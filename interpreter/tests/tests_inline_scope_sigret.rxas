/* SIGRET leaves a logical inline activation and restores caller signal state. */
.globals=0

main() .locals=6
    load r1,42
    sigbr caller_handler,"OTHER"
    inlenter r0,helper(),"count=0;args=list();a0=r4;proxies=();owned=(r4,r5);prep=none;result=ignored",after_clone
    sigret "OTHER"
    load r5,99
    signal "OTHER"
    ret 1
after_clone:
    ieq r2,r1,42
    brf fail,r2
    signal "OTHER"
    br fail
caller_handler:
    sigbr no_scope,"OUT_OF_RANGE"
    linkargv r5,1
    br fail
no_scope:
    ieq r2,r1,42
    brf fail,r2
    sayx "PASS: inline scoped SIGRET cleanup"
    ret 0
fail:
    ret 1

helper() .locals=0
    ret
