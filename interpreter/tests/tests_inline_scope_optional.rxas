/* Absent optional a1 is a fresh owned cell, never a caller pointer. */
.globals=0

main() .locals=6
    load r1,42
    inlenter r0,helper(),"count=0;args=list();a0=r4;proxies=(r5:1);owned=(r4,r5);prep=none",after_clone
    ieq r2,r4,0
    brf fail,r2
    load r5,19
    ret r5
after_clone:
    ieq r2,r0,19
    brf fail,r2
    ieq r2,r1,42
    brf fail,r2
    sayx "PASS: inline optional argument backing"
    ret 0
fail:
    ret 1

helper() .locals=0
    ret
