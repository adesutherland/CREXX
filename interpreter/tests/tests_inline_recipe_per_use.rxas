/* Identical recipe text at two sites must seal to each distinct provider. */
.globals=0

main() .locals=3
    inlenter r0,first(),"count=0;args=list();a0=r2;proxies=();owned=(r2);prep=none;result=ignored",after_first
    ret
after_first:
    inlenter r0,second(),"count=0;args=list();a0=r2;proxies=();owned=(r2);prep=none;result=ignored",after_second
    ret
after_second:
    sayx "PASS: inline recipe per use"
    ret 0

first() .locals=0
    ret

second() .locals=0
    ret
