cmake_minimum_required(VERSION 3.24)
foreach(_required ASSEMBLER LINKER DISASSEMBLER VM HARNESS SOURCE WORK)
  if(NOT DEFINED ${_required})
    message(FATAL_ERROR "Missing ${_required}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
function(run_checked _name)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${_dir}" RESULT_VARIABLE _result
    OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 30)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "${_name}: ${_result}\n${_stdout}${_stderr}")
  endif()
  set(_stdout "${_stdout}" PARENT_SCOPE)
endfunction()

foreach(_mode plain optimized)
  set(_dir "${WORK}/${_mode}")
  file(MAKE_DIRECTORY "${_dir}")
  file(COPY_FILE "${SOURCE}/inlined_private_root.rxas" "${_dir}/private-root.rxas")
  file(COPY_FILE "${SOURCE}/inlined_private_provider.rxas" "${_dir}/private-provider.rxas")
  set(_options "")
  if(_mode STREQUAL "plain")
    set(_options -n)
  endif()
  run_checked("assemble ${_mode} provider" "${ASSEMBLER}" ${_options} private-provider.rxas)
  run_checked("assemble ${_mode} root" "${ASSEMBLER}" ${_options} private-root.rxas)
  run_checked("inspect ${_mode} root" "${DISASSEMBLER}" private-root.rxbin)
  string(REGEX MATCHALL "[.]inlinedprivate r[0-9]+,\"private-provider[.]rxas\",g0" _bindings "${_stdout}")
  list(LENGTH _bindings _binding_count)
  if(NOT _binding_count EQUAL 6 OR _stdout MATCHES "[ \t](inlenter|qglobbind)[ \t]")
    message(FATAL_ERROR "lost declarations or added per-call machinery\n${_stdout}")
  endif()
  file(WRITE "${_dir}/roundtrip.rxas" "${_stdout}")
  run_checked("assemble ${_mode} roundtrip" "${ASSEMBLER}" ${_options} roundtrip.rxas)
  run_checked("link ${_mode} root" "${LINKER}" -r private-root.rxas -o image private-root.rxbin private-provider.rxbin)
  run_checked("execute ${_mode} image" "${VM}" image.rxbin)
  run_checked("context/lifecycle ${_mode}" "${HARNESS}" "${_dir}/image.rxbin")
  if(NOT _stdout MATCHES "INLINED_PRIVATE_VM[|]failures=0")
    message(FATAL_ERROR "missing lifecycle oracle: ${_stdout}")
  endif()
  run_checked("link ${_mode} roundtrip" "${LINKER}" -r roundtrip.rxas -o roundtrip roundtrip.rxbin private-provider.rxbin)
  run_checked("execute ${_mode} roundtrip" "${VM}" roundtrip.rxbin)
  file(WRITE "${_dir}/anchor.rxas" ".globals=0\nanchor() .locals=0\n  ret 91\n")
  run_checked("assemble anchor" "${ASSEMBLER}" -n anchor.rxas)
  run_checked("relocate sealed borrowed globals" "${LINKER}" -s -r anchor.rxas -r private-root.rxas
    -o relinked anchor.rxbin image.rxbin)
  run_checked("execute relocated sealed image" "${VM}" relinked.rxbin)
  run_checked("inspect relocated declarations" "${DISASSEMBLER}" relinked.rxbin)
  if(NOT _stdout MATCHES "[.]inlinedprivate r[0-9]+,\"private-provider[.]rxas\",g0")
    message(FATAL_ERROR "source stripping lost executable private binding\n${_stdout}")
  endif()
endforeach()

set(_dir "${WORK}/negative")
file(MAKE_DIRECTORY "${_dir}")
file(COPY_FILE "${SOURCE}/inlined_private_provider.rxas" "${_dir}/private-provider.rxas")
run_checked("assemble negative provider" "${ASSEMBLER}" -n private-provider.rxas)
foreach(_case duplicate hole outside late)
  if(_case STREQUAL "duplicate")
    set(_body ".locals=2\n  .inlinedprivate r1,\"private-provider.rxas\",g0\n  .inlinedprivate r1,\"private-provider.rxas\",g0\n  ret 0\n")
  elseif(_case STREQUAL "hole")
    set(_body ".locals=3\n  .inlinedprivate r1,\"private-provider.rxas\",g0\n  ret 0\n")
  elseif(_case STREQUAL "outside")
    set(_body ".locals=2\n  .inlinedprivate r2,\"private-provider.rxas\",g0\n  ret 0\n")
  else()
    set(_body ".locals=2\n  load r0,0\n  .inlinedprivate r1,\"private-provider.rxas\",g0\n  ret 0\n")
  endif()
  file(WRITE "${_dir}/${_case}.rxas" ".globals=0\nmain() ${_body}")
  foreach(_options "-n" "")
    execute_process(COMMAND "${ASSEMBLER}" ${_options} "${_case}.rxas" WORKING_DIRECTORY "${_dir}"
      RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 30)
    if(_result EQUAL 0)
      message(FATAL_ERROR "accepted malformed ${_case} ${_options}: ${_out}${_err}")
    endif()
  endforeach()
endforeach()

# Link errors must preserve the existing output, including an otherwise unused
# private provider, wrong namespace, invalid provider bound and ambiguity.
file(WRITE "${_dir}/last-good.rxbin" "last-good")
file(SHA256 "${_dir}/last-good.rxbin" _before)
foreach(_case missing bounds ordinal ambiguous)
  set(_provider private-provider.rxas)
  set(_global 0)
  if(_case STREQUAL "missing")
    set(_provider wrong/private-provider.rxas)
  elseif(_case STREQUAL "bounds")
    set(_global 2)
  elseif(_case STREQUAL "ordinal")
    set(_provider @1)
  endif()
  file(WRITE "${_dir}/${_case}.rxas"
    ".globals=0\nmain() .locals=1\n  .inlinedprivate r0,\"${_provider}\",g${_global}\n  ret 0\n")
  run_checked("assemble link negative ${_case}" "${ASSEMBLER}" -n "${_case}.rxas")
  set(_inputs "${_case}.rxbin" private-provider.rxbin)
  if(_case STREQUAL "ambiguous")
    file(COPY_FILE "${_dir}/private-provider.rxbin" "${_dir}/duplicate-provider.rxbin")
    list(APPEND _inputs duplicate-provider.rxbin)
  endif()
  execute_process(COMMAND "${LINKER}" -r "${_case}.rxas" -o last-good ${_inputs}
    WORKING_DIRECTORY "${_dir}" RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 30)
  file(SHA256 "${_dir}/last-good.rxbin" _after)
  if(_result EQUAL 0 OR NOT _before STREQUAL _after)
    message(FATAL_ERROR "invalid ${_case} binding succeeded or damaged last-good output: ${_out}${_err}")
  endif()
endforeach()
message("INLINED_PRIVATE_INTEGRATION|failures=0")
