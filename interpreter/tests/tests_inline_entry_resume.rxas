/* A rejected scope must resume at its encoded caller continuation. */
.globals=1
main() .locals=6
    load g0,0
    load r0,77
    load r1,-1
    load r4,44
    load r5,55
    sigignore "FAILURE"
    sigignore "OUT_OF_RANGE"
    inlenter r0,helper(),"count=r1;args=window(r2);a0=r4;proxies=();owned=(r4,r5);prep=none",rejected
    sayx "FAIL: unentered inline body"
    ret 91
rejected:
    ieq r2,r0,77
    brf fail,r2
    ieq r2,r4,44
    brf fail,r2
    ieq r2,r5,55
    brf fail,r2
    inlenter r0,helper(),"count=0;args=list();a0=r4;proxies=();owned=(r4,r5);prep=none",entered
    say "entered"
    ret 9
entered:
    ieq r2,r0,9
    brf fail,r2
    ieq r2,r4,0
    brf fail,r2
    ieq r2,r5,0
    brf fail,r2
    load r0,77
    load r1,-1
    load r2,100
    load r3,200
    settp r2,0
    settp r3,0
    sigcall failure_return(),"FAILURE"
    sigcall failure_return(),"OUT_OF_RANGE"
    inlenter r0,helper(),"count=r1;args=window(r2);a0=r4;proxies=();owned=(r4,r5);prep=settp(r2,256)+swap(r2,r3)",prepared
    sayx "FAIL: rejected prepared clone body"
    ret 92
prepared:
    ieq r5,r0,77
    brf fail,r5
    ieq r5,r2,200
    brf fail,r5
    ieq r5,r3,100
    brf fail,r5
    getandtp r5,r3,256
    ieq r5,r5,256
    brf fail,r5
    ieq r5,g0,1
    brf fail,r5
    sigbr no_scope,"OUT_OF_RANGE"
    linkargv r4,0
    br fail
no_scope:
    sayx "PASS: inline rejected entry resume"
    ret 0
fail:
    sayx "FAIL: inline rejected entry resume"
    ret 1
helper() .locals=0
    say "entered"
    ret 9
failure_return() .locals=0
    iadd g0,g0,1
    ret 0
