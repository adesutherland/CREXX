/*
 * Gate F F1c local-provider and structured-scope fixture.
 *
 * This deliberately exercises the public RXAS boundary.  The task target is
 * a semantic-graph callable id, never a procedure-name string, and every
 * asynchronous payload is a canonical RXCV binary.
 */

.globals=0

.meta "gatef.identity"="b" ".int" identity() "number=.string"
.meta "gatef.loop_forever"="b" ".int" loop_forever() ""
.meta "gatef.binary_identity"="b" ".binary" binary_identity() "item=.binary"

main() .locals=32
    /* Canonical local-pool configuration: one worker, admission capacity 2. */
    load r4,

    /* Provider and wire-contract failures must allocate no channel. */
    load r2,0
    load r3,0
    chanopen r0,r1,r2,r3,r4
    ieq r5,r0,3
    brf fail_invalid_provider,r5
    ieq r5,r1,0
    brf fail_failure_handle,r5

    /* Reserved core providers are known-but-unavailable; an unregistered
     * extension code is invalid rather than silently treated as a core type. */
    load r2,2
    chanopen r0,r1,r2,r3,r4
    ieq r5,r0,4
    brf fail_unavailable_provider,r5
    ieq r5,r1,0
    brf fail_failure_handle,r5
    load r2,65536
    chanopen r0,r1,r2,r3,r4
    ieq r5,r0,3
    brf fail_unregistered_provider,r5
    ieq r5,r1,0
    brf fail_failure_handle,r5

    load r2,1
    load r3,16
    chanopen r0,r1,r2,r3,r4
    ieq r5,r0,5
    brf fail_unsupported_capability,r5
    ieq r5,r1,0
    brf fail_failure_handle,r5

    /* Truncated RXCV. */
    load r6,
    load r3,0
    chanopen r0,r1,r2,r3,r6
    ieq r5,r0,6
    brf fail_truncated,r5

    /* Canonical payload with one trailing byte. */
    load r6,
    chanopen r0,r1,r2,r3,r6
    ieq r5,r0,6
    brf fail_trailing,r5

    /* Same fields in noncanonical order. */
    load r6,
    chanopen r0,r1,r2,r3,r6
    ieq r5,r0,6
    brf fail_noncanonical,r5

    /* Supported document framing with an incompatible major version. */
    load r6,
    chanopen r0,r1,r2,r3,r6
    ieq r5,r0,7
    brf fail_version,r5

    /* Open the bounded local provider. */
    load r3,11
    chanopen r0,r1,r2,r3,r4
    ieq r5,r0,0
    brf fail_open,r5

    /* Outputs may alias inputs once the provider has consumed every input.
     * Exercise the channel output replacing its own RXCV configuration. */
    bcopy r31,r4
    chanopen r0,r31,r2,r3,r31
    ieq r5,r0,0
    brf fail_alias_open,r5
    load r30,1
    chanclose r0,r31,r30
    ieq r5,r0,0
    brf fail_alias_close,r5

    /* A structurally valid channel capability owned by another execution. */
    load r6,8589934592
    iadd r7,r1,r6
    load r8,0
    chanwait r0,r9,r7,r8
    ieq r5,r0,14
    brf fail_wrong_owner,r5

    /* A valid empty channel is nonblocking, and a channel is not a ticket. */
    chanwait r0,r9,r1,r8
    ieq r5,r0,10
    brf fail_would_block,r5
    load r12,0x52584356010000001c00000000000000000000000000000000000000
    chancancel r0,r1,r1,r12
    ieq r5,r0,13
    brf fail_wrong_kind,r5

    /* Start a nonterminating task and wait long enough for it to be running. */
    load r4,
    /* Kind 3 requires the later compiler/runtime taskwork factory adapter.  It
     * must fail explicitly in F1c rather than ignore factory arguments. */
    bcopy r29,r4
    load r27,350
    load r28,3
    bseti64 r29,r27,r28
    load r8,0
    chanstart r0,r30,r1,r29,r8
    ieq r5,r0,19
    brf fail_taskwork_deferred,r5
    ieq r5,r30,0
    brf fail_failure_ticket,r5
    chanstart r0,r6,r1,r4,r8
    ieq r5,r0,0
    brf fail_start_loop,r5
    load r8,10000
    chanwait r0,r9,r1,r8
    ieq r5,r0,11
    brf fail_running_timeout,r5

    /* Fill the remaining admission slot, then prove bounded rejection. */
    load r4,
    load r8,0
    chanstart r0,r10,r1,r4,r8
    ieq r5,r0,0
    brf fail_start_queued,r5
    load r4,
    chanstart r0,r11,r1,r4,r8
    ieq r5,r0,9
    brf fail_backpressure,r5
    ieq r5,r11,0
    brf fail_failure_ticket,r5

    /* Cancel one queued and one running task. */
    chancancel r0,r1,r10,r12
    ieq r5,r0,0
    brf fail_cancel_queued,r5
    chancancel r0,r1,r10,r12
    ieq r5,r0,16
    brf fail_cancel_terminal,r5
    chancancel r0,r1,r6,r12
    ieq r5,r0,0
    brf fail_cancel_running,r5

    load r8,-1
    chanwait r0,r13,r1,r8
    ieq r5,r0,0
    brf fail_wait_cancel_one,r5
    load r14,299
    bgeti64 r15,r13,r14
    ieq r5,r15,3
    brf fail_cancel_state_one,r5
    chanwait r0,r13,r1,r8
    ieq r5,r0,0
    brf fail_wait_cancel_two,r5
    bgeti64 r15,r13,r14
    ieq r5,r15,3
    brf fail_cancel_state_two,r5

    /* The cancelled worker must be reusable. */
    load r4,
    load r8,0
    chanstart r0,r6,r1,r4,r8
    ieq r5,r0,0
    brf fail_reuse_start,r5
    load r8,-1
    chanwait r0,r13,r1,r8
    ieq r5,r0,0
    brf fail_reuse_wait,r5
    load r14,298
    bgeti64 r15,r13,r14
    ieq r5,r15,1
    brf fail_reuse_state,r5
    load r14,229
    bgeti64 r15,r13,r14
    ieq r5,r15,41
    brf fail_reuse_result,r5
    chancancel r0,r1,r6,r12
    ieq r5,r0,16
    brf fail_reuse_terminal,r5

    /* A second channel runs two independent tasks on two workers. */
    load r4,
    load r2,1
    load r3,11
    chanopen r0,r16,r2,r3,r4
    ieq r5,r0,0
    brf fail_open_two,r5

    load r4,
    load r8,0
    chanstart r0,r17,r16,r4,r8
    ieq r5,r0,0
    brf fail_independent_one,r5
    load r4,
    chanstart r0,r18,r16,r4,r8
    ieq r5,r0,0
    brf fail_independent_two,r5

    load r8,-1
    chanwait r0,r19,r16,r8
    ieq r5,r0,0
    brf fail_independent_wait_one,r5
    chanwait r0,r20,r16,r8
    ieq r5,r0,0
    brf fail_independent_wait_two,r5
    load r14,298
    bgeti64 r21,r19,r14
    bgeti64 r22,r20,r14
    iadd r23,r21,r22
    ieq r5,r23,2
    brf fail_independent_states,r5
    load r14,229
    bgeti64 r21,r19,r14
    bgeti64 r22,r20,r14
    iadd r23,r21,r22
    ieq r5,r23,83
    brf fail_independent_results,r5

    /* Kind-2 adapters receive complete copied RXCV documents as worker-owned
     * binary values.  Echo one tree containing every F1 public node family and
     * prove that the receiver materializes the identical canonical node. */
    load r4,
    load r8,0
    chanstart r0,r24,r16,r4,r8
    ieq r5,r0,0
    brf fail_channelvalue_start,r5
    load r8,-1
    chanwait r0,r13,r16,r8
    ieq r5,r0,0
    brf fail_channelvalue_wait,r5
    load r27,128
    bgeti64 r15,r13,r27
    ieq r5,r15,0
    brf fail_channelvalue_error,r5
    load r27,582
    bgeti64 r15,r13,r27
    ieq r5,r15,1
    brf fail_channelvalue_state,r5
    load r29,
    load r27,217
    load r28,304
    bslice r30,r13,r27,r28
    load r27,0
    bcmpb r27,r30,r29
    ieq r5,r27,0
    brf fail_channelvalue_result,r5

    /* A scope is another type-1 channel whose configuration contains an
     * execution-local capability to its pool.  Its one absolute deadline is
     * inherited by every child and produces a terminal deadline completion. */
    load r4,
    load r27,137
    bseti64 r4,r27,r1
    load r2,1
    load r3,15
    chanopen r0,r25,r2,r3,r4
    ieq r5,r0,0
    brf fail_scope_deadline_open,r5
    load r4,
    load r8,0
    chanstart r0,r26,r25,r4,r8
    ieq r5,r0,0
    brf fail_scope_deadline_start,r5
    load r8,-1
    chanwait r0,r13,r25,r8
    ieq r5,r0,0
    brf fail_scope_deadline_wait,r5
    load r27,307
    bgeti64 r15,r13,r27
    ieq r5,r15,4
    brf fail_scope_deadline_state,r5
    chancancel r0,r25,r26,r12
    ieq r5,r0,16
    brf fail_scope_deadline_terminal,r5
    load r3,1
    chanclose r0,r25,r3
    ieq r5,r0,0
    brf fail_scope_deadline_close,r5

    /* Fail-fast uses the same terminal publication path.  A missing semantic
     * target fails first and cancels its still-queued sibling exactly once. */
    load r4,
    load r27,137
    bseti64 r4,r27,r1
    load r3,15
    chanopen r0,r25,r2,r3,r4
    ieq r5,r0,0
    brf fail_scope_failfast_open,r5
    load r4,
    load r8,0
    chanstart r0,r27,r25,r4,r8
    ieq r5,r0,0
    brf fail_scope_failfast_first,r5
    load r4,
    chanstart r0,r26,r25,r4,r8
    ieq r5,r0,0
    brf fail_scope_failfast_second,r5
    load r8,-1
    chanwait r0,r13,r25,r8
    ieq r5,r0,0
    brf fail_scope_failfast_wait_one,r5
    load r28,311
    bgeti64 r15,r13,r28
    ieq r5,r15,2
    brf fail_scope_failfast_state_one,r5
    chanwait r0,r13,r25,r8
    ieq r5,r0,0
    brf fail_scope_failfast_wait_two,r5
    load r28,299
    bgeti64 r15,r13,r28
    ieq r5,r15,3
    brf fail_scope_failfast_state_two,r5
    load r3,1
    chanclose r0,r25,r3
    ieq r5,r0,0
    brf fail_scope_failfast_close,r5

    /* A ticket from channel one is not authority over channel two. */
    chancancel r0,r16,r6,r12
    ieq r5,r0,15
    brf fail_unknown_ticket,r5

    /* Closing a pool stops admission through every still-open child scope.
     * The scope remains closeable so accepted work can still be accounted. */
    load r4,
    load r27,137
    bseti64 r4,r27,r1
    load r2,1
    load r3,15
    chanopen r0,r25,r2,r3,r4
    ieq r5,r0,0
    brf fail_pool_close_scope_open,r5
    /* Accept one nonterminating child before the owning pool closes. */
    load r4,
    load r8,0
    chanstart r0,r24,r25,r4,r8
    ieq r5,r0,0
    brf fail_pool_close_scope_task,r5
    load r3,2
    chanclose r0,r1,r3
    ieq r5,r0,0
    brf fail_close_one,r5
    load r8,-1
    chanwait r0,r13,r25,r8
    ieq r5,r0,0
    brf fail_pool_close_scope_wait,r5
    load r28,299
    bgeti64 r15,r13,r28
    ieq r5,r15,3
    brf fail_pool_close_scope_state,r5
    load r4,
    load r8,0
    chanstart r0,r24,r25,r4,r8
    ieq r5,r0,18
    brf fail_pool_close_scope_start,r5
    ieq r5,r24,0
    brf fail_failure_ticket,r5
    load r3,1
    chanclose r0,r25,r3
    ieq r5,r0,0
    brf fail_pool_close_scope_close,r5

    /* Close consumes every request; a repeated use is stale. */
    chanclose r0,r1,r3
    ieq r5,r0,13
    brf fail_double_close_one,r5
    load r8,0
    chanstart r0,r24,r1,r4,r8
    ieq r5,r0,13
    brf fail_stale_start,r5
    ieq r5,r24,0
    brf fail_failure_ticket,r5

    /* Drain-close must continue to enforce the deadline of every open scope;
     * otherwise an accepted nonterminating child could strand pool shutdown. */
    load r4,
    load r27,137
    bseti64 r4,r27,r16
    load r2,1
    load r3,15
    chanopen r0,r25,r2,r3,r4
    ieq r5,r0,0
    brf fail_pool_drain_scope_open,r5
    load r4,
    load r8,0
    chanstart r0,r26,r25,r4,r8
    ieq r5,r0,0
    brf fail_pool_drain_scope_task,r5
    load r3,1
    chanclose r0,r16,r3
    ieq r5,r0,0
    brf fail_close_two,r5
    load r8,-1
    chanwait r0,r13,r25,r8
    ieq r5,r0,0
    brf fail_pool_drain_scope_wait,r5
    load r27,307
    bgeti64 r15,r13,r27
    ieq r5,r15,4
    brf fail_pool_drain_scope_state,r5
    chanclose r0,r25,r3
    ieq r5,r0,0
    brf fail_pool_drain_scope_close,r5
    chanclose r0,r16,r3
    ieq r5,r0,13
    brf fail_double_close_two,r5

    /* Leave one running channel deliberately. VM context teardown must cancel,
     * join and release its channel, ticket, request and worker allocations. */
    load r4,
    load r2,1
    load r3,11
    chanopen r0,r25,r2,r3,r4
    ieq r5,r0,0
    brf fail_teardown_open,r5
    load r4,
    load r8,0
    chanstart r0,r26,r25,r4,r8
    ieq r5,r0,0
    brf fail_teardown_start,r5

    say "PASS: Gate F F1c local channel"
    ret 0

fail_invalid_provider:
    say "FAIL: invalid provider status"
    ret 1
fail_failure_handle:
    say "FAIL: failed open returned channel"
    ret 1
fail_unavailable_provider:
    say "FAIL: reserved provider availability status"
    ret 1
fail_unregistered_provider:
    say "FAIL: unregistered extension provider status"
    ret 1
fail_unsupported_capability:
    say "FAIL: unsupported capability status"
    ret 1
fail_truncated:
    say "FAIL: truncated RXCV accepted"
    ret 1
fail_trailing:
    say "FAIL: trailing RXCV accepted"
    ret 1
fail_noncanonical:
    say "FAIL: noncanonical RXCV accepted"
    ret 1
fail_version:
    say "FAIL: incompatible RXCV version status"
    ret 1
fail_open:
    say "FAIL: local channel open"
    ret 1
fail_alias_open:
    say "FAIL: aliased channel open"
    ret 1
fail_alias_close:
    say "FAIL: aliased channel close"
    ret 1
fail_wrong_owner:
    say "FAIL: wrong-owner capability status"
    ret 1
fail_would_block:
    say "FAIL: empty-channel nonblocking status"
    ret 1
fail_wrong_kind:
    say "FAIL: wrong-kind capability status"
    ret 1
fail_taskwork_deferred:
    say "FAIL: unsupported taskwork factory was accepted"
    ret 1
fail_start_loop:
    say "FAIL: loop task start"
    ret 1
fail_running_timeout:
    say "FAIL: running task observation timeout"
    ret 1
fail_start_queued:
    say "FAIL: queued task start"
    ret 1
fail_backpressure:
    say "FAIL: bounded admission backpressure"
    ret 1
fail_failure_ticket:
    say "FAIL: rejected operation returned ticket"
    ret 1
fail_cancel_queued:
    say "FAIL: queued cancellation"
    ret 1
fail_cancel_terminal:
    say "FAIL: repeated cancellation status"
    ret 1
fail_cancel_running:
    say "FAIL: running cancellation"
    ret 1
fail_wait_cancel_one:
    say "FAIL: first cancellation wait"
    ret 1
fail_cancel_state_one:
    say "FAIL: first cancellation state"
    ret 1
fail_wait_cancel_two:
    say "FAIL: second cancellation wait"
    ret 1
fail_cancel_state_two:
    say "FAIL: second cancellation state"
    ret 1
fail_reuse_start:
    say "FAIL: worker reuse start"
    ret 1
fail_reuse_wait:
    say "FAIL: worker reuse wait"
    ret 1
fail_reuse_state:
    say "FAIL: worker reuse completion state"
    ret 1
fail_reuse_result:
    say "FAIL: worker reuse result"
    ret 1
fail_reuse_terminal:
    say "FAIL: reused task repeated cancel"
    ret 1
fail_open_two:
    say "FAIL: second channel open"
    ret 1
fail_independent_one:
    say "FAIL: first independent task start"
    ret 1
fail_independent_two:
    say "FAIL: second independent task start"
    ret 1
fail_independent_wait_one:
    say "FAIL: first independent task wait"
    ret 1
fail_independent_wait_two:
    say "FAIL: second independent task wait"
    ret 1
fail_independent_states:
    say "FAIL: independent task states"
    ret 1
fail_independent_results:
    say "FAIL: independent task results"
    ret 1
fail_unknown_ticket:
    say "FAIL: cross-channel ticket status"
    ret 1
fail_pool_close_scope_open:
    say "FAIL: pool-close scope did not open"
    ret 1
fail_pool_close_scope_task:
    say "FAIL: pool-close scope task did not start"
    ret 1
fail_pool_close_scope_wait:
    say "FAIL: pool-close scope task was not accounted"
    ret 1
fail_pool_close_scope_state:
    say "FAIL: pool-close scope task was not cancelled"
    ret 1
fail_pool_close_scope_start:
    say "FAIL: closed pool admitted scope work"
    ret 1
fail_pool_close_scope_close:
    say "FAIL: scope could not close after pool"
    ret 1
fail_pool_drain_scope_open:
    say "FAIL: pool-drain scope did not open"
    ret 1
fail_pool_drain_scope_task:
    say "FAIL: pool-drain scope task did not start"
    ret 1
fail_pool_drain_scope_wait:
    say "FAIL: pool drain did not account deadline task"
    ret 1
fail_pool_drain_scope_state:
    say "FAIL: pool drain lost scope deadline"
    ret 1
fail_pool_drain_scope_close:
    say "FAIL: drained scope could not close after pool"
    ret 1
fail_channelvalue_start:
    say "FAIL: full ChannelValue start"
    ret 1
fail_channelvalue_wait:
    say "FAIL: full ChannelValue wait"
    ret 1
fail_channelvalue_state:
    say "FAIL: full ChannelValue completion state"
    ret 1
fail_channelvalue_error:
    ieq r5,r15,4
    brt fail_channelvalue_target,r5
    ieq r5,r15,5
    brt fail_channelvalue_setup,r5
    ieq r5,r15,6
    brt fail_channelvalue_return,r5
    say "FAIL: full ChannelValue unknown error"
    ret 1
fail_channelvalue_target:
    say "FAIL: full ChannelValue target not found"
    ret 1
fail_channelvalue_setup:
    say "FAIL: full ChannelValue worker setup"
    ret 1
fail_channelvalue_return:
    say "FAIL: full ChannelValue invalid return"
    ret 1
fail_channelvalue_result:
    say "FAIL: full ChannelValue copied result"
    ret 1
fail_scope_deadline_open:
    say "FAIL: deadline scope open"
    ret 1
fail_scope_deadline_start:
    say "FAIL: deadline scope start"
    ret 1
fail_scope_deadline_wait:
    say "FAIL: deadline scope wait"
    ret 1
fail_scope_deadline_state:
    say "FAIL: deadline scope terminal state"
    ret 1
fail_scope_deadline_terminal:
    say "FAIL: deadline scope one-terminal rule"
    ret 1
fail_scope_deadline_close:
    say "FAIL: deadline scope close"
    ret 1
fail_scope_failfast_open:
    say "FAIL: fail-fast scope open"
    ret 1
fail_scope_failfast_first:
    say "FAIL: fail-fast missing-target start"
    ret 1
fail_scope_failfast_second:
    say "FAIL: fail-fast sibling start"
    ret 1
fail_scope_failfast_wait_one:
    say "FAIL: fail-fast first wait"
    ret 1
fail_scope_failfast_state_one:
    say "FAIL: fail-fast first state"
    ret 1
fail_scope_failfast_wait_two:
    say "FAIL: fail-fast sibling wait"
    ret 1
fail_scope_failfast_state_two:
    say "FAIL: fail-fast sibling state"
    ret 1
fail_scope_failfast_close:
    say "FAIL: fail-fast scope close"
    ret 1
fail_close_one:
    say "FAIL: first channel close"
    ret 1
fail_double_close_one:
    say "FAIL: first channel double close"
    ret 1
fail_stale_start:
    say "FAIL: stale channel start"
    ret 1
fail_close_two:
    say "FAIL: second channel close"
    ret 1
fail_double_close_two:
    say "FAIL: second channel double close"
    ret 1
fail_teardown_open:
    say "FAIL: teardown channel open"
    ret 1
fail_teardown_start:
    say "FAIL: teardown task start"
    ret 1

identity() .locals=1 .expose=gatef.identity
    stoi a1
    ret a1

loop_forever() .locals=1 .expose=gatef.loop_forever
    load r0,0
loop_again:
    inc r0
    br loop_again

binary_identity() .locals=1 .expose=gatef.binary_identity
    ret a1
