/*
 * Gate F F1b minimum local-provider vertical fixture.
 *
 * This deliberately exercises the public RXAS boundary.  The task target is
 * a semantic-graph callable id, never a procedure-name string, and every
 * asynchronous payload is a canonical RXCV binary.
 */

.globals=0

.meta "gatef.identity"="b" ".int" identity() "number=.string"
.meta "gatef.loop_forever"="b" ".int" loop_forever() ""

main() .locals=32
    /* Canonical local-pool configuration: one worker, admission capacity 2. */
    load r4,

    /* Provider and wire-contract failures must allocate no channel. */
    load r2,0
    load r3,0
    chanopen r0,r1,r2,r3,r4
    ieq r5,r0,3
    brf fail_invalid_provider,r5
    ieq r5,r1,0
    brf fail_failure_handle,r5

    load r2,1
    load r3,4
    chanopen r0,r1,r2,r3,r4
    ieq r5,r0,5
    brf fail_unsupported_capability,r5
    ieq r5,r1,0
    brf fail_failure_handle,r5

    /* Truncated RXCV. */
    load r6,
    load r3,0
    chanopen r0,r1,r2,r3,r6
    ieq r5,r0,6
    brf fail_truncated,r5

    /* Canonical payload with one trailing byte. */
    load r6,
    chanopen r0,r1,r2,r3,r6
    ieq r5,r0,6
    brf fail_trailing,r5

    /* Same fields in noncanonical order. */
    load r6,
    chanopen r0,r1,r2,r3,r6
    ieq r5,r0,6
    brf fail_noncanonical,r5

    /* Supported document framing with an incompatible major version. */
    load r6,
    chanopen r0,r1,r2,r3,r6
    ieq r5,r0,7
    brf fail_version,r5

    /* Open the bounded local provider. */
    load r3,11
    chanopen r0,r1,r2,r3,r4
    ieq r5,r0,0
    brf fail_open,r5

    /* Outputs may alias inputs once the provider has consumed every input.
     * Exercise the channel output replacing its own RXCV configuration. */
    bcopy r31,r4
    chanopen r0,r31,r2,r3,r31
    ieq r5,r0,0
    brf fail_alias_open,r5
    load r30,1
    chanclose r0,r31,r30
    ieq r5,r0,0
    brf fail_alias_close,r5

    /* A structurally valid channel capability owned by another execution. */
    load r6,8589934592
    iadd r7,r1,r6
    load r8,0
    chanwait r0,r9,r7,r8
    ieq r5,r0,14
    brf fail_wrong_owner,r5

    /* A valid empty channel is nonblocking, and a channel is not a ticket. */
    chanwait r0,r9,r1,r8
    ieq r5,r0,10
    brf fail_would_block,r5
    load r12,0x52584356010000001c00000000000000000000000000000000000000
    chancancel r0,r1,r1,r12
    ieq r5,r0,13
    brf fail_wrong_kind,r5

    /* Start a nonterminating task and wait long enough for it to be running. */
    load r4,
    load r8,0
    chanstart r0,r6,r1,r4,r8
    ieq r5,r0,0
    brf fail_start_loop,r5
    load r8,10000
    chanwait r0,r9,r1,r8
    ieq r5,r0,11
    brf fail_running_timeout,r5

    /* Fill the remaining admission slot, then prove bounded rejection. */
    load r4,
    load r8,0
    chanstart r0,r10,r1,r4,r8
    ieq r5,r0,0
    brf fail_start_queued,r5
    load r4,
    chanstart r0,r11,r1,r4,r8
    ieq r5,r0,9
    brf fail_backpressure,r5
    ieq r5,r11,0
    brf fail_failure_ticket,r5

    /* Cancel one queued and one running task. */
    chancancel r0,r1,r10,r12
    ieq r5,r0,0
    brf fail_cancel_queued,r5
    chancancel r0,r1,r10,r12
    ieq r5,r0,16
    brf fail_cancel_terminal,r5
    chancancel r0,r1,r6,r12
    ieq r5,r0,0
    brf fail_cancel_running,r5

    load r8,-1
    chanwait r0,r13,r1,r8
    ieq r5,r0,0
    brf fail_wait_cancel_one,r5
    load r14,299
    bgeti64 r15,r13,r14
    ieq r5,r15,3
    brf fail_cancel_state_one,r5
    chanwait r0,r13,r1,r8
    ieq r5,r0,0
    brf fail_wait_cancel_two,r5
    bgeti64 r15,r13,r14
    ieq r5,r15,3
    brf fail_cancel_state_two,r5

    /* The cancelled worker must be reusable. */
    load r4,
    load r8,0
    chanstart r0,r6,r1,r4,r8
    ieq r5,r0,0
    brf fail_reuse_start,r5
    load r8,-1
    chanwait r0,r13,r1,r8
    ieq r5,r0,0
    brf fail_reuse_wait,r5
    load r14,298
    bgeti64 r15,r13,r14
    ieq r5,r15,1
    brf fail_reuse_state,r5
    load r14,229
    bgeti64 r15,r13,r14
    ieq r5,r15,41
    brf fail_reuse_result,r5
    chancancel r0,r1,r6,r12
    ieq r5,r0,16
    brf fail_reuse_terminal,r5

    /* A second channel runs two independent tasks on two workers. */
    load r4,
    load r2,1
    load r3,11
    chanopen r0,r16,r2,r3,r4
    ieq r5,r0,0
    brf fail_open_two,r5

    load r4,
    load r8,0
    chanstart r0,r17,r16,r4,r8
    ieq r5,r0,0
    brf fail_independent_one,r5
    load r4,
    chanstart r0,r18,r16,r4,r8
    ieq r5,r0,0
    brf fail_independent_two,r5

    load r8,-1
    chanwait r0,r19,r16,r8
    ieq r5,r0,0
    brf fail_independent_wait_one,r5
    chanwait r0,r20,r16,r8
    ieq r5,r0,0
    brf fail_independent_wait_two,r5
    load r14,298
    bgeti64 r21,r19,r14
    bgeti64 r22,r20,r14
    iadd r23,r21,r22
    ieq r5,r23,2
    brf fail_independent_states,r5
    load r14,229
    bgeti64 r21,r19,r14
    bgeti64 r22,r20,r14
    iadd r23,r21,r22
    ieq r5,r23,83
    brf fail_independent_results,r5

    /* A ticket from channel one is not authority over channel two. */
    chancancel r0,r16,r6,r12
    ieq r5,r0,15
    brf fail_unknown_ticket,r5

    /* Close consumes every request; a repeated use is stale. */
    load r3,1
    chanclose r0,r1,r3
    ieq r5,r0,0
    brf fail_close_one,r5
    chanclose r0,r1,r3
    ieq r5,r0,13
    brf fail_double_close_one,r5
    load r8,0
    chanstart r0,r24,r1,r4,r8
    ieq r5,r0,13
    brf fail_stale_start,r5
    ieq r5,r24,0
    brf fail_failure_ticket,r5

    load r3,2
    chanclose r0,r16,r3
    ieq r5,r0,0
    brf fail_close_two,r5
    chanclose r0,r16,r3
    ieq r5,r0,13
    brf fail_double_close_two,r5

    /* Leave one running channel deliberately. VM context teardown must cancel,
     * join and release its channel, ticket, request and worker allocations. */
    load r4,
    load r2,1
    load r3,11
    chanopen r0,r25,r2,r3,r4
    ieq r5,r0,0
    brf fail_teardown_open,r5
    load r4,
    load r8,0
    chanstart r0,r26,r25,r4,r8
    ieq r5,r0,0
    brf fail_teardown_start,r5

    say "PASS: Gate F F1b local channel"
    ret 0

fail_invalid_provider:
    say "FAIL: invalid provider status"
    ret 1
fail_failure_handle:
    say "FAIL: failed open returned channel"
    ret 1
fail_unsupported_capability:
    say "FAIL: unsupported capability status"
    ret 1
fail_truncated:
    say "FAIL: truncated RXCV accepted"
    ret 1
fail_trailing:
    say "FAIL: trailing RXCV accepted"
    ret 1
fail_noncanonical:
    say "FAIL: noncanonical RXCV accepted"
    ret 1
fail_version:
    say "FAIL: incompatible RXCV version status"
    ret 1
fail_open:
    say "FAIL: local channel open"
    ret 1
fail_alias_open:
    say "FAIL: aliased channel open"
    ret 1
fail_alias_close:
    say "FAIL: aliased channel close"
    ret 1
fail_wrong_owner:
    say "FAIL: wrong-owner capability status"
    ret 1
fail_would_block:
    say "FAIL: empty-channel nonblocking status"
    ret 1
fail_wrong_kind:
    say "FAIL: wrong-kind capability status"
    ret 1
fail_start_loop:
    say "FAIL: loop task start"
    ret 1
fail_running_timeout:
    say "FAIL: running task observation timeout"
    ret 1
fail_start_queued:
    say "FAIL: queued task start"
    ret 1
fail_backpressure:
    say "FAIL: bounded admission backpressure"
    ret 1
fail_failure_ticket:
    say "FAIL: rejected operation returned ticket"
    ret 1
fail_cancel_queued:
    say "FAIL: queued cancellation"
    ret 1
fail_cancel_terminal:
    say "FAIL: repeated cancellation status"
    ret 1
fail_cancel_running:
    say "FAIL: running cancellation"
    ret 1
fail_wait_cancel_one:
    say "FAIL: first cancellation wait"
    ret 1
fail_cancel_state_one:
    say "FAIL: first cancellation state"
    ret 1
fail_wait_cancel_two:
    say "FAIL: second cancellation wait"
    ret 1
fail_cancel_state_two:
    say "FAIL: second cancellation state"
    ret 1
fail_reuse_start:
    say "FAIL: worker reuse start"
    ret 1
fail_reuse_wait:
    say "FAIL: worker reuse wait"
    ret 1
fail_reuse_state:
    say "FAIL: worker reuse completion state"
    ret 1
fail_reuse_result:
    say "FAIL: worker reuse result"
    ret 1
fail_reuse_terminal:
    say "FAIL: reused task repeated cancel"
    ret 1
fail_open_two:
    say "FAIL: second channel open"
    ret 1
fail_independent_one:
    say "FAIL: first independent task start"
    ret 1
fail_independent_two:
    say "FAIL: second independent task start"
    ret 1
fail_independent_wait_one:
    say "FAIL: first independent task wait"
    ret 1
fail_independent_wait_two:
    say "FAIL: second independent task wait"
    ret 1
fail_independent_states:
    say "FAIL: independent task states"
    ret 1
fail_independent_results:
    say "FAIL: independent task results"
    ret 1
fail_unknown_ticket:
    say "FAIL: cross-channel ticket status"
    ret 1
fail_close_one:
    say "FAIL: first channel close"
    ret 1
fail_double_close_one:
    say "FAIL: first channel double close"
    ret 1
fail_stale_start:
    say "FAIL: stale channel start"
    ret 1
fail_close_two:
    say "FAIL: second channel close"
    ret 1
fail_double_close_two:
    say "FAIL: second channel double close"
    ret 1
fail_teardown_open:
    say "FAIL: teardown channel open"
    ret 1
fail_teardown_start:
    say "FAIL: teardown task start"
    ret 1

identity() .locals=1 .expose=gatef.identity
    stoi a1
    ret a1

loop_forever() .locals=1 .expose=gatef.loop_forever
    load r0,0
loop_again:
    inc r0
    br loop_again
