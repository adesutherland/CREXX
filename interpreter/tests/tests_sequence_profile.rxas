/*
 * Dynamic instruction-sequence profiling fixture.
 *
 * RXAS combines the comparison and branch, leaving a four-opcode emitted loop
 * body that executes five times. The taken branch must break the rolling
 * window before the next iteration.
 */

.globals=0

main() .locals=5
    load r1, 0
    load r2, 5
loop:
    iadd r1, r1, 1
    copy r3, r1
    copy r4, r3
    ilt r0, r1, r2
    brt loop, r0
    iadd r2, r2, 7
    copy r4, r2
    ret 0
