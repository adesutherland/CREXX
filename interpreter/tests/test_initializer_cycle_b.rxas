.globals=0

boot() .locals=0
   .meta "initcycleb.boot"="b" ".void" boot() ""
   .meta "initcycleb.boot"=".initializer" ".void" boot() ""
   call initcyclea.ping()
   ret

ping() .locals=0 .expose=initcycleb.ping
   .meta "initcycleb.ping"="b" ".void" ping() ""
   ret

initcyclea.ping() .expose=initcyclea.ping
   .meta "initcyclea.ping"="b" ".void" initcyclea.ping() ""
