/*
 * Decimal Plugin Sanity Tests for Assembler Instructions
 */

.globals=0

/*
 * r1 = number of errors
 * r2 = number of tests
 */
main() .locals=6
    load r1,0
    load r2,0
    say "Decimal Plugin Sanity Tests for Assembler Instructions"

    /* Test DECPLNM_REG_REG_REG */
    say ""
    sayx "Test 0 (DECPLNM_REG_REG_REG)"
    inc r2
    decplnm r3,r4,r5
    load r0," Name="
    concat r0,r0,r3
    concat r0,r0," Description="
    concat r0,r0,r4
    concat r0,r0," Version="
    concat r0,r0,r5
    say r0

    /* Test load */
    sayx "Test 1 (load)"
    inc r2
    load r3,1.23456e3d
    dtos r3
    seq r0,r3,"1234.56"
    brt test1end,r0
    inc r1
    sayx " - failed "
    say r3
test1end:

    /* Test stod and dtos - convert string to/from decimal */
    say ""
    sayx "Test 2 (stod and dtos)"
    inc r2
    load r3,"1e3"
    stod r3
    dtos r3
    seq r0,r3,"1000"
    brt test2end,r0
    inc r1
    sayx " - failed "
    say r3
test2end:

    /* Invalid decimal text must remain a conversion signal rather than the
     * decimal backend's generic ERROR fallback. */
    say ""
    sayx "Test 2.1 (stod - conversion syntax)"
    inc r2
    load r3,"not-a-number"
    sigbr test2_1caught, "CONVERSION_ERROR"
    stod r3
    inc r1
    sayx " - failed "
test2_1caught:
    sighalt "CONVERSION_ERROR"

    /* Test itod */
    say ""
    sayx "Test 3 (itod)"
    inc r2
    load r3,1001
    itod r3
    dtos r3
    seq r0,r3,"1001"
    brt test3end,r0
    inc r1
    sayx " - failed "
    say r3
test3end:

    /* Test ftod */
    say ""
    sayx "Test 4 (ftod)"
    inc r2
    load r3,1001.1
    ftod r3
    dtos r3
    seq r0,r3,"1001.1"
    brt test4end,r0
    inc r1
    sayx " - failed "
    say r3
test4end:

    say ""
    sayx "Test 5 (dtoi)"
    inc r2
    load r3,1234d
    dtoi r3
    itos r3
    seq r0,r3,"1234"
    brt test5end,r0
    inc r1
    sayx " - failed "
    say r3
test5end:

    say ""
    sayx "Test 5.1 (dtoi - conversion error)"
    inc r2
    load r3,12.34d
    sigbr test5_1end, "CONVERSION_ERROR" /* Set signal to branch */
    dtoi r3 /* This should cause a signal */
    inc r1
    sayx " - failed "
test5_1end:
    sighalt "CONVERSION_ERROR" /* Unset signal handler */

    /* Test dtof */
    say ""
    sayx "Test 6 (dtof)"
    inc r2
    load r3,1.23456e3d
    dtof r3
    ftos r3
    seq r0,r3,"1234.56"
    brt test6end,r0
    inc r1
    sayx " - failed "
    say r3
test6end:

    /* Test dadd (reg, reg, reg) */
    say ""
    sayx "Test 7 (dadd - reg,reg,reg)"
    inc r2
    load r3,1.23456e3d
    load r4,5.4321e3d
    dadd r5,r3,r4
    dtos r5
    seq r0,r5,"6666.66"
    brt test7end,r0
    inc r1
    sayx " - failed "
    say r5
test7end:

    /* Test dadd (reg, reg, decimal) */
    say ""
    sayx "Test 8 (dadd - reg,reg,decimal)"
    inc r2
    load r3,1.23456e3d
    dadd r4,r3,1e3
    dtos r4
    seq r0,r4,"2234.56"
    brt test8end,r0
    inc r1
    sayx " - failed "
    say r4
test8end:

    /* Test dsub (reg, reg, reg) */
    say ""
    sayx "Test 9 (dsub - reg,reg,reg)"
    inc r2
    load r3,1.23456e3d
    load r4,5.4321e3d
    dsub r5,r3,r4
    dtos r5
    seq r0,r5,"-4197.54"
    brt test9end,r0
    inc r1
    sayx " - failed "
    say r5
test9end:

    /* Test dsub (reg, reg, decimal) */
    say ""
    sayx "Test 10 (dsub - reg,reg,decimal)"
    inc r2
    load r3,1.23456e3d
    dsub r4,r3,1e3
    dtos r4
    seq r0,r4,"234.56"
    brt test10end,r0
    inc r1
    sayx " - failed "
    say r4
test10end:

    /* Test dsub (reg, decimal, reg) */
    say ""
    sayx "Test 11 (dsub - reg,decimal,reg)"
    inc r2
    load r3,1.23456e3d
    dsub r4,1e3,r3
    dtos r4
    seq r0,r4,"-234.56"
    brt test11end,r0
    inc r1
    sayx " - failed "
    say r4
test11end:

    /* Test dmult (reg, reg, reg) */
    say ""
    sayx "Test 12 (dmult - reg,reg,reg)"
    inc r2
    load r3,1.23456e3d
    load r4,5.4321e3d
    dmult r5,r3,r4
    dtos r5
    seq r0,r5,"6706253.376"
    brt test12end,r0
    inc r1
    sayx " - failed "
    say r5
test12end:

    /* Test dmult (reg, reg, decimal) */
    say ""
    sayx "Test 13 (dmult - reg,reg,decimal)"
    inc r2
    load r3,1.23456e3d
    dmult r4,r3,2d
    dtos r4
    seq r0,r4,"2469.12"
    brt test13end,r0
    inc r1
    sayx " - failed "
    say r4
test13end:

    /* Test ddiv (reg, reg, reg) */
    say ""
    sayx "Test 14 (ddiv - reg,reg,reg)"
    inc r2
    load r3,1.234567e3d
    load r4,2d
    ddiv r5,r3,r4
    dtos r5
    seq r0,r5,"617.2835"
    brt test14end,r0
    inc r1
    sayx " - failed "
    say r5
test14end:

    /* Test ddiv (reg, reg, decimal) */
    say ""
    sayx "Test 15 (ddiv - reg,reg,decimal)"
    inc r2
    load r3,1.23456e3d
    ddiv r4,r3,2d
    dtos r4
    seq r0,r4,"617.28"
    brt test15end,r0
    inc r1
    sayx " - failed "
    say r4
test15end:

    /* Test ddiv (reg, decimal, reg) */
    say ""
    sayx "Test 16 (ddiv - reg,decimal,reg)"
    inc r2
    load r3,3d
    ddiv r4,9d,r3
    dtos r4
    seq r0,r4,"3"
    brt test16end,r0
    inc r1
    sayx " - failed "
    say r4
test16end:

    /* Test ddiv (reg, reg, reg) - with division by zero */
    say ""
    sayx "Test 16.1 (ddiv - reg,decimal,reg - division by zero)"
    inc r2
    load r3,0d
    sigbr test16_1end, "DIVISION_BY_ZERO" /* Set signal to branch */
    ddiv r4,9d,r3 /* This should cause a signal */
    inc r1
    sayx " - failed "
test16_1end:
    sighalt "DIVISION_BY_ZERO" /* Unset signal handler */

    /* Test DEQ_REG_REG_REG */
    say ""
    sayx "Test 17 (DEQ_REG_REG_REG)"
    inc r2
    load r3,1.23456e3d
    load r4,1.23456e3d
    deq r5,r3,r4
    brt test17end,r5
    inc r1
    sayx " - failed "
    itos r5
    say r5
test17end:

    /* Test DNE_REG_REG_REG */
    say ""
    sayx "Test 18 (DNE_REG_REG_REG)"
    inc r2
    load r3,1.23456e3d
    load r4,1.23457e3d
    dne r5,r3,r4
    brt test18end,r5
    inc r1
    sayx " - failed "
    itos r5
    say r5
test18end:

   /* Test DGT_REG_REG_REG */
    say ""
    sayx "Test 19 (DGT_REG_REG_REG)"
    inc r2
    load r3,1.23457e3d
    load r4,1.23456e3d
    dgt r5,r3,r4
    brt test19end,r5
    inc r1
    sayx " - failed "
    itos r5
    say r5
test19end:

    /* Test DGTE_REG_REG_REG */
    say ""
    sayx "Test 20 (DGTE_REG_REG_REG) - test equals"
    inc r2
    load r3,1.23456e3d
    load r4,1.23456e3d
    dgte r5,r3,r4
    brt test20end,r5
    inc r1
    sayx " - failed "
    itos r5
    say r5
test20end:

    /* Test DGTE_REG_REG_REG */
    say ""
    sayx "Test 21 (DGTE_REG_REG_REG) - test greater"
    inc r2
    load r3,1.23457e3d
    load r4,1.23456e3d
    dgte r5,r3,r4
    brt test21end,r5
    inc r1
    sayx " - failed "
    itos r5
    say r5
test21end:

    /* Test DLT_REG_REG_REG */
    say ""
    sayx "Test 22 (DLT_REG_REG_REG)"
    inc r2
    load r3,1.23456e3d
    load r4,1.23457e3d
    dlt r5,r3,r4
    brt test22end,r5
    inc r1
    sayx " - failed "
    itos r5
    say r5
test22end:

    /* Test DLTE_REG_REG_REG */
    say ""
    sayx "Test 23 (DLTE_REG_REG_REG) - test equals"
    inc r2
    load r3,1.23456e3d
    load r4,1.23456e3d
    dlte r5,r3,r4
    brt test23end,r5
    inc r1
    sayx " - failed "
    itos r5
    say r5
test23end:

    /* Test DLTE_REG_REG_REG */
    say ""
    sayx "Test 24 (DLTE_REG_REG_REG) - test less"
    inc r2
    load r3,1.23456e3d
    load r4,1.23457e3d
    dlte r5,r3,r4
    brt test24end,r5
    inc r1
    sayx " - failed "
    itos r5
    say r5
test24end:

    /* Test DEQ_REG_REG_DECIMAL */
    say ""
    sayx "Test 25 (DEQ_REG_REG_DECIMAL)"
    inc r2
    load r3,1.23456e3d
    deq r4,r3,1234.56d
    brt test25end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test25end:

    /* Test DLTBR_ID_REG_REG - True */
    say ""
    sayx "Test 26 (DLTBR_ID_REG_REG) - test true"
    inc r2
    load r3,1.23456e3d
    load r4,1.23457e3d
    dltbr test26_true,r3,r4
    inc r1
    sayx " - failed "
test26_true:

    /* Test DLTBR_ID_REG_REG - False */
    say ""
    sayx "Test 27 (DLTBR_ID_REG_REG) - test false"
    inc r2
    load r3,1.23457e3d
    load r4,1.23456e3d
    dltbr test27_true,r3,r4
    br test27_end
test27_true:
    inc r1
    sayx " - failed "
test27_end:

    /* Test DGTBR_ID_REG_REG - True */
    say ""
    sayx "Test 28 (DGTBR_ID_REG_REG) - test true"
    inc r2
    load r3,1.23457e3d
    load r4,1.23456e3d
    dgtbr test28_true,r3,r4
    inc r1
    sayx " - failed "
test28_true:

    /* Test DGTBR_ID_REG_REG - False */
    say ""
    sayx "Test 29 (DGTBR_ID_REG_REG) - test false"
    inc r2
    load r3,1.23456e3d
    load r4,1.23457e3d
    dgtbr test29_true,r3,r4
    br test29_end
test29_true:
    inc r1
    sayx " - failed "
test29_end:

    /* Test DEQBR_ID_REG_REG - True */
    say ""
    sayx "Test 30 (DEQBR_ID_REG_REG) - test true"
    inc r2
    load r3,1.23456e3d
    load r4,1.23456e3d
    deqbr test30_true,r3,r4
    inc r1
    sayx " - failed "
test30_true:

    /* Test DEQBR_ID_REG_REG - False */
    say ""
    sayx "Test 31 (DEQBR_ID_REG_REG) - test false"
    inc r2
    load r3,1.23456e3d
    load r4,1.23457e3d
    deqbr test31_true,r3,r4
    br test31_end
test31_true:
    inc r1
    sayx " - failed "
test31_end:

    /* Test DNE_REG_REG_DECIMAL - true */
    say ""
    sayx "Test 32 (DNE_REG_REG_DECIMAL) - test true"
    inc r2
    load r3,1.23456e3d
    dne r4,r3,1234.57d
    brt test32end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test32end:

    /* Test DNE_REG_REG_DECIMAL - false */
    say ""
    sayx "Test 33 (DNE_REG_REG_DECIMAL) - test false"
    inc r2
    load r3,1.23456e3d
    dne r4,r3,1234.56d
    brf test33end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test33end:

    /* Test DGT_REG_REG_DECIMAL - true */
    say ""
    sayx "Test 34 (DGT_REG_REG_DECIMAL) - test true"
    inc r2
    load r3,1.23457e3d
    dgt r4,r3,1234.56d
    brt test34end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test34end:

    /* Test DGT_REG_REG_DECIMAL - false */
    say ""
    sayx "Test 35 (DGT_REG_REG_DECIMAL) - test false"
    inc r2
    load r3,1.23456e3d
    dgt r4,r3,1234.56d
    brf test35end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test35end:

    /* Test DGT_REG_DECIMAL_REG - true */
    say ""
    sayx "Test 36 (DGT_REG_DECIMAL_REG) - test true"
    inc r2
    load r3,1234.56d
    dgt r4,1234.57d,r3
    brt test36end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test36end:

    /* Test DGT_REG_DECIMAL_REG - false */
    say ""
    sayx "Test 37 (DGT_REG_DECIMAL_REG) - test false"
    inc r2
    load r3,1234.56d
    dgt r4,1234.56d,r3
    brf test37end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test37end:

    /* Test DGTE_REG_REG_DECIMAL - true */
    say ""
    sayx "Test 38 (DGTE_REG_REG_DECIMAL) - test true"
    inc r2
    load r3,1.23456e3d
    dgte r4,r3,1234.56d
    brt test38end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test38end:

    /* Test DGTE_REG_REG_DECIMAL - false */
    say ""
    sayx "Test 39 (DGTE_REG_REG_DECIMAL) - test false"
    inc r2
    load r3,1.23456e3d
    dgte r4,r3,1234.57d
    brf test39end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test39end:

    /* Test DGTE_REG_DECIMAL_REG - true */
    say ""
    sayx "Test 40 (DGTE_REG_DECIMAL_REG) - test true"
    inc r2
    load r3,1234.56d
    dgte r4,1234.56d,r3
    brt test40end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test40end:

    /* Test DGTE_REG_DECIMAL_REG - false */
    say ""
    sayx "Test 41 (DGTE_REG_DECIMAL_REG) - test false"
    inc r2
    load r3,1234.57d
    dgte r4,1234.56d,r3
    brf test41end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test41end:

/* Test DLT_REG_REG_DECIMAL - true */
    say ""
    sayx "Test 42 (DLT_REG_REG_DECIMAL) - test true"
    inc r2
    load r3,1.23456e3d
    dlt r4,r3,1234.57d
    brt test42end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test42end:

    /* Test DLT_REG_REG_DECIMAL - false */
    say ""
    sayx "Test 43 (DLT_REG_REG_DECIMAL) - test false"
    inc r2
    load r3,1.23457e3d
    dlt r4,r3,1234.56d
    brf test43end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test43end:

    /* Test DLT_REG_DECIMAL_REG - true */
    say ""
    sayx "Test 44 (DLT_REG_DECIMAL_REG) - test true"
    inc r2
    load r3,1234.57d
    dlt r4,1234.56d,r3
    brt test44end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test44end:

    /* Test DLT_REG_DECIMAL_REG - false */
    say ""
    sayx "Test 45 (DLT_REG_DECIMAL_REG) - test false"
    inc r2
    load r3,1234.56d
    dlt r4,1234.56d,r3
    brf test45end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test45end:

    /* Test DLTE_REG_REG_DECIMAL - true */
    say ""
    sayx "Test 46 (DLTE_REG_REG_DECIMAL) - test true"
    inc r2
    load r3,1.23456e3d
    dlte r4,r3,1234.56d
    brt test46end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test46end:

    /* Test DLTE_REG_REG_DECIMAL - false */
    say ""
    sayx "Test 47 (DLTE_REG_REG_DECIMAL) - test false"
    inc r2
    load r3,1.23457e3d
    dlte r4,r3,1234.56d
    brf test47end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test47end:

    /* Test DLTE_REG_DECIMAL_REG - true */
    say ""
    sayx "Test 48 (DLTE_REG_DECIMAL_REG) - test true"
    inc r2
    load r3,1234.56d
    dlte r4,1234.56d,r3
    brt test48end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test48end:

    /* Test DLTE_REG_DECIMAL_REG - false */
    say ""
    sayx "Test 49 (DLTE_REG_DECIMAL_REG) - test false"
    inc r2
    load r3,1234.56d
    dlte r4,1234.57d,r3
    brf test49end,r4
    inc r1
    sayx " - failed "
    itos r4
    say r4
test49end:

    /* Test DCOPY_REG_REG */
    say ""
    sayx "Test 50 (DCOPY_REG_REG)"
    inc r2
    load r3,1.23456e3d
    dcopy r4,r3
    dtos r4
    seq r0,r4,"1234.56"
    brt test50end,r0
    inc r1
    sayx " - failed "
    say r4
test50end:

    /* Test DSEX_REG */
    say ""
    sayx "Test 51 (DSEX_REG)"
    inc r2
    load r3,1.23456e3d
    dsex r3
    dtos r3
    seq r0,r3,"-1234.56"
    brt test51end,r0
    inc r1
    sayx " - failed "
    say r3
test51end:

    /* Test DPOW_REG_REG_REG */
    say ""
    sayx "Test 52 (DPOW_REG_REG_REG)"
    inc r2
    load r3,2d
    load r4,3d
    dpow r5,r3,r4
    dtos r5
    seq r0,r5,"8"
    brt test52end,r0
    inc r1
    sayx " - failed "
    say r5
test52end:

    /* Test DPOW_REG_REG_DECIMAL */
    say ""
    sayx "Test 53 (DPOW_REG_REG_DECIMAL)"
    inc r2
    load r3,2d
    dpow r4,r3,3d
    dtos r4
    seq r0,r4,"8"
    brt test53end,r0
    inc r1
    sayx " - failed "
    say r4
test53end:

    /* Test DPOW_REG_DECIMAL_REG */
    say ""
    sayx "Test 54 (DPOW_REG_DECIMAL_REG)"
    inc r2
    load r3,3d
    dpow r4,2d,r3
    dtos r4
    seq r0,r4,"8"
    brt test54end,r0
    inc r1
    sayx " - failed "
    say r4
test54end:

    /* Test DEXTR_REG_REG_REG */
    say ""
    sayx "Test 55 (DEXTR_REG_REG_REG)"
    inc r2
    load r5,1234.56789d /* Input Decimal */
    dextr r3,r4,r5
    /* Check r3 - should be "1.23456789" */
    seq r0,r3,"1.23456789"
    brt test55part2,r0
    inc r1
    sayx " - failed coeficient "
    say r3
test55part2:
    /* Check r4 - should be 3 */
    ieq r0,r4,3
    brt test55end,r0
    inc r1
    sayx " - failed exponent "
    itos r4
    say r4
test55end:

    /* Test SETDGTS_REG & GETDGTS_REG */
    say ""
    sayx "Test 56 (SETDGTS_REG & GETDGTS_REG)"
    inc r2
    load r3,5
    setnumdgts r3
    getnumdgts r4
    ieq r0,r4,5
    brt test56end,r0
    inc r1
    sayx " - failed "
    itos r4
    say r4
test56end:

    /* Test SETDGTS_INT & GETDGTS_REG */
    say ""
    sayx "Test 57 (SETDGTS_INT & GETDGTS_REG)"
    inc r2
    setnumdgts 10
    getnumdgts r4
    ieq r0,r4,10
    brt test57end,r0
    inc r1
    sayx " - failed "
    itos r4
    say r4
test57end:

    /* Test decimal literal operand aliases do not clobber source registers */
    say ""
    sayx "Test 58 (decimal literal source/result alias)"
    inc r2
    setnumdgts 20

    load r3,100d
    dadd r3,r3,1d
    dtos r3
    seq r0,r3,"101"
    brt test58sub_rrd,r0
    inc r1
    sayx " - failed dadd r,r,d "
    say r3
test58sub_rrd:
    load r3,100d
    dsub r3,r3,1d
    dtos r3
    seq r0,r3,"99"
    brt test58sub_drr,r0
    inc r1
    sayx " - failed dsub r,r,d "
    say r3
test58sub_drr:
    load r3,1d
    dsub r3,100d,r3
    dtos r3
    seq r0,r3,"99"
    brt test58mult_rrd,r0
    inc r1
    sayx " - failed dsub r,d,r "
    say r3
test58mult_rrd:
    load r3,100d
    dmult r3,r3,2d
    dtos r3
    seq r0,r3,"200"
    brt test58div_rrd,r0
    inc r1
    sayx " - failed dmult r,r,d "
    say r3
test58div_rrd:
    load r3,100d
    ddiv r3,r3,4d
    dtos r3
    seq r0,r3,"25"
    brt test58div_drr,r0
    inc r1
    sayx " - failed ddiv r,r,d "
    say r3
test58div_drr:
    load r3,4d
    ddiv r3,100d,r3
    dtos r3
    seq r0,r3,"25"
    brt test58idiv_rrd,r0
    inc r1
    sayx " - failed ddiv r,d,r "
    say r3
test58idiv_rrd:
    load r3,100d
    didiv r3,r3,4d
    dtos r3
    seq r0,r3,"25"
    brt test58idiv_drr,r0
    inc r1
    sayx " - failed didiv r,r,d "
    say r3
test58idiv_drr:
    load r3,4d
    didiv r3,100d,r3
    dtos r3
    seq r0,r3,"25"
    brt test58mod_rrd,r0
    inc r1
    sayx " - failed didiv r,d,r "
    say r3
test58mod_rrd:
    load r3,101d
    dmod r3,r3,4d
    dtos r3
    seq r0,r3,"1"
    brt test58mod_drr,r0
    inc r1
    sayx " - failed dmod r,r,d "
    say r3
test58mod_drr:
    load r3,4d
    dmod r3,101d,r3
    dtos r3
    seq r0,r3,"1"
    brt test58mod_rrr_left,r0
    inc r1
    sayx " - failed dmod r,d,r "
    say r3
test58mod_rrr_left:
    load r3,101d
    load r4,4d
    dmod r3,r3,r4
    dtos r3
    seq r0,r3,"1"
    brt test58mod_rrr_right,r0
    inc r1
    sayx " - failed dmod r,r,r left alias "
    say r3
test58mod_rrr_right:
    load r3,101d
    load r4,4d
    dmod r4,r3,r4
    dtos r4
    seq r0,r4,"1"
    brt test58pow_rrd,r0
    inc r1
    sayx " - failed dmod r,r,r right alias "
    say r4
test58pow_rrd:
    load r3,2d
    dpow r3,r3,3d
    dtos r3
    seq r0,r3,"8"
    brt test58pow_drr,r0
    inc r1
    sayx " - failed dpow r,r,d "
    say r3
test58pow_drr:
    load r3,3d
    dpow r3,2d,r3
    dtos r3
    seq r0,r3,"8"
    brt test58end,r0
    inc r1
    sayx " - failed dpow r,d,r "
    say r3
test58end:

    /* Test every immediate numeric-context setter and getter. */
    say ""
    sayx "Test 59 (immediate numeric-context setters/getters)"
    inc r2
    setnumdgts 9
    setnumfuz 2
    setnumfrm 2
    setnumcas 2
    setnumstd 2
    getnumdgts r3
    ine r0,r3,9
    brt test59fail,r0
    getnumfuz r3
    ine r0,r3,2
    brt test59fail,r0
    getnumfrm r3
    ine r0,r3,2
    brt test59fail,r0
    getnumcas r3
    ine r0,r3,2
    brt test59fail,r0
    getnumstd r3
    ine r0,r3,2
    brt test59fail,r0
    br test59end
test59fail:
    inc r1
    sayx " - failed"
test59end:

    /* Test every register numeric-context setter and source preservation. */
    say ""
    sayx "Test 60 (register numeric-context setters/getters)"
    inc r2
    load r3,8
    setnumdgts r3
    getnumdgts r4
    ine r0,r4,8
    brt test60fail,r0
    ine r0,r3,8
    brt test60fail,r0
    load r3,1
    setnumfuz r3
    getnumfuz r4
    ine r0,r4,1
    brt test60fail,r0
    ine r0,r3,1
    brt test60fail,r0
    load r3,1
    setnumfrm r3
    getnumfrm r4
    ine r0,r4,1
    brt test60fail,r0
    ine r0,r3,1
    brt test60fail,r0
    load r3,1
    setnumcas r3
    getnumcas r4
    ine r0,r4,1
    brt test60fail,r0
    ine r0,r3,1
    brt test60fail,r0
    load r3,1
    setnumstd r3
    getnumstd r4
    ine r0,r4,1
    brt test60fail,r0
    ine r0,r3,1
    brt test60fail,r0
    br test60end
test60fail:
    inc r1
    sayx " - failed"
test60end:

    /* Test combined scientific setup, readback and provider synchronization. */
    say ""
    sayx "Test 61 (NUMSCI state and decimal effect)"
    inc r2
    numsci 9,2,2
    getnumdgts r3
    ine r0,r3,9
    brt test61fail,r0
    getnumfuz r3
    ine r0,r3,0
    brt test61fail,r0
    getnumfrm r3
    ine r0,r3,1
    brt test61fail,r0
    getnumcas r3
    ine r0,r3,2
    brt test61fail,r0
    getnumstd r3
    ine r0,r3,2
    brt test61fail,r0
    load r3,1d
    load r4,3d
    ddiv r5,r3,r4
    dtos r5
    sne r0,r5,"0.333333333"
    brt test61fail,r0
    br test61end
test61fail:
    inc r1
    sayx " - failed"
test61end:

    /* Test combined engineering setup, readback and provider synchronization. */
    say ""
    sayx "Test 62 (NUMENG state and decimal effect)"
    inc r2
    numeng 6,1,1
    getnumdgts r3
    ine r0,r3,6
    brt test62fail,r0
    getnumfuz r3
    ine r0,r3,0
    brt test62fail,r0
    getnumfrm r3
    ine r0,r3,2
    brt test62fail,r0
    getnumcas r3
    ine r0,r3,1
    brt test62fail,r0
    getnumstd r3
    ine r0,r3,1
    brt test62fail,r0
    load r3,1d
    load r4,3d
    ddiv r5,r3,r4
    dtos r5
    sne r0,r5,"0.333333"
    brt test62fail,r0
    br test62end
test62fail:
    inc r1
    sayx " - failed"
test62end:

    /* Compare combined and expanded state through exponent formatting. */
    say ""
    sayx "Test 63 (combined/expanded numeric-context equivalence)"
    inc r2
    numsci 9,2,2
    load r3,1e20d
    dtos r3
    setnumdgts 9
    setnumfuz 0
    setnumfrm 1
    setnumcas 2
    setnumstd 2
    load r4,1e20d
    dtos r4
    sne r0,r3,r4
    brt test63fail,r0
    numeng 6,1,1
    load r3,1e20d
    dtos r3
    setnumdgts 6
    setnumfuz 0
    setnumfrm 2
    setnumcas 1
    setnumstd 1
    load r4,1e20d
    dtos r4
    sne r0,r3,r4
    brt test63fail,r0
    br test63end
test63fail:
    inc r1
    sayx " - failed"
test63end:

    /* Invalid combined operands must signal before partial context mutation. */
    say ""
    sayx "Test 64 (NUMSCI invalid digits preserve context)"
    inc r2
    numsci 9,1,1
    sigbr test64caught,"INVALID_ARGUMENTS"
    numsci 4,2,2
    inc r1
    sayx " - failed to signal"
    sighalt "INVALID_ARGUMENTS"
    br test64end
test64caught:
    sighalt "INVALID_ARGUMENTS"
    getnumdgts r3
    ine r0,r3,9
    brt test64fail,r0
    getnumfuz r3
    ine r0,r3,0
    brt test64fail,r0
    getnumfrm r3
    ine r0,r3,1
    brt test64fail,r0
    getnumcas r3
    ine r0,r3,1
    brt test64fail,r0
    getnumstd r3
    ine r0,r3,1
    brt test64fail,r0
    br test64end
test64fail:
    inc r1
    sayx " - failed partial mutation"
test64end:

    say ""
    sayx "Test 65 (NUMENG invalid case preserve context)"
    inc r2
    numeng 7,1,2
    sigbr test65caught,"INVALID_ARGUMENTS"
    numeng 8,3,1
    inc r1
    sayx " - failed to signal"
    sighalt "INVALID_ARGUMENTS"
    br test65end
test65caught:
    sighalt "INVALID_ARGUMENTS"
    getnumdgts r3
    ine r0,r3,7
    brt test65fail,r0
    getnumfuz r3
    ine r0,r3,0
    brt test65fail,r0
    getnumfrm r3
    ine r0,r3,2
    brt test65fail,r0
    getnumcas r3
    ine r0,r3,1
    brt test65fail,r0
    getnumstd r3
    ine r0,r3,2
    brt test65fail,r0
    br test65end
test65fail:
    inc r1
    sayx " - failed partial mutation"
test65end:

    say ""
    sayx "Test 66 (NUMSCI invalid standard preserve context)"
    inc r2
    numsci 10,2,1
    sigbr test66caught,"INVALID_ARGUMENTS"
    numsci 11,1,3
    inc r1
    sayx " - failed to signal"
    sighalt "INVALID_ARGUMENTS"
    br test66end
test66caught:
    sighalt "INVALID_ARGUMENTS"
    getnumdgts r3
    ine r0,r3,10
    brt test66fail,r0
    getnumfuz r3
    ine r0,r3,0
    brt test66fail,r0
    getnumfrm r3
    ine r0,r3,1
    brt test66fail,r0
    getnumcas r3
    ine r0,r3,2
    brt test66fail,r0
    getnumstd r3
    ine r0,r3,1
    brt test66fail,r0
    br test66end
test66fail:
    inc r1
    sayx " - failed partial mutation"
test66end:

    /* FUZZ reduces comparison precision without changing stored arithmetic. */
    say ""
    sayx "Test 67 (FUZZ decimal comparison semantics)"
    inc r2
    numsci 9,1,1
    load r3,1.00000001d
    load r4,1.00000000d
    deq r5,r3,r4
    brt test67fail,r5
    deq r5,r3,1.00000000d
    brt test67fail,r5
    setnumfuz 1
    deq r5,r3,r4
    brf test67fail,r5
    deq r5,r3,1.00000000d
    brf test67fail,r5
    load r3,1.00000006d
    deq r5,r3,r4
    brt test67fail,r5
    deq r5,r3,1.00000000d
    brt test67fail,r5
    br test67end
test67fail:
    inc r1
    sayx " - failed"
test67end:

    /* FORM and CASE apply to provider-backed exponential formatting. */
    say ""
    sayx "Test 68 (FORM/CASE decimal formatting semantics)"
    inc r2
    numsci 6,2,1
    load r3,1e20d
    dtos r3
    sne r0,r3,"1E+20"
    brt test68fail,r0
    numeng 6,1,1
    load r3,1e20d
    dtos r3
    sne r0,r3,"100e+18"
    brt test68fail,r0
    br test68end
test68fail:
    inc r1
    sayx " - failed "
    say r3
test68end:

    /* COMMON is half-even while CLASSIC is half-up. */
    say ""
    sayx "Test 69 (STANDARD decimal rounding semantics)"
    inc r2
    numsci 5,1,1
    load r3,1.23445d
    dadd r3,r3,0d
    dtos r3
    sne r0,r3,"1.2344"
    brt test69fail,r0
    numsci 5,1,2
    load r3,1.23445d
    dadd r3,r3,0d
    dtos r3
    sne r0,r3,"1.2345"
    brt test69fail,r0
    numsci 6,1,1
    load r3,12344.5d
    setnumdgts 5
    dadd r3,r3,0d
    dtos r3
    sne r0,r3,"12344"
    brt test69fail,r0
    numsci 6,1,1
    load r3,12345.5d
    setnumdgts 5
    dadd r3,r3,0d
    dtos r3
    sne r0,r3,"12346"
    brt test69fail,r0
    numsci 6,1,1
    load r3,-12344.5d
    setnumdgts 5
    dadd r3,r3,0d
    dtos r3
    sne r0,r3,"-12344"
    brt test69fail,r0
    numsci 6,1,2
    load r3,12344.5d
    setnumdgts 5
    dadd r3,r3,0d
    dtos r3
    sne r0,r3,"12345"
    brt test69fail,r0
    br test69end
test69fail:
    inc r1
    sayx " - failed "
    say r3
test69end:

   /* Print and return results */
   say ""
   sayx "Tests Run: "
   itos r2
   say r2

   sayx "Error Count: "
   itos r1
   say r1

   ret r1
