/* A native COPY hook follows an owned reference through a nested public call.
 * Observe the wrapper at handler entry, before later argument copyback. */
.meta "signal_delivery.trigger"="b" ".int" trigger() "target=.object,payload=.object"
.meta "signal_delivery.mutate"="b" ".int" mutate() "reference=.object"
.globals=0

trigger() .locals=5
    link r0,a1
    mkref r2,r0
    linkattr1 r3,a2,1
    copy r3,r2
    unlink r3
    linkattr1 r3,a2,2
    load r3,1
    unlink r3
    sigbrv handled,r0,"ERROR"
    signal "ERROR",a2
    ret 90
handled:
    typeof r3,r0
    seq r4,r3,".rxfnsb..runtime_signal"
    brf wrong_type,r4
    isinitialized r4,r0
    brf uninitialized,r4
    getattrs r3,r0
    ieq r4,r3,6
    brf wrong_layout,r4
    linkattr1 r1,r0,1
    icopy r2,r1
    unlink r1
    ret r2
wrong_type:
    ret 91
uninitialized:
    ret 92
wrong_layout:
    ret 93

mutate() .locals=4
    linkref r0,a1
    getattrs r1,r0
    ieq r2,r1,6
    brf nochange,r2
    linkattr1 r1,r0,1
    load r1,17
    unlink r1
    ret 1
nochange:
    ret 0
