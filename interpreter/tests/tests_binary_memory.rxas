/*
 * CREXX Interpreter test for typed binary memory RXAS instructions.
 */

.globals=0

main() .locals=40
    load r1,0x
    load r2,32
    bresize r1,r2
    blen r3,r1
    ieq r0,r3,32
    brf fail_resize_len,r0

    load r2,31
    bgetu8 r3,r1,r2
    ieq r0,r3,0
    brf fail_resize_zero_fill,r0

    load r2,17
    bfill r1,r2
    load r2,12
    bgetu8 r3,r1,r2
    ieq r0,r3,17
    brf fail_bfill,r0

    load r2,0
    load r3,255
    bsetu8 r1,r2,r3
    bgetu8 r4,r1,r2
    ieq r0,r4,255
    brf fail_bgetu8,r0
    bgeti8 r4,r1,r2
    ieq r0,r4,-1
    brf fail_bgeti8_sign,r0

    load r2,1
    load r3,-2
    bseti8 r1,r2,r3
    getbyte r4,r1,r2
    ieq r0,r4,254
    brf fail_bseti8_byte,r0
    bgeti8 r4,r1,r2
    ieq r0,r4,-2
    brf fail_bseti8_read,r0

    load r2,2
    load r3,4660
    bsetu16 r1,r2,r3
    bgetu16 r4,r1,r2
    ieq r0,r4,4660
    brf fail_bgetu16,r0
    getbyte r4,r1,r2
    ieq r0,r4,52
    brf fail_bsetu16_byte0,r0
    load r2,3
    getbyte r4,r1,r2
    ieq r0,r4,18
    brf fail_bsetu16_byte1,r0

    load r2,4
    load r3,-1234
    bseti16 r1,r2,r3
    bgeti16 r4,r1,r2
    ieq r0,r4,-1234
    brf fail_bgeti16,r0
    getbyte r4,r1,r2
    ieq r0,r4,46
    brf fail_bseti16_byte0,r0
    load r2,5
    getbyte r4,r1,r2
    ieq r0,r4,251
    brf fail_bseti16_byte1,r0

    load r2,6
    load r3,305419896
    bsetu32 r1,r2,r3
    bgetu32 r4,r1,r2
    ieq r0,r4,305419896
    brf fail_bgetu32,r0
    getbyte r4,r1,r2
    ieq r0,r4,120
    brf fail_bsetu32_byte0,r0
    load r2,7
    getbyte r4,r1,r2
    ieq r0,r4,86
    brf fail_bsetu32_byte1,r0
    load r2,8
    getbyte r4,r1,r2
    ieq r0,r4,52
    brf fail_bsetu32_byte2,r0
    load r2,9
    getbyte r4,r1,r2
    ieq r0,r4,18
    brf fail_bsetu32_byte3,r0

    load r2,10
    load r3,-123456789
    bseti32 r1,r2,r3
    bgeti32 r4,r1,r2
    ieq r0,r4,-123456789
    brf fail_bgeti32,r0
    getbyte r4,r1,r2
    ieq r0,r4,235
    brf fail_bseti32_byte0,r0
    load r2,11
    getbyte r4,r1,r2
    ieq r0,r4,50
    brf fail_bseti32_byte1,r0
    load r2,12
    getbyte r4,r1,r2
    ieq r0,r4,164
    brf fail_bseti32_byte2,r0
    load r2,13
    getbyte r4,r1,r2
    ieq r0,r4,248
    brf fail_bseti32_byte3,r0

    load r2,16
    load r5,1.5
    bsetf64 r1,r2,r5
    bgetf64 r6,r1,r2
    feq r0,r6,1.5
    brf fail_bgetf64,r0
    getbyte r4,r1,r2
    ieq r0,r4,0
    brf fail_bsetf64_byte0,r0
    load r2,22
    getbyte r4,r1,r2
    ieq r0,r4,248
    brf fail_bsetf64_byte6,r0
    load r2,23
    getbyte r4,r1,r2
    ieq r0,r4,63
    brf fail_bsetf64_byte7,r0

    load r7,0x78563412ff80
    load r2,0
    bgetu32 r4,r7,r2
    ieq r0,r4,305419896
    brf fail_const_bgetu32,r0
    load r2,4
    bgeti8 r4,r7,r2
    ieq r0,r4,-1
    brf fail_const_bgeti8_ff,r0
    load r2,5
    bgeti8 r4,r7,r2
    ieq r0,r4,-128
    brf fail_const_bgeti8_80,r0

    bclear r1
    blen r3,r1
    ieq r0,r3,0
    brf fail_bclear,r0

    load r2,4
    bresize r1,r2
    load r2,3
    bgetu8 r3,r1,r2
    ieq r0,r3,0
    brf fail_bclear_resize_zero,r0

    sigbr catch_read_oob,"OUT_OF_RANGE"
    load r2,2
    bgetu32 r3,r1,r2
    br fail_read_oob_signal

catch_read_oob:
    sigbr catch_negative_resize,"OUT_OF_RANGE"
    load r2,-1
    bresize r1,r2
    br fail_negative_resize_signal

catch_negative_resize:
    sigbr catch_write_oob,"OUT_OF_RANGE"
    load r2,3
    load r3,1
    bsetu16 r1,r2,r3
    br fail_write_oob_signal

catch_write_oob:
    sigbr catch_bad_byte,"OUT_OF_RANGE"
    load r2,0
    load r3,256
    bsetu8 r1,r2,r3
    br fail_bad_byte_signal

catch_bad_byte:
    say "PASS: Binary Memory Typed Ops"
    ret 0

fail_resize_len:
    say "FAIL: bresize length mismatch"
    ret 1
fail_resize_zero_fill:
    say "FAIL: bresize did not zero-fill"
    ret 1
fail_bfill:
    say "FAIL: bfill byte mismatch"
    ret 1
fail_bgetu8:
    say "FAIL: bgetu8 mismatch"
    ret 1
fail_bgeti8_sign:
    say "FAIL: bgeti8 sign mismatch"
    ret 1
fail_bseti8_byte:
    say "FAIL: bseti8 byte mismatch"
    ret 1
fail_bseti8_read:
    say "FAIL: bseti8 read mismatch"
    ret 1
fail_bgetu16:
    say "FAIL: bgetu16 mismatch"
    ret 1
fail_bsetu16_byte0:
    say "FAIL: bsetu16 byte 0 mismatch"
    ret 1
fail_bsetu16_byte1:
    say "FAIL: bsetu16 byte 1 mismatch"
    ret 1
fail_bgeti16:
    say "FAIL: bgeti16 mismatch"
    ret 1
fail_bseti16_byte0:
    say "FAIL: bseti16 byte 0 mismatch"
    ret 1
fail_bseti16_byte1:
    say "FAIL: bseti16 byte 1 mismatch"
    ret 1
fail_bgetu32:
    say "FAIL: bgetu32 mismatch"
    ret 1
fail_bsetu32_byte0:
    say "FAIL: bsetu32 byte 0 mismatch"
    ret 1
fail_bsetu32_byte1:
    say "FAIL: bsetu32 byte 1 mismatch"
    ret 1
fail_bsetu32_byte2:
    say "FAIL: bsetu32 byte 2 mismatch"
    ret 1
fail_bsetu32_byte3:
    say "FAIL: bsetu32 byte 3 mismatch"
    ret 1
fail_bgeti32:
    say "FAIL: bgeti32 mismatch"
    ret 1
fail_bseti32_byte0:
    say "FAIL: bseti32 byte 0 mismatch"
    ret 1
fail_bseti32_byte1:
    say "FAIL: bseti32 byte 1 mismatch"
    ret 1
fail_bseti32_byte2:
    say "FAIL: bseti32 byte 2 mismatch"
    ret 1
fail_bseti32_byte3:
    say "FAIL: bseti32 byte 3 mismatch"
    ret 1
fail_bgetf64:
    say "FAIL: bgetf64 mismatch"
    ret 1
fail_bsetf64_byte0:
    say "FAIL: bsetf64 byte 0 mismatch"
    ret 1
fail_bsetf64_byte6:
    say "FAIL: bsetf64 byte 6 mismatch"
    ret 1
fail_bsetf64_byte7:
    say "FAIL: bsetf64 byte 7 mismatch"
    ret 1
fail_const_bgetu32:
    say "FAIL: constant bgetu32 mismatch"
    ret 1
fail_const_bgeti8_ff:
    say "FAIL: constant bgeti8 ff mismatch"
    ret 1
fail_const_bgeti8_80:
    say "FAIL: constant bgeti8 80 mismatch"
    ret 1
fail_bclear:
    say "FAIL: bclear length mismatch"
    ret 1
fail_bclear_resize_zero:
    say "FAIL: bclear followed by bresize did not zero-fill"
    ret 1
fail_read_oob_signal:
    say "FAIL: bgetu32 out-of-range did not signal"
    ret 1
fail_negative_resize_signal:
    say "FAIL: negative bresize did not signal"
    ret 1
fail_write_oob_signal:
    say "FAIL: bsetu16 out-of-range did not signal"
    ret 1
fail_bad_byte_signal:
    say "FAIL: bsetu8 bad byte did not signal"
    ret 1
