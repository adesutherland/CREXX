/* The provider's imported start falls inside this module's main body. */
.globals=0

main() .locals=0
    say "import-bound PASS"
    .srcstep 1 1 17 "import-call.rexx" 12 3 10 "call local"
    call local_fail()
    ret

local_fail() .locals=0
    .srcstep 2 2 17 "import-cause.rexx" 13 1 11 "raise local"
    signal "OTHER","import-bound fault"
    ret

/* The real loader rewrites this declaration with the foreign procedure's
 * start and binarySpace. It must not bound either local procedure. */
diagforeign.probe() .expose=diagforeign.probe
