/* Dynamic selection follows active formal slots, including repeated actuals. */
.globals=0
main() .locals=14
    load r1,10
    load r2,20
    call2 r3,swapped(),r1,r2
    inlenter r4,swapped(),"count=2;args=list(r1,r2);a0=r8;proxies=(r9:1,r10:2);owned=(r8,r9,r10,r11);prep=none",after_swap
    swap r9,r10
    load r11,1
    linkargv r11,r11,0
    ret r11
after_swap:
    ieq r5,r3,20
    brf fail,r5
    ieq r5,r4,20
    brf fail,r5

    call3 r3,repeated(),r1,r1,r2
    inlenter r4,repeated(),"count=3;args=list(r1,r1,r2);a0=r8;proxies=(r9:1,r10:2,r11:3);owned=(r8,r9,r10,r11,r12,r13);prep=none",after_repeat
    link r9,r11
    linkargv r12,1
    ieq r13,r12,20
    brf repeated_bad,r13
    linkargv r12,2
    ieq r13,r12,10
    brf repeated_bad,r13
    unlink r9
    linkargv r12,1
    ieq r13,r12,10
    brf repeated_bad,r13
    swap r9,r11
    linkargv r12,1
    ret r12
repeated_bad:
    ret 101
after_repeat:
    ieq r5,r3,20
    brf fail,r5
    ieq r5,r4,20
    brf fail,r5
    ieq r5,r1,10
    brf fail,r5
    ieq r5,r2,20
    brf fail,r5

    call1 r3,rebound_count(),r1
    inlenter r4,rebound_count(),"count=1;args=list(r1);a0=r8;proxies=(r9:1);owned=(r8,r9,r12,r13);prep=none",after_count
    link r8,r9
    linkargv r12,0
    ieq r13,r12,10
    brf count_bad,r13
    unlink r8
    linkargv r12,0
    ret r12
count_bad:
    ret 102
after_count:
    ieq r5,r3,1
    brf fail,r5
    ieq r5,r4,1
    brf fail,r5

    load r8,77
    load r9,88
    sigbr duplicate_rejected,"RXBIN_CORRUPTION"
    inlenter r4,swapped(),"count=2;args=list(r1,r2);a0=r8;proxies=(r9:1,r10:1);owned=(r8,r9,r10);prep=none",fail
    ret 103
duplicate_rejected:
    ieq r5,r8,77
    brf fail,r5
    ieq r5,r9,88
    brf fail,r5
    sayx "PASS: inline active argument bindings"
    ret 0
fail:
    ret 1

swapped() .locals=1
    swap a1,a2
    linkarg r0,1
    ret r0

repeated() .locals=2
    link a1,a3
    linkarg r0,1
    ieq r1,r0,20
    brf original_bad,r1
    linkarg r0,2
    ieq r1,r0,10
    brf original_bad,r1
    unlink a1
    linkarg r0,1
    ieq r1,r0,10
    brf original_bad,r1
    swap a1,a3
    linkarg r0,1
    ret r0
original_bad:
    ret 104

rebound_count() .locals=2
    link a0,a1
    linkarg r0,0
    ieq r1,r0,10
    brf original_count_bad,r1
    unlink a0
    linkarg r0,0
    ret r0
original_count_bad:
    ret 105
