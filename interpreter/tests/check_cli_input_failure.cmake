if(NOT DEFINED VM OR NOT DEFINED KIND)
    message(FATAL_ERROR "VM and KIND are required")
endif()
set(WORK "${CMAKE_CURRENT_BINARY_DIR}/cli-input-failure-${KIND}")
file(MAKE_DIRECTORY "${WORK}")
set(MISSING "${WORK}/absent.rxbin")
set(INVALID "${WORK}/invalid.rxbin")
file(REMOVE "${MISSING}")
file(WRITE "${INVALID}" "Not an RXBIN container")
foreach(INPUT IN ITEMS "${MISSING}" "${INVALID}")
    execute_process(COMMAND "${VM}" "${INPUT}"
        RESULT_VARIABLE RC OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT RC EQUAL 2 OR NOT ERR MATCHES "ERROR reading module file")
        message(FATAL_ERROR "CLI input failure returned ${RC}: ${OUT}${ERR}")
    endif()
endforeach()
execute_process(COMMAND "${VM}" -v RESULT_VARIABLE RC)
if(NOT RC EQUAL 0)
    message(FATAL_ERROR "Version control returned ${RC}")
endif()
file(REMOVE_RECURSE "${WORK}")
