cmake_minimum_required(VERSION 3.24)
foreach(_required ASSEMBLER LINKER DISASSEMBLER VM HARNESS RECORDS MUTATOR SOURCE WORK)
  if(NOT DEFINED ${_required})
    message(FATAL_ERROR "Missing ${_required}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
function(run_checked _name)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${_dir}" RESULT_VARIABLE _result
    OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 30)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "${_name}: ${_result}\n${_stdout}${_stderr}")
  endif()
  set(_stdout "${_stdout}" PARENT_SCOPE)
endfunction()

foreach(_mode plain optimized)
  set(_dir "${WORK}/${_mode}")
  file(MAKE_DIRECTORY "${_dir}")
  file(COPY_FILE "${SOURCE}/program_entry.rxas" "${_dir}/entry-root.rxas")
  set(_options "")
  if(_mode STREQUAL "plain")
    set(_options -n)
  endif()
  run_checked("assemble ${_mode} marked root" "${ASSEMBLER}" ${_options} entry-root.rxas)
  run_checked("inspect ${_mode} entry header" "${DISASSEMBLER}" entry-root.rxbin)
  string(REGEX MATCHALL "[.]entry=program-default" _markers "${_stdout}")
  list(LENGTH _markers _count)
  string(REGEX MATCHALL "[.]initializer" _initializers "${_stdout}")
  list(LENGTH _initializers _initializer_count)
  if(NOT _count EQUAL 1 OR NOT _initializer_count EQUAL 1 OR NOT _stdout MATCHES "main[(][)][ \t]+[.]locals=3[ \t]+[.]expose=entry[.]start[ \t]+[.]entry=program-default")
    message(FATAL_ERROR "typed entry missing, duplicated or misplaced\n${_stdout}")
  endif()
  file(WRITE "${_dir}/roundtrip.rxas" "${_stdout}")
  run_checked("assemble ${_mode} roundtrip" "${ASSEMBLER}" ${_options} roundtrip.rxas)
  run_checked("link ${_mode} entry image" "${LINKER}" -r entry-root.rxas -o image entry-root.rxbin)
  run_checked("plain VM checked entry ${_mode}" "${VM}" image.rxbin)
  run_checked("API/default/dynamic controls ${_mode}" "${HARNESS}" "${_dir}/image.rxbin")
  if(NOT _stdout MATCHES "PROGRAM_ENTRY_VM[|]failures=0")
    message(FATAL_ERROR "missing executable entry oracle: ${_stdout}")
  endif()
  run_checked("link ${_mode} roundtrip" "${LINKER}" -r roundtrip.rxas -o roundtrip roundtrip.rxbin)
  run_checked("execute ${_mode} roundtrip" "${VM}" roundtrip.rxbin)
  file(WRITE "${_dir}/anchor.rxas" ".globals=0\nanchor() .locals=0\n  ret 91\n")
  run_checked("assemble entry anchor" "${ASSEMBLER}" -n anchor.rxas)
  run_checked("relink and strip marked entry" "${LINKER}" -s -r anchor.rxas -r entry-root.rxas
    -o relinked anchor.rxbin image.rxbin)
  run_checked("API controls after entry relocation" "${HARNESS}" "${_dir}/relinked.rxbin")
  run_checked("inspect stripped entry" "${DISASSEMBLER}" relinked.rxbin)
  if(NOT _stdout MATCHES "[.]entry=program-default")
    message(FATAL_ERROR "stripping lost executable entry contract")
  endif()
endforeach()

set(_dir "${WORK}/negative")
file(MAKE_DIRECTORY "${_dir}")
foreach(_case owner value duplicate)
  if(_case STREQUAL "owner")
    set(_header "helper() .locals=0 .entry=program-default")
  elseif(_case STREQUAL "value")
    set(_header "main() .locals=0 .entry=unknown")
  else()
    set(_header "main() .locals=0 .entry=program-default .entry=program-default")
  endif()
  file(WRITE "${_dir}/${_case}.rxas" ".globals=0\n${_header}\n  ret 0\n")
  execute_process(COMMAND "${ASSEMBLER}" -n "${_case}.rxas" WORKING_DIRECTORY "${_dir}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 30)
  if(_result EQUAL 0)
    message(FATAL_ERROR "accepted malformed entry ${_case}: ${_out}${_err}")
  endif()
endforeach()

# Conflicting entry roles are rejected before assembly opens its output. Both
# metadata orders are handwritable and otherwise use the valid initializer ABI.
set(_initializer ".meta \"entry.boot\"=\"b\" \".void\" main() \"\"\n.meta \"entry.boot\"=\".initializer\" \".void\" main() \"\"\n")
foreach(_order initializer-first entry-first)
  if(_order STREQUAL "initializer-first")
    set(_source ".globals=0\n${_initializer}main() .locals=0 .entry=program-default\n  ret\n")
  else()
    set(_source ".globals=0\nmain() .locals=0 .entry=program-default\n${_initializer}  ret\n")
  endif()
  file(WRITE "${_dir}/${_order}.rxas" "${_source}")
  file(WRITE "${_dir}/role-last-good.rxbin" "last-good")
  file(SHA256 "${_dir}/role-last-good.rxbin" _role_before)
  foreach(_options "-n" "")
    execute_process(COMMAND "${ASSEMBLER}" ${_options} -o role-last-good "${_order}.rxas"
      WORKING_DIRECTORY "${_dir}" RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 30)
    file(SHA256 "${_dir}/role-last-good.rxbin" _role_after)
    if(_result EQUAL 0 OR NOT _role_before STREQUAL _role_after OR
       NOT "${_out}${_err}" MATCHES "program-default main cannot also be a module initializer")
      message(FATAL_ERROR "wrong ${_order} role admission or damaged output: ${_result}\n${_out}${_err}")
    endif()
  endforeach()
endforeach()

# All executable P roles follow the same static target rule, including handler
# installation. Unmarked procedures retain the historical ordinary-call ABI.
foreach(_shape call fixed signal breakpoint)
  if(_shape STREQUAL "call")
    set(_instruction "call main()")
  elseif(_shape STREQUAL "fixed")
    set(_instruction "call1 r0,main(),r0")
  elseif(_shape STREQUAL "signal")
    set(_instruction "sigcall main(),\"OTHER\"")
  else()
    set(_instruction "bpon main()")
  endif()
  file(WRITE "${_dir}/${_shape}.rxas"
    ".globals=0\nmain() .locals=0 .entry=program-default\n  ret 0\nhelper() .locals=1\n  load r0,0\n  ${_instruction}\n  ret\n")
  foreach(_options "-n" "")
    execute_process(COMMAND "${ASSEMBLER}" ${_options} "${_shape}.rxas" WORKING_DIRECTORY "${_dir}"
      RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 30)
    if(_result EQUAL 0 OR NOT "${_out}${_err}" MATCHES "program-default main cannot be an ordinary child-call target")
      message(FATAL_ERROR "wrong static ${_shape} admission: ${_result}\n${_out}${_err}")
    endif()
  endforeach()
endforeach()
file(WRITE "${_dir}/legacy.rxas" ".globals=0\nmain() .locals=0\n  ret 0\nhelper() .locals=0\n  call main()\n  ret\n")
run_checked("unmarked child target remains valid" "${ASSEMBLER}" -n legacy.rxas)
run_checked("unmarked entry remains executable" "${VM}" legacy.rxbin)

file(WRITE "${_dir}/provider.rxas" ".globals=0\nmain() .locals=0 .expose=entry.start .entry=program-default\n  ret 0\n")
file(WRITE "${_dir}/caller.rxas" ".globals=0\ncaller() .locals=0\n  call entry.start()\n  ret\nentry.start() .expose=entry.start\n")
file(WRITE "${_dir}/other.rxas" ".globals=0\nmain() .locals=0 .entry=program-default\n  ret 0\n")
file(WRITE "${_dir}/qualified.rxas" ".globals=0\ncaller() .locals=0\n  call @1::0()\n  ret\n")
foreach(_module provider caller other qualified)
  run_checked("assemble entry link fixture ${_module}" "${ASSEMBLER}" -n "${_module}.rxas")
endforeach()
run_checked("construct sealed forbidden child" "${MUTATOR}" join-seal sealed.rxbin qualified.rxbin provider.rxbin)
run_checked("construct local forbidden child" "${RECORDS}" --static-child local-child.rxbin)
file(WRITE "${_dir}/last-good.rxbin" "last-good")
file(SHA256 "${_dir}/last-good.rxbin" _before)
foreach(_case import ambiguous sealed local)
  if(_case STREQUAL "import")
    set(_arguments -r caller.rxas caller.rxbin provider.rxbin)
    set(_reason "ordinary child-call target")
  elseif(_case STREQUAL "ambiguous")
    set(_arguments -r provider.rxas -r other.rxas provider.rxbin other.rxbin)
    set(_reason "ambiguous program-default entries")
  elseif(_case STREQUAL "sealed")
    set(_arguments -r qualified.rxas sealed.rxbin)
    set(_reason "ordinary child-call target")
  else()
    set(_arguments -r entry-codec local-child.rxbin)
    set(_reason "ordinary child-call target")
  endif()
  execute_process(COMMAND "${LINKER}" -o last-good ${_arguments} WORKING_DIRECTORY "${_dir}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 30)
  file(SHA256 "${_dir}/last-good.rxbin" _after)
  if(_result EQUAL 0 OR NOT _before STREQUAL _after OR NOT "${_out}${_err}" MATCHES "${_reason}")
    message(FATAL_ERROR "bad ${_case} entry admission or last-good publication: ${_result}\n${_out}${_err}")
  endif()
endforeach()
message("PROGRAM_ENTRY_INTEGRATION|failures=0")
