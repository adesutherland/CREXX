/**
 * crexx compiler driver
 * crexx is an executable which controls the phases of the crexx
 * processor, compiles, assembles and executes rexx programs.
 * It optionally compiles the program to a native executable,
 * using the C compiler family recorded by the CMake build.
 * For this, the rxcpacker phase generates a c source file.
 *
 * The options processor can receive files and options in any
 * sequence, where options need at least one dash at the left
 * of the option string. This determines if the strings fed to
 * it are options or filenames. The --args option needs to be last.
 *
 * If a filename has a suffix of .rxpp, the crexx precompiler
 * is invoked to perform its magic - it produces a .crexx
 * which then is compiled and executed, or compiled to an
 * object file which is linked to the interpreter to
 * form a native executable.
 *
 */           

 options levelb comments_dash
 import rxfnsb
 import rxfs
 import concurrency
 import rxhash
 import crexx_build_worker
 
 /* procedure main is what is run when crexx starts execution */
 main: procedure = .int
 arg fn = .string[]
 module = .string[]

 /* defaults for options for this program */
native=0;version=0;help=0;compile=0;filename='';verbose=0
execute=1;linking=0;compile=1;optimize=1;nocolor=0;keep=1;decimal=1
lastfile=0;sourceRoots='';binaryRoots='';importRxas=0;argsStart=0
linkStripSource=1;linkPreserveInline=0;linkMap='';linkOptionsUsed=0
diagnosticsMode='';diagnosticLocale=''
projectMode='';projectOutput='';projectJobs='auto';projectRebuild=0
filenames=.string[];binfiles=.string[];cleanupFiles=.string[];cliArgs=.string[]
 
 esc             = '1b'X
 ANSI_RESET      = '[0m'
 ANSI_GREEN      = '[32m'
 ANSI_BLUE       = '[34m'
 ANSI_RED        = '[31m'
 ANSI_YELLOW     = '[33m'
 ANSI_LINE_CLEAR = '[2K'
 ANSI_LINE_UP    = '[1A'
 
 /* when there are no commandline arguments found, display help */
 if fn[0]=0 then do
   ret = help(nocolor)
   exit
 end
 
 /* determine the path for libraries etc */
 rxpath=''
 env_wanted='CREXX_HOME'
 /* honour CREXX_HOME environment variable when set */
 assembler getenv rxpath,env_wanted
 
 /* if not set, then */
rexx_version = ''
assembler rxvers rexx_version
dirsep = '/'
platform = word(rexx_version,1)
platformUpper = translate(platform)
if  platformUpper = 'WINDOWS' then dirsep = '\'
 if rxpath='' then do
   rxpath=loadpath()
   lastSegment=lastpos(dirsep,rxpath)
   rxpath=substr(rxpath,1,lastSegment-1)
 end
 else do
   if verbose>3 then say 'relpath set from environment CREXX_HOME'
 end
 
 rxpath=rxpath||dirsep /* to avoid having to start -l with a slash */

 libraries='bin'

 modulenumber=1
 /* loop through arguments and find options and program files */
 libs = ""
 do i=1 to fn.0
   if left(fn.i,1)<>'-' then
     do /* it is not a flag but a filename */
       if left(fn.i,2) = './' then fn.i=substr(fn.i,3) -- make shebangs work
       filename=fn.i
       /* check for extensionless files and .exe extensions */
       if right(upper(filename),4) = '.EXE' then do
	 say 'Error: compilation of .exe files is not supported'
	 exit(99)
       end
       if pos('.',filename) = 0 then do
	 /* look whether a .crexx file exists, else fail         */
	 /* this complexity only because we allow default .crexx */
	 select
	   when isfile(filename'.crexx') then filename = filename'.crexx'
           when isfile(filename'.CREXX') then filename = filename'.CREXX'
	 otherwise
	   if pos('.',filename) = 0 then do
	     say 'Error: compilation of extensionless files is not supported.'
	     say '(and no' filename'.crexx was found)'
	     exit(99)
	   end
	 end
       end
       call appendArrayValue filenames, filename
       end
     else
       do
	 /* allow for single- and double dash options */
	 if left(fn.i,2) = '--'  then fn.i=substr(fn.i,2)
	 if fn.i = '-args'       then do
           argsStart = i + 1
           leave
	 end
	 ret = .string
	 if fn.i = '-help'       then ret = help(nocolor)
	 if fn.i = '-exec'       then execute=1
	 if fn.i = '-noexec'     then execute=0
	 if fn.i = '-native'     then native=1
	 if fn.i = '-nonative'   then native=0
	 if fn.i = '-compile'    then compile=1
	 if fn.i = '-nocompile'  then compile=0
	 if fn.i = '-version'    then version=1
	 if fn.i = '-verbose'    then verbose=1
	 if fn.i = '-verbose0'   then verbose=0
	 if fn.i = '-verbose1'   then verbose=1
	 if fn.i = '-verbose2'   then verbose=2
	 if fn.i = '-verbose3'   then verbose=3
	 if fn.i = '-verbose4'   then verbose=4
	 if fn.i = '-color'      then nocolor=0
	 if fn.i = '-colour'     then nocolor=0
	 if fn.i = '-nocolor'    then nocolor=1
	 if fn.i = '-nocolour'   then nocolor=1
	 if fn.i = '-optimize'   then optimize=1
	 if fn.i = '-optimise'   then optimize=1
	 if fn.i = '-nooptimize' then optimize=0
	 if fn.i = '-nooptimise' then optimize=0
	 if fn.i = '-library' | fn.i = '-tool' then do
           requestedMode = substr(fn.i,2)
           if projectMode <> '' & projectMode <> requestedMode then do
             say '--library and --tool are mutually exclusive'
             return 2
           end
           projectMode = requestedMode
           execute = 0
           i = i + 1
           if i > fn.0 then do
             say 'missing output path after --' || requestedMode
             return 2
           end
           projectOutput = fn.i
	 end
	 if fn.i = '-jobs' then do
           i = i + 1
           if i > fn.0 then do
             say 'missing count or auto after --jobs'
             return 2
           end
           projectJobs = lower(fn.i)
	 end
	 else if left(fn.i,6) = '-jobs=' then do
           projectJobs = lower(substr(fn.i,7))
           if projectJobs = '' then do
             say 'missing count or auto after --jobs='
             return 2
           end
	 end
	 if fn.i = '-rebuild' then projectRebuild=1
	 if fn.i = '-keep'       then keep=1
	 if fn.i = '-nokeep'     then keep=0
	 if fn.i = '-nodecimal'  then decimal=0
	 if fn.i = '-decimal'    then decimal=1
	 if fn.i = '-import-rxas' then importRxas=1
	 if fn.i = '-diagnostics' then do
           i = i + 1
           if i > fn.0 then do
             say 'missing mode after' fn.i
             return 2
           end
           diagnosticsMode = lower(fn.i)
	 end
	 else if left(fn.i,12) = '-diagnostics' & fn.i <> '-diagnostics' then do
           diagnosticsMode = lower(substr(fn.i,13))
           if diagnosticsMode = '' then do
             say 'missing mode after' fn.i
             return 2
           end
	 end
	 if fn.i = '-diagnostic-locale' then do
           i = i + 1
           if i > fn.0 then do
             say 'missing locale after' fn.i
             return 2
           end
           diagnosticLocale = fn.i
	 end
	 else if left(fn.i,18) = '-diagnostic-locale' & fn.i <> '-diagnostic-locale' then do
           diagnosticLocale = substr(fn.i,19)
           if diagnosticLocale = '' then do
             say 'missing locale after' fn.i
             return 2
           end
	 end
	 if fn.i = '-no-localisation' | fn.i = '-no-localization' then diagnosticsMode = 'raw'
	 if fn.i = '-localisation' | fn.i = '-localization' then diagnosticsMode = 'localized'
	 if fn.i = '-link-keep-source' then do
           linkStripSource = 0
           linkOptionsUsed = 1
	 end
	 if fn.i = '-link-strip-source' then do
           linkStripSource = 1
           linkOptionsUsed = 1
	 end
	 if fn.i = '-link-keep-inline' then do
           linkPreserveInline = 1
           linkOptionsUsed = 1
	 end
	 if fn.i = '-link-strip-inline' then do
           linkPreserveInline = 0
           linkOptionsUsed = 1
	 end
	 
	 optarg = ''
	 if fn.i = '-source' | fn.i = '-s' then do
           i = i + 1
           if i > fn.0 then do
             say 'missing source root after' fn.i
             return 2
           end
           optarg = fn.i
           sourceRoots = appendSemicolonValue(sourceRoots, optarg)
	 end
	 else if left(fn.i,2) = '-s' & fn.i <> '-source' then do
           optarg = substr(fn.i,3)
           if optarg = '' then do
             say 'missing source root after' fn.i
             return 2
           end
           sourceRoots = appendSemicolonValue(sourceRoots, optarg)
	 end
	 
	 if fn.i = '-i' then do
           i = i + 1
           if i > fn.0 then do
             say 'missing binary import root after -i'
             return 2
           end
           optarg = fn.i
           binaryRoots = appendSemicolonValue(binaryRoots, optarg)
	 end
	 else if left(fn.i,2) = '-i' & fn.i <> '-import-rxas' then do
           optarg = substr(fn.i,3)
           if optarg = '' then do
             say 'missing binary import root after' fn.i
             return 2
           end
           binaryRoots = appendSemicolonValue(binaryRoots, optarg)
	 end
	 
	 if fn.i = '-l' then do
           i = i + 1
           if i > fn.0 then do
             say 'missing library path after -l'
             return 2
           end
           optarg = fn.i
           fullLibrary = resolveLibraryPath(rxpath, dirsep, optarg)
           lastSlash = lastpos('/',fullLibrary)
           if lastSlash = 0 then lastSlash = lastpos('\',fullLibrary)
           libs = libs';'fullLibrary
           if lastSlash > 0 then libraries = libraries';'left(fullLibrary,lastSlash-1)
           else libraries = libraries';'fullLibrary
             modulenumber = modulenumber+1
	   end
	   else if left(fn.i,2)= '-l' & fn.i <> '-l' & left(fn.i,5) <> '-link' then do
             optarg = substr(fn.i,3)
             if optarg = '' then do
               say 'missing library path after' fn.i
               return 2
             end
             fullLibrary = .string
             fullLibrary = resolveLibraryPath(rxpath, dirsep, optarg)
             lastSlash = .int
             lastSlash = lastpos('/',fullLibrary)
             if lastSlash = 0 then lastSlash = lastpos('\',fullLibrary)
             libs = libs';'fullLibrary
             if lastSlash > 0 then libraries = libraries';'left(fullLibrary,lastSlash-1)
             else libraries = libraries';'fullLibrary
               modulenumber = modulenumber+1
	     end
	     
	     if fn.i = '-linkmap' then do
               i = i + 1
               if i > fn.0 then do
		 say 'missing map path after -linkmap'
		 return 2
               end
               linkMap = fn.i
               linkOptionsUsed = 1
	     end
	     else if left(fn.i,8) = '-linkmap' & fn.i <> '-linkmap' then do
               optarg = substr(fn.i,9)
               if optarg = '' then do
		 say 'missing map path after' fn.i
		 return 2
               end
               linkMap = optarg
               linkOptionsUsed = 1
	     end
	   end
	 end
	 
-- keep --args as argv entries so spaces and shell-looking text survive
 if argsStart > 0 then do
   do fn_i=argsStart to fn.0
     call appendArrayValue cliArgs, fn.fn_i
   end
 end
   
   -- rxvme embeds the shipped bytecode libraries, while native packaging
   -- still needs those images as explicit rxlink inputs. User -l values are
   -- required in both modes.
   userLibs = libs
   runtimeLibs = libs
   libs = libs';'rxpath||'bin'dirsep'classlib'
   libs = libs';'rxpath||'bin'dirsep'classlib_native'
   libs = libs';'rxpath||'bin'dirsep'rxfnsc'
   libs = libs';'rxpath||'bin'dirsep'rxfnsg'
   libs = libs';'rxpath||'bin'dirsep'rexxscript'

   -- Legacy native plugins remain explicit runtime/native inputs. Providers
   -- declared in RXBIN metadata are discovered from trusted provider roots.
   libs = libs';'rxpath||'bin'dirsep'rx_treemap'
   libs = libs';'rxpath||'bin'dirsep'rx_llist'
   libs = libs';'rxpath||'bin'dirsep'rx_keyaccess'
   runtimeLibs = runtimeLibs';'rxpath||'bin'dirsep'rx_treemap'
   runtimeLibs = runtimeLibs';'rxpath||'bin'dirsep'rx_llist'
   runtimeLibs = runtimeLibs';'rxpath||'bin'dirsep'rx_keyaccess'
   
   declib = ''
   if \decimal then declib = '-p rxvm_db_decimal'
   if verbose>1 then call logo nocolor  
   
    decstat = rxpath'bin/rxvm_mc_decimal_manual.a'
    decstatMsvc = rxpath'bin/rxvm_mc_decimal_manual.lib'
    if \decimal then decstat =  rxpath'bin/rxvm_db_decimal_manual.a'
    if \decimal then decstatMsvc = rxpath'bin/rxvm_db_decimal_manual.lib'
   
   if verbose>2 then do
     call banner nocolor
     say 'INVOCATION OPTIONS'
     say 'Options in effect:'
    if \nocolor then say '  COLOR'
     else say 'NOCOLOR'
     if decimal  then say '  DECIMAL'
     else say 'NOCDECIMAL'
       
     if execute then say '  EXEC'
     else say 'NOEXEC'
     if native  then say '  NATIVE'
     else say 'NONATIVE'
     if keep  then say '  KEEP'
     else say 'NOKEEP'
     if \optimize  then say 'NOOPTIMIZE'
     else say '  OPTIMIZE'
     if importRxas then say '  IMPORT-RXAS'
     else say 'NOIMPORT-RXAS'
     if diagnosticsMode <> '' then say 'DIAGNOSTICS' diagnosticsMode
     if diagnosticLocale <> '' then say 'DIAGNOSTIC-LOCALE' diagnosticLocale

     say 'VERBOSE' verbose
     say 'SOURCE ROOTS' sourceRoots
     say 'BINARY ROOTS' binaryRoots
     -- call formfeed
     say;say;say
     end

if nocolor then do
  esc             = ''
  ANSI_RESET      = ''
  ANSI_GREEN      = ''
  ANSI_BLUE       = ''
  ANSI_RED        = ''
  ANSI_YELLOW     = ''
  ANSI_LINE_CLEAR = ''
  ANSI_LINE_UP    = ''
end
     
if version then call logo nocolor

if verbose>1 then say esc||ANSI_GREEN'using relpath   :'esc||ANSI_RESET rxpath

lpath = libraries

if verbose>1 then say esc||ANSI_GREEN'using lpath     :'esc||ANSI_RESET lpath
if verbose>1 then say esc||ANSI_GREEN'using s roots   :'esc||ANSI_RESET sourceRoots
if verbose>1 then say esc||ANSI_GREEN'using i roots   :'esc||ANSI_RESET binaryRoots

if linkOptionsUsed & \native then do
  say 'link options require -native'
  return 2
end

if projectMode <> '' then do
  if argsStart > 0 then do
    say '--args is not available with --library or --tool'
    return 2
  end
  if \compile then do
    say '--nocompile is not available with --library or --tool'
    return 2
  end
  if projectMode = 'library' & native then do
    say '--native is available with --tool, not --library'
    return 2
  end
  projectBinaryRoots = rxpath || lpath
  if binaryRoots <> '' then projectBinaryRoots = projectBinaryRoots || ';' || binaryRoots
  return buildProject(projectMode, projectOutput, filenames, projectJobs, projectRebuild, optimize, native, sourceRoots, projectBinaryRoots, binaryRoots, libs, userLibs, importRxas, diagnosticsMode, diagnosticLocale, rxpath, dirsep, platformUpper)
end

/* Output Arrays for command output */
out = .string[]
err = .string[]

/* see if there is a .rxpp file to run the preprocessor against        */
/* while we have no exists(file) function, specify the .rxpp extension */
do i=.int(1) to filenames[0]
  filename=filenames[i]
  sourceFile=filename
  if i=filenames[0] then lastfile=1
    dotpos = lastpos('.',filename)
  if dotpos > 0 then do
    if right(filename,4) = 'rxpp'
    then do /* run the preprocessor */
      filename = left(filename,dotpos-1)
      sourceFile = filename'.crexx'
      /* print the file when verbose ibm style output is requested */
    if verbose>3 then do
      call printFileToSTDout filename'.rxpp', nocolor
    end
    rxppArgs = .string[]
    call appendArrayValue rxppArgs, rxpath||'bin'||dirsep||'rxpp'
    call appendArrayValue rxppArgs, '-i'
    call appendArrayValue rxppArgs, filename'.rxpp'
    call appendArrayValue rxppArgs, '-o'
    call appendArrayValue rxppArgs, filename'.crexx'
    call appendArrayValue rxppArgs, '-m'
    call appendArrayValue rxppArgs, rxpath||'bin'||dirsep||'maclib.rexx'
    call appendArrayValue rxppArgs, '-verbose'
    call appendArrayValue rxppArgs, verbose
    address crexx "run :rxppArgs[]"
    if verbose then do
      if RC = 0 then res=esc||ANSI_GREEN||'OK'esc||ANSI_RESET
      else res = esc||ANSI_RED||RC||esc||ANSI_RESET
	if compile then say '[ 'res' ] rxpp     - Preprocessed   ' esc||ANSI_BLUE||filename'.rxpp'||esc||ANSI_RESET
      end
      if RC\=0 then return RC
    end
  end
  /* if all is well, we now have a .crexx ready for compilation    */

  /* if file has .crexx extension, chop it off */
  if lower(right(filename,6))='.crexx' then filename=substr(filename,1,length(filename)-6)
  /* if file has .rexx extension, chop it off */
  if lower(right(filename,5))='.rexx' then filename=substr(filename,1,length(filename)-5)
  /* if file has .bcrexx extension, chop it off */
  if lower(right(filename,7))='.bcrexx' then filename=substr(filename,1,length(filename)-7) 
  
  optiflag=''; if optimize=0 then optiflag= '-n'
  binaryPath = rxpath||lpath
  if binaryRoots <> '' then binaryPath = binaryPath';'binaryRoots

  binfile = chop_suffix(filename)
  call appendArrayUnique binfiles, binfile

  /* print the file when verbose ibm style output is requested */
  if verbose>3 then do
    if pos('.',sourceFile) = 0 then sourceFile=SourceFile'.crexx'
    call printFileToSTDout sourceFile, nocolor
  end

  -- rxas_filename = chop_suffix(filename) /* temp fix for two-part filename files */

  rxcArgs = .string[]
  call appendArrayValue rxcArgs, rxpath||'bin'||dirsep||'rxc'
  if optiflag <> '' then call appendArrayValue rxcArgs, optiflag
  if sourceRoots <> '' then do
    call appendArrayValue rxcArgs, '-s'
    call appendArrayValue rxcArgs, sourceRoots
  end
  if binaryPath <> '' then do
    call appendArrayValue rxcArgs, '-i'
    call appendArrayValue rxcArgs, binaryPath
  end
  if importRxas then call appendArrayValue rxcArgs, '--import-rxas'
  if diagnosticsMode <> '' then do
    call appendArrayValue rxcArgs, '--diagnostics'
    call appendArrayValue rxcArgs, diagnosticsMode
  end
  if diagnosticLocale <> '' then do
    call appendArrayValue rxcArgs, '--diagnostic-locale'
    call appendArrayValue rxcArgs, diagnosticLocale
  end
  call appendArrayValue rxcArgs, '-o'
  call appendArrayValue rxcArgs, binfile
  call appendArrayValue rxcArgs, sourceFile
  rxcmd = renderCommand(rxcArgs, platformUpper)
  if verbose>1 then
    do
      if compile then say esc||ANSI_GREEN'rxc command     :' rxcmd
	if compile=0 then
	  do
	  say 'rxc does not compile due to --nocompile option'
	end
  end
  rxcOut = .string[]
  rxcErr = .string[]
  if compile then address crexx "run :rxcArgs[]" output rxcOut error rxcErr
  else RC = 0
  do j = 1 to rxcOut.0
    say '> rxc output:' rxcOut.j
  end
  do j = .int(1) to rxcErr.0
    call emitRxcDiagnostic rxcErr.j
  end
  if verbose then do
    res = .string
    if RC = 0 then res=esc||ANSI_GREEN||'OK'esc||ANSI_RESET
    else res = esc||ANSI_RED||RC||esc||ANSI_RESET
    if compile then say '[ 'res' ] rxc      - Compiled       ' esc||ANSI_BLUE||sourceFile||esc||ANSI_RESET
    end
  if RC\=0 then return RC

  if compile then do
/* print the file when verbose ibm style output is requested */
    if verbose>3 then do
      call printFileToSTDout binfile'.rxas', nocolor
    end

    call appendArrayUnique cleanupFiles, binfile'.rxas'
    call appendArrayUnique cleanupFiles, binfile'.rxbin'
    asmArgs = .string[]
    call appendArrayValue asmArgs, rxpath||'bin'||dirsep||'rxas'
    if optiflag <> '' then call appendArrayValue asmArgs, optiflag
    call appendArrayValue asmArgs, '-o'
    call appendArrayValue asmArgs, binfile
    call appendArrayValue asmArgs, binfile
    asmcmd = renderCommand(asmArgs, platformUpper)
    address crexx "run :asmArgs[]" output out error err
    if RC<>0 then say '[rxas     - Assembly Failed    ' esc||ANSI_BLUE||binfile'.rxas'||esc||ANSI_RESET
    if verbose then do
      if verbose>1 then say esc||ANSI_GREEN||'rxas command    :'   asmcmd
      res = .string
      if RC = 0 then res=esc||ANSI_GREEN||'OK'esc||ANSI_RESET
      else res = esc||ANSI_RED||RC||esc||ANSI_RESET
      say '[ 'res' ] rxas     - Assembled      ' esc||ANSI_BLUE||binfile'.rxas'||esc||ANSI_RESET
    end
    if RC\=0 then return RC
  end
  else do
    existingRxbin = binfile'.rxbin'
    if \fileExists(existingRxbin) then do
      say 'missing existing bytecode for -nocompile:' existingRxbin
      return 2
    end
    if verbose>1 then say esc||ANSI_GREEN'using existing rxbin:'esc||ANSI_RESET existingRxbin
  end

  if verbose>2 then call banner nocolor

  if native then do
    linkedOutput = binfile'_linked'
    providerRequirements = linkedOutput'.rxproviders'
    outputStem = binfile
    nativeCompiler = readNativeConfigLine(rxpath, dirsep, 'crexx_native_compiler')
    if nativeCompiler = '' then nativeCompiler = 'gcc'
    nativeCompilerStyle = translate(readNativeConfigLine(rxpath, dirsep, 'crexx_native_compiler_style'))
    if nativeCompilerStyle = '' then nativeCompilerStyle = 'GNU'
    staticLinkArgs = .string[]
    linkInputs = .string[]
    libsRest = .string
    modulePath = .string
    staticModule = .string
    sep = .int
    call appendArrayUnique linkInputs, binfile
    call appendArrayUnique linkInputs, rxpath || 'bin' || dirsep || 'library'
    libsRest = libs
    do while libsRest <> ''
      sep = pos(';', libsRest)
      if sep = 0 then do
        modulePath = libsRest
        libsRest = ''
      end
      else do
        modulePath = left(libsRest, sep - 1)
        libsRest = substr(libsRest, sep + 1)
      end
      if modulePath = '' then iterate
      staticModule = findStaticModule(modulePath)
      if staticModule <> '' then do
        if nativeCompilerStyle = 'MSVC' then
          call appendArrayValue staticLinkArgs, '/WHOLEARCHIVE:' || staticModule
        else if isMacPlatform(platformUpper) then
          call appendArrayValue staticLinkArgs, '-Wl,-force_load,' || staticModule
        else do
          call appendArrayValue staticLinkArgs, '-Wl,--whole-archive'
          call appendArrayValue staticLinkArgs, staticModule
          call appendArrayValue staticLinkArgs, '-Wl,--no-whole-archive'
        end
      end
      else
        call appendArrayUnique linkInputs, modulePath
    end

    linkArgs = .string[]
    call appendArrayValue linkArgs, rxpath || 'bin' || dirsep || 'rxlink'
    if linkStripSource then call appendArrayValue linkArgs, '-s'
    if linkPreserveInline then call appendArrayValue linkArgs, '-i'
    if linkMap <> '' then do
      call appendArrayValue linkArgs, '-m'
      call appendArrayValue linkArgs, linkMap
    end
    call appendArrayValue linkArgs, '-p'
    call appendArrayValue linkArgs, providerRequirements
    call appendArrayValue linkArgs, '-o'
    call appendArrayValue linkArgs, linkedOutput
    loop f=1 to linkInputs[0]
      call appendArrayValue linkArgs, linkInputs[f]
    end
    link_cmd = renderCommand(linkArgs, platformUpper)
    if verbose>1 then say esc||ANSI_GREEN'rxlink command  :'esc||ANSI_RESET link_cmd
    address crexx "run :linkArgs[]" output out error err
    if verbose then do
      res = .string
      if RC = 0 then res=esc||ANSI_GREEN||'OK'esc||ANSI_RESET
      else res = esc||ANSI_RED||RC||esc||ANSI_RESET
      say '[ 'res' ] rxlink   - Linked         ' esc||ANSI_BLUE||linkedOutput'.rxbin'||esc||ANSI_RESET
    end
    if RC\=0 then return RC

    providerRc = appendNativeProviderArgs(staticLinkArgs, providerRequirements, rxpath, dirsep, nativeCompilerStyle, platformUpper)
    if providerRc \= 0 then return providerRc

    packArgs = .string[]
    call appendArrayValue packArgs, rxpath || 'bin' || dirsep || 'rxcpack'
    call appendArrayValue packArgs, '-o'
    call appendArrayValue packArgs, outputStem
    call appendArrayValue packArgs, linkedOutput
    pack_cmd = renderCommand(packArgs, platformUpper)
    if verbose>1 then
    do
      say esc||ANSI_GREEN'rxcpack command :'esc||ANSI_RESET pack_cmd
      end
    address crexx "run :packArgs[]" output out error err
    if verbose then do
      res = .string
      if RC = 0 then res=esc||ANSI_GREEN||'OK'esc||ANSI_RESET
      else res = esc||ANSI_RED||RC||esc||ANSI_RESET
      say '[ 'res' ] rxcpack  - C-Packed ' esc||ANSI_BLUE||outputStem||esc||ANSI_RESET
    end
    if RC\=0 then return RC

    ccArgs = .string[]
    call appendArrayValue ccArgs, nativeCompiler
    if nativeCompilerStyle = 'MSVC' then do
      call appendNativeConfigArgs ccArgs, rxpath, dirsep, 'crexx_native_cflags_argv', 'crexx_native_cflags'
      call appendArrayValue ccArgs, outputStem'.c'
      call appendArrayValue ccArgs, '/Fe:' || outputStem || '.exe'
      call appendArrayValue ccArgs, '/link'
      call appendArrayValue ccArgs, '/INCLUDE:main'
      call appendArrayValue ccArgs, '/LIBPATH:' || rxpath || 'bin'
      call appendArrayValues ccArgs, staticLinkArgs
      call appendMsvcLibrary ccArgs, rxpath, dirsep, 'rxvml'
      call appendMsvcLibrary ccArgs, rxpath, dirsep, 'rxpashim'
      call appendMsvcLibrary ccArgs, rxpath, dirsep, 'rxvmplugin'
      call appendMsvcLibrary ccArgs, rxpath, dirsep, 'rxvmref'
      call appendMsvcLibrary ccArgs, rxpath, dirsep, 'rxvmmemory'
      call appendMsvcLibrary ccArgs, rxpath, dirsep, 'rxbin'
      call appendMsvcLibrary ccArgs, rxpath, dirsep, 'platform'
      call appendArrayValue ccArgs, decstatMsvc
      call appendMsvcLibrary ccArgs, rxpath, dirsep, 'decnumber'
      call appendMsvcLibrary ccArgs, rxpath, dirsep, 'avl_tree'
      call appendMsvcLibrary ccArgs, rxpath, dirsep, 'rxpa'
      call appendArrayValue ccArgs, 'ws2_32.lib'
      call appendNativeConfigArgs ccArgs, rxpath, dirsep, 'crexx_native_libs_argv', 'crexx_native_libs'
      call appendNativeConfigArgs ccArgs, rxpath, dirsep, 'crexx_native_ldflags_argv', 'crexx_native_ldflags'
    end
    else do
      call appendArrayValue ccArgs, '-O3'
      call appendArrayValue ccArgs, '-DNDEBUG'
      call appendNativeConfigArgs ccArgs, rxpath, dirsep, 'crexx_native_cflags_argv', 'crexx_native_cflags'
      if isMacPlatform(platformUpper) then do
        call appendArrayValue ccArgs, '-Wl,-search_paths_first'
        call appendArrayValue ccArgs, '-Wl,-headerpad_max_install_names'
      end
      call appendArrayValue ccArgs, '-o'
      call appendArrayValue ccArgs, outputStem
      call appendArrayValue ccArgs, outputStem'.c'
      call appendArrayValue ccArgs, '-L' || rxpath || 'bin'
      if isMacPlatform(platformUpper) then do
        call appendArrayValue ccArgs, '-lrxvml'
        call appendArrayValue ccArgs, '-lrxpashim'
        call appendArrayValue ccArgs, '-lrxvmplugin'
        call appendArrayValue ccArgs, '-lrxvmref'
        call appendArrayValue ccArgs, '-lrxvmmemory'
        call appendArrayValue ccArgs, '-lrxbin'
        call appendArrayValue ccArgs, '-lplatform'
        call appendArrayValue ccArgs, decstat
        call appendArrayValue ccArgs, '-ldecnumber'
        call appendArrayValue ccArgs, '-lavl_tree'
        call appendArrayValue ccArgs, '-lrxpa'
        call appendArrayValue ccArgs, '-lm'
        call appendNativeConfigArgs ccArgs, rxpath, dirsep, 'crexx_native_libs_argv', 'crexx_native_libs'
        call appendNativeConfigArgs ccArgs, rxpath, dirsep, 'crexx_native_ldflags_argv', 'crexx_native_ldflags'
        call appendArrayValues ccArgs, staticLinkArgs
      end
      else do
        call appendArrayValue ccArgs, '-Wl,--start-group'
        call appendArrayValues ccArgs, staticLinkArgs
        call appendArrayValue ccArgs, '-lrxvml'
        call appendArrayValue ccArgs, '-lrxpashim'
        call appendArrayValue ccArgs, '-lrxvmplugin'
        call appendArrayValue ccArgs, '-lrxvmref'
        call appendArrayValue ccArgs, '-lrxvmmemory'
        call appendArrayValue ccArgs, '-lrxbin'
        call appendArrayValue ccArgs, '-lplatform'
        call appendArrayValue ccArgs, decstat
        call appendArrayValue ccArgs, '-ldecnumber'
        call appendArrayValue ccArgs, '-lavl_tree'
        call appendArrayValue ccArgs, '-lrxpa'
        call appendArrayValue ccArgs, '-lm'
        if isWindowsPlatform(platformUpper) then call appendArrayValue ccArgs, '-lws2_32'
        call appendNativeConfigArgs ccArgs, rxpath, dirsep, 'crexx_native_libs_argv', 'crexx_native_libs'
        call appendNativeConfigArgs ccArgs, rxpath, dirsep, 'crexx_native_ldflags_argv', 'crexx_native_ldflags'
        call appendArrayValue ccArgs, '-Wl,--end-group'
      end
    end
    cc_command = renderCommand(ccArgs, platformUpper)

    if verbose>1 then
      do
	say 'cc compile command:'
	say cc_command
	end
    address crexx "run :ccArgs[]"
    
    if verbose then
      do
	res = .string
	if RC = 0 then res='OK'esc||ANSI_RESET
	else res = esc||ANSI_RED||RC||esc||ANSI_RESET
	say '[ 'res' ] cc        - C-Compiled' esc||ANSI_BLUE||outputStem||esc||ANSI_RESET
	end
    if RC\=0 then return RC  
    if \keep then do
      nativeCleanupFiles = .string[]
      if compile then do
        call appendArrayUnique nativeCleanupFiles, binfile'.rxas'
        call appendArrayUnique nativeCleanupFiles, binfile'.rxbin'
      end
      call appendArrayUnique nativeCleanupFiles, linkedOutput'.rxbin'
      call appendArrayUnique nativeCleanupFiles, providerRequirements
      call appendArrayUnique nativeCleanupFiles, outputStem'.c'
      delrc = deleteFiles(nativeCleanupFiles,verbose)
    end
    end
  else do
    exArgs = .string[]
    call appendArrayValue exArgs, rxpath||'bin'||dirsep||'rxvme'
    if declib <> '' then do
      call appendArrayValue exArgs, '-p'
      call appendArrayValue exArgs, 'rxvm_db_decimal'
    end
    do bf=1 to binfiles[0]
      call appendArrayValue exArgs, binfiles[bf]
    end
    call appendSemicolonValuesToArray exArgs, runtimeLibs
    call appendArrayValue exArgs, '-a'
    call appendArrayValues exArgs, cliArgs
    ex_command = renderCommand(exArgs, platformUpper)

    if verbose>1 then do
      if execute then say 'crexx executes:' ex_command
      if execute=0 then say 'crexx does not execute because of --noexec'
    end
    if lastfile=1 then if execute then do
      address crexx "run :exArgs[]"
      if RC\=0 then return RC
    end
  end
end   -- do i

  /* now determine if the compile/link intermediates need to be deleted */
  delrc = .int
  if \keep & native=0 then delrc = deleteFiles(cleanupFiles,verbose)
  
return 0

projectFileHash: procedure = .string
arg path = .string
do
  return rxhash..sha256filehex(path)
on signal
  return ""
end
return ""

projectReadStamp: procedure = .string
arg path = .string
do
  return readbinary(path) as .string
on signal
  return ""
end
return ""

projectKeyText: procedure = .binary
arg state = .binary, text = .string
state = rxhash..sha256update(state, text as .binary)
state = rxhash..sha256update(state, '00'x as .binary)
return state

projectCandidateHash: procedure = .string
arg candidate = .string
hash = projectFileHash(candidate)
if hash <> '' then return hash
hash = projectFileHash(candidate || '.rxbin')
if hash <> '' then return hash
hash = projectFileHash(candidate || '.rxplugin')
return hash

projectKeyRoots: procedure = .binary
arg state = .binary, roots = .string
rest = roots
do while rest <> ''
  sep = pos(';', rest)
  if sep = 0 then do
    root = rest
    rest = ''
  end
  else do
    root = left(rest, sep - 1)
    rest = substr(rest, sep + 1)
  end
  if root = '' then iterate
  state = projectKeyText(state, root)
  entries = .string[]
  if rxfs..listdir(root, entries) < 0 then do
    state = projectKeyText(state, '<missing-root>')
    iterate
  end
  ignored = arraysort(entries)
  do i = 1 to entries[0]
    candidate = root || '/' || entries[i]
    hash = projectFileHash(candidate)
    if hash <> '' then do
      state = projectKeyText(state, entries[i])
      state = projectKeyText(state, hash)
    end
  end
end
return state

projectActionKey: procedure = .string
arg mode = .string, output = .string, optimize = .int, sources = .string[], sourceRoots = .string, binaryRoots = .string, dependencyBinaryRoots = .string, libraryInputs = .string, rxc = .string, rxas = .string, rxlink = .string
state = rxhash..sha256init()
state = projectKeyText(state, 'crexx-project/v1')
state = projectKeyText(state, mode)
state = projectKeyText(state, output)
state = projectKeyText(state, optimize)
state = projectKeyText(state, sourceRoots)
state = projectKeyText(state, binaryRoots)
state = projectKeyRoots(state, sourceRoots)
state = projectKeyRoots(state, dependencyBinaryRoots)
state = projectKeyText(state, projectFileHash(rxc))
state = projectKeyText(state, projectFileHash(rxas))
state = projectKeyText(state, projectFileHash(rxlink))
do i = 1 to sources[0]
  state = projectKeyText(state, sources[i])
  state = projectKeyText(state, projectFileHash(sources[i]))
end
rest = libraryInputs
do while rest <> ''
  sep = pos(';', rest)
  if sep = 0 then do
    item = rest
    rest = ''
  end
  else do
    item = left(rest, sep - 1)
    rest = substr(rest, sep + 1)
  end
  if item <> '' then do
    state = projectKeyText(state, item)
    state = projectKeyText(state, projectCandidateHash(item))
  end
end
return rxhash..sha256finalhex(state)

projectMemberKey: procedure = .string
arg projectKey = .string, stem = .string
state = rxhash..sha256init()
state = projectKeyText(state, projectKey)
state = projectKeyText(state, stem)
return rxhash..sha256finalhex(state)

projectActionCurrent: procedure = .int
arg output = .string, stamp = .string, key = .string
if rxfs..isfile(output) = 0 then return 0
return projectReadStamp(stamp) = key

projectAbsolutePath: procedure = .string
arg path = .string, cwd = .string, dirsep = .string
if path = '' then return ''
if left(path,1) = '/' | left(path,1) = '\' then return path
if length(path) >= 2 & substr(path,2,1) = ':' then return path
return cwd || dirsep || path

projectDirectory: procedure = .string
arg path = .string
slash = lastpos('/', path)
backslash = lastpos('\', path)
separator = max(slash, backslash)
if separator = 0 then return ''
if separator = 1 then return left(path,1)
return left(path,separator - 1)

projectSourceStem: procedure = .string
arg path = .string
slash = lastpos('/', path)
backslash = lastpos('\', path)
separator = max(slash, backslash)
name = path
if separator > 0 then name = substr(path,separator + 1)
dot = lastpos('.', name)
if dot > 0 then name = left(name,dot - 1)
return translate(name,'_','.')

projectNormalizeRoots: procedure = .string
arg roots = .string, cwd = .string, dirsep = .string
normalized = ''
rest = roots
do while rest <> ''
  sep = pos(';', rest)
  if sep = 0 then do
    item = rest
    rest = ''
  end
  else do
    item = left(rest, sep - 1)
    rest = substr(rest, sep + 1)
  end
  if item <> '' then normalized = appendSemicolonValue(normalized, projectAbsolutePath(item,cwd,dirsep))
end
return normalized

projectMakeDirectory: procedure = .int
arg path = .string
captured = .string[]
errors = .string[]
address crexx "mkdir -p :path" output captured error errors
if rc = 0 then return 0
say 'FAILED: make project directory' path
do i = 1 to errors[0]
  say errors[i]
end
return rc

projectRunArgv: procedure = .int
arg label = .string, argv = .string[]
i = .int
captured = .string[]
errors = .string[]
address crexx "run :argv[]" output captured error errors
commandRc = rc
if commandRc <> 0 then do
  say 'FAILED:' label 'rc=' || commandRc
  do i = 1 to captured[0]
    say captured[i]
  end
  do i = 1 to errors[0]
    say errors[i]
  end
end
return commandRc

projectWriteStamp: procedure = .int
arg path = .string, key = .string
temporary = path || '.tmp'
if writebinary(temporary, key as .binary) <> length(key) then return 1
if rxfs..rename(temporary, path) <> 0 then return 1
return 0

projectCompileRequest: procedure = .channelvalue
arg source = .string, stem = .string, workDir = .string, sourceRoots = .string, binaryRoots = .string, rxc = .string, rxas = .string, key = .string, optimize = .int, importRxas = .int, diagnostics = .string, diagnosticLocale = .string
names = .string[]
values = .channelvalue[]
names[1] = 'binaryRoots'
values[1] = .channelvalue.string_value(binaryRoots)
names[2] = 'diagnosticLocale'
values[2] = .channelvalue.string_value(diagnosticLocale)
names[3] = 'diagnostics'
values[3] = .channelvalue.string_value(diagnostics)
names[4] = 'importRxas'
values[4] = .channelvalue.integer_value(importRxas)
names[5] = 'key'
values[5] = .channelvalue.string_value(key)
names[6] = 'optimize'
values[6] = .channelvalue.integer_value(optimize)
names[7] = 'rxas'
values[7] = .channelvalue.string_value(rxas)
names[8] = 'rxc'
values[8] = .channelvalue.string_value(rxc)
names[9] = 'source'
values[9] = .channelvalue.string_value(source)
names[10] = 'sourceRoots'
values[10] = .channelvalue.string_value(sourceRoots)
names[11] = 'stem'
values[11] = .channelvalue.string_value(stem)
names[12] = 'workDir'
values[12] = .channelvalue.string_value(workDir)
return .channelvalue.record_value('crexx.build.project.compile', 1, names, values)

projectRunCompileWave: procedure = .int
arg jobs = .int, requests = .channelvalue[]
i = .int
if requests[0] = 0 then return 0
workers = min(jobs, requests[0])
pool = .taskpool.local(workers, requests[0] + workers)
scope = .taskscope.collectall(pool, -1)
target = crexx_build_worker..compile_target()
children = .task[]
do i = 1 to requests[0]
  children[i] = scope.submit(target, requests[i])
end
completed = scope.join()
call scope.close()
call pool.close()
failed = 0
do i = 1 to completed[0]
  if completed[i].succeeded() = 0 then do
    say 'FAILED: project compile task' i 'code=' || completed[i].error_code() completed[i].message()
    failed = 1
  end
  else if completed[i].value().as_integer() <> 0 then failed = 1
end
return failed

projectNativeKey: procedure = .string
arg projectKey = .string, rxbin = .string, driver = .string, configRoot = .string, dirsep = .string
state = rxhash..sha256init()
state = projectKeyText(state, 'crexx-project-native/v1')
state = projectKeyText(state, projectKey)
state = projectKeyText(state, projectFileHash(rxbin))
state = projectKeyText(state, projectFileHash(driver))
state = projectKeyText(state, projectFileHash(configRoot || 'bin' || dirsep || 'crexx_native_compiler'))
state = projectKeyText(state, projectFileHash(configRoot || 'bin' || dirsep || 'crexx_native_cflags_argv'))
state = projectKeyText(state, projectFileHash(configRoot || 'bin' || dirsep || 'crexx_native_ldflags_argv'))
state = projectKeyText(state, projectFileHash(configRoot || 'bin' || dirsep || 'crexx_native_libs_argv'))
return rxhash..sha256finalhex(state)

projectPackageNative: procedure = .int
arg outputBase = .string, workRoot = .string, projectKey = .string, rxpath = .string, dirsep = .string, platformName = .string, userLibraries = .string
driver = rxpath || 'bin' || dirsep || 'crexx'
rxbin = outputBase || '.rxbin'
nativeOutput = outputBase
if isWindowsPlatform(platformName) then nativeOutput = outputBase || '.exe'
nativeStamp = workRoot || '/native.action.sha256'
nativeKey = projectNativeKey(projectKey, rxbin, driver, rxpath, dirsep)
if projectActionCurrent(nativeOutput, nativeStamp, nativeKey) then do
  say 'SKIP: native tool current' nativeOutput
  return 0
end

argv = .string[]
call appendArrayValue argv, driver
call appendArrayValue argv, '-native'
call appendArrayValue argv, '-nocompile'
call appendArrayValue argv, '-noexec'
call appendArrayValue argv, '-keep'
rest = userLibraries
do while rest <> ''
  sep = pos(';', rest)
  if sep = 0 then do
    item = rest
    rest = ''
  end
  else do
    item = left(rest, sep - 1)
    rest = substr(rest, sep + 1)
  end
  if item <> '' then do
    call appendArrayValue argv, '-l'
    call appendArrayValue argv, item
  end
end
call appendArrayValue argv, outputBase || '.crexx'
if projectRunArgv('package native project tool', argv) <> 0 then return 1
if rxfs..isfile(nativeOutput) = 0 then return 1
if projectWriteStamp(nativeStamp, nativeKey) <> 0 then return 1
say 'PUBLISHED: native tool' nativeOutput
return 0

buildProject: procedure = .int
arg mode = .string, output = .string, sources = .string[], jobsText = .string, forceRebuild = .int, optimize = .int, native = .int, configuredSourceRoots = .string, configuredBinaryRoots = .string, dependencyBinaryRoots = .string, libraryInputs = .string, userLibraries = .string, importRxas = .int, diagnostics = .string, diagnosticLocale = .string, rxpath = .string, dirsep = .string, platformName = .string
i = .int
j = .int
if output = '' then do
  say 'missing project output path'
  return 2
end
if sources[0] = 0 then do
  say '--' || mode 'requires at least one source file'
  return 2
end

jobs = 5
if jobsText = 'auto' then do
  if platformName = 'MACOS' | platformName = 'MACOSX' then jobs = 30
end
else do
  do
    jobs = jobsText as .int
  on signal
    say 'invalid --jobs value:' jobsText
    return 2
  end
end
if jobs < 1 | jobs > 65535 then do
  say '--jobs must be auto or an integer from 1 through 65535'
  return 2
end

cwd = rxfs..cwd()
resolvedSources = .string[]
stems = .string[]
sourceRoots = projectNormalizeRoots(configuredSourceRoots, cwd, dirsep)
do i = 1 to sources[0]
  resolvedSources[i] = projectAbsolutePath(sources[i], cwd, dirsep)
  if rxfs..isfile(resolvedSources[i]) = 0 then do
    say 'missing project source:' sources[i]
    return 2
  end
  stems[i] = projectSourceStem(resolvedSources[i])
  if stems[i] = '' then do
    say 'cannot derive project member name from:' sources[i]
    return 2
  end
  do j = 1 to i - 1
    if stems[j] = stems[i] then do
      say 'duplicate project member name:' stems[i]
      return 2
    end
  end
  sourceRoots = appendSemicolonValue(sourceRoots, projectDirectory(resolvedSources[i]))
end

binaryRoots = projectNormalizeRoots(configuredBinaryRoots, cwd, dirsep)
dependencyRoots = projectNormalizeRoots(dependencyBinaryRoots, cwd, dirsep)
outputBase = projectAbsolutePath(output, cwd, dirsep)
if lower(right(outputBase,6)) = '.rxbin' then outputBase = left(outputBase,length(outputBase) - 6)
outputDirectory = projectDirectory(outputBase)
if outputDirectory = '' then outputDirectory = cwd
if projectMakeDirectory(outputDirectory) <> 0 then return 1
workRoot = outputBase || '.crexx-build'
memberRoot = workRoot || '/members'
publishRoot = workRoot || '/publish'
if projectMakeDirectory(memberRoot) <> 0 then return 1
if projectMakeDirectory(publishRoot) <> 0 then return 1

rxc = rxpath || 'bin' || dirsep || 'rxc'
rxas = rxpath || 'bin' || dirsep || 'rxas'
rxlink = rxpath || 'bin' || dirsep || 'rxlink'
projectKey = projectActionKey(mode, outputBase, optimize, resolvedSources, sourceRoots, binaryRoots, dependencyRoots, libraryInputs, rxc, rxas, rxlink)
finalOutput = outputBase || '.rxbin'
finalStamp = workRoot || '/product.action.sha256'
if \forceRebuild & projectActionCurrent(finalOutput, finalStamp, projectKey) then do
  say 'SKIP: project current' finalOutput
  if mode = 'tool' & native then return projectPackageNative(outputBase, workRoot, projectKey, rxpath, dirsep, platformName, userLibraries)
  return 0
end

requests = .channelvalue[]
do i = 1 to resolvedSources[0]
  memberDir = memberRoot || '/' || stems[i]
  memberOutput = memberDir || '/' || stems[i] || '.rxbin'
  memberStamp = memberDir || '/action.sha256'
  memberKey = projectMemberKey(projectKey, stems[i])
  if \forceRebuild & projectActionCurrent(memberOutput, memberStamp, memberKey) then
    say 'SKIP: project member current' stems[i]
  else requests[requests[0] + 1] = projectCompileRequest(resolvedSources[i], stems[i], memberDir, sourceRoots, binaryRoots, rxc, rxas, memberKey, optimize, importRxas, diagnostics, diagnosticLocale)
end
if requests[0] > 0 then say 'WAVE: project compile/assemble jobs=' || requests[0]
if projectRunCompileWave(jobs, requests) <> 0 then return 1

privateBase = publishRoot || '/product'
privateOutput = privateBase || '.rxbin'
if rxfs..isfile(privateOutput) then ignored = rxfs..delete(privateOutput)
linkArgs = .string[]
call appendArrayValue linkArgs, rxlink
if optimize then call appendArrayValue linkArgs, '-s'
call appendArrayValue linkArgs, '-o'
call appendArrayValue linkArgs, privateBase
do i = 1 to stems[0]
  call appendArrayValue linkArgs, memberRoot || '/' || stems[i] || '/' || stems[i] || '.rxbin'
end
say 'BARRIER: link' mode
if projectRunArgv('link project ' || mode, linkArgs) <> 0 then return 1
if rxfs..isfile(privateOutput) = 0 then return 1
if rxfs..rename(privateOutput, finalOutput) <> 0 then do
  say 'FAILED: publish project output' finalOutput
  return 1
end
if projectWriteStamp(finalStamp, projectKey) <> 0 then return 1
say 'PUBLISHED:' mode finalOutput

if mode = 'tool' & native then return projectPackageNative(outputBase, workRoot, projectKey, rxpath, dirsep, platformName, userLibraries)
return 0

emitStderr: procedure
arg message = .string
fileid = .int
target = .string
mode = .string
nl = .string
fileid = 0
target = "stderr"
mode = "w"
nl = '0a'x
assembler fopen fileid,target,mode
if fileid = 0 then return
assembler fwrite fileid,message
assembler fwrite fileid,nl
return

emitRxcDiagnostic: procedure
arg line = .string
diag = .string
diag = strip(line)
if left(diag, 10) = "Warning in" | pos("warning(s)", diag) > 0 then do
  call emitStderr "> rxc warning: " || line
  return
end
if left(diag, 8) = "Error in" | pos("error(s)", diag) > 0 then do
  call emitStderr "> rxc error: " || line
  return
end
call emitStderr "> rxc: " || line
return

/*----------------------------------------------------------------------*/
help: procedure = .string
arg nocolor = .string  
call logo nocolor 
say
say 'Arguments are: in_file_specification... [--option]...'
say
say 'The following options are available:'
say
say '-help              -- display (this) help info'
say '-args              -- pass remaining argv entries to the program (final option)'
say '-version           -- display the version number'
say '-exec              -- execute the compiled rxbin (default)'
say '-noexec            -- compile only; do not execute with rxvme'
say '-compile           -- enable compilation to rxbin (default)'
say '-nocompile         -- skip rxc/rxas and reuse an existing .rxbin'
say '-native            -- package a native executable from the compiled program'
say '-nonative          -- disable native packaging (default)'
say '-library output    -- incrementally build explicit sources into output.rxbin'
say '-tool output       -- incrementally build explicit sources into a linked tool'
say '-jobs auto|count   -- bounded parallel project compilation (default auto)'
say '-rebuild           -- force every project member and final link to rebuild'
say '-verbose[0-4]      -- report on progress; default verbose0'
say '-[no]colo[u]r      -- enable or disable colo[u]r output'
say '-[no]optimi[s|z]e  -- enable or disable optimization'
say '-keep              -- keep compile/link intermediates (default)'
say '-nokeep            -- delete compile/link intermediates after the run'
say '-decimal           -- use decimal arithmetic'
say '-l[library path]   -- exact library file path, or packaged name under CREXX_HOME/bin'
say '-s[path]           -- additional source import root for the rxc phase'
say '-i[path]           -- additional raw binary import root for the rxc phase'
say '--import-rxas      -- allow the rxc phase to auto-import .rxas from binary roots'
say '--diagnostics mode -- rxc diagnostics: localized or raw'
say '--diagnostic-locale locale -- diagnostic locale such as en_GB or en_US'
say '--no-localisation  -- use raw diagnostic code/parameter rendering'
say '--linkmap path     -- write an rxlink map file when using -native'
say '--link-keep-source -- keep source/TRACE debug metadata in the linked native image'
say '--link-keep-inline -- keep inline-body metadata in the linked native image'
say
say 'Source files without OPTIONS use rxc file-type defaults: .rexx is Level C'
say 'and .crexx/.crx are Level G.'
say 'Options -s, -i and --import-rxas affect compilation only; runtime/native loading uses -l.'
say '--library and --tool optimize by default, compile explicit sources in one parallel'
say 'wave, link only after that wave succeeds, and publish the final RXBIN atomically.'
say 'Use --nooptimize for diagnostic parity; --tool also accepts --native.'
say 'Native packaging uses rxlink before rxcpack; declared provider archives and explicit'
say 'plugin/static libraries are linked with platform-appropriate retention flags.'
say
say 'all options can also be prefixed with --'
return 'help done'

/*----------------------------------------------------------------------*/
logo: procedure
arg nocolor = .string
rversion = ''
/* note that for brevity we use an assembler directive to get to the version */
assembler rxvers rversion
rvers = word(rversion,3)
rbuild = word(rversion,1) word(rversion,2) word(rversion,4)
esc = '1b'x
if nocolor then do
  say 'CREXX compiler driver' rvers '('rbuild')'
end
else do
  say esc'[33mCREXX compiler driver' esc'[34m'rvers esc'[0m ('rbuild')'
end
say 'cREXX License (MIT)'
say 'Copyright (c) 2020-2026 Adrian Sutherland, Peter Jacob, René Jansen'
say 'See https://github.com/adesutherland/CREXX for project details'
return

/*----------------------------------------------------------------------*/
printarray: procedure = .string
arg toprint = .string[]
loop i=1 to toprint.0
  say toprint.i
end
return 'printed'

  
banner: procedure
arg nocolor = .string
rversion = ''
/* note that for brevity we use an assembler directive to get to the version */
assembler rxvers rversion
rvers2 = word(rversion,3)

esc = '1b'x
if nocolor then do
  say '======> RexxLA cREXX compiler 'rvers2'            'date() time()
  end
else say esc'[34m'||'======> RexxLA cREXX compiler 'rvers2'            'date() time() esc'[0m'
say;say

formfeed: procedure
say x2c('0C')

printFileToSTDout: procedure
arg toread = .string, nocolor = .string
call banner nocolor
say '  LINENUM' copies('----+',15)
i=1
do while lines(toread)
  say '   'right(i,6,'0') linein(toread)
  i=i+1
end
call lineout toread

/**
 * delete the files (when crexx option = --nokeep)
 * and log this when verbosity > 2
 * @parm filenames .string containing file paths
 * @return .int
 */
deleteFiles: procedure = .int
arg filenames = .string[], verbosity = .int
loop i=1 to filenames[0]
  filename = filenames[i]
  if verbosity > 2 then say 'deleting' filename
  rc = delete(filename)
end
return 0

/*
 * chop_suffix gets rid of file extensions
 * and changes dots to underscores
 * if they are not the separator
 */

chop_suffix: procedure = .string
  arg fn = .string
  path=''
  name=fn
  p1 = lastpos('/', fn)  /* find last path separator */
  p2 = lastpos('\', fn)
  p  = max(p1, p2)
  if p > 0 then do
     path = left(fn, p)
     name = substr(fn, p + 1)
  end
  lp = lastpos('.', name)
  if lp > 0 then name = left(name, lp - 1)
return path || translate(name, '_', '.')

appendSemicolonValue: procedure = .string
arg current = .string, value = .string
if value = '' then return current
if current = '' then return value
return current';'value

resolveLibraryPath: procedure = .string
arg rxpath = .string, dirsep = .string, candidate = .string
if pos('/', candidate) > 0 | pos('\', candidate) > 0 then return candidate
return rxpath || 'bin' || dirsep || candidate

appendWordUnique: procedure = .string
arg current = .string, value = .string
if value = '' then return current
if current = '' then return value
if wordpos(value, current) > 0 then return current
return current value

appendArrayValue: procedure
arg expose current = .string[], item = .string
index = .int
index = current[0] + 1
current[index] = item
return

appendArrayUnique: procedure
arg expose current = .string[], item = .string
i = .int
if item = '' then return
do i = 1 to current[0]
  if current[i] = item then return
end
call appendArrayValue current, item
return

appendArrayValues: procedure
arg expose current = .string[], values = .string[]
i = .int
do i = 1 to values[0]
  call appendArrayValue current, values[i]
end
return

appendSemicolonValuesToArray: procedure
arg expose current = .string[], values = .string
rest = .string
item = .string
sep = .int
rest = values
do while rest <> ''
  sep = pos(';', rest)
  if sep = 0 then do
    item = rest
    rest = ''
  end
  else do
    item = left(rest, sep - 1)
    rest = substr(rest, sep + 1)
  end
  if item <> '' then call appendArrayValue current, item
end
return

appendCommandArg: procedure = .string
arg command = .string, item = .string, platformName = .string
if item = '' then return command
if command = '' then return quoteCommandArg(item, platformName)
return command || ' ' || quoteCommandArg(item, platformName)

renderCommand: procedure = .string
arg argv = .string[], platformName = .string
command = .string
i = .int
command = ''
do i = 1 to argv[0]
  command = appendCommandArg(command, argv[i], platformName)
end
return command

appendSemicolonArgs: procedure = .string
arg command = .string, values = .string, platformName = .string
rest = .string
item = .string
sep = .int
rest = values
do while rest <> ''
  sep = pos(';', rest)
  if sep = 0 then do
    item = rest
    rest = ''
  end
  else do
    item = left(rest, sep - 1)
    rest = substr(rest, sep + 1)
  end
  if item <> '' then command = appendCommandArg(command, item, platformName)
end
return command

quoteCommandArg: procedure = .string
arg item = .string, platformName = .string
if item = '' then return '""'
if pos('"', item) = 0 then return '"' || item || '"'
if \isWindowsPlatform(platformName) & pos("'", item) = 0 then return "'" || item || "'"
return '"' || item || '"'

findStaticModule: procedure = .string
arg modulePath = .string
staticModule = modulePath || '_static.a'
if fileExists(staticModule) then return staticModule
staticModule = modulePath || '_static.lib'
if fileExists(staticModule) then return staticModule
return ''

appendNativeProviderArgs: procedure = .int
arg expose current = .string[], requirementsFile = .string, rxpath = .string, dirsep = .string, compilerStyle = .string, platformName = .string
header = .string
line = .string
status = .string
providerId = .string
tab = .string
firstTab = .int
rest = .string
secondTab = .int
providerDir = .string
staticSuffix = .string
canonicalStaticPath = .string
legacyStaticPath = .string
staticPath = .string
required = .int
seenProviders = .string
requiredProviders = .string

providerDir = rxpath || 'bin' || dirsep || 'providers' || dirsep
if compilerStyle = 'MSVC' then staticSuffix = '.lib'
else staticSuffix = '.a'

if \fileExists(requirementsFile) then do
  say 'missing native provider requirements:' requirementsFile
  return 2
end
header = linein(requirementsFile)
if header \= 'CREXX-RXPA-REQUIREMENTS 1' then do
  call lineout requirementsFile
  say 'invalid native provider requirements:' requirementsFile
  return 2
end
tab = '09'X
requiredProviders = ';'
do while lines(requirementsFile)
  line = linein(requirementsFile)
  if line = '' then iterate
  firstTab = pos(tab, line)
  if firstTab = 0 then do
    call lineout requirementsFile
    say 'invalid native provider requirement:' line
    return 2
  end
  status = left(line, firstTab - 1)
  rest = substr(line, firstTab + 1)
  secondTab = pos(tab, rest)
  if secondTab = 0 then do
    call lineout requirementsFile
    say 'invalid native provider requirement:' line
    return 2
  end
  providerId = left(rest, secondTab - 1)
  if status \= 'required' & status \= 'optional' then do
    call lineout requirementsFile
    say 'invalid native provider policy:' status
    return 2
  end
  if status = 'required' & pos(';' || providerId || ';', requiredProviders) = 0 then
    requiredProviders = requiredProviders || providerId || ';'
end
call lineout requirementsFile
header = linein(requirementsFile)
seenProviders = ';'
do while lines(requirementsFile)
  line = linein(requirementsFile)
  if line = '' then iterate
  firstTab = pos(tab, line)
  if firstTab = 0 then do
    call lineout requirementsFile
    say 'invalid native provider requirement:' line
    return 2
  end
  status = left(line, firstTab - 1)
  rest = substr(line, firstTab + 1)
  secondTab = pos(tab, rest)
  if secondTab = 0 then do
    call lineout requirementsFile
    say 'invalid native provider requirement:' line
    return 2
  end
  providerId = left(rest, secondTab - 1)
  if status \= 'required' & status \= 'optional' then do
    call lineout requirementsFile
    say 'invalid native provider policy:' status
    return 2
  end
  required = pos(';' || providerId || ';', requiredProviders) > 0
  if pos(';' || providerId || ';', seenProviders) > 0 then iterate
  seenProviders = seenProviders || providerId || ';'

  canonicalStaticPath = providerDir || providerId || staticSuffix
  legacyStaticPath = providerDir || providerId || '_static' || staticSuffix
  staticPath = ''
  if fileExists(canonicalStaticPath) then staticPath = canonicalStaticPath
  else if fileExists(legacyStaticPath) then staticPath = legacyStaticPath
  if staticPath = '' then do
    if required then do
      call lineout requirementsFile
      say 'missing native provider archive:' canonicalStaticPath '(legacy:' legacyStaticPath')'
      return 2
    end
    iterate
  end
  if compilerStyle = 'MSVC' then
    call appendArrayValue current, '/WHOLEARCHIVE:' || staticPath
  else if isMacPlatform(platformName) then
    call appendArrayValue current, '-Wl,-force_load,' || staticPath
  else do
    call appendArrayValue current, '-Wl,--whole-archive'
    call appendArrayValue current, staticPath
    call appendArrayValue current, '-Wl,--no-whole-archive'
  end
end
call lineout requirementsFile
return 0

appendMsvcLibrary: procedure
arg expose current = .string[], rxpath = .string, dirsep = .string, libraryName = .string
call appendArrayValue current, rxpath || 'bin' || dirsep || libraryName || '.lib'
return

isMacPlatform: procedure = .int
arg platformName = .string
platformUpper = translate(platformName)
if platformUpper = 'MACOS' | platformUpper = 'MACOSX' then return 1
return 0

isWindowsPlatform: procedure = .int
arg platformName = .string
platformUpper = translate(platformName)
if platformUpper = 'WINDOWS' | platformUpper = 'WIN32' | platformUpper = 'WIN64' then return 1
return 0

readNativeRuntimeLinkLibs: procedure = .string
arg rxpath = .string, dirsep = .string
return readNativeConfigLine(rxpath, dirsep, 'crexx_native_libs')

readNativeCompileFlags: procedure = .string
arg rxpath = .string, dirsep = .string
return readNativeConfigLine(rxpath, dirsep, 'crexx_native_cflags')

readNativeLinkFlags: procedure = .string
arg rxpath = .string, dirsep = .string
return readNativeConfigLine(rxpath, dirsep, 'crexx_native_ldflags')

appendNativeConfigArgs: procedure
arg expose current = .string[], rxpath = .string, dirsep = .string, argvFileName = .string, fallbackFileName = .string
configFile = .string
configArg = .string
configFile = rxpath || 'bin' || dirsep || argvFileName
if fileExists(configFile) then do
  do while lines(configFile)
    configArg = linein(configFile)
    if configArg <> '' then call appendArrayValue current, configArg
  end
  call lineout configFile
  return
end
call appendWordsToArray current, readNativeConfigLine(rxpath, dirsep, fallbackFileName)
return

appendWordsToArray: procedure
arg expose current = .string[], text = .string
i = .int
do i = 1 to words(text)
  call appendArrayValue current, word(text, i)
end
return

readNativeConfigLine: procedure = .string
arg rxpath = .string, dirsep = .string, fileName = .string
configFile = rxpath || 'bin' || dirsep || fileName
if \fileExists(configFile) then return ''
line = linein(configFile)
call lineout configFile
return strip(line)

fileExists: procedure = .int
arg filePath = .string
if isfile(filePath) then return 1
return 0
  
/* ---------------------------------------------------------------------
* ISRXPP procedure checks for type of file
* Returns:
*  -1 = file could not be loaded / empty
*   0 = not recognised as REXX/RXPP
*   1 = RXPP/preprocessor source
*   2 = likely plain REXX source
* ---------------------------------------------------------------------
*/
isrxpp: procedure=.int
  arg file=.string

  /* Load the whole source as text. This is cheap enough for source files and avoids line-by-line I/O overhead. */
  code=loadText(file)

  /* Empty or unreadable files cannot be classified. */
  if length(code)<1 then return -1

  code=upper(code)  /* Case-insensitive scan. */

  /* Direct RXPP directives. These are strong evidence that the file must pass through the preprocessor. */
  if pos('##IF',code)    >0 then return 1
  if pos('##CFLAGS',code)>0 then return 1
  if pos('##ELSE',code)  >0 then return 1
  if pos('##SET',code)   >0 then return 1

  /* Generic RXPP/macro marker scan.
     A plain '##' is not enough by itself because it may occur in comments or
     strings. verifyMacCall() performs a cheap follow-up check. */
  ppi=pos('##',code)
  do while ppi>0
     if verifyMacCall(code,ppi)=1 then return 1
     ppi=pos('##',code,ppi+2)
  end

  /* Plain REXX smoke test.
     These checks do not prove correctness; they only avoid classifying obvious
     REXX programs as unknown when no RXPP marker was found. */
  if pos('SAY ',code)    >0 then return 2
  if pos('SUBSTR(',code) >0 then return 2
  if pos('POS(',code)    >0 then return 2
  if pos('LEFT(',code)   >0 then return 2
  if pos('RIGHT(',code)  >0 then return 2
  if pos('IF ',code)     >0 then return 2
  if pos('CALL ',code)   >0 then return 2
return 0
/* ---------------------------------------------------------------------
* Checks whether a found '##' looks like an RXPP macro/directive start.
* Current heuristic:
*  - '## ' is ignored.
*  - '##' followed by A-Z or '_' is treated as RXPP.
* ---------------------------------------------------------------------
*/
verifyMacCall: procedure=.int
  arg expose code=.string, startpos=.int

  /* Character immediately after '##'. */
  firstchar=substr(code,startpos+2,1)

  /* Ignore blank after ##. */
  if firstchar =' ' then return 0

  /* RXPP directives/macros normally start with a letter or underscore. */
  if pos(firstchar, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ_') > 0 then return 1
return 0
