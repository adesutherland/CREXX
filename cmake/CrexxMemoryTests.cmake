# Component memory tests stop at the output of the instrumented component.
# These input images are generated by the ordinary donor in split assurance.
set(_memory_dir "${CMAKE_BINARY_DIR}/tests/memory")
file(MAKE_DIRECTORY "${_memory_dir}")
set(_memory_source "${CMAKE_SOURCE_DIR}/tests/memory")
crexx_add_fixture_command(
    OUTPUT "${_memory_dir}/shared.rxbin"
    BYPRODUCTS "${_memory_dir}/provider.rxas" "${_memory_dir}/provider.rxbin"
    COMMAND $<TARGET_FILE:rxc> -x --no-exe-import -i "${CMAKE_BINARY_DIR}/bin"
        -o "${_memory_dir}/provider" "${_memory_source}/san008_provider.crexx"
    COMMAND $<TARGET_FILE:rxas> -o "${_memory_dir}/provider" "${_memory_dir}/provider.rxas"
    COMMAND $<TARGET_FILE:rxlink> -s -r provider -o "${_memory_dir}/shared"
        "${_memory_dir}/provider.rxbin"
    DEPENDS rxc rxas rxlink compiler_exit_bin library
        "${CMAKE_BINARY_DIR}/bin/rxcexits.rxbin" "${_memory_source}/san008_provider.crexx"
    VERBATIM)
set(_memory_inputs "${_memory_dir}/shared.rxbin")
foreach(_stem tests_link_root tests_link_provider_a tests_link_provider_b tests_link_signature_bad_impl)
    crexx_add_fixture_command(OUTPUT "${_memory_dir}/${_stem}.rxbin"
        COMMAND $<TARGET_FILE:rxas> -o "${_memory_dir}/${_stem}"
            "${CMAKE_SOURCE_DIR}/linker/tests/${_stem}.rxas"
        DEPENDS rxas "${CMAKE_SOURCE_DIR}/linker/tests/${_stem}.rxas" VERBATIM)
    list(APPEND _memory_inputs "${_memory_dir}/${_stem}.rxbin")
endforeach()
add_custom_target(memory_tool_fixtures ALL DEPENDS ${_memory_inputs})

foreach(_stage compiler assembler linker disassembler precomp)
    if(_stage STREQUAL compiler)
        set(_tool rxc)
    elseif(_stage STREQUAL assembler)
        set(_tool rxas)
    elseif(_stage STREQUAL linker)
        set(_tool rxlink)
    elseif(_stage STREQUAL disassembler)
        set(_tool rxdas)
    else()
        set(_tool rxpp)
    endif()
    add_test(NAME memory_${_stage}_lifecycle
        COMMAND ${CMAKE_COMMAND}
            -DSTAGE=${_stage} -DTOOL=$<TARGET_FILE:${_tool}>
            -DSOURCE=${CMAKE_SOURCE_DIR} -DINPUT=${_memory_dir}
            -DWORK=${_memory_dir}/${_stage} -DBIN=${CMAKE_BINARY_DIR}/bin
            -P "${_memory_source}/tool_lifecycle.cmake")
    set_tests_properties(memory_${_stage}_lifecycle PROPERTIES
        LABELS "sanitizer;memory;${_stage}" TIMEOUT 300
        CREXX_PREP_TARGETS "${_tool}")
endforeach()
# Target ownership is explicit; stage labels are not target names.
set_tests_properties(memory_compiler_lifecycle PROPERTIES CREXX_PREP_TARGETS "rxc;library;compiler_exit_bin")
set_tests_properties(memory_assembler_lifecycle PROPERTIES CREXX_PREP_TARGETS "rxas")
set_tests_properties(memory_linker_lifecycle PROPERTIES CREXX_PREP_TARGETS "rxlink;memory_tool_fixtures")
set_tests_properties(memory_disassembler_lifecycle PROPERTIES CREXX_PREP_TARGETS "rxdas;memory_tool_fixtures")
set_tests_properties(memory_precomp_lifecycle PROPERTIES CREXX_PREP_TARGETS "rxpp")
add_test(NAME memory_classic_compiler_lifecycle
    COMMAND ${CMAKE_COMMAND} -DSTAGE=classic -DTOOL=$<TARGET_FILE:rxc-c>
        -DSOURCE=${CMAKE_SOURCE_DIR} -DWORK=${_memory_dir}/classic -DBIN=${CMAKE_BINARY_DIR}/bin
        -P "${_memory_source}/tool_lifecycle.cmake")
set_tests_properties(memory_classic_compiler_lifecycle PROPERTIES
    LABELS "sanitizer;memory;compiler" TIMEOUT 300
    CREXX_PREP_TARGETS "rxc-c;library;compiler_exit_bin")
add_test(NAME memory_san008_import_bounds
    COMMAND ${CMAKE_COMMAND} -DSTAGE=san008 -DTOOL=$<TARGET_FILE:rxc>
        -DSOURCE=${CMAKE_SOURCE_DIR} -DINPUT=${_memory_dir} -DBIN=${CMAKE_BINARY_DIR}/bin
        -DWORK=${_memory_dir}/san008 -P "${_memory_source}/tool_lifecycle.cmake")
set_tests_properties(memory_san008_import_bounds PROPERTIES
    LABELS "sanitizer;memory;compiler;san-008" TIMEOUT 300
    CREXX_PREP_TARGETS "rxc;memory_tool_fixtures;library;compiler_exit_bin")
crexx_label_smoke_tests(memory_compiler_lifecycle memory_classic_compiler_lifecycle
    memory_assembler_lifecycle memory_linker_lifecycle memory_san008_import_bounds
    memory_disassembler_lifecycle memory_precomp_lifecycle)
crexx_finalize_directory_qa_tiers()
