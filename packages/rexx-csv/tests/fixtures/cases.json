{
  "schema_version": 1,
  "profile": "rexx-csv-0.1",
  "cases": [
    {
      "id": "P001",
      "description": "Empty document",
      "operation": "parse",
      "input": "",
      "expected": {
        "ok": true,
        "rows": []
      }
    },
    {
      "id": "P002",
      "description": "One record without final separator",
      "operation": "parse",
      "input": "a,b",
      "expected": {
        "ok": true,
        "rows": [
          [
            "a",
            "b"
          ]
        ]
      }
    },
    {
      "id": "P003",
      "description": "Final CRLF adds no record",
      "operation": "parse",
      "input": "a,b\r\n",
      "expected": {
        "ok": true,
        "rows": [
          [
            "a",
            "b"
          ]
        ]
      }
    },
    {
      "id": "P004",
      "description": "Final LF adds no record",
      "operation": "parse",
      "input": "a,b\n",
      "expected": {
        "ok": true,
        "rows": [
          [
            "a",
            "b"
          ]
        ]
      }
    },
    {
      "id": "P005",
      "description": "Two records",
      "operation": "parse",
      "input": "a,b\r\nc,d",
      "expected": {
        "ok": true,
        "rows": [
          [
            "a",
            "b"
          ],
          [
            "c",
            "d"
          ]
        ]
      }
    },
    {
      "id": "P006",
      "description": "Mixed CRLF and LF record endings",
      "operation": "parse",
      "input": "a\r\nb\nc\r\n",
      "expected": {
        "ok": true,
        "rows": [
          [
            "a"
          ],
          [
            "b"
          ],
          [
            "c"
          ]
        ]
      }
    },
    {
      "id": "P007",
      "description": "Quoted comma",
      "operation": "parse",
      "input": "\"a,b\",c",
      "expected": {
        "ok": true,
        "rows": [
          [
            "a,b",
            "c"
          ]
        ]
      }
    },
    {
      "id": "P008",
      "description": "Doubled quote",
      "operation": "parse",
      "input": "\"a\"\"b\",c",
      "expected": {
        "ok": true,
        "rows": [
          [
            "a\"b",
            "c"
          ]
        ]
      }
    },
    {
      "id": "P009",
      "description": "Quoted LF is retained",
      "operation": "parse",
      "input": "\"a\nb\",c",
      "expected": {
        "ok": true,
        "rows": [
          [
            "a\nb",
            "c"
          ]
        ]
      }
    },
    {
      "id": "P010",
      "description": "Quoted CRLF is retained",
      "operation": "parse",
      "input": "\"a\r\nb\",c",
      "expected": {
        "ok": true,
        "rows": [
          [
            "a\r\nb",
            "c"
          ]
        ]
      }
    },
    {
      "id": "P011",
      "description": "Quoted lone CR is retained",
      "operation": "parse",
      "input": "\"a\rb\",c",
      "expected": {
        "ok": true,
        "rows": [
          [
            "a\rb",
            "c"
          ]
        ]
      }
    },
    {
      "id": "P012",
