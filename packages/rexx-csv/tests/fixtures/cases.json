        "ok": true,
        "rows": [
          [
            "a"
          ],
          [
            ""
          ],
          [
            "b"
          ]
        ]
      }
    },
    {
      "id": "P019",
      "description": "Leading and trailing spaces are data",
      "operation": "parse",
      "input": " a ,\" b \"",
