    {
      "id": "P021",
      "description": "Quoted ordinary values",
      "operation": "parse",
      "input": "\"a\",\"b\"",
      "expected": {
        "ok": true,
        "rows": [
          [
            "a",
            "b"
          ]
        ]
      }
    },
    {
      "id": "P022",
      "description": "Ragged rows are accepted",
      "operation": "parse",
      "input": "a,b\nx\ny,z,w",
      "expected": {
        "ok": true,
        "rows": [
          [
            "a",
            "b"
          ],
          [
            "x"
          ],
          [
            "y",
            "z",
            "w"
          ]
        ]
      }
    },
    {
      "id": "P023",
      "description": "Headers including duplicates are ordinary rows",
      "operation": "parse",
      "input": "name,name\nx,y",
      "expected": {
        "ok": true,
        "rows": [
          [
            "name",
            "name"
          ],
          [
            "x",
            "y"
          ]
        ]
      }
    },
    {
      "id": "P024",
      "description": "Leading zeros and formula text are strings",
      "operation": "parse",
      "input": "0012,=1+1,+42,-7,@name",
      "expected": {
        "ok": true,
        "rows": [
          [
            "0012",
            "=1+1",
            "+42",
            "-7",
            "@name"
          ]
        ]
      }
    },
    {
      "id": "P025",
      "description": "Accented CJK astral and decomposed text",
      "operation": "parse",
      "input": "café,東京,🙂,é",
      "expected": {
        "ok": true,
        "rows": [
          [
            "café",
            "東京",
            "🙂",
            "é"
          ]
        ]
      }
    },
    {
      "id": "P026",
      "description": "One document BOM is removed",
      "operation": "parse",
      "input": "﻿a,b",
      "expected": {
        "ok": true,
        "rows": [
          [
            "a",
            "b"
          ]
        ]
      }
    },
    {
      "id": "P027",
      "description": "BOM-only document has no rows",
