        "ok": true,
        "rows": [
          [
            " a ",
            " b "
          ]
        ]
      }
    },
    {
      "id": "P020",
      "description": "Tabs are data",
      "operation": "parse",
      "input": "\ta\t,b",
      "expected": {
        "ok": true,
        "rows": [
          [
            "\ta\t",
            "b"
          ]
        ]
      }
