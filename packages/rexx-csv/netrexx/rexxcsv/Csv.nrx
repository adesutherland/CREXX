options binary
package rexxcsv

/** Pure NetRexx CSV factories. Shared semantics and byte budgets: ../../SPEC.md. */
class Csv public final
  method Csv() shared

  /** @param fields caller-owned strings @return immutable defensive snapshot. */
  method row(fields = String[]) public static returns CsvRow
    return CsvRow(fields)

  /* Full scalar validation is a binding precondition, before CSV parsing.
   * Count UTF-8 bytes in long arithmetic without allocating an encoded copy.
   */
  method utf8Bytes(text = String, stop = int) private static returns long
    bytes = long 0
    p = int 0
    loop while p < stop
      point = int text.codePointAt(p)
      if point >= 55296 & point <= 57343 then return -1
      if point < 128 then bytes = bytes + 1
      else if point < 2048 then bytes = bytes + 2
      else if point < 65536 then bytes = bytes + 3
      else bytes = bytes + 4
      p = p + Character.charCount(point)
    end
    return bytes

  method parseError(code = String, record = int, column = int, limit = String) private static returns CsvDocument
    return CsvDocument(CsvRow[0], code, record, column, limit)

  method outputError(code = String, record = int, column = int, limit = String) private static returns CsvOutput
    return CsvOutput('', code, record, column, limit)

  /** @param text Unicode scalar text @return checked document, never partial rows. */
  method parse(text = String) public static returns CsvDocument
    if text = null then signal IllegalArgumentException('Null CSV input')
    bytes = long utf8Bytes(text, text.length())
    if bytes < 0 then return parseError('E_ARGUMENT', 0, 0, '')
    if bytes > 16777216 then return parseError('E_LIMIT', 0, 0, 'input_bytes')
    size = int text.length()
    p = int 0
    if size > 0 then do
      if text.codePointAt(0) = 65279 then p = 1
    end
    if p = size then return CsvDocument(CsvRow[0], '', 0, 0, '')
    records = CsvRow[16]
    fields = String[16]
    width = int 0
    record = int 1
    column = int 1
    total = int 1
    state = int 0
    start = int p
    decoded = int 0
    value = String null
    builder = StringBuilder null
    loop forever
      point = int -1
      if p < size then point = text.codePointAt(p)
      if point = 0 then return parseError('E_NUL', record, column, '')
      if state = 0 then do
        start = p
        if point = 34 then do
          state = 2
          p = p + 1
          start = p
          builder = StringBuilder()
          iterate
        end
      end
      if state = 2 then do
        if point = -1 then return parseError('E_UNCLOSED_QUOTE', record, column, '')
        if point = 34 then do
          doubled = boolean 0
          if p + 1 < size then doubled = text.codePointAt(p + 1) = 34
          if doubled then do
            decoded = decoded + 1
            if decoded > 1048576 then return parseError('E_LIMIT', record, column, 'field_bytes')
            builder.append(CharSequence text, start, p)
            builder.appendCodePoint(int 34)
            p = p + 2
            start = p
          end
          else do
            builder.append(CharSequence text, start, p)
            value = builder.toString()
            builder = null
            state = 3
            p = p + 1
          end
          iterate
        end
        if point < 128 then decoded = decoded + 1
        else if point < 2048 then decoded = decoded + 2
        else if point < 65536 then decoded = decoded + 3
        else decoded = decoded + 4
        if decoded > 1048576 then return parseError('E_LIMIT', record, column, 'field_bytes')
        p = p + Character.charCount(point)
        iterate
      end
      if point = -1 | point = 44 | point = 10 | point = 13 then do
        step = int 1
        if point = 13 then do
          if p + 1 >= size then return parseError('E_RECORD_SEPARATOR', record, column, '')
          if text.codePointAt(p + 1) \= 10 then return parseError('E_RECORD_SEPARATOR', record, column, '')
          step = 2
        end
        if state \= 3 then value = text.substring(start, p)
        if width = fields.length then do
          expanded = String[fields.length * 2]
          System.arraycopy(fields, 0, expanded, 0, width)
          fields = expanded
        end
        fields[width] = value
        width = width + 1
        value = null
        decoded = 0
        state = 0
        p = p + step
        if point = 44 then do
          column = column + 1
          total = total + 1
          if column > 1024 then return parseError('E_LIMIT', record, column, 'fields_per_record')
        end
        else do
          rowFields = String[width]
          System.arraycopy(fields, 0, rowFields, 0, width)
          if record > records.length then do
            expandedRows = CsvRow[records.length * 2]
            System.arraycopy(records, 0, expandedRows, 0, records.length)
            records = expandedRows
          end
          records[record - 1] = CsvRow(rowFields)
          if point = -1 | p >= size then do
            finished = CsvRow[record]
            System.arraycopy(records, 0, finished, 0, record)
            return CsvDocument(finished, '', 0, 0, '')
          end
          record = record + 1
          column = 1
          total = total + 1
          width = 0
          if record > 10000 then return parseError('E_LIMIT', record, column, 'records')
        end
        if total > 100000 then return parseError('E_LIMIT', record, column, 'total_fields')
        iterate
      end
      if state = 3 then return parseError('E_AFTER_QUOTE', record, column, '')
      if point = 34 then return parseError('E_QUOTE', record, column, '')
      state = 1
      if point < 128 then decoded = decoded + 1
      else if point < 2048 then decoded = decoded + 2
      else if point < 65536 then decoded = decoded + 3
      else decoded = decoded + 4
      if decoded > 1048576 then return parseError('E_LIMIT', record, column, 'field_bytes')
      p = p + Character.charCount(point)
    end

  /** @param rows caller-owned row array @return checked canonical CRLF output. */
  method write(rows = CsvRow[]) public static returns CsvOutput
    if rows = null then signal IllegalArgumentException('Null row array')
    loop i = int 0 to rows.length - 1
      if rows[i] = null then signal IllegalArgumentException('Null row')
    end
    output = StringBuilder()
    written = long 0
    total = int 0
    loop r = int 0 to rows.length - 1
      record = int r + 1
      if record > 10000 then return outputError('E_LIMIT', record, 1, 'records')
      current = rows[r]
      count = int current.fieldCount()
      if count = 0 then return outputError('E_EMPTY_ROW', record, 0, '')
      loop column = int 1 to count
        if column > 1024 then return outputError('E_LIMIT', record, column, 'fields_per_record')
        total = total + 1
        if total > 100000 then return outputError('E_LIMIT', record, column, 'total_fields')
        value = String current.field(column)
        bytes = long utf8Bytes(value, value.length())
        if bytes < 0 then return outputError('E_ARGUMENT', 0, 0, '')
        nul = int value.indexOf(0)
        if nul >= 0 then do
          if utf8Bytes(value, nul) <= 1048576 then return outputError('E_NUL', record, column, '')
        end
        if bytes > 1048576 then return outputError('E_LIMIT', record, column, 'field_bytes')
        quotes = int 0
        q = int value.indexOf(34)
        loop while q >= 0
          quotes = quotes + 1
          q = value.indexOf(34, q + 1)
        end
        quoted = boolean (bytes = 0 | quotes > 0 | value.indexOf(44) >= 0 | value.indexOf(13) >= 0 | value.indexOf(10) >= 0)
        if r = 0 & column = 1 & value.length() > 0 then do
          if value.codePointAt(0) = 65279 then quoted = 1
        end
        contribution = long bytes + quotes
        if quoted then contribution = contribution + 2
        if column > 1 then contribution = contribution + 1
        if column = count then contribution = contribution + 2
        if written + contribution > 16777216 then return outputError('E_LIMIT', record, column, 'output_bytes')
        written = written + contribution
        if column > 1 then output.appendCodePoint(int 44)
        if quoted then do
          output.appendCodePoint(int 34)
          start = int 0
          q = value.indexOf(34)
          loop while q >= 0
            output.append(CharSequence value, start, int (q + 1))
            output.appendCodePoint(int 34)
            start = q + 1
            q = value.indexOf(34, start)
          end
          output.append(CharSequence value, start, value.length())
          output.appendCodePoint(int 34)
        end
        else output.append(value)
        if column = count then do
          output.appendCodePoint(int 13)
          output.appendCodePoint(int 10)
        end
      end
    end
    return CsvOutput(output.toString(), '', 0, 0, '')

  /* One diagnostic wording owner for both public result types. */
  method message(code = String, limit = String) shared static returns String
    select
      when code.equals('') then return ''
      when code.equals('E_ARGUMENT') then return 'Invalid Unicode scalar text'
      when code.equals('E_QUOTE') then return 'Quote in an unquoted field'
      when code.equals('E_AFTER_QUOTE') then return 'Unexpected character after closing quote'
      when code.equals('E_UNCLOSED_QUOTE') then return 'Unclosed quoted field'
      when code.equals('E_RECORD_SEPARATOR') then return 'Lone CR outside quotes'
      when code.equals('E_NUL') then return 'NUL is not permitted in CSV text'
      when code.equals('E_EMPTY_ROW') then return 'A CSV row must contain at least one field'
      otherwise return 'CSV resource limit exceeded: ' || limit
    end
