options levelb comments_dash
import rxfnsb

main: procedure = .int
  arg args = .string[]
  manifest = ""
  output = ""
  checksum_root = ""
  self_test_requested = 0
  i = 1
  do while i <= args[0]
    option = args[i]
    if option = "--self-test" then self_test_requested = 1
    else if option = "--manifest" then do
      if i = args[0] then return argument_error("missing value after --manifest")
      i = i + 1
      manifest = args[i]
    end
    else if option = "--output" then do
      if i = args[0] then return argument_error("missing value after --output")
      i = i + 1
      output = args[i]
    end
    else if option = "--checksums-root" then do
      if i = args[0] then return argument_error("missing value after --checksums-root")
      i = i + 1
      checksum_root = args[i]
    end
    else if option = "-h" | option = "--help" then do
      call usage
      return 0
    end
    else return argument_error("unknown option: " || option)
    i = i + 1
  end

  if self_test_requested then return self_test()
  if checksum_root <> "" then return write_and_verify_checksums(checksum_root)
  if manifest = "" | output = "" then
    return argument_error("--manifest and --output are required")
  rows = read_manifest(manifest)
  if rows[0] = 0 then return execution_error("artifact manifest has no rows")
  result = .string[]
  result[1] = "role,runtime,workload,form,path,size_bytes,sha256"
  do row_index = 1 to rows[0]
    fields = split_delimited(rows[row_index], "|")
    path = fields[5]
    size = file_size(path)
    hash = sha256_file(path)
    if size = "" | hash = "" then
      return execution_error("could not inventory artifact: " || path)
    result[result[0] + 1] = fields[1] || "," || fields[2] || "," || ,
        fields[3] || "," || fields[4] || "," || path || "," || size || "," || hash
  end
  if write_lines(output, result) <> 0 then return 1
  say "PASS: inventoried" rows[0] "performance artifacts in" output
  return 0

read_manifest: procedure = .string[]
  arg path = .string
  rows = .string[]
  header_seen = 0
  do while lines(path)
    line = linein(path)
    if line = "" | left(strip(line), 1) = "#" then iterate
    if \header_seen then do
      if line <> "crexx-artifact-inventory|1" then do
        call linein path
        say "ERROR: artifact manifest header is not recognized"
        empty = .string[]
        return empty
      end
      header_seen = 1
      iterate
    end
    fields = split_delimited(line, "|")
    if fields[0] <> 5 then do
      call linein path
      say "ERROR: artifact manifest row must have five fields"
      empty = .string[]
      return empty
    end
    rows[rows[0] + 1] = line
  end
  call linein path
  return rows

file_size: procedure = .string
  arg path = .string
  command = .string[]
  command[1] = "/usr/bin/stat"
  command[2] = "-f"
  command[3] = "%z"
  command[4] = path
  out = .string[]
  err = .string[]
  address crexx "run :command[]" output out error err
  if rc = 0 & out[0] > 0 then return strip(out[1])
  command[2] = "-c"
  command[3] = "%s"
  out = .string[]
  err = .string[]
  address crexx "run :command[]" output out error err
  if rc = 0 & out[0] > 0 then return strip(out[1])
  return ""

sha256_file: procedure = .string
  arg path = .string
  command = .string[]
  command[1] = "cmake"
  command[2] = "-E"
  command[3] = "sha256sum"
  command[4] = path
  out = .string[]
  err = .string[]
  address crexx "run :command[]" output out error err
  if rc <> 0 | out[0] = 0 then return ""
  return lower(word(out[1], 1))

split_delimited: procedure = .string[]
  arg value = .string, delimiter = .string
  fields = .string[]
  start = 1
  do forever
    delimiter_at = pos(delimiter, value, start)
    if delimiter_at = 0 then do
      fields[fields[0] + 1] = substr(value, start)
      leave
    end
    fields[fields[0] + 1] = substr(value, start, delimiter_at - start)
    start = delimiter_at + length(delimiter)
  end
  return fields

write_lines: procedure = .int
  arg path = .string, text = .string[]
  out = .string[]
  err = .string[]
  address crexx "rm :path" output out error err
  do i = 1 to text[0]
    if lineout(path, text[i]) <> 0 then do
      call lineout path
      return execution_error("could not write artifact inventory")
    end
  end
  call lineout path
  return 0

collect_files_recursive: procedure = .int
  arg directory = .string, root = .string, expose files = .string[]
  out = .string[]
  err = .string[]
  address crexx "ls :directory" output out error err
  if rc <> 0 then return execution_error("could not list bundle directory: " || directory)
  do i = 1 to out[0]
    child = out[i]
    if left(child, 1) <> "/" then child = directory || "/" || child
    stat_out = .string[]
    stat_err = .string[]
    address crexx "stat :child" output stat_out error stat_err
    if rc <> 0 | stat_out[0] = 0 then
      return execution_error("could not stat bundle path: " || child)
    if pos("type=directory", stat_out[1]) > 0 then do
      if collect_files_recursive(child, root, files) <> 0 then return 1
    end
    else if pos("type=file", stat_out[1]) > 0 then do
      relative = substr(child, length(root) + 2)
      if relative <> "checksums.sha256" then files[files[0] + 1] = relative
    end
  end
  return 0

sort_strings: procedure = .void
  arg expose values = .string[]
  do i = 2 to values[0]
    value = values[i]
    j = i - 1
    do while j >= 1 & values[j] > value
      values[j + 1] = values[j]
      j = j - 1
    end
    values[j + 1] = value
  end
  return

write_and_verify_checksums: procedure = .int
  arg root = .string
  files = .string[]
  if collect_files_recursive(root, root, files) <> 0 then return 1
  call sort_strings files
  checksum_lines = .string[]
  do i = 1 to files[0]
    hash = sha256_file(root || "/" || files[i])
    if hash = "" then return execution_error("could not checksum: " || files[i])
    checksum_lines[i] = hash || "  " || files[i]
  end
  checksum_path = root || "/checksums.sha256"
  if write_lines(checksum_path, checksum_lines) <> 0 then return 1
  do i = 1 to files[0]
    actual = sha256_file(root || "/" || files[i])
    if actual <> word(checksum_lines[i], 1) then
      return execution_error("checksum verification failed: " || files[i])
  end
  say "PASS: wrote and verified" files[0] "bundle checksums in" checksum_path
  return 0

usage: procedure = .void
  say "Usage: inventory_performance_artifacts --manifest PATH --output PATH"
  say "       inventory_performance_artifacts --checksums-root PATH"
  say "       inventory_performance_artifacts --self-test"
  return

self_test: procedure = .int
  fields = split_delimited("role|runtime|workload|form|path", "|")
  if fields[0] <> 5 | fields[4] <> "form" then
    return execution_error("artifact manifest parser self-test failed")
  say "PASS: performance artifact inventory self-test"
  return 0

argument_error: procedure = .int
  arg message = .string
  say "ERROR:" message
  return 2

execution_error: procedure = .int
  arg message = .string
  say "ERROR:" message
  return 1
