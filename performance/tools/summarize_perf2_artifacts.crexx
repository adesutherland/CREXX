options levelb comments_dash numeric_classic
import rxfnsb

/* Exact-RXBIN/static-disassembly inventory for PERF2 dossiers. */
main: procedure = .int
  arg args = .string[]
  manifest = ""
  output = ""
  self_test_requested = 0
  i = 1
  do while i <= args[0]
    option = args[i]
    if option = "--self-test" then self_test_requested = 1
    else if option = "--manifest" then do
      if i = args[0] then return argument_error("missing value after --manifest")
      i = i + 1
      manifest = args[i]
    end
    else if option = "--output" then do
      if i = args[0] then return argument_error("missing value after --output")
      i = i + 1
      output = args[i]
    end
    else if option = "-h" | option = "--help" then do
      call usage
      return 0
    end
    else return argument_error("unknown option: " || option)
    i = i + 1
  end
  if self_test_requested then return self_test()
  if manifest = "" | output = "" then
    return argument_error("--manifest and --output are required")
  root = current_directory()
  manifest = absolute_path(root, manifest)
  output = absolute_path(root, output)
  rows = read_manifest(manifest)
  if rows[0] < 2 then return execution_error("artifact manifest is incomplete")

  library_fields = split_delimited(rows[1], "|")
  if library_fields[1] <> "shared-library" then
    return execution_error("first artifact row must be shared-library")
  library_rxbin = absolute_path(root, library_fields[3])
  library_disassembly = absolute_path(root, library_fields[4])
  library_bytes = file_size(library_rxbin)
  library_hash = sha256_file(library_rxbin)
  library_static = static_instruction_count(library_disassembly)
  if library_bytes < 1 | library_hash = "" | library_static < 1 then
    return execution_error("could not inventory shared library")

  result = .string[]
  result[1] = "workload,program_static_instructions,program_max_locals,program_rxbin_bytes,program_rxbin_sha256,shared_static_instructions,shared_rxbin_bytes,shared_rxbin_sha256,module_set_static_instructions,module_set_rxbin_bytes"
  do row_index = 2 to rows[0]
    fields = split_delimited(rows[row_index], "|")
    if fields[1] <> "workload" then return execution_error("unexpected artifact role")
    workload = fields[2]
    rxbin = absolute_path(root, fields[3])
    disassembly = absolute_path(root, fields[4])
    program_bytes = file_size(rxbin)
    program_hash = sha256_file(rxbin)
    program_static = static_instruction_count(disassembly)
    max_locals = maximum_locals(disassembly)
    if program_bytes < 1 | program_hash = "" | program_static < 1 then
      return execution_error("could not inventory workload: " || workload)
    result[result[0] + 1] = csv_field(workload) || "," || program_static || ,
        "," || max_locals || "," || program_bytes || "," || program_hash || ,
        "," || library_static || "," || library_bytes || "," || library_hash || ,
        "," || (program_static + library_static) || "," || ,
        (program_bytes + library_bytes)
  end
  if write_lines(output, result) <> 0 then return 1
  say "PASS: inventoried" rows[0] - 1 "PERF2 workload artifact sets in" output
  return 0

static_instruction_count: procedure = .int
  arg path = .string
  count = 0
  text = .string[]
  err = .string[]
  address crexx "cat :path" output text error err
  if rc <> 0 then return 0
  do i = 1 to text[0]
    line = text[i]
    marker_at = pos("* 0x", line)
    if marker_at = 0 then iterate
    hex_start = marker_at + 4
    colon_at = pos(":", line, hex_start)
    if colon_at <= hex_start then iterate
    hex_address = substr(line, hex_start, colon_at - hex_start)
    if verify(lower(hex_address), "0123456789abcdef") = 0 then count = count + 1
  end
  return count

maximum_locals: procedure = .int
  arg path = .string
  maximum = 0
  marker = ".locals="
  text = .string[]
  err = .string[]
  address crexx "cat :path" output text error err
  if rc <> 0 then return 0
  do line_index = 1 to text[0]
    line = text[line_index]
    marker_at = pos(marker, line)
    if marker_at = 0 then iterate
    value = substr(line, marker_at + length(marker))
    digits = ""
    do i = 1 to length(value)
      character = substr(value, i, 1)
      if pos(character, "0123456789") = 0 then leave
      digits = digits || character
    end
    if digits <> "" & (digits as .int) > maximum then maximum = digits as .int
  end
  return maximum

read_manifest: procedure = .string[]
  arg path = .string
  rows = .string[]
  header_seen = 0
  do while lines(path)
    line = linein(path)
    if line = "" | left(strip(line), 1) = "#" then iterate
    if \header_seen then do
      if line <> "crexx-perf2-artifacts|1" then do
        call linein path
        empty = .string[]
        return empty
      end
      header_seen = 1
      iterate
    end
    fields = split_delimited(line, "|")
    if fields[0] <> 4 then do
      call linein path
      empty = .string[]
      return empty
    end
    rows[rows[0] + 1] = line
  end
  call linein path
  return rows

file_size: procedure = .int
  arg path = .string
  command = .string[]
  command[1] = "/usr/bin/stat"
  command[2] = "-f"
  command[3] = "%z"
  command[4] = path
  out = .string[]
  err = .string[]
  address crexx "run :command[]" output out error err
  if rc = 0 & out[0] > 0 then return out[1] as .int
  return 0

sha256_file: procedure = .string
  arg path = .string
  command = .string[]
  command[1] = "cmake"
  command[2] = "-E"
  command[3] = "sha256sum"
  command[4] = path
  out = .string[]
  err = .string[]
  address crexx "run :command[]" output out error err
  if rc <> 0 | out[0] = 0 then return ""
  return lower(word(out[1], 1))

split_delimited: procedure = .string[]
  arg value = .string, delimiter = .string
  fields = .string[]
  start = 1
  do forever
    delimiter_at = pos(delimiter, value, start)
    if delimiter_at = 0 then do
      fields[fields[0] + 1] = substr(value, start)
      leave
    end
    fields[fields[0] + 1] = substr(value, start, delimiter_at - start)
    start = delimiter_at + length(delimiter)
  end
  return fields

csv_field: procedure = .string
  arg value = .string
  if pos(",", value) > 0 | pos('"', value) > 0 then
    return '"' || changestr('"', value, '""') || '"'
  return value

current_directory: procedure = .string
  out = .string[]
  err = .string[]
  address crexx "pwd" output out error err
  if rc = 0 & out[0] > 0 then return out[1]
  return "unknown"

absolute_path: procedure = .string
  arg root = .string, path = .string
  if left(path, 1) = "/" then return path
  return root || "/" || path

write_lines: procedure = .int
  arg path = .string, text = .string[]
  out = .string[]
  err = .string[]
  address crexx "rm :path" output out error err
  do i = 1 to text[0]
    if lineout(path, text[i]) <> 0 then do
      call lineout path
      return execution_error("could not write: " || path)
    end
  end
  call lineout path
  return 0

self_test: procedure = .int
  fields = split_delimited("workload|Sieve|image|disassembly", "|")
  if fields[0] <> 4 | fields[2] <> "Sieve" then
    return execution_error("artifact manifest parser self-test failed")
  say "PASS: PERF2 artifact summarizer self-test"
  return 0

usage: procedure = .void
  say "Usage: summarize_perf2_artifacts --manifest PATH --output PATH"
  say "       summarize_perf2_artifacts --self-test"
  return

argument_error: procedure = .int
  arg message = .string
  say "ERROR:" message
  call usage
  return 2

execution_error: procedure = .int
  arg message = .string
  say "ERROR:" message
  return 1
