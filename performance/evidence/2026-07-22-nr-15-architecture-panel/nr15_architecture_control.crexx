make_keys: procedure = .string[]
  arg size = .int, family = .string
  keys = .string[]
  do i = 1 to size
    keys[i] = make_key(i, family)
  end
  return keys

make_key: procedure = .string
  arg index = .int, family = .string
  if family == "ascii" then return "key-" || index
  if family == "unicode" then return "κλειδί-🔥-" || index
  if family == "long" then
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-" || index
  if family == "collision" then do
    value = index - 1
    key = ""
    do part = 1 to 10
      if value % 2 = 0 then key = key || "Aa"
      else key = key || "BB"
      value = value / 2
    end
    return key
  end
  return "unknown-" || index

elapsed_us: procedure = .int
  arg start = .int
  elapsed = time("us") - start
  if elapsed < 0 then elapsed = elapsed + 86400000000
  return elapsed

report: procedure = .int
  arg candidate = .string, mode = .string, family = .string, size = .int, iterations = .int, elapsed = .int, checksum = .int
  if checksum <= 0 then return fail("checksum")
  say "benchmark=nr15_architecture_control"
  say "candidate="candidate
  say "mode="mode
  say "family="family
  say "size="size
  say "iterations="iterations
  say "elapsed_us="elapsed
  say "checksum="checksum
  say "PASS: NR-15 architecture control"
  return 0

fail: procedure = .int
  arg label = .string
  say "FAIL: NR-15 architecture control" label
  return 1

Nr15PanelStem: class
  *: factory
    return
