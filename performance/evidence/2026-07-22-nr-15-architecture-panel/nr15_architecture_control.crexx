/* One control surface for the approved NR-15 D1/D2/D2-hybrid panel. */
options levelb comments_dash
import rxfnsb

arg argv = .string[]
candidate = "d1"
mode = "get-hit"
size = 64
iterations = 20000
family = "ascii"
if argv[0] >= 1 then candidate = argv[1]
if argv[0] >= 2 then mode = argv[2]
if argv[0] >= 3 then size = argv[3]
if argv[0] >= 4 then iterations = argv[4]
if argv[0] >= 5 then family = argv[5]

select
  when candidate == "d1" then rc = run_d1(mode, size, iterations, family)
  when candidate == "d2" then rc = run_d2(mode, size, iterations, family)
  when candidate == "d2h" then rc = run_d2h(mode, size, iterations, family)
  otherwise rc = fail("candidate")
end
return rc

run_d1: procedure = .int
  arg mode = .string, size = .int, iterations = .int, family = .string
  keys = make_keys(size, family)
  target = .stem()
  do i = 1 to size
    key = keys[i]
    value = "v" || i
    assembler nr15d1set target,key,value
  end
  checksum = 0
  result = .string
  start = time("us")
  select
    when mode == "get-hit" then do
      do i = 1 to iterations
        index = ((i - 1) % size) + 1
        key = keys[index]
        assembler nr15d1get result,target,key
        checksum = checksum + length(result)
      end
    end
    when mode == "get-miss" then do
      key = "missing-" || family
      do i = 1 to iterations
        assembler nr15d1get result,target,key
        if result == "" then checksum = checksum + 1
      end
    end
    when mode == "set-existing" then do
      do i = 1 to iterations
        index = ((i - 1) % size) + 1
        key = keys[index]
        value = "u" || i
        assembler nr15d1set target,key,value
        checksum = checksum + index
      end
    end
    when mode == "set-new" then do
      do i = 1 to iterations
        key = "new-" || family || "-" || i
        value = "n" || i
        assembler nr15d1set target,key,value
        checksum = checksum + 1
      end
    end
    when mode == "reset-default" then do
      key = keys[1]
      do i = 1 to iterations
        value = "d" || (i % 10)
        assembler nr15d1reset target,value
        assembler nr15d1get result,target,key
        checksum = checksum + length(result)
      end
    end
    when mode == "multi-tail" then do
      left = "row"
      right = "1"
      value = "segmented"
      assembler nr15d1set2 target,left,right,value
      do i = 1 to iterations
        assembler nr15d1get2 result,target,left,right
        checksum = checksum + length(result)
      end
    end
    otherwise return fail("mode")
  end
  elapsed = elapsed_us(start)
  return report("d1", mode, family, size, iterations, elapsed, checksum)

run_d2: procedure = .int
  arg mode = .string, size = .int, iterations = .int, family = .string
  keys = make_keys(size, family)
  target = .Nr15PanelStem()
  do i = 1 to size
    key = keys[i]
