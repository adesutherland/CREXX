    REQUIRE_VALID_UTF8_REGISTER(REG_OP(4));
    { nr15_key_parts p = nr15_two_parts(REG_OP(2), REG_OP(3));
      NR15_PANEL_RESULT(nr15_d1_set_parts(REG_OP(1), &p, REG_OP(4))); }
    DISPATCH;

