    DISPATCH;

START_INSTRUCTION(NR15D1KEYAT_REG_REG_REG) VM_ADVANCE(3);
    NR15_PANEL_RESULT(nr15_d1_key_at(REG_OP(1), REG_OP(2), REG_OP(3)->int_value));
    DISPATCH;

START_INSTRUCTION(NR15D1VALUEAT_REG_REG_REG) VM_ADVANCE(3);
    NR15_PANEL_RESULT(nr15_d1_value_at(REG_OP(1), REG_OP(2), REG_OP(3)->int_value));
