/* Provisional NR-15 D1/D2/D2-hybrid instruction handlers. */

#define NR15_PANEL_RESULT(call_)                                               \
    do {                                                                       \
        int nr15_result__ = (call_);                                           \
        if (nr15_result__ != NR15_OK)                                          \
            SET_SIGNAL_MSG(RXSIGNAL_FAILURE, nr15_error_message(nr15_result__)); \
    } while (0)

START_INSTRUCTION(NR15D1GET_REG_REG_REG) VM_ADVANCE(3);
    REQUIRE_VALID_UTF8_REGISTER(REG_OP(3));
    { nr15_key_parts p = nr15_one_part(REG_OP(3));
      NR15_PANEL_RESULT(nr15_d1_get_parts(REG_OP(1), REG_OP(2), &p)); }
    DISPATCH;

START_INSTRUCTION(NR15D1SET_REG_REG_REG) VM_ADVANCE(3);
    REQUIRE_VALID_UTF8_REGISTER(REG_OP(2));
    REQUIRE_VALID_UTF8_REGISTER(REG_OP(3));
    { nr15_key_parts p = nr15_one_part(REG_OP(2));
      NR15_PANEL_RESULT(nr15_d1_set_parts(REG_OP(1), &p, REG_OP(3))); }
    DISPATCH;

START_INSTRUCTION(NR15D1RESET_REG_REG) VM_ADVANCE(2);
    REQUIRE_VALID_UTF8_REGISTER(REG_OP(2));
    NR15_PANEL_RESULT(nr15_d1_reset(REG_OP(1), REG_OP(2)));
    DISPATCH;

START_INSTRUCTION(NR15D1GET2_REG_REG_REG_REG) VM_ADVANCE(4);
    REQUIRE_VALID_UTF8_REGISTER(REG_OP(3));
    REQUIRE_VALID_UTF8_REGISTER(REG_OP(4));
    { nr15_key_parts p = nr15_two_parts(REG_OP(3), REG_OP(4));
      NR15_PANEL_RESULT(nr15_d1_get_parts(REG_OP(1), REG_OP(2), &p)); }
    DISPATCH;

START_INSTRUCTION(NR15D1SET2_REG_REG_REG_REG) VM_ADVANCE(4);
