+rejected_model: procedure = .int
+  arg runtime = .binary, path = .string, hash = .string, config = .binary
+  model = .binary
+  if rxllama..modelopen(runtime, path, hash, "bge-small-en-v1.5", config, model) <> 0 then return 0
+  started = time("us")
+  do while elapsed(started) < 60000000
+    state = ""
+    if rxllama..modelstate(model, state) <> 0 then return 1
+    if state = "failed" then return check(rxllama..close(model) = 0, "failed model close")
+    if state <> "loading" then return 1
+  end
+  return 1
+
+embedding_failures: procedure = .int
+  arg session = .binary, config = .binary
+  request = .binary
+  if rxllama..requestopen(session, config, request) <> 0 then return 1
+  errors = check(rxllama..submit(request) <> 0, "empty batch rejected")
+  errors = errors + check(rxllama..close(request) = 0, "empty request close")
+  if rxllama..requestopen(session, config, request) <> 0 then return 1
+  row = 0
+  status = rxllama..addembedding(request, copies("a ", 513), "document", row)
+  if status = 0 then errors = errors + check(rxllama..submit(request) <> 0, "oversized batch rejected")
+  errors = errors + check(rxllama..close(request) = 0, "invalid request close")
+  if rxllama..requestopen(session, config, request) <> 0 then return 1
+  errors = errors + check(rxllama..addprompt(request, "", "Name one animal.", row) <> 0, "embedding capability mismatch")
+  values = .packedfloat(0)
+  rows = 0
+  dimensions = 0
+  errors = errors + check(rxllama..embeddings(request, values, rows, dimensions) <> 0, "no incomplete embedding publication")
+  errors = errors + check(rxllama..close(request) = 0, "capability failure close")
+  return errors
+
+incremental_generation: procedure = .int
+  arg session = .binary, config = .binary, cancel_early = .boolean
+  request = .binary
+  if rxllama..requestopen(session, config, request) <> 0 then return 1
+  row = 0
+  if rxllama..addprompt(request, "", "Name three animals.", row) <> 0 then return 1
+  if rxllama..submit(request) <> 0 then return 1
+  errors = 0
+  started = time("us")
+  count = 0
+  iterations = 0
+  do while elapsed(started) < 60000000
+    state = ""
+    if rxllama..process(request, 1, state) <> 0 then return 1
+    iterations = iterations + 1
+    if cancel_early & iterations = 1 then do
+      errors = errors + check(rxllama..cancel(request) = 0, "active request cancellation")
+    end
+    if \cancel_early then do
+      text = ""
+      tokens = 0
+      finish = ""
+      status = rxllama..readtext(request, 1, text, tokens, finish)
+      errors = errors + check(status = 0 & tokens >= 0, "incremental text read")
+      count = count + tokens
+      errors = errors + check(count <= 32, "incremental total output budget")
+    end
+    if state = "complete" | state = "cancelled" then leave
+    if state <> "running" then return 1
+  end
+  if cancel_early then errors = errors + check(state = "cancelled", "cancelled terminal state")
+  else do
+    errors = errors + check(state = "complete" & count > 0, "incremental completion")
+    errors = errors + check(finish = "eos" | finish = "output_limit", "incremental finish reason")
+  end
+  errors = errors + check(rxllama..close(request) = 0, "incremental request close")
+  return errors
 
