diff --git a/interpreter/rxvmintp.c b/interpreter/rxvmintp.c
index cbdf8d761..100a5cd28 100644
--- a/interpreter/rxvmintp.c
+++ b/interpreter/rxvmintp.c
@@ -13177,9 +13177,32 @@ START_INSTRUCTION(DMOD_REG_REG_REG) VM_ADVANCE(3);
                   REG_IDX(1), REG_IDX(2), REG_IDX(3), REG_IDX(4), REG_IDX(5),
                   REG_IDX(6), REG_IDX(7), REG_IDX(8), REG_IDX(9));
             DISPATCH;
-        RESERVED_IMPL(RESERVED_088)
-        RESERVED_IMPL(RESERVED_089)
-        RESERVED_IMPL(RESERVED_090)
+        START_INSTRUCTION(RELINKREF_REG_REG) VM_ADVANCE(2);
+            REG_OP(1) = current_frame->baselocals[REG_IDX(1)];
+            {
+                rxvm_reference_cell *cell = rxvm_reference_payload_cell(REG_OP(2));
+                value *target = rxvm_reference_cell_target(cell);
+                if (!target) {
+                    SET_SIGNAL_MSG(RXSIGNAL_REFERENCE_INVALID, "Reference is invalid");
+                    DISPATCH;
+                }
+                REG_OP(1) = target;
+            }
+            DISPATCH;
+
+        START_INSTRUCTION(COPYATTR1_REG_REG_INT) VM_ADVANCE(3);
+            if ((int)INT_OP(3) - 1 < 0 ||
+                (int)INT_OP(3) - 1 >= REG_OP(2)->num_attributes) {
+                SET_SIGNAL(RXSIGNAL_OUT_OF_RANGE);
+                DISPATCH;
+            }
+            copy_value(REG_OP(1), REG_OP(2)->attributes[(int)INT_OP(3) - 1]);
+            DISPATCH;
+
+        START_INSTRUCTION(ICOPYBR_REG_REG_ID)
+            REG_OP(1)->int_value = REG_OP(2)->int_value;
+            VM_SELECT_INDEX((pc + 3)->index, RXVM_TRANSITION_BRANCH);
+            DISPATCH;
         RESERVED_IMPL(RESERVED_091)
         RESERVED_IMPL(RESERVED_092)
         RESERVED_IMPL(RESERVED_093)
