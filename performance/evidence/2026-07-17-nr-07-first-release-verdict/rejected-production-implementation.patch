+static ValueType direct_condition_effective_type(ASTNode *node) {
+    if (!node) return TP_UNKNOWN;
+    return node->target_type != TP_UNKNOWN ? node->target_type : node->value_type;
+}
+
+static int direct_condition_operand_is_integer(ASTNode *node) {
+    ValueType type = direct_condition_effective_type(node);
+    return type == TP_BOOLEAN || type == TP_INTEGER;
+}
+
+int rxcp_emit_is_direct_integer_condition(ASTNode *condition) {
+    ASTNode *left;
+    ASTNode *right;
+    ASTNode *parent;
+
+    if (!condition || !condition->context || !condition->context->optimise) return 0;
+    switch (condition->node_type) {
+        case OP_COMPARE_EQUAL:
+        case OP_COMPARE_NEQ:
+        case OP_COMPARE_GT:
+        case OP_COMPARE_LT:
+        case OP_COMPARE_GTE:
+        case OP_COMPARE_LTE:
+            break;
+        default:
+            return 0;
+    }
+
+    parent = condition->parent;
+    if (!parent || parent->child != condition ||
+        (parent->node_type != IF &&
+         parent->node_type != WHILE &&
+         parent->node_type != UNTIL)) return 0;
+
+    left = ast_chdn(condition, 0);
+    right = ast_chdn(condition, 1);
+    if (!left || !right) return 0;
+    if (!direct_condition_operand_is_integer(left) ||
+        !direct_condition_operand_is_integer(right)) return 0;
+    if (condition->cleanup || left->cleanup || right->cleanup) return 0;
+    if (is_constant(left) && is_constant(right)) return 0;
+    if (!is_constant(left) && left->register_num < 0) return 0;
+    if (!is_constant(right) && right->register_num < 0) return 0;
+    return 1;
+}
+
+static NodeType direct_condition_reverse_compare(NodeType type) {
+    switch (type) {
+        case OP_COMPARE_GT: return OP_COMPARE_LT;
+        case OP_COMPARE_LT: return OP_COMPARE_GT;
+        case OP_COMPARE_GTE: return OP_COMPARE_LTE;
+        case OP_COMPARE_LTE: return OP_COMPARE_GTE;
+        default: return type;
+    }
+}
+
+static const char *direct_condition_branch_opcode(NodeType type, int branch_when_true) {
+    if (branch_when_true) {
+        switch (type) {
+            case OP_COMPARE_EQUAL: return "beq";
+            case OP_COMPARE_NEQ: return "bne";
+            case OP_COMPARE_GT: return "bgt";
+            case OP_COMPARE_LT: return "blt";
+            case OP_COMPARE_GTE: return "bge";
+            case OP_COMPARE_LTE: return "ble";
+            default: return 0;
+        }
+    }
+
+    switch (type) {
+        case OP_COMPARE_EQUAL: return "bne";
+        case OP_COMPARE_NEQ: return "beq";
+        case OP_COMPARE_GT: return "ble";
+        case OP_COMPARE_LT: return "bge";
+        case OP_COMPARE_GTE: return "blt";
+        case OP_COMPARE_LTE: return "bgt";
+        default: return 0;
+    }
+}
+
+/* Emit the branch as the direct condition's expression output so each operand
+ * fragment remains owned by exactly one output chain. */
+static int emit_direct_integer_condition(ASTNode *condition) {
+    ASTNode *left;
+    ASTNode *right;
+    ASTNode *parent;
+    NodeType compare_type;
+    const char *opcode;
+    const char *suffix;
+    int label;
+    int branch_when_true;
+    char *right_operand;
+    char *text;
+
+    if (!rxcp_emit_is_direct_integer_condition(condition)) return 0;
+    parent = condition->parent;
+    left = ast_chdn(condition, 0);
+    right = ast_chdn(condition, 1);
+    compare_type = condition->node_type;
+
+    if (parent->node_type == IF) {
+        label = parent->node_number;
+        suffix = "iffalse";
+        branch_when_true = 0;
+    } else {
+        if (!parent->parent || !parent->parent->parent) return 0;
+        label = parent->parent->parent->node_number;
+        suffix = "doend";
+        branch_when_true = parent->node_type == UNTIL;
+    }
+
+    if (!condition->output) condition->output = output_f();
+    if (left->output) output_concat(condition->output, left->output);
+    if (right->output) output_concat(condition->output, right->output);
+
+    if (is_constant(left)) {
+        ASTNode *temporary = left;
+        left = right;
+        right = temporary;
+        compare_type = direct_condition_reverse_compare(compare_type);
+    }
+
+    opcode = direct_condition_branch_opcode(compare_type, branch_when_true);
+    right_operand = is_constant(right)
+                    ? format_constant(TP_INTEGER, right)
+                    : mprintf("%c%d", right->register_type, right->register_num);
+    if (!opcode || !right_operand) return 0;
+
+    text = mprintf("   %s l%d%s,%c%d,%s\n",
+                   opcode,
+                   label,
+                   suffix,
+                   left->register_type,
+                   left->register_num,
+                   right_operand);
+    free(right_operand);
+    if (!text) return 0;
+    output_append_text(condition->output, text);
+    free(text);
+    return 1;
+}
+
