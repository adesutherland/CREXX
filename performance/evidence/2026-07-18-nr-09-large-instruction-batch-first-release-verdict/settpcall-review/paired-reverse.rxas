/*
 * Reverse-order partner for paired.rxas. The first pair is a warm-up; the
 * remaining eleven are recorded, with SETTPCALL measured first.
 */

.globals=0

main() .locals=8
    load r5,12
pair:
    say "fused_us"
    call r1,measure_fused()
    say "expanded_us"
    call r1,measure_expanded()
    dec r5
    brt pair,r5
    ret 0

measure_expanded() .locals=16
    mtime r2
    load r0,20000000
    load r10,1
    load r11,43
expanded_loop:
    settp r11,512
    call r1,return_arg(),r10
    dec r0
    brt expanded_loop,r0
    mtime r3
    isub r1,r3,r2
    itos r1
    say r1
    ret r1

measure_fused() .locals=16
    mtime r2
    load r0,20000000
    load r10,1
    load r11,43
fused_loop:
    settpcall r1,return_arg(),r10,r11,512
    dec r0
    brt fused_loop,r0
    mtime r3
    isub r1,r3,r2
    itos r1
    say r1
    ret r1

return_arg() .locals=0
    ret a1
