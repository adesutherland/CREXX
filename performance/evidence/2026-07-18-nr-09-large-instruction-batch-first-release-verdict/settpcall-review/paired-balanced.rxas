/*
 * Balanced same-process SETTPCALL timing. Pair order alternates so that the
 * twelve recorded pairs contain six measurements in each order. Pair one is
 * a warm-up and is excluded from the summary.
 */

.globals=0

main() .locals=8
    load r5,13
    load r6,0
pair:
    brt reverse_order,r6
forward_order:
    say "expanded_us"
    call r1,measure_expanded()
    say "fused_us"
    call r1,measure_fused()
    load r6,1
    br pair_done
reverse_order:
    say "fused_us"
    call r1,measure_fused()
    say "expanded_us"
    call r1,measure_expanded()
    load r6,0
pair_done:
    dec r5
    brt pair,r5
    ret 0

measure_expanded() .locals=16
    mtime r2
    load r0,20000000
    load r10,1
    load r11,43
expanded_loop:
    settp r11,512
    call r1,return_arg(),r10
    dec r0
    brt expanded_loop,r0
    mtime r3
    isub r1,r3,r2
    itos r1
    say r1
    ret r1

measure_fused() .locals=16
    /* Keep the post-call return target at the same 128-byte runtime-image
     * offset as the expanded form. These execute before the timed interval. */
    cnop
    cnop
    cnop
    cnop
    cnop
    cnop
    cnop
    cnop
    cnop
    cnop
    cnop
    cnop
    cnop
    cnop
    mtime r2
    load r0,20000000
    load r10,1
    load r11,43
fused_loop:
    settpcall r1,return_arg(),r10,r11,512
    dec r0
    brt fused_loop,r0
    mtime r3
    isub r1,r3,r2
    itos r1
    say r1
    ret r1

return_arg() .locals=0
    ret a1
