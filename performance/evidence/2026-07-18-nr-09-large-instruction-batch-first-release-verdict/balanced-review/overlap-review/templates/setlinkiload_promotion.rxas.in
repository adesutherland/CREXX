/* Generated overlap-selection Release cell for SETLINKILOAD_PROMOTION. */

.globals=0

main() .locals=8
    load r5,5
    load r6,0
pair:
    brt reverse_order,r6
forward_order:
    say "current_us"
    call r1,measure_current_setlinkiload_promotion()
    say "alternative_us"
    call r1,measure_alternative_setlinkiload_promotion()
    load r6,1
    br pair_done
reverse_order:
    say "alternative_us"
    call r1,measure_alternative_setlinkiload_promotion()
    say "current_us"
    call r1,measure_current_setlinkiload_promotion()
    load r6,0
pair_done:
    dec r5
    brt pair,r5
    ret 0

measure_current_setlinkiload_promotion() .locals=24
    null r1
    load r4,1
    mtime r22
    load r0,500000
setlinkiload_promotion_current_loop:
    setlinkattr1 r2,r1,4,r4
    load r3,1
    isetunlink r2,r3
    dec r0
    brt setlinkiload_promotion_current_loop,r0
    mtime r23
    isub r1,r23,r22
    itos r1
    say r1
    ret r1

measure_alternative_setlinkiload_promotion() .locals=24
@PADDING@
    null r1
    load r4,1
    mtime r22
    load r0,500000
setlinkiload_promotion_alternative_loop:
    setlinkiload r2,r1,4,r4,r3,1
    isetunlink r2,r3
    dec r0
    brt setlinkiload_promotion_alternative_loop,r0
    mtime r23
    isub r1,r23,r22
    itos r1
    say r1
    ret r1

