/* Generated overlap-selection Release cell for FMULTICOPY_CHAIN_SELECTION. */

.globals=0

main() .locals=8
    load r5,5
    load r6,0
pair:
    brt reverse_order,r6
forward_order:
    say "current_us"
    call r1,measure_current_fmulticopy_chain_selection()
    say "alternative_us"
    call r1,measure_alternative_fmulticopy_chain_selection()
    load r6,1
    br pair_done
reverse_order:
    say "alternative_us"
    call r1,measure_alternative_fmulticopy_chain_selection()
    say "current_us"
    call r1,measure_current_fmulticopy_chain_selection()
    load r6,0
pair_done:
    dec r5
    brt pair,r5
    ret 0

measure_current_fmulticopy_chain_selection() .locals=24
    load r5,7
    load r6,8
    mtime r22
    load r0,1000000
fmulticopy_chain_selection_current_loop:
    itof r8,r5
    fmult r8,r8,2.0
    itof r9,r6
    dec r0
    brt fmulticopy_chain_selection_current_loop,r0
    mtime r23
    isub r1,r23,r22
    itos r1
    say r1
    ret r1

measure_alternative_fmulticopy_chain_selection() .locals=24
@PADDING@
    load r5,7
    load r6,8
    mtime r22
    load r0,1000000
fmulticopy_chain_selection_alternative_loop:
    itof r8,r5
    fmulticopy r8,2.0,r9,r6
    itof r9
    dec r0
    brt fmulticopy_chain_selection_alternative_loop,r0
    mtime r23
    isub r1,r23,r22
    itos r1
    say r1
    ret r1

