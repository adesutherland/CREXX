+/* ---- Startup link index ------------------------------------------------
+ * The interface registry rebuilds used to scan every module's meta list
+ * linearly for every procedure lookup, signature check and interface member
+ * search (quadratic in the number of metas).  While a rebuild is running, a
+ * hash index over META_FUNC (by name and by procedure) and META_MEMBER (by
+ * owner) is built once and consulted instead.  Lookup semantics (first module,
+ * first entry wins) are unchanged; without an index the linear scans remain. */
+typedef struct link_index_func {
+    module *mod;
+    meta_func_constant *meta;
+    proc_runtime *proc;
+    const char *name;
+    size_t name_len;
+} link_index_func;
+
+typedef struct link_index_member {
+    module *mod;
+    meta_entry *meta;
+    int next;
+} link_index_member;
+
+typedef struct link_index_owner {
+    const char *name;
+    size_t name_len;
+    int first;
+    int last;
+    int used;
+} link_index_owner;
+
+typedef struct link_index {
+    link_index_func *funcs;      size_t num_funcs;
+    int *name_table;             size_t name_cap;   /* open addressing, -1 empty */
+    int *proc_table;             size_t proc_cap;
+    link_index_member *members;  size_t num_members;
+    link_index_owner *owners;    size_t owner_cap;
+    string_constant **impl_class; string_constant **impl_iface;   /* META_IMPLEMENTS pairs */
+    int *impl_table;             size_t impl_cap;
+} link_index;
+
+static _Thread_local link_index *active_link_index = 0;
+
+static size_t link_hash_bytes(const char *s, size_t n, int fold) {
+    size_t h = 1469598103934665603ULL;
+    size_t i;
+    for (i = 0; i < n; i++) {
+        unsigned char c = (unsigned char)s[i];
+        if (fold) c = (unsigned char)tolower(c);
+        h ^= c;
+        h *= 1099511628211ULL;
+    }
+    return h;
+}
+
+static size_t link_hash_ptr(const void *p) {
+    size_t h = (size_t)(uintptr_t)p;
+    h ^= h >> 17; h *= 0x9E3779B97F4A7C15ULL; h ^= h >> 29;
+    return h;
+}
+
+static void link_index_free(link_index *ix) {
+    if (!ix) return;
+    free(ix->funcs); free(ix->name_table); free(ix->proc_table);
+    free(ix->members); free(ix->owners);
+    free(ix->impl_class); free(ix->impl_iface); free(ix->impl_table);
+    free(ix);
+}
+
+static link_index *link_index_build(rxvm_context *context) {
+    link_index *ix;
+    size_t mod_index, nfunc = 0, nmem = 0, nimpl = 0, cap, i, num_impl = 0;
+
+    for (mod_index = 0; mod_index < context->num_modules; mod_index++) {
+        module *mod = context->modules[mod_index];
+        int meta_ix = mod->meta_head;
+        while (meta_ix != -1) {
+            meta_entry *meta = (meta_entry *)(mod->segment.const_pool + meta_ix);
+            if (meta->base.type == META_FUNC) nfunc++;
+            else if (meta->base.type == META_MEMBER) nmem++;
+            else if (meta->base.type == META_IMPLEMENTS) nimpl++;
+            meta_ix = meta->next;
+        }
+    }
+    ix = calloc(1, sizeof(*ix));
+    if (!ix) return 0;
+    for (cap = 16; cap < nfunc * 2 + 2; cap <<= 1) ;
+    ix->name_cap = ix->proc_cap = cap;
+    ix->owner_cap = 16;
+    while (ix->owner_cap < nmem * 2 + 2) ix->owner_cap <<= 1;
+    ix->funcs = calloc(nfunc + 1, sizeof(*ix->funcs));
+    ix->name_table = malloc(cap * sizeof(int));
+    ix->proc_table = malloc(cap * sizeof(int));
+    ix->members = calloc(nmem + 1, sizeof(*ix->members));
+    ix->owners = calloc(ix->owner_cap, sizeof(*ix->owners));
+    for (ix->impl_cap = 16; ix->impl_cap < nimpl * 2 + 2; ix->impl_cap <<= 1) ;
+    ix->impl_class = calloc(nimpl + 1, sizeof(*ix->impl_class));
+    ix->impl_iface = calloc(nimpl + 1, sizeof(*ix->impl_iface));
+    ix->impl_table = malloc(ix->impl_cap * sizeof(int));
+    if (!ix->funcs || !ix->name_table || !ix->proc_table || !ix->members || !ix->owners ||
+        !ix->impl_class || !ix->impl_iface || !ix->impl_table) {
+        link_index_free(ix);
+        return 0;
+    }
+    for (i = 0; i < cap; i++) ix->name_table[i] = ix->proc_table[i] = -1;
+    for (i = 0; i < ix->impl_cap; i++) ix->impl_table[i] = -1;
+
+    for (mod_index = 0; mod_index < context->num_modules; mod_index++) {
+        module *mod = context->modules[mod_index];
+        int meta_ix = mod->meta_head;
+        while (meta_ix != -1) {
+            meta_entry *meta = (meta_entry *)(mod->segment.const_pool + meta_ix);
+            if (meta->base.type == META_FUNC) {
+                meta_func_constant *mf = (meta_func_constant *)meta;
+                string_constant *sym = (string_constant *)(mod->segment.const_pool + mf->symbol);
+                proc_runtime *proc = rxvm_get_module_runtime_procedure(mod, mf->func);
+                link_index_func *f = &ix->funcs[ix->num_funcs];
+                int fi = (int)ix->num_funcs;
+                int have_name = 0;
+                f->mod = mod; f->meta = mf; f->proc = proc;
+                if (sym->base.type == STRING_CONST) {
+                    size_t slot = link_hash_bytes(sym->string, sym->string_len, 1) & (cap - 1);
+                    f->name = sym->string; f->name_len = sym->string_len;
+                    while (ix->name_table[slot] != -1) {
+                        link_index_func *o = &ix->funcs[ix->name_table[slot]];
+                        if (runtime_name_equals_ignore_case(o->name, o->name_len, f->name, f->name_len)) {
+                            have_name = 1; break;
+                        }
+                        slot = (slot + 1) & (cap - 1);
+                    }
+                    if (!have_name) ix->name_table[slot] = fi;
+                }
+                if (proc) {
+                    size_t slot = link_hash_ptr(proc) & (cap - 1);
+                    while (ix->proc_table[slot] != -1 && ix->funcs[ix->proc_table[slot]].proc != proc)
+                        slot = (slot + 1) & (cap - 1);
+                    if (ix->proc_table[slot] == -1) ix->proc_table[slot] = fi;
+                }
+                ix->num_funcs++;
+            } else if (meta->base.type == META_IMPLEMENTS) {
+                meta_implements_constant *im = (meta_implements_constant *)meta;
+                string_constant *c = get_runtime_string_constant(mod, im->symbol);
+                string_constant *f = get_runtime_string_constant(mod, im->interface_symbol);
+                if (c && f) {
+                    size_t slot = (link_hash_bytes(c->string, c->string_len, 0) * 31 +
+                                   link_hash_bytes(f->string, f->string_len, 0)) & (ix->impl_cap - 1);
+                    ix->impl_class[num_impl] = c; ix->impl_iface[num_impl] = f;
+                    while (ix->impl_table[slot] != -1) slot = (slot + 1) & (ix->impl_cap - 1);
+                    ix->impl_table[slot] = (int)num_impl++;
+                }
+            } else if (meta->base.type == META_MEMBER) {
+                meta_member_constant *mm = (meta_member_constant *)meta;
+                string_constant *owner = get_runtime_string_constant(mod, mm->owner);
+                if (owner) {
+                    size_t slot = link_hash_bytes(owner->string, owner->string_len, 0) & (ix->owner_cap - 1);
+                    link_index_owner *ow;
+                    int mi = (int)ix->num_members;
+                    while (ix->owners[slot].used &&
+                           !(ix->owners[slot].name_len == owner->string_len &&
+                             memcmp(ix->owners[slot].name, owner->string, owner->string_len) == 0))
+                        slot = (slot + 1) & (ix->owner_cap - 1);
+                    ow = &ix->owners[slot];
+                    if (!ow->used) {
+                        ow->used = 1; ow->name = owner->string; ow->name_len = owner->string_len;
+                        ow->first = ow->last = -1;
+                    }
+                    ix->members[mi].mod = mod; ix->members[mi].meta = meta; ix->members[mi].next = -1;
+                    if (ow->last >= 0) ix->members[ow->last].next = mi; else ow->first = mi;
+                    ow->last = mi;
+                    ix->num_members++;
+                }
+            }
+            meta_ix = meta->next;
+        }
+    }
+    return ix;
+}
+
+/* first META_MEMBER index owned by `owner` (member list in module/meta order), or -1 */
+static int link_index_first_member(const link_index *ix, const char *name, size_t len) {
+    size_t slot = link_hash_bytes(name, len, 0) & (ix->owner_cap - 1);
+    while (ix->owners[slot].used) {
+        if (ix->owners[slot].name_len == len && memcmp(ix->owners[slot].name, name, len) == 0)
+            return ix->owners[slot].first;
+        slot = (slot + 1) & (ix->owner_cap - 1);
+    }
+    return -1;
+}
