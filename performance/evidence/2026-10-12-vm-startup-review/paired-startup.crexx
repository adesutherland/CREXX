options levelb comments_dash
import rxfnsb

/* Review-only single-workload sampling. Patterns from run_cross_runtime.crexx. */
main: procedure = .int
  arg args = .string[]
  i = .int
  if args[0] <> 4 then return 2
  stock = args[1]
  candidate = args[2]
  library_dir = args[3]
  image = args[4]
  say "engine,phase,pair,variant,elapsed_us,exit_code,output"
  do engine = 1 to 2
    vm = "rxtvm"
    if engine = 2 then vm = "rxbvm"
    do pair = 0 to 12
      phase = "recorded"
      if pair = 0 then phase = "warmup"
      do turn = 1 to 2
        variant = "stock"
        vm_dir = stock
        if (pair <mod> 2 = 0 & turn = 2) | (pair <mod> 2 = 1 & turn = 1) then do
          variant = "candidate"
          vm_dir = candidate
        end
        command = .string[]
        command[1] = vm_dir || "/" || vm
        command[2] = "-l"
        command[3] = library_dir
        command[4] = "--provider-path"
        command[5] = library_dir
        command[6] = image
        command[7] = library_dir || "/library.rxbin"
        command[8] = "-a"
        command[9] = "-c"
        command[10] = "print(1)"
        child_output = .string[]
        child_error = .string[]
        started_us = time("us")
        address crexx "run :command[]" output child_output error child_error
        child_rc = rc
        elapsed_us = time("us") - started_us
        if elapsed_us < 0 then elapsed_us = elapsed_us + 86400000000
        first_line = ""
        if child_output[0] > 0 then first_line = child_output[1]
        say vm || "," || phase || "," || pair || "," || variant || "," || elapsed_us || "," || child_rc || "," || first_line
        if child_rc <> 0 | child_output[0] <> 1 | first_line <> "1" | child_error[0] <> 0 then do
          do i = 1 to child_output[0]
            say "STDOUT:" child_output[i]
          end
          do i = 1 to child_error[0]
            say "STDERR:" child_error[i]
          end
          return 1
        end
      end
    end
  end
  return 0
