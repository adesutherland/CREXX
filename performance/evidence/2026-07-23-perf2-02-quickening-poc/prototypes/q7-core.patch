+/* PERF2-02 Q7 PoC: build a fail-soft, module-owned quick-site plan from the
+ * immutable canonical image.  Records are stable for the module lifetime. */
+static void rxvm_perf2_build_quick_sites(module *mod) {
+    size_t instruction_index;
+    size_t previous_index;
+    size_t count;
+    size_t slot;
+    unsigned int previous_opcode;
+    rxvm_perf2_quick_site *sites;
+
+    if (!mod || mod->perf2_quick_sites_built) return;
+    mod->perf2_quick_sites_built = 1;
+    if (!mod->segment.binary || !mod->segment.inst_size) return;
+
+    count = 0;
+    previous_index = SIZE_MAX;
+    previous_opcode = OP_MAX_INSTRUCTIONS;
+    instruction_index = 0;
+    while (instruction_index < mod->segment.inst_size) {
+        unsigned int opcode =
+                (unsigned int)mod->segment.binary[instruction_index].instruction.opcode;
+        size_t operands =
+                (size_t)mod->segment.binary[instruction_index].instruction.no_ops;
+        if (operands >= mod->segment.inst_size - instruction_index) return;
+        if (opcode == OP_COPY_REG_REG || opcode == OP_MKREF_REG_REG) count++;
+        previous_index = instruction_index;
+        previous_opcode = opcode;
+        instruction_index += operands + 1u;
+    }
+
+    if (!count || count > SIZE_MAX / sizeof(*sites)) return;
+    sites = (rxvm_perf2_quick_site *)calloc(count, sizeof(*sites));
+    if (!sites) return;
+
+    slot = 0;
+    previous_index = SIZE_MAX;
+    previous_opcode = OP_MAX_INSTRUCTIONS;
+    instruction_index = 0;
+    while (instruction_index < mod->segment.inst_size && slot < count) {
+        unsigned int opcode =
+                (unsigned int)mod->segment.binary[instruction_index].instruction.opcode;
+        size_t operands =
+                (size_t)mod->segment.binary[instruction_index].instruction.no_ops;
+        rxvm_perf2_quick_site *site = 0;
+
+        if (opcode == OP_COPY_REG_REG) {
+            site = &sites[slot++];
+            site->family = RXVM_PERF2_QUICK_COPY;
+            site->state = RXVM_PERF2_QUICK_CANDIDATE;
+            site->canonical_index = instruction_index;
+            site->operand1 = mod->segment.binary[instruction_index + 1u].index;
+            site->operand2 = mod->segment.binary[instruction_index + 2u].index;
+        } else if (opcode == OP_MKREF_REG_REG && operands == 2u) {
+            site = &sites[slot++];
+            site->family = RXVM_PERF2_QUICK_REFERENCE;
+            site->state = RXVM_PERF2_QUICK_SPECIALIZED;
+            site->canonical_index = instruction_index;
+            site->operand1 = mod->segment.binary[instruction_index + 1u].index;
+            site->operand2 = mod->segment.binary[instruction_index + 2u].index;
+            if (previous_opcode == OP_MINLINKATTR1_REG_REG_REG_INT &&
+                previous_index != SIZE_MAX &&
+                previous_index + 5u == instruction_index &&
+                mod->segment.binary[previous_index + 1u].index ==
+                        mod->segment.binary[instruction_index + 2u].index) {
+                site->flags = 1u;
+                site->root_operand = mod->segment.binary[previous_index + 2u].index;
+                site->index_operand = mod->segment.binary[previous_index + 3u].index;
+                site->index_offset = mod->segment.binary[previous_index + 4u].iconst;
+            }
+        }
+
+        previous_index = instruction_index;
+        previous_opcode = opcode;
+        instruction_index += operands + 1u;
+    }
+
+    mod->perf2_quick_sites = sites;
+    mod->perf2_quick_site_count = slot;
+}
+
+static int rxvm_perf2_plain_copy_value(const value *v) {
+    return v && !v->reference_payload && !v->native_payload_ops &&
+           !v->decimal_value_length && !v->string_length && !v->binary_length &&
+           !v->num_attributes && !v->object_type;
+}
+
+static void rxvm_perf2_copy_plain_value(value *dest, const value *source) {
+    if (!dest || !source || dest == source) return;
+    dest->status.all_type_flags = source->status.all_type_flags;
+    dest->int_value = source->int_value;
+    dest->float_value = source->float_value;
+    dest->object_type = 0;
+    dest->decimal_value_length = 0;
+    dest->string_length = 0;
+    dest->string_pos = 0;
+#ifndef NUTF8
+    dest->string_chars = 0;
+    dest->string_char_pos = 0;
+#endif
+    dest->binary_length = 0;
+    dest->binary_pos = 0;
+    dest->native_payload_ops = 0;
+    dest->native_payload_flags = 0;
+    dest->num_attributes = 0;
+}
