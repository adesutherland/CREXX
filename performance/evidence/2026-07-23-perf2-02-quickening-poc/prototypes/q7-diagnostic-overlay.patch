+
+static uint64_t rxvm_perf2_diag_now(void) {
+#ifdef __APPLE__
+    return mach_absolute_time();
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * UINT64_C(1000000000) + (uint64_t)ts.tv_nsec;
+#endif
+}
+
+static void rxvm_perf2_diag_calibrate_timer(void) {
+    uint64_t i;
+    uint64_t minimum = UINT64_MAX;
+
+#ifdef __APPLE__
+    mach_timebase_info_data_t timebase;
+    mach_timebase_info(&timebase);
+    rxvm_perf2_diag.timer_numer = timebase.numer;
+    rxvm_perf2_diag.timer_denom = timebase.denom;
+#else
+    rxvm_perf2_diag.timer_numer = 1u;
+    rxvm_perf2_diag.timer_denom = 1u;
+#endif
+    rxvm_perf2_diag.timer_calibration_samples = UINT64_C(10000);
+    for (i = 0; i < rxvm_perf2_diag.timer_calibration_samples; i++) {
+        uint64_t start = rxvm_perf2_diag_now();
+        uint64_t elapsed = rxvm_perf2_diag_now() - start;
+        rxvm_perf2_diag.timer_pair_ticks += elapsed;
+        if (elapsed < minimum) minimum = elapsed;
+    }
+    rxvm_perf2_diag.timer_pair_min_ticks = minimum;
+}
+
+static void rxvm_perf2_diag_register(void) {
+    if (!rxvm_perf2_diag_registered) {
+        rxvm_perf2_diag_registered = 1;
+        rxvm_perf2_diag_calibrate_timer();
+        atexit(rxvm_perf2_diag_dump);
+    }
+}
