+static rxvm_perf2_quick_site *rxvm_perf2_diag_site_at(module *mod,
+                                                       size_t canonical_index) {
+    size_t left;
+    size_t right;
+
+    if (!mod || !mod->perf2_quick_sites) return 0;
+    left = 0;
+    right = mod->perf2_quick_site_count;
+    while (left < right) {
+        size_t mid = left + ((right - left) >> 1);
+        size_t site_index = mod->perf2_quick_sites[mid].canonical_index;
+        if (site_index == canonical_index) return &mod->perf2_quick_sites[mid];
+        if (site_index < canonical_index) left = mid + 1u;
+        else right = mid;
+    }
+    return 0;
+}
