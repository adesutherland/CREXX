+/* PERF2-02 Q3 PoC: prove current-frame ownership directly, without retaining
+ * any site, frame, value, or reference-cell state.  This deliberately covers
+ * only an own local and a physical immediate child of an own local. */
+static int rxvm_reference_try_current_frame_owner(stack_frame *frame,
+                                                  size_t source_register,
+                                                  value *storage,
+                                                  rxvm_ref_owner_kind *owner_kind,
+                                                  void **owner) {
+    size_t i;
+    size_t j;
+    size_t locals;
+
+    if (!frame || !frame->procedure || !storage || !owner_kind || !owner) return 0;
+    locals = (size_t)frame->procedure->locals;
+    if (locals > frame->number_locals) locals = frame->number_locals;
+
+    if (source_register < locals &&
+        frame->locals[source_register] == frame->baselocals[source_register] &&
+        storage == frame->baselocals[source_register]) {
+        *owner_kind = RXVM_REF_LOCAL;
+        *owner = frame;
+        return 1;
+    }
+
+    for (i = 0; i < locals; i++) {
+        value *root = frame->baselocals[i];
+        if (!root || frame->locals[i] != root ||
+            !root->attributes || !root->unlinked_attributes) continue;
+        for (j = 0; j < root->num_attributes; j++) {
+            if (root->attributes[j] == storage &&
+                root->unlinked_attributes[j] == storage) {
+                *owner_kind = RXVM_REF_ATTRIBUTE;
+                *owner = 0;
+                return 1;
+            }
+        }
+    }
+
+    return 0;
+}
