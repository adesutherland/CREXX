/* PERF2-02 isolated PoC guard fixture; not a production test. */

.globals=0

main() .locals=16
    load r2,1

    /* Physical child of an own local: guarded hit, invalid at root lifetime. */
    setattrs r1,1
    minlinkattr1 r3,r1,r2,0
    load r3,"owned"
    mkref r4,r3
    unlink r3
    endlife r1
    refvalid r6,r4
    ieq r0,r6,0
    brf fail_owned_lifetime,r0

    /* Live slot linked to another local: mandatory guard miss and fallback. */
    setattrs r1,1
    load r5,"external"
    linktoattr1 1,r1,r5
    minlinkattr1 r3,r1,r2,0
    mkref r4,r3
    unlink r3
    endlife r1
    refvalid r6,r4
    ieq r0,r6,1
    brf fail_external_survives_root,r0
    load r5,"external-updated"
    deref r7,r4
    seq r0,r7,"external-updated"
    brf fail_external_value,r0
    endlife r5
    refvalid r6,r4
    ieq r0,r6,0
    brf fail_external_lifetime,r0

    /* Direct own local: eager local handler, invalid at local lifetime. */
    load r8,"local"
    mkref r9,r8
    endlife r8
    refvalid r6,r9
    ieq r0,r6,0
    brf fail_local_lifetime,r0

    say "PASS: PERF2-02 reference guards"
    ret 0

fail_owned_lifetime:
    say "FAIL: owned child lifetime"
    ret 1
fail_external_survives_root:
    say "FAIL: linked external died with root"
    ret 1
fail_external_value:
    say "FAIL: linked external value"
    ret 1
fail_external_lifetime:
    say "FAIL: linked external lifetime"
    ret 1
fail_local_lifetime:
    say "FAIL: direct local lifetime"
    ret 1
