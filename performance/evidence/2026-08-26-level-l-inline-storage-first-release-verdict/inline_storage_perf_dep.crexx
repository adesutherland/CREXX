options levelb
namespace inline_storage_perf_dep expose token store
import rxfnsb

token: class
  value_ = .int

  *: factory
    arg value = .int
    value_ = value
    return

  /* Deliberately leave one real member call after the outer forwarding
   * accessor is inlined. This keeps the comparison honest. */
  runtimeValue: method = .int
    value = .int
    value = value_
    assembler unlink value
    return value

store: class
  current_ = .inline_storage_perf_dep..token
  classes_ = .int[2]
  bytes_ = .binary

  *: factory
    current_ = .inline_storage_perf_dep..token(3)
    classes_[1] = 11
    data = .binary
    call binresize data, 1
    bytes_ = data
    <at..u8>(0) bytes_ = 7
    return

  currentValue: method = .int
    return current_.runtimeValue()

  classAt: method = .int
    arg index = .int
    return classes_[index]

  byteAt: method = .int
    arg offset = .int
    return <at..u8>(offset) bytes_
