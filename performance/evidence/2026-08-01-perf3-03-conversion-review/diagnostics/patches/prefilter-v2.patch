+/*
+ * Fail closed only for an empty span or an impossible leading ASCII byte.
+ * Keeping this wrapper out of line preserves the compact loose-comparison
+ * caller while compatible or uncertain forms use the existing converter.
+ */
+static RXVM_LABEL_OWNER_NOINLINE int rxvm_loose_string2float(
+        double *out, const char *text, size_t length) {
+    unsigned char first;
+
+    if (length == 0) return 1;
+    first = (unsigned char)text[0];
+    if (first < 0x80 &&
+        !((first >= '0' && first <= '9') || first == '+' || first == '-' ||
+          first == '.' || first == ',' || first == 'i' || first == 'I' ||
+          first == 'n' || first == 'N' || first == ' ' || first == '\t' ||
+          first == '\n' || first == '\r' || first == '\f' || first == '\v')) {
+        return 1;
+    }
+    return string2float(out, (char *)text, length);
+}
