+/*
+ * Fail-closed loose-comparison numeric prefilter. It rejects only an empty
+ * ASCII-whitespace span or an ASCII leading byte that no supported strtod
+ * spelling can begin with. Non-ASCII input and both common locale decimal
+ * separators fall back to the existing converter.
+ */
+static int rxvm_maybe_numeric_text(const char *text, size_t length) {
+    size_t i = 0;
+    unsigned char first;
+
+    while (i < length) {
+        first = (unsigned char)text[i];
+        if (first >= 0x80) return 1;
+        if (first != ' ' && first != '\t' && first != '\n' && first != '\r' &&
+            first != '\f' && first != '\v') break;
+        i++;
+    }
+    if (i == length) return 0;
+    first = (unsigned char)text[i];
+    return (first >= '0' && first <= '9') || first == '+' || first == '-' ||
+           first == '.' || first == ',' || first == 'i' || first == 'I' ||
+           first == 'n' || first == 'N';
+}
