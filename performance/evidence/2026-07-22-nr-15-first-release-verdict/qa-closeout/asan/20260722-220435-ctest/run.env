phase=ctest
build_dir=cmake-build-debugasan
build_jobs=4
test_jobs=1
build_leaks=on
test_leaks=off
stop_on_failure=0
regex=^(13_stems_(noopt|opt)|repro_multi_tail_stems_(noopt|opt)|13_stems_run_(noopt|opt)|repro_multi_tail_stems_run_(noopt|opt)|trace_stem_sugar|rxvmstem_storage|ts_regvalue_tester|rxasreference(catch)?tests(-rxbvm)?|nr21_fixed_call_contract|nr14_frozen_parse_contract|nr15_native_stem_contract|ts_stem(_errors)?_(noopt|opt)|nr15_stem_(semantics|access)_(rxvm|rxbvm)_(noopt|opt))$
exclude_regex=
exclude_regex_file=
ctest_index=
fixture_exclude_setup=linked_opt_runtime_artifacts
fixture_exclude_any=
base_asan_options=
