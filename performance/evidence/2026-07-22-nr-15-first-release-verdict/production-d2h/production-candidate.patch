+                        "STEM index is outside the stored range");
+            }
+            DISPATCH;
+
+        START_INSTRUCTION(STEMSET_REG_REG_REG) VM_ADVANCE(3);
+            DEBUG("TRACE - STEMSET R%d,R%d,R%d\n",
+                  (int)REG_IDX(1), (int)REG_IDX(2), (int)REG_IDX(3));
+            REQUIRE_VALID_UTF8_REGISTER(REG_OP(2));
