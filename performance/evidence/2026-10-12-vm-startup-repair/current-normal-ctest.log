  /* ##cflag nosrcmap */

  /* A small end-to-end RexxScript block example.  */

  total = .string

  count = .string

  output = .string[]

  raw = .string[]

  /* D*/

  __rexxscript_source = ''

  __rexxscript_source = __rexxscript_source || ' count = 3' || ";"

  __rexxscript_source = __rexxscript_source || ' total = 10 + 20 + 30' || ";"

  __rexxscript_source = __rexxscript_source || " say 'RexxScript total:'
  total" || ";"

  __rexxscript_source = __rexxscript_source || ' msg.1=111' || ";"

  __rexxscript_source = __rexxscript_source || ' msg.2=222' || ";"

  __rexxscript_source = __rexxscript_source || ' msg.3=333' || ";"

  __rexxscript_source = __rexxscript_source || ' msg.0=3' || ";"

  __rexxscript_source = __rexxscript_source || ' do i=1 to msg.0' || ";"

  __rexxscript_source = __rexxscript_source || " say 987' 'msg.i" || ";"

  __rexxscript_source = __rexxscript_source || ' end' || ";"

  REXXSCRIPT __rexxscript_source EXPOSE total, count OUTPUT output RESULT raw

  say 'Captured output:'

  do i=1 to output[0]

    say output[i]

  end

  say 'Total from RexxScript:' total

  say 'Count from RexxScript:' count

  say 'Raw status:' raw[1]




