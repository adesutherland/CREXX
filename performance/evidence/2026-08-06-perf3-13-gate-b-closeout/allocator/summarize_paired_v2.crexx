/* PERF3-13 Gate B closeout pairwise-balanced control/candidate summary. */
options levelb comments_dash
import rxfnsb

arg argv = .string[]
if argv[0] < 3 then do
  say "Usage: summarize_paired OUTPUT_SUMMARY OUTPUT_COMMON SAMPLES [SAMPLES ...]"
  return 2
end

output_path = argv[1]
common_path = argv[2]
group_keys = .string[]
group_workloads = .string[]
group_vms = .string[]
group_metrics = .string[]
before_values = .float[]
after_values = .float[]
before_counts = .int[]
after_counts = .int[]
group_count = 0
before_medians = .float[]
after_medians = .float[]

do input_number = 3 to argv[0]
  input_path = argv[input_number]
  line_number = 0
  do while lines(input_path)
    line = linein(input_path)
    line_number = line_number + 1
    if line_number = 1 then iterate
    fields = split_delimited(line, ",")
    if fields[0] <> 20 then return fail("unexpected sample row width")
    if fields[11] <> "recorded" then iterate
    if fields[18] <> "pass" then return fail("non-passing recorded sample")

    vm_name = fields[6]
    if vm_name = "rxvm" then vm_name = "rxtvm"
    key = fields[3] || "/" || vm_name
    group = find_group(group_keys, group_count, key)
    if group = 0 then do
      group_count = group_count + 1
      group = group_count
      group_keys[group] = key
      group_workloads[group] = fields[3]
      group_vms[group] = vm_name
      group_metrics[group] = "elapsed_ns"
      if fields[3] = "RexxCPS" then group_metrics[group] = "benchmark_rate"
    end

    sample_value = fields[15]
    if group_metrics[group] = "benchmark_rate" then sample_value = fields[19]

    if fields[7] = "current-product" then do
      before_counts[group] = before_counts[group] + 1
      before_values[group * 100 + before_counts[group]] = sample_value
    end
    else if fields[7] = "gateb-worker-slabs" | ,
        fields[7] = "gateb-large-slabs" | ,
        fields[7] = "gateb-worker-slabs-closeout" then do
      after_counts[group] = after_counts[group] + 1
      after_values[group * 100 + after_counts[group]] = sample_value
    end
    else return fail("unexpected variant")
  end
  call linein input_path
end

call remove_output output_path
header = "workload,vm,metric,pairs,before_median,after_median,min_percent," || ,
    "q1_percent,median_percent,q3_percent,max_percent,mean_percent," || ,
    "mean_95_ci_low_percent,mean_95_ci_high_percent,interval_result," || ,
    "favorable,total"
if lineout(output_path, header) <> 0 then return fail("could not create paired summary")

do group = 1 to group_count
  if before_counts[group] <> after_counts[group] then return fail("incomplete pair set")
  count = before_counts[group]
  if count < 2 | count > 36 then return fail("paired count is outside 2..36")
  before = .float[]
  after = .float[]
  do pair = 1 to count
    before[pair] = before_values[group * 100 + pair]
    after[pair] = after_values[group * 100 + pair]
  end
  if write_summary(output_path, group_workloads[group], group_vms[group], ,
      group_metrics[group], before, after) <> 0 then return 1
  call sort_floats before
  call sort_floats after
  before_medians[group] = sample_quantile(before, 1, 2)
  after_medians[group] = sample_quantile(after, 1, 2)
end
call lineout output_path
if write_common(common_path, group_workloads, group_vms, before_medians, ,
    after_medians) <> 0 then return 1

say "PASS: PERF3-13 Gate B paired summary retained at" output_path
return 0

write_summary: procedure = .int
  arg output_path = .string, workload = .string, vm = .string, ,
      metric = .string, before = .float[], after = .float[]
  count = before[0]
  deltas = .float[]
  favorable = 0
  sum = 0.0
  do pair = 1 to count
    delta = ((after[pair] - before[pair]) * 100.0) / before[pair]
    deltas[pair] = delta
    sum = sum + delta
    if metric = "elapsed_ns" & delta < 0.0 then favorable = favorable + 1
    if metric = "benchmark_rate" & delta > 0.0 then favorable = favorable + 1
  end

  call sort_floats before
  call sort_floats after
  call sort_floats deltas
  mean = sum / (count as .float)
  sum_squares = 0.0
  do i = 1 to count
    difference = deltas[i] - mean
    sum_squares = sum_squares + difference * difference
  end
  sample_deviation = square_root(sum_squares / ((count - 1) as .float))
  margin = t_critical_95(count - 1) * sample_deviation / square_root(count as .float)
  interval_low = mean - margin
  interval_high = mean + margin
  interval_result = "noisy_inconclusive"
  if metric = "elapsed_ns" then do
    if interval_high < 0.0 then interval_result = "clear_favorable"
    else if interval_low > 0.0 then interval_result = "clear_adverse"
  end
  else do
    if interval_low > 0.0 then interval_result = "clear_favorable"
    else if interval_high < 0.0 then interval_result = "clear_adverse"
  end
  row = workload || "," || vm || "," || metric || "," || count || "," || ,
      float_text(sample_quantile(before, 1, 2)) || "," || ,
      float_text(sample_quantile(after, 1, 2)) || "," || float_text(deltas[1]) || ,
      "," || float_text(sample_quantile(deltas, 1, 4)) || "," || ,
      float_text(sample_quantile(deltas, 1, 2)) || "," || ,
      float_text(sample_quantile(deltas, 3, 4)) || "," || ,
      float_text(deltas[count]) || "," || float_text(mean) || "," || ,
      float_text(interval_low) || "," || float_text(interval_high) || "," || ,
      interval_result || "," || favorable || "," || count
  if lineout(output_path, row) <> 0 then return fail("could not append paired row")
  return 0

write_common: procedure = .int
  arg output_path = .string, workloads = .string[], vms = .string[], ,
      before_medians = .float[], after_medians = .float[]
  vm_names = .string[]
  vm_names[1] = "rxtvm"
  vm_names[2] = "rxbvm"
  products = .float[]
  counts = .int[]
  memberships = .string[]
  do vm_index = 1 to 2
    products[vm_index] = 1.0
    counts[vm_index] = 0
    memberships[vm_index] = ""
  end
  do group = 1 to workloads[0]
    if common_workload(workloads[group]) = 0 then iterate
    vm_index = 0
    if vms[group] = "rxtvm" then vm_index = 1
    else if vms[group] = "rxbvm" then vm_index = 2
    else return fail("unexpected VM in common aggregate")
    if after_medians[group] <= 0.0 then return fail("non-positive common median")
    products[vm_index] = products[vm_index] * ,
        (before_medians[group] / after_medians[group])
    counts[vm_index] = counts[vm_index] + 1
    if memberships[vm_index] <> "" then
      memberships[vm_index] = memberships[vm_index] || ";"
    memberships[vm_index] = memberships[vm_index] || workloads[group]
  end
  call remove_output output_path
  if lineout(output_path, ,
      "vm,n,geometric_mean_candidate_over_current,membership") <> 0 then
    return fail("could not create common aggregate")
  do vm_index = 1 to 2
    if counts[vm_index] <> 5 then return fail("common aggregate does not contain five workloads")
    row = vm_names[vm_index] || "," || counts[vm_index] || "," || ,
        float_text(nth_root(products[vm_index], counts[vm_index])) || "," || ,
        memberships[vm_index]
    if lineout(output_path, row) <> 0 then return fail("could not append common aggregate")
  end
  call lineout output_path
  return 0

common_workload: procedure = .int
  arg workload = .string
  if workload = "Sieve" | workload = "Permute" | workload = "Bounce" | ,
      workload = "Richards" | workload = "Base64" then return 1
  return 0

nth_root: procedure = .float
  arg value = .float, degree = .int
  if degree <= 0 | value <= 0.0 then return 0.0
  guess = 1.0
  if value > 1.0 then guess = value / (degree as .float)
  do iteration = 1 to 80
    divisor = int_power(guess, degree - 1)
    if divisor = 0.0 then return 0.0
    next_guess = (((degree - 1) as .float) * guess + value / divisor) / ,
        (degree as .float)
    if floatabs(next_guess - guess) < 0.000000000001 then return next_guess
    guess = next_guess
  end
  return guess

int_power: procedure = .float
  arg base = .float, exponent = .int
  result = 1.0
  do i = 1 to exponent
    result = result * base
  end
  return result

find_group: procedure = .int
  arg keys = .string[], group_count = .int, key = .string
  do group = 1 to group_count
    if keys[group] = key then return group
  end
  return 0

remove_output: procedure = .void
  arg path = .string
  remove_out = .string[]
  remove_err = .string[]
  address crexx "rm :path" output remove_out error remove_err
  return

split_delimited: procedure = .string[]
  arg text = .string, delimiter = .string
  fields = .string[]
  start = 1
  do forever
    delimiter_at = pos(delimiter, text, start)
    if delimiter_at = 0 then do
      fields[fields[0] + 1] = substr(text, start)
      leave
    end
    fields[fields[0] + 1] = substr(text, start, delimiter_at - start)
    start = delimiter_at + length(delimiter)
  end
  return fields

sort_floats: procedure = .void
  arg expose values = .float[]
  do i = 2 to values[0]
    item = values[i]
    j = i - 1
    do while j >= 1 & values[j] > item
      values[j + 1] = values[j]
      j = j - 1
    end
    values[j + 1] = item
  end
  return

sample_quantile: procedure = .float
  arg values = .float[], numerator = .int, denominator = .int
  scaled = (values[0] - 1) * numerator
  lower_zero_index = scaled <idiv> denominator
  remainder = scaled <mod> denominator
  lower_value = values[lower_zero_index + 1]
  if remainder = 0 then return lower_value
  return lower_value + (values[lower_zero_index + 2] - lower_value) * ,
      ((remainder as .float) / (denominator as .float))

square_root: procedure = .float
  arg value = .float
  if value <= 0.0 then return 0.0
  guess = value
  if guess < 1.0 then guess = 1.0
  do iteration = 1 to 80
    next_guess = (guess + value / guess) / 2.0
    if floatabs(next_guess - guess) < 0.000000000001 then return next_guess
    guess = next_guess
  end
  return guess

t_critical_95: procedure = .float
  arg degrees = .int
  if degrees <= 11 then return 2.200985
  if degrees = 12 then return 2.178813
  if degrees = 13 then return 2.160369
  if degrees = 14 then return 2.144787
  if degrees = 15 then return 2.131450
  if degrees = 16 then return 2.119905
  if degrees = 17 then return 2.109816
  if degrees = 18 then return 2.100922
  if degrees = 19 then return 2.093024
  if degrees = 20 then return 2.085963
  if degrees = 21 then return 2.079614
  if degrees = 22 then return 2.073873
  if degrees = 23 then return 2.068658
  if degrees = 24 then return 2.063899
  if degrees = 25 then return 2.059539
  if degrees = 26 then return 2.055529
  if degrees = 27 then return 2.051831
  if degrees = 28 then return 2.048407
  if degrees = 29 then return 2.045230
  if degrees = 30 then return 2.042272
  if degrees = 31 then return 2.039513
  if degrees = 32 then return 2.036933
  if degrees = 33 then return 2.034515
  if degrees = 34 then return 2.032245
  return 2.030108

float_text: procedure = .string
  arg value = .float
  return strip(floatformat(value, , 6))

fail: procedure = .int
  arg message = .string
  say "ERROR:" message
  return 1
