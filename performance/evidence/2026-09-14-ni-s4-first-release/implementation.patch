+    errors = errors + embedding_request(session, config, 1)
+  end
+  do i = 1 to 20
+    errors = errors + embedding_request(session, config, 8)
+  end
+  loads = 0
+  errors = errors + check(rxllama..infoint(model, "load_count", loads) = 0 & loads = 1, "persistent weights")
+  request = .binary
+  other = .binary
+  errors = errors + check(rxllama..requestopen(session, config, request) = 0, "request open")
+  errors = errors + check(rxllama..requestopen(session, config, other) <> 0, "one active request")
+  errors = errors + check(rxllama..close(session) <> 0, "request retains session")
+  row = 0
+  errors = errors + check(rxllama..addembedding(request, "cat", "query", row) = 0, "query")
+  errors = errors + check(rxllama..submit(request) = 0, "cancel submit")
+  errors = errors + check(rxllama..cancel(request) = 0, "cancel")
+  state = ""
+  errors = errors + check(rxllama..process(request, 512, state) = 0 & state = "cancelled", "cancel state")
+  errors = errors + check(rxllama..close(request) = 0, "cancel close")
+  errors = errors + embedding_request(session, config, 4)
+  errors = errors + check(rxllama..close(session) = 0, "session close")
+  errors = errors + check(rxllama..close(model) = 0, "model close")
+  errors = errors + check(rxllama..close(runtime) = 0, "runtime close")
+  errors = errors + check(rxllama..close(config) = 0, "config close")
+  if errors <> 0 then return 1
+  say "PASS: rxllama persistent embedding acceptance" args[1]
+  return 0
