+                    break;
+                case 'I': SETINT(args[i], output.integer); break;
+                case 'S': SETSTRING(args[i], output.text); break;
+            }
+        }
+    }
+finish:
+    SETINT(result, status); SETINT(signal, SIGNAL_NONE); SETSTRING(signal, "");
+}
