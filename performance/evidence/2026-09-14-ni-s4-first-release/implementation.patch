+  errors = errors + check(rxllama..submit(request) = 0, "owned text submit")
+  tokens = 0
+  errors = errors + check(rxllama..infoint(request, "input_tokens", tokens) = 0 & tokens = 4, "complete owned tokenizer input")
+  errors = errors + check(complete_request(request) = 0, "NUL completion")
+  values = .packedfloat(0)
+  rows = 0
+  dimensions = 0
+  errors = errors + check(rxllama..embeddings(request, values, rows, dimensions) = 0, "NUL output")
+  errors = errors + check(rxllama..close(request) = 0, "NUL request close")
+  errors = errors + check(values.size() = 384, "packed output survives request close")
+  return errors
+
