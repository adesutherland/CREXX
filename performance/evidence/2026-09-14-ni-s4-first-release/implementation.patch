+
+check: procedure = .int
+  arg condition = .boolean, label = .string
+  if condition then return 0
+  say "FAIL: rxllama" label
+  return 1
+
+elapsed: procedure = .int
+  arg started = .int
+  duration = time("us") - started
+  if duration < 0 then duration = duration + 86400000000
+  return duration
+
+ready_model: procedure = .int
+  arg model = .binary
+  started = time("us")
+  do while elapsed(started) < 60000000
+    state = ""
+    if rxllama..modelstate(model, state) <> 0 then return 1
+    if state = "ready" then return 0
+    if state <> "loading" then return 1
+  end
+  say "FAIL: model preparation deadline"
+  return 1
+
+ready_session: procedure = .int
+  arg session = .binary
+  started = time("us")
+  do while elapsed(started) < 60000000
+    state = ""
+    if rxllama..prepare(session, 512, state) <> 0 then return 1
+    if state = "ready" then return 0
+    if state = "failed" | state = "cancelled" then return 1
+  end
+  say "FAIL: session preparation deadline"
+  return 1
+
+complete_request: procedure = .int
+  arg request = .binary
+  started = time("us")
+  do while elapsed(started) < 60000000
+    state = ""
+    if rxllama..process(request, 512, state) <> 0 then return 1
+    if state = "complete" then return 0
+    if state <> "running" then return 1
+  end
+  say "FAIL: request deadline"
+  return 1
+
+rejected_model: procedure = .int
+  arg runtime = .binary, path = .string, hash = .string, config = .binary
+  model = .binary
+  if rxllama..modelopen(runtime, path, hash, "bge-small-en-v1.5", config, model) <> 0 then return 0
+  started = time("us")
+  do while elapsed(started) < 60000000
+    state = ""
+    if rxllama..modelstate(model, state) <> 0 then return 1
+    if state = "failed" then return check(rxllama..close(model) = 0, "failed model close")
+    if state <> "loading" then return 1
+  end
+  return 1
+
+embedding_failures: procedure = .int
+  arg session = .binary, config = .binary
+  request = .binary
+  if rxllama..requestopen(session, config, request) <> 0 then return 1
+  errors = check(rxllama..submit(request) <> 0, "empty batch rejected")
+  errors = errors + check(rxllama..close(request) = 0, "empty request close")
+  if rxllama..requestopen(session, config, request) <> 0 then return 1
+  row = 0
+  status = rxllama..addembedding(request, copies("a ", 513), "document", row)
+  if status = 0 then errors = errors + check(rxllama..submit(request) <> 0, "oversized batch rejected")
+  errors = errors + check(rxllama..close(request) = 0, "invalid request close")
+  if rxllama..requestopen(session, config, request) <> 0 then return 1
+  values = .packedfloat(0)
+  rows = 0
+  dimensions = 0
+  errors = errors + check(rxllama..embeddings(request, values, rows, dimensions) <> 0, "no incomplete embedding publication")
+  errors = errors + check(rxllama..close(request) = 0, "capability failure close")
+  return errors
+
+embedding_request: procedure = .int
+  arg session = .binary, config = .binary, count = .int
+  request = .binary
+  if rxllama..requestopen(session, config, request) <> 0 then return 1
+  errors = 0
+  status = .int
+  i = .int
+  do i = 1 to count
+    row = 0
+    text = "A cat sits by the window. Row " || i
+    status = rxllama..addembedding(request, text, "document", row)
+    errors = errors + check(status = 0 & row = i, "ordered embedding admission")
+  end
+  errors = errors + check(rxllama..submit(request) = 0, "embedding submit")
+  errors = errors + check(complete_request(request) = 0, "embedding completion")
+  values = .packedfloat(0)
+  rows = 0
+  dimensions = 0
+  status = rxllama..embeddings(request, values, rows, dimensions)
