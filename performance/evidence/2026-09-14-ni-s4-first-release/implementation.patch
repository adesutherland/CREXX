+shutil.copy2(program.parent / provider.name, relocated / provider.name)
+clean = dict(os.environ)
+for key in ("CREXX_HOME", "DYLD_LIBRARY_PATH", "DYLD_FALLBACK_LIBRARY_PATH", "LD_LIBRARY_PATH", "GGML_BACKEND_PATH"):
