+        summary->branches != 0 || summary->calls != 0 ||
+        (summary->result_flags & (RXCP_INLINE_RESULT_FALLTHROUGH |
+                                  RXCP_INLINE_RESULT_MULTIPLE))) {
         return 0;
     }
 
