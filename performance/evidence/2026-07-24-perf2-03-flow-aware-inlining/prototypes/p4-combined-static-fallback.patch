diff --git a/compiler/rxcp_inline_rewrite.c b/compiler/rxcp_inline_rewrite.c
index 966fe2030..040960898 100644
--- a/compiler/rxcp_inline_rewrite.c
+++ b/compiler/rxcp_inline_rewrite.c
@@ -409,6 +409,41 @@ static int inline_count_return_nodes(ASTNode *node) {
     return count;
 }
 
+#define PERF2_P4_CLEANED_NODE_BUDGET 100u
+
+static size_t inline_candidate_node_count(ASTNode *node) {
+    ASTNode *child;
+    size_t count;
+
+    if (!node) return 0;
+    count = 1;
+    for (child = node->child; child; child = child->sibling) {
+        count += inline_candidate_node_count(child);
+    }
+    return count;
+}
+
+/* PERF2-03 P4 prototype.  P1/P2 perform clone-time cleanup and P3 performs
+ * final scalar result placement; this last detached-candidate gate preserves
+ * the original call whenever the remaining expanded tree exceeds the bounded
+ * static-size budget.  It deliberately does not claim profile profitability:
+ * the experiment tests fallback ownership and shows why dynamic frequency and
+ * a candidate-local flow overlay are still required. */
+static int inline_candidate_passes_p4_budget(Context *context,
+                                             ASTNode *candidate,
+                                             ASTNode *call_node,
+                                             Symbol *proc_sym) {
+    size_t nodes;
+
+    nodes = inline_candidate_node_count(candidate);
+    if (nodes <= PERF2_P4_CLEANED_NODE_BUDGET) return 1;
+    inline_debug_fail_closed(context,
+                             call_node,
+                             proc_sym,
+                             "P4 fallback retained original call after bounded candidate cost gate");
+    return 0;
+}
