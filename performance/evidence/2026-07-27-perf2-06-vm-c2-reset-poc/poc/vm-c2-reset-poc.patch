+
+static int rxvm_vm_c2_legacy_operand_selected(
+        unsigned int mask, size_t operand_index) {
+    if (mask == RXOP_OP_ALL) return 1;
+    if (operand_index >= 3u) return 0;
+    return (mask & (1u << operand_index)) != 0;
+}
+
+static int rxvm_vm_c2_signature_operand_selected(
+        const char *signature, size_t operand_index) {
+    size_t signature_length;
+
+    if (!signature) return 0;
+    signature_length = strlen(signature);
+    return operand_index < signature_length &&
+           signature[operand_index] == '1';
+}
+
+static int rxvm_vm_c2_effect_branch_target(
+        int opcode, size_t operand_index) {
+    switch (opcode) {
+#define RXE(STATE, READS, WRITES, KILLS, BRANCH_TARGETS, IMPLICIT, SEMANTICS) \
+        rxvm_vm_c2_legacy_operand_selected(BRANCH_TARGETS, operand_index)
+#define RXEV(STATE, READS, WRITES, KILLS, BRANCH_TARGETS, IMPLICIT, SEMANTICS) \
+        rxvm_vm_c2_signature_operand_selected(BRANCH_TARGETS, operand_index)
+#define RXEC(STATE, READS, WRITES, KILLS, BRANCH_TARGETS, IMPLICIT, SEMANTICS, \
+             CURSOR_READS, CURSOR_WRITES, CONST_EVALUATOR) \
+        rxvm_vm_c2_legacy_operand_selected(BRANCH_TARGETS, operand_index)
+#define RXOP_EFFECT(NAME, EFFECTS) case OP_##NAME: return EFFECTS;
+#include "../binutils/include/rxopeffects.h"
+#undef RXOP_EFFECT
+#undef RXEC
+#undef RXEV
+#undef RXE
+        default: return 0;
+    }
+}
+
+/* These are the canonical instructions that can change a frame register's
+ * pointer mapping, including call-window restoration hazards.  Object
+ * attribute LINKTOATTR/UNLINKATTR instructions intentionally do not appear:
+ * they change an object's attribute table, not the frame mapping. */
+static int rxvm_vm_c2_opcode_may_rebind_frame(int opcode) {
+    unsigned int semantics = rxvm_vm_c2_effect_semantics(opcode);
+
+    if (semantics & (RXOP_SEM_ALIAS_CREATE | RXOP_SEM_ALIAS_RELEASE)) {
+        switch (opcode) {
+            case OP_LINKTOATTR_REG_REG_REG:
+            case OP_LINKTOATTR_INT_REG_REG:
+            case OP_LINKTOATTR1_REG_REG_REG:
+            case OP_LINKTOATTR1_INT_REG_REG:
+            case OP_UNLINKATTR_REG_REG:
+            case OP_UNLINKATTR_INT_REG:
+            case OP_UNLINKATTR1_REG_REG:
+            case OP_UNLINKATTR1_INT_REG:
+                break;
+            default:
+                return 1;
+        }
+    }
+
+    switch (opcode) {
+        case OP_LOAD_REG_REG:
+        case OP_LOAD_INT_INT:
+        case OP_LOAD_INT_REG:
+        case OP_CALL_REG_FUNC_REG:
+        case OP_DCALL_REG_REG_REG:
+        case OP_SWAPN_REG_REG_REG_REG:
+        case OP_SWAPN_REG_REG_REG_REG_REG_REG:
+        case OP_SWAPN_REG_REG_REG_REG_REG_REG_REG_REG:
+        case OP_SETTPSWAP_REG_INT_REG:
+        case OP_LOADSETTPSWAP_REG_INT_REG_INT_REG:
+        case OP_SWAPSETTP_REG_REG_REG_INT:
+        case OP_SWAPSETTPSWAP_REG_REG_REG_INT_REG:
+        case OP_SETTPSWAPSETTPSWAP_REG_INT_REG_REG_REG:
+        case OP_SWAPCALL_REG_FUNC_REG_REG_REG:
+        case OP_SETTPSWAPCALL_REG_FUNC_REG_REG_INT_REG:
+        case OP_SETTPCALL_REG_FUNC_REG_REG_INT:
+        case OP_SWAP_REG_REG:
+            return 1;
+        default:
+            return 0;
+    }
+}
+
+static void rxvm_vm_c2_classify_runtime_procedure(
+        module *mod, proc_runtime *runtime,
+        const unsigned char *instruction_boundaries) {
+    size_t end;
+    size_t index;
+    size_t candidate;
+    size_t proc_index;
+    int may_rebind = 0;
+
+    runtime->may_rebind_core = 1;
+    runtime->vm_c2_reset_class = RXVM_VM_C2_RESET_CLASS_UNKNOWN;
+#if RXVM_VM_C2_RESET_DIAGNOSTICS
+    runtime->vm_c2_instructions_scanned = 0;
+#endif
+
+    if (!mod || mod->native || !runtime->binarySpace ||
+        runtime->start == SIZE_MAX || !mod->segment.binary ||
+        runtime->start >= mod->segment.inst_size || !instruction_boundaries ||
+        !instruction_boundaries[runtime->start]) return;
+
+    end = mod->segment.inst_size;
+    for (proc_index = 0; proc_index < mod->procedure_count; proc_index++) {
+        if (mod->procedures[proc_index].binarySpace != &mod->segment) continue;
+        candidate = mod->procedures[proc_index].start;
+        if (candidate > runtime->start && candidate < end) end = candidate;
+    }
+    if (!instruction_boundaries[end]) return;
+
+    index = runtime->start;
+    while (index < end) {
+        int opcode = mod->segment.binary[index].instruction.opcode;
+        int operand_count = mod->segment.binary[index].instruction.no_ops;
+        int expected_operands = rxvm_vm_c2_expected_operands(opcode);
+        unsigned int semantics;
+        FlowType flow;
+        size_t operand_index;
+        size_t branch_target_count = 0;
+        size_t next;
+
+        if (expected_operands < 0 ||
+            rxvm_vm_c2_effect_state(opcode) != RXOP_EFFECT_CLASSIFIED ||
+            operand_count != expected_operands ||
+            (size_t)operand_count >= end - index) return;
+        semantics = rxvm_vm_c2_effect_semantics(opcode);
+        if (semantics & RXOP_SEM_INDIRECT_BRANCH) return;
+        flow = rxvm_vm_c2_opcode_flow(opcode);
+        for (operand_index = 0;
+             operand_index < (size_t)operand_count;
+             operand_index++) {
+            size_t target;
+
+            if (!rxvm_vm_c2_effect_branch_target(opcode, operand_index))
+                continue;
+            branch_target_count++;
+            target = mod->segment.binary[index + operand_index + 1u].index;
+            if (target < runtime->start || target >= end ||
+                !instruction_boundaries[target]) return;
+        }
+        if ((flow == FLOW_JUMP || flow == FLOW_COND) &&
+            branch_target_count == 0) return;
+        next = index + (size_t)operand_count + 1u;
+        if (next == end &&
+            (flow == FLOW_NEXT ||
+             (flow == FLOW_COND && branch_target_count < 2u))) return;
+#if RXVM_VM_C2_RESET_DIAGNOSTICS
+        runtime->vm_c2_instructions_scanned++;
+#endif
+        if (rxvm_vm_c2_opcode_may_rebind_frame(opcode)) may_rebind = 1;
+        index = next;
+    }
+
+    if (index != end) return;
+    runtime->may_rebind_core = (unsigned char)may_rebind;
+    runtime->vm_c2_reset_class = may_rebind
+            ? RXVM_VM_C2_RESET_CLASS_MAY_REBIND
+            : RXVM_VM_C2_RESET_CLASS_PROVED_CLEAN;
+}
+
+static void rxvm_vm_c2_classify_module_procedures(module *mod) {
+    unsigned char *instruction_boundaries;
+    size_t instruction_index;
+    size_t proc_index;
+    int valid_stream = 0;
+
+    if (!mod || !mod->segment.binary || !mod->segment.inst_size ||
+        mod->segment.inst_size == SIZE_MAX) return;
+    instruction_boundaries = (unsigned char *)calloc(
+            mod->segment.inst_size + 1u, sizeof(*instruction_boundaries));
+    if (!instruction_boundaries) return;
+
+    instruction_index = 0;
+    while (instruction_index < mod->segment.inst_size) {
+        int opcode = mod->segment.binary[instruction_index].instruction.opcode;
+        int operand_count =
+                mod->segment.binary[instruction_index].instruction.no_ops;
+        int expected_operands = rxvm_vm_c2_expected_operands(opcode);
+
+        instruction_boundaries[instruction_index] = 1;
+        if (expected_operands < 0 || operand_count != expected_operands ||
+            (size_t)operand_count >=
+                    mod->segment.inst_size - instruction_index) break;
+        instruction_index += (size_t)operand_count + 1u;
+    }
+    if (instruction_index == mod->segment.inst_size) {
+        instruction_boundaries[instruction_index] = 1;
+        valid_stream = 1;
+    }
+
+    if (!valid_stream) {
+        free(instruction_boundaries);
+        return;
+    }
+    for (proc_index = 0; proc_index < mod->procedure_count; proc_index++) {
+        rxvm_vm_c2_classify_runtime_procedure(
+                mod, &mod->procedures[proc_index], instruction_boundaries);
+    }
+    free(instruction_boundaries);
+}
