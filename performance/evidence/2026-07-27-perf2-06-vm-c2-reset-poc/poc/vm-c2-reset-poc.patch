+/* PERF2-06 VM-C2 isolated reset PoC.  Mode 0 preserves the accepted product,
+ * mode 1 uses one fixed-core copy, and mode 2 guards that copy with a
+ * conservative procedure-static proof. */
+#define RXVM_VM_C2_RESET_DENSE 0
+#define RXVM_VM_C2_RESET_FIXED 1
+#define RXVM_VM_C2_RESET_STATIC 2
+
+#ifndef RXVM_VM_C2_RESET_MODE
+#define RXVM_VM_C2_RESET_MODE RXVM_VM_C2_RESET_DENSE
+#endif
+
+#if RXVM_VM_C2_RESET_MODE < RXVM_VM_C2_RESET_DENSE || \
+    RXVM_VM_C2_RESET_MODE > RXVM_VM_C2_RESET_STATIC
+#error "RXVM_VM_C2_RESET_MODE must be 0, 1, or 2"
+#endif
+
+#ifndef RXVM_VM_C2_RESET_DIAGNOSTICS
+#define RXVM_VM_C2_RESET_DIAGNOSTICS 0
+#endif
+
+#if RXVM_VM_C2_RESET_DIAGNOSTICS != 0 && RXVM_VM_C2_RESET_DIAGNOSTICS != 1
+#error "RXVM_VM_C2_RESET_DIAGNOSTICS must be 0 or 1"
+#endif
+
+typedef enum rxvm_vm_c2_reset_class {
+    RXVM_VM_C2_RESET_CLASS_UNKNOWN = 0,
+    RXVM_VM_C2_RESET_CLASS_PROVED_CLEAN,
+    RXVM_VM_C2_RESET_CLASS_MAY_REBIND
+} rxvm_vm_c2_reset_class;
