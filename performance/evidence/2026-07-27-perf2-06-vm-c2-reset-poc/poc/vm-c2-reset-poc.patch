+static unsigned int rxvm_vm_c2_effect_semantics(int opcode) {
+    switch (opcode) {
+#define RXE(STATE, READS, WRITES, KILLS, BRANCH_TARGETS, IMPLICIT, SEMANTICS) \
+        (SEMANTICS)
+#define RXEV(STATE, READS, WRITES, KILLS, BRANCH_TARGETS, IMPLICIT, SEMANTICS) \
+        (SEMANTICS)
+#define RXEC(STATE, READS, WRITES, KILLS, BRANCH_TARGETS, IMPLICIT, SEMANTICS, \
+             CURSOR_READS, CURSOR_WRITES, CONST_EVALUATOR) (SEMANTICS)
+#define RXOP_EFFECT(NAME, EFFECTS) case OP_##NAME: return EFFECTS;
+#include "../binutils/include/rxopeffects.h"
+#undef RXOP_EFFECT
+#undef RXEC
+#undef RXEV
+#undef RXE
+        default: return RXOP_SEM_OPAQUE;
