+#if RXVM_VM_C2_RESET_DIAGNOSTICS
+static void rxvm_vm_c2_reset_diagnostics_begin(rxvm_context *context) {
+    size_t mod_index;
+
+    if (!context) return;
+    for (mod_index = 0; mod_index < context->num_modules; mod_index++) {
+        size_t proc_index;
+        module *mod = context->modules[mod_index];
+        if (!mod) continue;
+        for (proc_index = 0; proc_index < mod->procedure_count; proc_index++) {
+            proc_runtime *runtime = &mod->procedures[proc_index];
+            runtime->vm_c2_fresh_activations = 0;
+            runtime->vm_c2_reused_activations = 0;
+            runtime->vm_c2_eligible_core_slots = 0;
+            runtime->vm_c2_core_reset_activations = 0;
+            runtime->vm_c2_core_reset_slots = 0;
+            runtime->vm_c2_static_skip_activations = 0;
+            runtime->vm_c2_static_skip_slots = 0;
+            runtime->vm_c2_zero_core_activations = 0;
+            runtime->vm_c2_reused_a0_resets = 0;
+        }
+    }
+}
+
+static void rxvm_vm_c2_reset_diagnostics_report(rxvm_context *context, int rc) {
+    uint64_t prepared_procedures = 0;
+    uint64_t may_rebind_procedures = 0;
+    uint64_t proved_clean_procedures = 0;
+    uint64_t unknown_fallback_procedures = 0;
+    uint64_t instructions_scanned = 0;
+    uint64_t fresh_activations = 0;
+    uint64_t reused_activations = 0;
+    uint64_t eligible_core_slots = 0;
+    uint64_t core_reset_activations = 0;
+    uint64_t core_reset_slots = 0;
+    uint64_t static_skip_activations = 0;
+    uint64_t static_skip_slots = 0;
+    uint64_t zero_core_activations = 0;
+    uint64_t reused_a0_resets = 0;
+    size_t mod_index;
+
+    if (!context) return;
+    for (mod_index = 0; mod_index < context->num_modules; mod_index++) {
+        size_t proc_index;
+        module *mod = context->modules[mod_index];
+        if (!mod) continue;
+        for (proc_index = 0; proc_index < mod->procedure_count; proc_index++) {
+            proc_runtime *runtime = &mod->procedures[proc_index];
+            prepared_procedures++;
+#if RXVM_VM_C2_RESET_MODE == RXVM_VM_C2_RESET_STATIC
+            instructions_scanned += (uint64_t)runtime->vm_c2_instructions_scanned;
+            if (runtime->vm_c2_reset_class == RXVM_VM_C2_RESET_CLASS_MAY_REBIND)
+                may_rebind_procedures++;
+            else if (runtime->vm_c2_reset_class == RXVM_VM_C2_RESET_CLASS_PROVED_CLEAN)
+                proved_clean_procedures++;
+            else unknown_fallback_procedures++;
+#endif
+            fresh_activations += runtime->vm_c2_fresh_activations;
+            reused_activations += runtime->vm_c2_reused_activations;
+            eligible_core_slots += runtime->vm_c2_eligible_core_slots;
+            core_reset_activations += runtime->vm_c2_core_reset_activations;
+            core_reset_slots += runtime->vm_c2_core_reset_slots;
+            static_skip_activations += runtime->vm_c2_static_skip_activations;
+            static_skip_slots += runtime->vm_c2_static_skip_slots;
+            zero_core_activations += runtime->vm_c2_zero_core_activations;
+            reused_a0_resets += runtime->vm_c2_reused_a0_resets;
+        }
+    }
+
+    fprintf(stderr,
+            "VM_C2_RESET_STATS,vm=%s,mode=%d,result=%d,"
+            "prepared_procedures=%llu,may_rebind_procedures=%llu,"
+            "proved_clean_procedures=%llu,unknown_fallback_procedures=%llu,"
+            "instructions_scanned=%llu,fresh_activations=%llu,"
+            "reused_activations=%llu,eligible_core_slots=%llu,"
+            "core_reset_activations=%llu,core_reset_slots=%llu,"
+            "core_reset_bytes=%llu,static_skip_activations=%llu,"
+            "static_skip_slots=%llu,zero_core_activations=%llu,"
+            "reused_a0_resets=%llu\n",
+#ifdef NTHREADED
+            "rxbvm",
+#else
+            "rxvm",
+#endif
+            RXVM_VM_C2_RESET_MODE, rc,
+            (unsigned long long)prepared_procedures,
+            (unsigned long long)may_rebind_procedures,
+            (unsigned long long)proved_clean_procedures,
+            (unsigned long long)unknown_fallback_procedures,
+            (unsigned long long)instructions_scanned,
+            (unsigned long long)fresh_activations,
+            (unsigned long long)reused_activations,
+            (unsigned long long)eligible_core_slots,
+            (unsigned long long)core_reset_activations,
+            (unsigned long long)core_reset_slots,
+            (unsigned long long)(core_reset_slots * sizeof(value *)),
+            (unsigned long long)static_skip_activations,
+            (unsigned long long)static_skip_slots,
+            (unsigned long long)zero_core_activations,
+            (unsigned long long)reused_a0_resets);
+}
+#endif
