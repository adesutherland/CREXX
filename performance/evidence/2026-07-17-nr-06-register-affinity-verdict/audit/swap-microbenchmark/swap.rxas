/*
 * NR-06 diagnostic candidate: the same 100,000,000-iteration loop with one
 * non-cancellable SWAP per iteration. The swapped values are deliberately
 * outside the loop-control state.
 */

.globals=0

main() .locals=4
   load r0,0
   load r1,100000000
   load r2,1
   load r3,2
l_loop:
   swap r2,r3
   iadd r0,r0,1
   blt l_loop,r0,r1
   load r0,0
   ret r0

