+/* NR-02 opaque-input, result-observation, perturbation and trace diagnostic. */
+/* This separately named source is not quotable canonical RexxCPS 2.2.        */
+
+parse arg variant tracearg countarg averagingarg
+if variant='' then variant='A'
+select
+  when variant='A' then do
+    opaquezero=0; opaqueone=1; opaquemarker='b'
+    opaquekey='Key Bee'; opaquedigits='12345678'
+    opaquefailure='foobar'; opaquenine=9; opaquequestion='?'
+    opaquefoobar='Foo Bar'; opaquewith='with'; opaqueargs='args'
+  end
+  when variant='B' then do
+    opaquezero=0; opaqueone=1; opaquemarker='b'
+    opaquekey='Key Dee'; opaquedigits='92345678'
+    opaquefailure='foobaz'; opaquenine=8; opaquequestion='!'
+    opaquefoobar='Zoo Bar'; opaquewith='WITH'; opaqueargs='ARGS'
+  end
+  otherwise do
+    say 'FAIL: variant must be A or B'
+    exit 2
+  end
+end
