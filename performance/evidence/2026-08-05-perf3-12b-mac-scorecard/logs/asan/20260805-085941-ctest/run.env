phase=ctest
build_dir=cmake-build-debugasan
build_jobs=4
test_jobs=1
build_leaks=on
test_leaks=off
stop_on_failure=0
regex=^(rxas_optimizer_metadata|rxas_flow_graph_contract|rxas_optimizer_semantic_batch_flow|rxas_optimizer_joined_key_private_local|rxas_optimizer_joined_key_private_local_noopt)$
exclude_regex=
exclude_regex_file=
ctest_index=
fixture_exclude_setup=
fixture_exclude_any=
base_asan_options=
