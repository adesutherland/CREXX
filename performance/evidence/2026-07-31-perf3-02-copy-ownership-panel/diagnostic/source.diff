+static rxvm_profile_full_copy_row *rxvm_profile_full_copy_row_for_active(
+        rxvm_profile_state *state) {
+    size_t i;
+    rxvm_profile_full_copy_row *rows;
+    size_t capacity;
+    for (i = 0; i < state->full_copy_row_count; i++) {
+        rxvm_profile_full_copy_row *row = &state->full_copy_rows[i];
+        if (row->module_id == state->active_module_id &&
+                row->instruction_index == state->active_instruction_index)
+            return row;
+    }
+    if (state->full_copy_row_count == state->full_copy_row_capacity) {
+        capacity = state->full_copy_row_capacity
+                ? state->full_copy_row_capacity * 2 : 64;
+        if (capacity < state->full_copy_row_capacity ||
+                capacity > SIZE_MAX / sizeof(*rows)) {
+            state->full_copy_tracking_unavailable = 1;
+            return 0;
+        }
+        rows = (rxvm_profile_full_copy_row *)realloc(
+                state->full_copy_rows, capacity * sizeof(*rows));
+        if (!rows) {
+            state->full_copy_tracking_unavailable = 1;
+            return 0;
+        }
+        state->full_copy_rows = rows;
+        state->full_copy_row_capacity = capacity;
+    }
+    rows = &state->full_copy_rows[state->full_copy_row_count++];
+    memset(rows, 0, sizeof(*rows));
+    rows->module_id = state->active_module_id;
+    rows->instruction_index = state->active_instruction_index;
+    return rows;
+}
+
+void rxvm_profile_full_copy_begin(rxvm_profile_state *state,
+                                  const value *source) {
+    size_t shape;
+    if (!state || !state->enabled) return;
+    state->full_copy_active = 1;
+    state->full_copy_top_shape = rxvm_profile_value_payload_shape(source);
+    state->full_copy_top_bytes = rxvm_profile_value_payload_bytes(source);
+    for (shape = 0; shape < RXVM_PROFILE_VALUE_SHAPE_COUNT; shape++) {
+        state->full_copy_before_count[shape] =
+                state->value_operations[RXVM_PROFILE_VALUE_COPY][shape].count;
+        state->full_copy_before_bytes[shape] =
+                state->value_operations[RXVM_PROFILE_VALUE_COPY][shape].bytes;
+    }
+}
+
+void rxvm_profile_full_copy_end(rxvm_profile_state *state) {
+    rxvm_profile_full_copy_row *row;
+    size_t shape;
+    if (!state || !state->enabled || !state->full_copy_active) return;
+    state->full_copy_active = 0;
+    row = rxvm_profile_full_copy_row_for_active(state);
+    if (!row) return;
+    rxvm_profile_increment(state, &row->executions);
+    rxvm_profile_increment(
+            state, &row->top[state->full_copy_top_shape].count);
+    rxvm_profile_add_total(
+            state, &row->top[state->full_copy_top_shape].bytes,
+            state->full_copy_top_bytes);
+    if (state->full_copy_top_bytes >
+            row->top[state->full_copy_top_shape].max_bytes)
+        row->top[state->full_copy_top_shape].max_bytes =
+                state->full_copy_top_bytes;
+    for (shape = 0; shape < RXVM_PROFILE_VALUE_SHAPE_COUNT; shape++) {
+        const rxvm_profile_allocation_counter *current =
+                &state->value_operations[RXVM_PROFILE_VALUE_COPY][shape];
+        uint64_t count = current->count - state->full_copy_before_count[shape];
+        uint64_t bytes = current->bytes - state->full_copy_before_bytes[shape];
+        rxvm_profile_add_total(state, &row->recursive[shape].count, count);
+        rxvm_profile_add_total(state, &row->recursive[shape].bytes, bytes);
+        if (bytes > row->recursive[shape].max_bytes)
+            row->recursive[shape].max_bytes = bytes;
+    }
+}
+
 uint64_t rxvm_profile_frame_phase_begin(void) {
     rxvm_profile_state *state = rxvm_active_allocation_profile;
     return state && state->enabled && state->timing_enabled
@@ -1156,10 +1235,12 @@ void rxvm_profile_destroy(rxvm_profile_state *state) {
     free(state->activations);
     free(state->call_rows);
     free(state->branch_rows);
+    free(state->full_copy_rows);
     state->procedures = 0;
     state->activations = 0;
     state->call_rows = 0;
     state->branch_rows = 0;
+    state->full_copy_rows = 0;
     state->procedure_count = 0;
     state->procedure_capacity = 0;
     state->activation_count = 0;
@@ -1168,6 +1249,8 @@ void rxvm_profile_destroy(rxvm_profile_state *state) {
     state->call_row_capacity = 0;
     state->branch_row_count = 0;
     state->branch_row_capacity = 0;
+    state->full_copy_row_count = 0;
+    state->full_copy_row_capacity = 0;
     if (rxvm_active_allocation_profile == state)
         rxvm_active_allocation_profile = state->previous_allocation_profile;
     state->previous_allocation_profile = 0;
@@ -2219,6 +2302,49 @@ static void rxvm_profile_write_table(FILE *out,
     }
 }
 
+static void rxvm_profile_write_full_copy_sites(
+        const rxvm_profile_state *state) {
+    const char *path = getenv("CREXX_FULL_COPY_SITES_OUTPUT");
+    FILE *out;
+    size_t row_index;
+    if (!path || !*path) return;
+    out = fopen(path, "w");
+    if (!out) {
+        fprintf(stderr, "ERROR: unable to open full-copy site output '%s'\n",
+                path);
+        return;
+    }
+    fprintf(out, "module_id,module,instruction_index,executions,shape,"
+                 "top_count,top_bytes,top_max_bytes,recursive_count,"
+                 "recursive_bytes,recursive_max_bytes,status\n");
+    for (row_index = 0; row_index < state->full_copy_row_count; row_index++) {
+        const rxvm_profile_full_copy_row *row =
+                &state->full_copy_rows[row_index];
+        size_t shape;
+        for (shape = 0; shape < RXVM_PROFILE_VALUE_SHAPE_COUNT; shape++) {
+            fprintf(out, "%zu,", row->module_id);
+            rxvm_profile_csv_string(out,
+                    rxvm_profile_module_name(state, row->module_id));
+            fprintf(out, ",%zu,%" PRIu64 ",",
+                    row->instruction_index, row->executions);
+            rxvm_profile_csv_string(out,
+                    rxvm_profile_value_shape_names[shape]);
+            fprintf(out, ",%" PRIu64 ",%" PRIu64 ",%" PRIu64
+                         ",%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",%s\n",
+                    row->top[shape].count, row->top[shape].bytes,
+                    row->top[shape].max_bytes,
+                    row->recursive[shape].count,
+                    row->recursive[shape].bytes,
+                    row->recursive[shape].max_bytes,
+                    state->full_copy_tracking_unavailable
+                        ? "degraded" : "complete");
+        }
+    }
+    if (fclose(out) != 0)
+        fprintf(stderr, "ERROR: failed while closing full-copy site output '%s'\n",
+                path);
+}
+
 void rxvm_profile_report(const rxvm_profile_state *state,
                          const char *output_path,
                          const char *vm_mode,
@@ -2248,5 +2374,7 @@ void rxvm_profile_report(const rxvm_profile_state *state,
                                  signal_name);
     }
 
+    rxvm_profile_write_full_copy_sites(state);
+
     if (close_output) fclose(out);
 }
