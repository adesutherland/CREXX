/* PERF2-04 Base64 string-access algorithm controls.
 *
 * These are attribution-only controls, not benchmark replacements.  The
 * current variant preserves the checked-in decoder.  The codepoint-poschar
 * variant removes one-character materialisation while retaining codepoint
 * indexing and the current invalid-digit-to-zero behaviour.  The
 * codepoint-arithmetic variant additionally replaces the alphabet scan with
 * RFC 4648 ASCII range arithmetic.  All variants retain the same encoder,
 * binary output, checksum and dual-VM correctness contract.
 */
options levelb comments_dash
import rxfnsb

arg argv = .string[]
if argv[0] <> 2 then return fail("use VARIANT REPETITIONS")
variant = lower(argv[1])
if verify(argv[2], "0123456789") <> 0 then
  return fail("REPETITIONS must be positive")
repetitions = argv[2] as .int
if repetitions < 1 then return fail("REPETITIONS must be positive")

input = make_input()
encoded = ""
decoded = .binary
do iteration = 1 to repetitions
  encoded = base64_encode(input)
  select
    when variant = "current" then decoded = base64_decode_current(encoded)
    when variant = "codepoint-poschar" then
      decoded = base64_decode_codepoint_poschar(encoded)
    when variant = "codepoint-arithmetic" then
      decoded = base64_decode_codepoint_arithmetic(encoded)
    otherwise return fail("unknown VARIANT")
  end
end

if length(encoded) <> 1368 then
  return fail("expected encoded length 1368, got " || length(encoded))
if bincompare(input, decoded) <> 0 then return fail("decoded bytes differ from input")
checksum = byte_checksum(decoded)
if checksum <> 130560 then
  return fail("expected checksum 130560, got " || checksum)

say "PERF2-04-BASE64-CONTROL variant=" || variant ,
    "repetitions=" || repetitions ,
    "encoded_length=" || length(encoded) ,
    "checksum=" || checksum ,
    "publication=attribution-only"
say "PASS: PERF2-04 Base64 control"
return 0

make_input: procedure = .binary
  data = .binary
  call binresize data, 1024
  do offset = 0 to 1023
    <at..u8>(offset) data = (offset * 31 + 7) <mod> 256
  end
  return data

base64_encode: procedure = .string
  arg data = .binary
  alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" as .binary
  input_length = binlength(data)
  encoded_length = ((input_length + 2) <idiv> 3) * 4
  result = .binary
  call binresize result, encoded_length
  input_offset = 0
  output_offset = 0
  do while input_offset < input_length
    remaining = input_length - input_offset
    byte1 = <at..u8>(input_offset) data
    byte2 = 0
    byte3 = 0
    if remaining > 1 then byte2 = <at..u8>(input_offset + 1) data
    if remaining > 2 then byte3 = <at..u8>(input_offset + 2) data

    digit1 = byte1 <idiv> 4
    digit2 = (byte1 <mod> 4) * 16 + byte2 <idiv> 16
    digit3 = (byte2 <mod> 16) * 4 + byte3 <idiv> 64
    digit4 = byte3 <mod> 64

    <at..u8>(output_offset) result = <at..u8>(digit1) alphabet
    <at..u8>(output_offset + 1) result = <at..u8>(digit2) alphabet
    if remaining > 1 then <at..u8>(output_offset + 2) result = <at..u8>(digit3) alphabet
    else <at..u8>(output_offset + 2) result = 61
    if remaining > 2 then <at..u8>(output_offset + 3) result = <at..u8>(digit4) alphabet
    else <at..u8>(output_offset + 3) result = 61
    input_offset = input_offset + 3
    output_offset = output_offset + 4
  end
  return result as .string

base64_decode_current: procedure = .binary
  arg encoded = .string
  alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  encoded_length = length(encoded)
  padding = 0
  if substr(encoded, encoded_length, 1) = "=" then padding = padding + 1
  if substr(encoded, encoded_length - 1, 1) = "=" then padding = padding + 1
  output_length = (encoded_length <idiv> 4) * 3 - padding
  result = .binary
  call binresize result, output_length

  input_offset = 1
  output_offset = 0
  do while input_offset <= encoded_length
    digit1 = base64_digit_current(substr(encoded, input_offset, 1), alphabet)
    digit2 = base64_digit_current(substr(encoded, input_offset + 1, 1), alphabet)
    char3 = substr(encoded, input_offset + 2, 1)
    char4 = substr(encoded, input_offset + 3, 1)
    digit3 = 0
    digit4 = 0
    if char3 <> "=" then digit3 = base64_digit_current(char3, alphabet)
    if char4 <> "=" then digit4 = base64_digit_current(char4, alphabet)

    <at..u8>(output_offset) result = digit1 * 4 + digit2 <idiv> 16
    output_offset = output_offset + 1
    if output_offset < output_length + 1 & char3 <> "=" then do
      <at..u8>(output_offset) result = (digit2 <mod> 16) * 16 + digit3 <idiv> 4
      output_offset = output_offset + 1
    end
    if output_offset < output_length + 1 & char4 <> "=" then do
      <at..u8>(output_offset) result = (digit3 <mod> 4) * 64 + digit4
      output_offset = output_offset + 1
    end
    input_offset = input_offset + 4
  end
  return result

base64_digit_current: procedure = .int
  arg character = .string, alphabet = .string
  digit = pos(character, alphabet) - 1
  if digit < 0 then return 0
  return digit

base64_decode_codepoint_poschar: procedure = .binary
  arg encoded = .string
  alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  code1 = .int
  code2 = .int
  code3 = .int
  code4 = .int
  digit1 = .int
  digit2 = .int
  digit3 = .int
  digit4 = .int
  encoded_length = length(encoded)
  padding = 0
  last = encoded_length - 1
  assembler strchar code4,encoded,last
  if code4 = 61 then padding = padding + 1
  last = last - 1
  assembler strchar code3,encoded,last
  if code3 = 61 then padding = padding + 1
  output_length = (encoded_length <idiv> 4) * 3 - padding
  result = .binary
  call binresize result, output_length

  input_offset = 0
  output_offset = 0
  do while input_offset < encoded_length
    assembler strchar code1,encoded,input_offset
    next = input_offset + 1
    assembler strchar code2,encoded,next
    next = input_offset + 2
    assembler strchar code3,encoded,next
    next = input_offset + 3
    assembler strchar code4,encoded,next

    digit1 = -1
    digit2 = -1
    digit3 = 0
    digit4 = 0
    assembler poschar digit1,alphabet,code1
    assembler poschar digit2,alphabet,code2
    if digit1 < 0 then digit1 = 0
    if digit2 < 0 then digit2 = 0
    if code3 <> 61 then do
      digit3 = -1
      assembler poschar digit3,alphabet,code3
      if digit3 < 0 then digit3 = 0
    end
    if code4 <> 61 then do
      digit4 = -1
      assembler poschar digit4,alphabet,code4
      if digit4 < 0 then digit4 = 0
    end

    <at..u8>(output_offset) result = digit1 * 4 + digit2 <idiv> 16
    output_offset = output_offset + 1
    if output_offset < output_length + 1 & code3 <> 61 then do
      <at..u8>(output_offset) result = (digit2 <mod> 16) * 16 + digit3 <idiv> 4
      output_offset = output_offset + 1
    end
    if output_offset < output_length + 1 & code4 <> 61 then do
      <at..u8>(output_offset) result = (digit3 <mod> 4) * 64 + digit4
      output_offset = output_offset + 1
    end
    input_offset = input_offset + 4
  end
  return result

base64_decode_codepoint_arithmetic: procedure = .binary
  arg encoded = .string
  code1 = .int
  code2 = .int
  code3 = .int
  code4 = .int
  encoded_length = length(encoded)
  padding = 0
  last = encoded_length - 1
  assembler strchar code4,encoded,last
  if code4 = 61 then padding = padding + 1
  last = last - 1
  assembler strchar code3,encoded,last
  if code3 = 61 then padding = padding + 1
  output_length = (encoded_length <idiv> 4) * 3 - padding
  result = .binary
  call binresize result, output_length

  input_offset = 0
  output_offset = 0
  do while input_offset < encoded_length
    assembler strchar code1,encoded,input_offset
    next = input_offset + 1
    assembler strchar code2,encoded,next
    next = input_offset + 2
    assembler strchar code3,encoded,next
    next = input_offset + 3
    assembler strchar code4,encoded,next

    digit1 = base64_digit_codepoint(code1)
    digit2 = base64_digit_codepoint(code2)
    digit3 = 0
    digit4 = 0
    if code3 <> 61 then digit3 = base64_digit_codepoint(code3)
    if code4 <> 61 then digit4 = base64_digit_codepoint(code4)

    <at..u8>(output_offset) result = digit1 * 4 + digit2 <idiv> 16
    output_offset = output_offset + 1
    if output_offset < output_length + 1 & code3 <> 61 then do
      <at..u8>(output_offset) result = (digit2 <mod> 16) * 16 + digit3 <idiv> 4
      output_offset = output_offset + 1
    end
    if output_offset < output_length + 1 & code4 <> 61 then do
      <at..u8>(output_offset) result = (digit3 <mod> 4) * 64 + digit4
      output_offset = output_offset + 1
    end
    input_offset = input_offset + 4
  end
  return result

base64_digit_codepoint: procedure = .int
  arg codepoint = .int
  select
    when codepoint >= 65 & codepoint <= 90 then return codepoint - 65
    when codepoint >= 97 & codepoint <= 122 then return codepoint - 71
    when codepoint >= 48 & codepoint <= 57 then return codepoint + 4
    when codepoint = 43 then return 62
    when codepoint = 47 then return 63
    otherwise return 0
  end
  return 0

byte_checksum: procedure = .int
  arg data = .binary
  checksum = 0
  do offset = 0 to binlength(data) - 1
    checksum = checksum + <at..u8>(offset) data
  end
  return checksum

fail: procedure = .int
  arg message = .string
  say "FAIL:" message
  return 1
