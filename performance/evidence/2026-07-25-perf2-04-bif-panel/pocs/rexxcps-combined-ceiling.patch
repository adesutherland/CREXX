+verify_word1_question_ceiling: procedure = .int
+  errors = 0
+  errors = errors + check_word1_question_case("")
+  errors = errors + check_word1_question_case("     ")
+  errors = errors + check_word1_question_case("Key Bee")
+  errors = errors + check_word1_question_case("?")
+  errors = errors + check_word1_question_case("? tail")
+  errors = errors + check_word1_question_case("  ?  tail")
+  errors = errors + check_word1_question_case("?x tail")
+  errors = errors + check_word1_question_case("é ?")
+  errors = errors + check_word1_question_case(" ?　tail")
+  errors = errors + check_word1_question_case("？ tail")
+  return errors
+
+
+check_word1_question_case: procedure = .int
+  arg source = .string
+  expected = 0
+  if word(source, 1) = "?" then expected = 1
+  actual = word1_is_question_ceiling(source)
+  if actual <> expected then return 1
+  return 0
+
+
+word1_is_question_ceiling: procedure = .int
+  arg source = .string
+  word_start = .int
+  word_end = .int
+  word_length = .int
+  codepoint = .int
+  zero = 0
+  if source == "" then return 0
+  assembler fndnblnk word_start,source,zero
+  if word_start < 0 then return 0
+  assembler strchar codepoint,source,word_start
+  if codepoint <> 63 then return 0
+  assembler fndblnk word_end,source,word_start
+  if word_end < 0 then assembler strlen word_end,source
+  word_length = word_end - word_start
+  if word_length = 1 then return 1
+  return 0
+
+
 fail: procedure = .int
   numeric digits 9
   arg message = .string
