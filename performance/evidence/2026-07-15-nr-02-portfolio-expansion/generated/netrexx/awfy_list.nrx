/*
 * NetRexx port of the Are We Fast Yet? List benchmark.
 * Derived from the SOM benchmark suite under the MIT license; see
 * ../../LICENSE-SOM-MIT.txt and ../../README.md.
 */
options binary

class awfy_list

  method main(args=String[]) static
    repetitions=int 1
    if args.length>=1 then repetitions=Rexx args[0]
    if repetitions<1 then do
      say 'FAIL: repetitions must be positive'
      exit 1
    end

    result=int 0
    loop iteration=1 to repetitions
      result=ListBenchmark().run()
      if result\=10 then do
        say 'FAIL: expected length 10, got' result
        exit 1
      end
    end

    say 'benchmark=awfy_list repetitions='repetitions 'result='result
    say 'PASS: AWFY List NetRexx port'

class ListElement
  properties private
    value=int
    nextElement=ListElement

  method ListElement(initialValue=int)
    value=initialValue

  method length() binary returns int
    if nextElement=null then return 1
    return 1+nextElement.length()

  method next() binary returns ListElement
    return nextElement

  method setNext(element=ListElement) binary
    nextElement=element

class ListBenchmark
  method run() binary returns int
    result=ListElement tail(makeList(15),makeList(10),makeList(6))
    return result.length()

  method makeList(listLength=int) private binary returns ListElement
    if listLength=0 then return null
    element=ListElement(listLength)
    element.setNext(makeList(listLength-1))
    return element

  method isShorterThan(x=ListElement,y=ListElement) private binary returns boolean
    xTail=ListElement x
    yTail=ListElement y
    loop while yTail\=null
      if xTail=null then return 1
      xTail=xTail.next()
      yTail=yTail.next()
    end
    return 0

  method tail(x=ListElement,y=ListElement,z=ListElement) private binary returns ListElement
    if isShorterThan(y,x) then
      return tail(tail(x.next(),y,z),tail(y.next(),z,x),tail(z.next(),x,y))
    return z
