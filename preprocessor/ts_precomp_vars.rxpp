/* RXPP preprocessor-variable smoke test. */
##cflags def nset niflink n1buf 2buf 3buf nvars nmaclist includes nosrcmap nmaclog
/* Date and time captured when RXPP starts preprocessing the source. */

/* RXPP:EXPAND */ Precompiled on {date} at {time} /* we generate just a comment containing {variables} */
say 'date         = {date}'
say 'time         = {time}'

/* RXPP path variables.
 * These paths are independent; depending on the build or installation
 * layout, two or more of them may resolve to the same directory.
 * syslib    - cREXX system library directory
 * syspath   - system search path
 * macpath   - macro library search path
 * inpath    - directory containing the input source
 * buildpath - directory used for generated build artifacts
 */
say 'syslib       = {syslib}'
say 'syspath      = {syspath}'
say 'macpath      = {macpath}'
say 'inpath       = {inpath}'
say 'buildpath    = {buildpath}'

/* Current RXPP input and generated output files. */
say 'sourcefile   = {sourcefile}'
say 'outputfile   = {outputfile}'

/* Target platform known to RXPP. */
say 'platform     = {platform}'

/* RXPP/compiler identification.
 * rxpp_version - cREXX version identifying this RXPP invocation
 * rxpp_rexx    - name of the RXPP source being processed
 * rxpp_date    - formatted preprocessing date and time
 */
say 'rxpp_version = {rxpp_version}'
say 'rxpp_rexx    = {rxpp_rexx}'
say 'rxpp_date    = {rxpp_date}'

/* Current RXPP processing flags and generated-source print setting. */
say 'cflags       = {cflags}'
say 'printgen     = {printgen}'