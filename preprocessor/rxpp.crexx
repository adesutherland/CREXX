  posn = 1
  p = pos(name, str, 1)
  do while p>0
     before = ''
     if p > 1 then before = substr(str, p - 1, 1)
     after  = substr(str, p + length(name), 1)
     /* check before and after chars to change only full variable names */
	verbb=verify(before, alphaN, 'N')
    verba=verify(after, alphaN, 'N')
    if length(before)=0 then verbb=1
	if length(after) =0 then verba=1
    if verbb=0 | verba=0 then do
	   posn = p + 1
	   p=posn
       iterate        /* no, not a valid variable name */
    end
    if p>length(str) then leave
    str=splice(value,str,p,length(name))    ## str=insertatc(value,str,p,length(name))    ## use the C-function
    posn = p + length(value)
    p = pos(name, str, posn)
  end
return str
*/

/* ------------------------------------------------------------------
 * replaceArg: Replaces a parameter occurrence respecting identifier boundaries
 * also supports NAME## terminator.
 *  - Matches bare name only at identifier boundaries
 *  - Also matches name## unconditionally and consumes the '##'
 *  - Preserves quoted literals exactly, including doubled quotes
 * ------------------------------------------------------------------ */
replaceArg: procedure=.string
  arg str=.string, name=.string, value=.string
  out = ''
  nlen = length(name)
  slen = length(str)
  uname = upper(name)
  i = 1

  do while i <= slen
     ch = substr(str, i, 1)

     if ch = "'" | ch = '"' then do
        quote_char = ch
        out = out || ch
        i = i + 1
        do while i <= slen
           qch = substr(str, i, 1)
           out = out || qch
           if qch = quote_char then do
              if i < slen & substr(str, i + 1, 1) = quote_char then do
                 out = out || quote_char
                 i = i + 2
                 iterate
              end
              i = i + 1
              leave
           end
           i = i + 1
        end
        iterate
     end

     if i + nlen - 1 <= slen then do
        current = upper(substr(str, i, nlen))
        if current = uname then do
           before = ''
           if i > 1 then before = substr(str, i - 1, 1)
           after1 = substr(str, i + nlen, 1)
           after2 = substr(str, i + nlen, 2)

           if after2 = '##' then do
              out = out || value
              i = i + nlen + 2
              iterate
           end

           verbb = verify(before, alphaN, 'N')
           verba = verify(after1, alphaN, 'N')
           if before = '' then verbb = 1
           if after1 = '' then verba = 1

           if verbb \= 0 & verba \= 0 then do
              out = out || value
              i = i + nlen
              iterate
           end
        end
     end

     out = out || ch
     i = i + 1
  end
return out
/* ------------------------------------------------------------------
 * InsertAt: Pure string insert/replace helper (legacy).
 * ------------------------------------------------------------------
 */
InsertAt: Procedure=.string
arg needle=.string,haystack=.string,at=.int,len=.int
  if at+len>length(haystack) then rhs=''
  else rhs=substr(haystack, at+len)
  if at>1 then lhs=substr(haystack, 1, at-1)
  else lhs=''
return lhs || needle || rhs
/* ------------------------------------------------------------------
 * parseArgList: Splits a macro argument list into callargs[] and returns the argument count.
 * ------------------------------------------------------------------
 */
parseArgList: procedure=.int
  arg argstr=.string
  callargs=.string[]
  callargs_source_col=.int[]
  callargs_source_len=.int[]
  anum=splitargs(argstr,callargs)
  search_start=1
  do j=1 to anum                 ## could also be callargs.0, but might be not set correctly due to higher previous macro call
     callargs.j=strip(callargs.j)
     callargs_source_len.j=length(callargs.j)
     if callargs.j='' then callargs_source_col.j=0
     else do
        /*
         * Peter note: splitargs is still the authority for argument values.
         * This ordered scan records where each trimmed value came from inside
         * the original argument text so replaceFixArg() can emit nested source
         * spans around substituted arguments.
         */
        found=pos(callargs.j,argstr,search_start)
        if found=0 then found=search_start
        callargs_source_col.j=found
        search_start=found+length(callargs.j)
     end
  end
return anum
/* ------------------- the following sequence is part of the C function splitargs
  callargs=.string[]
  i = 1
  depth = 0
  token = ''
  do j = 1 to length(argstr)
    c = substr(argstr, j, 1)
    if c = ',' & depth = 0 then do
      callargs.i = strip(token)
      token = ''
      i = i + 1
    end
    else do
      if c = '(' then depth = depth + 1
      if c = ')' then depth = depth - 1
      token = token || c
    end
  end
  if strip(token) <> '' then do
     callargs.i = strip(token)
  ##   call templist 'PUT',i,callargs.i      ### +++++++++++ remove
  end
return i
----------------- */
/* ------------------------------------------------------------------
 * Dump pre-compiler variables
 * ------------------------------------------------------------------
 */
printvars: procedure
  say 'Pre-Compiler Variable List'
  say '-------------------------------------------------------'
  do i=1 to macros_varname.0
     if macros_varname.i='' then iterate
     say right(i,3,'0')' 'macros_varname.i"='"macros_varvalue.i"'"
  end
  say macros_varname.0' variables defined'
return
/* ------------------------------------------------------------------
 * Dump macros
 * ------------------------------------------------------------------
 */
printmacs: procedure
  say 'Substitution Macro List'
  say '-------------------------------------------------------'
  do i=1 to macros_mname.0
     say left(macros_mname.i||macros_margs.i')',35) '{'macros_mbody.i'}'
  end
  say macros_mname.0' substitution macros defined'
  say 'Scripted Macro List'
    say '-------------------------------------------------------'
    do i=.int(1) to scriptMacros[0]
       say left(scriptMacros[i],35)
    end
    say scriptMacros[0]' scripted macros defined'
return
/* ------------------------------------------------------------------
 * getvarindx: Returns the index of a pre-compiler variable in the variable table.
 * ------------------------------------------------------------------
 */
getvarindx: procedure=.int
  arg varname=.string
  do i=1 to macros_varname.0
     if macros_varname.i='' then iterate
     if macros_varname.i=varname then return i
  end
  return 0
/* ------------------------------------------------------------------
 * findvar: Checks whether a pre-compiler variable exists (returns index or 0).
 * ------------------------------------------------------------------
 */
findvar: procedure=.string
  arg varname=.string
  varname='{'lower(varname)'}'
  index=getvarindx(varname)
return index
/* ------------------------------------------------------------------
 * getvar: Returns the value of a pre-compiler variable.
 * ------------------------------------------------------------------
 */
getvar: procedure=.string
  arg varname=.string
  varname='{'lower(varname)'}'
  vvalue=''
  i=getvarindx(varname)
  if i>0 then vvalue=macros_varvalue.i
return vvalue
/* ------------------------------------------------------------------
 * setvar: Sets a pre-compiler variable (stored as {name}).
 * ------------------------------------------------------------------
 */
setvar: procedure=.int
  arg varname=.string,varvalue=.string
  varname='{'lower(varname)'}'
  if varname='{printgen}' then do
     varvalue=lower(strip(varvalue))
     if varvalue='on' then varvalue='all'
     else if varvalue='off' then varvalue='none'
     printgen_flags=varvalue
  end
  i=getvarindx(varname)
  if i=0 then i=macros_varname.0+1
  macros_varname.i=varname
  macros_varvalue.i=varvalue
return i
/* ------------------------------------------------------------------
 * quote: Quotes a string value for code generation.
 * ------------------------------------------------------------------
 */
quote: procedure=.string
  arg line=.string, prefix=''
  if prefix \= '' then return prefix'={'line'}'
return "'"line"'"
/* ------------------------------------------------------------------
 * push_unique(value, array)
 * Returns 1 if appended, 0 if already present.
 * ------------------------------------------------------------------
 */
push_unique: procedure=.int
  arg expose array=.string[],value=.string
  uval = upper(value)
  do i = 1 to array[0]
     cur = upper(array[i])
     if cur = uval then return 0
  end
  array[array[0]+1] = value
return 1

/* ------------------------------------------------------------------------
 * parsevar: Implements ##PARSE by generating runtime parsing code and variable assignments.
 * ##PARSE command, re-parse tokens from template to receive Variable names
 *   PARSE VAR variable template
 *   PARSE VALUE 'quoted-value' [WITH] template
 *   PARSE VALUE variable [WITH] template
 * ------------------------------------------------------------------------
 */
parsevar: Procedure=.int
  arg line_no=.int, parseLine=.string
  lhs = ""
 ## 1. strip off PARSE VAR variable template or PARSE VALUE 'string'/variable [WITH] template
 ##                1w  2w   3w     4w            1w    2w     3w                4w
 ## 2. strip off PARSE variable template or PARSE 'string'/variable [WITH] template
 ##                1w   2w         3w        1w      2w                         3w
  parseLine=subword(parseLine,2)    ## strip off PARSE command
  parsestmt=parseline               ## save this for adding it later as comment
  ww1=upper(word(parseLine,1))
  uplow=0
  if ww1='UPPER' | ww1='LOWER' then do
     if ww1='UPPER' then uplow=1
     else uplow=2
     parseLine=subword(parseLine,2)
  end
  ppi=pos('/*',parseLine)
  if ppi>1 then parseLine=substr(parseLine,1,ppi-1)
  ppi=pos('##',parseLine)
  if ppi>1 then parseLine=substr(parseLine,1,ppi-1)
  pmode=upper(word(parseLine,1))    ## check if we have a VALUE or VAR clause
  if pmode='VALUE' | pmode= 'VAR' then parseLine=subword(parseLine,2)   ## set behind VALUE/VAR clause

  sstr=substr(parseLine,1,1)
  if sstr="'" | sstr='"' then do
     lhs=Firstword(parseLine)
     parseLine=substr(parseLine,length(lhs)+1)
  end
  else do
     lhs=word(parseLine,1)
     ParseLine=subword(ParseLine,2)
  end
  if fpos('WITH',parseLine,1)=1 then template=subword(ParseLine,2)   ## yes, then drop it too!
  else template=ParseLine
  lhs=strip(lhs)

  template=preCleanTemplate(template)
  template=strip(template)
  template=preCleanTemplate(template)
  k       = 0
  buf     = ''                              /* pending unquoted text */
  WHITESPACE = ' '||'09'x||'0D'x||'0A'x||'0B'x||'0C'x||'C2A0'x

 /* flush pending unquoted text as a token */
  tokenhi=0
  token=.string[]
  L = length(template)
  i = 1
  do while i <= L
     ch = substr(template, i, 1)
     if pos(ch, WHITESPACE) > 0 then do
        buf=flush(buf,token,tokenhi)
        j = i + 1
        do while j <= L & pos(substr(template, j, 1), WHITESPACE) > 0
           j = j + 1
        end
        tokenhi=tokenhi+1
        token.tokenhi = substr(template, i, j - i)  /* exact run of blanks/tabs/etc */
        i = j
        iterate
     end

    /* quoted literal => single token, quotes included; supports doubled quotes */
    if ch = "'" | ch = '"' then do
       buf=flush(buf,token,tokenhi)
       q     = ch
       qtok  = q
       i     = i + 1
       closed = 0
       do while i <= L
          c = substr(template, i, 1)
          qtok = qtok || c
          if c = q then do
          /* doubled quote => literal quote inside string */
          if i < L & substr(template, i+1, 1) = q then do
             qtok = qtok || q
             i = i + 2
             iterate
          end
          closed = 1
          i = i + 1
          leave
        end
        i = i + 1
      end
      if \closed then do
        say 'Error: unmatched quote in template'
        return -1
      end
      tokenhi=tokenhi+ 1
      token.tokenhi = qtok
      iterate
    end
     /* otherwise accumulate into current unquoted token */
    buf = buf || ch
    i = i + 1
  end

  buf=flush(buf,token,tokenhi)
/* ----------------------------------------------------------------------
 * Classify tokens in token_types
 * ----------------------------------------------------------------------
 */
  j = .int
  j=0
  insert=.string[]
  do i=1 to tokenhi
     quotechr=substr(token.i,1,1)
     if quotechr = "'" | quotechr = '"' then do
        token.i=strip(token.i,,quotechr)       ## drop quotes
     end
     else if quotechr = " " then  token_type.i=2     ## blank seperator
     else if verify(token.i,'0123456789')=0 then nop
     else if (quotechr='+' | quotechr='-' ) & verify(substr(token.i,2),'0123456789+-')=0 then nop
     else if (quotechr='(') then nop    ## token_type.i=6
     else do
        if fpos('parse',token.i,1)>0 then iterate
        j=j+1
        if token.i='.' then iterate
        insert.j=token.i"=_pass_variable_content."j
     end
  end
  insert_count = j
  imax=insert_count*2+15        ## add 15 lines to handle all generated lines, maybe too much, but empty lines will be dropped anyway
  rc= insert_source(line_no+1,imax)

   inew=inject2Source(line_no+1,0,'/* PARSE 'parseSTMT' */')
   inew=inject2Source(inew+1,3,"_pass_variable.1='' ; _pass_variable_content.1='' /* init array for PARSE function */ ")
   inew=inject2Source(inew+1,3,'_string2Parse='lhs)
   inew=inject2Source(inew+1,3,'_parsetemplate='embed(template))
   if pos(' trimparse',cflags)>0 then inew=inject2Source(inew+1,3,'call parse _string2parse,_parsetemplate,_pass_variable,_pass_variable_content,1,'uplow)
   else inew=inject2Source(inew+1,3,'call parse _string2parse,_parsetemplate,_pass_variable,_pass_variable_content,0,'uplow)
  if pos(' parse',cflags)>0 then do
     inew=inject2Source(inew+1,3,'say ">> "copies("-",72)')
     if substr(lhs,1,1)='x' then lhs=' 'lhs
     upmode=''
     if uplow=1 then upmode='UPPER '
     else if uplow=2 then upmode='LOWER '
     inew=inject2Source(inew+1,3,'say ">> PARSE Statement: 'upmode'["'lhs'" -- VAR/VALUE WITH --> "' embed(template) '"]"')
     inew=inject2Source(inew+1,3,'say ">> PARSE STRING   : ["'lhs'"]"')                 ## value function doesn't help, if the parm is a variable
     inew=inject2Source(inew+1,3,'say ">> PARSE TEMPLATE : ["'embed(template)'"]"')
  end
  inew=inject2Source(inew+1,0,'## ---------- set parse variables ----------')
  do j=1 to insert_count
     inew=inject2Source(inew+1,3,insert.j)
     if pos(' parse',cflags)>0 then do
        inew=inject2Source(inew+1,3,'say ">> PARSE Result   : "_pass_variable.'j'"=["_pass_variable_content.'j'"]"')
     end
  end
  inew=inject2Source(inew+1,0,'## ---------- parse variables set ----------')
return tokenhi

/* ------------------------------------------------------------------
 * flush: Flushes buffered text into token[] as a single token.
 * ------------------------------------------------------------------
 */
flush: procedure=.string
  arg buf=.string, expose token=.string[], expose tokenhi=.int
  if buf = '' then return ''
  tokenhi=tokenhi+1
  token.tokenhi = buf
  buf = ''
return buf
/* ------------------------------------------------------------------
 * embed: Quotes a string using ' or \" depending on content.
 * ------------------------------------------------------------------
 */
embed: procedure=.string
  arg strx=.string
  if pos("'",strx,1)>0 then return '"'strx'"'
return "'"strx"'"

/* -------------------------------------------------
 * preCleanTemplate
 *  - Preserve inner content of quoted literals exactly
 *  - Remove whitespace only if it directly neighbors a quote
 *  - No suppression around numbers, +/-, punctuation, etc.
 *  - Supports doubled quotes inside literals ('' and "")
 * -------------------------------------------------
 */
preCleanTemplate: procedure=.string
  arg template=.string

  WHITESPACE = ' '||'09'x||'0D'x||'0A'x||'0B'x||'0C'x||'C2A0'x
  out = ''
  L = length(template)
  i = 1
  last_out_char = ''     /* track last emitted char for "prev is quote" check */
  do while i <= L
    ch = substr(template, i, 1)
    /* ---- quoted literal: copy EXACTLY as-is, including quotes ---- */
    if ch = "'" | ch = '"' then do
      q    = ch
      qtok = q
      i    = i + 1
      closed = 0
      do while i <= L
        c = substr(template, i, 1)
        qtok = qtok || c
        if c = q then do
          /* doubled quote -> keep both quotes and continue */
          if i < L & substr(template, i+1, 1) = q then do
            qtok = qtok || q
            i = i + 2
            iterate
          end
          closed = 1
          i = i + 1
          leave
        end
        i = i + 1
      end
      if \closed then return template  /* unmatched quote: leave template as-is */

      out = out || qtok
      last_out_char = q               /* closing quote is the last emitted char */
      iterate
    end
    /* ---- whitespace run ---- */
    if pos(ch, WHITESPACE) > 0 then do
      j = i + 1
      do while j <= L & pos(substr(template, j, 1), WHITESPACE) > 0
        j = j + 1
      end
      /* peek next non-WS char */
      nextch = ''
      if j <= L then nextch = substr(template, j, 1)

      /* suppress only if whitespace touches a QUOTE on either side */
      if last_out_char = "'" | last_out_char = '"' | nextch = "'" | nextch = '"' then do
        i = j
        iterate
      end

      /* otherwise keep the whitespace as-is */
      out = out || substr(template, i, j - i)
      i = j
      last_out_char = ' '             /* non-quote marker */
      iterate
    end
    /* ---- ordinary char ---- */
    out = out || ch
    i = i + 1
    last_out_char = ch
  end
  return out

/* ------------------------------------------------------------------
 * FirstWord: Extracts the first token from a string, respecting quoted string rules.
 * ------------------------------------------------------------------
 */
FirstWord: Procedure=.string
  arg line=string
  line = strip(line)
  i = 1
  quoted = ''
  llen=length(line)
  do while i <= llen
     qchar = substr(line,i,1)
     if qchar = '"' | qchar = "'" then do
        i = i + 1
        part = ''
        do while i <= llen
           c = substr(line,i,1)
           if c = qchar then do
              if substr(line,i+1,1) \= qchar then leave   /* search for quote */
              part = part || qchar
              i = i + 2
              iterate
           end
           part = part || c
           i = i + 1
        end
        quoted = quoted || part
        i = i + 1
     end
     else if qchar = ' ' then leave
     else leave
  end
return "'"quoted"'"

/* ------------------------------------------------------------------
 * inject2Source: Writes a prepared line into a reserved source slot and marks it as generated.
 * inject a new line into source code, the new lines must have been
 * prepared prior to the call
 * returns the line number used
 * ------------------------------------------------------------------
 */
inject2Source: procedure=.int
  arg lnr=.int,inc=.int,line=.string
  if source.lnr \='' & pos('/* reserved',source.lnr)=0 then say "++++++++++++ parse overflow at line "lnr' contains 'line
  if inc>0 then source.lnr='   'line
  else source.lnr=line
  stype.lnr='R'
return lnr
/* ------------------------------------------------------------------
 * linkerInfo: Writes an include file containing imported module names for linking.
 * ------------------------------------------------------------------
 */
linkerInfo: procedure
  arg outfile=.string, imported=.string, external=.string, link=.string, norun=.int
  normalized=.string
  slash=.int
  userpath=.string
  member=.string
  dot=.int
  linker=.string[]
  linkcount=.int
  rest=.string
  sep=.int
  item=.string
  normalized=translate(outfile,'/','\')
  slash=lastpos('/',normalized)
  if slash>0 then do
    userpath=left(normalized,slash)
    member=substr(normalized,slash+1)
  end
  else do
    userpath=''
    member=normalized
  end
  dot=lastpos('.',member)
  if dot>0 then member=left(member,dot-1)
  linkfile=userpath||member'.inc'
  linker=.string[]
  linkcount=.int
  linkcount=0
  rest=substr(imported,2)
  do while rest <> ''
    sep=pos('|',rest)
    if sep=0 then do
      item=strip(rest)
      rest=''
    end
    else do
      item=strip(left(rest,sep-1))
      rest=substr(rest,sep+1)
    end
    if item='' then iterate
    linkcount=linkcount+1
    linker[linkcount] = 'import|' || item
  end
  rest=substr(external,2)
  do while rest <> ''
    sep=pos('|',rest)
    if sep=0 then do
      item=strip(rest)
      rest=''
    end
    else do
      item=strip(left(rest,sep-1))
      rest=substr(rest,sep+1)
    end
    if item='' then iterate
    linkcount=linkcount+1
    linker[linkcount] = 'external|' || item
  end
  if link \= '' then do
    linkcount=linkcount+1
    linker[linkcount] = 'link|' || link
  end
  if norun then do
    linkcount=linkcount+1
    linker[linkcount] = 'norun|1'
  end
  call writeall linker,linkfile,-1
  if verbose then say 'CRX0510I ['time('l')'] Library import names passed to 'linkfile
return
/* ------------------------------------------------------------------
 * GetPath: from a path/file-name input
 * Returns the containing directory with UNIX-style separators, or ./ when
 * the input is a bare filename in the current directory.
  * ------------------------------------------------------------------
 */
getPath: procedure=.string
  arg input=.string

  path = translate(input, '/', '\')   /* "\" -> "/" */
  fpos=lastpos('/',path)
  if fpos>0 then path=substr(path,1,fpos)
  else path='./'
return path

/* ------------------------------------------------------------------
 * normalisePath
 *
 * Normalises a filesystem path and, when necessary, resolves a
 * relative path against a supplied base directory.
 *
 * Syntax:
 *
 *   normalised = normalisePath(xsyspath, rawpath)
 *
 * Arguments:
 *
 *   xsyspath
 *       Base directory used when rawpath is relative.
 *
 *       This is typically the directory of the current source file,
 *       macro library, INCLUDE file, or other caller-defined search
 *       location.
 *
 *       xsyspath is ignored when rawpath is already absolute.
 *
 *   rawpath
 *       Path to normalise.
 *       The path may:
 *         - be absolute;
 *         - be relative to xsyspath;
 *         - contain "." components;
 *         - contain ".." components;
 *         - use "/" or "\" directory separators.
 *
 * Result:
 *
 *   Returns a normalised path using UNIX-style "/" separators.
 *
 *   The routine:
 *     1. Converts "\" directory separators to "/".
 *     2. Detects Windows drive prefixes such as:
 *          C:
 *          D:
 *     3. Detects absolute paths.
 *     4. If rawpath is relative and xsyspath is supplied, prefixes
 *        rawpath with xsyspath.
 *     5. Removes "." path components.
 *     6. Resolves ".." by removing the preceding path component.
 *     7. Prevents ".." from moving above the root of an absolute path.
 *     8. Reconstructs the path using "/" separators.
 *
 * Examples:
 *   normalisePath(
 *       "C:/Users/Peter/macros",
 *       "../Docs/./file.txt" )
 *
 *   returns:
 *       C:/Users/Peter/Docs/file.txt
 *
 *   normalisePath(
 *       "/home/peter/project/src/macros",
 *       "../../example")
 *
 *   returns:
 *       /home/peter/project/example
 *
 *   normalisePath(
 *       "C:/projects/rxpp/src/macros",
 *       "../../example")
 *
 *   returns:
 *       C:/projects/rxpp/example
 *
 * Absolute paths:
 *
 *   If rawpath is absolute, xsyspath is not used.
 *
 *   Example:
 *
 *       normalisePath(
 *           "/home/peter/project",
 *           "/usr/local/macros")
 *
 *   returns:
 *       /usr/local/macros
 *
 * Windows absolute paths:
 *       normalisePath(
 *           "C:/projects/rxpp",
 *           "D:/macros/common" )
 *
 *   returns:
 *       D:/macros/common
 *
 *
 * Mixed separators:
 *       normalisePath(
 *           "C:\projects\rxpp",
 *           "..\macros/./common" )
 *
 *   returns:
 *
 *       C:/projects/macros/common
 *
 * Parent-directory traversal:
 *   A relative path may move upwards without knowing the complete
 *   absolute pathname.
 *
 *   For example:
 *       "../../example"
 *
 *   means:
 *       - move one directory up;
 *       - move another directory up;
 *       - enter directory "example".
 *
 *   Therefore:
 *
 *       normalisePath(
 *           "/a/b/c/d",
 *           "../../example"  )
 *
 *   returns:
 *       /a/b/example
 *
 * Behaviour of "..":
 *
 *   Internally, path components are treated like a stack.
 *       a/b/c/../d
 *
 *   is processed approximately as:
 *       a
 *       a/b
 *       a/b/c
 *       a/b
 *       a/b/d
 *
 *   producing:
 *       a/b/d
 *
 *   For an absolute path, ".." cannot escape above the root.
 *       /a/../../b
 *
 *   becomes:
 *       /b
 *
 *   For a relative path that has no component available to remove,
 *   ".." is preserved.
 *       ../../example
 *
 *   therefore remains meaningful when no xsyspath is supplied.
 *
 * Important implementation detail:
 *
 *   The variable "parti" is the logical number of components currently
 *   present in the normalised path.
 *
 *   It acts as the stack pointer while "." and ".." are processed.
 *
 *
 * Empty / current-directory result:
 *   If normalisation removes all components:
 *       "."        -> "."
 *
 *   for a relative path, while:
 *       "/."       -> "/"
 *
 *   for an absolute path.
 *   A Windows drive root becomes:
 *       C:/.
 *   logically:
 *       C:/
 *
 *
 * Intended RXPP use:
 *
 *   normalisePath is suitable for resolving paths specified by RXPP
 *   directives such as INCLUDE, USE, or MACRODIR against the directory
 *   associated with the calling source.
 *
 *   Example:
 *       ##MACRODIR ../../example
 *
 *   may be resolved internally as:
 *       macrodir = normalisePath(
 *           currentSourceDirectory,
 *           "../../example"    )
 *
 *   This allows source files to refer to neighbouring directories
 *   without knowing their absolute installation location.
 *
 *
 * Deliberate limitations:
 *
 *   - The returned path always uses "/" separators, including Windows.
 *
 *   - Windows drive-relative paths such as:
 *
 *         C:example
 *
 *     have special native Windows semantics and should not be relied
 *     upon. Prefer:
 *         C:/example
 *
 *     for an absolute path, or:
 *         example
 *     for a normal relative path.
 *
 *   - UNC paths such as:
 *         \\server\share\directory
 *
 *     are not explicitly preserved as UNC paths by the current
 *     implementation. Add dedicated handling if RXPP needs UNC support.
 *
 *   - The procedure performs lexical path normalisation only.
 *     It does not check whether the resulting file or directory exists.
 *
 *   - Symbolic links are not resolved. Consequently, lexical ".."
 *     processing may differ from filesystem-level canonicalisation when
 *     symbolic links are involved.
 *
 *
 * Notes:
 *   This routine performs path manipulation only. It does not access
 *   the filesystem and therefore works with paths that do not yet exist.
 *
 *   This is intentional for RXPP, where paths may be constructed and
 *   interpreted before the referenced file or directory is opened.
 * ------------------------------------------------------------------
 */
normalisePath: procedure=.string
  arg xsyspath=.string, rawpath=.string

  path = translate(rawpath, '/', '\')   /* "\" -> "/" */
  basepath = translate(xsyspath, '/', '\')

  /* Resolve relative INCLUDE/USE names against the macro-library directory
   * supplied by the caller. Previously xsyspath was accepted but ignored,
   * turning a relative name such as ui.rxpm into /ui.rxpm. */
  if length(path) < 2 | substr(path, 2, 1) \= ':' then do
    if left(path, 1) \= '/' & basepath \= '' then do
      if right(basepath, 1) \= '/' then basepath = basepath || '/'
      path = basepath || path
    end
  end

  drive = ''
  part=''
  absolute = 0

  /* Detect Windows drive prefix */
  if length(path) >= 2 & substr(path, 2, 1) = ':' then do
     drive = substr(path, 1, 2)
     path  = substr(path, 3)
  end

  /* Detect absolute path */
  if left(path, 1) = '/' then do
     absolute = 1
     do while left(path, 1) = '/'
        path = substr(path, 2)
     end
  end

  /* Split into components */
  components=Qsplit(path,'/')

  /* Normalise components */
  norm = .string[]
  parti = 0

  do i = 1 to components[0]
     part = components[i]

    select
      when part = '.' | part = '' then nop
      when part = '..' then do
        if parti > 0 then do
          if norm[parti] <> '..' then do
            parti = parti - 1
            iterate
          end
        end
        if \absolute then do
          parti = parti + 1
          norm[parti] = '..'
        end
      end
      otherwise do
        parti = parti + 1
        norm[parti] = part
      end
    end
  end

  /* Rebuild */
  normalised = ''

  if drive \= '' then normalised = drive

  if absolute then normalised = normalised || '/'

  do i = .int(1) to parti
    if normalised \= '' & right(normalised, 1) \= '/' then normalised = normalised || '/'
    normalised = normalised || norm[i]
  end

  if normalised = '' then do
    if drive \= '' then normalised = drive || '/'
    else if absolute then normalised = '/'
    else normalised = '.'
  end
return normalised

/* ---------------------------------------------------------------
 * CommentScan
 *
 * Scan one source line and update nested block-comment depth.
 *
 * Quotes are significant only outside block comments.
 * Once /* has been encountered, quote characters have no special
 * meaning until the corresponding */ has been processed.
 *
 * Returns the resulting comment depth.
 * HIT is set when any part of the line belongs to a block comment.
 * --------------------------------------------------------------- */
CommentScan: procedure=.int
  arg line_no=.int, depth=.int, expose hit=.int
  line = source[line_no]
  length = length(line)
  pos = 1
  hit = (depth > 0)
  quote = ""
  do while pos <= length
      /*
       * Inside a block comment.
       *
       * Quotes are ordinary characters here. We only care about
       * nested comment delimiters.
       */
      if depth > 0 then do

          if substr(line, pos, 2) = '/*' then do
              hit = 1
              depth = depth + 1
              pos = pos + 2
              iterate
          end
          if substr(line, pos, 2) = '*/' then do
              hit = 1
              depth = depth - 1
              pos = pos + 2
              iterate
          end
          hit = 1
          pos = pos + 1
          iterate
      end
      /*
       * Outside a block comment.
       *
       * Comment markers inside quoted strings must be ignored.
       */
      ch = substr(line, pos, 1)
      if quote <> "" then do
          /*
           * Handle doubled Rexx quote characters.
           *
           * Example:
           *
           *     "Peter said ""hello"""
           */
          if ch = quote then do
              if pos < length & substr(line, pos + 1, 1) = quote then do
                  pos = pos + 2
                  iterate
              end
              quote = ""
          end
          pos = pos + 1
          iterate
      end
      /*
       * Start of a quoted string.
       */
      if ch = '"' | ch = "'" then do
          quote = ch
          pos = pos + 1
          iterate
      end
      /*
       * Start of a block comment.
       */
      if substr(line, pos, 2) = '/*' then do
          hit = 1
          depth = depth + 1
          pos = pos + 2
          iterate
      end
      pos = pos + 1
  end
  return depth
/* ------------------------------------------------------------------
 * formatRexx: Apply the optional indentation-only formatter to the final
 * generated source buffer.  This is intentionally kept local to RXPP so the
 * formatter can be selected without changing the build/import graph.
 * ------------------------------------------------------------------
 */
formatRexx: procedure = .string[]
   arg source = .string[]

   result = .string[]
   level = 0
   inProcedure = 0
   commentDepth = 0

   do lineNo = 1 to source[0]
      original = source[lineNo]
      maskedResult = maskRexxLine(original, commentDepth)
      masked = maskedResult[1]
      commentDepth = maskedResult[2]

      text = strip(original, 'L')
      if text = '' then do
         call appendFormatted result, original
         iterate
      end

      /* RXPP directives and source-map control lines must remain at column 1. */
      if left(text, 2) = '##' | left(text, 1) = '@' then do
         call appendFormatted result, text
         iterate
      end

      syntax = strip(masked)
      if syntax = '' then do
         call appendFormatted result, indentLine(text, level, inProcedure)
         iterate
      end

      first = translate(word(syntax, 1))
      label = ''
      if right(first, 1) = ':' then do
         label = word(text, 1)
         syntax = strip(substr(syntax, length(word(syntax, 1)) + 1))
         first = translate(word(syntax, 1))
      end

      if first = 'END' then do
         if level > 0 then level = level - 1
      end

      line = text
      if label <> '' then
         line = label || ' ' || strip(substr(text, length(label) + 1))
      else if first = 'RETURN' & level = 0 & inProcedure then
         line = text
      else
         line = indentLine(text, level, inProcedure)

      call appendFormatted result, line

      upperSyntax = translate(syntax)
      if pos('PROCEDURE', upperSyntax) = 1 then
         inProcedure = 1

      if pos(';', upperSyntax) > 0 then
         iterate

      if first = 'DO' | first = 'SELECT' then
         level = level + 1
      else if first = 'IF' & wordpos('THEN DO', upperSyntax) > 0 then
         level = level + 1
      else if first = 'ELSE' & word(upperSyntax, 2) = 'DO' then
         level = level + 1
      else if first = 'WHEN' & wordpos('THEN DO', upperSyntax) > 0 then
         level = level + 1
      else if first = 'OTHERWISE' & word(upperSyntax, 2) = 'DO' then
         level = level + 1
   end

   return result

appendFormatted: procedure = .void
   arg expose target = .string[], line = .string
   target[target[0] + 1] = line
   return

indentLine: procedure = .string
   arg line = .string, level = .int, inProcedure = .int

   if inProcedure then do
      if level = 0 then
         return copies(' ', 2) || strip(line, 'L')
      return copies(' ', 2 + (level * 3)) || strip(line, 'L')
   end

   return copies(' ', level * 3) || strip(line, 'L')

maskRexxLine: procedure = .string[]
   arg line = .string, commentDepth = .int

   masked = copies(' ', length(line))
   inSingle = 0
   inDouble = 0
   i = 1

   do while i <= length(line)
      ch = substr(line, i, 1)
      nx = substr(line, i + 1, 1)

      if commentDepth > 0 then do
         if ch = '/' & nx = '*' then do
            commentDepth = commentDepth + 1
            i = i + 2
         end
         else if ch = '*' & nx = '/' then do
            commentDepth = commentDepth - 1
            i = i + 2
         end
         else i = i + 1
         iterate
      end

      if inSingle then do
         if ch = "'" then do
            if nx = "'" then i = i + 2
            else do
               inSingle = 0
               i = i + 1
            end
         end
         else i = i + 1
         iterate
      end

      if inDouble then do
         if ch = '"' then do
            if nx = '"' then i = i + 2
            else do
               inDouble = 0
               i = i + 1
            end
         end
         else i = i + 1
         iterate
      end

      if ch = '/' & nx = '*' then do
         commentDepth = commentDepth + 1
         i = i + 2
         iterate
      end

      if ch = "'" then do
         inSingle = 1
         i = i + 1
         iterate
      end

      if ch = '"' then do
         inDouble = 1
         i = i + 1
         iterate
      end

      masked = overlay(ch, masked, i, 1)
      i = i + 1
   end

   result = .string[]
   result[1] = masked
   result[2] = commentDepth
   return result

/* ------------------------------------------------------------------
 * rxppinit: Initializes RXPP global state, arrays, counters, module name, system path, and default flags.
 * ------------------------------------------------------------------
 */
rxppinit: procedure=.string
  arg rexxname=.string,maclib=.string
  alphaN='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_'
  source=.string[]
  source_origin_file=.string[]
  source_origin_line=.string[]
  source_origin_text=.string[]
  source_mcall_depth=.string[]
  stype.1='R'
  beginBlock=.string[]
  beginName=.string[]
  macros_mname=.string[]
  macros_mspace=.int[]
  callargs=.string[]
  callargs_source_col=.int[]
  callargs_source_len=.int[]
  macros_varname=.string[]
  macros_varvalue=.string[]
  included_files=.string[]
  imported_funcs=""
  external_modules=""
  link_target=""
  no_run=0
  scriptMacro=.stem()
  globaldef=''
  lino=0
  srcmap_source_file=rexxname
  srcmap_line_offset=10
  select_count=0
  outbuf=.string[]
  mexpanded=0
  rxmodule=translate(rexxname,,'/\')
  wrds=words(rxmodule)
  rxmodule=word(rxmodule,wrds)
  syspath=translate(maclib,,'/\')
  wrds=words(syspath)
  wlast=wordindex(syspath,wrds)
  syspath=substr(maclib,1,wlast-1)
  call setvar 'rxpp_rexx',rxmodule
  rxmodule=word(translate(rxmodule,,'.'),1)
  cflags=' ndef nset svars siflink n1buf n2buf n3buf n4buf nvars nparse strictmacrocheck nmaclog nblockmacros'
  call setvar 'cflags',cflags
  printgen_flags='all'
  call setvar 'printgen',printgen_flags
  call setvar 'rxpp_date',date()' 'time()
  call setvar 'date',date()
  call setvar 'time',time('l')
  return translate(strip(syspath),'/','\')
