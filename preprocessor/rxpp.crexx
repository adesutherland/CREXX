/**
 * RXPP preprocessor.
 *
 * RXPP expands .rxpp macro/directive source into ordinary Level B CREXX.
 * By default RXPP emits the raw source-map channel that rxc consumes before
 * parsing so diagnostics can point back to original .rxpp files instead of only
 * the generated .crexx file.  Use ##CFLAG nosrcmap only for legacy plain-output
 * inspection.
 */
options levelb

import rexxscript
import precomp
import rxfnsb
import system
namespace rxpp expose globaldef rxmodule source stype source_origin_file source_origin_line source_origin_text source_mcall_depth callargs callargs_source_col callargs_source_len macros_mname macros_margs macros_mbody macros_mspace macros_varname macros_varvalue cflags printgen_flags outbuf lino curlino rexxlines included_files syspath macpath syslib inpath outpath alphaN mExpanded expandLevel aifblock elapsedTime verbose imported_funcs external_modules link_target no_run select_count beginblock beginName scriptMacro scriptMacros scriptMacroPath scriptMacroCounter srcmap_source_file srcmap_line_offset dalias rxpp_build_mode fortran_bind_count fortran_bind_target fortran_bind_host fortran_bindings_declared fortran_export_count fortran_export_target fortran_export_host fortran_exports_declared fortran_call_insert_at rxpp_stats_directives rxpp_stats_includes rxpp_stats_include_duplicates rxpp_stats_suppressed rxpp_stats_pass1_lines rxpp_stats_pass2_links

/* ------------------------------------------------------------------
 * CREXX Pre Compiler
 *   Currently supported Commands
 *   ##DEFINE
 *   ##INCLUDE  (nested)
 *   ##LOADMACRO (register external script macros from a directory)
 * ------------------------------------------------------------------
 */
 main: procedure = .int
arg command=.string[]
  internal_testing=0    ## activate only for rxpp internal tests
  env=.os()
  syslib  = env.LoadPath()
  infile  = .string
  outfile = .string
  maclib  = .string
  rxpp_build_mode = 0
  verbose = .int
  verbose = 0
  cnext   = .string
  dalias  = .string
  rexx_version = .string
  rxpp_build_timestamp = 'RXPP_BUILD_TIMESTAMP'
  rxpp_timing_mark = .int
  rxpp_timing_elapsed = .int
  rxpp_timing_seconds = .float
  rxpp_stats_directives = 0
  rxpp_stats_includes = 0
  rxpp_stats_include_duplicates = 0
  rxpp_stats_suppressed = 0
  rxpp_stats_pass1_lines = 0
  rxpp_stats_pass2_links = 0
  assembler rxvers rexx_version
  platform = word(rexx_version,1)' 'word(rexx_version,2)
  rxpp_version = word(rexx_version,3)' 'word(rexx_version,4)

  ElapsedTime=time('us')
  rxpp_timing_mark=ElapsedTime

  do i=1 to command.0
     j=i+1
     command.i=upper(command.i)
     if j>command.0 then leave         /* not existing command.j might lead to error */
     if command.i     ='-I' then infile=command.j
     else if command.i='-IN' then infile=command.j
     else if command.i='-O' then outfile=command.j
     else if command.i='-OUT' then outfile=command.j
     else if command.i='-M' then maclib=command.j
     else if command.i='-VERBOSE' then verbose=command.j
     else if command.i='--RXBUILD' then rxpp_build_mode=1
  end
  if verbose then say 'CRX0010I ['time('l')'] Pre-Compile started RXPP build 'rxpp_build_timestamp
  
  if internal_testing=1 then do
     infile  = 'C:/Users/PeterJ/CLionProjects/CREXX260401/lib/plugins/system/treemap_test.rxpp'
     outfile = 'C:/Users/PeterJ/CLionProjects/CREXX260401/lib/plugins/system/treemap_test.crexx'
     maclib  = 'C:/Users/PeterJ/CLionProjects/CREXX260401/preprocessor/Maclib.rexx'
  end


 if strip(infile)='' then do
     call rxpp_diag 'error','RXPP_NO_SOURCE_FILE'
     exit 8
  end
  if verbose then do
     say 'Input File:  ' translate(infile,'/','\')
     say 'Output File: ' translate(outfile,'/','\')
     say 'Macro Lib:   ' translate(maclib,'/','\')
     say 'Verbose:     ' verbose
  end
  inpath=getpath(infile)
  outpath=getpath(outfile)
  macpath=getpath(maclib)

scriptMacro=.stem()
scriptMacros=.string[]
scriptMacroPath=.stem()
scriptMacroCounter=0
syspath=rxppinit(infile,maclib)                   ## init global and environment variables
call registerScriptMacros inpath                 /* maclib macros have precedence */
if inpath \= macpath then call registerScriptMacros macpath

syspath=translate(syspath,'/','\')
syslib=translate(syspath,'/','\')
inpath=translate(inpath,'/','\')
outpath=translate(outpath,'/','\')
macpath=translate(macpath,'/','\')

if verbose then do
   say 'CRX0100I ['time('l')'] Pre-Compile pass one'
   say 'CRX0110I ['time('l')'] Syslib Path 'syspath
   say 'CRX0110I ['time('l')'] System Path 'syslib
   say 'CRX0110I ['time('l')'] Input Path  'inpath
   say 'CRX0110I ['time('l')'] Macro Path  'macpath
   say 'CRX0110I ['time('l')'] Build Path  'outpath
 end
 call setvar 'syslib',syslib
 call setvar 'syspath',syspath
 call setvar 'macpath',macpath
 call setvar 'inpath',inpath
 call setvar 'buildpath',outpath
 call setvar 'sourcefile',translate(infile,'/','\')
 call setvar 'outputfile',translate(outfile,'/','\')
 call setvar 'platform',platform
 call setvar 'rxpp_version',rxpp_version

/* --------------------------------------------------------------------
 * Pass One. Load Macros, Load Source, Expand Macros of Source
 * --------------------------------------------------------------------
 */
  call rxpp_flow 'pass1','start',0,'load source and register directives'
  sourceLines=RXPPPassOne(infile,outfile,maclib,syspath'/macsys.rexx')    ## load source file and macro library
  rxpp_stats_pass1_lines=source.0
  call rxpp_flow 'pass1','end',0,'source_lines='source.0
  if rxpp_cflag_present('timing') then do
     rxpp_timing_elapsed=time('us')-rxpp_timing_mark
     rxpp_timing_seconds=(rxpp_timing_elapsed as .float)/1000000
     say '++RXPP-DIAG timing pass1 ' rxpp_timing_seconds 'seconds'
     rxpp_timing_mark=time('us')
  end
  /* 1buf is a pass boundary diagnostic: CFLAG has been picked up by
   * RXPPPassOne, and the source is now stable until RXPPPassTwo starts. */
  if pos(' 1buf',cflags)>0 then call list_array source,-1,-1,'Source Buffer after Pass 1'
/* ------------------------------------------------------------------
 * Pass Two create ##IF/##IFN/##ELSE/##ENDIF reference table
 * ------------------------------------------------------------------
 */
  call rxpp_flow 'pass2','start',0,'normalize conditionals and link blocks'
  call RXPPPassTwo                                  ## pass 2 to pre-expand certain elements (##ELSE)
  rxpp_stats_pass2_links=aifblock.0
  call rxpp_flow 'pass2','end',0,'links='aifblock.0
  if pos(' 2buf',cflags)>0 then call list_array source,-1,-1,'Source Buffer after Pass 2'
  if rxpp_cflag_present('timing') then do
     rxpp_timing_elapsed=time('us')-rxpp_timing_mark
     rxpp_timing_seconds=(rxpp_timing_elapsed as .float)/1000000
     say '++RXPP-DIAG timing pass2 ' rxpp_timing_seconds 'seconds'
     rxpp_timing_mark=time('us')
  end
  if verbose then say 'CRX0200I ['time('l')'] Pre-Compile pass two'
/* ------------------------------------------------------------------
 *  Pass 3 keep/drop ##IF /##IFN blocks, build Final Output Buffer
 * ------------------------------------------------------------------
 */
  call rxpp_flow 'pass3','start',0,'select and emit generated source'
  call RXPPPassThree outfile                        ## analyse source and expand macros
  call rxpp_flow 'pass3','end',0,'output_lines='outbuf.0
  if rxpp_cflag_present('timing') then do
     rxpp_timing_elapsed=time('us')-rxpp_timing_mark
     rxpp_timing_seconds=(rxpp_timing_elapsed as .float)/1000000
     say '++RXPP-DIAG timing pass3 ' rxpp_timing_seconds 'seconds'
     rxpp_timing_mark=time('us')
  end
  if verbose then say 'CRX0310I ['time('l')'] Pre-Compiled REXX saved'
     if pos(' 3buf',cflags)>0 then call list_array outbuf, -1,-1,'Source Buffer after Pass 3'
  if rxpp_cflag_present('format') then outbuf=formatRexx(outbuf)
  if rxpp_cflag_present('4buf') then call list_array outbuf, -1,-1,'Source Buffer after Formatting'
  call writeall outbuf,outfile,-1                   ## write generated output to file
 /* call linkerInfo outfile,imported_funcs,external_modules,link_target,link_go,no_run      */      ## linker definition will be calculated out of the normal output file
  call linkerInfo outfile,imported_funcs,external_modules,link_target,no_run      ## linker definition will be calculated out of the normal output file

  if rxpp_cflag_present('timing') then do
     rxpp_timing_elapsed=time('us')-rxpp_timing_mark
     rxpp_timing_seconds=(rxpp_timing_elapsed as .float)/1000000
     say '++RXPP-DIAG timing output ' rxpp_timing_seconds 'seconds'
     rxpp_timing_elapsed=time('us')-ElapsedTime
     rxpp_timing_seconds=(rxpp_timing_elapsed as .float)/1000000
     say '++RXPP-DIAG timing total ' rxpp_timing_seconds 'seconds'
  end

  if verbose then do
     say 'CRX0500I ['time('l')'] Pre-Compile completed, 'mexpanded' macro calls expanded, total source lines 'outbuf.0
     if pos(' vars',cflags)>0 then call printvars
     if pos(' maclist',cflags)>0 then call printmacs
     if pos(' includes',cflags)>0 then do
        call list_array included_files,-1,-1,'Include Files'
        call list_blocks
     end
     elapsedTime=(time('us')-elapsedtime)
     say 'CRX0101I ['time('l')'] Elapsed Time 'elapsedTime/1000000' seconds, 'elapsedTime/1000' milliseconds'
  end
  if rxpp_cflag_present('stats') then call rxpp_stats_report
return 0

/* ------------------------------------------------------------------
 * Pre Processor Pass One
 * 1. Load (and sort) Macros
 * 2. Load Source File
 * 3. Determine Pre-Processor Statements
 * ------------------------------------------------------------------
 */
RXPPPassOne: procedure = .int expose fortran_bind_count fortran_bind_target fortran_bind_host fortran_bindings_declared fortran_export_count fortran_export_target fortran_export_host fortran_exports_declared fortran_call_insert_at
  arg expose infile=.string, outfile=.string,maclib=.string, macsys=.string

  /* Locals */
  maxmac = .string
/* ---- 1a. Load Macros from MACLIB  */
  macnum=readSource(maclib,0)    /* error doesn't terminate program */
  if macnum<0 then do
     call rxpp_diag 'warning','RXPP_MACLIB_MISSING','file',maclib
  end
  else do
     call GetPreComp macnum,infile                 ## analyse maclib, source lines not needed just register macros
     if verbose then say 'CRX0120I ['time('l')'] Maclib loaded:      'source.0' records'
     if verbose then say 'CRX0130I ['time('l')'] Macros extracted:   'macros_mname.0
     maxmac=macros_mname.0
  end
## clear source array
##  call drop_Array source
##  call drop_Array stype
  assembler SETATTRS source,0
  assembler SETATTRS stype,0
  assembler SETATTRS source_origin_file,0
  assembler SETATTRS source_origin_line,0
  assembler SETATTRS source_origin_text,0

/* ---- 1b. Load System Macros from MACSYS  */
  macnum=readSource(macsys,0)    /* error doesn't terminate program */
  if macnum<0 then do
     call rxpp_diag 'warning','RXPP_SYSTEM_MACLIB_MISSING','file',macsys
  end
  else do
     call GetPreComp macnum,infile                 ## analyse maclib, source lines not needed just register macros
     if verbose then say 'CRX0120I ['time('l')'] System Maclib loaded: 'source.0' records'
     if verbose then say 'CRX0130I ['time('l')'] Macros extracted:     'macros_mname.0-maxmac
  end
## clear source array
##  call drop_Array source
##  call drop_Array stype
  assembler SETATTRS source,0
  assembler SETATTRS stype,0
  assembler SETATTRS source_origin_file,0
  assembler SETATTRS source_origin_line,0
  assembler SETATTRS source_origin_text,0
/* ---- 1c. Load file to compile */
  rexxLines=readSource(infile,1)
  if rexxLines<0 then do
     call rxpp_diag 'error','RXPP_SOURCE_MISSING','file',infile
     exit 8
  end
  call rxpp_set_source_origin_range 1,rexxLines,infile,1
  if rxpp_input_has_srcmap_options() then do
     call rxpp_diag 'error','RXPP_ALREADY_SOURCE_MAPPED','file',infile
     call rxpp_diag 'error','RXPP_ALREADY_SOURCE_MAPPED_HINT'
     exit 8
  end

/* ---- 2. find levelb, import and other option stuff  */
  which=0
  /* now pickup the flags, they might be used in PRECOMP */
  i=fsearch(source,1,"##CFLAG","","",which)   ## pickup CFLAG
  if i>0 then flagsset=early_flag_pick_up(i)

  level='levelb'
  linx=arrayfind('options levelg',source,1,0)
  if linx>0 then do
      stype.linx='X'
      level='levelg'
  end
  else do
      linx=arrayfind('options levelb',source,1,0)
      if linx>0 then stype.linx='X'
  end
  linx=arrayfind('import rxfnsb',source,1,0)
  if linx>0 then stype.linx='X'

  linx=arrayfind('/* REXX */',source,1,0)
  if linx>0 then stype.linx='X'
  else do
     linx=arrayfind('/* RXPP */',source,1,0)
     if linx>0 then do
        stype.linx='X'
        source[linx]=''
     end
  end
  call insert_source 1,10

  source.1='/* RXPP */'
  source.2='options' level
  if rxpp_srcmap_enabled() then source.2='options' level 'srcmap'
  source.3='import rxfnsb'
  source.4='/* reserved for namespace definition */'
  rexxlines=rexxlines+3
  if verbose then say 'CRX0140I ['time('l')'] Rexx Source loaded: 'rexxLines' records'

  /* now pickup ##BEGIN  */
  i=1
  which=0
  do forever
     beg=fsearch(source,i,"##BEGIN","","",which)   ## pickup BEGIN
     if beg=0 then leave
     stype[beg]='I'
     bi=beginBlock[0]
     beginName[beginName[0]+1]=upper(word(source[beg],2))
     ii=.int
     j=0
     do ii=beg+1 to source[0]
        stype[ii]='X'   /* drop it from source file */
        ww1=upper(word(source[ii],1))
        if ww1='##ENDBEGIN' then leave
        j=j+1
        beginBlock[bi+j]=source[ii]
        if pos(' nset',cflags)>0 then source[ii]=''
        else source[ii]='/* 'source[ii]' I*/'
     end
     beginName[beginName[0]]=beginName[beginName[0]]' 'bi+1' 'j
     i=ii+1
  end

/* ---- 3. Pre-Compile source file,  */
  maclibm=macros_mname.0
  fortran_bind_count=0
  fortran_bind_target=.string[]
  fortran_bind_host=.string[]
  fortran_bindings_declared=0
  fortran_export_count=0
  fortran_export_target=.string[]
  fortran_export_host=.string[]
  fortran_exports_declared=0
  fortran_call_insert_at=source.0+1
  call GetPreComp rexxlines,infile       ## analyse source, source lines needed keep them
  fortran_block_seen=0
  do scan_line=1 to source.0
     if source.scan_line='fortran_source = .string[]' then fortran_block_seen=1
  end
  if fortran_block_seen=1 then do
     if fortran_exports_declared=1 & fortran_bindings_declared=0 then do
        fortran_call_insert_at=RXPP_fortran_emit(fortran_call_insert_at,'fortran_bindings = .string[]')
        fortran_bindings_declared=1
     end
     if fortran_exports_declared=1 then fortran_call_insert_at=RXPP_fortran_emit(fortran_call_insert_at,'fortran_results = fortran_run(fortran_source, fortran_bindings, fortran_exports)')
     else if fortran_bindings_declared=1 then fortran_call_insert_at=RXPP_fortran_emit(fortran_call_insert_at,'call fortran_run fortran_source, fortran_bindings')
     else fortran_call_insert_at=RXPP_fortran_emit(fortran_call_insert_at,'call fortran_run fortran_source')
     if fortran_exports_declared=1 then do
        fortran_call_insert_at=RXPP_fortran_emit(fortran_call_insert_at,'__fortran_export_pos = 1')
        do export_index=1 to fortran_export_count
           fortran_call_insert_at=RXPP_fortran_emit(fortran_call_insert_at,'__fortran_export_count = fortran_results[__fortran_export_pos]')
           fortran_call_insert_at=RXPP_fortran_emit(fortran_call_insert_at,'__fortran_export_pos = __fortran_export_pos + 1')
           fortran_call_insert_at=RXPP_fortran_emit(fortran_call_insert_at,'__fortran_export_i_'export_index' = 1')
           fortran_call_insert_at=RXPP_fortran_emit(fortran_call_insert_at,'do while __fortran_export_i_'export_index' <= __fortran_export_count')
           fortran_call_insert_at=RXPP_fortran_emit(fortran_call_insert_at,fortran_export_host[export_index]'[__fortran_export_i_'export_index'] = fortran_results[__fortran_export_pos]')
           fortran_call_insert_at=RXPP_fortran_emit(fortran_call_insert_at,'__fortran_export_pos = __fortran_export_pos + 1')
           fortran_call_insert_at=RXPP_fortran_emit(fortran_call_insert_at,'__fortran_export_i_'export_index' = __fortran_export_i_'export_index' + 1')
           fortran_call_insert_at=RXPP_fortran_emit(fortran_call_insert_at,'end')
        end
     end
  end
  if verbose then say 'CRX0150I ['time('l')'] Macros extracted:   'macros_mname.0-maclibm
  call sort_bylen macros_mname,macros_margs,macros_mbody,macros_mspace ## sort macro names by length do avoid unintented substitution (e.g. quote dquote)
  if verbose then say 'CRX0160I ['time('l')'] Macros arranged:    'macros_mname.0
return rexxlines
/* ------------------------------------------------------------------
 * Pass 2 pre-expand certain elements
 * !! Macro expansions already took place in Pass one step 3 !!
 * create ##IF/##IFN/##ELSE/##ENDIF reference table
 * ------------------------------------------------------------------
 */
RXPPPassTwo: procedure
  stack = .string[]     /* simulate stack using indexed stem */
  depth = 0             /* current depth */
  aifblock=.int[]
  which=0
  i=fsearch(source,1,'namespace ','',"",which)            ## find any namespace instruction
  if i>0 then do
     globaldef=source.i' 'globaldef
     source.i=""
  end
  i=fsearch(source,1,'##IF ','##IFN ',"##CFLAG",which)   ## search as first word in the source string

/* 1. ##ELSE becomes    Translate ELSE clause
        ##ENDIF         close previous ##IF
        ##IFN condition open else as ##IFN    */
  do while i>0
     if which<3 then condition=subword(source.i,2)
     else flagsset=early_flag_pick_up(i) /* <<<!!!!!!!!!!!! ugly construct to pick up potential compiler flags immediately after pass 1 */
     i=fsearch(source,i+1,'##IF ','##IFN ','##ELSE',which)
     if which \=3 then iterate
     call arrayInsert source,i,1
     call arrayInsert stype,i,1
     source.i='##endif'
     stype.i='R'
     j=i+1
     source.j='##ifn 'condition
     i=fsearch(source,j+1,'##IF ','##IFN ',"",which)   ## search as first word in the source string
  end

/* 2. ##IF / ##IFN build cross reference  */
  which=0
  i=fsearch(source,1,'##IF ','##IFN ',"",which)   ## search as first word in the source string
  do while i>0
     if which=1 then stype.i='IF'
     else if which=2 then stype.i='IFN'
     lnk=findMatchingEndif(i+1)
     aifblock.i=lnk
     i=fsearch(source,i+1,'##IF ','##IFN ','',which)
  end

/* 3. output ##IF ##IFN / ##ENDIF Reference table */
  if verbose=0 then return
  if pos(' iflink',cflags)=0 then return
  if aifblock.0=0 then say "+++ no Pre Source Expansion occurred"
  else do i=1 to aifblock.0
     if aifblock.i=0 then iterate
     lnk = .int
     lnk=aifblock.i
     say right(i,4,'0')' 'left(strip(source.i),15)' linked to --> ' right(lnk,4,'0') ' ' strip(source.lnk)'  <+++ PASS2: IF/ENDIF linked; PASS3 decides emit or skip>'
     do j=.int(i+1) to lnk-1
        say '? controlled by IF: 'right(j,4,'0')' 'strip(source.j)
     end
     say right(lnk,4,'0')' 'left(strip(source.lnk),15)' (block end)'
  end
return
/* ------------------------------------------------------------------
 *  Pass 3 Build Final Output Buffer
 *    1. activate ##IF /##IFN block if condition is true
 *    2. not active blocks are dropped stype.LineNo='X'
 *    3. handle ##PARSE, why ? maybe belongs to Pass one
 *    4. Write or Dropm Macro and pre-compiler statements
 *       to show original pre-process call
 * ------------------------------------------------------------------
 */
RXPPPassThree: procedure
  arg out=.string
  lineNo=0
  condition=.string
  if globaldef='' then source.4=''
  else do
     if fpos('namespace',globaldef,1)>0 then source.4=globaldef
     else source.4='namespace 'rxmodule' expose 'globaldef
  end
  do while lineNo<source.0
      lineNo=Lineno+1
     curLino=LineNo           ## save into global current LineNo
     line = source.lineNo
     uline=upper(strip(line))
     if stype.LineNo='X' then do
        rxpp_stats_suppressed=rxpp_stats_suppressed+1
        call rxpp_flow 'pass3','suppress',lineNo,'stype=X'
        iterate    ## suppress any ##ELSE ##ENDIF
     end
     else if stype.LineNo='noexp' then do
        if pos('/* reserved',line)>0 then iterate
        call writeline line
        iterate
     end
     if pos('/* reserved',line)>0 then iterate
  	 else if stype.LineNo='D' then do
        if pos(' ndef',cflags)>0 then do
           rxpp_stats_suppressed=rxpp_stats_suppressed+1
           call rxpp_flow 'pass3','suppress',lineNo,'ndef'
           iterate     ## ndef    : suppress original definition, just output expanded result
        end
 	    call writeLine printGen(line,1)           ## printgen: prints pre-processor line with appropriate suffix comment
  	 end
     else if stype.LineNo='I' then do
       if pos(' nset',cflags)>0 then do
          rxpp_stats_suppressed=rxpp_stats_suppressed+1
          call rxpp_flow 'pass3','suppress',lineNo,'nset'
          iterate      ## nset    : suppress original definition, just output expanded result
       end
   	   call writeLine printGen(line,2)            ## printgen: prints pre-processor line with appropriate suffix comment
     end
     else if stype.LineNo='IF' then do
       ##  call writeLine printGen(line,4)
       condition=strip(substr(line,6))
       if rxpp_condition_eval(condition)=0 & aifblock.lineno>lineNo then do   ## only forward pointer are permitted, else loop
           rxpp_stats_suppressed=rxpp_stats_suppressed+1
           call rxpp_flow 'pass3','conditional_skip',lineNo,strip(line)
           if rxpp_cflag_present('iftrace') then say '++RXPP-DIAG iftrace line='lineNo ' 'strip(line)' -> skipped'
           lineno=aifblock.lineno
        end
        else do
           call rxpp_flow 'pass3','conditional_keep',lineNo,strip(line)
           if rxpp_cflag_present('iftrace') then say '++RXPP-DIAG iftrace line='lineNo ' 'strip(line)' -> retained'
        end
     end
     else if stype.LineNo='IFN' then do
       ##  call writeLine printGen(line,4)
        condition=strip(substr(line,7))
        if rxpp_condition_eval(condition)=1 & aifblock.lineno>lineNo then do  ## only forward pointer are permitted, else loop
           rxpp_stats_suppressed=rxpp_stats_suppressed+1
           call rxpp_flow 'pass3','conditional_skip',lineNo,strip(line)
           if rxpp_cflag_present('iftrace') then say '++RXPP-DIAG iftrace line='lineNo ' 'strip(line)' -> skipped'
           lineno=aifblock.lineno
        end
        else do
           call rxpp_flow 'pass3','conditional_keep',lineNo,strip(line)
           if rxpp_cflag_present('iftrace') then say '++RXPP-DIAG iftrace line='lineNo ' 'strip(line)' -> retained'
        end
     end
##     else if stype.LineNo='PARSE' then call parsevar lineNo,line
     else if stype.LineNo='IMPORT' then do
        func=word(line,2)
        if pos("|"func,imported_funcs)=0 then do
           imported_funcs=imported_funcs"|"func   ## keep track of imported modules
           call writeline line                    ## also write line, else it gets lost
        end
     end
     else if stype.LineNo='EMIT' then do
        /* Sections are complete only after preceding macros expand. */
        call cmd_emit lineNo,line
        if pos(' ndef',cflags)>0 then iterate      ## ndef    : suppress original definition, just output expanded result
        call writeLine printGen(line,5)            ## printgen: prints pre-processor line with appropriate suffix comment
     end
     else if stype.LineNo='ARRAY' then do
       if pos(' ndef',cflags)>0 then iterate      ## ndef    : suppress original definition, just output expanded result
       call writeLine printGen(line,5)            ## printgen: prints pre-processor line with appropriate suffix comment
     end
     else if stype.LineNo='GLOBAL' then do
       if pos(' ndef',cflags)>0 then iterate      ## ndef    : suppress original definition, just output expanded result
       call writeLine printGen(line,6)            ## printgen: prints pre-processor line with appropriate suffix comment
     end
   	 else if stype.LineNo='FOR' then do
       if pos(' ndef',cflags)>0 then iterate      ## ndef    : suppress original definition, just output expanded result
       call writeLine printGen(line,3)            ## printgen: prints pre-processor line with appropriate suffix comment
     end
     else if strip(line) \='' then do
       if left(uline,7)='##BLANK' then do
           call writeline ' '
           iterate
       end
       newline = expandRecursive(line,lineNo)
       if pos('##EMIT',upper(word(newline,1)))>0 then do   /* allow a macro call ##EMIT */
          /* Sections are complete only after preceding macros expand. */
          call cmd_emit lineNo,newline
          if pos(' ndef',cflags)>0 then iterate      ## ndef    : suppress original definition, just output expanded result
          call writeLine printGen(line,5)            ## printgen: prints pre-processor line with appropriate suffix comment
       end
       if stype.LineNo='D' & pos(' ndef',cflags)>0 then iterate
       call writeline newline
   	 end
  end
  call writeline ''
  if verbose then say 'CRX0300I ['time('l')'] Pre-Compiled REXX generated '
return
/* ------------------------------------------------------------------
 * Early_flag_pick_up Reads ##CFLAG early and updates runtime flags used during subsequent passes.
 * ------------------------------------------------------------------
 */
early_flag_pick_up: procedure=.int
  arg i=.int
  if i=0 then return 0

  line = lower(strip(source.i))

  if left(line, 2) = '/*' & right(line, 2) = '*/' then do
     line = strip(substr(line, 3, length(line) - 4))
     already_wrapped = 1
  end
  else already_wrapped = .int(0)

  cflags = ' ' || subword(line, 2)
  call setvar 'cflags', cflags
  call rxpp_flow 'pass2','cflag',i,cflags

  if \already_wrapped then source.i = '/* ' || line || ' */'
return 1
/* ------------------------------------------------------------------
 * Output Begin Blocks for information (not into code)
 * ------------------------------------------------------------------
 */
 list_blocks: procedure
  if beginName[0]>0 then say ' '
  do i=1 to beginName[0]
     say 'Begin Block: 'word(beginName[i],1)
     say copies('-',48)
     from=word(beginName[i],2)
     if datatype(from) \= 'NUM' then leave
     tto =word(beginName[i],3)
     if datatype(tto) \= 'NUM' then leave
     tto =from+tto-1
     do j=from to tto
        say right(j,4,'0') beginBlock[j]
     end
     say ' '
  end
 return
/* ------------------------------------------------------------------
 * for ##IF / ##IFN find associated ##ENDIF, handling nesting.
 * ------------------------------------------------------------------
 */
findMatchingEndif: procedure=.int
  arg startline=.int
  nest = 1  /* Start at 1 because the current ##IF is level 1 */
  which = 0
  i = fsearch(source, startline, '##IF ','##IFN ','##END', which)
  do while i > 0
    if which = 1 | which=2 then nest = nest + 1
    else if which = 3 then do
      nest = nest - 1
      stype.i = 'X'  /* mark for removal or annotation */
      if nest = 0 then return i  /* finally matched ##ENDIF */
    end
    i = fsearch(source, i + 1, '##IF ', '##IFN ','##END', which)
  end
  call rxpp_diag 'error','RXPP_MISSING_ENDIF','line',startline
return 0
/* ------------------------------------------------------------------
 * Read Rexx Source file into the global source[] buffer.
 * ------------------------------------------------------------------
 */
ReadSource: procedure=.int
  arg file=.string,mandatory=1
##  i=readall(source,file,-1)
  source=ReadLines(file,,,"noRaise")
  if mandatory=1 & source[0]=1 & word(source[1],1)='-8' then do
     call rxpp_diag 'error','RXPP_SOURCE_MISSING','file',file
     call rxpp_diag 'error','RXPP_FILE_TERMINATED','file',file
     exit 8
  end
  if word(source[1],1)='-8' then return -8
return source[0]
/* ------------------------------------------------------------------
 * Scans source for pre-compiler directives and macro definitions,
 * dispatches command handlers.
 * ------------------------------------------------------------------
 */
GetPrecomp: procedure expose rxpp_build_mode
   arg line_no=.int,source_file=.string
   lineNo = 0
   source_file=translate(source_file,'/','\')
   source_file=changestr('//',source_file,'/')
   if rxpp_build_mode='debug' then say 'CRX0000I ['time('l')'] Reading 'source_file

   if rxpp_build_mode='debug' then say 'CRX0000I ['time('l')'] Pre-Compiling 'source_file
   builddir=0    /* ##BUILDDIR may appear only once */
   do while lineNo < source.0      ## array might grow, so while is more reliable
      LineNo=LineNo+1
      if stype[LineNO]='noexp' | stype[LineNO]='cmt' then iterate
      hit=0
      depth = CommentScan(lineNo,0,hit)
      if hit then do
         cmtbeg=LineNo
         stype[lineNo] = 'cmt'
      /* if still inside a block comment, mark subsequent lines too */
         do while depth > 0 & lineNo < source.0
            lineNo = lineNo + 1
            stype[lineNo] = 'cmt'
            depth=CommentScan(lineNo, depth,hit)  /* hit will be 1 anyway because depth>0 at BOL, but keep it consistent */
         end
         if pos(' cmtblk',cflags)> 0 & LineNo-cmtbeg>15 then do ci=cmtbeg+1 to lineNo-1
            source[ci]='*>'source[ci]
         end
      end
      line = source.lineNo
      ucmd=word(line,1)
      if ucmd='' then iterate
      ucmd=upper(ucmd)
      if substr(ucmd,1,2)='##' then do
         rxpp_stats_directives=rxpp_stats_directives+1
         call rxpp_flow 'pass1','directive',lineNo,ucmd
      end
      if ucmd = 'PARSE' then stype.LineNo='PARSE'                      ## short cut although it is a precompiler instruction
      else if ucmd = 'IMPORT' then stype.LineNo='IMPORT'               ## keep track of all imported functions plugins
      else if ucmd = 'FOR'    then call cmd_for lineNo,line
      else if ucmd = 'REXXSCRIPT' then do
         if words(line) >= 2 & upper(word(line,2)) = 'RUN' then call cmd_rexxscript_run lineNo,line
      end
      else if ucmd = 'FORTRAN' then do
         if words(line) >= 2 then do
            if upper(word(line,2)) = 'RUN' then call cmd_fortran_run lineNo,line,'RUN'
            else if upper(word(line,2)) = 'PROCEDURES' then call cmd_fortran_run lineNo,line,'PROCEDURES'
         end
      end
      else if pos('<'ucmd,dalias'>') > 0 then do
         call cmd_data_alias lineNo,line
         iterate
      end
      if substr(ucmd,1,2)\='##' then iterate
      if ucmd      = '##DEFINE'  then lineno=cmd_define(lineNo,line)
      else if ucmd = '##MACRO'  then lineno=cmd_macro(lineNo,line)
      else if ucmd = '##INCLUDE' then call cmd_include lineNo,line,1
      else if ucmd = '##LOADMACRO' then call cmd_loadMacro lineNo,line
      else if ucmd = '##BUILDDIR' then stype.LineNo='X'
      else if ucmd = '##RXBUILD' then do
         if upper(word(line,2)) = 'REQUIRED' then do
            if rxpp_build_mode = 0 then do
               call rxpp_diag 'error','RXPP_BUILD_REQUIRED','file',source_file
               exit 8
            end
            stype.LineNo='X'
         end
      end
      else if ucmd = '##EXTERNAL' then call cmd_external lineNo,line
      else if ucmd = '##LINK' then call cmd_link lineNo,line
      else if ucmd = '##NORUN' then call cmd_norun lineNo,line
      else if ucmd = '##EMIT'    then stype.LineNo='EMIT'
      else if ucmd = '##USE'     then call cmd_include lineNo,line,2
      else if ucmd = '##COPYBLOCK' then call cmd_copyBlock lineNo,line
      else if ucmd = '##DATA'    then call cmd_data lineNo,line
      else if ucmd = '##RELATION' then call cmd_data lineNo,line
      else if ucmd = '##PROGRAM' then call cmd_data lineNo,line
      else if ucmd = '##LIBRARY' then call cmd_data lineNo,line
      else if ucmd = '##RULE' then call cmd_data lineNo,line
      else if ucmd = '##INPUT'   then call cmd_data lineNo,line,"input"
 ##     else if ucmd = '##PARSE'   then stype.LineNo='PARSE'
      else if ucmd = '##ARRAY'   then call cmd_array  lineNo,line
      else if ucmd = '##DALIAS'  then call cmd_dalias  lineNo,line
      else if ucmd = '##GLOBAL'  then call cmd_global lineNo,line
      else if substr(ucmd,1,5) = '##SYS'   then call cmd_data lineNo,line, substr(ucmd,3)
##       else if ucmd = '##????' then do    ## for any new pre compile statement
##       end
   end
return

/* Insert one generated RexxScript source line at a precise position. */
RXPP_rexxscript_emit: procedure = .int expose source stype
  arg at=.int,text=.string
  call insert_source at,1,'D'
  source.at=text
  stype.at=' '
return at+1

/* ------------------------------------------------------------------
 * CMD_rexxscript_run: Package a multiline RexxScript body as one ordinary
 * REXXSCRIPT expression.  The runtime/compiler-exit semantics remain the
 * existing ones; this command only removes the need to quote/concatenate
 * every source line manually.
 * ------------------------------------------------------------------
 */
CMD_rexxscript_run: procedure
  arg line_no=.int,line=.string
  opening_line=line
  stype.line_no='D'
  script_lines=.string[]
  script_count=0
  found=0
  i=.int
  do i=line_no+1 to source.0
     line=source.i
     if upper(strip(line))='END REXXSCRIPT' then do
        found=1
        leave
     end
     if rxpp_expand_block_line(i) then iterate
     line=source.i
     script_count=script_count+1
     script_lines[script_count]=line
     source.i=''
     stype.i=' '
  end
  if found=0 then do
     say 'RXPP error: REXXSCRIPT RUN requires END REXXSCRIPT'
     exit 8
  end

  source.line_no=''
  source.i=''
  stype.i=' '
  insert_at=i+1
  insert_at=RXPP_rexxscript_emit(insert_at,"__rexxscript_source = ''")
  do script_index=1 to script_count
     insert_at=RXPP_rexxscript_emit(insert_at,'__rexxscript_source = __rexxscript_source || 'safe_quote(script_lines[script_index])' || ";"')
  end
  clauses=''
  if opening_line \= '' then clauses=subword(opening_line,3)
  generated='REXXSCRIPT __rexxscript_source'
  if clauses \= '' then generated=generated' 'clauses
  insert_at=RXPP_rexxscript_emit(insert_at,generated)
return

/* Insert one generated ordinary source line at a precise position. */
RXPP_fortran_emit: procedure = .int expose source stype
  arg at=.int,text=.string
  call insert_source at,1,'D'
  source.at=text
  stype.at=' '
return at+1

/* ------------------------------------------------------------------
 * CMD_fortran_run: Capture a free-form FORTRAN source block as part of the
 * combined fortran_source array used by the FORTRAN interpreter examples.
 *
 * The block deliberately has one fixed array name for the first version;
 * this keeps the RXPP syntax small while preserving the existing ##DATA
 * contract. The terminator is END FORTRAN.
 * ------------------------------------------------------------------
 */
CMD_fortran_run: procedure expose fortran_bind_count fortran_bind_target fortran_bind_host fortran_bindings_declared fortran_export_count fortran_export_target fortran_export_host fortran_exports_declared fortran_call_insert_at
  arg line_no=.int,line=.string,block_kind=.string
  stype.line_no='D'
  j=0
  do scan_line=1 to line_no-1
     if pos('fortran_source.', source.scan_line)=1 then j=j+1
  end
  if j = 0 then source.line_no='fortran_source = .string[]'
  else source.line_no=''
  found=0
  bind_start=fortran_bind_count
  export_start=fortran_export_count
  i=.int
  do i=line_no+1 to source.0
     line=source.i
     if upper(strip(line))='END FORTRAN' then do
        found=1
        leave
     end
     if rxpp_expand_block_line(i) then iterate
     line=source.i
     if pos('BIND', upper(line)) > 0 then do
        bind_line=strip(substr(line,pos('BIND',upper(line))+4))
        bind_body=bind_line
        bind_equals=pos('=',bind_body)
        bind_target=''
        bind_host=''
        if bind_equals > 1 then do
           bind_target=strip(left(bind_body,bind_equals-1))
           bind_host=strip(substr(bind_body,bind_equals+1))
        end
        if bind_target='' | bind_host='' then do
           say 'RXPP error: malformed C$RX BIND; expected C$RX BIND target = host'
           exit 8
        end
        fortran_bind_count=fortran_bind_count+1
        fortran_bind_target[fortran_bind_count]=bind_target
        fortran_bind_host[fortran_bind_count]=bind_host
     end
     if pos('EXPORT', upper(line)) > 0 then do
        export_line=strip(substr(line,pos('EXPORT',upper(line))+6))
        export_equals=pos('=',export_line)
        export_target=''
        export_host=''
        if export_equals > 1 then do
           export_target=strip(left(export_line,export_equals-1))
           export_host=strip(substr(export_line,export_equals+1))
        end
        if export_target='' | export_host='' then do
           say 'RXPP error: malformed C$RX EXPORT; expected C$RX EXPORT target = host'
           exit 8
        end
        fortran_export_count=fortran_export_count+1
        fortran_export_target[fortran_export_count]=export_target
        fortran_export_host[fortran_export_count]=export_host
     end
     j=j+1
     source.i='fortran_source.'j'='safe_quote(line)
     stype.i='noexp'
  end
  if found=1 then do
     source.i=''
     stype.i=' '
     /* Keep the deferred call after the last FORTRAN block.  A later
      * FORTRAN PROCEDURES block may shift this position, so each block
      * refreshes it while RXPP is collecting the source. */
     fortran_call_insert_at=i+1
     if block_kind='RUN' & (fortran_bind_count > bind_start | fortran_export_count > export_start) then do
        insert_at=i+1
        if fortran_bind_count > bind_start then do
           if fortran_bindings_declared=0 then do
              insert_at=RXPP_fortran_emit(insert_at,'fortran_bindings = .string[]')
              fortran_bindings_declared=1
           end
           insert_at=RXPP_fortran_emit(insert_at,'__fortran_bind_pos = 1')
           do binding_index=bind_start+1 to fortran_bind_count
              insert_at=RXPP_fortran_emit(insert_at,'fortran_bindings[__fortran_bind_pos] = 'safe_quote(fortran_bind_target[binding_index]))
              insert_at=RXPP_fortran_emit(insert_at,'__fortran_bind_pos = __fortran_bind_pos + 1')
              insert_at=RXPP_fortran_emit(insert_at,'fortran_bindings[__fortran_bind_pos] = 'fortran_bind_host[binding_index]'[0]')
              insert_at=RXPP_fortran_emit(insert_at,'__fortran_bind_pos = __fortran_bind_pos + 1')
              insert_at=RXPP_fortran_emit(insert_at,'__fortran_bind_i_'binding_index' = 1')
              insert_at=RXPP_fortran_emit(insert_at,'do while __fortran_bind_i_'binding_index' <= 'fortran_bind_host[binding_index]'[0]')
              insert_at=RXPP_fortran_emit(insert_at,'fortran_bindings[__fortran_bind_pos] = 'fortran_bind_host[binding_index]'[__fortran_bind_i_'binding_index']')
              insert_at=RXPP_fortran_emit(insert_at,'__fortran_bind_pos = __fortran_bind_pos + 1')
              insert_at=RXPP_fortran_emit(insert_at,'__fortran_bind_i_'binding_index' = __fortran_bind_i_'binding_index' + 1')
              insert_at=RXPP_fortran_emit(insert_at,'end')
           end
        end
        if fortran_export_count > export_start then do
           if fortran_exports_declared=0 then do
              insert_at=RXPP_fortran_emit(insert_at,'fortran_exports = .string[]')
              fortran_exports_declared=1
           end
           insert_at=RXPP_fortran_emit(insert_at,'__fortran_export_pos = 1')
           do export_index=export_start+1 to fortran_export_count
              insert_at=RXPP_fortran_emit(insert_at,'fortran_exports[__fortran_export_pos] = 'safe_quote(fortran_export_target[export_index]))
              insert_at=RXPP_fortran_emit(insert_at,'__fortran_export_pos = __fortran_export_pos + 1')
           end
        end
        fortran_call_insert_at=insert_at
     end
  end
  else do
     say 'RXPP error: FORTRAN' block_kind 'requires END FORTRAN'
     exit 8
  end
return
/* ------------------------------------------------------------------
 * CMD_loadMacro: Register .rxpm names from an additional directory.
 * The package bodies remain lazy and are read by LoadExternalScriptMacro.
 * ------------------------------------------------------------------
 */
CMD_loadMacro: procedure
  arg line_no=.int,line=.string
  stype.line_no='X'
  path=normalisePath(syspath,word(line,2))
  if right(path,1) \= '/' then path=path'/'
  if verbose then say 'CRX0110I ['time('l')'] Macro Path  'path
  call registerScriptMacros path
return
/* ------------------------------------------------------------------
 * registerScriptMacros: Add names from PATH and remember their directory.
 * Existing names retain the earlier directory, which defines precedence.
 * ------------------------------------------------------------------
 */
registerScriptMacros: procedure
  arg path=.string
  call macroList path,'rxpm',scriptMacros,1
return

/* ------------------------------------------------------------------
 * CMD_external: Declare an explicit runtime module dependency.
 * Source-relative and absolute names are normalized before being written to
 * the manifest. The @runtime/ namespace is preserved so the crexx driver can
 * resolve it against the installed runtime bin directory.
 * ------------------------------------------------------------------
 */
CMD_external: procedure
  arg line_no=.int,line=.string
  stype.line_no='X'
  module=strip(word(line,2))
  if module='' then do
     call rxpp_diag 'error','RXPP_EXTERNAL_REQUIRES_MODULE'
     exit 8
  end
  runtimePrefix = translate(left(module,8))
  if runtimePrefix = '&SYSLIB/' then module=syslib'/'substr(module,9)
  else module=normalisePath(inpath,module)
  if pos('|'module'|',external_modules'|')=0 then external_modules=external_modules'|'module
return
/* ------------------------------------------------------------------
 * CMD_link: Declare a linked RXBIN output member for crexx.exe.
 * The directive is metadata only; the driver invokes rxlink after RXPP.
 * ------------------------------------------------------------------
 */
CMD_link: procedure
  arg line_no=.int,line=.string
  stype.line_no='X'
  member=strip(word(line,2))
  if member='' then do
    say 'RXPP error: ##LINK requires an output member name'
    exit 8
  end
  if words(line) <> 2 | member='.' | member='..' | pos('/',member)>0 | pos('\',member)>0 | pos(':',member)>0 | lower(right(member,6))='.rxbin' then do
    say 'RXPP error: ##LINK accepts only a member name, not a path:' member
    exit 8
  end
  if link_target \= '' then do
    say 'RXPP error: only one ##LINK directive is allowed'
    exit 8
  end
  link_target=member
return

/* ------------------------------------------------------------------
 * CMD_norun: Compile and assemble an RXPP member without starting rxvme.
 * ------------------------------------------------------------------
 */
CMD_norun: procedure
  arg line_no=.int,line=.string
  stype.line_no='X'
  if words(line) <> 1 then do
    say 'RXPP error: ##NORUN takes no arguments'
    exit 8
  end
  no_run=1
return
/* ------------------------------------------------------------------
 * Process ##DEFINE command
 * Parses a macro definition and registers the macro in the macro tables.
 * ------------------------------------------------------------------
 */
CMD_define: procedure=.int
   arg line_no=.int,line=.string
   nlino=line_no
   name    = ''
   arglist = ''
   body    = ''
   dspace=0
   mtype=upper(word(line,2))
   if mtype = 'FUNCTION' | mtype='FKT' then def = subword(line, 3)
   if mtype = 'COMMAND' | mtype='CMD' then do
      def = subword(line, 3)
      dspace=1
   end
   else def = subword(line, 2)
   wrd=word(def,1)
   ppi = pos('(', wrd,1)    ## must be in macro name, not in later macro body
   if ppi > 1 then do  /* Format: name(arg1, arg2) body */
      name    = strip(substr(def, 1, ppi - 1))
      ppi2    = pos(')', def,ppi+1)
      if ppi2 = 0 then do
         call rxpp_diag 'error','RXPP_MACRO_MISSING_RPAREN','definition',def
         exit 8
      end
      if ppi2 - ppi - 1<=0 then arglist=''
      else do
         arglist = strip(substr(def, ppi + 1, ppi2 - ppi - 1))
         if dspace=1 then arglist=ConcParms(arglist)
      end
      body= strip(substr(def, ppi2 + 1))
   end
   else do /* Format: name body (no arguments) */
      name = wrd
      body = subword(def, 2)
      arglist=''
   end

   if validateForwardingParams(arglist,name)
   then do
      call rxpp_diag 'error','RXPP_MACRO_FORWARDING_POSITION','macro',name,'arguments',arglist
      exit 8
   end

/* Remove braces and trim */
   body = strip(body)
   stype.nlino='D'
   do forever
      if body='' then leave
      nlen=length(body)
      if substr(body,nlen,1) \= '\' then leave
      nlino=nlino+1
      if nlino>source.0 then do
         call rxpp_diag 'error','RXPP_MACRO_UNCLOSED','name',name
         exit 8
      end
      nlen=nlen-1
      if nlen>1 then do
         /* Keep continued lines until expansion can decide whether they are
          * standalone script-macro calls. Ordinary macros are folded back
          * to semicolons by rxpp_split_cstyle_lines(). */
         body=strip(substr(body,1,nlen))||d2c(10)||strip(source.nlino)
      end
      else body=strip(source.nlino)
      stype.nlino='D'
   end
   opr=pos('{',body)
   lopr=lastpos('}',body)
   if lopr>0 then body=substr(body,opr+1,lopr-opr-1)
   body=changestr('; ;',body,';')
   body=strip(body)
   if substr(body,1,1)=';' then body=substr(body,2)
   body=strip(body)
   if body = '' | lopr=0 then do
      call rxpp_diag 'error','RXPP_MACRO_EMPTY_BODY','name',name
      exit 8
   end

 /* Register macro */
   name=strip(name)
   if dspace=1 then macro_name = upper(name)' '
   else macro_name = upper(name)'('

   macro_index = 0
   do scan_index=1 to macros_mname.0
      if macros_mname.scan_index = macro_name then do
         macro_index = scan_index
         leave
      end
   end

   if macro_index = 0 then macro_index = macros_mname.0 + 1

   macros_mname.macro_index = macro_name
   macros_margs.macro_index = strip(arglist)
   macros_mbody.macro_index = body
   macros_mspace.macro_index = dspace
return nlino
/* ------------------------------------------------------------------
 * Process ##MACRO command
 * Reads a Macro definition into a macro string
 * ------------------------------------------------------------------
 */
CMD_macro: procedure=.int
    arg line_no=.int, line=.string
    stype.line_no = 'D'
    macname = word(source.line_no,2)
    parms   = subword(source.line_no,3)
    if validateForwardingParams(parms,macname)
    then do
       call rxpp_diag 'error','RXPP_MACRO_FORWARDING_POSITION','macro',macname,'arguments',parms
       exit 8
    end
    body = ''
    i=.int
    do i=line_no+1 to source.0
       line = strip(source.i)
       stype.i = 'D'
       if upper(word(line,1)) = '##MEND' then leave
       body = body || line || '; '
    end
    call StoreScriptMacro macname, parms, body
    macname = '##'lower(strip(macname,,'#'))
    scriptMacros[scriptMacros[0]+1] = macname
return i
/* ----------------------------------------------------------------------
 * StoreScriptMacro
 *
 * Register a script macro in the canonical internal representation.
 *
 * Both internally defined and externally loaded script macros must pass
 * through this routine so that they are stored identically.
 *
 * macname:
 *     canonical macro name including the ## prefix
 *
 * parms:
 *     parameter definition as found on the ##MACRO statement
 *
 * body:
 *     macro body without ##MACRO / ##MEND
 * ----------------------------------------------------------------------
 */
StoreScriptMacro: procedure=.void
    arg macname=.string, mparms=.string, body=.string
    macname = '##'lower(strip(macname,,'#'))
    mparms = strip(mparms)
    mparms = translate(mparms,,',')
    body = qstripcomment('/*','*/',body)
    scriptMacro.macname       = body
    scriptMacro.macname.parms = mparms
    scriptMacro.macname.calls = 0
return

/* ----------------------------------------------------------------------
 * validateForwardingParams
 *
 * A named forwarding parameter is written as terminal ...name. Bare ...
 * retains the historical repeat-body meaning.
 * ----------------------------------------------------------------------
 */
validateForwardingParams: procedure=.int
    arg parms=.string,macname=.string
    formal=.string
    count=.int
    forwarding=.int
    parm=.string
    formal=translate(strip(parms),,' ,')
    count=words(formal)
    forwarding=0
    do forward_param_index=1 to count
       parm=word(formal,forward_param_index)
       if left(parm,3) \= '...' | parm='...' then iterate
       if parm='...' then iterate
       if forwarding=1 | forward_param_index \= count then return 1
       forwarding=1
    end
return 0

/* ----------------------------------------------------------------------
 * LoadExternalScriptMacro
 *
 * Load a script macro from the selected macro-library directory first,
 * followed by <syspath>/<macro-name>.rxpm, and store it in
 * scriptMacro. using the same representation as an internal ##MACRO.
 *
 * MACNAME is the canonical macro key and may include the ## prefix.
 *
 * Returns:
 *   0  macro loaded
 *   1  macro file missing / load failed
 * ----------------------------------------------------------------------
 */
LoadExternalScriptMacro: procedure=.int
    arg macname=.string
    file_macname = macname
    body=.string
    if substr(file_macname,1,2) = '##' then file_macname = substr(file_macname,3)
    macro_path = scriptMacroPath.macname
    if macro_path = '' then macro_path = macpath
    macro_file = macro_path || file_macname || '.rxpm'
    if verbose then say 'CRX0171I Script macro 'macname' selected from 'macro_file
    stream = loadtext(macro_file, ';', 'noRaise')
    if pos('-8 OPEN ERROR',stream) > 0 then do
        if macro_path = macpath & syspath \= macpath then do
            macro_file = syspath || file_macname || '.rxpm'
            stream = loadtext(macro_file, ';', 'noRaise')
        end
        if pos('-8 OPEN ERROR',stream) > 0 then do
            scriptMacro.macname.error = 'error'
            scriptMacro.macname.file = macro_file
            call rxpp_diag('warning', 'RXPP_SCRIPT_MACRO_MISSING', 'file', macro_file)
            return 1
        end
    end
    /*
     * First record:
     *
     *     ##MACRO name parms...
     */
    sep = pos(';',stream)
    if sep > 0 then do
        header = strip(substr(stream,1,sep-1))
        body   = substr(stream,sep+1)
        scriptMacro.macname.parms = subword(header,3)
        scriptMacro.macname.parms = translate(scriptMacro.macname.parms,,',')
    end
    else do
        body = stream
        scriptMacro.macname.parms = ''
    end
    /*
     * External files contain the terminating ##MEND; internal macros
     * do not store it.
     */
    mend = pos('##MEND',upper(body))
    if mend > 0 then body = substr(body,1,mend-1)
    body = qstripcomment('/*','*/',body)

    scriptMacro.macname       = body
    scriptMacro.macname.calls = 0
return 0

/* ------------------------------------------------------------------
 * Concatenate all parameters into a comma-separated list.
 * ------------------------------------------------------------------
 */
ConcParms: Procedure=.string
   arg inparm=.string
   sargs=''
   do i=1 to qwords(inparm)
      parm=qword(inparm,i)
      if sargs='' then sargs=parm
      else sargs=sargs','parm
   end
return sargs
/* ------------------------------------------------------------------
 * isCommandKeyword: Tests whether a command-style argument token names a
 * keyword declared by the macro. Accept bare, key=value, and key(value)
 * spellings so the caller can distinguish a new bare keyword from its value.
 * ------------------------------------------------------------------
 */
isCommandKeyword: procedure=.int
   arg token=.string,parmdef=.string
   candidate=token
   equal_pos=pos('=',candidate)
   paren_pos=pos('(',candidate)
   if equal_pos>0 then candidate=substr(candidate,1,equal_pos-1)
   else if paren_pos>1 then candidate=substr(candidate,1,paren_pos-1)
   if candidate='' then return 0

   deftext=changestr(',',parmdef,' ')
   do i=1 to qwords(deftext)
      declaration=qword(deftext,i)
      equal_pos=pos('=',declaration)
      if equal_pos=0 then iterate
      if upper(candidate)=upper(substr(declaration,1,equal_pos-1)) then return 1
   end
return 0
/* ------------------------------------------------------------------
 * normalizeCommandKeywords: Rewrites a declared bare keyword followed by
 * one quote-aware value token into key=value before normal argument parsing.
 * ------------------------------------------------------------------
 */
normalizeCommandKeywords: procedure=.string
   arg argtext=.string,parmdef=.string
   deftext=changestr(',',parmdef,' ')
   positional_count=0
   saw_keyword=0
   do definition_index=1 to qwords(deftext)
      declaration=qword(deftext,definition_index)
      if pos('=',declaration)>0 then saw_keyword=1
      else if saw_keyword=0 then positional_count=positional_count+1
   end

   result=''
   argc=qwords(argtext)
   i=1
   do while i<=argc
      token=qword(argtext,i)
      if i>positional_count & isCommandKeyword(token,parmdef) then do
         /* Already-supported key=value and key(value) forms pass unchanged. */
         if pos('=',token)=0 & pos('(',token)=0 then do
            if i<argc then do
               next_token=qword(argtext,i+1)
               if isCommandKeyword(next_token,parmdef)=0 then do
                  token=token'='next_token
                  i=i+1
               end
            end
         end
      end
      if result='' then result=token
      else result=result' 'token
      i=i+1
   end
return result
/* ------------------------------------------------------------------
 * Formats pre-compiler statements/macros into annotated comment lines for traceability.
 * ------------------------------------------------------------------
 */
printGen: procedure=.string
  arg line=.string, type=.int
  if printgen_flags='none' then return '' ## suppress all macro call definitions
  if type=1 then return '/* 'line' D*/'   ## DEFINE clause
  if type=2 then return '/* 'line' I*/'   ## INCLUDE clause
  if type=3 then return '/* 'line' S*/'   ## SET clause
  if type=4 then return '/* 'line' IF*/'  ## IF clause
  if type=5 then return '/* 'line' AR*/'  ## Array clause
  if type=6 then return '/* 'line' GL*/'  ## Global clause
  if type=7 then return '/* 'line' SC*/'  ## Sections
  else return '/* rxpp: 'line' */'        ## Macro call
return '/* rxpp: 'line' U*/'
/* ------------------------------------------------------------------
 * Source-map helpers: keep RXPP marker emission and escaping in one place.
 * The compiler consumes the raw @ channel after seeing "options ... srcmap".
 *
 * RXPP edits source[] in place: it inserts generated header lines, includes
 * files, and injects expansion output.  Keep source_origin_*[] in lockstep with
 * source[] so Peter can trace each emitted line back to the source file/line
 * that caused it.  For generated helper lines, the origin is normally copied
 * from the directive or macro call that caused the insertion.
 * ------------------------------------------------------------------
 */
rxpp_set_source_origin: procedure
  arg line_no=.int,file=.string,source_line=.int,line_text=.string
  source_origin_file[line_no]=file
  source_origin_line[line_no]=source_line''
  source_origin_text[line_no]=line_text
return

rxpp_clear_source_origin: procedure
  arg line_no=.int
  source_origin_file[line_no]=''
  source_origin_line[line_no]='0'
  source_origin_text[line_no]=''
return

rxpp_copy_source_origin: procedure
  arg line_no=.int,from_line=.int
  if from_line>0 & source_origin_line[from_line]>0 then do
     source_origin_file[line_no]=source_origin_file[from_line]
     source_origin_line[line_no]=source_origin_line[from_line]
     source_origin_text[line_no]=source_origin_text[from_line]
  end
  else call rxpp_clear_source_origin line_no
return

rxpp_set_source_origin_range: procedure
  arg first_line=.int,line_count=.int,file=.string,first_source_line=.int
  do offset=0 to line_count-1
     line_no=first_line+offset
     call rxpp_set_source_origin line_no,file,first_source_line+offset,source[line_no]
  end
return

rxpp_input_has_srcmap_options: procedure=.int
  do line_no=1 to source.0
     line=lower(strip(source[line_no]))
     if word(line,1)\='options' then iterate
     do option_no=2 to words(line)
        if word(line,option_no)='srcmap' then return 1
     end
  end
return 0

rxpp_cflag_present: procedure=.int
  arg flag=.string
  flag=lower(strip(flag))
  do flag_no=1 to words(cflags)
     if word(cflags,flag_no)=flag then return 1
  end
return 0

/* Emit a structured, compile-time-only event for ##CFLAG flow.  Keep the
 * fields deliberately simple so the output remains useful to both humans and
 * small diagnostic scripts. */
rxpp_flow: procedure
  arg phase=.string,action=.string,line_no=.int,detail=.string
  if rxpp_cflag_present('flow')=0 then return
  origin=''
  origin_line=''
  if line_no>0 then do
     origin=source_origin_file[line_no]
     origin_line=source_origin_line[line_no]
  end
  say '++RXPP-FLOW phase='||phase||' action='||action||' line='||line_no||' origin='||origin||':'||origin_line||' detail='||detail
return

/* Print a compact end-of-run summary.  Diagnostics are intentionally emitted
 * after the generated file has been written and never enter outbuf[]. */
rxpp_stats_report: procedure
  say '++RXPP-STATS input_lines='||rxpp_stats_pass1_lines||' pass2_links='||rxpp_stats_pass2_links||' output_lines='||outbuf.0
  say '++RXPP-STATS directives='||rxpp_stats_directives||' includes='||rxpp_stats_includes||' include_duplicates='||rxpp_stats_include_duplicates
  say '++RXPP-STATS macros_defined='||macros_mname.0||' source_macro_expansions='||mexpanded||' script_macro_expansions='||scriptMacroCounter||' suppressed='||rxpp_stats_suppressed
return

/* Embedded free-form text is literal by default.  BLOCKMACROS opts in to
 * normal command-macro expansion and the subsequent scripted-macro facade
 * expansion while a block collector is reading its lines.  The negative form
 * is useful when a shared flag list enables the feature globally. */
rxpp_block_macros_enabled: procedure=.int
  if rxpp_cflag_present('nblockmacros') then return 0
  if rxpp_cflag_present('blockmacros') then return 1
return 0

/* Expand one line in a free-form collector.  Return 1 when a scripted macro
 * inserted replacement source lines and the caller must iterate so those
 * lines are collected in source order. */
rxpp_expand_block_line: procedure=.int expose source stype
  arg line_no=.int
  if rxpp_block_macros_enabled()=0 then return 0
  line=expandLine(source.line_no,line_no)
  macname=rxpp_script_macro_name(line)
  if macname<>'' then do
     line=newMacros(macname,line,line_no,1,1)
     return 1
  end
  source.line_no=line
return 0

rxpp_srcmap_enabled: procedure=.int
  if rxpp_cflag_present('nosrcmap') | rxpp_cflag_present('no-srcmap') then return 0
return 1

rxpp_srcmap_marker: procedure=.string
return '!RXPP_SRCMAP_AT!'

rxpp_srcmap_quote: procedure=.string
  arg text=.string
  text=changestr('@',text,'@@')
  text=changestr('"',text,'""')
return '"'text'"'

rxpp_srcmap_escape: procedure=.string
  arg text=.string
  marker=rxpp_srcmap_marker()
  text=changestr('@',text,'@@')
  text=changestr(marker,text,'@')
return text

rxpp_srcmap_file_hint: procedure=.string
  arg file=.string
return '@'rxpp_srcmap_quote(file)

rxpp_srcmap_line_hint: procedure=.string
  arg line_no=.int,line_text=.string
  if line_no<=0 then return ''
return '@'line_no'l'rxpp_srcmap_quote(line_text)

rxpp_srcmap_source_line: procedure=.int
  arg line_no=.int
  if line_no>0 & source_origin_line[line_no]>0 then return source_origin_line[line_no]
  if line_no<=srcmap_line_offset then return 0
return line_no-srcmap_line_offset

rxpp_srcmap_source_file: procedure=.string
  arg line_no=.int
  if line_no>0 & source_origin_file[line_no]\='' then return source_origin_file[line_no]
return srcmap_source_file

rxpp_srcmap_source_text: procedure=.string
  arg line_no=.int
  if line_no>0 & source_origin_text[line_no]\='' then return source_origin_text[line_no]
return source[line_no]

rxpp_srcmap_span: procedure=.string
  arg source_col=.int,source_len=.int,text=.string
  marker=rxpp_srcmap_marker()
  if source_col<1 then source_col=1
  if source_len<1 then source_len=length(text)
return marker||source_col||'+'||source_len||'{'||text||marker||'}'

rxpp_srcmap_argument_value: procedure=.string
  arg value=.string,relative_col=.int,source_base=.int
  if \rxpp_srcmap_enabled() then return value
  if relative_col<=0 then return value
  if length(value)<1 then return value
return rxpp_srcmap_span(source_base+relative_col,length(value),value)
/* ------------------------------------------------------------------
 * Diagnostic helpers.
 *
 * Pattern for new RXPP warnings/errors:
 *   1. Add one stable RXPP_* key to messages/diagnostics.*.msg.
 *   2. Emit it with rxpp_diag and named parameters.
 *   3. Do not format English text at the call site.
 *
 * Keeping the rendering here lets RXPP share rxc's message catalog files and
 * environment contract while remaining a Level B tool.  The call sites stay
 * small and repeatable for future preprocessor diagnostics.
 * ------------------------------------------------------------------
 */
rxpp_diag: procedure
  arg severity=.string,code=.string,name1='',value1='',name2='',value2='',name3='',value3=''
  say rxpp_diag_text(code,name1,value1,name2,value2,name3,value3)
return

rxpp_diag_text: procedure=.string
  arg code=.string,name1='',value1='',name2='',value2='',name3='',value3=''
  names=.string[]
  values=.string[]
  if name1\='' then do
     names[names[0]+1]=name1
     values[values[0]+1]=value1''
  end
  if name2\='' then do
     names[names[0]+1]=name2
     values[values[0]+1]=value2''
  end
  if name3\='' then do
     names[names[0]+1]=name3
     values[values[0]+1]=value3''
  end
return rxpp_diag_render(code,names,values)

rxpp_diag_render: procedure=.string
  arg code=.string,names=.string[],values=.string[]
  if rxpp_diag_mode()='raw' then return rxpp_diag_render_raw(code,names,values)

  locale=rxpp_diag_effective_locale()
  template=rxpp_diag_cat_lookup(locale,code)
  if template='' & locale\='en_GB' then template=rxpp_diag_cat_lookup('en_GB',code)
  if template='' then return rxpp_diag_render_raw(code,names,values)
return rxpp_diag_render_template(code,template,names,values)

rxpp_diag_mode: procedure=.string
  mode=lower(strip(getenv('CREXX_DIAGNOSTICS')))
  if mode='raw' | mode='machine' | mode='code' then return 'raw'
  if mode='localized' | mode='localised' | mode='text' then return 'localized'
return 'localized'

rxpp_diag_effective_locale: procedure=.string
  locale=strip(getenv('CREXX_DIAGNOSTIC_LOCALE'))
  if locale='' then locale=strip(getenv('LC_ALL'))
  if locale='' then locale=strip(getenv('LC_MESSAGES'))
  if locale='' then locale=strip(getenv('LANG'))
return rxpp_diag_normalize_locale(locale)

rxpp_diag_normalize_locale: procedure=.string
  arg locale=.string
  locale=strip(locale)
  if locale='' then return 'en_GB'
  if upper(locale)='C' | upper(locale)='POSIX' then return 'en_GB'

  dot=pos('.',locale)
  if dot>0 then locale=left(locale,dot-1)
  at=pos('@',locale)
  if at>0 then locale=left(locale,at-1)
  locale=changestr('-',locale,'_')

  if length(locale)=2 then return lower(locale)
  if length(locale)>=5 & substr(locale,3,1)='_' then do
     return lower(substr(locale,1,2))'_'upper(substr(locale,4,2))||substr(locale,6)
  end
  if locale='' then return 'en_GB'
return locale

rxpp_diag_render_template: procedure=.string
  arg code=.string,template=.string,names=.string[],values=.string[]
  rendered=code': '
  cursor=1
  do forever
     open=pos('{',template,cursor)
     if open=0 then do
        rendered=rendered||substr(template,cursor)
        leave
     end
     rendered=rendered||substr(template,cursor,open-cursor)
     close=pos('}',template,open+1)
     if close=0 then do
        rendered=rendered||substr(template,open)
        leave
     end
     pname=substr(template,open+1,close-open-1)
     found=0
     pvalue=''
     do i=1 to names[0]
        if names[i]=pname then do
           found=1
           pvalue=values[i]
           leave
        end
     end
     if found then rendered=rendered||rxpp_diag_escape(pvalue)
     else rendered=rendered||substr(template,open,close-open+1)
     cursor=close+1
  end
return rendered

rxpp_diag_render_raw: procedure=.string
  arg code=.string,names=.string[],values=.string[]
  rendered=code
  do i=1 to names[0]
     rendered=rendered' 'names[i]'="'rxpp_diag_escape(values[i])'"'
  end
return rendered

rxpp_diag_escape: procedure=.string
  arg text=.string
  text=changestr('\',text,'\\')
  text=changestr('"',text,'\"')
  text=changestr('09'x,text,'\t')
  text=changestr('0d'x,text,'\r')
  text=changestr('0a'x,text,'\n')
return text

rxpp_diag_cat_lookup: procedure=.string
  arg locale=.string,code=.string
  template=rxpp_diag_env_lookup(locale,code)
  if template\='' then return template

  template=rxpp_diag_dir_lookup('messages',locale,code)
  if template\='' then return template
  template=rxpp_diag_dir_lookup('../messages',locale,code)
  if template\='' then return template
  template=rxpp_diag_dir_lookup('../../messages',locale,code)
  if template\='' then return template

  if syspath\='' then do
     template=rxpp_diag_dir_lookup(syspath'/messages',locale,code)
     if template\='' then return template
     template=rxpp_diag_dir_lookup(syspath'/../messages',locale,code)
     if template\='' then return template
     template=rxpp_diag_dir_lookup(syspath'/../share/crexx/messages',locale,code)
     if template\='' then return template
  end
return ''

rxpp_diag_env_lookup: procedure=.string
  arg locale=.string,code=.string
  pathlist=strip(getenv('CREXX_MESSAGE_PATH'))
  if pathlist='' then return ''

  first=pathlist
  semi=pos(';',first)
  if semi>0 then first=left(first,semi-1)
  template=rxpp_diag_dir_lookup(strip(first),locale,code)
  if template\='' then return template

  rest=pathlist
  do while rest\=''
     semi=pos(';',rest)
     if semi=0 then do
        part=strip(rest)
        rest=''
     end
     else do
        part=strip(left(rest,semi-1))
        rest=substr(rest,semi+1)
     end
     template=rxpp_diag_dir_lookup(part,locale,code)
     if template\='' then return template
  end
return ''

rxpp_diag_dir_lookup: procedure=.string
  arg directory=.string,locale=.string,code=.string
  if directory='' then return ''
  if right(directory,1)='/' | right(directory,1)='\' then path=directory'diagnostics.'locale'.msg'
  else path=directory'/diagnostics.'locale'.msg'
return rxpp_diag_file_lookup(path,code)

rxpp_diag_file_lookup: procedure=.string
  arg path=.string,code=.string
  catalog=readLines(path,,,'noRaise')
  if catalog[0]=1 & word(catalog[1],1)='-8' then return ''
  do i=1 to catalog[0]
     line=strip(catalog[i])
     if line='' then iterate
     if left(line,1)='#' then iterate
     equals=pos('=',line)
     if equals=0 then iterate
     key=strip(left(line,equals-1))
     if key=code then return strip(substr(line,equals+1))
  end
return ''
/* ------------------------------------------------------------------
 * Implements ##SET: assigns a pre-compiler variable and updates internal flags if needed.
 * ------------------------------------------------------------------
 */
CMD_set: procedure
  arg line_no=.int,incl=.string
  stype.line_no= 'S'
  varn=word(incl,2)
  vind=setvar(varn,DropComment(subword(incl,3)))
  if varn='cflags' then cflags=word(lower(macros_varvalue.vind),1) ## set cflags additionally directly will be used often
return

/* ------------------------------------------------------------------
 * Removes trailing line (##) or block (/*..*/) comments from a value.
 * ------------------------------------------------------------------
 */
dropComment: procedure=.string
  arg varvalue=.string,from=1
  fp1=pos('##',varvalue,from)
  if fp1>1 then varvalue=substr(varvalue,1,fp1-1)
  fp1=pos('/*',varvalue,from)
  if fp1>1 then varvalue=substr(varvalue,1,fp1-1)
return strip(varvalue)
/* ------------------------------------------------------------------
 * CMD_unset: Implements ##UNSET: clears a pre-compiler variable (with exemptions for protected vars).
 * ------------------------------------------------------------------
 */
CMD_unset: procedure
  arg line_no=.int,incl=.string
  stype.line_no= 'S'
  varn=word(incl,2)
  varn=lower(varn)
  if varn='printgen'  then return
  if varn='rxpp_rexx' then return
  if varn='rxpp_date' then return
  i=findvar(varn)
  if i=0 then return
  removed=macros_varname.0
  do shift=i to macros_varname.0-1
     macros_varname[shift]=macros_varname[shift+1]
     macros_varvalue[shift]=macros_varvalue[shift+1]
  end
  macros_varname[removed]=''
  macros_varvalue[removed]=''
return
/* ------------------------------------------------------------------
 * rxpp_condition_eval: Evaluates the small compile-time condition language.
 * Bare names test existence; == and != compare stored string values exactly.
 * ------------------------------------------------------------------
 */
rxpp_condition_eval: procedure=.int
  arg condition=.string
  condition=strip(condition)
  op=pos('==',condition)
  operator='=='
  if op=0 then do
     op=pos('!=',condition)
     operator='!='
  end
  if op=0 then do
     if condition='' then return 0
     return findvar(condition)>0
  end
  name=strip(left(condition,op-1))
  expected=strip(substr(condition,op+2))
  if length(expected)>=2 then do
     first=left(expected,1)
     last=right(expected,1)
     if (first='"' & last='"') | (first="'" & last="'") then expected=substr(expected,2,length(expected)-2)
  end
  defined=findvar(name)>0
  actual=''
  if defined then actual=getvar(name)
  if operator='==' then return defined & actual=expected
return \defined | actual\=expected

/* ------------------------------------------------------------------
 * CMD_assert: Validates compile-time RXPP variables.  Bare names test
 * existence; == and != compare the stored string value exactly.
 * ------------------------------------------------------------------
 */
CMD_assert: procedure
  arg line_no=.int,incl=.string
  rest=.string
  comma=.int
  assert_condition=.string
  assert_message=.string
  first=.string
  last=.string
  result=.int
  stype.line_no='X'
  rest=strip(substr(incl,9))
  comma=pos(',',rest)
  if comma>0 then do
     assert_condition=strip(left(rest,comma-1))
     assert_message=strip(substr(rest,comma+1))
  end
  else do
     assert_condition=rest
     assert_message=assert_condition
  end
  if length(assert_message)>=2 then do
     first=left(assert_message,1)
     last=right(assert_message,1)
     if (first='"' & last='"') | (first="'" & last="'") then assert_message=substr(assert_message,2,length(assert_message)-2)
  end

  result=rxpp_condition_eval(assert_condition)
  if result=0 then do
     call rxpp_diag 'error','RXPP_ASSERT_FAILED','condition',assert_condition,'message',assert_message
     exit 8
  end
return
/* ------------------------------------------------------------------
 * CMD_include: Implements ##INCLUDE / ##USE: reads and inserts the included file into the source buffer.
 * ------------------------------------------------------------------
 */
CMD_include: procedure
  arg line_no=.int,incl=.string,mode=.int
  stype.line_no= 'I'
  rxpp_stats_includes=rxpp_stats_includes+1
  requested_file=word(incl,2)
  file=requested_file
  include_kind='INCLUDE'
  if mode=2 then include_kind='USE'
  rc=.int
  insertat=.int
  file=normalisepath(inpath,file)
  if rxpp_cflag_present('includetrace') then do
     say '++RXPP-DIAG includetrace line='line_no ' 'include_kind ' requested='requested_file ' resolved='file
  end
  include=.string[]
  /* new=readall(include,file,-1) */
  include=readLines(file,,,'noRaise')
  new=include[0]
  if new=1 & word(include[1],1)='-8' then do
     call rxpp_diag 'error','RXPP_INCLUDE_MISSING','file',file
     call rxpp_diag 'error','RXPP_TERMINATED'
     exit 8
  end
  if push_unique(included_files,file)=0 then do
     rxpp_stats_include_duplicates=rxpp_stats_include_duplicates+1
     call rxpp_flow 'pass1','include_duplicate',line_no,file
     if rxpp_cflag_present('includetrace') then say '++RXPP-DIAG includetrace duplicate='file
     return      /* already part of the included list */
  end
  call rxpp_flow 'pass1','include',line_no,include_kind ' 'file
  if mode=1 then do
     rc= insert_source(line_no+1,new)
     insertat=line_no
  end
  else do
     linc=source.0
     rc= insert_source(linc+1,new)
     insertat=linc
  end
  do j=1 to new
     insertat=insertat+1
     source.insertat=include.j
     call rxpp_set_source_origin insertat,file,j,include.j
  end
return
/* ------------------------------------------------------------------
 * CMD_emit: emit the contents of a named section queue.
 * ------------------------------------------------------------------
 */
CMD_emit: procedure
    arg line_no=.int, incl=.string
/* ##EMIT section_name is the call to emit the contents of the named section queue.*/
    section_name = word(incl, 2) /* section_name is 2. word, it is actually a queue name */

    if rxqueue("SET", section_name) > 0 then return   /* if section does not exist return. */

    new = queued()          /* get the number of lines in the queue */
    if new = 0 then return  /* nothing to emit */

    call insert_source line_no + 1, new /* insert empty lines into the source buffer */

    do i = 1 to new
       insertat = line_no + i
       source.insertat = peek(i)
       call rxpp_set_source_origin insertat, file, i, source.insertat
    end

return
/* ------------------------------------------------------------------
 * CMD_copyBlock
 * ------------------------------------------------------------------
 */
CMD_copyBlock: procedure=.int
  arg line_no=.int,name=.string
  stype.line_no= 'I'
  bname=upper(word(name,2))

  i=.int
  found=0
  do i=1 to beginName[0]
     if bname \= word(beginName[i],1) then iterate
     found=1
     leave
  end
  if found=0 then return 4
  from=word(beginName[i],2)
  if datatype(from) \= 'NUM' then return 4
  newlines=word(beginName[i],3)
  if datatype(newlines) \= 'NUM' then return 4
  rc=.int
  insertat=.int
  rc= insert_source(line_no+1,newlines)
  insertat=line_no

  do i=0 to newlines-1
     insertat=insertat+1
     source.insertat=beginblock[from+i]
   end
return 0
/* ------------------------------------------------------------------
 * CMD_array: Implements ##ARRAY: expands array declarations into initialization statements.
 * ------------------------------------------------------------------
 */
CMD_array: procedure
   arg line_no=.int,line=.string
   stype.line_no= 'ARRAY'
   line=translate(line,,',')
   line=DropComment(line,3)
   atype=word(line,2)
   if substr(atype,1,1)\='.' then atype='.'atype
   defs=subword(line,3)
   new=words(defs)                       ## check how many arrays have been defined
   if new=0 then return
   rc= insert_source(line_no+1,new)    ## insert new lines, shift buffer
   do i=1 to new                         ## now add the statements
      def=word(defs,i)
      source[lino+i]=def'='atype'[];'
   end
return
/* ------------------------------------------------------------------
 * CMD_global: Implements ##GLOBAL: expands globals and accumulates namespace exposure list.
 * ------------------------------------------------------------------
 */
CMD_global: procedure
   arg line_no=.int,line=.string
   stype.line_no= 'GLOBAL'
   line=translate(line,,',')
   line=DropComment(line,3)
   atype=upper(word(line,2))
   if substr(atype,1,1)='.' then atype=substr(atype,2)
   if atype='INT' | atype='FLOAT' | atype='STRING' | atype='INT[]' | atype='FLOAT[]' | atype='STRING[]'then nop
   else return
   defs=subword(line,3)
   new=words(defs)                       ## check how many arrays have been defined
   if new=0 then return
   rc= insert_source(line_no+1,new)    ## insert new lines, shift buffer
   do i=1 to new                         ## now add the statements
      def=word(defs,i)
      vtemp=translate(def,,'=')
      ivar=word(vtemp,1)
      ival=word(vtemp,2)
      if ival='' then source[lino+i]=ivar'=.'atype
      else source[lino+i]=ivar'=.'atype'; 'def
      globaldef=globaldef' 'ivar
   end
return
/* ------------------------------------------------------------------
 * CMD_dalias: Implements ##data aliases
 * ------------------------------------------------------------------
 */
CMD_dalias: procedure
   arg line_no=.int,line=.string
   stype.line_no= 'D'
   line=translate(line,,',')
   line=DropComment(line,3)

   alias_count=0
   do i=2 to words(line)
      alias=upper(word(line,i))
      if left(alias,2)='##' then alias=substr(alias,3)

      if alias='' then do
         say 'RXPP error: empty DALIAS name at line' line_no
         exit 8
      end
      if verify(left(alias,1),'ABCDEFGHIJKLMNOPQRSTUVWXYZ_','N') \= 0 then do
         say 'RXPP error: invalid DALIAS name' alias '- expected an identifier'
         exit 8
      end
      if verify(alias,'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_','N') \= 0 then do
         say 'RXPP error: invalid DALIAS name' alias '- expected an identifier'
         exit 8
      end

      reserved = ' ADDRESS ARG BY CALL DO ELSE END EXIT IF IMPORT INTERPRET ITERATE LEAVE NOP NUMERIC OPTIONS OTHERWISE PARSE PROCEDURE PULL PUSH RETURN SAY SELECT SIGNAL THEN TRACE WHEN WHILE '
      rxpp_reserved = ' ARRAY ASSERT BUILDDIR CFLAG COPYBLOCK DALIAS DATA DEFINE ELSE EMIT END EXTERNAL FOR FORTRAN GLOBAL IF IFN INCLUDE INPUT LIBRARY LINK LOADMACRO MACRO NORUN PROGRAM REXXSCRIPT RULE RXBUILD SET SYS USE UNSET '
      if pos(' 'alias' ',reserved)>0 | pos(' 'alias' ',rxpp_reserved)>0 then do
         say 'RXPP error: invalid DALIAS name' alias '- reserved keyword'
         exit 8
      end

      if pos('<##'alias'>',dalias)>0 | pos('<'alias'>',dalias)>0 then do
         say 'RXPP error: duplicate DALIAS name' alias
         exit 8
      end

      dalias= dalias '<##'alias'>'
      dalias= dalias '<'alias'>'
      alias_count=alias_count+1
   end
   if alias_count=0 then do
      say 'RXPP error: ##DALIAS requires at least one alias name'
      exit 8
   end
return
/* ------------------------------------------------------------------
 * Load macro names from PATH, Content will loaded if used
 * ------------------------------------------------------------------
 */
macroList: procedure
  arg dir= .string, extension=.string, expose macros=.string[], append=.int
  if append \= 1 then macros=.string[]
  lowalpha='abcdefghijklmnopqrstuvwxyz_0123456789'
  dir=translate(dir,'/','\')
  out=.string[]
  err=.string[]
 ## 'ls 'dir'*.'extension output out error err
 'ls 'dir output out error err
  if out.0 < 1 then return

  do i = 1 to out.0
     file = strip(out[i])
     if file = '' then iterate
   /* Find final extension separator. */
     dot = lastpos('.', file)
     if dot = 0 then iterate
   /* Extract and validate extension. */
     ext = lower(strip(substr(file, dot + 1)))
     if ext \= extension then iterate
   /* Extract filename without directory and extension. */
     slash = max(lastpos('/', file), lastpos('\', file))
     mname = substr(file, slash + 1, dot - slash - 1)
     if mname = '' then iterate
   /* Accept only names consisting of characters in LOWALPHA.
     * TRANSLATE removes the permitted characters; anything left
     * makes the name invalid.
     */
     if strip(translate(mname, , lowalpha)) \= '' then iterate
     candidate = '##'mname
     duplicate = 0
     do existing = 1 to macros[0]
        if macros[existing] = candidate then do
           duplicate = 1
           leave
        end
     end
     /* Later search roots override earlier roots. */
     scriptMacroPath.candidate = dir
     if verbose then say 'CRX0170I Script macro 'candidate' registered from 'dir
     if duplicate = 0 then macros[macros[0] + 1] = candidate
  end
return
