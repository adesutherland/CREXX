##
## return nlino
/* ------------------------------------------------------------------
 * CMD_for: Expands a FOR pseudo-construct into an equivalent REXX looping sequence.
 * ------------------------------------------------------------------
 */
CMD_for: procedure
  arg line_no=.int,line=.string
  line=subword(line,2)
  stype.line_no= 'FOR'
  nlino=line_no+1
  line=qstripcomment('/*','*/',line)
  parts=qsplit(line,';')
  from=parts.1
  condc=parts.2
  step=parts.3
  fromx=qsplit(from,',')
  start=''
  do i=1 to fromx.0
     start=start||fromx.i';'
  end
  stepx=qsplit(step,',')
  update=''
  do i=.int(1) to stepx.0
     update=update||stepx.i';'
  end

  call insert_source nlino,6         ## insert new lines, shift buffer

  select_count=select_count+1
  source[line_no+1]='__first_'select_count'=1'
  source[lino+2]=start
  source[lino+3]='do forever'
  source[lino+4]='   if __first_'select_count'=1 then __first_'select_count'=0'
  source[lino+5]='   else do; 'update'; end'
  source[lino+6]='   if 'condc' then nop; else leave'
  do i=.int(1) to 6
     stype[nlino+i]=' '
  end
return
/* ------------------------------------------------------------------
 * CMD_data: Implements ##DATA blocks: converts lines into array assignments
 * until ##END, then optionally calls a callback with the array name.
 * ------------------------------------------------------------------
 */
CMD_data: procedure
  arg line_no=.int,line=.string,array=''
  stype.line_no= 'D'
  onto=.string
  callback=.string
  line=qstripcomment('/*','*/',line)   /* remove comments */
  wi=wordindex(line,2)
  qpi=qpos('##',line,wi)   /* remove end of line comment, must start after 2. word */
  if qpi=0 then qpi=qpos('--',line,wi)
  if qpi>1 then line=substr(line,1,qpi-1)
  if array='' then do
     array=word(line,2)
     onto= word(line,3)
     callback= word(line,4)
  end
  else do
     onto= word(line,2)
     callback= word(line,3)
  end

  if onto \='' & callback ='' then callback=onto
  j=0
  i = .int
  do i=line_no+1 to source.0
     line=source.i
     if upper(word(line,1))='##END' then leave
     if rxpp_expand_block_line(i) then iterate
     line=source.i
     j=j+1
     source.i=array'.'j'='safe_quote(line)
     stype.i='noexp'
  end
  if callback = '' then stype.i='D'   ## set D for ##END
  else do
     /* Replace the suppressed ##END with a call after all array entries. */
     source.i='call 'callback' 'array
     stype.i=' '
  end
return

/* ------------------------------------------------------------------
 * CMD_data_alias: Implements ##DATA blocks: converts lines into array assignments
 * until ##END, then optionally calls a callback with the array name.
 * ------------------------------------------------------------------
 */
/*
 * Collect a named data block.
 *
 * Supported forms:
 *
 *     ##PYTHON program
 *       print("Hello")
 *     ##END PYTHON
 *
 *     PYTHON program pythonRule
 *       print("Hello")
 *     END PYTHON
 *
 * The first word identifies the registered data alias.
 * The second word names the receiving array.
 * The optional third word names a callback procedure.
 */
CMD_data_alias: procedure
  arg line_no=.int,line=.string
  /*
   * Mark the opening line as an RXPP data directive.
   */
  stype.line_no = 'D'

  /*
   * Remove comments from the opening directive before
   * interpreting its parameters.
   */
  line = qstripcomment('/*','*/',line)
  directive_form = left(strip(line),2)

  wi = wordindex(line,2)
  if wi>0 then do
     qpi = qpos('##',line,wi)
     if qpi = 0 then qpi = qpos('--',line,wi)
     if qpi > 1 then line = substr(line,1,qpi-1)
  end
  /*
   * Determine the alias from the first word.
   *
   * Both forms are accepted:
   *
   *     ##PYTHON
   *     PYTHON
   */
  alias = upper(word(line,1))

  if left(alias,2) = '##' then alias = substr(alias,3)
  if alias = '' then do
     say 'RXPP error: missing data-block alias'
     return
  end

  /*
   * Confirm that the alias has been registered by ##DALIAS.
   *
   * dalias contains entries such as:
   *
   *     <##FORTRAN> <FORTRAN> <##PYTHON> <PYTHON>
   */
  aliasToken = '<'alias'>'
   /*
   * The second word is the receiving array.
   * The third word is an optional callback procedure.
   */
  array = word(line,2)
  if array = '' then array=alias
  callback = word(line,3)
  /*
   * Only an array name and an optional callback are allowed.
   */
  if word(line,4) <> '' then do
     say 'RXPP error: too many parameters on' alias 'block'
     return
  end

  /*
   * The end marker must match the opening alias.
   *
   * Both forms are accepted:
   *
   *     ##END PYTHON
   *     END PYTHON
   */
  endMarker1 = '##END 'alias
  endMarker2 = 'END 'alias
  endMarker3 = '##END'
  j = 0
  foundEnd = 0
  i = .int
  /*
   * Read source lines until the matching named end marker.
   */
  do i = line_no + 1 to source.0
     line = source.i
     testLine = upper(strip(line))
     if testLine = endMarker1 | testLine = endMarker2 | (directive_form = '##' & testLine = endMarker3) then do
        foundEnd = 1
        leave
     end
     /* BLOCKMACROS applies the same two-stage expansion to DALIAS blocks. */
     if rxpp_expand_block_line(i) then iterate
     line=source.i
     j = j + 1
     source.i = array'.'j'='safe_quote(line)
     stype.i = 'noexp'
  end
  /*
   * Protect against an unterminated data block. Without this
   * check, the procedure could accidentally continue past the
   * end of the source buffer.
   */
  if foundEnd = 0 then do
     say 'RXPP error: missing' endMarker1
     return
  end

  /*
   * Without a callback, suppress the end marker as an RXPP
   * directive.
   */
  if callback = '' then stype.i = 'D'
  /*
   * With a callback, replace the end marker by a call that
   * receives the populated array.
   */
  else do
     source.i = 'call 'callback' 'array
     stype.i = ' '
  end
return
/* ------------------------------------------------------------------
 * writeline: Appends a line to outbuf[] after variable injection.
 * splitting on backslashes (\)
 * ------------------------------------------------------------------
 */
writeline: procedure
  arg oline=.string
  source_line_no=.int
  source_file=.string
  source_text=.string
  oline=injectVariable(oline)
## just insert line to buffer
   if lino=1 then do
      lino = lino + 1
      outbuf.lino='/* 'copies('-',70)
      lino = lino + 1
      outbuf.lino = ' * PRE Compiled on 'date()' at 'time()
      lino = lino + 1
      outbuf.lino = ' * 'copies('-',70)
      lino = lino + 1
      outbuf.lino=' */'
   end
   if oline='' & outbuf.lino='' then return  ## not more than one blank line
   if rxpp_srcmap_enabled() then do
      source_line_no=rxpp_srcmap_source_line(curlino)
      source_file=rxpp_srcmap_source_file(curlino)
      source_text=rxpp_srcmap_source_text(curlino)
      if source_line_no>0 & oline\='' then do
        /*
         * Peter note: these two emitter calls establish the current original
         * source file and source line before the generated line is written.
         * rxc uses them as the default location for any generated text that is
         * not inside a narrower rxpp_srcmap_span() below.
         */
         lino = lino + 1
         outbuf.lino=rxpp_srcmap_file_hint(source_file)
         lino = lino + 1
         outbuf.lino=rxpp_srcmap_line_hint(source_line_no,source_text)
      end
      /*
       * Peter note: escape every literal @ in generated CREXX after all RXPP
       * source-map helper calls have inserted their private marker token.  The
       * marker is converted back to raw @ here; user/program @ characters become
       * @@ so rxc will treat them as ordinary text.
       */
      oline=rxpp_srcmap_escape(oline)
   end
   lino = lino + 1
   outbuf.lino = oline
  return
/* ------------------------------------------------------------------
 * expandRecursive: Expands a line repeatedly until no further macro substitutions occur.
 * ------------------------------------------------------------------
 */
expandRecursive:  procedure=.string
  arg line=.string,linnum=.int
  old = ''

  macname=rxpp_script_macro_name(line)
  if macname\='' then do
     line=rxpp_srcmap_unwrap(line)
     return newmacros(macname,line,linnum,1,0)
  end
  expandlevel=0
  do until old = line | line=''   /* No change → stop */
     old = line
     line = expandLine(line,linnum)  /* Expand one level */
     if pos(d2c(10),line)>0 then line=rxpp_split_cstyle_lines(line,linnum)
     /* C-style expansion can produce a standalone script-macro invocation.
      * Dispatch only when its first word is an exact registered macro name. */
     macname=rxpp_script_macro_name(line)
     if macname\='' then do
        line=rxpp_srcmap_unwrap(line)
        /* A C-style macro may already have emitted the source-call comment.
         * Avoid having the nested script macro emit the same call again. */
        macro_call_logged = (printgen_flags='all' | (printgen_flags='nnest' & expandLevel=0))
        return newmacros(macname,line,linnum,1,macro_call_logged)
     end
  end
return line

/* ------------------------------------------------------------------
 * rxpp_script_macro_name: Return the exact registered script macro at the
 * first word of LINE, or an empty string when LINE is ordinary source.
 * ------------------------------------------------------------------
 */
rxpp_script_macro_name: procedure=.string
  arg line=.string
  line=rxpp_srcmap_unwrap(line)
  word1=lower(word(line,1))
  if substr(word1,1,2)\='##' then return ''
  do k=1 to scriptMacros[0]
     macname=scriptMacros[k]
     /* Exact matching prevents ##ui from capturing ##ui_node. */
     if word1=macname then return macname
  end
return ''

/* ------------------------------------------------------------------
 * rxpp_srcmap_unwrap: Remove source-map span delimiters while retaining their
 * contents. Generated script-macro calls are inspected before final output,
 * so source-map wrappers must not hide the directive token or its arguments.
 * ------------------------------------------------------------------
 */
rxpp_srcmap_unwrap: procedure=.string
  arg line=.string
  marker=rxpp_srcmap_marker()
  marker_len=length(marker)
  close_marker=marker||'}'
  close_len=length(close_marker)
  result=''
  i=1
  line_len=length(line)
  do while i<=line_len
     if substr(line,i,marker_len)=marker then do
        j=i+marker_len
        k=j
        do while k<=line_len & datatype(substr(line,k,1),'W')
           k=k+1
        end
        if k>j & substr(line,k,1)='+' then do
           k=k+1
           digits=k
           do while k<=line_len & datatype(substr(line,k,1),'W')
              k=k+1
           end
           if k>digits & substr(line,k,1)='{' then do
              i=k+1
              iterate
           end
        end
        if substr(line,i,close_len)=close_marker then do
           i=i+close_len
           iterate
        end
     end
     result=result||substr(line,i,1)
     i=i+1
  end
return result

/* ------------------------------------------------------------------
 * rxpp_split_cstyle_lines: Split a continued C-style expansion only when it
 * contains a standalone script-macro call. Remaining lines are inserted after
 * the current line, preserving their order for Pass Three. Ordinary continued
 * macros retain their historical semicolon expansion.
 * ------------------------------------------------------------------
 */
rxpp_split_cstyle_lines: procedure=.string
  arg line=.string,linnum=.int
  separator=d2c(10)
  parts=.string[]
  rest=line
  part_count=0
  has_script_call=0
  do forever
     split_at=pos(separator,rest)
     part_count=part_count+1
     if split_at=0 then do
        parts[part_count]=rest
        if rxpp_script_macro_name(rest)\='' then has_script_call=1
        leave
     end
     parts[part_count]=left(rest,split_at-1)
     if rxpp_script_macro_name(parts[part_count])\='' then has_script_call=1
     rest=substr(rest,split_at+1)
  end

  if has_script_call=0 then return changestr(separator,' ; ',line)

  if part_count>1 then do
     call insert_source linnum+1,part_count-1
     do part_index=2 to part_count
        call inject2Source linnum+part_index-1,3,parts[part_index]
     end
  end
return parts[1]
/* ------------------------------------------------------------------
 * expandLine: Expands all macro invocations within a single line (one expansion pass).
 * ------------------------------------------------------------------
 */
expandLine:  procedure=.string
  arg line=.string,linnum=.int
  ucmd=upper(word(line,1))
  if ucmd = '##SET' then do
     call cmd_set 9999,line
     if pos(' nset',cflags)>0 then return ''
     return printGen(line,3)
  end
  if ucmd = '##UNSET' then do
     call cmd_unset 9999,line
     if pos(' nset',cflags)>0 then return ''
     return printGen(line,3)
  end
  if ucmd = '##ASSERT' then do
     call cmd_assert 9999,line
     return ''
  end
  ## if cmt='##' then return line
  ## if cmt='/*' then return line
  ## if pos('(',line,1)=0 then return line   ## if there is no "(" there can't be a macro call
  i=hasMacro(line,macros_mname,1)      ## checks also for ## /*
  do while i>0
     line=resolveMacro(i,line,expandLevel,linnum)
     expandlevel=expandlevel+1
     i=hasMacro(line,macros_mname,i+1)
  end
return line
/* ------------------------------------------------------------------
 * expand new Macros: Expands one macro occurrence by parsing arguments and substituting into the macro body.
 * ------------------------------------------------------------------
 */
newMacros:  procedure=.string
  arg macname=.string,line=.string,linnum=.int,ipi=.int,suppress_call_comment=.int
  original_call=.string
  source_len=.int
  forward_text=.string
  forward_value=.string
  script_formals=.string
  script_formal=.string
  script_formal_count=.int
  script_forward_name=.string
  grouped_script_args=.int
  if scriptMacro.macname.error='error' then return line' ## File not available: 'syspath||macname'.rxpm'
  if scriptMacro.macname = '' then do
     rc = LoadExternalScriptMacro(macname)
     if rc \= 0 then do
        missing_file = scriptMacro.macname.file
        if missing_file = '' then missing_file = syspath || strip(macname,,'#') || '.rxpm'
        return line' ## 'rxpp_diag_text('RXPP_SCRIPT_MACRO_MISSING', 'file', missing_file)
     end
  end

  scriptMacroCounter=scriptMacroCounter+1
  call rxpp_flow 'pass3','script_macro',linnum,macname
  if rxpp_cflag_present('macrotrace') then say '++RXPP-DIAG macrotrace script='macname ' line='linnum ' source='source_origin_file[linnum]':'source_origin_line[linnum]
  if scriptMacroCounter>1500 then do
     call rxpp_diag 'warning','RXPP_EXPANSION_LIMIT','count',scriptMacroCounter
     return line
  end

  subparm=substr(line,ipi)
  subparm=subword(subparm,2)
  forward_text=subparm
  grouped_script_args=pos('=(',subparm)>0
  if grouped_script_args then do
     subparm=protectScriptMacroGroup(subparm)
     forward_text=changestr(d2c(1),subparm,',')
     forward_text=changestr(d2c(2),forward_text,' ')
  end
  subparm=translate(subparm,,',')
  inparms=''
  original_call=source[linnum]
  if printgen_flags='none' then suppress_call_comment=1
  if suppress_call_comment then stype[linnum]='X'
  else do
     stype[linnum]='D'
     source[linnum]='/* 'source[linnum]' */'
  end
  script_formals=translate(scriptMacro.macname.parms,,',')
  script_formal_count=words(script_formals)
  script_forward_name=''
  do script_forward_index=1 to script_formal_count
     script_formal=word(script_formals,script_forward_index)
     if left(script_formal,3)='...' then do
        if script_formal='...' | script_forward_index \= script_formal_count then do
           call rxpp_diag 'error','RXPP_MACRO_FORWARDING_POSITION','macro',macname,'arguments',scriptMacro.macname.parms
           exit 8
        end
        script_forward_name=substr(script_formal,4)
        leave
     end
  end
  if script_forward_name \= '' then script_formal_count=script_formal_count-1
  do script_bind_index=1 to script_formal_count
     sword=qword(subparm,script_bind_index)
     if grouped_script_args then do
        sword=changestr(d2c(1),sword,',')
        sword=changestr(d2c(2),sword,' ')
        expectedarg=word(script_formals,script_bind_index)
        equal_pos=pos('=',sword)
        if equal_pos>0 & upper(substr(sword,1,equal_pos-1))=upper(expectedarg) then do
           sword=substr(sword,equal_pos+1)
           if left(sword,1)='(' & right(sword,1)=')' then sword=substr(sword,2,length(sword)-2)
        end
     end
     sword=quote(sword)
     if sword \= '' then inparms=inparms||word(script_formals,script_bind_index)' = 'sword'; '
  end
  if script_forward_name \= '' then do
     /* script_formal_count is the number of fixed parameters remaining;
      * the forwarded tail starts immediately after those parameters. */
     /* Use the original quote-aware text.  The normalized SUBPARM replaces
      * commas with separators and would corrupt commas inside quoted values. */
     forward_text=scriptForwardTail(forward_text,script_formal_count+1,grouped_script_args)
     /* INPARMS wraps the forwarded value in a single-quoted RexxScript
      * literal.  Double quotes are ordinary data there and must remain
      * single; doubling them would make QWORDS see escaped quotes instead of
      * quote delimiters.  Only the enclosing single quote needs escaping. */
     forward_value=forward_text
     forward_value=changestr("'",forward_value,"''")
     inparms=inparms||script_forward_name' = '''forward_value'''; '
  end
/* Prepare RexxScript Call */
   out=.string[]
   generated_mcall_depth=.int[]
   result=.string[]
   scriptMacro.macname.calls=scriptMacro.macname.calls+1
   instructionSet=scriptMacro.macname
   _mcalls=scriptMacro.macname.calls
   _sysndx=scriptMacroCounter
   _macro_calls=_sysndx
   _date=date()
   _time=time('l')
   _macro=macname
   _mline=source_origin_text[linnum]
   _mlino=source_origin_line[linnum]
   _file=getvar('rxpp_rexx')
   _module=rxmodule
   if pos(' maclog',cflags)>0 then do
      REXXSCRIPT inparms' 'instructionSet EXPOSE _sysndx, _macro_calls, _file, _module, _date, _time, _macro, _mline, _mlino, _mcalls OUTPUT out RESULT result debug
   end
   else do
     REXXSCRIPT inparms' 'instructionSet EXPOSE _sysndx, _macro_calls, _file, _module, _date, _time, _macro, _mline, _mlino, _mcalls OUTPUT out RESULT result /* DEBUG */
   end
   script_error=.int
   script_error=0
   if result[1]='OK' then nop
   else do
      script_error=1
      say '/// Macro Error at line : '_mlino
      say '/// Macro Call          : '_mline
      say '/// Error Message       : 'result.1
   end
/* Logging of rexxscript just for debugging */
  if pos(' maclog',cflags)>0 then do
     do k=1 to result.0
        say "Script Result" k result.k
     end
  end
  if script_error=1 then do
     call rxpp_diag 'error','RXPP Precompile aborted'
     exit 8
  end

  main_insert = 0
  tail_insert = 0
  source_len  = length(original_call)

  do kk = .int(1) to out[0]
     line = changestr("''", out[kk], "")
     testline = strip(line, 'L')
     if left(testline, 10) = '@.section@' then do
        call add_section line
        iterate
     end
     if left(testline, 8) = '@.mcall@' then do
        main_insert = main_insert + 1
        p = pos('@.mcall@', line)
        parent_mcall_depth = source_mcall_depth[linnum]
        if parent_mcall_depth = '' then parent_mcall_depth = 0
        mcall_depth = parent_mcall_depth + 1
        if mcall_depth > 16 then do
           call rxpp_diag 'error','RXPP_MCALL_DEPTH','macro',macname,'depth',mcall_depth,'limit',16
           ki=.int
           do ki=1 to outbuf[0]
              say right(ki,4,'0')' \\\ 'outbuf[ki]
           end
           do kj=1 to out[0]
              say right(ki+kj-1,4,'0')' \\+ 'out[kj]
           end
           call rxpp_diag 'error','RXPP Precompile aborted'
           exit 8
        end
        else do
           out[kk] = substr(line, p + 8)
           generated_mcall_depth[kk] = mcall_depth
        end
        iterate
     end
     if left(testline, 7) = '@.main@' then do
        main_insert = main_insert + 1
        main_pos = pos('@.main@', line)
        out[kk] = substr(line, main_pos + 7)
        iterate
     end
     if left(testline, 7) = '@.tail@' then do
        tail_insert = tail_insert + 1
        if tail_insert = 1 then source[source[0] + 1] = '/* Appended by 'original_call' */'
        p = .int
        p = pos('@.tail@', line)
        source[source[0] + 1] = substr(line, p + 7)
        if rxpp_srcmap_enabled() then source[source[0]] = rxpp_srcmap_span(1, source_len, source[source[0]])
        iterate
     end
  end
  rc = .int
  rc= insert_source(linnum+1,out[0]-tail_insert+1)
  inew=linnum+1
  source_len=length(original_call)
  do kk=.int(1) to out[0]
     if pos('@.tail@',out[kk])>0 then iterate
     if pos('@.section@',out[kk])>0 then iterate
     /*
      * RexxScript-backed script macros can produce arbitrary output text.  RXPP
      * does not know token-level provenance inside that script output, so the
      * repeatable rule is to map each emitted line to the whole script-macro
      * invocation.  Future per-token script metadata can narrow this later.
      */
     if rxpp_srcmap_enabled() then do
        /*
         * Peter note: RexxScript macros currently provide line-level output
         * only, so each emitted line is mapped to the whole script-macro
         * invocation.  When RexxScript reports token provenance, this is the
         * place to replace the coarse span with narrower spans.
         */
        out[kk]=rxpp_srcmap_span(1,source_len,out[kk])
     end
     inew=inject2Source(inew+1,3,out[kk])
     source_mcall_depth[inew] = generated_mcall_depth[kk]
  end
  if suppress_call_comment then return ''
return source[linnum]

add_section: procedure
   arg line=.string
   marker='@.section@'
   if left(line,length(marker)) \= marker then return
   /* Everything after @.section@ is:
    *     section-name@payload
    * The payload is deliberately NOT stripped because leading
    * blanks may represent indentation in generated source.
    */
   rest=substr(line,length(marker)+1)
   separator=pos('@',rest)
   if separator=0 then return
   section_name=strip(substr(rest,1,separator-1))
   if section_name='' then return
   section_line=substr(rest,separator+1)
   call rxqueue 'SETX',section_name
   QUEUE section_line
return




/* ------------------------------------------------------------------
 * resolveMacro: Expands one macro occurrence by parsing arguments and substituting into the macro body.
 *     line is input line
 *     i    contains macro index to resolve line
 * ------------------------------------------------------------------
 */
resolveMacro: procedure=.string
   arg i=.int, line=.string,level=.int,linnum=.int
   ppl=lastpos('##',line)       ## ending comment, if any
   if ppl>1 then line=substr(line,1,ppl-1)
   uline   = upper(line)
   callPos = 0
   /* load the macro header and definition */
   name    = macros_mname.i    ## macro name
   args    = macros_margs.i    ## macro arguments
   body    = macros_mbody.i    ## macros body {...}
   mspace  = macros_mspace.i   ## macro type, 1 is a sapce type, 0, normal, parms are separated by ","

   body=injectVariable(body)    ## inject pre-compiler variables, if there are any
   mexpanded=mexpanded+1
   call rxpp_flow 'pass3','macro',linnum,name
   if rxpp_cflag_present('macrotrace') then say '++RXPP-DIAG macrotrace macro='name ' line='linnum ' source='source_origin_file[linnum]':'source_origin_line[linnum]
   ## test whether the macro repeats or forwards variadic arguments
   isVariadic=0
   isForward=0
   forwardName=''
   forwardMarker=0
   forwardToken=.string
   fixedArgs=.string
   forwardStart=0
   forwardMarker=pos('...',args)
   if forwardMarker>0 then do
      forwardToken=word(translate(substr(args,forwardMarker),,' ,'),1)
      if forwardToken='...' then isVariadic=1
      else do
         isForward=1
         forwardName=substr(forwardToken,4)
      end
   end
   if isVariadic then args=strip(changestr('...', args, ''))
   fixedArgs=args
   if isForward then do
      /* Remove the forwarding marker and any separator left before it. */
      fixedArgs=changestr('...'forwardName,args,'')
      fixedArgs=strip(changestr(',', fixedArgs, ''))
      forwardStart=words(translate(fixedArgs,,','))+1
   end
   if mspace=1 then do   ## command macros have stricter rule, they must be the first word of the line and they can't be nested
      if word(uline,1) \=strip(name) then return line  ## not a valid command macro call
   end
   do forever
      callpos=pos(name, uline, callPos + 1)        ## search position of macro in input line
      if callpos=0 then leave                      ## nothing there, leave
    ## now we know macro is part of the line
       if printgen_flags='all' then call writeline printGen(strip(line),0)     ## some logging if wanted
       else if level=0 & printgen_flags='nnest' then call writeline printGen(strip(line),0)
       level=level+1     ## increase level in case a second instance of macro is found
    ## check which char is prior the macro call
       if callpos>1 then do
          status_before=verify(substr(uline,callpos-1,1), alphaN, 'N')
          if status_before=0 then iterate
       end
    ## move remaing line, which is the argument list of the macro
       remain  = substr(line, callPos + length(name))    ## set to parameter part, macro has format name( +length positions into it
    ## extract argument list
       argtext = fetchArguments(remain)
       rawArgText=argtext
       if mspace=1 then do
          argtext=normalizeCommandKeywords(argtext,args)
          argtext=ConcParms(argtext)
       end
       callargcount = parseArgList(argtext)
       bodyExp = body
       if isVariadic then return variadic(bodyExp, callargcount, argtext)
       if isForward then do
          if fixedArgs\='' then bodyExp=replaceFixArg(bodyExp,name,fixedArgs,callargcount,callpos+length(name)-1,0)
          forwardText=forwardArgumentTail(forwardStart,callargcount,mspace)
          bodyExp=replaceForwardArg(bodyExp,forwardName,forwardText)
       end
       else bodyExp=replaceFixArg(bodyExp,name,args,callargcount,callpos+length(name)-1,1)
    /* Here is the non variadic processing */
       if substr(bodyexp,1,3)='+++' then return bodyexp  ## +++ error occurred in call
       callLen = length(name) + 1 + length(argtext)  /* inkl. len(name()+1 for ) */
       if rxpp_srcmap_enabled() then do
          /*
           * Peter note: this outer span maps generated replacement text back to
           * the macro call itself.  replaceFixArg() may already have inserted
           * narrower spans for substituted arguments; rxc chooses the narrowest
           * enclosing span when a diagnostic lands inside the expansion.
           */
          bodyExp=rxpp_srcmap_span(callpos,callLen,bodyExp)
       end
       line=splice(bodyexp,line,callpos,callLen)  ## line=insertatc(bodyexp,line,callpos,callLen)
       if mspace= 1 then leave        /* nesting for command macros are not permitted */
       uline    = upper(line)         /* update uline for repetition */
       callPos  = callPos - 1         /* set next start point */
    end
return line
/* ------------------------------------------------------------------
 * injectVariable: Inject pre-compiler variables ({var}) into a line.
 * ------------------------------------------------------------------ */
injectVariable: procedure=.string
   arg line2change=.string
   original = line2change
   testline = strip(line2change)

   marker = '/* RXPP:EXPAND */'
   force  = pos(marker, upper(testline)) = 1

   if force then line2change = strip(substr(testline, length(marker) + 1))
   else do
     initial_comment = left(testline, 2)
     if initial_comment = '/*' | initial_comment = '##' then return original
   end

  /* Do not process comments or RXPP directives. */
   cmt = left(line2change, 2)
   if cmt = '/*' | cmt = '##' then return line2change
   start = 1

   do forever
      open = pos('{', line2change, start)
      if open = 0 then leave

      close = pos('}', line2change, open + 1)
      if close = 0 then leave      /* incomplete variable */
      variable = substr(line2change, open, close - open + 1)
      found = 0
      do i = 1 to macros_varname.0
         if macros_varname.i \= variable then iterate
         line2change = substr(line2change, 1, open - 1) || macros_varvalue.i || substr(line2change, close + 1)
       /* Continue after the inserted value. */
         start = open + length(macros_varvalue.i)
         found = 1
         leave
      end

      if found = 0 then start = close + 1              /* unknown variable */
   end
   if force=1 then line2change = '/* 'line2change' */'
   return line2change
/* ------------------------------------------------------------------
 * replaceFixArg: Substitutes fixed macro parameters with supplied call arguments (positional + keyword).
 * ------------------------------------------------------------------
 */
replaceFixArg: Procedure=.string
  arg bodyexp=.string,macname=.string, xargs=.string,callargcount=.int,source_base=.int,check_arity=.int
  iargs=xargs
  preserveScriptGroups=pos('##_',bodyExp)>0    /* check if the expansion contains a script macro call */

  xargs   = translate(xargs, , ',')
  wrds=words(xargs)
  if check_arity \= 0 & wrds\=callargcount then do    ## callargs.0 is may be not set properly
     if pos(' strictmacrocheck',cflags)>0 then do
        call writeline '## +++++ macro 'macname' call parameters do not match with template'
        call writeline '## +++++ template 'quote(xargs)
        say '+++++ macro 'macname' call parameters do not match with template'
        say '+++++ template 'quote(xargs)
     end
  end
 ## First take the positional parameters
  keypositional=0
  do k=1 to wrds
     aname = word(xargs, k)
     if pos('=',aname)>0 then do
        if keypositional=0 then keypositional=k
        iterate
     end
     if keypositional>0 then do
        call rxpp_diag 'error','RXPP_POSITIONAL_AFTER_KEYWORD','macro',macname,'arguments',iargs
        return '+++ 'rxpp_diag_text('RXPP_POSITIONAL_AFTER_KEYWORD','macro',macname,'arguments',iargs)
     end
     aval=callargs.k
     /*
      * Peter note: wrap each positional argument value before substitution.
      * If the expanded body later fails in rxc, the inner span points at the
      * original argument expression rather than only the full macro call.
      */
     aval=rxpp_srcmap_argument_value(aval,callargs_source_col.k,source_base)
     bodyExp = replaceArg(bodyExp, aname, aval)   ## replace macro variable by value in callargs.k
   end
  if keypositional=0 then return bodyExp
## now that we know we have keyword paramters, we need to translate tso-style call back to key= syntax
  do i=1 to callargcount
       callargs.i=tso2func(callargs.i,preserveScriptGroups)
  end
## start matching macro definition parm list to calling parameters (keywords only)
  do k=.int(keypositional) to wrds        ## run through the macroc header definition
     aname = .string
     aname = translate(word(xargs, k),,'=')         ## aname is the keyword definition in the macro header
     adefault=word(aname,2)                        ## 2. word is the default value
     if adefault='' then adefault="''"             ## if not there, use empty string
     aname=word(aname,1)                           ## now isolate parameter name
     j = 0
     do j=1 to wrds                  ## find the appropriate keyword, sequence is free
        if fpos(aname'=',callargs.j,1)>0 then leave    ### +++++++++++ modify  ## use fpos function to search case-insensitive
     end
     aval = .string
     aval=callargs.j                       ## identifies the call of the macro
     value_source_col=0
     equal_pos=pos('=',aval)
     if equal_pos=0 then aval=adefault ## if keyword is not defined use the default in the macro def part
     else do                               ## if so check if the keyword call is also in the value clause
        value_source_col=callargs_source_col.j+equal_pos
        aval=substr(aval,equal_pos+1)
        /* Keep the keyword label on a grouped value forwarded to a script
         * macro so newMacros can recognize the original key=(...) group. */
        if preserveScriptGroups & left(strip(aval),1)='(' & pos(',',aval)>0 then aval=aname'='aval
     end
     /*
      * Peter note: keyword defaults are generated text and therefore stay on
      * the outer macro-call span.  Supplied keyword values get a narrower span
      * starting after the '=' or TSO-style '(' in the original call argument.
      */
     aval=rxpp_srcmap_argument_value(aval,value_source_col,source_base)
     bodyExp = replaceArg(bodyExp, aname, aval)
  end
return bodyExp
/* ------------------------------------------------------------------
 * replaceForwardArg: Substitutes a terminal ...name forwarding marker once.
 * The marker is deliberately distinct from the ordinary identifier so a
 * forwarding body can pass the complete original argument text onward.
 * ------------------------------------------------------------------
 */
replaceForwardArg: procedure=.string
  arg str=.string,name=.string,value=.string
  marker='...'name
  result=''
  cursor=1
  do forever
     found=pos(marker,str,cursor)
     if found=0 then do
        result=result||substr(str,cursor)
        leave
     end
     result=result||substr(str,cursor,found-cursor)||value
     cursor=found+length(marker)
  end
return result
/* ------------------------------------------------------------------
 * forwardArgumentTail: Joins the actual arguments after the fixed prefix.
 * ------------------------------------------------------------------
 */
forwardArgumentTail: procedure=.string
  arg start=.int,count=.int,space_style=.int
  separator=','
  if space_style=1 then separator=' '
  result=''
  do k=start to count
     if result='' then result=callargs.k
     else result=result||separator||callargs.k
  end
return result
/* ------------------------------------------------------------------
 * scriptForwardTail: Returns the quote-aware tail of a scripted macro call.
 * ------------------------------------------------------------------
 */
scriptForwardTail: procedure=.string
  arg text=.string,start=.int,grouped=.int
  count=.int
  result=.string
  value=.string
  k=.int
  if grouped then do
     text=changestr(d2c(1),text,',')
     text=changestr(d2c(2),text,' ')
  end
  result=''
  count=qwords(text)
  do k=start to count
     value=qword(text,k)
     if result='' then result=value
     else result=result' 'value
  end
return result
/* ------------------------------------------------------------------
 * protectScriptMacroGroup: Protects separators inside key=(...) while
 * the existing qword argument splitter handles surrounding arguments.
 * ------------------------------------------------------------------
 */
protectScriptMacroGroup: procedure=.string
  arg text=.string
  out=''
  depth=0
  quote_char=''
  text_len=length(text)

  do j=1 to text_len
     ch=substr(text,j,1)

     if quote_char\='' then do
        out=out||ch
        if ch=quote_char then do
           if j<text_len & substr(text,j+1,1)=quote_char then do
              out=out||quote_char
              j=j+1
           end
           else quote_char=''
        end
        iterate
     end

     if ch='"' | ch="'" then do
        quote_char=ch
        out=out||ch
        iterate
     end

     if depth=0 & ch='=' & j<text_len & substr(text,j+1,1)='(' then do
        out=out||'=('
        depth=1
        j=j+1
        iterate
     end

     if depth>0 & ch='(' then depth=depth+1
     else if depth>0 & ch=')' then depth=depth-1

     if depth>0 & ch=',' then out=out||d2c(1)
     else if depth>0 & (ch=' ' | ch='09'x) then out=out||d2c(2)
     else out=out||ch
  end
return out

/* ------------------------------------------------------------------
 * tso2func: Normalizes TSO-style keyword arguments to function-style key=value syntax.
 * ------------------------------------------------------------------
 */
tso2func: procedure=.string
  arg inparm=.string,preserve_group=.int
  /* Ignore parentheses inside quoted keyword values. */
  pp1=qpos('(',inparm)
  if pp1=0 then return inparm
  pp2=lastpos(')',inparm)
  if pp2<pp1 then return inparm
  if pp1>1 & substr(inparm,pp1-1,1)='=' then do
     if preserve_group & pos(',',substr(inparm,pp1+1,pp2-pp1-1))>0 then return inparm
     /* Preserve keyword expressions wrapped in parentheses, including any
      * comparison '=' inside the expression. */
     inparm=substr(inparm,1,pp1-1)||substr(inparm,pp1+1,pp2-pp1-1)||substr(inparm,pp2+1)
  end
  else do
     inparm=overlay('=',inparm,pp1)
     if pp2>1 then inparm=substr(inparm,1,pp2-1)
  end
return strip(inparm)
/* ------------------------------------------------------------------
 * variadic: Expands variadic macros (macros with ... arguments) into repeated generated statements.
 * ------------------------------------------------------------------
 */
variadic: procedure=.string
  arg bodyExp=.string, callArgCount=.int, argText=.string

  /* Normalize argument text */
  argText  = translate(argText, , ',')
  varCount = callArgCount - 1

  /* Extract left-hand side (e.g., result = ...) */
  tempBody = translate(bodyExp, , '.=')
  lhs      = word(tempBody, 1)
  ix       = word(tempBody, 2)

  /* Extract the remaining expression */
  tempBody = translate(bodyExp, , '=')
  remain   = subword(tempBody, 2)

  /* Replace the primary macro parameters */
  if pos('arglist',lhs)>0 then inc=0
  else do
     bodyExp  = replaceArg(bodyExp, lhs, word(argText, 1))      /* fixed first argument */
     bodyExp  = replaceArg(bodyExp, 'argcount', varCount)
     inc=1
  end
  originalBody = bodyExp  /* store original for each iteration */
  /* Loop through variadic arguments */
  do k = 1 to varCount
     value   = word(argText, k + 1)
     bodyExp = replaceArg(bodyExp, '$indx', k)
     bodyExp = replaceArg(bodyExp, 'arglist.'k, value)
     call writeline bodyExp
     bodyExp = originalBody  /* reset to base form for next iteration */
  end

  /* Final run with index = 0 (optional placeholder reset) */
  bodyExp = replaceArg(bodyExp, '$indx', 0)

  /* Extract final left-hand side for return */
  finalBody = translate(bodyExp, , '=')
  lhs       = word(finalBody, 1)
  remain    = word(finalBody, 2)

  if remain = '' then return ''  /* empty body check */
  return ''
  ## return lhs '=' varCount   ## set variable.0 not allowed in level b
/* ------------------------------------------------------------------
 * debugArgs: Debug helper to print macro call arguments (usually disabled).
 * ------------------------------------------------------------------
 */
/* ##### DEAD CODE: retained for reference; not compiled or called. ##### */
## debugArgs:  procedure
##   arg name=.string,args=.string,callargcount=.int
##   say '--- DEBUG ---'
##   say 'Macro Name: ' name
##   say 'Macro Args: ' args
