/**
 * RXPP preprocessor.
 *
 * RXPP expands .rxpp macro/directive source into ordinary Level B CREXX.
 * By default RXPP emits the raw source-map channel that rxc consumes before
 * parsing so diagnostics can point back to original .rxpp files instead of only
 * the generated .crexx file.  Use ##CFLAG nosrcmap only for legacy plain-output
 * inspection.
 */
options levelb

import rexxscript
import precomp
import rxfnsb
import system
namespace rxpp expose globaldef rxmodule source stype source_origin_file source_origin_line source_origin_text callargs callargs_source_col callargs_source_len macros_mname macros_margs macros_mbody macros_mspace macros_varname macros_varvalue cflags printgen_flags outbuf lino curlino rexxlines included_files syspath macpath binpath inpath outpath alphaN mExpanded expandLevel aifblock elapsedTime verbose imported_funcs select_count beginblock beginName scriptMacro scriptMacros scriptMacroPath scriptMacroCounter srcmap_source_file srcmap_line_offset

/* ------------------------------------------------------------------
 * CREXX Pre Compiler
 *   Currently supported Commands
 *   ##DEFINE
 *   ##INCLUDE  (nested)
 *   ##LOADMACRO (register external script macros from a directory)
 * ------------------------------------------------------------------
 */
 main: procedure = .int
arg command=.string[]
  internal_testing=0    ## activate only for rxpp internal tests
  env=.os()
  binPath=env.LoadPath()
  infile  = .string
  outfile = .string
  maclib  = .string
  verbose = .int
  cnext   = .string
  ElapsedTime=time('us')

  do i=1 to command.0
     j=i+1
     command.i=upper(command.i)
     if j>command.0 then leave         /* not existing command.j might lead to error */
     if command.i     ='-I' then infile=command.j
     else if command.i='-IN' then infile=command.j
     else if command.i='-O' then outfile=command.j
     else if command.i='-OUT' then outfile=command.j
     else if command.i='-M' then maclib=command.j
     else if command.i='-VERBOSE' then verbose=command.j
  end
  verbose=1
  if verbose then say 'CRX0010I ['time('l')'] Pre-Compile started'
  
  if internal_testing=1 then do
     infile  = 'C:/Users/PeterJ/CLionProjects/CREXX260401/lib/plugins/system/treemap_test.rxpp'
     outfile = 'C:/Users/PeterJ/CLionProjects/CREXX260401/lib/plugins/system/treemap_test.crexx'
     maclib  = 'C:/Users/PeterJ/CLionProjects/CREXX260401/preprocessor/Maclib.rexx'
  end


 if strip(infile)='' then do
     call rxpp_diag 'error','RXPP_NO_SOURCE_FILE'
     exit 8
  end
  if verbose then do
     say 'Input File:  ' infile
     say 'Output File: ' outfile
     say 'Macro Lib:   ' maclib
     say 'Verbose:     ' verbose
  end
  inpath=getpath(infile)
  outpath=getpath(outfile)
  macpath=getpath(maclib)

scriptMacro=.stem()
scriptMacros=.string[]
scriptMacroPath=.stem()
scriptMacroCounter=0
syspath=rxppinit(infile,maclib)                   ## init global and environment variables
call registerScriptMacros inpath                 /* maclib macros have precedence */
if inpath \= macpath then call registerScriptMacros macpath

  if verbose then say 'CRX0100I ['time('l')'] Pre-Compile pass one'
  if verbose then say 'CRX0110I ['time('l')'] System Path 'syspath
/* --------------------------------------------------------------------
 * Pass One. Load Macros, Load Source, Expand Macros of Source
 * --------------------------------------------------------------------
 */
  sourceLines=RXPPPassOne(infile,outfile,maclib,syspath'/macsys.rexx')    ## load source file and macro library
  ## !!! to early is as picked up later-> is in pass 2 now !! if pos(' 1buf',cflags)>0 then call list_array source,-1,-1,'Source Buffer after Pass 1'
/* ------------------------------------------------------------------
 * Pass Two create ##IF/##IFN/##ELSE/##ENDIF reference table
 * ------------------------------------------------------------------
 */
  call RXPPPassTwo                                  ## pass 2 to pre-expand certain elements (##ELSE)
    if pos(' 2buf',cflags)>0 then call list_array source,-1,-1,'Source Buffer after Pass 2'
  if verbose then say 'CRX0200I ['time('l')'] Pre-Compile pass two'
/* ------------------------------------------------------------------
 *  Pass 3 keep/drop ##IF /##IFN blocks, build Final Output Buffer
 * ------------------------------------------------------------------
 */
  call RXPPPassThree outfile                        ## analyse source and expand macros
  if verbose then say 'CRX0310I ['time('l')'] Pre-Compiled REXX saved'
     if pos(' 3buf',cflags)>0 then call list_array outbuf, -1,-1,'Source Buffer after Pass 3'
  call writeall outbuf,outfile,-1                   ## write generated output to file
  call linkerInfo outfile,imported_funcs            ## linker definition will be calculated out of the normal output file
  if verbose then do
     say 'CRX0500I ['time('l')'] Pre-Compile completed, 'mexpanded' macro calls expanded, total source lines 'outbuf.0
     if pos(' vars',cflags)>0 then call printvars
     if pos(' maclist',cflags)>0 then call printmacs
     if pos(' includes',cflags)>0 then do
        call list_array included_files,-1,-1,'Include Files'
        call list_blocks
     end
     elapsedTime=(time('us')-elapsedtime)
     say 'CRX0101I ['time('l')'] Elapsed Time 'elapsedTime/1000000' seconds, 'elapsedTime/1000' milliseconds'
  end
return 0

/* ------------------------------------------------------------------
 * Pre Processor Pass One
 * 1. Load (and sort) Macros
 * 2. Load Source File
 * 3. Determine Pre-Processor Statements
 * ------------------------------------------------------------------
 */
RXPPPassOne: procedure = .int
  arg expose infile=.string, outfile=.string,maclib=.string, macsys=.string

  /* Locals */
  maxmac = .string
/* ---- 1a. Load Macros from MACLIB  */
  macnum=readSource(maclib,0)    /* error doesn't terminate program */
  if macnum<0 then do
     if verbose then call rxpp_diag 'warning','RXPP_MACLIB_MISSING','file',maclib
  end
  else do
     call GetPreComp macnum                 ## analyse maclib, source lines not needed just register macros
     if verbose then say 'CRX0120I ['time('l')'] Maclib loaded:      'source.0' records'
     if verbose then say 'CRX0130I ['time('l')'] Macros extracted:   'macros_mname.0
     maxmac=macros_mname.0
  end
## clear source array
##  call drop_Array source
##  call drop_Array stype
  assembler SETATTRS source,0
  assembler SETATTRS stype,0
  assembler SETATTRS source_origin_file,0
  assembler SETATTRS source_origin_line,0
  assembler SETATTRS source_origin_text,0

/* ---- 1b. Load System Macros from MACSYS  */
  macnum=readSource(macsys,0)    /* error doesn't terminate program */
  if macnum<0 then do
     if verbose then call rxpp_diag 'warning','RXPP_SYSTEM_MACLIB_MISSING','file',macsys
  end
  else do
     call GetPreComp macnum                 ## analyse maclib, source lines not needed just register macros
     if verbose then say 'CRX0120I ['time('l')'] System Maclib loaded: 'source.0' records'
     if verbose then say 'CRX0130I ['time('l')'] Macros extracted:     'macros_mname.0-maxmac
  end
## clear source array
##  call drop_Array source
##  call drop_Array stype
  assembler SETATTRS source,0
  assembler SETATTRS stype,0
  assembler SETATTRS source_origin_file,0
  assembler SETATTRS source_origin_line,0
  assembler SETATTRS source_origin_text,0
/* ---- 1c. Load file to compile */
  rexxLines=readSource(infile,1)
  if rexxLines<0 then do
     call rxpp_diag 'error','RXPP_SOURCE_MISSING','file',infile
     exit 8
  end
  call rxpp_set_source_origin_range 1,rexxLines,infile,1
  if rxpp_input_has_srcmap_options() then do
     call rxpp_diag 'error','RXPP_ALREADY_SOURCE_MAPPED','file',infile
     call rxpp_diag 'error','RXPP_ALREADY_SOURCE_MAPPED_HINT'
     exit 8
  end

/* ---- 2. find levelb, import and other option stuff  */
  which=0
  /* now pickup the flags, they might be used in PRECOMP */
  i=fsearch(source,1,"##CFLAG","","",which)   ## pickup CFLAG
  if i>0 then flagsset=early_flag_pick_up(i)

  level='levelb'
  linx=arrayfind('options levelg',source,1,0)
  if linx>0 then do
      stype.linx='X'
      level='levelg'
  end
  else do
      linx=arrayfind('options levelb',source,1,0)
      if linx>0 then stype.linx='X'
  end
  linx=arrayfind('import rxfnsb',source,1,0)
  if linx>0 then stype.linx='X'

  linx=arrayfind('/* REXX */',source,1,0)
  if linx>0 then stype.linx='X'
  else do
     linx=arrayfind('/* RXPP */',source,1,0)
     if linx>0 then do
        stype.linx='X'
        source[linx]=''
     end
  end
  call insert_source 1,10

  source.1='/* RXPP */'
  source.2='options' level
  if rxpp_srcmap_enabled() then source.2='options' level 'srcmap'
  source.3='import rxfnsb'
  source.4='/* reserved for namespace definition */'
  rexxlines=rexxlines+3
  if verbose then say 'CRX0140I ['time('l')'] Rexx Source loaded: 'rexxLines' records'

  /* now pickup ##BEGIN  */
  i=1
  which=0
  do forever
     beg=fsearch(source,i,"##BEGIN","","",which)   ## pickup BEGIN
     if beg=0 then leave
     stype[beg]='I'
     bi=beginBlock[0]
     beginName[beginName[0]+1]=upper(word(source[beg],2))
     ii=.int
     j=0
     do ii=beg+1 to source[0]
        stype[ii]='X'   /* drop it from source file */
        ww1=upper(word(source[ii],1))
        if ww1='##ENDBEGIN' then leave
        j=j+1
        beginBlock[bi+j]=source[ii]
        if pos(' nset',cflags)>0 then source[ii]=''
        else source[ii]='/* 'source[ii]' I*/'
     end
     beginName[beginName[0]]=beginName[beginName[0]]' 'bi+1' 'j
     i=ii+1
  end

/* ---- 3. Pre-Compile source file,  */
  maclibm=macros_mname.0
  call GetPreComp rexxlines              ## analyse source, source lines needed keep them
  if verbose then say 'CRX0150I ['time('l')'] Macros extracted:   'macros_mname.0-maclibm
  call sort_bylen macros_mname,macros_margs,macros_mbody,macros_mspace ## sort macro names by length do avoid unintented substitution (e.g. quote dquote)
  if verbose then say 'CRX0160I ['time('l')'] Macros arranged:    'macros_mname.0
return rexxlines
/* ------------------------------------------------------------------
 * Pass 2 pre-expand certain elements
 * !! Macro expansions already took place in Pass one step 3 !!
 * create ##IF/##IFN/##ELSE/##ENDIF reference table
 * ------------------------------------------------------------------
 */
RXPPPassTwo: procedure
  stack = .string[]     /* simulate stack using indexed stem */
  depth = 0             /* current depth */
  aifblock=.int[]
  which=0
  i=fsearch(source,1,'namespace ','',"",which)            ## find any namespace instruction
  if i>0 then do
     globaldef=source.i' 'globaldef
     source.i=""
  end
  i=fsearch(source,1,'##IF ','##IFN ',"##CFLAG",which)   ## search as first word in the source string

/* 1. ##ELSE becomes    Translate ELSE clause
        ##ENDIF         close previous ##IF
        ##IFN condition open else as ##IFN    */
  do while i>0
     if which<3 then condition=word(source.i,2)
     else flagsset=early_flag_pick_up(i) /* <<<!!!!!!!!!!!! ugly construct to pick up potential compiler flags immediately after pass 1 */
     i=fsearch(source,i+1,'##IF ','##IFN ','##ELSE',which)
     if which \=3 then iterate
     call arrayInsert source,i,1
     call arrayInsert stype,i,1
     source.i='##endif'
     stype.i='R'
     j=i+1
     source.j='##ifn 'condition
     i=fsearch(source,j+1,'##IF ','##IFN ',"",which)   ## search as first word in the source string
  end

/* 2. ##IF / ##IFN build cross reference  */
  which=0
  i=fsearch(source,1,'##IF ','##IFN ',"",which)   ## search as first word in the source string
  do while i>0
     if which=1 then stype.i='IF'
     else if which=2 then stype.i='IFN'
     lnk=findMatchingEndif(i+1)
     aifblock.i=lnk
     i=fsearch(source,i+1,'##IF ','##IFN ','',which)
  end

/* 3. Build OO definition table OO support dropped */

/* 4. output ##IF ##IFN / ##ENDIF Reference table */
  if verbose=0 then return
  if pos(' iflink',cflags)=0 then return
  if aifblock.0=0 then say "+++ no Pre Source Expansion occurred"
  else do i=1 to aifblock.0
     if aifblock.i=0 then iterate
     lnk = .int
     lnk=aifblock.i
     say right(i,4,'0')' 'left(strip(source.i),15)' linked to --> ' right(lnk,4,'0') ' ' strip(source.lnk)'  <+++ PASS2: IF/ENDIF linked; PASS3 decides emit or skip>'
     do j=.int(i+1) to lnk-1
        say '? controlled by IF: 'right(j,4,'0')' 'strip(source.j)
     end
     say right(lnk,4,'0')' 'left(strip(source.lnk),15)' (block end)'
  end
return
/* ------------------------------------------------------------------
 *  Pass 3 Build Final Output Buffer
 *    1. activate ##IF /##IFN block if condition is true
 *    2. not active blocks are dropped stype.LineNo='X'
 *    3. handle ##PARSE, why ? maybe belongs to Pass one
 *    4. Write or Dropm Macro and pre-compiler statements
 *       to show original pre-process call
 * ------------------------------------------------------------------
 */
RXPPPassThree: procedure
  arg out=.string
  lineNo=0
  if globaldef='' then source.4=''
  else do
     if fpos('namespace',globaldef,1)>0 then source.4=globaldef
     else source.4='namespace 'rxmodule' expose 'globaldef
  end
  do while lineNo<source.0
      lineNo=Lineno+1
     curLino=LineNo           ## save into global current LineNo
     line = source.lineNo
     uline=upper(strip(line))
     if stype.LineNo='X' then iterate    ## suppress any ##ELSE ##ENDIF
     if pos('/* reserved',line)>0 then iterate
  	 else if stype.LineNo='D' then do
 	    if pos(' ndef',cflags)>0 then iterate     ## ndef    : suppress original definition, just output expanded result
 	    call writeLine printGen(line,1)           ## printgen: prints pre-processor line with appropriate suffix comment
  	 end
     else if stype.LineNo='I' then do
       if pos(' nset',cflags)>0 then iterate      ## nset    : suppress original definition, just output expanded result
   	   call writeLine printGen(line,2)            ## printgen: prints pre-processor line with appropriate suffix comment
     end
     else if stype.LineNo='IF' then do
       ##  call writeLine printGen(line,4)
       if findvar(word(line,2))=0 & aifblock.lineno>lineNo then do   ## only forward pointer are permitted, else loop
           lineno=aifblock.lineno
        end
     end
     else if stype.LineNo='IFN' then do
       ##  call writeLine printGen(line,4)
        if findvar(word(line,2))>0 & aifblock.lineno>lineNo then do  ## only forward pointer are permitted, else loop
           lineno=aifblock.lineno
        end
     end
##     else if stype.LineNo='PARSE' then call parsevar lineNo,line
     else if stype.LineNo='IMPORT' then do
        func=word(line,2)
        if pos("|"func,imported_funcs)=0 then do
           imported_funcs=imported_funcs"|"func   ## keep track of imported modules
           call writeline line                    ## also write line, else it gets lost
        end
     end
     else if stype.LineNo='EMIT' then do
        /* Sections are complete only after preceding macros expand. */
        call cmd_emit lineNo,line
        if pos(' ndef',cflags)>0 then iterate      ## ndef    : suppress original definition, just output expanded result
        call writeLine printGen(line,5)            ## printgen: prints pre-processor line with appropriate suffix comment
     end
     else if stype.LineNo='ARRAY' then do
       if pos(' ndef',cflags)>0 then iterate      ## ndef    : suppress original definition, just output expanded result
       call writeLine printGen(line,5)            ## printgen: prints pre-processor line with appropriate suffix comment
     end
     else if stype.LineNo='GLOBAL' then do
       if pos(' ndef',cflags)>0 then iterate      ## ndef    : suppress original definition, just output expanded result
       call writeLine printGen(line,6)            ## printgen: prints pre-processor line with appropriate suffix comment
     end
  	 else if stype.LineNo='WHEN' then do
       if pos(' ndef',cflags)>0 then iterate      ## ndef    : suppress original definition, just output expanded result
       call writeLine printGen(line,3)            ## printgen: prints pre-processor line with appropriate suffix comment
   	 end
   	 else if stype.LineNo='FOR' then do
       if pos(' ndef',cflags)>0 then iterate      ## ndef    : suppress original definition, just output expanded result
       call writeLine printGen(line,3)            ## printgen: prints pre-processor line with appropriate suffix comment
     end
   	 else if stype.LineNo='SELECT' then do
       if pos(' ndef',cflags)>0 then iterate      ## ndef    : suppress original definition, just output expanded result
       call writeLine printGen(line,3)            ## printgen: prints pre-processor line with appropriate suffix comment
   	 end
     else if strip(line) \='' then do
       if left(uline,7)='##BLANK' then do
           call writeline ' '
           iterate
       end
       newline = expandRecursive(line,lineNo)
       if pos('##EMIT',upper(word(newline,1)))>0 then do   /* allow a macro call ##EMIT */
          /* Sections are complete only after preceding macros expand. */
          call cmd_emit lineNo,newline
          if pos(' ndef',cflags)>0 then iterate      ## ndef    : suppress original definition, just output expanded result
          call writeLine printGen(line,5)            ## printgen: prints pre-processor line with appropriate suffix comment
       end
       if stype.LineNo='D' & pos(' ndef',cflags)>0 then iterate
       call writeline newline
   	 end
  end
  call writeline ''
  if verbose then say 'CRX0300I ['time('l')'] Pre-Compiled REXX generated '
return
/* ------------------------------------------------------------------
 * Early_flag_pick_up Reads ##CFLAG early and updates runtime flags used during subsequent passes.
 * ------------------------------------------------------------------
 */
early_flag_pick_up: procedure=.int
  arg i=.int
  if i=0 then return 0

  line = lower(strip(source.i))

  if left(line, 2) = '/*' & right(line, 2) = '*/' then do
     line = strip(substr(line, 3, length(line) - 4))
     already_wrapped = 1
  end
  else already_wrapped = .int(0)

  cflags = ' ' || subword(line, 2)
  call setvar 'cflags', cflags

  if \already_wrapped then source.i = '/* ' || line || ' */'
return 1
/* ------------------------------------------------------------------
 * Output Begin Blocks for information (not into code)
 * ------------------------------------------------------------------
 */
 list_blocks: procedure
  if beginName[0]>0 then say ' '
  do i=1 to beginName[0]
     say 'Begin Block: 'word(beginName[i],1)
     say copies('-',48)
     from=word(beginName[i],2)
     if datatype(from) \= 'NUM' then leave
     tto =word(beginName[i],3)
     if datatype(tto) \= 'NUM' then leave
     tto =from+tto-1
     do j=from to tto
        say right(j,4,'0') beginBlock[j]
     end
     say ' '
  end
 return
/* ------------------------------------------------------------------
 * for ##IF / ##IFN find associated ##ENDIF, handling nesting.
 * ------------------------------------------------------------------
 */
findMatchingEndif: procedure=.int
  arg startline=.int
  nest = 1  /* Start at 1 because the current ##IF is level 1 */
  which = 0
  i = fsearch(source, startline, '##IF ','##IFN ','##END', which)
  do while i > 0
    if which = 1 | which=2 then nest = nest + 1
    else if which = 3 then do
      nest = nest - 1
      stype.i = 'X'  /* mark for removal or annotation */
      if nest = 0 then return i  /* finally matched ##ENDIF */
    end
    i = fsearch(source, i + 1, '##IF ', '##IFN ','##END', which)
  end
  if verbose then call rxpp_diag 'error','RXPP_MISSING_ENDIF','line',startline
return 0
/* ------------------------------------------------------------------
 * Read Rexx Source file into the global source[] buffer.
 * ------------------------------------------------------------------
 */
ReadSource: procedure=.int
  arg file=.string,mandatory=1
##  i=readall(source,file,-1)
  source=ReadLines(file,,,"noRaise")
  if mandatory=1 & source[0]=1 & word(source[1],1)='-8' then do
     call rxpp_diag 'error','RXPP_SOURCE_MISSING','file',file
     call rxpp_diag 'error','RXPP_FILE_TERMINATED','file',file
     exit 8
  end
  if word(source[1],1)='-8' then return -8
return source[0]
/* ------------------------------------------------------------------
 * Scans source for pre-compiler directives and macro definitions,
 * dispatches command handlers.
 * ------------------------------------------------------------------
 */
GetPrecomp: procedure
   arg line_no=.int
   lineNo = 0
   do while lineNo < source.0      ## array might grow, so while is more reliable
      LineNo=LineNo+1
      if stype[LineNO]='noexp' | stype[LineNO]='cmt' then iterate
      hit=0
      depth = CommentScan(lineNo,0,hit)
      if hit then do
         cmtbeg=LineNo
         stype[lineNo] = 'cmt'
      /* if still inside a block comment, mark subsequent lines too */
         do while depth > 0 & lineNo < source.0
            lineNo = lineNo + 1
            stype[lineNo] = 'cmt'
            depth=CommentScan(lineNo, depth,hit)  /* hit will be 1 anyway because depth>0 at BOL, but keep it consistent */
         end
         if pos(' cmtblk',cflags)> 0 & LineNo-cmtbeg>15 then do ci=cmtbeg+1 to lineNo-1
            source[ci]='*>'source[ci]
         end
      end
      line = source.lineNo
      ucmd=word(line,1)
      if ucmd='' then iterate
      ucmd=upper(ucmd)
      if ucmd = 'PARSE' then stype.LineNo='PARSE'                      ## short cut although it is a precompiler instruction
      else if ucmd = 'IMPORT' then stype.LineNo='IMPORT'               ## keep track of all imported functions plugins
      else if ucmd = 'FOR'    then call cmd_for lineNo,line
      if substr(ucmd,1,2)\='##' then iterate
      if ucmd      = '##DEFINE'  then lineno=cmd_define(lineNo,line)
      else if ucmd = '##MACRO'  then lineno=cmd_macro(lineNo,line)
      else if ucmd = '##INCLUDE' then call cmd_include lineNo,line,1
      else if ucmd = '##LOADMACRO' then call cmd_loadMacro lineNo,line
      else if ucmd = '##BUILDDIR' then stype.LineNo='X'
      else if ucmd = '##EMIT'    then stype.LineNo='EMIT'
      else if ucmd = '##USE'     then call cmd_include lineNo,line,2
      else if ucmd = '##COPYBLOCK' then call cmd_copyBlock lineNo,line
      else if ucmd = '##DATA'    then call cmd_data lineNo,line,word(line,2)
      else if ucmd = '##INPUT'   then call cmd_data lineNo,line,"input"
 ##     else if ucmd = '##PARSE'   then stype.LineNo='PARSE'
      else if ucmd = '##ARRAY'   then call cmd_array  lineNo,line
      else if ucmd = '##GLOBAL'  then call cmd_global lineNo,line
      else if substr(ucmd,1,5) = '##SYS'   then call cmd_data lineNo,line, substr(ucmd,3)
##       else if ucmd = '##????' then do    ## for any new pre compile statement
##       end
   end
return
/* ------------------------------------------------------------------
 * CMD_loadMacro: Register .rxpm names from an additional directory.
 * The package bodies remain lazy and are read by LoadExternalScriptMacro.
 * ------------------------------------------------------------------
 */
CMD_loadMacro: procedure
  arg line_no=.int,line=.string
  stype.line_no='X'
  path=normalisePath(syspath,word(line,2))
  if right(path,1) \= '/' then path=path'/'
  call registerScriptMacros path
return
/* ------------------------------------------------------------------
 * registerScriptMacros: Add names from PATH and remember their directory.
 * Existing names retain the earlier directory, which defines precedence.
 * ------------------------------------------------------------------
 */
registerScriptMacros: procedure
  arg path=.string
  call macroList path,'rxpm',scriptMacros,1
return
/* ------------------------------------------------------------------
 * Process ##DEFINE command
 * Parses a macro definition and registers the macro in the macro tables.
 * ------------------------------------------------------------------
 */
CMD_define: procedure=.int
   arg line_no=.int,line=.string
   nlino=line_no
   name    = ''
   arglist = ''
   body    = ''
   dspace=0
   mtype=upper(word(line,2))
   if mtype = 'FUNCTION' | mtype='FKT' then def = subword(line, 3)
   if mtype = 'COMMAND' | mtype='CMD' then do
      def = subword(line, 3)
      dspace=1
   end
   else def = subword(line, 2)
   wrd=word(def,1)
   ppi = pos('(', wrd,1)    ## must be in macro name, not in later macro body
   if ppi > 1 then do  /* Format: name(arg1, arg2) body */
      name    = strip(substr(def, 1, ppi - 1))
      ppi2    = pos(')', def,ppi+1)
      if ppi2 = 0 then do
         call rxpp_diag 'error','RXPP_MACRO_MISSING_RPAREN','definition',def
         exit 8
      end
      if ppi2 - ppi - 1<=0 then arglist=''
      else do
         arglist = strip(substr(def, ppi + 1, ppi2 - ppi - 1))
         if dspace=1 then arglist=ConcParms(arglist)
      end
      body= strip(substr(def, ppi2 + 1))
   end
   else do /* Format: name body (no arguments) */
      name = wrd
      body = subword(def, 2)
      arglist=''
   end

/* Remove braces and trim */
   body = strip(body)
   stype.nlino='D'
   do forever
      if body='' then leave
      nlen=length(body)
      if substr(body,nlen,1) \= '\' then leave
      nlino=nlino+1
      if nlino>source.0 then do
         call rxpp_diag 'error','RXPP_MACRO_UNCLOSED','name',name
         exit 8
      end
      nlen=nlen-1
      if nlen>1 then do
         body=strip(substr(body,1,nlen))' ; 'strip(source.nlino)
      end
      else body=strip(source.nlino)
      stype.nlino='D'
   end
   opr=pos('{',body)
   lopr=lastpos('}',body)
   if lopr>0 then body=substr(body,opr+1,lopr-opr-1)
   body=changestr('; ;',body,';')
   body=strip(body)
   if substr(body,1,1)=';' then body=substr(body,2)
   body=strip(body)
   if body = '' | lopr=0 then do
      call rxpp_diag 'error','RXPP_MACRO_EMPTY_BODY','name',name
      exit 8
   end

 /* Register macro */
   name=strip(name)
   if dspace=1 then macro_name = upper(name)' '
   else macro_name = upper(name)'('

   macro_index = 0
   do scan_index=1 to macros_mname.0
      if macros_mname.scan_index = macro_name then do
         macro_index = scan_index
         leave
      end
   end

   if macro_index = 0 then macro_index = macros_mname.0 + 1

   macros_mname.macro_index = macro_name
   macros_margs.macro_index = strip(arglist)
   macros_mbody.macro_index = body
   macros_mspace.macro_index = dspace
return nlino
/* ------------------------------------------------------------------
 * Process ##MACRO command
 * Reads a Macro definition into a macro string
 * ------------------------------------------------------------------
 */
CMD_macro: procedure=.int
    arg line_no=.int, line=.string
    stype.line_no = 'D'
    macname = word(source.line_no,2)
    parms   = subword(source.line_no,3)
    body = ''
    i=.int
    do i=line_no+1 to source.0
       line = strip(source.i)
       stype.i = 'D'
       if upper(word(line,1)) = '##MEND' then leave
       body = body || line || '; '
    end
    call StoreScriptMacro macname, parms, body
    macname = '##'lower(strip(macname,,'#'))
    scriptMacros[scriptMacros[0]+1] = macname
return i
/* ----------------------------------------------------------------------
 * StoreScriptMacro
 *
 * Register a script macro in the canonical internal representation.
 *
 * Both internally defined and externally loaded script macros must pass
 * through this routine so that they are stored identically.
 *
 * macname:
 *     canonical macro name including the ## prefix
 *
 * parms:
 *     parameter definition as found on the ##MACRO statement
 *
 * body:
 *     macro body without ##MACRO / ##MEND
 * ----------------------------------------------------------------------
 */
StoreScriptMacro: procedure=.void
    arg macname=.string, mparms=.string, body=.string
    macname = '##'lower(strip(macname,,'#'))
    mparms = strip(mparms)
    mparms = translate(mparms,,',')
    body = qstripcomment('/*','*/',body)
    scriptMacro.macname       = body
    scriptMacro.macname.parms = mparms
    scriptMacro.macname.calls = 0
return
/* ----------------------------------------------------------------------
 * LoadExternalScriptMacro
 *
 * Load a script macro from the selected macro-library directory first,
 * followed by <syspath>/<macro-name>.rxpm, and store it in
 * scriptMacro. using the same representation as an internal ##MACRO.
 *
 * MACNAME is the canonical macro key and may include the ## prefix.
 *
 * Returns:
 *   0  macro loaded
 *   1  macro file missing / load failed
 * ----------------------------------------------------------------------
 */
LoadExternalScriptMacro: procedure=.int
    arg macname=.string
    file_macname = macname
    body=.string
    if substr(file_macname,1,2) = '##' then file_macname = substr(file_macname,3)
    macro_path = scriptMacroPath.macname
    if macro_path = '' then macro_path = macpath
    macro_file = macro_path || file_macname || '.rxpm'
    if verbose then say 'CRX0171I Script macro 'macname' selected from 'macro_file
    stream = loadtext(macro_file, ';', 'noRaise')
    if pos('-8 OPEN ERROR',stream) > 0 then do
        if macro_path = macpath & syspath \= macpath then do
            macro_file = syspath || file_macname || '.rxpm'
            stream = loadtext(macro_file, ';', 'noRaise')
        end
        if pos('-8 OPEN ERROR',stream) > 0 then do
            scriptMacro.macname.error = 'error'
            scriptMacro.macname.file = macro_file
            call rxpp_diag('warning', 'RXPP_SCRIPT_MACRO_MISSING', 'file', macro_file)
            return 1
        end
    end
    /*
     * First record:
     *
     *     ##MACRO name parms...
     */
    sep = pos(';',stream)
    if sep > 0 then do
        header = strip(substr(stream,1,sep-1))
        body   = substr(stream,sep+1)
        scriptMacro.macname.parms = subword(header,3)
        scriptMacro.macname.parms = translate(scriptMacro.macname.parms,,',')
    end
    else do
        body = stream
        scriptMacro.macname.parms = ''
    end
    /*
     * External files contain the terminating ##MEND; internal macros
     * do not store it.
     */
    mend = pos('##MEND',upper(body))
    if mend > 0 then body = substr(body,1,mend-1)
    body = qstripcomment('/*','*/',body)

    scriptMacro.macname       = body
    scriptMacro.macname.calls = 0
return 0

/* ------------------------------------------------------------------
 * Concatenate all parameters into a comma-separated list.
 * ------------------------------------------------------------------
 */
ConcParms: Procedure=.string
   arg inparm=.string
   sargs=''
   do i=1 to words(inparm)
      sargs=sargs','word(inparm,i)
   end
   if sargs='' then return ''
return substr(sargs,2)
/* ------------------------------------------------------------------
 * Formats pre-compiler statements/macros into annotated comment lines for traceability.
 * ------------------------------------------------------------------
 */
printGen: procedure=.string
  arg line=.string, type=.int
  if printgen_flags='none' then return '' ## suppress all macro call definitions
  if type=1 then return '/* 'line' D*/'   ## DEFINE clause
  if type=2 then return '/* 'line' I*/'   ## INCLUDE clause
  if type=3 then return '/* 'line' S*/'   ## SET clause
  if type=4 then return '/* 'line' IF*/'  ## IF clause
  if type=5 then return '/* 'line' AR*/'  ## Array clause
  if type=6 then return '/* 'line' GL*/'  ## Global clause
  if type=7 then return '/* 'line' SC*/'  ## Sections
  else return '/* rxpp: 'line' */'        ## Macro call
return '/* rxpp: 'line' U*/'
/* ------------------------------------------------------------------
 * Source-map helpers: keep RXPP marker emission and escaping in one place.
 * The compiler consumes the raw @ channel after seeing "options ... srcmap".
 *
 * RXPP edits source[] in place: it inserts generated header lines, includes
 * files, and injects expansion output.  Keep source_origin_*[] in lockstep with
 * source[] so Peter can trace each emitted line back to the source file/line
 * that caused it.  For generated helper lines, the origin is normally copied
 * from the directive or macro call that caused the insertion.
 * ------------------------------------------------------------------
 */
rxpp_set_source_origin: procedure
  arg line_no=.int,file=.string,source_line=.int,line_text=.string
  source_origin_file[line_no]=file
  source_origin_line[line_no]=source_line''
  source_origin_text[line_no]=line_text
return

rxpp_clear_source_origin: procedure
  arg line_no=.int
  source_origin_file[line_no]=''
  source_origin_line[line_no]='0'
  source_origin_text[line_no]=''
return

rxpp_copy_source_origin: procedure
  arg line_no=.int,from_line=.int
  if from_line>0 & source_origin_line[from_line]>0 then do
     source_origin_file[line_no]=source_origin_file[from_line]
     source_origin_line[line_no]=source_origin_line[from_line]
     source_origin_text[line_no]=source_origin_text[from_line]
  end
  else call rxpp_clear_source_origin line_no
return

rxpp_set_source_origin_range: procedure
  arg first_line=.int,line_count=.int,file=.string,first_source_line=.int
  do offset=0 to line_count-1
     line_no=first_line+offset
     call rxpp_set_source_origin line_no,file,first_source_line+offset,source[line_no]
  end
return

rxpp_input_has_srcmap_options: procedure=.int
  do line_no=1 to source.0
     line=lower(strip(source[line_no]))
     if word(line,1)\='options' then iterate
     do option_no=2 to words(line)
        if word(line,option_no)='srcmap' then return 1
     end
  end
return 0

rxpp_cflag_present: procedure=.int
  arg flag=.string
  flag=lower(strip(flag))
  do flag_no=1 to words(cflags)
     if word(cflags,flag_no)=flag then return 1
  end
return 0

rxpp_srcmap_enabled: procedure=.int
  if rxpp_cflag_present('nosrcmap') | rxpp_cflag_present('no-srcmap') then return 0
return 1

rxpp_srcmap_marker: procedure=.string
return '!RXPP_SRCMAP_AT!'

rxpp_srcmap_quote: procedure=.string
  arg text=.string
  text=changestr('@',text,'@@')
  text=changestr('"',text,'""')
return '"'text'"'

rxpp_srcmap_escape: procedure=.string
  arg text=.string
  marker=rxpp_srcmap_marker()
  text=changestr('@',text,'@@')
  text=changestr(marker,text,'@')
return text

rxpp_srcmap_file_hint: procedure=.string
  arg file=.string
return '@'rxpp_srcmap_quote(file)

rxpp_srcmap_line_hint: procedure=.string
  arg line_no=.int,line_text=.string
  if line_no<=0 then return ''
return '@'line_no'l'rxpp_srcmap_quote(line_text)

rxpp_srcmap_source_line: procedure=.int
  arg line_no=.int
  if line_no>0 & source_origin_line[line_no]>0 then return source_origin_line[line_no]
  if line_no<=srcmap_line_offset then return 0
return line_no-srcmap_line_offset

rxpp_srcmap_source_file: procedure=.string
  arg line_no=.int
  if line_no>0 & source_origin_file[line_no]\='' then return source_origin_file[line_no]
return srcmap_source_file

rxpp_srcmap_source_text: procedure=.string
  arg line_no=.int
  if line_no>0 & source_origin_text[line_no]\='' then return source_origin_text[line_no]
return source[line_no]

rxpp_srcmap_span: procedure=.string
  arg source_col=.int,source_len=.int,text=.string
  marker=rxpp_srcmap_marker()
  if source_col<1 then source_col=1
  if source_len<1 then source_len=length(text)
return marker||source_col||'+'||source_len||'{'||text||marker||'}'

rxpp_srcmap_argument_value: procedure=.string
  arg value=.string,relative_col=.int,source_base=.int
  if \rxpp_srcmap_enabled() then return value
  if relative_col<=0 then return value
  if length(value)<1 then return value
return rxpp_srcmap_span(source_base+relative_col,length(value),value)
/* ------------------------------------------------------------------
 * Diagnostic helpers.
 *
 * Pattern for new RXPP warnings/errors:
 *   1. Add one stable RXPP_* key to messages/diagnostics.*.msg.
 *   2. Emit it with rxpp_diag and named parameters.
 *   3. Do not format English text at the call site.
 *
 * Keeping the rendering here lets RXPP share rxc's message catalog files and
 * environment contract while remaining a Level B tool.  The call sites stay
 * small and repeatable for future preprocessor diagnostics.
 * ------------------------------------------------------------------
 */
rxpp_diag: procedure
  arg severity=.string,code=.string,name1='',value1='',name2='',value2='',name3='',value3=''
  say rxpp_diag_text(code,name1,value1,name2,value2,name3,value3)
return

rxpp_diag_text: procedure=.string
  arg code=.string,name1='',value1='',name2='',value2='',name3='',value3=''
  names=.string[]
  values=.string[]
  if name1\='' then do
     names[names[0]+1]=name1
     values[values[0]+1]=value1''
  end
  if name2\='' then do
     names[names[0]+1]=name2
     values[values[0]+1]=value2''
  end
  if name3\='' then do
     names[names[0]+1]=name3
     values[values[0]+1]=value3''
  end
return rxpp_diag_render(code,names,values)

rxpp_diag_render: procedure=.string
  arg code=.string,names=.string[],values=.string[]
  if rxpp_diag_mode()='raw' then return rxpp_diag_render_raw(code,names,values)

  locale=rxpp_diag_effective_locale()
  template=rxpp_diag_cat_lookup(locale,code)
  if template='' & locale\='en_GB' then template=rxpp_diag_cat_lookup('en_GB',code)
  if template='' then return rxpp_diag_render_raw(code,names,values)
return rxpp_diag_render_template(code,template,names,values)

rxpp_diag_mode: procedure=.string
  mode=lower(strip(getenv('CREXX_DIAGNOSTICS')))
  if mode='raw' | mode='machine' | mode='code' then return 'raw'
  if mode='localized' | mode='localised' | mode='text' then return 'localized'
return 'localized'

rxpp_diag_effective_locale: procedure=.string
  locale=strip(getenv('CREXX_DIAGNOSTIC_LOCALE'))
  if locale='' then locale=strip(getenv('LC_ALL'))
  if locale='' then locale=strip(getenv('LC_MESSAGES'))
  if locale='' then locale=strip(getenv('LANG'))
return rxpp_diag_normalize_locale(locale)

rxpp_diag_normalize_locale: procedure=.string
  arg locale=.string
  locale=strip(locale)
  if locale='' then return 'en_GB'
  if upper(locale)='C' | upper(locale)='POSIX' then return 'en_GB'

  dot=pos('.',locale)
  if dot>0 then locale=left(locale,dot-1)
  at=pos('@',locale)
  if at>0 then locale=left(locale,at-1)
  locale=changestr('-',locale,'_')

  if length(locale)=2 then return lower(locale)
  if length(locale)>=5 & substr(locale,3,1)='_' then do
     return lower(substr(locale,1,2))'_'upper(substr(locale,4,2))||substr(locale,6)
  end
  if locale='' then return 'en_GB'
return locale

rxpp_diag_render_template: procedure=.string
  arg code=.string,template=.string,names=.string[],values=.string[]
  rendered=code': '
  cursor=1
  do forever
     open=pos('{',template,cursor)
     if open=0 then do
        rendered=rendered||substr(template,cursor)
        leave
     end
     rendered=rendered||substr(template,cursor,open-cursor)
     close=pos('}',template,open+1)
     if close=0 then do
        rendered=rendered||substr(template,open)
        leave
     end
     pname=substr(template,open+1,close-open-1)
     found=0
     pvalue=''
     do i=1 to names[0]
        if names[i]=pname then do
           found=1
           pvalue=values[i]
           leave
        end
     end
     if found then rendered=rendered||rxpp_diag_escape(pvalue)
     else rendered=rendered||substr(template,open,close-open+1)
     cursor=close+1
  end
return rendered

rxpp_diag_render_raw: procedure=.string
  arg code=.string,names=.string[],values=.string[]
  rendered=code
  do i=1 to names[0]
     rendered=rendered' 'names[i]'="'rxpp_diag_escape(values[i])'"'
  end
return rendered

rxpp_diag_escape: procedure=.string
  arg text=.string
  text=changestr('\',text,'\\')
  text=changestr('"',text,'\"')
  text=changestr('09'x,text,'\t')
  text=changestr('0d'x,text,'\r')
  text=changestr('0a'x,text,'\n')
return text

rxpp_diag_cat_lookup: procedure=.string
  arg locale=.string,code=.string
  template=rxpp_diag_env_lookup(locale,code)
  if template\='' then return template

  template=rxpp_diag_dir_lookup('messages',locale,code)
  if template\='' then return template
  template=rxpp_diag_dir_lookup('../messages',locale,code)
  if template\='' then return template
  template=rxpp_diag_dir_lookup('../../messages',locale,code)
  if template\='' then return template

  if syspath\='' then do
     template=rxpp_diag_dir_lookup(syspath'/messages',locale,code)
     if template\='' then return template
     template=rxpp_diag_dir_lookup(syspath'/../messages',locale,code)
     if template\='' then return template
     template=rxpp_diag_dir_lookup(syspath'/../share/crexx/messages',locale,code)
     if template\='' then return template
  end
return ''

rxpp_diag_env_lookup: procedure=.string
  arg locale=.string,code=.string
  pathlist=strip(getenv('CREXX_MESSAGE_PATH'))
  if pathlist='' then return ''

  first=pathlist
  semi=pos(';',first)
  if semi>0 then first=left(first,semi-1)
  template=rxpp_diag_dir_lookup(strip(first),locale,code)
  if template\='' then return template

  rest=pathlist
  do while rest\=''
     semi=pos(';',rest)
     if semi=0 then do
        part=strip(rest)
        rest=''
     end
     else do
        part=strip(left(rest,semi-1))
        rest=substr(rest,semi+1)
     end
     template=rxpp_diag_dir_lookup(part,locale,code)
     if template\='' then return template
  end
return ''

rxpp_diag_dir_lookup: procedure=.string
  arg directory=.string,locale=.string,code=.string
  if directory='' then return ''
  if right(directory,1)='/' | right(directory,1)='\' then path=directory'diagnostics.'locale'.msg'
  else path=directory'/diagnostics.'locale'.msg'
return rxpp_diag_file_lookup(path,code)

rxpp_diag_file_lookup: procedure=.string
  arg path=.string,code=.string
  catalog=readLines(path,,,'noRaise')
  if catalog[0]=1 & word(catalog[1],1)='-8' then return ''
  do i=1 to catalog[0]
     line=strip(catalog[i])
     if line='' then iterate
     if left(line,1)='#' then iterate
     equals=pos('=',line)
     if equals=0 then iterate
     key=strip(left(line,equals-1))
     if key=code then return strip(substr(line,equals+1))
  end
return ''
/* ------------------------------------------------------------------
 * Implements ##SET: assigns a pre-compiler variable and updates internal flags if needed.
 * ------------------------------------------------------------------
 */
CMD_set: procedure
  arg line_no=.int,incl=.string
  stype.line_no= 'S'
  varn=word(incl,2)
  vind=setvar(varn,DropComment(subword(incl,3)))
  if varn='cflags' then cflags=word(lower(macros_varvalue.vind),1) ## set cflags additionally directly will be used often
return

/* ------------------------------------------------------------------
 * Removes trailing line (##) or block (/*..*/) comments from a value.
 * ------------------------------------------------------------------
 */
dropComment: procedure=.string
  arg varvalue=.string,from=1
  fp1=pos('##',varvalue,from)
  if fp1>1 then varvalue=substr(varvalue,1,fp1-1)
  fp1=pos('/*',varvalue,from)
  if fp1>1 then varvalue=substr(varvalue,1,fp1-1)
return strip(varvalue)
/* ------------------------------------------------------------------
 * CMD_unset: Implements ##UNSET: clears a pre-compiler variable (with exemptions for protected vars).
 * ------------------------------------------------------------------
 */
CMD_unset: procedure
  arg line_no=.int,incl=.string
  stype.line_no= 'S'
  varn=word(incl,2)
  varn=lower(varn)
  if varn='printgen'  then return
  if varn='rxpp_rexx' then return
  if varn='rxpp_date' then return
  i=setvar(varn,'')  ## reset flag
return
/* ------------------------------------------------------------------
 * CMD_include: Implements ##INCLUDE / ##USE: reads and inserts the included file into the source buffer.
 * ------------------------------------------------------------------
 */
CMD_include: procedure
  arg line_no=.int,incl=.string,mode=.int
  stype.line_no= 'I'
  file=word(incl,2)
  rc=.int
  insertat=.int
  file=normalisepath(syspath,file)
  include=.string[]
  /* new=readall(include,file,-1) */
  include=readLines(file,,,'noRaise')
  new=include[0]
  if new=1 & word(include[1],1)='-8' then do
     call rxpp_diag 'error','RXPP_INCLUDE_MISSING','file',file
     call rxpp_diag 'error','RXPP_TERMINATED'
     exit 8
  end
  if push_unique(included_files,file)=0 then return      /* already part of the included list */
  if mode=1 then do
     rc= insert_source(line_no+1,new)
     insertat=line_no
  end
  else do
     linc=source.0
     rc= insert_source(linc+1,new)
     insertat=linc
  end
  do j=1 to new
     insertat=insertat+1
     source.insertat=include.j
     call rxpp_set_source_origin insertat,file,j,include.j
  end
return
/* ------------------------------------------------------------------
 * CMD_emit: emit the contents of a named section queue.
 * ------------------------------------------------------------------
 */
CMD_emit: procedure
    arg line_no=.int, incl=.string
/* ##EMIT section_name is the call to emit the contents of the named section queue.*/
    section_name = word(incl, 2) /* section_name is 2. word, it is actually a queue name */

    if rxqueue("SET", section_name) > 0 then return   /* if section does not exist return. */

    new = queued()          /* get the number of lines in the queue */
    if new = 0 then return  /* nothing to emit */

    call insert_source line_no + 1, new /* insert empty lines into the source buffer */

    do i = 1 to new
       insertat = line_no + i
       source.insertat = peek(i)
       call rxpp_set_source_origin insertat, file, i, source.insertat
    end

return
/* ------------------------------------------------------------------
 * CMD_copyBlock
 * ------------------------------------------------------------------
 */
CMD_copyBlock: procedure=.int
  arg line_no=.int,name=.string
  stype.line_no= 'I'
  bname=upper(word(name,2))

  i=.int
  found=0
  do i=1 to beginName[0]
     if bname \= word(beginName[i],1) then iterate
     found=1
     leave
  end
  if found=0 then return 4
  from=word(beginName[i],2)
  if datatype(from) \= 'NUM' then return 4
  newlines=word(beginName[i],3)
  if datatype(newlines) \= 'NUM' then return 4
  rc=.int
  insertat=.int
  rc= insert_source(line_no+1,newlines)
  insertat=line_no

  do i=0 to newlines-1
     insertat=insertat+1
     source.insertat=beginblock[from+i]
   end
return 0
/* ------------------------------------------------------------------
 * CMD_array: Implements ##ARRAY: expands array declarations into initialization statements.
 * ------------------------------------------------------------------
 */
CMD_array: procedure
   arg line_no=.int,line=.string
   stype.line_no= 'ARRAY'
   line=translate(line,,',')
   line=DropComment(line,3)
   atype=word(line,2)
   if substr(atype,1,1)\='.' then atype='.'atype
   defs=subword(line,3)
   new=words(defs)                       ## check how many arrays have been defined
   if new=0 then return
   rc= insert_source(line_no+1,new)    ## insert new lines, shift buffer
   do i=1 to new                         ## now add the statements
      def=word(defs,i)
      source[lino+i]=def'='atype'[];'
   end
return
/* ------------------------------------------------------------------
 * CMD_global: Implements ##GLOBAL: expands globals and accumulates namespace exposure list.
 * ------------------------------------------------------------------
 */
CMD_global: procedure
   arg line_no=.int,line=.string
   stype.line_no= 'GLOBAL'
   line=translate(line,,',')
   line=DropComment(line,3)
   atype=upper(word(line,2))
   if substr(atype,1,1)='.' then atype=substr(atype,2)
   if atype='INT' | atype='FLOAT' | atype='STRING' | atype='INT[]' | atype='FLOAT[]' | atype='STRING[]'then nop
   else return
   defs=subword(line,3)
   new=words(defs)                       ## check how many arrays have been defined
   if new=0 then return
   rc= insert_source(line_no+1,new)    ## insert new lines, shift buffer
   do i=1 to new                         ## now add the statements
      def=word(defs,i)
      vtemp=translate(def,,'=')
      ivar=word(vtemp,1)
      ival=word(vtemp,2)
      if ival='' then source[lino+i]=ivar'=.'atype
      else source[lino+i]=ivar'=.'atype'; 'def
      globaldef=globaldef' 'ivar
   end
return
/* ------------------------------------------------------------------
 * Load macro names from PATH, Content will loaded if used
 * ------------------------------------------------------------------
 */
macroList: procedure
  arg dir= .string, extension=.string, expose macros=.string[], append=.int
  if append \= 1 then macros=.string[]
  lowalpha='abcdefghijklmnopqrstuvwxyz_0123456789'
  dir=translate(dir,'/','\')
  out=.string[]
  err=.string[]
 ## 'ls 'dir'*.'extension output out error err
 'ls 'dir output out error err
  if out.0 < 1 then return

  do i = 1 to out.0
     file = strip(out[i])
     if file = '' then iterate
   /* Find final extension separator. */
     dot = lastpos('.', file)
     if dot = 0 then iterate
   /* Extract and validate extension. */
     ext = lower(strip(substr(file, dot + 1)))
     if ext \= extension then iterate
   /* Extract filename without directory and extension. */
     slash = max(lastpos('/', file), lastpos('\', file))
     mname = substr(file, slash + 1, dot - slash - 1)
     if mname = '' then iterate
   /* Accept only names consisting of characters in LOWALPHA.
     * TRANSLATE removes the permitted characters; anything left
     * makes the name invalid.
     */
     if strip(translate(mname, , lowalpha)) \= '' then iterate
     candidate = '##'mname
     duplicate = 0
     do existing = 1 to macros[0]
        if macros[existing] = candidate then do
           duplicate = 1
           leave
        end
     end
     /* Later search roots override earlier roots. */
     scriptMacroPath.candidate = dir
     if verbose then say 'CRX0170I Script macro 'candidate' registered from 'dir
     if duplicate = 0 then macros[macros[0] + 1] = candidate
  end
return
/* ------------------------------------------------------------------
 * replaceOnce: Replaces one occurrence of a substring at a given position (or first occurrence).
 * ------------------------------------------------------------------
 */
replaceOnce: procedure=.string
  arg needle=.string,haystack=.string,newstring=.string,position=0
  if position=0 then position=pos(needle,haystack)
  if position<=0 then return haystack
return substr(haystack,1,position-1) || newstring || substr(haystack,position+length(needle))

/* ------------------------------------------------------------------
 * matchParen: Finds the matching ')' for an opening '(' with nesting support.
 * Return position of matching ')' for s[openPos]='(' (balanced).
 * This allows nested parentheses inside computed expressions.
 * ------------------------------------------------------------------
 */
matchParen: procedure=.int
  arg s=.string, openPos=.int
  len = length(s)
  if openPos<1 | openPos>len | substr(s,openPos,1) \= '(' then return 0

  depth = 1
  i = openPos + 1
  do while i <= len
    ch = substr(s,i,1)
    if ch='(' then depth = depth + 1
    else if ch=')' then do
      depth = depth - 1
      if depth = 0 then return i
    end
    i = i + 1
  end
return 0

/* ------------------------------------------------------------------
 * insert_source: Inserts reserved lines into source[]/stype[] and shifts following lines down.
 * the line number is the first line which is shifted,
 * !! it does not mean add empty line after provided line number !!
 * ------------------------------------------------------------------
 */
insert_source: Procedure=.int
  arg at=.int,new=.int,expand='',stemlog=0
  stemlog=0
  rc=arrayInsert(source,at,new)    ## insert new lines, shift buffer
  rc=arrayInsert(stype, at,new)
  rc=arrayInsert(source_origin_file, at,new)
  rc=arrayInsert(source_origin_line, at,new)
  rc=arrayInsert(source_origin_text, at,new)
  i = .int
  do i=0 to new-1                   ## in some cases you want special
     source[at+i]='/* reserved 'at+i i' */'
     stype[at+i]=expand             ## treatment of the new entry for
     /*
      * Default generated-line provenance: an inserted helper line usually
      * comes from the directive immediately above the insertion point.  Include
      * handling overrides this below with the real included file/line.
      */
     if at>1 then call rxpp_copy_source_origin at+i,at-1
     else call rxpp_clear_source_origin at+i
  end                               ## example: no further inspection
  if stemlog=0 then return 0
  say 'Insert 'new' lines at 'at
  say '----------------------------------'
  if at>2 then say '<< 'right(at-2,4,'0') source[at-2]
  if at>1 then say '== 'right(at-1,4,'0') source[at-1]
  do i=at to at+new-1
     say '++ 'right(i,4,'0') source[i]
  end
  say '>> 'right(i,4,'0') source[i]
  say '>> 'right(i+1,4,'0') source[i+1]
return 0                            ## when line is inspected afterwards
/* ------------------------------------------------------------------
 * Insert_line: Writes a line into a reserved slot
 * inserts a reserved line first if needed.
 * ------------------------------------------------------------------
 */
insert_line: procedure=.int
  arg nlino=.int, newline=.string
  if pos('/* reserved',source[nlino])>0 then nop
  else do
     call insert_source nlino,1,'noexp',0
     if pos('/* reserved',source[nlino])=0 then do
        say '++ 'right(nlino,4,'0')' 'newline' overwrites'
        say '++ 'right(nlino,4,'0')' 'source[nlino]
     end
  end
  source[nlino]=newline

return nlino
/* ------------------------------------------------------------------
 * CMD_for: Expands a FOR pseudo-construct into an equivalent REXX looping sequence.
 * ------------------------------------------------------------------
 */
CMD_for: procedure
  arg line_no=.int,line=.string
  line=subword(line,2)
  stype.line_no= 'FOR'
  nlino=line_no+1
  line=qstripcomment('/*','*/',line)
  parts=qsplit(line,';')
  from=parts.1
  condc=parts.2
  step=parts.3
  fromx=qsplit(from,',')
  start=''
  do i=1 to fromx.0
     start=start||fromx.i';'
  end
  stepx=qsplit(step,',')
  update=''
  do i=.int(1) to stepx.0
     update=update||stepx.i';'
  end

  call insert_source nlino,6         ## insert new lines, shift buffer

  select_count=select_count+1
  source[line_no+1]='__first_'select_count'=1'
  source[lino+2]=start
  source[lino+3]='do forever'
  source[lino+4]='   if __first_'select_count'=1 then __first_'select_count'=0'
  source[lino+5]='   else do; 'update'; end'
  source[lino+6]='   if 'condc' then nop; else leave'
  do i=.int(1) to 6
     stype[nlino+i]=' '
  end
return
/* ------------------------------------------------------------------
 * CMD_data: Implements ##DATA blocks: converts lines into array assignments until ##END.
 * ------------------------------------------------------------------
 */
CMD_data: procedure
  arg line_no=.int,line=.string,array=.string
  stype.line_no= 'D'
  j=0
  i = .int
  do i=line_no+1 to source.0
     line=source.i
     if upper(word(line,1))='##END' then leave
     j=j+1
     source.i=array'.'j'='safe_quote(line)
  end
  stype.i='D'   ## set D for ##END
return
/* ------------------------------------------------------------------
 * writeline: Appends a line to outbuf[] after variable injection and OO translation.
 * splitting on backslashes (\)
 * ------------------------------------------------------------------
 */
writeline: procedure
  arg oline=.string
  source_line_no=.int
  source_file=.string
  source_text=.string
  oline=injectVariable(oline)
## just insert line to buffer
   if lino=1 then do
      lino = lino + 1
      outbuf.lino='/* 'copies('-',70)
      lino = lino + 1
      outbuf.lino = ' * PRE Compiled on 'date()' at 'time()
      lino = lino + 1
      outbuf.lino = ' * 'copies('-',70)
      lino = lino + 1
      outbuf.lino=' */'
   end
   if oline='' & outbuf.lino='' then return  ## not more than one blank line
   if rxpp_srcmap_enabled() then do
      source_line_no=rxpp_srcmap_source_line(curlino)
      source_file=rxpp_srcmap_source_file(curlino)
      source_text=rxpp_srcmap_source_text(curlino)
      if source_line_no>0 & oline\='' then do
        /*
         * Peter note: these two emitter calls establish the current original
         * source file and source line before the generated line is written.
         * rxc uses them as the default location for any generated text that is
         * not inside a narrower rxpp_srcmap_span() below.
         */
         lino = lino + 1
         outbuf.lino=rxpp_srcmap_file_hint(source_file)
         lino = lino + 1
         outbuf.lino=rxpp_srcmap_line_hint(source_line_no,source_text)
      end
      /*
       * Peter note: escape every literal @ in generated CREXX after all RXPP
       * source-map helper calls have inserted their private marker token.  The
       * marker is converted back to raw @ here; user/program @ characters become
       * @@ so rxc will treat them as ordinary text.
       */
      oline=rxpp_srcmap_escape(oline)
   end
   lino = lino + 1
   outbuf.lino = oline
  return
/* ------------------------------------------------------------------
 * expandRecursive: Expands a line repeatedly until no further macro substitutions occur.
 * ------------------------------------------------------------------
 */
expandRecursive:  procedure=.string
  arg line=.string,linnum=.int
  old = ''

  word1=lower(word(line,1))
  if substr(word1,1,2)='##' then do
     do k=1 to scriptMacros[0]
        macname=scriptMacros[k]
        /* A scripted directive names one macro. Prefix matching made a macro
         * such as ##ui capture ##ui_node when both packages were present. */
        if word1=macname then return newmacros(macname,line,linnum,1)
     end
  end
  expandlevel=0
  do until old = line | line=''   /* No change → stop */
     old = line
     line = expandLine(line,linnum)  /* Expand one level */
  end
return line
/* ------------------------------------------------------------------
 * expandLine: Expands all macro invocations within a single line (one expansion pass).
 * ------------------------------------------------------------------
 */
expandLine:  procedure=.string
  arg line=.string,linnum=.int
  ucmd=upper(word(line,1))
  if ucmd = '##SET' | ucmd = '##UNSET' then do
     call cmd_set 9999,line
     if pos(' nset',cflags)>0 then return ''
     return printGen(line,3)
  end
  ## if cmt='##' then return line
  ## if cmt='/*' then return line
  ## if pos('(',line,1)=0 then return line   ## if there is no "(" there can't be a macro call
  i=hasMacro(line,macros_mname,1)      ## checks also for ## /*
  do while i>0
     line=resolveMacro(i,line,expandLevel,linnum)
     expandlevel=expandlevel+1
     i=hasMacro(line,macros_mname,i+1)
  end
return line
/* ------------------------------------------------------------------
 * expand new Macros: Expands one macro occurrence by parsing arguments and substituting into the macro body.
 * ------------------------------------------------------------------
 */
newMacros:  procedure=.string
  arg macname=.string,line=.string,linnum=.int,ipi=.int
  original_call=.string
  source_len=.int
  if scriptMacro.macname.error='error' then return line' ## File not available: 'syspath||macname'.rxpm'
  if scriptMacro.macname = '' then do
     rc = LoadExternalScriptMacro(macname)
     if rc \= 0 then do
        missing_file = scriptMacro.macname.file
        if missing_file = '' then missing_file = syspath || strip(macname,,'#') || '.rxpm'
        return line' ## 'rxpp_diag_text('RXPP_SCRIPT_MACRO_MISSING', 'file', missing_file)
     end
  end

  scriptMacroCounter=scriptMacroCounter+1
  if scriptMacroCounter>500 then do
     call rxpp_diag 'warning','RXPP_EXPANSION_LIMIT','count',scriptMacroCounter
     return line
  end

  subparm=substr(line,ipi)
  subparm=subword(subparm,2)
  subparm=translate(subparm,,',')
  inparms=''
  original_call=source[linnum]
  stype[linnum]='D'
  source[linnum]='/* 'source[linnum]' */'
  do kk=1 to words(scriptMacro.macname.parms)
     sword=qword(subparm,kk)
     sword=quote(sword)
     if sword \= '' then inparms=inparms||word(scriptMacro.macname.parms,kk)' = 'sword'; '
  end
/* Prepare RexxScript Call */
   out=.string[]
   result=.string[]
   scriptMacro.macname.calls=scriptMacro.macname.calls+1
   instructionSet=scriptMacro.macname
   _mcalls=scriptMacro.macname.calls
   _sysndx=scriptMacroCounter
   _macro_calls=_sysndx
   _date=date()
   _time=time('l')
   _macro=macname
   _mline=source_origin_text[linnum]
   _mlino=source_origin_line[linnum]
   _file=getvar('rxpp_rexx')
   _module=rxmodule
   if pos(' maclog',cflags)>0 then do
      REXXSCRIPT inparms' 'instructionSet EXPOSE _sysndx, _macro_calls, _file, _module, _date, _time, _macro, _mline, _mlino, _mcalls OUTPUT out RESULT result debug
   end
   else do
     REXXSCRIPT inparms' 'instructionSet EXPOSE _sysndx, _macro_calls, _file, _module, _date, _time, _macro, _mline, _mlino, _mcalls OUTPUT out RESULT result /* DEBUG */
   end
   if result[1]='OK' then nop
   else do
      say '/// Macro Error at line : '_mlino
      say '/// Macro Call          : '_mline
      say '/// Error Message       : 'result.1
   end
/* Logging of rexxscript just for debugging */
  if pos(' maclog',cflags)>0 then do
     do k=1 to result.0
        say "Script Result" k result.k
     end
  end

  main_insert = 0
  tail_insert = 0
  source_len  = length(original_call)

  do kk = .int(1) to out[0]
     line = changestr("''", out[kk], "")
     testline = strip(line, 'L')
     if left(testline, 10) = '@.section@' then do
        call add_section line
        iterate
     end
     if left(testline, 7) = '@.main@' then do
        main_insert = main_insert + 1
        p = pos('@.main@', line)
        out[kk] = substr(line, p + 7)
        iterate
     end
     if left(testline, 7) = '@.tail@' then do
        tail_insert = tail_insert + 1
        if tail_insert = 1 then source[source[0] + 1] = '/* Appended by 'original_call' */'
        p = .int
        p = pos('@.tail@', line)
        source[source[0] + 1] = substr(line, p + 7)
        if rxpp_srcmap_enabled() then source[source[0]] = rxpp_srcmap_span(1, source_len, source[source[0]])
        iterate
     end
  end
  rc = .int
  rc= insert_source(linnum+1,out[0]-tail_insert+1)
  inew=linnum+1
  source_len=length(original_call)
  do kk=.int(1) to out[0]
     if pos('@.tail@',out[kk])>0 then iterate
     if pos('@.section@',out[kk])>0 then iterate
     /*
      * RexxScript-backed script macros can produce arbitrary output text.  RXPP
      * does not know token-level provenance inside that script output, so the
      * repeatable rule is to map each emitted line to the whole script-macro
      * invocation.  Future per-token script metadata can narrow this later.
      */
     if rxpp_srcmap_enabled() then do
        /*
         * Peter note: RexxScript macros currently provide line-level output
         * only, so each emitted line is mapped to the whole script-macro
         * invocation.  When RexxScript reports token provenance, this is the
         * place to replace the coarse span with narrower spans.
         */
        out[kk]=rxpp_srcmap_span(1,source_len,out[kk])
     end
     inew=inject2Source(inew+1,3,out[kk])
  end
return source[linnum]

add_section: procedure
   arg line=.string
   marker='@.section@'
   if left(line,length(marker)) \= marker then return
   /* Everything after @.section@ is:
    *     section-name@payload
    * The payload is deliberately NOT stripped because leading
    * blanks may represent indentation in generated source.
    */
   rest=substr(line,length(marker)+1)
   separator=pos('@',rest)
   if separator=0 then return
   section_name=strip(substr(rest,1,separator-1))
   if section_name='' then return
   section_line=substr(rest,separator+1)
   call rxqueue 'SETX',section_name
   QUEUE section_line
return




/* ------------------------------------------------------------------
 * resolveMacro: Expands one macro occurrence by parsing arguments and substituting into the macro body.
 *     line is input line
 *     i    contains macro index to resolve line
 * ------------------------------------------------------------------
 */
resolveMacro: procedure=.string
   arg i=.int, line=.string,level=.int,linnum=.int
   ppl=lastpos('##',line)       ## ending comment, if any
   if ppl>1 then line=substr(line,1,ppl-1)
   uline   = upper(line)
   callPos = 0
   /* load the macro header and definition */
   name    = macros_mname.i    ## macro name
   args    = macros_margs.i    ## macro arguments
   body    = macros_mbody.i    ## macros body {...}
   mspace  = macros_mspace.i   ## macro type, 1 is a sapce type, 0, normal, parms are separated by ","

   body=injectVariable(body)    ## inject pre-compiler variables, if there are any
   mexpanded=mexpanded+1
   ## test Macro is variadic
   isVariadic=.int
   if pos('...', args,1) > 0 then do
      isVariadic = 1
      args = strip(changestr('...', '', args))
   end
   else isVariadic = 0
   if mspace=1 then do   ## command macros have stricter rule, they must be the first word of the line and they can't be nested
      if word(uline,1) \=strip(name) then return line  ## not a valid command macro call
   end
   do forever
      callpos=pos(name, uline, callPos + 1)        ## search position of macro in input line
      if callpos=0 then leave                      ## nothing there, leave
    ## now we know macro is part of the line
       if printgen_flags='all' then call writeline printGen(strip(line),0)     ## some logging if wanted
       else if level=0 & printgen_flags='nnest' then call writeline printGen(strip(line),0)
       level=level+1     ## increase level in case a second instance of macro is found
    ## check which char is prior the macro call
       if callpos>1 then do
          status_before=verify(substr(uline,callpos-1,1), alphaN, 'N')
          if status_before=0 then iterate
       end
    ## move remaing line, which is the argument list of the macro
       remain  = substr(line, callPos + length(name))    ## set to parameter part, macro has format name( +length positions into it
    ## extract argument list
       argtext = fetchArguments(remain)
       if mspace=1 then argtext=ConcParms(argtext)
       callargcount = parseArgList(argtext)
       bodyExp = body
       if isVariadic then return variadic(bodyExp, callargcount, argtext)
    /* Here is the non variadic processing */
       bodyExp = replaceFixArg(bodyExp, name,args,callargcount,callpos+length(name)-1)
       if substr(bodyexp,1,3)='+++' then return bodyexp  ## +++ error occurred in call
       callLen = length(name) + 1 + length(argtext)  /* inkl. len(name()+1 for ) */
       if rxpp_srcmap_enabled() then do
          /*
           * Peter note: this outer span maps generated replacement text back to
           * the macro call itself.  replaceFixArg() may already have inserted
           * narrower spans for substituted arguments; rxc chooses the narrowest
           * enclosing span when a diagnostic lands inside the expansion.
           */
          bodyExp=rxpp_srcmap_span(callpos,callLen,bodyExp)
       end
       line=splice(bodyexp,line,callpos,callLen)  ## line=insertatc(bodyexp,line,callpos,callLen)
       if mspace= 1 then leave        /* nesting for command macros are not permitted */
       uline    = upper(line)         /* update uline for repetition */
       callPos  = callPos - 1         /* set next start point */
    end
return line
/* ------------------------------------------------------------------
 * injectVariable: Injects pre-compiler variables ({var}) into text lines.
 * ------------------------------------------------------------------
 */
injectVariable: procedure=.string
  arg line2change=.string
  fp1=pos('{',line2change,1)>0
  fp2=pos('}',line2change,fp1+1)
  do while fp1>0 & fp2>0
     cmt=substr(strip(line2change),1,2)
     if cmt='/*' | cmt='##' then leave
     do i=1 to macros_varname.0
        if macros_varname.i='' then iterate
        Line2change=ChangeStr(macros_varname.i,line2change,macros_varvalue.i)
     end
     fp1=pos('{',line2change,fp2+1)>0
     fp2=pos('}',line2change,fp2+1)
  end
return line2change
/* ------------------------------------------------------------------
 * replaceFixArg: Substitutes fixed macro parameters with supplied call arguments (positional + keyword).
 * ------------------------------------------------------------------
 */
replaceFixArg: Procedure=.string
  arg bodyexp=.string,macname=.string, xargs=.string,callargcount=.int,source_base=.int
  iargs=xargs

  xargs   = translate(xargs, , ',')
  wrds=words(xargs)
  if wrds\=callargcount then do    ## callargs.0 is may be not set properly
     if pos(' strictmacrocheck',cflags)>0 then do
        call writeline '## +++++ macro 'macname' call parameters do not match with template'
        call writeline '## +++++ template 'quote(xargs)
        say '+++++ macro 'macname' call parameters do not match with template'
        say '+++++ template 'quote(xargs)
     end
  end
 ## First take the positional parameters
  keypositional=0
  do k=1 to wrds
     aname = word(xargs, k)
     if pos('=',aname)>0 then do
        if keypositional=0 then keypositional=k
        iterate
     end
     if keypositional>0 then do
        call rxpp_diag 'error','RXPP_POSITIONAL_AFTER_KEYWORD','macro',macname,'arguments',iargs
        return '+++ 'rxpp_diag_text('RXPP_POSITIONAL_AFTER_KEYWORD','macro',macname,'arguments',iargs)
     end
     aval=callargs.k
     /*
      * Peter note: wrap each positional argument value before substitution.
      * If the expanded body later fails in rxc, the inner span points at the
      * original argument expression rather than only the full macro call.
      */
     aval=rxpp_srcmap_argument_value(aval,callargs_source_col.k,source_base)
     bodyExp = replaceArg(bodyExp, aname, aval)   ## replace macro variable by value in callargs.k
   end
  if keypositional=0 then return bodyExp
## now that we know we have keyword paramters, we need to translate tso-style call back to key= syntax
  do i=1 to callargcount
       callargs.i=tso2func(callargs.i)
  end
## start matching macro definition parm list to calling parameters (keywords only)
  do k=.int(keypositional) to wrds        ## run through the macroc header definition
     aname = .string
     aname = translate(word(xargs, k),,'=')         ## aname is the keyword definition in the macro header
     adefault=word(aname,2)                        ## 2. word is the default value
     if adefault='' then adefault="''"             ## if not there, use empty string
     aname=word(aname,1)                           ## now isolate parameter name
     j = 0
     do j=1 to wrds                  ## find the appropriate keyword, sequence is free
        if fpos(aname'=',callargs.j,1)>0 then leave    ### +++++++++++ modify  ## use fpos function to search case-insensitive
     end
     aval = .string
     aval=callargs.j                       ## identifies the call of the macro
     value_source_col=0
     if pos('=',aval)=0 then aval=adefault ## if keyword is not defined use the default in the macro def part
     else do                               ## if so check if the keyword call is also in the value clause
        value_source_col=callargs_source_col.j+pos('=',aval)
        aval=translate(aval,,'=')
        aval=subword(aval,2)
     end
     /*
      * Peter note: keyword defaults are generated text and therefore stay on
      * the outer macro-call span.  Supplied keyword values get a narrower span
      * starting after the '=' or TSO-style '(' in the original call argument.
      */
     aval=rxpp_srcmap_argument_value(aval,value_source_col,source_base)
     bodyExp = replaceArg(bodyExp, aname, aval)
  end
return bodyExp
/* ------------------------------------------------------------------
 * tso2func: Normalizes TSO-style keyword arguments to function-style key=value syntax.
 * ------------------------------------------------------------------
 */
tso2func: procedure=.string
  arg inparm=.string
  pp1=pos('(',inparm)
  if pp1=0 then return inparm
  pp2=lastpos(')',inparm)
  inparm=overlay('=',inparm,pp1)
  if pp2>1 then inparm=substr(inparm,1,pp2-1)
return strip(inparm)
/* ------------------------------------------------------------------
 * variadic: Expands variadic macros (macros with ... arguments) into repeated generated statements.
 * ------------------------------------------------------------------
 */
variadic: procedure=.string
  arg bodyExp=.string, callArgCount=.int, argText=.string

  /* Normalize argument text */
  argText  = translate(argText, , ',')
  varCount = callArgCount - 1

  /* Extract left-hand side (e.g., result = ...) */
  tempBody = translate(bodyExp, , '.=')
  lhs      = word(tempBody, 1)
  ix       = word(tempBody, 2)

  /* Extract the remaining expression */
  tempBody = translate(bodyExp, , '=')
  remain   = subword(tempBody, 2)

  /* Replace the primary macro parameters */
  if pos('arglist',lhs)>0 then inc=0
  else do
     bodyExp  = replaceArg(bodyExp, lhs, word(argText, 1))      /* fixed first argument */
     bodyExp  = replaceArg(bodyExp, 'argcount', varCount)
     inc=1
  end
  originalBody = bodyExp  /* store original for each iteration */
  /* Loop through variadic arguments */
  do k = 1 to varCount
     value   = word(argText, k + 1)
     bodyExp = replaceArg(bodyExp, '$indx', k)
     bodyExp = replaceArg(bodyExp, 'arglist.'k, value)
     call writeline bodyExp
     bodyExp = originalBody  /* reset to base form for next iteration */
  end

  /* Final run with index = 0 (optional placeholder reset) */
  bodyExp = replaceArg(bodyExp, '$indx', 0)

  /* Extract final left-hand side for return */
  finalBody = translate(bodyExp, , '=')
  lhs       = word(finalBody, 1)
  remain    = word(finalBody, 2)

  if remain = '' then return ''  /* empty body check */
  return ''
  ## return lhs '=' varCount   ## set variable.0 not allowed in level b
/* ------------------------------------------------------------------
 * debugArgs: Debug helper to print macro call arguments (usually disabled).
 * ------------------------------------------------------------------
 */
debugArgs:  procedure
  arg name=.string,args=.string,callargcount=.int
  say '--- DEBUG ---'
  say 'Macro Name: ' name
  say 'Macro Args: ' args
  say 'Argtext:     ' argtext
  do k = 1 to callargcount
     say 'callargs.'k' = 'callargs.k
  end
  say 'Before Replace: ' body
return
/* ------------------------------------------------------------------
 * fetchArguments: Extracts a macro argument list, handling nested parentheses.
 * ------------------------------------------------------------------
 */
fetchArguments: procedure=.string
  arg remain=.string

  argText = ''
  depth   = 1  /* Initial open parenthesis already passed before this call */

  do j = 1 to length(remain)
     c = substr(remain, j, 1)
     if c = '(' then depth = depth + 1
     if c = ')' then do
        depth = depth - 1
        if depth = 0 then leave  /* finished parsing full argument expression */
     end
     argText = argText || c
  end
  return strip(argText)
/* ------------------------------------------------------------------
 * Replace Argument in Macro Call
 * ------------------------------------------------------------------
 */
 /* old Version
replaceArgx: procedure=.string
  arg str=.string, name=.string, value=.string

  posn = 1
  p = pos(name, str, 1)
