#!/bin/sh
set -eu
# macOS Installer supplies target volume as $3. Receipts/discovery below refer
# to the startup volume only; never accidentally write to it for another target.
[ "${3:-/}" = / ] || { echo 'Install llama.rexx on the startup volume.' >&2; exit 1; }
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
/bin/sh "$here/manage.sh" check
