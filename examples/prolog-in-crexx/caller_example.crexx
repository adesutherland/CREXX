options levelb
import prolog

say "=== calling a prolog predicate with parameters and getting a value back ==="
call prolog..PrologConsultString "factorial(0,1) :- !. factorial(N,F) :- N>0, N1 is N-1, factorial(N1,F1), F is N*F1."
result = prolog..PrologCallGet("factorial(6, X)", "X")
say "factorial(6) =" result

say ""
say "=== lower-level PrologCall + PrologGetVar ==="
ok = prolog..PrologCall("factorial(10, X)")
say "call ok=" ok
say "X =" prolog..PrologGetVar("X")

say ""
say "=== consulting a family tree and finding all grandchildren ==="
call prolog..PrologConsultString "parent(tom,bob). parent(bob,ann). parent(tom,liz). parent(liz,pat). grandparent(X,Z):-parent(X,Y),parent(Y,Z)."
n = prolog..PrologFindAll("grandparent(tom, X)", "X")
say "found" n "grandchildren of tom:"
do i = 1 to n
  say "  " prolog..PrologFindAllNth(i)
end

say ""
say "=== a failing call ==="
ok2 = prolog..PrologCall("factorial(6, 999)")
say "factorial(6,999) call ok=" ok2

say ""
say "=== PrologReset then confirm the family facts are gone ==="
call prolog..PrologReset
ok3 = prolog..PrologCall("parent(tom, bob)")
say "parent(tom,bob) after reset, ok=" ok3

say ""
say "=== the OTHER direction: Prolog calling back into CREXX ==="
say "(via crexx_call/2,3 -- see crexxcallback.crexx; this build uses"
say " the shipped default stub, which implements 'hello' and 'double')"
r1 = prolog..PrologCallGet("crexx_call(hello, R)", "R")
say "crexx_call(hello, R) -> R =" r1
ok4 = prolog..PrologCall("crexx_call(double, 21, R)")
say "crexx_call(double, 21, R) call ok=" ok4 " R=" prolog..PrologGetVar("R")
exit 0
