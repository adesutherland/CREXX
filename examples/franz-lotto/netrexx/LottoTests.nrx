/* Model and outputFile checks: java -cp ".;NetRexxC.jar" LottoTests */
options binary
import java.util.Random
import java.io.File
import java.io.IOException
import java.nio.outputFile.Files

class LottoTests
  method check(ok=boolean,label=String) static
    if \ok then signal IllegalStateException(label)

  method validatePool(text=String,needed=int,maximum=int) static
    words=text.split(' ')
    previous=int 0
    loop i=0 to needed-1
      value=Integer.parseInt(words[i])
      check(value>previous & value<=maximum,'range, order, uniqueness')
      check(words[i].length=2,'two-digit formatting')
      previous=value
    end

  method main(args=String[]) static
    check(LottoModel.parseCount('1')=1,'minimum')
    check(LottoModel.parseCount('50')=50,'maximum')
    check(LottoModel.parseCount('05')=5,'leading zero')
    check(LottoModel.parseCount('')=0,'empty')
    invalid=String '0 00 51 99 -1 1.5 100 abc +1 1e1'
    loop value over invalid.split(' ')
      check(LottoModel.parseCount(value)=0,'invalid field')
    end
    rng=java.util.Random(12345)
    loop game=1 to 3
      loop count=1 to 50
        tips=LottoModel.generate(game,count,rng)
        check(tips.length=count,'tip count')
        loop line over tips
          needed=int 6
          maximum=int 45
          if game=2 then maximum=49
          if game=3 then do
            needed=5
            maximum=50
          end
          validatePool(line,needed,maximum)
          if game=3 then do
            parts=line.split(' \\+ ')
            check(parts.length=2,'Euro pools')
            validatePool(parts[1],2,12)
            check(line.split(' ').length=8,'Euro width')
          end
          else check(line.split(' ').length=6,'six balls')
        end
      end
    end
    check(LottoModel.generate(0,1,rng).length=0,'invalid game')
    check(LottoModel.generate(1,0,rng).length=0,'invalid count')
    folder=File(System.getProperty('java.io.tmpdir'),'lotto-model-' || System.nanoTime())
    check(folder.mkdir(),'temporary folder')
    outputFile=File(folder,'tips.txt')
    tips=LottoModel.generate(3,3,rng)
    LottoModel.save(outputFile.getPath,3,tips)
    lines=java.nio.file.Files.readAllLines(outputFile.toPath)
    check(lines.size=4,'saved count')
    check(lines.get(1).equals('01: ' || tips[0]),'saved first tip')
    tips=LottoModel.generate(1,1,rng)
    LottoModel.save(outputFile.getPath,1,tips)
    check(java.nio.file.Files.readAllLines(outputFile.toPath).size=2,'replacement truncates')
    failed=boolean 0
    do
      LottoModel.save(File(folder,'missing/tips.txt').getPath,1,tips)
    catch IOException
      failed=1
    end
    check(failed,'save failure')
    outputFile.delete()
    folder.delete()
    System.out.println('PASS: NetRexx Lotto (3825 tips; validation, save, replace, failure)')
