/* NetRexx Swing Lotto window. MIT License; see ../LICENSE.txt.
 * Start reading here: build the controls, attach button listeners, and then
 * handle each action. All Swing work stays on Java's event-dispatch thread.
 * LottoModel owns the rules; no HTML or Java bridge is needed.
 */
options binary
import javax.swing.
import java.awt.
import java.awt.event.
import java.util.Random
import java.io.File
import java.io.IOException

class LottoWindow extends JFrame implements ActionListener
  properties private
    austria=JRadioButton('Austria: 6 from 45',1)
    germany=JRadioButton('Germany: 6 from 49')
    euro=JRadioButton('Euro-Lotto: 5 from 50 + 2 from 12')
    countField=JTextField('10',3)
    generateButton=JButton('Generate')
    saveButton=JButton('Save...')
    quitButton=JButton('Quit')
    output=JTextArea(16,54)
    status=JLabel('Choose a game, enter 1-50 tips, then Generate.')
    tips=String[0]
    generatedGame=int 1
    rng=java.util.Random()

  method LottoWindow()
    super('NetRexx Lotto - teaching example')
    setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE)
    group=ButtonGroup()
    group.add(austria)
    group.add(germany)
    group.add(euro)
    choices=JPanel(GridLayout(3,1,0,3))
    choices.setBorder(BorderFactory.createTitledBorder('Choose one game'))
    choices.add(austria)
    choices.add(germany)
    choices.add(euro)
    controls=JPanel(FlowLayout(FlowLayout.LEFT))
    controls.add(JLabel('Tips (1-50):'))
    controls.add(countField)
    controls.add(generateButton)
    controls.add(saveButton)
    controls.add(quitButton)
    saveButton.setEnabled(0)
    generateButton.addActionListener(this)
    saveButton.addActionListener(this)
    quitButton.addActionListener(this)
    countField.addActionListener(this)
    top=JPanel(BorderLayout())
    top.add(choices,BorderLayout.CENTER)
    top.add(controls,BorderLayout.SOUTH)
    output.setEditable(0)
    output.setFont(Font(Font.MONOSPACED,Font.PLAIN,14))
    output.setMargin(Insets(8,8,8,8))
    bottom=JPanel(BorderLayout(0,6))
    bottom.add(status,BorderLayout.NORTH)
    bottom.add(JLabel('Game choices from Franz Marx. A recreational learning example.'),BorderLayout.SOUTH)
    content=JPanel(BorderLayout(8,8))
    content.setBorder(BorderFactory.createEmptyBorder(10,10,10,10))
    content.add(top,BorderLayout.NORTH)
    content.add(JScrollPane(output),BorderLayout.CENTER)
    content.add(bottom,BorderLayout.SOUTH)
    setContentPane(content)
    getRootPane.setDefaultButton(generateButton)
    pack()
    setMinimumSize(Dimension(600,420))
    setLocationRelativeTo(null)

  method selectedGame returns int
    if germany.isSelected then return 2
    if euro.isSelected then return 3
    return 1

  method actionPerformed(event=ActionEvent)
    source=event.getSource
    if source=quitButton then dispose()
    else if source=saveButton then chooseSave()
    else if source=generateButton | source=countField then generate()

  method generate
    count=LottoModel.parseCount(countField.getText)
    if count=0 then do
      status.setText('Enter a whole number from 1 to 50. Results kept.')
      countField.requestFocusInWindow()
      countField.selectAll()
      return
    end
    generatedGame=selectedGame()
    tips=LottoModel.generate(generatedGame,count,rng)
    output.setText(LottoModel.format(generatedGame,tips))
    output.setCaretPosition(0)
    saveButton.setEnabled(1)
    status.setText('Generated ' || count || ' tips. Scroll for all results; Save writes a outputFile.')

  method chooseSave
    chooser=JFileChooser()
    chooser.setDialogTitle('Save the generated Lotto tips')
    chooser.setSelectedFile(File('Lotto-Tipps-NetRexx.txt'))
    if chooser.showSaveDialog(this)<>JFileChooser.APPROVE_OPTION then return
    outputFile=chooser.getSelectedFile
    if outputFile.exists then do
      answer=JOptionPane.showConfirmDialog(this,'Replace the existing outputFile?', -
        'Confirm replacement',JOptionPane.YES_NO_OPTION)
      if answer<>JOptionPane.YES_OPTION then return
    end
    saveTo(outputFile)

  method saveTo(outputFile=File)
    do
      LottoModel.save(outputFile.getPath,generatedGame,tips)
      status.setText('Saved: ' || outputFile.getAbsolutePath)
    catch IOException
      status.setText('Save failed. Check the path and folder permissions; results kept.')
    end

  -- This exercises the real Swing controls and their registered listeners.
  -- Called on the event-dispatch thread by LottoGuiTests, not during normal use.
  method exerciseControls
    LottoTests.check(austria.isSelected & \germany.isSelected & \euro.isSelected,'default game')
    LottoTests.check(\saveButton.isEnabled,'no startup save')
    germany.doClick()
    LottoTests.check(germany.isSelected & \austria.isSelected & \euro.isSelected,'exclusive Germany')
    euro.doClick()
    LottoTests.check(euro.isSelected & \germany.isSelected & \austria.isSelected,'exclusive Euro')
    countField.setText('50')
    generateButton.doClick()
    LottoTests.check(tips.length=50 & generatedGame=3,'Generate 50 Euro tips')
    LottoTests.check(output.getText.contains('50: '),'last result visible in scrollable output')
    previous=output.getText
    countField.setText('0')
    generateButton.doClick()
    LottoTests.check(output.getText.equals(previous),'invalid count preserves results')
    LottoTests.check(status.getText.startsWith('Enter a whole number'),'validation message')
    austria.doClick()
    countField.setText('1')
    countField.postActionEvent()
    LottoTests.check(tips.length=1 & generatedGame=1,'Enter generates Austria')
    folder=File(System.getProperty('java.io.tmpdir'),'lotto-gui-' || System.nanoTime())
    LottoTests.check(folder.mkdir(),'temporary folder')
    outputFile=File(folder,'tips.txt')
    germany.doClick() /* selection must not relabel previously generated tips */
    saveTo(outputFile)
    do
      LottoTests.check(java.nio.file.Files.readAllLines(outputFile.toPath).get(0).toString.contains('Austria'),'saved game matches generated tips')
    catch IOException
      LottoTests.check(0,'cannot inspect saved GUI results')
    end
    LottoTests.check(outputFile.isFile & status.getText.startsWith('Saved:'),'GUI save')
    outputFile.delete()
    folder.delete()
    saveTo(File(folder,'missing/tips.txt'))
    LottoTests.check(status.getText.startsWith('Save failed'),'GUI save failure')
    generateButton.doClick()
    LottoTests.check(status.getText.startsWith('Generated'),'usable after failure')
    quitButton.doClick()
    LottoTests.check(\isDisplayable(),'Quit disposes window')

  method main(args=String[]) static
    SwingUtilities.invokeLater(LottoLauncher())

class LottoLauncher private implements Runnable
  method run
    LottoWindow().setVisible(1)
