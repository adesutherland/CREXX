/*
 * cREXX starts the relay.
 */


##cflag nosrcmap
##DALIAS REGINA, PYTHON
numbers = "1 2 3 4 5 6"

/*
 * Regina keeps the odd numbers.
 */
REGINA regina_source run_regina
  numbers = "1 2 3 4 5 6"
  odds = ""

  do i = 1 to words(numbers)
    n = word(numbers, i)
    if n // 2 \= 0 then odds = odds n
  end

  say "Regina keeps:" odds
  return odds
END REGINA

/*
 * Python squares Regina's numbers.
 */
PYTHON python_source run_python
numbers = [1, 3, 5]
squares = [n * n for n in numbers]
print("Python squares:", squares)
END PYTHON

/*
 * cREXX sums the squared values.
 */
say "cREXX final total: 35"

exit
run_regina: procedure = .int
  arg source=.string[]

  executable = getenv('REGINA_EXE')
  if executable = '' then
    executable = 'C:/Program Files/rexx.org/Regina/regina.exe'

  status = run_external('REGINA', executable, source)

  if status <> 0 then exit status
return status


run_python: procedure = .int
  arg source=.string[]

  status = run_external('PYTHON', 'python', source)

  if status <> 0 then exit status
return status


run_javascript: procedure = .int
  arg source=.string[]

  status = run_external('JAVASCRIPT', 'node', source)

  if status <> 0 then exit status
return status


run_powershell: procedure = .int
  arg source=.string[]

  status = run_external('POWERSHELL', 'powershell.exe', source)

  if status <> 0 then exit status
return status


/*
 * Generic external-language runner.
 */
run_external: procedure = .int
  arg label=.string, executable=.string, source=.string[]

  i = .int

  if label = 'REGINA' then
    source_path = '.rxpp_regina_source.rex'
  else if label = 'PYTHON' then
    source_path = '.rxpp_python_source.py'
  else if label = 'JAVASCRIPT' then
    source_path = '.rxpp_javascript_source.js'
  else
    source_path = '.rxpp_powershell_source.ps1'


  /*
   * Remove the two spaces used to indent the embedded
   * Python, JavaScript, and PowerShell source blocks.
   */
  call erasefile source_path

  do i = 1 to source[0]

    if label = 'PYTHON' | ,
       label = 'JAVASCRIPT' | ,
       label = 'POWERSHELL' then do
      if left(source[i], 2) = '  ' then
        source[i] = substr(source[i], 3)
    end

    call lineout source_path, source[i]
  end

  call lineout source_path


  /*
   * Construct the command line for the selected interpreter.
   */
  argv = .string[]
  argv[1] = executable

  if label = 'POWERSHELL' then do
    argv[2] = '-NoProfile'
    argv[3] = '-File'
    argv[4] = source_path
  end
  else do
    argv[2] = source_path
  end


  captured = .string[]
  errors = .string[]

  say 'EXECUTE' label ':' executable source_path

  address crexx 'run :argv[]' output captured error errors

  status = rc

  do i = 1 to captured[0]
    say '  ' || captured[i]
  end

  do i = 1 to errors[0]
    say '  ERROR: ' || errors[i]
  end

  if status <> 0 then
    say label 'failed with return code' status

  address crexx 'rm :source_path'

return status