/*
 * cREXX native user interaction example.
 *
 * Demonstrates the simple user interaction services provided by the
 * system .Os class.  The services use the native facilities of the
 * host operating system; applications do not depend on a particular
 * GUI toolkit.
 *
 * The example demonstrates:
 *
 *   message()  - display an informational message
 *   warning()  - display a warning
 *   error()    - display an error
 *   confirm()  - request a Yes/No decision
 *   input()    - request text from the user
 *
 * The calls are synchronous: execution continues after the user has
 * responded to the displayed dialog.
 */

options levelb comments_dash
import system

main: procedure
  x = .Os()
  answer = x.directory("What DIR do you want?","C:\temp")
  call x.message("You selected: "answer)
 file = x.file("Select an input file:", 0, answer)
   call x.message("You selected File: "file)

  /*
   * Display a simple informational message.
   */
  call x.message("Hello from cREXX - Cheers from Munich!")
 
  /*
   * Warning and error messages have the same simple calling convention
   * as message(), but allow the host platform to present the appropriate
   * native severity indication.
   */
  call x.warning("This is a warning message.")

  call x.error("This is an error message.")

  /*
   * Ask the user for a Yes/No decision.
   *
   * confirm() returns 1 when Yes is selected and 0 when No is selected.
   */
  answer = x.confirm("Shall we continue?")

  if answer = 1 then
    call x.message("You selected Yes.")
  else
    call x.message("You selected No.")

  /*
   * Request a string from the user.
   *
   * input() returns the entered text.  An empty string means that the
   * dialog was cancelled or that no text was entered.
   */
  name = x.input("Please enter your name:")

  if name = "" then do
    call x.warning("No name was entered.")
  end
  else do
    call x.message("Hello " || name || " - Cheers from Munich!")
  end

  return
