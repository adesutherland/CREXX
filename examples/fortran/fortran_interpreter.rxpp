/*
 * cREXX FORTRAN IV sample
 * -----------------------
 *
 * RXPP captures the fixed-format guest program between FORTRAN RUN and
 * END FORTRAN. RXPP then invokes fortran_run automatically; the runtime is
 * supplied by the imported fortran module.
 *
 * The guest program demonstrates declarations, DATA, labeled DO loops,
 * arithmetic IF, array subscripting, and list-directed WRITE.
 */
options levelg
##cflag nosrcmap
import fortran
##external fortran

/* The following block is FORTRAN source, not cREXX source. */
FORTRAN RUN
       PROGRAM MATRIX
       INTEGER I,J
       REAL A(3,3),X(3),Y(3)
       REAL SUM,MEAN,MAXIMUM

       DATA A / 2.0,1.0,0.0,
      1         1.0,2.0,1.0,
      1         0.0,1.0,2.0 /

       DATA X / 1.0,2.0,3.0 /

C     Calculate Y = A * X
       DO 100 I = 1,3
       Y(I) = 0.0
       DO 90 J = 1,3
       Y(I) = Y(I) + A(I,J) * X(J)
    90 CONTINUE
   100 CONTINUE

C     Calculate sum, mean, and maximum
       SUM = 0.0
       MAXIMUM = Y(1)

       DO 200 I = 1,3
       SUM = SUM + Y(I)
       IF (Y(I) - MAXIMUM) 200,210,220

   210 GOTO 200

   220 MAXIMUM = Y(I)

   200 CONTINUE

       MEAN = SUM / 3.0

       WRITE (*,300) Y(1),Y(2),Y(3)
       WRITE (*,310) SUM,MEAN,MAXIMUM
       WRITE (*,320) I

  300 FORMAT (3F10.3)
  310 FORMAT (3F10.3)
  320 FORMAT (I10)

       STOP
       END
END FORTRAN
