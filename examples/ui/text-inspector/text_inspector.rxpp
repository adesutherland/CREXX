/*
 * Text Inspector: a Level G worked example of UI contract v0.
 *
 * Read this file after lib/ui/contracts/README.md. A feature owns MODEL,
 * UPDATE and VIEW. The session owns feature values, routing, a bounded event
 * queue and correlated effect requests; the driver/executor owns actual I/O.
 *
 * A command is an intent shared by menus, buttons and keys. It queues an
 * application event. An event is a fact delivered to update(); an effect is
 * requested work, returned as a collection (zero, one or many), never executed
 * inside the feature. Completion comes back as another event.
 *
 * Standard ui.*, widget.* and io.* names come from the framework catalogue.
 * document.* belongs to this application. Every extension is registered with
 * a payload shape. A future builder can generate the declarations below without
 * spreading handwritten logic across widget callbacks.
 *
 * ui_compat is a temporary shell for the existing GTK/line-TUI tracer. It owns
 * paths and maps their scalar protocol to v0. The feature below imports neither
 * driver, never opens a file, and receives an opaque resource rather than an
 * OS path to use for I/O. Future terminal/web shells can reuse the feature.
 */
options levelg
namespace text_inspector expose text_inspector_app text_inspector_component make_text_inspector_session
import rxfnsb
import ui
import ui_contract
import ui_compat

##LOADMACRO ui

/** Composition for new owner-loop drivers; it imports no particular driver.
 * @param id session identity @param caps services actually supplied by the host
 * @return session with the same feature and declarative commands as the tracer
 */
make_text_inspector_session: procedure = .uisession
  arg id = .string, caps = .uicapabilities
  session = .uisession(id, caps)
  rc = session.add_component("root", .text_inspector_component(caps.has("ui.dialog")))
  if rc < 0 then exit 1
  rc = session.register_event("document.open.requested")
  if rc < 0 then exit 1
  rc = session.register_event("document.clear.requested")
  if rc < 0 then exit 1
  ##UI_COMMAND session,"document.open.requested","Open...","root","document.open.requested","o"
  ##UI_COMMAND session,"document.clear.requested","Clear","root","document.clear.requested","c"
  ##UI_COMMAND session,"document.quit","Quit","root","ui.close.requested","q"
  return session

/**
 * Compatibility composition root shared unchanged by GTK, TUI and tests.
 * This is wiring, not a god class: the feature below owns application policy.
 */
text_inspector_app: class implements .uiapp
  _bridge = .uibridge
  *: factory
    _bridge = .uibridge(.text_inspector_component())
    rc = _bridge.register_event("document.open.requested")
    if rc < 0 then exit 1
    rc = _bridge.register_event("document.clear.requested")
    if rc < 0 then exit 1
    /* One declaration per command. UI_COMMAND emits checked registration.
     * Button action fields below contain command IDs, not native signals.
     * The first two IDs keep the original tracer's spelling for compatibility. */
    ##UI_COMMAND _bridge,"document.open.requested","Open...","root","document.open.requested","o"
    ##UI_COMMAND _bridge,"document.clear.requested","Clear","root","document.clear.requested","c"
    ##UI_COMMAND _bridge,"document.quit","Quit","root","ui.close.requested","q"
    return

  /** @param event legacy driver fact @return translated legacy driver work */
  update: method = .uieffect
    arg event = .uievent
    return _bridge.update(event)

  /** @return current feature view */
  view: method = .uiview
    return _bridge.view()

/**
 * Small backend-independent feature. Test it directly with v0 messages, or
 * put it in a uisession to test real routing and asynchronous completions.
 */
text_inspector_component: class implements .uicomponent
  /* MODEL: display data only. Resource tokens travel in effect payloads. */
  _path = .string
  _status = .string
  _line_count = .int
  _word_count = .int
  _character_count = .int
  _confirm_clear = .int
  _confirming = .int

  /** @param confirm_clear ask the standard confirmation service before Clear;
   * legacy hosts omit it until they implement that optional capability.
   */
  *: factory
    arg confirm_clear = 0
    _confirm_clear = confirm_clear
    _confirming = 0
    _path = ""
    _status = "Ready"
    _line_count = 0
    _word_count = 0
    _character_count = 0
    return

  /** Reduce one validated semantic fact into state and requested work.
   * Standard payloads and effect outcomes are defined by catalogue.json.
   * Application intent remains explicit ordinary cREXX, not generated logic.
   * @param event semantic UI or correlated effect-completion event
   * @return zero or more requested effects; empty means no external work
   */
  update: method = .uieffects
    arg event = .uimessage
    name = event.name()
    body = event.body()
    result = .uieffects()
    request = .uipayload
    resource = .uiresource

    if name = "ui.ready" then _status = "Ready"
    /* The feature specifies purpose; the driver chooses the actual chooser. */
    if name = "document.open.requested" then do
      _status = "Choose a text file"
      request = .uipayload()
      call request.put_text("title", "Open a text file")
      call request.put_text("purpose", "open")
      call result.add(.uimessage("ui.resource.choose", request, event.target(), "effect"))
    end
    /* Cancellation is a terminal outcome, not an empty-filename convention. */
    if name = "ui.effect.cancelled" then do
      if _confirming then _status = "Clear cancelled"
      else _status = "Open cancelled"
      _confirming = 0
    end
    if name = "ui.resource.selected" then do
      resource = body.resource("resource")
      _path = resource.display_name()
      _status = "Loading " || _path
      request = .uipayload()
      call request.put_resource("resource", resource)
      call result.add(.uimessage("io.text.read", request, event.target(), "effect"))
    end
    if name = "ui.effect.failed" then do
      _line_count = 0
      _word_count = 0
      _character_count = 0
      _status = body.text("message")
    end
    /* Records are owned data. Unicode character and word-count policy belong
     * to this feature, not the framework, GTK, terminal, or future JavaScript. */
    if name = "io.text.read.completed" then do
      records = body.texts("records")
      resource = body.resource("resource")
      _path = resource.display_name()
      _line_count = records[0]
      _word_count = 0
      _character_count = 0
      do index = 1 to records[0]
        line = records[index]
        _word_count = _word_count + words(line)
        _character_count = _character_count + length(line)
      end
      _status = "Count complete"
    end
    if name = "document.clear.requested" then do
      if _confirm_clear then do
        _confirming = 1
        request = .uipayload()
        call request.put_text("title", "Clear results?")
        call request.put_text("message", "Clear the current file and counts?")
        call result.add(.uimessage("ui.dialog.confirm", request, event.target(), "effect"))
      end
      else call clear_model()
    end
    if name = "ui.dialog.accepted" & _confirming then do
      if body.text("response") = "ok" then call clear_model()
      _confirming = 0
    end
    /* A close request can be declined, confirmed or preceded by a save.
     * This tiny read-only feature simply accepts it by requesting ui.close. */
    if name = "ui.close.requested" then call result.add(.uimessage("ui.close", .uipayload(), event.target(), "effect"))
    return result

  /** Build the complete backend-neutral view from current state.
   *
   * A view is a disposable description, not a collection of live widgets.
   * Drivers may rebuild, diff, or otherwise render it. Stable IDs connect
   * successive views and are also anchors for the small relative layout.
   *
   * UI_NODE fields are:
   *
   *   kind | id | action | shortcut | relation | anchor
   *
   * `root` starts the logical grid. `below` and `right` refer to a prior
   * stable ID. uiview_impl resolves those relationships once; GTK and TUI then
   * consume the same rows and columns. The `line` node proves that this is a
   * logical widget vocabulary, not merely a list of text/button procedures.
   *
   * @return logical flat view consumed by all tracer drivers
   */
  view: method = .uiview
    view = .ui..uiview_impl("cREXX Text Inspector")
    path_text = "File: (none)"
    if _path \= "" then path_text = "File: " || _path
    line_text = "Lines: " || _line_count
    word_text = "Words: " || _word_count
    character_text = "Characters: " || _character_count
    status_text = "Status: " || _status
    open_text = "Open..."
    clear_text = "Clear"
    quit_text = "Quit"
    separator_text = ""

    /* Row 0: selected path. */
    ##UI_NODE "label|path|none|none|root|none",path_text
    /* Row 1: a backend-neutral separator below the path. */
    ##UI_NODE "line|summary-divider|none|none|below|path",separator_text
    /* Row 2: three related values placed left-to-right. */
    ##UI_NODE "label|lines|none|none|below|summary-divider",line_text
    ##UI_NODE "label|words|none|none|right|lines",word_text
    ##UI_NODE "label|characters|none|none|right|words",character_text
    /* Row 3: status begins below the left edge of the summary row. */
    ##UI_NODE "label|status|none|none|below|lines",status_text
    /* Row 4: stable command IDs resolve through the session registry. */
    ##UI_NODE "button|open|document.open.requested|o|below|status",open_text
    ##UI_NODE "button|clear|document.clear.requested|c|right|open",clear_text
    ##UI_NODE "button|quit|document.quit|q|right|clear",quit_text
    return view

  /** Reset only feature-owned state; the runtime and driver keep running. */
  clear_model: method = .void
    _path = ""
    _status = "Ready"
    _line_count = 0
    _word_count = 0
    _character_count = 0
    return
