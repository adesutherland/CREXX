options levelg
namespace text_inspector_core_test
import ui
import ui_contract
import text_inspector

/* Unit-test feature policy; session and host conformance cover admission,
 * correlation, physical I/O and teardown separately. */
app = .text_inspector..text_inspector_component()

effect = app.update(.uimessage("document.open.requested", .uipayload()))
if effect.count() \= 1 then do
  say "FAIL: open did not produce one effect"
  exit 1
end

request = effect.item(1)
if request.name() \= "ui.resource.choose" then do
  say "FAIL: open did not request standard resource chooser"
  exit 1
end
effect = app.update(.uimessage("ui.effect.cancelled", .uipayload('{"reason":"chooser_cancelled"}')))
view = app.view()
if effect.count() \= 0 | view.node_text(6) \= "Status: Open cancelled" then do
  say "FAIL: file-selection cancellation was not rendered"
  exit 1
end

records = .string[]
records[1] = "alpha beta"
records[2] = "café gamma delta"
body = .uipayload()
call body.put_resource("resource", .uiresource("fixture-1", "session", "fixture.txt"))
call body.put_texts("records", records)
event = .uimessage("io.text.read.completed", body)
effect = app.update(event)
view = app.view()
if view.node_text(3) \= "Lines: 2" | view.node_text(4) \= "Words: 5" | view.node_text(5) \= "Characters: 26" then do
  say "FAIL: shared Text Inspector update produced the wrong counts"
  exit 1
end
if view.node_kind(2) \= "line" | view.node_row(3) \= 2 | view.node_column(3) \= 0 | view.node_column(4) \= 1 | view.node_column(5) \= 2 then do
  say "FAIL: shared Text Inspector view did not resolve relative layout"
  exit 1
end
if view.node_relation(8) \= "right" | view.node_anchor(8) \= "open" then do
  say "FAIL: shared Text Inspector view did not retain authored placement"
  exit 1
end

effect = app.update(.uimessage("document.clear.requested", .uipayload()))
view = app.view()
if view.node_text(1) \= "File: (none)" | view.node_text(4) \= "Words: 0" then do
  say "FAIL: clear did not reset the shared model"
  exit 1
end

effect = app.update(.uimessage("ui.close.requested", .uipayload()))
if effect.count() \= 1 then do
  say "FAIL: close request did not produce one effect"
  exit 1
end

request = effect.item(1)
if request.name() \= "ui.close" then do
  say "FAIL: close request did not produce standard close effect"
  exit 1
end

say "PASS: Text Inspector shared application contract"
exit 0
