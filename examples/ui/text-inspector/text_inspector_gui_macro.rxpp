/*
 * Rich DEFINE-GUI example using the currently implemented features.
 *
 * The example demonstrates:
 *
 *   - labels and layout rows;
 *   - editable text controls;
 *   - bindings;
 *   - change and commit events;
 *   - generated control setters;
 *   - button actions;
 *   - activation callbacks;
 *   - a status bar.
 *
 * The application handlers remain ordinary cREXX procedures.
 */
options levelg

##cflags ndef nset niflink n1buf 2buf 3buf 4buf
##cflags nvars nmaclist includes nosrcmap nmaclog format

##loadmacro ui
##DALIAS DEFINE-GUI HANDLER UI_GUI

import text_inspector

DEFINE-GUI TextInspector

  /*
   * Header and current file.
   */
  LABEL heading "cREXX Text Inspector"
  LABEL path    "File: (none)"


  /*
   * Summary information.
   */
  ROW
    LABEL lines      "Lines: 0"
    LABEL words      "Words: 0"
    LABEL characters "Characters: 0"
  END ROW


  /*
   * Main text input.
   *
   * The content is reported whenever the control changes.
   */
  TEXT content "Text contents"
  BIND content document.text
  ON CHANGE content CALL document.text


  /*
   * Search and filter input.
   *
   * The filter is processed only when the user commits it.
   */
  ROW
    TEXT filter "Filter text"
    BIND filter document.filter
    ON COMMIT filter CALL document.filter

    TEXT search "Search text"
    BIND search document.search
    ON COMMIT search CALL document.search
  END ROW


  /*
   * Application actions.
   */
  ROW
    BUTTON open    "Open..."  ACTION document.open
    BUTTON clear   "Clear"    ACTION document.clear
    BUTTON refresh "Refresh"  ACTION document.refresh
    BUTTON quit    "Quit"     ACTION document.quit
  END ROW


  /*
   * The status bar is initially static. Its value can be changed
   * by the application handlers through generated setters.
   */
  STATUSBAR status "Status: Ready"


  /*
   * Button activation remains independent of the native driver.
   */
  ON ACTIVATE open    CALL document.open
  ON ACTIVATE clear   CALL document.clear
  ON ACTIVATE refresh CALL document.refresh
  ON ACTIVATE quit    CALL document.quit

END DEFINE-GUI

##UI_GUI_HOST text_inspector_gui_macro,text_inspector,text_inspector_component,TextInspector,make_text_inspector_session
##EMIT gui_host_component
##EMIT gui_host_session
/* Generated host is part of this source. */


/*
 * Flat application handlers.
 *
 * The generated controller invokes these procedures. The application
 * does not call the generated TextInspector module directly.
 */


application_open: procedure = .uieffects
  arg event = .uimessage, delegate = .controller_component
  call delegate.set_status("Choose a text file")
  return delegate.update(event)

application_file_selected: procedure = .uieffects
  arg event = .uimessage, delegate = .controller_component

  resource = event.body().resource("resource")
  filename = resource.display_name()
say 111 filename
  call delegate.set_path(filename)
  call delegate.set_status("Opening " || filename)

  return delegate.update(event)

application_text: procedure = .uieffects
  arg event = .uimessage, delegate = .controller_component

  value = event.body().text("value")
  call delegate.set_status("Text changed")
  return delegate.update(event)


application_filter: procedure = .uieffects
  arg event = .uimessage, delegate = .controller_component

  value = event.body().text("value")

  call delegate.set_status("Filtering: " || value)
  return delegate.update(event)


application_search: procedure = .uieffects
  arg event = .uimessage, delegate = .controller_component

  value = event.body().text("value")

  call delegate.set_status("Searching for: " || value)
  return delegate.update(event)


application_clear: procedure = .uieffects
  arg event = .uimessage, delegate = .controller_component

  call delegate.set_status("Clearing results")
  return delegate.update(event)


application_refresh: procedure = .uieffects
  arg event = .uimessage, delegate = .controller_component

  call delegate.set_status("Refreshing view")
  return delegate.update(event)


application_quit: procedure = .uieffects
  arg event = .uimessage, delegate = .controller_component

  return delegate.update(event)
