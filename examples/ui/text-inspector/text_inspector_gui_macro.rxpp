/* DEFINE-GUI describes layout and commands over the existing feature view.
 * The generated wrapper has no application state or callback policy. */
options levelg
namespace TextInspector expose controller_component make_controller render control_metadata event_metadata register_gui make_text_inspector_gui_session
import text_inspector

##loadmacro ui
##DALIAS DEFINE-GUI HANDLER UI_GUI

DEFINE-GUI TextInspector
  LABEL path
  LINE summary-divider
  ROW
    LABEL lines
    LABEL words
    LABEL characters
  END ROW
  LABEL status
  ROW
    BUTTON open ACTION document.open EVENT document.open.requested SHORTCUT o
    BUTTON open_again ACTION document.open EVENT document.open.requested SHORTCUT o
    BUTTON clear ACTION document.clear EVENT document.clear.requested SHORTCUT c
    BUTTON quit ACTION document.quit EVENT ui.close.requested SHORTCUT q
  END ROW
  BIND path path
  BIND status status
  BIND open_again open
END DEFINE-GUI

##UI_GUI_HOST TextInspector,make_text_inspector_gui_session,make_gui_delegate
##EMIT gui_host_component
##EMIT gui_host_session

make_gui_delegate: procedure = .uicomponent
  arg caps = .uicapabilities
  return .text_inspector_component(caps.has("ui.dialog"))
