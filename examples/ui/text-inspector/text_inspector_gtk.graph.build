/* Launch the GTK Text Inspector through the canonical graph runner.
 *
 * CMake prerequisite (run from the repository root):
 *   cmake -S . -B cmake-build-ui-gtk -DENABLE_GTK=ON -DPKG_CONFIG_EXECUTABLE=C:/msys64/mingw64/bin/pkg-config.exe
 *   cmake --build cmake-build-ui-gtk --target example_text_inspector_artifacts rxvm --parallel 10
 *
 * The graph runner does not invoke CMake; it consumes the RXPP macro library
 * and GTK/native artifacts produced by these commands. */
GTK_BUILD = "cmake-build-ui-gtk";
GRAPH_BUILD = ".crexx-build/ui-graph";

RULE run_gtk
  ACTION = "RUN"
END RULE;

RULE compile_gtk_program
  ACTION = "COMPILE PROGRAM"
END RULE;

RULE compile_rxpp
  ACTION = "COMPILE RXPP"
END RULE;

BUILD "${GRAPH_BUILD}/text_inspector_gui_macro.crexx"
  RULE = compile_rxpp
  INPUT = "examples/ui/text-inspector/text_inspector_gui_macro.rxpp"
  DEPENDS_ON = "${GTK_BUILD}/examples/ui/text-inspector/rxpp/maclib.rexx"
END BUILD;

BUILD "${GRAPH_BUILD}/text_inspector_gui_macro.rxbin"
  RULE = compile_gtk_program
  INPUT = "${GRAPH_BUILD}/text_inspector_gui_macro.crexx"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_contract.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/library.rxbin"
END BUILD;

BUILD "${GRAPH_BUILD}/text_inspector_gtk.rxbin"
  RULE = compile_gtk_program
  INPUT = "${GTK_BUILD}/examples/ui/text-inspector/generated/text_inspector_gtk.crexx"
  DEPENDS_ON = "${GTK_BUILD}/examples/ui/text-inspector/text_inspector.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_gtk.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_local_resources.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_contract.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_catalog.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/library.rxbin"
END BUILD;

BUILD "run-text-inspector-gtk"
  BUILD_NAME = run_text_inspector_gtk
  RULE = run_gtk
  INPUT = "${GRAPH_BUILD}/text_inspector_gtk.rxbin"
  DEPENDS_ON = "${GRAPH_BUILD}/text_inspector_gtk.rxbin"
  WORK_DIR = "."
  DEPENDS_ON = "${GTK_BUILD}/bin/rx_ui_gtk_native.rxplugin"
  DEPENDS_ON = "${GTK_BUILD}/examples/ui/text-inspector/text_inspector.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_gtk.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_local_resources.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_contract.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_catalog.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/library.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/rx_ui_gtk_native.rxplugin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/examples/ui/text-inspector/text_inspector.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_gtk.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_local_resources.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_contract.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_catalog.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/library.rxbin"
END BUILD;

DEFAULT_BUILD = run_text_inspector_gtk;
