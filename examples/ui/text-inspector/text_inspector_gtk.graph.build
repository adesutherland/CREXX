/* Launch the GTK Text Inspector through the canonical graph runner.
 *
 * CMake prerequisite (run from the repository root):
 *   cmake -S . -B cmake-build-release -DENABLE_GTK=ON -DPKG_CONFIG_EXECUTABLE=C:/msys64/mingw64/bin/pkg-config.exe
 *   cmake --build cmake-build-release --target example_text_inspector_artifacts text_inspector_gui_macro_artifact rxvm --parallel 10
 *
 * The graph runner does not invoke CMake; it consumes the RXPP macro library
 * and GTK/native artifacts produced by these commands.
 */

 /* run-text-inspector-gtk-macro */


GTK_BUILD = "cmake-build-release";
GRAPH_BUILD = ".crexx-build/ui-graph";

RULE run_gtk
  ACTION = "RUN"
END RULE;

RULE run_probe
  ACTION = "RUN"
END RULE;

RULE compile_gtk_program
  ACTION = "COMPILE PROGRAM"
END RULE;

RULE compile_rxpp
  ACTION = "COMPILE RXPP"
END RULE;

BUILD "${GRAPH_BUILD}/text_inspector_gui_macro.crexx"
  RULE = compile_rxpp
  INPUT = "examples/ui/text-inspector/text_inspector_gui_macro.rxpp"
    DEPENDS_ON = "${GTK_BUILD}/examples/ui/text-inspector/rxpp/ui/ui_gui.rxpm"
  DEPENDS_ON = "${GTK_BUILD}/examples/ui/text-inspector/rxpp/ui/ui_gui_host.rxpm"
  DEPENDS_ON = "${GTK_BUILD}/examples/ui/text-inspector/rxpp/maclib.rexx"
END BUILD;

BUILD "${GRAPH_BUILD}/TextInspector.rxbin"
  RULE = compile_gtk_program
  INPUT = "${GRAPH_BUILD}/text_inspector_gui_macro.crexx"
  DEPENDS_ON = "${GRAPH_BUILD}/text_inspector_gui_macro.crexx"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_contract.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/library.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/examples/ui/text-inspector/text_inspector.rxbin"
END BUILD;

BUILD "${GRAPH_BUILD}/text_inspector_gtk.rxbin"
  RULE = compile_gtk_program
  INPUT = "${GTK_BUILD}/examples/ui/text-inspector/generated/text_inspector_gtk.crexx"
  DEPENDS_ON = "${GTK_BUILD}/examples/ui/text-inspector/text_inspector.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_gtk.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_scene.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_local_resources.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_contract.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_catalog.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/library.rxbin"
END BUILD;

BUILD "${GRAPH_BUILD}/text_inspector_gui_macro_test.rxbin"
  RULE = compile_gtk_program
  INPUT = "examples/ui/text-inspector/test_text_inspector_gui_macro.crexx"
  DEPENDS_ON = "${GRAPH_BUILD}/TextInspector.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/examples/ui/text-inspector/text_inspector.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_contract.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_catalog.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/library.rxbin"
END BUILD;

BUILD "${GRAPH_BUILD}/text_inspector_gui_macro_gtk.crexx"
  RULE = compile_rxpp
  INPUT = "examples/ui/text-inspector/text_inspector_gui_macro_gtk.rxpp"
  DEPENDS_ON = "${GTK_BUILD}/examples/ui/text-inspector/rxpp/maclib.rexx"
END BUILD;

BUILD "${GRAPH_BUILD}/text_inspector_gui_macro_gtk.rxbin"
  RULE = compile_gtk_program
  INPUT = "${GRAPH_BUILD}/text_inspector_gui_macro_gtk.crexx"
  DEPENDS_ON = "${GRAPH_BUILD}/text_inspector_gui_macro_gtk.crexx"
  DEPENDS_ON = "${GRAPH_BUILD}/TextInspector.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/examples/ui/text-inspector/rxpp/maclib.rexx"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_gtk.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_scene.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_contract.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/library.rxbin"
END BUILD;

BUILD "run-text-inspector-gtk-macro"
  BUILD_NAME = run_text_inspector_gtk_macro
  RULE = run_gtk
  INPUT = "${GRAPH_BUILD}/text_inspector_gui_macro_gtk.rxbin"
  DEPENDS_ON = "${GRAPH_BUILD}/text_inspector_gui_macro_gtk.rxbin"
  WORK_DIR = "."
  DEPENDS_ON = "${GTK_BUILD}/bin/rx_ui_gtk_native.rxplugin"
  DEPENDS_ON = "${GRAPH_BUILD}/TextInspector.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/examples/ui/text-inspector/text_inspector.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_gtk.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_scene.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_local_resources.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_contract.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_catalog.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/library.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/rx_ui_gtk_native"
  RUNTIME_ARGUMENT = "${GRAPH_BUILD}/TextInspector.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/examples/ui/text-inspector/text_inspector.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_gtk.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_scene.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_local_resources.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_contract.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_catalog.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/library.rxbin"
END BUILD;

BUILD "run-text-inspector-gtk-macro-test"
  BUILD_NAME = run_text_inspector_gtk_macro_test
  RULE = run_gtk
  INPUT = "${GRAPH_BUILD}/text_inspector_gui_macro_test.rxbin"
  DEPENDS_ON = "${GRAPH_BUILD}/text_inspector_gui_macro_test.rxbin"
  DEPENDS_ON = "${GRAPH_BUILD}/TextInspector.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/examples/ui/text-inspector/text_inspector.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_contract.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/library.rxbin"
  WORK_DIR = "."
  RUNTIME_ARGUMENT = "${GRAPH_BUILD}/TextInspector.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/examples/ui/text-inspector/text_inspector.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_contract.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_catalog.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/library.rxbin"
END BUILD;

/* Backend-neutral generated-controller probe. */
BUILD "run-text-inspector-gui-probe"
  BUILD_NAME = run_text_inspector_gui_probe
  RULE = run_probe
  INPUT = "${GRAPH_BUILD}/text_inspector_gui_macro_test.rxbin"
  DEPENDS_ON = "${GRAPH_BUILD}/text_inspector_gui_macro_test.rxbin"
  DEPENDS_ON = "${GRAPH_BUILD}/TextInspector.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_contract.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/library.rxbin"
  WORK_DIR = "."
  RUNTIME_ARGUMENT = "${GRAPH_BUILD}/TextInspector.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/examples/ui/text-inspector/text_inspector.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_contract.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_catalog.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/library.rxbin"
END BUILD;

BUILD "run-text-inspector-gtk"
  BUILD_NAME = run_text_inspector_gtk
  RULE = run_gtk
  INPUT = "${GRAPH_BUILD}/text_inspector_gtk.rxbin"
  DEPENDS_ON = "${GRAPH_BUILD}/text_inspector_gtk.rxbin"
  WORK_DIR = "."
  DEPENDS_ON = "${GTK_BUILD}/bin/rx_ui_gtk_native.rxplugin"
  DEPENDS_ON = "${GTK_BUILD}/examples/ui/text-inspector/text_inspector.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_gtk.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_scene.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_local_resources.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_contract.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui_catalog.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/ui.rxbin"
  DEPENDS_ON = "${GTK_BUILD}/bin/library.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/rx_ui_gtk_native"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/examples/ui/text-inspector/text_inspector.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_gtk.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_scene.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_local_resources.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_contract.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui_catalog.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/ui.rxbin"
  RUNTIME_ARGUMENT = "${GTK_BUILD}/bin/library.rxbin"
END BUILD;

DEFAULT_BUILD = run_text_inspector_gtk_macro;
