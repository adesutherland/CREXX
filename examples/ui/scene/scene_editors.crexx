/* Independent graph and tile-map application features on the common UI. */
options levelg
namespace scene_editors expose make_graph_editor_session make_map_editor_session graph_editor map_editor
import rxfnsb
import rxjson
import ui
import ui_contract
import ui_scene

graph_items: procedure = .string[]
  arg ax = .int, created = .int, connected = .int, selected = .string
  result = .string[]
  label = "A"
  if selected = "node-a" then label = "A*"
  result[1] = '{"id":"node-a","kind":"rect","x":' || ax || ',"y":7680,"w":20480,"h":15360,"label":' || jsonquote(label) || '}'
  label = "B"
  if selected = "node-b" then label = "B*"
  result[2] = '{"id":"node-b","kind":"rect","x":56320,"y":7680,"w":20480,"h":15360,"label":' || jsonquote(label) || '}'
  result[3] = '{"id":"edge-ab","kind":"edge","x":' || (ax + 20480) || ',"y":15360,"w":' || (56320 - ax - 20480) || ',"h":0,"label":""}'
  if created then do
    label = "C"
    if selected = "node-c" then label = "C*"
    result[result[0] + 1] = '{"id":"node-c","kind":"rect","x":32000,"y":43520,"w":20480,"h":15360,"label":' || jsonquote(label) || '}'
    if connected then result[result[0] + 1] = '{"id":"edge-ac","kind":"edge","x":' || (ax + 10240) || ',"y":23040,"w":' || (42240 - ax - 10240) || ',"h":20480,"label":""}'
  end
  return result

map_items: procedure = .string[]
  arg unit_x = .int
  result = .string[]
  do row = 0 to 3
    do column = 0 to 3
      id = "tile-" || row || "-" || column
      terrain = "Plain"
      if (row + column) % 3 = 0 then terrain = "Forest"
      result[result[0] + 1] = '{"id":' || jsonquote(id) || ',"kind":"tile","x":' || (column * 16384) || ',"y":' || (row * 16384) || ',"w":16384,"h":16384,"label":' || jsonquote(terrain) || '}'
    end
  end
  result[result[0] + 1] = '{"id":"unit-blue","kind":"unit","x":' || unit_x || ',"y":4096,"w":8192,"h":8192,"label":"Blue"}'
  return result

valid_graph_model: procedure = .int
  arg state = .string
  if jsonvalid(state) = 0 | jsontype(state, "ax") \= "number" | jsontype(state, "created") \= "number" | jsontype(state, "connected") \= "number" | jsontype(state, "selected") \= "string" | jsontype(state, "origin") \= "number" | jsontype(state, "scale") \= "number" then return 0
  do index = 1 to 5
    field = word("ax created connected origin scale", index)
    if datatype(jsonget(state, field), "W") = 0 then return 0
  end
  ax = jsonget(state, "ax") as .int
  created = jsonget(state, "created") as .int
  connected = jsonget(state, "connected") as .int
  origin = jsonget(state, "origin") as .int
  scale = jsonget(state, "scale") as .int
  selected = jsonget(state, "selected")
  if ax < 7680 | ax > 35840 | (ax - 7680) <mod> 2560 \= 0 then return 0
  if created < 0 | created > 1 | connected < 0 | connected > created then return 0
  if origin < 0 | origin > 262144 | origin <mod> 2560 \= 0 then return 0
  if scale \= 128 & scale \= 256 then return 0
  if selected \= "" & selected \= "node-a" & selected \= "node-b" & selected \= "node-c" then return 0
  if selected = "node-c" & created = 0 then return 0
  return 1

make_graph_editor_session: procedure = .uisession
  arg id = .string, caps = .uicapabilities
  session = .uisession(id, caps)
  graphical = caps.has("form.scene") & caps.has("scene.rect") & caps.has("scene.edge")
  rc = session.add_component("root", .graph_editor(graphical))
  do i = 1 to 10
    action = word("create move connect delete zoom pan select undo redo quit", i)
    if action \= "quit" then rc = session.register_event("graph." || action || ".requested")
    event = "graph." || action || ".requested"
    if action = "quit" then event = "ui.close.requested"
    rc = session.register_command(.uicommand("graph." || action, action, "root", event, substr(action, 1, 1)))
  end
  return session

graph_editor: class implements .uicomponent
  _graphical = .int
  _scene = .uisceneowner
  _packet = .string
  _ax = .int
  _created = .int
  _connected = .int
  _selected = .string
  _origin = .int
  _scale = .int
  _undo = .string[]
  _redo = .string[]
  _journal = .string
  *: factory
    arg graphical = .int
    _graphical = graphical
    _scene = .uisceneowner("graph-editor")
    _ax = 7680
    _created = 0
    _connected = 0
    _selected = ""
    _origin = 0
    _scale = 256
    _journal = ""
    call arraydrop _undo
    call arraydrop _redo
    unused = _scene.set_items(graph_items(_ax, _created, _connected, _selected))
    _packet = _scene.snapshot()
    return
  model: method = .string
    return '{"ax":' || _ax || ',"created":' || _created || ',"connected":' || _connected || ',"selected":' || jsonquote(_selected) || ',"origin":' || _origin || ',"scale":' || _scale || '}'
  saved_state: method = .string
    index = .int
    result = '{"format":1,"model":' || model() || ',"undo":['
    do index = 1 to _undo[0]
      if index > 1 then result = result || ','
      result = result || _undo[index]
    end
    result = result || '],"redo":['
    do index = 1 to _redo[0]
      if index > 1 then result = result || ','
      result = result || _redo[index]
    end
    return result || ']}'
  load_saved_state: method = .int
    arg saved = .string
    index = .int
    if length(saved) > 16384 | jsonvalid(saved) = 0 then return 0
    if jsonget(saved, "format") \= "1" | jsontype(saved, "model") \= "object" | jsontype(saved, "undo") \= "array" | jsontype(saved, "redo") \= "array" then return 0
    incoming = jsonget(saved, "model")
    if valid_graph_model(incoming) = 0 then return 0
    undo_count = jsoncount(saved, "undo")
    redo_count = jsoncount(saved, "redo")
    if undo_count < 0 | undo_count > 32 | redo_count < 0 | redo_count > 32 then return 0
    do index = 1 to undo_count
      if valid_graph_model(jsonget(saved, "undo[" || index || "]")) = 0 then return 0
    end
    do index = 1 to redo_count
      if valid_graph_model(jsonget(saved, "redo[" || index || "]")) = 0 then return 0
    end
    call restore(incoming)
    call arraydrop _undo
    call arraydrop _redo
    do index = 1 to undo_count
      _undo[index] = jsonget(saved, "undo[" || index || "]")
    end
    do index = 1 to redo_count
      _redo[index] = jsonget(saved, "redo[" || index || "]")
    end
    discard = _scene.set_items(items())
    discard = _scene.set_viewport(_origin, 0, _scale, 420, 260)
    _packet = _scene.snapshot()
    return 1
  restore: method = .void
    arg saved = .string
    _ax = jsonget(saved, "ax") as .int
    _created = jsonget(saved, "created") as .int
    _connected = jsonget(saved, "connected") as .int
    _selected = jsonget(saved, "selected")
    _origin = jsonget(saved, "origin") as .int
    _scale = jsonget(saved, "scale") as .int
    return
  items: method = .string[]
    return graph_items(_ax, _created, _connected, _selected)
  reconcile: method = .void
    arg before = .string
    if jsonget(before, "origin") \= (_origin as .string) | jsonget(before, "scale") \= (_scale as .string) then
      _packet = _scene.set_viewport(_origin, 0, _scale, 420, 260)
    else _packet = _scene.set_items(items())
    if _packet = "" then _packet = _scene.snapshot()
    return
  act: method = .void
    arg action = .string
    before = model()
    if action = "undo" then do
      if _undo[0] < 1 then return
      _redo[_redo[0] + 1] = before
      call restore(arraypop(_undo))
    end
    else if action = "redo" then do
      if _redo[0] < 1 then return
      _undo[_undo[0] + 1] = before
      call restore(arraypop(_redo))
    end
    else do
      if action = "create" then _created = 1
      else if action = "move" & _ax < 35840 then _ax = _ax + 2560
      else if action = "connect" & _created then _connected = 1
      else if action = "delete" then do
        _created = 0
        _connected = 0
        if _selected = "node-c" then _selected = ""
      end
      else if action = "zoom" then do
        if _scale = 256 then _scale = 128
        else _scale = 256
      end
      else if action = "pan" & _origin < 261120 then _origin = _origin + 2560
      else if action = "select" then _selected = "node-a"
      if model() = before then return
      _undo[_undo[0] + 1] = before
      if _undo[0] > 32 then call arraydelete _undo, 1, 1
      call arraydrop _redo
    end
    call reconcile(before)
    _journal = strip(_journal || " " || action)
    return
  update: method = .uieffects
    arg event = .uimessage
    name = event.name()
    do i = 1 to 9
      action = word("create move connect delete zoom pan select undo redo", i)
      if name = "graph." || action || ".requested" then call act(action)
    end
    if name = "ui.scene.key" then do
      key = event.body().text("key")
      if key = "Delete" then call act("delete")
      else if key = "ArrowRight" | key = "Right" then call act("move")
      else if key = "z" then call act("zoom")
      else if key = "p" then call act("pan")
      else if key = "a" then call act("create")
      else if key = "c" then call act("connect")
      else if key = "u" then call act("undo")
      else if key = "r" then call act("redo")
    end
    if name = "ui.scene.pointer" then call select_pointer(event.body())
    if name = "ui.scene.resync" then _packet = _scene.snapshot()
    effects = .uieffects()
    if name = "ui.close.requested" then call effects.add(.uimessage("ui.close", .uipayload(), event.target(), "effect"))
    return effects
  select_pointer: method = .void
    arg body = .uipayload
    pointer = .uipointer(body.text("epoch"), body.integer("revision"), body.integer("x"), body.integer("y"))
    admission = _scene.accept_pointer(pointer)
    if \admission.ok() then return
    viewport = .uiviewport(_origin, 0, _scale, 420, 260)
    point = viewport.map(pointer)
    if \point.valid() then return
    before = model()
    _selected = _scene.pick(point)
    if _selected \= "" then call reconcile(before)
    return
  view: method = .uiview
    view = .uiview_impl("Editable graph")
    call append_view(view)
    return view
  append_view: method = .void
    arg view = .uiview_impl
    i = .int
    if _graphical then call view.add_scene("graph", _packet, "root")
    else do
      call view.add_label("heading", "Graph objects", "root")
      records = items()
      do i = 1 to records[0]
        call view.add_label(jsonget(records[i], "id"), jsonget(records[i], "label") || " " || jsonget(records[i], "id"))
      end
    end
    call view.add_label("state", "A: " || _ax || " C: " || _created || " Edge AC: " || _connected || " Selected: " || _selected)
    call view.add_label("viewport", "Pan: " || _origin || " Scale: " || _scale)
    do i = 1 to 10
      action = word("create move connect delete zoom pan select undo redo quit", i)
      call view.add_button(action, action, "graph." || action, substr(action, 1, 1))
    end
    return
  journal: method = .string
    return _journal
  scene: method = .string
    return _scene.snapshot()

make_map_editor_session: procedure = .uisession
  arg id = .string, caps = .uicapabilities
  session = .uisession(id, caps)
  graphical = caps.has("form.scene") & caps.has("scene.tile") & caps.has("scene.unit")
  rc = session.add_component("root", .map_editor(graphical))
  do i = 1 to 5
    action = word("turn pan zoom select quit", i)
    if action \= "quit" then rc = session.register_event("map." || action || ".requested")
    event = "map." || action || ".requested"
    if action = "quit" then event = "ui.close.requested"
    rc = session.register_command(.uicommand("map." || action, action, "root", event, substr(action, 1, 1)))
  end
  return session

map_editor: class implements .uicomponent
  _graphical = .int
  _scene = .uisceneowner
  _packet = .string
  _turn = .int
  _unit_x = .int
  _origin = .int
  _scale = .int
  _selected = .string
  _journal = .string
  *: factory
    arg graphical = .int
    _graphical = graphical
    _scene = .uisceneowner("map-editor")
    _turn = 1
    _unit_x = 4096
    _origin = 0
    _scale = 256
    _selected = ""
    _journal = ""
    unused = _scene.set_items(map_items(_unit_x))
    _packet = _scene.snapshot()
    return
  items: method = .string[]
    return map_items(_unit_x)
  turn_record: method = .string
    return '{"turn":' || _turn || ',"unit_x":' || _unit_x || '}'
  restore_turn: method = .int
    arg record = .string
    if jsonvalid(record) = 0 | jsontype(record, "turn") \= "number" | jsontype(record, "unit_x") \= "number" then return 0
    if datatype(jsonget(record, "turn"), "W") = 0 | datatype(jsonget(record, "unit_x"), "W") = 0 then return 0
    turn = jsonget(record, "turn") as .int
    unit_x = jsonget(record, "unit_x") as .int
    if turn < 1 | turn > 100000 | unit_x \= 4096 + ((turn - 1) <mod> 4) * 16384 then return 0
    _turn = turn
    _unit_x = unit_x
    discard = _scene.set_items(items())
    _packet = _scene.snapshot()
    return 1
  update: method = .uieffects
    arg event = .uimessage
    name = event.name()
    action = ""
    if name = "map.turn.requested" then action = "turn"
    else if name = "map.pan.requested" then action = "pan"
    else if name = "map.zoom.requested" then action = "zoom"
    else if name = "map.select.requested" then action = "select"
    else if name = "ui.scene.key" then do
      key = event.body().text("key")
      if key = "ArrowRight" | key = "Right" then action = "turn"
      else if key = "p" then action = "pan"
      else if key = "z" then action = "zoom"
    end
    if action = "turn" & _turn < 100000 then do
      _turn = _turn + 1
      _unit_x = _unit_x + 16384
      if _unit_x > 53248 then _unit_x = 4096
      _packet = _scene.set_items(items())
    end
    else if action = "pan" then do
      _origin = _origin + 4096
      _packet = _scene.set_viewport(_origin, 0, _scale, 420, 260)
    end
    else if action = "zoom" then do
      if _scale = 256 then _scale = 128
      else _scale = 256
      _packet = _scene.set_viewport(_origin, 0, _scale, 420, 260)
    end
    else if action = "select" then _selected = "unit-blue"
    if name = "ui.scene.pointer" then call select_pointer(event.body())
    if name = "ui.scene.resync" then _packet = _scene.snapshot()
    if action \= "" then _journal = strip(_journal || " " || action)
    effects = .uieffects()
    if name = "ui.close.requested" then call effects.add(.uimessage("ui.close", .uipayload(), event.target(), "effect"))
    return effects
  select_pointer: method = .void
    arg body = .uipayload
    pointer = .uipointer(body.text("epoch"), body.integer("revision"), body.integer("x"), body.integer("y"))
    admission = _scene.accept_pointer(pointer)
    if \admission.ok() then return
    viewport = .uiviewport(_origin, 0, _scale, 420, 260)
    point = viewport.map(pointer)
    if point.valid() then _selected = _scene.pick(point)
    return
  view: method = .uiview
    view = .uiview_impl("Tile Map Demo")
    call append_view(view)
    return view
  append_view: method = .void
    arg view = .uiview_impl
    if _graphical then call view.add_scene("map", _packet, "root")
    else do
      call view.add_label("heading", "Map cell viewport 4x4", "root")
      do row = 0 to 3
        text = ""
        do column = 0 to 3
          cell = "."
          if row = 0 & column = (_unit_x - 4096) % 16384 then cell = "B"
          else if (row + column) % 3 = 0 then cell = "F"
          text = text || cell
        end
        call view.add_label("row-" || row, text)
      end
    end
    call view.add_label("state", "Turn: " || _turn || " Unit x: " || _unit_x || " Selected: " || _selected)
    call view.add_label("viewport", "Pan: " || _origin || " Scale: " || _scale)
    do i = 1 to 5
      action = word("turn pan zoom select quit", i)
      call view.add_button(action, action, "map." || action, substr(action, 1, 1))
    end
    return
  journal: method = .string
    return _journal
  state: method = .string
    return _turn || "/" || _unit_x || "/" || _origin || "/" || _scale || "/" || _selected
  scene: method = .string
    return _scene.snapshot()
