/* RXPP */
##cflags ndef nset niflink 1buf buf 3buf nvars nmaclist includes nosrcmap nmaclog
options levelg

/*
 * One field definition generates:
 *
 *   - class field
 *   - initialization
 *   - getter
 *   - setter
 *   - channel encoding
 *   - channel decoding
 */
##MACRO CHANNELFIELD mname,name,type,initial
    .section class_fields &name = &type
    if _mcalls=1 then do
        .section factory *: factory
    end
    .section factory &name = &initial
    .section getters get_&mname: method = &type
    .section getters return &name
    .section getters ##blankline
    .section setters set_&mname: method = .void
    .section setters arg value = &type
    .section setters &name = value
    .section setters return
    .section setters ##blankline
    .section channel_pack_names names[&_mcalls] = "&mname"
    if type = ".int" then do
        .section channel_pack_values values[&_mcalls] = .channelvalue.integer_value(&name)
        .section channel_unpack &name = encoded.field("&mname").as_integer()
    end
    if type = ".string" then do
        .section channel_pack_values values[&_mcalls] = .channelvalue.string_value(&name)
        .section channel_unpack &name = encoded.field("&mname").as_string()
    end
    if type = ".boolean" then do
        .section channel_pack_values values[&_mcalls] = .channelvalue.boolean_value(&name)
        .section channel_unpack &name = encoded.field("&mname").as_boolean()
    end
##MEND

##MACRO CHANNELCLASS classname,schema
    .gen &classname: class
    .gen ##emit class_fields
    .gen ##emit factory
    .gen return
    .gen ##emit getters
    .gen ##emit setters
    .gen to_channel: method = .channelvalue
    .gen names = .string[]
    .gen values = .channelvalue[]
    .gen ##emit channel_pack_names
    .gen ##emit channel_pack_values
    .gen return .channelvalue.record_value("&schema",1,names,values)
    .gen from_channel: factory
    .gen arg encoded = .channelvalue
    .gen ##emit channel_unpack
    .gen return
##MEND

/*
 * Define the data model once.
 *
 * RXPP generates the class and the CHANNELVALUE transport logic required
 * to exchange structured data between subtasks automatically.
 */
##CHANNELFIELD id,          _id,          .int,     0
##CHANNELFIELD name,        _name,        .string,  ""
##CHANNELFIELD active,      _active,      .boolean, 0
##CHANNELFIELD count,       _count,       .int,     0
##CHANNELFIELD description, _description, .string,  ""

/*
 * Execute the task in parallel.
 *
 * The returned object automatically crosses the subtask boundary and is
 * reconstructed in the controlling task.
 */
do parallel
    result = calculate_stats(42, "CREXX", 1, 123)

    say result.get_id()
    say result.get_name()
    say result.get_active()
    say result.get_count()
    say result.get_description()
end
return

/*
 * TASK returning a structured result.
 *
 * Parameters are passed into the subtask, while the generated
 * channel transport returns the reconstructed object to the
 * controlling task.
 */
calculate_stats: task = .stats_result
    arg id=.int, name=.string, active=.boolean, count=.int
    result = .stats_result()

    call result.set_id(id)
    call result.set_name(name)
    call result.set_active(active)
    call result.set_count(count)
    call result.set_description("Generated by CHANNELFIELD")

return result
/*
 * Build the result object and its transport layer from the field
 * definitions above.
 */
##CHANNELCLASS stats_result, example.stats
