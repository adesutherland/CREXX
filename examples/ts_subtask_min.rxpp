/* RXPP */
##cflags ndef nset niflink 1buf buf 3buf nvars nmaclist includes nosrcmap nmaclog
options levelg

/*
 * 2 external Macros are needed to generate the channel transport layer.
 *
 * CHANNELCLASS.rxpm:
 *   - name of the class
 *   - name of the channel transport class
 *
 * CHANNELFIELD.rxpm:
 *   - name of the field
 *   - name of the channel transport field
 *   - type of the field
 * Copy them into the bin libaray before running the RXPP pre-compiler.
 */

/*
 * Define the data model once.
 *
 * RXPP generates the class and the CHANNELVALUE transport logic required
 * to exchange structured data between subtasks automatically.
 * One field definition generates:
 *
 *   - class field
 *   - initialization
 *   - getter
 *   - setter
 *   - channel encoding
 *   - channel decoding
 */
##CHANNELFIELD id,          _id,          .int,     0
##CHANNELFIELD name,        _name,        .string,  ""
##CHANNELFIELD active,      _active,      .boolean, 0
##CHANNELFIELD count,       _count,       .int,     0
##CHANNELFIELD description, _description, .string,  ""

/*
 * Execute the task in parallel.
 *
 * The returned object automatically crosses the subtask boundary and is
 * reconstructed in the controlling task.
 */
do parallel
    result = calculate_stats(42, "CREXX", 1, 123)

    say result.get_id()
    say result.get_name()
    say result.get_active()
    say result.get_count()
    say result.get_description()
end
return

/*
 * TASK returning a structured result.
 *
 * Parameters are passed into the subtask, while the generated
 * channel transport returns the reconstructed object to the
 * controlling task.
 */
calculate_stats: task = .stats_result
    arg id=.int, name=.string, active=.boolean, count=.int
    result = .stats_result()

    call result.set_id(id)
    call result.set_name(name)
    call result.set_active(active)
    call result.set_count(count)
    call result.set_description("Generated by CHANNELFIELD")

return result
/*
 * Build the result object and its transport layer from the field
 * definitions above.
 */
##CHANNELCLASS stats_result, example.stats