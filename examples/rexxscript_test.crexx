exit 0

show_result: PROCEDURE
  arg result=.string[]
  say copies('-',64)
  say "Status :" result[1]
  say copies('-',64)

  i = 2
  output_start = 0

  do while i <= result[0]
    if datatype(result[i], "W") then do
      output_start = i
      leave
    end

    say "Variable:" result[i] "=" result[i + 1]
    i = i + 2
  end

  if output_start > 0 then do
    say
    say "Output lines:" result[output_start]
    say copies('-',64)

    do j = 1 to result[output_start]
      say right(j,4,'0') result[output_start + j]
    end
  end

return