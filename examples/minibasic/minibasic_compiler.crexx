/* MiniBASIC source compiler.
 *
 * This compiler owns the first application-generation slice. It parses a
 * MiniBASIC source file with the same Level L grammar as the reader, emits a
 * small cREXX state-machine program, and leaves rxbuild to compile that
 * generated source into the final application RXBIN.
 */
options levelb
import rxfnsb
import lllanguage
import llsource
import lltree
import minibasicgrammar

state: initialiser expose mb_line mb_node mb_line_count mb_output
  mb_line = .int[]
  mb_node = .int[]
  mb_line_count = 0
  mb_output = .string[]

main: procedure = .int expose mb_line mb_node mb_line_count mb_output
  arg argv = .string[]
  if argv[0] <> 2 then do
    say 'usage: minibasic_compiler source.bas generated.crexx'
    return 2
  end

  source = .binary
  do
    source = readbinary(argv[1])
  on signal
    say 'MINIBASIC_IO: cannot read ' || argv[1]
    return 2
  end

  request = .lllanguage..request(minibasicgrammar..language(),source)
  status = request.parse()
  if status <> 0 then do
    say argv[1] || ': ' || llsource..diagnostic(source,request.offset(),'MINIBASIC_COMPILE',request.error())
    return status
  end

  tree = .lltree..view(request.tree(),request.root())
  if tree.error() <> '' then do
    say 'MINIBASIC_COMPILE: ' || tree.error()
    return 3
  end

  return compile_tree(tree,argv[2])

compile_tree: procedure = .int expose mb_line mb_node mb_line_count mb_output
  arg tree = .lltree..view, output = .string
  i = .int
  line = .int
  statement = .int
  rc = .int
  root = .int
  content = .string
  written = .int
  root = tree.root()
  mb_line_count = 0

  do i = 1 to tree.count(root)
    line = tree.child(root,i)
    if tree.name(line) <> 'line' then iterate
    mb_line_count = mb_line_count + 1
    mb_line[mb_line_count] = tree.text(tree.child(line,1)) as .int
    mb_node[mb_line_count] = line
  end
  if mb_line_count = 0 then return compile_failure('source has no numbered lines','')

  call emit_line '/* Generated by minibasic_compiler. */'
  call emit_line 'options levelb'
  call emit_line 'import rxfnsb'
  call emit_line ''
  call emit_line 'main: procedure = .int'
  call emit_line '  pc = 1'
  call emit_line '  do while pc <> 0'
  call emit_line '    select'

  do i = 1 to mb_line_count
    call emit_line '      when pc = ' || i || ' then do'
    statement = tree.child(mb_node[i],2)
    if tree.name(statement) = 'statement' then statement = tree.child(statement,1)
    rc = emit_statement(tree,statement,i)
    if rc <> 0 then return rc
    call emit_line '      end'
  end

  call emit_line '      otherwise pc = 0'
  call emit_line '    end'
  call emit_line '  end'
  call emit_line '  return 0'

  content = ''
  do i = 1 to mb_output[0]
    if i > 1 then content = content || '0a'x
    content = content || mb_output[i]
  end
  written = writebinary(output,content as .binary)
  if written <> length(content) then return compile_failure('cannot write generated source',output)
  say 'MINIBASIC COMPILE:' output
  return 0

emit_statement: procedure = .int expose mb_line mb_node mb_line_count mb_output
  arg tree = .lltree..view, statement = .int, position = .int
  i = .int
  item = .int
  list = .int
  name = .string
  line = .string
  target = .string
  target_line = .int
  value = .string
  condition = .string
  next_position = .int
  name = tree.name(statement)
  next_position = position + 1
  if next_position > mb_line_count then next_position = 0

  if name = 'rem.statement' then do
    call emit_next next_position
    return 0
  end
  if name = 'let.statement' then do
    statement = tree.child(statement,2)
    name = tree.name(statement)
  end
  if name = 'assignment.statement' then do
    target = variable_name(tree,tree.child(statement,1))
    value = emit_expression(tree,tree.child(statement,3))
    call emit_line '        ' || target || ' = ' || value
    call emit_next next_position
    return 0
  end
  if name = 'print.statement' then do
    list = tree.child(statement,2)
    line = '        say'
    do i = 1 to tree.count(list)
      item = tree.child(list,i)
      if tree.name(item) <> 'expression' then iterate
      line = line || ' ' || emit_expression(tree,item)
    end
    call emit_line line
    call emit_next next_position
    return 0
  end
  if name = 'input.statement' then do
    target = variable_name(tree,tree.child(statement,2))
    call emit_line '        say "' || target || '?"'
    call emit_line '        ' || target || ' = pull()'
    call emit_next next_position
    return 0
  end
  if name = 'if.statement' then do
    target_line = tree.text(tree.child(statement,4)) as .int
    target = find_line(target_line)
    if target = 0 then return compile_failure('IF target line not found',target_line)
    condition = emit_expression(tree,tree.child(statement,2))
    call emit_line '        if ' || condition || ' then pc = ' || target
    call emit_line '        else pc = ' || next_position
    return 0
  end
  if name = 'goto.statement' then do
    target_line = tree.text(tree.child(statement,2)) as .int
    target = find_line(target_line)
    if target = 0 then return compile_failure('GOTO target line not found',target_line)
    call emit_line '        pc = ' || target
    return 0
  end
  if name = 'end.statement' then do
    call emit_line '        pc = 0'
    return 0
  end
  return compile_failure('unsupported statement',name)

emit_next: procedure expose mb_output
  arg position = .int
  call emit_line '        pc = ' || position

emit_expression: procedure = .string
  arg tree = .lltree..view, node = .int
  name = tree.name(node)
  if name = 'integer' | name = 'string' then return tree.text(node)
  if name = 'identifier' then return translate(tree.text(node))
  if name = 'variable' then return variable_name(tree,node)
  if name = 'group' then return '(' || emit_expression(tree,tree.child(node,2)) || ')'
  if name = 'expression' | name = 'comparison' then do
    left = emit_expression(tree,tree.child(node,1))
    if tree.count(node) = 1 then return left
    operator = emit_operator(tree.name(tree.child(node,2)))
    right = emit_expression(tree,tree.child(node,3))
    return left || ' ' || operator || ' ' || right
  end
  if name = 'additive' | name = 'multiplicative' then do
    result = emit_expression(tree,tree.child(node,1))
    i = 2
    do while i <= tree.count(node)
      result = result || ' ' || emit_operator(tree.name(tree.child(node,i))) || ' ' || emit_expression(tree,tree.child(node,i + 1))
      i = i + 2
    end
    return result
  end
  if name = 'primary' | name = 'unary' then do
    if tree.count(node) = 1 then return emit_expression(tree,tree.child(node,1))
    return emit_operator(tree.name(tree.child(node,1))) || emit_expression(tree,tree.child(node,2))
  end
  return emit_expression(tree,tree.child(node,1))

emit_operator: procedure = .string
  arg name = .string
  if name = 'plus' then return '+'
  if name = 'minus' then return '-'
  if name = 'multiply' then return '*'
  if name = 'divide' then return '/'
  if name = 'equals' then return '='
  if name = 'not_equals' then return '<>'
  if name = 'less' then return '<'
  if name = 'greater' then return '>'
  if name = 'less_equal' then return '<='
  if name = 'greater_equal' then return '>='
  return name

variable_name: procedure = .string
  arg tree = .lltree..view, node = .int
  return translate(tree.text(tree.child(node,1)))

find_line: procedure = .int expose mb_line mb_line_count
  arg wanted = .int
  do i = 1 to mb_line_count
    if mb_line[i] = wanted then return i
  end
  return 0

emit_line: procedure expose mb_output
  arg value = .string
  mb_output[mb_output[0] + 1] = value

compile_failure: procedure = .int
  arg message = .string, detail = .string
  say 'MINIBASIC_COMPILE: ' || message || ' ' || detail
  return 4
