  errors = errors + check(dictionary.addMember("PURCHASE_ORDER_RECORD", "RECORD", "Purchase Order record", m_purchase_order_record) = 0, "member PURCHASE_ORDER_RECORD")
  errors = errors + check(dictionary.addMember("PURCHASE_LINE_RECORD", "RECORD", "Purchase Line record", m_purchase_line_record) = 0, "member PURCHASE_LINE_RECORD")
  errors = errors + check(dictionary.addMember("SALES_ORDER_RECORD", "RECORD", "Sales Order record", m_sales_order_record) = 0, "member SALES_ORDER_RECORD")
  errors = errors + check(dictionary.addMember("SALES_LINE_RECORD", "RECORD", "Sales Line record", m_sales_line_record) = 0, "member SALES_LINE_RECORD")
  errors = errors + check(dictionary.addMember("INVOICE_RECORD", "RECORD", "Invoice record", m_invoice_record) = 0, "member INVOICE_RECORD")
  errors = errors + check(dictionary.addMember("INVOICE_LINE_RECORD", "RECORD", "Invoice Line record", m_invoice_line_record) = 0, "member INVOICE_LINE_RECORD")
  errors = errors + check(dictionary.addMember("PAYMENT_RECORD", "RECORD", "Payment record", m_payment_record) = 0, "member PAYMENT_RECORD")
  errors = errors + check(dictionary.addMember("SHIPMENT_RECORD", "RECORD", "Shipment record", m_shipment_record) = 0, "member SHIPMENT_RECORD")
  errors = errors + check(dictionary.addMember("SHIPMENT_LINE_RECORD", "RECORD", "Shipment Line record", m_shipment_line_record) = 0, "member SHIPMENT_LINE_RECORD")
  errors = errors + check(dictionary.addMember("RETURN_RECORD", "RECORD", "Return record", m_return_record) = 0, "member RETURN_RECORD")
  errors = errors + check(dictionary.addMember("RETURN_LINE_RECORD", "RECORD", "Return Line record", m_return_line_record) = 0, "member RETURN_LINE_RECORD")
  errors = errors + check(dictionary.addMember("EMPLOYEE_RECORD", "RECORD", "Employee record", m_employee_record) = 0, "member EMPLOYEE_RECORD")
  errors = errors + check(dictionary.addMember("DEPARTMENT_RECORD", "RECORD", "Department record", m_department_record) = 0, "member DEPARTMENT_RECORD")
