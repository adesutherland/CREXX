  errors = errors + check(dictionary.addMember("PRICE_AGREEMENT_RECORD", "RECORD", "Price Agreement record", m_price_agreement_record) = 0, "member PRICE_AGREEMENT_RECORD")
  errors = errors + check(dictionary.addMember("ADDRESS_GROUP", "GROUP", "Address reusable group", m_address_group) = 0, "member ADDRESS_GROUP")
  errors = errors + check(dictionary.addMember("CONTACT_GROUP", "GROUP", "Contact reusable group", m_contact_group) = 0, "member CONTACT_GROUP")
  errors = errors + check(dictionary.addMember("AUDIT_GROUP", "GROUP", "Audit reusable group", m_audit_group) = 0, "member AUDIT_GROUP")
  errors = errors + check(dictionary.addMember("MONEY_GROUP", "GROUP", "Money reusable group", m_money_group) = 0, "member MONEY_GROUP")
  errors = errors + check(dictionary.addMember("AGREEMENT_NUMBER", "FIELD", "Agreement Number field", m_agreement_number) = 0, "member AGREEMENT_NUMBER")
  errors = errors + check(dictionary.addMember("AGREEMENT_STATUS", "FIELD", "Agreement Status field", m_agreement_status) = 0, "member AGREEMENT_STATUS")
  errors = errors + check(dictionary.addMember("AMOUNT", "FIELD", "Amount field", m_amount) = 0, "member AMOUNT")
  errors = errors + check(dictionary.addMember("APPROVAL_CODE", "FIELD", "Approval Code field", m_approval_code) = 0, "member APPROVAL_CODE")
  errors = errors + check(dictionary.addMember("BANK_REFERENCE", "FIELD", "Bank Reference field", m_bank_reference) = 0, "member BANK_REFERENCE")
  errors = errors + check(dictionary.addMember("BILLED_QUANTITY", "FIELD", "Billed Quantity field", m_billed_quantity) = 0, "member BILLED_QUANTITY")
  errors = errors + check(dictionary.addMember("BIN_LOCATION", "FIELD", "Bin Location field", m_bin_location) = 0, "member BIN_LOCATION")
  errors = errors + check(dictionary.addMember("BUDGET_AMOUNT", "FIELD", "Budget Amount field", m_budget_amount) = 0, "member BUDGET_AMOUNT")
  errors = errors + check(dictionary.addMember("BUYER_NUMBER", "FIELD", "Buyer Number field", m_buyer_number) = 0, "member BUYER_NUMBER")
  errors = errors + check(dictionary.addMember("CAPACITY", "FIELD", "Capacity field", m_capacity) = 0, "member CAPACITY")
  errors = errors + check(dictionary.addMember("CARRIER", "FIELD", "Carrier field", m_carrier) = 0, "member CARRIER")
  errors = errors + check(dictionary.addMember("CITY", "FIELD", "City field", m_city) = 0, "member CITY")
  errors = errors + check(dictionary.addMember("CONTACT_EMAIL", "FIELD", "Contact Email field", m_contact_email) = 0, "member CONTACT_EMAIL")
  errors = errors + check(dictionary.addMember("CONTACT_NAME", "FIELD", "Contact Name field", m_contact_name) = 0, "member CONTACT_NAME")
  errors = errors + check(dictionary.addMember("CONTACT_PHONE", "FIELD", "Contact Phone field", m_contact_phone) = 0, "member CONTACT_PHONE")
  errors = errors + check(dictionary.addMember("COST_CENTER", "FIELD", "Cost Center field", m_cost_center) = 0, "member COST_CENTER")
  errors = errors + check(dictionary.addMember("COUNTRY", "FIELD", "Country field", m_country) = 0, "member COUNTRY")
  errors = errors + check(dictionary.addMember("CREATED_BY", "FIELD", "Created By field", m_created_by) = 0, "member CREATED_BY")
  errors = errors + check(dictionary.addMember("CREDIT_LIMIT", "FIELD", "Credit Limit field", m_credit_limit) = 0, "member CREDIT_LIMIT")
  errors = errors + check(dictionary.addMember("CURRENCY_CODE", "FIELD", "Currency Code field", m_currency_code) = 0, "member CURRENCY_CODE")
  errors = errors + check(dictionary.addMember("CUSTOMER_CATEGORY", "FIELD", "Customer Category field", m_customer_category) = 0, "member CUSTOMER_CATEGORY")
  errors = errors + check(dictionary.addMember("CUSTOMER_NAME", "FIELD", "Customer Name field", m_customer_name) = 0, "member CUSTOMER_NAME")
  errors = errors + check(dictionary.addMember("CUSTOMER_NUMBER", "FIELD", "Customer Number field", m_customer_number) = 0, "member CUSTOMER_NUMBER")
  errors = errors + check(dictionary.addMember("CUSTOMER_STATUS", "FIELD", "Customer Status field", m_customer_status) = 0, "member CUSTOMER_STATUS")
  errors = errors + check(dictionary.addMember("DATE", "FIELD", "Date field", m_date) = 0, "member DATE")
  errors = errors + check(dictionary.addMember("DEPARTMENT_NAME", "FIELD", "Department Name field", m_department_name) = 0, "member DEPARTMENT_NAME")
  errors = errors + check(dictionary.addMember("DEPARTMENT_NUMBER", "FIELD", "Department Number field", m_department_number) = 0, "member DEPARTMENT_NUMBER")
  errors = errors + check(dictionary.addMember("DEPARTMENT_STATUS", "FIELD", "Department Status field", m_department_status) = 0, "member DEPARTMENT_STATUS")
  errors = errors + check(dictionary.addMember("DESTINATION_LOCATION", "FIELD", "Destination Location field", m_destination_location) = 0, "member DESTINATION_LOCATION")
  errors = errors + check(dictionary.addMember("DISCOUNT_RATE", "FIELD", "Discount Rate field", m_discount_rate) = 0, "member DISCOUNT_RATE")
  errors = errors + check(dictionary.addMember("EMPLOYEE_NAME", "FIELD", "Employee Name field", m_employee_name) = 0, "member EMPLOYEE_NAME")
  errors = errors + check(dictionary.addMember("EMPLOYEE_NUMBER", "FIELD", "Employee Number field", m_employee_number) = 0, "member EMPLOYEE_NUMBER")
  errors = errors + check(dictionary.addMember("EMPLOYMENT_STATUS", "FIELD", "Employment Status field", m_employment_status) = 0, "member EMPLOYMENT_STATUS")
  errors = errors + check(dictionary.addMember("INVENTORY_STATUS", "FIELD", "Inventory Status field", m_inventory_status) = 0, "member INVENTORY_STATUS")
  errors = errors + check(dictionary.addMember("INVOICE_NUMBER", "FIELD", "Invoice Number field", m_invoice_number) = 0, "member INVOICE_NUMBER")
  errors = errors + check(dictionary.addMember("INVOICE_STATUS", "FIELD", "Invoice Status field", m_invoice_status) = 0, "member INVOICE_STATUS")
  errors = errors + check(dictionary.addMember("JOB_TITLE", "FIELD", "Job Title field", m_job_title) = 0, "member JOB_TITLE")
  errors = errors + check(dictionary.addMember("LINE_AMOUNT", "FIELD", "Line Amount field", m_line_amount) = 0, "member LINE_AMOUNT")
  errors = errors + check(dictionary.addMember("LINE_NUMBER", "FIELD", "Line Number field", m_line_number) = 0, "member LINE_NUMBER")
  errors = errors + check(dictionary.addMember("LINE_STATUS", "FIELD", "Line Status field", m_line_status) = 0, "member LINE_STATUS")
  errors = errors + check(dictionary.addMember("MANAGER", "FIELD", "Manager field", m_manager) = 0, "member MANAGER")
  errors = errors + check(dictionary.addMember("MANAGER_NUMBER", "FIELD", "Manager Number field", m_manager_number) = 0, "member MANAGER_NUMBER")
  errors = errors + check(dictionary.addMember("MINIMUM_QUANTITY", "FIELD", "Minimum Quantity field", m_minimum_quantity) = 0, "member MINIMUM_QUANTITY")
  errors = errors + check(dictionary.addMember("MOVEMENT_NUMBER", "FIELD", "Movement Number field", m_movement_number) = 0, "member MOVEMENT_NUMBER")
  errors = errors + check(dictionary.addMember("MOVEMENT_QUANTITY", "FIELD", "Movement Quantity field", m_movement_quantity) = 0, "member MOVEMENT_QUANTITY")
  errors = errors + check(dictionary.addMember("MOVEMENT_TYPE", "FIELD", "Movement Type field", m_movement_type) = 0, "member MOVEMENT_TYPE")
  errors = errors + check(dictionary.addMember("ORDERED_QUANTITY", "FIELD", "Ordered Quantity field", m_ordered_quantity) = 0, "member ORDERED_QUANTITY")
  errors = errors + check(dictionary.addMember("ORDER_STATUS", "FIELD", "Order Status field", m_order_status) = 0, "member ORDER_STATUS")
  errors = errors + check(dictionary.addMember("PACKAGE_NUMBER", "FIELD", "Package Number field", m_package_number) = 0, "member PACKAGE_NUMBER")
  errors = errors + check(dictionary.addMember("PAYMENT_AMOUNT", "FIELD", "Payment Amount field", m_payment_amount) = 0, "member PAYMENT_AMOUNT")
  errors = errors + check(dictionary.addMember("PAYMENT_METHOD", "FIELD", "Payment Method field", m_payment_method) = 0, "member PAYMENT_METHOD")
  errors = errors + check(dictionary.addMember("PAYMENT_NUMBER", "FIELD", "Payment Number field", m_payment_number) = 0, "member PAYMENT_NUMBER")
  errors = errors + check(dictionary.addMember("PAYMENT_STATUS", "FIELD", "Payment Status field", m_payment_status) = 0, "member PAYMENT_STATUS")
  errors = errors + check(dictionary.addMember("PAYMENT_TERMS", "FIELD", "Payment Terms field", m_payment_terms) = 0, "member PAYMENT_TERMS")
  errors = errors + check(dictionary.addMember("POSTCODE", "FIELD", "Postcode field", m_postcode) = 0, "member POSTCODE")
  errors = errors + check(dictionary.addMember("PRODUCT_CATEGORY", "FIELD", "Product Category field", m_product_category) = 0, "member PRODUCT_CATEGORY")
  errors = errors + check(dictionary.addMember("PRODUCT_NAME", "FIELD", "Product Name field", m_product_name) = 0, "member PRODUCT_NAME")
  errors = errors + check(dictionary.addMember("PRODUCT_NUMBER", "FIELD", "Product Number field", m_product_number) = 0, "member PRODUCT_NUMBER")
  errors = errors + check(dictionary.addMember("PRODUCT_STATUS", "FIELD", "Product Status field", m_product_status) = 0, "member PRODUCT_STATUS")
  errors = errors + check(dictionary.addMember("PURCHASE_ORDER_NUMBER", "FIELD", "Purchase Order Number field", m_purchase_order_number) = 0, "member PURCHASE_ORDER_NUMBER")
  errors = errors + check(dictionary.addMember("PURCHASE_REGION", "FIELD", "Purchase Region field", m_purchase_region) = 0, "member PURCHASE_REGION")
  errors = errors + check(dictionary.addMember("PURCHASE_STATUS", "FIELD", "Purchase Status field", m_purchase_status) = 0, "member PURCHASE_STATUS")
  errors = errors + check(dictionary.addMember("QUANTITY_ON_HAND", "FIELD", "Quantity On Hand field", m_quantity_on_hand) = 0, "member QUANTITY_ON_HAND")
  errors = errors + check(dictionary.addMember("QUANTITY_RESERVED", "FIELD", "Quantity Reserved field", m_quantity_reserved) = 0, "member QUANTITY_RESERVED")
  errors = errors + check(dictionary.addMember("RATING", "FIELD", "Rating field", m_rating) = 0, "member RATING")
  errors = errors + check(dictionary.addMember("REFERENCE_NUMBER", "FIELD", "Reference Number field", m_reference_number) = 0, "member REFERENCE_NUMBER")
  errors = errors + check(dictionary.addMember("REFUND_AMOUNT", "FIELD", "Refund Amount field", m_refund_amount) = 0, "member REFUND_AMOUNT")
  errors = errors + check(dictionary.addMember("REORDER_LEVEL", "FIELD", "Reorder Level field", m_reorder_level) = 0, "member REORDER_LEVEL")
  errors = errors + check(dictionary.addMember("REORDER_QUANTITY", "FIELD", "Reorder Quantity field", m_reorder_quantity) = 0, "member REORDER_QUANTITY")
  errors = errors + check(dictionary.addMember("RETURNED_QUANTITY", "FIELD", "Returned Quantity field", m_returned_quantity) = 0, "member RETURNED_QUANTITY")
  errors = errors + check(dictionary.addMember("RETURN_NUMBER", "FIELD", "Return Number field", m_return_number) = 0, "member RETURN_NUMBER")
  errors = errors + check(dictionary.addMember("RETURN_REASON", "FIELD", "Return Reason field", m_return_reason) = 0, "member RETURN_REASON")
  errors = errors + check(dictionary.addMember("RETURN_STATUS", "FIELD", "Return Status field", m_return_status) = 0, "member RETURN_STATUS")
  errors = errors + check(dictionary.addMember("SALESPERSON_NUMBER", "FIELD", "Salesperson Number field", m_salesperson_number) = 0, "member SALESPERSON_NUMBER")
  errors = errors + check(dictionary.addMember("SALES_ORDER_NUMBER", "FIELD", "Sales Order Number field", m_sales_order_number) = 0, "member SALES_ORDER_NUMBER")
  errors = errors + check(dictionary.addMember("SALES_REGION", "FIELD", "Sales Region field", m_sales_region) = 0, "member SALES_REGION")
  errors = errors + check(dictionary.addMember("SHIPMENT_NUMBER", "FIELD", "Shipment Number field", m_shipment_number) = 0, "member SHIPMENT_NUMBER")
  errors = errors + check(dictionary.addMember("SHIPMENT_STATUS", "FIELD", "Shipment Status field", m_shipment_status) = 0, "member SHIPMENT_STATUS")
  errors = errors + check(dictionary.addMember("SHIPPED_QUANTITY", "FIELD", "Shipped Quantity field", m_shipped_quantity) = 0, "member SHIPPED_QUANTITY")
  errors = errors + check(dictionary.addMember("SHIPPING_COST", "FIELD", "Shipping Cost field", m_shipping_cost) = 0, "member SHIPPING_COST")
  errors = errors + check(dictionary.addMember("SOURCE_LOCATION", "FIELD", "Source Location field", m_source_location) = 0, "member SOURCE_LOCATION")
  errors = errors + check(dictionary.addMember("STANDARD_COST", "FIELD", "Standard Cost field", m_standard_cost) = 0, "member STANDARD_COST")
  errors = errors + check(dictionary.addMember("STREET", "FIELD", "Street field", m_street) = 0, "member STREET")
  errors = errors + check(dictionary.addMember("SUBTOTAL", "FIELD", "Subtotal field", m_subtotal) = 0, "member SUBTOTAL")
  errors = errors + check(dictionary.addMember("SUPPLIER_CATEGORY", "FIELD", "Supplier Category field", m_supplier_category) = 0, "member SUPPLIER_CATEGORY")
  errors = errors + check(dictionary.addMember("SUPPLIER_NAME", "FIELD", "Supplier Name field", m_supplier_name) = 0, "member SUPPLIER_NAME")
  errors = errors + check(dictionary.addMember("SUPPLIER_NUMBER", "FIELD", "Supplier Number field", m_supplier_number) = 0, "member SUPPLIER_NUMBER")
  errors = errors + check(dictionary.addMember("SUPPLIER_STATUS", "FIELD", "Supplier Status field", m_supplier_status) = 0, "member SUPPLIER_STATUS")
  errors = errors + check(dictionary.addMember("TAX_AMOUNT", "FIELD", "Tax Amount field", m_tax_amount) = 0, "member TAX_AMOUNT")
  errors = errors + check(dictionary.addMember("TAX_NUMBER", "FIELD", "Tax Number field", m_tax_number) = 0, "member TAX_NUMBER")
  errors = errors + check(dictionary.addMember("TAX_RATE", "FIELD", "Tax Rate field", m_tax_rate) = 0, "member TAX_RATE")
  errors = errors + check(dictionary.addMember("TAX_REGISTRATION", "FIELD", "Tax Registration field", m_tax_registration) = 0, "member TAX_REGISTRATION")
  errors = errors + check(dictionary.addMember("TIME", "FIELD", "Time field", m_time) = 0, "member TIME")
  errors = errors + check(dictionary.addMember("TOTAL_AMOUNT", "FIELD", "Total Amount field", m_total_amount) = 0, "member TOTAL_AMOUNT")
  errors = errors + check(dictionary.addMember("TRACKING_NUMBER", "FIELD", "Tracking Number field", m_tracking_number) = 0, "member TRACKING_NUMBER")
  errors = errors + check(dictionary.addMember("UNIT_OF_MEASURE", "FIELD", "Unit Of Measure field", m_unit_of_measure) = 0, "member UNIT_OF_MEASURE")
  errors = errors + check(dictionary.addMember("UNIT_PRICE", "FIELD", "Unit Price field", m_unit_price) = 0, "member UNIT_PRICE")
  errors = errors + check(dictionary.addMember("UPDATED_BY", "FIELD", "Updated By field", m_updated_by) = 0, "member UPDATED_BY")
  errors = errors + check(dictionary.addMember("WAREHOUSE_NAME", "FIELD", "Warehouse Name field", m_warehouse_name) = 0, "member WAREHOUSE_NAME")
  errors = errors + check(dictionary.addMember("WAREHOUSE_NUMBER", "FIELD", "Warehouse Number field", m_warehouse_number) = 0, "member WAREHOUSE_NUMBER")
  errors = errors + check(dictionary.addMember("WAREHOUSE_STATUS", "FIELD", "Warehouse Status field", m_warehouse_status) = 0, "member WAREHOUSE_STATUS")
  errors = errors + check(dictionary.addMember("WAREHOUSE_TYPE", "FIELD", "Warehouse Type field", m_warehouse_type) = 0, "member WAREHOUSE_TYPE")
  errors = errors + check(dictionary.addMember("WEIGHT", "FIELD", "Weight field", m_weight) = 0, "member WEIGHT")

  /* Do not use invalid IDs if any member creation failed. */
  if errors <> 0 then do
    say "FAIL: member creation errors=" || errors
    close_rc = dictionary.close()
    return 1
  end

  /* ACCOUNT_NUMBER deliberately identifies two members. */
  errors = errors + check(dictionary.addAlias(m_date, "CALENDAR_DATE") = 0, "alias DATE CALENDAR_DATE")
  errors = errors + check(dictionary.addAlias(m_date, "DAY") = 0, "alias DATE DAY")
  errors = errors + check(dictionary.addAlias(m_customer_number, "ACCOUNT_NUMBER") = 0, "alias CUSTOMER_NUMBER ACCOUNT_NUMBER")
  errors = errors + check(dictionary.addAlias(m_supplier_number, "ACCOUNT_NUMBER") = 0, "alias SUPPLIER_NUMBER ACCOUNT_NUMBER")
  errors = errors + check(dictionary.addAlias(m_product_number, "ITEM_NUMBER") = 0, "alias PRODUCT_NUMBER ITEM_NUMBER")
  errors = errors + check(dictionary.addAlias(m_product_name, "ITEM_NAME") = 0, "alias PRODUCT_NAME ITEM_NAME")

  /* Ordered occurrences; repeated successors are intentional. */

  /* ADDRESS_GROUP */
  errors = errors + check(dictionary.addReference(m_address_group, m_street, "contains", 1, "") = 0, "ADDRESS_GROUP position 1 STREET")
  errors = errors + check(dictionary.addReference(m_address_group, m_city, "contains", 2, "") = 0, "ADDRESS_GROUP position 2 CITY")
  errors = errors + check(dictionary.addReference(m_address_group, m_postcode, "contains", 3, "") = 0, "ADDRESS_GROUP position 3 POSTCODE")
  errors = errors + check(dictionary.addReference(m_address_group, m_country, "contains", 4, "") = 0, "ADDRESS_GROUP position 4 COUNTRY")

  /* CONTACT_GROUP */
  errors = errors + check(dictionary.addReference(m_contact_group, m_contact_name, "contains", 1, "") = 0, "CONTACT_GROUP position 1 CONTACT_NAME")
  errors = errors + check(dictionary.addReference(m_contact_group, m_contact_phone, "contains", 2, "") = 0, "CONTACT_GROUP position 2 CONTACT_PHONE")
