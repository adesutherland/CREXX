  rows = .string[]
  report_rc = dictionary.executeCommand("MEMBERS", "", rows)
  errors = errors + check(report_rc = 0, "list members")
  if report_rc = 0 then do
    formatted = .string[]
    format_rc = report.formatMembers(rows, formatted)
    errors = errors + check(format_rc = 0, "format members")
    if format_rc = 0 then do
      do i = 1 to formatted[0]
        say formatted[i]
      end
    end
