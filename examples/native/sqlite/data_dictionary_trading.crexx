/* Trading and warehouse data dictionary sample.
   Use a fresh database: the default :memory: database is empty on each run.
   Optional argument: a path to a new, empty SQLite database.
   This is illustrative dictionary data, not a physical record layout. */
options levelb

import data_DataDictionary
import data_DataDictionaryReport

check: procedure = .int
  arg condition = .boolean, label = .string
  if \condition then do
    say "FAIL: " || label
    return 1
  end
  return 0

main: procedure = .int
  arg args = .string[]
  filename = ":memory:"
  if args.0 > 0 then filename = args[1]
  dictionary = .DataDictionary()
  report = .DataDictionaryReport()
  errors = 0
  errors = errors + check(dictionary.open(filename) = 0, "open")
  if errors <> 0 then return 1

  /* Each output variable receives the new member ID. */
  m_customer_record = 0
  m_supplier_record = 0
  m_product_record = 0
  m_warehouse_record = 0
  m_inventory_record = 0
  m_purchase_order_record = 0
  m_purchase_line_record = 0
  m_sales_order_record = 0
  m_sales_line_record = 0
  m_invoice_record = 0
  m_invoice_line_record = 0
  m_payment_record = 0
  m_shipment_record = 0
  m_shipment_line_record = 0
  m_return_record = 0
  m_return_line_record = 0
  m_employee_record = 0
  m_department_record = 0
  m_stock_movement_record = 0
  m_price_agreement_record = 0
  m_address_group = 0
  m_contact_group = 0
  m_audit_group = 0
  m_money_group = 0
  m_agreement_number = 0
  m_agreement_status = 0
  m_amount = 0
  m_approval_code = 0
  m_bank_reference = 0
  m_billed_quantity = 0
  m_bin_location = 0
  m_budget_amount = 0
  m_buyer_number = 0
  m_capacity = 0
  m_carrier = 0
  m_city = 0
  m_contact_email = 0
  m_contact_name = 0
  m_contact_phone = 0
  m_cost_center = 0
  m_country = 0
  m_created_by = 0
  m_credit_limit = 0
  m_currency_code = 0
  m_customer_category = 0
  m_customer_name = 0
  m_customer_number = 0
  m_customer_status = 0
  m_date = 0
  m_department_name = 0
  m_department_number = 0
  m_department_status = 0
  m_destination_location = 0
  m_discount_rate = 0
  m_employee_name = 0
  m_employee_number = 0
  m_employment_status = 0
  m_inventory_status = 0
  m_invoice_number = 0
  m_invoice_status = 0
  m_job_title = 0
  m_line_amount = 0
  m_line_number = 0
  m_line_status = 0
  m_manager = 0
  m_manager_number = 0
  m_minimum_quantity = 0
  m_movement_number = 0
  m_movement_quantity = 0
  m_movement_type = 0
  m_ordered_quantity = 0
  m_order_status = 0
  m_package_number = 0
  m_payment_amount = 0
  m_payment_method = 0
  m_payment_number = 0
  m_payment_status = 0
  m_payment_terms = 0
  m_postcode = 0
  m_product_category = 0
  m_product_name = 0
  m_product_number = 0
  m_product_status = 0
  m_purchase_order_number = 0
  m_purchase_region = 0
  m_purchase_status = 0
  m_quantity_on_hand = 0
  m_quantity_reserved = 0
  m_rating = 0
  m_reference_number = 0
  m_refund_amount = 0
  m_reorder_level = 0
  m_reorder_quantity = 0
  m_returned_quantity = 0
  m_return_number = 0
  m_return_reason = 0
  m_return_status = 0
  m_salesperson_number = 0
  m_sales_order_number = 0
  m_sales_region = 0
  m_shipment_number = 0
  m_shipment_status = 0
  m_shipped_quantity = 0
  m_shipping_cost = 0
  m_source_location = 0
  m_standard_cost = 0
  m_street = 0
  m_subtotal = 0
  m_supplier_category = 0
  m_supplier_name = 0
  m_supplier_number = 0
  m_supplier_status = 0
  m_tax_amount = 0
  m_tax_number = 0
  m_tax_rate = 0
  m_tax_registration = 0
  m_time = 0
  m_total_amount = 0
  m_tracking_number = 0
  m_unit_of_measure = 0
  m_unit_price = 0
  m_updated_by = 0
  m_warehouse_name = 0
  m_warehouse_number = 0
  m_warehouse_status = 0
  m_warehouse_type = 0
  m_weight = 0

  /* Add all members before creating aliases or references. */
  errors = errors + check(dictionary.addMember("CUSTOMER_RECORD", "RECORD", "Customer record", m_customer_record) = 0, "member CUSTOMER_RECORD")
  errors = errors + check(dictionary.addMember("SUPPLIER_RECORD", "RECORD", "Supplier record", m_supplier_record) = 0, "member SUPPLIER_RECORD")
  errors = errors + check(dictionary.addMember("PRODUCT_RECORD", "RECORD", "Product record", m_product_record) = 0, "member PRODUCT_RECORD")
  errors = errors + check(dictionary.addMember("WAREHOUSE_RECORD", "RECORD", "Warehouse record", m_warehouse_record) = 0, "member WAREHOUSE_RECORD")
