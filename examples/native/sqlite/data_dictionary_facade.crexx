ddReportFail: procedure = .int expose last_error last_rc
  arg message = .string
  last_error = message
  last_rc = -1
  return -1

ddFail: procedure = .int expose last_error last_rc active_ failed_ first_error current_name
  arg message = .string
  if active_ <> 0 then last_error = current_name || ": " || message
  else last_error = message
  last_rc = -1
  if active_ <> 0 & failed_ = 0 then do
    failed_ = 1
    first_error = last_error
  end
  return -1

ddSuccess: procedure = .int expose last_error last_rc
  last_error = ""
  last_rc = 0
  return 0

ddSequenceFailure: procedure = .int expose last_error last_rc session_error session_rc
  last_error = session_error
  last_rc = session_rc
  return session_rc

ddDefinitionFailure: procedure = .int expose last_error last_rc first_error
  last_error = first_error
  last_rc = -1
  return -1

facadeInvalidText: procedure = .int
  arg value = .string
  return pos("|", value) <> 0
