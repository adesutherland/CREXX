ddMemberReport: procedure = .string[] expose dictionary report open_ active_ last_error last_rc
  arg member_name = .string
  lines = .string[]
  if open_ = 0 then do
    call ddReportFail("ddMemberReport: dictionary is not open")
    return lines
  end
  if active_ <> 0 then do
    call ddReportFail("ddMemberReport: complete the active definition first")
    return lines
  end
  details = ""
  rc = dictionary.getMemberDetails(member_name, details)
  if rc <> 0 then do
    call ddReportFail(member_name || ": ddMemberReport query rc=" || rc)
    return lines
  end
  member_id = .int
  rc = dictionary.getMemberId(member_name, member_id)
  if rc <> 0 then do
    call ddReportFail(member_name || ": ddMemberReport query rc=" || rc)
    return lines
  end
  attributes = .string[]
  outgoing = .string[]
  incoming = .string[]
  rc = dictionary.listAttributes(member_id, attributes)
  if rc = 0 then rc = dictionary.getSuccessorLinks(member_id, outgoing)
  if rc = 0 then rc = dictionary.getCallerLinks(member_id, incoming)
  if rc <> 0 then do
    call ddReportFail(member_name || ": ddMemberReport query rc=" || rc)
    return lines
  end
  rc = report.formatMemberReport(details, attributes, outgoing, incoming, lines)
  if rc <> 0 then do
    call ddReportFail(member_name || ": ddMemberReport format rc=" || rc)
    empty = .string[]
    return empty
  end
  call ddSuccess
  return lines

ddBom: procedure = .string[] expose dictionary report open_ active_ last_error last_rc
  arg member_name = .string, max_depth = 0, link_type = ""
