{
  "include": [
    {
      "id": "linux",
      "name": "Linux x64 Vulkan",
      "os": "ubuntu-24.04",
      "platform": "linux",
      "toolchain": "gcc",
      "artifact_name": "llama.rexx-linux-x64-vulkan",
      "build_jobs": 2,
      "test_jobs": 5,
      "backends": "cpu,vulkan",
      "cuda": false,
      "cmake_args": "-DCREXX_LLAMA_VULKAN=ON",
      "core_platform": "linux-x64",
      "backend": "vulkan"
    },
    {
      "id": "windows",
      "name": "Windows x64 Vulkan (MSVC)",
      "os": "windows-2025",
      "platform": "windows",
      "toolchain": "msvc",
      "artifact_name": "llama.rexx-windows-x64-vulkan",
      "build_jobs": 2,
      "test_jobs": 2,
      "backends": "cpu,vulkan",
      "cuda": false,
      "cmake_args": "-DCMAKE_C_COMPILER=cl -DCMAKE_CXX_COMPILER=cl -DENABLE_PARSER_MODE=OFF -DCREXX_LLAMA_VULKAN=ON",
      "core_platform": "windows-x64",
      "backend": "vulkan"
    },
    {
      "id": "macos-arm64",
      "name": "macOS arm64 Metal",
      "os": "macos-15",
      "platform": "macos",
      "toolchain": "clang",
      "artifact_name": "llama.rexx-macos-arm64-metal",
      "build_jobs": 2,
      "test_jobs": 5,
      "backends": "cpu,metal",
      "cuda": false,
      "cmake_args": "-DCMAKE_OSX_ARCHITECTURES=arm64",
      "core_platform": "macos-arm64",
      "backend": "metal"
    },
    {
      "id": "macos-intel",
      "name": "macOS x86_64 Metal",
      "os": "macos-15-intel",
      "platform": "macos",
      "toolchain": "clang",
      "artifact_name": "llama.rexx-macos-x86_64-metal",
      "build_jobs": 2,
      "test_jobs": 5,
      "backends": "cpu,metal",
      "cuda": false,
      "cmake_args": "-DCMAKE_OSX_ARCHITECTURES=x86_64",
      "core_platform": "macos-x86_64",
      "backend": "metal"
    },
    {
      "id": "linux-cuda",
      "name": "Linux x64 CUDA",
      "os": "ubuntu-24.04",
      "platform": "linux",
      "toolchain": "gcc",
      "artifact_name": "llama.rexx-linux-x64-cuda",
      "build_jobs": 2,
      "test_jobs": 5,
      "backends": "cpu,cuda",
      "cuda": true,
      "cmake_args": "-DCREXX_LLAMA_CUDA=ON -DCMAKE_C_COMPILER_LAUNCHER=sccache -DCMAKE_CXX_COMPILER_LAUNCHER=sccache -DCMAKE_CUDA_COMPILER_LAUNCHER=sccache",
      "core_platform": "linux-x64",
      "backend": "cuda"
    },
    {
      "id": "windows-cuda",
      "name": "Windows x64 CUDA (MSVC)",
      "os": "windows-2025",
      "platform": "windows",
      "toolchain": "msvc",
      "artifact_name": "llama.rexx-windows-x64-cuda",
      "build_jobs": 2,
      "test_jobs": 2,
      "backends": "cpu,cuda",
      "cuda": true,
      "cmake_args": "-DCMAKE_C_COMPILER=cl -DCMAKE_CXX_COMPILER=cl -DENABLE_PARSER_MODE=OFF -DCREXX_LLAMA_CUDA=ON -DCMAKE_C_COMPILER_LAUNCHER=sccache -DCMAKE_CXX_COMPILER_LAUNCHER=sccache -DCMAKE_CUDA_COMPILER_LAUNCHER=sccache",
      "core_platform": "windows-x64",
      "backend": "cuda"
    }
  ]
}
