//CRXCG PROC FLAGS='-n',ARGS=,WORK=CRX,
// RXLIB='@RXBIN@',
// ROOT='@ROOT@'
//COMP EXEC PGM=RXC,PARM='&FLAGS -i &ROOT -o DD:ASM DD:SRC',
// COND=(0,NE),REGION=256M
//SYSIN DD DUMMY
//SYSPRINT DD SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//SYSTERM DD SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//SRC DD DUMMY
//ASM DD DSN=&&&WORK.A,DISP=(NEW,PASS,DELETE),
// @ALLOC@
// SPACE=(TRK,(20,0)),DCB=(RECFM=VB,LRECL=4100,BLKSIZE=8200)
//ASSEM EXEC PGM=RXAS,PARM='-o DD:SYSGO DD:ASM',
// COND=(0,NE),REGION=256M
//SYSIN DD DUMMY
//SYSPRINT DD SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//SYSTERM DD SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//ASM DD DSN=&&&WORK.A,DISP=(OLD,DELETE,DELETE)
//SYSGO DD DSN=&&&WORK.O,DISP=(NEW,PASS,DELETE),
// @ALLOC@
// SPACE=(TRK,(20,0)),DCB=(RECFM=VB,LRECL=260,BLKSIZE=264)
//RUN EXEC PGM=RXVM,PARM='--no-autoload DD:SYSGO DD:LIBRARY &ARGS',
// COND=(0,NE),REGION=256M
//SYSIN DD DUMMY
//SYSPRINT DD SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//SYSTERM DD SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//SYSGO DD DSN=&&&WORK.O,DISP=(OLD,DELETE,DELETE)
//LIBRARY DD DSN=&RXLIB(LIBRARY),DISP=SHR
// PEND
