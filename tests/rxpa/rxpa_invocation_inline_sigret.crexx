/* A checked target must survive a logical inline SIGRET and complete once. */
options levelb
import rxinvoke

main: procedure = .int
  arg argv = .string[]
  names = .string[]; types = .string[]; signatures = .string[]; providers = .string[]
  names[1] = 'scopechecked.target'; types[1] = '.int'
  signatures[1] = 'value=.int'; providers[1] = ''
  catalogue = .rxinvoke..catalogue(names,types,signatures,providers)
  binding = .rxinvoke..binding(catalogue,1)
  cells = .rxinvoke..scalar[]; presence = .int[]
  original = rxinvoke..integer(35); cells[1] = original; presence[1] = 1
  request = rxinvoke..prepare(binding,cells,presence,1,32768)
  if request.state() <> 'sealed' then return 1
  continued = 0
  call rxinvoke..invoke(request)
  continued = continued + 1
  result = request.result()
  if continued <> 1 | request.state() <> 'complete' then return 2
  if result.asint() <> 36 | original.asint() <> 35 then return 3
  replay = 0
  do
    call rxinvoke..invoke(request)
  on signal invalid_arguments
    replay = replay + 1
  end
  if replay <> 1 | request.state() <> 'complete' | result.asint() <> 36 then return 4

  /* A second physical checked frame catches leaked scope or signal policy. */
  request = rxinvoke..prepare(binding,cells,presence,1,32768)
  call rxinvoke..invoke(request)
  continued = continued + 1
  result = request.result()
  if continued <> 2 | request.state() <> 'complete' then return 5
  if result.asint() <> 36 | original.asint() <> 35 then return 6
  say 'CHECKED_INLINE_SIGRET_PASS'
  return 0
