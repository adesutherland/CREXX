/* rxpa native payload copy/finalizer test */

options levelb
import rxpatests

say "RXPA Native Payload Tests"

call native_payload_reset

payload = native_payload_make(77)
copy = payload

if native_payload_id(payload) \= 77 then do
    say 'native_payload_make() produced unexpected payload id' native_payload_id(payload)
    return 1
end

if native_payload_id(copy) \= 77 then do
    say 'native payload copy produced unexpected payload id' native_payload_id(copy)
    return 1
end

if native_payload_copies() < 1 then do
    say 'native payload copy hook was not called'
    return 1
end

stale = native_payload_make(88)
finalizers_before = native_payload_finalizers()
stale = 0
if native_payload_finalizers() <= finalizers_before then do
    say 'native payload finalizer was not called when scalar overwrite reused a register'
    return 1
end

call native_payload_clear payload
if native_payload_finalizers() < 1 then do
    say 'native payload finalizer was not called for original payload'
    return 1
end

call native_payload_clear copy
if native_payload_finalizers() < 2 then do
    say 'native payload finalizer was not called for copied payload'
    return 1
end

call native_payload_reset
if retire_private_payload() \= 7 then do
    say 'retired private payload call returned an unexpected value'
    return 1
end
if native_payload_finalizers() \= 1 then do
    say 'retired private payload was not finalized at return'
    return 1
end
if retire_private_payload() \= 7 | native_payload_finalizers() \= 2 then do
    say 'reused private frame did not finalize its payload once'
    return 1
end

returned = return_private_payload()
if native_payload_id(returned) \= 103 then do
    say 'returned local payload did not reach the caller'
    return 1
end
finalizers_before = native_payload_finalizers()
call native_payload_clear returned
if native_payload_finalizers() <= finalizers_before then do
    say 'returned local payload was not finalized by its new owner'
    return 1
end

borrowed = native_payload_make(105)
returned_borrowed = return_borrowed_payload(borrowed)
if native_payload_id(borrowed) \= 105 | native_payload_id(returned_borrowed) \= 105 then do
    say 'borrowed return did not preserve both owners'
    return 1
end
call native_payload_clear returned_borrowed
if native_payload_id(borrowed) \= 105 then do
    say 'clearing borrowed return damaged original owner'
    return 1
end
call native_payload_clear borrowed

call native_payload_reset
caught = 0
do
    call unwind_private_payload
    say 'private payload signal unexpectedly resumed'
    return 1
on signal error
    caught = 1
end
if caught \= 1 | native_payload_finalizers() \= 1 then do
    say 'signal unwind did not finalize private payload once'
    return 1
end

say "OK"

return 0

physical_frame_controls: procedure expose PHYSICAL_FRAME_CONTROL
    constant PHYSICAL_FRAME_CONTROL = 0
    return

/* These assertions inspect physical return/unwind retirement, so retain real
 * calls in both compiler modes using the existing exposed-control pattern. */
retire_private_payload: procedure = .int expose PHYSICAL_FRAME_CONTROL
    private_payload = native_payload_make(101)
    if native_payload_id(private_payload) \= 101 then return 0
    return 7

return_private_payload: procedure = .binary expose PHYSICAL_FRAME_CONTROL
    private_payload = native_payload_make(103)
    return private_payload

return_borrowed_payload: procedure = .binary expose PHYSICAL_FRAME_CONTROL
    arg borrowed_payload = .binary
    return borrowed_payload

unwind_private_payload: procedure = .void expose PHYSICAL_FRAME_CONTROL
    private_payload = native_payload_make(107)
    call throw_signal
    return
