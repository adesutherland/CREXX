case_live_bool_target() .locals=5
    ieq r0,r1,32
    .traceevent "O" 4 "R" "B" "r" 0 0 0 0 "" ""
    brt preserve_bool,r0
    load r0,0
preserve_bool:
    load r3,0
    brt done,r0
done:
    ret

