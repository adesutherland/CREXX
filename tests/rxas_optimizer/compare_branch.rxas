* Integer compare plus conditional branch should fuse only when the compare
* result register is dead on both branch paths.

case_ieq_brt_rr() .locals=5
    ieq r0,r1,r2
    .traceevent "O" 4 "R" "B" "r" 0 0 0 0 "" ""
    brt hit_ieq_brt_rr,r0
    ret
hit_ieq_brt_rr:
    ret

case_ieq_brf_rr() .locals=5
    ieq r0,r1,r2
    brf hit_ieq_brf_rr,r0
    ret
hit_ieq_brf_rr:
