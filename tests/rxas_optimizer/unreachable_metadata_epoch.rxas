* M00 metadata-only cleanup must invalidate the immutable epoch before K04.

unreachable_metadata_epoch() .locals=3
    null r1
    ieq r1,r0,0
    .traceevent "O" 4 "R" "B" "r" 1 2 2 0 "result" "result"
    brf done,r1
done:
    ret
dead:
    .srcstep 3 3 17 "unreachable_metadata_epoch.crexx" 3 1 4 "dead"
    .traceevent "V" 4 "R" "I" "r" 1 3 3 0 "dead" "dead"
