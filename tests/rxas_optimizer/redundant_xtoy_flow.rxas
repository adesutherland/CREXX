* PERF3-11 M01 metadata-driven one-register XTOY repetition proof.

itof_old_floor() .locals=24
    load r0,3
    itof r0
    brt itof_old_floor_left,a0
    br itof_old_floor_join
itof_old_floor_left:
    load r23,1
itof_old_floor_join:
    itof r0
    ret r0

ftos_repeat() .locals=24
    load r1,1.25
    ftos r1
    ftos r1
    ret r1

ftos_context_write() .locals=24
    load r2,1.25
    ftos r2
    setnumcas 2
    ftos r2
    ret r2

dtos_repeat() .locals=24
    load r3,12d
    dtos r3
    dtos r3
    ret r3

dtos_context_write() .locals=24
    load r4,12d
    dtos r4
    setnumdgts 18
    dtos r4
    ret r4

itod_repeat() .locals=24
    load r5,12
    itod r5
    itod r5
    ret r5

itod_source_write() .locals=24
    load r6,12
    itod r6
    load r6,13
    itod r6
    ret r6

itod_context_write() .locals=24
    load r7,12
    itod r7
    setnumdgts 19
    itod r7
    ret r7

itod_skip_continuation() .locals=24
    sigcalla xtoy_skip_signal(),"FAILURE"
    load r8,12
    itod r8
    itod r8
    ret r8

itod_trace_batch() .locals=24
    load r9,12
    itod r9
    .traceevent "V" 6 "R" "D" "r" 9 1 1 0 "first-decimal" ""
    itod r9
    .traceevent "A" 6 "R" "D" "r" 9 1 1 0 "second-decimal" ""
    ret r9

itod_link_transfer() .locals=24
    load r10,12
    itod r10
    link r11,r10
    itod r11
    unlink r11
    ret r10

