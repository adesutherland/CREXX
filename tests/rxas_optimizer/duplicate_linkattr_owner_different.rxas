* Equal-looking attributes on different owners are different paths.

main() .locals=10
    setattrs r0,1
    linkattr1 r5,r0,1
    load r6,"payload"
    scopy r5,r6
    unlink r5

    setattrs r7,1
    linkattr1 r8,r7,1
    load r9,"payload"
    scopy r8,r9
    unlink r8

    linkattr1 r1,r0,1
    scopy r2,r1
    unlink r1

    linkattr1 r3,r7,1
    scopy r4,r3
    unlink r3

    say r4
    ret
