* Attribute-count generation changes make the later path distinct.

main() .locals=7
    setattrs r0,1
    linkattr1 r5,r0,1
    load r6,"payload"
    scopy r5,r6
    unlink r5

    linkattr1 r1,r0,1
    scopy r2,r1
    unlink r1

    setattrs r0,2
    linkattr1 r3,r0,1
    scopy r4,r3
    unlink r3

    say r4
    ret
