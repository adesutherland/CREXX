* K05 immutable-CFG branch threading: inherited forms and stronger reach.

br_to_brt() .locals=1
    br br_to_brt_target
    ret
br_to_brt_target:
    .traceevent "O" 4 "R" "B" "r" 0 0 0 0 "br-to-brt" ""
    brt br_to_brt_true,r0
    ret
br_to_brt_true:
    ret

br_to_brf() .locals=2
    br br_to_brf_target
    ret
br_to_brf_target:
    brf br_to_brf_false,r1
    ret
br_to_brf_false:
    ret

br_to_brtf() .locals=3
    br br_to_brtf_target
    ret
br_to_brtf_target:
    brtf br_to_brtf_true,br_to_brtf_false,r2
br_to_brtf_true:
    ret
br_to_brtf_false:
    ret

brt_to_brt() .locals=4
    brt brt_to_brt_target,r3
    ret
brt_to_brt_target:
    brt brt_to_brt_true,r3
    ret
brt_to_brt_true:
    ret

brf_to_brf() .locals=5
