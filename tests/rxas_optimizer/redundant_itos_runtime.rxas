* PERF3-10 runtime equivalence for retained and removed ITOS cases.

main() .locals=10
    numsci 18,1,1

    load r0,41
    itos r0
    itos r0
    seq r9,r0,"41"
    brf failed,r9

    load r1,41
    itos r1
    link r2,r1
    itos r2
    seq r9,r2,"41"
    unlink r2
    brf failed,r9

    load r3,41
    itos r3
    swap r3,r4
    itos r4
    seq r9,r4,"41"
    brf failed,r9

    load r5,41
    itos r5
    inc r5
    itos r5
    seq r9,r5,"42"
    brf failed,r9

    load r6,41
    itos r6
    load r6,"changed"
    itos r6
    seq r9,r6,"41"
    brf failed,r9

    say "PASS: PERF3-10 redundant ITOS runtime"
    ret 0

failed:
    say "FAIL: PERF3-10 redundant ITOS runtime"
    ret 1
