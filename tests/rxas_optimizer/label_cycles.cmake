cmake_minimum_required(VERSION 3.24)
foreach(_name RXAS RXDAS RXVM WORKING_DIRECTORY)
    if(NOT DEFINED ${_name})
        message(FATAL_ERROR "Missing ${_name}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${WORKING_DIRECTORY}")
function(check_cycle name body finite)
    set(source "${WORKING_DIRECTORY}/${name}.rxas")
    file(WRITE "${source}" ".globals=0\nmain() .locals=0\n${body}\nend_label:\n")
    foreach(mode optimized unoptimized)
        set(flags)
        if(mode STREQUAL "unoptimized")
            set(flags -n)
        endif()
        set(stem "${WORKING_DIRECTORY}/${name}-${mode}")
        execute_process(COMMAND "${RXAS}" ${flags} -o "${stem}" "${source}"
                RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "${name}/${mode} assembly failed: ${result}\n${out}${err}")
        endif()
        execute_process(COMMAND "${RXDAS}" -o "${stem}.rxas" "${stem}.rxbin"
                RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "${name}/${mode} disassembly failed: ${result}\n${out}${err}")
        endif()
        file(READ "${stem}.rxas" text)
        if(finite)
            execute_process(COMMAND "${RXVM}" --no-autoload "${stem}.rxbin"
                    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
            if(NOT result STREQUAL "7")
                message(FATAL_ERROR "Finite chain changed result: ${result}\n${out}${err}")
            endif()
        elseif(mode STREQUAL "optimized")
            if(NOT text MATCHES "say[ \t]+\"LOOP READY\"")
                message(FATAL_ERROR "Lost observable entry output: ${text}")
            endif()
            string(REGEX MATCH "([A-Za-z_][A-Za-z0-9_]*):[ \t]+br[ \t]+([A-Za-z_][A-Za-z0-9_]*)" loop "${text}")
            if(NOT loop OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
                message(FATAL_ERROR "Expected a retained self-loop: ${text}")
            endif()
        endif()
    endforeach()
endfunction()
check_cycle(alias_self " say \"LOOP READY\"\nfirst:\nalias:\n br first" FALSE)
check_cycle(two_cycle " say \"LOOP READY\"\nfirst:\n br second\nsecond:\n br first" FALSE)
check_cycle(three_cycle " say \"LOOP READY\"\nfirst:\n br second\nsecond:\n br third\nthird:\n br first" FALSE)
check_cycle(finite " br first\nfirst:\nalias:\n br second\nsecond:\n ret 7" TRUE)
