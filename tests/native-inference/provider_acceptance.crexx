/* STEP-02 ordinary pre-implementation RXPA acceptance.
 * A missing rxllama provider is a failure, never an expected-pass wrapper.
 * Run explicitly until aggregate scheduling has been qualified. */
options levelb floats_binary
import rxfnsb
import rxfnsg
import rxllama

check: procedure = .int
  arg condition = .boolean, label = .string
  if condition then return 0
  say "FAIL: rxllama" label
  return 1

elapsed: procedure = .int
  arg started = .int
  duration = time("us") - started
  if duration < 0 then duration = duration + 86400000000
  return duration

ready_model: procedure = .int
  arg model = .binary
  started = time("us")
  do while elapsed(started) < 600000000
    state = ""
    if rxllama..modelstate(model, state) <> 0 then return 1
    if state = "ready" then return 0
    if state <> "loading" then return 1
  end
  say "FAIL: model preparation deadline"
  return 1

ready_session: procedure = .int
  arg session = .binary
  started = time("us")
  do while elapsed(started) < 600000000
    state = ""
    if rxllama..prepare(session, 512, state) <> 0 then return 1
    if state = "ready" then return 0
    if state = "failed" | state = "cancelled" then return 1
  end
  say "FAIL: session preparation deadline"
  return 1

complete_request: procedure = .int
  arg request = .binary
  started = time("us")
  do while elapsed(started) < 600000000
    state = ""
    if rxllama..process(request, 512, state) <> 0 then return 1
    if state = "complete" then return 0
    if state <> "running" then return 1
  end
  say "FAIL: request deadline"
  return 1

rejected_model: procedure = .int
  arg runtime = .binary, path = .string, hash = .string, config = .binary
  model = .binary
  if rxllama..modelopen(runtime, path, hash, "bge-small-en-v1.5", config, model) <> 0 then return 0
  started = time("us")
  do while elapsed(started) < 600000000
    state = ""
    if rxllama..modelstate(model, state) <> 0 then return 1
    if state = "failed" then return check(rxllama..close(model) = 0, "failed model close")
    if state <> "loading" then return 1
  end
  return 1

embedding_failures: procedure = .int
  arg session = .binary, config = .binary
  request = .binary
  if rxllama..requestopen(session, config, request) <> 0 then return 1
  errors = check(rxllama..submit(request) <> 0, "empty batch rejected")
  errors = errors + check(rxllama..close(request) = 0, "empty request close")
  if rxllama..requestopen(session, config, request) <> 0 then return 1
  row = 0
  status = rxllama..addembedding(request, copies("a ", 513), "document", row)
  if status = 0 then errors = errors + check(rxllama..submit(request) <> 0, "oversized batch rejected")
  errors = errors + check(rxllama..close(request) = 0, "invalid request close")
  if rxllama..requestopen(session, config, request) <> 0 then return 1
  errors = errors + check(rxllama..addprompt(request, "", "Name one animal.", row) <> 0, "embedding capability mismatch")
  values = .packedfloat(0)
  rows = 0
  dimensions = 0
  errors = errors + check(rxllama..embeddings(request, values, rows, dimensions) <> 0, "no incomplete embedding publication")
  errors = errors + check(rxllama..close(request) = 0, "capability failure close")
  return errors

incremental_generation: procedure = .int
  arg session = .binary, config = .binary, cancel_early = .boolean
  request = .binary
  if rxllama..requestopen(session, config, request) <> 0 then return 1
  row = 0
  if rxllama..addprompt(request, "", "Name three animals.", row) <> 0 then return 1
  if rxllama..submit(request) <> 0 then return 1
  errors = 0
  started = time("us")
  count = 0
  iterations = 0
  finish = ""
  state = ""
  do while elapsed(started) < 600000000
    if rxllama..process(request, 1, state) <> 0 then return 1
    iterations = iterations + 1
    if cancel_early & iterations = 1 then do
      errors = errors + check(rxllama..cancel(request) = 0, "active request cancellation")
    end
    if \cancel_early then do
      text = ""
      tokens = 0
      status = rxllama..readtext(request, 1, text, tokens, finish)
      errors = errors + check(status = 0 & tokens >= 0, "incremental text read")
      count = count + tokens
      errors = errors + check(count <= 32, "incremental total output budget")
    end
    if state = "complete" | state = "cancelled" then leave
    if state <> "running" then return 1
  end
  if cancel_early then errors = errors + check(state = "cancelled", "cancelled terminal state")
  else do
    errors = errors + check(state = "complete" & count > 0, "incremental completion")
    errors = errors + check(finish = "eos" | finish = "output_limit", "incremental finish reason")
  end
  errors = errors + check(rxllama..close(request) = 0, "incremental request close")
  return errors

embedding_request: procedure = .int
  arg session = .binary, config = .binary, count = .int
  request = .binary
  if rxllama..requestopen(session, config, request) <> 0 then return 1
  errors = 0
  status = .int
  i = .int
  do i = 1 to count
    row = 0
    text = "A cat sits by the window. Row " || i
    status = rxllama..addembedding(request, text, "document", row)
    errors = errors + check(status = 0 & row = i, "ordered embedding admission")
  end
  errors = errors + check(rxllama..submit(request) = 0, "embedding submit")
  errors = errors + check(complete_request(request) = 0, "embedding completion")
  values = .packedfloat(0)
  rows = 0
  dimensions = 0
  status = rxllama..embeddings(request, values, rows, dimensions)
  errors = errors + check(status = 0 & rows = count & dimensions = 384, "embedding shape")
  errors = errors + check(values.size() = count * 384, "packed vector length")
  if values.size() = count * 384 then do r = 0 to count - 1
    squared_norm = 0.0
    do d = 0 to 383
      value = values.get(r * 384 + d)
      errors = errors + check(value = value & abs(value) <= 1.0, "finite normalized coordinate")
      squared_norm = squared_norm + value * value
    end
    errors = errors + check(abs(squared_norm - 1.0) <= 0.00002, "unit embedding norm")
  end
  errors = errors + check(rxllama..close(request) = 0, "request close")
  errors = errors + check(rxllama..close(request) = 0, "idempotent close")
  errors = errors + check(rxllama..submit(request) <> 0, "closed request rejected")
  return errors

generation_request: procedure = .int
  arg session = .binary, config = .binary, count = .int
  request = .binary
  if rxllama..requestopen(session, config, request) <> 0 then return 1
  errors = 0
  status = .int
  i = .int
  do i = 1 to count
    row = 0
    status = rxllama..addprompt(request, "", "Name one animal. Request row " || i, row)
    errors = errors + check(status = 0 & row = i, "ordered prompt admission")
  end
  errors = errors + check(rxllama..submit(request) = 0, "generation submit")
  errors = errors + check(complete_request(request) = 0, "generation completion")
  all_tokens = 0
  do i = 1 to count
    text = ""
    tokens = 0
    finish = ""
    status = rxllama..readtext(request, i, text, tokens, finish)
    errors = errors + check(status = 0 & tokens >= 0 & tokens <= 32, "bounded generated tokens")
    errors = errors + check(finish = "eos" | finish = "output_limit", "generation finish reason")
    all_tokens = all_tokens + tokens
  end
  errors = errors + check(all_tokens > 0, "generation positive output")
  errors = errors + check(rxllama..close(request) = 0, "generation request close")
  return errors

main: procedure = .int
  arg args = .string[]
  if args.0 <> 4 & args.0 <> 5 then do
    say "Usage: provider_acceptance BGE_F16_PATH SHA256 SMOL_Q8_PATH SHA256 [cpu|auto|required-gpu]"
    return 2
  end
  mode = "cpu"
  if args.0 = 5 then mode = args[5]
  config = .binary
  runtime = .binary
  model = .binary
  session = .binary
  i = .int
  if rxllama..configcreate(config) <> 0 then return 1
  errors = check(rxllama..configtext(config, "hardware_mode", mode) = 0, "hardware mode")
  errors = errors + check(rxllama..configint(config, "memory_bytes", 4294967296) = 0, "memory budget")
  errors = errors + check(rxllama..configint(config, "output_tokens", 32) = 0, "output budget")
  errors = errors + check(rxllama..configint(config, "not_a_supported_option", 1) <> 0, "unknown option rejected")
  errors = errors + check(rxllama..configint(config, "memory_bytes", -1) <> 0, "negative memory rejected")
  errors = errors + check(rxllama..configint(config, "output_tokens", -1) <> 0, "negative output budget rejected")
  errors = errors + check(rxllama..configtext(config, "hardware_mode", "not-a-mode") <> 0, "invalid hardware mode rejected")
  if rxllama..runtimeopen(config, runtime) <> 0 then return 1
  errors = errors + rejected_model(runtime, args[1] || ".does-not-exist", args[2], config)
  errors = errors + rejected_model(runtime, args[1], copies("0", 64), config)
  count = 0
  errors = errors + check(rxllama..devicecount(runtime, count) = 0 & count > 0, "CPU device discovered")
  if rxllama..modelopen(runtime, args[1], args[2], "bge-small-en-v1.5", config, model) <> 0 then return 1
  if ready_model(model) <> 0 then return 1
  if rxllama..sessionopen(model, "embedding", config, session) <> 0 then return 1
  errors = errors + check(rxllama..close(model) <> 0, "live session retains model")
  if ready_session(session) <> 0 then return 1
  errors = errors + embedding_failures(session, config)
  do i = 1 to 100
    errors = errors + embedding_request(session, config, 1)
  end
  do i = 1 to 20
    errors = errors + embedding_request(session, config, 8)
  end
  loads = 0
  errors = errors + check(rxllama..infoint(model, "load_count", loads) = 0 & loads = 1, "persistent weights")
  generation_model = .binary
  generation_session = .binary
  if rxllama..modelopen(runtime, args[3], args[4], "smollm2-360m-instruct", config, generation_model) <> 0 then return 1
  if ready_model(generation_model) <> 0 then return 1
  if mode = "required-gpu" then do
    offloaded = 0
    errors = errors + check(rxllama..infoint(generation_model, "gpu_layers", offloaded) = 0 & offloaded > 0, "generation GPU offload")
  end
  if rxllama..sessionopen(generation_model, "generation", config, generation_session) <> 0 then return 1
  if ready_session(generation_session) <> 0 then return 1
  errors = errors + incremental_generation(generation_session, config, 1)
  errors = errors + incremental_generation(generation_session, config, 0)
  do i = 1 to 100
    errors = errors + generation_request(generation_session, config, 1)
  end
  do i = 1 to 20
    errors = errors + generation_request(generation_session, config, 4)
  end
  loads = 0
  errors = errors + check(rxllama..infoint(generation_model, "load_count", loads) = 0 & loads = 1, "persistent generation weights")
  errors = errors + check(rxllama..close(generation_session) = 0, "generation session close")
  errors = errors + check(rxllama..close(generation_model) = 0, "generation model close")
  errors = errors + check(rxllama..close(session) = 0, "session close")
  errors = errors + check(rxllama..close(model) = 0, "model close")
  errors = errors + check(rxllama..close(runtime) = 0, "runtime close")
  errors = errors + check(rxllama..close(config) = 0, "config close")
  if errors <> 0 then return 1
  say "PASS: rxllama persistent embedding and generation acceptance"
  return 0
