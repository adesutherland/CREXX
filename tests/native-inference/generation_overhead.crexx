/* NI-S5: fixed integration workload, not a model/backend benchmark. */
options levelb floats_binary
import rxfnsb
import rxfnsg
import rxllama

check: procedure = .int
  arg condition = .boolean, label = .string
  if condition then return 0
  say "FAIL: rxllama" label
  return 1

elapsed: procedure = .int
  arg started = .int
  duration = time("us") - started
  if duration < 0 then duration = duration + 86400000000
  return duration

ready_model: procedure = .int
  arg model = .binary
  started = time("us")
  do while elapsed(started) < 600000000
    state = ""
    if rxllama..modelstate(model, state) <> 0 then return 1
    if state = "ready" then return 0
    if state <> "loading" then return 1
  end
  say "FAIL: model preparation deadline"
  return 1

ready_session: procedure = .int
  arg session = .binary
  started = time("us")
  do while elapsed(started) < 600000000
    state = ""
    if rxllama..prepare(session, 512, state) <> 0 then return 1
    if state = "ready" then return 0
    if state = "failed" | state = "cancelled" then return 1
  end
  say "FAIL: session preparation deadline"
  return 1

complete_request: procedure = .int
  arg request = .binary
  started = time("us")
  do while elapsed(started) < 600000000
    state = ""
    if rxllama..process(request, 512, state) <> 0 then return 1
    if state = "complete" then return 0
    if state <> "running" then return 1
  end
  say "FAIL: request deadline"
  return 1

one_request: procedure = .int
  arg session = .binary, config = .binary, count = .int, expose texts = .string[], expose finishes = .string[], expose total = .int
  request = .binary
  if rxllama..requestopen(session, config, request) <> 0 then return 1
  row = .int
  do row = 1 to count
    id = 0
    texts[row] = ""
    finishes[row] = ""
    if rxllama..addprompt(request, "", "Name one animal.", id) <> 0 | id <> row then return 1
  end
  if rxllama..submit(request) <> 0 then return 1
  total = 0
  state = ""
  text = ""
  finish = ""
  tokens = 0
  started = time("us")
  do forever
    if rxllama..process(request, 128, state) <> 0 then return 1
    do row = 1 to count
      if rxllama..readtext(request, row, text, tokens, finish) <> 0 then return 1
      texts[row] = texts[row] || text
      finishes[row] = finish
      total = total + tokens
    end
    if state = "complete" then leave
    if state <> "running" | elapsed(started) > 600000000 then return 1
  end
  if total < 1 | total > count * 32 then return 1
  do row = 1 to count
    if texts[row] = "" then return 1
    if finishes[row] <> "eos" & finishes[row] <> "output_limit" then return 1
  end
  return rxllama..close(request)

main: procedure = .int
  arg args = .string[]
  if args[0] <> 5 then return 2
  count = args[4] as .int
  repeats = args[5] as .int
  if (count <> 1 & count <> 4) | repeats < 1 then return 2
  started = time("us")
  config = .binary
  runtime = .binary
  model = .binary
  session = .binary
  if rxllama..configcreate(config) <> 0 then return 1
  if rxllama..configtext(config, "hardware_mode", args[1]) <> 0 then return 1
  if rxllama..runtimeopen(config, runtime) <> 0 then return 1
  if rxllama..modelopen(runtime, args[2], args[3], "smollm2-360m-instruct", config, model) <> 0 then return 1
  if ready_model(model) <> 0 then return 1
  if rxllama..sessionopen(model, "generation", config, session) <> 0 then return 1
  if ready_session(session) <> 0 then return 1
  prepare_us = elapsed(started)
  texts = .string[]
  finishes = .string[]
  total = 0
  started = time("us")
  if one_request(session, config, count, texts, finishes, total) <> 0 then return 1
  first_us = elapsed(started)
  started = time("us")
  do i = 1 to repeats
    if one_request(session, config, count, texts, finishes, total) <> 0 then return 1
  end
  warm_us = elapsed(started)
  loaded = 0
  if rxllama..infoint(model, "load_count", loaded) <> 0 | loaded <> 1 then return 1
  say "PREPARE_US=" || prepare_us
  say "FIRST_US=" || first_us
  say "WARM_US=" || warm_us "us"
  say "TOKENS=" || total
  do row = 1 to count
    say "TEXT" || row || "=" || c2x(texts[row])
    say "FINISH" || row || "=" || finishes[row]
  end
  say "PASS: NI-S5 fixed generation work" count repeats "load_count=1"
  if rxllama..close(session) <> 0 | rxllama..close(model) <> 0 then return 1
  if rxllama..close(runtime) <> 0 | rxllama..close(config) <> 0 then return 1
  return 0
