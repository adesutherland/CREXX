/* Negative transport test: a copied native handle must be unusable in a
 * different VM. Supported workers open their own model/session references. */
options levelg
namespace rxllama_worker_acceptance
import rxfnsb
import concurrency
import rxllama

foreign_model: task = .int
  arg handle = .binary
  state = ""
  if rxllama..modelstate(handle, state) = 0 then return 1
  if rxllama..close(handle) = 0 then return 2
  return 0

main: procedure = .int
  arg args = .string[]
  if args.0 <> 2 then return 2
  config = .binary
  runtime = .binary
  model = .binary
  if rxllama..configcreate(config) <> 0 then return 1
  if rxllama..configtext(config, "hardware_mode", "cpu") <> 0 then return 1
  if rxllama..runtimeopen(config, runtime) <> 0 then return 1
  if rxllama..modelopen(runtime, args[1], args[2], "bge-small-en-v1.5", config, model) <> 0 then return 1
  pool = .taskpool.local(2, 4)
  scope = .taskscope.collectall(pool, -1)
  do parallel using scope
    first = foreign_model(model)
    second = foreign_model(model)
  end
  call pool.close()
  if first <> 0 | second <> 0 then return 1
  state = ""
  if rxllama..modelstate(model, state) <> 0 then return 1
  if state <> "loading" & state <> "ready" then return 1
  if state = "loading" then do
    if rxllama..modelcancel(model) <> 0 then return 1
  end
  started = time("us")
  do while state = "loading"
    if rxllama..modelstate(model, state) <> 0 then return 1
    duration = time("us") - started
    if duration < 0 then duration = duration + 86400000000
    if duration > 600000000 then return 1
  end
  if rxllama..close(model) <> 0 then return 1
  if rxllama..close(runtime) <> 0 then return 1
  if rxllama..close(config) <> 0 then return 1
  say "PASS: rxllama foreign VM handle rejection"
  return 0
