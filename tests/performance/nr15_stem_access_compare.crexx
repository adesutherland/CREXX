/* NR-15 observational stem/string-access workload. */
options levelb comments_dash
import rxfnsb

arg argv = .string[]

mode = "get-hit"
size = 64
iterations = 20000
family = "ascii"
if argv[0] >= 1 then mode = argv[1]
if argv[0] >= 2 then size = argv[2]
if argv[0] >= 3 then iterations = argv[3]
if argv[0] >= 4 then family = argv[4]
if size < 1 then return fail("size")
if iterations < 1 then return fail("iterations")
if family == "collision" & size > 1024 then return fail("collision size exceeds 1024")

keys = .string[]
target = .stem()
do i = 1 to size
  keys[i] = make_key(i, family)
  call target.set(keys[i], "v" || i)
end

checksum = 0
start = time("us")

select
  when mode == "get-hit" then do
    do i = 1 to iterations
      index = ((i - 1) % size) + 1
      checksum = checksum + length(target.get(keys[index]))
    end
  end
  when mode == "get-miss" then do
    miss = "missing-" || family
    do i = 1 to iterations
      if target.get(miss) == "" then checksum = checksum + 1
    end
  end
  when mode == "property-hit" then do
    do i = 1 to iterations
      index = ((i - 1) % size) + 1
      key = keys[index]
      checksum = checksum + length(target.key)
    end
  end
  when mode == "bracket-hit" then do
    do i = 1 to iterations
      index = ((i - 1) % size) + 1
      checksum = checksum + length(target[keys[index]])
    end
  end
  when mode == "set-existing" then do
    do i = 1 to iterations
      index = ((i - 1) % size) + 1
      call target.set(keys[index], "u" || i)
      checksum = checksum + index
    end
  end
  when mode == "set-new" then do
    do i = 1 to iterations
      key = "new-" || family || "-" || i
      call target.set(key, "n" || i)
    end
    checksum = target.size()
  end
  when mode == "reset-default" then do
    do i = 1 to iterations
      target. = "d" || i
    end
    checksum = length(target.get(keys[1])) + target.size()
  end
  when mode == "reset-selective" then do
    do i = 1 to iterations
      index = ((i - 1) % size) + 1
      target. = "d" || i
      call target.set(keys[index], "s" || i)
      checksum = checksum + length(target.get(keys[index]))
    end
  end
  when mode == "multi-tail" then do
    compound = .stem()
    do i = 1 to size
      left = "L" || i
      right = "R" || i
      call compound.set(left || "." || right, "m" || i)
    end
    do i = 1 to iterations
      index = ((i - 1) % size) + 1
      left = "L" || index
      right = "R" || index
      checksum = checksum + length(compound.left.right)
    end
  end
  when mode == "histogram" then do
    histogram = .stem()
    text = "alpha beta gamma alpha delta beta alpha epsilon gamma alpha"
    do i = 1 to iterations
      do word_index = 1 to words(text)
        token = word(text, word_index)
        current_text = histogram.get(token)
        current_count = .int
        if current_text <> "" then current_count = current_text as .int
        call histogram.set(token, (current_count + 1) || "")
      end
    end
    checksum = (histogram.get("alpha") as .int) + (histogram.get("beta") as .int) + ,
        (histogram.get("gamma") as .int)
  end
  otherwise return fail("mode")
end

elapsed = time("us") - start
if elapsed < 0 then elapsed = elapsed + 86400000000
if checksum <= 0 then return fail("checksum")

say "benchmark=nr15_stem_access_compare"
say "mode="mode
say "family="family
say "size="size
say "iterations="iterations
say "elapsed_us="elapsed
say "checksum="checksum
say "PASS: NR-15 stem access compare"
return 0

make_key: procedure = .string
  arg index = .int, family = .string
  if family == "ascii" then return "key-" || index
  if family == "unicode" then return "κλειδί-🔥-" || index
  if family == "long" then return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-" || index
  if family == "collision" then do
    value = index - 1
    key = ""
    do part = 1 to 10
      if value % 2 = 0 then key = key || "Aa"
      else key = key || "BB"
      value = value / 2
    end
    return key
  end
  return "unknown-" || index

fail: procedure = .int
  arg label = .string
  say "FAIL: NR-15" label
  return 1
