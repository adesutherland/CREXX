/* RCC-5F production packed-float statistics workload. */
options levelb floats_binary

import rxfnsb
import rxfnsg
import rxstats

elapsedUs: procedure = .int
  arg started = .int
  elapsed = time("us") - started
  if elapsed < 0 then elapsed = elapsed + 86400000000
  return elapsed

main: procedure = .int
  arg arguments = .string[]
  iterations = 4000
  offset = 0.0
  if arguments[0] > 0 then iterations = arguments[1]
  if arguments[0] > 1 then offset = arguments[2]
  x = .packedfloat(256)
  y = .packedfloat(256)
  do index = 0 to 255
    call x.set(index, offset + (index <mod> 17))
    call y.set(index, 3.0 * x.get(index) + 7.0)
  end

  checksum = 0.0
  mean = 0.0
  deviation = 0.0
  covariance = 0.0
  correlation = 0.0
  started = time("us")
  do iteration = 1 to iterations
    mean = rxstats..mean(x)
    deviation = rxstats..stddev(x)
    covariance = rxstats..covariance(x, y)
    correlation = rxstats..correlation(x, y)
    checksum = checksum + mean + deviation + covariance + correlation
  end
  elapsed = elapsedUs(started)
  calls_per_second = ((iterations * 4) as .float) * 1000000.0 / (elapsed as .float)
  say "benchmark=rcc5f_rxstats variant=packed observations=256 iterations=" || iterations || " offset=" || offset || " elapsed_us=" || elapsed || " calls_per_second=" || calls_per_second || " mean=" || mean || " stddev=" || deviation || " covariance=" || covariance || " correlation=" || correlation || " checksum=" || checksum
  say "PASS: RCC-5F packed statistics workload"
  return 0
