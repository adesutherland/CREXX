include("${CMAKE_CURRENT_LIST_DIR}/nr16_17_runtime.cmake")

set(valid "mode=trace-off\niterations=10\nchecksum=55\nPASS: NR-16/17 stable-state compare\n")
nr16_17_output_problem("0" "${valid}" "" "trace-off" problem)
if(NOT problem STREQUAL "")
    message(FATAL_ERROR "Valid NR-16/17 output refused: ${problem}")
endif()
string(REPLACE "trace-off" "address-same-static" other_path "${valid}")
nr16_17_output_problem("0" "${other_path}" "" "address-same-static" problem)
if(NOT problem STREQUAL "")
    message(FATAL_ERROR "Valid ADDRESS output refused: ${problem}")
endif()

foreach(case IN ITEMS missing-pass wrong-mode wrong-iterations wrong-checksum forbidden-fail forbidden-panic stderr nonzero)
    set(output "${valid}")
    set(error "")
    set(result "0")
    if(case STREQUAL "missing-pass")
        string(REPLACE "PASS: NR-16/17 stable-state compare\n" "" output "${output}")
    elseif(case STREQUAL "wrong-mode")
        string(REPLACE "trace-off" "control" output "${output}")
    elseif(case STREQUAL "wrong-iterations")
        string(REPLACE "iterations=10" "iterations=100" output "${output}")
    elseif(case STREQUAL "wrong-checksum")
        string(REPLACE "checksum=55" "checksum=550" output "${output}")
    elseif(case STREQUAL "forbidden-fail")
        string(APPEND output "FAIL: injected failure\n")
    elseif(case STREQUAL "forbidden-panic")
        string(APPEND output "PANIC: injected failure\n")
    elseif(case STREQUAL "stderr")
        set(error "unexpected diagnostic\n")
    elseif(case STREQUAL "nonzero")
        set(result "1")
    endif()
    nr16_17_output_problem("${result}" "${output}" "${error}" "trace-off" problem)
    if(problem STREQUAL "")
        message(FATAL_ERROR "Invalid NR-16/17 ${case} output accepted")
    endif()
endforeach()
message(STATUS "PASS: NR-16/17 output guard contract")
