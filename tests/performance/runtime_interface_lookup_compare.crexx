/* Observational benchmark for VM interface method and factory registries. */
options levelb
namespace runtime_interface_lookup_compare
import rxfnsb

arg argv = .string[]

iterations = 50000
factory_iterations = 5000
if argv[0] >= 1 then iterations = argv[1]
if argv[0] >= 2 then factory_iterations = argv[2]

target = .lookup24()

start = time("us")
checksum = 0
do i = 1 to iterations
  checksum = checksum + target.value()
end
method_elapsed = time("us") - start

start = time("us")
do i = .int(1) to factory_iterations
  target = .lookup24()
  checksum = checksum + target.value()
end
factory_elapsed = time("us") - start

if checksum \= (iterations + factory_iterations) * 24 then return fail("checksum")

say "benchmark=runtime_interface_lookup_compare"
say "registry_groups=24"
say "method_iterations="iterations
say "factory_iterations="factory_iterations
say "method_us="method_elapsed
say "factory_us="factory_elapsed
say "PASS: runtime interface lookup compare"
return 0

fail: procedure = .int
  arg label = .string
  say "FAIL:" label
  return 1

lookup01: interface
  *: factory
  value: method = .int
lookup01impl: class implements .lookup01
  *: factory
    return
  value: method = .int
    return 1

