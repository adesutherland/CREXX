bench_numeric8: procedure = .int
  arg iterations = .int, value = .string
  table_sum = 0
  start = time("us")
  do i = 1 to iterations
    select value
      when "1" then table_sum = table_sum + 1
      when "2" then table_sum = table_sum + 2
      when "3" then table_sum = table_sum + 3
      when "4" then table_sum = table_sum + 4
      when "5" then table_sum = table_sum + 5
      when "6" then table_sum = table_sum + 6
      when "7" then table_sum = table_sum + 7
      when "8" then table_sum = table_sum + 8
      otherwise table_sum = table_sum - 1
    end
  end
  table_elapsed = time("us") - start
  branch_sum = 0
  start = time("us")
  do i = 1 to iterations
    if "1" = value then branch_sum = branch_sum + 1
    else if "2" = value then branch_sum = branch_sum + 2
    else if "3" = value then branch_sum = branch_sum + 3
    else if "4" = value then branch_sum = branch_sum + 4
    else if "5" = value then branch_sum = branch_sum + 5
    else if "6" = value then branch_sum = branch_sum + 6
    else if "7" = value then branch_sum = branch_sum + 7
    else if "8" = value then branch_sum = branch_sum + 8
    else branch_sum = branch_sum - 1
  end
  branch_elapsed = time("us") - start
  return report_text("numeric", 8, value, iterations, table_elapsed, branch_elapsed, table_sum, branch_sum)

report_int: procedure = .int
  arg count = .int, pattern = .int, iterations = .int, table_elapsed = .int, branch_elapsed = .int, table_sum = .int, branch_sum = .int
  if table_sum \= branch_sum then return fail("integer checksum")
  say "mode=int count="count "pattern="pattern "iterations="iterations "table_us="table_elapsed "branch_us="branch_elapsed
  say "PASS: jump dispatch compare"
  return 0

report_text: procedure = .int
  arg mode = .string, count = .int, value = .string, iterations = .int, table_elapsed = .int, branch_elapsed = .int, table_sum = .int, branch_sum = .int
  if table_sum \= branch_sum then return fail(mode || " checksum")
  say "mode="mode "count="count "value="value "iterations="iterations "table_us="table_elapsed "branch_us="branch_elapsed
  say "PASS: jump dispatch compare"
  return 0

fail: procedure = .int
  arg label = .string
  say "FAIL:" label
  return 1
