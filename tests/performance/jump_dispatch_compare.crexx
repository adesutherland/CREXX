/* Observational table-versus-branch dispatch benchmark. */
options levelb comments_dash
import rxfnsb

arg argv = .string[]

mode = "int"
count = 3
pattern = 3
iterations = 500000
value = ""
if argv[0] >= 1 then mode = argv[1]
if argv[0] >= 2 then count = argv[2]
if argv[0] >= 3 then pattern = argv[3]
if argv[0] >= 4 then iterations = argv[4]
if argv[0] >= 5 then value = argv[5]

if mode = "int" then do
  if count = 2 then return bench_int2(iterations, pattern)
  if count = 3 then return bench_int3(iterations, pattern)
  if count = 4 then return bench_int4(iterations, pattern)
  if count = 6 then return bench_int6(iterations, pattern)
  if count = 8 then return bench_int8(iterations, pattern)
end
if mode = "string" then do
  if count = 2 then return bench_string2(iterations, value)
  if count = 3 then return bench_string3(iterations, value)
  if count = 8 then return bench_string8(iterations, value)
end
if mode = "numeric" then do
  if count = 2 then return bench_numeric2(iterations, value)
  if count = 3 then return bench_numeric3(iterations, value)
  if count = 8 then return bench_numeric8(iterations, value)
end
say "FAIL: unsupported benchmark shape"
return 1

bench_int2: procedure = .int
  arg iterations = .int, pattern = .int
  table_sum = 0
  start = time("us")
  do i = 0 to iterations - 1
    if pattern = 0 then value = 0
    else if pattern = 1 then value = 1
    else if pattern = 2 then value = 2
    else value = i % 2
    select value
      when 0 then table_sum = table_sum + 1
      when 1 then table_sum = table_sum + 2
      otherwise table_sum = table_sum - 1
    end
  end
  table_elapsed = time("us") - start
  branch_sum = 0
  start = time("us")
  do i = 0 to iterations - 1
    if pattern = 0 then value = 0
    else if pattern = 1 then value = 1
    else if pattern = 2 then value = 2
    else value = i % 2
    if 0 = value then branch_sum = branch_sum + 1
    else if 1 = value then branch_sum = branch_sum + 2
    else branch_sum = branch_sum - 1
  end
  branch_elapsed = time("us") - start
  return report_int(2, pattern, iterations, table_elapsed, branch_elapsed, table_sum, branch_sum)

