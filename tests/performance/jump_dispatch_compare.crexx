bench_numeric2: procedure = .int
  arg iterations = .int, value = .string
  table_sum = 0
  start = time("us")
  do i = 1 to iterations
    select value
      when "1" then table_sum = table_sum + 1
      when "2.0" then table_sum = table_sum + 2
      otherwise table_sum = table_sum - 1
    end
  end
  table_elapsed = time("us") - start
  branch_sum = 0
  start = time("us")
  do i = 1 to iterations
    if "1" = value then branch_sum = branch_sum + 1
    else if "2.0" = value then branch_sum = branch_sum + 2
    else branch_sum = branch_sum - 1
  end
  branch_elapsed = time("us") - start
  return report_text("numeric", 2, value, iterations, table_elapsed, branch_elapsed, table_sum, branch_sum)

bench_numeric3: procedure = .int
