foreach(required STAGE TOOL SOURCE WORK)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

function(memory_call expected artifact)
    if(expected STREQUAL success)
        file(REMOVE "${WORK}/${artifact}")
    endif()
    execute_process(COMMAND "${TOOL}" ${ARGN} WORKING_DIRECTORY "${WORK}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    # Expected tool errors must never consume a sanitizer diagnostic as success.
    set(diagnostic "${out}\n${err}")
    if(diagnostic MATCHES "(ERROR|SUMMARY): (AddressSanitizer|LeakSanitizer):|AddressSanitizer:|LeakSanitizer has encountered a fatal error")
        message(FATAL_ERROR "Instrumented ${STAGE} reported a memory failure:\n${diagnostic}")
    endif()
    # rxas/rxdas return -1 for ordinary input errors. Windows preserves that
    # signed exit; POSIX reports 255. Do not admit native exception statuses.
    if((NOT result MATCHES "^[0-9]+$" OR result GREATER 255) AND
       NOT (WIN32 AND result STREQUAL "-1" AND
            (STAGE STREQUAL assembler OR STAGE STREQUAL disassembler)))
        message(FATAL_ERROR "${STAGE} terminated abnormally (${result}):\n${diagnostic}")
    endif()
    if(expected STREQUAL success)
        if(NOT result EQUAL 0 OR NOT EXISTS "${WORK}/${artifact}")
            message(FATAL_ERROR "${STAGE} failed (${result}):\n${diagnostic}")
        endif()
        file(SIZE "${WORK}/${artifact}" size)
        if(size EQUAL 0)
            message(FATAL_ERROR "${STAGE} emitted an empty artifact")
        endif()
    elseif(result EQUAL 0 OR NOT diagnostic MATCHES "${expected}")
        message(FATAL_ERROR "${STAGE} did not reject the intended input (${result}, expected ${expected}):\n${diagnostic}")
    endif()
endfunction()

if(STAGE STREQUAL compiler OR STAGE STREQUAL classic)
    if(STAGE STREQUAL classic)
        set(level c)
    else()
        set(level b)
    endif()
    file(WRITE "${WORK}/valid.rexx" "options level${level}\nsay 'memory lifecycle'\nreturn 0\n")
    file(WRITE "${WORK}/invalid.rexx" "options level${level}\nsay (1 +\n")
    foreach(mode IN ITEMS opt noopt)
        set(flags)
        if(mode STREQUAL noopt)
            list(APPEND flags -n)
        endif()
        memory_call(success "${mode}.rxas" -x ${flags} -i "${BIN}" -o "${mode}" "${WORK}/valid.rexx")
        memory_call("[Ee][Rr][Rr][Oo][Rr]|SYNTAX" "" -x ${flags} -i "${BIN}" -o invalid "${WORK}/invalid.rexx")
    endforeach()
elseif(STAGE STREQUAL assembler)
    foreach(mode IN ITEMS opt noopt)
        set(flags)
        if(mode STREQUAL noopt)
            list(APPEND flags -n)
        endif()
        memory_call(success "${mode}.rxbin" ${flags} -o "${mode}"
            "${SOURCE}/linker/tests/tests_link_provider_a.rxas")
        file(WRITE "${WORK}/invalid.rxas" ".globals=0\nmain() .locals=0\nunknown_memory_opcode\n")
        memory_call("[Ee][Rr][Rr][Oo][Rr]|SYNTAX|[Uu]nknown" "" ${flags} -o invalid "${WORK}/invalid.rxas")
    endforeach()
elseif(STAGE STREQUAL linker)
    foreach(flags IN ITEMS "" -s -i)
        memory_call(success "linked.rxbin" ${flags} -o linked
            "${INPUT}/tests_link_root.rxbin" "${INPUT}/tests_link_provider_a.rxbin")
    endforeach()
    memory_call("Duplicate providers" "" -o duplicate "${INPUT}/tests_link_root.rxbin"
        "${INPUT}/tests_link_provider_a.rxbin" "${INPUT}/tests_link_provider_b.rxbin")
    memory_call("signature" "" -o invalid "${INPUT}/tests_link_signature_bad_impl.rxbin")
elseif(STAGE STREQUAL disassembler)
    memory_call(success disassembled.rxas -o "${WORK}/disassembled.rxas"
        "${INPUT}/tests_link_provider_a.rxbin")
    file(WRITE "${WORK}/invalid.rxbin" "invalid bytecode")
    memory_call("[Ii]nvalid|ERROR|[Ee]rror|[Ff]ormat|[Cc]orrupt" "" -o "${WORK}/invalid.rxas" "${WORK}/invalid.rxbin")
elseif(STAGE STREQUAL precomp)
    # RXPP is a VM client. This tiny case exists specifically for its native
    # precomp provider, without compiling or running the emitted source.
    file(WRITE "${WORK}/input.rxpp" "say SQUARE(3)\nsay 'memory@example.com'\n")
    memory_call(success preprocessed.crexx rxprecomp -I "${WORK}/input.rxpp"
        -o "${WORK}/preprocessed.crexx" -m "${SOURCE}/preprocessor/maclib.rexx")
    memory_call("RXPP_SOURCE_MISSING" ""
        rxprecomp -I "${WORK}/missing.rxpp" -o "${WORK}/missing.crexx"
        -m "${SOURCE}/preprocessor/maclib.rexx")
elseif(STAGE STREQUAL san008)
    foreach(kind IN ITEMS source rxas rxbin shared)
        set(imports "${WORK}/${kind}")
        file(MAKE_DIRECTORY "${imports}")
        set(import_flags)
        if(kind STREQUAL source)
            file(COPY "${SOURCE}/tests/memory/san008_provider.crexx" DESTINATION "${imports}")
        elseif(kind STREQUAL rxas)
            file(COPY "${INPUT}/provider.rxas" DESTINATION "${imports}")
            list(APPEND import_flags --import-rxas)
        elseif(kind STREQUAL shared)
            file(COPY "${INPUT}/shared.rxbin" DESTINATION "${imports}")
        else()
            file(COPY "${INPUT}/provider.rxbin" DESTINATION "${imports}")
        endif()
        foreach(mode IN ITEMS opt noopt)
            set(flags)
            if(mode STREQUAL noopt)
                list(APPEND flags -n)
            endif()
            foreach(index IN ITEMS 1 0)
                file(WRITE "${WORK}/consumer.crexx" "options levelb\nnamespace memory_import\nmain: procedure = .int expose grid\n  say grid[-2,1,${index}]\n  return 0\n")
                memory_call(ARRAY_DIMS_MISMATCH "" -x ${flags} ${import_flags}
                    -s "${imports}" -i "${imports}" -i "${BIN}" -o consumer "${WORK}/consumer.crexx")
            endforeach()
            file(WRITE "${WORK}/consumer.crexx" "options levelb\nnamespace memory_import\nmain: procedure = .int expose grid\n  say grid[-2,1]\n  return 0\n")
            memory_call(success consumer.rxas -x ${flags} ${import_flags}
                -s "${imports}" -i "${imports}" -i "${BIN}" -o consumer "${WORK}/consumer.crexx")
        endforeach()
    endforeach()
else()
    message(FATAL_ERROR "Unknown memory stage ${STAGE}")
endif()
