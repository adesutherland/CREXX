/* This is a modified Level B adaptation, not the unchanged RexxCPS 2.2       */
/* program. Its result must not be quoted as an official RexxCPS 2.2 score.   */
/*                                                                            */
/* cREXX Level B adaptation: 2026, the cREXX contributors.                    */
/*----------------------------------------------------------------------------*/
options levelb comments_dash
import rxfnsb

arg argv = .string[]

count = 100
averaging = 10
if argv[0] >= 1 then count = argv[1]
if argv[0] >= 2 then averaging = argv[2]
if count < 1 then return fail("count must be positive")
if averaging < 1 then return fail("averaging must be positive")

/* The original workload uses classic compound variables. Level B makes the
 * backing stem objects explicit while retaining compound-tail access. */
acompound = .stem()
avar = .stem()

empty_start = time("us")
do measure = 1 to averaging
  do count
  end
end
empty_us = time("us") - empty_start

full_start = time("us")
do measure = 1 to averaging
  do count
    /* This body retains the shape of the original 1,000-clause mix. */
    flag = "0"
    p0 = "b"
    do mix_iteration = 1 to 14
      key1 = "Key Bee"
      acompound.key1.mix_iteration = substr(1234 "5678", 6, 2)
      if flag = acompound.key1.mix_iteration then return fail("unexpected comparison 1")
      do j = 1.1 to 2.2 by 1.1
        if j > (acompound.key1.mix_iteration as .decimal) then return fail("unexpected comparison 2")
        if 17 < length(j as .string) - 1 then return fail("unexpected comparison 3")
        if (j as .string) = "foobar" then return fail("unexpected comparison 4")
        if substr(1234, 1, 1) = "9" then return fail("unexpected comparison 5")
        if word(key1, 1) = "?" then return fail("unexpected comparison 6")
        if j < 5 then do
          acompound.key1.mix_iteration = ((acompound.key1.mix_iteration as .decimal) + 1) as .string
          if j = 2.2 then leave
        end
        iterate
      end

      call avar.set("0.2", "1.0" || mix_iteration)
      call avar.set("1.2", "1.0" || mix_iteration)
      call avar.set("1.3", "1.0" || mix_iteration)
      select
        when flag = "string" then return fail("unexpected selection S1")
        when avar.get(flag || ".2") = "0" then return fail("unexpected selection S2")
        when flag = ((5 + 99.7) as .string) then return fail("unexpected selection S3")
        when flag <> "0" then call avar.set("1.2", ((avar.get("1.2") as .decimal) * 1.1) as .string)
        when flag == "0" then flag = "0"
      end

      flag = "1"
      select
        when flag == "ring" then return fail("unexpected selection T1")
        when avar.get(flag || ".3") = "0" then return fail("unexpected selection T2")
        when flag <> "0" then call avar.set("1.2", ((avar.get("1.2") as .decimal) * 1.1) as .string)
        when flag == "0" then flag = "1"
      end

      parse value "Foo Bar" with v1 +5 v2 .
      trace_state = "Off"
      address_state = "CREXX"
      call cps_subroutine("with", "2", "args", "(This is the second)11")
      text = "This is an awfully boring program"
      parse var text p1 (p0) p5
      text = "is an awfully boring program This"
      parse var text p2 (p0) p6
      text = "an awfully boring program This is"
      parse var text p3 (p0) p7
      text = "awfully boring program This is an"
      parse var text p4 (p0) p8
    end
  end
end
full_us = time("us") - full_start

work_us = full_us - empty_us
if work_us < 1 then work_us = 1
work_units = count * averaging
estimated_cps = (work_units * 1000 * 1000000) / work_us

say "benchmark=rexxcps_levelb count="count "averaging="averaging
say "full_us="full_us "empty_us="empty_us "work_us="work_us
say "estimated_levelb_clauses_per_second="estimated_cps
say "PASS: RexxCPS Level B adaptation"
return 0

cps_subroutine: procedure = .void
  arg a1 = .string, a2 = .string, a3 = .string, a4 = .string
  upper_a1 = upper(a1)
  upper_a2 = upper(a2)
  upper_a3 = upper(a3)
  upper_a4 = upper(a4)
  parse var upper_a3 b1 b2 b3 .
  do 1
    text = upper_a1 || " " || upper_a2 || " " || upper_a3
    parse var text c1 c2 c3
  end
  return

fail: procedure = .int
  arg message = .string
  say "FAIL:" message
  return 1
