/*
 * Level B port of the Are We Fast Yet? Bounce benchmark.
 * Derived from the SOM benchmark suite under the MIT license; see
 * LICENSE-SOM-MIT.txt and README.md in this directory.
 */
options levelb comments_dash
import rxfnsb

arg argv = .string[]

repetitions = 1
if argv[0] >= 1 then repetitions = argv[1]
if repetitions < 1 then return fail("repetitions must be positive")

result = 0
do iteration = 1 to repetitions
  benchmark = .BounceBenchmark()
  result = benchmark.run()
  if result <> 1331 then return fail("expected 1331 bounces, got " || result)
end

say "benchmark=awfy_bounce repetitions="repetitions "result="result
say "PASS: AWFY Bounce"
return 0

fail: procedure = .int
  arg message = .string
  say "FAIL:" message
  return 1

AwfyRandom: class
  seed_value = .int

  *: factory
    seed_value = 74755
    return

  next: method = .int
    seed_value = ((seed_value * 1309) + 13849) <mod> 65536
    return seed_value

BounceBall: class
  x = .int
  y = .int
  x_velocity = .int
  y_velocity = .int

  *: factory
    arg random_ref = reference .AwfyRandom
    random = dereference random_ref
    x = random.next() <mod> 500
    y = random.next() <mod> 500
    x_velocity = (random.next() <mod> 300) - 150
    y_velocity = (random.next() <mod> 300) - 150
    return

  bounce: method = .boolean
    bounced = 0
    x = x + x_velocity
    y = y + y_velocity

    if x > 500 then do
      x = 500
      x_velocity = 0 - abs(x_velocity)
      bounced = 1
    end
    if x < 0 then do
      x = 0
      x_velocity = abs(x_velocity)
      bounced = 1
    end
    if y > 500 then do
      y = 500
      y_velocity = 0 - abs(y_velocity)
      bounced = 1
    end
    if y < 0 then do
      y = 0
      y_velocity = abs(y_velocity)
      bounced = 1
    end
    return bounced

BounceBenchmark: class
  *: factory
    return

  run: method = .int
    random = .AwfyRandom()
    balls = .BounceBall[]
    do i = 1 to 100
      balls[i] = .BounceBall(reference random)
    end

    bounces = 0
    do step = 1 to 50
      do i = 1 to balls[0]
        ball_ref = reference balls[i]
        ball = dereference ball_ref
        if ball.bounce() then bounces = bounces + 1
      end
    end
    return bounces
