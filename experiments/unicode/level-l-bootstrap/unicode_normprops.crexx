/*
 * cREXX License (MIT)
 *
 * Minimal first-fault parser for the normative Unicode normalization
 * properties needed by the prepared NFC/NFKC proof.
 */

options levelb

namespace unicode_normprops expose unicodenormpropsresult unicode_normprops_parse
import rxfnsb

/** Parse the pinned composition-exclusion and C-form Quick_Check properties. */
unicode_normprops_parse: procedure = .unicodenormpropsresult
  arg path = .string, version = .string
  result = .unicodenormpropsresult()
  call result.parse(path, version)
  return result

/** Normative normalization-property subset used by the prepared normalizer. */
unicodenormpropsresult: class
  _status = .int
  _error = .string
  _error_line = .int
  _full_exclusions = .binary
  _full_exclusion_count = .int
  _quick_check = .binary
  _nfc_qc_no_count = .int
  _nfc_qc_maybe_count = .int
  _nfkc_qc_no_count = .int
  _nfkc_qc_maybe_count = .int

  *: factory
    _status = 0
    _error = ""
    _error_line = 0
    _full_exclusion_count = 0
    _nfc_qc_no_count = 0
    _nfc_qc_maybe_count = 0
    _nfkc_qc_no_count = 0
    _nfkc_qc_maybe_count = 0
    call binresize _full_exclusions, 0x22000
    /* Two scalars per byte; each nibble is NFC_QC[1:0], NFKC_QC[3:2]. */
    call binresize _quick_check, 0x88000
    return

  parse: method = .void
    arg path = .string, version = .string
    byte_offset = .int
    mask = .int
    byte = .int
    shift = .int
    if version \= "17.0.0" then do
      call _fail "normalization-property parser requires Unicode version 17.0.0", 0
      return
    end
    lines = readlines(path)
    if lines[0] <= 0 then do
      call _fail "DerivedNormalizationProps input is empty or unreadable", 0
      return
    end
    do line_number = 1 to lines[0] while _status = 0
      line = lines[line_number]
      comment = pos("#", line)
      if comment > 0 then line = left(line, comment - 1)
      line = strip(line)
      if line = "" then iterate
      fields = qsplit(line, ";")
      if fields[0] < 2 then do
        call _fail "normalization-property record has fewer than two fields", line_number
        leave
      end
      property = strip(fields[2])
      if property \= "Full_Composition_Exclusion" &,
         property \= "NFC_QC" & property \= "NFKC_QC" then iterate
      qc_value = 0
      if property = "Full_Composition_Exclusion" then do
        if fields[0] \= 2 then,
          call _fail "Full_Composition_Exclusion record has an unexpected value", line_number
      end
      else do
        if fields[0] \= 3 then do
          call _fail property || " record has no Quick_Check value", line_number
          leave
        end
        value = strip(fields[3])
        if value = "N" then qc_value = 1
        else if value = "M" then qc_value = 2
        else do
          call _fail property || " record has an unsupported Quick_Check value", line_number
          leave
        end
      end
      if _status \= 0 then leave
      range = strip(fields[1])
      dots = pos("..", range)
      first = .int
      last = .int
      if dots = 0 then do
        first = _hex(range, line_number)
        last = first
      end
      else do
        first = _hex(strip(left(range, dots - 1)), line_number)
        last = _hex(strip(substr(range, dots + 2)), line_number)
      end
      if _status \= 0 then leave
      if first < 0 | last < first | last > 0x10FFFF |,
         (first <= 0xDFFF & last >= 0xD800) then do
        call _fail "invalid " || property || " range " || first || ".." || last, line_number
        leave
      end
      do codepoint = first to last while _status = 0
        if property = "Full_Composition_Exclusion" then do
          byte_offset = codepoint <idiv> 8
          mask = 1 <shl> (codepoint <mod> 8)
          byte = <at..u8>(byte_offset) _full_exclusions
          if (byte <and> mask) \= 0 then,
            call _fail "overlapping Full_Composition_Exclusion range", line_number
          else do
            <at..u8>(byte_offset) _full_exclusions = byte <or> mask
            _full_exclusion_count = _full_exclusion_count + 1
          end
        end
        else do
          byte_offset = codepoint <idiv> 2
          shift = (codepoint <mod> 2) * 4
          if property = "NFKC_QC" then shift = shift + 2
          mask = 3 <shl> shift
          byte = <at..u8>(byte_offset) _quick_check
          if (byte <and> mask) \= 0 then,
            call _fail "overlapping " || property || " range", line_number
          else do
            <at..u8>(byte_offset) _quick_check = byte <or> (qc_value <shl> shift)
            if property = "NFC_QC" & qc_value = 1 then,
              _nfc_qc_no_count = _nfc_qc_no_count + 1
            else if property = "NFC_QC" then,
              _nfc_qc_maybe_count = _nfc_qc_maybe_count + 1
            else if qc_value = 1 then,
              _nfkc_qc_no_count = _nfkc_qc_no_count + 1
            else _nfkc_qc_maybe_count = _nfkc_qc_maybe_count + 1
          end
        end
      end
    end
    if _status = 0 & _full_exclusion_count \= 1120 then,
      call _fail "Full_Composition_Exclusion count does not match Unicode 17.0.0", lines[0]
    if _status = 0 & (_nfc_qc_no_count \= 1120 | _nfc_qc_maybe_count \= 132 |,
       _nfkc_qc_no_count \= 4965 | _nfkc_qc_maybe_count \= 132) then,
      call _fail "normalization Quick_Check counts do not match Unicode 17.0.0", lines[0]
    return

  status: method = .int
    return _status

  error: method = .string
    return _error

  error_line: method = .int
    return _error_line

  full_exclusion_count: method = .int
    return _full_exclusion_count

  is_full_exclusion: method = .int
    arg codepoint = .int
    if codepoint < 0 | codepoint > 0x10FFFF then return 0
    byte = <at..u8>(codepoint <idiv> 8) _full_exclusions
    mask = 1 <shl> (codepoint <mod> 8)
    return (byte <and> mask) \= 0

  /** Packed two-form Quick_Check image; 0=Yes, 1=No, 2=Maybe. */
  quick_check_image: method = .binary
    return _quick_check

  nfc_qc_no_count: method = .int
    return _nfc_qc_no_count

  nfc_qc_maybe_count: method = .int
    return _nfc_qc_maybe_count

  nfkc_qc_no_count: method = .int
    return _nfkc_qc_no_count

  nfkc_qc_maybe_count: method = .int
    return _nfkc_qc_maybe_count

  /** Return 0=Yes, 1=No, or 2=Maybe for NFC (form 3) or NFKC (form 4). */
  quick_check: method = .int
    arg codepoint = .int, form = .int
    if codepoint < 0 | codepoint > 0x10FFFF | (form \= 3 & form \= 4) then return -1
    byte = <at..u8>(codepoint <idiv> 2) _quick_check
    shift = (codepoint <mod> 2) * 4
    if form = 4 then shift = shift + 2
    return (byte <shr> shift) <and> 3

  _hex: method = .int
    arg text = .string, line_number = .int
    if text = "" | length(text) > 6 then do
      call _fail "invalid hexadecimal normalization-property scalar", line_number
      return -1
    end
    value = 0
    do i = 1 to length(text) while _status = 0
      byte = c2d(substr(text, i, 1))
      if byte >= 48 & byte <= 57 then digit = byte - 48
      else if byte >= 65 & byte <= 70 then digit = byte - 55
      else call _fail "invalid hexadecimal normalization-property scalar", line_number
      if _status = 0 then value = value * 16 + digit
    end
    return value

  _fail: method = .void
    arg message = .string, line_number = .int
    if _status \= 0 then return
    _status = 1
    _error = message
    _error_line = line_number
    return
