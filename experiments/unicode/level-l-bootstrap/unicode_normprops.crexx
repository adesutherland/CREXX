/*
 * cREXX License (MIT)
 *
 * Minimal first-fault parser for the normative Unicode normalization
 * properties needed by the prepared NFC/NFKC proof.
 */

options levelb

namespace unicode_normprops expose unicodenormpropsresult unicode_normprops_parse
import rxfnsb

/** Parse Full_Composition_Exclusion from pinned DerivedNormalizationProps. */
unicode_normprops_parse: procedure = .unicodenormpropsresult
  arg path = .string, version = .string
  result = .unicodenormpropsresult()
  call result.parse(path, version)
  return result

/** Normative normalization-property subset used by the prepared composer. */
unicodenormpropsresult: class
  _status = .int
  _error = .string
  _error_line = .int
  _full_exclusions = .binary
  _full_exclusion_count = .int

  *: factory
    _status = 0
    _error = ""
    _error_line = 0
    _full_exclusion_count = 0
    call binresize _full_exclusions, 0x22000
    return

  parse: method = .void
    arg path = .string, version = .string
    if version \= "17.0.0" then do
      call _fail "normalization-property parser requires Unicode version 17.0.0", 0
      return
    end
    lines = readlines(path)
    if lines[0] <= 0 then do
      call _fail "DerivedNormalizationProps input is empty or unreadable", 0
      return
    end
    do line_number = 1 to lines[0] while _status = 0
      line = lines[line_number]
      comment = pos("#", line)
      if comment > 0 then line = left(line, comment - 1)
      line = strip(line)
      if line = "" then iterate
      fields = qsplit(line, ";")
      if fields[0] < 2 then do
        call _fail "normalization-property record has fewer than two fields", line_number
        leave
      end
      property = strip(fields[2])
      if property \= "Full_Composition_Exclusion" then iterate
      if fields[0] \= 2 then do
        call _fail "Full_Composition_Exclusion record has an unexpected value", line_number
        leave
      end
      range = strip(fields[1])
      dots = pos("..", range)
      first = .int
      last = .int
      if dots = 0 then do
        first = _hex(range, line_number)
        last = first
      end
      else do
        first = _hex(strip(left(range, dots - 1)), line_number)
        last = _hex(strip(substr(range, dots + 2)), line_number)
      end
      if _status \= 0 then leave
      if first < 0 | last < first | last > 0x10FFFF |,
         (first <= 0xDFFF & last >= 0xD800) then do
        call _fail "invalid Full_Composition_Exclusion range " || first || ".." || last, line_number
        leave
      end
      do codepoint = first to last while _status = 0
        byte_offset = codepoint <idiv> 8
        mask = 1 <shl> (codepoint <mod> 8)
        byte = <at..u8>(byte_offset) _full_exclusions
        if (byte <and> mask) \= 0 then,
          call _fail "overlapping Full_Composition_Exclusion range", line_number
        else do
          <at..u8>(byte_offset) _full_exclusions = byte <or> mask
          _full_exclusion_count = _full_exclusion_count + 1
        end
      end
    end
    if _status = 0 & _full_exclusion_count \= 1120 then,
      call _fail "Full_Composition_Exclusion count does not match Unicode 17.0.0", lines[0]
    return

  status: method = .int
    return _status

  error: method = .string
    return _error

  error_line: method = .int
    return _error_line

  full_exclusion_count: method = .int
    return _full_exclusion_count

  is_full_exclusion: method = .int
    arg codepoint = .int
    if codepoint < 0 | codepoint > 0x10FFFF then return 0
    byte = <at..u8>(codepoint <idiv> 8) _full_exclusions
    mask = 1 <shl> (codepoint <mod> 8)
    return (byte <and> mask) \= 0

  _hex: method = .int
    arg text = .string, line_number = .int
    if text = "" | length(text) > 6 then do
      call _fail "invalid hexadecimal normalization-property scalar", line_number
      return -1
    end
    value = 0
    do i = 1 to length(text) while _status = 0
      byte = c2d(substr(text, i, 1))
      if byte >= 48 & byte <= 57 then digit = byte - 48
      else if byte >= 65 & byte <= 70 then digit = byte - 55
      else call _fail "invalid hexadecimal normalization-property scalar", line_number
      if _status = 0 then value = value * 16 + digit
    end
    return value

  _fail: method = .void
    arg message = .string, line_number = .int
    if _status \= 0 then return
    _status = 1
    _error = message
    _error_line = line_number
    return
