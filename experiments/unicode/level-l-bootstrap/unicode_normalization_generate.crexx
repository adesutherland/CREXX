/*
 * Generate the constant-backed Unicode 17 four-form normalization module.
 *
 * The Unicode data compiler remains an experimental build-time Level B tool.
 * This generator freezes its versioned portable image into one exposed binary
 * constant and copies the proved normalizer class into the same source module.
 * rxc gives that language constant one module-scoped RXAS alias, so every
 * runtime table read lowers to the same read-only RXBIN constant-pool operand
 * without a per-normalizer image copy or a post-compiler sealing pass.
 */
options levelb

import rxfnsb
import rxhash
import unicode_data
import unicode_normprops
import unicode_d
import unicode_casefold

arg argv = .string[]
if argv[0] \= 6 then do
  say "usage: unicode_normalization_generate UnicodeData.txt DerivedNormalizationProps.txt CaseFolding.txt unicode_d.crexx unicode_casefold.crexx output.crexx"
  return 2
end

ucd = unicode_data_parse(argv[1], "17.0.0")
if ucd.status() \= 0 then do
  say "FAIL: UnicodeData line" ucd.error_line() || ":" || ucd.error()
  return 1
end
properties = unicode_normprops_parse(argv[2], "17.0.0")
if properties.status() \= 0 then do
  say "FAIL: normalization properties line" properties.error_line() || ":" || properties.error()
  return 1
end
tables = unicode_norm_compile(ucd, properties)
if tables.status() \= 0 then do
  say "FAIL: prepared normalization table compiler:" tables.error()
  return 1
end
if tables.byte_length() \= 6736284 |,
   tables.rank_count() \= 55 |,
    tables.nfd_mapping_count() \= 2081 | tables.nfkd_mapping_count() \= 5914 |,
   tables.composition_pair_count() \= 961 |,
   tables.nfc_qc_no_count() \= 1120 | tables.nfc_qc_maybe_count() \= 132 |,
   tables.nfkc_qc_no_count() \= 4965 | tables.nfkc_qc_maybe_count() \= 132 then do
  say "FAIL: prepared normalization image audit"
  return 1
end
casefold = unicode_casefold_compile(argv[3], "17.0.0")
if casefold.status() \= 0 then do
  say "FAIL: CaseFolding line" casefold.error_line() || ":" || casefold.error()
  return 1
end
if casefold.byte_length() \= 4501380 | casefold.record_count() \= 1585 |,
   casefold.component_count() \= 1707 | casefold.common_count() \= 1481 |,
   casefold.simple_count() \= 31 | casefold.full_count() \= 104 |,
   casefold.turkic_count() \= 2 | casefold.max_mapping() \= 3 then do
  say "FAIL: prepared case-fold image audit"
  return 1
end

normalization_image = tables.image()
casefold_image = casefold.image()
image = normalization_image
call binresize image, <blen>(normalization_image) + <blen>(casefold_image)
call bincopy image, <blen>(normalization_image), casefold_image, 0, <blen>(casefold_image)
hex = bin2x(image)

template_lines = readlines(argv[4])
if template_lines[0] <= 0 then do
  say "FAIL: normalizer source template is empty or unreadable"
  return 1
end
casefold_template_lines = readlines(argv[5])
if casefold_template_lines[0] <= 0 then do
  say "FAIL: case-folder source template is empty or unreadable"
  return 1
end

path = argv[6]
if erasefile(path) \= 0 then return 1
call emit_line path, "/* Generated Unicode 17.0.0 constant-backed normalization and case-fold runtime. */"
call emit_line path, "/* Generated by unicode_normalization_generate.crexx; do not edit. */"
call emit_line path, "options levelb"
call emit_line path, ""
call emit_line path, "namespace unicode_normalization expose unicodednormalizer unicode_normalizer_new unicodecasefolder unicode_casefolder_new"
call emit_line path, "import rxfnsb"
call emit_line path, ""
call emit_line path, "unicode_runtime_constants: procedure expose UNICODE_DATA"
call emit_line path, "  /* rxc emits this source constant once and reuses its module-scoped alias. */"
if charout(path, "  constant UNICODE_DATA = '") \= 0 then return 1
if charout(path, hex) \= 0 then return 1
if charout(path, "'x as .binary" || "0a"x) \= 0 then return 1
call emit_line path, "  return"
call emit_line path, ""
call emit_line path, "unicode_normalization_is_scalar: procedure = .int"
call emit_line path, "  arg codepoint = .int"
call emit_line path, "  if codepoint < 0 | codepoint > 0x10FFFF then return 0"
call emit_line path, "  if codepoint >= 0xD800 & codepoint <= 0xDFFF then return 0"
call emit_line path, "  return 1"
call emit_line path, ""
call emit_line path, "unicode_normalizer_new: procedure = .unicodednormalizer"
call emit_line path, "  arg form = .string"
call emit_line path, "  normalizer = .unicodednormalizer()"
call emit_line path, "  call normalizer.initialize(form)"
call emit_line path, "  return normalizer"
call emit_line path, ""
call emit_line path, "unicode_casefolder_new: procedure = .unicodecasefolder"
call emit_line path, "  arg mode = .string"
call emit_line path, "  folder = .unicodecasefolder()"
call emit_line path, "  call folder.initialize(mode)"
call emit_line path, "  return folder"
call emit_line path, ""

line_number = .int
line = .string
stripped = .string
copying = 0
skipping_initialize = 0
class_found = 0
do line_number = 1 to template_lines[0]
  line = template_lines[line_number]
  stripped = strip(line)
  if copying = 0 then do
    if stripped = "unicodednormalizer: class" then do
      copying = 1
      class_found = 1
    end
    else iterate
  end

  if stripped = "_image = .binary" then iterate
  if stripped = "initialize: method = .void" then do
    call emit_line path, "  initialize: method = .void"
    call emit_line path, "    arg form = .string"
    call emit_line path, "    _ready = 0"
    call emit_line path, "    _status = 0"
    call emit_line path, '    _error = ""'
    call emit_line path, "    form = upper(form)"
    call emit_line path, '    if form = "NFD" then _form = 1'
    call emit_line path, '    else if form = "NFKD" then _form = 2'
    call emit_line path, '    else if form = "NFC" then _form = 3'
    call emit_line path, '    else if form = "NFKC" then _form = 4'
    call emit_line path, "    else do"
    call emit_line path, '      call _fail "prepared normalization form must be NFD, NFKD, NFC, or NFKC"'
    call emit_line path, "      return"
    call emit_line path, "    end"
    call emit_line path, "    _compose = _form >= 3"
    call emit_line path, "    call _validate_image"
    call emit_line path, "    if _status = 0 then do"
    call emit_line path, "      call binresize _counts, _rank_count * 4"
    call emit_line path, "      call binresize _next, _rank_count * 4"
    call emit_line path, "      _ready = 1"
    call emit_line path, "    end"
    call emit_line path, "    return"
    call emit_line path, ""
    skipping_initialize = 1
    iterate
  end
  if skipping_initialize then do
    if stripped = "ready: method = .int" then skipping_initialize = 0
    else iterate
  end

  line = changestr("unicode_d_is_scalar", line, "unicode_normalization_is_scalar")
  line = changestr("_image", line, "UNICODE_DATA")
  line = changestr("_validateUNICODE_DATA", line, "_validate_image")
  call emit_line path, line
end

if class_found = 0 then do
  say "FAIL: normalizer class marker not found in template"
  return 1
end

copying = 0
skipping_initialize = 0
class_found = 0
do line_number = 1 to casefold_template_lines[0]
  line = casefold_template_lines[line_number]
  stripped = strip(line)
  if copying = 0 then do
    if stripped = "unicodecasefolder: class" then do
      copying = 1
      class_found = 1
    end
    else iterate
  end

  if stripped = "_image = .binary" then iterate
  if stripped = "initialize: method = .void" then do
    call emit_line path, "  initialize: method = .void"
    call emit_line path, "    arg mode = .string"
    call emit_line path, "    _ready = 0"
    call emit_line path, "    _status = 0"
    call emit_line path, '    _error = ""'
    call emit_line path, "    _base = 6736284"
    call emit_line path, "    call _select_mode mode"
    call emit_line path, "    if _status = 0 then call _validate_image"
    call emit_line path, "    if _status = 0 then _ready = 1"
    call emit_line path, "    return"
    call emit_line path, ""
    skipping_initialize = 1
    iterate
  end
  if skipping_initialize then do
    if stripped = "ready: method = .int" then skipping_initialize = 0
    else iterate
  end

  line = changestr("unicode_casefold_is_scalar", line, "unicode_normalization_is_scalar")
  line = changestr("_image", line, "UNICODE_DATA")
  line = changestr("_validateUNICODE_DATA", line, "_validate_image")
  call emit_line path, line
end

if class_found = 0 then do
  say "FAIL: case-folder class marker not found in template"
  return 1
end
if charout(path) \= 0 then return 1

say "Unicode normalization section bytes:" tables.byte_length()
say "Unicode case-fold section bytes:" casefold.byte_length()
say "Unicode shared constant bytes:" <blen>(image)
say "Unicode shared constant SHA-256:" rxhash..sha256hex(image)
say "Unicode shared constant source: PASS"
return 0

emit_line: procedure = .void
  arg path = .string, line = .string
  ignored = charout(path, line || "0a"x)
  return
