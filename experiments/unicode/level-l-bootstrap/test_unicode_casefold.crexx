/* Unicode 17 prepared simple/full/default/Turkic case-fold proof. */
options levelb

import rxfnsb
import unicode_casefold
import unicode_normalization

arg argv = .string[]
if argv[0] \= 1 then do
  say "usage: test_unicode_casefold CaseFolding.txt"
  return 2
end

tables = unicode_casefold_compile(argv[1], "17.0.0")
if tables.status() \= 0 then do
  say "FAIL: CaseFolding line" tables.error_line() || ":" || tables.error()
  return 1
end
if tables.byte_length() \= 4501380 | tables.record_count() \= 1585 |,
   tables.component_count() \= 1707 | tables.common_count() \= 1481 |,
   tables.simple_count() \= 31 | tables.full_count() \= 104 |,
   tables.turkic_count() \= 2 | tables.max_mapping() \= 3 then do
  say "FAIL: prepared CaseFolding count audit"
  return 1
end

simple = .unicode_normalization..unicodecasefolder
full = .unicode_normalization..unicodecasefolder
turkic_simple = .unicode_normalization..unicodecasefolder
turkic_full = .unicode_normalization..unicodecasefolder
simple = unicode_casefolder_new("SIMPLE")
full = unicode_casefolder_new("FULL")
turkic_simple = unicode_casefolder_new("TURKIC_SIMPLE")
turkic_full = unicode_casefolder_new("TURKIC_FULL")
if simple.ready() = 0 | full.ready() = 0 |,
   turkic_simple.ready() = 0 | turkic_full.ready() = 0 then do
  say "FAIL: shared case-folder validation:" simple.error() full.error() turkic_simple.error() turkic_full.error()
  return 1
end
if simple.mode() \= "SIMPLE" | full.mode() \= "FULL" |,
   turkic_simple.mode() \= "TURKIC_SIMPLE" |,
   turkic_full.mode() \= "TURKIC_FULL" then do
  say "FAIL: shared case-folder mode selection"
  return 1
end

failures = 0
failures = failures + expect_fold(reference simple, "simple ASCII", "0041 005A", "0061 007A")
failures = failures + expect_fold(reference full, "full sharp s", "0053 0074 0072 0061 00DF 0065", "0073 0074 0072 0061 0073 0073 0065")
failures = failures + expect_fold(reference simple, "simple capital sharp s", "1E9E", "00DF")
failures = failures + expect_fold(reference full, "full capital sharp s", "1E9E", "0073 0073")
failures = failures + expect_fold(reference simple, "default simple dotted I", "0049 0130", "0069 0130")
failures = failures + expect_fold(reference full, "default full dotted I", "0049 0130", "0069 0069 0307")
failures = failures + expect_fold(reference turkic_simple, "Turkic simple I", "0049 0130", "0131 0069")
failures = failures + expect_fold(reference turkic_full, "Turkic full I", "0049 0130", "0131 0069")
failures = failures + expect_fold(reference full, "full Armenian expansion", "0587", "0565 0582")
failures = failures + expect_fold(reference full, "non-BMP mapping", "10400", "10428")
failures = failures + expect_fold(reference full, "identity emoji", "01F600", "01F600")

invalid = unicode_casefolder_new("LOCALE")
if invalid.ready() \= 0 | invalid.status() = 0 then do
  say "FAIL: invalid case-fold mode was accepted"
  failures = failures + 1
end

record_checks = 0
do record_index = 0 to tables.record_count() - 1
  source_codepoint = tables.record_source(record_index)
  source = ""
  assembler appendchar source,source_codepoint

  expected = ""
  mapped = tables.expected_simple(record_index, 0)
  assembler appendchar expected,mapped
  if simple.fold(source) \== expected then do
    say "FAIL: simple CaseFolding record" record_index "U+" || d2x(source_codepoint)
    failures = failures + 1
  end
  record_checks = record_checks + 1

  expected = tables.expected_full(record_index, 0)
  if full.fold(source) \== expected then do
    say "FAIL: full CaseFolding record" record_index "U+" || d2x(source_codepoint)
    failures = failures + 1
  end
  record_checks = record_checks + 1

  expected = ""
  mapped = tables.expected_simple(record_index, 1)
  assembler appendchar expected,mapped
  if turkic_simple.fold(source) \== expected then do
    say "FAIL: Turkic simple CaseFolding record" record_index "U+" || d2x(source_codepoint)
    failures = failures + 1
  end
  record_checks = record_checks + 1

  expected = tables.expected_full(record_index, 1)
  if turkic_full.fold(source) \== expected then do
    say "FAIL: Turkic full CaseFolding record" record_index "U+" || d2x(source_codepoint)
    failures = failures + 1
  end
  record_checks = record_checks + 1
end

identity_checks = 0
batch_count = 0
batch = ""
do codepoint = 0 to 0x10FFFF
  if codepoint >= 0xD800 & codepoint <= 0xDFFF then iterate
  if tables.has_record(codepoint) then iterate
  assembler appendchar batch,codepoint
  batch_count = batch_count + 1
  identity_checks = identity_checks + 1
  if batch_count = 4096 then do
    failures = failures + expect_identity(reference simple, "SIMPLE", batch, codepoint)
    failures = failures + expect_identity(reference full, "FULL", batch, codepoint)
    failures = failures + expect_identity(reference turkic_simple, "TURKIC_SIMPLE", batch, codepoint)
    failures = failures + expect_identity(reference turkic_full, "TURKIC_FULL", batch, codepoint)
    batch = ""
    batch_count = 0
  end
end
if batch_count > 0 then do
  failures = failures + expect_identity(reference simple, "SIMPLE", batch, 0x10FFFF)
  failures = failures + expect_identity(reference full, "FULL", batch, 0x10FFFF)
  failures = failures + expect_identity(reference turkic_simple, "TURKIC_SIMPLE", batch, 0x10FFFF)
  failures = failures + expect_identity(reference turkic_full, "TURKIC_FULL", batch, 0x10FFFF)
end
if identity_checks \= 1110479 then do
  say "FAIL: unexpected unlisted CaseFolding scalar count" identity_checks
  failures = failures + 1
end

if failures > 0 then return 1
say "CaseFolding section bytes:" tables.byte_length()
say "CaseFolding section SHA-256:" tables.sha256()
say "CaseFolding records checked in four modes:" record_checks
say "Unlisted CaseFolding scalar identity checks per mode:" identity_checks
say "Prepared simple/full/default/Turkic case folding: PASS"
say "Result: PASS"
return 0

expect_fold: procedure = .int
  arg folder_ref = reference .unicode_normalization..unicodecasefolder, label = .string, source_hex = .string, expected_hex = .string
  folder = dereference folder_ref
  source = hex_sequence_to_string(source_hex)
  expected = hex_sequence_to_string(expected_hex)
  actual = folder.fold(source)
  if actual \== expected then do
    say "FAIL:" label "expected" expected_hex "got" string_to_hex_sequence(actual)
    return 1
  end
  return 0

expect_identity: procedure = .int
  arg folder_ref = reference .unicode_normalization..unicodecasefolder, label = .string, expose batch = .string, codepoint = .int
  folder = dereference folder_ref
  actual = folder.fold(batch)
  if actual \== batch then do
    say "FAIL:" label "unlisted identity batch near U+" || right(d2x(codepoint), 6, "0")
    return 1
  end
  return 0

hex_sequence_to_string: procedure = .string
  arg sequence = .string
  result = ""
  do i = 1 to words(sequence)
    codepoint = x2d(word(sequence, i))
    assembler appendchar result,codepoint
  end
  return result

string_to_hex_sequence: procedure = .string
  arg value = .string
  result = ""
  value_length = 0
  assembler strlen value_length,value
  do i = 0 to value_length - 1
    codepoint = 0
    assembler strchar codepoint,value,i
    if result \= "" then result = result || " "
    width = 4
    if codepoint > 0xFFFF then width = 6
    result = result || right(d2x(codepoint), width, "0")
  end
  return result
