/* Lexer for the retained ICU gennorm2 normalization rule-file language. */
options levell
namespace level_l_gennorm2

eof: token = 0
hexadecimal: token
range: token
colon: token
equals: token
greater: token
star: token
unicode_keyword: token
version: token
newline: token

invalid_utf8: diagnostic = "invalid UTF-8 input"
invalid_character: diagnostic = "invalid gennorm2 input character"

scan: lexer input utf8
  ascii.digit: charset = U+0030 to U+0039
  ascii.hex_letter: charset = U+0041 to U+0046
  horizontal_space: charset = U+0009 | U+0020
  line_character: charset = scalar except (U+0000 | U+000A | U+000D)

  hexadecimal_value: pattern = (ascii.digit | ascii.hex_letter)+
  version_text: pattern = ascii.digit+ ("." ascii.digit+)+
  line_end: pattern = U+000D? U+000A
  comment_text: pattern = "#" line_character*

  spacing: rule = horizontal_space+ then skip
  comment: rule = comment_text then skip
  unicode_word: rule = "Unicode" then emit unicode_keyword
  version_number: rule = version_text then emit version
  hex_value: rule = hexadecimal_value then emit hexadecimal
  range_operator: rule = ".." then emit range
  colon_operator: rule = ":" then emit colon
  equals_operator: rule = "=" then emit equals
  greater_operator: rule = ">" then emit greater
  star_operator: rule = "*" then emit star
  line_break: rule = line_end then emit newline

  end_of_input: rule = eof then emit eof
  bad_encoding: rule = malformed then error invalid_utf8
  unmatched_input: rule = otherwise then error invalid_character
