/* Focused parser, span, first-fault panic, and complete-corpus checks. */
options levelb

import level_l_gennorm2
import unicode_gennorm2

failures = 0
crlf_source = "# café" || "0d0a"x || "* Unicode 17.0.0" || "0d0a"x || "0300:230" || "0d0a"x || "00C0=0041 0300" || "0d0a"x
result = parse_source(crlf_source)
failures = failures + check_int("UTF-8/CRLF fixture status", result.status(), 0)
if result.status() = 0 then do
  ast = result.ast()
  version = ast.record_at(0)
  ccc = ast.record_at(1)
  mapping = ast.record_at(2)
  failures = failures + check_int("version source byte start", version.source_start(), 9)
  failures = failures + check_int("version source byte length", version.source_length(), 16)
  failures = failures + check_int("version token start", version.token_start(), 1)
  failures = failures + check_int("version token count", version.token_count(), 4)
  failures = failures + check_int("version line", version.line(), 2)
  failures = failures + check_int("CCC source byte start", ccc.source_start(), 27)
  failures = failures + check_int("CCC source byte length", ccc.source_length(), 8)
  failures = failures + check_int("mapping source byte start", mapping.source_start(), 37)
  failures = failures + check_int("mapping value count", mapping.value_count(), 2)
  failures = failures + check_int("mapping second value", mapping.value_at(1), 0x0300)
end

bad_version = "* Unicode 16.0.0" || "0a"x || "0300:230" || "0a"x || "00C0=0041 0300" || "0a"x
result = parse_source(bad_version)
failures = failures + check_panic("unsupported version", result, "expected Unicode version 17.0.0", 10, 6, 2, 1)

malformed = "* Unicode 17.0.0" || "0a"x || "0300..0314::230" || "0a"x || "00C0=0041 0300" || "0a"x
result = parse_source(malformed)
failures = failures + check_panic("malformed CCC", result, "expected decimal canonical combining class", 28, 1, 8, 2)

wrong_arity = "* Unicode 17.0.0" || "0a"x || "0300:230" || "0a"x || "00C0=0041" || "0a"x
result = parse_source(wrong_arity)
failures = failures + check_panic_message("two-way arity", result, "two-way mapping must contain exactly two code points")

non_scalar = "* Unicode 17.0.0" || "0a"x || "D800:230" || "0a"x || "00C0=0041 0300" || "0a"x
result = parse_source(non_scalar)
failures = failures + check_panic_message("non-scalar CCC", result, "record source is not a Unicode scalar value")

bad_ccc = "* Unicode 17.0.0" || "0a"x || "0300:0" || "0a"x || "00C0=0041 0300" || "0a"x
result = parse_source(bad_ccc)
failures = failures + check_panic_message("zero CCC", result, "canonical combining class must be 1..255")

overlap = "* Unicode 17.0.0" || "0a"x || "0300..0302:230" || "0a"x || "0302:232" || "0a"x || "00C0=0041 0300" || "0a"x
result = parse_source(overlap)
failures = failures + check_panic_message("overlapping CCC", result, "overlapping canonical-combining-class range")

duplicate = "* Unicode 17.0.0" || "0a"x || "0300:230" || "0a"x || "00C0=0041 0300" || "0a"x || "00C0>0041" || "0a"x
result = parse_source(duplicate)
failures = failures + check_panic_message("duplicate mapping", result, "duplicate decomposition mapping")

missing_version = "0300:230" || "0a"x || "00C0=0041 0300" || "0a"x
result = parse_source(missing_version)
failures = failures + check_panic_message("missing version", result, "missing Unicode version declaration")

if failures \= 0 then do
  say "Unicode gennorm2 parser failures:" failures
  return 1
end

say "PASS: deterministic typed Unicode rule parser and panic contract"
return 0

parse_source: procedure = .unicodegennorm2result
  arg source = .string
  tokens = level_l_gennorm2_lex(source)
  if level_l_gennorm2_status() \= 0 then return .unicodegennorm2result()
  return unicode_gennorm2_parse(source, tokens)

check_panic: procedure = .int
  arg label = .string, result = .unicodegennorm2result, message = .string, start = .int, span_length = .int, token = .int, line = .int
  failures = 0
  failures = failures + check_int(label || " status", result.status(), 1)
  failures = failures + check_str(label || " message", result.error(), message)
  failures = failures + check_int(label || " start", result.error_start(), start)
  failures = failures + check_int(label || " length", result.error_length(), span_length)
  failures = failures + check_int(label || " token", result.error_token(), token)
  failures = failures + check_int(label || " line", result.error_line(), line)
  return failures

check_panic_message: procedure = .int
  arg label = .string, result = .unicodegennorm2result, message = .string
  failures = check_int(label || " status", result.status(), 1)
  failures = failures + check_str(label || " message", result.error(), message)
  return failures

check_int: procedure = .int
  arg label = .string, actual = .int, expected = .int
  if actual = expected then return 0
  say "FAIL:" label "expected" expected "got" actual
  return 1

check_str: procedure = .int
  arg label = .string, actual = .string, expected = .string
  if actual == expected then return 0
  say "FAIL:" label "expected" expected "got" actual
  return 1
