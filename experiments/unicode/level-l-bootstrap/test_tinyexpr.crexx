/* Differential proof for TinyExpr generated from authored Level L. */
options levelb

import rxfnsl
import level_l_tinyexpr

failures = 0

failures = failures + compare_source("")
failures = failures + compare_source("   ")
failures = failures + compare_source("sum + 12*(x-3)/5")
failures = failures + compare_source("12 + 3*(4+5) - 6/2")
failures = failures + compare_source("abc123")
failures = failures + compare_source("0 007 42")

reference_tokens = tinyexpr_lex("2 + @")
generated_tokens = level_l_tinyexpr_lex("2 + @")
failures = failures + check_int("invalid generated status", level_l_tinyexpr_status(), 2)
failures = failures + check_int("invalid generated offset", level_l_tinyexpr_error_offset(), 4)
failures = failures + check_str("invalid generated message", level_l_tinyexpr_error_message(), "invalid input character")
failures = failures + compare_tokens("invalid prefix", reference_tokens, generated_tokens)

generated_tokens = level_l_tinyexpr_lex("é")
failures = failures + check_int("valid UTF-8 unmatched status", level_l_tinyexpr_status(), 2)
failures = failures + check_int("valid UTF-8 unmatched byte offset", level_l_tinyexpr_error_offset(), 0)

if failures \= 0 then do
  say "Level L TinyExpr failures:" failures
  return 1
end

say "PASS: authored Level L TinyExpr matches rxfnsl"
return 0

compare_source: procedure = .int
  arg source = .string
  reference_tokens = tinyexpr_lex(source)
  reference_status = tinyexpr_status()
  generated_tokens = level_l_tinyexpr_lex(source)
  generated_status = level_l_tinyexpr_status()

  failures = check_int("status for " || source, generated_status, reference_status)
  failures = failures + compare_tokens(source, reference_tokens, generated_tokens)
  return failures

compare_tokens: procedure = .int
  arg label = .string, reference_tokens = .binary, generated_tokens = .binary
  reference_count = tinyexpr_token_count(reference_tokens)
  generated_count = level_l_tinyexpr_token_count(generated_tokens)
  failures = check_int(label || " token count", generated_count, reference_count)

  compare_count = reference_count
  if generated_count < compare_count then compare_count = generated_count
  do index = 0 to compare_count - 1
    failures = failures + check_int(label || " kind", level_l_tinyexpr_token_kind(generated_tokens, index), tinyexpr_token_kind(reference_tokens, index))
    failures = failures + check_int(label || " start", level_l_tinyexpr_token_start(generated_tokens, index), tinyexpr_token_start(reference_tokens, index))
    failures = failures + check_int(label || " length", level_l_tinyexpr_token_length(generated_tokens, index), tinyexpr_token_length(reference_tokens, index))
    failures = failures + check_str(label || " name", level_l_tinyexpr_token_name(level_l_tinyexpr_token_kind(generated_tokens, index)), tinyexpr_token_name(tinyexpr_token_kind(reference_tokens, index)))
  end
  return failures

check_int: procedure = .int
  arg label = .string, actual = .int, expected = .int
  if actual = expected then return 0
  say "FAIL:" label "expected" expected "got" actual
  return 1

check_str: procedure = .int
  arg label = .string, actual = .string, expected = .string
  if actual == expected then return 0
  say "FAIL:" label "expected" expected "got" actual
  return 1
