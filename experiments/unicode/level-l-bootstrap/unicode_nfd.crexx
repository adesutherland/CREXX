/*
 * cREXX License (MIT)
 *
 * Experimental Unicode 17.0.0 NFD table compiler and normalizer. The table
 * image is a portable little-endian proof format using only <at..type> fields.
 */

options levelb

namespace unicode_nfd expose unicodenfdtables unicodenfdnormalizer unicode_nfd_compile unicode_nfd_new
import rxfnsb
import rxhash
import unicode_gennorm2

/** Compile a typed gennorm2 AST into the portable NFD proof image. */
unicode_nfd_compile: procedure = .unicodenfdtables
  arg ast = .unicodegennorm2ast
  tables = .unicodenfdtables()
  call tables.compile(ast)
  return tables

/** Construct an NFD normalizer over one validated portable table image. */
unicode_nfd_new: procedure = .unicodenfdnormalizer
  arg tables = .unicodenfdtables
  normalizer = .unicodenfdnormalizer()
  call normalizer.initialize(tables)
  return normalizer

unicode_nfd_is_scalar: procedure = .int
  arg codepoint = .int
  if codepoint < 0 | codepoint > 0x10FFFF then return 0
  if codepoint >= 0xD800 & codepoint <= 0xDFFF then return 0
  return 1

/**
 * Versioned portable NFD table image.
 *
 * Header: 64 bytes. CCC: one byte per Unicode code point. Mapping pages:
 * 4,352 eight-byte page records. Mapping records: 12 bytes each. Mapping
 * values: four-byte Unicode scalars.
 */
unicodenfdtables: class
  _image = .binary
  _status = .int
  _error = .string
  _version = .string
  _mapping_count = .int
  _mapping_value_count = .int
  _ccc_record_count = .int
  _ccc_codepoint_count = .int
  _two_way_count = .int
  _one_way_count = .int

  *: factory
    _status = 0
    _error = ""
    _version = ""
    _mapping_count = 0
    _mapping_value_count = 0
    _ccc_record_count = 0
    _ccc_codepoint_count = 0
    _two_way_count = 0
    _one_way_count = 0
    return

  compile: method = .void
    arg ast = .unicodegennorm2ast
    call binclear _image
    _status = 0
    _error = ""
    _version = ast.version()
    _mapping_count = ast.two_way_mappings() + ast.one_way_mappings()
    _mapping_value_count = ast.mapping_values()
    _ccc_record_count = ast.ccc_records()
    _ccc_codepoint_count = ast.ccc_codepoints()
    _two_way_count = ast.two_way_mappings()
    _one_way_count = ast.one_way_mappings()
    call _compile ast
    return

  status: method = .int
    return _status

  error: method = .string
    return _error

  version: method = .string
    return _version

  byte_length: method = .int
    return <blen>(_image)

  mapping_count: method = .int
    return _mapping_count

  mapping_value_count: method = .int
    return _mapping_value_count

  ccc_record_count: method = .int
    return _ccc_record_count

  ccc_codepoint_count: method = .int
    return _ccc_codepoint_count

  two_way_count: method = .int
    return _two_way_count

  one_way_count: method = .int
    return _one_way_count

  image: method = .binary
    return _image

  sha256: method = .string
    if _status \= 0 then return ""
    return rxhash..sha256hex(_image)

  manifest: method = .string
    if _status \= 0 then return "status|error|" || _error || "0a"x
    nl = "0a"x
    return "format|crexx-nfd-portable-at-v1" || nl ||,
           "unicode|" || _version || nl ||,
           "bytes|" || <blen>(_image) || nl ||,
           "ccc_records|" || _ccc_record_count || nl ||,
           "ccc_codepoints|" || _ccc_codepoint_count || nl ||,
           "mapping_records|" || _mapping_count || nl ||,
           "mapping_values|" || _mapping_value_count || nl ||,
           "two_way|" || _two_way_count || nl ||,
           "one_way|" || _one_way_count || nl ||,
           "sha256|" || sha256() || nl

  _fail: method = .void
    arg message = .string
    if _status \= 0 then return
    _status = 1
    _error = message
    return

  _compile: method = .void
    arg ast = .unicodegennorm2ast
    if _version \= "17.0.0" then do
      call _fail "NFD tables require Unicode version 17.0.0"
      return
    end
    if _ccc_record_count <= 0 | _mapping_count <= 0 | _mapping_value_count <= 0 then do
      call _fail "incomplete NFD table AST"
      return
    end

    /* Portable image constants. */
    header_size = 64
    ccc_offset = header_size
    ccc_bytes = 0x110000
    page_offset = ccc_offset + ccc_bytes
    page_count = 0x1100
    page_size = 8
    map_offset = page_offset + page_count * page_size
    map_size = 12
    values_offset = map_offset + _mapping_count * map_size
    total_size = values_offset + _mapping_value_count * 4

    call binresize _image, total_size

    /* CNFD, format 1, Unicode 17.0.0, then section offsets and counts. */
    <at..u8>(0) _image = 67
    <at..u8>(1) _image = 78
    <at..u8>(2) _image = 70
    <at..u8>(3) _image = 68
    <at..u16>(4) _image = 1
    <at..u16>(6) _image = header_size
    <at..u16>(8) _image = 17
    <at..u16>(10) _image = 0
    <at..u16>(12) _image = 0
    <at..u16>(14) _image = 0
    <at..u32>(16) _image = ccc_offset
    <at..u32>(20) _image = ccc_bytes
    <at..u32>(24) _image = page_offset
    <at..u32>(28) _image = page_count
    <at..u32>(32) _image = map_offset
    <at..u32>(36) _image = _mapping_count
    <at..u32>(40) _image = values_offset
    <at..u32>(44) _image = _mapping_value_count
    <at..u32>(48) _image = _ccc_record_count
    <at..u32>(52) _image = _ccc_codepoint_count
    <at..u32>(56) _image = _two_way_count
    <at..u32>(60) _image = _one_way_count

    map_index = 0
    value_index = 0
    last_mapping_source = -1
    seen_ccc_records = 0
    seen_ccc_codepoints = 0
    seen_two_way = 0
    seen_one_way = 0

    do record_index = 0 to ast.record_count() - 1 while _status = 0
      record = ast.record_at(record_index)
      kind = record.kind()
      select kind
        when "version" then nop
        when "ccc_single" then do
          call _add_ccc record, ccc_offset
          seen_ccc_records = seen_ccc_records + 1
          seen_ccc_codepoints = seen_ccc_codepoints + 1
        end
        when "ccc_range" then do
          call _add_ccc record, ccc_offset
          seen_ccc_records = seen_ccc_records + 1
          seen_ccc_codepoints = seen_ccc_codepoints + record.last() - record.first() + 1
        end
        when "mapping_two_way" then do
          call _add_mapping record, map_index, value_index, last_mapping_source, page_offset, map_offset, values_offset, 1
          seen_two_way = seen_two_way + 1
        end
        when "mapping_one_way" then do
          call _add_mapping record, map_index, value_index, last_mapping_source, page_offset, map_offset, values_offset, 0
          seen_one_way = seen_one_way + 1
        end
        otherwise call _fail "unsupported record in NFD table AST"
      end
    end

    if _status \= 0 then return
    if map_index \= _mapping_count | value_index \= _mapping_value_count then,
      call _fail "mapping table count mismatch"
    else if seen_ccc_records \= _ccc_record_count | seen_ccc_codepoints \= _ccc_codepoint_count then,
      call _fail "CCC table count mismatch"
    else if seen_two_way \= _two_way_count | seen_one_way \= _one_way_count then,
      call _fail "mapping-kind count mismatch"
    return

  _add_ccc: method = .void
    arg record = .unicodegennorm2record, ccc_offset = .int
    first = record.first()
    last = record.last()
    ccc = record.number()
    if unicode_nfd_is_scalar(first) = 0 | unicode_nfd_is_scalar(last) = 0 | last < first then do
      call _fail "invalid CCC range while compiling NFD tables"
      return
    end
    if first <= 0xDFFF & last >= 0xD800 then do
      call _fail "CCC range contains a surrogate while compiling NFD tables"
      return
    end
    if ccc < 1 | ccc > 255 then do
      call _fail "invalid CCC value while compiling NFD tables"
      return
    end
    do codepoint = first to last
      offset = ccc_offset + codepoint
      if <at..u8>(offset) _image \= 0 then do
        call _fail "overlapping CCC range while compiling NFD tables"
        return
      end
      <at..u8>(offset) _image = ccc
    end
    return

  _add_mapping: method = .void
    arg record = .unicodegennorm2record, expose map_index = .int, expose value_index = .int, expose last_mapping_source = .int, page_offset = .int, map_offset = .int, values_offset = .int, two_way = .int
    source = record.first()
    if unicode_nfd_is_scalar(source) = 0 then do
      call _fail "invalid mapping source while compiling NFD tables"
      return
    end
    if source <= last_mapping_source then do
      call _fail "decomposition mappings are not in strict code-point order"
      return
    end
    if record.value_count() <= 0 then do
      call _fail "empty decomposition mapping while compiling NFD tables"
      return
    end
    if two_way & record.value_count() \= 2 then do
      call _fail "two-way decomposition has invalid arity while compiling NFD tables"
      return
    end

    page = source <idiv> 256
    page_record = page_offset + page * 8
    page_mappings = <at..u16>(page_record + 4) _image
    if page_mappings = 0 then <at..u32>(page_record) _image = map_index
    <at..u16>(page_record + 4) _image = page_mappings + 1

    offset = map_offset + map_index * 12
    <at..u32>(offset) _image = source
    <at..u32>(offset + 4) _image = value_index
    <at..u16>(offset + 8) _image = record.value_count()
    <at..u8>(offset + 10) _image = two_way
    <at..u8>(offset + 11) _image = 0

    do i = 0 to record.value_count() - 1
      value = record.value_at(i)
      if unicode_nfd_is_scalar(value) = 0 then do
        call _fail "invalid mapping value while compiling NFD tables"
        return
      end
      <at..u32>(values_offset + value_index * 4) _image = value
      value_index = value_index + 1
    end
    last_mapping_source = source
    map_index = map_index + 1
    return

/** Explicit NFD operation over one validated portable table image. */
unicodenfdnormalizer: class
  _image = .binary
  _ready = .int
  _status = .int
  _error = .string
  _ccc_offset = .int
  _ccc_bytes = .int
  _page_offset = .int
  _page_count = .int
  _map_offset = .int
  _map_count = .int
  _values_offset = .int
  _value_count = .int
  _work = .binary
  _work_capacity = .int
  _work_count = .int
  _path = .binary

  *: factory
    _ready = 0
    _status = 0
    _error = ""
    _work_capacity = 64
    _work_count = 0
    call binresize _work, _work_capacity * 4
    call binresize _path, 64 * 4
    return

  initialize: method = .void
    arg tables = .unicodenfdtables
    _ready = 0
    _status = 0
    _error = ""
    if tables.status() \= 0 then do
      call _fail tables.error()
      return
    end
    _image = tables.image()
    call _validate_image
    if _status = 0 then _ready = 1
    return

  status: method = .int
    return _status

  error: method = .string
    return _error

  ready: method = .int
    return _ready

  normalize: method = .string
    arg source = .string
    if _ready = 0 then return ""
    _status = 0
    _error = ""
    _work_count = 0

    source_length = 0
    assembler strlen source_length,source
    do source_index = 0 to source_length - 1 while _status = 0
      codepoint = 0
      assembler strchar codepoint,source,source_index
      call _decompose codepoint, 0
    end
    if _status \= 0 then return ""

    call _canonical_order
    if _status \= 0 then return ""

    result = ""
    do i = 0 to _work_count - 1
      codepoint = <at..u32>(i * 4) _work
      assembler appendchar result,codepoint
    end
    return result

  combining_class: method = .int
    arg codepoint = .int
    if _ready = 0 then return -1
    if unicode_nfd_is_scalar(codepoint) = 0 then return -1
    return _ccc(codepoint)

  _fail: method = .void
    arg message = .string
    if _status \= 0 then return
    _status = 1
    _error = message
    return

  _validate_image: method = .void
    image_length = <blen>(_image)
    if image_length < 64 then do
      call _fail "NFD table image is shorter than its header"
      return
    end
    if <at..u8>(0) _image \= 67 | <at..u8>(1) _image \= 78 |,
       <at..u8>(2) _image \= 70 | <at..u8>(3) _image \= 68 then do
      call _fail "NFD table image has invalid magic"
      return
    end
    if <at..u16>(4) _image \= 1 | <at..u16>(6) _image \= 64 then do
      call _fail "unsupported NFD table format"
      return
    end
    if <at..u16>(8) _image \= 17 | <at..u16>(10) _image \= 0 | <at..u16>(12) _image \= 0 then do
      call _fail "unsupported Unicode version in NFD table image"
      return
    end

    _ccc_offset = <at..u32>(16) _image
    _ccc_bytes = <at..u32>(20) _image
    _page_offset = <at..u32>(24) _image
    _page_count = <at..u32>(28) _image
    _map_offset = <at..u32>(32) _image
    _map_count = <at..u32>(36) _image
    _values_offset = <at..u32>(40) _image
    _value_count = <at..u32>(44) _image

    if _ccc_offset \= 64 | _ccc_bytes \= 0x110000 then do
      call _fail "invalid CCC section in NFD table image"
      return
    end
    if _page_count \= 0x1100 | _page_offset \= _ccc_offset + _ccc_bytes then do
      call _fail "invalid mapping-page section in NFD table image"
      return
    end
    if _map_offset \= _page_offset + _page_count * 8 then do
      call _fail "invalid mapping-record section in NFD table image"
      return
    end
    if _values_offset \= _map_offset + _map_count * 12 |,
       image_length \= _values_offset + _value_count * 4 then do
      call _fail "invalid mapping-value section in NFD table image"
      return
    end

    previous_source = -1
    do map_index = 0 to _map_count - 1 while _status = 0
      record_offset = _map_offset + map_index * 12
      source = <at..u32>(record_offset) _image
      value_start = <at..u32>(record_offset + 4) _image
      value_length = <at..u16>(record_offset + 8) _image
      if unicode_nfd_is_scalar(source) = 0 | source <= previous_source then,
        call _fail "invalid mapping order in NFD table image"
      else if value_length = 0 | value_start + value_length > _value_count then,
        call _fail "invalid mapping span in NFD table image"
      previous_source = source
    end

    do page = 0 to _page_count - 1 while _status = 0
      page_record = _page_offset + page * 8
      first = <at..u32>(page_record) _image
      count = <at..u16>(page_record + 4) _image
      if count > 0 then do
        if first + count > _map_count then call _fail "invalid mapping page span in NFD table image"
        else do i = first to first + count - 1 while _status = 0
          source = <at..u32>(_map_offset + i * 12) _image
          if source <idiv> 256 \= page then call _fail "mapping page does not match its source"
        end
      end
    end

    do value_index = 0 to _value_count - 1 while _status = 0
      value = <at..u32>(_values_offset + value_index * 4) _image
      if unicode_nfd_is_scalar(value) = 0 then call _fail "non-scalar mapping value in NFD table image"
    end
    return

  _decompose: method = .void
    arg codepoint = .int, depth = .int
    if _status \= 0 then return
    if unicode_nfd_is_scalar(codepoint) = 0 then do
      call _fail "normalization input is not a scalar value"
      return
    end

    if codepoint >= 0xAC00 & codepoint < 0xAC00 + 11172 then do
      s_index = codepoint - 0xAC00
      l_index = s_index <idiv> 588
      remainder = s_index <mod> 588
      v_index = remainder <idiv> 28
      t_index = s_index <mod> 28
      call _append 0x1100 + l_index
      call _append 0x1161 + v_index
      if t_index \= 0 then call _append 0x11A7 + t_index
      return
    end

    mapping = _find_mapping(codepoint)
    if mapping < 0 then do
      call _append codepoint
      return
    end
    if depth >= 64 then do
      call _fail "cyclic or excessively deep decomposition mapping"
      return
    end
    do i = 0 to depth - 1
      if <at..u32>(i * 4) _path = codepoint then do
        call _fail "cyclic or excessively deep decomposition mapping"
        return
      end
    end
    <at..u32>(depth * 4) _path = codepoint

    record_offset = _map_offset + mapping * 12
    value_start = <at..u32>(record_offset + 4) _image
    value_length = <at..u16>(record_offset + 8) _image
    do i = 0 to value_length - 1 while _status = 0
      value = <at..u32>(_values_offset + (value_start + i) * 4) _image
      call _decompose value, depth + 1
    end
    return

  _append: method = .void
    arg codepoint = .int
    if _work_count >= _work_capacity then do
      _work_capacity = _work_capacity * 2
      call binresize _work, _work_capacity * 4
    end
    <at..u32>(_work_count * 4) _work = codepoint
    _work_count = _work_count + 1
    return

  _find_mapping: method = .int
    arg codepoint = .int
    page = codepoint <idiv> 256
    page_record = _page_offset + page * 8
    first = <at..u32>(page_record) _image
    count = <at..u16>(page_record + 4) _image
    low = first
    high = first + count - 1
    do while low <= high
      middle = (low + high) <idiv> 2
      source = <at..u32>(_map_offset + middle * 12) _image
      if source = codepoint then return middle
      if source < codepoint then low = middle + 1
      else high = middle - 1
    end
    return -1

  _ccc: method = .int
    arg codepoint = .int
    return <at..u8>(_ccc_offset + codepoint) _image

  _canonical_order: method = .void
    do i = 1 to _work_count - 1
      current = <at..u32>(i * 4) _work
      current_ccc = _ccc(current)
      if current_ccc = 0 then iterate
      j = i
      do while j > 0
        previous = <at..u32>((j - 1) * 4) _work
        previous_ccc = _ccc(previous)
        if previous_ccc = 0 | previous_ccc <= current_ccc then leave
        <at..u32>(j * 4) _work = previous
        <at..u32>((j - 1) * 4) _work = current
        j = j - 1
      end
    end
    return
