/*
 * cREXX License (MIT)
 *
 * Experimental Unicode 17.0.0 prepared normalization tables and UTF-8
 * normalizer.  The image is portable and byte-addressed.  Recursive
 * decomposition and canonical ordering of each scalar mapping happen only
 * while generating it; NFC and NFKC share one fused canonical composer.
 */

options levelb

namespace unicode_d expose unicodedtables unicodednormalizer unicode_d_compile unicode_norm_compile unicode_d_new
import rxfnsb
import rxhash
import unicode_gennorm2
import unicode_data
import unicode_normprops

/** Compile canonical and compatibility UCD ASTs into one prepared image. */
unicode_d_compile: procedure = .unicodedtables
  arg ucd = .unicodeucdresult, properties = .unicodenormpropsresult
  tables = .unicodedtables()
  call tables.compile(ucd, properties)
  return tables

/** Compile the complete four-form prepared normalization image. */
unicode_norm_compile: procedure = .unicodedtables
  arg ucd = .unicodeucdresult, properties = .unicodenormpropsresult
  tables = .unicodedtables()
  call tables.compile(ucd, properties)
  return tables

/** Construct one NFD or NFKD normalizer over a prepared image. */
unicode_d_new: procedure = .unicodednormalizer
  arg tables = .unicodedtables, form = .string
  normalizer = .unicodednormalizer()
  call normalizer.initialize(tables, form)
  return normalizer

unicode_d_is_scalar: procedure = .int
  arg codepoint = .int
  if codepoint < 0 | codepoint > 0x10FFFF then return 0
  if codepoint >= 0xD800 & codepoint <= 0xDFFF then return 0
  return 1

/** Compact temporary index over the direct decomposition graph. */
unicodedrawmappings: class
  _image = .binary
  _status = .int
  _error = .string
  _map_count = .int
  _value_count = .int
  _map_offset = .int
  _values_offset = .int

  *: factory
    _status = 0
    _error = ""
    _map_count = 0
    _value_count = 0
    _map_offset = 0x1100 * 8
    _values_offset = _map_offset
    return

  compile: method = .void
    arg ast = .unicodegennorm2ast
    _status = 0
    _error = ""
    _map_count = ast.two_way_mappings() + ast.one_way_mappings()
    _value_count = ast.mapping_values()
    _map_offset = 0x1100 * 8
    _values_offset = _map_offset + _map_count * 12
    call binresize _image, _values_offset + _value_count * 4
    if ast.version() \= "17.0.0" | _map_count <= 0 | _value_count <= 0 then do
      call _fail "invalid direct Unicode decomposition AST"
      return
    end

    map_index = 0
    value_index = 0
    previous = -1
    do i = 0 to ast.record_count() - 1 while _status = 0
      record = ast.record_at(i)
      if record.kind() = "mapping_one_way" |,
         record.kind() = "mapping_two_way" then do
        source = record.first()
        if unicode_d_is_scalar(source) = 0 | source <= previous then do
          call _fail "direct Unicode mappings are not strictly ordered"
          iterate
        end
        if record.value_count() <= 0 then do
          call _fail "direct Unicode mapping is empty"
          iterate
        end

        page = source <idiv> 256
        page_offset = page * 8
        page_count = <at..u16>(page_offset + 4) _image
        if page_count = 0 then <at..u32>(page_offset) _image = map_index
        <at..u16>(page_offset + 4) _image = page_count + 1

        offset = _map_offset + map_index * 12
        <at..u32>(offset) _image = source
        <at..u32>(offset + 4) _image = value_index
        <at..u16>(offset + 8) _image = record.value_count()
        <at..u16>(offset + 10) _image = 0
        do j = 0 to record.value_count() - 1 while _status = 0
          value = record.value_at(j)
          if unicode_d_is_scalar(value) = 0 then call _fail "direct Unicode mapping contains a non-scalar value"
          else do
            <at..u32>(_values_offset + value_index * 4) _image = value
            value_index = value_index + 1
          end
        end
        previous = source
        map_index = map_index + 1
      end
    end
    if _status = 0 & (map_index \= _map_count | value_index \= _value_count) then,
      call _fail "direct Unicode mapping count mismatch"
    return

  status: method = .int
    return _status

  error: method = .string
    return _error

  map_count: method = .int
    return _map_count

  value_count: method = .int
    return _value_count

  source_at: method = .int
    arg index = .int
    return <at..u32>(_map_offset + index * 12) _image

  mapping_value_count: method = .int
    arg mapping = .int
    return <at..u16>(_map_offset + mapping * 12 + 8) _image

  mapping_value_at: method = .int
    arg mapping = .int, index = .int
    first = <at..u32>(_map_offset + mapping * 12 + 4) _image
    return <at..u32>(_values_offset + (first + index) * 4) _image

  find: method = .int
    arg codepoint = .int
    page_offset = (codepoint <idiv> 256) * 8
    first = <at..u32>(page_offset) _image
    count = <at..u16>(page_offset + 4) _image
    low = first
    high = first + count - 1
    do while low <= high
      middle = (low + high) <idiv> 2
      source = <at..u32>(_map_offset + middle * 12) _image
      if source = codepoint then return middle
      if source < codepoint then low = middle + 1
      else high = middle - 1
    end
    return -1

  _fail: method = .void
    arg message = .string
    if _status \= 0 then return
    _status = 1
    _error = message
    return

/** Versioned portable prepared four-form normalization image. */
unicodedtables: class
  _image = .binary
  _status = .int
  _error = .string
  _ccc = .binary
  _ccc_seen = .binary
  _rank = .binary
  _rank_count = .int
  _nfd_raw = .unicodedrawmappings
  _nfkd_raw = .unicodedrawmappings
  _temp = .binary
  _temp_count = .int
  _temp_capacity = .int
  _path = .binary
  _nfd_bits = .binary
  _nfkd_bits = .binary
  _nfd_prepared = .binary
  _nfd_pages = .binary
  _nfkd_pages = .binary
  _nfd_records = .binary
  _nfkd_records = .binary
  _nfd_components = .binary
  _nfkd_components = .binary
  _nfd_component_count = .int
  _nfkd_component_count = .int
  _nfd_utf8_bytes = .int
  _nfkd_utf8_bytes = .int
  _nfd_closed = .int
  _nfd_open = .int
  _nfd_marks = .int
  _nfd_complex = .int
  _nfkd_closed = .int
  _nfkd_open = .int
  _nfkd_marks = .int
  _nfkd_complex = .int
  _nfd_identity_starters = .int
  _nfd_identity_marks = .int
  _nfkd_identity_starters = .int
  _nfkd_identity_marks = .int
  _composition_triples = .binary
  _composition_count = .int
  _composition_directory = .binary
  _composition_directory_count = .int
  _composition_pairs = .binary
  _composition_max_pairs = .int
  _full_exclusion_count = .int

  *: factory
    _status = 0
    _error = ""
    _rank_count = 0
    _temp_count = 0
    _temp_capacity = 32
    _composition_count = 0
    _composition_directory_count = 0
    _composition_max_pairs = 0
    _full_exclusion_count = 0
    call binresize _temp, _temp_capacity * 4
    call binresize _path, 64 * 4
    return

  compile: method = .void
    arg ucd = .unicodeucdresult, properties = .unicodenormpropsresult
    _status = 0
    _error = ""
    if ucd.status() \= 0 then do
      call _fail ucd.error()
      return
    end
    if properties.status() \= 0 then do
      call _fail properties.error()
      return
    end

    call _compile_ccc ucd.compatibility_ast()
    if _status \= 0 then return

    _nfd_raw = .unicodedrawmappings()
    call _nfd_raw.compile(ucd.canonical_ast())
    if _nfd_raw.status() \= 0 then do
      call _fail _nfd_raw.error()
      return
    end
    _nfkd_raw = .unicodedrawmappings()
    call _nfkd_raw.compile(ucd.compatibility_ast())
    if _nfkd_raw.status() \= 0 then do
      call _fail _nfkd_raw.error()
      return
    end

    call _prepare_form _nfd_raw, 1
    if _status = 0 then call _prepare_form _nfkd_raw, 2
    if _status = 0 then call _prepare_composition ucd.canonical_ast(), properties
    if _status = 0 then call _audit_partition 1
    if _status = 0 then call _audit_partition 2
    if _status = 0 then call _prepare_nfd_symbols
    if _status = 0 then call _assemble_image
    return

  status: method = .int
    return _status

  error: method = .string
    return _error

  image: method = .binary
    return _image

  byte_length: method = .int
    return <blen>(_image)

  sha256: method = .string
    if _status \= 0 then return ""
    return rxhash..sha256hex(_image)

  rank_count: method = .int
    return _rank_count

  nfd_mapping_count: method = .int
    return _nfd_raw.map_count()

  nfkd_mapping_count: method = .int
    return _nfkd_raw.map_count()

  nfd_component_count: method = .int
    return _nfd_component_count

  nfkd_component_count: method = .int
    return _nfkd_component_count

  nfd_identity_starters: method = .int
    return _nfd_identity_starters

  nfd_identity_marks: method = .int
    return _nfd_identity_marks

  nfkd_identity_starters: method = .int
    return _nfkd_identity_starters

  nfkd_identity_marks: method = .int
    return _nfkd_identity_marks

  composition_pair_count: method = .int
    return _composition_count

  composition_starter_count: method = .int
    return _composition_directory_count

  full_exclusion_count: method = .int
    return _full_exclusion_count

  manifest: method = .string
    if _status \= 0 then return "status|error|" || _error || "0a"x
    nl = "0a"x
    return "format|crexx-unicode-normalization-prepared-portable-v3" || nl ||,
           "unicode|17.0.0" || nl ||,
           "bytes|" || <blen>(_image) || nl ||,
           "positive_ccc|" || _rank_count || nl ||,
           "nfd_mappings|" || _nfd_raw.map_count() || nl ||,
           "nfd_components|" || _nfd_component_count || nl ||,
           "nfd_utf8_bytes|" || _nfd_utf8_bytes || nl ||,
           "nfd_classes|" || _nfd_closed || "/" || _nfd_open || "/" || _nfd_marks || "/" || _nfd_complex || nl ||,
           "nfkd_mappings|" || _nfkd_raw.map_count() || nl ||,
           "nfkd_components|" || _nfkd_component_count || nl ||,
           "nfkd_utf8_bytes|" || _nfkd_utf8_bytes || nl ||,
           "nfkd_classes|" || _nfkd_closed || "/" || _nfkd_open || "/" || _nfkd_marks || "/" || _nfkd_complex || nl ||,
           "composition_pairs|" || _composition_count || nl ||,
           "composition_starters|" || _composition_directory_count || nl ||,
           "composition_max_pairs|" || _composition_max_pairs || nl ||,
           "full_composition_exclusions|" || _full_exclusion_count || nl ||,
           "sha256|" || sha256() || nl

  _fail: method = .void
    arg message = .string
    if _status \= 0 then return
    _status = 1
    _error = message
    return

  _compile_ccc: method = .void
    arg ast = .unicodegennorm2ast
    ccc = .int
    call binresize _ccc, 0x110000
    call binresize _ccc_seen, 255
    call binresize _rank, 256
    ccc_count = 0
    do i = 0 to ast.record_count() - 1 while _status = 0
      record = ast.record_at(i)
      if record.kind() = "ccc_single" | record.kind() = "ccc_range" then do
        first = record.first()
        last = record.last()
        ccc = record.number()
        if unicode_d_is_scalar(first) = 0 | unicode_d_is_scalar(last) = 0 | last < first then,
          call _fail "invalid CCC record in prepared D generator"
        else if ccc < 1 | ccc > 254 then,
          call _fail "prepared D generator requires CCC values 1..254"
        else do codepoint = first to last while _status = 0
          if <at..u8>(codepoint) _ccc \= 0 then call _fail "overlapping CCC record in prepared D generator"
          else do
            <at..u8>(codepoint) _ccc = ccc
            <at..u8>(ccc) _ccc_seen = 1
            ccc_count = ccc_count + 1
          end
        end
      end
    end
    if _status = 0 & ccc_count \= 968 then call _fail "prepared D CCC scalar count mismatch"
    _rank_count = 0
    do ccc = 1 to 254
      if <at..u8>(ccc) _ccc_seen \= 0 then do
        <at..u8>(ccc) _rank = _rank_count
        _rank_count = _rank_count + 1
      end
    end
    if _status = 0 & _rank_count \= 55 then call _fail "prepared D positive CCC rank count mismatch"
    return

  _prepare_form: method = .void
    arg raw = .unicodedrawmappings, form = .int
    component_start = .int
    i = .int
    codepoint = .int
    if form = 1 then do
      call binresize _nfd_bits, 0x22000
      call binresize _nfd_pages, 0x1100 * 8
      call binresize _nfd_records, raw.map_count() * 12
      call binresize _nfd_components, (raw.value_count() + raw.map_count()) * 12
      _nfd_component_count = 0
      _nfd_utf8_bytes = 0
      _nfd_closed = 0
      _nfd_open = 0
      _nfd_marks = 0
      _nfd_complex = 0
    end
    else do
      call binresize _nfkd_bits, 0x22000
      call binresize _nfkd_pages, 0x1100 * 8
      call binresize _nfkd_records, raw.map_count() * 12
      call binresize _nfkd_components, (raw.value_count() + raw.map_count()) * 12
      _nfkd_component_count = 0
      _nfkd_utf8_bytes = 0
      _nfkd_closed = 0
      _nfkd_open = 0
      _nfkd_marks = 0
      _nfkd_complex = 0
    end

    do mapping = 0 to raw.map_count() - 1 while _status = 0
      source = raw.source_at(mapping)
      _temp_count = 0
      call _expand raw, source, 0
      if _status \= 0 then leave
      call _order_temp
      if _status \= 0 then leave
      structural_class = _classify_temp()
      closed_count = _closed_prefix_count()
      if structural_class < 1 | structural_class > 4 then do
        call _fail "prepared D mapping has an invalid structural class"
        leave
      end
      if _temp_count > 255 | closed_count > 255 then do
        call _fail "prepared D mapping exceeds its compact boundary fields"
        leave
      end

      if form = 1 then do
        component_start = _nfd_component_count
        do i = 0 to _temp_count - 1
          codepoint = <at..u32>(i * 4) _temp
          call _write_component _nfd_components, _nfd_component_count, codepoint
          _nfd_utf8_bytes = _nfd_utf8_bytes + _utf8_length(codepoint)
          _nfd_component_count = _nfd_component_count + 1
        end
        call _write_prepared_record _nfd_records, _nfd_pages, _nfd_bits, mapping, source, component_start, _temp_count, structural_class, closed_count
        if structural_class = 1 then _nfd_closed = _nfd_closed + 1
        else if structural_class = 2 then _nfd_open = _nfd_open + 1
        else if structural_class = 3 then _nfd_marks = _nfd_marks + 1
        else _nfd_complex = _nfd_complex + 1
      end
      else do
        component_start = _nfkd_component_count
        do i = 0 to _temp_count - 1
          codepoint = <at..u32>(i * 4) _temp
          call _write_component _nfkd_components, _nfkd_component_count, codepoint
          _nfkd_utf8_bytes = _nfkd_utf8_bytes + _utf8_length(codepoint)
          _nfkd_component_count = _nfkd_component_count + 1
        end
        call _write_prepared_record _nfkd_records, _nfkd_pages, _nfkd_bits, mapping, source, component_start, _temp_count, structural_class, closed_count
        if structural_class = 1 then _nfkd_closed = _nfkd_closed + 1
        else if structural_class = 2 then _nfkd_open = _nfkd_open + 1
        else if structural_class = 3 then _nfkd_marks = _nfkd_marks + 1
        else _nfkd_complex = _nfkd_complex + 1
      end
    end

    if _status \= 0 then return
    if form = 1 then do
      call binresize _nfd_components, _nfd_component_count * 12
      if _nfd_component_count \= 3450 | _nfd_utf8_bytes \= 8041 |,
         _nfd_closed \= 1085 | _nfd_open \= 989 |,
         _nfd_marks \= 7 | _nfd_complex \= 0 then,
        call _fail "prepared NFD closure audit mismatch"
    end
    else do
      call binresize _nfkd_components, _nfkd_component_count * 12
      if _nfkd_component_count \= 9193 | _nfkd_utf8_bytes \= 18593 |,
         _nfkd_closed \= 4822 | _nfkd_open \= 1083 |,
         _nfkd_marks \= 9 | _nfkd_complex \= 0 then,
        call _fail "prepared NFKD closure audit mismatch"
    end
    return

  _expand: method = .void
    arg raw = .unicodedrawmappings, codepoint = .int, depth = .int
    i = .int
    if _status \= 0 then return
    if unicode_d_is_scalar(codepoint) = 0 then do
      call _fail "prepared D closure contains a non-scalar value"
      return
    end
    if codepoint >= 0xAC00 & codepoint < 0xAC00 + 11172 then do
      s_index = codepoint - 0xAC00
      l_index = s_index <idiv> 588
      remainder = s_index <mod> 588
      v_index = remainder <idiv> 28
      t_index = s_index <mod> 28
      call _append_temp 0x1100 + l_index
      call _append_temp 0x1161 + v_index
      if t_index \= 0 then call _append_temp 0x11A7 + t_index
      return
    end

    mapping = raw.find(codepoint)
    if mapping < 0 then do
      call _append_temp codepoint
      return
    end
    if depth >= 64 then do
      call _fail "cyclic or excessively deep prepared D decomposition"
      return
    end
    do i = 0 to depth - 1
      if <at..u32>(i * 4) _path = codepoint then do
        call _fail "cyclic or excessively deep prepared D decomposition"
        return
      end
    end
    <at..u32>(depth * 4) _path = codepoint
    do i = 0 to raw.mapping_value_count(mapping) - 1 while _status = 0
      call _expand raw, raw.mapping_value_at(mapping, i), depth + 1
    end
    return

  _append_temp: method = .void
    arg codepoint = .int
    if _temp_count >= _temp_capacity then do
      _temp_capacity = _temp_capacity * 2
      call binresize _temp, _temp_capacity * 4
    end
    <at..u32>(_temp_count * 4) _temp = codepoint
    _temp_count = _temp_count + 1
    return

  _order_temp: method = .void
    previous_ccc = .int
    i = .int
    do i = 1 to _temp_count - 1
      current = <at..u32>(i * 4) _temp
      current_ccc = <at..u8>(current) _ccc
      if current_ccc = 0 then iterate
      j = i
      do while j > 0
        previous = <at..u32>((j - 1) * 4) _temp
        previous_ccc = <at..u8>(previous) _ccc
        if previous_ccc = 0 | previous_ccc <= current_ccc then leave
        <at..u32>(j * 4) _temp = previous
        <at..u32>((j - 1) * 4) _temp = current
        j = j - 1
      end
    end
    previous_ccc = 0
    do i = 0 to _temp_count - 1 while _status = 0
      codepoint = <at..u32>(i * 4) _temp
      ccc = <at..u8>(codepoint) _ccc
      if ccc = 0 then previous_ccc = 0
      else do
        if previous_ccc > ccc then call _fail "prepared D expansion is not canonically ordered"
        previous_ccc = ccc
      end
    end
    return

  _classify_temp: method = .int
    first_starter = -1
    last_starter = -1
    do i = 0 to _temp_count - 1
      codepoint = <at..u32>(i * 4) _temp
      if <at..u8>(codepoint) _ccc = 0 then do
        if first_starter < 0 then first_starter = i
        last_starter = i
      end
    end
    if first_starter < 0 then return 3
    if first_starter > 0 then return 4
    if last_starter = _temp_count - 1 then return 1
    return 2

  /** Components through the final starter are closed against later input. */
  _closed_prefix_count: method = .int
    closed_count = 0
    do i = 0 to _temp_count - 1
      codepoint = <at..u32>(i * 4) _temp
      if <at..u8>(codepoint) _ccc = 0 then closed_count = i + 1
    end
    return closed_count

  _write_prepared_record: method = .void
    arg expose records = .binary, expose pages = .binary, expose bits = .binary, mapping = .int, source = .int, component_start = .int, component_count = .int, structural_class = .int, closed_count = .int
    offset = mapping * 12
    <at..u32>(offset) records = source
    <at..u32>(offset + 4) records = component_start
    <at..u16>(offset + 8) records = component_count
    <at..u8>(offset + 10) records = structural_class
    <at..u8>(offset + 11) records = closed_count

    page_offset = (source <idiv> 256) * 8
    page_count = <at..u16>(page_offset + 4) pages
    if page_count = 0 then <at..u32>(page_offset) pages = mapping
    <at..u16>(page_offset + 4) pages = page_count + 1

    bit_offset = source <idiv> 8
    mask = 1 <shl> (source <mod> 8)
    <at..u8>(bit_offset) bits = <at..u8>(bit_offset) bits <or> mask
    return

  _write_component: method = .void
    arg expose components = .binary, index = .int, codepoint = .int
    offset = index * 12
    ccc = <at..u8>(codepoint) _ccc
    length = _utf8_length(codepoint)
    <at..u32>(offset) components = codepoint
    <at..u8>(offset + 4) components = ccc
    <at..u8>(offset + 5) components = length
    if length = 1 then <at..u8>(offset + 6) components = codepoint
    else if length = 2 then do
      <at..u8>(offset + 6) components = 0xC0 <or> (codepoint <shr> 6)
      <at..u8>(offset + 7) components = 0x80 <or> (codepoint <and> 0x3F)
    end
    else if length = 3 then do
      <at..u8>(offset + 6) components = 0xE0 <or> (codepoint <shr> 12)
      <at..u8>(offset + 7) components = 0x80 <or> ((codepoint <shr> 6) <and> 0x3F)
      <at..u8>(offset + 8) components = 0x80 <or> (codepoint <and> 0x3F)
    end
    else do
      <at..u8>(offset + 6) components = 0xF0 <or> (codepoint <shr> 18)
      <at..u8>(offset + 7) components = 0x80 <or> ((codepoint <shr> 12) <and> 0x3F)
      <at..u8>(offset + 8) components = 0x80 <or> ((codepoint <shr> 6) <and> 0x3F)
      <at..u8>(offset + 9) components = 0x80 <or> (codepoint <and> 0x3F)
    end
    return

  _utf8_length: method = .int
    arg codepoint = .int
    if codepoint <= 0x7F then return 1
    if codepoint <= 0x7FF then return 2
    if codepoint <= 0xFFFF then return 3
    return 4

  _mapped: method = .int
    arg bits = .binary, codepoint = .int
    byte = <at..u8>(codepoint <idiv> 8) bits
    mask = 1 <shl> (codepoint <mod> 8)
    return (byte <and> mask) \= 0

  /** Build the exact non-Hangul Primary Composite relation. */
  _prepare_composition: method = .void
    arg ast = .unicodegennorm2ast, properties = .unicodenormpropsresult
    _full_exclusion_count = properties.full_exclusion_count()
    call binresize _composition_triples, 2081 * 12
    _composition_count = 0
    do i = 0 to ast.record_count() - 1 while _status = 0
      record = ast.record_at(i)
      if record.kind() \= "mapping_one_way" | record.value_count() \= 2 then iterate
      composite = record.first()
      first = record.value_at(0)
      second = record.value_at(1)
      if properties.is_full_exclusion(composite) then iterate
      if <at..u8>(first) _ccc \= 0 then iterate
      offset = _composition_count * 12
      <at..u32>(offset) _composition_triples = first
      <at..u32>(offset + 4) _composition_triples = second
      <at..u32>(offset + 8) _composition_triples = composite
      _composition_count = _composition_count + 1
    end
    call binresize _composition_triples, _composition_count * 12
    if _composition_count \= 961 | _full_exclusion_count \= 1120 then do
      call _fail "Unicode 17 primary-composition audit mismatch"
      return
    end
    call _sort_composition
    if _status = 0 then call _index_composition
    return

  _sort_composition: method = .void
    previous_first = .int
    previous_second = .int
    i = .int
    offset = .int
    first = .int
    second = .int
    do i = 1 to _composition_count - 1
      offset = i * 12
      first = <at..u32>(offset) _composition_triples
      second = <at..u32>(offset + 4) _composition_triples
      composite = <at..u32>(offset + 8) _composition_triples
      j = i
      do while j > 0
        previous_offset = (j - 1) * 12
        previous_first = <at..u32>(previous_offset) _composition_triples
        previous_second = <at..u32>(previous_offset + 4) _composition_triples
        if previous_first < first |,
           (previous_first = first & previous_second < second) then leave
        target_offset = j * 12
        <at..u32>(target_offset) _composition_triples = previous_first
        <at..u32>(target_offset + 4) _composition_triples = previous_second
        <at..u32>(target_offset + 8) _composition_triples = <at..u32>(previous_offset + 8) _composition_triples
        j = j - 1
      end
      target_offset = j * 12
      <at..u32>(target_offset) _composition_triples = first
      <at..u32>(target_offset + 4) _composition_triples = second
      <at..u32>(target_offset + 8) _composition_triples = composite
    end
    previous_first = -1
    previous_second = -1
    do i = 0 to _composition_count - 1 while _status = 0
      offset = i * 12
      first = <at..u32>(offset) _composition_triples
      second = <at..u32>(offset + 4) _composition_triples
      if first < previous_first | (first = previous_first & second <= previous_second) then,
        call _fail "primary-composition pairs are not unique and ordered"
      previous_first = first
      previous_second = second
    end
    return

  _index_composition: method = .void
    call binresize _composition_directory, _composition_count * 12
    call binresize _composition_pairs, _composition_count * 8
    _composition_directory_count = 0
    _composition_max_pairs = 0
    pair = 0
    do while pair < _composition_count & _status = 0
      triple_offset = pair * 12
      starter = <at..u32>(triple_offset) _composition_triples
      first_pair = pair
      do while pair < _composition_count &,
               <at..u32>(pair * 12) _composition_triples = starter
        triple_offset = pair * 12
        pair_offset = pair * 8
        <at..u32>(pair_offset) _composition_pairs = <at..u32>(triple_offset + 4) _composition_triples
        <at..u32>(pair_offset + 4) _composition_pairs = <at..u32>(triple_offset + 8) _composition_triples
        pair = pair + 1
      end
      pair_count = pair - first_pair
      directory_offset = _composition_directory_count * 12
      <at..u32>(directory_offset) _composition_directory = starter
      <at..u32>(directory_offset + 4) _composition_directory = first_pair
      <at..u16>(directory_offset + 8) _composition_directory = pair_count
      <at..u16>(directory_offset + 10) _composition_directory = 0
      if pair_count > _composition_max_pairs then _composition_max_pairs = pair_count
      _composition_directory_count = _composition_directory_count + 1
    end
    call binresize _composition_directory, _composition_directory_count * 12
    if _composition_directory_count \= 391 | _composition_max_pairs \= 19 then,
      call _fail "Unicode 17 primary-composition index audit mismatch"
    return

  _audit_partition: method = .void
    arg form = .int
    identity_marks = 0
    if form = 1 then bits = _nfd_bits
    else bits = _nfkd_bits
    do codepoint = 0 to 0x10FFFF
      if codepoint >= 0xD800 & codepoint <= 0xDFFF then iterate
      if codepoint >= 0xAC00 & codepoint < 0xAC00 + 11172 then iterate
      if _mapped(bits, codepoint) then iterate
      if <at..u8>(codepoint) _ccc \= 0 then identity_marks = identity_marks + 1
    end
    if form = 1 then do
      _nfd_identity_marks = identity_marks
      _nfd_identity_starters = 1112064 - 11172 - _nfd_raw.map_count() - identity_marks
      if _nfd_identity_starters \= 1097847 | _nfd_identity_marks \= 964 then,
        call _fail "prepared NFD scalar partition mismatch"
    end
    else do
      _nfkd_identity_marks = identity_marks
      _nfkd_identity_starters = 1112064 - 11172 - _nfkd_raw.map_count() - identity_marks
      if _nfkd_identity_starters \= 1094014 | _nfkd_identity_marks \= 964 then,
        call _fail "prepared NFKD scalar partition mismatch"
    end
    return

  /**
   * Prepare the NFD virtual alphabet. Identity scalars classify as themselves;
   * synthetic values use the high 11 bits as an exact SELECT kind and the low
   * 21 bits as a scalar, CCC, or mapping-record payload. Algorithmic Hangul is
   * a prepared kind so the common identity arm has no range predicate.
   */
  _prepare_nfd_symbols: method = .void
    prepared = .int
    call binresize _nfd_prepared, 0x110000 * 4
    do codepoint = 0 to 0x10FFFF
      if codepoint >= 0xD800 & codepoint <= 0xDFFF then,
        prepared = 7 <shl> 21
      else do
        ccc = <at..u8>(codepoint) _ccc
        if codepoint >= 0xAC00 & codepoint < 0xAC00 + 11172 then,
          prepared = (6 <shl> 21) <or> codepoint
        else if ccc = 0 then prepared = codepoint
        else prepared = (1 <shl> 21) <or> ccc
      end
      <at..u32>(codepoint * 4) _nfd_prepared = prepared
    end

    do mapping = 0 to _nfd_raw.map_count() - 1
      offset = mapping * 12
      source = <at..u32>(offset) _nfd_records
      structural_class = <at..u8>(offset + 10) _nfd_records
      prepared_kind = structural_class + 1
      prepared = (prepared_kind <shl> 21) <or> mapping
      <at..u32>(source * 4) _nfd_prepared = prepared
    end
    return

  _assemble_image: method = .void
    header_size = 192
    ccc_offset = header_size
    rank_offset = ccc_offset + 0x110000
    nfd_prepared_offset = rank_offset + 256
    nfd_bits_offset = nfd_prepared_offset + 0x110000 * 4
    nfkd_bits_offset = nfd_bits_offset + 0x22000
    nfd_pages_offset = nfkd_bits_offset + 0x22000
    nfkd_pages_offset = nfd_pages_offset + 0x1100 * 8
    nfd_records_offset = nfkd_pages_offset + 0x1100 * 8
    nfd_components_offset = nfd_records_offset + _nfd_raw.map_count() * 12
    nfkd_records_offset = nfd_components_offset + _nfd_component_count * 12
    nfkd_components_offset = nfkd_records_offset + _nfkd_raw.map_count() * 12
    composition_directory_offset = nfkd_components_offset + _nfkd_component_count * 12
    composition_pairs_offset = composition_directory_offset + _composition_directory_count * 12
    total_size = composition_pairs_offset + _composition_count * 8
    call binresize _image, total_size

    <at..u8>(0) _image = 67
    <at..u8>(1) _image = 85
    <at..u8>(2) _image = 68
    <at..u8>(3) _image = 68
    <at..u16>(4) _image = 3
    <at..u16>(6) _image = header_size
    <at..u16>(8) _image = 17
    <at..u16>(10) _image = 0
    <at..u16>(12) _image = 0
    <at..u16>(14) _image = 0
    <at..u32>(16) _image = ccc_offset
    <at..u32>(20) _image = 0x110000
    <at..u32>(24) _image = rank_offset
    <at..u32>(28) _image = 256
    <at..u32>(32) _image = nfd_bits_offset
    <at..u32>(36) _image = 0x22000
    <at..u32>(40) _image = nfkd_bits_offset
    <at..u32>(44) _image = 0x22000
    <at..u32>(48) _image = nfd_pages_offset
    <at..u32>(52) _image = 0x1100
    <at..u32>(56) _image = nfkd_pages_offset
    <at..u32>(60) _image = 0x1100
    <at..u32>(64) _image = nfd_records_offset
    <at..u32>(68) _image = _nfd_raw.map_count()
    <at..u32>(72) _image = nfd_components_offset
    <at..u32>(76) _image = _nfd_component_count
    <at..u32>(80) _image = nfkd_records_offset
    <at..u32>(84) _image = _nfkd_raw.map_count()
    <at..u32>(88) _image = nfkd_components_offset
    <at..u32>(92) _image = _nfkd_component_count
    <at..u32>(96) _image = _rank_count
    <at..u32>(100) _image = _nfd_utf8_bytes
    <at..u32>(104) _image = _nfkd_utf8_bytes
    <at..u32>(108) _image = _nfd_closed
    <at..u32>(112) _image = _nfd_open
    <at..u32>(116) _image = _nfd_marks
    <at..u32>(120) _image = _nfd_complex
    <at..u32>(124) _image = _nfkd_closed
    <at..u32>(128) _image = _nfkd_open
    <at..u32>(132) _image = _nfkd_marks
    <at..u32>(136) _image = _nfkd_complex
    <at..u32>(140) _image = _nfd_raw.value_count()
    <at..u32>(144) _image = _nfkd_raw.value_count()
    <at..u32>(148) _image = _nfd_component_count
    <at..u32>(152) _image = _nfkd_component_count
    <at..u32>(156) _image = nfd_prepared_offset
    <at..u32>(160) _image = composition_directory_offset
    <at..u32>(164) _image = _composition_directory_count
    <at..u32>(168) _image = composition_pairs_offset
    <at..u32>(172) _image = _composition_count
    <at..u32>(176) _image = _full_exclusion_count
    <at..u32>(180) _image = 12
    <at..u32>(184) _image = _composition_max_pairs
    <at..u32>(188) _image = 0x110000

    call bincopy _image, ccc_offset, _ccc, 0, <blen>(_ccc)
    call bincopy _image, rank_offset, _rank, 0, <blen>(_rank)
    call bincopy _image, nfd_prepared_offset, _nfd_prepared, 0, <blen>(_nfd_prepared)
    call bincopy _image, nfd_bits_offset, _nfd_bits, 0, <blen>(_nfd_bits)
    call bincopy _image, nfkd_bits_offset, _nfkd_bits, 0, <blen>(_nfkd_bits)
    call bincopy _image, nfd_pages_offset, _nfd_pages, 0, <blen>(_nfd_pages)
    call bincopy _image, nfkd_pages_offset, _nfkd_pages, 0, <blen>(_nfkd_pages)
    call bincopy _image, nfd_records_offset, _nfd_records, 0, <blen>(_nfd_records)
    call bincopy _image, nfd_components_offset, _nfd_components, 0, <blen>(_nfd_components)
    call bincopy _image, nfkd_records_offset, _nfkd_records, 0, <blen>(_nfkd_records)
    call bincopy _image, nfkd_components_offset, _nfkd_components, 0, <blen>(_nfkd_components)
    call bincopy _image, composition_directory_offset, _composition_directory, 0, <blen>(_composition_directory)
    call bincopy _image, composition_pairs_offset, _composition_pairs, 0, <blen>(_composition_pairs)
    return

/** Shared bytewise four-form engine over one validated prepared image. */
unicodednormalizer: class
  _image = .binary
  _ready = .int
  _status = .int
  _error = .string
  _form = .int
  _ccc_offset = .int
  _rank_offset = .int
  _rank_count = .int
  _prepared_offset = .int
  _prepared_count = .int
  _bits_offset = .int
  _pages_offset = .int
  _records_offset = .int
  _record_count = .int
  _components_offset = .int
  _component_count = .int
  _composition_directory_offset = .int
  _composition_directory_count = .int
  _composition_pairs_offset = .int
  _composition_pair_count = .int
  _decoded_codepoint = .int
  _decoded_length = .int
  _output = .binary
  _output_length = .int
  _output_capacity = .int
  _raw_start = .int
  _raw_length = .int
  _pending = .binary
  _pending_count = .int
  _pending_capacity = .int
  _pending_disordered = .int
  _pending_last_ccc = .int
  _bucket_flushes = .int
  _scratch = .binary
  _counts = .binary
  _next = .binary
  _compose = .int
  _compose_has_starter = .int
  _compose_starter = .int
  _compose_last_ccc = .int
  _compose_marks = .binary
  _compose_mark_count = .int
  _compose_mark_capacity = .int

  *: factory
    _ready = 0
    _status = 0
    _error = ""
    _form = 0
    _compose = 0
    _output_length = 0
    _output_capacity = 64
    call binresize _output, _output_capacity
    _raw_start = 0
    _raw_length = 0
    _pending_count = 0
    _pending_capacity = 64
    _pending_disordered = 0
    _pending_last_ccc = 0
    _bucket_flushes = 0
    call binresize _pending, _pending_capacity * 12
    _compose_has_starter = 0
    _compose_starter = 0
    _compose_last_ccc = 0
    _compose_mark_count = 0
    _compose_mark_capacity = 64
    call binresize _compose_marks, _compose_mark_capacity * 4
    return

  initialize: method = .void
    arg tables = .unicodedtables, form = .string
    _ready = 0
    _status = 0
    _error = ""
    if tables.status() \= 0 then do
      call _fail tables.error()
      return
    end
    form = upper(form)
    if form = "NFD" then _form = 1
    else if form = "NFKD" then _form = 2
    else if form = "NFC" then _form = 3
    else if form = "NFKC" then _form = 4
    else do
      call _fail "prepared normalization form must be NFD, NFKD, NFC, or NFKC"
      return
    end
    _compose = _form >= 3
    _image = tables.image()
    call _validate_image
    if _status = 0 then do
      call binresize _counts, _rank_count * 4
      call binresize _next, _rank_count * 4
      _ready = 1
    end
    return

  ready: method = .int
    return _ready

  status: method = .int
    return _status

  error: method = .string
    return _error

  form: method = .string
    if _form = 1 then return "NFD"
    if _form = 2 then return "NFKD"
    if _form = 3 then return "NFC"
    if _form = 4 then return "NFKC"
    return ""

  /** Number of non-monotone mark runs handled by the stable rank buckets. */
  bucket_flushes: method = .int
    return _bucket_flushes

  combining_class: method = .int
    arg codepoint = .int
    if _ready = 0 | unicode_d_is_scalar(codepoint) = 0 then return -1
    return <at..u8>(_ccc_offset + codepoint) _image

  /** Normalize validated text through the existing explicit binary surface. */
  normalize: method = .string
    arg expose source = .string
    source_length = .int
    result = .string
    if _ready = 0 then return ""
    if _form = 1 then do
      _status = 0
      _error = ""
      _pending_count = 0
      _pending_disordered = 0
      _pending_last_ccc = 0
      _bucket_flushes = 0
      result = ""
      source_length = 0
      assembler strlen source_length,source
      do source_index = 0 to source_length - 1
        codepoint = 0
        assembler strchar codepoint,source,source_index
        prepared = <at..u32>(_prepared_offset + codepoint * 4) _image
        prepared_kind = prepared <shr> 21
        prepared_payload = prepared <and> 0x1FFFFF

        /* Exact equality cases stay consecutive so RXC can retain dispatch. */
        select prepared_kind
          when 0 then do
            if _pending_count > 0 then call _flush_pending_string result
            assembler appendchar result,prepared
          end
          when 1 then call _enqueue_scalar_mark codepoint, prepared_payload
          when 2 then call _process_prepared_mapping_string prepared_payload, prepared_kind, result
          when 3 then call _process_prepared_mapping_string prepared_payload, prepared_kind, result
          when 4 then call _process_prepared_mapping_string prepared_payload, prepared_kind, result
          when 5 then call _process_prepared_mapping_string prepared_payload, prepared_kind, result
          when 6 then do
            if _pending_count > 0 then call _flush_pending_string result
            s_index = prepared_payload - 0xAC00
            l_index = s_index <idiv> 588
            remainder = s_index <mod> 588
            v_index = remainder <idiv> 28
            t_index = s_index <mod> 28
            jamo = 0x1100 + l_index
            assembler appendchar result,jamo
            jamo = 0x1161 + v_index
            assembler appendchar result,jamo
            if t_index \= 0 then do
              jamo = 0x11A7 + t_index
              assembler appendchar result,jamo
            end
          end
          when 7 then assembler signal "UNICODE_ERROR","invalid scalar in prepared NFD input"
          otherwise assembler signal "UNICODE_ERROR","invalid prepared NFD symbol kind"
        end
      end
      if _pending_count > 0 then call _flush_pending_string result
      return result
    end
    source_binary = source as .binary
    empty_string = ""
    source_length = <blen>(source_binary)
    call _begin source_length
    call _consume 2, empty_string, source_binary, source_length
    call _finish 2, empty_string, source_binary
    if _status \= 0 then return ""
    result = _output as .string
    return result

  /** Normalize a binary UTF-8 buffer and retain a binary result. */
  normalize_binary: method = .binary
    arg expose source = .binary
    empty = .binary
    if _ready = 0 then return empty
    empty_string = ""
    source_length = <blen>(source)
    call _begin source_length
    call _consume 2, empty_string, source, source_length
    call _finish 2, empty_string, source
    if _status \= 0 then return empty
    return _output

  /** Exact normalization predicate; C forms currently normalize and compare. */
  is_normalized: method = .int
    arg expose source = .string
    if _ready = 0 then return 0
    if _compose then do
      normalized = normalize(source)
      if _status \= 0 then return 0
      return normalized == source
    end
    source_binary = source as .binary
    empty_string = ""
    source_length = <blen>(source_binary)
    _status = 0
    _error = ""
    return _quick_check(2, empty_string, source_binary, source_length)

  /** Exact binary normalization predicate. */
  is_normalized_binary: method = .int
    arg expose source = .binary
    if _ready = 0 then return 0
    if _compose then do
      normalized = normalize_binary(source)
      if _status \= 0 then return 0
      return bincompare(normalized, source) = 0
    end
    empty_string = ""
    _status = 0
    _error = ""
    return _quick_check(2, empty_string, source, <blen>(source))

  /** Begin an NFD scan whose classifications are supplied by generated code. */
  lexer_begin: method = .void
    arg source_length = .int
    if _ready = 0 | _form \= 1 then do
      assembler signal "INVALID_ARGUMENTS","generated scanner requires a ready NFD normalizer"
    end
    call _begin source_length
    return

  /** Accept a generated run of identity starters. */
  lexer_raw: method = .void
    arg expose source = .binary, source_offset = .int, source_length = .int
    empty_string = ""
    call _queue_raw source_offset, source_length, 2, empty_string, source
    return

  /** Accept one generated identity nonstarter with its prepared CCC. */
  lexer_mark: method = .void
    arg expose source = .binary, source_offset = .int, source_length = .int, ccc = .int
    empty_string = ""
    call _enqueue_source_mark 0, ccc, source_offset, source_length, 2, empty_string, source
    return

  /** Accept one generated prepared-mapping record. */
  lexer_mapping: method = .void
    arg expose source = .binary, mapping = .int
    empty_string = ""
    call _process_mapping mapping, 2, empty_string, source
    return

  /** Accept one generated Hangul syllable match. */
  lexer_hangul: method = .void
    arg expose source = .binary, source_offset = .int
    first = <at..u8>(source_offset) source
    second = <at..u8>(source_offset + 1) source
    third = <at..u8>(source_offset + 2) source
    codepoint = ((first <and> 0x0F) <shl> 12) <or>,
                ((second <and> 0x3F) <shl> 6) <or>,
                (third <and> 0x3F)
    empty_string = ""
    call _emit_hangul codepoint, 2, empty_string, source
    return

  /** Finish a generated NFD scan and return its binary result. */
  lexer_finish: method = .binary
    arg expose source = .binary
    empty_string = ""
    call _finish 2, empty_string, source
    if _status \= 0 then assembler signal "UNICODE_ERROR",_error
    return _output

  _fail: method = .void
    arg message = .string
    if _status \= 0 then return
    _status = 1
    _error = message
    return

  _validate_image: method = .void
    offset = .int
    first = .int
    count = .int
    image_length = <blen>(_image)
    if image_length < 192 then do
      call _fail "prepared normalization image is shorter than its header"
      return
    end
    if <at..u8>(0) _image \= 67 | <at..u8>(1) _image \= 85 |,
       <at..u8>(2) _image \= 68 | <at..u8>(3) _image \= 68 |,
       <at..u16>(4) _image \= 3 | <at..u16>(6) _image \= 192 then do
      call _fail "invalid prepared normalization image header"
      return
    end
    if <at..u16>(8) _image \= 17 | <at..u16>(10) _image \= 0 |,
       <at..u16>(12) _image \= 0 then do
      call _fail "unsupported Unicode version in prepared normalization image"
      return
    end
    _ccc_offset = <at..u32>(16) _image
    _rank_offset = <at..u32>(24) _image
    _rank_count = <at..u32>(96) _image
    _prepared_offset = <at..u32>(156) _image
    _prepared_count = <at..u32>(188) _image
    if _form = 1 | _form = 3 then do
      _bits_offset = <at..u32>(32) _image
      _pages_offset = <at..u32>(48) _image
      _records_offset = <at..u32>(64) _image
      _record_count = <at..u32>(68) _image
      _components_offset = <at..u32>(72) _image
      _component_count = <at..u32>(76) _image
    end
    else do
      _bits_offset = <at..u32>(40) _image
      _pages_offset = <at..u32>(56) _image
      _records_offset = <at..u32>(80) _image
      _record_count = <at..u32>(84) _image
      _components_offset = <at..u32>(88) _image
      _component_count = <at..u32>(92) _image
    end
    _composition_directory_offset = <at..u32>(160) _image
    _composition_directory_count = <at..u32>(164) _image
    _composition_pairs_offset = <at..u32>(168) _image
    _composition_pair_count = <at..u32>(172) _image
    if _ccc_offset \= 192 | <at..u32>(20) _image \= 0x110000 |,
       _rank_offset \= _ccc_offset + 0x110000 | <at..u32>(28) _image \= 256 |,
       _rank_count \= 55 | _prepared_count \= 0x110000 |,
       _prepared_offset \= _rank_offset + 256 then do
      call _fail "invalid CCC/rank sections in prepared normalization image"
      return
    end
    if _prepared_offset + _prepared_count * 4 > image_length then do
      call _fail "prepared-symbol section exceeds normalization image"
      return
    end
    if (_form = 1 | _form = 3) & (_record_count \= 2081 | _component_count \= 3450) then,
      call _fail "invalid NFD counts in prepared D image"
    else if (_form = 2 | _form = 4) & (_record_count \= 5914 | _component_count \= 9193) then,
      call _fail "invalid NFKD counts in prepared D image"
    if _status \= 0 then return
    if _components_offset + _component_count * 12 > image_length then,
      call _fail "prepared D component section exceeds image length"
    else if _composition_directory_count \= 391 | _composition_pair_count \= 961 |,
            <at..u32>(176) _image \= 1120 | <at..u32>(180) _image \= 12 |,
            <at..u32>(184) _image \= 19 |,
            _composition_directory_offset + _composition_directory_count * 12 > image_length |,
            _composition_pairs_offset + _composition_pair_count * 8 > image_length then,
      call _fail "invalid primary-composition sections in prepared normalization image"

    previous = -1
    do mapping = 0 to _record_count - 1 while _status = 0
      offset = _records_offset + mapping * 12
      source = <at..u32>(offset) _image
      first = <at..u32>(offset + 4) _image
      count = <at..u16>(offset + 8) _image
      structural_class = <at..u8>(offset + 10) _image
      closed_count = <at..u8>(offset + 11) _image
      if unicode_d_is_scalar(source) = 0 | source <= previous then,
        call _fail "prepared D records are not strictly ordered"
      else if count = 0 | first + count > _component_count then,
        call _fail "prepared D component span is invalid"
      else if structural_class < 1 | structural_class > 4 then,
        call _fail "prepared D structural class is invalid"
      else if (structural_class = 1 & closed_count \= count) |,
              (structural_class = 2 & (closed_count = 0 | closed_count >= count)) |,
              (structural_class = 3 & closed_count \= 0) |,
              closed_count > count then,
        call _fail "prepared D closed-prefix boundary is invalid"
      if _status = 0 & (_form = 1 | _form = 3) then do
        prepared = <at..u32>(_prepared_offset + source * 4) _image
        if (prepared <shr> 21) \= structural_class + 1 |,
           (prepared <and> 0x1FFFFF) \= mapping then,
          call _fail "prepared NFD symbol does not match its mapping record"
      end
      previous = source
    end
    previous = -1
    expected_first = 0
    do directory = 0 to _composition_directory_count - 1 while _status = 0
      offset = _composition_directory_offset + directory * 12
      starter = <at..u32>(offset) _image
      first = <at..u32>(offset + 4) _image
      count = <at..u16>(offset + 8) _image
      if unicode_d_is_scalar(starter) = 0 | starter <= previous | count = 0 |,
         first \= expected_first | first + count > _composition_pair_count then,
        call _fail "invalid primary-composition directory record"
      previous_second = -1
      do pair = first to first + count - 1 while _status = 0
        pair_offset = _composition_pairs_offset + pair * 8
        second = <at..u32>(pair_offset) _image
        composite = <at..u32>(pair_offset + 4) _image
        if unicode_d_is_scalar(second) = 0 |,
           unicode_d_is_scalar(composite) = 0 | second <= previous_second then,
          call _fail "invalid primary-composition pair record"
        previous_second = second
      end
      previous = starter
      expected_first = first + count
    end
    if _status = 0 & expected_first \= _composition_pair_count then,
      call _fail "primary-composition directory does not cover every pair"
    return

  _begin: method = .void
    arg source_length = .int
    _status = 0
    _error = ""
    _output_length = 0
    if source_length > _output_capacity then do
      _output_capacity = source_length
      if _output_capacity < 64 then _output_capacity = 64
    end
    call binresize _output, _output_capacity
    _raw_start = 0
    _raw_length = 0
    _pending_count = 0
    _pending_disordered = 0
    _pending_last_ccc = 0
    _bucket_flushes = 0
    _compose_has_starter = 0
    _compose_starter = 0
    _compose_last_ccc = 0
    _compose_mark_count = 0
    return

  _consume: method = .void
    arg source_kind = .int, expose source_string = .string, expose source_binary = .binary, source_length = .int
    position = 0
    do while position < source_length & _status = 0
      byte = _source_byte(source_kind, source_string, source_binary, position)
      if byte <= 0x7F then do
        if _compose then do
          call _process_scalar byte, position, 1, source_kind, source_string, source_binary
          position = position + 1
        end
        else do
          start = position
          position = position + 1
          do while position < source_length
            byte = _source_byte(source_kind, source_string, source_binary, position)
            if byte > 0x7F then leave
            position = position + 1
          end
          call _queue_raw start, position - start, source_kind, source_string, source_binary
        end
      end
      else do
        call _decode source_kind, source_string, source_binary, position, source_length
        if _status = 0 then do
          call _process_scalar _decoded_codepoint, position, _decoded_length, source_kind, source_string, source_binary
          position = position + _decoded_length
        end
      end
    end
    return

  _source_byte: method = .int
    arg source_kind = .int, expose source_string = .string, expose source_binary = .binary, offset = .int
    return <at..u8>(offset) source_binary

  _decode: method = .void
    arg source_kind = .int, expose source_string = .string, expose source_binary = .binary, position = .int, source_length = .int
    second = .int
    third = .int
    first = _source_byte(source_kind, source_string, source_binary, position)
    if first >= 0xC2 & first <= 0xDF then do
      if position + 2 > source_length then do
        call _fail "truncated UTF-8 sequence"
        return
      end
      second = _source_byte(source_kind, source_string, source_binary, position + 1)
      if second < 0x80 | second > 0xBF then do
        call _fail "invalid UTF-8 continuation byte"
        return
      end
      _decoded_codepoint = ((first <and> 0x1F) <shl> 6) <or> (second <and> 0x3F)
      _decoded_length = 2
      return
    end
    if first >= 0xE0 & first <= 0xEF then do
      if position + 3 > source_length then do
        call _fail "truncated UTF-8 sequence"
        return
      end
      second = _source_byte(source_kind, source_string, source_binary, position + 1)
      third = _source_byte(source_kind, source_string, source_binary, position + 2)
      if third < 0x80 | third > 0xBF |,
         (first = 0xE0 & (second < 0xA0 | second > 0xBF)) |,
         (first = 0xED & (second < 0x80 | second > 0x9F)) |,
         (first \= 0xE0 & first \= 0xED & (second < 0x80 | second > 0xBF)) then do
        call _fail "invalid UTF-8 three-byte sequence"
        return
      end
      _decoded_codepoint = ((first <and> 0x0F) <shl> 12) <or>,
                           ((second <and> 0x3F) <shl> 6) <or>,
                           (third <and> 0x3F)
      _decoded_length = 3
      return
    end
    if first >= 0xF0 & first <= 0xF4 then do
      if position + 4 > source_length then do
        call _fail "truncated UTF-8 sequence"
        return
      end
      second = _source_byte(source_kind, source_string, source_binary, position + 1)
      third = _source_byte(source_kind, source_string, source_binary, position + 2)
      fourth = _source_byte(source_kind, source_string, source_binary, position + 3)
      if third < 0x80 | third > 0xBF | fourth < 0x80 | fourth > 0xBF |,
         (first = 0xF0 & (second < 0x90 | second > 0xBF)) |,
         (first = 0xF4 & (second < 0x80 | second > 0x8F)) |,
         (first \= 0xF0 & first \= 0xF4 & (second < 0x80 | second > 0xBF)) then do
        call _fail "invalid UTF-8 four-byte sequence"
        return
      end
      _decoded_codepoint = ((first <and> 0x07) <shl> 18) <or>,
                           ((second <and> 0x3F) <shl> 12) <or>,
                           ((third <and> 0x3F) <shl> 6) <or>,
                           (fourth <and> 0x3F)
      _decoded_length = 4
      return
    end
    call _fail "invalid UTF-8 leading byte"
    return

  _process_scalar: method = .void
    arg codepoint = .int, source_offset = .int, source_length = .int, source_kind = .int, expose source_string = .string, expose source_binary = .binary
    if codepoint >= 0xAC00 & codepoint < 0xAC00 + 11172 then do
      if _compose then do
        call _flush_segment source_kind, source_string, source_binary
        call _compose_scalar codepoint, 0
      end
      else call _emit_hangul codepoint, source_kind, source_string, source_binary
      return
    end
    if _mapped(codepoint) then do
      mapping = _find_mapping(codepoint)
      if mapping < 0 then call _fail "prepared D mapping bit has no record"
      else call _process_mapping mapping, source_kind, source_string, source_binary
      return
    end
    ccc = <at..u8>(_ccc_offset + codepoint) _image
    if ccc = 0 then do
      if _compose then do
        call _flush_segment source_kind, source_string, source_binary
        call _compose_scalar codepoint, 0
      end
      else call _queue_raw source_offset, source_length, source_kind, source_string, source_binary
    end
    else call _enqueue_source_mark codepoint, ccc, source_offset, source_length, source_kind, source_string, source_binary
    return

  _mapped: method = .int
    arg codepoint = .int
    byte = <at..u8>(_bits_offset + (codepoint <idiv> 8)) _image
    mask = 1 <shl> (codepoint <mod> 8)
    return (byte <and> mask) \= 0

  _find_mapping: method = .int
    arg codepoint = .int
    page_offset = _pages_offset + (codepoint <idiv> 256) * 8
    first = <at..u32>(page_offset) _image
    count = <at..u16>(page_offset + 4) _image
    low = first
    high = first + count - 1
    do while low <= high
      middle = (low + high) <idiv> 2
      source = <at..u32>(_records_offset + middle * 12) _image
      if source = codepoint then return middle
      if source < codepoint then low = middle + 1
      else high = middle - 1
    end
    return -1

  /** Queue one identity nonstarter for the scalar prepared executor. */
  _enqueue_scalar_mark: method = .void
    arg codepoint = .int, ccc = .int
    if _pending_count >= _pending_capacity then do
      _pending_capacity = _pending_capacity * 2
      call binresize _pending, _pending_capacity * 12
    end
    offset = _pending_count * 12
    <at..u32>(offset) _pending = codepoint
    <at..u8>(offset + 4) _pending = ccc
    if _pending_count > 0 & ccc < _pending_last_ccc then,
      _pending_disordered = 1
    _pending_last_ccc = ccc
    _pending_count = _pending_count + 1
    return

  /** Queue one already prepared mapping component without byte materialization. */
  _enqueue_prepared_mark: method = .void
    arg component = .int
    if _pending_count >= _pending_capacity then do
      _pending_capacity = _pending_capacity * 2
      call binresize _pending, _pending_capacity * 12
    end
    target = _pending_count * 12
    codepoint = <at..u32>(component) _image
    ccc = <at..u8>(component + 4) _image
    <at..u32>(target) _pending = codepoint
    <at..u8>(target + 4) _pending = ccc
    if _pending_count > 0 & ccc < _pending_last_ccc then,
      _pending_disordered = 1
    _pending_last_ccc = ccc
    _pending_count = _pending_count + 1
    return

  /** Append and clear the one open canonical-order segment. */
  _flush_pending_string: method = .void
    arg expose result = .string
    if _pending_count = 0 then return
    disordered = _pending_disordered
    if disordered then call _sort_pending
    do i = 0 to _pending_count - 1
      offset = i * 12
      if disordered then codepoint = <at..u32>(offset) _scratch
      else codepoint = <at..u32>(offset) _pending
      assembler appendchar result,codepoint
    end
    _pending_count = 0
    _pending_disordered = 0
    _pending_last_ccc = 0
    return

  /** Execute one prepared mapping class over its closed/open boundaries. */
  _process_prepared_mapping_string: method = .void
    arg mapping = .int, prepared_kind = .int, expose result = .string
    i = .int
    component = .int
    codepoint = .int
    offset = _records_offset + mapping * 12
    first = <at..u32>(offset + 4) _image
    count = <at..u16>(offset + 8) _image
    closed_count = <at..u8>(offset + 11) _image

    select prepared_kind
      when 2 then do
        if _pending_count > 0 then call _flush_pending_string result
        do i = 0 to count - 1
          component = _components_offset + (first + i) * 12
          codepoint = <at..u32>(component) _image
          assembler appendchar result,codepoint
        end
      end
      when 3 then do
        if _pending_count > 0 then call _flush_pending_string result
        do i = 0 to closed_count - 1
          component = _components_offset + (first + i) * 12
          codepoint = <at..u32>(component) _image
          assembler appendchar result,codepoint
        end
        do i = closed_count to count - 1
          component = _components_offset + (first + i) * 12
          call _enqueue_prepared_mark component
        end
      end
      when 4 then do
        do i = 0 to count - 1
          component = _components_offset + (first + i) * 12
          call _enqueue_prepared_mark component
        end
      end
      when 5 then do
        do i = 0 to count - 1
          component = _components_offset + (first + i) * 12
          codepoint = <at..u32>(component) _image
          ccc = <at..u8>(component + 4) _image
          if ccc = 0 then do
            if _pending_count > 0 then call _flush_pending_string result
            assembler appendchar result,codepoint
          end
          else call _enqueue_prepared_mark component
        end
      end
      otherwise assembler signal "UNICODE_ERROR","invalid prepared NFD mapping class"
    end
    return

  _process_mapping: method = .void
    arg mapping = .int, source_kind = .int, expose source_string = .string, expose source_binary = .binary
    offset = _records_offset + mapping * 12
    first = <at..u32>(offset + 4) _image
    count = <at..u16>(offset + 8) _image
    do i = 0 to count - 1 while _status = 0
      component = _components_offset + (first + i) * 12
      codepoint = <at..u32>(component) _image
      ccc = <at..u8>(component + 4) _image
      if ccc = 0 then do
        call _flush_segment source_kind, source_string, source_binary
        if _compose then call _compose_scalar codepoint, 0
        else call _append_component component
      end
      else call _enqueue_component component
    end
    return

  _emit_hangul: method = .void
    arg codepoint = .int, source_kind = .int, expose source_string = .string, expose source_binary = .binary
    call _flush_segment source_kind, source_string, source_binary
    s_index = codepoint - 0xAC00
    l_index = s_index <idiv> 588
    remainder = s_index <mod> 588
    v_index = remainder <idiv> 28
    t_index = s_index <mod> 28
    call _append_codepoint 0x1100 + l_index
    call _append_codepoint 0x1161 + v_index
    if t_index \= 0 then call _append_codepoint 0x11A7 + t_index
    return

  _queue_raw: method = .void
    arg source_offset = .int, source_length = .int, source_kind = .int, expose source_string = .string, expose source_binary = .binary
    if _pending_count > 0 then call _flush_segment source_kind, source_string, source_binary
    if _raw_length = 0 then do
      _raw_start = source_offset
      _raw_length = source_length
    end
    else if _raw_start + _raw_length = source_offset then,
      _raw_length = _raw_length + source_length
    else do
      call _flush_raw source_kind, source_string, source_binary
      _raw_start = source_offset
      _raw_length = source_length
    end
    return

  _enqueue_source_mark: method = .void
    arg codepoint = .int, ccc = .int, source_offset = .int, source_length = .int, source_kind = .int, expose source_string = .string, expose source_binary = .binary
    call _ensure_pending
    offset = _pending_count * 12
    <at..u32>(offset) _pending = codepoint
    <at..u8>(offset + 4) _pending = ccc
    <at..u8>(offset + 5) _pending = source_length
    payload_offset = offset + 6
    call bincopy _pending, payload_offset, source_binary, source_offset, source_length
    call _note_pending ccc
    return

  _enqueue_component: method = .void
    arg component = .int
    call _ensure_pending
    offset = _pending_count * 12
    codepoint = <at..u32>(component) _image
    ccc = <at..u8>(component + 4) _image
    length = <at..u8>(component + 5) _image
    <at..u32>(offset) _pending = codepoint
    <at..u8>(offset + 4) _pending = ccc
    <at..u8>(offset + 5) _pending = length
    call bincopy _pending, offset + 6, _image, component + 6, length
    call _note_pending ccc
    return

  _ensure_pending: method = .void
    if _pending_count >= _pending_capacity then do
      _pending_capacity = _pending_capacity * 2
      call binresize _pending, _pending_capacity * 12
    end
    return

  _note_pending: method = .void
    arg ccc = .int
    if _pending_count > 0 & ccc < _pending_last_ccc then,
      _pending_disordered = 1
    _pending_last_ccc = ccc
    _pending_count = _pending_count + 1
    return

  _flush_segment: method = .void
    arg source_kind = .int, expose source_string = .string, expose source_binary = .binary
    call _flush_raw source_kind, source_string, source_binary
    call _flush_pending
    return

  _flush_raw: method = .void
    arg source_kind = .int, expose source_string = .string, expose source_binary = .binary
    if _raw_length = 0 | _status \= 0 then return
    call _ensure_output _raw_length
    call bincopy _output, _output_length, source_binary, _raw_start, _raw_length
    _output_length = _output_length + _raw_length
    _raw_length = 0
    return

  _flush_pending: method = .void
    codepoint = .int
    ccc = .int
    span_length = .int
    if _pending_count = 0 | _status \= 0 then return
    if _pending_disordered then call _sort_pending
    do i = 0 to _pending_count - 1 while _status = 0
      offset = i * 12
      if _pending_disordered then do
        codepoint = <at..u32>(offset) _scratch
        ccc = <at..u8>(offset + 4) _scratch
        span_length = <at..u8>(offset + 5) _scratch
        if _compose then call _compose_scalar codepoint, ccc
        else do
          call _ensure_output span_length
          call bincopy _output, _output_length, _scratch, offset + 6, span_length
          _output_length = _output_length + span_length
        end
      end
      else do
        codepoint = <at..u32>(offset) _pending
        ccc = <at..u8>(offset + 4) _pending
        span_length = <at..u8>(offset + 5) _pending
        if _compose then call _compose_scalar codepoint, ccc
        else do
          call _ensure_output span_length
          call bincopy _output, _output_length, _pending, offset + 6, span_length
          _output_length = _output_length + span_length
        end
      end
    end
    _pending_count = 0
    _pending_disordered = 0
    _pending_last_ccc = 0
    return

  _sort_pending: method = .void
    rank = .int
    offset = .int
    i = .int
    ccc = .int
    _bucket_flushes = _bucket_flushes + 1
    call binresize _scratch, _pending_count * 12
    call binfill _counts, 0
    do i = 0 to _pending_count - 1
      ccc = <at..u8>(i * 12 + 4) _pending
      rank = <at..u8>(_rank_offset + ccc) _image
      offset = rank * 4
      <at..u32>(offset) _counts = <at..u32>(offset) _counts + 1
    end
    total = 0
    do rank = 0 to _rank_count - 1
      offset = rank * 4
      <at..u32>(offset) _next = total
      total = total + <at..u32>(offset) _counts
    end
    do i = 0 to _pending_count - 1
      source_offset = i * 12
      ccc = <at..u8>(source_offset + 4) _pending
      rank = <at..u8>(_rank_offset + ccc) _image
      rank_offset = rank * 4
      target = <at..u32>(rank_offset) _next
      call bincopy _scratch, target * 12, _pending, source_offset, 12
      <at..u32>(rank_offset) _next = target + 1
    end
    return

  _append_component: method = .void
    arg component = .int
    length = <at..u8>(component + 5) _image
    call _ensure_output length
    call bincopy _output, _output_length, _image, component + 6, length
    _output_length = _output_length + length
    return

  /** Consume one canonically ordered scalar using the UAX #15 D117 state. */
  _compose_scalar: method = .void
    arg codepoint = .int, ccc = .int
    if _compose_has_starter = 0 then do
      if ccc = 0 then do
        _compose_has_starter = 1
        _compose_starter = codepoint
        _compose_last_ccc = 0
      end
      else call _append_codepoint codepoint
      return
    end

    composite = -1
    if _compose_last_ccc < ccc | _compose_last_ccc = 0 then,
      composite = _compose_pair(_compose_starter, codepoint)
    if composite >= 0 then do
      _compose_starter = composite
      return
    end

    if ccc = 0 then do
      call _flush_composer
      _compose_has_starter = 1
      _compose_starter = codepoint
      _compose_last_ccc = 0
      return
    end
    call _ensure_compose_marks
    <at..u32>(_compose_mark_count * 4) _compose_marks = codepoint
    _compose_mark_count = _compose_mark_count + 1
    _compose_last_ccc = ccc
    return

  /** Hangul arithmetic followed by exact non-Hangul Primary Composite lookup. */
  _compose_pair: method = .int
    arg starter = .int, candidate = .int
    middle = .int
    value = .int
    if starter >= 0x1100 & starter <= 0x1112 &,
       candidate >= 0x1161 & candidate <= 0x1175 then,
      return 0xAC00 + (starter - 0x1100) * 588 + (candidate - 0x1161) * 28
    if starter >= 0xAC00 & starter < 0xAC00 + 11172 &,
       (starter - 0xAC00) <mod> 28 = 0 &,
       candidate >= 0x11A8 & candidate <= 0x11C2 then,
      return starter + candidate - 0x11A7

    low = 0
    high = _composition_directory_count - 1
    directory = -1
    do while low <= high
      middle = (low + high) <idiv> 2
      value = <at..u32>(_composition_directory_offset + middle * 12) _image
      if value = starter then do
        directory = middle
        leave
      end
      if value < starter then low = middle + 1
      else high = middle - 1
    end
    if directory < 0 then return -1

    directory_offset = _composition_directory_offset + directory * 12
    first = <at..u32>(directory_offset + 4) _image
    count = <at..u16>(directory_offset + 8) _image
    low = first
    high = first + count - 1
    do while low <= high
      middle = (low + high) <idiv> 2
      pair_offset = _composition_pairs_offset + middle * 8
      value = <at..u32>(pair_offset) _image
      if value = candidate then return <at..u32>(pair_offset + 4) _image
      if value < candidate then low = middle + 1
      else high = middle - 1
    end
    return -1

  _ensure_compose_marks: method = .void
    if _compose_mark_count < _compose_mark_capacity then return
    _compose_mark_capacity = _compose_mark_capacity * 2
    call binresize _compose_marks, _compose_mark_capacity * 4
    return

  _flush_composer: method = .void
    if _compose_has_starter = 0 then return
    call _append_codepoint _compose_starter
    do i = 0 to _compose_mark_count - 1
      call _append_codepoint <at..u32>(i * 4) _compose_marks
    end
    _compose_has_starter = 0
    _compose_starter = 0
    _compose_last_ccc = 0
    _compose_mark_count = 0
    return

  _append_codepoint: method = .void
    arg codepoint = .int
    if codepoint <= 0x7F then length = 1
    else if codepoint <= 0x7FF then length = 2
    else if codepoint <= 0xFFFF then length = 3
    else length = 4
    call _ensure_output length
    offset = _output_length
    if length = 1 then <at..u8>(offset) _output = codepoint
    else if length = 2 then do
      <at..u8>(offset) _output = 0xC0 <or> (codepoint <shr> 6)
      <at..u8>(offset + 1) _output = 0x80 <or> (codepoint <and> 0x3F)
    end
    else if length = 3 then do
      <at..u8>(offset) _output = 0xE0 <or> (codepoint <shr> 12)
      <at..u8>(offset + 1) _output = 0x80 <or> ((codepoint <shr> 6) <and> 0x3F)
      <at..u8>(offset + 2) _output = 0x80 <or> (codepoint <and> 0x3F)
    end
    else do
      <at..u8>(offset) _output = 0xF0 <or> (codepoint <shr> 18)
      <at..u8>(offset + 1) _output = 0x80 <or> ((codepoint <shr> 12) <and> 0x3F)
      <at..u8>(offset + 2) _output = 0x80 <or> ((codepoint <shr> 6) <and> 0x3F)
      <at..u8>(offset + 3) _output = 0x80 <or> (codepoint <and> 0x3F)
    end
    _output_length = _output_length + length
    return

  _ensure_output: method = .void
    arg extra = .int
    required = _output_length + extra
    if required <= _output_capacity then return
    do while _output_capacity < required
      _output_capacity = _output_capacity * 2
    end
    call binresize _output, _output_capacity
    return

  _finish: method = .void
    arg source_kind = .int, expose source_string = .string, expose source_binary = .binary
    if _status \= 0 then return
    call _flush_segment source_kind, source_string, source_binary
    if _status = 0 & _compose then call _flush_composer
    if _status = 0 then call binresize _output, _output_length
    return

  _quick_check: method = .int
    arg source_kind = .int, expose source_string = .string, expose source_binary = .binary, source_length = .int
    previous_ccc = 0
    position = 0
    do while position < source_length & _status = 0
      byte = _source_byte(source_kind, source_string, source_binary, position)
      if byte <= 0x7F then do
        previous_ccc = 0
        position = position + 1
      end
      else do
        call _decode source_kind, source_string, source_binary, position, source_length
        if _status \= 0 then return 0
        codepoint = _decoded_codepoint
        if (codepoint >= 0xAC00 & codepoint < 0xAC00 + 11172) |,
           _mapped(codepoint) then return 0
        ccc = <at..u8>(_ccc_offset + codepoint) _image
        if ccc = 0 then previous_ccc = 0
        else do
          if previous_ccc > ccc then return 0
          previous_ccc = ccc
        end
        position = position + _decoded_length
      end
    end
    return _status = 0
