/*
 * cREXX License (MIT)
 *
 * Experimental Unicode 17.0.0 prepared D-form tables and UTF-8 normalizer.
 * The image is portable and byte-addressed.  Recursive decomposition and
 * canonical ordering of each scalar mapping happen only while generating it.
 */

options levelb

namespace unicode_d expose unicodedtables unicodednormalizer unicode_d_compile unicode_d_new
import rxfnsb
import rxhash
import unicode_gennorm2
import unicode_data

/** Compile canonical and compatibility UCD ASTs into one prepared image. */
unicode_d_compile: procedure = .unicodedtables
  arg ucd = .unicodeucdresult
  tables = .unicodedtables()
  call tables.compile(ucd)
  return tables

/** Construct one NFD or NFKD normalizer over a prepared image. */
unicode_d_new: procedure = .unicodednormalizer
  arg tables = .unicodedtables, form = .string
  normalizer = .unicodednormalizer()
  call normalizer.initialize(tables, form)
  return normalizer

unicode_d_is_scalar: procedure = .int
  arg codepoint = .int
  if codepoint < 0 | codepoint > 0x10FFFF then return 0
  if codepoint >= 0xD800 & codepoint <= 0xDFFF then return 0
  return 1

/** Compact temporary index over the direct decomposition graph. */
unicodedrawmappings: class
  _image = .binary
  _status = .int
  _error = .string
  _map_count = .int
  _value_count = .int
  _map_offset = .int
  _values_offset = .int

  *: factory
    _status = 0
    _error = ""
    _map_count = 0
    _value_count = 0
    _map_offset = 0x1100 * 8
    _values_offset = _map_offset
    return

  compile: method = .void
    arg ast = .unicodegennorm2ast
    _status = 0
    _error = ""
    _map_count = ast.two_way_mappings() + ast.one_way_mappings()
    _value_count = ast.mapping_values()
    _map_offset = 0x1100 * 8
    _values_offset = _map_offset + _map_count * 12
    call binresize _image, _values_offset + _value_count * 4
    if ast.version() \= "17.0.0" | _map_count <= 0 | _value_count <= 0 then do
      call _fail "invalid direct Unicode decomposition AST"
      return
    end

    map_index = 0
    value_index = 0
    previous = -1
    do i = 0 to ast.record_count() - 1 while _status = 0
      record = ast.record_at(i)
      if record.kind() = "mapping_one_way" |,
         record.kind() = "mapping_two_way" then do
        source = record.first()
        if unicode_d_is_scalar(source) = 0 | source <= previous then do
          call _fail "direct Unicode mappings are not strictly ordered"
          iterate
        end
        if record.value_count() <= 0 then do
          call _fail "direct Unicode mapping is empty"
          iterate
        end

        page = source <idiv> 256
        page_offset = page * 8
        page_count = <at..u16>(page_offset + 4) _image
        if page_count = 0 then <at..u32>(page_offset) _image = map_index
        <at..u16>(page_offset + 4) _image = page_count + 1

        offset = _map_offset + map_index * 12
        <at..u32>(offset) _image = source
        <at..u32>(offset + 4) _image = value_index
        <at..u16>(offset + 8) _image = record.value_count()
        <at..u16>(offset + 10) _image = 0
        do j = 0 to record.value_count() - 1 while _status = 0
          value = record.value_at(j)
          if unicode_d_is_scalar(value) = 0 then call _fail "direct Unicode mapping contains a non-scalar value"
          else do
            <at..u32>(_values_offset + value_index * 4) _image = value
            value_index = value_index + 1
          end
        end
        previous = source
        map_index = map_index + 1
      end
    end
    if _status = 0 & (map_index \= _map_count | value_index \= _value_count) then,
      call _fail "direct Unicode mapping count mismatch"
    return

  status: method = .int
    return _status

  error: method = .string
    return _error

  map_count: method = .int
    return _map_count

  value_count: method = .int
    return _value_count

  source_at: method = .int
    arg index = .int
    return <at..u32>(_map_offset + index * 12) _image

  mapping_value_count: method = .int
    arg mapping = .int
    return <at..u16>(_map_offset + mapping * 12 + 8) _image

  mapping_value_at: method = .int
    arg mapping = .int, index = .int
    first = <at..u32>(_map_offset + mapping * 12 + 4) _image
    return <at..u32>(_values_offset + (first + index) * 4) _image

  find: method = .int
    arg codepoint = .int
    page_offset = (codepoint <idiv> 256) * 8
    first = <at..u32>(page_offset) _image
    count = <at..u16>(page_offset + 4) _image
    low = first
    high = first + count - 1
    do while low <= high
      middle = (low + high) <idiv> 2
      source = <at..u32>(_map_offset + middle * 12) _image
      if source = codepoint then return middle
      if source < codepoint then low = middle + 1
      else high = middle - 1
    end
    return -1

  _fail: method = .void
    arg message = .string
    if _status \= 0 then return
    _status = 1
    _error = message
    return

/** Versioned portable prepared NFD/NFKD image. */
unicodedtables: class
  _image = .binary
  _status = .int
  _error = .string
  _ccc = .binary
  _ccc_seen = .binary
  _rank = .binary
  _rank_count = .int
  _nfd_raw = .unicodedrawmappings
  _nfkd_raw = .unicodedrawmappings
  _temp = .binary
  _temp_count = .int
  _temp_capacity = .int
  _path = .binary
  _nfd_bits = .binary
  _nfkd_bits = .binary
  _nfd_pages = .binary
  _nfkd_pages = .binary
  _nfd_records = .binary
  _nfkd_records = .binary
  _nfd_components = .binary
  _nfkd_components = .binary
  _nfd_component_count = .int
  _nfkd_component_count = .int
  _nfd_utf8_bytes = .int
  _nfkd_utf8_bytes = .int
  _nfd_closed = .int
  _nfd_open = .int
  _nfd_marks = .int
  _nfd_complex = .int
  _nfkd_closed = .int
  _nfkd_open = .int
  _nfkd_marks = .int
  _nfkd_complex = .int
  _nfd_identity_starters = .int
  _nfd_identity_marks = .int
  _nfkd_identity_starters = .int
  _nfkd_identity_marks = .int

  *: factory
    _status = 0
    _error = ""
    _rank_count = 0
    _temp_count = 0
    _temp_capacity = 32
    call binresize _temp, _temp_capacity * 4
    call binresize _path, 64 * 4
    return

  compile: method = .void
    arg ucd = .unicodeucdresult
    _status = 0
    _error = ""
    if ucd.status() \= 0 then do
      call _fail ucd.error()
      return
    end

    call _compile_ccc ucd.compatibility_ast()
    if _status \= 0 then return

    _nfd_raw = .unicodedrawmappings()
    call _nfd_raw.compile(ucd.canonical_ast())
    if _nfd_raw.status() \= 0 then do
      call _fail _nfd_raw.error()
      return
    end
    _nfkd_raw = .unicodedrawmappings()
    call _nfkd_raw.compile(ucd.compatibility_ast())
    if _nfkd_raw.status() \= 0 then do
      call _fail _nfkd_raw.error()
      return
    end

    call _prepare_form _nfd_raw, 1
    if _status = 0 then call _prepare_form _nfkd_raw, 2
    if _status = 0 then call _audit_partition 1
    if _status = 0 then call _audit_partition 2
    if _status = 0 then call _assemble_image
    return

  status: method = .int
    return _status

  error: method = .string
    return _error

  image: method = .binary
    return _image

  byte_length: method = .int
    return <blen>(_image)

  sha256: method = .string
    if _status \= 0 then return ""
    return rxhash..sha256hex(_image)

  rank_count: method = .int
    return _rank_count

  nfd_mapping_count: method = .int
    return _nfd_raw.map_count()

  nfkd_mapping_count: method = .int
    return _nfkd_raw.map_count()

  nfd_component_count: method = .int
    return _nfd_component_count

  nfkd_component_count: method = .int
    return _nfkd_component_count

  nfd_identity_starters: method = .int
    return _nfd_identity_starters

  nfd_identity_marks: method = .int
    return _nfd_identity_marks

  nfkd_identity_starters: method = .int
    return _nfkd_identity_starters

  nfkd_identity_marks: method = .int
    return _nfkd_identity_marks

  manifest: method = .string
    if _status \= 0 then return "status|error|" || _error || "0a"x
    nl = "0a"x
    return "format|crexx-unicode-d-prepared-portable-v1" || nl ||,
           "unicode|17.0.0" || nl ||,
           "bytes|" || <blen>(_image) || nl ||,
           "positive_ccc|" || _rank_count || nl ||,
           "nfd_mappings|" || _nfd_raw.map_count() || nl ||,
           "nfd_components|" || _nfd_component_count || nl ||,
           "nfd_utf8_bytes|" || _nfd_utf8_bytes || nl ||,
           "nfd_classes|" || _nfd_closed || "/" || _nfd_open || "/" || _nfd_marks || "/" || _nfd_complex || nl ||,
           "nfkd_mappings|" || _nfkd_raw.map_count() || nl ||,
           "nfkd_components|" || _nfkd_component_count || nl ||,
           "nfkd_utf8_bytes|" || _nfkd_utf8_bytes || nl ||,
           "nfkd_classes|" || _nfkd_closed || "/" || _nfkd_open || "/" || _nfkd_marks || "/" || _nfkd_complex || nl ||,
           "sha256|" || sha256() || nl

  _fail: method = .void
    arg message = .string
    if _status \= 0 then return
    _status = 1
    _error = message
    return

  _compile_ccc: method = .void
    arg ast = .unicodegennorm2ast
    call binresize _ccc, 0x110000
    call binresize _ccc_seen, 255
    call binresize _rank, 256
    ccc_count = 0
    do i = 0 to ast.record_count() - 1 while _status = 0
      record = ast.record_at(i)
      if record.kind() = "ccc_single" | record.kind() = "ccc_range" then do
        first = record.first()
        last = record.last()
        ccc = record.number()
        if unicode_d_is_scalar(first) = 0 | unicode_d_is_scalar(last) = 0 | last < first then,
          call _fail "invalid CCC record in prepared D generator"
        else if ccc < 1 | ccc > 254 then,
          call _fail "prepared D generator requires CCC values 1..254"
        else do codepoint = first to last while _status = 0
          if <at..u8>(codepoint) _ccc \= 0 then call _fail "overlapping CCC record in prepared D generator"
          else do
            <at..u8>(codepoint) _ccc = ccc
            <at..u8>(ccc) _ccc_seen = 1
            ccc_count = ccc_count + 1
          end
        end
      end
    end
    if _status = 0 & ccc_count \= 968 then call _fail "prepared D CCC scalar count mismatch"
    _rank_count = 0
    do ccc = 1 to 254
      if <at..u8>(ccc) _ccc_seen \= 0 then do
        <at..u8>(ccc) _rank = _rank_count
        _rank_count = _rank_count + 1
      end
    end
    if _status = 0 & _rank_count \= 55 then call _fail "prepared D positive CCC rank count mismatch"
    return

  _prepare_form: method = .void
    arg raw = .unicodedrawmappings, form = .int
    if form = 1 then do
      call binresize _nfd_bits, 0x22000
      call binresize _nfd_pages, 0x1100 * 8
      call binresize _nfd_records, raw.map_count() * 12
      call binresize _nfd_components, (raw.value_count() + raw.map_count()) * 8
      _nfd_component_count = 0
      _nfd_utf8_bytes = 0
      _nfd_closed = 0
      _nfd_open = 0
      _nfd_marks = 0
      _nfd_complex = 0
    end
    else do
      call binresize _nfkd_bits, 0x22000
      call binresize _nfkd_pages, 0x1100 * 8
      call binresize _nfkd_records, raw.map_count() * 12
      call binresize _nfkd_components, (raw.value_count() + raw.map_count()) * 8
      _nfkd_component_count = 0
      _nfkd_utf8_bytes = 0
      _nfkd_closed = 0
      _nfkd_open = 0
      _nfkd_marks = 0
      _nfkd_complex = 0
    end

    do mapping = 0 to raw.map_count() - 1 while _status = 0
      source = raw.source_at(mapping)
      _temp_count = 0
      call _expand raw, source, 0
      if _status \= 0 then leave
      call _order_temp
      if _status \= 0 then leave
      structural_class = _classify_temp()
      if structural_class < 1 | structural_class > 4 then do
        call _fail "prepared D mapping has an invalid structural class"
        leave
      end

      if form = 1 then do
        component_start = _nfd_component_count
        do i = 0 to _temp_count - 1
          codepoint = <at..u32>(i * 4) _temp
          call _write_component _nfd_components, _nfd_component_count, codepoint
          _nfd_utf8_bytes = _nfd_utf8_bytes + _utf8_length(codepoint)
          _nfd_component_count = _nfd_component_count + 1
        end
        call _write_prepared_record _nfd_records, _nfd_pages, _nfd_bits, mapping, source, component_start, _temp_count, structural_class
        if structural_class = 1 then _nfd_closed = _nfd_closed + 1
        else if structural_class = 2 then _nfd_open = _nfd_open + 1
        else if structural_class = 3 then _nfd_marks = _nfd_marks + 1
        else _nfd_complex = _nfd_complex + 1
      end
      else do
        component_start = _nfkd_component_count
        do i = 0 to _temp_count - 1
          codepoint = <at..u32>(i * 4) _temp
          call _write_component _nfkd_components, _nfkd_component_count, codepoint
          _nfkd_utf8_bytes = _nfkd_utf8_bytes + _utf8_length(codepoint)
          _nfkd_component_count = _nfkd_component_count + 1
        end
        call _write_prepared_record _nfkd_records, _nfkd_pages, _nfkd_bits, mapping, source, component_start, _temp_count, structural_class
        if structural_class = 1 then _nfkd_closed = _nfkd_closed + 1
        else if structural_class = 2 then _nfkd_open = _nfkd_open + 1
        else if structural_class = 3 then _nfkd_marks = _nfkd_marks + 1
        else _nfkd_complex = _nfkd_complex + 1
      end
    end

    if _status \= 0 then return
    if form = 1 then do
      call binresize _nfd_components, _nfd_component_count * 8
      if _nfd_component_count \= 3450 | _nfd_utf8_bytes \= 8041 |,
         _nfd_closed \= 1085 | _nfd_open \= 989 |,
         _nfd_marks \= 7 | _nfd_complex \= 0 then,
        call _fail "prepared NFD closure audit mismatch"
    end
    else do
      call binresize _nfkd_components, _nfkd_component_count * 8
      if _nfkd_component_count \= 9193 | _nfkd_utf8_bytes \= 18593 |,
         _nfkd_closed \= 4822 | _nfkd_open \= 1083 |,
         _nfkd_marks \= 9 | _nfkd_complex \= 0 then,
        call _fail "prepared NFKD closure audit mismatch"
    end
    return

  _expand: method = .void
    arg raw = .unicodedrawmappings, codepoint = .int, depth = .int
    if _status \= 0 then return
    if unicode_d_is_scalar(codepoint) = 0 then do
      call _fail "prepared D closure contains a non-scalar value"
      return
    end
    if codepoint >= 0xAC00 & codepoint < 0xAC00 + 11172 then do
      s_index = codepoint - 0xAC00
      l_index = s_index <idiv> 588
      remainder = s_index <mod> 588
      v_index = remainder <idiv> 28
      t_index = s_index <mod> 28
      call _append_temp 0x1100 + l_index
      call _append_temp 0x1161 + v_index
      if t_index \= 0 then call _append_temp 0x11A7 + t_index
      return
    end

    mapping = raw.find(codepoint)
    if mapping < 0 then do
      call _append_temp codepoint
      return
    end
    if depth >= 64 then do
      call _fail "cyclic or excessively deep prepared D decomposition"
      return
    end
    do i = 0 to depth - 1
      if <at..u32>(i * 4) _path = codepoint then do
        call _fail "cyclic or excessively deep prepared D decomposition"
        return
      end
    end
    <at..u32>(depth * 4) _path = codepoint
    do i = 0 to raw.mapping_value_count(mapping) - 1 while _status = 0
      call _expand raw, raw.mapping_value_at(mapping, i), depth + 1
    end
    return

  _append_temp: method = .void
    arg codepoint = .int
    if _temp_count >= _temp_capacity then do
      _temp_capacity = _temp_capacity * 2
      call binresize _temp, _temp_capacity * 4
    end
    <at..u32>(_temp_count * 4) _temp = codepoint
    _temp_count = _temp_count + 1
    return

  _order_temp: method = .void
    do i = 1 to _temp_count - 1
      current = <at..u32>(i * 4) _temp
      current_ccc = <at..u8>(current) _ccc
      if current_ccc = 0 then iterate
      j = i
      do while j > 0
        previous = <at..u32>((j - 1) * 4) _temp
        previous_ccc = <at..u8>(previous) _ccc
        if previous_ccc = 0 | previous_ccc <= current_ccc then leave
        <at..u32>(j * 4) _temp = previous
        <at..u32>((j - 1) * 4) _temp = current
        j = j - 1
      end
    end
    previous_ccc = 0
    do i = 0 to _temp_count - 1 while _status = 0
      codepoint = <at..u32>(i * 4) _temp
      ccc = <at..u8>(codepoint) _ccc
      if ccc = 0 then previous_ccc = 0
      else do
        if previous_ccc > ccc then call _fail "prepared D expansion is not canonically ordered"
        previous_ccc = ccc
      end
    end
    return

  _classify_temp: method = .int
    first_starter = -1
    last_starter = -1
    do i = 0 to _temp_count - 1
      codepoint = <at..u32>(i * 4) _temp
      if <at..u8>(codepoint) _ccc = 0 then do
        if first_starter < 0 then first_starter = i
        last_starter = i
      end
    end
    if first_starter < 0 then return 3
    if first_starter > 0 then return 4
    if last_starter = _temp_count - 1 then return 1
    return 2

  _write_prepared_record: method = .void
    arg expose records = .binary, expose pages = .binary, expose bits = .binary, mapping = .int, source = .int, component_start = .int, component_count = .int, structural_class = .int
    offset = mapping * 12
    <at..u32>(offset) records = source
    <at..u32>(offset + 4) records = component_start
    <at..u16>(offset + 8) records = component_count
    <at..u8>(offset + 10) records = structural_class
    <at..u8>(offset + 11) records = 0

    page_offset = (source <idiv> 256) * 8
    page_count = <at..u16>(page_offset + 4) pages
    if page_count = 0 then <at..u32>(page_offset) pages = mapping
    <at..u16>(page_offset + 4) pages = page_count + 1

    bit_offset = source <idiv> 8
    mask = 1 <shl> (source <mod> 8)
    <at..u8>(bit_offset) bits = <at..u8>(bit_offset) bits <or> mask
    return

  _write_component: method = .void
    arg expose components = .binary, index = .int, codepoint = .int
    offset = index * 8
    ccc = <at..u8>(codepoint) _ccc
    length = _utf8_length(codepoint)
    <at..u8>(offset) components = ccc
    <at..u8>(offset + 1) components = length
    if length = 1 then <at..u8>(offset + 2) components = codepoint
    else if length = 2 then do
      <at..u8>(offset + 2) components = 0xC0 <or> (codepoint <shr> 6)
      <at..u8>(offset + 3) components = 0x80 <or> (codepoint <and> 0x3F)
    end
    else if length = 3 then do
      <at..u8>(offset + 2) components = 0xE0 <or> (codepoint <shr> 12)
      <at..u8>(offset + 3) components = 0x80 <or> ((codepoint <shr> 6) <and> 0x3F)
      <at..u8>(offset + 4) components = 0x80 <or> (codepoint <and> 0x3F)
    end
    else do
      <at..u8>(offset + 2) components = 0xF0 <or> (codepoint <shr> 18)
      <at..u8>(offset + 3) components = 0x80 <or> ((codepoint <shr> 12) <and> 0x3F)
      <at..u8>(offset + 4) components = 0x80 <or> ((codepoint <shr> 6) <and> 0x3F)
      <at..u8>(offset + 5) components = 0x80 <or> (codepoint <and> 0x3F)
    end
    return

  _utf8_length: method = .int
    arg codepoint = .int
    if codepoint <= 0x7F then return 1
    if codepoint <= 0x7FF then return 2
    if codepoint <= 0xFFFF then return 3
    return 4

  _mapped: method = .int
    arg bits = .binary, codepoint = .int
    byte = <at..u8>(codepoint <idiv> 8) bits
    mask = 1 <shl> (codepoint <mod> 8)
    return (byte <and> mask) \= 0

  _audit_partition: method = .void
    arg form = .int
    identity_marks = 0
    if form = 1 then bits = _nfd_bits
    else bits = _nfkd_bits
    do codepoint = 0 to 0x10FFFF
      if codepoint >= 0xD800 & codepoint <= 0xDFFF then iterate
      if codepoint >= 0xAC00 & codepoint < 0xAC00 + 11172 then iterate
      if _mapped(bits, codepoint) then iterate
      if <at..u8>(codepoint) _ccc \= 0 then identity_marks = identity_marks + 1
    end
    if form = 1 then do
      _nfd_identity_marks = identity_marks
      _nfd_identity_starters = 1112064 - 11172 - _nfd_raw.map_count() - identity_marks
      if _nfd_identity_starters \= 1097847 | _nfd_identity_marks \= 964 then,
        call _fail "prepared NFD scalar partition mismatch"
    end
    else do
      _nfkd_identity_marks = identity_marks
      _nfkd_identity_starters = 1112064 - 11172 - _nfkd_raw.map_count() - identity_marks
      if _nfkd_identity_starters \= 1094014 | _nfkd_identity_marks \= 964 then,
        call _fail "prepared NFKD scalar partition mismatch"
    end
    return

  _assemble_image: method = .void
    header_size = 160
    ccc_offset = header_size
    rank_offset = ccc_offset + 0x110000
    nfd_bits_offset = rank_offset + 256
    nfkd_bits_offset = nfd_bits_offset + 0x22000
    nfd_pages_offset = nfkd_bits_offset + 0x22000
    nfkd_pages_offset = nfd_pages_offset + 0x1100 * 8
    nfd_records_offset = nfkd_pages_offset + 0x1100 * 8
    nfd_components_offset = nfd_records_offset + _nfd_raw.map_count() * 12
    nfkd_records_offset = nfd_components_offset + _nfd_component_count * 8
    nfkd_components_offset = nfkd_records_offset + _nfkd_raw.map_count() * 12
    total_size = nfkd_components_offset + _nfkd_component_count * 8
    call binresize _image, total_size

    <at..u8>(0) _image = 67
    <at..u8>(1) _image = 85
    <at..u8>(2) _image = 68
    <at..u8>(3) _image = 68
    <at..u16>(4) _image = 1
    <at..u16>(6) _image = header_size
    <at..u16>(8) _image = 17
    <at..u16>(10) _image = 0
    <at..u16>(12) _image = 0
    <at..u16>(14) _image = 0
    <at..u32>(16) _image = ccc_offset
    <at..u32>(20) _image = 0x110000
    <at..u32>(24) _image = rank_offset
    <at..u32>(28) _image = 256
    <at..u32>(32) _image = nfd_bits_offset
    <at..u32>(36) _image = 0x22000
    <at..u32>(40) _image = nfkd_bits_offset
    <at..u32>(44) _image = 0x22000
    <at..u32>(48) _image = nfd_pages_offset
    <at..u32>(52) _image = 0x1100
    <at..u32>(56) _image = nfkd_pages_offset
    <at..u32>(60) _image = 0x1100
    <at..u32>(64) _image = nfd_records_offset
    <at..u32>(68) _image = _nfd_raw.map_count()
    <at..u32>(72) _image = nfd_components_offset
    <at..u32>(76) _image = _nfd_component_count
    <at..u32>(80) _image = nfkd_records_offset
    <at..u32>(84) _image = _nfkd_raw.map_count()
    <at..u32>(88) _image = nfkd_components_offset
    <at..u32>(92) _image = _nfkd_component_count
    <at..u32>(96) _image = _rank_count
    <at..u32>(100) _image = _nfd_utf8_bytes
    <at..u32>(104) _image = _nfkd_utf8_bytes
    <at..u32>(108) _image = _nfd_closed
    <at..u32>(112) _image = _nfd_open
    <at..u32>(116) _image = _nfd_marks
    <at..u32>(120) _image = _nfd_complex
    <at..u32>(124) _image = _nfkd_closed
    <at..u32>(128) _image = _nfkd_open
    <at..u32>(132) _image = _nfkd_marks
    <at..u32>(136) _image = _nfkd_complex
    <at..u32>(140) _image = _nfd_raw.value_count()
    <at..u32>(144) _image = _nfkd_raw.value_count()
    <at..u32>(148) _image = _nfd_component_count
    <at..u32>(152) _image = _nfkd_component_count
    <at..u32>(156) _image = 0

    call bincopy _image, ccc_offset, _ccc, 0, <blen>(_ccc)
    call bincopy _image, rank_offset, _rank, 0, <blen>(_rank)
    call bincopy _image, nfd_bits_offset, _nfd_bits, 0, <blen>(_nfd_bits)
    call bincopy _image, nfkd_bits_offset, _nfkd_bits, 0, <blen>(_nfkd_bits)
    call bincopy _image, nfd_pages_offset, _nfd_pages, 0, <blen>(_nfd_pages)
    call bincopy _image, nfkd_pages_offset, _nfkd_pages, 0, <blen>(_nfkd_pages)
    call bincopy _image, nfd_records_offset, _nfd_records, 0, <blen>(_nfd_records)
    call bincopy _image, nfd_components_offset, _nfd_components, 0, <blen>(_nfd_components)
    call bincopy _image, nfkd_records_offset, _nfkd_records, 0, <blen>(_nfkd_records)
    call bincopy _image, nfkd_components_offset, _nfkd_components, 0, <blen>(_nfkd_components)
    return

/** Shared bytewise NFD/NFKD engine over one validated prepared image. */
unicodednormalizer: class
  _image = .binary
  _ready = .int
  _status = .int
  _error = .string
  _form = .int
  _ccc_offset = .int
  _rank_offset = .int
  _rank_count = .int
  _bits_offset = .int
  _pages_offset = .int
  _records_offset = .int
  _record_count = .int
  _components_offset = .int
  _component_count = .int
  _decoded_codepoint = .int
  _decoded_length = .int
  _output = .binary
  _output_length = .int
  _output_capacity = .int
  _raw_start = .int
  _raw_length = .int
  _pending = .binary
  _pending_count = .int
  _pending_capacity = .int
  _pending_disordered = .int
  _pending_last_ccc = .int
  _bucket_flushes = .int
  _scratch = .binary
  _counts = .binary
  _next = .binary

  *: factory
    _ready = 0
    _status = 0
    _error = ""
    _form = 0
    _output_length = 0
    _output_capacity = 64
    call binresize _output, _output_capacity
    _raw_start = 0
    _raw_length = 0
    _pending_count = 0
    _pending_capacity = 64
    _pending_disordered = 0
    _pending_last_ccc = 0
    _bucket_flushes = 0
    call binresize _pending, _pending_capacity * 8
    return

  initialize: method = .void
    arg tables = .unicodedtables, form = .string
    _ready = 0
    _status = 0
    _error = ""
    if tables.status() \= 0 then do
      call _fail tables.error()
      return
    end
    form = upper(form)
    if form = "NFD" then _form = 1
    else if form = "NFKD" then _form = 2
    else do
      call _fail "prepared D form must be NFD or NFKD"
      return
    end
    _image = tables.image()
    call _validate_image
    if _status = 0 then do
      call binresize _counts, _rank_count * 4
      call binresize _next, _rank_count * 4
      _ready = 1
    end
    return

  ready: method = .int
    return _ready

  status: method = .int
    return _status

  error: method = .string
    return _error

  form: method = .string
    if _form = 1 then return "NFD"
    if _form = 2 then return "NFKD"
    return ""

  /** Number of non-monotone mark runs handled by the stable rank buckets. */
  bucket_flushes: method = .int
    return _bucket_flushes

  combining_class: method = .int
    arg codepoint = .int
    if _ready = 0 | unicode_d_is_scalar(codepoint) = 0 then return -1
    return <at..u8>(_ccc_offset + codepoint) _image

  /** Normalize validated text without first copying its complete UTF-8 bytes. */
  normalize: method = .string
    arg expose source = .string
    if _ready = 0 then return ""
    empty_binary = .binary
    source_length = 0
    assembler sblen source_length,source
    call _begin source_length
    call _consume 1, source, empty_binary, source_length
    call _finish 1, source, empty_binary
    if _status \= 0 then return ""
    result = _output as .string
    return result

  /** Normalize a binary UTF-8 buffer and retain a binary result. */
  normalize_binary: method = .binary
    arg expose source = .binary
    empty = .binary
    if _ready = 0 then return empty
    empty_string = ""
    source_length = <blen>(source)
    call _begin source_length
    call _consume 2, empty_string, source, source_length
    call _finish 2, empty_string, source
    if _status \= 0 then return empty
    return _output

  /** Exact D-form Quick_Check over a string, with no normalized result copy. */
  is_normalized: method = .int
    arg expose source = .string
    if _ready = 0 then return 0
    empty_binary = .binary
    source_length = 0
    assembler sblen source_length,source
    _status = 0
    _error = ""
    return _quick_check(1, source, empty_binary, source_length)

  /** Exact D-form Quick_Check over a binary UTF-8 buffer. */
  is_normalized_binary: method = .int
    arg expose source = .binary
    if _ready = 0 then return 0
    empty_string = ""
    _status = 0
    _error = ""
    return _quick_check(2, empty_string, source, <blen>(source))

  _fail: method = .void
    arg message = .string
    if _status \= 0 then return
    _status = 1
    _error = message
    return

  _validate_image: method = .void
    image_length = <blen>(_image)
    if image_length < 160 then do
      call _fail "prepared D image is shorter than its header"
      return
    end
    if <at..u8>(0) _image \= 67 | <at..u8>(1) _image \= 85 |,
       <at..u8>(2) _image \= 68 | <at..u8>(3) _image \= 68 |,
       <at..u16>(4) _image \= 1 | <at..u16>(6) _image \= 160 then do
      call _fail "invalid prepared D image header"
      return
    end
    if <at..u16>(8) _image \= 17 | <at..u16>(10) _image \= 0 |,
       <at..u16>(12) _image \= 0 then do
      call _fail "unsupported Unicode version in prepared D image"
      return
    end
    _ccc_offset = <at..u32>(16) _image
    _rank_offset = <at..u32>(24) _image
    _rank_count = <at..u32>(96) _image
    if _form = 1 then do
      _bits_offset = <at..u32>(32) _image
      _pages_offset = <at..u32>(48) _image
      _records_offset = <at..u32>(64) _image
      _record_count = <at..u32>(68) _image
      _components_offset = <at..u32>(72) _image
      _component_count = <at..u32>(76) _image
    end
    else do
      _bits_offset = <at..u32>(40) _image
      _pages_offset = <at..u32>(56) _image
      _records_offset = <at..u32>(80) _image
      _record_count = <at..u32>(84) _image
      _components_offset = <at..u32>(88) _image
      _component_count = <at..u32>(92) _image
    end
    if _ccc_offset \= 160 | <at..u32>(20) _image \= 0x110000 |,
       _rank_offset \= _ccc_offset + 0x110000 | <at..u32>(28) _image \= 256 |,
       _rank_count \= 55 then do
      call _fail "invalid CCC/rank sections in prepared D image"
      return
    end
    if _form = 1 & (_record_count \= 2081 | _component_count \= 3450) then,
      call _fail "invalid NFD counts in prepared D image"
    else if _form = 2 & (_record_count \= 5914 | _component_count \= 9193) then,
      call _fail "invalid NFKD counts in prepared D image"
    if _status \= 0 then return
    if _components_offset + _component_count * 8 > image_length then,
      call _fail "prepared D component section exceeds image length"

    previous = -1
    do mapping = 0 to _record_count - 1 while _status = 0
      offset = _records_offset + mapping * 12
      source = <at..u32>(offset) _image
      first = <at..u32>(offset + 4) _image
      count = <at..u16>(offset + 8) _image
      structural_class = <at..u8>(offset + 10) _image
      if unicode_d_is_scalar(source) = 0 | source <= previous then,
        call _fail "prepared D records are not strictly ordered"
      else if count = 0 | first + count > _component_count then,
        call _fail "prepared D component span is invalid"
      else if structural_class < 1 | structural_class > 4 then,
        call _fail "prepared D structural class is invalid"
      previous = source
    end
    return

  _begin: method = .void
    arg source_length = .int
    _status = 0
    _error = ""
    _output_length = 0
    if source_length > _output_capacity then do
      _output_capacity = source_length
      if _output_capacity < 64 then _output_capacity = 64
    end
    call binresize _output, _output_capacity
    _raw_start = 0
    _raw_length = 0
    _pending_count = 0
    _pending_disordered = 0
    _pending_last_ccc = 0
    _bucket_flushes = 0
    return

  _consume: method = .void
    arg source_kind = .int, expose source_string = .string, expose source_binary = .binary, source_length = .int
    position = 0
    do while position < source_length & _status = 0
      byte = _source_byte(source_kind, source_string, source_binary, position)
      if byte <= 0x7F then do
        start = position
        position = position + 1
        do while position < source_length
          byte = _source_byte(source_kind, source_string, source_binary, position)
          if byte > 0x7F then leave
          position = position + 1
        end
        call _queue_raw start, position - start, source_kind, source_string, source_binary
      end
      else do
        call _decode source_kind, source_string, source_binary, position, source_length
        if _status = 0 then do
          call _process_scalar _decoded_codepoint, position, _decoded_length, source_kind, source_string, source_binary
          position = position + _decoded_length
        end
      end
    end
    return

  _source_byte: method = .int
    arg source_kind = .int, expose source_string = .string, expose source_binary = .binary, offset = .int
    value = 0
    if source_kind = 1 then assembler sgetu8 value,source_string,offset
    else value = <at..u8>(offset) source_binary
    return value

  _decode: method = .void
    arg source_kind = .int, expose source_string = .string, expose source_binary = .binary, position = .int, source_length = .int
    first = _source_byte(source_kind, source_string, source_binary, position)
    if first >= 0xC2 & first <= 0xDF then do
      if position + 2 > source_length then do
        call _fail "truncated UTF-8 sequence"
        return
      end
      second = _source_byte(source_kind, source_string, source_binary, position + 1)
      if second < 0x80 | second > 0xBF then do
        call _fail "invalid UTF-8 continuation byte"
        return
      end
      _decoded_codepoint = ((first <and> 0x1F) <shl> 6) <or> (second <and> 0x3F)
      _decoded_length = 2
      return
    end
    if first >= 0xE0 & first <= 0xEF then do
      if position + 3 > source_length then do
        call _fail "truncated UTF-8 sequence"
        return
      end
      second = _source_byte(source_kind, source_string, source_binary, position + 1)
      third = _source_byte(source_kind, source_string, source_binary, position + 2)
      if third < 0x80 | third > 0xBF |,
         (first = 0xE0 & (second < 0xA0 | second > 0xBF)) |,
         (first = 0xED & (second < 0x80 | second > 0x9F)) |,
         (first \= 0xE0 & first \= 0xED & (second < 0x80 | second > 0xBF)) then do
        call _fail "invalid UTF-8 three-byte sequence"
        return
      end
      _decoded_codepoint = ((first <and> 0x0F) <shl> 12) <or>,
                           ((second <and> 0x3F) <shl> 6) <or>,
                           (third <and> 0x3F)
      _decoded_length = 3
      return
    end
    if first >= 0xF0 & first <= 0xF4 then do
      if position + 4 > source_length then do
        call _fail "truncated UTF-8 sequence"
        return
      end
      second = _source_byte(source_kind, source_string, source_binary, position + 1)
      third = _source_byte(source_kind, source_string, source_binary, position + 2)
      fourth = _source_byte(source_kind, source_string, source_binary, position + 3)
      if third < 0x80 | third > 0xBF | fourth < 0x80 | fourth > 0xBF |,
         (first = 0xF0 & (second < 0x90 | second > 0xBF)) |,
         (first = 0xF4 & (second < 0x80 | second > 0x8F)) |,
         (first \= 0xF0 & first \= 0xF4 & (second < 0x80 | second > 0xBF)) then do
        call _fail "invalid UTF-8 four-byte sequence"
        return
      end
      _decoded_codepoint = ((first <and> 0x07) <shl> 18) <or>,
                           ((second <and> 0x3F) <shl> 12) <or>,
                           ((third <and> 0x3F) <shl> 6) <or>,
                           (fourth <and> 0x3F)
      _decoded_length = 4
      return
    end
    call _fail "invalid UTF-8 leading byte"
    return

  _process_scalar: method = .void
    arg codepoint = .int, source_offset = .int, source_length = .int, source_kind = .int, expose source_string = .string, expose source_binary = .binary
    if codepoint >= 0xAC00 & codepoint < 0xAC00 + 11172 then do
      call _emit_hangul codepoint, source_kind, source_string, source_binary
      return
    end
    if _mapped(codepoint) then do
      mapping = _find_mapping(codepoint)
      if mapping < 0 then call _fail "prepared D mapping bit has no record"
      else call _process_mapping mapping, source_kind, source_string, source_binary
      return
    end
    ccc = <at..u8>(_ccc_offset + codepoint) _image
    if ccc = 0 then call _queue_raw source_offset, source_length, source_kind, source_string, source_binary
    else call _enqueue_source_mark ccc, source_offset, source_length, source_kind, source_string, source_binary
    return

  _mapped: method = .int
    arg codepoint = .int
    byte = <at..u8>(_bits_offset + (codepoint <idiv> 8)) _image
    mask = 1 <shl> (codepoint <mod> 8)
    return (byte <and> mask) \= 0

  _find_mapping: method = .int
    arg codepoint = .int
    page_offset = _pages_offset + (codepoint <idiv> 256) * 8
    first = <at..u32>(page_offset) _image
    count = <at..u16>(page_offset + 4) _image
    low = first
    high = first + count - 1
    do while low <= high
      middle = (low + high) <idiv> 2
      source = <at..u32>(_records_offset + middle * 12) _image
      if source = codepoint then return middle
      if source < codepoint then low = middle + 1
      else high = middle - 1
    end
    return -1

  _process_mapping: method = .void
    arg mapping = .int, source_kind = .int, expose source_string = .string, expose source_binary = .binary
    offset = _records_offset + mapping * 12
    first = <at..u32>(offset + 4) _image
    count = <at..u16>(offset + 8) _image
    do i = 0 to count - 1 while _status = 0
      component = _components_offset + (first + i) * 8
      ccc = <at..u8>(component) _image
      if ccc = 0 then do
        call _flush_segment source_kind, source_string, source_binary
        call _append_component component
      end
      else call _enqueue_component component
    end
    return

  _emit_hangul: method = .void
    arg codepoint = .int, source_kind = .int, expose source_string = .string, expose source_binary = .binary
    call _flush_segment source_kind, source_string, source_binary
    s_index = codepoint - 0xAC00
    l_index = s_index <idiv> 588
    remainder = s_index <mod> 588
    v_index = remainder <idiv> 28
    t_index = s_index <mod> 28
    call _append_codepoint 0x1100 + l_index
    call _append_codepoint 0x1161 + v_index
    if t_index \= 0 then call _append_codepoint 0x11A7 + t_index
    return

  _queue_raw: method = .void
    arg source_offset = .int, source_length = .int, source_kind = .int, expose source_string = .string, expose source_binary = .binary
    if _pending_count > 0 then call _flush_segment source_kind, source_string, source_binary
    if _raw_length = 0 then do
      _raw_start = source_offset
      _raw_length = source_length
    end
    else if _raw_start + _raw_length = source_offset then,
      _raw_length = _raw_length + source_length
    else do
      call _flush_raw source_kind, source_string, source_binary
      _raw_start = source_offset
      _raw_length = source_length
    end
    return

  _enqueue_source_mark: method = .void
    arg ccc = .int, source_offset = .int, source_length = .int, source_kind = .int, expose source_string = .string, expose source_binary = .binary
    call _ensure_pending
    offset = _pending_count * 8
    <at..u8>(offset) _pending = ccc
    <at..u8>(offset + 1) _pending = source_length
    payload_offset = offset + 2
    if source_kind = 1 then do
      assembler sbmove _pending,payload_offset,source_string,source_offset,source_length
    end
    else call bincopy _pending, payload_offset, source_binary, source_offset, source_length
    call _note_pending ccc
    return

  _enqueue_component: method = .void
    arg component = .int
    call _ensure_pending
    offset = _pending_count * 8
    ccc = <at..u8>(component) _image
    length = <at..u8>(component + 1) _image
    <at..u8>(offset) _pending = ccc
    <at..u8>(offset + 1) _pending = length
    call bincopy _pending, offset + 2, _image, component + 2, length
    call _note_pending ccc
    return

  _ensure_pending: method = .void
    if _pending_count >= _pending_capacity then do
      _pending_capacity = _pending_capacity * 2
      call binresize _pending, _pending_capacity * 8
    end
    return

  _note_pending: method = .void
    arg ccc = .int
    if _pending_count > 0 & ccc < _pending_last_ccc then,
      _pending_disordered = 1
    _pending_last_ccc = ccc
    _pending_count = _pending_count + 1
    return

  _flush_segment: method = .void
    arg source_kind = .int, expose source_string = .string, expose source_binary = .binary
    call _flush_raw source_kind, source_string, source_binary
    call _flush_pending
    return

  _flush_raw: method = .void
    arg source_kind = .int, expose source_string = .string, expose source_binary = .binary
    if _raw_length = 0 | _status \= 0 then return
    call _ensure_output _raw_length
    if source_kind = 1 then,
      assembler sbmove _output,_output_length,source_string,_raw_start,_raw_length
    else call bincopy _output, _output_length, source_binary, _raw_start, _raw_length
    _output_length = _output_length + _raw_length
    _raw_length = 0
    return

  _flush_pending: method = .void
    if _pending_count = 0 | _status \= 0 then return
    if _pending_disordered then call _sort_pending
    do i = 0 to _pending_count - 1 while _status = 0
      offset = i * 8
      span_length = .int
      if _pending_disordered then do
        span_length = <at..u8>(offset + 1) _scratch
        call _ensure_output span_length
        call bincopy _output, _output_length, _scratch, offset + 2, span_length
      end
      else do
        span_length = <at..u8>(offset + 1) _pending
        call _ensure_output span_length
        call bincopy _output, _output_length, _pending, offset + 2, span_length
      end
      _output_length = _output_length + span_length
    end
    _pending_count = 0
    _pending_disordered = 0
    _pending_last_ccc = 0
    return

  _sort_pending: method = .void
    _bucket_flushes = _bucket_flushes + 1
    call binresize _scratch, _pending_count * 8
    call binfill _counts, 0
    do i = 0 to _pending_count - 1
      ccc = <at..u8>(i * 8) _pending
      rank = <at..u8>(_rank_offset + ccc) _image
      offset = rank * 4
      <at..u32>(offset) _counts = <at..u32>(offset) _counts + 1
    end
    total = 0
    do rank = 0 to _rank_count - 1
      offset = rank * 4
      <at..u32>(offset) _next = total
      total = total + <at..u32>(offset) _counts
    end
    do i = 0 to _pending_count - 1
      source_offset = i * 8
      ccc = <at..u8>(source_offset) _pending
      rank = <at..u8>(_rank_offset + ccc) _image
      rank_offset = rank * 4
      target = <at..u32>(rank_offset) _next
      call bincopy _scratch, target * 8, _pending, source_offset, 8
      <at..u32>(rank_offset) _next = target + 1
    end
    return

  _append_component: method = .void
    arg component = .int
    length = <at..u8>(component + 1) _image
    call _ensure_output length
    call bincopy _output, _output_length, _image, component + 2, length
    _output_length = _output_length + length
    return

  _append_codepoint: method = .void
    arg codepoint = .int
    if codepoint <= 0x7F then length = 1
    else if codepoint <= 0x7FF then length = 2
    else if codepoint <= 0xFFFF then length = 3
    else length = 4
    call _ensure_output length
    offset = _output_length
    if length = 1 then <at..u8>(offset) _output = codepoint
    else if length = 2 then do
      <at..u8>(offset) _output = 0xC0 <or> (codepoint <shr> 6)
      <at..u8>(offset + 1) _output = 0x80 <or> (codepoint <and> 0x3F)
    end
    else if length = 3 then do
      <at..u8>(offset) _output = 0xE0 <or> (codepoint <shr> 12)
      <at..u8>(offset + 1) _output = 0x80 <or> ((codepoint <shr> 6) <and> 0x3F)
      <at..u8>(offset + 2) _output = 0x80 <or> (codepoint <and> 0x3F)
    end
    else do
      <at..u8>(offset) _output = 0xF0 <or> (codepoint <shr> 18)
      <at..u8>(offset + 1) _output = 0x80 <or> ((codepoint <shr> 12) <and> 0x3F)
      <at..u8>(offset + 2) _output = 0x80 <or> ((codepoint <shr> 6) <and> 0x3F)
      <at..u8>(offset + 3) _output = 0x80 <or> (codepoint <and> 0x3F)
    end
    _output_length = _output_length + length
    return

  _ensure_output: method = .void
    arg extra = .int
    required = _output_length + extra
    if required <= _output_capacity then return
    do while _output_capacity < required
      _output_capacity = _output_capacity * 2
    end
    call binresize _output, _output_capacity
    return

  _finish: method = .void
    arg source_kind = .int, expose source_string = .string, expose source_binary = .binary
    if _status \= 0 then return
    call _flush_segment source_kind, source_string, source_binary
    if _status = 0 then call binresize _output, _output_length
    return

  _quick_check: method = .int
    arg source_kind = .int, expose source_string = .string, expose source_binary = .binary, source_length = .int
    previous_ccc = 0
    position = 0
    do while position < source_length & _status = 0
      byte = _source_byte(source_kind, source_string, source_binary, position)
      if byte <= 0x7F then do
        previous_ccc = 0
        position = position + 1
      end
      else do
        call _decode source_kind, source_string, source_binary, position, source_length
        if _status \= 0 then return 0
        codepoint = _decoded_codepoint
        if (codepoint >= 0xAC00 & codepoint < 0xAC00 + 11172) |,
           _mapped(codepoint) then return 0
        ccc = <at..u8>(_ccc_offset + codepoint) _image
        if ccc = 0 then previous_ccc = 0
        else do
          if previous_ccc > ccc then return 0
          previous_ccc = ccc
        end
        position = position + _decoded_length
      end
    end
    return _status = 0
