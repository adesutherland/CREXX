/*
 * Generate the Level B wrapper for the prepared Unicode 17 NFD executor.
 *
 * The prepared Unicode compiler maps each scalar to a virtual-alphabet
 * symbol. The shared executor iterates native CREXX string codepoints and
 * dispatches exact synthetic kinds before its residual scalar predicates.
 * This retained generation step proves deterministic Level L data lowering;
 * it deliberately emits no UTF-8 byte DFA.
 */
options levelb

import rxfnsb
import unicode_data
import unicode_normprops
import unicode_d

arg argv = .string[]
codepoint = .int
if argv[0] \= 3 then do
  say "usage: unicode_nfd_lexer_generate UnicodeData.txt DerivedNormalizationProps.txt output.re"
  return 2
end

ucd = unicode_data_parse(argv[1], "17.0.0")
if ucd.status() \= 0 then do
  say "FAIL: UnicodeData line" ucd.error_line() || ":" ucd.error()
  return 1
end
properties = unicode_normprops_parse(argv[2], "17.0.0")
if properties.status() \= 0 then do
  say "FAIL: normalization properties line" properties.error_line() || ":" properties.error()
  return 1
end
tables = unicode_norm_compile(ucd, properties)
if tables.status() \= 0 then do
  say "FAIL: prepared normalization table compiler:" tables.error()
  return 1
end
if tables.nfd_mapping_count() \= 2081 |,
   tables.nfd_identity_starters() \= 1097847 |,
   tables.nfd_identity_marks() \= 964 then do
  say "FAIL: prepared NFD scalar partition"
  return 1
end

path = argv[3]
if erasefile(path) \= 0 then return 1
call emit_line path, "/* Generated prepared-symbol Unicode 17 NFD wrapper. */"
call emit_line path, "/* Unicode IR -> prepared virtual alphabet -> shared Level B SELECT. */"
call emit_line path, "options levelb"
call emit_line path, ""
call emit_line path, "namespace level_l_unicode_nfd expose levellunicodenfdnormalizer level_l_unicode_nfd_new"
call emit_line path, "import unicode_d"
call emit_line path, ""
call emit_line path, "level_l_unicode_nfd_new: procedure = .levellunicodenfdnormalizer"
call emit_line path, "  arg tables = .unicode_d..unicodedtables"
call emit_line path, "  return .levellunicodenfdnormalizer(tables)"
call emit_line path, ""
call emit_line path, "levellunicodenfdnormalizer: class"
call emit_line path, "  _normalizer = .unicode_d..unicodednormalizer"
call emit_line path, ""
call emit_line path, "  *: factory"
call emit_line path, "    arg tables = .unicode_d..unicodedtables"
call emit_line path, '    _normalizer = unicode_d_new(tables, "NFD")'
call emit_line path, '    if _normalizer.status() \= 0 then do'
call emit_line path, '      construction_error = _normalizer.error()'
call emit_line path, '      assembler signal "INVALID_ARGUMENTS",construction_error'
call emit_line path, "    end"
call emit_line path, "    return"
call emit_line path, ""
call emit_line path, "  normalize: method = .string"
call emit_line path, "    arg source = .string"
call emit_line path, "    return _normalizer.normalize(source)"
call emit_line path, ""
call emit_line path, "  bucket_flushes: method = .int"
call emit_line path, "    return _normalizer.bucket_flushes()"

if charout(path) \= 0 then return 1
say "Prepared NFD generated mapping symbols:" tables.nfd_mapping_count()
say "Prepared NFD generated identity-mark symbols:" tables.nfd_identity_marks()
say "Prepared NFD generated executor: codepoint SELECT"
say "Result: PASS"
return 0

emit_line: procedure = .void
  arg path = .string, line = .string
  ignored = charout(path, line || "0a"x)
  return
