// cREXX overlay for re2c's loop-switch Python backend used by generated
// transducers.  Unlike the first token-lexer overlay, this form supports
// grouped byte-transition cases by lowering switches to classic SELECT.

semicolons = 0;
indentation_sensitive = 0;
wrap_blocks_in_braces = 0;

re2c:code-model = loop-switch;
re2c:date = 0;
re2c:version = 0;
re2c:line-dirs = 0;
re2c:state:abort = 0;
re2c:nested-ifs = 1;
re2c:bit-vectors = 0;
re2c:indent:string = "  ";

code:cmp_eq = "=";
code:cmp_ne = "\\=";
code:cmp_lt = "<";
code:cmp_gt = ">";
code:cmp_le = "<=";
code:cmp_ge = ">=";

code:if_then_else =
    [branch{0}: topindent "if " cond " then do" nl
        indent [stmt: stmt] dedent
        topindent "end" nl]
    [branch{1:-1}: topindent (.cond ? "else if " cond " then do" : "else do") nl
        indent [stmt: stmt] dedent
        topindent "end" nl];

code:if_then_else_oneline = <undefined>;

code:switch =
    topindent "__level_l_selector = " expr nl
    topindent "select" nl
        indent [case: case] dedent
    topindent "end" nl;

code:switch_cases =
    topindent "when "
        [case{0:-2}: case " | "]
        [case{-1}: case " then do" nl]
        indent [stmt: stmt] dedent
    topindent "end" nl;

code:switch_cases_oneline = <undefined>;

code:switch_case_range = (.many
    ? "(" [val{0}: val] " <= __level_l_selector & __level_l_selector <= " [val{-1}: val] ")"
    : "__level_l_selector = " [val{0}: val]);

code:switch_case_default = "1";

code:loop =
    topindent "do forever" nl
        indent [stmt: stmt] dedent
    topindent "end" nl;

code:continue = topindent "iterate" nl;

code:fingerprint =
    "/* Generated by the retained re2c Level L transducer backend. */" nl;

code:abort = topindent "return \"\"" nl;

code:yypeek =
    topindent yych " = <at..u8>(" YYCURSOR ") " YYINPUT nl;

code:yyskip =
    topindent YYCURSOR " = " YYCURSOR " + 1" nl;

code:yybackup = topindent YYMARKER " = " YYCURSOR nl;
code:yyrestore = topindent YYCURSOR " = " YYMARKER nl;
