// cREXX overlay for re2c's loop-switch Python backend.
//
// This deliberately overrides only target-language forms needed by the first
// Level L emitter experiment. The retained command selects the bundled Python
// syntax first and then applies this file. A production backend would either
// freeze a complete syntax file or replace this dependency.

semicolons = 0;
indentation_sensitive = 0;
wrap_blocks_in_braces = 0;

re2c:code-model = loop-switch;
re2c:date = 0;
re2c:version = 0;
re2c:line-dirs = 0;
re2c:state:abort = 0;
re2c:nested-ifs = 1;
re2c:bit-vectors = 0;
re2c:indent:string = "  ";

code:cmp_eq = "=";
code:cmp_ne = "\\=";
code:cmp_lt = "<";
code:cmp_gt = ">";
code:cmp_le = "<=";
code:cmp_ge = ">=";

code:if_then_else =
    [branch{0}: topindent "if " cond " then do" nl
        indent [stmt: stmt] dedent
        topindent "end" nl]
    [branch{1:-1}: topindent (.cond ? "else if " cond " then do" : "else do") nl
        indent [stmt: stmt] dedent
        topindent "end" nl];

code:if_then_else_oneline = <undefined>;

code:switch =
    topindent "select " expr nl
        indent [case: case] dedent
    topindent "end" nl;

code:switch_cases =
    [case: topindent case nl]
        indent [stmt: stmt] dedent
    topindent "end" nl;

code:switch_cases_oneline = <undefined>;

code:switch_case_range = "when " [val{0}: val] " then do";
code:switch_case_default = "otherwise do";

code:loop =
    topindent "do forever" nl
        indent [stmt: stmt] dedent
    topindent "end" nl;

code:continue = topindent "iterate" nl;

code:fingerprint =
    "/* Generated by the retained re2c Level L emitter experiment. */" nl;

code:abort = topindent "return 0" nl;

code:yypeek =
    topindent yych " = <at..u8>(" YYCURSOR ") " YYINPUT nl;

code:yyskip =
    topindent YYCURSOR " = " YYCURSOR " + 1" nl;

code:yybackup = topindent YYMARKER " = " YYCURSOR nl;
code:yyrestore = topindent YYCURSOR " = " YYMARKER nl;
