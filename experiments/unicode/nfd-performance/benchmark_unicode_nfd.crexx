/* Correctness-gated Unicode NFD table-layout throughput experiment. */
options levelb

import rxfnsb
import level_l_gennorm2
import unicode_gennorm2
import unicode_nfd
import unicode_nfd_packed
import unicode_nfd_apple

arg argv = .string[]
if argv[0] \= 6 & argv[0] \= 8 then do
  say "usage: benchmark_unicode_nfd variant vm nfc.txt NormalizationTest.txt warmups samples [rows|buffer repetitions]"
  return 2
end

variant = argv[1]
vm_label = argv[2]
nfc_path = argv[3]
normalization_path = argv[4]
warmups = argv[5] as .int
sample_count = argv[6] as .int
workload = "rows"
buffer_repetitions = 0
if argv[0] = 8 then do
  workload = argv[7]
  buffer_repetitions = argv[8] as .int
end
if variant \= "portable" & variant \= "packed" & variant \= "apple-rxpa" then,
  return fail("variant must be portable, packed, or apple-rxpa")
if warmups < 0 then return fail("warmups must be non-negative")
if sample_count < 1 then return fail("samples must be positive")
if workload \= "rows" & workload \= "buffer" then return fail("workload must be rows or buffer")
if workload = "rows" & buffer_repetitions \= 0 then return fail("row workload repetitions must be zero")
if workload = "buffer" & buffer_repetitions < 1 then return fail("buffer repetitions must be positive")

rules_source = loadtext(nfc_path, "0a"x)
tokens = level_l_gennorm2_lex(rules_source)
if level_l_gennorm2_status() \= 0 then return fail("gennorm2 lexer: " || level_l_gennorm2_error_message())
parse_result = unicode_gennorm2_parse(rules_source, tokens)
if parse_result.status() \= 0 then return fail("gennorm2 parser: " || parse_result.error())

sources = .string[]
expected = .string[]
lines = readlines(normalization_path)
do line_number = 1 to lines[0]
  line = strip(lines[line_number])
  if line = "" | left(line, 1) = "#" | left(line, 1) = "@" then iterate
  fields = qsplit(line, ";")
  if fields[0] < 3 then return fail("invalid normalization row at line " || line_number)
  source_hex = strip(fields[1])
  expected_hex = strip(fields[3])
  if source_hex = "" | expected_hex = "" then return fail("empty normalization field at line " || line_number)
  row = sources[0] + 1
  sources[row] = hex_sequence_to_string(source_hex)
  expected[row] = hex_sequence_to_string(expected_hex)
end
if sources[0] \= 20034 | expected[0] \= 20034 then return fail("unexpected normalization row count")

if workload = "buffer" then do
  source_buffer = .string
  expected_buffer = .string
  call build_large_buffers reference sources, reference expected, buffer_repetitions, source_buffer, expected_buffer
  if variant = "portable" then,
    return benchmark_portable_buffer(parse_result.ast(), reference source_buffer, reference expected_buffer, vm_label, warmups, sample_count, buffer_repetitions)
  if variant = "packed" then,
    return benchmark_packed_buffer(parse_result.ast(), reference source_buffer, reference expected_buffer, vm_label, warmups, sample_count, buffer_repetitions)
  return benchmark_apple_rxpa_buffer(reference sources, reference expected, reference source_buffer, reference expected_buffer, vm_label, warmups, sample_count, buffer_repetitions)
end

if variant = "portable" then,
  return benchmark_portable(parse_result.ast(), reference sources, reference expected, vm_label, warmups, sample_count)
if variant = "packed" then,
  return benchmark_packed(parse_result.ast(), reference sources, reference expected, vm_label, warmups, sample_count)
return benchmark_apple_rxpa(reference sources, reference expected, vm_label, warmups, sample_count)

benchmark_portable: procedure = .int
  arg ast = .unicodegennorm2ast, sources_ref = reference .string[], expected_ref = reference .string[], vm_label = .string, warmups = .int, sample_count = .int
  sources = dereference sources_ref
  expected = dereference expected_ref

  started = time("us")
  tables = unicode_nfd_compile(ast)
  if tables.status() \= 0 then return fail("portable table compiler: " || tables.error())
  normalizer = unicode_nfd_new(tables)
  if normalizer.status() \= 0 then return fail("portable table validation: " || normalizer.error())
  prepare_us = elapsed_us(started)

  checksum = portable_correctness(reference normalizer, reference sources, reference expected)
  if checksum < 0 then return 1
  say "benchmark=unicode_nfd phase=prepare variant=portable vm=" || vm_label,
      "rows=" || sources[0] "elapsed_us=" || prepare_us,
      "table_bytes=" || tables.byte_length() "int_bytes=" || <sizeof..int>

  do warmup = 1 to warmups
    actual_checksum = portable_pass(reference normalizer, reference sources)
    if actual_checksum \= checksum then return fail("portable warmup checksum")
  end

  samples = .int[]
  do sample = 1 to sample_count
    started = time("us")
    actual_checksum = portable_pass(reference normalizer, reference sources)
    elapsed = elapsed_us(started)
    if actual_checksum \= checksum then return fail("portable sample checksum")
    samples[sample] = elapsed
    say "benchmark=unicode_nfd phase=normalize variant=portable vm=" || vm_label,
        "sample=" || sample "rows=" || sources[0] "elapsed_us=" || elapsed,
        "checksum=" || actual_checksum
  end
  median = median_us(reference samples)
  say "benchmark=unicode_nfd phase=summary variant=portable vm=" || vm_label,
      "warmups=" || warmups "samples=" || sample_count "rows=" || sources[0],
      "median_us=" || median "checksum=" || checksum
  say "PASS: Unicode NFD portable performance cell"
  return 0

benchmark_portable_buffer: procedure = .int
  arg ast = .unicodegennorm2ast, source_ref = reference .string, expected_ref = reference .string, vm_label = .string, warmups = .int, sample_count = .int, repetitions = .int
  source = dereference source_ref
  expected = dereference expected_ref

  started = time("us")
  tables = unicode_nfd_compile(ast)
  if tables.status() \= 0 then return fail("portable table compiler: " || tables.error())
  normalizer = unicode_nfd_new(tables)
  if normalizer.status() \= 0 then return fail("portable table validation: " || normalizer.error())
  prepare_us = elapsed_us(started)

  checksum = portable_buffer_correctness(reference normalizer, reference source, reference expected)
  if checksum < 0 then return 1
  input_bytes = binlength(source as .binary)
  output_bytes = binlength(expected as .binary)
  input_scalars = string_scalars(source)
  output_scalars = string_scalars(expected)
  say "benchmark=unicode_nfd phase=prepare variant=portable vm=" || vm_label,
      "workload=buffer repetitions=" || repetitions,
      "input_utf8_bytes=" || input_bytes "output_utf8_bytes=" || output_bytes,
      "input_scalars=" || input_scalars "output_scalars=" || output_scalars,
      "elapsed_us=" || prepare_us "table_bytes=" || tables.byte_length(),
      "int_bytes=" || <sizeof..int>

  do warmup = 1 to warmups
    actual_checksum = portable_buffer_pass(reference normalizer, reference source)
    if actual_checksum \= checksum then return fail("portable buffer warmup checksum")
  end

  samples = .int[]
  do sample = 1 to sample_count
    started = time("us")
    actual_checksum = portable_buffer_pass(reference normalizer, reference source)
    elapsed = elapsed_us(started)
    if actual_checksum \= checksum then return fail("portable buffer sample checksum")
    samples[sample] = elapsed
    say "benchmark=unicode_nfd phase=normalize variant=portable vm=" || vm_label,
        "workload=buffer repetitions=" || repetitions "sample=" || sample,
        "input_utf8_bytes=" || input_bytes "elapsed_us=" || elapsed,
        "checksum_utf8_bytes=" || actual_checksum
  end
  median = median_us(reference samples)
  throughput = input_bytes * 1000000 <idiv> median
  say "benchmark=unicode_nfd phase=summary variant=portable vm=" || vm_label,
      "workload=buffer repetitions=" || repetitions,
      "warmups=" || warmups "samples=" || sample_count,
      "input_utf8_bytes=" || input_bytes "output_utf8_bytes=" || output_bytes,
      "median_us=" || median "input_utf8_bytes_per_second=" || throughput,
      "checksum_utf8_bytes=" || checksum
  say "PASS: Unicode NFD portable large-buffer performance cell"
  return 0

