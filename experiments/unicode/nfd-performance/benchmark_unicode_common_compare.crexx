canonical_certify_sources: procedure = .int
  arg normalizer_ref = reference .unicode_d..unicodednormalizer, sources_ref = reference .string[]
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
  do i = 1 to sources[0]
    if normalizer.is_normalized(sources[i]) \= 1 then,
      return fail_data("canonical certificate preparation", i, "normalized source rejected")
    if normalizer.status() \= 0 then,
      return fail_data("canonical certificate preparation", i, normalizer.error())
  end
  return 1

shared_certify_sources: procedure = .int
  arg normalizer_ref = reference .unicode_normalization..unicodednormalizer, sources_ref = reference .string[]
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
  do i = 1 to sources[0]
    if normalizer.is_normalized(sources[i]) \= 1 then,
      return fail_data("shared certificate preparation", i, "normalized source rejected")
    if normalizer.status() \= 0 then,
      return fail_data("shared certificate preparation", i, normalizer.error())
  end
  return 1

