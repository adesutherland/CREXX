benchmark_apple: procedure = .int
  arg sources_ref = reference .string[], expected_ref = reference .string[], operation = .string, vm_label = .string, workload = .string, repetitions = .int, warmups = .int, sample_count = .int
  sources = dereference sources_ref
  expected = dereference expected_ref
  mismatches = 0
  checksum = apple_correctness(reference sources, reference expected, operation, mismatches)
  if checksum < 0 then return 1
  call emit_prepare "apple", operation, vm_label, workload, repetitions, sources, 0, 0, checksum
  do warmup = 1 to warmups
    if apple_pass(reference sources, operation) \= checksum then return fail("Apple warmup checksum")
  end
  samples = .int[]
  do sample = 1 to sample_count
    started = time("us")
    actual = apple_pass(reference sources, operation)
    elapsed = elapsed_us(started)
    if actual \= checksum then return fail("Apple sample checksum")
    samples[sample] = elapsed
    call emit_sample "apple", operation, vm_label, workload, repetitions, sample, elapsed, actual
  end
  call emit_summary "apple", operation, vm_label, workload, repetitions, warmups, sample_count, sources, reference samples, checksum, mismatches
  return 0

canonical_normalization_correctness: procedure = .int
  arg normalizer_ref = reference .unicode_d..unicodednormalizer, sources_ref = reference .string[], expected_ref = reference .string[]
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
  expected = dereference expected_ref
  checksum = 0
  do i = 1 to sources[0]
    actual = normalizer.normalize(sources[i])
    if normalizer.status() \= 0 then return fail_data("canonical normalization", i, normalizer.error())
    if actual \== expected[i] then return fail_data("canonical normalization", i, "result mismatch")
    checksum = checksum + binlength(actual as .binary)
  end
  return checksum

shared_normalization_correctness: procedure = .int
  arg normalizer_ref = reference .unicode_normalization..unicodednormalizer, sources_ref = reference .string[], expected_ref = reference .string[]
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
  expected = dereference expected_ref
  checksum = 0
  do i = 1 to sources[0]
    actual = normalizer.normalize(sources[i])
    if normalizer.status() \= 0 then return fail_data("shared normalization", i, normalizer.error())
    if actual \== expected[i] then return fail_data("shared normalization", i, "result mismatch")
    checksum = checksum + binlength(actual as .binary)
  end
  return checksum

canonical_predicate_correctness: procedure = .int
  arg normalizer_ref = reference .unicode_d..unicodednormalizer, sources_ref = reference .string[], expected_ref = reference .string[]
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
  expected = dereference expected_ref
  checksum = 0
  do i = 1 to sources[0]
    expected_value = 0
    if sources[i] == expected[i] then expected_value = 1
    actual = normalizer.is_normalized(sources[i])
    if normalizer.status() \= 0 then return fail_data("canonical predicate", i, normalizer.error())
    if actual \= expected_value then return fail_data("canonical predicate", i, "result mismatch")
    checksum = checksum + (actual + 1) * i
  end
  return checksum

shared_predicate_correctness: procedure = .int
  arg normalizer_ref = reference .unicode_normalization..unicodednormalizer, sources_ref = reference .string[], expected_ref = reference .string[]
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
  expected = dereference expected_ref
  checksum = 0
  do i = 1 to sources[0]
    expected_value = 0
    if sources[i] == expected[i] then expected_value = 1
    actual = normalizer.is_normalized(sources[i])
    if normalizer.status() \= 0 then return fail_data("shared predicate", i, normalizer.error())
    if actual \= expected_value then return fail_data("shared predicate", i, "result mismatch")
    checksum = checksum + (actual + 1) * i
  end
  return checksum

