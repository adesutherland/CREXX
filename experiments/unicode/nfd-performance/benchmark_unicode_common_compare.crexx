apple_correctness: procedure = .int
  arg sources_ref = reference .string[], expected_ref = reference .string[], operation = .string, expose mismatches = .int
  sources = dereference sources_ref
  expected = dereference expected_ref
  i = .int
  actual = .string
  actual_predicate = .int
  expected_predicate = .int
  mismatches = 0
  checksum = 0
  if operation = "nfd" then do i = 1 to sources[0]
    actual = unicode_common_apple..normalize_nfd(sources[i])
    if actual \== expected[i] then mismatches = mismatches + 1
    checksum = checksum + binlength(actual as .binary)
  end
  else if operation = "nfkd" then do i = 1 to sources[0]
    actual = unicode_common_apple..normalize_nfkd(sources[i])
    if actual \== expected[i] then mismatches = mismatches + 1
    checksum = checksum + binlength(actual as .binary)
  end
  else if operation = "nfc" then do i = 1 to sources[0]
    actual = unicode_common_apple..normalize_nfc(sources[i])
    if actual \== expected[i] then mismatches = mismatches + 1
    checksum = checksum + binlength(actual as .binary)
  end
  else if operation = "nfkc" then do i = 1 to sources[0]
    actual = unicode_common_apple..normalize_nfkc(sources[i])
    if actual \== expected[i] then mismatches = mismatches + 1
    checksum = checksum + binlength(actual as .binary)
  end
  else if operation = "is-nfd" then do i = 1 to sources[0]
    expected_predicate = 0
    if sources[i] == expected[i] then expected_predicate = 1
    actual_predicate = unicode_common_apple..is_nfd(sources[i])
    if actual_predicate \= expected_predicate then mismatches = mismatches + 1
    checksum = checksum + (actual_predicate + 1) * i
  end
  else if operation = "is-nfkd" then do i = 1 to sources[0]
    expected_predicate = 0
    if sources[i] == expected[i] then expected_predicate = 1
    actual_predicate = unicode_common_apple..is_nfkd(sources[i])
    if actual_predicate \= expected_predicate then mismatches = mismatches + 1
    checksum = checksum + (actual_predicate + 1) * i
  end
  else if operation = "is-nfc" then do i = 1 to sources[0]
    expected_predicate = 0
    if sources[i] == expected[i] then expected_predicate = 1
    actual_predicate = unicode_common_apple..is_nfc(sources[i])
    if actual_predicate \= expected_predicate then mismatches = mismatches + 1
    checksum = checksum + (actual_predicate + 1) * i
  end
  else if operation = "is-nfkc" then do i = 1 to sources[0]
    expected_predicate = 0
    if sources[i] == expected[i] then expected_predicate = 1
    actual_predicate = unicode_common_apple..is_nfkc(sources[i])
    if actual_predicate \= expected_predicate then mismatches = mismatches + 1
    checksum = checksum + (actual_predicate + 1) * i
  end
  else if operation = "full" then do i = 1 to sources[0]
    actual = unicode_common_apple..fold_full(sources[i])
    if actual \== expected[i] then mismatches = mismatches + 1
    checksum = checksum + binlength(actual as .binary)
  end
  else if operation = "turkic-full" then do i = 1 to sources[0]
    actual = unicode_common_apple..fold_turkic_full(sources[i])
    if actual \== expected[i] then mismatches = mismatches + 1
    checksum = checksum + binlength(actual as .binary)
  end
  else return -1
  return checksum

apple_pass: procedure = .int
  arg sources_ref = reference .string[], operation = .string
  sources = dereference sources_ref
  i = .int
  actual = .string
  actual_predicate = .int
  checksum = 0
  if operation = "nfd" then do i = 1 to sources[0]
    actual = unicode_common_apple..normalize_nfd(sources[i])
    checksum = checksum + binlength(actual as .binary)
  end
  else if operation = "nfkd" then do i = 1 to sources[0]
    actual = unicode_common_apple..normalize_nfkd(sources[i])
    checksum = checksum + binlength(actual as .binary)
  end
  else if operation = "nfc" then do i = 1 to sources[0]
    actual = unicode_common_apple..normalize_nfc(sources[i])
    checksum = checksum + binlength(actual as .binary)
  end
  else if operation = "nfkc" then do i = 1 to sources[0]
    actual = unicode_common_apple..normalize_nfkc(sources[i])
    checksum = checksum + binlength(actual as .binary)
  end
  else if operation = "is-nfd" then do i = 1 to sources[0]
    actual_predicate = unicode_common_apple..is_nfd(sources[i])
    checksum = checksum + (actual_predicate + 1) * i
  end
  else if operation = "is-nfkd" then do i = 1 to sources[0]
    actual_predicate = unicode_common_apple..is_nfkd(sources[i])
    checksum = checksum + (actual_predicate + 1) * i
  end
  else if operation = "is-nfc" then do i = 1 to sources[0]
    actual_predicate = unicode_common_apple..is_nfc(sources[i])
    checksum = checksum + (actual_predicate + 1) * i
  end
  else if operation = "is-nfkc" then do i = 1 to sources[0]
    actual_predicate = unicode_common_apple..is_nfkc(sources[i])
    checksum = checksum + (actual_predicate + 1) * i
  end
  else if operation = "full" then do i = 1 to sources[0]
    actual = unicode_common_apple..fold_full(sources[i])
    checksum = checksum + binlength(actual as .binary)
  end
  else if operation = "turkic-full" then do i = 1 to sources[0]
    actual = unicode_common_apple..fold_turkic_full(sources[i])
    checksum = checksum + binlength(actual as .binary)
  end
  else return -1
  return checksum

load_normalization_rows: procedure = .int
  arg path = .string, operation = .string, sources_ref = reference .string[], expected_ref = reference .string[]
  sources = dereference sources_ref
  expected = dereference expected_ref
  expected_field = 3
  if operation = "nfc" then expected_field = 2
  else if operation = "nfkc" then expected_field = 4
  else if operation = "nfkd" then expected_field = 5
  lines = readlines(path)
  do line_number = 1 to lines[0]
    line = strip(lines[line_number])
    if line = "" | left(line, 1) = "#" | left(line, 1) = "@" then iterate
    fields = qsplit(line, ";")
    if fields[0] < 5 then return fail("invalid normalization row at line " || line_number)
    row = sources[0] + 1
    sources[row] = hex_sequence_to_string(strip(fields[1]))
    expected[row] = hex_sequence_to_string(strip(fields[expected_field]))
  end
  if sources[0] \= 20034 | expected[0] \= 20034 then,
    return fail("unexpected normalization row count")
  return 0

load_casefold_rows: procedure = .int
  arg tables = .unicode_casefold..unicodecasefoldtables, operation = .string, sources_ref = reference .string[], expected_ref = reference .string[]
  sources = dereference sources_ref
  expected = dereference expected_ref
  turkic = operation = "turkic-simple" | operation = "turkic-full"
  full = operation = "full" | operation = "turkic-full"
  do record_index = 0 to tables.record_count() - 1
    row = record_index + 1
    source_codepoint = tables.record_source(record_index)
    sources[row] = ""
    assembler appendchar sources[row],source_codepoint
    if full then expected[row] = tables.expected_full(record_index, turkic)
    else do
      mapped_codepoint = tables.expected_simple(record_index, turkic)
      expected[row] = ""
      assembler appendchar expected[row],mapped_codepoint
    end
  end
  if sources[0] \= 1585 | expected[0] \= 1585 then,
    return fail("unexpected CaseFolding record count")
  return 0

build_large_buffers: procedure = .void
  arg sources_ref = reference .string[], expected_ref = reference .string[], repetitions = .int, expose source_buffer = .string, expose expected_buffer = .string
  sources = dereference sources_ref
  expected = dereference expected_ref
  source_block = arrayjoin(sources, " ") || " "
  expected_block = arrayjoin(expected, " ") || " "
  source_buffer = copies(source_block, repetitions)
  expected_buffer = copies(expected_block, repetitions)
  return

/** Re-materialize normalized strings through the validated binary-to-text boundary.
 *  This deliberately begins non-ASCII strings without a normalization certificate;
 *  the conversion and array writes happen outside the timed interval. */
reset_normalized_sources: procedure = .void
  arg expected_ref = reference .string[], sources_ref = reference .string[]
  expected = dereference expected_ref
  sources = dereference sources_ref
  call arraydrop sources
  do i = 1 to expected[0]
    source_bytes = expected[i] as .binary
    sources[i] = source_bytes as .string
  end
  return

emit_prepare: procedure = .void
  arg variant = .string, operation = .string, vm_label = .string, workload = .string, repetitions = .int, sources = .string[], prepare_us = .int, table_bytes = .int, checksum = .int
  checksum_field = "checksum_utf8_bytes=" || checksum
  if left(operation, 3) = "is-" then checksum_field = "checksum_true_weight=" || checksum
  say "benchmark=unicode_common_compare phase=prepare variant=" || variant,
      "operation=" || operation "vm=" || vm_label "workload=" || workload,
      "repetitions=" || repetitions "units=" || sources[0],
      "input_utf8_bytes=" || input_bytes(reference sources),
      "elapsed_us=" || prepare_us "table_bytes=" || table_bytes,
      checksum_field
  return

emit_sample: procedure = .void
  arg variant = .string, operation = .string, vm_label = .string, workload = .string, repetitions = .int, sample = .int, elapsed = .int, checksum = .int
  checksum_field = "checksum_utf8_bytes=" || checksum
  if left(operation, 3) = "is-" then checksum_field = "checksum_true_weight=" || checksum
  say "benchmark=unicode_common_compare phase=transform variant=" || variant,
      "operation=" || operation "vm=" || vm_label "workload=" || workload,
      "repetitions=" || repetitions "sample=" || sample,
      "elapsed_us=" || elapsed checksum_field
  return

emit_summary: procedure = .void
  arg variant = .string, operation = .string, vm_label = .string, workload = .string, repetitions = .int, warmups = .int, sample_count = .int, sources = .string[], samples_ref = reference .int[], checksum = .int, mismatches = .int
  bytes = input_bytes(reference sources)
  median = median_us(samples_ref)
  throughput = bytes * 1000000 <idiv> median
  checksum_field = "checksum_utf8_bytes=" || checksum
  if left(operation, 3) = "is-" then checksum_field = "checksum_true_weight=" || checksum
  say "benchmark=unicode_common_compare phase=summary variant=" || variant,
      "operation=" || operation "vm=" || vm_label "workload=" || workload,
      "repetitions=" || repetitions "warmups=" || warmups,
      "samples=" || sample_count "units=" || sources[0],
      "input_utf8_bytes=" || bytes "median_us=" || median,
      "input_utf8_bytes_per_second=" || throughput,
      checksum_field,
      "unicode17_mismatches=" || mismatches
  return

input_bytes: procedure = .int
  arg sources_ref = reference .string[]
  sources = dereference sources_ref
  result = 0
  do i = 1 to sources[0]
    result = result + binlength(sources[i] as .binary)
  end
  return result

median_us: procedure = .int
  arg values_ref = reference .int[]
  values = snapshot values_ref
  do i = 2 to values[0]
    current = values[i]
    j = i - 1
    do while j >= 1 & values[j] > current
      values[j + 1] = values[j]
      j = j - 1
    end
    values[j + 1] = current
  end
  middle = values[0] <idiv> 2
  if values[0] <mod> 2 = 1 then return values[middle + 1]
  return (values[middle] + values[middle + 1]) <idiv> 2

elapsed_us: procedure = .int
  arg started = .int
  elapsed = time("us") - started
  if elapsed < 0 then elapsed = elapsed + 86400000000
  return elapsed

hex_sequence_to_string: procedure = .string
  arg sequence = .string
  result = ""
  do i = 1 to words(sequence)
    codepoint = x2d(word(sequence, i))
    assembler appendchar result,codepoint
  end
  return result

fail_data: procedure = .int
  arg label = .string, row = .int, message = .string
  say "FAIL:" label "row" row || ":" message
  return -1

fail: procedure = .int
  arg message = .string
  say "FAIL:" message
  return 1
