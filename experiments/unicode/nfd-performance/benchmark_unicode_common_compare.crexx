/* Correctness-gated common-table comparison across explicit Unicode services. */
options levelb

import rxfnsb
import unicode_data
import unicode_normprops
import unicode_d
import unicode_casefold
import unicode_normalization
import unicode_common_apple

arg argv = .string[]
if argv[0] \= 11 then do
  say "usage: benchmark_unicode_common_compare variant operation vm UnicodeData.txt DerivedNormalizationProps.txt NormalizationTest.txt CaseFolding.txt warmups samples rows|buffer repetitions"
  return 2
end

variant = argv[1]
operation = argv[2]
vm_label = argv[3]
unicode_data_path = argv[4]
normalization_properties_path = argv[5]
normalization_test_path = argv[6]
casefold_path = argv[7]
warmups = argv[8] as .int
sample_count = argv[9] as .int
workload = argv[10]
repetitions = argv[11] as .int

implementation_variant = variant
cache_mode = "ordinary"
if variant = "shared-cold" then do
  implementation_variant = "shared"
  cache_mode = "cold"
end
else if variant = "shared-hit" then do
  implementation_variant = "shared"
  cache_mode = "hit"
end
if implementation_variant \= "canonical" &,
   implementation_variant \= "shared" &,
   implementation_variant \= "apple" then,
  return fail("variant must be canonical, shared, apple, shared-cold, or shared-hit")
if operation \= "nfd" & operation \= "nfkd" &,
   operation \= "nfc" & operation \= "nfkc" &,
   operation \= "is-nfd" & operation \= "is-nfkd" &,
   operation \= "is-nfc" & operation \= "is-nfkc" &,
   operation \= "simple" & operation \= "full" &,
   operation \= "turkic-simple" & operation \= "turkic-full" then,
  return fail("unknown Unicode operation")
if implementation_variant = "apple" &,
   (operation = "simple" | operation = "turkic-simple") then,
  return fail("CoreFoundation has no exact simple case-fold operation")
if warmups < 0 | sample_count < 1 then,
  return fail("invalid warmup or sample count")
if workload \= "rows" & workload \= "buffer" then,
  return fail("workload must be rows or buffer")
if workload = "rows" & repetitions \= 0 then,
  return fail("row workload repetitions must be zero")
if workload = "buffer" & repetitions < 1 then,
  return fail("buffer repetitions must be positive")

sources = .string[]
expected = .string[]
source_buffer = .string
expected_buffer = .string
started = .int
prepare_us = .int
is_normalization = operation = "nfd" | operation = "nfkd" |,
                   operation = "nfc" | operation = "nfkc" |,
                   operation = "is-nfd" | operation = "is-nfkd" |,
                   operation = "is-nfc" | operation = "is-nfkc"
is_predicate = left(operation, 3) = "is-"
normalization_form = operation
if is_predicate then normalization_form = substr(operation, 4)
if cache_mode \= "ordinary" & \is_normalization then,
  return fail("certificate variants apply only to normalization operations")

if is_normalization then do
  if load_normalization_rows(normalization_test_path, normalization_form, reference sources, reference expected) \= 0 then return 1
  ucd = unicode_data_parse(unicode_data_path, "17.0.0")
  if ucd.status() \= 0 then,
    return fail("UnicodeData parser line " || ucd.error_line() || ": " || ucd.error())
  properties = unicode_normprops_parse(normalization_properties_path, "17.0.0")
  if properties.status() \= 0 then,
    return fail("normalization-property parser line " || properties.error_line() || ": " || properties.error())
  canonical_tables = unicode_norm_compile(ucd, properties)
  if canonical_tables.status() \= 0 then,
    return fail("canonical normalization table compiler: " || canonical_tables.error())
  if workload = "buffer" then do
    call build_large_buffers reference sources, reference expected, repetitions, source_buffer, expected_buffer
    call arraydrop sources
    call arraydrop expected
    if is_predicate then source_buffer = expected_buffer
    sources[1] = source_buffer
    expected[1] = expected_buffer
  end
  if implementation_variant = "canonical" then do
    started = time("us")
    canonical_normalizer = unicode_d_new(canonical_tables, upper(normalization_form))
    prepare_us = elapsed_us(started)
    if is_predicate then,
      return benchmark_canonical_predicate(reference canonical_normalizer, reference sources, reference expected, operation, vm_label, workload, repetitions, warmups, sample_count, prepare_us, canonical_tables.byte_length(), variant, cache_mode)
    return benchmark_canonical_normalization(reference canonical_normalizer, reference sources, reference expected, operation, vm_label, workload, repetitions, warmups, sample_count, prepare_us, canonical_tables.byte_length(), variant, cache_mode)
  end
  if implementation_variant = "shared" then do
    started = time("us")
    shared_normalizer = unicode_normalizer_new(upper(normalization_form))
    prepare_us = elapsed_us(started)
    if is_predicate then,
      return benchmark_shared_predicate(reference shared_normalizer, reference sources, reference expected, operation, vm_label, workload, repetitions, warmups, sample_count, prepare_us, variant, cache_mode)
    return benchmark_shared_normalization(reference shared_normalizer, reference sources, reference expected, operation, vm_label, workload, repetitions, warmups, sample_count, prepare_us, variant, cache_mode)
  end
  return benchmark_apple(reference sources, reference expected, operation, vm_label, workload, repetitions, warmups, sample_count)
end

fold_tables = unicode_casefold_compile(casefold_path, "17.0.0")
if fold_tables.status() \= 0 then,
  return fail("CaseFolding parser line " || fold_tables.error_line() || ": " || fold_tables.error())
if load_casefold_rows(fold_tables, operation, reference sources, reference expected) \= 0 then return 1
if workload = "buffer" then do
  call build_large_buffers reference sources, reference expected, repetitions, source_buffer, expected_buffer
  call arraydrop sources
  call arraydrop expected
  sources[1] = source_buffer
  expected[1] = expected_buffer
end
mode = upper(changestr("-", operation, "_"))
if implementation_variant = "canonical" then do
  started = time("us")
  canonical_folder = unicode_casefold_new(fold_tables, mode)
  prepare_us = elapsed_us(started)
  return benchmark_canonical_casefold(reference canonical_folder, reference sources, reference expected, operation, vm_label, workload, repetitions, warmups, sample_count, prepare_us, fold_tables.byte_length())
end
if implementation_variant = "shared" then do
  started = time("us")
  shared_folder = unicode_casefolder_new(mode)
  prepare_us = elapsed_us(started)
  return benchmark_shared_casefold(reference shared_folder, reference sources, reference expected, operation, vm_label, workload, repetitions, warmups, sample_count, prepare_us)
end
return benchmark_apple(reference sources, reference expected, operation, vm_label, workload, repetitions, warmups, sample_count)

benchmark_canonical_normalization: procedure = .int
  arg normalizer_ref = reference .unicode_d..unicodednormalizer, sources_ref = reference .string[], expected_ref = reference .string[], operation = .string, vm_label = .string, workload = .string, repetitions = .int, warmups = .int, sample_count = .int, prepare_us = .int, table_bytes = .int, variant = .string, cache_mode = .string
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
  expected = dereference expected_ref
  if cache_mode \= "ordinary" then,
    call reset_normalized_sources reference expected, reference sources
  if cache_mode = "hit" then,
    if canonical_certify_sources(reference normalizer, reference sources) \= 1 then return 1
  checksum = canonical_normalization_correctness(reference normalizer, reference sources, reference expected)
  if checksum < 0 then return 1
  call emit_prepare variant, operation, vm_label, workload, repetitions, sources, prepare_us, table_bytes, checksum
  do warmup = 1 to warmups
    if cache_mode = "cold" then,
      call reset_normalized_sources reference expected, reference sources
    if canonical_normalization_pass(reference normalizer, reference sources) \= checksum then return fail("canonical normalization warmup checksum")
  end
  samples = .int[]
  do sample = 1 to sample_count
    if cache_mode = "cold" then,
      call reset_normalized_sources reference expected, reference sources
    started = time("us")
    actual = canonical_normalization_pass(reference normalizer, reference sources)
    elapsed = elapsed_us(started)
    if actual \= checksum then return fail("canonical normalization sample checksum")
    samples[sample] = elapsed
    call emit_sample variant, operation, vm_label, workload, repetitions, sample, elapsed, actual
  end
  call emit_summary variant, operation, vm_label, workload, repetitions, warmups, sample_count, sources, reference samples, checksum, 0
  return 0

benchmark_shared_normalization: procedure = .int
  arg normalizer_ref = reference .unicode_normalization..unicodednormalizer, sources_ref = reference .string[], expected_ref = reference .string[], operation = .string, vm_label = .string, workload = .string, repetitions = .int, warmups = .int, sample_count = .int, prepare_us = .int, variant = .string, cache_mode = .string
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
  expected = dereference expected_ref
  if cache_mode \= "ordinary" then,
    call reset_normalized_sources reference expected, reference sources
  if cache_mode = "hit" then,
    if shared_certify_sources(reference normalizer, reference sources) \= 1 then return 1
  checksum = shared_normalization_correctness(reference normalizer, reference sources, reference expected)
  if checksum < 0 then return 1
  call emit_prepare variant, operation, vm_label, workload, repetitions, sources, prepare_us, 11237664, checksum
  do warmup = 1 to warmups
    if cache_mode = "cold" then,
      call reset_normalized_sources reference expected, reference sources
    if shared_normalization_pass(reference normalizer, reference sources) \= checksum then return fail("shared normalization warmup checksum")
  end
  samples = .int[]
  do sample = 1 to sample_count
    if cache_mode = "cold" then,
      call reset_normalized_sources reference expected, reference sources
    started = time("us")
    actual = shared_normalization_pass(reference normalizer, reference sources)
    elapsed = elapsed_us(started)
    if actual \= checksum then return fail("shared normalization sample checksum")
    samples[sample] = elapsed
    call emit_sample variant, operation, vm_label, workload, repetitions, sample, elapsed, actual
  end
  call emit_summary variant, operation, vm_label, workload, repetitions, warmups, sample_count, sources, reference samples, checksum, 0
  return 0

