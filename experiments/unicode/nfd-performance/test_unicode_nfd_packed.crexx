/* Complete Unicode 17.0.0 NFD conformance proof for the packed control. */
options levelb

import rxfnsb
import level_l_gennorm2
import unicode_gennorm2
import unicode_nfd_packed

arg argv = .string[]
i = .int
actual = .string
if argv[0] \= 2 then do
  say "usage: test_unicode_nfd_packed nfc.txt NormalizationTest.txt"
  return 2
end

rules_source = loadtext(argv[1], "0a"x)
tokens = level_l_gennorm2_lex(rules_source)
if level_l_gennorm2_status() \= 0 then do
  say "FAIL: gennorm2 lexer:" level_l_gennorm2_error_message()
  return 1
end
parse_result = unicode_gennorm2_parse(rules_source, tokens)
if parse_result.status() \= 0 then do
  say "FAIL: gennorm2 parser line" parse_result.error_line() || ":" parse_result.error()
  return 1
end

tables = unicode_nfd_packed_compile(parse_result.ast())
if tables.status() \= 0 then do
  say "FAIL: packed NFD table compiler:" tables.error()
  return 1
end
expected_table_bytes = 1134267 * <sizeof..int>
if tables.byte_length() \= expected_table_bytes then do
  say "FAIL: packed NFD table byte length expected" expected_table_bytes "got" tables.byte_length()
  return 1
end

normalizer = unicode_nfd_packed_new(tables)
if normalizer.status() \= 0 then do
  say "FAIL: packed NFD table validation:" normalizer.error()
  return 1
end

failures = 0
failures = failures + expect_nfd(reference normalizer, "empty", "", "")
failures = failures + expect_nfd(reference normalizer, "ASCII identity", "0041 006C 0070 0068 0061", "0041 006C 0070 0068 0061")
failures = failures + expect_nfd(reference normalizer, "Latin decomposition", "00C0", "0041 0300")
failures = failures + expect_nfd(reference normalizer, "recursive decomposition", "01FA", "0041 030A 0301")
failures = failures + expect_nfd(reference normalizer, "canonical ordering", "0061 0315 0300", "0061 0300 0315")
failures = failures + expect_nfd(reference normalizer, "Hangul LV", "AC00", "1100 1161")
failures = failures + expect_nfd(reference normalizer, "Hangul LVT", "AC01", "1100 1161 11A8")
failures = failures + expect_nfd(reference normalizer, "non-BMP identity", "01F600", "01F600")
if normalizer.combining_class(0x0300) \= 230 | normalizer.combining_class(0x0041) \= 0 then do
  say "FAIL: packed canonical combining-class lookup"
  failures = failures + 1
end

cycle_source = "* Unicode 17.0.0" || "0a"x || "0300:230" || "0a"x ||,
               "0041>0042" || "0a"x || "0042>0041" || "0a"x
cycle_tokens = level_l_gennorm2_lex(cycle_source)
cycle_parse = unicode_gennorm2_parse(cycle_source, cycle_tokens)
if cycle_parse.status() \= 0 then do
  say "FAIL: packed cycle fixture parser:" cycle_parse.error()
  failures = failures + 1
end
else do
  cycle_tables = unicode_nfd_packed_compile(cycle_parse.ast())
  cycle_normalizer = unicode_nfd_packed_new(cycle_tables)
  ignored = cycle_normalizer.normalize("A")
  if cycle_normalizer.status() \= 1 |,
     cycle_normalizer.error() \= "cyclic or excessively deep decomposition mapping" then do
    say "FAIL: packed cyclic mapping was not rejected precisely"
    failures = failures + 1
  end
end

if failures \= 0 then return 1

part1_seen = .binary
call binresize part1_seen, 0x110000
part_rows = .int[]
do i = 1 to 6
  part_rows[i] = 0
end
invariant_checks = 0
part = -1
failure = ""

lines = readlines(argv[2])
do line_number = 1 to lines[0] while failure = ""
  line = strip(lines[line_number])
  if line = "" | left(line, 1) = "#" then iterate

  if left(line, 5) = "@Part" then do
    if length(line) < 6 then do
      failure = "invalid part marker at line " || line_number
      leave
    end
    next_part = c2d(substr(line, 6, 1)) - 48
    if next_part < 0 | next_part > 5 | next_part \= part + 1 then do
      failure = "unexpected part marker at line " || line_number
      leave
    end
    part = next_part
    iterate
  end

  if part < 0 | part > 5 then do
    failure = "test row precedes a valid part marker at line " || line_number
    leave
  end

  fields = qsplit(line, ";")
  if fields[0] < 5 then do
    failure = "invalid normalization row at line " || line_number
    leave
  end
  field1 = strip(fields[1])
  field2 = strip(fields[2])
  field3 = strip(fields[3])
  field4 = strip(fields[4])
  field5 = strip(fields[5])
  if field1 = "" | field2 = "" | field3 = "" | field4 = "" | field5 = "" then do
    failure = "invalid normalization row at line " || line_number
    leave
  end

  c1 = hex_sequence_to_string(field1)
  c2 = hex_sequence_to_string(field2)
  c3 = hex_sequence_to_string(field3)
  c4 = hex_sequence_to_string(field4)
  c5 = hex_sequence_to_string(field5)

  actual = normalizer.normalize(c1)
  if normalizer.status() \= 0 then failure = "toNFD(c1) error at line " || line_number || ": " || normalizer.error()
  else if actual \== c3 then failure = relation_failure("toNFD(c1) == c3", line_number, actual, c3)

  if failure = "" then do
    actual = normalizer.normalize(c2)
    if normalizer.status() \= 0 then failure = "toNFD(c2) error at line " || line_number || ": " || normalizer.error()
    else if actual \== c3 then failure = relation_failure("toNFD(c2) == c3", line_number, actual, c3)
  end
  if failure = "" then do
    actual = normalizer.normalize(c3)
    if normalizer.status() \= 0 then failure = "toNFD(c3) error at line " || line_number || ": " || normalizer.error()
    else if actual \== c3 then failure = relation_failure("toNFD(c3) == c3", line_number, actual, c3)
  end
  if failure = "" then do
    actual = normalizer.normalize(c4)
    if normalizer.status() \= 0 then failure = "toNFD(c4) error at line " || line_number || ": " || normalizer.error()
    else if actual \== c5 then failure = relation_failure("toNFD(c4) == c5", line_number, actual, c5)
  end
  if failure = "" then do
    actual = normalizer.normalize(c5)
    if normalizer.status() \= 0 then failure = "toNFD(c5) error at line " || line_number || ": " || normalizer.error()
    else if actual \== c5 then failure = relation_failure("toNFD(c5) == c5", line_number, actual, c5)
  end
  if failure \= "" then leave

  if part = 1 then do
    if words(field1) \= 1 then do
      failure = "Part 1 source is not one code point at line " || line_number
      leave
    end
    part1_source = x2d(field1)
    <at..u8>(part1_source) part1_seen = 1
  end
  part_rows[part + 1] = part_rows[part + 1] + 1
  invariant_checks = invariant_checks + 5
end

if failure = "" & part \= 5 then failure = "normalization test ended before Part 5"
if failure = "" then do
  expected_parts = .int[]
  expected_parts[1] = 45
  expected_parts[2] = 17086
  expected_parts[3] = 1936
  expected_parts[4] = 194
  expected_parts[5] = 735
  expected_parts[6] = 38
  do i = 1 to 6 while failure = ""
    if part_rows[i] \= expected_parts[i] then,
      failure = "unexpected row count for Part " || (i - 1)
  end
end
if failure \= "" then do
  say "FAIL:" failure
  return 1
end

unlisted_identity_checks = 0
batch_count = 0
batch = ""
starter = 65
do codepoint = 0 to 0x10FFFF while failure = ""
  if codepoint >= 0xD800 & codepoint <= 0xDFFF then iterate
  if <at..u8>(codepoint) part1_seen \= 0 then iterate
  assembler appendchar batch,starter
  assembler appendchar batch,codepoint
  batch_count = batch_count + 1
  unlisted_identity_checks = unlisted_identity_checks + 1
  if batch_count = 4096 then do
    actual = normalizer.normalize(batch)
    if normalizer.status() \= 0 then failure = "unlisted identity normalization error: " || normalizer.error()
    else if actual \== batch then failure = "unlisted scalar batch is not an NFD identity near U+" || right(d2x(codepoint), 6, "0")
    batch = ""
    batch_count = 0
  end
end
if failure = "" & batch_count > 0 then do
  actual = normalizer.normalize(batch)
  if normalizer.status() \= 0 then failure = "unlisted identity normalization error: " || normalizer.error()
  else if actual \== batch then failure = "final unlisted scalar batch is not an NFD identity"
end
if failure = "" & unlisted_identity_checks \= 1094978 then,
  failure = "unexpected unlisted scalar identity count"
if failure \= "" then do
  say "FAIL:" failure
  return 1
end

say "Unicode version:" tables.version()
say "NFD table format: crexx-nfd-host-packed-int-v1"
say "Packed int bytes:" tables.int_size()
say "NFD table bytes:" tables.byte_length()
say "gennorm2 ccc records/code points:" tables.ccc_record_count() || "/" || tables.ccc_codepoint_count()
say "gennorm2 two-way/one-way mappings:" tables.two_way_count() || "/" || tables.one_way_count()
say "gennorm2 mapping values:" tables.mapping_value_count()
say "NormalizationTest rows by Part 0..5:" part_rows[1] || "/" || part_rows[2] || "/" || part_rows[3] || "/" || part_rows[4] || "/" || part_rows[5] || "/" || part_rows[6]
say "NFD corpus invariant checks:" invariant_checks
say "Unlisted scalar identity checks:" unlisted_identity_checks
say "Focused packed NFD fixtures: PASS"
say "Result: PASS"
return 0

expect_nfd: procedure = .int
  arg normalizer_ref = reference .unicode_nfd_packed..unicodenfdpackednormalizer, label = .string, source_hex = .string, expected_hex = .string
  normalizer = dereference normalizer_ref
  source = hex_sequence_to_string(source_hex)
  expected = hex_sequence_to_string(expected_hex)
  actual = normalizer.normalize(source)
  if normalizer.status() \= 0 then do
    say "FAIL:" label || ":" normalizer.error()
    return 1
  end
  if actual == expected then return 0
  say "FAIL:" label "expected" string_to_hex_sequence(expected) "got" string_to_hex_sequence(actual)
  return 1

hex_sequence_to_string: procedure = .string
  arg sequence = .string
  result = ""
  do i = 1 to words(sequence)
    codepoint = x2d(word(sequence, i))
    assembler appendchar result,codepoint
  end
  return result

string_to_hex_sequence: procedure = .string
  arg value = .string
  result = ""
  value_length = 0
  assembler strlen value_length,value
  do i = 0 to value_length - 1
    codepoint = 0
    assembler strchar codepoint,value,i
    if result \= "" then result = result || " "
    width = 4
    if codepoint > 0xFFFF then width = 6
    result = result || right(d2x(codepoint), width, "0")
  end
  return result

relation_failure: procedure = .string
  arg relation = .string, line_number = .int, actual = .string, expected = .string
  return relation || " failed at line " || line_number || ": expected [" ||,
         string_to_hex_sequence(expected) || "] got [" || string_to_hex_sequence(actual) || "]"
