      "output_utf8_bytes=" || checksum "median_us=" || median,
      "input_utf8_bytes_per_second=" || throughput
  say "PASS: generated prepared NFD rough buffer cell"
  return 0

original_rows_correctness: procedure = .int
  arg normalizer_ref = reference .unicode_nfd..unicodenfdnormalizer, sources_ref = reference .string[], expected_ref = reference .string[]
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
  expected = dereference expected_ref
  checksum = 0
  do i = 1 to sources[0]
    actual = normalizer.normalize(sources[i])
    if normalizer.status() \= 0 then return fail_row("original-nfd", i, normalizer.error())
    if actual \== expected[i] then return fail_row("original-nfd", i, "result mismatch")
    checksum = checksum + string_scalars(actual)
  end
  return checksum

prepared_rows_correctness: procedure = .int
  arg normalizer_ref = reference .unicode_d..unicodednormalizer, sources_ref = reference .string[], expected_ref = reference .string[], variant = .string
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
  expected = dereference expected_ref
  checksum = 0
  do i = 1 to sources[0]
    actual = normalizer.normalize(sources[i])
    if normalizer.status() \= 0 then return fail_row(variant, i, normalizer.error())
    if actual \== expected[i] then return fail_row(variant, i, "result mismatch")
    checksum = checksum + string_scalars(actual)
  end
  return checksum

generated_rows_correctness: procedure = .int
  arg normalizer_ref = reference .level_l_unicode_nfd..levellunicodenfdnormalizer, sources_ref = reference .string[], expected_ref = reference .string[]
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
  expected = dereference expected_ref
  checksum = 0
  do i = 1 to sources[0]
    actual = normalizer.normalize(sources[i])
    if actual \== expected[i] then return fail_row("generated-nfd", i, "result mismatch")
    checksum = checksum + string_scalars(actual)
  end
  return checksum

original_rows_pass: procedure = .int
  arg normalizer_ref = reference .unicode_nfd..unicodenfdnormalizer, sources_ref = reference .string[]
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
  checksum = 0
  do i = 1 to sources[0]
    actual = normalizer.normalize(sources[i])
    checksum = checksum + string_scalars(actual)
  end
  return checksum

prepared_rows_pass: procedure = .int
  arg normalizer_ref = reference .unicode_d..unicodednormalizer, sources_ref = reference .string[]
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
  checksum = 0
  do i = 1 to sources[0]
    actual = normalizer.normalize(sources[i])
    checksum = checksum + string_scalars(actual)
  end
  return checksum

generated_rows_pass: procedure = .int
  arg normalizer_ref = reference .level_l_unicode_nfd..levellunicodenfdnormalizer, sources_ref = reference .string[]
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
  checksum = 0
  do i = 1 to sources[0]
    actual = normalizer.normalize(sources[i])
