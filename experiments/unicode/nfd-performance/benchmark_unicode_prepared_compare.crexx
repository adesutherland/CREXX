benchmark_original_buffer: procedure = .int
  arg ast = .unicodegennorm2ast, source_ref = reference .string, expected_ref = reference .string, vm_label = .string, warmups = .int, sample_count = .int, repetitions = .int
  actual_checksum = .int
  source = dereference source_ref
  expected = dereference expected_ref
  started = time("us")
  tables = unicode_nfd_compile(ast)
  if tables.status() \= 0 then return fail("original table compiler: " || tables.error())
  normalizer = unicode_nfd_new(tables)
  if normalizer.status() \= 0 then return fail("original table validation: " || normalizer.error())
  prepare_us = elapsed_us(started)
  checksum = original_buffer_correctness(reference normalizer, reference source, reference expected)
  if checksum < 0 then return 1
  input_bytes = binlength(source as .binary)
  say "benchmark=unicode_prepared_compare phase=prepare variant=original-nfd vm=" || vm_label,
      "workload=buffer repetitions=" || repetitions "input_utf8_bytes=" || input_bytes,
      "output_utf8_bytes=" || checksum "elapsed_us=" || prepare_us,
      "table_bytes=" || tables.byte_length()
  do warmup = 1 to warmups
    actual_checksum = original_buffer_pass(reference normalizer, reference source)
    if actual_checksum \= checksum then return fail("original NFD buffer warmup checksum")
  end
  samples = .int[]
  do sample = 1 to sample_count
    started = time("us")
    actual_checksum = original_buffer_pass(reference normalizer, reference source)
    elapsed = elapsed_us(started)
    if actual_checksum \= checksum then return fail("original NFD buffer sample checksum")
    samples[sample] = elapsed
    say "benchmark=unicode_prepared_compare phase=normalize variant=original-nfd vm=" || vm_label,
        "workload=buffer repetitions=" || repetitions "sample=" || sample,
        "input_utf8_bytes=" || input_bytes "elapsed_us=" || elapsed,
        "checksum_utf8_bytes=" || actual_checksum
  end
  median = median_us(reference samples)
  throughput = input_bytes * 1000000 <idiv> median
  say "benchmark=unicode_prepared_compare phase=summary variant=original-nfd vm=" || vm_label,
      "workload=buffer repetitions=" || repetitions "warmups=" || warmups,
      "samples=" || sample_count "input_utf8_bytes=" || input_bytes,
      "output_utf8_bytes=" || checksum "median_us=" || median,
      "input_utf8_bytes_per_second=" || throughput
  say "PASS: original scalar NFD rough buffer cell"
  return 0

