/* Rough correctness-gated comparison of scalar and prepared normalization. */
options levelb

import rxfnsb
import level_l_gennorm2
import unicode_gennorm2
import unicode_nfd
import unicode_data
import unicode_normprops
import unicode_d
import level_l_unicode_nfd

arg argv = .string[]
if argv[0] \= 10 then do
  say "usage: benchmark_unicode_prepared_compare variant vm nfc.txt UnicodeData.txt DerivedNormalizationProps.txt NormalizationTest.txt warmups samples rows|buffer repetitions"
  return 2
end

variant = argv[1]
vm_label = argv[2]
nfc_path = argv[3]
unicode_data_path = argv[4]
normalization_properties_path = argv[5]
normalization_test_path = argv[6]
warmups = argv[7] as .int
sample_count = argv[8] as .int
workload = argv[9]
repetitions = argv[10] as .int

if variant \= "original-nfd" & variant \= "generated-nfd" &,
   variant \= "prepared-nfd" & variant \= "prepared-nfc" then,
  return fail("variant must be original-nfd, generated-nfd, prepared-nfd, or prepared-nfc")
if warmups < 0 then return fail("warmups must be non-negative")
if sample_count < 1 then return fail("samples must be positive")
if workload \= "rows" & workload \= "buffer" then,
  return fail("workload must be rows or buffer")
if workload = "rows" & repetitions \= 0 then,
  return fail("row workload repetitions must be zero")
if workload = "buffer" & repetitions < 1 then,
  return fail("buffer repetitions must be positive")

sources = .string[]
expected = .string[]
lines = readlines(normalization_test_path)
do line_number = 1 to lines[0]
  line = strip(lines[line_number])
  if line = "" | left(line, 1) = "#" | left(line, 1) = "@" then iterate
  fields = qsplit(line, ";")
  if fields[0] < 3 then return fail("invalid normalization row at line " || line_number)
  expected_field = 3
  if variant = "prepared-nfc" then expected_field = 2
  source_hex = strip(fields[1])
  expected_hex = strip(fields[expected_field])
  if source_hex = "" | expected_hex = "" then,
    return fail("empty normalization field at line " || line_number)
  row = sources[0] + 1
  sources[row] = hex_sequence_to_string(source_hex)
  expected[row] = hex_sequence_to_string(expected_hex)
end
if sources[0] \= 20034 | expected[0] \= 20034 then,
  return fail("unexpected normalization row count")

if variant = "original-nfd" then do
  rules_source = loadtext(nfc_path, "0a"x)
  tokens = level_l_gennorm2_lex(rules_source)
  if level_l_gennorm2_status() \= 0 then,
    return fail("gennorm2 lexer: " || level_l_gennorm2_error_message())
  parse_result = unicode_gennorm2_parse(rules_source, tokens)
  if parse_result.status() \= 0 then,
    return fail("gennorm2 parser: " || parse_result.error())
  if workload = "rows" then,
    return benchmark_original_rows(parse_result.ast(), reference sources, reference expected, vm_label, warmups, sample_count)
  source_buffer = .string
  expected_buffer = .string
  call build_large_buffers reference sources, reference expected, repetitions, source_buffer, expected_buffer
  return benchmark_original_buffer(parse_result.ast(), reference source_buffer, reference expected_buffer, vm_label, warmups, sample_count, repetitions)
end

ucd = unicode_data_parse(unicode_data_path, "17.0.0")
if ucd.status() \= 0 then,
  return fail("UnicodeData parser line " || ucd.error_line() || ": " || ucd.error())
properties = unicode_normprops_parse(normalization_properties_path, "17.0.0")
if properties.status() \= 0 then,
  return fail("normalization-property parser line " || properties.error_line() || ": " || properties.error())
form = "NFD"
if variant = "prepared-nfc" then form = "NFC"
if variant = "generated-nfd" then do
  started = time("us")
  tables = unicode_norm_compile(ucd, properties)
  if tables.status() \= 0 then return fail("generated table compiler: " || tables.error())
  normalizer = level_l_unicode_nfd_new(tables)
  prepare_us = elapsed_us(started)
  if workload = "rows" then,
    return benchmark_generated_rows(reference normalizer, reference sources, reference expected, vm_label, warmups, sample_count, prepare_us, tables.byte_length())
  source_buffer = .string
  expected_buffer = .string
  call build_large_buffers reference sources, reference expected, repetitions, source_buffer, expected_buffer
  return benchmark_generated_buffer(reference normalizer, reference source_buffer, reference expected_buffer, vm_label, warmups, sample_count, repetitions, prepare_us, tables.byte_length())
end
if workload = "rows" then,
  return benchmark_prepared_rows(ucd, properties, reference sources, reference expected, variant, form, vm_label, warmups, sample_count)
source_buffer = .string
expected_buffer = .string
call build_large_buffers reference sources, reference expected, repetitions, source_buffer, expected_buffer
return benchmark_prepared_buffer(ucd, properties, reference source_buffer, reference expected_buffer, variant, form, vm_label, warmups, sample_count, repetitions)

benchmark_original_rows: procedure = .int
  arg ast = .unicodegennorm2ast, sources_ref = reference .string[], expected_ref = reference .string[], vm_label = .string, warmups = .int, sample_count = .int
  actual_checksum = .int
  sources = dereference sources_ref
  expected = dereference expected_ref
  started = time("us")
  tables = unicode_nfd_compile(ast)
  if tables.status() \= 0 then return fail("original table compiler: " || tables.error())
  normalizer = unicode_nfd_new(tables)
  if normalizer.status() \= 0 then return fail("original table validation: " || normalizer.error())
  prepare_us = elapsed_us(started)
  checksum = original_rows_correctness(reference normalizer, reference sources, reference expected)
  if checksum < 0 then return 1
  say "benchmark=unicode_prepared_compare phase=prepare variant=original-nfd vm=" || vm_label,
      "workload=rows rows=" || sources[0] "elapsed_us=" || prepare_us,
      "table_bytes=" || tables.byte_length()
  do warmup = 1 to warmups
    actual_checksum = original_rows_pass(reference normalizer, reference sources)
    if actual_checksum \= checksum then return fail("original NFD warmup checksum")
  end
  samples = .int[]
  do sample = 1 to sample_count
    started = time("us")
    actual_checksum = original_rows_pass(reference normalizer, reference sources)
    elapsed = elapsed_us(started)
    if actual_checksum \= checksum then return fail("original NFD sample checksum")
    samples[sample] = elapsed
    say "benchmark=unicode_prepared_compare phase=normalize variant=original-nfd vm=" || vm_label,
        "workload=rows sample=" || sample "rows=" || sources[0],
        "elapsed_us=" || elapsed "checksum_scalars=" || actual_checksum
  end
  median = median_us(reference samples)
  say "benchmark=unicode_prepared_compare phase=summary variant=original-nfd vm=" || vm_label,
      "workload=rows warmups=" || warmups "samples=" || sample_count,
      "rows=" || sources[0] "median_us=" || median,
      "checksum_scalars=" || checksum
  say "PASS: original scalar NFD rough performance cell"
  return 0

benchmark_prepared_rows: procedure = .int
  arg ucd = .unicode_data..unicodeucdresult, properties = .unicode_normprops..unicodenormpropsresult, sources_ref = reference .string[], expected_ref = reference .string[], variant = .string, form = .string, vm_label = .string, warmups = .int, sample_count = .int
  actual_checksum = .int
  sources = dereference sources_ref
  expected = dereference expected_ref
  started = time("us")
  tables = unicode_norm_compile(ucd, properties)
  if tables.status() \= 0 then return fail("prepared table compiler: " || tables.error())
  normalizer = unicode_d_new(tables, form)
  if normalizer.status() \= 0 then return fail("prepared table validation: " || normalizer.error())
  prepare_us = elapsed_us(started)
  checksum = prepared_rows_correctness(reference normalizer, reference sources, reference expected, variant)
  if checksum < 0 then return 1
  say "benchmark=unicode_prepared_compare phase=prepare variant=" || variant "vm=" || vm_label,
      "workload=rows rows=" || sources[0] "elapsed_us=" || prepare_us,
      "table_bytes=" || tables.byte_length()
  do warmup = 1 to warmups
    actual_checksum = prepared_rows_pass(reference normalizer, reference sources)
    if actual_checksum \= checksum then return fail(variant || " warmup checksum")
  end
  samples = .int[]
  do sample = 1 to sample_count
    started = time("us")
    actual_checksum = prepared_rows_pass(reference normalizer, reference sources)
    elapsed = elapsed_us(started)
    if actual_checksum \= checksum then return fail(variant || " sample checksum")
    samples[sample] = elapsed
    say "benchmark=unicode_prepared_compare phase=normalize variant=" || variant "vm=" || vm_label,
        "workload=rows sample=" || sample "rows=" || sources[0],
        "elapsed_us=" || elapsed "checksum_scalars=" || actual_checksum
  end
  median = median_us(reference samples)
  say "benchmark=unicode_prepared_compare phase=summary variant=" || variant "vm=" || vm_label,
      "workload=rows warmups=" || warmups "samples=" || sample_count,
      "rows=" || sources[0] "median_us=" || median,
      "checksum_scalars=" || checksum
  say "PASS: " || variant " rough performance cell"
  return 0

benchmark_generated_rows: procedure = .int
  arg normalizer_ref = reference .level_l_unicode_nfd..levellunicodenfdnormalizer, sources_ref = reference .string[], expected_ref = reference .string[], vm_label = .string, warmups = .int, sample_count = .int, prepare_us = .int, table_bytes = .int
  actual_checksum = .int
  normalizer = dereference normalizer_ref
  sources = dereference sources_ref
