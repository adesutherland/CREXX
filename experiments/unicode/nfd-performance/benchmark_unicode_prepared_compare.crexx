original_buffer_correctness: procedure = .int
  arg normalizer_ref = reference .unicode_nfd..unicodenfdnormalizer, source_ref = reference .string, expected_ref = reference .string
  normalizer = dereference normalizer_ref
  source = dereference source_ref
  expected = dereference expected_ref
  actual = normalizer.normalize(source)
  if normalizer.status() \= 0 then do
    say "FAIL: original-nfd buffer:" normalizer.error()
    return -1
  end
  if actual \== expected then do
    say "FAIL: original-nfd buffer result mismatch"
    return -1
  end
  return binlength(actual as .binary)

prepared_buffer_correctness: procedure = .int
  arg normalizer_ref = reference .unicode_d..unicodednormalizer, source_ref = reference .string, expected_ref = reference .string, variant = .string
  normalizer = dereference normalizer_ref
  source = dereference source_ref
  expected = dereference expected_ref
  actual = normalizer.normalize(source)
  if normalizer.status() \= 0 then do
    say "FAIL: " || variant " buffer:" normalizer.error()
    return -1
  end
  if actual \== expected then do
    say "FAIL: " || variant " buffer result mismatch"
    return -1
  end
  return binlength(actual as .binary)

generated_buffer_correctness: procedure = .int
  arg normalizer_ref = reference .level_l_unicode_nfd..levellunicodenfdnormalizer, source_ref = reference .string, expected_ref = reference .string
  normalizer = dereference normalizer_ref
  source = dereference source_ref
  expected = dereference expected_ref
  actual = normalizer.normalize(source)
  if actual \== expected then do
    say "FAIL: generated-nfd buffer result mismatch"
    return -1
  end
  return binlength(actual as .binary)

original_buffer_pass: procedure = .int
  arg normalizer_ref = reference .unicode_nfd..unicodenfdnormalizer, source_ref = reference .string
  normalizer = dereference normalizer_ref
  source = dereference source_ref
  actual = normalizer.normalize(source)
  return binlength(actual as .binary)

prepared_buffer_pass: procedure = .int
  arg normalizer_ref = reference .unicode_d..unicodednormalizer, source_ref = reference .string
  normalizer = dereference normalizer_ref
  source = dereference source_ref
  actual = normalizer.normalize(source)
  return binlength(actual as .binary)

generated_buffer_pass: procedure = .int
  arg normalizer_ref = reference .level_l_unicode_nfd..levellunicodenfdnormalizer, source_ref = reference .string
  normalizer = dereference normalizer_ref
  source = dereference source_ref
  actual = normalizer.normalize(source)
  return binlength(actual as .binary)

median_us: procedure = .int
  arg values_ref = reference .int[]
  values = snapshot values_ref
  do i = 2 to values[0]
    current = values[i]
    j = i - 1
    do while j >= 1 & values[j] > current
      values[j + 1] = values[j]
      j = j - 1
    end
    values[j + 1] = current
  end
  middle = values[0] <idiv> 2
  if values[0] <mod> 2 = 1 then return values[middle + 1]
  return (values[middle] + values[middle + 1]) <idiv> 2

elapsed_us: procedure = .int
  arg started = .int
  elapsed = time("us") - started
  if elapsed < 0 then elapsed = elapsed + 86400000000
  return elapsed

build_large_buffers: procedure = .void
  arg sources_ref = reference .string[], expected_ref = reference .string[], repetitions = .int, expose source_buffer = .string, expose expected_buffer = .string
  sources = dereference sources_ref
  expected = dereference expected_ref
  /* U+0020 closes every normalization segment and is stable in all forms. */
  source_block = arrayjoin(sources, " ") || " "
  expected_block = arrayjoin(expected, " ") || " "
  source_buffer = copies(source_block, repetitions)
  expected_buffer = copies(expected_block, repetitions)
  return

string_scalars: procedure = .int
  arg value = .string
  length = 0
  assembler strlen length,value
  return length

hex_sequence_to_string: procedure = .string
  arg sequence = .string
  result = ""
  do i = 1 to words(sequence)
    codepoint = x2d(word(sequence, i))
    assembler appendchar result,codepoint
  end
  return result

fail_row: procedure = .int
  arg variant = .string, row = .int, message = .string
  say "FAIL: " || variant " correctness row" row || ":" message
  return -1

fail: procedure = .int
  arg message = .string
  say "FAIL:" message
  return 1
