benchmark_generated_buffer: procedure = .int
  arg normalizer_ref = reference .level_l_unicode_nfd..levellunicodenfdnormalizer, source_ref = reference .string, expected_ref = reference .string, vm_label = .string, warmups = .int, sample_count = .int, repetitions = .int, prepare_us = .int, table_bytes = .int
  actual_checksum = .int
  normalizer = dereference normalizer_ref
  source = dereference source_ref
  expected = dereference expected_ref
  checksum = generated_buffer_correctness(reference normalizer, reference source, reference expected)
  if checksum < 0 then return 1
  input_bytes = binlength(source as .binary)
  say "benchmark=unicode_prepared_compare phase=prepare variant=generated-nfd vm=" || vm_label,
      "workload=buffer repetitions=" || repetitions "input_utf8_bytes=" || input_bytes,
      "output_utf8_bytes=" || checksum "elapsed_us=" || prepare_us,
      "table_bytes=" || table_bytes
  do warmup = 1 to warmups
