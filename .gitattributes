# Pinned upstream Unicode and legacy mapping inputs are retained byte-for-byte.
# Force LF on every platform because their published checksums cover exact bytes.
lib/rxfnsg/unicode/data/**/*.txt text eol=lf -whitespace

# The pinned official SQLite amalgamation is also retained byte-for-byte.
lib/plugins/sqlite/vendor/sqlite3.c text eol=lf -whitespace
lib/plugins/sqlite/vendor/sqlite3.h text eol=lf -whitespace
