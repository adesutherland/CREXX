/* cREXX License (MIT). Request-lifetime storage for native-owned L enrollment.
 * The native host calls this reader with its own frozen disassembly bytes.
 * Constructing a session in ordinary B does not enroll native authority. */
options levelb
namespace llrxinlinestage expose read session
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetflow
import lltargetsummary
import lltargetnormalize
import llinline
import llrxasinput

read: procedure = .object
  arg names = .string[], sources = .binary[]
  return .session(names,sources) as .object

session: class
  _raw = .lltarget..module[]
  _canonical = .lltarget..module[]
  _result = .lltarget..module[]
  _explicit = .lltargetnormalize..change[]
  _normalized = .lltargetnormalize..change[]
  _profiles0 = .lltargettransfer..profile[]
  _profiles1 = .lltargettransfer..profile[]
  _cfgs0 = .lltargetcfg..graph[]
  _cfgs1 = .lltargetcfg..graph[]
  _flows0 = .lltargetflow..analysis[]
  _flows1 = .lltargetflow..analysis[]
  _summaries = .lltargetsummary..analysis[]
  _summaries0 = .lltargetsummary..analysis[]
  _receipts = .llinline..normalizationreceipt[]
  _prepared0 = .int
  _prepared1 = .int
  _chargedwork0 = .int[]
  _chargedwork1 = .int[]
  _chargedbytes0 = .int[]
  _chargedbytes1 = .int[]
  _indices = .instructionindex[]
  _proofcallers = .int[]
  _proofoperations = .int[]
  _proofproviders = .int[]
  _prooffunctions = .int[]
  _prooftypes = .int[]
  _proofphases = .int[]
  _proofcaps = .object[]
  _proofheads = .int[]
  _prooftails = .int[]
  _proofnext = .int[]
  _canonicalready = .int
  _normalizedready = .int
  _candidatesready = .int
  _work = .int
  _remaining = .int
  _bytes = .int
  _normalwork = .int
  _normalbytes = .int
  _analysiswork = .int
  _analysisbytes = .int
  *: factory
    arg names = .string[], sources = .binary[]
    parsed = .llrxasinput..parsed; i = .int
    reader = .llrxasinput..reader(); fault = .string
    if names[0] < 1 | names[0] > 100000 | sources[0] <> names[0] then assembler signal "ERROR","LL_INLINE_SELECTION: snapshot count/pairing"
    remaining = 67108864
    do i = 1 to names[0]
      name = names[i]; source = sources[i]
      if <blen>(source) > remaining then assembler signal "ERROR","LL_RESOURCE_LIMIT: selection snapshot bytes"
      remaining = remaining - <blen>(source)
      parsed = reader.parse(source,name,name)
      if parsed.status() <> 0 then do; fault = parsed.diagnostic(); assembler signal "ERROR",fault; end
      _raw[i] = parsed.result()
    end
    return
  count: method = .int
    return _raw[0]
  canonicalize: method = .void
    arg work = .int
    i = .int
    if _canonicalready then return
    if work < 1 then assembler signal "ERROR","LL_RESOURCE_LIMIT: selection staging work"
    _work = work; _remaining = work; _bytes = 67108864; fault = .string
    /* Lower normalization transactions do not yet publish total draft/remap
     * counters. Reserve their whole envelopes, never guess zero actual cost.
     * Each analysis owner is likewise bounded by one disjoint allocation. */
    _normalwork = work <idiv> (8 * _raw[0]); _normalbytes = _bytes <idiv> (8 * _raw[0])
    _analysiswork = work <idiv> (16 * _raw[0]); _analysisbytes = _bytes <idiv> (16 * _raw[0])
    if _normalwork < 1 | _normalbytes < 1 | _analysiswork < 1 | _analysisbytes < 1 then assembler signal "ERROR","LL_RESOURCE_LIMIT: selection stage partitions"
    do i = 1 to _raw[0]
      target = _raw[i]
      call spend(target.records() * 32,target.records() * 2 + 1)
      _indices[i] = .instructionindex(target)
      _proofheads[i] = 0; _prooftails[i] = 0
      _proofheads[_raw[0] + i] = 0; _prooftails[_raw[0] + i] = 0
      _chargedwork0[i] = 0; _chargedbytes0[i] = 0
      _chargedwork1[i] = 0; _chargedbytes1[i] = 0
      _result[i] = _raw[i]
    end
    /* Finish every array allocation before handing any element reference to
     * native code. Neither owner array is resized after its enrollment. */
    do i = 1 to _raw[0]
      call spend(_normalbytes,_normalwork)
      changed = lltargetnormalize..explicit(reference _raw[i],_normalwork,_normalbytes)
      if changed.status() <> 'changed' & changed.status() <> 'keep' then do
        fault = 'LL_INLINE_SELECTION: explicit normalization: ' || changed.reason(); assembler signal "ERROR",fault
      end
      _explicit[i] = changed; _canonical[i] = changed.result()
    end
    _canonicalready = 1
    return
  owner: method = reference .lltarget..module
    arg index = .int, phase = .int
    if index < 1 | index > _raw[0] | _canonicalready = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: owner index"
    if phase = 0 then return reference _canonical[index]
    if phase <> 1 | _candidatesready = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: owner phase"
    return reference _result[index]
  rawarray: method = reference .lltarget..module[]
    return reference _raw
  resultarray: method = reference .lltarget..module[]
    call finishnormalization()
    return reference _result
  normalizationarray: method = reference .lltargetnormalize..change[]
    call finishnormalization()
    return reference _normalized
  /** Borrow durable evidence only after the fixed phase 1 owners and
   * capabilities have supplied every receipt's candidate proof. */
  receipt: method = reference .llinline..normalizationreceipt
    arg index = .int
    if index < 1 | index > _raw[0] then assembler signal "ERROR","LL_INLINE_SELECTION: receipt index"
    call finishnormalization()
    return reference _receipts[index]
  function: method = .int
    arg index = .int, symbol = .string, phase = .int
    owner_ref = owner(index,phase); target = dereference owner_ref
    return target.procedureid(symbol)
  operation: method = .int
    arg index = .int, symbol = .string, ordinal = .int, phase = .int
    mapped = .int; j = .int
    if index < 1 | index > _raw[0] | ordinal < 0 then return 0
    target = _raw[index]; functionid = target.procedureid(symbol)
    if functionid = 0 then return 0
    call spend(0,1)
    operation = _indices[index].at(functionid,ordinal)
    if operation = 0 | _canonicalready = 0 then return 0
    before = target.at(operation)
    if phase = 1 then do
      if _candidatesready = 0 then return 0
      mapped = _receipts[index].operation(_explicit[index].operation(operation))
    end
    else if phase = 0 then mapped = _explicit[index].operation(operation)
    else return 0
    if mapped < 1 then return 0
    owner_ref = owner(index,phase); resultowner = dereference owner_ref
    after = resultowner.at(mapped)
    if before.opcode() <> after.opcode() | before.operands() <> after.operands() then assembler signal "ERROR","LL_INLINE_SELECTION: native source mapping changed binding opcode"
    call spend(0,before.operands() + 1)
    do j = 1 to before.operands()
      left = before.operand(j); right = after.operand(j)
      if left.kind() <> right.kind() then assembler signal "ERROR","LL_INLINE_SELECTION: native source mapping changed binding role"
      if left.kind() = 'R' then do
        if left.bank() <> right.bank() | left.index() <> right.index() then assembler signal "ERROR","LL_INLINE_SELECTION: native source mapping changed binding storage"
      end
      else if left.index() <> right.index() | left.bytes() <> right.bytes() | left.text() <> right.text() then assembler signal "ERROR","LL_INLINE_SELECTION: native source mapping changed binding descriptor"
    end
    return mapped
  addproof: method = .int
    arg caller = .int, operation = .int, provider = .int, functionid = .int, typeoperation = .int, phase = .int, capability = .object
    if caller < 1 | caller > _raw[0] | provider < 1 | provider > _raw[0] | functionid < 2 | operation < 1 | typeoperation < 0 then return 0
    if phase <> 0 & phase <> 1 then return 0
    if (phase = 0 & _prepared0) | (phase = 1 & _prepared1) then return 0
    call spend(96,1)
    n = _proofcaps[0] + 1
    key = phase * _raw[0] + caller
    _proofnext[n] = 0
    if _prooftails[key] > 0 then _proofnext[_prooftails[key]] = n
    else _proofheads[key] = n
    _prooftails[key] = n
    _proofcallers[n] = caller; _proofoperations[n] = operation; _proofproviders[n] = provider
    _prooffunctions[n] = functionid; _prooftypes[n] = typeoperation; _proofphases[n] = phase; _proofcaps[n] = capability
    return 1
  spend: method = .void
    arg bytes = .int, work = .int
    if bytes < 0 | work < 0 | bytes > _bytes | work > _remaining then assembler signal "ERROR","LL_RESOURCE_LIMIT: selection session work/bytes"
    _bytes = _bytes - bytes; _remaining = _remaining - work
    return
  preparephase: method = .void
    arg phase = .int
    i = .int; row = .int; accepted = .int
    profile_ref = reference .lltargettransfer..profile
    providerprofile = reference .lltargettransfer..profile
    owner_ref = reference .lltarget..module; provider_ref = reference .lltarget..module
    fault = .string
    if phase = 0 & _prepared0 then return
    if phase = 1 & _prepared1 then return
    if phase <> 0 & phase <> 1 then assembler signal "ERROR","LL_INLINE_SELECTION: profile phase"
    /* Allocate every profile cell before any peer obtains its reference. */
    do i = 1 to _raw[0]
      owner_ref = owner(i,phase)
      stages = 4
      call spend(stages * _analysisbytes,stages * _analysiswork)
      if phase = 0 then _profiles0[i] = .lltargettransfer..profile(owner_ref,_analysiswork,_analysisbytes)
      else _profiles1[i] = .lltargettransfer..profile(owner_ref,_analysiswork,_analysisbytes)
    end
    do i = 1 to _raw[0]
      if phase = 0 then profile_ref = reference _profiles0[i]
      else profile_ref = reference _profiles1[i]
      profile = dereference profile_ref
      row = _proofheads[phase * _raw[0] + i]
      do while row > 0
        call spend(0,1)
        provider_ref = owner(_proofproviders[row],phase)
        if phase = 0 then providerprofile = reference _profiles0[_proofproviders[row]]
        else providerprofile = reference _profiles1[_proofproviders[row]]
        if _prooftypes[row] = 0 then accepted = profile.certifybinding(_proofoperations[row],provider_ref,_prooffunctions[row],_proofcaps[row],providerprofile)
        else accepted = profile.certifyselection(_proofoperations[row],provider_ref,_prooffunctions[row],_proofcaps[row],_prooftypes[row],providerprofile)
        if accepted = 0 then do
          fault = profile.message()
          if fault = '' then fault = 'LL_INLINE_SELECTION: native owner proof expired or duplicated'
          assembler signal "ERROR",fault
        end
        row = _proofnext[row]
      end
    end
    /* Constructors retain references but do not run. Finish the arrays before
     * any public points/summary query or provider analysis can borrow them. */
    do i = 1 to _raw[0]
      owner_ref = owner(i,phase)
      if phase = 0 then do
        _cfgs0[i] = .lltargetcfg..graph(owner_ref,reference _profiles0[i],_analysiswork,_analysisbytes)
        _flows0[i] = .lltargetflow..analysis(owner_ref,reference _profiles0[i],reference _cfgs0[i],_analysiswork,_analysisbytes)
      end
      else do
        _cfgs1[i] = .lltargetcfg..graph(owner_ref,reference _profiles1[i],_analysiswork,_analysisbytes)
        _flows1[i] = .lltargetflow..analysis(owner_ref,reference _profiles1[i],reference _cfgs1[i],_analysiswork,_analysisbytes)
      end
    end
    do i = 1 to _raw[0]
      if phase = 0 then _summaries0[i] = .lltargetsummary..analysis(reference _flows0[i],_analysiswork,_analysisbytes)
      else _summaries[i] = .lltargetsummary..analysis(reference _flows1[i],_analysiswork,_analysisbytes)
    end
    do i = 1 to _raw[0]
      row = _proofheads[phase * _raw[0] + i]
      do while row > 0
        call spend(0,1)
        if _proofproviders[row] <> i then do
          if phase = 0 then accepted = _summaries0[i].useprovider(reference _flows0[_proofproviders[row]],reference _summaries0[_proofproviders[row]])
          else accepted = _summaries[i].useprovider(reference _flows1[_proofproviders[row]],reference _summaries[_proofproviders[row]])
          if accepted = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: provider bundle mismatch"
        end
        row = _proofnext[row]
      end
    end
    if phase = 0 then _prepared0 = 1
    else _prepared1 = 1
    return
  settle: method = .void
    i = .int; phase = .int
    work = .int; bytes = .int; previouswork = .int; previousbytes = .int
    do phase = 0 to 1
      if phase = 0 & _prepared0 = 0 then iterate
      if phase = 1 & _prepared1 = 0 then iterate
      do i = 1 to _raw[0]
        if phase = 0 then do
          work = _profiles0[i].usedwork() + _cfgs0[i].usedwork() + _flows0[i].usedwork() + _summaries0[i].usedwork()
          bytes = _profiles0[i].usedbytes() + _cfgs0[i].usedbytes() + _flows0[i].usedbytes() + _summaries0[i].usedbytes()
          previouswork = _chargedwork0[i]; previousbytes = _chargedbytes0[i]
        end
        else do
          work = _profiles1[i].usedwork() + _cfgs1[i].usedwork() + _flows1[i].usedwork() + _summaries[i].usedwork()
          bytes = _profiles1[i].usedbytes() + _cfgs1[i].usedbytes() + _flows1[i].usedbytes() + _summaries[i].usedbytes()
          previouswork = _chargedwork1[i]; previousbytes = _chargedbytes1[i]
        end
        stages = 4
        if work < previouswork | bytes < previousbytes | work > stages * _analysiswork | bytes > stages * _analysisbytes then assembler signal "ERROR","LL_RESOURCE_LIMIT: selection analysis partition"
        /* Whole child allowances were debited before construction. Caches
         * grow inside those same owners and never obtain a renewed quota. */
        if phase = 0 then do; _chargedwork0[i] = work; _chargedbytes0[i] = bytes; end
        else do; _chargedwork1[i] = work; _chargedbytes1[i] = bytes; end
      end
    end
    return
  normalize: method = .void
    i = .int
    if _candidatesready then return
    if _canonicalready = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: canonical owners absent"
    fault = .string
    call preparephase(0)
    do i = 1 to _canonical[0]
      call spend(_normalbytes,_normalwork)
      /* Allocate every actual lazy value before any receipt prepares links
       * to its own fields. No prepared receipt array can subsequently grow. */
      _receipts[i] = .llinline..normalizationreceipt.borrowed(reference _canonical[i],reference _flows0[i],reference _summaries0[i],_normalwork,_normalbytes)
    end
    do i = 1 to _canonical[0]
      call settle()
      state = _receipts[i].status()
      if state <> 'prepared' then do
        fault = 'LL_INLINE_SELECTION: entry candidate: ' || _receipts[i].reason()
        if state = 'limit' then fault = 'LL_RESOURCE_LIMIT: entry candidate: ' || _receipts[i].reason()
        assembler signal "ERROR",fault
      end
      if _receipts[i].reservedwork() > _normalwork | _receipts[i].reservedbytes() > _normalbytes then assembler signal "ERROR","LL_RESOURCE_LIMIT: selection receipt partition"
      _result[i] = _receipts[i].candidate()
      call settle()
    end
    /* Native phase 1 enrollment may now borrow every fixed candidate cell.
     * Ordinary result/map/warning readers still require receipt completion. */
    _candidatesready = 1
    return
  finishnormalization: method = .void
    i = .int; j = .int; mapped = .int; accepted = .int
    mapping = .int[]; warnings = .lltargetnormalize..warning[]
    changed = .lltargetnormalize..change; previous = .lltargetnormalize..warning
    item = .lltarget..record
    if _normalizedready then return
    if _candidatesready = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: result candidates absent"
    fault = .string
    call preparephase(1)
    do i = 1 to _canonical[0]
      call settle()
      accepted = _receipts[i].finish(reference _result[i],reference _flows1[i])
      call settle()
      if accepted = 0 then do
        fault = 'LL_INLINE_SELECTION: entry receipt: ' || _receipts[i].reason()
        if _receipts[i].status() = 'limit' then fault = 'LL_RESOURCE_LIMIT: entry receipt: ' || _receipts[i].reason()
        assembler signal "ERROR",fault
      end
      if _receipts[i].reservedwork() > _normalwork | _receipts[i].reservedbytes() > _normalbytes then assembler signal "ERROR","LL_RESOURCE_LIMIT: selection receipt partition"
    end
    /* All semantic commits succeeded before publishing the composed adapter
     * records. Never replace a phase 1 owner after native enrollment. */
    do i = 1 to _canonical[0]
      changed = _receipts[i].result(); candidate = changed.result(); current = _result[i]
      if candidate.valid() = 0 | candidate.identity() <> current.identity() then assembler signal "ERROR","LL_INLINE_SELECTION: receipt changed enrolled owner"
      assembler setattrs mapping,0
      assembler setattrs warnings,0
      source = _raw[i]
      call spend(source.records() * 8,source.records() + changed.warnings() + _explicit[i].warnings())
      do j = 1 to source.records()
        item = source.record(j); mapping[item.id()] = _receipts[i].operation(_explicit[i].operation(item.id()))
      end
      do j = 1 to _explicit[i].warnings()
        previous = _explicit[i].warning(j); mapped = _receipts[i].operation(previous.operation()); item = current.at(mapped)
        call spend(160 + length(previous.procedure()) + length(previous.component()),1)
        warnings[warnings[0] + 1] = .lltargetnormalize..warning(previous.procedure(),previous.local(),previous.component(),mapped,item.origin())
      end
      do j = 1 to changed.warnings()
        previous = changed.warning(j)
        call spend(160 + length(previous.procedure()) + length(previous.component()),1)
        warnings[warnings[0] + 1] = previous
      end
      state = changed.status()
      if _explicit[i].status() = 'changed' then state = 'changed'
      _normalized[i] = .lltargetnormalize..change.resolved(state,changed.reason(),current,mapping,warnings,changed)
    end
    call settle()
    _normalizedready = 1
    return
  /** Finish the exact pair before lending either reference. Constructors are
   * lazy and valid() deliberately does not execute them. A failed/limited
   * owner returns no borrowed bundle; cached work stays in its reserved
   * session partition and is settled before any reference can escape. */
  ready: method = .void
    arg index = .int
    if index < 1 | index > _raw[0] then assembler signal "ERROR","LL_INLINE_SELECTION: analysis owner index"
    call finishnormalization()
    state = _flows1[index].status(); fault = _flows1[index].reason()
    call settle()
    if state <> 'ok' then do
      if state = 'limit' then fault = 'LL_RESOURCE_LIMIT: selection point analysis: ' || fault
      else fault = 'LL_INLINE_SELECTION: point analysis ' || state || ': ' || fault
      assembler signal "ERROR",fault
    end
    state = _summaries[index].status(); fault = _summaries[index].reason()
    call settle()
    if state <> 'ok' then do
      if state = 'limit' then fault = 'LL_RESOURCE_LIMIT: selection summary analysis: ' || fault
      else fault = 'LL_INLINE_SELECTION: summary analysis ' || state || ': ' || fault
      assembler signal "ERROR",fault
    end
    return
  points: method = reference .lltargetflow..analysis
    arg index = .int
    call ready(index)
    return reference _flows1[index]
  summaries: method = reference .lltargetsummary..analysis
    arg index = .int
    call ready(index)
    return reference _summaries[index]
  claimwork: method = .int
    arg owners = .int
    call finishnormalization()
    call settle()
    if owners < 1 then assembler signal "ERROR","LL_INLINE_SELECTION: expansion owner count"
    allowance = _remaining <idiv> owners
    call spend(0,allowance)
    return allowance

/** A single charged construction gives constant-time instruction ordinals.
 * Metadata rows do not acquire instruction ordinals. */
instructionindex: class
  _first = .int[]
  _counts = .int[]
  _operations = .int[]
  *: factory
    arg source = .lltarget..module
    do i = 1 to source.procedures()
      body = source.procedure(i); functionid = body.functionid()
      _first[functionid] = _operations[0] + 1; count = 0
      do j = 1 to body.records()
        item = body.record(j)
        if item.kind() <> 'instruction' then iterate
        _operations[_operations[0] + 1] = item.id(); count = count + 1
      end
      _counts[functionid] = count
    end
    return
  at: method = .int
    arg functionid = .int, ordinal = .int
    if functionid < 1 | functionid > _counts[0] | ordinal < 0 then return 0
    if ordinal >= _counts[functionid] then return 0
    return _operations[_first[functionid] + ordinal]
