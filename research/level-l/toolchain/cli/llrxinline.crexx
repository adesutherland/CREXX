/* cREXX License (MIT). Thin one-module client of the shared B/L services. */
options levelb
namespace llrxinline expose main selectionresult selectionexecute
import rxfnsb
import lllimits
import llir
import llirgraph
import lltarget
import llinline
import lltargetnormalize
import lltargettransfer
import lltargetflow
import lltargetsummary
import llcleanup
import llrxasinput
import llrxasoutput
import llfileoutput
import llrxascatalog
import rxjson
import llrxinlinestage

boot: initialiser expose inlinephase
  inlinephase = 'startup'
  return

main: procedure = .int expose inlinephase
  arg argv = .string[]
  limits = .lllimits..policy; frontend = .llrxasinput..reader; parsed = .llrxasinput..parsed
  target = .lltarget..module; emitted = .llrxasoutput..emission; output = .llir..output
  bodies = .lltarget..module[]; cleanup = 1; workbudget = 4000000
  sourcepath = ''; destination = ''; logical = ''; artifact = ''; profile = 'unknown'; policy = 'default'
  selection = ''; selectionresult = ''
  bodypaths = .string[]; bodynames = .string[]; i = 1
  do while i <= argv[0]
    option = argv[i]
    select
      when option = '-o' | option = '--module' | option = '--artifact' | option = '--profile' | option = '--policy' | option = '--selection' | option = '--selection-result' then do
        if i = argv[0] then return usage('missing operand for ' || option)
        i = i + 1; value = argv[i]
        select option
          when '-o' then destination = value
          when '--module' then logical = value
          when '--artifact' then artifact = value
          when '--profile' then profile = value
          when '--policy' then policy = value
          when '--selection' then selection = value
          when '--selection-result' then selectionresult = value
        end
      end
      when option = '--body' then do
        if i + 2 > argv[0] then return usage('--body requires logical-module and source-path')
        bodynames[bodynames[0] + 1] = argv[i + 1]; bodypaths[bodypaths[0] + 1] = argv[i + 2]; i = i + 2
      end
      when option = '--work' then do
        if i = argv[0] then return usage('missing operand for --work')
        i = i + 1; value = argv[i]
        if value = '' | length(value) > 8 then return usage('--work requires a positive decimal allowance up to 99999999')
        if verify(value,'0123456789') <> 0 then return usage('--work requires a positive decimal allowance up to 99999999')
        workbudget = value as .int
        if workbudget < 1 then return usage('--work requires a positive decimal allowance up to 99999999')
      end
      when option = '--no-inline' then policy = 'never'
      when option = '--no-cleanup' then cleanup = 0
      when left(option,1) = '-' then return usage('unknown option ' || option)
      when sourcepath <> '' then return usage('only one output module can be selected')
      otherwise sourcepath = option
    end
    i = i + 1
  end
  if wordpos(policy,'default all-legal never') = 0 then return usage('unknown selection policy ' || policy)
  if selection <> '' then do
    if selectionresult = '' | sourcepath <> '' | destination <> '' | logical <> '' | artifact <> '' | bodypaths[0] > 0 | profile <> 'unknown' then return usage('--selection requires only --selection-result, --policy and --work')
    return selectionmode(selection,selectionresult,policy,workbudget)
  end
  if selectionresult <> '' then return usage('--selection-result requires --selection')
  if sourcepath = '' | destination = '' | logical = '' then return usage('source, --module and -o are required')
  if profile <> 'unknown' & profile <> 'closed-main-default-halt.v1' & profile <> 'closed-main-static-exact-default-halt.v1' then return usage('unknown preservation profile ' || profile)
  if artifact = '' then artifact = sourcepath
  do
    inlinephase = 'parse'
    limits = .lllimits..policy(); inputbytes = 67108864
    frontend = .llrxasinput..reader()
    source = readsource(sourcepath,min(inputbytes,limits.limit('source.bytes'))); inputbytes = inputbytes - <blen>(source)
    parsed = frontend.parse(source,logical,artifact,limits)
    if parsed.status() <> 0 then do; call lineout 'stderr',parsed.diagnostic(); return 1; end
    target = parsed.result()
    do i = 1 to bodypaths[0]
      source = readsource(bodypaths[i],min(inputbytes,limits.limit('source.bytes'))); inputbytes = inputbytes - <blen>(source)
      parsed = frontend.parse(source,bodynames[i],bodypaths[i],limits)
      if parsed.status() <> 0 then do; call lineout 'stderr',parsed.diagnostic(); return 1; end
      bodies[i] = parsed.result()
    end
    inlinephase = 'applybatch'
    if applybatch(target,reference bodies,profile,policy,cleanup,workbudget) <> 0 then return 1
    inlinephase = 'render'
    emitted = llrxasoutput..render(reference target)
    if emitted.error() <> '' then do; call lineout 'stderr',emitted.error(); return 1; end
    inlinephase = 'publish'
    output = emitted.output(); message = llfileoutput..publish(output,destination)
    if message <> '' then do; call lineout 'stderr',message; return 1; end
    return 0
  on signal as problem
    detail = 'LL_INLINE_ERROR: ' || problem.name() || ': ' || left(problem.message(),512)
    detail = detail || ' [phase=' || inlinephase || ';module=' || problem.module() || ';address=' || problem.address()
    detail = detail || ';filehex=' || bin2x(left(problem.file(),160) as .binary) || ';line=' || problem.line() || ']'
    call lineout 'stderr',detail; return 1
  end
  return 1

/** Capture only original IDs in source order. Generated calls never enter an
 * unbounded restart loop. */
callsites: procedure = .int[]
  arg owner = reference .lltarget..module
  target = .lltarget..module; item = .lltarget..record
  target = dereference owner; calls = .int[]; catalog = .llrxascatalog..catalog()
  do i = 1 to target.records()
    item = target.record(i)
    if item.kind() <> 'instruction' then iterate
    if catalog.callinvokes(item.opcode()) then calls[calls[0] + 1] = item.id()
  end
  return calls

/** Return 2 for the exact caller owner, 1 for a supplied provider, 0 when no
 * body is available, and -1 after reporting an ambiguous supplied binding.
 * Supplied providers remain anchored in main's immutable typed array. Return
 * its index rather than a reference to a helper-local copied module. */
selectprovider: procedure = .int
  arg owner = reference .lltarget..module, called = .string, supplied = reference .lltarget..module[], expose providerindex = .int, expose procedureid = .int
  target = .lltarget..module; candidate = .lltarget..module
  declaration = .lltarget..record; localname = .lltarget..operand; name = .lltarget..operand; body = .lltarget..body
  target = dereference owner; bodies = dereference supplied; j = .int
  providerindex = 0; procedureid = target.procedureid(called)
  if procedureid > 0 then return 2
  exported = ''; selected = 0
  do j = 1 to target.records()
    declaration = target.record(j)
    if declaration.kind() <> '.import' then iterate
    localname = declaration.operand(1)
    if localname.text() == called then do
      name = declaration.operand(2); exported = name.text()
    end
  end
  do j = 1 to bodies[0]
    candidate = bodies[j]
    do k = 1 to candidate.procedures()
      body = candidate.procedure(k)
      if exported <> '' & body.expose() == exported then do
        if selected then do
          call lineout 'stderr','LL_INLINE_BINDING: ambiguous supplied provider ' || exported
          return -1
        end
        providerindex = j; procedureid = body.functionid(); selected = 1
      end
    end
  end
  return selected

/** Project exact local calls into one ordinary L graph. The synthetic root
 * makes every procedure available to the shared SCC service, including
 * disconnected authored helpers. Names locate later revisions; they confer
 * no executable-body or target authority. */
callorder: class
  _owner = reference .lltarget..module
  _worklimit = .int
  _bytelimit = .int
  _graph = .llir..module
  _index = .llirgraph..index
  _cycles = .llirgraph..cycles
  _names = .string[]
  _sortednames = .string[]
  _sortednodes = .int[]
  _waves = .int[]
  _components = .int[]
  _levels = .int[]
  _hascalls = .int[]
  _status = .string
  _reason = .string
  _work = .int
  _bytes = .int
  _lookupwork = .int
  _lookuplevels = .int
  *: factory
    arg owner = reference .lltarget..module, work = .int, bytes = .int
    _owner = owner; _worklimit = work; _bytelimit = bytes; _status = 'building'
    return
  run: method = .void
    if _status <> 'building' then return
    owner = _owner; work = _worklimit; bytes = _bytelimit
    if <refvalid>(owner) = 0 then do; _status = 'invalid'; _reason = 'inline.callgraph.owner.expired'; return; end
    source = dereference owner
    body = .lltarget..body; item = .lltarget..record; field = .lltarget..operand
    registry = .llir..schema; family = .llir..family; contract = .llir..contract
    opcode = .llir..operation; builder = .llir..builder; fn = .llir..function
    blocks = .llir..block[]; operation = .llir..opdraft; at = .llir..origin
    nodes = .int[]; from = .int[]; destinations = .int[]; heads = .int[]; links = .int[]; keys = .string[]
    pending = .int[]; incoming = .int[]; nextedge = .int[]; ready = .int[]; levels = .int[]; active = .int[]
    i = .int; edge = .int; caller = .int; callee = .int; count = .int
    first = .int; last = .int; component = .int; targetcomponent = .int
    count = source.procedures()
    if count < 1 | work < 1 | bytes < 1 then do; _status = 'limit'; _reason = 'inline.callgraph.allowance'; return; end
    _work = source.records() + count * 8; _bytes = count * 192 + source.records() * 32
    if _work > work | _bytes > bytes then do; _status = 'limit'; _reason = 'inline.callgraph.tables'; return; end
    longestname = 0
    do i = 1 to count
      body = source.procedure(i); _names[i] = body.name(); nodes[body.functionid()] = i
      namebytes = <blen>(body.name() as .binary)
      longestname = max(longestname,namebytes); _bytes = _bytes + namebytes * 4 + 10
      keys[i] = right(i as .string,10,'0') || body.name()
      _hascalls[i] = 0; heads[i] = 0
    end
    if _bytes >= bytes then do; _status = 'limit'; _reason = 'inline.callgraph.names.bytes'; return; end
    width = count; _lookuplevels = 1
    do while width > 0; width = width <idiv> 2; _lookuplevels = _lookuplevels + 1; end
    _lookupwork = _lookuplevels * (longestname * 2 + 4) + 1
    _work = _work + count * _lookuplevels * 8 * (longestname + 11)
    if _work > work then do; _status = 'limit'; _reason = 'inline.callgraph.names.work'; return; end
    /* Use the shared case-sensitive lexical sort once. The fixed-width node
     * prefix travels with its name while offset 11 selects only the name. */
    ignoredsort = arraysort(keys,11)
    do i = 1 to count
      _sortednames[i] = substr(keys[i],11); _sortednodes[i] = left(keys[i],10) as .int
    end
    catalog = .llrxascatalog..catalog()
    do i = 1 to source.records()
      item = source.record(i)
      if item.kind() <> 'instruction' then iterate
      if catalog.callinvokes(item.opcode()) = 0 then iterate
      if item.procedureid() < 1 then iterate
      caller = nodes[item.procedureid()]
      if caller = 0 then iterate
      _hascalls[caller] = 1
      if catalog.callkind(item.opcode()) <> 1 then iterate
      field = item.operand(catalog.calltarget(item.opcode()))
      _work = _work + _lookupwork + field.length() * _lookuplevels
      if _work > work then do; _status = 'limit'; _reason = 'inline.callgraph.lookup.work'; return; end
      callee = findname(field.text())
      if callee = 0 then iterate
      edge = from[0] + 1; from[edge] = caller; destinations[edge] = callee
      links[edge] = heads[caller]; heads[caller] = edge
    end
    registry = .llir..schema(); family = registry.family('llinline.callgraph',1)
    opcode = family.operation('node'); call opcode.control('terminal',0,max(count,from[0]))
    contract = registry.finish(); builder = .llir..builder(contract,max(1,count * 4 + from[0] * 2 + 8),bytes - _bytes)
    at = builder.synthetic('inline call ordering'); fn = builder.function('calls',contract.type('core.void'))
    blocks[1] = fn.block('root')
    do i = 1 to count; blocks[i + 1] = fn.block('procedure' || i); end
    operation = blocks[1].operation(contract.operation('llinline.callgraph.node'),at)
    do i = 1 to count; call operation.successor(blocks[i + 1]); end
    ignored = operation.finish()
    do i = 1 to count
      operation = blocks[i + 1].operation(contract.operation('llinline.callgraph.node'),at)
      edge = heads[i]
      do while edge > 0
        call operation.successor(blocks[destinations[edge] + 1]); edge = links[edge]
      end
      ignored = operation.finish()
    end
    _graph = builder.finish()
    if _graph.error() <> '' then do; _status = 'invalid'; _reason = _graph.error(); return; end
    _bytes = _bytes + _graph.bytes()
    if _bytes >= bytes then do; _status = 'limit'; _reason = 'inline.callgraph.ir.bytes'; return; end
    _index = .llirgraph..index(reference _graph,work - _work,bytes - _bytes)
    if _index.status() <> 'ok' then do; _status = _index.status(); _reason = _index.message(); return; end
    _work = _work + _index.usedwork(); _bytes = _bytes + _index.usedbytes()
    _cycles = _index.loops(work - _work,bytes - _bytes)
    if _cycles.status() <> 'ok' then do; _status = _cycles.status(); _reason = _cycles.message(); return; end
    _work = _work + _cycles.usedwork(); _bytes = _bytes + _cycles.usedbytes()
    _work = _work + count * 3 + from[0] * 3 + _cycles.components() * 3
    if _work > work then do; _status = 'limit'; _reason = 'inline.callgraph.order.work'; return; end
    do i = 1 to _cycles.components(); pending[i] = 0; incoming[i] = 0; levels[i] = 1; end
    do i = 1 to count; _components[i] = _cycles.component(blocks[i + 1].id()); end
    do edge = 1 to from[0]
      component = _components[from[edge]]; targetcomponent = _components[destinations[edge]]
      if component = targetcomponent then iterate
      pending[component] = pending[component] + 1
      nextedge[edge] = incoming[targetcomponent]; incoming[targetcomponent] = edge
    end
    first = 1; last = 0
    do i = 1 to _cycles.components()
      if pending[i] = 0 then do; last = last + 1; ready[last] = i; end
    end
    do while first <= last
      component = ready[first]; first = first + 1
      edge = incoming[component]
      do while edge > 0
        caller = _components[from[edge]]; levels[caller] = max(levels[caller],levels[component] + 1)
        pending[caller] = pending[caller] - 1
        if pending[caller] = 0 then do; last = last + 1; ready[last] = caller; end
        edge = nextedge[edge]
      end
    end
    do i = 1 to count
      _levels[i] = levels[_components[i]]
      if _hascalls[i] then active[_levels[i]] = 1
    end
    do i = 1 to active[0]
      if active[i] then _waves[_waves[0] + 1] = i
    end
    _status = 'ok'
    return
  status: method = .string
    call run()
    return _status
  reason: method = .string
    call run()
    return _reason
  usedwork: method = .int
    call run()
    return _work
  usedbytes: method = .int
    call run()
    return _bytes
  size: method = .int
    call run()
    return _waves[0]
  level: method = .int
    arg ordinal = .int
    call run()
    return _waves[ordinal]
  lookupwork: method = .int
    call run()
    return _lookupwork * 2 + 1
  /** Exact lexical lookup into the already constructed index. During run,
   * callers have precharged this bounded search before invoking it. */
  findname: method = .int
    arg name = .string
    lower = 1; upper = _sortednames[0]; comparison = .int
    do while lower <= upper
      middle = lower + (upper - lower) <idiv> 2; probe = _sortednames[middle]
      if probe == name then return _sortednodes[middle]
      assembler slt comparison,probe,name
      if comparison then lower = middle + 1
      else upper = middle - 1
    end
    return 0
  includes: method = .int
    arg name = .string, level = .int
    call run()
    node = findname(name)
    if node = 0 then return 0
    return _levels[node] = level
  recursive: method = .int
    arg caller = .string, callee = .string
    call run()
    left = findname(caller); right = findname(callee)
    if left = 0 | right = 0 then return 0
    return _components[left] = _components[right]

/** Rebuild proof owners between leaf-to-caller waves. A later caller clones
 * the newly published local provider body; no receipt or point fact survives
 * replacement of its exact module owner. */
applybatch: procedure = .int expose inlinephase
  arg expose target = .lltarget..module, supplied = reference .lltarget..module[], profile = .string, policy = .string, cleanup = .int, workbudget = .int
  order = .callorder; bytebudget = 67108864; i = .int
  if policy = 'never' then return applywave(target,supplied,profile,policy,cleanup,workbudget,bytebudget)
  order = .callorder(reference target,workbudget,bytebudget)
  if order.status() <> 'ok' then do; call lineout 'stderr','LL_INLINE_' || upper(order.status()) || ': ' || order.reason(); return 1; end
  workbudget = workbudget - order.usedwork(); bytebudget = bytebudget - order.usedbytes()
  if order.size() = 0 then return applywave(target,supplied,profile,policy,cleanup,workbudget,bytebudget)
  if profile = 'closed-main-static-exact-default-halt.v1' then do
    if checkproviders(reference target,supplied) = 0 then return 1
  end
  do i = 1 to order.size()
    inlinephase = 'wave.schedule'
    remaining = order.size() - i + 1; allowance = workbudget <idiv> remaining; bytes = bytebudget <idiv> remaining
    workbudget = workbudget - allowance; bytebudget = bytebudget - bytes
    if allowance < 1 | bytes < 1 then do; call lineout 'stderr','LL_INLINE_LIMIT: inline.bottomup.allowance'; return 1; end
    if applywave(target,supplied,profile,policy,cleanup,allowance,bytes,order.level(i),reference order) <> 0 then return 1
  end
  return 0

checkproviders: procedure = .int
  arg owner = reference .lltarget..module, supplied = reference .lltarget..module[]
  source = dereference owner; providers = dereference supplied; used = .int[]
  item = .lltarget..record; field = .lltarget..operand; provider = .lltarget..module
  providerindex = .int; procedureid = .int; called = .string; i = .int
  catalog = .llrxascatalog..catalog(); calls = callsites(owner)
  do i = 1 to calls[0]
    item = source.at(calls[i])
    if catalog.callkind(item.opcode()) <> 1 then iterate
    field = item.operand(catalog.calltarget(item.opcode())); called = field.text()
    selected = selectprovider(owner,called,supplied,providerindex,procedureid)
    if selected < 0 then return 0
    if selected = 1 then used[providerindex] = 1
  end
  do i = 1 to providers[0]
    if used[i] then iterate
    provider = providers[i]; call lineout 'stderr','LL_INLINE_BINDING: unused supplied provider ' || provider.name(); return 0
  end
  return 1

/** Expand original bindings atomically, then run the separately callable
 * cleanup once per changed caller, resolving stable names after each change.
 * The checked expansion is independently executable. Optional cleanup failure
 * preserves the latest valid owner and cannot veto its publication. */
applywave: procedure = .int expose inlinephase
  arg expose target = .lltarget..module, supplied = reference .lltarget..module[], profile = .string, policy = .string, cleanup = .int, workbudget = .int, bytebudget = 67108864, wave = 0, ?schedule = reference .callorder
  change = .llinline..change; body = .lltarget..body; request = .llinline..binding
  item = .lltarget..record; field = .lltarget..operand; bodies = .lltarget..module[]
  normalized = .lltargetnormalize..change; context = .llinline..context
  receipt = .llinline..normalizationreceipt
  execution = .lltargettransfer..profile
  prepared = .object[]; names = .string[]; sitenames = .string[]
  siteids = .int[]; providerindices = .int[]; procedureids = .int[]; providerused = .int[]
  procedureid = .int; providerindex = .int; i = .int; j = .int
  ordering = .callorder; callername = .string
  inlinephase = 'wave.selection'
  if ?schedule then ordering = dereference schedule
  bodies = dereference supplied; calls = callsites(reference target); catalog = .llrxascatalog..catalog()
  do i = 1 to calls[0]
    item = target.at(calls[i]); called = ''
    body = target.body(item.procedureid()); callername = body.name()
    if wave > 0 then do
      workbudget = workbudget - ordering.lookupwork()
      if workbudget < 1 then do; call lineout 'stderr','LL_INLINE_LIMIT: inline.callgraph.lookup.work'; return 1; end
      if ordering.includes(callername,wave) = 0 then iterate
    end
    if catalog.callkind(item.opcode()) <> 1 then do
      call keepdiagnostic(reference target,item.id(),'target.selection.authority.unavailable','availability','selection')
      iterate
    end
    do j = 1 to item.operands()
      field = item.operand(j)
      if field.kind() = 'P' then called = field.text()
    end
    selected = selectprovider(reference target,called,supplied,providerindex,procedureid)
    if selected < 0 then return 1
    if selected = 0 then do
      call keepdiagnostic(reference target,item.id(),'unavailable exact body ' || called,'availability','binding')
      iterate
    end
    if selected = 2 & ?schedule then do
      workbudget = workbudget - ordering.lookupwork()
      if workbudget < 1 then do; call lineout 'stderr','LL_INLINE_LIMIT: inline.callgraph.lookup.work'; return 1; end
      if ordering.recursive(callername,called) then do
        call keepdiagnostic(reference target,item.id(),'policy.recursive.scc','policy','selection')
        iterate
      end
    end
    index = siteids[0] + 1
    siteids[index] = calls[i]
    procedureids[index] = procedureid
    if selected = 1 then do
      providerindices[index] = providerindex; providerused[providerindex] = 1
    end
    else do
      providerindices[index] = 0
      body = target.body(procedureid); sitenames[index] = body.name()
    end
  end
  if profile = 'closed-main-static-exact-default-halt.v1' & wave = 0 then do
    do j = 1 to bodies[0]
      if workbudget < 1 then do; call lineout 'stderr','LL_INLINE_LIMIT: import.providers.work'; return 1; end
      workbudget = workbudget - 1
      if providerused[j] = 0 then do
        call lineout 'stderr','LL_INLINE_BINDING: unused supplied provider ' || bodies[j].name()
        return 1
      end
    end
  end
  inlinephase = 'wave.normalization'
  if profile <> 'unknown' then do
    execution = .lltargettransfer..profile.closedcalls(reference target,target.procedureid('main'),profile,workbudget,bytebudget)
    if execution.status() <> 'ok' then do; call lineout 'stderr','LL_INLINE_' || upper(execution.status()) || ': ' || execution.message(); return 1; end
    workbudget = workbudget - execution.usedwork(); bytebudget = bytebudget - execution.usedbytes()
    receipt = .llinline..normalizationreceipt.owned(reference target,workbudget,bytebudget,reference execution)
  end
  else receipt = .llinline..normalizationreceipt.owned(reference target,workbudget,bytebudget)
  if receipt.status() <> 'ok' then do
    call lineout 'stderr','LL_INLINE_NORMALIZATION_' || upper(receipt.status()) || ': ' || receipt.reason()
    return 1
  end
  normalized = receipt.result(); workbudget = workbudget - receipt.reservedwork(); bytebudget = bytebudget - receipt.reservedbytes()
  if workbudget < 1 | bytebudget < 1 then do; call lineout 'stderr','LL_INLINE_LIMIT: normalization remaining work/bytes'; return 1; end
  if normalized.status() = 'changed' then target = normalized.result()
  do i = 1 to normalized.warnings()
    warning = normalized.warning(i)
    call lineout 'stderr',warning.diagnostic()
  end
  if policy = 'never' | siteids[0] = 0 then return 0
  inlinephase = 'wave.context'
  context = .llinline..context('assembler',policy)
  if profile <> 'unknown' then do
    /* Normalization has published another exact owner. Recheck the caller's
     * explicit invocation premise there; the old witness is never reused. */
    execution = .lltargettransfer..profile.closedcalls(reference target,target.procedureid('main'),profile,workbudget,bytebudget)
    if execution.status() <> 'ok' then do
      call lineout 'stderr','LL_INLINE_' || upper(execution.status()) || ': ' || execution.message()
      return 1
    end
    workbudget = workbudget - execution.usedwork(); bytebudget = bytebudget - execution.usedbytes()
    executionbound = context.useexecution(reference target,reference execution)
  end
  if context.certifyreceipt(reference target,normalized,reference receipt) = 0 then do
    call keepdiagnostic(reference target,0,normalized.reason(),'proof','normalization')
    return 0
  end
  inlinephase = 'wave.bindings'
  do i = 1 to siteids[0]
    callid = normalized.operation(siteids[i])
    if providerindices[i] = 0 then do
      procedureid = target.procedureid(sitenames[i])
      request = llinline..bind(reference target,callid,reference target,procedureid)
    end
    else do
      request = llinline..bind(reference target,callid,reference bodies[providerindices[i]],procedureids[i])
    end
    prepared[i] = request as .object
  end
  inlinephase = 'wave.expand'
  change = llinline..expandcontext(prepared,context,workbudget,1000000,bytebudget)
  inlinephase = 'wave.expand.returned'
  do i = 1 to change.sites()
    site = change.site(i)
    if change.statusat(site) = 'keep' then do
      inlinephase = 'wave.keepdiagnostic'
      call keepdiagnostic(reference target,site,change.reasonat(site))
    end
  end
  if change.status() = 'keep' then return 0
  if change.status() <> 'changed' then do; call lineout 'stderr','LL_INLINE_' || upper(change.status()) || ': ' || change.reason(); return 1; end
  inlinephase = 'wave.result'
  target = change.result()
  inlinephase = 'wave.result.returned'
  if cleanup = 0 then return 0
  do i = 1 to change.callers()
    body = target.body(change.caller(i)); names[i] = body.name()
  end
  do i = 1 to names[0]
    procedureid = target.procedureid(names[i])
    call optionalcleanup(target,procedureid,profile,workbudget,'transport')
    procedureid = target.procedureid(names[i])
    call optionalcleanup(target,procedureid,profile,workbudget,'storage')
  end
  return 0

/** A cleanup refusal is ordinary; an internal failure stays visible. Neither
 * can replace the last validated owner. Successful conservative publication
 * returns success even when this optional optimization could not complete. */
optionalcleanup: procedure = .void
  arg expose target = .lltarget..module, procedureid = .int, profile = .string, workbudget = .int, stage = .string
  cleaned = .llinline..change; candidate = .lltarget..module
  prefix = 'LL_CLEANUP'; if stage = 'storage' then prefix = 'LL_STORAGE'
  do
    if stage = 'storage' then cleaned = llcleanup..storage(reference target,procedureid,profile,workbudget)
    else cleaned = llcleanup..transport(reference target,procedureid,profile,workbudget)
    if cleaned.status() = 'keep' then call lineout 'stderr',prefix || '_KEEP: ' || cleaned.reason()
    else if cleaned.status() <> 'changed' then call lineout 'stderr',prefix || '_FAILED: ' || cleaned.status() || ': ' || cleaned.reason()
    else do
      candidate = cleaned.result()
      if candidate.valid() then target = candidate
      else call lineout 'stderr',prefix || '_FAILED: invalid: ' || candidate.error()
    end
  on signal as problem
    call lineout 'stderr',prefix || '_FAILED: ' || problem.name() || ': ' || problem.message()
  end
  return

/** Retain the complete authoritative reason and one record for every site.
 * The appended labels describe its diagnostic namespace, never proof facts.
 * IDs and spans refer to the frozen input, before output-owner replacement. */
keepdiagnostic: procedure = .void
  arg owner = reference .lltarget..module, callid = .int, reason = .string, category = '', layer = ''
  source = dereference owner; root = ''; second = ''
  item = .lltarget..record; field = .lltarget..operand
  if category = '' then do
    names = translate(reason,' ','.'); root = word(names,1); second = word(names,2)
    category = 'unclassified'; layer = 'unclassified'
    select
      when root = 'policy' then do; category = 'policy'; layer = 'selection'; end
      when root = 'binding' | root = 'import' then do; category = 'availability'; layer = 'binding'; end
      when root = 'target' then do
        category = 'proof'; layer = 'target.' || second
        if wordpos(second,'body bodyview selection') > 0 then category = 'availability'
      end
      when root = 'normalization' then do; category = 'proof'; layer = 'normalization'; end
      when root = 'expansion' then do
        category = 'proof'; layer = 'target.expansion'
        if second = 'correspondence' then layer = 'target.correspondence'
        if pos('.work',reason) > 0 | pos('.bytes',reason) > 0 then category = 'resource'
      end
      when root = 'signal' then do; category = 'proof'; layer = 'signal'; end
      when wordpos(root,'scopefree argument arithmetic binary component entry global profile return string value') > 0 then do; category = 'proof'; layer = root; end
      when root = 'inline' then do; category = 'proof'; layer = 'inline'; end
      otherwise nop
    end
  end
  scope = 'module'; if callid > 0 then scope = 'call'
  context = ' [category=' || category || ' layer=' || layer || ' scope=' || scope
  context = context || ' owner=' || source.identity() || ' module=' || keepfield(source.name())
  if callid > 0 then do
    item = source.at(callid); graph_ref = source.ir(); graph = dereference graph_ref
    fn = graph.function(item.procedureid()); at = item.origin()
    context = context || ' procedure=' || keepfield(fn.name()) || ' call=' || callid
    context = context || ' source=' || keepfield(at.filename()) || ' bytes=' || at.first() || ':' || at.last() || ' origin=' || at.kind()
    catalog = .llrxascatalog..catalog(); ordinal = catalog.calltarget(item.opcode()); target = ''
    if ordinal > 0 & ordinal <= item.operands() then do
      field = item.operand(ordinal)
      if field.kind() = 'R' then target = field.bank() || field.index()
      else target = field.text()
    end
    context = context || ' target=' || keepfield(target)
  end
  call lineout 'stderr','LL_INLINE_KEEP: ' || reason || context || ']'
  return

/** Bound before escaping; the full API reason and numeric site locators stay
 * available even when a displayed name is longer than this fixed allowance. */
keepfield: procedure = .string
  arg text = .string
  if length(text) > 256 then text = left(text,256) || '...[truncated]'
  return rxjson..jsonquote(text)

usage: procedure = .int
  arg reason = ''
  if reason <> '' then call lineout 'stderr','LL_INLINE_OPTIONS: ' || reason
  call lineout 'stderr','Usage: llrxinline --module logical -o output.rxas [--artifact identity] [--body logical source.rxas] [--profile closed-main-default-halt.v1|closed-main-static-exact-default-halt.v1] [--policy default|all-legal|never] [--work positive-decimal] [--no-cleanup] source.rxas'
  call lineout 'stderr','The closed-main profile requires a fresh standalone root with default HALT policy; unknown profile retains calls.'
  call lineout 'stderr','Static-exact additionally requires delivery from the exact caller and provider sources, with no alternate providers or pre-entry invocation.'
  return 2

/** Read bytes under the source adapter's allowance before accumulating them.
 * Ordinary VM file primitives are IO, never a compiler/assembler backend. */
readsource: procedure = .binary
  arg path = .string, limit = .int
  file = 0; result = .binary; mode = 'rb'; remaining = .int; size = .int
  do
    if limit < 1 then assembler signal "ERROR","LL_RESOURCE_LIMIT: source input bytes"
    assembler fopen file,path,mode
    if file = 0 then assembler signal "ERROR","LL_INLINE_INPUT: cannot open source"
    eof = 0
    do while eof = 0
      remaining = limit - <blen>(result); size = 32768
      if remaining < size then size = remaining + 1
      chunk = .binary; assembler freadb chunk,file,size
      status = 0; assembler ferror status,file
      if status <> 0 then assembler signal "ERROR","LL_INLINE_INPUT: source read failed"
      if <blen>(chunk) > remaining then assembler signal "ERROR","LL_RESOURCE_LIMIT: source input bytes"
      assembler bappend result,chunk
      assembler feof eof,file
      if <blen>(chunk) = 0 & eof = 0 then assembler signal "ERROR","LL_INLINE_INPUT: source read made no progress"
    end
    status = 0; assembler fclose status,file; file = 0
    if status <> 0 then assembler signal "ERROR","LL_INLINE_INPUT: source close failed"
    return result
  on signal as problem
    if file <> 0 then do; ignored = 0; assembler fclose ignored,file; end
    message = problem.message(); assembler signal "ERROR",message
  end
  return result

/** The native linker owns this transient manifest and independently validates
 * the returned files before replacing its selected modules. All provider and
 * caller owners below remain frozen while every binding is expanded. */
/** Native host passes the actual session it constructed and enrolled. The
 * manifest remains a request/diagnostic locator, never a proof constructor. */
selectionexecute: procedure = .int
  arg state = .llrxinlinestage..session, manifestpath = .string, resultpath = .string, policy = .string, workbudget = .int
  return selectionmode(manifestpath,resultpath,policy,workbudget,reference state)

selectionmode: procedure = .int
  arg manifestpath = .string, resultpath = .string, policy = .string, workbudget = .int, ?staged = reference .llrxinlinestage..session
  outputs = .lltarget..module[]
  moduleowners = .string[]; modulenames = .string[]
  moduleinputs = .string[]; moduleoutputs = .string[]; changed = .int[]
  procowners = .string[]; procsymbols = .string[]; procconstants = .int[]; procmodules = .int[]; procnormal = .int[]
  bindings = .object[]; bindingowners = .int[]; localbindings = .object[]
  target = .lltarget..module; body = .lltarget..body; record = .lltarget..record
  parsed = .llrxasinput..parsed; frontend = .llrxasinput..reader; normalized = .lltargetnormalize..change
  request = .llinline..binding; context = .llinline..context; expanded = .llinline..change
  emitted = .llrxasoutput..emission; writer = .llir..writer
  doc = .rxjson..jsondocument; catalog = .llrxascatalog..catalog()
  fault = .string; prefix = .string; i = .int; j = .int
  allowance = .int; byteallowance = .int
  points = reference .lltargetflow..analysis; summaries = reference .lltargetsummary..analysis
  receipt_ref = reference .llinline..normalizationreceipt
  do
    /* Live links must be declared and bound in this same block scope. They
     * retain the native session's exact array cells for every later site. */
    raw = .lltarget..module[]; frozen = .lltarget..module[]; normalizations = .lltargetnormalize..change[]
    receipts = .llinline..normalizationreceipt[]
    stage = .llrxinlinestage..session
    raw_ref = reference .lltarget..module[]; result_ref = reference .lltarget..module[]
    normalizations_ref = reference .lltargetnormalize..change[]
    source = readsource(manifestpath,67108864)
    remainingbytes = 67108864 - <blen>(source)
    doc = .jsondocument(source as .string)
    if doc.valid() = 0 then do; fault = 'LL_INLINE_SELECTION: invalid JSON: ' || doc.error(); assembler signal "ERROR",fault; end
    if doc.type('') <> 'object' then assembler signal "ERROR","LL_INLINE_SELECTION: root object required"
    if selectiontext(reference doc,'version') <> 'llinline.selection.v1' then assembler signal "ERROR","LL_INLINE_SELECTION: unsupported version"
    transaction = selectiontext(reference doc,'transaction')
    if selectiontext(reference doc,'catalog') <> catalog.fingerprint() then assembler signal "ERROR","LL_INLINE_SELECTION: catalogue mismatch"
    if doc.type('modules') <> 'array' | doc.type('procedures') <> 'array' | doc.type('bindings') <> 'array' then assembler signal "ERROR","LL_INLINE_SELECTION: module/procedure/binding arrays required"
    modulecount = doc.count('modules'); procedurecount = doc.count('procedures'); bindingcount = doc.count('bindings')
    if modulecount < 1 | modulecount > workbudget | procedurecount > workbudget | bindingcount > workbudget then assembler signal "ERROR","LL_RESOURCE_LIMIT: selection rows"
    frontend = .llrxasinput..reader(); context = .llinline..context('linker',policy)
    if ?staged then stage = dereference staged
    if ?staged then do
      if modulecount <> stage.count() then assembler signal "ERROR","LL_INLINE_SELECTION: native session module count mismatch"
      raw_ref = stage.rawarray(); result_ref = stage.resultarray(); normalizations_ref = stage.normalizationarray()
    end
    if ?staged then raw = dereference raw_ref
    if ?staged then frozen = dereference result_ref
    if ?staged then normalizations = dereference normalizations_ref
    if context.status() <> 'ok' then do; fault = 'LL_INLINE_SELECTION: ' || context.reason(); assembler signal "ERROR",fault; end
    /* Complete raw allocation before lending any element to a receipt. */
    do i = 1 to modulecount
      prefix = 'modules.' || i || '.'
      if selectionnumber(reference doc,prefix || 'ordinal') <> i - 1 then assembler signal "ERROR","LL_INLINE_SELECTION: nonconsecutive module ordinal"
      moduleowners[i] = selectiontext(reference doc,prefix || 'owner')
      modulenames[i] = selectiontext(reference doc,prefix || 'name')
      moduleinputs[i] = selectiontext(reference doc,prefix || 'input')
      moduleoutputs[i] = selectiontext(reference doc,prefix || 'output')
      do j = 1 to i - 1
        if moduleowners[j] = moduleowners[i] | moduleoutputs[j] = moduleoutputs[i] then assembler signal "ERROR","LL_INLINE_SELECTION: duplicate owner/output"
      end
      if ?staged then do
        target = raw[i]
        if target.name() <> modulenames[i] then assembler signal "ERROR","LL_INLINE_SELECTION: native session module name mismatch"
      end
      else do
        source = readsource(moduleinputs[i],remainingbytes)
        remainingbytes = remainingbytes - <blen>(source)
        parsed = frontend.parse(source,modulenames[i],modulenames[i])
        if parsed.status() <> 0 then do; fault = parsed.diagnostic(); assembler signal "ERROR",fault; end
        raw[i] = parsed.result()
      end
    end
    if ?staged = 0 then do
      /* Factories are lazy. Finish the receipt array before the first status
       * constructs field-owned references in one of its elements. */
      allowance = workbudget <idiv> modulecount; byteallowance = remainingbytes <idiv> modulecount
      do i = 1 to modulecount
        receipts[i] = .llinline..normalizationreceipt.owned(reference raw[i],allowance,byteallowance)
      end
      do i = 1 to modulecount
        if receipts[i].status() <> 'ok' then do; fault = 'LL_INLINE_SELECTION: normalization ' || receipts[i].status() || ': ' || receipts[i].reason(); assembler signal "ERROR",fault; end
        normalized = receipts[i].result()
        workbudget = workbudget - receipts[i].reservedwork(); remainingbytes = remainingbytes - receipts[i].reservedbytes()
        if normalized.status() = 'invalid' | normalized.status() = 'limit' then do
          fault = 'LL_INLINE_SELECTION: normalization ' || normalized.status() || ': ' || normalized.reason()
          assembler signal "ERROR",fault
        end
        normalizations[i] = normalized; frozen[i] = normalized.result()
      end
    end
    /* All result slots are fixed before a stamp borrows one. Staged owners
     * remain live links to the host's already fixed result array. */
    do i = 1 to modulecount
      normalized = normalizations[i]
      if normalized.status() = 'invalid' | normalized.status() = 'limit' then do
        fault = 'LL_INLINE_SELECTION: normalization ' || normalized.status() || ': ' || normalized.reason()
        assembler signal "ERROR",fault
      end
      outputs[i] = frozen[i]
      if normalized.status() = 'changed' then changed[i] = 1
      if normalized.status() = 'changed' | normalized.status() = 'keep' then do
        if ?staged then receipt_ref = stage.receipt(i)
        else receipt_ref = reference receipts[i]
        if context.certifyreceipt(reference frozen[i],normalized,receipt_ref) = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: normalization certificate"
      end
      else call keepdiagnostic(reference frozen[i],0,normalized.reason(),'proof','normalization')
      do j = 1 to normalized.warnings()
        warning = normalized.warning(j)
        call lineout 'stderr','LL_RXAS_WARNING: ' || warning.message()
      end
    end
    do i = 1 to procedurecount
      prefix = 'procedures.' || i || '.'
      procowners[i] = selectiontext(reference doc,prefix || 'owner')
      procconstants[i] = selectionnumber(reference doc,prefix || 'constant')
      ordinal = selectionnumber(reference doc,prefix || 'ordinal')
      symbol = selectiontext(reference doc,prefix || 'symbol')
      procsymbols[i] = symbol
      locals = selectionnumber(reference doc,prefix || 'locals')
      moduleindex = selectionmodule(moduleowners,procowners[i])
      if moduleindex = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: procedure owner absent"
      do j = 1 to i - 1
        if procowners[j] = procowners[i] & procconstants[j] = procconstants[i] then assembler signal "ERROR","LL_INLINE_SELECTION: duplicate procedure constant"
      end
      target = raw[moduleindex]
      rawfunction = target.procedureid(symbol)
      if rawfunction = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: procedure symbol absent"
      body = target.body(rawfunction)
      if upper(body.name()) <> upper(symbol) | body.locals() <> locals then assembler signal "ERROR","LL_INLINE_SELECTION: procedure identity mismatch"
      /* Body views borrow target's graph; retain its name before replacing
       * that owner with the normalized module. */
      name = body.name()
      target = frozen[moduleindex]; functionid = target.procedureid(name)
      if functionid = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: normalized procedure absent"
      procmodules[i] = moduleindex; procnormal[i] = functionid
      if context.certifyprocedure(reference frozen[moduleindex],transaction,target.identity(),moduleindex - 1,functionid,ordinal) = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: procedure certificate"
    end
    do i = 1 to bindingcount
      prefix = 'bindings.' || i || '.'
      caller = selectiontext(reference doc,prefix || 'caller')
      provider = selectiontext(reference doc,prefix || 'provider')
      callerconstant = selectionnumber(reference doc,prefix || 'procedure')
      targetconstant = selectionnumber(reference doc,prefix || 'target')
      instructionordinal = selectionnumber(reference doc,prefix || 'instruction_ordinal')
      callerindex = selectionmodule(moduleowners,caller); providerindex = selectionmodule(moduleowners,provider)
      callerrow = selectionprocedure(procowners,procconstants,caller,callerconstant)
      providerrow = selectionprocedure(procowners,procconstants,provider,targetconstant)
      if callerindex = 0 | providerindex = 0 | callerrow = 0 | providerrow = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: binding owner/procedure absent"
      target = raw[callerindex]; body = target.body(target.procedureid(procsymbols[callerrow]))
      n = 0; callid = 0
      do j = 1 to body.records()
        record = body.record(j)
        if record.kind() <> 'instruction' then iterate
        if n = instructionordinal then do; callid = record.id(); leave; end
        n = n + 1
      end
      if callid = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: instruction ordinal outside procedure"
      callid = normalizations[callerindex].operation(callid)
      request = llinline..bind(reference frozen[callerindex],callid,reference frozen[providerindex],procnormal[providerrow])
      if request.valid() = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: stale binding"
      if callerindex <> providerindex then do
        target = frozen[callerindex]; provider_target = frozen[providerindex]
        if context.certifyselected(request,transaction,target.identity(),provider_target.identity(),providerindex - 1) = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: foreign selection certificate"
      end
      bindings[i] = request as .object; bindingowners[i] = callerindex
    end
    do i = 1 to modulecount
      call objectarraydrop localbindings
      do j = 1 to bindingcount
        if bindingowners[j] = i then localbindings[localbindings[0] + 1] = bindings[j]
      end
      if localbindings[0] = 0 | policy = 'never' then iterate
      allowance = workbudget <idiv> (modulecount - i + 1)
      if ?staged then do
        points = stage.points(i); summaries = stage.summaries(i)
        if context.usefacts(reference frozen[i],points,summaries) = 0 then assembler signal "ERROR","LL_INLINE_SELECTION: shared native owner facts rejected"
        allowance = stage.claimwork(modulecount - i + 1)
      end
      else workbudget = workbudget - allowance
      expanded = llinline..expandcontext(localbindings,context,allowance)
      if expanded.status() = 'changed' then do; outputs[i] = expanded.result(); changed[i] = 1; end
      else if expanded.status() <> 'keep' then do; fault = 'LL_INLINE_SELECTION: expansion ' || expanded.status() || ': ' || expanded.reason(); assembler signal "ERROR",fault; end
      do j = 1 to expanded.sites()
        if expanded.statusat(expanded.site(j)) = 'keep' then call keepdiagnostic(reference frozen[i],expanded.site(j),expanded.reasonat(expanded.site(j)))
      end
    end
    response = '{"version":"llinline.selection.result.v1","transaction":' || rxjson..jsonquote(transaction) || ',"catalog":' || rxjson..jsonquote(catalog.fingerprint()) || ',"modules":['
    do i = 1 to modulecount
      emitted = llrxasoutput..render(reference outputs[i])
      if emitted.error() <> '' then do; fault = 'LL_INLINE_SELECTION: render ' || emitted.error(); assembler signal "ERROR",fault; end
      message = llfileoutput..publish(emitted.output(),moduleoutputs[i])
      if message <> '' then assembler signal "ERROR",message
      if i > 1 then response = response || ','
      flag = 'false'; if changed[i] then flag = 'true'
      response = response || '{"owner":' || rxjson..jsonquote(moduleowners[i]) || ',"ordinal":' || (i - 1) || ',"changed":' || flag || ',"output":' || rxjson..jsonquote(moduleoutputs[i]) || '}'
    end
    response = response || ']}'
    writer = .llir..writer(); call writer.write(response)
    message = llfileoutput..publish(writer.finish(),resultpath)
    if message <> '' then assembler signal "ERROR",message
    return 0
  on signal as problem
    call lineout 'stderr','LL_INLINE_SELECTION: ' || problem.name() || ': ' || problem.message()
    return 1
  end
  return 1

selectiontext: procedure = .string
  arg document = reference .rxjson..jsondocument, path = .string
  doc = dereference document; fault = .string
  if doc.type(path) <> 'string' then do; fault = 'LL_INLINE_SELECTION: string required at ' || path; assembler signal "ERROR",fault; end
  value = doc.get(path)
  if value = '' then do; fault = 'LL_INLINE_SELECTION: empty string at ' || path; assembler signal "ERROR",fault; end
  return value

selectionnumber: procedure = .int
  arg document = reference .rxjson..jsondocument, path = .string
  doc = dereference document; value = 0; fault = .string
  if doc.type(path) <> 'number' | doc.node_int(doc.find(path),value) <> 0 | value < 0 then do
    fault = 'LL_INLINE_SELECTION: nonnegative integer required at ' || path; assembler signal "ERROR",fault
  end
  return value

selectionmodule: procedure = .int
  arg owners = .string[], name = .string
  do i = 1 to owners[0]
    if owners[i] = name then return i
  end
  return 0

selectionprocedure: procedure = .int
  arg owners = .string[], constants = .int[], owner = .string, codeconstant = .int
  do i = 1 to owners[0]
    if owners[i] = owner & constants[i] = codeconstant then return i
  end
  return 0

/** The native linker invokes this exported reader in the already loaded B
 * service after main has published its private result. It receives only a
 * typed flat snapshot and compares every field to the frozen native set. */
selectionresult: procedure = .string[]
  arg path = .string
  values = .string[]; empty = .string[]
  do
    source = readsource(path,67108864)
    doc = .jsondocument(source as .string)
    if doc.valid() = 0 | doc.type('') <> 'object' | doc.node_count(doc.root()) <> 4 then return values
    if doc.type('modules') <> 'array' then return values
    count = doc.count('modules')
    if count < 1 | count > 100000 then return values
    version = selectiontext(reference doc,'version')
    transaction = selectiontext(reference doc,'transaction')
    catalog = selectiontext(reference doc,'catalog')
    if version <> 'llinline.selection.result.v1' then return values
    values[1] = version; values[2] = transaction; values[3] = catalog
    do i = 1 to count
      prefix = 'modules.' || i || '.'
      node = doc.find('modules.' || i)
      if doc.node_type(node) <> 'object' | doc.node_count(node) <> 4 then return empty
      owner = selectiontext(reference doc,prefix || 'owner')
      ordinal = selectionnumber(reference doc,prefix || 'ordinal')
      if ordinal <> i - 1 | doc.type(prefix || 'changed') <> 'boolean' then return empty
      changed = doc.get(prefix || 'changed')
      output = selectiontext(reference doc,prefix || 'output')
      base = 4 * i
      values[base] = owner; values[base + 1] = ordinal as .string; values[base + 2] = changed; values[base + 3] = output
    end
    return values
  on signal
    return empty
  end
  return empty
