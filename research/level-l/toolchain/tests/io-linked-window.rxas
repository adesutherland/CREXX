/* The retained child sees five pointers across the outer r/a boundary.
 * Distinct actuals give 11+52+20+30+40=153, plus the snapshot 10=163.
 * Aliased first/fifth actuals mutate 5 to 8: 8+8+7+11+13=47, plus 5=52.
 * The overlapping result becomes the next y: 11+11+52+11+13+8=106. */
.globals=0
main() .locals=14
  load r0,5
  load r1,10
  load r2,20
  load r3,30
  load r4,40
  load r5,50
  call r6,windowouter(),r0
  icopy r7,r1
  icopy r8,r2
  icopy r9,r5
  load r1,5
  load r2,7
  load r3,11
  load r4,13
  link r5,r1
  call r2,windowouter(),r0
  icopy r10,r2
  icopy r11,r1
  call r2,windowouter(),r0
  icopy r12,r2
  icopy r13,r1
  unlink r5
  itos r6
  say r6
  itos r7
  say r7
  itos r8
  say r8
  itos r9
  say r9
  itos r10
  say r10
  itos r11
  say r11
  itos r12
  say r12
  itos r13
  say r13
  ret 0

/* r1 is followed by a0/a1/a2/a3/a4. The source swaps reorder the first
 * two actuals; its inverse and the outer mapping can disappear after proof.
 * The child result a2 also supplies its third actual, retaining the old y
 * until the child has read it. The owned snapshot must survive both calls. */
windowouter() .locals=2
  icopy r0,a1
  link a0,a5
  load r1,5
  swap a0,a1
  .srcstep 1 1 0 "io-linked-window.rxas" 58 3 25 "  call a2,windowleaf(),r1"
  .traceevent "V" 4 "R" "I" "a" 2 1 1 0 "window-result" ""
  call a2,windowleaf(),r1
  swap a0,a1
  unlink a0
  iadd r0,r0,a2
  ret r0

windowleaf() .locals=1
  iadd a1,a1,1
  iadd a2,a2,2
  iadd r0,a1,a2
  iadd r0,r0,a3
  iadd r0,r0,a4
  iadd r0,r0,a5
  ret r0
