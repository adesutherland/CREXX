/* A callee pointer permutation must keep caller storage and borrowed return. */
.globals=0
main() .locals=6
  load r0,11
  load r1,23
  swap r3,r1
  swap r4,r0
  call2 r5,proxy(),r3,r4
  swap r0,r4
  swap r1,r3
  itos r5
  say r5
  itos r0
  say r0
  itos r1
  say r1
  ret 0
proxy() .locals=0
  swap a1,a2
  ret a1
