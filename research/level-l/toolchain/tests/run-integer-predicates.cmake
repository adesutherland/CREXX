cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER CLI FIXTURES WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
include("${FIXTURES}/signal-pair-helpers.cmake")
file(READ "${FIXTURES}/io-integer-predicates.rxas" _original)
foreach(_input -1 0 1)
  # One activation preserves the golden body's own recycler/whole-TRACE
  # boundary. Repeated unreset activations remain a separate negative control.
  string(REPLACE "load r0,-1" "load r0,${_input}" _source "${_original}")
  set(_source_path "${WORK}/input-${_input}.rxas")
  file(WRITE "${_source_path}" "${_source}")
  set(_expected "${_input}\n0\nkeep\n512\n0\nkeep\n512")
foreach(_mode conservative cleaned)
  set(_option "")
  if(_mode STREQUAL conservative)
    set(_option --no-cleanup)
  endif()
  set(_product "${WORK}/predicates-${_input}-${_mode}")
  run_checked("expand integer predicates ${_mode}" "${VM}" "${CLI}" ${RUNTIME} -a
    --module integer-predicates.rxas --profile closed-main-default-halt.v1 ${_option}
    -o "${_product}.rxas" "${_source_path}")
  file(READ "${_product}.rxas" _expanded)
  string(FIND "${_expanded}" "classify() .locals=" _end)
  string(SUBSTRING "${_expanded}" 0 ${_end} _caller)
  if(_caller MATCHES "(^|\n)[ \t]*(call[1234]?|ichkrng|igtbr|iltbr)[ \t]")
    message(FATAL_ERROR "Predicates retained a selected call or added compare helpers/guards")
  endif()
  if(_mode STREQUAL conservative)
    string(REGEX MATCHALL "(^|\n)[ \t]*(ilt|igt) " _predicates "${_caller}")
    list(LENGTH _predicates _predicate_count)
    set(_expected_predicates 3)
    if(_input EQUAL -1)
      set(_expected_predicates 2)
    endif()
    if(NOT _predicate_count EQUAL _expected_predicates)
      message(FATAL_ERROR "Conservative expansion lost original reached predicate instructions")
    endif()
    string(REGEX MATCH "[.]srcstep ([0-9]+) ([0-9]+) 17 \"inline_test_multi_return_assign[.]crexx\" 14 3 13 [^\n]*\n[ \t]*[.]traceevent \"V\" 6 \"R\" \"I\" \"r\" ([0-9]+) ([0-9]+) ([0-9]+) 0 \"val\" \"\"\n[ \t]*ilt r([0-9]+),r([0-9]+),0" _comparison "${_caller}")
    if(NOT _comparison OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_4 OR
        NOT CMAKE_MATCH_2 STREQUAL CMAKE_MATCH_5 OR NOT CMAKE_MATCH_3 STREQUAL CMAKE_MATCH_7)
      message(FATAL_ERROR "Classify predicate lost its source, incoming read or TRACE identity")
    endif()
    set(_event ".traceevent \"O\" 4 \"R\" \"B\" \"r\" ${CMAKE_MATCH_6} ${CMAKE_MATCH_1} ${CMAKE_MATCH_2} 0 \"\" \"\"")
    string(FIND "${_caller}" "${_event}" _event_at)
    if(_event_at LESS 0)
      message(FATAL_ERROR "Classify result event lost the original predicate destination")
    endif()
    string(REGEX MATCH "[.]srcstep ([0-9]+) ([0-9]+) 17 \"predicate-alias[.]rxas\" 30 1 20 [^\n]*\n[ \t]*[.]traceevent \"V\" 6 \"R\" \"I\" \"r\" ([0-9]+) ([0-9]+) ([0-9]+) 0 \"alias-before\" \"\"\n[ \t]*igt r([0-9]+),r([0-9]+),0" _alias "${_caller}")
    if(NOT _alias OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_4 OR
        NOT CMAKE_MATCH_2 STREQUAL CMAKE_MATCH_5 OR NOT CMAKE_MATCH_3 STREQUAL CMAKE_MATCH_7 OR
        NOT CMAKE_MATCH_6 STREQUAL CMAKE_MATCH_7 OR CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Aliased predicate lost its incoming active slot or distinct source/clause IDs")
    endif()
  endif()
  bound_pair("predicates-${_input}-${_mode}" "${_source}" "${_expanded}" "${_expected}")
endforeach()
endforeach()

# A fresh owned local has whole-null knowledge without an integer definition.
string(REPLACE "ilt r1,a1,0" "ilt r1,r1,0" _undefined "${_original}")
file(WRITE "${WORK}/undefined.rxas" "${_undefined}")
run_checked("retain undefined predicate input" "${VM}" "${CLI}" ${RUNTIME} -a
  --module integer-predicate-undefined.rxas --profile closed-main-default-halt.v1 --no-cleanup
  -o "${WORK}/undefined-kept.rxas" "${WORK}/undefined.rxas")
file(READ "${WORK}/undefined-kept.rxas" _kept)
if(NOT _last_stderr MATCHES "predicate[.]operand[.]unproved" OR NOT _kept MATCHES "call1 r1,classify[(][)],r0")
  message(FATAL_ERROR "Undefined integer predicate lost its exact refusal: ${_last_stderr}")
endif()
file(WRITE "${WORK}/last-good.rxas" "predicate-last-good\n")
execute_process(COMMAND "${VM}" "${CLI}" ${RUNTIME} -a --module integer-predicate-limit.rxas
  --profile closed-main-default-halt.v1 --work 1 -o "${WORK}/last-good.rxas"
  "${FIXTURES}/io-integer-predicates.rxas"
  RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
file(READ "${WORK}/last-good.rxas" _last_good)
if(_status EQUAL 0 OR NOT _stderr MATCHES "LL_INLINE_LIMIT:" OR NOT _last_good STREQUAL "predicate-last-good\n")
  message(FATAL_ERROR "Predicate work refusal changed last-good publication: ${_stdout}${_stderr}")
endif()
file(REMOVE_RECURSE "${WORK}")
message("RXAS_INTEGER_PREDICATES|failures=0")
