/* Shared footprint oracle: stdout is "kept\n256\n44\n".
 * The integer result in r0 is dead; its string and ABI flag remain live while
 * the independent integer in r1 is also live. Integer liveness alone cannot
 * license a whole-cell clear, release or overlapping assignment. */
.globals=0
main() .locals=3
  null r0
  load r0,17
  load r0,"kept"
  settp r0,256
  isub r0,r0,1
  load r1,44
  getandtp r2,r0,768
  say r0
  itos r2
  say r2
  itos r1
  say r1
  ret 0
