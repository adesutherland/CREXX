/* cREXX License (MIT). Independent constructed imported-leaf contract. */
options levelb
import rxfnsb
import llir
import lltarget
import llinline
import llcleanup

check: procedure = .int
  arg condition = .int, message = .string
  if condition then return 0
  say 'FAIL:' message
  return 1

one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object
  return body.emit(name,fields,at)
two: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object
  return body.emit(name,fields,at)
three: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, third = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object; fields[3] = third as .object
  return body.emit(name,fields,at)

startup: procedure = .int
  arg draft = .lltarget..draft, target = .string, option = .string, at = .llir..origin
  fields = .object[]; fields[1] = .lltarget..operand.string('startup' as .binary) as .object
  fields[2] = .lltarget..operand.string(option as .binary) as .object
  fields[3] = .lltarget..operand.string('.void' as .binary) as .object
  fields[4] = .lltarget..operand.procedure(target) as .object
  fields[5] = .lltarget..operand.string(''x as .binary) as .object
  return draft.record('.meta',fields,at)

/** Both modules intentionally allocate equal numeric source/origin IDs. */
provider: procedure = .lltarget..module
  arg variant = 0
  ignored = .int
  globals = 0; locals = 0; exposed = 'fixture.bump'; name = 'leaf'
  if variant = 1 then globals = 1
  if variant = 2 | variant = 10 | variant = 11 | variant = 12 then locals = 1
  if variant = 3 then exposed = 'fixture.other'
  if variant = 4 then name = 'main'
  draft = .lltarget..draft('provider','fixture:provider',globals)
  file = draft.source('provider-source.rxas','provider' as .binary); at = file.origin(0,8)
  if variant = 5 then ignored = startup(draft,name,'.initializer',at)
  if variant = 6 then ignored = startup(draft,name,'unknown-startup',at)
  leaf = draft.procedure(name,locals,at,exposed)
  fields = .object[]
  fields[1] = .lltarget..operand.integer(1) as .object; fields[2] = fields[1]
  fields[3] = .lltarget..operand.integer(0) as .object
  fields[4] = .lltarget..operand.string('provider-source.rxas' as .binary) as .object
  fields[5] = .lltarget..operand.integer(1) as .object; fields[6] = fields[5]
  fields[7] = .lltarget..operand.integer(8) as .object
  fields[8] = .lltarget..operand.string('provider' as .binary) as .object
  ignored = leaf.record('.srcstep',fields,at)
  if variant = 9 then do stepid = 2 to 97
    fields[1] = .lltarget..operand.integer(stepid) as .object
    fields[2] = fields[1]
    ignored = leaf.record('.srcstep',fields,at)
  end
  call objectarraydrop fields
  fields[1] = .lltarget..operand.string('V' as .binary) as .object
  fields[2] = .lltarget..operand.integer(4) as .object
  fields[3] = .lltarget..operand.string('R' as .binary) as .object
  fields[4] = .lltarget..operand.string('I' as .binary) as .object
  fields[5] = .lltarget..operand.string('a' as .binary) as .object
  fields[6] = .lltarget..operand.integer(1) as .object; fields[7] = fields[6]; fields[8] = fields[6]
  fields[9] = .lltarget..operand.integer(0) as .object
  fields[10] = .lltarget..operand.string('actual' as .binary) as .object
  fields[11] = .lltarget..operand.string(''x as .binary) as .object
  ignored = leaf.record('.traceevent',fields,at)
  if variant = 7 then do
    ignored = three(leaf,'call1',leaf.reg('a',1),.lltarget..operand.procedure('child'),leaf.reg('a',1),at)
  end
  if variant = 8 then do
    call objectarraydrop fields
    fields[1] = .lltarget..operand.string('leaf' as .binary) as .object
    fields[2] = .lltarget..operand.string('.inline' as .binary) as .object
    fields[3] = .lltarget..operand.string('opaque source transport' as .binary) as .object
    ignored = leaf.record('.meta',fields,at)
  end
  select variant
    when 10 then do
      /* Original owned RET moves and resets this snapshot before reuse. */
      ignored = two(leaf,'icopy',leaf.reg('r',0),leaf.reg('a',1),at)
      ignored = three(leaf,'iadd',leaf.reg('a',1),leaf.reg('a',1),.lltarget..operand.integer(7),at)
      ignored = one(leaf,'ret',leaf.reg('r',0),at)
    end
    when 11 then do
      /* Encoded local, active borrowed pointer: RET must COPY the actual. */
      ignored = two(leaf,'link',leaf.reg('r',0),leaf.reg('a',1),at)
      ignored = one(leaf,'ret',leaf.reg('r',0),at)
    end
    when 12 then do
      /* The second LOAD preserves flags256 left by the first activation.
       * Whole COPY observes them before SETTP executes again. */
      ignored = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(5),at)
      ignored = two(leaf,'copy',leaf.reg('a',1),leaf.reg('r',0),at)
      ignored = two(leaf,'settp',leaf.reg('r',0),.lltarget..operand.integer(256),at)
      ignored = one(leaf,'ret',leaf.reg('a',1),at)
    end
    otherwise do
      ignored = three(leaf,'iadd',leaf.reg('a',1),leaf.reg('a',1),.lltarget..operand.integer(7),at)
      ignored = one(leaf,'ret',leaf.reg('a',2),at)
    end
  end
  if variant = 7 then do
    child = draft.procedure('child',0,at)
    ignored = one(child,'ret',.lltarget..operand.integer(0),at)
  end
  return draft.finish()

caller: procedure = .lltarget..module
  arg variant = 0
  ignored = .int
  globals = 0; if variant = 5 then globals = 1
  draft = .lltarget..draft('caller','fixture:caller',globals)
  file = draft.source('caller-source.rxas','caller' as .binary); at = file.origin(0,6)
  fields = .object[]
  fields[1] = .lltarget..operand.procedure('left') as .object
  fields[2] = .lltarget..operand.symbol('fixture.bump') as .object
  ignored = draft.record('.import',fields,at)
  if variant <> 6 then do
    fields[1] = .lltarget..operand.procedure('right') as .object
    ignored = draft.record('.import',fields,at)
  end
  if variant = 1 then do
    fields[1] = .lltarget..operand.procedure('missing') as .object
    fields[2] = .lltarget..operand.symbol('fixture.missing') as .object
    ignored = draft.record('.import',fields,at)
  end
  if variant = 2 then do
    fields[1] = .lltarget..operand.procedure('left') as .object
    ignored = draft.record('.import',fields,at)
  end
  if variant = 4 then ignored = startup(draft,'main','.initializer',at)
  root = draft.procedure('main',3,at)
  call objectarraydrop fields
  fields[1] = .lltarget..operand.integer(1) as .object; fields[2] = fields[1]
  fields[3] = .lltarget..operand.integer(0) as .object
  fields[4] = .lltarget..operand.string('caller-source.rxas' as .binary) as .object
  fields[5] = .lltarget..operand.integer(1) as .object; fields[6] = fields[5]
  fields[7] = .lltarget..operand.integer(6) as .object
  fields[8] = .lltarget..operand.string('caller' as .binary) as .object
  ignored = root.record('.srcstep',fields,at)
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(5),at)
  ignored = two(root,'icopy',root.reg('r',1),root.reg('r',0),at)
  call objectarraydrop fields
  fields[1] = root.reg('r',0) as .object; fields[2] = .lltarget..operand.procedure('left') as .object
  fields[3] = root.reg('r',0) as .object; fields[4] = fields[3]
  ignored = root.emit('call2',fields,at)
  ignored = three(root,'iadd',root.reg('r',1),root.reg('r',1),root.reg('r',0),at)
  if variant <> 6 then do
    ignored = two(root,'icopy',root.reg('r',2),root.reg('r',0),at)
    fields[2] = .lltarget..operand.procedure('right') as .object
    ignored = root.emit('call2',fields,at)
    ignored = three(root,'iadd',root.reg('r',2),root.reg('r',2),root.reg('r',0),at)
  end
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  if variant = 3 then do
    collision = draft.procedure('left',0,at)
    ignored = one(collision,'ret',.lltarget..operand.integer(0),at)
  end
  return draft.finish()

site: procedure = .int
  arg owner = reference .lltarget..module, name = .string
  source = dereference owner; item = .lltarget..record; value = .lltarget..operand
  do i = 1 to source.records()
    item = source.record(i)
    if item.kind() <> 'instruction' | item.mnemonic() <> 'call2' then iterate
    value = item.operand(2)
    if value.text() == name then return item.id()
  end
  return 0

requests: procedure = .object[]
  arg source = reference .lltarget..module, target = reference .lltarget..module
  result = .object[]; owner = dereference target; id = owner.procedureid('leaf')
  if id = 0 then id = owner.procedureid('main')
  left = site(source,'left'); right = site(source,'right')
  if left > 0 then result[1] = llinline..bind(source,left,target,id) as .object
  if right > 0 then result[2] = llinline..bind(source,right,target,id) as .object
  return result

unchanged: procedure = .int
  arg change = .llinline..change, source = .lltarget..module, status = .string, reason = .string
  failures = check(change.status() = status & change.reason() = reason,status || ': ' || reason)
  result = change.result()
  return failures + check(result.identity() = source.identity(),'refusal returns the exact original caller')

instructions: procedure = .int
  arg source = .lltarget..module, mnemonic = .string
  count = 0; item = .lltarget..record
  do i = 1 to source.records()
    item = source.record(i)
    if item.kind() = 'instruction' & item.mnemonic() = mnemonic then count = count + 1
  end
  return count

/** Use the same two import aliases and overlapping result/actual cell for
 * all models. The external RXAS panel independently executes their values. */
privatecontrols: procedure = .int
  arg profile = .string
  failures = 0; source = caller(); sourceid = source.identity()
  target = .lltarget..module; bindings = .object[]; changed = .llinline..change; refused = .llinline..change
  mode = .int; providerid = .int; result = .lltarget..module
  do variant = 1 to 3
    mode = 2
    if variant = 2 then mode = 10
    if variant = 3 then mode = 11
    target = provider(mode); providerid = target.identity(); bindings = requests(reference source,reference target)
    failures = failures + check(target.valid(),'private-local provider model is valid: ' || mode)
    changed = llinline..expandmany(bindings,profile,6000000)
    failures = failures + check(changed.status() = 'changed','finite imported private locals expand: ' || mode)
    if changed.status() = 'changed' then do
      result = changed.result()
      if mode = 10 then do
        failures = failures + check(instructions(result,'move') = 2,'owned private returns MOVE at both aliases')
        refused = llinline..expandmany(bindings,profile,6000000,1000000,67108864,14)
        failures = failures + unchanged(refused,source,'limit','inline.frame')
      end
      else failures = failures + check(instructions(result,'move') = 0 & instructions(result,'copy') = 2,'borrowed return never moves or resets an actual')
      failures = failures + check(result.procedures() = 1 & instructions(result,'call2') = 0,'private surrogate never reaches caller output')
    end
    failures = failures + check(source.identity() = sourceid & target.identity() = providerid,'private-local request preserves both frozen inputs')
  end
  target = provider(12); providerid = target.identity(); bindings = requests(reference source,reference target)
  failures = failures + check(target.valid(),'recycled-flags provider model is valid')
  refused = llinline..expandmany(bindings,profile,6000000)
  failures = failures + unchanged(refused,source,'keep','local.recycler.history.unproved')
  failures = failures + check(target.identity() = providerid & source.identity() = sourceid,'recycler refusal preserves both original owners')
  do i = 1 to bindings[0]
    request = bindings[i] as .llinline..binding
    failures = failures + check(refused.statusat(request.callid()) = 'keep','recycled state retains every alias in the atomic batch')
  end
  return failures

/** The only retained child is a real same-provider export. Its existing
 * caller alias is deliberately different from its provider procedure name.
 * Counted variants 5/6/7 reverse, omit or overlap the post-child swap. */
nestedprovider: procedure = .lltarget..module
  arg shape = .int, variant = 0
  draft = .lltarget..draft('nested.provider','fixture:nested.provider',0)
  file = draft.source('nested-provider.rxas','nested provider' as .binary); at = file.origin(0,15)
  locals = 2; if shape = 2 then locals = 1
  outer = draft.procedure('outer',locals,at,'fixture.nested.outer')
  ignored = .int; fields = .object[]
  childname = 'child'; if variant = 1 then childname = 'hidden'
  if shape = 2 then do
    ignored = two(outer,'load',outer.reg('a',0),.lltarget..operand.integer(2),at)
    ignored = two(outer,'swap',outer.reg('a',1),outer.reg('a',2),at)
    ignored = three(outer,'call',outer.reg('r',0),.lltarget..operand.procedure(childname),outer.reg('a',0),at)
    select variant
      when 5 then ignored = two(outer,'swap',outer.reg('a',2),outer.reg('a',1),at)
      when 6 then nop
      when 7 then ignored = two(outer,'swap',outer.reg('a',0),outer.reg('a',1),at)
      otherwise ignored = two(outer,'swap',outer.reg('a',1),outer.reg('a',2),at)
    end
  end
  else do
    ignored = one(outer,'null',outer.reg('r',0),at)
    ignored = one(outer,'null',outer.reg('r',1),at)
    actual = outer.reg('a',1); if shape = 3 then actual = outer.reg('a',2)
    ignored = two(outer,'icopy',outer.reg('r',0),actual,at)
    if shape = 3 then do
      fields[1] = .lltarget..operand.symbol('mutate') as .object
      fields[2] = .lltarget..operand.symbol('done') as .object; fields[3] = outer.reg('a',1) as .object
      ignored = outer.emit('brtf',fields,at)
      call objectarraydrop fields
      fields[1] = .lltarget..operand.symbol('mutate') as .object
      ignored = outer.record('label',fields,at)
    end
    call objectarraydrop fields
    fields[1] = outer.reg('r',1) as .object
    fields[2] = .lltarget..operand.procedure(childname) as .object
    fields[3] = outer.reg('a',2) as .object; fields[4] = fields[3]
    ignored = outer.emit('call2',fields,at)
    ignored = three(outer,'iadd',outer.reg('r',0),outer.reg('r',0),outer.reg('r',1),at)
    if shape = 3 then do
      call objectarraydrop fields
      fields[1] = .lltarget..operand.symbol('done') as .object
      ignored = outer.record('label',fields,at)
    end
  end
  ignored = one(outer,'ret',outer.reg('r',0),at)
  exposed = 'fixture.nested.child'; if variant = 1 then exposed = ''
  locals = 0; if variant = 4 then locals = 1
  child = draft.procedure(childname,locals,at,exposed)
  select variant
    when 2 then ignored = three(child,'call1',child.reg('a',1),.lltarget..operand.procedure('deeper'),child.reg('a',1),at)
    when 3 then ignored = three(child,'call1',child.reg('a',1),.lltarget..operand.procedure('outer'),child.reg('a',1),at)
    when 4 then do
      /* Both outer aliases must share this child's cached flag history. */
      ignored = two(child,'load',child.reg('r',0),.lltarget..operand.integer(5),at)
      ignored = two(child,'copy',child.reg('a',1),child.reg('r',0),at)
      ignored = two(child,'settp',child.reg('r',0),.lltarget..operand.integer(256),at)
    end
    otherwise ignored = three(child,'iadd',child.reg('a',1),child.reg('a',1),.lltarget..operand.integer(7),at)
  end
  ignored = one(child,'ret',child.reg('a',2),at)
  if variant = 1 then do
    /* Keep the caller's real child import resolved while the outer instead
     * invokes a distinct private body. Only the target's visibility changes. */
    exported = draft.procedure('child',0,at,'fixture.nested.child')
    ignored = one(exported,'ret',exported.reg('a',1),at)
  end
  if variant = 2 then do
    deeper = draft.procedure('deeper',0,at,'fixture.nested.deeper')
    ignored = one(deeper,'ret',deeper.reg('a',1),at)
  end
  decoy = draft.procedure('decoy',0,at,'fixture.nested.other')
  ignored = one(decoy,'ret',decoy.reg('a',1),at)
  return draft.finish()

nestedcaller: procedure = .lltarget..module
  arg shape = .int, variant = 0
  draft = .lltarget..draft('nested.caller','fixture:nested.caller',0)
  at = draft.synthetic('two outer aliases share one exported-child identity')
  fields = .object[]; ignored = .int
  fields[1] = .lltarget..operand.procedure('left') as .object
  fields[2] = .lltarget..operand.symbol('fixture.nested.outer') as .object
  ignored = draft.record('.import',fields,at)
  fields[1] = .lltarget..operand.procedure('right') as .object
  ignored = draft.record('.import',fields,at)
  if variant <> 1 then do
    fields[1] = .lltarget..operand.procedure('child_left') as .object
    exposed = 'fixture.nested.child'; if variant = 2 then exposed = 'fixture.nested.other'
    fields[2] = .lltarget..operand.symbol(exposed) as .object
    ignored = draft.record('.import',fields,at)
    if variant = 3 then do
      fields[1] = .lltarget..operand.procedure('child_right') as .object
      ignored = draft.record('.import',fields,at)
    end
  end
  root = draft.procedure('main',4,at)
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(5),at)
  ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(20),at)
  do i = 1 to 2
    name = 'left'; if i = 2 then name = 'right'
    first = root.reg('r',0); second = first
    if shape = 2 then second = root.reg('r',1)
    if shape = 3 then do
      if i = 2 then ignored = two(root,'settp',root.reg('r',0),.lltarget..operand.integer(256),at)
      ignored = three(root,'getandtp',root.reg('r',3),root.reg('r',0),.lltarget..operand.integer(768),at)
      first = root.reg('r',3); second = root.reg('r',1)
    end
    call objectarraydrop fields
    fields[1] = root.reg('r',0) as .object
    fields[2] = .lltarget..operand.procedure(name) as .object
    fields[3] = first as .object; fields[4] = second as .object
    ignored = root.emit('call2',fields,at)
  end
  if variant = 3 then do
    /* A separately selected direct child shares the pair and history used
     * to prove both retained child calls inside the imported outer body. */
    call objectarraydrop fields
    fields[1] = root.reg('r',2) as .object
    fields[2] = .lltarget..operand.procedure('child_right') as .object
    fields[3] = root.reg('r',0) as .object; fields[4] = fields[3]
    ignored = root.emit('call2',fields,at)
  end
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  return draft.finish()

nestedrequests: procedure = .object[]
  arg source = reference .lltarget..module, target = reference .lltarget..module
  result = .object[]; owner = dereference target
  result[1] = llinline..bind(source,site(source,'left'),target,owner.procedureid('outer')) as .object
  result[2] = llinline..bind(source,site(source,'right'),target,owner.procedureid('outer')) as .object
  childsite = site(source,'child_right')
  if childsite > 0 then result[3] = llinline..bind(source,childsite,target,owner.procedureid('child')) as .object
  return result

nestedcontrols: procedure = .int
  arg profile = .string
  failures = 0; source = .lltarget..module; target = .lltarget..module; result = .lltarget..module
  bindings = .object[]; changed = .llinline..change; refused = .llinline..change; cleaned = .llinline..change
  item = .lltarget..record; value = .lltarget..operand; imports = .int; calls = .int; swaps = .int
  shape = .int; variant = .int; i = .int; j = .int; mode = .int; expected = .string
  returning = .int; inverses = .int; expectedinverses = .int; expectedswaps = .int
  sourceid = .int; providerid = .int; request = .llinline..binding
  do shape = 1 to 7
    mode = shape; if shape = 4 then mode = 1
    if shape > 4 then mode = 2
    if shape = 4 then source = nestedcaller(mode,3)
    else source = nestedcaller(mode)
    if shape > 4 then target = nestedprovider(mode,shape)
    else target = nestedprovider(mode)
    sourceid = source.identity(); providerid = target.identity()
    failures = failures + check(source.valid() & target.valid(),'exported-child models are valid ' || shape)
    bindings = nestedrequests(reference source,reference target)
    changed = llinline..expandmany(bindings,profile,12000000)
    failures = failures + check(changed.status() = 'changed','exact imported outer expands with retained exported child ' || shape)
    if changed.status() <> 'changed' then do; say changed.reason(); iterate; end
    result = changed.result(); imports = 0; calls = 0; swaps = 0; returning = 0; inverses = 0
    do i = 1 to result.records()
      item = result.record(i)
      if item.kind() = '.import' then do
        imports = imports + 1; value = item.operand(1); name = value.text()
        expected = 'fixture.nested.outer'; if wordpos(name,'child_left child_right') > 0 then expected = 'fixture.nested.child'
        value = item.operand(2)
        failures = failures + check(wordpos(name,'left right child_left child_right') > 0 & value.text() = expected,'each original import keeps its exact export binding ' || shape)
      end
      if item.kind() <> 'instruction' then iterate
      if item.mnemonic() = 'swap' then swaps = swaps + 1
      if mode = 2 then do
        /* The counted model has no authored COPY/MOVE. Its outer return
         * transfer precedes exactly the generated inverse replay. */
        if wordpos(item.mnemonic(),'copy move') > 0 then returning = 1
        else if item.mnemonic() = 'swap' & returning then inverses = inverses + 1
        else returning = 0
      end
      do j = 1 to item.operands()
        value = item.operand(j)
        if value.kind() <> 'P' then iterate
        calls = calls + 1
        failures = failures + check(value.text() = 'child_left','only caller original exact child import survives ' || shape)
        if mode = 2 then failures = failures + check(item.mnemonic() = 'call','retained counted child keeps its original opcode')
        else failures = failures + check(item.mnemonic() = 'call2','retained fixed child keeps its original opcode')
      end
    end
    expectedimports = 3; if shape = 4 then expectedimports = 4
    failures = failures + check(result.valid() & result.procedures() = 1 & imports = expectedimports & calls = 2,'no surrogate definition, new import or original selected call reaches publication ' || shape)
    if shape = 4 then failures = failures + check(bindings[0] = 3,'two child import aliases select one deterministic retained alias beside a directly expanded child')
    if mode = 2 then do
      expectedswaps = 4; expectedinverses = 0
      if shape = 6 then expectedinverses = 2
      if shape = 7 then do; expectedswaps = 8; expectedinverses = 4; end
      failures = failures + check(swaps = expectedswaps & inverses = expectedinverses,'counted child preserves authored swaps and only necessary generated inverses ' || shape || ': swaps=' || swaps || ', inverses=' || inverses)
    end
    do i = 1 to bindings[0]
      request = bindings[i] as .llinline..binding
      failures = failures + check(changed.operation(request.callid()) = 0,'removed outer call mapping composes through exported-child deprojection')
    end
    cleaned = llcleanup..transport(reference result,result.procedureid('main'),profile,12000000)
    failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'body.unavailable' & cleaned.result().identity() = result.identity(),'caller-only cleanup precisely retains published imported-child body ' || shape)
    failures = failures + check(source.identity() = sourceid & target.identity() = providerid,'nested success preserves both original owners ' || shape)
  end
  do variant = 1 to 4
    if variant = 4 then source = nestedcaller(1,3)
    else source = nestedcaller(1)
    target = nestedprovider(1,variant); providerid = target.identity()
    bindings = nestedrequests(reference source,reference target)
    select variant
      when 1 then expected = 'import.child.private.pending'
      when 2 then expected = 'nested.call.depth.pending'
      when 3 then expected = 'call.recursion.active'
      otherwise expected = 'local.recycler.history.unproved'
    end
    refused = llinline..expandmany(bindings,profile,12000000)
    failures = failures + unchanged(refused,source,'keep',expected)
    failures = failures + check(target.identity() = providerid,'child refusal preserves exact provider owner ' || variant)
    do i = 1 to refused.sites()
      failures = failures + check(refused.statusat(refused.site(i)) = 'keep','exported-child proof refusal applies to the complete alias batch')
    end
  end
  target = nestedprovider(1)
  do variant = 1 to 2
    source = nestedcaller(1,variant); bindings = nestedrequests(reference source,reference target)
    refused = llinline..expandmany(bindings,profile,12000000)
    failures = failures + unchanged(refused,source,'keep','import.child.import.missing')
  end
  source = nestedcaller(1); sourceid = source.identity(); bindings = nestedrequests(reference source,reference target)
  do mode = 1 to 5
    select mode
      when 1 then refused = llinline..expandmany(bindings,profile,2)
      when 2 then refused = llinline..expandmany(bindings,profile,12000000,8)
      when 3 then refused = llinline..expandmany(bindings,profile,12000000,1000000,64)
      when 4 then refused = llinline..expandmany(bindings,profile,12000000,1000000,67108864,0)
      otherwise refused = llinline..expandmany(bindings,profile,12000000,1000000,67108864,65536,1)
    end
    failures = failures + check(refused.status() = 'limit' & refused.result().identity() = sourceid,'child closure work/entry/byte/frame/cell limits are atomic ' || mode)
  end
  return failures

main: procedure = .int
  alternate = .lltarget..module; alternatebindings = .object[]; status = .string; reason = .string
  refused = .llinline..change; variant = .int; i = .int
  failures = 0; profile = 'closed-main-static-exact-default-halt.v1'
  source = caller(); target = provider(); original = source.identity(); providerid = target.identity()
  failures = failures + check(source.valid() & target.valid(),'independent caller/provider models are valid')
  bindings = requests(reference source,reference target)
  first = bindings[1] as .llinline..binding
  inspected = llinline..inspect(first,'closed-main-default-halt.v1')
  failures = failures + check(inspected.status() = 'keep' & inspected.reason() = 'profile.imported.body.pending','old profile retains foreign calls')
  changed = llinline..expandmany(bindings,profile,6000000)
  failures = failures + check(changed.status() = 'changed','two aliases of one exact provider expand atomically')
  if changed.status() = 'changed' then do
    result = changed.result(); item = .lltarget..record; value = .lltarget..operand; origin = .llir..origin
    imports = 0; calls = 0; increments = 0; sources = 0; traces = 0; firststep = 0; secondstep = 0
    do i = 1 to result.records()
      item = result.record(i)
      if item.kind() = '.import' then imports = imports + 1
      if item.kind() = 'instruction' then do
        if wordpos(item.mnemonic(),'call call1 call2 call3 call4') > 0 then calls = calls + 1
        if item.mnemonic() = 'iadd' then do
          value = item.operand(3)
          if value.kind() = 'I' & value.index() = 7 then do
            increments = increments + 1; origin = item.origin()
            failures = failures + check(origin.filename() = 'provider-source.rxas' & origin.sourcebytes() = ('provider' as .binary) & origin.parents() = 2,'cloned operation retains exact provider bytes and both contributors')
          end
        end
      end
      if item.kind() = '.srcstep' then do
        value = item.operand(4)
        if value.text() = 'provider-source.rxas' then do
          sources = sources + 1; value = item.operand(1)
          if sources = 1 then firststep = value.index()
          else secondstep = value.index()
        end
      end
      if item.kind() = '.traceevent' then do
        traces = traces + 1; value = item.operand(5)
        failures = failures + check(value.text() = 'r','provider TRACE register is remapped into caller storage')
      end
    end
    failures = failures + check(result.name() = source.name() & result.artifact() = source.artifact() & result.globals() = 0,'original module identity and global bank survive')
    failures = failures + check(result.procedures() = 1 & imports = 2 & calls = 0 & increments = 2,'imports survive with no surrogate definition/reference or original call')
    failures = failures + check(sources = 2 & traces = 2 & firststep > 1 & secondstep > 1 & firststep <> secondstep,'colliding observation IDs get fresh per-site identities')
    failures = failures + check(changed.callers() = 1 & changed.caller(1) = result.procedureid('main'),'changed caller ID is composed through deprojection')
    failures = failures + check(changed.operation(first.callid()) = 0,'removed original call maps to zero')
  end
  failures = failures + check(source.identity() = original & target.identity() = providerid,'successful request preserves both frozen inputs')
  single = caller(6); singlebindings = requests(reference single,reference target); singlefirst = singlebindings[1] as .llinline..binding
  inspected = llinline..inspect(singlefirst,profile,6000000)
  failures = failures + check(inspected.status() = 'legal' & inspected.arguments() = 2 & inspected.returned() = 2,'single-site inspect uses exact imported body proof')
  do variant = 1 to 8
    if variant = 2 then iterate /* Former locals-only refusal is positive below. */
    alternate = provider(variant); alternatebindings = requests(reference source,reference alternate)
    status = 'keep'; reason = ''
    select variant
      when 1 then reason = 'import.global.storage.pending'
      when 3 then do; status = 'invalid'; reason = 'binding.target.mismatch'; end
      when 4 then reason = 'import.provider.main.pending'
      when 5 then reason = 'import.startup.metadata.pending'
      when 6 then reason = 'import.startup.metadata.pending'
      when 7 then reason = 'import.child.private.pending'
      when 8 then reason = 'import.leaf.inline.transport.pending'
    end
    failures = failures + check(alternate.valid(),'negative provider model is valid: ' || variant)
    refused = llinline..expandmany(alternatebindings,profile,6000000)
    failures = failures + unchanged(refused,source,status,reason)
  end
  do variant = 1 to 5
    alternate = caller(variant); alternatebindings = requests(reference alternate,reference target)
    status = 'keep'; reason = ''
    select variant
      when 1 then reason = 'binding.import.unresolved'
      when 2 then do; status = 'invalid'; reason = 'binding.import.ambiguous'; end
      when 3 then do; status = 'invalid'; reason = 'binding.import.local.collision'; end
      when 4 then reason = 'import.startup.metadata.pending'
      when 5 then reason = 'import.global.storage.pending'
    end
    failures = failures + check(alternate.valid(),'negative caller model is valid: ' || variant)
    refused = llinline..expandmany(alternatebindings,profile,6000000)
    failures = failures + unchanged(refused,alternate,status,reason)
  end
  refused = llinline..expandmany(bindings,profile,2)
  failures = failures + unchanged(refused,source,'limit','import.allowances')
  alternate = provider(9); alternatebindings = requests(reference source,reference alternate)
  failures = failures + check(alternate.valid(),'many-observation provider model is valid')
  refused = llinline..expandmany(alternatebindings,profile,24000)
  failures = failures + unchanged(refused,source,'limit','import.work')
  refused = llinline..expandmany(bindings,profile,6000000,8)
  failures = failures + check(refused.status() = 'limit' & refused.result().identity() = original,'entry cap is atomic')
  refused = llinline..expandmany(bindings,profile,6000000,1000000,64)
  failures = failures + check(refused.status() = 'limit' & refused.result().identity() = original,'byte cap is atomic')
  refused = llinline..expandmany(bindings,profile,6000000,1000000,67108864,0)
  failures = failures + check(refused.status() = 'limit' & refused.result().identity() = original,'frame cap is atomic')
  refused = llinline..expandmany(bindings,profile,6000000,1000000,67108864,65536,1)
  failures = failures + check(refused.status() = 'limit' & refused.result().identity() = original,'instruction cell cap is atomic')
  replayed = llinline..expandmany(bindings,profile,6000000)
  failures = failures + check(replayed.status() = 'changed' & source.identity() = original & target.identity() = providerid,'small replay after refusals retains both valid owners')
  failures = failures + privatecontrols(profile)
  failures = failures + nestedcontrols(profile)
  say 'IMPORTED_INLINE|failures=' || failures
  return failures
