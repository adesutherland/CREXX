/* cREXX License (MIT). Site coverage does not erase unknown local ingress. */
options levelb
import rxfnsb
import llir
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetflow
import llrxascatalog

check: procedure = .int
  arg condition = .int, message = .string
  if condition then return 0
  say 'FAIL:' message
  return 1
one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, value = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = value as .object
  return body.emit(name,fields,at)
sample: procedure = .lltarget..module
  arg mode = .int, expose called = .int, clearentry = 0
  fields = .object[]; ignored = .int
  draft = .lltarget..draft('normalization.site','fixture:normalization.site',0)
  at = draft.synthetic('outward uncertainty is distinct from local reentry')
  root = draft.procedure('main',3,at)
  if clearentry then ignored = one(root,'null',root.reg('r',1),at)
  fields[1] = .lltarget..operand.symbol('entry') as .object; ignored = root.record('label',fields,at)
  fields[1] = root.reg('r',0) as .object; fields[2] = .lltarget..operand.integer(7) as .object
  ignored = root.emit('load',fields,at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.symbol('site') as .object; ignored = root.record('label',fields,at)
  /* This native scalar observation belongs to the unchanged caller prefix.
   * A backedge after LOAD can make it dirty; one through LOAD defines it. */
  fields[1] = root.reg('r',0) as .object; fields[2] = root.reg('r',0) as .object; fields[3] = .lltarget..operand.integer(0) as .object
  ignored = root.emit('iadd',fields,at)
  if mode = 10 then do
    call objectarraydrop fields; fields[1] = .lltarget..operand.symbol('selected') as .object; fields[2] = root.reg('a',1) as .object
    ignored = root.emit('brt',fields,at)
    call objectarraydrop fields; fields[1] = root.reg('r',0) as .object; fields[2] = root.reg('r',1) as .object
    ignored = root.emit('copy',fields,at); ignored = one(root,'br',.lltarget..operand.symbol('site'),at)
    call objectarraydrop fields; fields[1] = .lltarget..operand.symbol('selected') as .object; ignored = root.record('label',fields,at)
  end
  call objectarraydrop fields; fields[1] = root.reg('r',2) as .object; fields[2] = .lltarget..operand.procedure('leaf') as .object
  called = root.emit('call',fields,at)
  if mode <> 10 then ignored = one(root,'signal',.lltarget..operand.string('LATE' as .binary),at)
  if mode = 2 | mode = 3 then do
    call objectarraydrop fields; fields[1] = root.reg('r',0) as .object; fields[2] = root.reg('r',1) as .object
    ignored = root.emit('copy',fields,at)
    label = 'site'; if mode = 3 then label = 'entry'
    ignored = one(root,'br',.lltarget..operand.symbol(label),at)
  end
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('leaf',0,at)
  ignored = one(leaf,'ret',.lltarget..operand.integer(0),at)
  return draft.finish()

premises: procedure = .lltargettransfer..profile
  arg owner = reference .lltarget..module, mode = .int
  source = dereference owner; catalog = .llrxascatalog..catalog()
  draft = .lltargettransfer..profiledraft(owner,'independent.normalization.site')
  integer = draft.domain('component','site.integer',catalog.componentmask('I'))
  i = .int; ignored = .int; destination = .int; input = .int; target = .int; value = .lltarget..operand
  do i = 1 to source.records()
    item = source.record(i)
    if item.kind() = 'procedure' then iterate
    ignored = draft.operation(item.id()); ignored = draft.relocation(item.id(),'none')
    if item.kind() <> 'instruction' then iterate
    select item.mnemonic()
      when 'load' then do
        destination = draft.ref(item.id(),1); value = item.operand(2)
        ignored = draft.event(item.id(),'write',destination,integer,'literal',0,value)
      end
      when 'null' then do
        destination = draft.ref(item.id(),1); ignored = draft.event(item.id(),'clear',destination,0)
      end
      when 'copy' then do
        destination = draft.ref(item.id(),1); input = draft.ref(item.id(),2)
        ignored = draft.event(item.id(),'transport',destination,0,'reference',input)
      end
      when 'call' then do
        destination = draft.ref(item.id(),1); target = draft.ref(item.id(),2,'procedure','symbolic')
        ignored = draft.event(item.id(),'clear',destination,0)
        if mode <> 4 then ignored = draft.event(item.id(),'callcapture',0,0,'none',0,.lltarget..operand(),'must','all','after','fixture.call')
        if mode = 8 | mode = 9 then do
          detail = 'catalog.callback.call-frame'; if mode = 9 then detail = 'catalog.callback.host'
          ignored = draft.event(item.id(),'callback',0,0,'none',0,.lltarget..operand(),'may','all','unknown',detail)
        end
        ignored = draft.event(item.id(),'call',0,0,'reference',target,.lltarget..operand(),'must','normal','after','fixture.call')
      end
      when 'iadd' then do
        destination = draft.ref(item.id(),1); input = draft.ref(item.id(),2)
        ignored = draft.event(item.id(),'read',input,integer)
        ignored = draft.event(item.id(),'observe',input,integer)
        ignored = draft.event(item.id(),'derive',destination,integer,'reference',input)
      end
      when 'signal' then do
        role = 'unwind'; if mode = 1 then role = 'unknown'
        /* Unknown destination of a physical outward departure is not an
         * unknown local role. Normal fallthrough models possible resumption. */
        ignored = draft.event(item.id(),'edge',0,0,'literal',0,.lltarget..operand.string('LATE' as .binary),'unknown','failure','after',role)
      end
      when 'br' then ignored = draft.ref(item.id(),1,'label','symbolic')
      when 'brt' then do
        ignored = draft.ref(item.id(),1,'label','symbolic'); input = draft.ref(item.id(),2)
        ignored = draft.event(item.id(),'read',input,integer); ignored = draft.event(item.id(),'observe',input,integer)
      end
      when 'ret' then do
        value = item.operand(1)
        if value.kind() = 'R' then input = draft.ref(item.id(),1)
        ignored = draft.event(item.id(),'return',0,0)
      end
      otherwise nop
    end
  end
  return draft.finish()

run: procedure = .int
  arg mode = .int
  failures = 0; called = .int; i = .int; ignored = .int
  source = sample(mode,called)
  sourceidentity = source.identity()
  profile = premises(reference source,mode); cfg = .lltargetcfg..graph(reference source,reference profile,4000000)
  flow = .lltargetflow..analysis(reference source,reference profile,reference cfg,4000000)
  failures = failures + check(source.valid() & profile.status() = 'ok' & cfg.status() = 'ok' & flow.status() = 'ok','site source/operational owners build ' || mode)
  if failures > 0 then do; say profile.message(); say cfg.message(); say flow.reason(); return failures; end
  root = source.procedureid('main'); provider = source.procedureid('leaf')
  failures = failures + check(cfg.normalizationcomplete(root) = 0,'whole-function CFG uncertainty remains visible ' || mode)
  coverage = flow.entrycoverageat(called,1000000)
  if mode = 0 | mode = 3 | mode = 5 | mode = 6 | mode = 7 then failures = failures + check(coverage.complete() & coverage.demands() = 0 & coverage.unresolved() = 0,'precise zero-dirty site coverage survives outward uncertainty ' || mode || ': ' || coverage.reason())
  if mode = 1 then failures = failures + check(coverage.complete() = 0 & coverage.reason() = 'target.cfg.ingress.local.destination.unproved','later unknown local handler cannot be omitted from ingress')
  if mode = 2 then failures = failures + check(coverage.unresolved() > 0 & coverage.demands() = 0,'returning outward signal makes backedge input unresolved without claiming exhaustive dirty-entry origins')
  if mode = 4 then do
    failures = failures + check(coverage.complete() = 0 & coverage.reason() = 'target.flow.site.capture.unproved','missing capture cannot borrow a before-instruction checkpoint')
    failures = failures + check(coverage.valid() & coverage.operation() = called & coverage.demands() = 0 & coverage.unresolved() = 1 & coverage.rows() = 1,'failure before cone construction returns a live unresolved fact without probing an unconstructed receiver')
  end
  if mode = 8 then failures = failures + check(coverage.complete() = 0 & coverage.reason() = 'target.flow.site.call.callback.phase.unproved','an independently authored lookalike frame hook cannot borrow canonical pointer preservation')
  if mode = 9 then failures = failures + check(coverage.complete() = 0 & coverage.reason() = 'target.flow.site.call.callback.phase.unproved','a post-capture HOST hook cannot borrow a resource-only frame event')
  if mode = 5 then do
    replacement = .lltarget..draft('replacement','fixture:replacement',0); at = replacement.synthetic('replace source epoch')
    body = replacement.procedure('main',0,at); ignored = one(body,'ret',.lltarget..operand.integer(0),at)
    source = replacement.finish()
    failures = failures + check(coverage.valid() = 0,'replaced module epoch invalidates site and ingress facts')
  end
  return failures

/** With no intervening foreign resumption, the same backedge has an exact
 * owned dirty source. This is independent of the unknown callback control. */
dirtybackedge: procedure = .int
  failures = 0; called = .int
  source = sample(10,called); profile = premises(reference source,10)
  cfg = .lltargetcfg..graph(reference source,reference profile,4000000)
  flow = .lltargetflow..analysis(reference source,reference profile,reference cfg,4000000)
  failures = failures + check(source.valid() & profile.status() = 'ok' & cfg.status() = 'ok' & flow.status() = 'ok','callback-free dirty backedge owners build')
  if failures > 0 then return failures
  coverage = flow.entrycoverageat(called,1000000)
  failures = failures + check(coverage.complete() & coverage.demands() > 0 & coverage.unresolved() = 0,'pre-CALL callback-free backedge retains the exact dirty witness: ' || coverage.status() || '/' || coverage.reason() || '/demands=' || coverage.demands())
  return failures

/** A child CALL does not invent a retired frame-resource callback. Exact
 * argument observations still distinguish defined and dirty owned entries. */
callbackphase: procedure = .int
  arg dirty = .int
  failures = 0; ignored = .int; i = .int; framehook = .int
  fields = .object[]; action = .lltargettransfer..action
  draft = .lltarget..draft('normalization.frame.' || dirty,'fixture:normalization.frame',0)
  at = draft.synthetic('captured fixed-call pointers survive a returning frame resource hook')
  root = draft.procedure('main',2,at)
  if dirty = 0 then do
    fields[1] = root.reg('r',0) as .object; fields[2] = .lltarget..operand.integer(7) as .object
    ignored = root.emit('load',fields,at)
  end
  fields[1] = root.reg('r',1) as .object; fields[2] = .lltarget..operand.procedure('leaf') as .object
  fields[3] = root.reg('r',0) as .object; called = root.emit('call1',fields,at)
  ignored = one(root,'sayx',.lltarget..operand.string('unchanged later host output' as .binary),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  body = draft.procedure('leaf',0,at)
  /* The child may write the borrowed argument; this does not resurrect a
   * finalizer in the already-retired prior activation. */
  call objectarraydrop fields; fields[1] = body.reg('a',1) as .object; fields[2] = body.reg('a',1) as .object
  fields[3] = .lltarget..operand.integer(0) as .object; ignored = body.emit('iadd',fields,at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  source = draft.finish(); failures = failures + check(source.valid(),'canonical frame-phase source validates ' || dirty)
  if source.valid() = 0 then do; say source.error(); return failures; end
  profile = .lltargettransfer..profile.closedcalls(reference source,source.procedureid('main'),'closed-main-default-halt.v1')
  cfg = .lltargetcfg..graph(reference source,reference profile,4000000)
  flow = .lltargetflow..analysis(reference source,reference profile,reference cfg,4000000)
  failures = failures + check(flow.status() = 'ok','canonical frame-phase flow builds ' || dirty)
  if flow.status() <> 'ok' then do; say flow.reason(); return failures; end
  instruction = profile.instruction(called)
  do i = 1 to instruction.actions()
    action = instruction.action(i)
    if action.kind() = 'callback' & action.detail() = 'catalog.callback.call-frame' then do
      framehook = flow.callbackpossibleat(called,i)
    end
  end
  failures = failures + check(framehook = 0 & flow.complete(source.procedureid('main'),'entry-observation'),'retired prior frame contributes no hidden hook to the exact observation inventory ' || dirty || ': hook=' || framehook || ' complete=' || flow.complete(source.procedureid('main'),'entry-observation'))
  coverage = flow.entrycoverageat(called,1000000)
  failures = failures + check(coverage.valid() & coverage.complete() & coverage.reason() = '' & coverage.unresolved() = 0,'site coverage is complete without a prior-frame finalizer hook ' || dirty || ': valid=' || coverage.valid() || ' complete=' || coverage.complete() || ' reason=' || coverage.reason() || ' unresolved=' || coverage.unresolved())
  if dirty = 0 then failures = failures + check(coverage.demands() = 0,'defined actual contributes no dirty-entry demand')
  else failures = failures + check(coverage.demands() > 0,'borrowed child observation retains the dirty caller-owned entry demand')
  return failures

/** Canonical bytes-output policy proof, separate from the independent
 * observation profile above. No retained-call ABI/observer permission is
 * inferred from this destination/ingress fact. */
outputingress: procedure = .int
  arg mode = .int
  failures = 0; ignored = .int; i = .int; terminal = .int; localgap = .int; backward = .int; callback = .int; opaque = .int; inherited = .int
  fields = .object[]; row = .lltargetcfg..edge; action = .lltargettransfer..action
  catalog = .llrxascatalog..catalog()
  draft = .lltarget..draft('normalization.output.' || mode,'fixture:normalization.output',0)
  at = draft.synthetic('public bytes output preserves only the suspended signal policy')
  body = draft.procedure('main',0,at)
  fields[1] = .lltarget..operand.symbol('site') as .object; earlier = body.record('label',fields,at)
  called = one(body,'call',.lltarget..operand.procedure('leaf'),at)
  if mode = 1 then do
    fields[1] = .lltarget..operand.symbol('site') as .object
    fields[2] = .lltarget..operand.string('POSIX_INT' as .binary) as .object
    ignored = body.emit('sigbr',fields,at)
  end
  printed = one(body,'sayx',.lltarget..operand.string('later bytes output' as .binary),at)
  if mode = 1 then ignored = one(body,'signal',.lltarget..operand.string('POSIX_INT' as .binary),at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  body = draft.procedure('leaf',0,at); ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  source = draft.finish(); failures = failures + check(source.valid(),'canonical output ingress source validates ' || mode)
  if source.valid() = 0 then do; say source.error(); return failures; end
  profile = .lltargettransfer..profile
  if mode = 2 then profile = .lltargettransfer..profile.closedmain(reference source,source.procedureid('main'),'closed-main-default-halt.v1')
  else profile = .lltargettransfer..profile.closedcalls(reference source,source.procedureid('main'),'closed-main-default-halt.v1')
  cfg = .lltargetcfg..graph(reference source,reference profile,4000000)
  failures = failures + check(cfg.status() = 'ok','canonical output ingress graph builds ' || mode)
  if cfg.status() <> 'ok' then do; say cfg.message(); return failures; end
  item = source.at(printed)
  failures = failures + check(catalog.callbackpreservessignalpolicy(item.opcode()) & profile.callbackpolicyunknown(printed) = 0 & profile.callbackobligations(printed) = catalog.callbackmask('host') & catalog.callbacknormalpreservesframe(item.opcode()),'catalogue bytes-output fact retains HOST and value uncertainty with frame preservation ' || mode)
  instruction = profile.instruction(printed)
  do i = 1 to instruction.actions()
    action = instruction.action(i)
    if action.kind() = 'callback' & action.detail() = 'catalog.callback.host' then callback = 1
    if action.kind() = 'external' & action.detail() = 'catalog.opaque' then opaque = 1
  end
  failures = failures + check(callback & opaque,'policy-only fact retains canonical callback and opaque observation actions ' || mode)
  do i = 1 to cfg.edges()
    row = cfg.edge(i)
    if row.sourceop() = printed & row.boundarykind() = 'closed-main-default-halt' then terminal = 1
    if row.sourceop() = printed & row.boundarykind() = 'callback-policy' then localgap = 1
    if row.role() = 'handler' & row.targetop() = earlier then backward = 1
  end
  cone = cfg.ingressat(called)
  if mode = 0 then do
    failures = failures + check(terminal & localgap = 0 & cone.complete() & cone.contains(printed) = 0,'later public output cannot invent an earlier same-activation ingress under the checked HALT policy: ' || cone.reason())
    rawprofile = .lltargettransfer..profile(reference source)
    rawcfg = .lltargetcfg..graph(reference source,reference rawprofile,4000000)
    failures = failures + check(rawcfg.status() = 'ok' & rawprofile.defaulthalt(source.procedureid('main')) = 0,'unsealed entry remains outside the default-HALT premise')
    if rawcfg.status() = 'ok' then do
      terminal = 0
      do i = 1 to rawcfg.outedges(printed)
        row = rawcfg.outedge(printed,i)
        if row.boundarykind() = 'closed-main-default-halt' then terminal = 1
        if row.boundarykind() = 'inherited-signal-policy' then inherited = 1
      end
      failures = failures + check(terminal = 0 & inherited,'policy preservation never fabricates a known entry handler table')
    end
  end
  if mode = 1 then do
    failures = failures + check(backward,'authored POSIX_INT backward handler survives later bytes output')
    failures = failures + check(cone.complete() = 0 | cone.contains(printed),'a known or unresolved backward signal cannot be omitted from site ingress')
  end
  if mode = 2 then failures = failures + check(cone.complete() & cone.contains(printed) = 0 & profile.callbackpolicyunknown(called) = 0 & profile.defaulthalt(source.procedureid('leaf')) = 0,'an exact bytecode child preserves the suspended policy independently of closed-call membership')
  return failures

main: procedure = .int
  failures = 0; mode = .int
  do mode = 0 to 9; failures = failures + run(mode); end
  do mode = 0 to 2; failures = failures + outputingress(mode); end
  do mode = 0 to 1; failures = failures + callbackphase(mode); end
  failures = failures + dirtybackedge()
  say 'TARGET_NORMALIZATION_SITE|failures=' || failures
  return failures
