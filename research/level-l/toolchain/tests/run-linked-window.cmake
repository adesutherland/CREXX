cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER CLI FIXTURE WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")

function(run_checked _description)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE _status
    OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "${_description}: ${_status}\n${_stdout}${_stderr}")
  endif()
  set(_last_stdout "${_stdout}" PARENT_SCOPE)
  set(_last_stderr "${_stderr}" PARENT_SCOPE)
endfunction()

# Keep source/TRACE records separately from executable instructions. The
# retained call must keep their address even when setup grows before it.
function(read_caller _path)
  file(STRINGS "${_path}" _lines ENCODING UTF-8)
  set(_inside OFF)
  set(_records "")
  set(_instructions "")
  set(_frame "")
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^[^ \t]+\\(\\)[ \t]+\\.locals=([0-9]+)")
      if(_line MATCHES "^main\\(\\)[ \t]+\\.locals=([0-9]+)")
        set(_inside ON)
        set(_frame "${CMAKE_MATCH_1}")
      else()
        set(_inside OFF)
      endif()
    elseif(_inside AND NOT _line STREQUAL "")
      list(APPEND _records "${_line}")
      if(_line MATCHES "^[ \t]*[A-Za-z][A-Za-z0-9]*([ \t]|$)")
        list(APPEND _instructions "${_line}")
      endif()
    endif()
  endforeach()
  if(_frame STREQUAL "" OR _instructions STREQUAL "")
    message(FATAL_ERROR "No main body in ${_path}")
  endif()
  set(_caller_records "${_records}" PARENT_SCOPE)
  set(_caller_instructions "${_instructions}" PARENT_SCOPE)
  set(_caller_frame "${_frame}" PARENT_SCOPE)
endfunction()

set(_expected "163\n11\n153\n52\n52\n8\n106\n11")
foreach(_mode conservative cleaned)
  set(_cleanup_option)
  if(_mode STREQUAL "conservative")
    set(_cleanup_option --no-cleanup)
  endif()
  set(_product "${WORK}/linked-window-${_mode}")
  run_checked("inline five-pointer child (${_mode})" "${VM}" "${CLI}" ${RUNTIME} -a
    --module io-linked-window.rxas --profile closed-main-default-halt.v1 --work 4000000
    ${_cleanup_option} -o "${_product}.rxas" "${FIXTURE}")
  read_caller("${_product}.rxas")
  list(LENGTH _caller_instructions _instruction_count)
  set(_calls 0)
  set(_swaps 0)
  set(_ordinal 0)
  foreach(_instruction IN LISTS _caller_instructions)
    if(_instruction MATCHES "^[ \t]*swap[ \t]")
      math(EXPR _swaps "${_swaps} + 1")
    endif()
    if(_instruction MATCHES "^[ \t]*call[ \t]+(r[0-9]+),windowleaf\\(\\),r([0-9]+)$")
      set(_result "${CMAKE_MATCH_1}")
      set(_window "${CMAKE_MATCH_2}")
      math(EXPR _last_slot "${_window} + 5")
      if(NOT _last_slot LESS _caller_frame)
        message(FATAL_ERROR "${_mode}: retained count5 window exceeds the caller frame")
      endif()
      math(EXPR _calls "${_calls} + 1")
      if(_mode STREQUAL "cleaned")
        math(EXPR _setup "${_ordinal} - 6")
        math(EXPR _closure "${_ordinal} + 6")
        if(_setup LESS 0 OR NOT _closure LESS _instruction_count)
          message(FATAL_ERROR "linked window lacks complete setup or closure")
        endif()
        set(_sources "")
        foreach(_slot RANGE 0 5)
          math(EXPR _at "${_setup} + ${_slot}")
          math(EXPR _destination "${_window} + ${_slot}")
          list(GET _caller_instructions ${_at} _link)
          if(NOT _link MATCHES "^[ \t]*link[ \t]+r${_destination},(r[0-9]+)$")
            message(FATAL_ERROR "linked count5 window is not contiguous ascending LINK W0..W5: ${_link}")
          endif()
          set(_source "${CMAKE_MATCH_1}")
          list(APPEND _sources "${_source}")
          foreach(_scratch RANGE ${_window} ${_last_slot})
            if(_source STREQUAL "r${_scratch}" OR _result STREQUAL "r${_scratch}")
              message(FATAL_ERROR "linked window overlaps a source or result storage")
            endif()
          endforeach()
          math(EXPR _at "${_ordinal} + 1 + ${_slot}")
          math(EXPR _destination "${_last_slot} - ${_slot}")
          list(GET _caller_instructions ${_at} _unlink)
          if(NOT _unlink MATCHES "^[ \t]*unlink[ \t]+r${_destination}$")
            message(FATAL_ERROR "linked count5 window is not closed in reverse order: ${_unlink}")
          endif()
        endforeach()
        list(GET _sources 0 _count_source)
        set(_count_load OFF)
        foreach(_before RANGE 0 ${_setup})
          list(GET _caller_instructions ${_before} _prior)
          if(_prior MATCHES "^[ \t]*load[ \t]+${_count_source},5$")
            set(_count_load ON)
          endif()
        endforeach()
        if(NOT _count_load)
          message(FATAL_ERROR "linked window lost the independently known count5 source")
        endif()
        list(GET _sources 1 _first_actual)
        list(GET _sources 2 _second_actual)
        list(GET _sources 3 _third_actual)
        if(NOT _third_actual STREQUAL _result)
          message(FATAL_ERROR "linked window lost child result/third-actual overlap")
        endif()
        if(_calls EQUAL 1)
          if(_first_actual STREQUAL _second_actual)
            message(FATAL_ERROR "distinct first call acquired an invented alias")
          endif()
        elseif(NOT _first_actual STREQUAL _second_actual)
          message(FATAL_ERROR "repeated aliased actuals became distinct linked sources")
        endif()
      endif()
    elseif(_instruction MATCHES "^[ \t]*(call[0-9]*|swapcall|settpswapcall|settpcall)[ \t]")
      message(FATAL_ERROR "${_mode}: expected only retained count5 child calls, got ${_instruction}")
    endif()
    math(EXPR _ordinal "${_ordinal} + 1")
  endforeach()
  if(NOT _calls EQUAL 3)
    message(FATAL_ERROR "${_mode}: expected three retained count5 child calls, got ${_calls}")
  endif()
  if(_mode STREQUAL "cleaned" AND NOT _swaps EQUAL 0)
    message(FATAL_ERROR "cleaned caller retained proved outer setup/inverse swaps")
  elseif(_mode STREQUAL "conservative" AND _swaps EQUAL 0)
    message(FATAL_ERROR "conservative expansion unexpectedly removed source swaps")
  endif()

  set(_ordinal 0)
  set(_attached 0)
  foreach(_record IN LISTS _caller_records)
    if(_record MATCHES "^[ \t]*call[ \t]+r([0-9]+),windowleaf\\(\\),r[0-9]+$")
      set(_result_index "${CMAKE_MATCH_1}")
      math(EXPR _step_at "${_ordinal} - 2")
      math(EXPR _trace_at "${_ordinal} - 1")
      if(_step_at LESS 0)
        message(FATAL_ERROR "retained child lost source/TRACE point records")
      endif()
      list(GET _caller_records ${_step_at} _step)
      list(GET _caller_records ${_trace_at} _trace)
      if(NOT _step MATCHES "^[ \t]*\\.srcstep ([0-9]+) ([0-9]+) 0 \"io-linked-window.rxas\" 58 3 25 \"  call a2,windowleaf\\(\\),r1\"$")
        message(FATAL_ERROR "${_mode}: child source point moved onto window setup: ${_step}")
      endif()
      set(_step_id "${CMAKE_MATCH_1}")
      set(_clause_id "${CMAKE_MATCH_2}")
      if(NOT _trace MATCHES "^[ \t]*\\.traceevent \"V\" 4 \"R\" \"I\" \"r\" ${_result_index} ${_step_id} ${_clause_id} 0 \"window-result\" \"\"$")
        message(FATAL_ERROR "${_mode}: child TRACE point lost its call/result attachment: ${_trace}")
      endif()
      math(EXPR _attached "${_attached} + 1")
    endif()
    math(EXPR _ordinal "${_ordinal} + 1")
  endforeach()
  if(NOT _attached EQUAL 3)
    message(FATAL_ERROR "${_mode}: expected three attached source/TRACE pairs")
  endif()

  run_checked("assemble linked count5 (${_mode})" "${ASSEMBLER}" -n
    -o "${_product}" "${_product}.rxas")
  run_checked("execute linked count5 (${_mode})" "${VM}" "${_product}.rxbin")
  string(REPLACE "\r\n" "\n" _normalized "${_last_stdout}")
  string(STRIP "${_normalized}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "${_mode}: expected '${_expected}', got '${_actual}'")
  endif()
endforeach()

file(REMOVE_RECURSE "${WORK}")
message("RXAS_LINKED_WINDOW|failures=0")
