/* GETANDTP is defined but unknown to facts. Native values0/256 exercise both
 * feasible arms; all output follows calls, preserving plain scalar actuals. */
.globals=0
main() .locals=9
  null r0
  load r0,5
  getandtp r1,r0,768
  load r3,11
  load r4,22
  call3 r5,mixed(),r1,r3,r4
  load r7,55
  call1 r7,maybe(),r1
  call1 r1,joined(),r1
  settp r0,256
  getandtp r2,r0,768
  call3 r6,mixed(),r2,r3,r4
  load r8,66
  call1 r8,maybe(),r2
  call1 r2,joined(),r2
  itos r5
  say r5
  itos r6
  say r6
  itos r4
  say r4
  itos r7
  say r7
  itos r8
  say r8
  itos r1
  say r1
  itos r2
  say r2
  ret 0
mixed() .locals=1
  null r0
  brt dynamic_positive,a1
  load r0,9
  ret r0
dynamic_positive:
  swap a2,a3
  load a2,99
  ret a3
maybe() .locals=0
  brt maybe_value,a1
  ret
maybe_value:
  ret 7
joined() .locals=1
  null r0
  brt joined_true,a1
  load r0,4
  br joined_done
joined_true:
  load r0,8
joined_done:
  ret r0
