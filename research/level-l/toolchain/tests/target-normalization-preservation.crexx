/* cREXX License (MIT). Ordinary atomic dirty-read normalization controls. */
options levelb
import rxfnsb
import llir
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetflow
import lltargetnormalize

check: procedure = .int
  arg condition = .int, message = .string
  if condition then return 0
  say 'FAIL:' message
  return 1

/** Add-zero needs the incoming integer but cannot overflow. Source-defined,
 * dirty-owned and borrowed inputs have independent expected outcomes. */
ordinary: procedure = .int
  arg mode = .int, work = 4000000
  failures = 0; fields = .object[]; ignored = .int; subject = .int; input = .int
  draft = .lltarget..draft('ordinary.normalization.' || mode,'fixture:ordinary.normalization',0)
  at = draft.synthetic('owned dirty integer before an add-zero')
  root = draft.procedure('main',3,at)
  if mode = 1 then do
    fields[1] = root.reg('r',1) as .object; fields[2] = .lltarget..operand.integer(9) as .object
    ignored = root.emit('load',fields,at)
  end
  value = root.reg('r',1); if mode = 2 then value = root.reg('a',1)
  fields[1] = root.reg('r',2) as .object; fields[2] = value as .object; fields[3] = .lltarget..operand.integer(0) as .object
  observed = root.emit('iadd',fields,at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.integer(0) as .object; ignored = root.emit('ret',fields,at)
  source = draft.finish(); originalid = source.identity()
  builder = .lltargettransfer..profiledraft(reference source,'independent.ordinary.normalization')
  integer = builder.domain('component','integer')
  do i = 1 to source.records()
    item = source.record(i); ignored = builder.operation(item.id()); ignored = builder.relocation(item.id(),'none')
    if item.kind() <> 'instruction' then iterate
    select item.mnemonic()
      when 'load' then do
        subject = builder.ref(item.id(),1); ignored = builder.event(item.id(),'write',subject,integer,'literal',0,item.operand(2))
      end
      when 'iadd' then do
        subject = builder.ref(item.id(),1); input = builder.ref(item.id(),2)
        ignored = builder.event(item.id(),'observe',input,integer)
        ignored = builder.event(item.id(),'write',subject,integer)
      end
      when 'ret' then ignored = builder.event(item.id(),'return',0,0)
    end
  end
  profile = builder.finish(); cfg = .lltargetcfg..graph(reference source,reference profile)
  flow = .lltargetflow..analysis(reference source,reference profile,reference cfg)
  failures = failures + check(source.valid() & flow.status() = 'ok','independent normalizer source/flow validates ' || mode)
  if failures > 0 then return failures
  normalized = lltargetnormalize..normalize(reference source,reference flow,work)
  result = normalized.result()
  if work = 1 then do
    failures = failures + check(normalized.status() = 'limit' & result.identity() = originalid & normalized.warnings() = 0,'exhausted normalizer retains input and publishes no warnings')
    return failures
  end
  if mode = 0 then do
    failures = failures + check(normalized.status() = 'changed' & normalized.warnings() = 1 & source.identity() = originalid,'proved owned dirty input gets one atomic clear/warning')
    if normalized.warnings() = 1 then do
      warning = normalized.warning(1)
      failures = failures + check(warning.local() = 1 & warning.operation() = normalized.operation(observed),'warning names original owned component and mapped observation')
    end
    body = result.body(result.procedureid('main')); first = body.record(1); value = first.operand(1)
    failures = failures + check(first.mnemonic() = 'null' & value.bank() = 'r' & value.index() = 1,'ordinary entry prelude clears only the proved owned source')
  end
  else failures = failures + check(normalized.status() = 'keep' & result.identity() = originalid & normalized.warnings() = 0,'defined or borrowed input is not cleared ' || mode)
  return failures

/** Reachable opaque effects are unresolved demands even when no explicit
 * observation follows. Unconditional normalization must respect that fact. */
opaquenormalization: procedure = .int
  arg mode = .int
  failures = 0; ignored = .int; i = .int
  draft = .lltarget..draft('normalization.opaque.' || mode,'fixture:normalization.opaque',0)
  at = draft.synthetic('unknown owned-entry demand cannot use unconditional normalization')
  root = draft.procedure('main',1,at); fields = .object[]; empty = .object[]
  fields[1] = root.reg('r',0) as .object; fields[2] = .lltarget..operand.integer(17) as .object
  opaque = root.emit('load',fields,at); ignored = root.emit('ret',empty,at)
  source = draft.finish()
  failures = failures + check(source.valid(),'opaque normalization source validates ' || mode)
  if source.valid() = 0 then do; say source.error(); return failures; end
  builder = .lltargettransfer..profiledraft(reference source,'independent.opaque.normalization.' || mode)
  do i = 1 to source.records()
    item = source.record(i)
    if item.kind() = 'procedure' then iterate
    ignored = builder.operation(item.id()); ignored = builder.relocation(item.id(),'none')
  end
  kind = 'unknown'; if mode = 1 then kind = 'external'
  ignored = builder.event(opaque,kind,0,0)
  profile = builder.finish(); cfg = .lltargetcfg..graph(reference source,reference profile)
  flow = .lltargetflow..analysis(reference source,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','opaque normalization flow builds ' || mode)
  if flow.status() <> 'ok' then do; say flow.reason(); return failures; end
  coverage = flow.entrycoverage(source.procedureid('main'))
  normalized = lltargetnormalize..normalize(reference source,reference flow); result = normalized.result()
  failures = failures + check(coverage.complete() = 0 & coverage.unresolved() & normalized.complete(source.procedureid('main')) = 0,'opaque demand coverage does not authorize an owned-entry clear ' || mode)
  failures = failures + check(normalized.status() = 'keep' & result.identity() = source.identity(),'unproved opaque demands retain the exact input ' || mode)
  return failures

main: procedure = .int
  failures = ordinary(0) + ordinary(1) + ordinary(2) + ordinary(0,1)
  failures = failures + opaquenormalization(0) + opaquenormalization(1)
  say 'TARGET_NORMALIZATION_PRESERVATION|failures=' || failures
  return failures
