cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER LINKER CLI FIXTURES WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
set(_profile closed-main-static-exact-default-halt.v1)
set(_provider "${FIXTURES}/io-import-private-provider.rxas")
set(_caller "${FIXTURES}/io-import-private-caller.rxas")
set(_state "${FIXTURES}/io-import-private-state.rxas")
set(_values "5\n12\n12\n12\n19\n19\n19\n19")
file(SHA256 "${_provider}" _provider_before)

function(run_checked _description)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE _status
    OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "${_description}: ${_status}\n${_stdout}${_stderr}")
  endif()
  set(_last_stdout "${_stdout}" PARENT_SCOPE)
  set(_last_stderr "${_stderr}" PARENT_SCOPE)
endfunction()

function(execute_pair _source _product _expected)
  run_checked("assemble ${_product}" "${ASSEMBLER}" -n -o "${_product}" "${_source}")
  run_checked("link ${_product}" "${LINKER}" -m "${_product}.map" -o "${_product}-linked"
    "${_product}.rxbin" "${WORK}/private-provider.rxbin")
  file(READ "${_product}.map" _map)
  string(FIND "${_map}" " from ${WORK}/private-provider.rxbin" _selected)
  if(_selected LESS 0)
    message(FATAL_ERROR "retained imports did not select the exact provider")
  endif()
  run_checked("execute ${_product}" "${VM}" "${_product}-linked.rxbin")
  string(REPLACE "\r\n" "\n" _actual "${_last_stdout}")
  string(STRIP "${_actual}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "${_product}: expected '${_expected}', got '${_actual}'")
  endif()
endfunction()

# Independently expected values are checked against the original imported
# programs before either transformed caller is considered.
run_checked("assemble exact private-local provider" "${ASSEMBLER}" -n
  -o "${WORK}/private-provider" "${_provider}")
file(SHA256 "${WORK}/private-provider.rxbin" _binary_before)
execute_pair("${_caller}" "${WORK}/original-private" "${_values}")
execute_pair("${_state}" "${WORK}/original-state" "0\n256")

foreach(_mode conservative cleaned)
  set(_cleanup_option)
  if(_mode STREQUAL "conservative")
    set(_cleanup_option --no-cleanup)
  endif()
  set(_product "${WORK}/private-${_mode}")
  run_checked("expand imported private locals (${_mode})" "${VM}" "${CLI}" ${RUNTIME} -a
    --module io-import-private-caller.rxas --profile "${_profile}" --work 6000000
    --body io-import-private-provider.rxas "${_provider}" ${_cleanup_option}
    -o "${_product}.rxas" "${_caller}")
  file(STRINGS "${_product}.rxas" _lines ENCODING UTF-8)
  set(_imports 0)
  set(_definitions 0)
  set(_owned 0)
  set(_borrowed 0)
  set(_source_points 0)
  set(_steps "")
  set(_last_step "")
  set(_last_clause "")
  set(_pending "")
  set(_pending_register "")
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^(owned|borrowed)_left\\(\\)[ \t]+\\.expose=fixture\\.import\\.private\\.(owned|borrowed)$")
      math(EXPR _imports "${_imports} + 1")
    elseif(_line MATCHES "^[^ \t]+\\(\\)[ \t]+\\.locals=")
      math(EXPR _definitions "${_definitions} + 1")
      if(NOT _line MATCHES "^main\\(\\)[ \t]+\\.locals=")
        message(FATAL_ERROR "${_mode}: private provider/surrogate definition leaked")
      endif()
    endif()
    if(_line MATCHES "^[ \t]*(call[0-9]*|swapcall|settpswapcall|settpcall)[ \t]")
      message(FATAL_ERROR "${_mode}: selected imported private-local call survived")
    endif()
    if(_line MATCHES "^[ \t]*\\.srcstep ([0-9]+) ([0-9]+) 0 \"io-import-private-provider.rxas\" (8|14) 3 8 \"  ret r0\"$")
      set(_last_step "${CMAKE_MATCH_1}")
      set(_last_clause "${CMAKE_MATCH_2}")
      if(_last_step LESS_EQUAL 2 OR _last_clause LESS_EQUAL 2)
        message(FATAL_ERROR "${_mode}: private provider source IDs collide with caller IDs")
      endif()
      list(APPEND _steps "${_last_step}")
      math(EXPR _source_points "${_source_points} + 1")
    endif()
    if(_line MATCHES "^[ \t]*\\.traceevent \"V\" 4 \"R\" \"I\" \"r\" ([0-9]+) ([0-9]+) ([0-9]+) 0 \"(owned-snapshot|borrowed-local)\" \"\"$")
      set(_pending_register "r${CMAKE_MATCH_1}")
      if(NOT CMAKE_MATCH_2 STREQUAL _last_step OR NOT CMAKE_MATCH_3 STREQUAL _last_clause)
        message(FATAL_ERROR "${_mode}: private TRACE lost its provider source/clause")
      endif()
      set(_pending "${CMAKE_MATCH_4}")
      if(_pending STREQUAL "owned-snapshot")
        math(EXPR _owned "${_owned} + 1")
      else()
        math(EXPR _borrowed "${_borrowed} + 1")
      endif()
    endif()
    if(NOT _pending STREQUAL "" AND _line MATCHES "^[ \t]*[A-Za-z][A-Za-z0-9]*([ \t]|$)")
      # Inspect the conservative return transfer; cleanup may relocate or
      # discharge it only while retaining the TRACE storage observation.
      if(_mode STREQUAL "conservative")
        set(_transfer copy)
        if(_pending STREQUAL "owned-snapshot")
          set(_transfer move)
        endif()
        if(NOT _line MATCHES "^[ \t]*${_transfer}[ \t]+r[0-9]+,${_pending_register}$")
          message(FATAL_ERROR "${_mode}: ${_pending} lost its exact ${_transfer} return: ${_line}")
        endif()
      endif()
      set(_pending "")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _steps)
  list(LENGTH _steps _distinct_steps)
  if(NOT _imports EQUAL 2 OR NOT _definitions EQUAL 1 OR NOT _owned EQUAL 3
      OR NOT _borrowed EQUAL 2 OR NOT _source_points EQUAL 5 OR NOT _distinct_steps EQUAL 5
      OR NOT _pending STREQUAL "")
    message(FATAL_ERROR "${_mode}: private-local expansion lost imports, ownership or source/TRACE")
  endif()
  execute_pair("${_product}.rxas" "${_product}" "${_values}")
endforeach()

# Repeated native calls share one frame_free_list. The second whole COPY must
# see the cached flags; the entire selected batch stays ordinary calls.
set(_product "${WORK}/retained-state")
run_checked("retain imported recycled flags" "${VM}" "${CLI}" ${RUNTIME} -a
  --module io-import-private-state.rxas --profile "${_profile}" --work 6000000
  --body io-import-private-provider.rxas "${_provider}"
  -o "${_product}.rxas" "${_state}")
string(FIND "${_last_stderr}" "local.recycler.history.unproved" _reason)
if(_reason LESS 0)
  message(FATAL_ERROR "recycled-state refusal lost its precise history reason: ${_last_stderr}")
endif()
file(STRINGS "${_product}.rxas" _lines ENCODING UTF-8)
set(_calls 0)
set(_imports 0)
foreach(_line IN LISTS _lines)
  if(_line MATCHES "^[ \t]*call1[ \t]+r0,state_left\\(\\),r0$")
    math(EXPR _calls "${_calls} + 1")
  elseif(_line MATCHES "^state_left\\(\\)[ \t]+\\.expose=fixture\\.import\\.private\\.state$")
    math(EXPR _imports "${_imports} + 1")
  endif()
endforeach()
if(NOT _calls EQUAL 2 OR NOT _imports EQUAL 1)
  message(FATAL_ERROR "recycler-history refusal partially changed its call batch")
endif()
execute_pair("${_product}.rxas" "${_product}" "0\n256")
file(SHA256 "${_provider}" _provider_after)
file(SHA256 "${WORK}/private-provider.rxbin" _binary_after)
if(NOT _provider_before STREQUAL _provider_after OR NOT _binary_before STREQUAL _binary_after)
  message(FATAL_ERROR "private-local expansion changed the exact provider source/binary")
endif()
file(REMOVE_RECURSE "${WORK}")
message("RXAS_IMPORTED_PRIVATE|failures=0")
