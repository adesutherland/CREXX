/* cREXX License (MIT). Independent operational point/edge fact controls. */
options levelb
import llir
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetflow
import lltargetnormalize
import llrxascatalog

check: procedure = .int
  arg condition = .int, message = .string
  if condition then return 0
  say 'FAIL:' message
  return 1
one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object
  return body.emit(name,fields,at)
two: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object
  return body.emit(name,fields,at)
label: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, at = .llir..origin
  fields = .object[]; fields[1] = .lltarget..operand.symbol(name) as .object
  return body.record('label',fields,at)
stalewitness: procedure = .int
  arg view = .lltargetflow..entryread, property = .string
  do
    if property = 'origin' then do
      at = view.origin()
      return at.id() < 0
    end
    return view.operation() < 0
    on signal
      return 1
  end
  return 0

/* Callback-free field writes isolate canonical alias/value projection.
 * Original resource-setter/reference forms remain separate raw negatives. */
callavailability: procedure = .int
  arg mode = .string, rawcase = 0
  failures = 0; ignored = .int; i = .int; called = .int; integer = 0
  draft = .lltarget..draft('availability.' || mode || '.' || rawcase,'fixture:availability',0)
  at = draft.synthetic('captured actual identity and dirty provenance')
  body = draft.procedure('main',4,at)
  if mode = 'defined' | mode = 'dirty' | mode = 'unknown' | mode = 'constant' | mode = 'unknown-observe' then do
    if rawcase then ignored = two(body,'load',body.reg('r',0),.lltarget..operand.integer(11),at)
    else ignored = one(body,'getnumdgts',body.reg('r',0),at)
  end
  if mode = 'defined' then do
    if rawcase then ignored = two(body,'copy',body.reg('r',1),body.reg('r',0),at)
    else ignored = one(body,'getnumdgts',body.reg('r',1),at)
  end
  if rawcase & (mode = 'unknown' | mode = 'constant' | mode = 'unknown-observe') then ignored = two(body,'linkref',body.reg('r',1),body.reg('r',0),at)
  if mode = 'join' then do
    if rawcase then ignored = two(body,'load',body.reg('r',3),.lltarget..operand.integer(1),at)
    else ignored = one(body,'getnumdgts',body.reg('r',3),at)
  end
  fields = .object[]
  fields[1] = body.reg('r',2) as .object; fields[2] = .lltarget..operand.procedure('snapshot') as .object
  fields[3] = body.reg('r',1) as .object; fields[4] = body.reg('r',0) as .object
  if mode = 'repeated' | mode = 'join' then fields[3] = body.reg('r',0) as .object
  if mode = 'join' then do
    fields[5] = body.reg('r',3) as .object; called = body.emit('call3',fields,at)
  end
  else called = body.emit('call2',fields,at)
  observed = one(body,'itos',body.reg('r',2),at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  body = draft.procedure('snapshot',0,at)
  if mode = 'join' then ignored = two(body,'brt',.lltarget..operand.symbol('untouched'),body.reg('a',3),at)
  if mode = 'unknown-observe' then ignored = one(body,'itos',body.reg('a',1),at)
  if mode = 'constant' | mode = 'unknown-observe' then ignored = one(body,'ret',.lltarget..operand.integer(7),at)
  else do
    if rawcase then ignored = two(body,'load',body.reg('a',2),.lltarget..operand.integer(99),at)
    else ignored = one(body,'getnumdgts',body.reg('a',2),at)
    if mode = 'join' then ignored = label(body,'untouched',at)
    ignored = one(body,'ret',body.reg('a',1),at)
  end
  body = draft.procedure('unrelated',1,at)
  ignored = two(body,'linkref',body.reg('r',0),body.reg('a',1),at)
  ignored = one(body,'itos',body.reg('r',0),at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  target = draft.finish(); failures = failures + check(target.valid(),'availability source ' || mode)
  if target.valid() = 0 then return failures
  profile = .lltargettransfer..profile(reference target)
  cfg = .lltargetcfg..graph(reference target,reference profile)
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','availability flow ' || mode || ': ' || flow.message())
  if flow.status() <> 'ok' then return failures
  catalog = .llrxascatalog..catalog()
  do i = 1 to profile.domains()
    domain = profile.domain(i)
    if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('I') then integer = i
  end
  /* The normal call result is separate from failure/skip paths joining at
   * the later observation; normalization must retain every dirty origin. */
  value = flow.componentat(called,'r',2,integer,1)
  if rawcase then failures = failures + check(value.availability() = 'unknown' & value.known() = 0,'raw resource/unknown-reference paths cannot prove a normal borrowed or literal result ' || mode)
  else if mode = 'defined' | mode = 'repeated' then do
    failures = failures + check(value.availability() = 'unknown','raw frame callback can replace even defined/repeated actual components ' || mode || ': ' || value.availability() || ' / ' || value.reason())
    failures = failures + check(value.known() = 0,'may-alias availability never invents return literal ' || mode)
  end
  else if mode = 'constant' | mode = 'unknown-observe' then do
    literal = value.literal()
    failures = failures + check(value.availability() = 'defined' & value.known() & literal.index() = 7,'literal return is precise with unknown actual values and a checked result binding: ' || value.availability() || ' / ' || value.reason())
  end
  else if mode = 'unknown' then failures = failures + check(value.availability() = 'unknown','unresolved alias remains unknown')
  else failures = failures + check(value.availability() = 'unknown' & value.known() = 0,'raw frame callback prevents an exhaustive dirty-origin proof ' || mode || ': ' || value.availability() || ' / ' || value.reason())
  normalized = lltargetnormalize..normalize(reference target,reference flow)
  failures = failures + check(wordpos(normalized.status(),'changed keep') > 0,'partial normalization remains a valid result ' || mode)
  failures = failures + check(normalized.complete(target.procedureid('unrelated')) = 0,'unrelated incomplete body is not certified ' || mode)
  failures = failures + check(normalized.complete(target.procedureid('main')) = 0 & normalized.unknownreason(target.procedureid('main')) <> '','point-value precision cannot discharge raw whole-function callbacks/policy ' || mode || '.' || rawcase)
  return failures

/* The corresponding callback-free transfer retains precise availability.
 * Raw CALL hooks above must not weaken this independent positive/dirty oracle. */
callbackfreetransfer: procedure = .int
  arg defined = .int
  failures = 0; ignored = .int; integer = 0; subject = .int; origin = .int
  draft = .lltarget..draft('flow.callback.free.' || defined,'fixture:flow.callback.free',0)
  at = draft.synthetic('callback-free scalar transfer preserves entry availability')
  body = draft.procedure('main',2,at)
  written = 0
  if defined then written = one(body,'getnumdgts',body.reg('r',0),at)
  copied = two(body,'icopy',body.reg('r',1),body.reg('r',0),at)
  returned = one(body,'ret',.lltarget..operand.integer(0),at)
  target = draft.finish(); catalog = .llrxascatalog..catalog()
  premise = .lltargettransfer..profiledraft(reference target,'fixture.callback.free.v1')
  integer = premise.domain('component','fixture.integer',catalog.componentmask('I'))
  if defined then do
    ignored = premise.operation(written); subject = premise.ref(written,1)
    ignored = premise.event(written,'write',subject,integer)
  end
  ignored = premise.operation(copied); subject = premise.ref(copied,1); origin = premise.ref(copied,2)
  ignored = premise.event(copied,'transport',subject,integer,'reference',origin)
  ignored = premise.operation(returned)
  ignored = premise.event(returned,'return',0,integer,'literal',0,.lltarget..operand.integer(0))
  profile = premise.finish()
  cfg = .lltargetcfg..graph(reference target,reference profile)
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','callback-free transfer flow completes')
  if flow.status() <> 'ok' then return failures
  value = flow.componentat(returned,'r',1,integer)
  if defined then failures = failures + check(value.availability() = 'defined' & value.known() = 0,'callback-free actual copy retains defined unknown value')
  else failures = failures + check(value.availability() = 'entry' & value.dirty(),'callback-free actual copy retains exact dirty origin')
  return failures

/* A possible entry frame hook precedes the normal result, and can change
 * actual pointees. It cannot donate a pre-hook literal or a failure result. */
callhookreturn: procedure = .int
  arg recover = .int
  failures = 0; ignored = .int; i = .int; integer = .int; hook = .int; failureschecked = .int
  action = .lltargettransfer..action; edge = .lltargetcfg..edge
  draft = .lltarget..draft('flow.call.hook.return.' || recover,'fixture:flow.call.hook.return',0)
  at = draft.synthetic('frame callback precedes normal result projection')
  body = draft.procedure('main',2,at)
  ignored = two(body,'load',body.reg('r',0),.lltarget..operand.integer(11),at)
  /* Defining the actual before a possible frame hook does not constrain a
   * later callback: it can copy a dirty component from another value. */
  if recover = 1 then ignored = one(body,'getnumdgts',body.reg('r',0),at)
  fields = .object[]; fields[1] = body.reg('r',1) as .object
  fields[2] = .lltarget..operand.procedure('leaf') as .object; fields[3] = body.reg('r',0) as .object
  called = body.emit('call1',fields,at)
  redefined = 0
  if recover = 2 then redefined = one(body,'getnumdgts',body.reg('r',1),at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  body = draft.procedure('leaf',0,at); ignored = one(body,'ret',body.reg('a',1),at)
  target = draft.finish(); profile = .lltargettransfer..profile(reference target)
  cfg = .lltargetcfg..graph(reference target,reference profile)
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','raw frame-hook return flow builds')
  if flow.status() <> 'ok' then do; say flow.reason(); return failures; end
  catalog = .llrxascatalog..catalog()
  do i = 1 to profile.domains()
    domain = profile.domain(i)
    if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('I') then integer = i
  end
  instruction = profile.instruction(called)
  do i = 1 to instruction.actions()
    action = instruction.action(i)
    if action.kind() = 'callback' & action.detail() = 'catalog.callback.call-frame' then hook = flow.callbackpossibleat(called,i)
  end
  failures = failures + check(hook & flow.complete(target.procedureid('main'),'entry-observation') = 0,'normal result precision retains the real frame hook and raw observation veto')
  value = flow.componentat(called,'r',1,integer,1)
  failures = failures + check(value.availability() = 'unknown' & value.known() = 0,'a possible frame hook can import dirty components despite earlier definition ' || recover || ': ' || value.availability() || ' / ' || value.reason())
  if redefined > 0 then do
    value = flow.componentat(redefined,'r',1,integer,1)
    failures = failures + check(value.availability() = 'defined' & value.known() = 0,'a callback-free write after the last callback genuinely restores scalar availability')
  end
  binding = flow.storageat(called,'r',1)
  failures = failures + check(binding.active() > 0,'resumed resource callback preserves the captured result pointer independently of value facts ' || recover)
  do i = 1 to cfg.outedges(called)
    edge = cfg.outedge(called,i)
    if edge.phase() = 'none' | edge.role() = 'normal' | edge.role() = 'table' | edge.asynchronous() then iterate
    value = flow.componenton(edge.id(),'r',1,integer)
    failures = failures + check(value.known() = 0,'exceptional call checkpoint cannot borrow the successful return projection')
    failureschecked = failureschecked + 1
  end
  failures = failures + check(failureschecked > 0,'frame-hook return control retains separate exceptional alternatives')
  return failures

/* This raw service shape has real setter/frame hooks. An exhaustive owned
 * clear list is unproved until callback/handler preservation is supplied. */
callresultorigins: procedure = .int
  failures = 0; ignored = .int
  draft = .lltarget..draft('availability.service','fixture:availability.service',1)
  at = draft.synthetic('ordinary child call result entry origins')
  body = draft.procedure('main',2,at)
  ignored = two(body,'load',body.reg('r',0),.lltarget..operand.integer(5),at)
  fields = .object[]; fields[1] = body.reg('r',1) as .object
  fields[2] = .lltarget..operand.procedure('helper') as .object; fields[3] = body.reg('r',0) as .object
  ignored = body.emit('call1',fields,at)
  observedmain = one(body,'itos',body.reg('r',1),at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  body = draft.procedure('helper',2,at)
  ignored = two(body,'load',body.reg('g',0),.lltarget..operand.integer(7),at)
  fields[1] = body.reg('r',0) as .object; fields[2] = .lltarget..operand.procedure('child') as .object
  fields[3] = body.reg('a',1) as .object; ignored = body.emit('call1',fields,at)
  fields[1] = body.reg('r',1) as .object; fields[2] = body.reg('r',0) as .object; fields[3] = body.reg('g',0) as .object
  observedchild = body.emit('iadd',fields,at)
  ignored = one(body,'ret',body.reg('r',1),at)
  body = draft.procedure('child',0,at); ignored = one(body,'ret',body.reg('a',1),at)
  target = draft.finish()
  profile = .lltargettransfer..profile(reference target)
  cfg = .lltargetcfg..graph(reference target,reference profile)
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','service-shaped call result flow: ' || flow.message())
  if flow.status() <> 'ok' then return failures
  maincoverage = flow.entrycoverage(target.procedureid('main')); helpercoverage = flow.entrycoverage(target.procedureid('helper'))
  failures = failures + check(maincoverage.complete() = 0 & maincoverage.unresolved() & helpercoverage.complete() = 0 & helpercoverage.unresolved(),'raw setter/frame callbacks retain unresolved service-shaped owned-entry coverage')
  normalized = lltargetnormalize..normalize(reference target,reference flow)
  failures = failures + check(normalized.complete(target.procedureid('main')) = 0 & normalized.complete(target.procedureid('helper')) = 0,'raw service callbacks cannot publish whole-function entry certificates')
  return failures

/* Sixty-five possible writes cannot be silently dropped from a bounded
 * availability summary. This independent narrow profile has one domain. */
aliaslimit: procedure = .int
  failures = 0; ignored = .int; i = .int
  draft = .lltarget..draft('availability.limit','fixture:availability.limit',0)
  at = draft.synthetic('bounded alias availability')
  body = draft.procedure('main',1,at)
  written = two(body,'load',body.reg('a',2),.lltarget..operand.integer(99),at)
  copied = two(body,'copy',body.reg('r',0),body.reg('a',1),at)
  observed = one(body,'itos',body.reg('r',0),at)
  ended = one(body,'ret',.lltarget..operand.integer(0),at)
  target = draft.finish()
  premise = .lltargettransfer..profiledraft(reference target,'fixture.alias.limit.v1')
  integer = premise.domain('component','fixture.integer')
  ignored = premise.operation(written); writer = premise.ref(written,1)
  do i = 1 to 65
    ignored = premise.event(written,'write',writer,integer,'literal',0,.lltarget..operand.integer(99),'may')
  end
  ignored = premise.operation(copied); destination = premise.ref(copied,1); source = premise.ref(copied,2)
  ignored = premise.event(copied,'transport',destination,integer,'reference',source)
  ignored = premise.operation(observed); destination = premise.ref(observed,1)
  ignored = premise.event(observed,'observe',destination,integer)
  ignored = premise.operation(ended); ignored = premise.event(ended,'return',0,integer,'literal',0,.lltarget..operand.integer(0))
  profile = premise.finish(); cfg = .lltargetcfg..graph(reference target,reference profile)
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','bounded summary remains a usable conservative analysis')
  if flow.status() <> 'ok' then return failures
  value = flow.componentat(observed,'r',0,integer)
  failures = failures + check(value.availability() = 'unknown' & value.known() = 0,'bounded alias summary never proves a value or definition')
  failures = failures + check(value.reason() = 'target.flow.alias.provenance.limit','bounded alias summary has an explicit refusal reason')
  failures = failures + check(flow.complete(target.procedureid('main'),'entry-observation') = 0,'bounded unknown cannot certify owned entry normalization')
  return failures

/* Repeated writes to an indexed owned-cell set have a finite logical
 * allowance; growth of unrelated retained cells is not another scan/write. */
indexedbudget: procedure = .int
  failures = 0; ignored = .int; i = .int; subject = .int; literal = .lltarget..operand
  draft = .lltarget..draft('flow.indexed.budget','fixture:flow.indexed.budget',0)
  at = draft.synthetic('indexed cell update allowance')
  body = draft.procedure('main',16,at); writes = .int[]
  do i = 0 to 15
    writes[writes[0] + 1] = two(body,'load',body.reg('r',i),.lltarget..operand.integer(i),at)
  end
  do i = 1 to 64
    writes[writes[0] + 1] = two(body,'load',body.reg('r',i % 16),.lltarget..operand.integer(i),at)
  end
  observed = one(body,'itos',body.reg('r',15),at)
  ended = one(body,'ret',.lltarget..operand.integer(0),at)
  target = draft.finish(); premise = .lltargettransfer..profiledraft(reference target,'fixture.indexed.budget.v1')
  integer = premise.domain('component','fixture.integer')
  do i = 1 to writes[0]
    ignored = premise.operation(writes[i]); subject = premise.ref(writes[i],1); record = target.at(writes[i]); literal = record.operand(2)
    ignored = premise.event(writes[i],'write',subject,integer,'literal',0,literal)
  end
  ignored = premise.operation(observed); subject = premise.ref(observed,1); ignored = premise.event(observed,'observe',subject,integer)
  ignored = premise.operation(ended); ignored = premise.event(ended,'return',0,integer,'literal',0,.lltarget..operand.integer(0))
  profile = premise.finish(); cfg = .lltargetcfg..graph(reference target,reference profile)
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg,30000)
  failures = failures + check(flow.status() = 'ok','indexed owned writes fit a bounded traversal allowance: ' || flow.message())
  if flow.status() = 'ok' then do
    value = flow.componentat(observed,'r',15,integer); literal = value.literal()
    failures = failures + check(value.known() & literal.index() = 63,'indexed budget control retains the independently expected last value')
  end
  limited = .lltargetflow..analysis(reference target,reference profile,reference cfg,1)
  failures = failures + check(limited.status() = 'limit','indexed accounting still enforces exhausted fuel')
  return failures

/* An unknown component and a defined component join to unknown in either
 * incoming-edge order; intact bindings distinguish this from alias havoc. */
unknownmeet: procedure = .int
  arg knownleft = .int
  failures = 0; ignored = .int; i = .int; subject = .int
  item = .lltarget..record
  draft = .lltarget..draft('flow.unknown.meet.' || knownleft,'fixture:flow.unknown.meet',0)
  at = draft.synthetic('unknown availability absorbs both meet operand orders')
  body = draft.procedure('main',1,at)
  ignored = two(body,'brt',.lltarget..operand.symbol('right'),body.reg('a',1),at)
  leftwrite = two(body,'load',body.reg('r',0),.lltarget..operand.integer(7),at)
  ignored = one(body,'br',.lltarget..operand.symbol('joined'),at)
  ignored = label(body,'right',at)
  rightwrite = two(body,'load',body.reg('r',0),.lltarget..operand.integer(7),at)
  ignored = label(body,'joined',at)
  observed = one(body,'itos',body.reg('r',0),at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  target = draft.finish(); failures = failures + check(target.valid(),'unknown meet source validates ' || knownleft)
  if target.valid() = 0 then do; say target.error(); return failures; end
  premise = .lltargettransfer..profiledraft(reference target,'independent.unknown.meet')
  integer = premise.domain('component','fixture.meet.integer')
  do i = 1 to target.records()
    item = target.record(i)
    if item.kind() = 'procedure' then iterate
    ignored = premise.operation(item.id()); ignored = premise.relocation(item.id(),'none')
    if item.id() = leftwrite | item.id() = rightwrite then do
      subject = premise.ref(item.id(),1)
      certainty = 'unknown'
      if (item.id() = leftwrite & knownleft) | (item.id() = rightwrite & knownleft = 0) then certainty = 'must'
      ignored = premise.event(item.id(),'write',subject,integer,'literal',0,.lltarget..operand.integer(7),certainty)
    end
    else if item.id() = observed then do
      subject = premise.ref(observed,1); ignored = premise.event(observed,'observe',subject,integer)
    end
    else if item.kind() = 'instruction' then do
      if item.mnemonic() = 'brt' then do
        subject = premise.ref(item.id(),2); ignored = premise.event(item.id(),'observe',subject,integer)
      end
      else if item.mnemonic() = 'ret' then ignored = premise.event(item.id(),'return',0,0)
    end
  end
  profile = premise.finish(); cfg = .lltargetcfg..graph(reference target,reference profile)
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','unknown meet flow builds ' || knownleft)
  if flow.status() <> 'ok' then do; say flow.reason(); return failures; end
  value = flow.componentat(observed,'r',0,integer); binding = flow.storageat(observed,'r',0)
  failures = failures + check(binding.active() > 0 & value.availability() = 'unknown' & value.known() = 0,'unknown availability cannot become mixed or donate a literal in either edge order ' || knownleft || ': ' || value.availability())
  return failures

/* The caller precedes both providers in the module. Its unchanged incoming
 * cells do not imply an unchanged transitive return summary. */
summaryrevisit: procedure = .int
  failures = 0; ignored = .int; i = .int; integer = .int
  draft = .lltarget..draft('flow.summary.revisit','fixture:flow.summary.revisit',0)
  at = draft.synthetic('later callee facts revisit unchanged caller input')
  body = draft.procedure('main',2,at)
  ignored = two(body,'load',body.reg('r',0),.lltarget..operand.integer(5),at)
  fields = .object[]; fields[1] = body.reg('r',1) as .object
  fields[2] = .lltarget..operand.procedure('bridge') as .object; fields[3] = body.reg('r',0) as .object
  called = body.emit('call1',fields,at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  body = draft.procedure('bridge',1,at)
  fields[1] = body.reg('r',0) as .object; fields[2] = .lltarget..operand.procedure('leaf') as .object; fields[3] = body.reg('a',1) as .object
  ignored = body.emit('call1',fields,at)
  ignored = one(body,'ret',body.reg('r',0),at)
  body = draft.procedure('leaf',0,at); ignored = one(body,'ret',.lltarget..operand.integer(13),at)
  target = draft.finish()
  profile = .lltargettransfer..profile.closedcalls(reference target,target.procedureid('main'),'closed-main-default-halt.v1')
  cfg = .lltargetcfg..graph(reference target,reference profile)
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','bounded transitive summary converges after caller input freezes: ' || flow.message())
  if flow.status() <> 'ok' then return failures
  catalog = .llrxascatalog..catalog()
  do i = 1 to profile.domains()
    domain = profile.domain(i)
    if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('I') then integer = i
  end
  value = flow.componentat(called,'r',1,integer,1); literal = value.literal()
  failures = failures + check(value.availability() = 'defined' & value.known() & literal.index() = 13,'call-dependent block revisits a changed callee summary')
  return failures

/* Independent operational CALL/RET programs expose the dependency without
 * borrowing a native callback/resource theorem. Both callers precede leaf. */
summaryworklist: procedure = .int
  arg dirty = .int
  failures = 0; ignored = .int; i = .int; resultref = .int; targetref = .int
  item = .lltarget..record; operand = .lltarget..operand
  draft = .lltarget..draft('flow.summary.worklist.' || dirty,'fixture:flow.summary.worklist',0)
  at = draft.synthetic('subscribed late return facts refine a stable caller')
  body = draft.procedure('main',1,at)
  called = two(body,'call',body.reg('r',0),.lltarget..operand.procedure('bridge'),at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  body = draft.procedure('bridge',1,at)
  ignored = two(body,'call',body.reg('r',0),.lltarget..operand.procedure('leaf'),at)
  ignored = one(body,'ret',body.reg('r',0),at)
  body = draft.procedure('leaf',dirty,at)
  if dirty then ignored = one(body,'ret',body.reg('r',0),at)
  else ignored = one(body,'ret',.lltarget..operand.integer(13),at)
  target = draft.finish(); failures = failures + check(target.valid(),'independent return-worklist source validates ' || dirty)
  if target.valid() = 0 then do; say target.error(); return failures; end
  failures = failures + check(target.procedureid('main') < target.procedureid('bridge') & target.procedureid('bridge') < target.procedureid('leaf'),'return providers occur after their unchanged callers')
  catalog = .llrxascatalog..catalog(); premise = .lltargettransfer..profiledraft(reference target,'independent.summary.worklist')
  integer = premise.domain('component','fixture.worklist.integer',catalog.componentmask('I'))
  do i = 1 to target.records()
    item = target.record(i)
    if item.kind() = 'procedure' then iterate
    ignored = premise.operation(item.id()); ignored = premise.relocation(item.id(),'none')
    if item.kind() <> 'instruction' then iterate
    if item.mnemonic() = 'call' then do
      resultref = premise.ref(item.id(),1); targetref = premise.ref(item.id(),2,'procedure','symbolic')
      ignored = premise.event(item.id(),'clear',resultref,0)
      ignored = premise.event(item.id(),'callcapture',0,0,'none',0,.lltarget..operand(),'must','all','after','fixture.exact.call')
      ignored = premise.event(item.id(),'call',0,0,'reference',targetref,.lltarget..operand(),'must','normal','after','fixture.exact.call')
    end
    else do
      operand = item.operand(1)
      if operand.kind() = 'R' then ignored = premise.ref(item.id(),1)
      ignored = premise.event(item.id(),'return',0,0)
    end
  end
  profile = premise.finish(); cfg = .lltargetcfg..graph(reference target,reference profile)
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','independent transitive return worklist converges ' || dirty || ': ' || flow.reason())
  if flow.status() <> 'ok' then return failures
  value = flow.componentat(called,'r',0,integer,1); operand = value.literal()
  if dirty then failures = failures + check(value.availability() = 'entry' & value.known() = 0,'late dirty return cannot become the cleared caller result or a literal')
  else failures = failures + check(value.availability() = 'defined' & value.known() & operand.kind() = 'I' & operand.index() = 13,'changed leaf RET reschedules both unchanged caller inputs')
  return failures

/* An explicit complete no-hook program isolates dirty owner/dependency
 * certification. The branch skips the entire result-clear/call sequence. */
privatecertificate: procedure = .int
  arg incomplete = .int
  failures = 0; ignored = .int; i = .int; subject = .int; targetref = .int; rootdirty = .int; privatedirty = .int
  item = .lltarget..record; operand = .lltarget..operand
  draft = .lltarget..draft('flow.private.certificate.' || incomplete,'fixture:flow.private.certificate',0)
  at = draft.synthetic('complete operational premise isolates private and skipped result entries')
  body = draft.procedure('main',1,at)
  ignored = two(body,'brt',.lltarget..operand.symbol('after.call'),body.reg('a',1),at)
  ignored = two(body,'call',body.reg('r',0),.lltarget..operand.procedure('leaf'),at)
  ignored = label(body,'after.call',at)
  ignored = one(body,'itos',body.reg('r',0),at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  locals = 1; if incomplete then locals = 3
  body = draft.procedure('leaf',locals,at)
  if incomplete then do
    fields = .object[]; fields[1] = body.reg('r',2) as .object; fields[2] = body.reg('r',1) as .object
    fields[3] = .lltarget..operand.integer(768) as .object; ignored = body.emit('getandtp',fields,at)
  end
  returned = one(body,'ret',body.reg('r',0),at)
  target = draft.finish(); failures = failures + check(target.valid(),'private certificate source validates ' || incomplete)
  if target.valid() = 0 then do; say target.error(); return failures; end
  catalog = .llrxascatalog..catalog(); premise = .lltargettransfer..profiledraft(reference target,'independent.private.certificate')
  integer = premise.domain('component','fixture.private.integer',catalog.componentmask('I'))
  do i = 1 to target.records()
    item = target.record(i)
    if item.kind() = 'procedure' then iterate
    ignored = premise.operation(item.id()); ignored = premise.relocation(item.id(),'none')
    if item.kind() <> 'instruction' then iterate
    select item.mnemonic()
      when 'call' then do
        subject = premise.ref(item.id(),1); targetref = premise.ref(item.id(),2,'procedure','symbolic')
        ignored = premise.event(item.id(),'clear',subject,0)
        ignored = premise.event(item.id(),'callcapture',0,0,'none',0,.lltarget..operand(),'must','all','after','fixture.exact.call')
        ignored = premise.event(item.id(),'call',0,0,'reference',targetref,.lltarget..operand(),'must','normal','after','fixture.exact.call')
      end
      when 'brt' then do
        subject = premise.ref(item.id(),2); ignored = premise.event(item.id(),'observe',subject,integer)
      end
      when 'itos' then do
        subject = premise.ref(item.id(),1); ignored = premise.event(item.id(),'observe',subject,integer)
      end
      when 'getandtp' then do
        subject = premise.ref(item.id(),1); ignored = premise.ref(item.id(),2)
        ignored = premise.event(item.id(),'write',subject,integer)
        call premise.unknown(item.id(),'observations','fixture.status.observation.unrepresented')
      end
      when 'ret' then do
        operand = item.operand(1)
        if operand.kind() = 'R' then do
          subject = premise.ref(item.id(),1); ignored = premise.event(item.id(),'observe',subject,integer)
        end
        ignored = premise.event(item.id(),'return',0,0)
      end
      otherwise call premise.unknown(item.id(),'effects','fixture.operation.unrepresented')
    end
  end
  profile = premise.finish(); cfg = .lltargetcfg..graph(reference target,reference profile)
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','private no-hook certificate flow builds ' || incomplete)
  if flow.status() <> 'ok' then do; say flow.reason(); return failures; end
  do i = 1 to flow.entryobservations()
    witness = flow.entryobservation(i)
    if witness.function() = target.procedureid('main') & witness.ownedindex() = 0 then rootdirty = 1
    if witness.function() = target.procedureid('leaf') & witness.ownedindex() = 0 & witness.operation() = returned then privatedirty = 1
  end
  failures = failures + check(rootdirty & privatedirty,'explicit no-hook skip and private return retain both exact dirty owners ' || incomplete)
  if incomplete = 0 then do
    coverage = flow.entrycoverage(target.procedureid('main'))
    failures = failures + check(coverage.complete() & coverage.dependencies() = 1,'complete intrinsic observations retain one explicit private-return normalization dependency')
    if coverage.dependencies() = 1 then failures = failures + check(coverage.dependency(1) = target.procedureid('leaf'),'private-return dependency names the exact source owner requiring normalization')
  end
  normalized = lltargetnormalize..normalize(reference target,reference flow)
  if incomplete then do
    failures = failures + check(normalized.complete(target.procedureid('main')) = 0 & normalized.complete(target.procedureid('leaf')) = 0,'incomplete provider cannot borrow a known dirty origin as a normalization certificate')
    failures = failures + check(normalized.unknownreason(target.procedureid('main')) = 'target.flow.call.intrinsic.footprint.unproved','deliberate provider observation gap retains the earliest intrinsic-footprint refusal: ' || normalized.unknownreason(target.procedureid('main')))
  end
  else failures = failures + check(normalized.complete(target.procedureid('main')) & normalized.complete(target.procedureid('leaf')) & normalized.warnings() >= 2,'complete no-hook coverage normalizes and warns for both required owners')
  return failures

/* Raw callback/policy paths cannot certify a caller's exhaustive dirty list.
 * A private RET point fact remains separate from its contextual demand. */
ownedreturn: procedure = .int
  arg mode = .int
  failures = 0; ignored = .int; i = .int
  draft = .lltarget..draft('flow.owned.return.' || mode,'fixture:flow.owned.return',0)
  at = draft.synthetic('typed caller demand reaches original private return')
  body = draft.procedure('main',2,at)
  ignored = two(body,'load',body.reg('r',0),.lltarget..operand.integer(5),at)
  fields = .object[]; fields[1] = body.reg('r',1) as .object
  fields[2] = .lltarget..operand.procedure('private') as .object; fields[3] = body.reg('r',0) as .object
  ignored = body.emit('call1',fields,at)
  ignored = one(body,'itos',body.reg('r',1),at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  privatelocals = 1; if mode = 2 then privatelocals = 3
  body = draft.procedure('private',privatelocals,at)
  if mode = 1 then ignored = two(body,'linkref',body.reg('r',0),body.reg('a',1),at)
  if mode = 2 then do
    /* Independent flag uncertainty cannot erase the exact returned r0
     * origin, or permit its caller to bypass the callee certificate. */
    fields[1] = body.reg('r',2) as .object; fields[2] = body.reg('r',1) as .object
    fields[3] = .lltarget..operand.integer(768) as .object
    ignored = body.emit('getandtp',fields,at)
  end
  returned = one(body,'ret',body.reg('r',0),at)
  target = draft.finish(); profile = .lltargettransfer..profile(reference target)
  cfg = .lltargetcfg..graph(reference target,reference profile)
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','owned return demand analysis remains bounded')
  if flow.status() <> 'ok' then return failures
  catalog = .llrxascatalog..catalog(); integer = 0
  do i = 1 to profile.domains()
    domain = profile.domain(i)
    if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('I') then integer = i
  end
  value = flow.componentat(returned,'r',0,integer)
  normalized = lltargetnormalize..normalize(reference target,reference flow)
  if mode = 1 then do
    failures = failures + check(value.availability() = 'unknown' & value.dirty() = 0,'unresolved raw return binding cannot invent a private origin')
  end
  else do
    if mode = 2 then failures = failures + check(value.availability() = 'unknown' & value.known() = 0,'raw ambient handler may import an unnamed dirty origin into the private RET: ' || value.availability())
    else failures = failures + check(value.availability() = 'entry' & value.dirty(),'raw private RET retains its local dirty origin despite the caller coverage gap ' || mode)
    if mode = 2 then failures = failures + check(normalized.complete(target.procedureid('private')) & normalized.warnings() > 0,'typed flag observation gives the private dirty read a clear and warning')
  end
  failures = failures + check(normalized.complete(target.procedureid('main')) = 0 & normalized.unknownreason(target.procedureid('main')) <> '','raw caller callback/handler uncertainty remains an explicit entry-certificate refusal ' || mode)
  return failures

fullresetcount: procedure = .int
  failures = 0; integer = 0; native = 0; countid = 0; possible = 0; capacitypossible = 0; fields = .object[]; i = .int
  action = .lltargettransfer..action
  draft = .lltarget..draft('full.reset.count','fixture:full.reset.count',0)
  at = draft.synthetic('a full reset does not invent a later setter finalizer')
  body = draft.procedure('main',3,at)
  ignored = two(body,'load',body.reg('r',0),.lltarget..operand.integer(2),at)
  cleared = one(body,'null',body.reg('r',1),at)
  ignored = two(body,'load',body.reg('r',1),.lltarget..operand.integer(0),at)
  ignored = two(body,'settp',body.reg('r',1),.lltarget..operand.integer(768),at)
  ignored = two(body,'settp',body.reg('r',1),.lltarget..operand.integer(0),at)
  copied = two(body,'copy',body.reg('r',2),body.reg('r',1),at)
  fields[1] = body.reg('r',2) as .object; fields[2] = .lltarget..operand.procedure('leaf') as .object
  fields[3] = body.reg('r',0) as .object; called = body.emit('call',fields,at)
  calledagain = body.emit('call',fields,at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  body = draft.procedure('leaf',0,at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  target = draft.finish()
  failures = failures + check(target.valid(),'full-reset count source validates')
  if target.valid() = 0 then return failures
  profile = .lltargettransfer..profile.closedcalls(reference target,target.procedureid('main'),'closed-main-default-halt.v1')
  cfg = .lltargetcfg..graph(reference target,reference profile)
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','full-reset count flow builds')
  if flow.status() <> 'ok' then return failures
  catalog = .llrxascatalog..catalog()
  do i = 1 to profile.domains()
    domain = profile.domain(i)
    if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('I') then integer = i
    if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('native-payload') then native = i
    if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('attribute-count') then countid = i
  end
  value = flow.componentat(cleared,'r',1,native,1)
  failures = failures + check(value.presence() = 'absent','full reset leaves native payload absent')
  value = flow.componentat(called,'r',1,countid)
  failures = failures + check(value.presence() = 'absent','scalar setter preserves an independently cleared attribute tree')
  value = flow.componentat(called,'r',0,integer); literal = value.literal()
  failures = failures + check(value.known() & literal.kind() = 'I' & literal.index() = 2 & flow.captureargumentcount(called) = 2,'following setter preserves the independently loaded count')
  value = flow.componentat(calledagain,'r',0,integer); literal = value.literal()
  failures = failures + check(value.known() & literal.kind() = 'I' & literal.index() = 2 & flow.captureargumentcount(calledagain) = 2,'retained child call preserves an unreachable caller count')
  instruction = profile.instruction(copied)
  do i = 1 to instruction.actions()
    action = instruction.action(i)
    if action.detail() = 'catalog.callback.capacity-or-checkpoint' then capacitypossible = capacitypossible | flow.callbackpossibleat(copied,i)
  end
  failures = failures + check(capacitypossible,'dirty destination COPY retains its raw possible capacity hook')
  instruction = profile.instruction(cleared)
  do i = 1 to instruction.actions()
    action = instruction.action(i)
    if action.kind() = 'callback' then possible = possible | flow.callbackpossibleat(cleared,i)
  end
  failures = failures + check(possible,'dirty-entry reset retains its raw possible cleanup hook')
  return failures

main: procedure = .int
  failures = 0; ignored = .int; i = .int; normaledge = .int; beforeedge = .int; partialedge = .int; afteredge = .int
  haswitness = 0
  ref0 = .int; ref1 = .int; ref2 = .int; labelref = .int
  value = .lltargetflow..valuefact; witness = .lltargetflow..entryread
  lifetime = .lltargetflow..lifetimefact
  edge = .lltargetcfg..edge; record = .lltarget..record
  literal = .lltarget..operand
  draft = .lltarget..draft('target.flow','fixture:target.flow',0)
  at = draft.synthetic('independent ordered transfer and signal-phase contract')
  body = draft.procedure('main',3,at)
  seed = two(body,'load',body.reg('r',0),.lltarget..operand.integer(10),at)
  changed = two(body,'load',body.reg('r',0),.lltarget..operand.integer(99),at)
  joined = label(body,'joined',at)
  transported = two(body,'copy',body.reg('r',2),body.reg('r',1),at)
  observed = one(body,'say',body.reg('r',2),at)
  firstswap = two(body,'swap',body.reg('r',0),body.reg('r',2),at)
  secondswap = two(body,'swap',body.reg('r',2),body.reg('r',1),at)
  ended = one(body,'endlife',body.reg('r',0),at)
  renewed = two(body,'load',body.reg('r',0),.lltarget..operand.integer(0),at)
  countread = one(body,'say',body.reg('a',0),at)
  returned = one(body,'ret',.lltarget..operand.integer(0),at)
  body = draft.procedure('uncertain',2,at)
  uncertainseed = two(body,'load',body.reg('r',0),.lltarget..operand.integer(10),at)
  uncertainmap = two(body,'link',body.reg('r',0),body.reg('r',1),at)
  uncertainread = one(body,'say',body.reg('r',0),at)
  uncertainret = one(body,'ret',.lltarget..operand.integer(0),at)
  body = draft.procedure('deriver',1,at)
  deriveseed = two(body,'load',body.reg('r',0),.lltarget..operand.integer(10),at)
  derived = one(body,'itos',body.reg('r',0),at)
  deriveread = one(body,'say',body.reg('r',0),at)
  deriveret = one(body,'ret',.lltarget..operand.integer(0),at)
  target = draft.finish()
  failures = failures + check(target.valid(),'constructed source owner')
  if target.valid() = 0 then do; say target.error(); say 'TARGET_FLOW|failures=' || failures; return failures; end
  premise = .lltargettransfer..profiledraft(reference target,'fixture.flow.phases.v1')
  integer = premise.domain('component','fixture.integer')
  floating = premise.domain('component','fixture.float')
  stringdomain = premise.domain('component','fixture.string')
  flag = premise.domain('flag','flag.bit.8')
  do i = 1 to target.records()
    record = target.record(i)
    if record.procedureid() > 1 & record.kind() <> 'procedure' then ignored = premise.operation(record.id())
  end
  ref0 = premise.ref(seed,1)
  ignored = premise.event(seed,'write',ref0,integer,'literal',0,.lltarget..operand.integer(10))
  ignored = premise.event(seed,'flagwrite',ref0,flag,'literal',0,.lltarget..operand.integer(1))
  ref0 = premise.ref(changed,1)
  /* The same ordered write is visible on normal/after edges, absent before,
   * and only possible on the explicitly partial edge. */
  ignored = premise.event(changed,'write',ref0,integer,'literal',0,.lltarget..operand.integer(99),'must','all','after')
  labelref = premise.ref(joined,1,'label','symbolic')
  ignored = premise.event(changed,'edge',labelref,0,'none',0,.lltarget..operand(),'must','failure','before','skip')
  ignored = premise.event(changed,'edge',labelref,0,'none',0,.lltarget..operand(),'must','failure','partial','skip')
  ignored = premise.event(changed,'edge',labelref,0,'none',0,.lltarget..operand(),'must','failure','after','skip')
  ref2 = premise.ref(transported,1); ref1 = premise.ref(transported,2)
  ignored = premise.event(transported,'transport',ref2,0,'reference',ref1)
  ref2 = premise.ref(observed,1)
  ignored = premise.event(observed,'observe',ref2,integer)
  ref0 = premise.ref(firstswap,1); ref2 = premise.ref(firstswap,2)
  ignored = premise.event(firstswap,'swap',ref0,0,'reference',ref2)
  ref2 = premise.ref(secondswap,1); ref1 = premise.ref(secondswap,2)
  ignored = premise.event(secondswap,'swap',ref2,0,'reference',ref1)
  ref0 = premise.ref(ended,1)
  ignored = premise.event(ended,'lifetime',ref0,0,'none',0,.lltarget..operand(),'must','normal','none','end')
  ref0 = premise.ref(renewed,1)
  ignored = premise.event(renewed,'lifetime',ref0,0,'none',0,.lltarget..operand(),'must','normal','none','begin')
  ignored = premise.event(renewed,'write',ref0,integer,'literal',0,.lltarget..operand.integer(0))
  countref = premise.ref(countread,1)
  ignored = premise.event(countread,'read',countref,integer)
  ignored = premise.event(returned,'return',0,integer,'literal',0,.lltarget..operand.integer(0))
  ref0 = premise.ref(uncertainseed,1)
  ignored = premise.event(uncertainseed,'write',ref0,integer,'literal',0,.lltarget..operand.integer(10))
  ref0 = premise.ref(uncertainmap,1); ref1 = premise.ref(uncertainmap,2)
  ignored = premise.event(uncertainmap,'link',ref0,0,'reference',ref1,.lltarget..operand(),'may')
  ref0 = premise.ref(uncertainread,1)
  ignored = premise.event(uncertainread,'observe',ref0,integer)
  ignored = premise.event(uncertainret,'return',0,integer,'literal',0,.lltarget..operand.integer(0))
  ref0 = premise.ref(deriveseed,1)
  ignored = premise.event(deriveseed,'write',ref0,integer,'literal',0,.lltarget..operand.integer(10))
  ref0 = premise.ref(derived,1)
  ignored = premise.event(derived,'observe',ref0,integer)
  ignored = premise.event(derived,'derive',ref0,stringdomain,'reference',ref0)
  ref0 = premise.ref(deriveread,1)
  ignored = premise.event(deriveread,'observe',ref0,stringdomain)
  ignored = premise.event(deriveret,'return',0,integer,'literal',0,.lltarget..operand.integer(0))
  profile = premise.finish()
  failures = failures + check(profile.status() = 'ok','independent operational profile seals')
  if profile.status() <> 'ok' then do; say profile.message(); say 'TARGET_FLOW|failures=' || failures; return failures; end
  cfg = .lltargetcfg..graph(reference target,reference profile)
  failures = failures + check(cfg.status() = 'ok','one typed machine CFG')
  if cfg.status() <> 'ok' then do; say cfg.message(); say 'TARGET_FLOW|failures=' || failures; return failures; end
  flow = lltargetflow..analyse(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','point and edge fixed point')
  if flow.status() <> 'ok' then do; say flow.message(); say 'TARGET_FLOW|failures=' || failures; return failures; end
  normaledge = 0; beforeedge = 0; partialedge = 0; afteredge = 0
  do i = 1 to cfg.outedges(changed)
    edge = cfg.outedge(changed,i)
    if edge.role() = 'normal' then normaledge = edge.id()
    else if edge.phase() = 'before' then beforeedge = edge.id()
    else if edge.phase() = 'partial' then partialedge = edge.id()
    else if edge.phase() = 'after' then afteredge = edge.id()
  end
  failures = failures + check(normaledge > 0 & beforeedge > 0 & partialedge > 0 & afteredge > 0,'parallel normal/before/partial/after identities retained')
  if normaledge > 0 & beforeedge > 0 & partialedge > 0 & afteredge > 0 then do
    value = flow.componenton(normaledge,'r',0,integer); literal = value.literal()
    failures = failures + check(value.known() & literal.index() = 99,'normal successor owns new value')
    value = flow.componenton(beforeedge,'r',0,integer); literal = value.literal()
    failures = failures + check(value.known() & literal.index() = 10,'before-write resumption retains incoming value')
    value = flow.componenton(afteredge,'r',0,integer); literal = value.literal()
    failures = failures + check(value.known() & literal.index() = 99,'after-write resumption sees committed value')
    value = flow.componenton(partialedge,'r',0,integer)
    failures = failures + check(value.known() = 0,'partial write cannot become an exact value')
    value = flow.flagon(partialedge,'r',0,flag); literal = value.literal()
    failures = failures + check(value.known() & literal.index() = 1,'unrelated individual flag survives partial integer write')
    lifetime = flow.lifetimeon(beforeedge,'r',0)
    failures = failures + check(lifetime.state() = 'live','resumed before-write edge retains activation lifetime')
  end
  value = flow.componentat(changed,'r',0,integer); literal = value.literal()
  failures = failures + check(value.known() & literal.index() = 10,'saved predecessor remains intact after all sibling transfers')
  value = flow.componentat(transported,'r',0,integer)
  failures = failures + check(value.known() = 0,'diamond join does not select one sibling value')
  failures = failures + check(flow.entryobservations() = 1,'whole transport alone is not a typed observation')
  if flow.entryobservations() = 1 then do
    witness = flow.entryobservation(1)
    haswitness = 1
    failures = failures + check(witness.operation() = observed & witness.ownedindex() = 1 & witness.activeindex() = 2 & witness.domain() = integer,'transport carries entry provenance to exact observed owned base')
  end
  source0 = flow.storageat(seed,'r',0); source1 = flow.storageat(transported,'r',1); source2 = flow.storageat(transported,'r',2)
  mapped0 = flow.storageat(returned,'r',0); mapped1 = flow.storageat(returned,'r',1); mapped2 = flow.storageat(returned,'r',2)
  failures = failures + check(mapped0.active() = source2.base() & mapped1.active() = source0.base() & mapped2.active() = source1.base(),'overlapping swaps compose in event order')
  failures = failures + check(mapped0.slotidentity() = source2.slotidentity() & mapped1.slotidentity() = source0.slotidentity(),'slot identities move with permutations')
  expired = flow.lifetimeat(renewed,'r',0); lifetime = flow.lifetimeat(returned,'r',0)
  failures = failures + check(expired.state() = 'ended' & lifetime.state() = 'live' & expired.generation() <> lifetime.generation(),'explicit end and begin carry distinct storage lifetime generations')
  do i = 1 to cfg.outedges(returned)
    edge = cfg.outedge(returned,i)
    if edge.role() = 'terminal' then do
      lifetime = flow.lifetimeon(edge.id(),'r',1)
      failures = failures + check(lifetime.state() = 'ended','normal departure expires every owned local base')
      lifetime = flow.lifetimeon(edge.id(),'a',0)
      failures = failures + check(lifetime.state() = 'ended','normal departure expires the frame-owned argument count a0')
    end
  end
  lifetime = flow.lifetimeat(uncertainread,'r',0)
  failures = failures + check(lifetime.state() = 'unknown','unknown active binding cannot prove a lifetime')
  failures = failures + check(flow.complete(target.procedureid('uncertain'),'entry-observation') = 0,'unknown observed binding is incomplete without a speculative warning')
  projection_ref = flow.projection(); projection = dereference projection_ref
  failures = failures + check(projection.status() = 'ok' & projection.complete(target.procedureid('uncertain')) = 0,'unknown observed storage pins liveness instead of becoming an empty access')
  value = flow.componentat(deriveread,'r',0,stringdomain)
  failures = failures + check(value.status() = 'unknown' & flow.complete(target.procedureid('deriver'),'entry-observation') = 0,'cross-component derivation cannot invent a source-domain dependency')
  failures = failures + check(projection.complete(target.procedureid('deriver')) = 0,'missing derivation selector pins liveness rather than reading the destination domain')
  limited = lltargetflow..analyse(reference target,reference profile,reference cfg,1)
  failures = failures + check(limited.status() = 'limit' & limited.entryobservations() = 0,'tiny fuel produces no partial observations')
  prior = flow.componentat(changed,'r',0,integer)
  flow = lltargetflow..analyse(reference target,reference profile,reference cfg)
  status = flow.status()
  failures = failures + check(prior.valid() = 0,'replacing analysis invalidates old value view')
  if haswitness then failures = failures + check(witness.valid() = 0 & stalewitness(witness,'operation') & stalewitness(witness,'origin'),'stale observation getters and provenance reject a replacement owner')
  failures = failures + callavailability('defined') + callavailability('repeated') + callavailability('dirty') + callavailability('join') + callavailability('constant') + callavailability('unknown-observe')
  failures = failures + callavailability('defined',1) + callavailability('dirty',1) + callavailability('constant',1) + callavailability('unknown',1) + callavailability('unknown-observe',1)
  failures = failures + callbackfreetransfer(0) + callbackfreetransfer(1)
  failures = failures + callhookreturn(0) + callhookreturn(1) + callhookreturn(2) + callresultorigins() + aliaslimit() + indexedbudget() + unknownmeet(0) + unknownmeet(1) + summaryrevisit() + summaryworklist(0) + summaryworklist(1) + privatecertificate(0) + privatecertificate(1) + ownedreturn(0) + ownedreturn(1) + ownedreturn(2) + fullresetcount()
  if failures = 0 then say 'TARGET_FLOW|failures=0'
  else say 'TARGET_FLOW|failures=' || failures
  return failures
