/* Fresh compiler flags give count0. The proof intentionally does not fold
 * GETANDTP; retaining this call must still execute normally and print0. */
.globals=0
main() .locals=3
  load r0,5
  getandtp r2,r0,768
  call1 r1,outer(),r2
  itos r1
  say r1
  ret 0
outer() .locals=1
  call r0,zero(),a1
  ret r0
zero() .locals=0
  ret 0
