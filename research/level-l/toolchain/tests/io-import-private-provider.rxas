/* One immutable foreign owner. Aliases of each export share its frame cache. */
.globals=0
owned() .locals=1 .expose=fixture.import.private.owned
  icopy r0,a1
  iadd a1,a1,7
  .srcstep 1 1 0 "io-import-private-provider.rxas" 8 3 8 "  ret r0"
  .traceevent "V" 4 "R" "I" "r" 0 1 1 0 "owned-snapshot" ""
  ret r0

borrowed() .locals=1 .expose=fixture.import.private.borrowed
  link r0,a1
  .srcstep 2 2 0 "io-import-private-provider.rxas" 14 3 8 "  ret r0"
  .traceevent "V" 4 "R" "I" "r" 0 2 2 0 "borrowed-local" ""
  ret r0

recycled() .locals=1 .expose=fixture.import.private.state
  load r0,5
  copy a1,r0
  .srcstep 3 3 0 "io-import-private-provider.rxas" 21 3 14 "  settp r0,256"
  .traceevent "V" 4 "R" "I" "a" 1 3 3 0 "copied-actual" ""
  settp r0,256
  ret a1
