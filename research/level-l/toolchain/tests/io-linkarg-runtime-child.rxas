/* Native mutateTailIndirect's suffix with a runtime-unknown 1..3 selector. */
.globals=0
main() .locals=10
  numsci 18,1,1
  .srcstep 1 1 17 "runtime-child.g" 1 1 31 "result = mutateTailIndirect(ix)"
  load r7,0x00
  load r8,0x00
  bineq r0,r7,0x01
  bineq r6,r8,0x01
  iadd r0,r0,r6
  iadd r0,r0,1
  load r1,10
  load r1,"ten"
  settp r1,256
  load r2,20
  load r2,"twenty"
  settp r2,512
  load r3,30
  load r3,"thirty"
  settp r3,768
  call4 r4,pick(),r0,r1,r2,r3
  .traceevent "F" 4 "R" "O" "r" 4 1 1 0 "pick" ""
  call4 r5,pick(),r0,r1,r2,r3
  icopy r9,r4
  itos r9
  say r9
  icopy r9,r5
  itos r9
  say r9
  say r5
  getandtp r9,r5,768
  itos r9
  say r9
  icopy r9,r1
  itos r9
  say r9
  say r1
  getandtp r9,r1,768
  itos r9
  say r9
  icopy r9,r2
  itos r9
  say r9
  say r2
  getandtp r9,r2,768
  itos r9
  say r9
  icopy r9,r3
  itos r9
  say r9
  say r3
  getandtp r9,r3,768
  itos r9
  say r9
  say "continued"
  ret 0
pick() .locals=5
  numsci 18,1,1
  .meta "pick.which"="b" ".int" a1
  .srcstep 2 2 17 "runtime-child.g" 14 3 31 "return bumpOne(arg[which])"
  icopy r3,a0
  isub r3,r3,1
  ichkrng a1,1,r3
  linkarg r3,a1,1
  .srcstep 3 3 17 "runtime-child.g" 15 3 23 "call selected bumpOne"
  call1 r4,bumpOne(),r3
  unlink r3
  .traceevent "F" 4 "R" "I" "r" 4 3 3 0 "bumpone" ""
  ret r4
  .meta "pick.which"
bumpOne() .locals=1
  numsci 18,1,1
  .meta "bumpOne.value"="b" ".int" a1
  .srcstep 4 4 17 "runtime-child.g" 20 3 17 "value = value + 7"
  .traceevent "V" 6 "R" "I" "a" 1 4 4 0 "value" ""
  iadd a1,a1,7
  .traceevent "O" 4 "R" "I" "a" 1 4 4 0 "" ""
  .traceevent "A" 6 "R" "I" "a" 1 4 4 0 "value" ""
  .srcstep 5 5 17 "runtime-child.g" 21 3 12 "return value"
  .traceevent "V" 6 "R" "I" "a" 1 5 5 0 "value" ""
  ret a1
  .meta "bumpOne.value"
