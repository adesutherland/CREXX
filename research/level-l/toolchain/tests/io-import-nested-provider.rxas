/* One exact exported child is shared by every outer activation.
 * Fixed calls preserve a private snapshot; counted calls preserve a swap
 * and its inverse; the branch calls the child only on its true arm. */
.globals=0
fixed() .locals=2 .expose=fixture.import.nested.fixed
  icopy r0,a1
  .srcstep 1 1 0 "io-import-nested-provider.rxas" 9 3 24 "  call2 r1,child(),a2,a2"
  .traceevent "V" 4 "R" "I" "a" 2 1 1 0 "fixed-child" ""
  call2 r1,child(),a2,a2
  iadd r0,r0,r1
  ret r0
counted() .locals=1 .expose=fixture.import.nested.counted
  load a0,2
  swap a1,a2
  .srcstep 2 2 0 "io-import-nested-provider.rxas" 17 3 20 "  call r0,child(),a0"
  .traceevent "V" 4 "R" "I" "a" 1 2 2 0 "counted-child" ""
  call r0,child(),a0
  swap a1,a2
  ret r0
branched() .locals=2 .expose=fixture.import.nested.branched
  null r0
  null r1
  icopy r0,a2
  brtf mutate,done,a1
mutate:
  .srcstep 3 3 0 "io-import-nested-provider.rxas" 28 3 24 "  call2 r1,child(),a2,a2"
  .traceevent "V" 4 "R" "I" "a" 2 3 3 0 "branched-child" ""
  call2 r1,child(),a2,a2
  iadd r0,r0,r1
done:
  ret r0
child() .locals=0 .expose=fixture.import.nested.child
  iadd a1,a1,7
  ret a2
decoy() .locals=0 .expose=fixture.import.nested.other
  ret a1
