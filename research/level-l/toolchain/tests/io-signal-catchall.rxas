/* Complete unbound G-shaped scope in the compiler's 29-name order.
 * The runner varies the scalar producer and injects pending signals only
 * after expansion, at paired original/transformed instruction boundaries. */
.globals=0
main() .locals=4
  .srcstep 1 1 17 "catchall.g" 1 1 35 "result = checked_identity(value)"
  settp r3,0
  getandtp r0,r3,256
  load r1,99
  load r2,0
  sigpush "FAILURE"
  sigpush "ERROR"
  sigpush "OVERFLOW_UNDERFLOW"
  sigpush "DIVISION_BY_ZERO"
  sigpush "CONVERSION_ERROR"
  sigpush "INVALID_ARGUMENTS"
  sigpush "OUT_OF_RANGE"
  sigpush "UNICODE_ERROR"
  sigpush "REFERENCE_INVALID"
  sigpush "OBJECT_NOT_INITIALIZED"
  sigpush "RXBIN_CORRUPTION"
  sigpush "UNKNOWN_INSTRUCTION"
  sigpush "FUNCTION_NOT_FOUND"
  sigpush "NOT_IMPLEMENTED"
  sigpush "INVALID_SIGNAL_CODE"
  sigpush "NOTREADY"
  sigpush "CANCEL"
  sigpush "QUIT"
  sigpush "TERM"
  sigpush "POSIX_INT"
  sigpush "POSIX_HUP"
  sigpush "POSIX_USR1"
  sigpush "POSIX_USR2"
  sigpush "POSIX_CHLD"
  sigpush "CHANNEL_ERROR"
  sigpush "TASK_FAILURE"
  sigpush "CLASSIC_SYNTAX"
  sigpush "CLASSIC_CONDITION"
  sigpush "OTHER"
  sigbr caught,"FAILURE"
  sigbr caught,"ERROR"
  sigbr caught,"OVERFLOW_UNDERFLOW"
  sigbr caught,"DIVISION_BY_ZERO"
  sigbr caught,"CONVERSION_ERROR"
  sigbr caught,"INVALID_ARGUMENTS"
  sigbr caught,"OUT_OF_RANGE"
  sigbr caught,"UNICODE_ERROR"
  sigbr caught,"REFERENCE_INVALID"
  sigbr caught,"OBJECT_NOT_INITIALIZED"
  sigbr caught,"RXBIN_CORRUPTION"
  sigbr caught,"UNKNOWN_INSTRUCTION"
  sigbr caught,"FUNCTION_NOT_FOUND"
  sigbr caught,"NOT_IMPLEMENTED"
  sigbr caught,"INVALID_SIGNAL_CODE"
  sigbr caught,"NOTREADY"
  sigbr caught,"CANCEL"
  sigbr caught,"QUIT"
  sigbr caught,"TERM"
  sigbr caught,"POSIX_INT"
  sigbr caught,"POSIX_HUP"
  sigbr caught,"POSIX_USR1"
  sigbr caught,"POSIX_USR2"
  sigbr caught,"POSIX_CHLD"
  sigbr caught,"CHANNEL_ERROR"
  sigbr caught,"TASK_FAILURE"
  sigbr caught,"CLASSIC_SYNTAX"
  sigbr caught,"CLASSIC_CONDITION"
  sigbr caught,"OTHER"
  call1 r1,checked_identity(),r0
  .traceevent "F" 4 "R" "I" "r" 1 1 1 0 "checked_identity" ""
  load r2,1
  say "normal"
  sigpop "OTHER"
  sigpop "CLASSIC_CONDITION"
  sigpop "CLASSIC_SYNTAX"
  sigpop "TASK_FAILURE"
  sigpop "CHANNEL_ERROR"
  sigpop "POSIX_CHLD"
  sigpop "POSIX_USR2"
  sigpop "POSIX_USR1"
  sigpop "POSIX_HUP"
  sigpop "POSIX_INT"
  sigpop "TERM"
  sigpop "QUIT"
  sigpop "CANCEL"
  sigpop "NOTREADY"
  sigpop "INVALID_SIGNAL_CODE"
  sigpop "NOT_IMPLEMENTED"
  sigpop "FUNCTION_NOT_FOUND"
  sigpop "UNKNOWN_INSTRUCTION"
  sigpop "RXBIN_CORRUPTION"
  sigpop "OBJECT_NOT_INITIALIZED"
  sigpop "REFERENCE_INVALID"
  sigpop "UNICODE_ERROR"
  sigpop "OUT_OF_RANGE"
  sigpop "INVALID_ARGUMENTS"
  sigpop "CONVERSION_ERROR"
  sigpop "DIVISION_BY_ZERO"
  sigpop "OVERFLOW_UNDERFLOW"
  sigpop "ERROR"
  sigpop "FAILURE"
  br joined
caught:
  sigpop "OTHER"
  sigpop "CLASSIC_CONDITION"
  sigpop "CLASSIC_SYNTAX"
  sigpop "TASK_FAILURE"
  sigpop "CHANNEL_ERROR"
  sigpop "POSIX_CHLD"
  sigpop "POSIX_USR2"
  sigpop "POSIX_USR1"
  sigpop "POSIX_HUP"
  sigpop "POSIX_INT"
  sigpop "TERM"
  sigpop "QUIT"
  sigpop "CANCEL"
  sigpop "NOTREADY"
  sigpop "INVALID_SIGNAL_CODE"
  sigpop "NOT_IMPLEMENTED"
  sigpop "FUNCTION_NOT_FOUND"
  sigpop "UNKNOWN_INSTRUCTION"
  sigpop "RXBIN_CORRUPTION"
  sigpop "OBJECT_NOT_INITIALIZED"
  sigpop "REFERENCE_INVALID"
  sigpop "UNICODE_ERROR"
  sigpop "OUT_OF_RANGE"
  sigpop "INVALID_ARGUMENTS"
  sigpop "CONVERSION_ERROR"
  sigpop "DIVISION_BY_ZERO"
  sigpop "OVERFLOW_UNDERFLOW"
  sigpop "ERROR"
  sigpop "FAILURE"
  load r2,2
  say "handler"
  br joined
joined:
  itos r0
  say r0
  itos r1
  say r1
  itos r2
  say r2
  ret 0
checked_identity() .locals=0
  .meta "checked_identity.value"="b" ".int" a1
  .srcstep 2 2 17 "catchall.g" 8 3 29 "assembler ichkrng value,-5,5"
  ichkrng a1,-5,5
  .srcstep 3 3 17 "catchall.g" 9 3 14 "return value"
  ret a1
  .meta "checked_identity.value"
