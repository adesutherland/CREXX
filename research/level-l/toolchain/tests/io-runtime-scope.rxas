/* Unknown selector and branch facts; every scope names stable private r1. */
.globals=0
main() .locals=10
  load r7,0x00
  load r8,0x00
  bineq r0,r7,0x01
  bineq r6,r8,0x01
  iadd r0,r0,r6
  iadd r0,r0,1
  load r1,10
  load r1,"ten"
  settp r1,256
  load r2,20
  load r2,"twenty"
  settp r2,512
  load r3,30
  load r3,"thirty"
  settp r3,768
  .srcstep 3 3 17 "scoped-caller.rxas" 3 1 21 "result = helper(flag)"
  call4 r4,helper(),r0,r1,r2,r3
  .traceevent "F" 4 "R" "O" "r" 4 3 3 0 "helper" ""
  call4 r5,helper(),r0,r1,r2,r3
  .traceevent "F" 4 "R" "O" "r" 5 3 3 0 "helper" ""
  itos r4
  say r4
  icopy r9,r5
  itos r9
  say r9
  say r5
  getandtp r9,r5,768
  itos r9
  say r9
  icopy r9,r1
  itos r9
  say r9
  ret 0
helper() .locals=5
  .srcstep 20 20 17 "runtime-scope.rxas" 20 1 7 "checked"
  icopy r3,a0
  isub r3,r3,1
  ichkrng a1,1,r3
  linkarg r3,a1,1
  null r1
  isub r1,r3,10
  brf add7,r1
  iadd r3,r3,9
  br joined
skipped:
  .meta "scope.hidden"="b" ".int" r1
  cnop
add7:
  .meta "scope.left"="b" ".int" r1
  iadd r3,r3,7
joined:
  .meta "scope.right"="b" ".int" r1
  .srcstep 2 2 17 "runtime-scope.rxas" 2 1 11 "return item"
  copy r4,r3
  unlink r3
  ret r4
  .meta "scope.left"
  .meta "scope.hidden"
  .meta "scope.right"
