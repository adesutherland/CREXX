cmake_minimum_required(VERSION 3.24)
foreach(_name VM CLI WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")

# Three distinct unavailable sites exercise complete multi-site reporting.
# The remaining calls cover dynamic selection, an SCC and ordinary proof.
# The reporter's uncapped site loops are reviewed directly; this fixture is
# deliberately small enough to qualify diagnostics without stressing flow.
set(_source "missing() .expose=fixture.missing\nmain() .locals=5\n")
foreach(_site RANGE 1 3)
  string(APPEND _source "call missing()\n")
endforeach()
# Use the source-visible RRR form in tests/rxas_optimizer/barrier_dcall.rxas.
# A known zero count avoids an unrelated unbounded argument-window premise.
string(APPEND _source "load r3,0\nload r4,0\ndcall r0,r3,r4\ncall recursive()\ncall leaf()\nret 0\nrecursive() .locals=0\ncall recursive()\nret\nleaf() .locals=0\nret 7\n")
set(_input "${WORK}/kept.rxas")
set(_output "${WORK}/kept-output.rxas")
file(WRITE "${_input}" "${_source}")
execute_process(COMMAND "${VM}" "${CLI}" ${RUNTIME} -a
  --module "keep \"quoted\"" --no-cleanup --work 12000000
  -o "${_output}" "${_input}"
  RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 90)
if(NOT _status EQUAL 0)
  message(FATAL_ERROR "KEEP diagnostic fixture failed: ${_status}\n${_stdout}${_stderr}")
endif()
string(REGEX MATCHALL "LL_INLINE_KEEP:[^\r\n]*" _records "${_stderr}")
set(_missing 0)
set(_dynamic OFF)
set(_recursive OFF)
set(_recursive_caller OFF)
set(_ordinary OFF)
set(_missing_ids "")
set(_spans "")
foreach(_record IN LISTS _records)
  if(_record MATCHES "^LL_INLINE_KEEP: signal[.]" AND NOT _record MATCHES "category=proof layer=signal ")
    message(FATAL_ERROR "Signal proof reason lost its diagnostic namespace: ${_record}")
  endif()
  string(FIND "${_record}" [=[module="keep \"quoted\""]=] _module)
  string(FIND "${_record}" [=[source="keep \"quoted\""]=] _source_name)
  if(_module LESS 0 OR _source_name LESS 0 OR NOT _record MATCHES "scope=call owner=[1-9][0-9]*"
      OR NOT _record MATCHES "call=([1-9][0-9]*)")
    message(FATAL_ERROR "KEEP record lost its escaped exact caller owner/site: ${_record}")
  endif()
  set(_callid "${CMAKE_MATCH_1}")
  if(NOT _record MATCHES "bytes=([0-9]+):([0-9]+)")
    message(FATAL_ERROR "KEEP record lost its input source byte span: ${_record}")
  endif()
  set(_first "${CMAKE_MATCH_1}")
  set(_last "${CMAKE_MATCH_2}")
  list(APPEND _spans "${_first}:${_last}")
  if(_last LESS_EQUAL _first)
    message(FATAL_ERROR "KEEP record has an empty/reversed source span: ${_record}")
  endif()
  math(EXPR _length "${_last} - ${_first}")
  string(SUBSTRING "${_source}" ${_first} ${_length} _fragment)
  string(FIND "${_record}" "LL_INLINE_KEEP: unavailable exact body missing " _unavailable)
  if(_unavailable EQUAL 0)
    if(NOT _record MATCHES "category=availability layer=binding"
        OR NOT _record MATCHES "procedure=\"main\"" OR NOT _record MATCHES "target=\"missing\""
        OR NOT _fragment MATCHES "^call missing\\(\\)")
      message(FATAL_ERROR "Unavailable-body record names the wrong call or layer: ${_record}\n${_fragment}")
    endif()
    math(EXPR _missing "${_missing} + 1")
    list(APPEND _missing_ids "${_callid}")
  elseif(_record MATCHES "^LL_INLINE_KEEP: target[.]selection[.]authority[.]unavailable ")
    if(NOT _record MATCHES "category=availability layer=selection" OR NOT _fragment MATCHES "^dcall ")
      message(FATAL_ERROR "Dynamic selection record lost its proof boundary: ${_record}")
    endif()
    set(_dynamic ON)
  elseif(_record MATCHES "^LL_INLINE_KEEP: policy[.]recursive[.]scc ")
    if(NOT _record MATCHES "category=policy layer=selection" OR NOT _record MATCHES "procedure=\"recursive\"")
      message(FATAL_ERROR "Recursive SCC record names the wrong policy/site: ${_record}")
    endif()
    set(_recursive ON)
  elseif(_record MATCHES "target=\"leaf\"")
    if(NOT _record MATCHES "category=proof layer=[^ ]+" OR NOT _fragment MATCHES "^call leaf\\(\\)")
      message(FATAL_ERROR "Ordinary refusal lost its exact proof/site context: ${_record}")
    endif()
    set(_ordinary ON)
  elseif(_record MATCHES "target=\"recursive\"" AND _record MATCHES "procedure=\"main\"")
    if(NOT _record MATCHES "category=proof layer=[^ ]+" OR NOT _fragment MATCHES "^call recursive\\(\\)")
      message(FATAL_ERROR "Call into recursive provider lost its proof/site context: ${_record}")
    endif()
    set(_recursive_caller ON)
  else()
    message(FATAL_ERROR "Unexpected retained-site diagnostic: ${_record}")
  endif()
endforeach()
list(REMOVE_DUPLICATES _missing_ids)
list(LENGTH _missing_ids _distinct_missing)
list(LENGTH _records _reported)
list(REMOVE_DUPLICATES _spans)
list(LENGTH _spans _distinct_spans)
if(NOT _missing EQUAL 3 OR NOT _distinct_missing EQUAL 3 OR NOT _dynamic OR NOT _recursive
    OR NOT _recursive_caller OR NOT _ordinary OR NOT _reported EQUAL 7 OR NOT _distinct_spans EQUAL 7)
  message(FATAL_ERROR "KEEP diagnostics omitted a retained site or refusal class: ${_missing}/${_distinct_missing}/${_dynamic}/${_recursive}/${_ordinary}\n${_stderr}")
endif()
file(READ "${_output}" _rendered)
if(_rendered MATCHES "LL_INLINE_KEEP|category=|layer=")
  message(FATAL_ERROR "CLI explanation leaked into executable RXAS metadata")
endif()

# Display truncation is reviewed at keepfield's pre-escape bound. This
# executable fixture uses accepted short names to reach the actual reporter.
message("RXAS_KEEP_DIAGNOSTICS|failures=0")
