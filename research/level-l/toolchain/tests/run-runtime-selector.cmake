cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER CLI FIXTURES WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
include("${FIXTURES}/signal-pair-helpers.cmake")
if(DEFINED CONSTRUCTED)
  execute_process(COMMAND "${VM}" "${CONSTRUCTED}" -a runtime
    RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 180)
  if(NOT _status EQUAL 0 OR NOT _stdout MATCHES "RUNTIME_SELECTOR[|]failures=0")
    message(FATAL_ERROR "Constructed runtime selector: ${_status}\n${_stdout}${_stderr}")
  endif()
endif()
file(READ "${FIXTURES}/io-linkarg-runtime.rxas" _fixture)
foreach(_case first middle last swap repeated result-alias selector-alias zero high owned no-prior-step empty-source cleanup)
  set(_original "${_fixture}")
  set(_value 10)
  set(_text ten)
  set(_status 256)
  set(_actuals "10\n20\n30")
  if(_case STREQUAL "middle" OR _case STREQUAL "swap" OR _case STREQUAL "repeated" OR _case STREQUAL "result-alias")
    string(REPLACE "load r7,0x00" "load r7,0x01" _original "${_original}")
    set(_value 20)
    set(_text twenty)
    set(_status 512)
  elseif(_case STREQUAL "last")
    string(REPLACE "load r7,0x00" "load r7,0x01" _original "${_original}")
    string(REPLACE "load r8,0x00" "load r8,0x01" _original "${_original}")
    set(_value 30)
    set(_text thirty)
    set(_status 768)
  endif()
  if(_case STREQUAL "swap")
    string(REPLACE "  icopy r1,a0" "  swap a2,a3\n  icopy r1,a0" _original "${_original}")
    set(_value 10)
    set(_text ten)
    set(_status 256)
  elseif(_case STREQUAL "repeated")
    string(REPLACE "pick(),r0,r1,r2,r3" "pick(),r0,r1,r1,r3" _original "${_original}")
    set(_value 10)
    set(_text ten)
    set(_status 256)
  elseif(_case STREQUAL "result-alias")
    string(REPLACE "call4 r4,pick()" "call4 r2,pick()" _original "${_original}")
    string(REPLACE "\"r\" 4 1 1 0 \"pick\"" "\"r\" 2 1 1 0 \"pick\"" _original "${_original}")
    string(REPLACE "  itos r4\n  say r4" "  icopy r9,r2\n  itos r9\n  say r9" _original "${_original}")
  elseif(_case STREQUAL "selector-alias")
    string(REPLACE "  icopy r1,a0" "  icopy r0,a1\n  icopy r1,a0" _original "${_original}")
    string(REPLACE "ichkrng a1,1,r1\n  linkarg r0,a1,1" "ichkrng r0,1,r1\n  linkarg r0,r0,1" _original "${_original}")
  elseif(_case STREQUAL "zero")
    string(REPLACE "  ichkrng a1,1,r1" "  load a0,77\n  ichkrng a1,1,r1" _original "${_original}")
    string(REPLACE "linkarg r0,a1,1" "linkarg r0,a1,-1" _original "${_original}")
    set(_value 77)
    set(_text "")
    set(_status 0)
  elseif(_case STREQUAL "high")
    string(REPLACE "iadd r0,r0,1" "getandtp r0,r6,768" _original "${_original}")
    string(REPLACE "ichkrng a1,1,r1" "ichkrng a1,9223372036854775805,9223372036854775807" _original "${_original}")
    string(REPLACE "linkarg r0,a1,1" "linkarg r0,a1,-9223372036854775805" _original "${_original}")
    set(_value 10)
    set(_text ten)
    set(_status 256)
  elseif(_case STREQUAL "owned")
    string(REPLACE "  icopy r1,a0" "  null r0\n  load r0,44\n  link a2,r0\n  link a3,r0\n  link a4,r0\n  icopy r1,a0" _original "${_original}")
    set(_value 44)
    set(_text "")
    set(_status 0)
  elseif(_case STREQUAL "no-prior-step" OR _case STREQUAL "empty-source")
    string(REPLACE "  .srcstep 2 2 17 \"runtime-selector.g\" 14 3 23 \"assembler checked pick\"\n" "" _original "${_original}")
    if(_case STREQUAL "empty-source")
      string(REPLACE "  .srcstep 1 1 17 \"runtime-selector.g\" 1 1 18 \"result = pick(ix)\"\n" "" _original "${_original}")
    endif()
  endif()
  set(_source "${WORK}/runtime-${_case}.rxas")
  set(_output "${WORK}/runtime-${_case}-expanded.rxas")
  file(WRITE "${_source}" "${_original}")
  set(_options --no-cleanup)
  if(_case STREQUAL "cleanup")
    set(_options)
  endif()
  run_checked("expand runtime ${_case}" "${VM}" "${CLI}" ${RUNTIME} -a
    --module runtime.rxas --profile closed-main-default-halt.v1 --work 12000000
    ${_options} -o "${_output}" "${_source}")
  file(READ "${_output}" _expanded)
  string(FIND "${_expanded}" "pick() .locals" _callee)
  string(SUBSTRING "${_expanded}" 0 ${_callee} _main)
  if(_main MATCHES "(^|\n)[ \t]*(call[1-4]?|linkarg)[ \t]")
    message(FATAL_ERROR "Runtime dispatch retained its call/index or moved borrowed storage")
  endif()
  string(REGEX MATCHALL "(^|\n)[ \t]*move " _moves "${_main}")
  list(LENGTH _moves _move_count)
  if((_case STREQUAL "owned" AND NOT _move_count EQUAL 6) OR (NOT _case STREQUAL "owned" AND NOT _move_count EQUAL 0))
    message(FATAL_ERROR "Runtime arm return lost its exact owned/borrowed action")
  endif()
  string(REGEX MATCHALL "ichkrng " _guards "${_main}")
  string(REGEX MATCHALL "brf " _branches "${_main}")
  string(REGEX MATCHALL "copy " _copies "${_main}")
  list(LENGTH _guards _guard_count)
  list(LENGTH _branches _branch_count)
  if(NOT _guard_count EQUAL 2 OR NOT _branch_count EQUAL 4)
    message(FATAL_ERROR "Runtime selector must retain one check and two dispatch tests per call")
  endif()
  if(NOT _case STREQUAL "empty-source" AND NOT _main MATCHES "[.]srcstep 1 1 17 \"runtime-selector[.]g\" 1 1 18 \"result = pick[(]ix[)]\"\n([ \t]*[.]meta[^\n]*\n)*[ \t]*(cnop\n[ \t]*)?[.]traceevent")
    message(FATAL_ERROR "Runtime continuation did not restore its caller source before TRACE")
  endif()
  # Each test reads the same captured selector, not the previous difference.
  string(REGEX MATCHALL "isub (r[0-9]+),(r[0-9]+),-?[0-9]+\n[ \t]*brf [^,\n]+,r[0-9]+" _dispatches "${_main}")
  list(LENGTH _dispatches _dispatch_count)
  if(NOT _dispatch_count EQUAL 4)
    message(FATAL_ERROR "Runtime selector lost its finite scalar dispatch")
  endif()
  foreach(_dispatch IN LISTS _dispatches)
    string(REGEX MATCH "isub (r[0-9]+),(r[0-9]+)," _match "${_dispatch}")
    if(CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Runtime comparison overwrote the captured selector")
    endif()
  endforeach()
  if(_case STREQUAL "high")
    # Deliberate paired post-pass injection reaches INT_MAX's third arm while
    # the source facts still treated the producer as a runtime unknown.
    string(REPLACE "getandtp r0,r6,768" "load r0,9223372036854775807" _original "${_original}")
    string(REPLACE "getandtp r0,r6,768" "load r0,9223372036854775807" _expanded "${_expanded}")
  endif()
  bound_pair("runtime-${_case}" "${_original}" "${_expanded}" "${_value}\n${_value}\n${_text}\n${_status}\n${_actuals}\ncontinued")
endforeach()

# The exact authored check owns failure; it remains before every new branch,
# with the same logical source, and cannot commit a result or continue.
file(READ "${WORK}/runtime-first.rxas" _original)
file(READ "${WORK}/runtime-first-expanded.rxas" _expanded)
foreach(_kind original expanded)
  string(REPLACE "iadd r0,r0,1" "load r0,99" _injected "${_${_kind}}")
  set(_product "${WORK}/runtime-failure-${_kind}")
  file(WRITE "${_product}.rxas" "${_injected}")
  run_checked("assemble runtime failure ${_kind}" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
  execute_process(COMMAND "${VM}" "${_product}.rxbin" RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 15)
  if(NOT _status MATCHES "^[1-9][0-9]*$" OR NOT _stderr MATCHES "SIGNAL OUT_OF_RANGE[)]" OR NOT _stderr MATCHES "runtime-selector.g" OR NOT _stderr MATCHES "assembler checked pick" OR _stdout MATCHES "continued")
    message(FATAL_ERROR "Runtime authored failure changed: ${_status}\n${_stdout}${_stderr}")
  endif()
endforeach()

foreach(_case unguarded wide bank changed unknown-bound suffix resumable)
  set(_source "${_fixture}")
  set(_reason argument.selector.unproved)
  if(_case STREQUAL "unguarded")
    string(REPLACE "  ichkrng a1,1,r1\n" "" _source "${_source}")
  elseif(_case STREQUAL "wide")
    string(REPLACE "iadd r0,r0,1" "getandtp r0,r6,768" _source "${_source}")
    string(REPLACE "ichkrng a1,1,r1" "ichkrng a1,1,4" _source "${_source}")
    set(_reason argument.selector.width.policy)
  elseif(_case STREQUAL "bank")
    string(REPLACE "linkarg r0,a1,1" "linkarg r0,a1,3" _source "${_source}")
    set(_reason argument.selector.bank.unproved)
  elseif(_case STREQUAL "changed")
    string(REPLACE "linkarg r0,a1,1" "linkarg r0,a2,1" _source "${_source}")
    set(_reason argument.selector.guard.unproved)
  elseif(_case STREQUAL "unknown-bound")
    string(REPLACE "  load r1,10" "  getandtp r1,r6,768\n  load r1,10" _source "${_source}")
    string(REPLACE "ichkrng a1,1,r1" "ichkrng a1,1,a1" _source "${_source}")
    set(_reason argument.range.unproved)
  elseif(_case STREQUAL "suffix")
    string(REPLACE "  ret r0" "  load r0,99\n  ret r0" _source "${_source}")
    set(_reason argument.selector.suffix.pending)
  else()
    string(REPLACE "  load r7,0x00" "  sigignore \"OUT_OF_RANGE\"\n  load r7,0x00" _source "${_source}")
    set(_reason signal.caller.policy.pending)
  endif()
  set(_input "${WORK}/runtime-${_case}-keep.rxas")
  set(_output "${WORK}/runtime-${_case}-kept.rxas")
  file(WRITE "${_input}" "${_source}")
  run_checked("retain runtime ${_case}" "${VM}" "${CLI}" ${RUNTIME} -a --module runtime.rxas
    --profile closed-main-default-halt.v1 --no-cleanup --work 12000000 -o "${_output}" "${_input}")
  file(READ "${_output}" _kept)
  if(NOT _last_stderr MATCHES "${_reason}" OR NOT _kept MATCHES "call4 r4,pick[(][)]")
    message(FATAL_ERROR "Runtime ${_case} lost precise refusal: ${_last_stderr}")
  endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
message("RXAS_RUNTIME_SELECTOR|failures=0")
