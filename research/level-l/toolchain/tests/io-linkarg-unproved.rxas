/* Facts intentionally do not fold GETANDTP. Its fresh flag band is0, so the
 * runtime selector0 selects a0=1 and the unchanged helper returns1. */
.globals=0
main() .locals=3
  load r0,5
  getandtp r2,r0,768
  call1 r1,selectunknown(),r2
  itos r1
  say r1
  ret 0
selectunknown() .locals=1
  linkarg r0,a1,0
  ret r0
