/* Independent ordered values, aliased status, snapshots and zero-count results. */
.globals=0
main() .locals=14
  load r0,1
  load r1,10
  load r2,2
invoke:
  .srcstep 1 1 0 "io-fused.rxas" 1 0 10 "fused call"
  .traceevent "V" 4 "R" "I" "r" 0 1 1 0 "count" ""
  swapcall r0,sum(),r0,r0,r2
  swap r0,r2
  icopy r12,r0
  itos r12
  say r12
  icopy r12,r1
  itos r12
  say r12
  icopy r12,r2
  itos r12
  say r12
  load r0,1
  load r1,10
  load r2,2
  link r3,r0
  settpswapcall r0,sum(),r0,r0,256,r2
  swap r0,r2
  getandtp r11,r0,768
  itos r11
  say r11
  getandtp r11,r3,768
  itos r11
  say r11
  getandtp r11,r2,768
  itos r11
  say r11
  unlink r3
  load r0,2
  load r1,7
  link r2,r1
  settpcall r4,snapshot(),r0,r1,256
  icopy r12,r4
  itos r12
  say r12
  icopy r12,r1
  itos r12
  say r12
  settpcall r4,snapshot(),r0,r1,256
  icopy r12,r4
  itos r12
  say r12
  icopy r12,r2
  itos r12
  say r12
  unlink r2
  load r0,2
  load r1,7
  load r2,3
  swapcall r4,sum(),r0,r1,r1
  icopy r12,r4
  itos r12
  say r12
  load r0,0
  load r4,77
  settpcall r4,bare(),r0,r1,0
  icopy r12,r4
  itos r12
  say r12
  settp r1,2162688
  settp r1,1024
  settpcall r4,bare(),r0,r1,4294967552
  getandtp r11,r1,2147483392
  itos r11
  say r11
  settpcall r4,bare(),r0,r1,0
  getandtp r11,r1,2147483392
  itos r11
  say r11
  settp r1,2162688
  settpcall r4,bare(),r0,r1,4294967296
  getandtp r11,r1,2147483392
  itos r11
  say r11
  ret 0
sum() .locals=1
  iadd r0,a1,a2
  ret r0
snapshot() .locals=1
  icopy r0,a1
  iadd a2,a2,1
  ret r0
bare() .locals=0
  ret
