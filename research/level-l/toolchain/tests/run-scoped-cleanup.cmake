cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER CLI FIXTURES WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
include("${FIXTURES}/signal-pair-helpers.cmake")

function(scoped_execute _stem _source _expected)
  set(_product "${WORK}/${_stem}")
  file(WRITE "${_product}.rxas" "${_source}")
  run_checked("assemble ${_stem}" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
  run_checked("execute ${_stem}" "${VM}" "${_product}.rxbin")
  expect_output("${_expected}")
endfunction()

foreach(_case cleanup snapshot repeated dirty proxy type)
  set(_input "${FIXTURES}/io-scoped-${_case}.rxas")
  file(READ "${_input}" _original)
  if(_case STREQUAL cleanup)
    set(_expected "23\n11\n23")
    set(_callee first)
  elseif(_case STREQUAL snapshot)
    set(_expected "11\n99")
    set(_callee snapshot)
  elseif(_case STREQUAL repeated)
    set(_expected "99")
    set(_callee snapshot)
  elseif(_case STREQUAL proxy)
    set(_expected "11\n11\n23")
    set(_callee proxy)
  elseif(_case STREQUAL type)
    set(_expected "type-ok")
    set(_callee leaf)
  else()
    set(_expected "0")
    set(_callee snapshot)
  endif()
  if(NOT _case STREQUAL dirty)
    scoped_execute("${_case}-original" "${_original}" "${_expected}")
  endif()
  foreach(_mode conservative cleaned)
    set(_option "")
    if(_mode STREQUAL conservative)
      set(_option --no-cleanup)
    endif()
    set(_product "${WORK}/${_case}-${_mode}")
    run_checked("expand scoped ${_case} ${_mode}" "${VM}" "${CLI}" ${RUNTIME} -a
      --module "scoped-${_case}.rxas" --profile closed-main-default-halt.v1
      ${_option} -o "${_product}.rxas" "${_input}")
    if(_last_stderr MATCHES "LL_(CLEANUP|STORAGE)_FAILED:")
      message(FATAL_ERROR "Scoped ${_case} reported internal cleanup failure: ${_last_stderr}")
    endif()
    if(_case STREQUAL dirty AND NOT _last_stderr MATCHES "LL_RXAS_ENTRY_READ")
      message(FATAL_ERROR "Distinct dirty actual lacks its owned-entry diagnostic")
    endif()
    file(READ "${_product}.rxas" _expanded)
    string(FIND "${_expanded}" "${_callee}() .locals=" _end)
    if(_end LESS 0)
      message(FATAL_ERROR "Scoped ${_case} lost its retained definition")
    endif()
    string(SUBSTRING "${_expanded}" 0 ${_end} _caller)
    if(_caller MATCHES "(^|\n)[ \t]*call[1234]?[ \t]")
      message(FATAL_ERROR "Scoped ${_case} ${_mode} retained its selected call")
    endif()
    string(REGEX MATCHALL "(^|\n)[ \t]*inlenter[ \t]" _entries "${_caller}")
    list(LENGTH _entries _entry_count)
    if(NOT _entry_count EQUAL 1)
      message(FATAL_ERROR "Scoped ${_case} ${_mode} must retain one logical activation")
    endif()
    if(_case STREQUAL cleanup)
      if(_mode STREQUAL cleaned AND _caller MATCHES "(^|\n)[ \t]*swap[ \t]")
        message(FATAL_ERROR "Explicit reordered leaf retained an outer permutation")
      endif()
      string(REGEX MATCH "load r([0-9]+),23([\r\n]|$)" _load "${_caller}")
      set(_actual_register "${CMAKE_MATCH_1}")
      string(REGEX MATCH "[.]traceevent \"V\" 4 \"R\" \"I\" \"r\" ([0-9]+) 0 0 0 \"y\" \"\"" _trace "${_caller}")
      if(NOT _load OR NOT _trace)
        message(FATAL_ERROR "Scoped reordered leaf lost its authored value or TRACE")
      endif()
      if(_mode STREQUAL cleaned AND NOT CMAKE_MATCH_1 STREQUAL _actual_register)
        message(FATAL_ERROR "Scoped cleanup remapped TRACE away from its actual storage")
      endif()
    elseif(_case STREQUAL type)
      string(REGEX MATCHALL "(^|\n)[ \t]*setobjtype[ \t]" _types "${_caller}")
      list(LENGTH _types _type_count)
      if(NOT _type_count EQUAL 2 OR NOT _caller MATCHES "(^|\n)[ \t]*acopy[ \t]" OR NOT _caller MATCHES "(^|\n)[ \t]*asserttype[ \t]")
        message(FATAL_ERROR "Status-only ACOPY lost an independently live object-type assignment")
      endif()
    elseif(_case STREQUAL proxy)
      if(_mode STREQUAL cleaned)
        string(REGEX MATCHALL "(^|\n)[ \t]*swap[ \t]" _swaps "${_caller}")
        list(LENGTH _swaps _swap_count)
        if(NOT _swap_count EQUAL 1)
          message(FATAL_ERROR "Proxy cleanup must retain the body swap and remove both outer permutations")
        endif()
        string(REGEX MATCH "proxies=\\(r([0-9]+):1" _proxy "${_caller}")
        set(_proxy_register "${CMAKE_MATCH_1}")
        if(NOT _proxy OR NOT _caller MATCHES "(^|\n)[ \t]*ret r${_proxy_register}([\r\n]|$)")
          message(FATAL_ERROR "Proxy return lost its physical borrowed slot")
        endif()
        if(_caller MATCHES "(^|\n)[ \t]*ret r[01]([\r\n]|$)")
          message(FATAL_ERROR "Proxy return was incorrectly rewritten to a caller backing slot")
        endif()
      endif()
    elseif(_case STREQUAL snapshot)
      string(REGEX MATCHALL "(^|\n)[ \t]*copy[ \t]" _copies "${_caller}")
      list(LENGTH _copies _copy_count)
      if(_copy_count LESS 1)
        message(FATAL_ERROR "Scoped snapshot lost its required authored value copy")
      endif()
    endif()
    scoped_execute("${_case}-${_mode}-executed" "${_expanded}" "${_expected}")
  endforeach()
endforeach()

file(REMOVE_RECURSE "${WORK}")
message("RXAS_SCOPED_CLEANUP|failures=0")
