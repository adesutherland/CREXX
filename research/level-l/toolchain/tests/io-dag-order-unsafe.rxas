/* TEST-ONLY COUNTEREXAMPLE, never an allowed product rewrite. Sharing the
 * two reverse-order temporaries with a lexical-arrival NULL before11 leaves
 * status256 on the later22. The deliberately wrong output is11/256/22/256. */
.globals=0
main() .locals=6
  br unsafe_first
unsafe_second:
  load r3,22
  copy r1,r3
  br unsafe_done
unsafe_first:
  null r3
  load r3,11
  settp r3,256
  copy r0,r3
  br unsafe_second
unsafe_done:
  getandtp r4,r0,768
  getandtp r5,r1,768
  itos r0
  say r0
  itos r4
  say r4
  itos r1
  say r1
  itos r5
  say r5
  ret 0
