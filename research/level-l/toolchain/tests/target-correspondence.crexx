/* cREXX License (MIT). Independent exact event/footprint correspondence client. */
options levelb
import rxfnsb
import llir
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetremap
import llrxascatalog

check: procedure = .int
  arg condition = .int, label = .string
  if condition then return 0
  say 'FAIL:' || label; return 1

sample: procedure = .lltarget..module
  arg candidate = .int, mode = .int, expose callbackid = .int
  ignored = .int
  draft = .lltarget..draft('normalization.preservation','fixture:normalization.preservation',0)
  at = draft.synthetic('entry delta is disjoint from the exact callback projection')
  root = draft.procedure('main',3,at); fields = .object[]
  if candidate then do
    index = 1; if mode = 1 then index = 0
    fields[1] = root.reg('r',index) as .object; ignored = root.emit('null',fields,at)
  end
  fields[1] = root.reg('r',0) as .object; fields[2] = .lltarget..operand.integer(7) as .object
  ignored = root.emit('load',fields,at)
  call objectarraydrop fields; fields[1] = root.reg('r',0) as .object; callbackid = root.emit('say',fields,at)
  fields[1] = root.reg('r',2) as .object; fields[2] = root.reg('r',1) as .object; fields[3] = .lltarget..operand.integer(0) as .object
  ignored = root.emit('iadd',fields,at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.integer(0) as .object; ignored = root.emit('ret',fields,at)
  return draft.finish()

/** These describe independently checked fixture events. No production native
 * callback is relabelled harmless, and raw-root backing is never assumed empty. */
premises: procedure = .lltargettransfer..profile
  arg owner = reference .lltarget..module, candidate = .int, mode = .int, missing = 0, otherpremise = 0
  source = dereference owner; premise = 'independent.normalization.preservation'
  if otherpremise then premise = 'independent.different.normalization.premise'
  builder = .lltargettransfer..profiledraft(owner,premise)
  catalog = .llrxascatalog..catalog(); integer = builder.domain('component','fixture.integer',catalog.componentmask('I'))
  ignored = .int; subject = .int; input = .int
  do i = 1 to source.records()
    item = source.record(i); ignored = builder.operation(item.id()); ignored = builder.relocation(item.id(),'none')
    if item.kind() <> 'instruction' then iterate
    select item.mnemonic()
      when 'load' then do
        subject = builder.ref(item.id(),1); ignored = builder.event(item.id(),'write',subject,integer,'literal',0,item.operand(2))
      end
      when 'null' then do
        subject = builder.ref(item.id(),1); ignored = builder.event(item.id(),'clear',subject,0)
        if mode = 3 then ignored = builder.event(item.id(),'callback',0,0,'none',0,.lltarget..operand(),'may','all','before','catalog.callback.unconditional')
      end
      when 'say' then do
        subject = builder.ref(item.id(),1); phase = 'before'; observation = 'component'
        if candidate & mode = 2 then phase = 'after'
        if mode = 4 then observation = 'physical'
        if mode = 5 then observation = 'unknown'
        ignored = builder.event(item.id(),'callback',subject,integer,'none',0,.lltarget..operand(),'may','all',phase,'fixture.component.observer',0,observation)
      end
      when 'iadd' then do
        subject = builder.ref(item.id(),1); input = builder.ref(item.id(),2)
        if candidate & mode = 6 then call builder.unknown(item.id(),'components','fixture.candidate.components.unknown')
        if missing then call builder.unknown(item.id(),'components','fixture.read.components.unknown')
        else ignored = builder.event(item.id(),'observe',input,integer)
        ignored = builder.event(item.id(),'write',subject,integer)
      end
      when 'br' then ignored = builder.ref(item.id(),1,'label','symbolic')
      when 'brf' then do
        ignored = builder.ref(item.id(),1,'label','symbolic'); input = builder.ref(item.id(),2)
        ignored = builder.event(item.id(),'observe',input,integer)
      end
      when 'ret' then ignored = builder.event(item.id(),'return',0,0)
      otherwise call builder.unknown(item.id(),'effects','fixture.unrepresented')
    end
  end
  return builder.finish()

run: procedure = .int
  arg mode = .int
  failures = 0; sourcecallback = .int; candidatecallback = .int; i = .int; next = 1
  original = sample(0,mode,sourcecallback); candidate = sample(1,mode,candidatecallback)
  failures = failures + check(original.valid() & candidate.valid(),'models validate ' || mode)
  if original.valid() = 0 | candidate.valid() = 0 then return failures
  before = premises(reference original,0,mode); after = premises(reference candidate,1,mode)
  sourcecfg = .lltargetcfg..graph(reference original,reference before)
  candidatecfg = .lltargetcfg..graph(reference candidate,reference after)
  operations = .int[]
  do i = 1 to original.records()
    item = original.record(i); target = candidate.record(next)
    if target.kind() = 'instruction' & target.mnemonic() = 'null' then do; next = next + 1; target = candidate.record(next); end
    operations[item.id()] = target.id(); next = next + 1
  end
  mapping = .lltargetremap..correspondence(reference original,reference candidate,reference before,reference after,reference sourcecfg,reference candidatecfg,operations)
  if mode = 2 | mode = 6 then do
    failures = failures + check(mapping.status() = 'unknown' & mapping.reason() = 'correspondence.transfer.changed','changed callback phase or dependency completeness has no exact correspondence ' || mode)
    return failures
  end
  failures = failures + check(mapping.status() = 'proved','identity-copy and explicit entry-clear correspondence validates ' || mode || ': ' || mapping.reason())
  if mapping.status() <> 'proved' then return failures
  event = mapping.event(sourcecallback,1)
  failures = failures + check(event.valid() & event.candidateoperation() = candidatecallback & event.sourceregion() = event.candidateregion(),'exact original callback event maps once ' || mode)
  invalid = mapping.event(sourcecallback,0)
  failures = failures + check(invalid.status() = 'invalid' & invalid.reason() = 'correspondence.event.invalid','an absent ordered action cannot assert event correspondence')
  if mode = 0 then do
    limited = .lltargetremap..correspondence(reference original,reference candidate,reference before,reference after,reference sourcecfg,reference candidatecfg,operations,1)
    failures = failures + check(limited.status() = 'limit','correspondence has a bounded work allowance')
    original = candidate
    failures = failures + check(mapping.valid() = 0 & event.valid() = 0,'replacing an owner invalidates correspondence and borrowed events')
  end
  return failures

identitymodel: procedure = .lltarget..module
  arg inserted = 0
  draft = .lltarget..draft('normalization.identity','fixture:normalization.identity',0)
  at = draft.synthetic('an unchanged zero-dirty procedure retains its possible later callback')
  body = draft.procedure('main',3,at); fields = .object[]; ignored = .int
  if inserted then do; fields[1] = body.reg('r',1) as .object; ignored = body.emit('null',fields,at); end
  fields[1] = body.reg('r',0) as .object; fields[2] = .lltarget..operand.integer(7) as .object
  ignored = body.emit('load',fields,at)
  assembler setattrs fields,0; fields[1] = body.reg('r',0) as .object; ignored = body.emit('say',fields,at)
  fields[1] = .lltarget..operand.integer(0) as .object; ignored = body.emit('ret',fields,at)
  return draft.finish()

footprintpremise: procedure = .lltargettransfer..profile
  arg owner = reference .lltarget..module, complete = .int
  source = dereference owner; builder = .lltargettransfer..profiledraft(owner,'independent.footprint.correspondence'); ignored = .int
  do i = 1 to source.records()
    item = source.record(i); ignored = builder.operation(item.id()); ignored = builder.relocation(item.id(),'none')
    if item.kind() <> 'instruction' then iterate
    if item.mnemonic() = 'ret' then ignored = builder.event(item.id(),'external',0,0,'none',0,.lltarget..operand(),'may','all','none','fixture.external',0,'unknown',complete)
  end
  return builder.finish()

footprintcorrespondence: procedure = .int
  source = identitymodel(); candidate = source; before = footprintpremise(reference source,1); after = footprintpremise(reference candidate,0)
  cfg0 = .lltargetcfg..graph(reference source,reference before); cfg1 = .lltargetcfg..graph(reference candidate,reference after); operations = .int[]
  do i = 1 to source.records(); item = source.record(i); operations[item.id()] = item.id(); end
  mapping = .lltargetremap..correspondence(reference source,reference candidate,reference before,reference after,reference cfg0,reference cfg1,operations)
  return check(mapping.status() = 'unknown' & mapping.reason() = 'correspondence.transfer.changed','candidate cannot change the exact intrinsic external-footprint premise')

/** A derived result's input component and context dependency are part of
 * event correspondence, independently of its destination component. */
derivationprofile: procedure = .lltargettransfer..profile
  arg owner = reference .lltarget..module, mode = .int
  source = dereference owner; builder = .lltargettransfer..profiledraft(owner,'independent.derivation.correspondence')
  output = builder.domain('component','string',4); name = 'integer'; bit = 1
  if mode = 3 then name = 'different-input'
  if mode = 4 then bit = 2
  input = builder.domain('component',name,bit); derivation = 1; context = 1
  if mode = 1 then derivation = 2
  if mode = 2 then context = 2
  if mode = 5 then input = 0
  do i = 1 to source.records()
    item = source.record(i); ignored = builder.operation(item.id()); ignored = builder.relocation(item.id(),'none')
    if item.kind() <> 'instruction' then iterate
    if item.mnemonic() = 'itos' then do
      ref = builder.ref(item.id(),1)
      ignored = builder.event(item.id(),'derive',ref,output,'reference',ref,.lltarget..operand(),'must','normal','none','fixture.derived-string',0,'unknown',0,input,derivation,context)
    end
  end
  return builder.finish()

derivationcontracts: procedure = .int
  failures = 0; draft = .lltarget..draft('derived.contract','fixture:derived.contract',0)
  at = draft.synthetic('same instruction with independently varied source dependencies')
  root = draft.procedure('main',1,at); fields = .object[]; fields[1] = root.reg('r',0) as .object
  ignored = root.emit('itos',fields,at)
  fields[1] = .lltarget..operand.integer(0) as .object; ignored = root.emit('ret',fields,at)
  source = draft.finish(); candidate = source; operations = .int[]
  do i = 1 to source.records(); item = source.record(i); operations[item.id()] = item.id(); end
  before = derivationprofile(reference source,0); cfg0 = .lltargetcfg..graph(reference source,reference before)
  do mode = 0 to 5
    after = derivationprofile(reference candidate,mode); cfg1 = .lltargetcfg..graph(reference candidate,reference after)
    mapping = .lltargetremap..correspondence(reference source,reference candidate,reference before,reference after,reference cfg0,reference cfg1,operations)
    if mode = 0 then failures = failures + check(mapping.status() = 'proved','identical derivation dependencies retain correspondence')
    else if mode = 5 then failures = failures + check(after.status() = 'invalid' & mapping.status() = 'invalid' & mapping.reason() = 'correspondence.analysis.unavailable','a missing source component invalidates a declared derivation before correspondence')
    else failures = failures + check(mapping.status() = 'unknown' & mapping.reason() = 'correspondence.transfer.changed','changed derivation/input/context contract has no correspondence ' || mode)
  end
  return failures

main: procedure = .int
  failures = footprintcorrespondence() + derivationcontracts(); mode = .int
  do mode = 0 to 6; failures = failures + run(mode); end
  say 'TARGET_CORRESPONDENCE|failures=' || failures
  return failures
