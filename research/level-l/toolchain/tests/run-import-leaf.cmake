cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER LINKER CLI FIXTURES WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
set(_profile closed-main-static-exact-default-halt.v1)
set(_caller "${FIXTURES}/io-import-caller.rxas")
set(_provider "${FIXTURES}/io-import-provider.rxas")
set(_expected "17\n12\n31\n19")
file(SHA256 "${_provider}" _provider_source_before)

function(run_checked _description)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE _status
    OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "${_description}: ${_status}\n${_stdout}${_stderr}")
  endif()
  set(_last_stdout "${_stdout}" PARENT_SCOPE)
  set(_last_stderr "${_stderr}" PARENT_SCOPE)
endfunction()

function(check_values _description _binary)
  run_checked("${_description}" "${VM}" "${_binary}")
  string(REPLACE "\r\n" "\n" _actual "${_last_stdout}")
  string(STRIP "${_actual}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "${_description}: expected '${_expected}', got '${_actual}'")
  endif()
endfunction()

function(check_retained _path _description)
  file(READ "${_path}" _source)
  file(STRINGS "${_path}" _lines ENCODING UTF-8)
  set(_count 0)
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^[ \t]*call2[ \t]+r0,foreign\\(\\),r0,r0$")
      math(EXPR _count "${_count} + 1")
    endif()
  endforeach()
  if(NOT _count EQUAL 2 OR NOT _source MATCHES "foreign\\(\\)[ \t]+\\.expose=fixture\\.import\\.bump")
    message(FATAL_ERROR "${_description}: refusal changed the original calls/import")
  endif()
endfunction()

function(expect_keep _name _profile _reason)
  set(_output "${WORK}/${_name}.rxas")
  run_checked("retain ${_name}" "${VM}" "${CLI}" ${RUNTIME} -a
    --module io-import-caller.rxas --profile "${_profile}" ${ARGN}
    -o "${_output}" "${_caller}")
  string(FIND "${_last_stderr}" "${_reason}" _found)
  if(_found LESS 0)
    message(FATAL_ERROR "${_name}: missing precise keep reason '${_reason}': ${_last_stderr}")
  endif()
  check_retained("${_output}" "${_name}")
endfunction()

function(expect_failure _name _reason)
  set(_output "${WORK}/${_name}.rxas")
  file(WRITE "${_output}" "last-good-import-output\n")
  execute_process(COMMAND "${VM}" "${CLI}" ${RUNTIME} -a
    --module io-import-caller.rxas --profile "${_profile}" ${ARGN}
    -o "${_output}" "${_caller}"
    RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
  string(FIND "${_stdout}${_stderr}" "${_reason}" _found)
  file(READ "${_output}" _after)
  if(_status EQUAL 0 OR _found LESS 0 OR NOT _after STREQUAL "last-good-import-output\n")
    message(FATAL_ERROR "${_name}: expected atomic failure '${_reason}', got ${_status}: ${_stdout}${_stderr}")
  endif()
endfunction()

# Assemble the exact immutable provider once and reuse it for every link.
# The original linked pair independently establishes the fixture's values.
run_checked("assemble exact imported provider" "${ASSEMBLER}" -n
  -o "${WORK}/import-provider" "${_provider}")
file(SHA256 "${WORK}/import-provider.rxbin" _provider_binary_before)
run_checked("assemble original import caller" "${ASSEMBLER}" -n
  -o "${WORK}/import-original" "${_caller}")
run_checked("link original exact pair" "${LINKER}" -o "${WORK}/import-original-linked"
  "${WORK}/import-original.rxbin" "${WORK}/import-provider.rxbin")
check_values("original imported alias/result values" "${WORK}/import-original-linked.rxbin")

foreach(_mode conservative cleaned)
  set(_cleanup_option)
  if(_mode STREQUAL "conservative")
    set(_cleanup_option --no-cleanup)
  endif()
  set(_product "${WORK}/import-${_mode}")
  run_checked("expand exact imported leaf (${_mode})" "${VM}" "${CLI}" ${RUNTIME} -a
    --module io-import-caller.rxas --artifact fixture:import-caller
    --body io-import-provider.rxas "${_provider}" --profile "${_profile}"
    ${_cleanup_option} -o "${_product}.rxas" "${_caller}")
  file(STRINGS "${_product}.rxas" _lines ENCODING UTF-8)
  set(_imports 0)
  set(_definitions 0)
  set(_increments 0)
  set(_caller_points 0)
  set(_provider_points 0)
  set(_provider_traces 0)
  set(_provider_steps "")
  set(_provider_clauses "")
  set(_last_step "")
  set(_last_clause "")
  set(_pending_trace "")
  set(_last_icopy "")
  set(_snapshots "")
  set(_snapshot_uses 0)
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^foreign\\(\\)[ \t]+\\.expose=fixture\\.import\\.bump$")
      math(EXPR _imports "${_imports} + 1")
    elseif(_line MATCHES "^[^ \t]+\\(\\)[ \t]+\\.locals=")
      math(EXPR _definitions "${_definitions} + 1")
      if(NOT _line MATCHES "^main\\(\\)[ \t]+\\.locals=")
        message(FATAL_ERROR "${_mode}: a provider/surrogate definition leaked into caller output: ${_line}")
      endif()
    endif()
    if(_line MATCHES "^[ \t]*(call[0-9]*|swapcall|settpswapcall|settpcall)[ \t]")
      message(FATAL_ERROR "${_mode}: selected imported leaf did not expand: ${_line}")
    endif()
    if(_line MATCHES "^[ \t]*\\.srcstep ([0-9]+) ([0-9]+) 0 \"io-import-provider.rxas\" 7 3 14 \"  iadd a1,a1,7\"$")
      set(_last_step "${CMAKE_MATCH_1}")
      set(_last_clause "${CMAKE_MATCH_2}")
      if(_last_step LESS_EQUAL 2 OR _last_clause LESS_EQUAL 2)
        message(FATAL_ERROR "${_mode}: provider observation IDs collide with the caller")
      endif()
      list(APPEND _provider_steps "${_last_step}")
      list(APPEND _provider_clauses "${_last_clause}")
      math(EXPR _provider_points "${_provider_points} + 1")
    elseif(_line MATCHES "^[ \t]*\\.srcstep ([12]) ([12]) 0 \"io-import-caller.rxas\" (12|17) 3 26 \"  call2 r0,foreign\\(\\),r0,r0\"$")
      math(EXPR _caller_points "${_caller_points} + 1")
    endif()
    if(_line MATCHES "^[ \t]*\\.traceevent \"V\" 4 \"R\" \"I\" \"r\" ([0-9]+) ([0-9]+) ([0-9]+) 0 \"import-actual\" \"\"$")
      set(_pending_trace "r${CMAKE_MATCH_1}")
      if(NOT CMAKE_MATCH_2 STREQUAL _last_step OR NOT CMAKE_MATCH_3 STREQUAL _last_clause)
        message(FATAL_ERROR "${_mode}: provider TRACE lost its source/clause relation")
      endif()
      math(EXPR _provider_traces "${_provider_traces} + 1")
    endif()
    if(_line MATCHES "^[ \t]*[A-Za-z][A-Za-z0-9]*([ \t]|$)")
      if(NOT _pending_trace STREQUAL "")
        if(NOT _line MATCHES "^[ \t]*iadd[ \t]+${_pending_trace},${_pending_trace},7$")
          message(FATAL_ERROR "${_mode}: provider TRACE no longer observes its mapped argument before mutation: ${_line}")
        endif()
        set(_pending_trace "")
      endif()
      if(_line MATCHES "^[ \t]*icopy[ \t]+(r[0-9]+),r[0-9]+$")
        set(_last_icopy "${CMAKE_MATCH_1}")
      endif()
      if(_line MATCHES "^[ \t]*iadd[ \t]+r[0-9]+,r[0-9]+,7$")
        math(EXPR _increments "${_increments} + 1")
        if(_last_icopy STREQUAL "")
          message(FATAL_ERROR "${_mode}: imported mutation lost its earlier scalar snapshot")
        endif()
        list(APPEND _snapshots "${_last_icopy}")
      endif()
      foreach(_snapshot IN LISTS _snapshots)
        if(_line MATCHES "^[ \t]*iadd[ \t]+r[0-9]+,${_snapshot},r[0-9]+$")
          math(EXPR _snapshot_uses "${_snapshot_uses} + 1")
        endif()
      endforeach()
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _provider_steps)
  list(REMOVE_DUPLICATES _provider_clauses)
  list(LENGTH _provider_steps _distinct_steps)
  list(LENGTH _provider_clauses _distinct_clauses)
  if(NOT _imports EQUAL 1 OR NOT _definitions EQUAL 1 OR NOT _increments EQUAL 2
      OR NOT _caller_points EQUAL 2 OR NOT _provider_points EQUAL 2 OR NOT _provider_traces EQUAL 2
      OR NOT _distinct_steps EQUAL 2 OR NOT _distinct_clauses EQUAL 2 OR NOT _snapshot_uses EQUAL 2
      OR NOT _pending_trace STREQUAL "")
    message(FATAL_ERROR "${_mode}: imported expansion lost an import, body, snapshot or truthful source/TRACE relation")
  endif()
  run_checked("assemble imported caller (${_mode})" "${ASSEMBLER}" -n
    -o "${_product}" "${_product}.rxas")
  run_checked("link exact imported pair (${_mode})" "${LINKER}" -m "${_product}.map"
    -o "${_product}-linked" "${_product}.rxbin" "${WORK}/import-provider.rxbin")
  file(READ "${_product}.map" _map)
  string(FIND "${_map}" " from ${WORK}/import-provider.rxbin" _provider_selected)
  if(_provider_selected LESS 0)
    message(FATAL_ERROR "${_mode}: retained import no longer selects the exact provider module")
  endif()
  check_values("${_mode} imported alias/result values" "${_product}-linked.rxbin")
endforeach()

expect_keep(old-profile closed-main-default-halt.v1 "profile.imported.body.pending"
  --body io-import-provider.rxas "${_provider}")
expect_keep(missing-body "${_profile}" "unavailable exact body foreign")
expect_keep(global-provider "${_profile}" "import.global.storage.pending"
  --body io-import-provider-global.rxas "${FIXTURES}/io-import-provider-global.rxas")
expect_keep(nested-provider "${_profile}" "import.leaf.nested.pending"
  --body io-import-provider-nested.rxas "${FIXTURES}/io-import-provider-nested.rxas")
expect_failure(duplicate-provider "LL_INLINE_BINDING: ambiguous supplied provider fixture.import.bump"
  --body first-provider "${_provider}" --body second-provider "${_provider}")
expect_failure(mismatched-provider "LL_INLINE_BINDING: unused supplied provider io-import-provider-other.rxas"
  --body io-import-provider-other.rxas "${FIXTURES}/io-import-provider-other.rxas")
expect_failure(work-limit "LL_INLINE_LIMIT:"
  --body io-import-provider.rxas "${_provider}" --work 1)
file(SHA256 "${_provider}" _provider_source_after)
file(SHA256 "${WORK}/import-provider.rxbin" _provider_binary_after)
if(NOT _provider_source_before STREQUAL _provider_source_after
    OR NOT _provider_binary_before STREQUAL _provider_binary_after)
  message(FATAL_ERROR "Imported expansion changed the immutable provider source or assembled artifact")
endif()
file(REMOVE_RECURSE "${WORK}")
message("RXAS_IMPORTED_LEAF|failures=0")
