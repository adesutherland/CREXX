cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER LINKER CLI FIXTURES WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
set(_profile closed-main-static-exact-default-halt.v1)
set(_provider "${FIXTURES}/io-import-global-provider.rxas")
set(_caller "${FIXTURES}/io-import-global-caller.rxas")
file(READ "${_provider}" _provider_text)
file(READ "${_caller}" _caller_text)
file(SHA256 "${_provider}" _provider_before)
file(SHA256 "${_caller}" _caller_before)

function(run_checked _description)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE _status
    OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "${_description}: ${_status}\n${_stdout}${_stderr}")
  endif()
  set(_last_stdout "${_stdout}" PARENT_SCOPE)
  set(_last_stderr "${_stderr}" PARENT_SCOPE)
endfunction()

function(execute_pair _source _provider_binary _product _expected)
  run_checked("assemble ${_product}" "${ASSEMBLER}" -n -o "${_product}" "${_source}")
  run_checked("link ${_product}" "${LINKER}" -m "${_product}.map" -o "${_product}-linked"
    "${_product}.rxbin" "${_provider_binary}")
  file(READ "${_product}.map" _map)
  string(FIND "${_map}" " from ${_provider_binary}" _selected)
  if(_selected LESS 0)
    message(FATAL_ERROR "retained procedure import did not select its exact provider")
  endif()
  run_checked("execute ${_product}" "${VM}" "${_product}-linked.rxbin")
  string(REPLACE "\r\n" "\n" _actual "${_last_stdout}")
  string(STRIP "${_actual}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "${_product}: expected '${_expected}', got '${_actual}'")
  endif()
endfunction()

function(expect_keep _name _source _body _reason)
  set(_output "${WORK}/${_name}-output.rxas")
  file(WRITE "${_output}" "last-good-public-global-output\n")
  execute_process(COMMAND "${VM}" "${CLI}" ${RUNTIME} -a
    --module io-import-global-caller.rxas --profile "${_profile}" --work 12000000
    --body io-import-global-provider.rxas "${_body}" ${ARGN}
    -o "${_output}" "${_source}"
    RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
  string(FIND "${_stdout}${_stderr}" "${_reason}" _found)
  file(READ "${_output}" _after)
  if(_reason STREQUAL "import.global.declaration.ambiguous" OR _reason STREQUAL "exposed global outside module" OR _reason STREQUAL "LL_INLINE_LIMIT")
    if(_status EQUAL 0 OR _found LESS 0 OR NOT _after STREQUAL "last-good-public-global-output\n")
      message(FATAL_ERROR "${_name}: expected atomic failure '${_reason}', got ${_status}: ${_stdout}${_stderr}")
    endif()
  else()
    file(STRINGS "${_output}" _lines ENCODING UTF-8)
    set(_calls 0)
    foreach(_line IN LISTS _lines)
      if(_line MATCHES "^call1 r[12],foreign\\(\\),(r0|g2)$")
        math(EXPR _calls "${_calls}+1")
      endif()
    endforeach()
    if(NOT _status EQUAL 0 OR _found LESS 0 OR NOT _calls EQUAL 2 OR NOT _after MATCHES "foreign\\(\\) \\.expose=fixture.global.bump")
      message(FATAL_ERROR "${_name}: expected original calls with '${_reason}', got ${_status}: ${_stdout}${_stderr}")
    endif()
  endif()
  set(_kept_output "${_output}" PARENT_SCOPE)
endfunction()

# The ordinary linked pair establishes these values before expansion.
set(_values "3\n13\n28\n28\n99\n256\n256")
run_checked("assemble immutable public-global provider" "${ASSEMBLER}" -n
  -o "${WORK}/global-provider" "${_provider}")
file(SHA256 "${WORK}/global-provider.rxbin" _binary_before)
execute_pair("${_caller}" "${WORK}/global-provider.rxbin" "${WORK}/original" "${_values}")
foreach(_mode conservative cleaned)
  set(_cleanup_option)
  if(_mode STREQUAL "conservative")
    set(_cleanup_option --no-cleanup)
  endif()
  set(_product "${WORK}/global-${_mode}")
  run_checked("expand public globals (${_mode})" "${VM}" "${CLI}" ${RUNTIME} -a
    --module io-import-global-caller.rxas --artifact fixture:global-caller
    --profile "${_profile}" --work 12000000
    --body io-import-global-provider.rxas "${_provider}" ${_cleanup_option}
    -o "${_product}.rxas" "${_caller}")
  file(STRINGS "${_product}.rxas" _lines ENCODING UTF-8)
  set(_exposures 0)
  set(_imports 0)
  set(_effects 0)
  set(_returns 0)
  set(_metadata 0)
  set(_traces 0)
  set(_definitions 0)
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^g[0-9]+ \\.expose=")
      math(EXPR _exposures "${_exposures}+1")
      if(NOT _line STREQUAL "g2 .expose=fixture.global.value")
        message(FATAL_ERROR "${_mode}: changed exposure declaration: ${_line}")
      endif()
    elseif(_line STREQUAL "foreign() .expose=fixture.global.bump")
      math(EXPR _imports "${_imports}+1")
    endif()
    if(_line MATCHES "\\(\\) \\.locals=")
      math(EXPR _definitions "${_definitions}+1")
    endif()
    if(_line MATCHES "^call[1-4]? ")
      message(FATAL_ERROR "${_mode}: selected shared-global call survived")
    endif()
    if(_line MATCHES "^iadd g2,g2,")
      math(EXPR _effects "${_effects}+1")
    endif()
    if(_line MATCHES "^copy r[0-9]+,g2$")
      math(EXPR _returns "${_returns}+1")
    endif()
    if(_line MATCHES "^\\.meta .* g2$")
      math(EXPR _metadata "${_metadata}+1")
    endif()
    if(_line MATCHES "^\\.traceevent .* \"g\" 2 ")
      math(EXPR _traces "${_traces}+1")
    endif()
    if(_line MATCHES "^endlife g" OR _line MATCHES "^\\.globals=" AND NOT _line STREQUAL ".globals=3")
      message(FATAL_ERROR "${_mode}: changed shared-global lifetime or bank: ${_line}")
    endif()
  endforeach()
  if(NOT _exposures EQUAL 1 OR NOT _imports EQUAL 1 OR NOT _definitions EQUAL 1
      OR NOT _effects EQUAL 2 OR NOT _returns EQUAL 2 OR NOT _metadata EQUAL 2 OR NOT _traces EQUAL 2)
    message(FATAL_ERROR "${_mode}: lost global mapping, return copy, metadata, exposure/import or TRACE")
  endif()
  execute_pair("${_product}.rxas" "${WORK}/global-provider.rxbin" "${_product}" "${_values}")
endforeach()

string(REPLACE "g1 .expose=fixture.global.value\n" "" _private "${_provider_text}")
file(WRITE "${WORK}/private-provider.rxas" "${_private}")
expect_keep(private "${_caller}" "${WORK}/private-provider.rxas" "import.global.private.pending")
string(REPLACE "g2 .expose=fixture.global.value\n" "" _missing "${_caller_text}")
file(WRITE "${WORK}/missing-caller.rxas" "${_missing}")
expect_keep(missing-alias "${WORK}/missing-caller.rxas" "${_provider}" "import.global.caller.alias.missing")
string(REPLACE "g2 .expose=fixture.global.value" "g2 .expose=fixture.global.other" _mismatch "${_caller_text}")
file(WRITE "${WORK}/mismatch-caller.rxas" "${_mismatch}")
expect_keep(mismatched-alias "${WORK}/mismatch-caller.rxas" "${_provider}" "import.global.caller.alias.missing")
string(REPLACE "g1 .expose=fixture.global.value" "g1 .expose=fixture.global.value\ng0 .expose=fixture.global.value" _duplicate "${_provider_text}")
file(WRITE "${WORK}/duplicate-provider.rxas" "${_duplicate}")
expect_keep(duplicate-global "${_caller}" "${WORK}/duplicate-provider.rxas" "import.global.declaration.ambiguous")
string(REPLACE "g1 .expose=fixture.global.value" "g2 .expose=fixture.global.value" _bounds "${_provider_text}")
file(WRITE "${WORK}/bounds-provider.rxas" "${_bounds}")
expect_keep(global-bounds "${_caller}" "${WORK}/bounds-provider.rxas" "exposed global outside module")
string(REPLACE "  call1 r1,foreign(),r0" "  link g2,r0\n  call1 r1,foreign(),r0" _rebound "${_caller_text}")
file(WRITE "${WORK}/rebound-caller.rxas" "${_rebound}")
expect_keep(rebound-global "${WORK}/rebound-caller.rxas" "${_provider}" "global.binding.unproved")
string(REPLACE "  load g2,10" "  cnop" _unknown "${_caller_text}")
string(REPLACE "  null g2" "  cnop" _unknown "${_unknown}")
file(WRITE "${WORK}/unknown-caller.rxas" "${_unknown}")
expect_keep(unknown-global "${WORK}/unknown-caller.rxas" "${_provider}" "global.definition.unproved")
# Initializer ingress remains covered by the constructed model. The current
# RXAS input profile rejects .initializer before reaching the inliner.
expect_keep(work-limit "${_caller}" "${_provider}" "LL_INLINE_LIMIT" --work 3)

# A retained private-global case executes with its independent distinct cell.
string(REGEX REPLACE "  ichkrng[^\n]*\n" "" _retained "${_caller_text}")
file(WRITE "${WORK}/retained-caller.rxas" "${_retained}")
run_checked("assemble retained private-global provider" "${ASSEMBLER}" -n
  -o "${WORK}/private-provider" "${WORK}/private-provider.rxas")
execute_pair("${WORK}/retained-caller.rxas" "${WORK}/private-provider.rxbin" "${WORK}/retained-original" "3\n3\n14\n11\n99\n0\n0")
expect_keep(retained-private "${WORK}/retained-caller.rxas" "${WORK}/private-provider.rxas" "import.global.private.pending")
execute_pair("${_kept_output}" "${WORK}/private-provider.rxbin" "${WORK}/retained-expanded" "3\n3\n14\n11\n99\n0\n0")

# No spelled g operand occurs here. The counted child window nevertheless
# reads provider g0 before a0; projection into a zero-global caller must keep.
set(_window_provider "${FIXTURES}/io-import-global-window-provider.rxas")
set(_window_caller "${FIXTURES}/io-import-global-window-caller.rxas")
run_checked("assemble implicit-global window provider" "${ASSEMBLER}" -n
  -o "${WORK}/window-provider" "${_window_provider}")
execute_pair("${_window_caller}" "${WORK}/window-provider.rxbin" "${WORK}/window-original" "0")
run_checked("retain implicit-global child window" "${VM}" "${CLI}" ${RUNTIME} -a
  --module io-import-global-window-caller.rxas --profile "${_profile}" --work 12000000
  --body io-import-global-window-provider.rxas "${_window_provider}"
  -o "${WORK}/window-retained.rxas" "${_window_caller}")
string(FIND "${_last_stderr}" "import.global.nested.call.pending" _window_reason)
file(READ "${WORK}/window-retained.rxas" _window_retained)
if(_window_reason LESS 0 OR NOT _window_retained MATCHES "call1 r1,foreign\\(\\),r0")
  message(FATAL_ERROR "implicit provider-global window was not retained with its precise reason")
endif()
execute_pair("${WORK}/window-retained.rxas" "${WORK}/window-provider.rxbin" "${WORK}/window-retained" "0")
file(SHA256 "${_provider}" _provider_after)
file(SHA256 "${_caller}" _caller_after)
file(SHA256 "${WORK}/global-provider.rxbin" _binary_after)
if(NOT _provider_before STREQUAL _provider_after OR NOT _caller_before STREQUAL _caller_after OR NOT _binary_before STREQUAL _binary_after)
  message(FATAL_ERROR "public-global expansion changed an exact immutable input")
endif()
message("RXAS_IMPORTED_GLOBAL|failures=0")
