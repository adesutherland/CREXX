cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER LINKER CLIENT WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
foreach(_shape source clone)
  set(_argument --emit-source)
  if(_shape STREQUAL "clone")
    set(_argument --emit-rxas)
  endif()
  execute_process(COMMAND "${VM}" "${CLIENT}" -a "${_argument}"
    RESULT_VARIABLE _status OUTPUT_VARIABLE _source ERROR_VARIABLE _error)
  if(NOT _status EQUAL 0 OR NOT _error STREQUAL "")
    message(FATAL_ERROR "Level L ${_shape} producer failed: ${_status}: ${_source}: ${_error}")
  endif()
  if(_shape STREQUAL "clone")
    if(_source MATCHES "(^|\n)(call[1-4]?|inlenter) " OR
        NOT _source MATCHES "main[(][)] [.]locals=0" OR
        NOT _source MATCHES "[.]inlineframe " OR NOT _source MATCHES "[.]inlinemap ")
      message(FATAL_ERROR "Certified clone retains a call/frame/cell cost or loses static diagnostics")
    endif()
  elseif(NOT _source MATCHES "(^|\n)call leaf[(][)][\r\n]")
    message(FATAL_ERROR "Source control no longer exercises ordinary CALL: ${_source}")
  endif()
  foreach(_optimization raw optimized)
    set(_stem "${WORK}/${_shape}-${_optimization}")
    file(WRITE "${_stem}.rxas" "${_source}")
    set(_flags)
    if(_optimization STREQUAL "raw")
      list(APPEND _flags -n)
    endif()
    execute_process(COMMAND "${ASSEMBLER}" ${_flags} "${_stem}"
      RESULT_VARIABLE _status OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
    if(NOT _status EQUAL 0 OR NOT _error STREQUAL "")
      message(FATAL_ERROR "Native assembler rejected ${_shape}/${_optimization}: ${_status}: ${_output}: ${_error}")
    endif()
    execute_process(COMMAND "${LINKER}" -s -o "${_stem}-linked" "${_stem}"
      RESULT_VARIABLE _status OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
    if(NOT _status EQUAL 0 OR NOT _error STREQUAL "")
      message(FATAL_ERROR "Native linker rejected ${_shape}/${_optimization}: ${_status}: ${_output}: ${_error}")
    endif()
    execute_process(COMMAND "${VM}" "${_stem}-linked.rxbin"
      RESULT_VARIABLE _status OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
    string(REPLACE "\r\n" "\n" _output "${_output}")
    if(NOT _status EQUAL 0 OR NOT _error STREQUAL "" OR NOT _output STREQUAL "retained-tail\n")
      message(FATAL_ERROR "${_shape}/${_optimization} differs from independent output: ${_status}: ${_output}: ${_error}")
    endif()
  endforeach()
endforeach()
file(REMOVE_RECURSE "${WORK}")
message("RETAINED_CALLER_NATIVE|failures=0")
