/* cREXX License (MIT). Draft construction is distinct from final permission. */
options levelb
import rxfnsb
import llir
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetflow
import lltargetsummary
import lltargetremap
import llrxascatalog

check: procedure = .int
  arg condition = .int, label = .string
  if condition then return 0
  say 'FAIL:' || label
  return 1
one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, value = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = value as .object
  return body.emit(name,fields,at)
two: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, left = .lltarget..operand, right = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = left as .object; fields[2] = right as .object
  return body.emit(name,fields,at)

sample: procedure = .lltarget..module
  arg mode = .int, expose called = .int, expose written = .int
  draft = .lltarget..draft('relational.plan','fixture:relational.plan',1)
  at = draft.synthetic('symbolic actuals do not become clean to construct a clone')
  main = draft.procedure('main',4,at)
  ignored = .int
  ignored = two(main,'load',main.reg('r',1),.lltarget..operand.integer(11),at)
  ignored = two(main,'load',main.reg('r',2),.lltarget..operand.integer(22),at)
  /* r0 is deliberately unknown. A direct structural clone transports that
   * same unknown; it has no authority to insert an entry clear for r0. */
  fields = .object[]
  fields[1] = main.reg('r',3) as .object; fields[2] = .lltarget..operand.procedure('choose') as .object
  fields[3] = main.reg('r',0) as .object; fields[4] = main.reg('r',1) as .object; fields[5] = main.reg('r',2) as .object
  called = main.emit('call3',fields,at)
  ignored = one(main,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('choose',1,at)
  ignored = one(leaf,'null',leaf.reg('r',0),at)
  if mode = 1 then ignored = two(leaf,'link',leaf.reg('g',0),leaf.reg('r',0),at)
  if mode = 2 | mode = 4 | mode = 5 then ignored = two(leaf,'link',leaf.reg('r',0),leaf.reg('a',1),at)
  if mode = 4 | mode = 5 then ignored = one(leaf,'unlink',leaf.reg('r',0),at)
  if mode = 4 then ignored = two(leaf,'link',leaf.reg('g',0),leaf.reg('r',0),at)
  if mode = 5 then ignored = two(leaf,'setattrs',leaf.reg('r',0),.lltarget..operand.integer(1),at)
  if mode = 3 then ignored = one(leaf,'sayx',.lltarget..operand.string('host' as .binary),at)
  ignored = two(leaf,'swap',leaf.reg('a',2),leaf.reg('a',3),at)
  written = two(leaf,'load',leaf.reg('a',2),.lltarget..operand.integer(99),at)
  ignored = one(leaf,'ret',leaf.reg('a',3),at)
  return draft.finish()

run: procedure = .int
  arg mode = .int
  failures = 0; called = .int; written = .int
  source = sample(mode,called,written)
  failures = failures + check(source.valid(),'relational fixture validates ' || mode)
  if source.valid() = 0 then do; say source.error(); return failures; end
  profile = .lltargettransfer..profile.closedcalls(reference source,source.procedureid('main'),'closed-main-default-halt.v1',4000000)
  cfg = .lltargetcfg..graph(reference source,reference profile,4000000)
  points = .lltargetflow..analysis(reference source,reference profile,reference cfg,4000000)
  summaries = .lltargetsummary..analysis(reference points,4000000)
  failures = failures + check(points.status() = 'ok' & summaries.status() = 'ok','shared native owners complete ' || mode)
  if points.status() <> 'ok' | summaries.status() <> 'ok' then return failures
  plan = summaries.expansionplan(called)
  if mode <> 3 & mode <> 5 then failures = failures + check(plan.draftallowed(),'unknown actual and mutable argument slots permit construction ' || mode || ':' || plan.reason())
  if mode = 3 then failures = failures + check(plan.draftallowed() = 0 & plan.reason() = 'target.context.restore.effects.unproved','host context uncertainty remains separate from byte-snapshot backing reach')
  if mode = 5 then failures = failures + check(plan.draftallowed() = 0 & plan.reason() = 'catalog.indirect.ownership.unknown','unbounded attribute ownership supplies no complete clone inventory')
  failures = failures + check(plan.allowed() = 0 & plan.semanticallowed() = 0,'a draft never grants final semantic permission ' || mode)
  layout = plan.layout()
  failures = failures + check(layout.countknown() & layout.count() = 3 & layout.resultkind() = 'captured','draft preserves exact arity/result capture ' || mode)
  history = points.privatebackinghistory(source.procedureid('choose'),'r',0)
  a0 = points.privatebackinghistory(source.procedureid('choose'),'a',0)
  if mode = 0 then do
    failures = failures + check(history.resourcefree() & history.nonescape(),'unrelated borrowed swap/write does not spoil private r0 history')
    failures = failures + check(a0.resourcefree() & a0.nonescape(),'unreferenced a0 uses the generic current-execution footprint without a recycled-timing veto')
    callinstruction = profile.instruction(called); classified = 0
    do ordinal = 1 to callinstruction.actions()
      action = callinstruction.action(ordinal)
      if action.kind() <> 'callback' | action.detail() <> 'catalog.callback.call-frame' then iterate
      classified = classified + 1
      failures = failures + check(profile.recyclercleanup(called,ordinal,'callback') & points.callbackpossibleat(called,ordinal),'incidental classification preserves the raw possible native callback')
      failures = failures + check(summaries.equivalencecallback(called,ordinal,1) = 0,'per-call equivalence does not impose incidental recycled-a0 timing')
    end
    failures = failures + check(classified = 1 & profile.recyclercleanup(called,0,'callback') = 0 & profile.recyclercleanup(called,1,'unrecognized') = 0,'only the exact canonical recycler action receives the equivalence classification')
  end
  if mode = 1 then failures = failures + check(history.resourcefree() = 0 & history.reason() = 'target.resource.backing.pointer.exported','exported original backing cannot borrow a nonescape invariant')
  if mode = 2 then failures = failures + check(history.resourcefree() & history.nonescape(),'borrowed active binding leaves original owned backing inactive and untouched')
  if mode = 3 then failures = failures + check(history.resourcefree() & history.nonescape(),'reviewed byte snapshot preserves only unescaped backing resource history:' || history.reason())
  if mode = 4 then failures = failures + check(history.resourcefree() = 0 & history.reason() = 'target.resource.backing.pointer.exported','reactivated original backing exported to global has no nonescape theorem')
  if mode = 5 then failures = failures + check(history.resourcefree() = 0,'resource-capable write after original backing reactivation spoils history')
  borrowed = points.privatebackinghistory(source.procedureid('choose'),'a',1)
  failures = failures + check(borrowed.resourcefree() = 0 & borrowed.nonescape() = 0,'borrowed actual receives no owned-backing seed')
  badpoint = points.resourceat(written,'a',2,0,'not-an-anchor')
  failures = failures + check(badpoint.live() = 0 & badpoint.capacityempty() = 0 & badpoint.nativeabsent() = 0,'invalid resource anchor supplies no cleanliness')
  if cfg.outedges(called) > 0 then do
    edge = cfg.outedge(called,1)
    badpoint = points.resourceat(written,'r',0,edge.id())
    failures = failures + check(badpoint.live() = 0 & badpoint.capacityempty() = 0,'foreign operation edge supplies no resource fact')
  end
  operations = .int[]; instances = .object[]
  do recordid = 1 to source.records()
    record = source.record(recordid); operations[record.id()] = record.id()
  end
  mapping = .lltargetremap..expansioncorrespondence(reference source,reference source,operations,instances,4000000)
  failures = failures + check(mapping.status() = 'unknown' & mapping.reason() = 'expansion.module.shape.unproved','empty expansion batch cannot masquerade as an activation correspondence')
  other = .lltargetsummary..analysis(reference points,4000000)
  refused = other.expansionequivalence(plan,reference mapping,4000000)
  failures = failures + check(refused.allowed() = 0 & refused.reason() = 'target.expansion.plan.owner.mismatch','cross-summary plan never grants candidate authority')
  limited = summaries.expansionequivalence(plan,reference mapping,0,0)
  failures = failures + check(limited.allowed() = 0 & limited.status() = 'limit','zero budget preflight rejects even an unrelated invalid structural claim')
  retained = limited.result()
  failures = failures + check(retained.identity() = source.identity(),'budget refusal atomically retains the exact original source')
  if mode = 0 then do
    replacement = sample(mode,called,written)
    source = replacement
    failures = failures + check(plan.valid() = 0 & history.valid() = 0,'source replacement invalidates draft and backing history')
  end
  return failures

/** The recycler timing contract never licenses resources or exported backing
 * pointers installed by the current invocation, nor erases explicit clears. */
a0ownership: procedure = .int
  arg mode = .int
  failures = 0; ignored = .int; clearop = 0
  draft = .lltarget..draft('relational.a0.ownership.' || mode,'fixture:relational.a0.ownership',1)
  at = draft.synthetic('current-invocation a0 resource and explicit-clear obligations')
  body = draft.procedure('main',1,at)
  ignored = two(body,'load',body.reg('r',0),.lltarget..operand.integer(7),at)
  fields = .object[]; fields[1] = body.reg('r',0) as .object; fields[2] = .lltarget..operand.procedure('worker') as .object; fields[3] = body.reg('r',0) as .object
  ignored = body.emit('call1',fields,at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  body = draft.procedure('worker',0,at)
  if mode = 1 then ignored = two(body,'copy',body.reg('a',0),body.reg('a',1),at)
  if mode = 2 then ignored = two(body,'link',body.reg('g',0),body.reg('a',0),at)
  if mode = 3 then clearop = one(body,'null',body.reg('a',0),at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  source = draft.finish()
  failures = failures + check(source.valid(),'current a0 ownership fixture validates ' || mode)
  if source.valid() = 0 then return failures
  profile = .lltargettransfer..profile.closedcalls(reference source,source.procedureid('main'),'closed-main-default-halt.v1',4000000)
  cfg = .lltargetcfg..graph(reference source,reference profile,4000000)
  points = .lltargetflow..analysis(reference source,reference profile,reference cfg,4000000)
  failures = failures + check(points.status() = 'ok','current a0 ownership flow builds ' || mode)
  if points.status() <> 'ok' then return failures
  history = points.privatebackinghistory(source.procedureid('worker'),'a',0)
  if mode < 3 then failures = failures + check(history.resourcefree() = 0 & history.nonescape() = 0,'current a0 resource import/export retains its generic ownership gate ' || mode)
  if mode = 3 then do
    failures = failures + check(history.resourcefree() & history.nonescape(),'explicit a0 clear remains a checked generic effect')
    instruction = profile.instruction(clearop); hooks = 0
    do ordinal = 1 to instruction.actions()
      action = instruction.action(ordinal)
      if action.kind() <> 'callback' then iterate
      hooks = hooks + 1
      failures = failures + check(profile.recyclercleanup(clearop,ordinal,'callback') = 0,'explicit clear hooks never receive the incidental recycler classification')
    end
    failures = failures + check(hooks > 0,'explicit a0 clear keeps its native hook inventory')
  end
  return failures

/** Returning public handlers may copy a dirty component into a formerly
 * defined global. Its deduplicated backing was first owned by another proc. */
foreignglobals: procedure = .int
  failures = 0; ignored = .int; integer = 0; sawreturn = 0; dirtyreturn = 1; i = .int
  draft = .lltarget..draft('relational.foreign.globals','fixture:relational.foreign.globals',1)
  at = draft.synthetic('foreign returning callback imports dirty origin into shared g0')
  first = draft.procedure('first',0,at)
  ignored = one(first,'getnumdgts',first.reg('g',0),at)
  ignored = one(first,'ret',.lltarget..operand.integer(0),at)
  main = draft.procedure('main',2,at)
  ignored = two(main,'sigcall',.lltarget..operand.procedure('handler'),.lltarget..operand.string('OUT_OF_RANGE' as .binary),at)
  setter = two(main,'load',main.reg('g',0),.lltarget..operand.integer(7),at)
  ignored = one(main,'getnumdgts',main.reg('r',0),at)
  ignored = one(main,'ret',.lltarget..operand.integer(0),at)
  handler = draft.procedure('handler',1,at)
  ignored = two(handler,'icopy',handler.reg('g',0),handler.reg('r',0),at)
  ignored = one(handler,'ret',.lltarget..operand.integer(0),at)
  source = draft.finish()
  failures = failures + check(source.valid(),'dirty returning-handler global fixture validates')
  if source.valid() = 0 then return failures
  profile = .lltargettransfer..profile.closedmain(reference source,source.procedureid('main'),'closed-main-default-halt.v1',4000000)
  cfg = .lltargetcfg..graph(reference source,reference profile,4000000)
  points = .lltargetflow..analysis(reference source,reference profile,reference cfg,4000000)
  failures = failures + check(points.status() = 'ok','dirty returning-handler global flow completes')
  if points.status() <> 'ok' then return failures
  catalog = .llrxascatalog..catalog()
  do i = 1 to profile.domains()
    domain = profile.domain(i)
    if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('I') then integer = i
  end
  /* Use the setter's licensed normal poststate. Earlier asynchronous edges
   * may already havoc an arbitrary later before-state. Compare the returning
   * handler alternative from this same setter, with the same value phase. */
  before = points.componentat(setter,'g',0,integer,1); literal = before.literal()
  failures = failures + check(before.known() & literal.kind() = 'I' & literal.index() = 7,'normal setter poststate independently defines global as seven')
  failures = failures + check(points.storagefunction(before.storage()) = source.procedureid('first'),'deduplicated global backing belongs to its first materializing owner')
  do i = 1 to cfg.outedges(setter)
    edge = cfg.outedge(setter,i)
    if edge.asynchronous() = 0 | wordpos(edge.exposure(),'handler-call handler-call-async') = 0 | edge.targetblock() = 0 then iterate
    sawreturn = 1
    after = points.componenton(edge.id(),'g',0,integer)
    if after.availability() <> 'unknown' | after.known() | after.originscomplete() then dirtyreturn = 0
  end
  failures = failures + check(sawreturn,'setter control includes a real asynchronous returning-handler alternative')
  failures = failures + check(sawreturn & dirtyreturn,'callback may import dirty state and foreign origin into shared global')
  return failures

/** A void RET preserves the provider poststate; CALL's earlier result clear
 * cannot overwrite a subsequent provider write through the same global. */
voidglobal: procedure = .int
  failures = 0; ignored = .int; integer = 0
  draft = .lltarget..draft('relational.void.global','fixture:relational.void.global',1)
  at = draft.synthetic('CALL clear precedes provider global mutation and bare return')
  main = draft.procedure('main',0,at)
  ignored = two(main,'load',main.reg('g',0),.lltarget..operand.integer(7),at)
  called = two(main,'call',main.reg('g',0),.lltarget..operand.procedure('leaf'),at)
  observed = one(main,'itos',main.reg('g',0),at)
  ignored = one(main,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('leaf',0,at)
  ignored = two(leaf,'load',leaf.reg('g',0),.lltarget..operand.integer(99),at)
  empty = .object[]; ignored = leaf.emit('ret',empty,at)
  source = draft.finish()
  profile = .lltargettransfer..profile.closedcalls(reference source,source.procedureid('main'),'closed-main-default-halt.v1',4000000)
  cfg = .lltargetcfg..graph(reference source,reference profile,4000000)
  points = .lltargetflow..analysis(reference source,reference profile,reference cfg,4000000)
  failures = failures + check(points.status() = 'ok','void global result projection completes')
  if points.status() <> 'ok' then return failures
  catalog = .llrxascatalog..catalog()
  do i = 1 to profile.domains()
    domain = profile.domain(i)
    if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('I') then integer = i
  end
  value = points.componentat(observed,'g',0,integer); literal = value.literal()
  failures = failures + check(value.availability() = 'unknown' | (value.known() & literal.kind() = 'I' & literal.index() = 99),'void provider mutation may be conservative, never stale pre-call clear or seven')
  return failures

/** Refining private backing cannot discharge a global capacity checkpoint. */
externalcheckpoint: procedure = .int
  failures = 0; ignored = .int; found = 0
  draft = .lltarget..draft('relational.external.checkpoint','fixture:relational.external.checkpoint',2)
  at = draft.synthetic('private no-resource theorem excludes global callback endpoints')
  main = draft.procedure('main',1,at)
  ignored = one(main,'getnumdgts',main.reg('r',0),at)
  copied = two(main,'copy',main.reg('g',0),main.reg('g',1),at)
  ignored = one(main,'ret',.lltarget..operand.integer(0),at)
  source = draft.finish()
  profile = .lltargettransfer..profile.closedmain(reference source,source.procedureid('main'),'closed-main-default-halt.v1',4000000)
  cfg = .lltargetcfg..graph(reference source,reference profile,4000000)
  points = .lltargetflow..analysis.relational(reference source,reference profile,reference cfg,4000000)
  failures = failures + check(points.status() = 'ok','private refinement leaves external endpoint flow usable')
  if points.status() <> 'ok' then return failures
  history = points.privatebackinghistory(source.procedureid('main'),'r',0)
  failures = failures + check(history.resourcefree() & history.nonescape(),'unrelated private backing has its own history:' || history.reason())
  instruction = profile.instruction(copied)
  do i = 1 to instruction.actions()
    action = instruction.action(i)
    if action.kind() = 'callback' & action.detail() = 'catalog.callback.capacity-or-checkpoint' then do
      failures = failures + check(points.callbackpossibleat(copied,i),'global capacity checkpoint cannot borrow private resource absence')
      found = 1
    end
  end
  failures = failures + check(found,'global transport has a distinct capacity/checkpoint control')
  return failures

/** A valid extraction object can contain an unresolved dirty-origin row.
 * Zero concrete demands must never turn that object into complete coverage. */
unresolvedcoverage: procedure = .int
  failures = 0; ignored = .int
  draft = .lltarget..draft('relational.unresolved.coverage','fixture:relational.unresolved.coverage',0)
  at = draft.synthetic('returning host callback may import a dirty foreign origin')
  main = draft.procedure('main',0,at)
  ignored = one(main,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('leaf',1,at)
  ignored = one(leaf,'sayx',.lltarget..operand.string('snapshot' as .binary),at)
  ignored = one(leaf,'itos',leaf.reg('r',0),at)
  ignored = one(leaf,'ret',.lltarget..operand.integer(0),at)
  source = draft.finish()
  profile = .lltargettransfer..profile(reference source,4000000)
  cfg = .lltargetcfg..graph(reference source,reference profile,4000000)
  points = .lltargetflow..analysis(reference source,reference profile,reference cfg,4000000)
  failures = failures + check(points.status() = 'ok','unresolved dirty-origin extraction flow completes')
  if points.status() <> 'ok' then return failures
  coverage = points.entrycoverage(source.procedureid('leaf'))
  failures = failures + check(coverage.valid() & coverage.complete() = 0 & coverage.rows() > coverage.demands(),'valid zero-demand extraction retains its unresolved dirty-origin portion')
  return failures

/** These are native control components, not final expansion permission. */
controlinventory: procedure = .int
  failures = 0; catalog = .llrxascatalog..catalog(); called = .int; written = .int
  source = sample(0,called,written); item = source.at(called)
  failures = failures + check(catalog.framepluginownership() = 'none-published-interface.v1','published plugin instance routes install no private-frame plugin ownership')
  failures = failures + check(catalog.callframecontrolstate(item.opcode()) = 'known' & catalog.callframecontrolentry(item.opcode(),'pluginowners') = 'none','ordinary child entry has typed nonowned plugin state')
  failures = failures + check(catalog.callframecontrolentry(item.opcode(),'not-a-field') = 'unknown' & catalog.framecontrolmasknamed('not-a-field') = 0,'unknown control names supply no absence fact')
  profile = .lltargettransfer..profile.closedcalls(reference source,source.procedureid('main'),'closed-main-default-halt.v1',4000000)
  cfg = .lltargetcfg..graph(reference source,reference profile,4000000)
  points = .lltargetflow..analysis(reference source,reference profile,reference cfg,4000000)
  summaries = .lltargetsummary..analysis(reference points,4000000)
  failures = failures + check(summaries.status() = 'ok','native control atoms share the existing summary closure')
  if summaries.status() <> 'ok' then return failures
  view = summaries.procedure(source.procedureid('choose'),'direct')
  fact = view.effect('framecontrol','may',catalog.framecontrolmask(source.at(written).opcode()) as .string,1)
  failures = failures + check(fact.may() & fact.unknown() = 0,'provider frame-control mask is retained as a known typed direct summary atom')
  return failures

/** A completed checker retains its cost when the enclosing summary cannot
 * pay it. A lazy structural proof is charged here; a frozen proof is reused. */
failureaccounting: procedure = .int
  failures = 0; called = .int; written = .int
  source = sample(0,called,written)
  profile = .lltargettransfer..profile.closedcalls(reference source,source.procedureid('main'),'closed-main-default-halt.v1',4000000)
  cfg = .lltargetcfg..graph(reference source,reference profile,4000000)
  points = .lltargetflow..analysis(reference source,reference profile,reference cfg,4000000)
  measured = .lltargetsummary..analysis(reference points,4000000)
  failures = failures + check(measured.status() = 'ok','failure-accounting summary completes')
  if measured.status() <> 'ok' then return failures
  plan = measured.expansionplan(called); exactwork = measured.usedwork()
  failures = failures + check(plan.draftallowed(),'failure-accounting draft is available')
  if plan.draftallowed() = 0 then return failures
  operations = .int[]; sourceops = .int[]; candidateops = .int[]; counts = .int[]; instances = .object[]
  sourceops[1] = written; candidateops[1] = written; counts[1] = 1
  /* No candidate frame exists: this is an independent structural refusal,
   * after its source/candidate indexing work has really been performed. */
  instance = .lltargetremap..expansioninstance(called,reference source,source.procedureid('choose'),1,sourceops,candidateops,counts,'absent')
  instances[1] = instance as .object
  lazy = .lltargetremap..expansioncorrespondence(reference source,reference source,operations,instances,4000000)
  rejected = measured.expansionequivalence(plan,reference lazy,4000000)
  failures = failures + check(rejected.allowed() = 0 & rejected.usedwork() > 0 & lazy.usedwork() > 0,'lazy refused correspondence retains actual final-stage work')
  frozen = measured.expansionequivalence(plan,reference lazy,4000000)
  failures = failures + check(frozen.allowed() = 0 & frozen.usedwork() = 0,'frozen refused correspondence is not built and spent again')
  tight = .lltargetsummary..analysis(reference points,exactwork)
  failures = failures + check(tight.status() = 'ok','tight summary pays its existing inference cost')
  if tight.status() <> 'ok' then return failures
  tightplan = tight.expansionplan(called)
  failures = failures + check(tightplan.draftallowed(),'tight summary pays the same draft cost')
  if tightplan.draftallowed() = 0 then return failures
  again = .lltargetremap..expansioncorrespondence(reference source,reference source,operations,instances,4000000)
  limited = tight.expansionequivalence(tightplan,reference again,4000000)
  failures = failures + check(limited.status() = 'limit' & limited.usedwork() >= again.usedwork() & again.usedwork() > 0,'wrapper refusal preserves completed checker cost instead of a zero-quota replacement')
  retained = limited.result()
  failures = failures + check(retained.identity() = source.identity(),'counter failure atomically retains the original source')
  return failures

main: procedure = .int
  failures = 0; mode = .int
  do mode = 0 to 5; failures = failures + run(mode); end
  do mode = 1 to 3; failures = failures + a0ownership(mode); end
  failures = failures + foreignglobals() + voidglobal() + externalcheckpoint() + unresolvedcoverage() + controlinventory() + failureaccounting()
  if failures = 0 then say 'TARGET_EXPANSION_RELATIONAL|failures=0'
  else say 'TARGET_EXPANSION_RELATIONAL|failures=' || failures
  return failures
