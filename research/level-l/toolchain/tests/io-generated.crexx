/* Native -n compiler input: its real metadata/call emission exercises the reader. */
options levelb
namespace inliogenerated

main: procedure = .int
  result = increment(7)
  result = twice(result)
  say result
  return 0

increment: procedure = .int
  arg value = .int
  return value + 1

twice: procedure = .int
  arg value = .int
  return value * 2
