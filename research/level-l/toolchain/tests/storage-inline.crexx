/* cREXX License (MIT). Independent typed placement/reuse and metadata controls. */
options levelb
import rxfnsb
import llir
import llirgraph
import lltarget
import lltargetfacts
import llcleanup
import llinline

check: procedure = .int
  arg condition = .int, message = .string
  if condition then return 0
  say 'FAIL:' message
  return 1
one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object
  return body.emit(name,fields,at)
two: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object
  return body.emit(name,fields,at)
three: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, third = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object; fields[3] = third as .object
  return body.emit(name,fields,at)
namedlabel: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, at = .llir..origin
  fields = .object[]; fields[1] = .lltarget..operand.symbol(name) as .object
  return body.record('label',fields,at)
nooperand: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, at = .llir..origin
  fields = .object[]
  return body.emit(name,fields,at)
tracepoint: procedure = .int
  arg body = .lltarget..bodydraft, index = .int, at = .llir..origin
  fields = .object[]
  fields[1] = .lltarget..operand.string('V' as .binary) as .object
  fields[2] = .lltarget..operand.integer(4) as .object
  fields[3] = .lltarget..operand.string('R' as .binary) as .object
  fields[4] = .lltarget..operand.string('I' as .binary) as .object
  fields[5] = .lltarget..operand.string('r' as .binary) as .object
  fields[6] = .lltarget..operand.integer(index) as .object
  do i = 7 to 9; fields[i] = .lltarget..operand.integer(0) as .object; end
  fields[10] = .lltarget..operand.string('r14,quoted' as .binary) as .object
  fields[11] = .lltarget..operand.string(''x as .binary) as .object
  return body.record('.traceevent',fields,at)
binding: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, index = .int, at = .llir..origin
  fields = .object[]; fields[1] = .lltarget..operand.string(name as .binary) as .object
  if index >= 0 then do
    fields[2] = .lltarget..operand.string('b' as .binary) as .object
    fields[3] = .lltarget..operand.string('.int' as .binary) as .object
    fields[4] = body.reg('r',index) as .object
  end
  return body.record('.meta',fields,at)

closedaddress: procedure = .int
  arg owner = reference .lltarget..module, sumid = .int, clearid = .int, carrierid = .int, continuationid = .int
  failures = 0; i = .int; sumordinal = .int; clearordinal = .int; carrierordinal = .int; continuationordinal = .int
  body = .lltarget..body; item = .lltarget..record
  source = dereference owner; body = source.body(source.procedureid('main'))
  do i = 1 to body.records()
    item = body.record(i)
    if item.id() = sumid then sumordinal = i
    if item.id() = clearid then clearordinal = i
    if item.id() = carrierid then carrierordinal = i
    if item.id() = continuationid then continuationordinal = i
  end
  failures = failures + check(sumordinal > 0 & clearordinal > sumordinal & carrierordinal = clearordinal + 1 & continuationordinal > carrierordinal,'stable shared scope closes after both lexical arm computations and before caller output')
  item = source.at(clearid)
  failures = failures + check(item.addressid() = carrierid,'stable shared clear retains its own executable address before continuation')
  item = source.at(carrierid)
  failures = failures + check(item.mnemonic() = 'cnop','stable shared clear keeps its immediate CNOP carrier')
  return failures

sparse: procedure = .int
  failures = 0; item = .lltarget..record; left = .lltarget..operand; right = .lltarget..operand
  changed = .llinline..change; limited = .llinline..change
  original = .lltarget..module; result = .lltarget..module; kept = .lltarget..module; body = .lltarget..body
  draft = .lltarget..draft('storage.sparse','fixture:storage.sparse',0)
  at = draft.synthetic('sparse complete typed references'); root = draft.procedure('main',15,at)
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(7),at)
  named = two(root,'load',root.reg('r',8),.lltarget..operand.integer(11),at)
  observed = two(root,'load',root.reg('r',14),.lltarget..operand.integer(13),at)
  metaid = binding(root,'visible',8,at); traceid = tracepoint(root,14,at)
  ignored = two(root,'copy',root.reg('r',0),root.reg('r',8),at)
  clearid = binding(root,'visible',-1,at)
  ignored = three(root,'iadd',root.reg('r',14),root.reg('r',14),root.reg('r',0),at)
  ignored = one(root,'itos',root.reg('r',14),at); ignored = one(root,'say',root.reg('r',14),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  original = draft.finish(); changed = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','sparse complete body receives checked placement')
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  result = changed.result(); body = result.body(result.procedureid('main'))
  failures = failures + check(body.locals() = 3,'three overlapping required cells use a dense three-cell frame')
  item = result.at(changed.operation(named)); left = item.operand(1)
  item = result.at(changed.operation(metaid)); right = item.operand(4)
  failures = failures + check(left.index() = right.index(),'scoped META_REG follows its logical cell')
  item = result.at(changed.operation(observed)); left = item.operand(1)
  item = result.at(changed.operation(traceid)); right = item.operand(6)
  failures = failures + check(left.index() = right.index(),'point TRACE follows its logical cell')
  right = item.operand(10)
  failures = failures + check(right.text() = 'r14,quoted','quoted metadata text is not a register template')
  item = result.at(changed.operation(clearid)); right = item.operand(1)
  failures = failures + check(item.operands() = 1 & right.text() = 'visible','matching metadata clear retains its name')
  graph = dereference original.ir(); before = graph.binary()
  limited = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1',1000000,1000000,67108864,2)
  kept = limited.result(); graph = dereference kept.ir()
  failures = failures + check(limited.status() = 'limit' & bin2x(graph.binary()) = bin2x(before),'insufficient simultaneous-cell budget preserves exact original')
  limited = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1',1)
  kept = limited.result(); graph = dereference kept.ir()
  failures = failures + check(limited.status() = 'limit' & bin2x(graph.binary()) = bin2x(before),'work refusal publishes no partial storage rewrite')
  limited = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1',1000000,1000000,1)
  kept = limited.result(); graph = dereference kept.ir()
  failures = failures + check(limited.status() = 'limit' & bin2x(graph.binary()) = bin2x(before),'byte refusal publishes no partial storage rewrite')
  limited = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1',1000000,1000000,67108864,65536,1)
  kept = limited.result(); graph = dereference kept.ir()
  failures = failures + check(limited.status() = 'limit' & bin2x(graph.binary()) = bin2x(before),'output cell refusal publishes the complete original')
  changed = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','ordinary storage request succeeds after bounded failures')
  return failures

/** Dense placement counts complete distinct references, independent of arm
 * order; it introduces neither sharing nor an arrival reset. */
sparsedag: procedure = .int
  failures = 0; mode = .int; service = .int; resets_found = .int; i = .int
  original = .lltarget..module; projected = .lltarget..module; result = .lltarget..module; kept = .lltarget..module; body = .lltarget..body
  item = .lltarget..record; left = .lltarget..operand; right = .lltarget..operand; condition = .lltarget..operand
  changed = .llinline..change; limited = .llinline..change; transported = .llinline..change
  draft = .lltarget..draft('storage.dag','fixture:storage.dag',0); at = draft.synthetic('three distinct DAG cells')
  root = draft.procedure('main',15,at)
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(5),at)
  conditionid = three(root,'getandtp',root.reg('r',0),root.reg('r',0),.lltarget..operand.integer(768),at)
  named = two(root,'load',root.reg('r',8),.lltarget..operand.integer(11),at)
  metaid = binding(root,'dagvisible',8,at)
  ignored = two(root,'brt',.lltarget..operand.symbol('dag_true'),root.reg('r',0),at)
  ignored = two(root,'load',root.reg('r',14),.lltarget..operand.integer(22),at)
  ignored = three(root,'iadd',root.reg('r',14),root.reg('r',14),root.reg('r',8),at)
  ignored = one(root,'br',.lltarget..operand.symbol('dag_join'),at)
  ignored = namedlabel(root,'dag_true',at)
  ignored = two(root,'load',root.reg('r',14),.lltarget..operand.integer(33),at)
  /* Exact operands prove success in each arm. The unequal 33/44 result is
   * available but unknown after the join; sumid anchors its last lexical arm. */
  sumid = three(root,'iadd',root.reg('r',14),root.reg('r',14),root.reg('r',8),at)
  ignored = namedlabel(root,'dag_join',at)
  lifeid = one(root,'endlife',root.reg('r',0),at)
  traceid = tracepoint(root,14,at); clearid = binding(root,'dagvisible',-1,at)
  carrierid = nooperand(root,'cnop',at)
  continuationid = one(root,'itos',root.reg('r',14),at); ignored = one(root,'say',root.reg('r',14),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  original = draft.finish()
  failures = failures + check(original.valid(),'sparse DAG is valid typed input')
  if original.valid() = 0 then do; say original.error(); return failures; end
  transported = llcleanup..transport(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(transported.status() = 'changed' & transported.operation(lifeid) = 0,'stable-scope graph transport removes the proved plain condition lifetime ending')
  if transported.status() <> 'changed' then do; say transported.reason(); return failures; end
  projected = transported.result()
  failures = failures + closedaddress(reference projected,transported.operation(sumid),transported.operation(clearid),transported.operation(carrierid),transported.operation(continuationid))
  changed = llcleanup..storage(reference projected,projected.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','sparse DAG receives unique dense placement')
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  result = changed.result(); body = result.body(result.procedureid('main'))
  item = result.at(changed.operation(transported.operation(conditionid))); condition = item.operand(1)
  item = result.at(changed.operation(transported.operation(named))); left = item.operand(1)
  item = result.at(changed.operation(transported.operation(sumid))); right = item.operand(1)
  failures = failures + check(body.locals() = 3 & left.index() <> right.index() & left.index() <> condition.index() & right.index() <> condition.index(),'three referenced logical DAG cells remain distinct in exactly three physical cells')
  item = result.at(changed.operation(transported.operation(metaid))); condition = item.operand(4)
  failures = failures + check(condition.index() = left.index(),'common-entry META_REG retains its dense logical binding')
  item = result.at(changed.operation(transported.operation(traceid))); condition = item.operand(6)
  failures = failures + check(condition.index() = right.index(),'joined point TRACE follows its dense value')
  condition = item.operand(10)
  failures = failures + check(condition.text() = 'r14,quoted','dense DAG projection preserves literal metadata text')
  failures = failures + closedaddress(reference result,changed.operation(transported.operation(sumid)),changed.operation(transported.operation(clearid)),changed.operation(transported.operation(carrierid)),changed.operation(transported.operation(continuationid)))
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() = 'instruction' & item.mnemonic() = 'null' then resets_found = resets_found + 1
  end
  failures = failures + check(resets_found = 0,'unique DAG placement invents no arrival reset')
  graph = dereference original.ir(); before = graph.binary()
  do service = 1 to 2
    do mode = 1 to 4
      if service = 1 then do
        select mode
          when 1 then limited = llcleanup..transport(reference original,original.procedureid('main'),'closed-main-default-halt.v1',1)
          when 2 then limited = llcleanup..transport(reference original,original.procedureid('main'),'closed-main-default-halt.v1',1000000,1000000,1)
          when 3 then limited = llcleanup..transport(reference original,original.procedureid('main'),'closed-main-default-halt.v1',1000000,1000000,67108864,0)
          otherwise limited = llcleanup..transport(reference original,original.procedureid('main'),'closed-main-default-halt.v1',1000000,1000000,67108864,65536,1)
        end
      end
      else do
        select mode
          when 1 then limited = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1',1)
          when 2 then limited = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1',1000000,1000000,1)
          when 3 then limited = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1',1000000,1000000,67108864,2)
          otherwise limited = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1',1000000,1000000,67108864,65536,1)
        end
      end
      kept = limited.result(); limitedgraph = dereference kept.ir()
      failures = failures + check(limited.status() = 'limit' & limited.reason() <> '' & bin2x(limitedgraph.binary()) = bin2x(before),'tight DAG cleanup allowances retain exact original ' || service || '/' || mode)
    end
  end
  return failures

/** The first lexical lifetime executes second. Source-order interval reuse
 * would put its reset before the wrong arrival and leak compiler status256. */
backwarddag: procedure = .int
  failures = 0; i = .int; resets_found = .int
  original = .lltarget..module; result = .lltarget..module; body = .lltarget..body
  item = .lltarget..record; first = .lltarget..operand; second = .lltarget..operand
  changed = .llinline..change
  draft = .lltarget..draft('storage.backward','fixture:storage.backward',0); at = draft.synthetic('reverse lexical scalar lifetimes')
  root = draft.procedure('main',8,at)
  ignored = one(root,'br',.lltarget..operand.symbol('first'),at)
  ignored = namedlabel(root,'second',at)
  secondid = two(root,'load',root.reg('r',3),.lltarget..operand.integer(22),at)
  ignored = two(root,'copy',root.reg('r',1),root.reg('r',3),at)
  ignored = one(root,'br',.lltarget..operand.symbol('done'),at)
  ignored = namedlabel(root,'first',at)
  firstid = two(root,'load',root.reg('r',5),.lltarget..operand.integer(11),at)
  ignored = two(root,'settp',root.reg('r',5),.lltarget..operand.integer(256),at)
  ignored = two(root,'copy',root.reg('r',0),root.reg('r',5),at)
  ignored = one(root,'br',.lltarget..operand.symbol('second'),at)
  ignored = namedlabel(root,'done',at)
  ignored = three(root,'getandtp',root.reg('r',6),root.reg('r',0),.lltarget..operand.integer(768),at)
  ignored = three(root,'getandtp',root.reg('r',7),root.reg('r',1),.lltarget..operand.integer(768),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  original = draft.finish()
  failures = failures + check(original.valid(),'backward-lexical DAG is valid and acyclic')
  if original.valid() = 0 then do; say original.error(); return failures; end
  changed = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','backward-lexical DAG receives dense placement')
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  result = changed.result(); body = result.body(result.procedureid('main'))
  item = result.at(changed.operation(firstid)); first = item.operand(1)
  item = result.at(changed.operation(secondid)); second = item.operand(1)
  failures = failures + check(body.locals() = 6 & first.index() <> second.index(),'six required cells stay distinct; reverse-order private temporaries cannot use a lexical reset schedule')
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() = 'instruction' & item.mnemonic() = 'null' then resets_found = resets_found + 1
  end
  failures = failures + check(resets_found = 0,'backward DAG dense mode inserts no unproved cross-block reset')
  return failures

/** These missing graph proofs preserve the original input; they are pending
 * analysis categories, not claims that the machine shapes are infeasible. */
graphkeeps: procedure = .int
  failures = 0; variant = .int; service = .int; expected = .string; ignored = .int
  original = .lltarget..module; kept = .lltarget..module; changed = .llinline..change
  do variant = 1 to 2
    draft = .lltarget..draft('storage.graph.keep.' || variant,'fixture:storage.graph.keep',0)
    at = draft.synthetic('specific missing graph proof'); root = draft.procedure('main',4,at)
    if variant = 1 then do
      ignored = namedlabel(root,'cycle',at)
      ignored = one(root,'br',.lltarget..operand.symbol('cycle'),at)
      expected = 'root.cfg.cycle.pending'
    end
    else do
      ignored = two(root,'load',root.reg('r',3),.lltarget..operand.integer(5),at)
      ignored = three(root,'getandtp',root.reg('r',0),root.reg('r',3),.lltarget..operand.integer(768),at)
      ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(11),at)
      ignored = two(root,'brt',.lltarget..operand.symbol('changed'),root.reg('r',0),at)
      ignored = one(root,'br',.lltarget..operand.symbol('joined'),at)
      ignored = namedlabel(root,'changed',at)
      ignored = two(root,'link',root.reg('r',1),root.reg('r',0),at)
      ignored = namedlabel(root,'joined',at)
      ignored = one(root,'ret',.lltarget..operand.integer(0),at)
      expected = 'join.binding.unproved'
    end
    original = draft.finish()
    failures = failures + check(original.valid(),'graph negative has valid target structure ' || variant)
    if original.valid() = 0 then do; say original.error(); iterate; end
    graph = dereference original.ir(); before = graph.binary()
    do service = 1 to 2
      if service = 1 then changed = llcleanup..transport(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
      else changed = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
      kept = changed.result(); keptgraph = dereference kept.ir()
      failures = failures + check(changed.status() = 'keep' & changed.reason() = expected & bin2x(keptgraph.binary()) = bin2x(before),'missing graph proof has exact reason and unchanged owner ' || variant || '/' || service)
      if changed.reason() <> expected then say changed.reason()
    end
  end
  return failures

/** Bounded joins preserve write success without inventing an exact value,
 * resetting status, or conflating the integer and whole-value domains. */
boundedmodel: procedure = .lltarget..module
  arg variant = .int
  constant HIGHEST = 9223372036854775807
  constant LOWEST = -9223372036854775807 - 1
  lhslo = 22; lhshi = 33; rhslo = 11; rhshi = 11; opname = 'iadd'; destination = 2
  select variant
    when 2 then do; opname = 'isub'; rhslo = 5; rhshi = 5; end
    when 3 then do; opname = 'imult'; lhslo = -3; lhshi = 4; rhslo = -2; rhshi = 5; end
    when 4 then do; opname = 'imult'; lhslo = LOWEST; lhshi = HIGHEST; rhslo = 0; rhshi = 0; end
    when 5 then do; lhslo = HIGHEST - 1; lhshi = HIGHEST; rhslo = 1; rhshi = 1; end
    when 6 then do; opname = 'isub'; lhslo = LOWEST; lhshi = LOWEST + 1; rhslo = 1; rhshi = 1; end
    when 7 then do; opname = 'imult'; lhslo = LOWEST; lhshi = -2; rhslo = -1; rhshi = -1; end
    otherwise nop
  end
  if variant > 4 then destination = 4
  draft = .lltarget..draft('storage.bounded.' || variant,'fixture:storage.bounded',0)
  at = draft.synthetic('bounded joined checked arithmetic'); root = draft.procedure('main',10,at)
  ignored = two(root,'load',root.reg('r',7),.lltarget..operand.integer(5),at)
  ignored = three(root,'getandtp',root.reg('r',0),root.reg('r',7),.lltarget..operand.integer(768),at)
  if variant > 4 then ignored = two(root,'load',root.reg('r',4),.lltarget..operand.integer(77),at)
  ignored = two(root,'settp',root.reg('r',destination),.lltarget..operand.integer(256),at)
  if variant = 8 then ignored = three(root,'getandtp',root.reg('r',2),root.reg('r',7),.lltarget..operand.integer(768),at)
  ignored = two(root,'brt',.lltarget..operand.symbol('bounded_true'),root.reg('r',0),at)
  if variant <> 8 then ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(lhslo),at)
  ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(rhslo),at)
  ignored = one(root,'br',.lltarget..operand.symbol('bounded_join'),at)
  ignored = namedlabel(root,'bounded_true',at)
  if variant <> 8 then ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(lhshi),at)
  ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(rhshi),at)
  ignored = namedlabel(root,'bounded_join',at)
  ignored = three(root,opname,root.reg('r',destination),root.reg('r',2),root.reg('r',1),at)
  if variant = 4 then ignored = three(root,'ichkrng',root.reg('r',destination),.lltarget..operand.integer(0),.lltarget..operand.integer(0),at)
  ignored = two(root,'copy',root.reg('r',5),root.reg('r',destination),at)
  ignored = three(root,'getandtp',root.reg('r',3),root.reg('r',5),.lltarget..operand.integer(768),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  return draft.finish()

boundedpositive: procedure = .int
  arg variant = .int
  failures = 0; i = .int; opid = .int; storageid = .int; integer = .int; whole = .int; mode = .int
  original = .lltarget..module; projected = .lltarget..module; result = .lltarget..module; kept = .lltarget..module
  facts = .lltargetfacts..analysis; changed = .llinline..change; allocated = .llinline..change; limited = .llinline..change
  item = .lltarget..record; body = .lltarget..body; projection = .llirgraph..access
  original = boundedmodel(variant)
  failures = failures + check(original.valid(),'bounded arithmetic control is valid typed input ' || variant)
  if original.valid() = 0 then do; say original.error(); return failures; end
  body = original.body(original.procedureid('main'))
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() = 'instruction' & wordpos(item.mnemonic(),'iadd isub imult') > 0 then opid = item.id()
  end
  facts = lltargetfacts..analysegraph(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(facts.status() = 'ok','every bounded endpoint proves a successful joined write ' || variant)
  if facts.status() <> 'ok' then do; say facts.reason(); return failures; end
  projection_ref = facts.access()
  projection = dereference projection_ref
  storageid = facts.storage(opid,1); integer = facts.integerdomain(storageid); whole = facts.wholedomain(storageid)
  failures = failures + check(integer > 0 & whole > 0 & projection.kills(opid,integer) & projection.kills(opid,whole) = 0,'bounded arithmetic kills only its integer component ' || variant)
  failures = failures + check(projection.reads(opid,integer),'aliased destination reads its incoming integer before publishing new bounds ' || variant)
  changed = llcleanup..transport(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','bounded join admits graph transport ' || variant)
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  projected = changed.result()
  item = projected.at(changed.operation(opid))
  failures = failures + check(wordpos(item.mnemonic(),'iadd isub imult') > 0,'checked arithmetic remains executable after transport ' || variant)
  allocated = llcleanup..storage(reference projected,projected.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(allocated.status() = 'changed','bounded caller receives unique dense placement ' || variant)
  if allocated.status() <> 'changed' then do; say allocated.reason(); return failures; end
  result = allocated.result(); body = result.body(result.procedureid('main'))
  failures = failures + check(body.locals() = 6,'six distinct bounded caller cells remain distinct under DAG placement ' || variant)
  graph = dereference original.ir(); before = graph.binary()
  if variant = 1 then do mode = 1 to 2
    if mode = 1 then limited = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1',1)
    else limited = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1',1000000,1000000,1)
    kept = limited.result(); limitedgraph = dereference kept.ir()
    failures = failures + check(limited.status() = 'limit' & bin2x(limitedgraph.binary()) = bin2x(before),'bounded state allowances fail atomically ' || mode)
  end
  return failures

boundedkeeps: procedure = .int
  failures = 0; variant = .int; service = .int
  original = .lltarget..module; kept = .lltarget..module; changed = .llinline..change
  do variant = 5 to 8
    original = boundedmodel(variant)
    failures = failures + check(original.valid(),'overflow or unbounded control is valid typed input ' || variant)
    if original.valid() = 0 then do; say original.error(); iterate; end
    graph = dereference original.ir(); before = graph.binary()
    do service = 1 to 2
      if service = 1 then changed = llcleanup..transport(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
      else changed = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
      kept = changed.result(); keptgraph = dereference kept.ir()
      failures = failures + check(changed.status() = 'keep' & changed.reason() = 'arithmetic.write.availability.unproved' & bin2x(keptgraph.binary()) = bin2x(before),'one unsafe endpoint or unbounded operand retains exact original ' || variant || '/' || service)
      if changed.status() <> 'keep' then say changed.reason()
    end
  end
  return failures

scoped: procedure = .int
  failures = 0; item = .lltarget..record; left = .lltarget..operand; right = .lltarget..operand
  changed = .llinline..change; original = .lltarget..module; result = .lltarget..module; body = .lltarget..body
  draft = .lltarget..draft('storage.scope','fixture:storage.scope',0)
  at = draft.synthetic('metadata remains live until clear'); root = draft.procedure('main',11,at)
  firstid = two(root,'load',root.reg('r',2),.lltarget..operand.integer(11),at)
  ignored = binding(root,'scoped',2,at)
  secondid = two(root,'load',root.reg('r',10),.lltarget..operand.integer(22),at)
  ignored = tracepoint(root,10,at); ignored = binding(root,'scoped',-1,at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  original = draft.finish(); changed = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','metadata-only retention permits unique dense placement')
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  result = changed.result(); body = result.body(result.procedureid('main'))
  item = result.at(changed.operation(firstid)); left = item.operand(1)
  item = result.at(changed.operation(secondid)); right = item.operand(1)
  failures = failures + check(body.locals() = 2 & left.index() <> right.index(),'scoped metadata prevents reuse before its clear')
  return failures

reuse: procedure = .int
  arg ended = 0
  failures = 0; item = .lltarget..record; left = .lltarget..operand; right = .lltarget..operand
  changed = .llinline..change; original = .lltarget..module; result = .lltarget..module; body = .lltarget..body
  previous = .lltarget..record; value = .lltarget..operand; secondat = .llir..origin
  draft = .lltarget..draft('storage.reuse','fixture:storage.reuse',0)
  at = draft.synthetic('two disjoint private scalar lifetimes'); root = draft.procedure('main',6,at)
  firstid = two(root,'load',root.reg('r',3),.lltarget..operand.integer(11),at)
  ignored = two(root,'settp',root.reg('r',3),.lltarget..operand.integer(256),at)
  ignored = two(root,'copy',root.reg('r',0),root.reg('r',3),at)
  lifeid = 0
  if ended then lifeid = one(root,'endlife',root.reg('r',3),at)
  secondat = draft.synthetic('second scalar entry requires fresh whole state')
  secondid = two(root,'load',root.reg('r',5),.lltarget..operand.integer(22),secondat)
  ignored = two(root,'copy',root.reg('r',1),root.reg('r',5),at)
  ignored = tracepoint(root,0,at); ignored = tracepoint(root,1,at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  original = draft.finish(); changed = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','disjoint checked scalar cells receive storage reuse')
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  result = changed.result(); body = result.body(result.procedureid('main'))
  item = result.at(changed.operation(firstid)); left = item.operand(1)
  item = result.at(changed.operation(secondid)); right = item.operand(1)
  failures = failures + check(body.locals() = 3 & left.index() = right.index(),'one private peak and two retained outputs need three cells')
  reset = 0
  do i = 2 to body.records()
    item = body.record(i)
    if item.id() <> changed.operation(secondid) then iterate
    previous = body.record(i - 1)
    if previous.kind() = 'instruction' & previous.mnemonic() = 'null' then do
      value = previous.operand(1)
      reset = value.index() = right.index() & previous.origin().id() = item.origin().id()
    end
  end
  failures = failures + check(reset,'reused scalar has an ordered fresh-entry NULL with semantic origin')
  if ended then do
    item = result.at(changed.operation(lifeid))
    failures = failures + check(item.kind() = 'instruction' & item.mnemonic() = 'endlife','proved plain-root lifetime ending remains before later reuse')
  end
  return failures

retainedwindow: procedure = .int
  failures = 0; item = .lltarget..record; counter = .lltarget..operand; left = .lltarget..operand; right = .lltarget..operand
  changed = .llinline..change; original = .lltarget..module; result = .lltarget..module; body = .lltarget..body
  draft = .lltarget..draft('storage.window','fixture:storage.window',0)
  at = draft.synthetic('retained counted window and its slot permutation'); root = draft.procedure('main',12,at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(11),at)
  ignored = two(root,'load',root.reg('r',3),.lltarget..operand.integer(22),at)
  ignored = two(root,'load',root.reg('r',7),.lltarget..operand.integer(2),at)
  firstswap = two(root,'swap',root.reg('r',8),root.reg('r',3),at)
  secondswap = two(root,'swap',root.reg('r',9),root.reg('r',2),at)
  callid = three(root,'call',root.reg('r',11),.lltarget..operand.procedure('first'),root.reg('r',7),at)
  ignored = two(root,'swap',root.reg('r',2),root.reg('r',9),at)
  ignored = two(root,'swap',root.reg('r',3),root.reg('r',8),at)
  ignored = tracepoint(root,11,at); ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('first',0,at); ignored = one(leaf,'ret',leaf.reg('a',1),at)
  original = draft.finish(); changed = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','retained counted-call caller receives unique dense placement')
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  result = changed.result(); body = result.body(result.procedureid('main'))
  item = result.at(changed.operation(callid)); counter = item.operand(3)
  item = result.at(changed.operation(firstswap)); left = item.operand(1)
  item = result.at(changed.operation(secondswap)); right = item.operand(1)
  failures = failures + check(left.index() = counter.index() + 1 & right.index() = counter.index() + 2,'every implicit actual remains contiguous after its mapped counter')
  swaps = 0
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() = 'instruction' & item.mnemonic() = 'swap' then swaps = swaps + 1
  end
  failures = failures + check(body.locals() = 6 & swaps = 4,'window plus outside storage needs six cells and keeps its reverse permutation')
  return failures

stringlifetime: procedure = .int
  failures = 0
  original = .lltarget..module; result = .lltarget..module; changed = .llinline..change; item = .lltarget..record; body = .lltarget..body
  draft = .lltarget..draft('storage.string','fixture:storage.string',0)
  at = draft.synthetic('ordinary string retains its authored lifetime operation'); root = draft.procedure('main',8,at)
  ignored = two(root,'load',root.reg('r',7),.lltarget..operand.string('payload λ' as .binary),at)
  lifeid = one(root,'endlife',root.reg('r',7),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  original = draft.finish()
  failures = failures + check(original.valid(),'ordinary string lifetime is valid typed input')
  if original.valid() = 0 then do; say original.error(); return failures; end
  changed = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','ordinary string has proved unique dense placement')
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  result = changed.result(); body = result.body(result.procedureid('main')); item = result.at(changed.operation(lifeid))
  failures = failures + check(body.locals() = 1 & item.mnemonic() = 'endlife','string-bearing ENDLIFE remains executable without widening integer-only lifetime deletion')
  return failures

hidden: procedure = .int
  /* Binary payload proof remains a separate pending category. Ordinary strings
   * above are no longer rejected merely because they have a side component. */
  failures = 0; original = .lltarget..module; kept = .lltarget..module; changed = .llinline..change
  draft = .lltarget..draft('storage.hidden','fixture:storage.hidden',0)
  at = draft.synthetic('unproved hidden lifetime cannot be made fresh by allocation'); root = draft.procedure('main',8,at)
  ignored = two(root,'load',root.reg('r',7),.lltarget..operand.literal('B','0x00FF' as .binary),at)
  ignored = one(root,'endlife',root.reg('r',7),at); ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  original = draft.finish(); graph = dereference original.ir(); before = graph.binary()
  changed = llcleanup..storage(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  kept = changed.result(); graph = dereference kept.ir()
  failures = failures + check(changed.status() = 'keep' & changed.reason() = 'profile.scalar.literal.pending','binary payload analysis remains explicitly pending')
  failures = failures + check(bin2x(graph.binary()) = bin2x(before),'hidden release state is preserved rather than reset to admit reuse')
  return failures

main: procedure = .int
  failures = sparse() + sparsedag() + backwarddag() + graphkeeps() + boundedpositive(1) + boundedpositive(2) + boundedpositive(3) + boundedpositive(4) + boundedkeeps() + scoped() + reuse() + reuse(1) + retainedwindow() + stringlifetime() + hidden()
  say 'STORAGE_INLINE|failures=' || failures
  return failures
