cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER CLI CONSTRUCTED FIXTURES WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
function(run_checked _description)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE _status
    OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "${_description}: ${_status}\n${_stdout}${_stderr}")
  endif()
  set(_last_stdout "${_stdout}" PARENT_SCOPE)
  set(_last_stderr "${_stderr}" PARENT_SCOPE)
endfunction()
function(expect_output _expected)
  string(REPLACE "\r\n" "\n" _normalized "${_last_stdout}")
  string(STRIP "${_normalized}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Expected '${_expected}', got '${_actual}'")
  endif()
endfunction()
function(expect_policies _body _multiple)
  string(REGEX MATCHALL "(sigpush|sigbr|sigpop)[ \t]+[^\n]+" _rows "${_body}")
  set(_actual)
  foreach(_row IN LISTS _rows)
    string(REGEX REPLACE "[ \t]+" " " _row "${_row}")
    string(STRIP "${_row}" _row)
    list(APPEND _actual "${_row}")
  endforeach()
  if(_multiple)
    set(_expected "sigpush \"OUT_OF_RANGE\";sigpush \"INVALID_ARGUMENTS\";sigbr caught,\"OUT_OF_RANGE\";sigbr caught,\"INVALID_ARGUMENTS\";sigpop \"INVALID_ARGUMENTS\";sigpop \"OUT_OF_RANGE\";sigpop \"INVALID_ARGUMENTS\";sigpop \"OUT_OF_RANGE\"")
  else()
    set(_expected "sigpush \"OUT_OF_RANGE\";sigbr caught,\"OUT_OF_RANGE\";sigpop \"OUT_OF_RANGE\";sigpop \"OUT_OF_RANGE\"")
  endif()
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Named policy order changed: ${_actual}")
  endif()
endfunction()
run_checked("constructed named-signal proof" "${VM}" "${CONSTRUCTED}" ${RUNTIME})
if(NOT _last_stdout MATCHES "SIGNAL_INLINE[|]failures=0")
  message(FATAL_ERROR "Constructed signal proof: ${_last_stdout}${_last_stderr}")
endif()
foreach(_case normal fault dynamic-normal dynamic-fault dynamic-alias-normal dynamic-alias-fault
    multi-normal multi-fault multi-dynamic-alias-normal multi-dynamic-alias-fault)
  set(_source "${FIXTURES}/io-signal-${_case}.rxas")
  set(_multiple FALSE)
  string(REGEX REPLACE "^multi-" "" _value_case "${_case}")
  if(_case MATCHES "^multi-")
    set(_multiple TRUE)
  endif()
  set(_bounds "0,10")
  if(_value_case MATCHES "^dynamic-")
    set(_bounds "-5,5")
  endif()
  if(_value_case STREQUAL "normal")
    set(_expected "normal\n7\n7\n1")
  elseif(_value_case STREQUAL "fault")
    set(_expected "handler\n12\n99\n2")
  elseif(_value_case STREQUAL "dynamic-normal" OR _value_case STREQUAL "dynamic-alias-normal")
    set(_expected "normal\n0\n0\n1")
  elseif(_value_case STREQUAL "dynamic-fault")
    set(_expected "handler\n256\n99\n2")
  else()
    set(_expected "handler\n256\n256\n2")
  endif()
  file(READ "${_source}" _original)
  expect_policies("${_original}" "${_multiple}")
  run_checked("assemble original ${_case}" "${ASSEMBLER}" -n -o "${WORK}/original-${_case}" "${_source}")
  run_checked("execute original ${_case}" "${VM}" "${WORK}/original-${_case}.rxbin")
  expect_output("${_expected}")
  foreach(_mode conservative cleanup)
    set(_options)
    if(_mode STREQUAL "conservative")
      set(_options --no-cleanup)
    endif()
    set(_product "${WORK}/${_case}-${_mode}")
    run_checked("expand ${_case} ${_mode}" "${VM}" "${CLI}" ${RUNTIME} -a
      --module "io-signal-${_case}.rxas" --profile closed-main-default-halt.v1
      ${_options} -o "${_product}.rxas" "${_source}")
    if(_mode STREQUAL "cleanup" AND (NOT _last_stderr MATCHES "LL_CLEANUP_KEEP: transport.exceptional.cfg.pending"
        OR NOT _last_stderr MATCHES "LL_STORAGE_KEEP: storage.exceptional.cfg.pending"))
      message(FATAL_ERROR "Exceptional cleanup was not retained precisely: ${_last_stderr}")
    endif()
    file(READ "${_product}.rxas" _expanded)
    string(FIND "${_expanded}" "checked_identity()" _callee_start)
    if(_callee_start LESS 0)
      message(FATAL_ERROR "Selected ${_case} callee definition disappeared")
    endif()
    string(SUBSTRING "${_expanded}" 0 ${_callee_start} _main_body)
    expect_policies("${_main_body}" "${_multiple}")
    if(NOT _main_body MATCHES "[.]srcstep [0-9]+ [0-9]+ [0-9]+ \"named_signal[.]g\"[^\n]*\n[ \t]*ichkrng[ \t]+r[0-9]+,${_bounds}")
      message(FATAL_ERROR "Cloned ${_case} check lost its main-body source step")
    endif()
    if(NOT _main_body MATCHES "[.]traceevent[ \t]+\"F\"[^\n]*\"checked_identity\"")
      message(FATAL_ERROR "Expanded ${_case} lost its handwritten call TRACE record")
    endif()
    if(_expanded MATCHES "call1[ \t]+[^\n]*checked_identity")
      message(FATAL_ERROR "Selected ${_case} call survives")
    endif()
    string(REGEX MATCH "caught:[^:]*sigpop[ \t]+\"OUT_OF_RANGE\"" _entry "${_expanded}")
    string(REGEX MATCHALL "unlink[ \t]+r[0-9]+" _unlinks "${_entry}")
    string(REGEX MATCHALL "endlife[ \t]+r[0-9]+" _lifetimes "${_entry}")
    list(LENGTH _unlinks _unlink_count)
    list(LENGTH _lifetimes _lifetime_count)
    string(REGEX MATCHALL "sigpop[ \t]+\"OUT_OF_RANGE\"" _pops "${_expanded}")
    list(LENGTH _pops _pop_count)
    string(REGEX MATCHALL "sigpop[ \t]+\"INVALID_ARGUMENTS\"" _other_pops "${_expanded}")
    list(LENGTH _other_pops _other_pop_count)
    if((_multiple AND NOT _other_pop_count EQUAL 2) OR (NOT _multiple AND NOT _other_pop_count EQUAL 0))
      message(FATAL_ERROR "Missing or extra secondary policy restoration: ${_main_body}")
    endif()
    if(NOT _unlink_count EQUAL 2 OR NOT _lifetime_count EQUAL 2 OR NOT _pop_count EQUAL 2
        OR NOT _entry MATCHES "[.]meta[ \t]+\"checked_identity.value.[^\"]+\""
        OR NOT _expanded MATCHES "named_signal.g")
      message(FATAL_ERROR "Missing abrupt closure, policy pop or source: ${_entry}")
    endif()
    run_checked("assemble ${_case} ${_mode}" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
    run_checked("execute ${_case} ${_mode}" "${VM}" "${_product}.rxbin")
    expect_output("${_expected}")
  endforeach()
endforeach()

# Existing CLI publication must retain a good output when proof work fails.
foreach(_refusal_case dynamic-normal multi-dynamic-alias-normal)
  set(_published "${WORK}/${_refusal_case}-cleanup.rxas")
  file(READ "${_published}" _good)
  execute_process(COMMAND "${VM}" "${CLI}" ${RUNTIME} -a
    --module "io-signal-${_refusal_case}.rxas" --profile closed-main-default-halt.v1 --work 1
    -o "${_published}" "${FIXTURES}/io-signal-${_refusal_case}.rxas"
    RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
  file(READ "${_published}" _after)
  if(_status EQUAL 0 OR NOT _after STREQUAL _good OR NOT _stderr MATCHES "LL_INLINE_LIMIT")
    message(FATAL_ERROR "Failed signal proof did not preserve last-good output: ${_status} ${_stderr}")
  endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
message("RXAS_NAMED_SIGNAL|failures=0")
