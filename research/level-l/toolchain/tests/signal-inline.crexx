/* cREXX License (MIT). Independent constructed caller-owned signal scope. */
options levelb
import rxfnsb
import llir
import llirgraph
import lltarget
import lltargetfacts
import llinline
import llcleanup

check: procedure = .int
  arg condition = .int, message = .string
  if condition then return 0
  say 'FAIL:' message
  return 1
one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object
  return body.emit(name,fields,at)
two: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object
  return body.emit(name,fields,at)
three: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, third = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object; fields[3] = third as .object
  return body.emit(name,fields,at)
label: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, at = .llir..origin
  fields = .object[]; fields[1] = .lltarget..operand.symbol(name) as .object
  return body.record('label',fields,at)

model: procedure = .lltarget..module
  arg variant = .int, expose callid = .int, expose handlerid = .int
  draft = .lltarget..draft('signal.' || variant,'constructed.signal.' || variant,0)
  at = draft.synthetic('independent caller-owned named scope')
  root = draft.procedure('main',4,at); input = 7
  if variant = 1 then input = 12
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(input),at)
  ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(99),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(0),at)
  if variant = 6 then ignored = two(root,'mkref',root.reg('r',0),root.reg('r',1),at)
  name = 'sigpush'
  if variant = 2 then name = 'sigret'
  ignored = one(root,name,.lltarget..operand.string('OUT_OF_RANGE'),at)
  target = 'caught'
  if variant = 4 then target = 'missing'
  if variant = 5 then target = 'foreign'
  ignored = two(root,'sigbr',.lltarget..operand.symbol(target),.lltarget..operand.string('OUT_OF_RANGE'),at)
  name = 'call1'
  if variant = 7 then name = 'call'
  callid = three(root,name,root.reg('r',1),.lltarget..operand.procedure('checked_identity'),root.reg('r',0),at)
  if variant = 8 then ignored = two(root,'load',root.reg('r',3),.lltarget..operand.literal('B','0x00FF' as .binary),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(1),at)
  ignored = one(root,'sigpop',.lltarget..operand.string('OUT_OF_RANGE'),at)
  ignored = one(root,'br',.lltarget..operand.symbol('joined'),at)
  handlerid = label(root,'caught',at)
  ignored = one(root,'sigpop',.lltarget..operand.string('OUT_OF_RANGE'),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(2),at)
  ignored = one(root,'br',.lltarget..operand.symbol('joined'),at)
  ignored = label(root,'joined',at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('checked_identity',0,at)
  fields = .object[]; fields[1] = .lltarget..operand.string('value') as .object
  fields[2] = .lltarget..operand.string('b') as .object; fields[3] = .lltarget..operand.string('.int') as .object
  fields[4] = leaf.reg('a',1) as .object; ignored = leaf.record('.meta',fields,at)
  if variant = 3 then ignored = one(leaf,'sigignore',.lltarget..operand.string('OUT_OF_RANGE'),at)
  file = draft.source('named_signal.g','assembler ichkrng value,0,10' as .binary)
  fault = file.origin(0,28)
  ignored = three(leaf,'ichkrng',leaf.reg('a',1),.lltarget..operand.integer(0),.lltarget..operand.integer(10),fault)
  ignored = one(leaf,'ret',leaf.reg('a',1),at)
  fields = .object[]; fields[1] = .lltarget..operand.string('value') as .object
  ignored = leaf.record('.meta',fields,at)
  if variant = 5 then do
    other = draft.procedure('other',0,at); ignored = label(other,'foreign',at)
    ignored = one(other,'ret',.lltarget..operand.integer(0),at)
  end
  return draft.finish()

main: procedure = .int
  failures = 0; callid = .int; handlerid = .int
  expected = .string[]
  expected[3] = 'signal.inherited.return.pending'
  expected[4] = 'signal.callee.policy.pending'
  expected[7] = 'signal.storage.plain.unproved'
  expected[8] = 'signal.call.window.pending'
  expected[9] = 'signal.caller.failure.pending'
  do variant = 0 to 8
    original = model(variant,callid,handlerid)
    if variant = 4 | variant = 5 then do
      failures = failures + check(original.valid() = 0 & pos('LL_TARGET_BINDING: unresolved branch label',original.error()) > 0,'target rejects absent or foreign handler label ' || variant)
      iterate
    end
    failures = failures + check(original.valid(),'constructed signal owner ' || variant)
    if original.valid() = 0 then do; say original.error(); iterate; end
    graph = dereference original.ir(); before = graph.binary()
    request = llinline..bind(reference original,callid,reference original,original.procedureid('checked_identity'))
    changed = llinline..expand(request,'closed-main-default-halt.v1')
    if variant > 1 then do
      failures = failures + check(changed.status() = 'keep' & changed.reason() = expected[variant + 1],'precise signal keep ' || variant)
      if changed.reason() <> expected[variant + 1] then say changed.reason()
    end
    else do
      failures = failures + check(changed.status() = 'changed','named scope expands ' || variant)
      if changed.status() <> 'changed' then do; say changed.reason(); iterate; end
      facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
      failures = failures + check(facts.status() = 'ok' & facts.handlercall(handlerid) = callid & facts.handleroutcome(callid) = variant + 1,'exact-owner handler and outcome')
      access = dereference facts.access()
      failures = failures + check(access.complete(original.procedureid('main')) = 0,'normal-only access projection stays incomplete')
      result = changed.result(); instructions = 0; closure = 0; lifetimes = 0; clears = 0; inhandler = 0; source = 0
      do i = 1 to result.records()
        item = result.record(i)
        if item.procedureid() <> result.procedureid('main') then iterate
        if item.kind() = 'label' then do; field = item.operand(1); inhandler = field.text() = 'caught'; end
        if inhandler & item.kind() = '.meta' & item.operands() = 1 then clears = clears + 1
        if item.kind() <> 'instruction' then iterate
        if item.mnemonic() = 'call1' then instructions = instructions + 1
        if item.mnemonic() = 'ichkrng' then source = item.origin().filename() = 'named_signal.g'
        if inhandler then do
          if item.mnemonic() = 'sigpop' then inhandler = 0
          if item.mnemonic() = 'unlink' then closure = closure + 1
          if item.mnemonic() = 'endlife' then lifetimes = lifetimes + 1
        end
      end
      failures = failures + check(instructions = 0 & closure = 2 & lifetimes = 2 & clears = 1 & source,'fresh binding/metadata closure precedes original handler pop')
      cleaned = llcleanup..transport(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
      failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'transport.exceptional.cfg.pending','transport retains exceptional graph')
      cleaned = llcleanup..storage(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
      failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'storage.exceptional.cfg.pending','assignment retains exceptional graph')
      limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,67108864,65536,1)
      failures = failures + check(limited.status() = 'limit' & limited.reason() = 'inline.code.cells','signal expansion cell cap')
      kept = limited.result(); keptgraph = dereference kept.ir()
      failures = failures + check(bin2x(keptgraph.binary()) = bin2x(before),'cell refusal preserves frozen owner')
      limited = llinline..expand(request,'closed-main-default-halt.v1',1)
      failures = failures + check(limited.status() = 'limit','signal proof work cap')
      limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,128)
      failures = failures + check(limited.status() = 'limit','signal proof byte cap')
      limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,67108864,4)
      failures = failures + check(limited.status() = 'limit' & limited.reason() = 'inline.frame','signal expansion frame cap')
    end
    graph = dereference original.ir()
    failures = failures + check(bin2x(graph.binary()) = bin2x(before),'all signal paths preserve original source owner')
  end
  say 'SIGNAL_INLINE|failures=' || failures
  return failures
