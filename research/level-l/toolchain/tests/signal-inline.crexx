/* cREXX License (MIT). Independent constructed caller-owned signal scope. */
options levelb
import rxfnsb
import llir
import llirgraph
import lltarget
import lltargetfacts
import llinline
import llcleanup

check: procedure = .int
  arg condition = .int, message = .string
  if condition then return 0
  say 'FAIL:' message
  return 1
one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object
  return body.emit(name,fields,at)
two: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object
  return body.emit(name,fields,at)
three: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, third = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object; fields[3] = third as .object
  return body.emit(name,fields,at)
label: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, at = .llir..origin
  fields = .object[]; fields[1] = .lltarget..operand.symbol(name) as .object
  return body.record('label',fields,at)

model: procedure = .lltarget..module
  arg variant = .int, expose callid = .int, expose handlerid = .int
  draft = .lltarget..draft('signal.' || variant,'constructed.signal.' || variant,0)
  at = draft.synthetic('independent caller-owned named scope')
  root = draft.procedure('main',4,at); input = 7
  if variant = 1 | variant = 18 then input = 12
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(input),at)
  ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(99),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(0),at)
  if (variant >= 9 & variant <= 12) | variant = 14 | variant = 19 | variant = 20 then do
    flags = 0
    if variant = 10 | variant = 12 | variant = 20 then flags = 256
    ignored = two(root,'settp',root.reg('r',3),.lltarget..operand.integer(flags),at)
    /* GETANDTP deliberately publishes a defined, nonconstant integer fact
     * for both runtime status inputs. Neither test is constant-specialized. */
    ignored = three(root,'getandtp',root.reg('r',0),root.reg('r',3),.lltarget..operand.integer(256),at)
  end
  if variant = 6 then ignored = two(root,'mkref',root.reg('r',0),root.reg('r',1),at)
  name = 'sigpush'
  if variant = 2 then name = 'sigret'
  firsttag = 'OUT_OF_RANGE'; secondtag = 'INVALID_ARGUMENTS'
  multiple = variant >= 17 & variant <> 36
  if variant = 31 then secondtag = 'FAILURE'
  if variant = 32 then secondtag = 'CANCEL'
  if variant = 33 then secondtag = 'POSIX_INT'
  if variant = 34 then secondtag = 'CHANNEL_ERROR'
  if variant = 35 then secondtag = 'ERROR'
  if variant = 36 then firsttag = 'INVALID_ARGUMENTS'
  ignored = one(root,name,.lltarget..operand.string(firsttag),at)
  if variant = 22 then ignored = one(root,'sigpush',.lltarget..operand.string(firsttag),at)
  if variant = 39 then ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(0),at)
  if multiple & variant <> 21 & variant <> 28 then ignored = one(root,'sigpush',.lltarget..operand.string(secondtag),at)
  target = 'caught'
  if variant = 4 then target = 'missing'
  if variant = 5 then target = 'foreign'
  if variant = 40 then ignored = two(root,'sigbr',.lltarget..operand.symbol(target),.lltarget..operand.string(secondtag),at)
  ignored = two(root,'sigbr',.lltarget..operand.symbol(target),.lltarget..operand.string(firsttag),at)
  if variant = 28 then ignored = one(root,'sigpush',.lltarget..operand.string(secondtag),at)
  if multiple & variant <> 23 & variant <> 40 then do
    secondhandler = target
    if variant = 29 then secondhandler = 'joined'
    ignored = two(root,'sigbr',.lltarget..operand.symbol(secondhandler),.lltarget..operand.string(secondtag),at)
    if variant = 24 then ignored = two(root,'sigbr',.lltarget..operand.symbol(secondhandler),.lltarget..operand.string(secondtag),at)
  end
  if variant = 30 then ignored = label(root,'alternate',at)
  name = 'call1'
  if variant = 7 then name = 'call'
  destination = root.reg('r',1); actual = root.reg('r',0)
  if variant = 11 | variant = 12 | variant = 19 | variant = 20 then destination = root.reg('r',0)
  if variant = 15 then actual = root.reg('a',1)
  callid = three(root,name,destination,.lltarget..operand.procedure('checked_identity'),actual,at)
  if variant = 8 then ignored = two(root,'load',root.reg('r',3),.lltarget..operand.literal('B','0x00FF' as .binary),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(1),at)
  if variant = 14 then ignored = three(root,'numsci',.lltarget..operand.integer(20),.lltarget..operand.integer(1),.lltarget..operand.integer(1),at)
  if variant = 25 then ignored = one(root,'sigpop',.lltarget..operand.string(firsttag),at)
  if multiple & variant <> 27 then ignored = one(root,'sigpop',.lltarget..operand.string(secondtag),at)
  if variant = 37 then ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(1),at)
  if variant <> 25 then ignored = one(root,'sigpop',.lltarget..operand.string(firsttag),at)
  ignored = one(root,'br',.lltarget..operand.symbol('joined'),at)
  handlerid = label(root,'caught',at)
  if variant = 26 then ignored = one(root,'sigpop',.lltarget..operand.string(firsttag),at)
  if multiple then ignored = one(root,'sigpop',.lltarget..operand.string(secondtag),at)
  if variant = 38 then ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(0),at)
  if variant <> 26 then ignored = one(root,'sigpop',.lltarget..operand.string(firsttag),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(2),at)
  if variant = 14 then ignored = three(root,'numsci',.lltarget..operand.integer(21),.lltarget..operand.integer(1),.lltarget..operand.integer(1),at)
  ignored = one(root,'br',.lltarget..operand.symbol('joined'),at)
  ignored = label(root,'joined',at)
  /* Reads after the join retain both the conditional result and path marker. */
  ignored = two(root,'copy',root.reg('r',3),destination,at)
  ignored = two(root,'copy',root.reg('r',3),root.reg('r',2),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('checked_identity',0,at)
  fields = .object[]; fields[1] = .lltarget..operand.string('value') as .object
  fields[2] = .lltarget..operand.string('b') as .object; fields[3] = .lltarget..operand.string('.int') as .object
  fields[4] = leaf.reg('a',1) as .object; ignored = leaf.record('.meta',fields,at)
  if variant = 3 then ignored = one(leaf,'sigignore',.lltarget..operand.string('OUT_OF_RANGE'),at)
  low = 0; high = 10
  if (variant >= 9 & variant <= 16) | variant = 19 | variant = 20 then do; low = -5; high = 5; end
  if variant = 13 then do; low = 7; high = 7; end
  if variant = 16 then do; low = 5; high = -5; end
  checktext = 'assembler ichkrng value,' || low || ',' || high
  file = draft.source('named_signal.g',checktext as .binary)
  fault = file.origin(0,length(checktext))
  ignored = three(leaf,'ichkrng',leaf.reg('a',1),.lltarget..operand.integer(low),.lltarget..operand.integer(high),fault)
  ignored = one(leaf,'ret',leaf.reg('a',1),at)
  fields = .object[]; fields[1] = .lltarget..operand.string('value') as .object
  ignored = leaf.record('.meta',fields,at)
  if variant = 5 then do
    other = draft.procedure('other',0,at); ignored = label(other,'foreign',at)
    ignored = one(other,'ret',.lltarget..operand.integer(0),at)
  end
  return draft.finish()

/** Independent complete unbound scope. The list is executable RXAS policy,
 * with no producer-side effect/ownership annotation. */
catchmodel: procedure = .lltarget..module
  arg variant = .int, expose callid = .int, expose handlerid = .int
  i = .int
  draft = .lltarget..draft('catchall.' || variant,'constructed.catchall.' || variant,0)
  at = draft.synthetic('independent complete unbound G scope')
  root = draft.procedure('main',4,at)
  tags = 'FAILURE ERROR OVERFLOW_UNDERFLOW DIVISION_BY_ZERO CONVERSION_ERROR INVALID_ARGUMENTS OUT_OF_RANGE UNICODE_ERROR REFERENCE_INVALID OBJECT_NOT_INITIALIZED RXBIN_CORRUPTION UNKNOWN_INSTRUCTION FUNCTION_NOT_FOUND NOT_IMPLEMENTED INVALID_SIGNAL_CODE NOTREADY CANCEL QUIT TERM POSIX_INT POSIX_HUP POSIX_USR1 POSIX_USR2 POSIX_CHLD CHANNEL_ERROR TASK_FAILURE CLASSIC_SYNTAX CLASSIC_CONDITION OTHER'
  input = 7
  if variant = 1 then input = 12
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(input),at)
  ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(99),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(0),at)
  if variant >= 2 & variant <= 5 then do
    flags = 0
    if variant = 3 | variant = 5 then flags = 256
    ignored = two(root,'settp',root.reg('r',3),.lltarget..operand.integer(flags),at)
    ignored = three(root,'getandtp',root.reg('r',0),root.reg('r',3),.lltarget..operand.integer(256),at)
  end
  if variant = 13 then ignored = two(root,'mkref',root.reg('r',0),root.reg('r',1),at)
  do i = 1 to words(tags)
    ignored = one(root,'sigpush',.lltarget..operand.string(word(tags,i)),at)
    if i = 1 & variant = 7 then ignored = one(root,'sigpush',.lltarget..operand.string(word(tags,i)),at)
    if i = 1 & variant = 8 then ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(0),at)
  end
  do i = 1 to words(tags)
    if i = 1 & variant = 6 then iterate
    target = 'caught'
    if i = 2 & variant = 9 then target = 'joined'
    if i = 1 & variant = 10 then ignored = three(root,'sigbrv',.lltarget..operand.symbol(target),root.reg('r',3),.lltarget..operand.string(word(tags,i)),at)
    else ignored = two(root,'sigbr',.lltarget..operand.symbol(target),.lltarget..operand.string(word(tags,i)),at)
  end
  if variant = 14 then ignored = label(root,'alternate',at)
  destination = root.reg('r',1)
  if variant = 4 | variant = 5 then destination = root.reg('r',0)
  callid = three(root,'call1',destination,.lltarget..operand.procedure('checked_identity'),root.reg('r',0),at)
  if variant = 15 then ignored = one(root,'sigpush',.lltarget..operand.string('CANCEL'),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(1),at)
  do i = words(tags) to 1 by -1
    ignored = one(root,'sigpop',.lltarget..operand.string(word(tags,i)),at)
  end
  ignored = one(root,'br',.lltarget..operand.symbol('joined'),at)
  handlerid = label(root,'caught',at)
  do i = words(tags) to 1 by -1
    ignored = one(root,'sigpop',.lltarget..operand.string(word(tags,i)),at)
  end
  /* Observe the interrupted result/flag before any handler overwrite. */
  ignored = two(root,'copy',root.reg('r',3),destination,at)
  ignored = two(root,'copy',root.reg('r',3),root.reg('r',2),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(2),at)
  ignored = one(root,'br',.lltarget..operand.symbol('joined'),at)
  ignored = label(root,'joined',at)
  ignored = two(root,'copy',root.reg('r',3),destination,at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('checked_identity',0,at)
  fields = .object[]; fields[1] = .lltarget..operand.string('value') as .object
  fields[2] = .lltarget..operand.string('b') as .object; fields[3] = .lltarget..operand.string('.int') as .object
  source = leaf.reg('a',1)
  if variant = 12 then source = leaf.reg('a',0)
  fields[4] = source as .object; ignored = leaf.record('.meta',fields,at)
  if variant = 11 then ignored = one(leaf,'sigignore',.lltarget..operand.string('CANCEL'),at)
  ignored = three(leaf,'ichkrng',leaf.reg('a',1),.lltarget..operand.integer(0),.lltarget..operand.integer(10),at)
  ignored = one(leaf,'ret',leaf.reg('a',1),at)
  fields = .object[]; fields[1] = .lltarget..operand.string('value') as .object
  ignored = leaf.record('.meta',fields,at)
  return draft.finish()

boundprojection: procedure = .void
  arg root = .lltarget..bodydraft, kind = .int, output = .int, event = .int, raw = .int, field = .int, variant = .int, at = .llir..origin
  ignored = three(root,'linkattr1',root.reg('r',raw),root.reg('r',event),.lltarget..operand.integer(5),at)
  index = .lltarget..operand.integer(kind)
  if variant = 13 & kind = 1 then index = .lltarget..operand.integer(2)
  if variant = 14 & kind = 1 then index = root.reg('r',3)
  ignored = three(root,'linkattr1',root.reg('r',field),root.reg('r',raw),index,at)
  name = 'copy'; if kind = 5 & variant <> 15 then name = 'scopy'
  ignored = two(root,name,root.reg('r',output),root.reg('r',field),at)
  if variant = 12 & kind = 1 then ignored = one(root,'null',root.reg('r',field),at)
  ignored = one(root,'unlink',root.reg('r',field),at)
  ignored = one(root,'unlink',root.reg('r',raw),at)
  ignored = one(root,'null',root.reg('r',field),at)
  ignored = one(root,'null',root.reg('r',raw),at)
  return

boundmodel: procedure = .lltarget..module
  arg variant = .int, expose callid = .int, expose handlerid = .int
  draft = .lltarget..draft('bound.' || variant,'constructed.bound.' || variant,0)
  at = draft.synthetic('caller-owned bound event and exact restored consumers')
  root = draft.procedure('main',12,at); i = .int
  tags = 'FAILURE ERROR OVERFLOW_UNDERFLOW DIVISION_BY_ZERO CONVERSION_ERROR INVALID_ARGUMENTS OUT_OF_RANGE UNICODE_ERROR REFERENCE_INVALID OBJECT_NOT_INITIALIZED RXBIN_CORRUPTION UNKNOWN_INSTRUCTION FUNCTION_NOT_FOUND NOT_IMPLEMENTED INVALID_SIGNAL_CODE NOTREADY CANCEL QUIT TERM POSIX_INT POSIX_HUP POSIX_USR1 POSIX_USR2 POSIX_CHLD CHANNEL_ERROR TASK_FAILURE CLASSIC_SYNTAX CLASSIC_CONDITION OTHER'
  event = 4; raw = 5; field = 6; code = 7
  if variant = 7 then event = 0
  if variant = 8 then code = 0
  if variant = 9 then field = raw
  input = 3; if variant = 1 then input = 12
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(input),at)
  ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(99),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(0),at)
  if variant >= 2 & variant <= 5 then do
    flags = 0; if variant = 3 | variant = 5 then flags = 256
    ignored = two(root,'settp',root.reg('r',3),.lltarget..operand.integer(flags),at)
    ignored = three(root,'getandtp',root.reg('r',0),root.reg('r',3),.lltarget..operand.integer(256),at)
  end
  if variant <> 11 then ignored = one(root,'null',root.reg('r',event),at)
  ignored = two(root,'load',root.reg('r',event),.lltarget..operand.integer(321),at)
  if variant <> 10 then ignored = one(root,'null',root.reg('r',raw),at)
  ignored = one(root,'null',root.reg('r',field),at)
  ignored = two(root,'load',root.reg('r',7),.lltarget..operand.integer(55),at)
  ignored = two(root,'load',root.reg('r',8),.lltarget..operand.string('preloaded-name'),at)
  ignored = two(root,'load',root.reg('r',9),.lltarget..operand.integer(77),at)
  ignored = two(root,'load',root.reg('r',9),.lltarget..operand.string('preloaded-message'),at)
  ignored = two(root,'settp',root.reg('r',9),.lltarget..operand.integer(256),at)
  if variant = 23 then ignored = two(root,'link',root.reg('r',raw),root.reg('r',3),at)
  do i = 1 to words(tags); ignored = one(root,'sigpush',.lltarget..operand.string(word(tags,i)),at); end
  do i = 1 to words(tags)
    if variant = 18 & i = 1 then ignored = two(root,'sigbr',.lltarget..operand.symbol('caught'),.lltarget..operand.string(word(tags,i)),at)
    else do
      destination = event; if variant = 19 & i = 2 then destination = 3
      ignored = three(root,'sigbrv',.lltarget..operand.symbol('caught'),root.reg('r',destination),.lltarget..operand.string(word(tags,i)),at)
    end
  end
  result = 1; if variant = 4 | variant = 5 then result = 0
  callid = three(root,'call1',root.reg('r',result),.lltarget..operand.procedure('checked_identity'),root.reg('r',0),at)
  if variant = 20 then ignored = one(root,'sigpush',.lltarget..operand.string('CANCEL'),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(1),at)
  do i = words(tags) to 1 by -1; ignored = one(root,'sigpop',.lltarget..operand.string(word(tags,i)),at); end
  ignored = one(root,'br',.lltarget..operand.symbol('joined'),at)
  handlerid = label(root,'caught',at)
  do i = words(tags) to 1 by -1; ignored = one(root,'sigpop',.lltarget..operand.string(word(tags,i)),at); end
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(2),at)
  if variant = 22 then ignored = label(root,'alternate',at)
  if variant = 16 then do
    fields = .object[]; fields[1] = .lltarget..operand.string('escaped-field') as .object; fields[2] = .lltarget..operand.string('b') as .object
    fields[3] = .lltarget..operand.string('.int') as .object; fields[4] = root.reg('r',field) as .object
    ignored = root.record('.meta',fields,at)
  end
  if variant = 17 then ignored = two(root,'copy',root.reg('r',10),root.reg('r',event),at)
  if variant <> 6 then do
    call boundprojection(root,1,code,event,raw,field,variant,at)
    call boundprojection(root,4,8,event,raw,field,variant,at)
    call boundprojection(root,5,9,event,raw,field,variant,at)
  end
  ignored = one(root,'null',root.reg('r',event),at)
  ignored = one(root,'br',.lltarget..operand.symbol('joined'),at)
  ignored = label(root,'joined',at)
  if variant = 24 then ignored = two(root,'copy',root.reg('r',10),root.reg('r',9),at)
  else ignored = two(root,'icopy',root.reg('r',10),root.reg('r',9),at)
  ignored = three(root,'getandtp',root.reg('r',11),root.reg('r',9),.lltarget..operand.integer(768),at)
  ignored = two(root,'copy',root.reg('r',10),root.reg('r',8),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('checked_identity',0,at)
  if variant = 21 then ignored = three(leaf,'iadd',leaf.reg('a',1),leaf.reg('a',1),.lltarget..operand.integer(1),at)
  ignored = three(leaf,'ichkrng',leaf.reg('a',1),.lltarget..operand.integer(-5),.lltarget..operand.integer(5),at)
  ignored = one(leaf,'ret',leaf.reg('a',1),at)
  return draft.finish()

boundcontrols: procedure = .int
  failures = 0; variant = .int; callid = .int; handlerid = .int; i = .int; mode = .int
  original = .lltarget..module; result = .lltarget..module; request = .llinline..binding
  changed = .llinline..change; facts = .lltargetfacts..analysis; cleaned = .llinline..change
  item = .lltarget..record; expected = .string[]
  limited = .llinline..change
  expected[7] = 'signal.bound.mapping.pending'; expected[8] = expected[7]; expected[9] = expected[7]
  expected[10] = 'signal.bound.state.unproved'; expected[11] = expected[10]
  do i = 12 to 17; expected[i] = 'signal.bound.consumer.pending'; end
  expected[17] = 'signal.snapshot.consumer.pending'
  expected[18] = 'signal.bound.handler.pending'; expected[19] = 'signal.bound.mapping.pending'
  expected[20] = 'signal.named.push.order.pending'; expected[21] = 'signal.callee.operation.pending'
  expected[22] = 'signal.named.entry.pending'; expected[23] = 'signal.bound.mapping.pending'; expected[24] = 'signal.bound.state.unproved'
  do variant = 0 to 24
    original = boundmodel(variant,callid,handlerid)
    failures = failures + check(original.valid(),'bound event model verifies ' || variant)
    if original.valid() = 0 then iterate
    request = llinline..bind(reference original,callid,reference original,original.procedureid('checked_identity'))
    changed = llinline..expand(request,'closed-main-default-halt.v1',12000000)
    if variant <= 6 then do
      failures = failures + check(changed.status() = 'changed','complete bound event lane expands ' || variant)
      if changed.status() <> 'changed' then do; say changed.reason(); iterate; end
      facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1',12000000)
      failures = failures + check(facts.status() = 'ok' & facts.handlerdirect(callid),'bound event lane shares direct read-only transport ' || variant)
      result = changed.result(); calls = 0; attributes = 0; lifetimes = 0; policies = 0
      do i = 1 to result.records()
        item = result.record(i)
        if item.procedureid() <> result.procedureid('main') | item.kind() <> 'instruction' then iterate
        if item.mnemonic() = 'call1' then calls = calls + 1
        if item.mnemonic() = 'linkattr1' then attributes = attributes + 1
        if item.mnemonic() = 'endlife' then lifetimes = lifetimes + 1
        if wordpos(item.mnemonic(),'sigpush sigbrv sigpop') > 0 then policies = policies + 1
      end
      extent = 6; if variant = 6 then extent = 0
      failures = failures + check(result.body(result.procedureid('main')).locals() = 12 & calls = 0 & attributes = extent & lifetimes = 0 & policies = 116,'bound policies, consumers and frame remain intact ' || variant)
      cleaned = llcleanup..transport(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
      failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'transport.exceptional.cfg.pending','bound consumer transport stays exceptional')
      cleaned = llcleanup..storage(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
      failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'storage.exceptional.cfg.pending','bound consumer storage stays exceptional')
    end
    else do
      failures = failures + check(changed.status() = 'keep' & changed.reason() = expected[variant] & changed.result().identity() = original.identity(),'specific atomic bound refusal ' || variant)
      if changed.reason() <> expected[variant] then say changed.reason()
    end
  end
  original = boundmodel(0,callid,handlerid); identity = original.identity()
  request = llinline..bind(reference original,callid,reference original,original.procedureid('checked_identity'))
  do mode = 1 to 4
    select mode
      when 1 then limited = llinline..expand(request,'closed-main-default-halt.v1',1)
      when 2 then limited = llinline..expand(request,'closed-main-default-halt.v1',12000000,1)
      when 3 then limited = llinline..expand(request,'closed-main-default-halt.v1',12000000,1000000,64)
      otherwise limited = llinline..expand(request,'closed-main-default-halt.v1',12000000,1000000,67108864,65536,1)
    end
    failures = failures + check(limited.status() = 'limit' & limited.result().identity() = identity,'bound event resource refusal is atomic ' || mode)
  end
  changed = llinline..expand(request,'closed-main-default-halt.v1',12000000)
  failures = failures + check(changed.status() = 'changed' & original.identity() = identity,'bound event replays after refused requests')
  return failures

snapshotcapture: procedure = .void
  arg root = .lltarget..bodydraft, saved = .int, variant = .int, at = .llir..origin
  if variant = 24 then ignored = one(root,'null',root.reg('r',4),at)
  name = 'copy'; if variant = 19 then name = 'move'
  target = root.reg('r',saved); if variant = 27 then target = root.reg('a',0)
  ignored = two(root,name,target,root.reg('r',4),at)
  if variant = 14 then ignored = two(root,'copy',target,root.reg('r',4),at)
  if variant = 6 then ignored = one(root,'null',root.reg('r',4),at)
  if variant = 20 then ignored = two(root,'copy',root.reg('r',10),target,at)
  return

/** Independent record producer adds one authored owned capture to the
 * maintained bound scope; it never calls the pass to construct an oracle. */
snapshotmodel: procedure = .lltarget..module
  arg variant = .int, expose callid = .int, expose handlerid = .int
  ignored = .int
  base = 0; if variant <= 5 then base = variant
  if variant = 7 then base = 1
  if variant = 25 then base = 13
  source = boundmodel(base,callid,handlerid); oldcall = callid; oldhandler = handlerid
  draft = .lltarget..draft('snapshot.' || variant,'constructed.snapshot.' || variant,0)
  at = draft.synthetic('authored post-pop owned runtime-event capture')
  saved = 12
  if variant = 9 then saved = 0
  if variant = 10 then saved = 4
  if variant = 11 then saved = 7
  prelude = 0; captured = 0; bodies = .object[]
  item = .lltarget..record; body = .lltarget..bodydraft; value = .lltarget..operand; oldbody = .lltarget..body
  i = .int; id = .int; fields = .object[]
  do i = 1 to source.records()
    item = source.record(i)
    if item.kind() = 'procedure' then do
      oldbody = source.body(item.procedureid()); extent = oldbody.locals()
      if oldbody.name() = 'main' then extent = 13
      body = draft.procedure(oldbody.name(),extent,at,oldbody.expose()); bodies[item.procedureid()] = body as .object
      iterate
    end
    if item.procedureid() = 0 then do
      call objectarraydrop fields
      do j = 1 to item.operands(); fields[j] = item.operand(j) as .object; end
      ignored = draft.record(item.kind(),fields,at); iterate
    end
    body = bodies[item.procedureid()] as .lltarget..bodydraft
    fields = llinline..clonefields(item,body)
    if source.body(item.procedureid()).name() = 'main' & item.kind() = 'instruction' then do
      if prelude = 0 & item.mnemonic() = 'sigpush' then do
        if variant <> 12 then ignored = one(body,'null',body.reg('r',saved),at)
        if variant = 13 then ignored = two(body,'load',body.reg('r',saved),.lltarget..operand.integer(0),at)
        if variant = 22 then do
          ignored = two(body,'setattrs',body.reg('r',saved),.lltarget..operand.integer(1),at)
          ignored = three(body,'linkattr1',body.reg('r',6),body.reg('r',saved),.lltarget..operand.integer(1),at)
        end
        if variant = 23 then ignored = two(body,'link',body.reg('r',saved),body.reg('r',3),at)
        prelude = 1
      end
      if item.mnemonic() = 'linkattr1' then do
        value = item.operand(2)
        if value.bank() = 'r' & value.index() = 4 then do
          if captured = 0 then do
            call snapshotcapture(body,saved,variant,at); captured = 1
            if variant = 18 then ignored = one(body,'null',body.reg('r',saved),at)
          end
          fields[2] = body.reg('r',saved) as .object
        end
      end
      if item.mnemonic() = 'null' then do
        value = item.operand(1)
        if value.bank() = 'r' & value.index() = 4 & item.id() > oldcall then do
          if variant = 21 then ignored = three(body,'linkattr1',body.reg('r',10),body.reg('r',saved),.lltarget..operand.integer(5),at)
          if variant <> 6 & variant <> 15 then ignored = one(body,'null',body.reg('r',4),at)
          if variant <> 16 & variant <> 18 then do
            name = 'null'; if variant = 17 then name = 'endlife'
            ignored = one(body,name,body.reg('r',saved),at)
          end
          if variant = 7 then do
            ignored = one(body,'endlife',body.reg('r',4),at)
            ignored = one(body,'endlife',body.reg('r',saved),at)
          end
          iterate
        end
      end
    end
    if item.kind() = 'instruction' then id = body.emit(item.mnemonic(),fields,at)
    else id = body.record(item.kind(),fields,at)
    if item.id() = oldcall then callid = id
    if item.id() = oldhandler then do
      handlerid = id
      if variant = 8 then do; call snapshotcapture(body,saved,variant,at); captured = 1; end
    end
  end
  return draft.finish()

snapshotcontrols: procedure = .int
  failures = 0; variant = .int; callid = .int; handlerid = .int; i = .int; mode = .int
  identity = .int
  original = .lltarget..module; result = .lltarget..module; request = .llinline..binding
  changed = .llinline..change; limited = .llinline..change; cleaned = .llinline..change
  item = .lltarget..record; value = .lltarget..operand; source = .lltarget..operand
  expected = .string[]
  expected[8] = 'signal.snapshot.phase.pending'
  do i = 9 to 11; expected[i] = 'signal.snapshot.mapping.pending'; end
  expected[12] = 'signal.snapshot.state.unproved'; expected[13] = expected[12]
  expected[14] = 'signal.snapshot.consumer.pending'
  do i = 15 to 18; expected[i] = 'signal.snapshot.cleanup.pending'; end
  expected[19] = 'signal.snapshot.consumer.pending'; expected[20] = expected[19]
  do i = 21 to 23; expected[i] = 'signal.snapshot.mapping.pending'; end
  expected[24] = 'signal.snapshot.cleanup.pending'; expected[25] = 'signal.snapshot.consumer.pending'
  expected[27] = 'signal.snapshot.mapping.pending'
  do variant = 0 to 27
    if variant = 26 then iterate
    original = snapshotmodel(variant,callid,handlerid)
    failures = failures + check(original.valid(),'owned event model verifies ' || variant)
    if original.valid() = 0 then do; say original.error(); iterate; end
    identity = original.identity()
    request = llinline..bind(reference original,callid,reference original,original.procedureid('checked_identity'))
    changed = llinline..expand(request,'closed-main-default-halt.v1',12000000)
    if variant <= 7 then do
      failures = failures + check(changed.status() = 'changed','owned event capture expands ' || variant)
      if changed.status() <> 'changed' then do; say changed.reason(); iterate; end
      result = changed.result(); captures = 0; calls = 0; projections = 0; closed = 0; lifetimes = 0
      do i = 1 to result.records()
        item = result.record(i)
        if item.procedureid() <> result.procedureid('main') | item.kind() <> 'instruction' then iterate
        if item.mnemonic() = 'call1' then calls = calls + 1
        if item.mnemonic() = 'copy' then do
          value = item.operand(1); source = item.operand(2)
          if value.bank() = 'r' & value.index() = 12 & source.bank() = 'r' & source.index() = 4 then captures = captures + 1
        end
        if item.mnemonic() = 'linkattr1' then do
          source = item.operand(2)
          if source.bank() = 'r' & source.index() = 12 then projections = projections + 1
        end
        if item.mnemonic() = 'null' then do
          value = item.operand(1)
          if value.bank() = 'r' & value.index() = 12 then closed = closed + 1
        end
        if item.mnemonic() = 'endlife' then lifetimes = lifetimes + 1
      end
      expectedlifetimes = 0; if variant = 7 then expectedlifetimes = 2
      failures = failures + check(result.body(result.procedureid('main')).locals() = 13 & calls = 0 & captures = 1 & projections = 3 & closed = 2 & lifetimes = expectedlifetimes,'one authored event COPY and both resets survive without added cells ' || variant)
      cleaned = llcleanup..transport(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
      failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'transport.exceptional.cfg.pending','owned event transport remains exceptional')
      cleaned = llcleanup..storage(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
      failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'storage.exceptional.cfg.pending','owned event storage remains exceptional')
    end
    else do
      failures = failures + check(changed.status() = 'keep' & changed.reason() = expected[variant] & changed.result().identity() = identity,'precise owned-event refusal ' || variant)
      if changed.reason() <> expected[variant] then say changed.reason()
    end
  end
  original = snapshotmodel(0,callid,handlerid); identity = original.identity()
  request = llinline..bind(reference original,callid,reference original,original.procedureid('checked_identity'))
  do mode = 1 to 4
    select mode
      when 1 then limited = llinline..expand(request,'closed-main-default-halt.v1',1)
      when 2 then limited = llinline..expand(request,'closed-main-default-halt.v1',12000000,1)
      when 3 then limited = llinline..expand(request,'closed-main-default-halt.v1',12000000,1000000,64)
      otherwise limited = llinline..expand(request,'closed-main-default-halt.v1',12000000,1000000,67108864,65536,1)
    end
    failures = failures + check(limited.status() = 'limit' & limited.result().identity() = identity,'owned-event cap preserves exact caller ' || mode)
  end
  changed = llinline..expand(request,'closed-main-default-halt.v1',12000000)
  failures = failures + check(changed.status() = 'changed' & original.identity() = identity,'owned event replay after refusals')
  return failures

main: procedure = .int
  failures = 0; callid = .int; handlerid = .int
  i = .int; item = .lltarget..record; field = .lltarget..operand
  variant = .int; outcome = .int; instructions = .int; closure = .int; inhandler = .int
  original = .lltarget..module; result = .lltarget..module; kept = .lltarget..module
  before = .binary
  request = .llinline..binding; changed = .llinline..change
  cleaned = .llinline..change; limited = .llinline..change; facts = .lltargetfacts..analysis
  expected = .string[]
  expected[3] = 'signal.inherited.return.pending'
  expected[4] = 'signal.callee.policy.pending'
  expected[7] = 'signal.storage.plain.unproved'
  expected[8] = 'signal.call.window.pending'
  expected[9] = 'signal.caller.failure.pending'
  /* NUMSCI can fail before the join; this profile rejects that caller shape. */
  expected[15] = 'signal.caller.failure.pending'
  expected[16] = 'signal.argument.value.unproved'
  expected[22] = 'signal.named.install.mismatch.pending'
  expected[23] = 'signal.named.push.duplicate.pending'
  expected[24] = 'signal.named.install.missing.pending'
  expected[25] = 'signal.named.install.duplicate.pending'
  expected[26] = 'signal.named.normal.pop.order.pending'
  expected[27] = 'signal.named.handler.pop.order.pending'
  expected[28] = 'signal.named.pop.count.pending'
  expected[29] = 'signal.named.push.order.pending'
  expected[30] = 'signal.handler.mismatch.pending'
  expected[31] = 'signal.named.entry.pending'
  expected[32] = 'signal.activation.failure.pending'
  expected[33] = 'signal.asynchronous.tag.pending'
  expected[34] = 'signal.asynchronous.tag.pending'
  expected[35] = 'signal.event.delivery.pending'
  expected[36] = 'signal.named.tag.pending'
  expected[37] = 'signal.named.range.missing.pending'
  expected[38] = 'signal.named.normal.pop.interleaved.pending'
  expected[39] = 'signal.named.handler.pop.interleaved.pending'
  expected[40] = 'signal.named.setup.pending'
  do variant = 0 to 40
    graph = .llir..module
    original = model(variant,callid,handlerid)
    if variant = 4 | variant = 5 then do
      failures = failures + check(original.valid() = 0 & pos('LL_TARGET_BINDING: unresolved branch label',original.error()) > 0,'target rejects absent or foreign handler label ' || variant)
      iterate
    end
    failures = failures + check(original.valid(),'constructed signal owner ' || variant)
    if original.valid() = 0 then do; say original.error(); iterate; end
    graph = dereference original.ir(); before = graph.binary()
    request = llinline..bind(reference original,callid,reference original,original.procedureid('checked_identity'))
    changed = llinline..expand(request,'closed-main-default-halt.v1')
    if (variant > 1 & variant < 9) | variant = 14 | variant = 15 | (variant >= 21 & variant <= 39) then do
      failures = failures + check(changed.status() = 'keep' & changed.reason() = expected[variant + 1],'precise signal keep ' || variant)
      if changed.reason() <> expected[variant + 1] then say changed.reason()
      keptgraph = .llir..module
      kept = changed.result(); keptgraph = dereference kept.ir()
      failures = failures + check(bin2x(keptgraph.binary()) = bin2x(before),'signal keep returns exact frozen caller ' || variant)
    end
    else do
      failures = failures + check(changed.status() = 'changed','named scope expands ' || variant)
      if changed.status() <> 'changed' then do; say changed.reason(); iterate; end
      facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
      outcome = variant + 1
      if variant >= 9 & variant <= 12 then outcome = 3
      if variant = 13 then outcome = 1
      if variant = 16 then outcome = 2
      if variant = 17 | variant = 40 then outcome = 1
      if variant = 18 then outcome = 2
      if variant = 19 | variant = 20 then outcome = 3
      failures = failures + check(facts.status() = 'ok' & facts.handlercall(handlerid) = callid & facts.handleroutcome(callid) = outcome,'exact-owner handler and feasible outcomes ' || variant)
      access = dereference facts.access()
      failures = failures + check(access.complete(original.procedureid('main')) = 0,'normal-only access projection stays incomplete')
      if outcome <> 1 then do
        cell = 2
        if variant = 11 | variant = 12 | variant = 19 | variant = 20 then cell = 1
        failures = failures + check(access.kills(callid,facts.integerdomain(cell)) = 0 & access.kills(callid,facts.wholedomain(cell)) = 0,'failure preserves result; no definite kill ' || variant)
      end
      result = changed.result(); instructions = 0; closure = 0; lifetimes = 0; clears = 0; inhandler = 0; source = 0
      policy = .string; originalpolicy = .string
      do i = 1 to original.records()
        item = original.record(i)
        if item.procedureid() <> original.procedureid('main') | item.kind() <> 'instruction' then iterate
        if wordpos(item.mnemonic(),'sigpush sigbr sigpop') = 0 then iterate
        field = item.operand(item.operands()); originalpolicy = originalpolicy || item.mnemonic() || ':' || field.text() || ';'
      end
      do i = 1 to result.records()
        item = result.record(i)
        if item.procedureid() <> result.procedureid('main') then iterate
        if item.kind() = 'label' then do; field = item.operand(1); inhandler = field.text() = 'caught'; end
        if inhandler & item.kind() = '.meta' & item.operands() = 1 then clears = clears + 1
        if item.kind() <> 'instruction' then iterate
        if wordpos(item.mnemonic(),'sigpush sigbr sigpop') > 0 then do
          field = item.operand(item.operands()); policy = policy || item.mnemonic() || ':' || field.text() || ';'
        end
        if item.mnemonic() = 'call1' then instructions = instructions + 1
        if item.mnemonic() = 'ichkrng' then source = item.origin().filename() = 'named_signal.g'
        if inhandler then do
          if item.mnemonic() = 'sigpop' then inhandler = 0
          if item.mnemonic() = 'unlink' then closure = closure + 1
          if item.mnemonic() = 'endlife' then lifetimes = lifetimes + 1
        end
      end
      failures = failures + check(instructions = 0 & closure = 2 & lifetimes = 2 & clears = 1 & source,'fresh binding/metadata closure precedes original handler pop')
      failures = failures + check(policy = originalpolicy,'all named policies retain original push/install/reverse-pop order ' || variant)
      cleaned = llcleanup..transport(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
      failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'transport.exceptional.cfg.pending','transport retains exceptional graph')
      cleaned = llcleanup..storage(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
      failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'storage.exceptional.cfg.pending','assignment retains exceptional graph')
      limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,67108864,65536,1)
      failures = failures + check(limited.status() = 'limit' & limited.reason() = 'inline.code.cells','signal expansion cell cap')
      limitedresult = limited.result(); limitedgraph = dereference limitedresult.ir()
      failures = failures + check(bin2x(limitedgraph.binary()) = bin2x(before),'cell refusal preserves frozen owner')
      limited = llinline..expand(request,'closed-main-default-halt.v1',1)
      failures = failures + check(limited.status() = 'limit','signal proof work cap')
      limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,128)
      failures = failures + check(limited.status() = 'limit','signal proof byte cap')
      limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,67108864,4)
      failures = failures + check(limited.status() = 'limit' & limited.reason() = 'inline.frame','signal expansion frame cap')
    end
    graph = dereference original.ir()
    failures = failures + check(bin2x(graph.binary()) = bin2x(before),'all signal paths preserve original source owner')
  end
  catchreason = .string[]
  catchreason[7] = 'signal.named.install.missing.pending'
  catchreason[8] = 'signal.named.push.duplicate.pending'
  catchreason[9] = 'signal.named.setup.pending'
  catchreason[10] = 'signal.handler.mismatch.pending'
  catchreason[11] = 'signal.bound.handler.pending'
  catchreason[12] = 'signal.callee.policy.pending'
  catchreason[13] = 'signal.catchall.mapping.pending'
  catchreason[14] = 'signal.storage.plain.unproved'
  catchreason[15] = 'signal.named.entry.pending'
  catchreason[16] = 'signal.named.push.order.pending'
  do variant = 0 to 15
    catchgraph = .llir..module
    original = catchmodel(variant,callid,handlerid)
    failures = failures + check(original.valid(),'constructed catch-all owner ' || variant)
    if original.valid() = 0 then do; say original.error(); iterate; end
    catchgraph = dereference original.ir(); before = catchgraph.binary()
    request = llinline..bind(reference original,callid,reference original,original.procedureid('checked_identity'))
    changed = llinline..expand(request,'closed-main-default-halt.v1')
    if variant >= 6 then do
      failures = failures + check(changed.status() = 'keep' & changed.reason() = catchreason[variant + 1],'precise catch-all keep ' || variant)
      if changed.reason() <> catchreason[variant + 1] then say changed.reason()
    end
    else do
      failures = failures + check(changed.status() = 'changed','complete catch-all expands ' || variant)
      if changed.status() <> 'changed' then do; say changed.reason(); iterate; end
      facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
      outcome = 3
      if variant = 1 then outcome = 2
      failures = failures + check(facts.status() = 'ok' & facts.handlerdirect(callid) & facts.handleroutcome(callid) = outcome,'catch-all admits pre/post-commit handler states ' || variant)
      result = changed.result(); instructions = 0; closure = 0; copies = 0; policies = 0; inhandler = 0; firsthandler = .string
      do i = 1 to result.records()
        item = result.record(i)
        if item.procedureid() <> result.procedureid('main') then iterate
        if item.kind() = 'label' then do; field = item.operand(1); inhandler = field.text() = 'caught'; end
        if item.kind() <> 'instruction' then iterate
        if inhandler & firsthandler = '' then firsthandler = item.mnemonic()
        if item.mnemonic() = 'call1' then instructions = instructions + 1
        if wordpos(item.mnemonic(),'link unlink endlife') > 0 then closure = closure + 1
        if item.mnemonic() = 'copy' & inhandler = 0 & policies = 58 then copies = copies + 1
        if wordpos(item.mnemonic(),'sigpush sigbr sigpop') > 0 then policies = policies + 1
      end
      failures = failures + check(instructions = 0 & closure = 0 & copies = 1 & policies = 116 & firsthandler = 'sigpop','direct catch-all has one return COPY and no fresh cleanup ' || variant)
      failures = failures + check(result.body(result.procedureid('main')).locals() = 4,'direct catch-all adds no frame cells')
      cleaned = llcleanup..transport(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
      failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'transport.exceptional.cfg.pending','catch-all transport keeps exceptional graph')
      cleaned = llcleanup..storage(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
      failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'storage.exceptional.cfg.pending','catch-all storage keeps exceptional graph')
      limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,67108864,3)
      failures = failures + check(limited.status() = 'limit' & limited.reason() = 'inline.frame','catch-all respects original frame cap')
    end
    catchgraph = dereference original.ir()
    failures = failures + check(bin2x(catchgraph.binary()) = bin2x(before),'catch-all preserves frozen source owner')
    if changed.status() = 'keep' then do
      catchkeptgraph = .llir..module
      kept = changed.result(); catchkeptgraph = dereference kept.ir()
      failures = failures + check(bin2x(catchkeptgraph.binary()) = bin2x(before),'catch-all refusal returns exact owner')
    end
  end
  failures = failures + boundcontrols()
  failures = failures + snapshotcontrols()
  say 'SIGNAL_INLINE|failures=' || failures
  return failures
