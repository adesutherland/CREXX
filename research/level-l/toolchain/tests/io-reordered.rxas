/* Counted first(y,x): preserve TRACE while eliminating the outer permutation. */
.globals=0
main() .locals=6
  load r0,11
  load r1,23
  load r2,2
  swap r3,r1
  swap r4,r0
  .traceevent "V" 4 "R" "I" "r" 3 0 0 0 "y" ""
  call r5,first(),r2
  swap r0,r4
  swap r1,r3
  itos r5
  say r5
  ret 0
first() .locals=0
  ret a1
