cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER CLI FIXTURES WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
include("${FIXTURES}/signal-pair-helpers.cmake")
if(DEFINED CONSTRUCTED)
  execute_process(COMMAND "${VM}" "${CONSTRUCTED}" -a runtime-child
    RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 180)
  if(NOT _status EQUAL 0 OR NOT _stdout MATCHES "RUNTIME_CHILD[|]failures=0")
    message(FATAL_ERROR "Constructed runtime child: ${_status}\n${_stdout}${_stderr}")
  endif()
endif()

# The native fixture's literal selector takes the old exact path. Its maintained
# noopt body anchors the producer shape; the cases below require unknown facts.
get_filename_component(_root "${FIXTURES}/../../../.." ABSOLUTE)
file(READ "${_root}/compiler/tests/golden/noopt/inline_test_ref_vararg_runtime.rxas" _native)
if(NOT _native MATCHES "linkarg r3,a1,1\n[ \t]*call1 r4,bumpOne[(][)],r3\n[ \t]*unlink r3\n[ \t]*[.]traceevent[^\n]+\n[ \t]*ret r4")
  message(FATAL_ERROR "Maintained native indirect-mutation suffix changed")
endif()
file(READ "${FIXTURES}/io-linkarg-runtime-child.rxas" _fixture)
# The RXAS reader canonicalizes procedure symbols; source and emitted spelling
# differ in case while binding to the same target.
set(_child_symbol "[bB][uU][mM][pP][oO][nN][eE]")
foreach(_case first middle last swap repeated result-selected result-unselected child-alias child-owned selector-alias owned cleanup)
  set(_original "${_fixture}")
  set(_first 17)
  set(_second 24)
  set(_text ten)
  set(_status 256)
  set(_actuals "24\nten\n256\n20\ntwenty\n512\n30\nthirty\n768")
  if(_case STREQUAL "middle" OR _case STREQUAL "swap" OR _case STREQUAL "repeated" OR _case STREQUAL "result-selected")
    string(REPLACE "load r7,0x00" "load r7,0x01" _original "${_original}")
    set(_first 27)
    set(_second 34)
    set(_text twenty)
    set(_status 512)
    set(_actuals "10\nten\n256\n34\ntwenty\n512\n30\nthirty\n768")
  elseif(_case STREQUAL "last")
    string(REPLACE "load r7,0x00" "load r7,0x01" _original "${_original}")
    string(REPLACE "load r8,0x00" "load r8,0x01" _original "${_original}")
    set(_first 37)
    set(_second 44)
    set(_text thirty)
    set(_status 768)
    set(_actuals "10\nten\n256\n20\ntwenty\n512\n44\nthirty\n768")
  endif()
  if(_case STREQUAL "swap")
    string(REPLACE "  icopy r3,a0" "  swap a2,a3\n  icopy r3,a0" _original "${_original}")
    set(_first 17)
    set(_second 24)
    set(_text ten)
    set(_status 256)
    set(_actuals "24\nten\n256\n20\ntwenty\n512\n30\nthirty\n768")
  elseif(_case STREQUAL "repeated")
    string(REPLACE "pick(),r0,r1,r2,r3" "pick(),r0,r1,r1,r3" _original "${_original}")
    set(_first 17)
    set(_second 24)
    set(_text ten)
    set(_status 256)
    set(_actuals "24\nten\n256\n20\ntwenty\n512\n30\nthirty\n768")
  elseif(_case STREQUAL "result-selected")
    string(REPLACE "call4 r4,pick()" "call4 r2,pick()" _original "${_original}")
    string(REPLACE "\"r\" 4 1 1 0 \"pick\"" "\"r\" 2 1 1 0 \"pick\"" _original "${_original}")
    string(REPLACE "icopy r9,r4" "icopy r9,r2" _original "${_original}")
    # The first result is read after both mutations of that same selected cell.
    set(_first 34)
  elseif(_case STREQUAL "result-unselected")
    string(REPLACE "call4 r4,pick()" "call4 r2,pick()" _original "${_original}")
    string(REPLACE "\"r\" 4 1 1 0 \"pick\"" "\"r\" 2 1 1 0 \"pick\"" _original "${_original}")
    string(REPLACE "icopy r9,r4" "icopy r9,r2" _original "${_original}")
    set(_actuals "24\nten\n256\n17\nten\n256\n30\nthirty\n768")
  elseif(_case STREQUAL "child-alias")
    string(REPLACE "call1 r4,bumpOne(),r3" "call1 r3,bumpOne(),r3\n  copy r4,r3" _original "${_original}")
  elseif(_case STREQUAL "child-owned")
    string(REPLACE "  ret a1" "  null r0\n  copy r0,a1\n  ret r0" _original "${_original}")
  elseif(_case STREQUAL "selector-alias")
    string(REPLACE "  ichkrng a1,1,r3\n  linkarg r3,a1,1" "  icopy r0,a1\n  ichkrng r0,1,r3\n  linkarg r0,r0,1" _original "${_original}")
    string(REPLACE "call1 r4,bumpOne(),r3" "call1 r4,bumpOne(),r0" _original "${_original}")
    string(REPLACE "  unlink r3" "  unlink r0" _original "${_original}")
  elseif(_case STREQUAL "owned")
    string(REPLACE "  icopy r3,a0" "  null r4\n  load r4,44\n  link a2,r4\n  icopy r3,a0" _original "${_original}")
    set(_first 51)
    set(_second 51)
    set(_text "")
    set(_status 0)
    set(_actuals "10\nten\n256\n20\ntwenty\n512\n30\nthirty\n768")
  endif()
  set(_source "${WORK}/child-${_case}.rxas")
  set(_output "${WORK}/child-${_case}-expanded.rxas")
  file(WRITE "${_source}" "${_original}")
  set(_options --no-cleanup)
  if(_case STREQUAL "cleanup")
    set(_options)
  endif()
  run_checked("expand runtime child ${_case}" "${VM}" "${CLI}" ${RUNTIME} -a
    --module runtime-child.rxas --profile closed-main-default-halt.v1 --work 12000000
    ${_options} -o "${_output}" "${_source}")
  file(READ "${_output}" _expanded)
  string(FIND "${_expanded}" "pick() .locals" _callee)
  if(_callee LESS 0)
    message(FATAL_ERROR "Retained native outer definition missing")
  endif()
  string(SUBSTRING "${_expanded}" 0 ${_callee} _main)
  if(_main MATCHES "(^|\n)[ \t]*(call[234]?|linkarg)[ \t]" OR _main MATCHES "iadd r[0-9]+,r[0-9]+,7")
    message(FATAL_ERROR "Runtime child retained its outer call/index or duplicated the child algorithm")
  endif()
  string(REGEX MATCHALL "(^|\n)[ \t]*call1 r[0-9]+,${_child_symbol}[(][)],r[0-9]+" _calls "${_main}")
  string(REGEX MATCHALL "(^|\n)[ \t]*ichkrng " _guards "${_main}")
  string(REGEX MATCHALL "(^|\n)[ \t]*brf " _branches "${_main}")
  string(REGEX MATCHALL "(^|\n)[ \t]*move " _moves "${_main}")
  string(REGEX MATCHALL "[.]traceevent \"F\"[^\n]*\"bumpone\"" _traces "${_main}")
  list(LENGTH _calls _call_count)
  list(LENGTH _guards _guard_count)
  list(LENGTH _branches _branch_count)
  list(LENGTH _moves _move_count)
  list(LENGTH _traces _trace_count)
  if(NOT _call_count EQUAL 6 OR NOT _guard_count EQUAL 2 OR NOT _branch_count EQUAL 4 OR NOT _move_count EQUAL 6 OR NOT _trace_count EQUAL 6)
    message(FATAL_ERROR "Runtime child lost finite dispatch, retained call or independent return closure")
  endif()
  bound_pair("child-${_case}" "${_original}" "${_expanded}" "${_first}\n${_second}\n${_text}\n${_status}\n${_actuals}\ncontinued")
endforeach()

# SILENT_HALT has no stderr/tag/source oracle and destroys root locals. These
# probes observe only the boundary state; immutable-base VM teardown is reviewed
# separately. Inject after proof so authored SIGNAL/SAY are not admission facts.
file(READ "${WORK}/child-first.rxas" _original)
file(READ "${WORK}/child-first-expanded.rxas" _expanded)
foreach(_point entry mutated returned)
  foreach(_kind original expanded)
    set(_injected "${_${_kind}}")
    string(REGEX REPLACE "([.]traceevent \"F\"[^\n]*\n)" "\\1say \"result-observed\"\n" _injected "${_injected}")
    set(_value 17)
    if(_point STREQUAL "entry")
      set(_value 10)
    endif()
    set(_source_step ".srcstep 90 90 17 \"runtime-child-cancel.g\" 9 3 24 \"cancel selected boundary\"\n")
    if(_point STREQUAL "returned")
      if(_kind STREQUAL "original")
        set(_owner pick)
      else()
        set(_owner main)
      endif()
      string(REGEX MATCH "${_owner}[(][)] [.]locals=([0-9]+)" _header "${_injected}")
      if(NOT _header)
        message(FATAL_ERROR "Missing CANCEL owning procedure ${_owner}")
      endif()
      set(_scratch "r${CMAKE_MATCH_1}")
      math(EXPR _locals "${CMAKE_MATCH_1} + 1")
      string(FIND "${_injected}" "${_header}" _begin)
      if(_kind STREQUAL "original")
        string(REGEX MATCH "${_child_symbol}[(][)] [.]locals=[0-9]+" _next_header "${_injected}")
      else()
        set(_next_header "pick() .locals=")
      endif()
      string(FIND "${_injected}" "${_next_header}" _end)
      if(_end LESS_EQUAL _begin)
        message(FATAL_ERROR "Missing CANCEL owning procedure boundary")
      endif()
      math(EXPR _length "${_end} - ${_begin}")
      string(SUBSTRING "${_injected}" 0 ${_begin} _before)
      string(SUBSTRING "${_injected}" ${_begin} ${_length} _body)
      string(SUBSTRING "${_injected}" ${_end} -1 _after)
      string(REPLACE "${_header}" "${_owner}() .locals=${_locals}" _body "${_body}")
      string(REGEX MATCHALL "(^|\n)[ \t]*call1 r[0-9]+,${_child_symbol}[(][)],r[0-9]+" _rows "${_body}")
      list(REMOVE_DUPLICATES _rows)
      foreach(_row IN LISTS _rows)
        string(REGEX REPLACE ".*,(r[0-9]+)$" "\\1" _selected "${_row}")
        set(_probe "${_source_step}icopy ${_scratch},${_selected}\nitos ${_scratch}\nsay ${_scratch}\nsay ${_selected}\ngetandtp ${_scratch},${_selected},768\nitos ${_scratch}\nsay ${_scratch}\nsignal \"CANCEL\",${_selected}\n")
        # This precedes authored UNLINK's lowered LINK-to-entry-anchor too.
        string(REPLACE "${_row}" "${_row}\n${_probe}" _body "${_body}")
      endforeach()
      set(_injected "${_before}${_body}${_after}")
    else()
      string(REGEX MATCH "(${_child_symbol})[(][)] [.]locals=1" _header "${_injected}")
      if(NOT _header)
        message(FATAL_ERROR "Missing CANCEL scalar child procedure")
      endif()
      set(_child_name "${CMAKE_MATCH_1}")
      string(REPLACE "${_header}" "${_child_name}() .locals=2" _injected "${_injected}")
      set(_probe "${_source_step}icopy r1,a1\nitos r1\nsay r1\nsay a1\ngetandtp r1,a1,768\nitos r1\nsay r1\nsignal \"CANCEL\",a1\n")
      if(_point STREQUAL "entry")
        string(REPLACE "${_child_name}() .locals=2\n" "${_child_name}() .locals=2\n${_probe}" _injected "${_injected}")
      else()
        string(REPLACE "iadd a1,a1,7\n" "iadd a1,a1,7\n${_probe}" _injected "${_injected}")
      endif()
    endif()
    string(REGEX MATCHALL "signal \"CANCEL\"" _signals "${_injected}")
    list(LENGTH _signals _signal_count)
    set(_expected_signals 1)
    if(_point STREQUAL "returned" AND _kind STREQUAL "expanded")
      set(_expected_signals 6)
    endif()
    if(NOT _signal_count EQUAL _expected_signals)
      message(FATAL_ERROR "CANCEL ${_point} ${_kind} was not injected at each exact retained boundary")
    endif()
    set(_product "${WORK}/child-cancel-${_point}-${_kind}")
    file(WRITE "${_product}.rxas" "${_injected}")
    run_checked("assemble child CANCEL ${_point} ${_kind}" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
    run_checked("execute child CANCEL ${_point} ${_kind}" "${VM}" "${_product}.rxbin")
    expect_output("${_value}\nten\n256")
    if(NOT _last_stderr STREQUAL "")
      message(FATAL_ERROR "Default CANCEL must silently terminate: ${_last_stderr}")
    endif()
  endforeach()
endforeach()

foreach(_case deeper counted branch selector context observer policy binding overflow second)
  set(_source "${_fixture}")
  set(_reason argument.selector.tail.call.pending)
  if(_case STREQUAL "deeper")
    string(REPLACE "  iadd a1,a1,7" "  call1 r0,grandchild(),a1\n  iadd a1,a1,7" _source "${_source}")
    string(APPEND _source "\ngrandchild() .locals=0\nret a1\n")
  elseif(_case STREQUAL "counted")
    string(REPLACE "call1 r4,bumpOne(),r3" "call r4,bumpOne(),r3" _source "${_source}")
  elseif(_case STREQUAL "branch")
    string(REPLACE "  iadd a1,a1,7" "  brt child_later,a1\nchild_later:\n  iadd a1,a1,7" _source "${_source}")
  elseif(_case STREQUAL "selector")
    string(REPLACE "  iadd a1,a1,7" "  linkarg r0,1\n  iadd a1,a1,7" _source "${_source}")
  elseif(_case STREQUAL "context")
    string(REPLACE "bumpOne() .locals=1\n  numsci 18,1,1" "bumpOne() .locals=1\n  numsci 9,1,1" _source "${_source}")
    set(_reason context.numeric.restore.unproved)
  elseif(_case STREQUAL "observer")
    string(REPLACE "  iadd a1,a1,7" "  say a1\n  iadd a1,a1,7" _source "${_source}")
  elseif(_case STREQUAL "policy")
    string(REPLACE "  iadd a1,a1,7" "  sigignore \"CANCEL\"\n  iadd a1,a1,7" _source "${_source}")
  elseif(_case STREQUAL "binding")
    string(REPLACE "  iadd a1,a1,7" "  link r0,a1\n  iadd a1,a1,7" _source "${_source}")
  elseif(_case STREQUAL "overflow")
    string(REPLACE "iadd a1,a1,7" "iadd a1,a1,9223372036854775807" _source "${_source}")
    set(_reason arithmetic.write.availability.unproved)
  else()
    string(REPLACE "  unlink r3" "  call1 r4,bumpOne(),r3\n  unlink r3" _source "${_source}")
  endif()
  set(_input "${WORK}/child-${_case}-keep.rxas")
  set(_output "${WORK}/child-${_case}-kept.rxas")
  file(WRITE "${_input}" "${_source}")
  run_checked("retain runtime child ${_case}" "${VM}" "${CLI}" ${RUNTIME} -a
    --module runtime-child.rxas --profile closed-main-default-halt.v1 --no-cleanup
    --work 12000000 -o "${_output}" "${_input}")
  file(READ "${_output}" _kept)
  if(NOT _last_stderr MATCHES "${_reason}" OR NOT _kept MATCHES "call4 r4,pick[(][)]")
    message(FATAL_ERROR "Runtime child ${_case} lost precise retained call: ${_last_stderr}")
  endif()
  if(_case STREQUAL "overflow")
    bound_pair("child-retained-overflow" "${_source}" "${_kept}" "10\n10\nten\n256\n10\nten\n256\n20\ntwenty\n512\n30\nthirty\n768\ncontinued")
  endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
message("RXAS_RUNTIME_CHILD|failures=0")
