cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER CLI FIXTURES WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
include("${FIXTURES}/signal-pair-helpers.cmake")

# This focused AC04 control qualifies G policy cloning and a compact C captured
# relay. It does not close the full emitted C helper/signal/call-exit closure.
function(policy_execute _stem _source _expected _reference_status)
  set(_product "${WORK}/${_stem}")
  file(WRITE "${_product}.rxas" "${_source}")
  run_checked("assemble ${_stem}" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
  execute_process(COMMAND "${VM}" "${_product}.rxbin" RESULT_VARIABLE _status
    OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 15)
  string(REPLACE "\r\n" "\n" _stdout "${_stdout}")
  string(STRIP "${_stdout}" _stdout)
  if(NOT _status MATCHES "^[1-9][0-9]*$" OR NOT _stdout STREQUAL _expected
      OR NOT _stderr MATCHES "PANIC: C-relay-payload [(]SIGNAL OTHER[)]"
      OR NOT _stderr MATCHES "signal_policy[.]c")
    message(FATAL_ERROR "${_stem} lost its independent signal result: ${_status}\n${_stdout}\n${_stderr}")
  endif()
  if(NOT _reference_status STREQUAL "" AND NOT _status STREQUAL _reference_status)
    message(FATAL_ERROR "${_stem} changed terminal signal status ${_reference_status} to ${_status}")
  endif()
  set(_policy_status "${_status}" PARENT_SCOPE)
endfunction()

file(READ "${FIXTURES}/io-policy-shapes.rxas" _fixture)
foreach(_case normal fault)
  set(_original "${_fixture}")
  set(_expected "3\nG-restored\nC-captured")
  if(_case STREQUAL fault)
    string(REPLACE "load g0,3" "load g0,12" _original "${_original}")
    set(_expected "-1\nG-restored\nC-captured")
  endif()
  set(_input "${WORK}/policy-${_case}.rxas")
  file(WRITE "${_input}" "${_original}")
  policy_execute("policy-${_case}-original" "${_original}" "${_expected}" "")
  set(_original_status "${_policy_status}")
  string(FIND "${_original}" "cprotect() .locals=" _c_start)
  string(SUBSTRING "${_original}" ${_c_start} -1 _c_original)
  string(REGEX MATCHALL "(^|\n)[ \t]*(sigpush|sigbrv|sigpop|sighalt|signalorigin)[ \t]+[^\n]+" _c_policies "${_c_original}")
  foreach(_mode conservative cleaned)
    set(_options)
    if(_mode STREQUAL conservative)
      set(_options --no-cleanup)
    endif()
    set(_product "${WORK}/policy-${_case}-${_mode}")
    run_checked("expand policy ${_case} ${_mode}" "${VM}" "${CLI}" ${RUNTIME} -a
      --module policy-shapes.rxas --profile closed-main-default-halt.v1
      --work 12000000 ${_options} -o "${_product}.rxas" "${_input}")
    if(_last_stderr MATCHES "LL_(CLEANUP|STORAGE)_FAILED:")
      message(FATAL_ERROR "Policy cleanup reported an internal failure: ${_last_stderr}")
    endif()
    file(READ "${_product}.rxas" _expanded)
    string(FIND "${_expanded}" "gprotect() .locals=" _g_start)
    string(FIND "${_expanded}" "cprotect() .locals=" _c_start)
    if(_g_start LESS 0 OR _c_start LESS 0)
      message(FATAL_ERROR "Policy output lost an original helper definition")
    endif()
    string(SUBSTRING "${_expanded}" 0 ${_g_start} _caller)
    string(REGEX MATCHALL "(^|\n)[ \t]*inlenter[ \t]" _entries "${_caller}")
    list(LENGTH _entries _entry_count)
    if(_caller MATCHES "call1[ \t]+g0,(gprotect|cprotect)[(][)]"
        OR NOT _entry_count EQUAL 2)
      message(FATAL_ERROR "Policy ${_case} ${_mode} did not expand both G and C: ${_caller}")
    endif()
    string(REGEX MATCHALL "(^|\n)[ \t]*sigpush[ \t]+\"OUT_OF_RANGE\"" _pushes "${_caller}")
    string(REGEX MATCHALL "(^|\n)[ \t]*sigpop[ \t]+\"OUT_OF_RANGE\"" _pops "${_caller}")
    list(LENGTH _pushes _push_count)
    list(LENGTH _pops _pop_count)
    if(NOT _push_count EQUAL 2 OR NOT _pop_count EQUAL 3)
      message(FATAL_ERROR "Policy ${_case} ${_mode} lost caller/clone push-pop restoration")
    endif()
    foreach(_operation sigpush sigbrv sighalt signalorigin)
      string(REGEX MATCHALL "(^|\n)[ \t]*${_operation}[ \t]+[^\n]*\"OTHER\"[^\n]*" _rows "${_caller}")
      list(LENGTH _rows _row_count)
      if(NOT _row_count EQUAL 1)
        message(FATAL_ERROR "Policy ${_case} ${_mode} lost cloned C ${_operation} row")
      endif()
    endforeach()
    string(REGEX MATCHALL "(^|\n)[ \t]*sigpop[ \t]+\"OTHER\"" _c_pops "${_caller}")
    list(LENGTH _c_pops _c_pop_count)
    if(NOT _c_pop_count EQUAL 2 OR NOT _caller MATCHES "[.]srcstep[^\n]*\"signal_policy[.]c\" 7 3")
      message(FATAL_ERROR "Policy ${_case} ${_mode} lost cloned C restoration or captured source rows")
    endif()
    string(SUBSTRING "${_expanded}" ${_c_start} -1 _c_expanded)
    string(REGEX MATCHALL "(^|\n)[ \t]*(sigpush|sigbrv|sigpop|sighalt|signalorigin)[ \t]+[^\n]+" _c_after "${_c_expanded}")
    # Compare executable policy spelling independent of renderer indentation.
    string(REGEX REPLACE "(^|\n)[ \t]*" "" _c_policies_normal "${_c_policies}")
    string(REGEX REPLACE "(^|\n)[ \t]*" "" _c_after_normal "${_c_after}")
    if(NOT _c_policies_normal STREQUAL _c_after_normal)
      message(FATAL_ERROR "Policy ${_case} ${_mode} changed the original C helper's relay rows")
    endif()
    policy_execute("policy-${_case}-${_mode}-executed" "${_expanded}" "${_expected}" "${_original_status}")
  endforeach()
endforeach()
file(REMOVE_RECURSE "${WORK}")
message("RXAS_POLICY_SHAPES|failures=0")
