/* cREXX License (MIT). Retained-child original-backing resource projection. */
options levelb
import llir
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetflow
import llrxascatalog

check: procedure = .int
  arg condition = .int, label = .string
  if condition then return 0
  say 'FAIL:' || label
  return 1
one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, value = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = value as .object
  return body.emit(name,fields,at)
two: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object
  return body.emit(name,fields,at)
fixed: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, destination = .lltarget..operand, first = .lltarget..operand, second = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = destination as .object
  fields[2] = .lltarget..operand.procedure(name) as .object
  fields[3] = first as .object; fields[4] = second as .object
  return body.emit('call2',fields,at)

sample: procedure = .lltarget..module
  arg mode = .int, expose called = .int
  draft = .lltarget..draft('backing.child.' || mode,'fixture:backing.child',2)
  at = draft.synthetic('same native resource predicates under captured child pointers')
  main = draft.procedure('main',1,at)
  ignored = one(main,'getnumdgts',main.reg('r',0),at)
  ignored = fixed(main,'worker',main.reg('r',0),main.reg('r',0),main.reg('r',0),at)
  ignored = one(main,'ret',.lltarget..operand.integer(0),at)
  /* The selected policy controls current signal paths only; the resource
   * theorem grants no fresh-frame or private-name premise. */
  worker = draft.procedure('worker',3,at)
  if mode = 11 then ignored = two(worker,'sigcall',.lltarget..operand.procedure('handler'),.lltarget..operand.string('FAILURE' as .binary),at)
  ignored = one(worker,'getnumdgts',worker.reg('r',0),at)
  if mode = 4 then ignored = two(worker,'link',worker.reg('r',0),worker.reg('a',1),at)
  destination = worker.reg('r',1)
  if mode = 9 | mode = 10 then destination = worker.reg('r',0)
  called = fixed(worker,'child',destination,worker.reg('r',0),worker.reg('a',2),at)
  ignored = one(worker,'ret',.lltarget..operand.integer(0),at)
  child = draft.procedure('child',1,at)
  select mode
    when 1 then ignored = two(child,'copy',child.reg('a',1),child.reg('a',2),at)
    when 2 then ignored = two(child,'link',child.reg('g',0),child.reg('a',1),at)
    when 3 then do
      fields = .object[]; fields[1] = child.reg('r',0) as .object
      fields[2] = child.reg('a',2) as .object; fields[3] = child.reg('a',1) as .object
      ignored = child.emit('dcall',fields,at)
    end
    when 4 then ignored = two(child,'copy',child.reg('a',1),child.reg('a',2),at)
    when 5 then do
      ignored = two(child,'link',child.reg('a',1),child.reg('g',0),at)
      ignored = two(child,'copy',child.reg('a',1),child.reg('a',2),at)
    end
    when 6 then ignored = two(child,'copy',child.reg('g',0),child.reg('g',1),at)
    when 7 then ignored = two(child,'setattrs',child.reg('a',1),.lltarget..operand.integer(1),at)
    when 8 then ignored = fixed(child,'worker',child.reg('r',0),child.reg('a',1),child.reg('a',2),at)
    when 9 then ignored = two(child,'load',child.reg('r',0),.lltarget..operand.integer(17),at)
    when 10 then ignored = two(child,'copy',child.reg('r',0),child.reg('a',2),at)
    otherwise ignored = one(child,'getnumdgts',child.reg('a',1),at)
  end
  if mode = 9 | mode = 10 then ignored = one(child,'ret',child.reg('r',0),at)
  else if mode = 5 then ignored = one(child,'ret',.lltarget..operand.integer(19),at)
  else ignored = one(child,'ret',child.reg('a',1),at)
  if mode = 11 then do
    handler = draft.procedure('handler',0,at)
    ignored = one(handler,'ret',.lltarget..operand.integer(0),at)
  end
  return draft.finish()

run: procedure = .int
  arg mode = .int
  failures = 0; called = .int; ordinal = .int; allocation = .int; allocationedge = .int; contextactions = .int
  source = sample(mode,called)
  failures = failures + check(source.valid(),'child backing source validates ' || mode)
  if source.valid() = 0 then do; say source.error(); return failures; end
  if mode = 12 then profile = .lltargettransfer..profile(reference source,8000000)
  else profile = .lltargettransfer..profile.closedcalls(reference source,source.procedureid('main'),'closed-main-default-halt.v1',8000000)
  cfg = .lltargetcfg..graph(reference source,reference profile,8000000)
  points = .lltargetflow..analysis(reference source,reference profile,reference cfg,8000000)
  failures = failures + check(points.status() = 'ok','raw child flow completes ' || mode || ':' || points.reason())
  if points.status() <> 'ok' then return failures
  number = 0; if mode = 6 then number = 2
  history = points.privatebackinghistory(source.procedureid('worker'),'r',number)
  positive = wordpos(mode as .string,'0 4 5 6 9') > 0
  if positive then failures = failures + check(history.resourcefree() & history.nonescape(),'exact child resources preserve original backing ' || mode || ':' || history.reason())
  else failures = failures + check(history.resourcefree() = 0 & history.nonescape() = 0 & history.reason() <> '','unproved child resource/escape remains explicit ' || mode || ':' || history.reason())
  if mode = 2 then failures = failures + check(history.reason() = 'target.resource.backing.pointer.exported','child pointer export keeps the exact reason')
  binding = points.captureargument(called,1)
  if positive then failures = failures + check(binding.status() = 'ok' & binding.active() > 0,'retained CALL captures its actual independently of resource contents ' || mode)
  borrowed = points.privatebackinghistory(source.procedureid('worker'),'a',2)
  failures = failures + check(borrowed.resourcefree() = 0,'borrowed actual never receives an owned-backing seed')
  if mode = 0 then do
    a0 = points.privatebackinghistory(source.procedureid('worker'),'a',0)
    failures = failures + check(a0.resourcefree() & a0.nonescape(),'retained scalar child keeps the generic a0 footprint without a recycler-timing obligation')
    /* Retained frame allocation can still fail. Its exact native FAILURE
     * departure remains in the graph even when resource reach is proved. */
    catalog = .llrxascatalog..catalog(); item = source.at(called); allocation = 0; allocationedge = 0
    instruction = profile.instruction(called); contextactions = 0
    do ordinal = 1 to instruction.actions()
      action = instruction.action(ordinal)
      if action.kind() <> 'context' then iterate
      domain = profile.domain(action.domain())
      failures = failures + check(domain.kind() = 'context','retained CALL context action remains an ambient typed domain')
      contextactions = contextactions + 1
    end
    failures = failures + check(contextactions > 0 & instruction.complete('numeric') = 0,'resource footprint grants no numeric proof for the unknown CALL context action')
    do ordinal = 1 to catalog.callcauses(item.opcode())
      cause = profile.callcause(called,ordinal)
      if cause.kind() = 'frame-allocation' then allocation = ordinal
    end
    do ordinal = 1 to cfg.outedges(called)
      edge = cfg.outedge(called,ordinal)
      if pos('.call-cause.' || allocation || '.sync.',edge.boundaryid()) > 0 & edge.signalname() = 'FAILURE' then allocationedge = allocationedge + 1
    end
    failures = failures + check(allocation > 0 & allocationedge > 0,'proved resource footprint retains the child allocation FAILURE producer')
    historyagain = points.privatebackinghistory(source.procedureid('worker'),'r',0)
    failures = failures + check(historyagain.resourcefree() & historyagain.nonescape(),'frozen child proof is reusable')
    limited = .lltargetflow..analysis(reference source,reference profile,reference cfg,1)
    limitedhistory = limited.privatebackinghistory(source.procedureid('worker'),'r',0)
    failures = failures + check(limited.status() = 'limit' & limitedhistory.resourcefree() = 0,'exhausted owner cannot publish partial child proof')
    replacement = sample(mode,called); source = replacement
    failures = failures + check(history.valid() = 0 & binding.valid() = 0,'replacing frozen source invalidates child history and capture')
  end
  return failures

main: procedure = .int
  failures = 0
  do mode = 0 to 12; failures = failures + run(mode); end
  say 'TARGET_BACKING_CHILD|failures=' || failures
  return failures
