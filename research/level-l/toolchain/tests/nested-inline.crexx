/* cREXX License (MIT). Independent retained nested-call structure controls. */
options levelb
import rxfnsb
import llir
import lltarget
import lltargetfacts
import llinline
import llcleanup

check: procedure = .int
  arg condition = .int, message = .string
  if condition then return 0
  say 'FAIL:' message
  return 1
one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object
  return body.emit(name,fields,at)
two: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object
  return body.emit(name,fields,at)
three: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, third = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object; fields[3] = third as .object
  return body.emit(name,fields,at)
four: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, third = .lltarget..operand, fourth = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object; fields[3] = third as .object; fields[4] = fourth as .object
  return body.emit(name,fields,at)

positivebody: procedure = .lltarget..module
  arg variant = .int
  draft = .lltarget..draft('nested.' || variant,'fixture:nested.' || variant,0)
  at = draft.synthetic('fixed snapshot and counted nested windows')
  root = draft.procedure('main',4,at)
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(5),at)
  ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(20),at)
  actual = root.reg('r',1)
  if variant = 1 then actual = root.reg('r',0)
  ignored = four(root,'call2',root.reg('r',2),.lltarget..operand.procedure('outer'),root.reg('r',0),actual,at)
  if variant = 2 then ignored = four(root,'call2',root.reg('r',3),.lltarget..operand.procedure('outer'),root.reg('r',0),actual,at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  localcount = 1
  if variant = 1 then localcount = 2
  outer = draft.procedure('outer',localcount,at)
  if variant = 1 then do
    ignored = two(outer,'icopy',outer.reg('r',0),outer.reg('a',1),at)
    ignored = three(outer,'call1',outer.reg('r',1),.lltarget..operand.procedure('child'),outer.reg('a',2),at)
    ignored = three(outer,'iadd',outer.reg('r',0),outer.reg('r',0),outer.reg('r',1),at)
  end
  else do
    ignored = two(outer,'load',outer.reg('a',0),.lltarget..operand.integer(2),at)
    if variant = 2 then ignored = two(outer,'swap',outer.reg('a',1),outer.reg('a',2),at)
    ignored = three(outer,'call',outer.reg('r',0),.lltarget..operand.procedure('child'),outer.reg('a',0),at)
    if variant = 2 then ignored = two(outer,'swap',outer.reg('a',1),outer.reg('a',2),at)
  end
  ignored = one(outer,'ret',outer.reg('r',0),at)
  leaf = draft.procedure('child',0,at)
  if variant = 1 then do
    ignored = three(leaf,'iadd',leaf.reg('a',1),leaf.reg('a',1),.lltarget..operand.integer(7),at)
    ignored = one(leaf,'ret',leaf.reg('a',1),at)
  end
  else if variant = 2 then do
    ignored = three(leaf,'iadd',leaf.reg('a',1),leaf.reg('a',1),.lltarget..operand.integer(1),at)
    ignored = one(leaf,'ret',leaf.reg('a',2),at)
  end
  else do
    ignored = three(leaf,'iadd',leaf.reg('a',2),leaf.reg('a',2),.lltarget..operand.integer(1),at)
    ignored = one(leaf,'ret',leaf.reg('a',1),at)
  end
  return draft.finish()

/** Assert relations between typed operands, never authored physical indices. */
structure: procedure = .int
  arg owner = reference .lltarget..module, variant = .int, stage = .string
  failures = 0; i = .int; j = .int; calls = .int; snapshotcell = -1; callordinal = .int; snapshotused = .int
  counter = .int; expected = .int; before = .int; after = .int
  item = .lltarget..record; neighbor = .lltarget..record; target = .lltarget..operand; body = .lltarget..body
  left = .lltarget..operand; right = .lltarget..operand; value = .lltarget..operand
  source = dereference owner; body = source.body(source.procedureid('main'))
  expected = 1
  if variant = 2 then expected = 2
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() <> 'instruction' then iterate
    if item.mnemonic() = 'icopy' & snapshotcell < 0 then do; value = item.operand(1); snapshotcell = value.index(); end
    if item.mnemonic() = 'iadd' & calls > 0 & variant = 1 then do
      value = item.operand(2)
      if value.index() = snapshotcell then snapshotused = 1
    end
    if wordpos(item.mnemonic(),'call call1 call2 call3 call4') = 0 then iterate
    calls = calls + 1; target = item.operand(2); callordinal = i
    failures = failures + check(target.text() = 'child','only exact nested child survives ' || stage)
    if variant = 1 then do
      failures = failures + check(item.mnemonic() = 'call1' & snapshotcell >= 0,'fixed child keeps opcode and prior snapshot ' || stage)
      iterate
    end
    failures = failures + check(item.mnemonic() = 'call' & item.operands() = 3,'counted child remains a counted call ' || stage)
    value = item.operand(3); counter = value.index()
    failures = failures + check(value.bank() = 'r' & counter + 2 < body.locals(),'counter and two implicit actuals fit contiguously ' || stage)
    if variant <> 2 then iterate
    before = 0; after = 0
    do j = callordinal - 1 to 1 by -1
      neighbor = body.record(j)
      if neighbor.kind() <> 'instruction' then iterate
      if neighbor.mnemonic() = 'swap' then do
        left = neighbor.operand(1); right = neighbor.operand(2)
        before = (left.index() = counter + 1 & right.index() = counter + 2) | (left.index() = counter + 2 & right.index() = counter + 1)
      end
      leave
    end
    do j = callordinal + 1 to body.records()
      neighbor = body.record(j)
      if neighbor.kind() <> 'instruction' then iterate
      if neighbor.mnemonic() = 'swap' then do
        left = neighbor.operand(1); right = neighbor.operand(2)
        after = (left.index() = counter + 1 & right.index() = counter + 2) | (left.index() = counter + 2 & right.index() = counter + 1)
      end
      leave
    end
    failures = failures + check(before & after,'source permutation and its inverse surround retained child ' || stage)
  end
  failures = failures + check(calls = expected,'all original outer calls removed; nested calls retained ' || stage)
  if variant = 1 then failures = failures + check(snapshotused,'owned snapshot remains the source of the post-child sum ' || stage)
  return failures

positive: procedure = .int
  arg variant = .int
  failures = 0; i = .int; expected = .int
  original = .lltarget..module; result = .lltarget..module; nextowner = .lltarget..module
  facts = .lltargetfacts..analysis; changed = .llinline..change; cleaned = .llinline..change
  request = .llinline..binding; requests = .object[]; ids = .int[]
  original = positivebody(variant)
  failures = failures + check(original.valid(),'constructed nested source is valid ' || variant)
  facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(facts.status() = 'ok','nested source has a scalar invocation proof ' || variant)
  if facts.status() <> 'ok' then do; say facts.reason(); return failures; end
  expected = 1
  if variant = 2 then expected = 2
  failures = failures + check(facts.calls() = expected,'private simulation publishes only root sites ' || variant)
  do i = 1 to facts.calls()
    ids[i] = facts.callid(i)
    failures = failures + check(facts.rebinding(ids[i]) = (variant = 2) & facts.orderedslots(ids[i]) = (variant <> 1),'counted ordering and explicit rebinding are independent ' || variant)
    request = llinline..bind(reference original,ids[i],reference original,original.procedureid('outer'))
    requests[i] = request as .object
  end
  changed = llinline..expandmany(requests,'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','outer sites expand atomically ' || variant)
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  do i = 1 to ids[0]
    failures = failures + check(changed.operation(ids[i]) = 0,'original outer call identity is removed ' || variant)
  end
  result = changed.result(); failures = failures + structure(reference result,variant,'expanded.' || variant)
  cleaned = llcleanup..transport(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(cleaned.status() = 'changed' | cleaned.status() = 'keep','whole-caller transport accepts retained children ' || variant)
  if cleaned.status() <> 'changed' & cleaned.status() <> 'keep' then do; say cleaned.reason(); return failures; end
  nextowner = cleaned.result()
  cleaned = llcleanup..storage(reference nextowner,nextowner.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(cleaned.status() = 'changed' | cleaned.status() = 'keep','whole-caller placement preserves retained windows ' || variant)
  if cleaned.status() <> 'changed' & cleaned.status() <> 'keep' then do; say cleaned.reason(); return failures; end
  result = cleaned.result(); failures = failures + structure(reference result,variant,'cleaned.' || variant)
  return failures

/** These are pending proof/body cases, not unrepresentable RXAS syntax. */
retention: procedure = .int
  failures = 0; variant = .int; callid = .int; expected = .string; ignored = .int
  original = .lltarget..module; kept = .lltarget..module
  request = .llinline..binding; decision = .llinline..decision; changed = .llinline..change
  do variant = 1 to 3
    draft = .lltarget..draft('nested.keep.' || variant,'fixture:nested.keep.' || variant,0)
    at = draft.synthetic('specific nested proof refusal keeps executable input intact')
    if variant = 1 then do
      fields = .object[]; fields[1] = .lltarget..operand.procedure('missing') as .object
      fields[2] = .lltarget..operand.symbol('missing.public') as .object
      ignored = draft.record('.import',fields,at)
    end
    root = draft.procedure('main',3,at)
    ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(5),at)
    actual = root.reg('r',0)
    if variant = 2 then do
      ignored = three(root,'getandtp',root.reg('r',2),root.reg('r',0),.lltarget..operand.integer(768),at)
      actual = root.reg('r',2)
    end
    callid = three(root,'call1',root.reg('r',1),.lltarget..operand.procedure('outer'),actual,at)
    ignored = one(root,'ret',.lltarget..operand.integer(0),at)
    outer = draft.procedure('outer',1,at)
    if variant = 1 then do
      ignored = three(outer,'call1',outer.reg('r',0),.lltarget..operand.procedure('missing'),outer.reg('a',1),at)
      expected = 'body.unavailable'
    end
    else if variant = 2 then do
      ignored = three(outer,'call',outer.reg('r',0),.lltarget..operand.procedure('child'),outer.reg('a',1),at)
      expected = 'argument.count.unproved'
    end
    else do
      ignored = three(outer,'call1',outer.reg('r',0),.lltarget..operand.procedure('outer'),outer.reg('a',1),at)
      expected = 'call.recursion.active'
    end
    ignored = one(outer,'ret',outer.reg('r',0),at)
    if variant = 2 then do
      leaf = draft.procedure('child',0,at)
      ignored = one(leaf,'ret',.lltarget..operand.integer(0),at)
    end
    original = draft.finish(); graph = dereference original.ir(); before = graph.binary()
    failures = failures + check(original.valid(),'retention control has a valid typed module ' || variant)
    request = llinline..bind(reference original,callid,reference original,original.procedureid('outer'))
    decision = llinline..inspect(request,'closed-main-default-halt.v1')
    failures = failures + check(decision.status() = 'keep' & decision.reason() = expected,'specific unfinished proof reason: ' || expected)
    changed = llinline..expand(request,'closed-main-default-halt.v1')
    kept = changed.result(); graph = dereference kept.ir()
    failures = failures + check(changed.status() = 'keep' & changed.reason() = expected & bin2x(graph.binary()) = bin2x(before),'refusal preserves the exact original executable module: ' || expected)
  end
  return failures

main: procedure = .int
  failures = positive(1) + positive(2) + positive(3) + retention()
  say 'NESTED_INLINE|failures=' || failures
  return failures
