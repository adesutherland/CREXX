/* Execution order is first(11/status256), then second(22/status0), despite
 * the opposite lexical order. Distinct temporaries preserve fresh status. */
.globals=0
main() .locals=4
  load r0,0
  load r1,0
  call2 r2,backward(),r0,r1
  getandtp r2,r0,768
  getandtp r3,r1,768
  itos r0
  say r0
  itos r2
  say r2
  itos r1
  say r1
  itos r3
  say r3
  ret 0
backward() .locals=6
  br order_first
order_second:
  load r3,22
  copy a2,r3
  br order_done
order_first:
  load r5,11
  settp r5,256
  copy a1,r5
  br order_second
order_done:
  ret
