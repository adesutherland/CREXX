/* Acyclic harness for the maintained no-opt classify body and scalar alias. */
.globals=0
main() .locals=9
  numsci 18,1,1
  load r0,-1
  .srcstep 1 1 17 "predicate-caller.rxas" 1 1 24 "result = classify(value)"
  call1 r1,classify(),r0
  .traceevent "F" 4 "R" "I" "r" 1 1 1 0 "classify" ""
  icopy r8,r1
  itos r8
  say r8
  null r4
  load r4,-7
  load r4,"keep"
  settp r4,512
  call1 r5,alias(),r4
  .traceevent "F" 4 "R" "O" "r" 5 1 1 0 "alias" ""
  icopy r8,r5
  itos r8
  say r8
  say r5
  getandtp r8,r5,768
  itos r8
  say r8
  icopy r8,r4
  itos r8
  say r8
  say r4
  getandtp r8,r4,768
  itos r8
  say r8
  ret 0
classify() .locals=4
   .meta "inline_test_multi_return_assign.classify"="b" ".int" classify() "val=.int"
   .srcstep 20 20 17 "inline_test_multi_return_assign.crexx" 12 1 27 "classify: procedure = .int"
   numsci 18,1,1
   .srcstep 12 12 17 "inline_test_multi_return_assign.crexx" 13 7 17 "  arg val = .int"
   .meta "inline_test_multi_return_assign.classify.val"="b" ".int" a1
   .srcstep 14 14 17 "inline_test_multi_return_assign.crexx" 14 3 13 "  if val < 0 then return -1"
   .traceevent "V" 6 "R" "I" "a" 1 14 14 0 "val" ""
   ilt r1,a1,0
   .traceevent "O" 4 "R" "B" "r" 1 14 14 0 "" ""
   brf l39iffalse,r1
   .srcstep 15 15 17 "inline_test_multi_return_assign.crexx" 14 14 18 "  if val < 0 then return -1"
   .srcstep 13 13 17 "inline_test_multi_return_assign.crexx" 14 19 28 "  if val < 0 then return -1"
   load r2,1
   .traceevent "L" 4 "R" "I" "r" 2 13 13 0 "" ""
   isub r3,0,r2
   .traceevent "P" 4 "R" "I" "r" 3 13 13 0 "" ""
   ret r3
l39iffalse:
   .srcstep 17 17 17 "inline_test_multi_return_assign.crexx" 15 3 13 "  if val > 0 then return 1"
   .traceevent "V" 6 "R" "I" "a" 1 17 17 0 "val" ""
   igt r3,a1,0
   .traceevent "O" 4 "R" "B" "r" 3 17 17 0 "" ""
   brf l45iffalse,r3
   .srcstep 18 18 17 "inline_test_multi_return_assign.crexx" 15 14 18 "  if val > 0 then return 1"
   .srcstep 16 16 17 "inline_test_multi_return_assign.crexx" 15 19 27 "  if val > 0 then return 1"
   ret 1
l45iffalse:
   .srcstep 19 19 17 "inline_test_multi_return_assign.crexx" 16 3 11 "  return 0"
   ret 0
   .meta "inline_test_multi_return_assign.classify.val"

alias() .locals=0
  .srcstep 30 7 17 "predicate-alias.rxas" 30 1 20 "value = value > zero"
  .traceevent "V" 6 "R" "I" "a" 1 30 7 0 "alias-before" ""
  igt a1,a1,0
  .traceevent "O" 4 "R" "I" "a" 1 30 7 0 "alias-after" ""
  ret a1
