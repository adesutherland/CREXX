cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER CLI FIXTURES WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
include("${FIXTURES}/signal-pair-helpers.cmake")
if(DEFINED CONSTRUCTED)
  execute_process(COMMAND "${VM}" "${CONSTRUCTED}" -a runtime-branch
    RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 180)
  if(NOT _status EQUAL 0 OR NOT _stdout MATCHES "RUNTIME_BRANCH[|]failures=0")
    message(FATAL_ERROR "Constructed runtime branch: ${_status}\n${_stdout}${_stderr}")
  endif()
endif()
file(READ "${FIXTURES}/io-linkarg-runtime-child.rxas" _native_shape)
string(FIND "${_native_shape}" "pick() .locals" _body)
string(SUBSTRING "${_native_shape}" 0 ${_body} _caller)
set(_prefix "pick() .locals=5\n.meta \"pick.which\"=\"b\" \".int\" a1\n.srcstep 20 20 17 \"runtime-branch.g\" 10 3 17 \"checked selection\"\nicopy r3,a0\nisub r3,r3,1\nichkrng a1,1,r3\nlinkarg r3,a1,1\nnull r4\nisub r4,r3,10\n")
set(_diamond "brf add7,r4\n.srcstep 21 21 17 \"runtime-branch.g\" 11 3 16 \"selected plus 9\"\niadd r3,r3,9\n.traceevent \"O\" 4 \"R\" \"I\" \"r\" 3 21 21 0 \"\" \"\"\nbr joined\nadd7:\n.srcstep 22 22 17 \"runtime-branch.g\" 12 3 16 \"selected plus 7\"\niadd r3,r3,7\n.traceevent \"O\" 4 \"R\" \"I\" \"r\" 3 22 22 0 \"\" \"\"\n")
set(_return "joined:\n.srcstep 23 23 17 \"runtime-branch.g\" 13 3 15 \"return selected\"\n.traceevent \"V\" 6 \"R\" \"I\" \"r\" 3 23 23 0 \"selected\" \"\"\ncopy r4,r3\nunlink r3\nret r4\n.meta \"pick.which\"\n")
set(_fixture "${_caller}${_prefix}${_diamond}${_return}")
foreach(_case first middle last dynamic-zero dynamic-one early child-skip-reached selector-write selected-result status)
  set(_original "${_fixture}")
  set(_first 17)
  set(_second 26)
  set(_text ten)
  set(_flags 256)
  set(_actuals "26\nten\n256\n20\ntwenty\n512\n30\nthirty\n768")
  if(_case STREQUAL "middle" OR _case STREQUAL "child-skip-reached")
    string(REPLACE "load r7,0x00" "load r7,0x01" _original "${_original}")
    set(_first 29)
    set(_second 38)
    set(_text twenty)
    set(_flags 512)
    set(_actuals "10\nten\n256\n38\ntwenty\n512\n30\nthirty\n768")
  elseif(_case STREQUAL "last")
    string(REPLACE "load r7,0x00" "load r7,0x01" _original "${_original}")
    string(REPLACE "load r8,0x00" "load r8,0x01" _original "${_original}")
    set(_first 39)
    set(_second 48)
    set(_text thirty)
    set(_flags 768)
    set(_actuals "10\nten\n256\n20\ntwenty\n512\n48\nthirty\n768")
  endif()
  if(_case MATCHES "^dynamic-")
    set(_byte 0x00)
    if(_case STREQUAL "dynamic-one")
      set(_byte 0x01)
      set(_first 20)
      set(_second 29)
      set(_actuals "29\nten\n256\n20\ntwenty\n512\n30\nthirty\n768")
    endif()
    string(REPLACE "main() .locals=10" "main() .locals=11" _original "${_original}")
    string(REPLACE "  call4 r4,pick()" "  load r10,${_byte}\n  bineq r9,r10,0x01\n  iadd r1,r1,r9\n  call4 r4,pick()" _original "${_original}")
  elseif(_case STREQUAL "early")
    set(_early "brf add7,r4\niadd r3,r3,9\n${_return}add7:\niadd r3,r3,7\nbr joined\n")
    set(_original "${_caller}${_prefix}${_early}")
    string(REPLACE ".meta \"pick.which\"=\"b\" \".int\" a1\n" "" _original "${_original}")
    string(REPLACE ".meta \"pick.which\"\n" "" _original "${_original}")
  elseif(_case STREQUAL "child-skip-reached")
    string(REPLACE "${_diamond}${_return}" "brf child,r4\nload r4,-1\nbr joined\nchild:\ncall1 r4,bump(),r3\njoined:\nunlink r3\nret r4\n.meta \"pick.which\"\nbump() .locals=0\niadd a1,a1,7\nret a1\n" _original "${_original}")
    set(_first -1)
    set(_second 17)
    set(_text ten)
    set(_flags 256)
    set(_actuals "17\nten\n256\n20\ntwenty\n512\n30\nthirty\n768")
  elseif(_case STREQUAL "selector-write")
    string(REPLACE "isub r4,r3,10" "load a1,99\nisub r4,a1,99" _original "${_original}")
    set(_second 24)
    set(_actuals "24\nten\n256\n20\ntwenty\n512\n30\nthirty\n768")
  elseif(_case STREQUAL "selected-result")
    string(REPLACE "call4 r4,pick()" "call4 r1,pick()" _original "${_original}")
    string(REPLACE "\"r\" 4 1 1 0 \"pick\"" "\"r\" 1 1 1 0 \"pick\"" _original "${_original}")
    string(REPLACE "icopy r9,r4" "icopy r9,r1" _original "${_original}")
    set(_first 26)
  elseif(_case STREQUAL "status")
    string(REPLACE "brf add7,r4" "brtpandt add7,r3,256" _original "${_original}")
    set(_second 24)
    set(_actuals "24\nten\n256\n20\ntwenty\n512\n30\nthirty\n768")
  endif()
  if(_case STREQUAL "selector-write" OR _case STREQUAL "child-skip-reached")
    set(_reselect "bineq r0,r7,0x01\nbineq r6,r8,0x01\niadd r0,r0,r6\niadd r0,r0,1\n")
    if(_case STREQUAL "child-skip-reached")
      string(PREPEND _reselect "load r7,0x00\n")
    endif()
    string(REPLACE "  call4 r5,pick()" "  ${_reselect}call4 r5,pick()" _original "${_original}")
  endif()
  set(_input "${WORK}/branch-${_case}.rxas")
  set(_output "${WORK}/branch-${_case}-expanded.rxas")
  file(WRITE "${_input}" "${_original}")
  run_checked("expand runtime branch ${_case}" "${VM}" "${CLI}" ${RUNTIME} -a
    --module runtime-branch.rxas --profile closed-main-default-halt.v1 --no-cleanup
    --work 12000000 -o "${_output}" "${_input}")
  file(READ "${_output}" _expanded)
  string(FIND "${_expanded}" "pick() .locals" _end)
  string(SUBSTRING "${_expanded}" 0 ${_end} _main)
  if(_main MATCHES "(^|\n)[ \t]*(call[234]?|linkarg)[ \t]" OR _main MATCHES "(^|\n)(add7|joined|child):")
    message(FATAL_ERROR "Runtime suffix retained its outer call/index or shared a source label")
  endif()
  string(REGEX MATCHALL "(^|\n)[ \t]*ichkrng " _guards "${_main}")
  string(REGEX MATCHALL "(^|\n)[ \t]*move " _moves "${_main}")
  list(LENGTH _guards _guard_count)
  list(LENGTH _moves _move_count)
  if(NOT _guard_count EQUAL 2 OR NOT _move_count EQUAL 6 OR NOT _main MATCHES "(^|\n)[ \t]*brf _inline[.]")
    message(FATAL_ERROR "Runtime branch needs one prefix/check and independent finite-case exits")
  endif()
  if(NOT _case STREQUAL "early")
    string(REGEX MATCHALL "[.]meta \"pick[.]which[.][$]inline[.][^\"]+\"=\"b\"" _opens "${_main}")
    string(REGEX MATCHALL "[.]meta \"pick[.]which[.][$]inline[.][^\"]+\"\n" _closes "${_main}")
    list(LENGTH _opens _open_count)
    list(LENGTH _closes _close_count)
    if(NOT _open_count EQUAL 6 OR NOT _close_count EQUAL 6)
      message(FATAL_ERROR "Each case needs one matched scoped binding")
    endif()
  endif()
  if(NOT _case STREQUAL "early" AND NOT _case STREQUAL "child-skip-reached")
    foreach(_amount 7 9)
      if(_case STREQUAL "selector-write" AND _amount EQUAL 9)
        continue()
      endif()
      string(REGEX MATCH "[.]srcstep ([0-9]+) ([0-9]+) [^\n]*\"selected plus ${_amount}\"\n[ \t]*iadd r([0-9]+),r[0-9]+,${_amount}\n[ \t]*[.]traceevent \"O\" 4 \"R\" \"I\" \"r\" ([0-9]+) ([0-9]+) ([0-9]+)" _trace "${_main}")
      if(NOT _trace OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_5 OR NOT CMAKE_MATCH_2 STREQUAL CMAKE_MATCH_6 OR NOT CMAKE_MATCH_3 STREQUAL CMAKE_MATCH_4)
        message(FATAL_ERROR "Branch write lost exact source/TRACE register or identity")
      endif()
    endforeach()
  endif()
  bound_pair("branch-${_case}" "${_original}" "${_expanded}" "${_first}\n${_second}\n${_text}\n${_flags}\n${_actuals}\ncontinued")
endforeach()

# Both newly executed mutation edges have the ordinary silent-CANCEL oracle.
# Fresh owner scratch observes components before terminal owned-base teardown.
foreach(_edge 7 9)
  set(_stem first)
  set(_expected "17\nten\n256")
  if(_edge EQUAL 9)
    set(_stem middle)
    set(_expected "29\ntwenty\n512")
  endif()
  foreach(_kind original expanded)
    set(_path "${WORK}/branch-${_stem}.rxas")
    set(_owner pick)
    if(_kind STREQUAL "expanded")
      set(_path "${WORK}/branch-${_stem}-expanded.rxas")
      set(_owner main)
    endif()
    file(READ "${_path}" _injected)
    string(REGEX MATCH "${_owner}[(][)] [.]locals=([0-9]+)" _header "${_injected}")
    set(_scratch "r${CMAKE_MATCH_1}")
    math(EXPR _locals "${CMAKE_MATCH_1} + 1")
    string(FIND "${_injected}" "${_header}" _start)
    string(SUBSTRING "${_injected}" 0 ${_start} _before)
    string(SUBSTRING "${_injected}" ${_start} -1 _body)
    set(_after "")
    if(_kind STREQUAL "expanded")
      string(FIND "${_body}" "pick() .locals" _end)
      string(SUBSTRING "${_body}" ${_end} -1 _after)
      string(SUBSTRING "${_body}" 0 ${_end} _body)
    endif()
    string(REPLACE "${_header}" "${_owner}() .locals=${_locals}" _body "${_body}")
    string(REGEX MATCHALL "(^|\n)[ \t]*iadd r[0-9]+,r[0-9]+,${_edge}\n" _rows "${_body}")
    list(LENGTH _rows _count)
    if(_count EQUAL 0)
      message(FATAL_ERROR "Missing branch mutation boundary")
    endif()
    list(REMOVE_DUPLICATES _rows)
    foreach(_row IN LISTS _rows)
      string(REGEX REPLACE ".*iadd (r[0-9]+),.*" "\\1" _selected "${_row}")
      set(_probe ".srcstep 99 99 17 \"runtime-branch-cancel.g\" 9 3 15 \"branch boundary\"\nicopy ${_scratch},${_selected}\nitos ${_scratch}\nsay ${_scratch}\nsay ${_selected}\ngetandtp ${_scratch},${_selected},768\nitos ${_scratch}\nsay ${_scratch}\nsignal \"CANCEL\",${_selected}\n")
      string(REPLACE "${_row}" "${_row}${_probe}" _body "${_body}")
    endforeach()
    set(_product "${WORK}/branch-cancel-${_edge}-${_kind}")
    file(WRITE "${_product}.rxas" "${_before}${_body}${_after}")
    run_checked("assemble branch CANCEL" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
    run_checked("execute branch CANCEL" "${VM}" "${_product}.rxbin")
    expect_output("${_expected}")
    if(NOT _last_stderr STREQUAL "")
      message(FATAL_ERROR "Default CANCEL must terminate silently: ${_last_stderr}")
    endif()
  endforeach()
endforeach()

foreach(_case bypass overflow local-meta extra-selector multi-ret)
  set(_source "${_fixture}")
  set(_reason argument.selector.tail.entry.pending)
  if(_case STREQUAL "bypass")
    string(REPLACE "ichkrng a1,1,r3\n" "brt selected,a1\nichkrng a1,1,r3\nselected:\n" _source "${_source}")
  elseif(_case STREQUAL "overflow")
    string(REPLACE "iadd r3,r3,9" "iadd r3,r3,9223372036854775807" _source "${_source}")
    set(_reason arithmetic.write.availability.unproved)
  elseif(_case STREQUAL "local-meta")
    string(REPLACE "add7:\n" "add7:\n.meta \"local\"=\"b\" \".int\" r3\n" _source "${_source}")
    set(_reason metadata.scope.cfg.pending)
  elseif(_case STREQUAL "extra-selector")
    string(REPLACE "joined:\n" "joined:\nlinkarg r0,a1,1\n" _source "${_source}")
    set(_reason argument.selector.tail.selector.pending)
  else()
    string(REPLACE "iadd r3,r3,7" "ret r3" _source "${_source}")
    # This old fixture retains pick.which: lexical re-entry is still unproved.
    set(_reason metadata.scope.cfg.pending)
  endif()
  set(_input "${WORK}/branch-${_case}-keep.rxas")
  set(_output "${WORK}/branch-${_case}-kept.rxas")
  file(WRITE "${_input}" "${_source}")
  run_checked("retain runtime branch ${_case}" "${VM}" "${CLI}" ${RUNTIME} -a
    --module runtime-branch.rxas --profile closed-main-default-halt.v1 --no-cleanup
    --work 12000000 -o "${_output}" "${_input}")
  file(READ "${_output}" _kept)
  if(NOT _last_stderr MATCHES "${_reason}" OR NOT _kept MATCHES "call4 r4,pick[(][)]")
    message(FATAL_ERROR "Branch ${_case} lost precise refusal: ${_last_stderr}")
  endif()
endforeach()
include("${FIXTURES}/runtime-return-controls.cmake")
file(REMOVE_RECURSE "${WORK}")
message("RXAS_RUNTIME_BRANCH|failures=0")
