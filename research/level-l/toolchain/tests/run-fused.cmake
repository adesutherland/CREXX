cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER CLI CONSTRUCTED GENERATED FIXTURES WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
function(run_checked _description)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE _status
    OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 90)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "${_description}: ${_status}\n${_stdout}${_stderr}")
  endif()
  set(_last_stdout "${_stdout}" PARENT_SCOPE)
  set(_last_stderr "${_stderr}" PARENT_SCOPE)
endfunction()
function(read_main _path)
  file(STRINGS "${_path}" _lines ENCODING UTF-8)
  set(_inside OFF)
  set(_calls 0)
  set(_swaps 0)
  set(_fused 0)
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^[^ \t]+\\(\\)[ \t]+\\.locals=")
      if(_line MATCHES "^main\\(\\)[ \t]")
        set(_inside ON)
      else()
        set(_inside OFF)
      endif()
    elseif(_inside)
      if(_line MATCHES "^[ \t]*(call[0-9]*|swapcall|settpswapcall|settpcall)[ \t]")
        math(EXPR _calls "${_calls} + 1")
      endif()
      if(_line MATCHES "^[ \t]*(swapcall|settpswapcall|settpcall)[ \t]")
        math(EXPR _fused "${_fused} + 1")
      endif()
      if(_line MATCHES "^[ \t]*swap[ \t]")
        math(EXPR _swaps "${_swaps} + 1")
      endif()
    endif()
  endforeach()
  set(_calls "${_calls}" PARENT_SCOPE)
  set(_swaps "${_swaps}" PARENT_SCOPE)
  set(_fused "${_fused}" PARENT_SCOPE)
endfunction()

run_checked("constructed fused contracts" "${VM}" "${CONSTRUCTED}" ${RUNTIME})
if(NOT _last_stdout MATCHES "FUSED_INLINE[|]failures=0")
  message(FATAL_ERROR "constructed fused contracts did not pass: ${_last_stdout}${_last_stderr}")
endif()
read_main("${GENERATED}")
if(_fused LESS 1)
  message(FATAL_ERROR "actual native-generated consumer contains no fused call")
endif()
foreach(_case handwritten generated)
  set(_source "${FIXTURES}/io-fused.rxas")
  set(_expected "1\n10\n11\n256\n256\n0\n7\n8\n8\n9\n10\n77\n2163968\n1024\n1024")
  if(_case STREQUAL "generated")
    set(_source "${GENERATED}")
    set(_expected "5")
  endif()
  foreach(_mode original conservative cleaned)
    set(_product "${WORK}/${_case}-${_mode}")
    if(_mode STREQUAL "original")
      file(COPY_FILE "${_source}" "${_product}.rxas")
    else()
      set(_cleanup)
      if(_mode STREQUAL "conservative")
        set(_cleanup --no-cleanup)
      endif()
      run_checked("inline ${_case} ${_mode}" "${VM}" "${CLI}" ${RUNTIME} -a
        --module "${_case}-fused.rxas" --profile closed-main-default-halt.v1
        --work 4000000 ${_cleanup} -o "${_product}.rxas" "${_source}")
      read_main("${_product}.rxas")
      if(_calls GREATER 0)
        message(FATAL_ERROR "${_case} ${_mode} retained a selected call")
      endif()
      if(_case STREQUAL "handwritten")
        if(_mode STREQUAL "conservative" AND _swaps LESS 5)
          message(FATAL_ERROR "conservative fused expansion lost authored preparation/restoration")
        endif()
        if(_mode STREQUAL "cleaned" AND _swaps GREATER 0)
          message(FATAL_ERROR "cleaned fused expansion retained proved outer swaps")
        endif()
      endif()
    endif()
    run_checked("assemble ${_case} ${_mode}" "${ASSEMBLER}" -n
      -o "${_product}" "${_product}.rxas")
    run_checked("execute ${_case} ${_mode}" "${VM}" "${_product}.rxbin")
    string(REPLACE "\r\n" "\n" _observed "${_last_stdout}")
    string(STRIP "${_observed}" _observed)
    if(NOT _observed STREQUAL _expected)
      message(FATAL_ERROR "${_case} ${_mode}: expected '${_expected}', got '${_observed}'")
    endif()
  endforeach()
endforeach()

set(_sentinel "${WORK}/last-good.rxas")
file(WRITE "${_sentinel}" "last-good fused output\n")
execute_process(COMMAND "${VM}" "${CLI}" ${RUNTIME} -a --module fused-limit.rxas
  --work 1 -o "${_sentinel}" "${FIXTURES}/io-fused.rxas"
  RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 90)
file(READ "${_sentinel}" _retained)
if(_status EQUAL 0 OR NOT _retained STREQUAL "last-good fused output\n")
  message(FATAL_ERROR "fused resource failure damaged last-good output: ${_stdout}${_stderr}")
endif()
message(STATUS "RXAS_FUSED|failures=0")
file(REMOVE_RECURSE "${WORK}")
