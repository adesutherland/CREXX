/* Single golden activations plus Unicode/NUL and scalar alias copyback. */
.globals=0
main() .locals=11
  numsci 18,1,1
  load r0,"λ\x00z"
  .srcstep 1 1 17 "concat-caller.rxas" 1 1 21 "result = readText(text)"
  call1 r1,readText(),r0
  .traceevent "F" 4 "R" "S" "r" 1 1 1 0 "readtext" ""
  say r1
  load r2,"same"
  call2 r3,combine_text(),r2,r2
  .traceevent "F" 4 "R" "S" "r" 3 1 1 0 "combine_text" ""
  say r3
  null r4
  load r4,42
  load r4,"λ"
  load r4,0xDEAD
  settp r4,512
  call1 r5,pad_alias(),r4
  say r5
  icopy r10,r5
  itos r10
  say r10
  getandtp r10,r5,768
  itos r10
  say r10
  bineq r10,r5,0xDEAD
  itos r10
  say r10
  say r4
  icopy r10,r4
  itos r10
  say r10
  getandtp r10,r4,768
  itos r10
  say r10
  bineq r10,r4,0xDEAD
  itos r10
  say r10
  null r8
  call1 r9,empty_pad(),r8
  say "["
  say r9
  say "]"
  ret 0
readText() .locals=2
   .meta "arg_semantics_scalar.readtext"="b" ".string" readText() "text=.string"
   .srcstep 27 27 17 "arg_semantics_scalar.crexx" 33 1 30 "readText: procedure = .string"
   numsci 18,1,1
   .srcstep 25 25 17 "arg_semantics_scalar.crexx" 34 7 21 "  arg text = .string"
   .meta "arg_semantics_scalar.readtext.text"="b" ".string" a1
   .srcstep 26 26 17 "arg_semantics_scalar.crexx" 35 3 25 "  return text || \":read\""
   .traceevent "V" 6 "R" "S" "a" 1 26 26 0 "text" ""
   concat r1,a1,":read"
   .traceevent "O" 4 "R" "S" "r" 1 26 26 0 "" ""
   ret r1
   .meta "arg_semantics_scalar.readtext.text"

combine_text() .locals=3
   .meta "repro_duplicate_call_argument.combine_text"="b" ".string" combine_text() "left=.string,right=.string"
   .srcstep 16 16 17 "repro_duplicate_call_argument.crexx" 17 1 34 "combine_text: procedure = .string"
   numsci 18,1,1
   .srcstep 13 13 17 "repro_duplicate_call_argument.crexx" 18 7 21 "  arg left = .string, right = .string"
   .meta "repro_duplicate_call_argument.combine_text.left"="b" ".string" a1
   .srcstep 14 14 17 "repro_duplicate_call_argument.crexx" 18 23 38 "  arg left = .string, right = .string"
   .meta "repro_duplicate_call_argument.combine_text.right"="b" ".string" a2
   .srcstep 15 15 17 "repro_duplicate_call_argument.crexx" 19 3 30 "  return left || \":\" || right"
   .traceevent "V" 6 "R" "S" "a" 1 15 15 0 "left" ""
   concat r2,a1,":"
   .traceevent "O" 4 "R" "S" "r" 2 15 15 0 "" ""
   .traceevent "V" 6 "R" "S" "a" 2 15 15 0 "right" ""
   concat r2,r2,a2
   .traceevent "O" 4 "R" "S" "r" 2 15 15 0 "" ""
   ret r2
   .meta "repro_duplicate_call_argument.combine_text.left"
   .meta "repro_duplicate_call_argument.combine_text.right"

pad_alias() .locals=0
  .srcstep 201 7 17 "concat-alias.rxas" 201 1 20 "value = value space empty"
  .traceevent "V" 6 "R" "S" "a" 1 201 7 0 "pad-before" ""
  sconcat a1,a1,""
  .traceevent "O" 4 "R" "S" "a" 1 201 7 0 "pad-after" ""
  ret a1
empty_pad() .locals=0
  sconcat a1,"",a1
  ret a1
