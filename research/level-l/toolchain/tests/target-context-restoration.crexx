/* cREXX License (MIT). Independent numeric restoration-plan consumer. */
options levelb
import rxfnsb
import llir
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetflow
import lltargetsummary
import lltargetremap
import llrxascatalog

check: procedure = .int
  arg condition = .int, message = .string
  if condition then return 0
  say 'FAIL:' message
  return 1
one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, value = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = value as .object
  return body.emit(name,fields,at)
two: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object
  return body.emit(name,fields,at)
enumerable: procedure = .int
  arg plan = .lltargetsummary..restorationfact
  do
    count = plan.fields()
    return 1
    on signal
      return 0
  end
  return 0

run: procedure = .int
  arg mode = .int
  failures = 0; ignored = .int; i = .int; seeded = .int; called = .int; mainret = .int; changed = .int; leafret = .int; destination = .int; expected = .string
  draft = .lltarget..draft('context.restore.' || mode,'fixture:context.restore',0)
  at = draft.synthetic('context delta and all departures have independent evidence')
  root = draft.procedure('main',1,at)
  if mode = 1 then seeded = one(root,'setnumdgts',.lltarget..operand.integer(53),at)
  else seeded = two(root,'load',root.reg('r',0),.lltarget..operand.integer(0),at)
  if mode = 1 | mode = 6 then do
    fields = .object[]; fields[1] = root.reg('r',0) as .object; fields[2] = .lltarget..operand.procedure('leaf') as .object; fields[3] = root.reg('r',0) as .object
    called = root.emit('call1',fields,at)
  end
  else called = two(root,'call',root.reg('r',0),.lltarget..operand.procedure('leaf'),at)
  mainret = one(root,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('leaf',1,at)
  if mode = 1 | mode = 6 then changed = one(leaf,'setnumdgts',.lltarget..operand.integer(20),at)
  else changed = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(1),at)
  leafret = one(leaf,'ret',.lltarget..operand.integer(7),at)
  source = draft.finish()
  failures = failures + check(source.valid(),'restoration fixture validates ' || mode)
  if source.valid() = 0 then do; say source.error(); return failures; end
  catalog = .llrxascatalog..catalog(); getter = catalog.find('getnumdgts','R')
  premise = .lltargettransfer..profiledraft(reference source,'fixture.context.restore.' || mode)
  integer = premise.domain('component','fixture.integer',catalog.componentmask('I'))
  nativebit = catalog.contextreadmask(getter)
  if mode = 2 then nativebit = 0
  contextdomain = premise.domain('context','fixture.digits',nativebit)
  do i = 1 to source.records()
    item = source.record(i)
    if item.kind() <> 'procedure' & item.procedureid() > 1 then ignored = premise.operation(item.id())
  end
  if mode <> 1 then do
    destination = premise.ref(seeded,1)
    ignored = premise.event(seeded,'write',destination,integer,'literal',0,.lltarget..operand.integer(0))
  end
  if mode <> 6 then ignored = premise.event(seeded,'context',0,contextdomain,'literal',0,.lltarget..operand.integer(53))
  provider = premise.ref(called,2,'procedure','symbolic')
  ignored = premise.event(called,'call',0,0,'reference',provider)
  ignored = premise.event(mainret,'return',0,integer,'literal',0,.lltarget..operand.integer(0))
  if mode <> 1 & mode <> 6 then do
    destination = premise.ref(changed,1)
    ignored = premise.event(changed,'write',destination,integer,'literal',0,.lltarget..operand.integer(1))
  end
  if mode > 0 then ignored = premise.event(changed,'context',0,contextdomain,'literal',0,.lltarget..operand.integer(20))
  if mode = 3 then ignored = premise.event(changed,'edge',0,0,'none',0,.lltarget..operand(),'may','all','after','async')
  if mode = 4 then ignored = premise.event(changed,'callback',0,0,'none',0,.lltarget..operand(),'may','all','unknown','fixture.observer')
  if mode = 5 then call premise.unknown(changed,'numeric','fixture missing context writer contract')
  if mode = 7 then ignored = premise.event(changed,'edge',0,0,'literal',0,.lltarget..operand.string('OTHER' as .binary),'may','failure','after','terminal')
  ignored = premise.event(leafret,'return',0,integer,'literal',0,.lltarget..operand.integer(7))
  profile = premise.finish(); cfg = .lltargetcfg..graph(reference source,reference profile)
  flow = .lltargetflow..analysis(reference source,reference profile,reference cfg)
  failures = failures + check(profile.status() = 'ok' & cfg.status() = 'ok' & flow.status() = 'ok','restoration evidence builds ' || mode)
  if profile.status() <> 'ok' | cfg.status() <> 'ok' | flow.status() <> 'ok' then do
    say profile.message(); say cfg.message(); say flow.message(); return failures
  end
  summaries = .lltargetsummary..analysis(reference flow)
  plan = summaries.contextrestoration(called)
  failures = failures + check(plan.valid() & plan.operation() = called & plan.procedure() = source.procedureid('leaf'),'restoration binds exact call and body ' || mode)
  if mode = 0 then do
    failures = failures + check(plan.allowed(),'no written numeric field needs no save or restore')
    if plan.allowed() then failures = failures + check(plan.fields() = 0 & plan.saves() = 0 & plan.exits() = 0,'zero delta publishes a zero-cost plan')
    repeated = summaries.contextrestoration(called)
    failures = failures + check(repeated.allowed() & repeated.operation() = called,'repeated query uses the same frozen call')
    replacement = .lltarget..draft('replaced','fixture:replacement',0)
    at = replacement.synthetic('replace the exact proof owner'); body = replacement.procedure('main',0,at)
    ignored = one(body,'ret',.lltarget..operand.integer(0),at); source = replacement.finish()
    failures = failures + check(plan.valid() = 0 & plan.status() = 'invalid' & enumerable(plan) = 0,'replacing a source invalidates restoration enumeration')
  end
  else if mode = 1 | mode = 6 then do
    failures = failures + check(catalog.contextsynccontract() = 'value-only-nonreentrant.v1','numeric restoration uses the enforced value-only plugin contract')
    failures = failures + check(plan.allowed(),'RET-only licensed context delta has a complete restore plan ' || mode || ': ' || plan.reason())
    if plan.allowed() then do
      expectedmode = 'literal'; saves = 0; if mode = 6 then do; expectedmode = 'saved'; saves = 1; end
      failures = failures + check(plan.fields() = 1 & plan.mode(1) = expectedmode & plan.saves() = saves,'known and unknown caller digits choose exact literal/save lowering ' || mode)
      failures = failures + check(plan.getter(1) = 'getnumdgts' & plan.setter(1) = 'setnumdgts' & plan.exits() = 1 & plan.exit(1) = leafret,'restore is bound to the numeric field and original RET ' || mode)
      if mode = 1 then failures = failures + check(plan.literal(1).kind() = 'I' & plan.literal(1).index() = 53,'known caller digits restore the caller value')
      else failures = failures + check(plan.saveordinal(1) = 1,'unknown caller digits reserve one integer save cell')
      sourceops = .int[]; candidateops = .int[]; counts = .int[]
      candidate = numericcandidate(reference source,called,mainret,mode,0,sourceops,candidateops,counts)
      failures = failures + check(candidate.valid(),'independent licensed numeric candidate validates ' || mode || ': ' || candidate.error())
      if candidate.valid() then do
        clone = .lltargetsummary..diagnosticclone(reference summaries,called,reference candidate,10,sourceops,candidateops,counts,4000000)
        failures = failures + check(clone.status() = 'proved','typed checker certifies known/dynamic GET/SET restore shape ' || mode || ': ' || clone.reason())
      end
      /* Keep the source evidence and lowering shape fixed; change only the
       * published restoration value or the captured save-cell reference. */
      corrupted = numericcandidate(reference source,called,mainret,mode,1,sourceops,candidateops,counts)
      failures = failures + check(corrupted.valid(),'corrupted numeric candidate remains structurally valid ' || mode || ': ' || corrupted.error())
      if corrupted.valid() then do
        rejected = .lltargetsummary..diagnosticclone(reference summaries,called,reference corrupted,10,sourceops,candidateops,counts,4000000)
        expected = 'target.diagnostic.clone.return.context.literal.mismatch'
        if mode = 6 then expected = 'target.diagnostic.clone.return.context.saved.slot.mismatch'
        failures = failures + check(rejected.status() = 'unknown' & rejected.reason() = expected,'typed checker refuses wrong restore value/save cell ' || mode || ': ' || rejected.reason())
      end
    end
  end
  else do
    expected = 'target.context.restore.setter.callback.unproved'
    if mode = 2 then expected = 'target.context.restore.domain.unrepresented'
    else if mode = 3 then expected = 'target.context.restore.async.unproved'
    else if mode = 4 then expected = 'target.context.restore.callback.unproved'
    else if mode = 5 then expected = 'target.context.restore.effects.unproved'
    else if mode = 7 then expected = 'target.context.restore.departure.unproved'
    failures = failures + check(plan.allowed() = 0 & plan.status() = 'unknown' & plan.reason() = expected,'unproved context plan identifies its obligation ' || mode || ': ' || plan.reason())
    failures = failures + check(enumerable(plan) = 0,'unproved plan cannot expose a partial restore list ' || mode)
  end
  return failures

/** Construct the expected lowering independently of the inliner. These
 * synchronous operational facts license RET-only restoration; canonical
 * ambient asynchronous exits remain a separate admission obligation. */
numericcandidate: procedure = .lltarget..module
  arg owner = reference .lltarget..module, callid = .int, mainretid = .int, mode = .int, corrupt = .int, expose sourceops = .int[], expose candidateops = .int[], expose counts = .int[]
  ignored = .int; i = .int
  source = dereference owner; callitem = source.at(callid); provider = source.body(source.procedureid('leaf'))
  graphref = source.ir(); sources = .object[]; origins = .object[]; fields = .object[]
  draft = .lltarget..draft('numeric.candidate.' || mode,'fixture:numeric.candidate',0)
  at = lltargetremap..copyorigin(graphref,callitem.origin(),reference draft,reference sources,reference origins)
  body = draft.procedure('main',4,at)
  if mode = 1 then ignored = one(body,'setnumdgts',.lltarget..operand.integer(53),at)
  else ignored = two(body,'load',body.reg('r',0),.lltarget..operand.integer(0),at)
  fields[1] = .lltarget..operand.integer(10) as .object; fields[2] = .lltarget..operand.integer(0) as .object
  fields[3] = .lltarget..operand.string(source.name() as .binary) as .object; fields[4] = .lltarget..operand.string('leaf' as .binary) as .object; fields[5] = .lltarget..operand.integer(0) as .object
  ignored = body.record('.inlineframe',fields,at); ordinal = 0
  if mode = 6 then do
    ordinal = 1; sourceops[ordinal] = 0; candidateops[ordinal] = one(body,'getnumdgts',body.reg('r',3),at); counts[ordinal] = 1
  end
  call objectarraydrop fields
  do i = 1 to 8
    if i = 4 | i = 8 then fields[i] = .lltarget..operand.string('' as .binary) as .object
    else fields[i] = .lltarget..operand.integer(0) as .object
  end
  ignored = body.record('.srcstep',fields,at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.symbol('clone.begin') as .object; ignored = body.record('label',fields,at)
  do i = 1 to provider.records()
    child = provider.record(i)
    if child.kind() <> 'instruction' then iterate
    ordinal = ordinal + 1; sourceops[ordinal] = child.id()
    childat = lltargetremap..copyorigin(graphref,child.origin(),reference draft,reference sources,reference origins)
    if child.mnemonic() = 'setnumdgts' then do
      candidateops[ordinal] = one(body,'setnumdgts',.lltarget..operand.integer(20),childat); counts[ordinal] = 1
    end
    else do
      candidateops[ordinal] = two(body,'load',body.reg('r',2),.lltarget..operand.integer(7),childat); counts[ordinal] = 4
      ignored = two(body,'icopy',body.reg('r',0),body.reg('r',2),childat)
      if mode = 1 then do
        restorevalue = 53; if corrupt then restorevalue = 54
        ignored = one(body,'setnumdgts',.lltarget..operand.integer(restorevalue),childat)
      end
      else do
        saveslot = 3; if corrupt then saveslot = 2
        ignored = one(body,'setnumdgts',body.reg('r',saveslot),childat)
      end
      ignored = one(body,'br',.lltarget..operand.symbol('clone.after'),childat)
    end
  end
  call objectarraydrop fields; fields[1] = .lltarget..operand.symbol('clone.after') as .object; ignored = body.record('label',fields,at)
  mainret = source.at(mainretid); returnat = lltargetremap..copyorigin(graphref,mainret.origin(),reference draft,reference sources,reference origins)
  ignored = one(body,'ret',.lltarget..operand.integer(0),returnat)
  call objectarraydrop fields; fields[1] = .lltarget..operand.symbol('clone.begin') as .object; fields[2] = .lltarget..operand.symbol('clone.after') as .object; fields[3] = .lltarget..operand.integer(10) as .object
  ignored = body.record('.inlinemap',fields,at)
  return draft.finish()

main: procedure = .int
  failures = 0
  empty = .lltargetsummary..restorationfact()
  failures = failures + check(empty.valid() = 0 & empty.status() = 'invalid' & enumerable(empty) = 0,'unbound plan supplies no restoration authority')
  do mode = 0 to 7; failures = failures + run(mode); end
  say 'TARGET_CONTEXT_RESTORATION|failures=' || failures
  return failures
