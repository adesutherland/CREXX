/* Byte-exact observations use BINEQ, not a string conversion of binary data.
 * All calls finish before presentation changes any string component. */
.globals=0
main() .locals=25
  load r0,0
  call1 r1,emptybytes(),r0
  call1 r2,ownedbytes(),r0
  call1 r3,ownedbytes(),r0
  load r4,17
  settp r4,256
  load r4,"coexist λ"
  load r4,0x0041FF
  call1 r5,borrowedbytes(),r4
  call1 r6,reboundbytes(),r4
  call2 r7,bytesnapshot(),r4,r4
  bineq r8,r1,0x
  bineq r9,r2,0x0041ff
  bineq r10,r3,0X0041FF
  bineq r11,r5,0x0041FF
  bineq r12,r6,0x0041FF
  bineq r13,r7,0x0041FF
  bineq r14,r4,0xAA
  icopy r15,r7
  getandtp r16,r7,768
  icopy r17,r5
  getandtp r18,r5,768
  bineq r5,r5,0x0041FF
  getandtp r19,r5,768
  bineq r20,r5,0x0041FF
  bineq r21,r5,0xAA
  load r22,0xDEAD
  icopy r23,r2
  getandtp r24,r2,768
  say "empty"
  itos r8
  say r8
  say "owned-repeat"
  itos r9
  say r9
  itos r10
  say r10
  say r2
  itos r23
  say r23
  itos r24
  say r24
  say "borrowed"
  itos r11
  say r11
  say r6
  itos r17
  say r17
  itos r18
  say r18
  say "rebound"
  itos r12
  say r12
  say "snapshot"
  itos r13
  say r13
  say r7
  itos r15
  say r15
  itos r16
  say r16
  say "actual-after"
  itos r14
  say r14
  say "observer-alias"
  itos r5
  say r5
  itos r20
  say r20
  itos r19
  say r19
  say "mismatch"
  itos r21
  say r21
  ret 0
emptybytes() .locals=1
  load r0,0
  load r0,0X
  ret r0
ownedbytes() .locals=1
  load r0,11
  settp r0,256
  load r0,"owned λ"
  load r0,0x0041FF
  ret r0
borrowedbytes() .locals=0
  ret a1
reboundbytes() .locals=1
  link r0,a1
  ret r0
bytesnapshot() .locals=1
  null r0
  load r0,23
  settp r0,512
  load r0,"snapshot λ"
  bcopy r0,a1
  load a2,0xAA
  ret r0
