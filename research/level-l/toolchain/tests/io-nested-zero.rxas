/* Counted CALL0 does not clear its result. Replacing it by the two-operand
 * CALL would destroy73 before the child's bare RET. */
.globals=0
main() .locals=3
  load r0,5
  getandtp r1,r0,768
  call1 r2,outerzero(),r1
  itos r2
  say r2
  ret 0
outerzero() .locals=2
  null r0
  load r0,73
  load r1,0
  brt zero_join,a1
  cnop
zero_join:
  call r0,barezero(),r1
  ret r0
barezero() .locals=0
  ret
