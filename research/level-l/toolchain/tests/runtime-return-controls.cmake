# Included by the existing serial runtime-branch panel; all producers are shared.
function(runtime_return_controls)
  if(DEFINED CONSTRUCTED)
    foreach(_lane runtime-infeasible-return runtime-nonuniform-restore)
      set(_expected "LL_TARGET_FACTS_ID: infeasible case RET")
      if(_lane STREQUAL "runtime-nonuniform-restore")
        set(_expected "LL_TARGET_FACTS_RETURN: case-aware restoration required")
      endif()
      execute_process(COMMAND "${VM}" "${CONSTRUCTED}" -a "${_lane}"
        RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
      if(_status EQUAL 0 OR NOT _stderr MATCHES "${_expected}" OR _stdout MATCHES "UNEXPECTED_")
        message(FATAL_ERROR "Sealed RET query ${_lane} changed: ${_status}\n${_stdout}${_stderr}")
      endif()
    endforeach()
  endif()
  file(READ "${FIXTURES}/io-linkarg-runtime-child.rxas" _native)
  string(FIND "${_native}" "pick() .locals" _end)
  string(SUBSTRING "${_native}" 0 ${_end} _caller)
  set(_prefix "pick() .locals=5\n.srcstep 20 20 17 \"runtime-returns.g\" 10 3 17 \"checked selection\"\nicopy r3,a0\nisub r3,r3,1\nichkrng a1,1,r3\nlinkarg r3,a1,1\nnull r4\nisub r4,r3,10\n")
  set(_owned "brf add7,r4\niadd r3,r3,9\ncopy r4,r3\nunlink r3\n.srcstep 21 21 17 \"runtime-returns.g\" 11 3 12 \"return owned\"\n.traceevent \"V\" 6 \"R\" \"I\" \"r\" 4 21 21 0 \"owned\" \"\"\nret r4\n")
  set(_borrowed "add7:\niadd r3,r3,7\n.srcstep 22 22 17 \"runtime-returns.g\" 12 3 15 \"return borrowed\"\n.traceevent \"V\" 6 \"R\" \"I\" \"r\" 3 22 22 0 \"selected\" \"\"\nret r3\n")
  set(_fixture "${_caller}${_prefix}${_owned}${_borrowed}")
  set(_unchanged "10\nten\n256\n20\ntwenty\n512\n30\nthirty\n768")
  foreach(_case first middle last dynamic-zero dynamic-one alias repeated matrix1 matrix2 matrix3 component1 component2 component3 child-skip-reached)
    set(_original "${_fixture}")
    set(_first 17)
    set(_second 26)
    set(_text ten)
    set(_flags 256)
    set(_actuals "26\nten\n256\n20\ntwenty\n512\n30\nthirty\n768")
    if(_case STREQUAL "middle" OR _case STREQUAL "repeated" OR _case STREQUAL "matrix2" OR _case STREQUAL "component2" OR _case STREQUAL "child-skip-reached")
      string(REPLACE "load r7,0x00" "load r7,0x01" _original "${_original}")
      set(_first 29)
      set(_second 38)
      set(_text twenty)
      set(_flags 512)
      set(_actuals "10\nten\n256\n38\ntwenty\n512\n30\nthirty\n768")
    elseif(_case STREQUAL "last" OR _case STREQUAL "matrix3" OR _case STREQUAL "component3")
      string(REPLACE "load r7,0x00" "load r7,0x01" _original "${_original}")
      string(REPLACE "load r8,0x00" "load r8,0x01" _original "${_original}")
      set(_first 39)
      set(_second 48)
      set(_text thirty)
      set(_flags 768)
      set(_actuals "10\nten\n256\n20\ntwenty\n512\n48\nthirty\n768")
    endif()
    if(_case MATCHES "^dynamic-")
      set(_byte 0x00)
      if(_case STREQUAL "dynamic-one")
        set(_byte 0x01)
        set(_first 20)
        set(_second 29)
        set(_actuals "29\nten\n256\n20\ntwenty\n512\n30\nthirty\n768")
      endif()
      string(REPLACE "main() .locals=10" "main() .locals=11" _original "${_original}")
      string(REPLACE "  call4 r4,pick()" "  load r10,${_byte}\n  bineq r9,r10,0x01\n  iadd r1,r1,r9\n  call4 r4,pick()" _original "${_original}")
    elseif(_case STREQUAL "alias")
      string(REPLACE "call4 r4,pick()" "call4 r1,pick()" _original "${_original}")
      string(REPLACE "\"r\" 4 1 1 0 \"pick\"" "\"r\" 1 1 1 0 \"pick\"" _original "${_original}")
      string(REPLACE "icopy r9,r4" "icopy r9,r1" _original "${_original}")
      set(_first 26)
    elseif(_case STREQUAL "repeated")
      string(REPLACE "pick(),r0,r1,r2,r3" "pick(),r0,r1,r1,r3" _original "${_original}")
      set(_first 17)
      set(_second 26)
      set(_text ten)
      set(_flags 256)
      set(_actuals "26\nten\n256\n20\ntwenty\n512\n30\nthirty\n768")
    elseif(_case MATCHES "^(matrix|component)")
      string(REPLACE "null r4\nisub r4,r3,10\n${_owned}${_borrowed}" "" _original "${_original}")
      string(REPLACE "  call4 r4,pick()" "  load r4,99\n  load r4,\"seed\"\n  settp r4,512\n  load r5,99\n  load r5,\"seed\"\n  settp r5,512\n  call4 r4,pick()" _original "${_original}")
      set(_first 99)
      set(_second 99)
      set(_text seed)
      set(_flags 512)
      set(_actuals "${_unchanged}")
      if(_case MATCHES "^matrix")
        string(APPEND _original "null r4\nisub r4,a1,3\nbrf bare,r4\nisub r4,a1,1\nbrf owned,r4\nbr shared\nowned:\nunlink r3\nnull r3\nload r3,71\nload r3,\"owned\"\nsettp r3,256\nswap a2,a3\nbr shared\nbare:\nret\nshared:\nret r3\n")
        if(_case STREQUAL "matrix1")
          set(_first 71)
          set(_second 71)
          set(_text owned)
          set(_flags 256)
        elseif(_case STREQUAL "matrix2")
          set(_first 20)
          set(_second 20)
          set(_text twenty)
        endif()
      else()
        string(APPEND _original "null r4\nisub r4,a1,1\nbrf bare,r4\nisub r4,a1,2\nbrf integer,r4\nret \"λ\"\nbare:\nret\ninteger:\nret 37\n")
        if(_case STREQUAL "component2")
          set(_first 37)
          set(_second 37)
        elseif(_case STREQUAL "component3")
          set(_text λ)
        endif()
      endif()
    elseif(_case STREQUAL "child-skip-reached")
      string(REPLACE "${_owned}${_borrowed}" "brf child,r4\nload r4,-1\nunlink r3\nret r4\nchild:\ncall1 r4,bump(),r3\nunlink r3\nret r4\nbump() .locals=0\niadd a1,a1,7\nret a1\n" _original "${_original}")
      string(REPLACE "  call4 r5,pick()" "  load r7,0x00\n  bineq r0,r7,0x01\n  bineq r6,r8,0x01\n  iadd r0,r0,r6\n  iadd r0,r0,1\n  call4 r5,pick()" _original "${_original}")
      set(_first -1)
      set(_second 17)
      set(_text ten)
      set(_flags 256)
      set(_actuals "17\nten\n256\n20\ntwenty\n512\n30\nthirty\n768")
    endif()
    set(_input "${WORK}/returns-${_case}.rxas")
    set(_output "${WORK}/returns-${_case}-expanded.rxas")
    file(WRITE "${_input}" "${_original}")
    run_checked("expand runtime returns ${_case}" "${VM}" "${CLI}" ${RUNTIME} -a
      --module runtime-returns.rxas --profile closed-main-default-halt.v1 --no-cleanup
      --work 12000000 -o "${_output}" "${_input}")
    file(READ "${_output}" _expanded)
    string(FIND "${_expanded}" "pick() .locals" _end)
    string(SUBSTRING "${_expanded}" 0 ${_end} _main)
    if(_main MATCHES "(^|\n)[ \t]*(call[234]?|linkarg)[ \t]" OR _main MATCHES "(^|\n)(add7|owned|shared|bare|integer|child):")
      message(FATAL_ERROR "Multiple RETs retained their selected outer call/index or source label")
    endif()
    if(_case MATCHES "^(first|middle|last|dynamic-zero|dynamic-one)$")
      # Only first-site facts have the initial exact actuals. Later call sites
      # can retain both exits after caller-state meets widen the actuals.
      string(REGEX MATCH "[.]traceevent \"F\"[^\n]*\"pick\"[^\n]*" _boundary "${_main}")
      string(FIND "${_main}" "${_boundary}" _end)
      string(SUBSTRING "${_main}" 0 ${_end} _first_site)
      string(REGEX MATCHALL "(^|\n)[ \t]*move " _moves "${_first_site}")
      list(LENGTH _moves _move_count)
      set(_expected_moves 2)
      if(_case MATCHES "^dynamic-")
        set(_expected_moves 3)
      endif()
      if(NOT _move_count EQUAL _expected_moves)
        message(FATAL_ERROR "First-site feasible owned exits changed")
      endif()
      foreach(_kind borrowed owned)
        set(_instruction copy)
        if(_kind STREQUAL "owned")
          set(_instruction move)
        endif()
        string(REGEX MATCH "[.]srcstep ([0-9]+) ([0-9]+) [^\n]*\"return ${_kind}\"\n[ \t]*[.]traceevent \"V\" 6 \"R\" \"I\" \"r\" ([0-9]+) ([0-9]+) ([0-9]+)[^\n]*\n[ \t]*${_instruction} r[0-9]+,r([0-9]+)" _trace "${_first_site}")
        if(NOT _trace OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_4 OR NOT CMAKE_MATCH_2 STREQUAL CMAKE_MATCH_5 OR NOT CMAKE_MATCH_3 STREQUAL CMAKE_MATCH_6)
          message(FATAL_ERROR "Exact ${_kind} RET source/TRACE/action changed")
        endif()
      endforeach()
    endif()
    bound_pair("returns-${_case}" "${_original}" "${_expanded}" "${_first}\n${_second}\n${_text}\n${_flags}\n${_actuals}\ncontinued")
  endforeach()

  foreach(_point borrowed owned)
    set(_case first)
    set(_expected "17\nten\n256")
    if(_point STREQUAL "owned")
      set(_case middle)
      set(_expected "29\ntwenty\n512")
    endif()
    foreach(_kind original expanded)
      set(_path "${WORK}/returns-${_case}.rxas")
      set(_owner pick)
      if(_kind STREQUAL "expanded")
        set(_path "${WORK}/returns-${_case}-expanded.rxas")
        set(_owner main)
      endif()
      file(READ "${_path}" _injected)
      string(REGEX REPLACE "([.]traceevent \"F\"[^\n]*\n)" "\\1say \"result-observed\"\n" _injected "${_injected}")
      string(REGEX MATCH "${_owner}[(][)] [.]locals=([0-9]+)" _header "${_injected}")
      set(_scratch "r${CMAKE_MATCH_1}")
      math(EXPR _locals "${CMAKE_MATCH_1} + 1")
      string(FIND "${_injected}" "${_header}" _start)
      string(SUBSTRING "${_injected}" 0 ${_start} _before)
      string(SUBSTRING "${_injected}" ${_start} -1 _body)
      set(_after "")
      if(_kind STREQUAL "expanded")
        string(FIND "${_body}" "pick() .locals" _end)
        string(SUBSTRING "${_body}" ${_end} -1 _after)
        string(SUBSTRING "${_body}" 0 ${_end} _body)
      endif()
      string(REPLACE "${_header}" "${_owner}() .locals=${_locals}" _body "${_body}")
      string(REGEX MATCHALL "[.]srcstep [^\n]*\"return ${_point}\"\n[ \t]*[.]traceevent \"V\"[^\n]*\n" _rows "${_body}")
      list(LENGTH _rows _count)
      if(_count EQUAL 0)
        message(FATAL_ERROR "Missing exact ${_point} pre-RET boundary")
      endif()
      list(REMOVE_DUPLICATES _rows)
      foreach(_row IN LISTS _rows)
        string(REGEX MATCH "\"r\" ([0-9]+)" _field "${_row}")
        set(_value "r${CMAKE_MATCH_1}")
        set(_probe ".srcstep 99 99 17 \"runtime-return-cancel.g\" 9 3 19 \"return boundary\"\nicopy ${_scratch},${_value}\nitos ${_scratch}\nsay ${_scratch}\nsay ${_value}\ngetandtp ${_scratch},${_value},768\nitos ${_scratch}\nsay ${_scratch}\nsignal \"CANCEL\",${_value}\n")
        string(REPLACE "${_row}" "${_row}${_probe}" _body "${_body}")
      endforeach()
      set(_product "${WORK}/returns-cancel-${_point}-${_kind}")
      file(WRITE "${_product}.rxas" "${_before}${_body}${_after}")
      run_checked("assemble return CANCEL" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
      run_checked("execute return CANCEL" "${VM}" "${_product}.rxbin")
      expect_output("${_expected}")
      if(NOT _last_stderr STREQUAL "")
        message(FATAL_ERROR "Return-boundary CANCEL must be silent: ${_last_stderr}")
      endif()
    endforeach()
  endforeach()
  set(_output "${WORK}/returns-last-good.rxas")
  file(WRITE "${_output}" "multiple-RET-last-good\n")
  execute_process(COMMAND "${VM}" "${CLI}" ${RUNTIME} -a --module runtime-returns.rxas
    --profile closed-main-default-halt.v1 --no-cleanup --work 1 -o "${_output}"
    "${WORK}/returns-first.rxas" RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
  file(READ "${_output}" _last_good)
  if(_status EQUAL 0 OR NOT _stderr MATCHES "LL_INLINE_LIMIT" OR NOT _last_good STREQUAL "multiple-RET-last-good\n")
    message(FATAL_ERROR "Bounded multiple-RET refusal overwrote last-good output")
  endif()
  message("RXAS_RUNTIME_RETURNS|failures=0")
endfunction()
runtime_return_controls()
