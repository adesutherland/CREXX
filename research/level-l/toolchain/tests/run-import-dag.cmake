cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER LINKER CLI FIXTURES WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
set(_profile closed-main-static-exact-default-halt.v1)
set(_caller "${FIXTURES}/io-import-dag-caller.rxas")
set(_first "${FIXTURES}/io-import-dag-provider.rxas")
set(_second "${FIXTURES}/io-import-dag-other.rxas")
set(_expected "9\n11\n99\n11\n22")

function(run_checked _description)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE _status
    OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "${_description}: ${_status}\n${_stdout}${_stderr}")
  endif()
  set(_last_stdout "${_stdout}" PARENT_SCOPE)
  set(_last_stderr "${_stderr}" PARENT_SCOPE)
endfunction()

function(execute_pair _source _product _expected)
  run_checked("assemble ${_product}" "${ASSEMBLER}" -n -o "${_product}" "${_source}")
  run_checked("link ${_product}" "${LINKER}" -m "${_product}.map" -o "${_product}-linked"
    "${_product}.rxbin" ${ARGN})
  file(READ "${_product}.map" _map)
  foreach(_provider IN LISTS ARGN)
    string(FIND "${_map}" " from ${_provider}" _selected)
    if(_selected LESS 0)
      message(FATAL_ERROR "retained imports did not select exact provider ${_provider}")
    endif()
  endforeach()
  run_checked("execute ${_product}" "${VM}" "${_product}-linked.rxbin")
  string(REPLACE "\r\n" "\n" _actual "${_last_stdout}")
  string(STRIP "${_actual}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "${_product}: expected '${_expected}', got '${_actual}'")
  endif()
endfunction()

function(expect_failure _name _reason)
  set(_output "${WORK}/${_name}.rxas")
  file(WRITE "${_output}" "last-good-dag-output\n")
  execute_process(COMMAND "${VM}" "${CLI}" ${RUNTIME} -a
    --module io-import-dag-caller.rxas --profile "${_profile}" ${ARGN}
    -o "${_output}" "${_caller}"
    RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
  string(FIND "${_stdout}${_stderr}" "${_reason}" _found)
  file(READ "${_output}" _after)
  if(_status EQUAL 0 OR _found LESS 0 OR NOT _after STREQUAL "last-good-dag-output\n")
    message(FATAL_ERROR "${_name}: atomic failure '${_reason}' expected, got ${_status}: ${_stdout}${_stderr}")
  endif()
endfunction()

# The two immutable provider images are prepared once and reused for all links.
foreach(_owner first second)
  file(SHA256 "${_${_owner}}" _${_owner}_source_before)
  run_checked("assemble exact ${_owner} provider" "${ASSEMBLER}" -n
    -o "${WORK}/${_owner}" "${_${_owner}}")
  file(SHA256 "${WORK}/${_owner}.rxbin" _${_owner}_binary_before)
endforeach()
set(_providers "${WORK}/first.rxbin" "${WORK}/second.rxbin")
execute_pair("${_caller}" "${WORK}/original" "${_expected}" ${_providers})

foreach(_mode conservative cleaned)
  set(_cleanup_option)
  if(_mode STREQUAL "conservative")
    set(_cleanup_option --no-cleanup)
  endif()
  set(_product "${WORK}/dag-${_mode}")
  run_checked("expand imported DAG (${_mode})" "${VM}" "${CLI}" ${RUNTIME} -a
    --module io-import-dag-caller.rxas --profile "${_profile}" --work 6000000
    --body io-import-dag-provider.rxas "${_first}"
    --body io-import-dag-other.rxas "${_second}" ${_cleanup_option}
    -o "${_product}.rxas" "${_caller}")
  file(STRINGS "${_product}.rxas" _lines ENCODING UTF-8)
  set(_imports 0)
  set(_definitions 0)
  set(_owned 0)
  set(_borrowed 0)
  set(_condition 0)
  set(_points 0)
  set(_constants 0)
  set(_steps "")
  set(_labels "")
  set(_last_step "")
  set(_last_clause "")
  set(_pending "")
  set(_pending_register "")
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^(foreign|other)\\(\\)[ \t]+\\.expose=fixture\\.import\\.dag\\.(first|second)$")
      math(EXPR _imports "${_imports} + 1")
    elseif(_line MATCHES "^[^ \t]+\\(\\)[ \t]+\\.locals=")
      math(EXPR _definitions "${_definitions} + 1")
      if(NOT _line MATCHES "^(main|anchor)\\(\\)[ \t]+\\.locals=")
        message(FATAL_ERROR "${_mode}: provider/surrogate declaration leaked")
      endif()
    endif()
    if(_line MATCHES "^\\.const (positive|_import\\.label\\.3) string \"(unchanged constant|reserved generated name)\"$")
      math(EXPR _constants "${_constants} + 1")
    endif()
    if(_line MATCHES "^[ \t]*(call[0-9]*|swapcall|settpswapcall|settpcall)[ \t]" OR _line MATCHES "detached-dag")
      message(FATAL_ERROR "${_mode}: selected call or detached provider observation survived")
    endif()
    if(_line MATCHES "^([^ \t:]+):$")
      set(_label "${CMAKE_MATCH_1}")
      list(FIND _labels "${_label}" _duplicate)
      if(NOT _duplicate LESS 0 OR _label MATCHES "^(positive|negative|negative_alias|dispatch)$|^_import\\.label\\.")
        message(FATAL_ERROR "${_mode}: duplicate or unrelocated provider label ${_label}")
      endif()
      list(APPEND _labels "${_label}")
    endif()
    if(_line MATCHES "^[ \t]*\\.srcstep ([0-9]+) ([0-9]+) 0 \"io-import-dag-(provider|other)\\.rxas\" (11|19|23) 3 [0-9]+ ")
      set(_last_step "${CMAKE_MATCH_1}")
      set(_last_clause "${CMAKE_MATCH_2}")
      if(_last_step LESS_EQUAL 1 OR _last_clause LESS_EQUAL 1)
        message(FATAL_ERROR "${_mode}: provider source IDs collide with the caller")
      endif()
      list(APPEND _steps "${_last_step}")
      math(EXPR _points "${_points} + 1")
    endif()
    if(_line MATCHES "^[ \t]*\\.traceevent \"V\" 4 \"R\" \"I\" \"r\" ([0-9]+) ([0-9]+) ([0-9]+) 0 \"dag-(owned|borrowed|condition)\" \"\"$")
      set(_pending_register "r${CMAKE_MATCH_1}")
      if(NOT CMAKE_MATCH_2 STREQUAL _last_step OR NOT CMAKE_MATCH_3 STREQUAL _last_clause)
        message(FATAL_ERROR "${_mode}: provider TRACE lost its source/clause identity")
      endif()
      set(_pending "${CMAKE_MATCH_4}")
      math(EXPR _${_pending} "${_${_pending}} + 1")
    endif()
    if(NOT _pending STREQUAL "" AND _line MATCHES "^[ \t]*[A-Za-z][A-Za-z0-9]*[ \t]")
      if(_pending STREQUAL "condition")
        if(NOT _line MATCHES "^[ \t]*brtf [^,]+,[^,]+,${_pending_register}$")
          message(FATAL_ERROR "${_mode}: branch-entry TRACE moved off its condition: ${_line}")
        endif()
      elseif(_mode STREQUAL "conservative")
        set(_transfer copy)
        if(_pending STREQUAL "owned")
          set(_transfer move)
        endif()
        if(NOT _line MATCHES "^[ \t]*${_transfer} r[0-9]+,${_pending_register}$")
          message(FATAL_ERROR "${_mode}: ${_pending} lost its exact return transfer: ${_line}")
        endif()
      endif()
      set(_pending "")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _steps)
  list(LENGTH _steps _distinct_steps)
  if(NOT _imports EQUAL 2 OR NOT _definitions EQUAL 2 OR NOT _constants EQUAL 2
      OR NOT _owned EQUAL 3 OR NOT _borrowed EQUAL 3 OR NOT _condition EQUAL 3
      OR NOT _points EQUAL 9 OR NOT _distinct_steps EQUAL 9 OR NOT _pending STREQUAL "")
    message(FATAL_ERROR "${_mode}: DAG imports, owners, return paths or source/TRACE observations changed")
  endif()
  execute_pair("${_product}.rxas" "${_product}" "${_expected}" ${_providers})
endforeach()

# The native original independently demonstrates both unreset status outcomes.
set(_state_provider "${FIXTURES}/io-import-dag-state-provider.rxas")
set(_state_caller "${FIXTURES}/io-import-dag-state-caller.rxas")
run_checked("assemble recycled DAG provider" "${ASSEMBLER}" -n -o "${WORK}/state-provider" "${_state_provider}")
execute_pair("${_state_caller}" "${WORK}/state-original" "0\n256" "${WORK}/state-provider.rxbin")
run_checked("retain recycled DAG" "${VM}" "${CLI}" ${RUNTIME} -a
  --module io-import-dag-state-caller.rxas --profile "${_profile}" --work 6000000
  --body io-import-dag-state-provider.rxas "${_state_provider}"
  -o "${WORK}/state-retained.rxas" "${_state_caller}")
string(FIND "${_last_stderr}" "local.recycler.history.unproved" _reason)
file(STRINGS "${WORK}/state-retained.rxas" _calls REGEX "^[ \t]*call2[ \t]+r1,foreign\\(\\),r0,r1$")
list(LENGTH _calls _call_count)
if(_reason LESS 0 OR NOT _call_count EQUAL 2)
  message(FATAL_ERROR "recycled DAG did not retain the whole batch with its precise reason")
endif()
execute_pair("${WORK}/state-retained.rxas" "${WORK}/state-retained" "0\n256" "${WORK}/state-provider.rxbin")
foreach(_invalid duplicate missing)
  expect_failure("invalid-${_invalid}" "LL_TARGET_BINDING:"
    --body "invalid-${_invalid}" "${FIXTURES}/io-import-dag-${_invalid}.rxas"
    --body io-import-dag-other.rxas "${_second}")
endforeach()
expect_failure(work-limit "LL_INLINE_LIMIT:" --work 1
  --body io-import-dag-provider.rxas "${_first}" --body io-import-dag-other.rxas "${_second}")
foreach(_owner first second)
  file(SHA256 "${_${_owner}}" _${_owner}_source_after)
  file(SHA256 "${WORK}/${_owner}.rxbin" _${_owner}_binary_after)
  if(NOT _${_owner}_source_before STREQUAL _${_owner}_source_after
      OR NOT _${_owner}_binary_before STREQUAL _${_owner}_binary_after)
    message(FATAL_ERROR "DAG expansion changed exact ${_owner} provider source or binary")
  endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
message("RXAS_IMPORTED_DAG|failures=0")
