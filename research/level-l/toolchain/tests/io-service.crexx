/* cREXX License (MIT). Independent RXAS service/ownership and admission controls. */
options levelb
import rxfnsb
import lllimits
import llir
import lltarget
import llrxasinput
import llrxasoutput

main: procedure = .int expose checks failures
  i = .int; record = .lltarget..record; value = .lltarget..operand
  normalized = .llrxasinput..parsed
  emitted = .llrxasoutput..emission; refused = .llrxasoutput..emission; output = .llir..output
  checks = 0; failures = 0; nl = '0a'x
  frontend = .llrxasinput..reader()
  source = '.globals=0' || nl || 'main() .locals=1' || nl || 'say "café\x00"' || nl || 'ret 0'
  first = frontend.parse(source as .binary,'service-one.rxas','fixture:one')
  call check(first.status() = 0,'ordinary source admitted without final newline')
  if first.status() = 0 then do
    firstmodule = first.result(); id = firstmodule.identity(); found = 0
    do i = 1 to firstmodule.records()
      record = firstmodule.record(i)
      if record.kind() = 'instruction' & record.mnemonic() = 'say' then do
        value = record.operand(1); found = upper(bin2x(value.bytes())) = '636166C3A900'
      end
    end
    call check(found,'UTF-8 and escaped NUL preserve exact literal bytes')
    emitted = llrxasoutput..render(reference firstmodule)
    call check(emitted.error() = '','typed output rendered')
    if emitted.error() = '' then do
      output = emitted.output(); second = frontend.parse(output.text() as .binary,'service-two.rxas','fixture:two')
      call check(second.status() = 0,'rendered current RXAS read through same public service')
      call check(firstmodule.identity() = id & firstmodule.error() = '','interleaved result retains independent owner')
    end
    refused = llrxasoutput..render(reference firstmodule,8)
    call check(refused.error() <> '' & refused.output().bytes() = 0,'output limit publishes no partial chunks')
  end
  literalSource = '.globals=+0' || nl || 'main() .locals=+3' || nl || 'load r0,+7' || nl || 'load r1,1D' || nl || 'load r2,0x00FF' || nl || 'ret +0' || nl
  literals = frontend.parse(literalSource as .binary,'literals','fixture:literals')
  call check(literals.status() = 0,'plus integers/counts and uppercase decimal syntax admitted')
  if literals.status() = 0 then do
    literalModule = literals.result(); foundInteger = 0; foundDecimal = 0; foundBinary = 0
    do i = 1 to literalModule.records()
      record = literalModule.record(i)
      if record.kind() = 'instruction' & record.mnemonic() = 'load' then do
        value = record.operand(2)
        if value.kind() = 'I' then foundInteger = value.index() = 7
        if value.kind() = 'D' then foundDecimal = value.text() = '1d'
        if value.kind() = 'B' then foundBinary = value.text() = '0x00FF'
      end
    end
    call check(foundInteger & foundDecimal,'adapter normalizes signed integer and native decimal spellings')
    call check(foundBinary,'binary literal retains arbitrary FF and NUL byte spelling')
    emitted = llrxasoutput..render(reference literalModule)
    call check(emitted.error() = '','normalized literal module renders')
    if emitted.error() = '' then do
      output = emitted.output(); normalized = frontend.parse(output.text() as .binary,'normalized','fixture:normalized')
      call check(normalized.status() = 0,'normalized literals read back through public service')
    end
  end
  metadataSource = 'main() .locals=0' || nl || '.srcstep -1 4294967296 4294967297 "meta.crexx" -4294967297 4294967295 -9223372036854775808 "source"' || nl || '.traceevent "V" -1 "N" "I" "" -9 4294967296 -4294967297 4294967297 "symbol" ""' || nl || 'ret 0' || nl
  metadata = frontend.parse(metadataSource as .binary,'metadata','fixture:metadata')
  call check(metadata.status() = 0,'signed source/TRACE metadata integer spellings admitted')
  if metadata.status() = 0 then do
    metadataModule = metadata.result(); foundStep = 0; foundTrace = 0
    do i = 1 to metadataModule.records()
      record = metadataModule.record(i)
      if record.kind() = '.srcstep' then do
        value = record.operand(1); foundStep = value.index() = 4294967295
        value = record.operand(2); foundStep = foundStep & value.index() = 0
        value = record.operand(3); foundStep = foundStep & value.index() = 1
        value = record.operand(5); foundStep = foundStep & value.index() = 4294967295
        value = record.operand(6); foundStep = foundStep & value.index() = 4294967295
        value = record.operand(7); foundStep = foundStep & value.index() = 0
      end
      if record.kind() = '.traceevent' then do
        value = record.operand(2); foundTrace = value.index() = 0
        value = record.operand(6); foundTrace = foundTrace & value.index() = -1
        value = record.operand(7); foundTrace = foundTrace & value.index() = 0
        value = record.operand(8); foundTrace = foundTrace & value.index() = 0
        value = record.operand(9); foundTrace = foundTrace & value.index() = 1
      end
    end
    call check(foundStep,'source metadata uses signed modulo-u32 canonical fields')
    call check(foundTrace,'TRACE negatives clamp or become NONE before modulo-u32 storage')
    emitted = llrxasoutput..render(reference metadataModule)
    call check(emitted.error() = '','canonical metadata renders through the ordinary writer')
    if emitted.error() = '' then do
      output = emitted.output(); normalized = frontend.parse(output.text() as .binary,'metadata-normalized','fixture:metadata-normalized')
      call check(normalized.status() = 0,'canonical metadata reads back through the public service')
    end
  end
  rawCodes = '01090B1B1F7F3F'x as .binary
  do i = 0 to <blen>(rawCodes)
    code = .binary
    if i > 0 then code = binsubstr(rawCodes,i,1)
    spelling = code as .string
    codeLine = '.traceevent "' || spelling || '" 0 "' || spelling || '" "' || spelling || '" "' || spelling || '" -1 0 0 0 "symbol" ""'
    rawSource = 'main() .locals=0' || nl || codeLine || nl || 'ret 0' || nl
    rawParsed = frontend.parse(rawSource as .binary,'raw-trace-' || i,'fixture:raw-trace')
    call check(rawParsed.status() = 0,'literal TRACE byte admitted: ' || i)
    if rawParsed.status() = 0 then do
      rawModule = rawParsed.result()
      call check(tracecodes(rawModule,code),'raw TRACE model fields retain exact byte: ' || i)
      emitted = llrxasoutput..render(reference rawModule)
      call check(emitted.error() = '','raw TRACE byte renders: ' || i)
      if emitted.error() = '' then do
        output = emitted.output()
        call check(pos(codeLine,output.text()) > 0,'writer emits literal TRACE byte without ordinary escaping: ' || i)
        normalized = frontend.parse(output.text() as .binary,'raw-trace-roundtrip-' || i,'fixture:raw-trace-roundtrip')
        call check(normalized.status() = 0,'raw TRACE output reads back: ' || i)
        if normalized.status() = 0 then call check(tracecodes(normalized.result(),code),'raw TRACE roundtrip fields retain exact byte: ' || i)
      end
    end
  end
  invalid = frontend.parse(('main() .locals=0' || nl || '.traceevent "\x01" 0 "N" "" "" -1 0 0 0 "" ""' || nl || 'ret 0' || nl) as .binary,'escaped-trace-code','fixture:negative')
  call check(invalid.status() <> 0 & pos('one raw byte',invalid.error()) > 0,'TRACE code escape spelling is not decoded into a byte')
  invalid = frontend.parse(('main() .locals=0' || nl || 'say "\xff"' || nl || 'ret 0' || nl) as .binary,'invalid-escaped-utf8','fixture:negative')
  call check(invalid.status() <> 0,'escaped invalid UTF-8 string payload refused')
  largeSource = 'main() .locals=0' || nl || 'say "' || copies('x',4096) || '"' || nl || 'ret 0' || nl
  invalid = frontend.parse(largeSource as .binary,'decode-work','fixture:negative',.lllimits..policy(),1000000,67108864,64)
  call check(invalid.status() = 2,'literal decoding shares the binding work allowance')
  large = frontend.parse(largeSource as .binary,'render-work','fixture:large')
  call check(large.status() = 0,'large literal control admitted under ordinary allowances')
  if large.status() = 0 then do
    largeModule = large.result(); refused = llrxasoutput..render(reference largeModule,67108864,10)
    call check(refused.error() <> '' & refused.output().bytes() = 0,'render work limit rejects payload without partial output')
  end
  invalid = frontend.parse(('.globals=0' || nl || '.globals=1' || nl) as .binary,'duplicate','fixture:negative')
  call check(invalid.status() <> 0 & pos('duplicate',invalid.error()) > 0,'duplicate global declaration refused')
  invalid = frontend.parse(('main() .locals=1' || nl || 'load r2,1' || nl || 'ret 0' || nl) as .binary,'badreg','fixture:negative')
  call check(invalid.status() <> 0,'register outside declared frame refused')
  invalid = frontend.parse(('main() .locals=0' || nl || 'madeup' || nl) as .binary,'opcode','fixture:negative')
  call check(invalid.status() <> 0,'unknown canonical instruction refused')
  invalid = frontend.parse(('.jtable table' || nl) as .binary,'profile','fixture:negative')
  call check(invalid.status() <> 0 & pos('PROFILE',invalid.error()) > 0,'unimplemented structural directive explicitly refused')
  limits = .lllimits..policy(); ok = limits.set('source.bytes',4)
  invalid = frontend.parse(source as .binary,'limited','fixture:negative',limits)
  call check(invalid.status() = 2,'input allowance refuses before target publication')
  last = frontend.parse(('main() .locals=0' || nl || 'ret 0' || nl) as .binary,'last','fixture:last')
  call check(last.status() = 0,'small request succeeds after malformed and over-budget requests')
  call inlinechecks(frontend,nl)
  call entrychecks(frontend,nl)
  call coldchecks(frontend,nl)
  say 'RXAS_IO|checks=' || checks || '|failures=' || failures
  if failures > 0 then return 1
  return 0

/** A handwritten metadata client: PCs are derived from four LOADs (3 cells
 * each) followed by RET (2). No inliner or native-output oracle participates. */
coldchecks: procedure = .void
  arg frontend = .llrxasinput..reader, nl = .string
  item = .lltarget..record; value = .lltarget..operand; emitted = .llrxasoutput..emission
  parsed = frontend.parse(coldsource(0,nl) as .binary,'cold-phases.rxas','fixture:cold-phases')
  call check(parsed.status() = 0,'handwritten executable phases and borrowed suffix admitted: ' || parsed.error())
  if parsed.status() = 0 then do
    source = parsed.result(); body = source.body(source.procedureid('main')); loads = 0
    call check(body.locals() = 4 & body.ownedlocals() = 3 & body.privatebindings() = 1,'self global is borrowed even though spelled in the local bank')
    call check(source.regions() = 2,'executable region IDs are independent of diagnostic frames')
    do i = 1 to source.records()
      item = source.record(i)
      if item.kind() <> 'instruction' then iterate
      if item.mnemonic() = 'load' then do
        loads = loads + 1; expected = 1
        if loads = 2 | loads = 4 then expected = 2
        call check(source.inlineaddress(item.id()) = (loads - 1) * 3,'ordinary instruction-cell PC ' || loads)
        call check(source.regionat(item.id()) = expected,'deepest lexical region includes fragmented child ' || loads)
        actions = source.exitactions(2,item.id()); expectedactions = 0
        if loads = 2 then expectedactions = 1
        if loads = 4 then expectedactions = 2
        call check(actions = expectedactions,'cold actions exist only in their half-open phase ' || loads)
        if loads = 4 then do
          first = source.exitaction(2,item.id(),1); second = source.exitaction(2,item.id(),2)
          call check(first.action() = 'endlife' & second.action() = 'digits','actions use declared order rather than metadata record order')
          actionwork = source.exitactionwork(2); ids = source.exitactionids(2,item.id(),actionwork,actionwork * 8)
          call check(ids[0] = 2 & ids[1] = first.id() & ids[2] = second.id(),'one bounded phase snapshot retains public action order')
          refusedids = .int[]; limited = 0
          do
            refusedids = source.exitactionids(2,item.id(),actionwork - 1,actionwork * 8)
          on signal
            limited = 1
          end
          call check(limited & refusedids[0] = 0 & source.error() = '','short phase-query work publishes no partial snapshot or owner error')

          value = second.registerref(1)
          call check(second.registerrefs() = 1 & value.bank() = 'r' & value.index() = 1 & value.owner() = source.identity(),'saved numeric source is an exact typed local reference')
        end
      end
      else if item.mnemonic() = 'ret' then call check(source.regionat(item.id()) = 0 & source.exitactions(2,item.id()) = 0,'range endpoint retires lexical child and its actions')
    end
    emitted = llrxasoutput..render(reference source)
    call check(emitted.error() = '','executable metadata and exact provider selector render')
    if emitted.error() = '' then do
      output = emitted.output(); again = frontend.parse(output.text() as .binary,'cold-roundtrip.rxas','fixture:cold-roundtrip')
      call check(again.status() = 0,'feature10/12 metadata reads after canonical rendering: ' || again.error())
      if again.status() = 0 then do
        result = again.result(); finalbody = result.body(result.procedureid('main'))
        call check(result.regions() = 2 & finalbody.ownedlocals() = 3,'region and borrowed ownership survive roundtrip')
      end
      bounded = llrxasoutput..render(reference source,output.bytes())
      call check(bounded.error() = '' & bounded.output().bytes() = output.bytes(),'exact metadata output byte bound admits complete publication')
      bounded = llrxasoutput..render(reference source,output.bytes() - 1)
      call check(bounded.error() <> '' & bounded.output().bytes() = 0,'short metadata output bound publishes nothing')
    end
  end
  do mode = 1 to 10
    invalid = frontend.parse(coldsource(mode,nl) as .binary,'invalid-cold-' || mode,'fixture:invalid-cold')
    call check(invalid.status() <> 0,'invalid region/phase/borrowed contract rejected ' || mode)
  end
  last = frontend.parse(coldsource(0,nl) as .binary,'cold-after-failures','fixture:cold-after-failures')
  call check(last.status() = 0,'cold failures do not poison later independent request')
  return

coldsource: procedure = .string
  arg mode = .int, nl = .string
  parent = 1; outerparent = 0; saved = 'r1'; suffix = 'r3'; provider = 'self'; literal = 1
  if mode = 1 then parent = 99
  if mode = 3 then parent = 0
  if mode = 5 then saved = 'r3'
  if mode = 6 then suffix = 'r2'
  if mode = 8 then literal = 0
  if mode = 9 then provider = '@4294967295'
  if mode = 10 then outerparent = 2
  text = '.globals=1' || nl || 'main() .locals=4' || nl
  if mode <> 7 then text = text || '.inlinedprivate ' || suffix || ',"' || provider || '",g0' || nl
  text = text || '.inlineregion 1,' || outerparent || nl || 'outer_begin:' || nl || 'load r0,7' || nl
  if mode = 7 then text = text || '.inlinedprivate r3,"self",g0' || nl
  text = text || '.inlineregion 2,' || parent || nl || 'child_begin:' || nl || 'load r1,18' || nl
  text = text || 'child_end:' || nl || 'load r2,4' || nl || 'frag_begin:' || nl || 'load r0,9' || nl || 'frag_end:' || nl || 'outer_end:' || nl || 'ret 0' || nl
  ending = 'outer_end'; if mode = 2 then ending = 'child_end'
  text = text || '.inlinerange outer_begin,' || ending || ',1' || nl || '.inlinerange child_begin,child_end,2' || nl || '.inlinerange frag_begin,frag_end,2' || nl
  text = text || '.inlineexit 2,frag_begin,frag_end,9,"digits",' || saved || nl
  text = text || '.inlineexit 2,child_begin,child_end,2,"endlife",r2' || nl || '.inlineexit 2,frag_begin,frag_end,2,"endlife",r2' || nl
  text = text || '.inlineexit 1,outer_begin,outer_end,5,"digits",' || literal || nl
  if mode = 4 then text = text || '.inlineexit 2,frag_begin,frag_end,2,"unlink",a1' || nl
  return text

/** Executable entry state is a typed procedure property, preserved by RXAS
 * roundtrip. An ordinary metadata string cannot manufacture the declaration. */
entrychecks: procedure = .void
  arg frontend = .llrxasinput..reader, nl = .string
  mode = .int; item = .lltarget..record; body = .lltarget..body
  header = .string; parsed = .llrxasinput..parsed; source = .lltarget..module
  emitted = .llrxasoutput..emission; bounded = .llrxasoutput..emission
  do mode = 0 to 2
    header = 'main() .locals=0'; exposed = ''
    if mode = 2 then do; exposed = 'published.main'; header = header || ' .expose=' || exposed; end
    if mode > 0 then header = header || ' .entry=program-default'
    parsed = frontend.parse((header || nl || 'ret 0' || nl) as .binary,'entry-' || mode,'fixture:entry')
    call check(parsed.status() = 0,'ordinary and marked main headers parse ' || mode || ': ' || parsed.error())
    if parsed.status() <> 0 then iterate
    source = parsed.result(); body = source.body(source.procedureid('main')); expected = mode > 0
    call check(body.entrykind() = expected & body.expose() = exposed,'typed entry kind and exposure remain independent ' || mode)
    emitted = llrxasoutput..render(reference source)
    call check(emitted.error() = '','typed entry header renders ' || mode)
    if emitted.error() <> '' then iterate
    output = emitted.output()
    call check(pos(header || nl,output.text()) > 0,'canonical exact entry option spelling renders ' || mode)
    bounded = llrxasoutput..render(reference source,output.bytes())
    call check(bounded.error() = '' & bounded.output().bytes() = output.bytes(),'entry rendering admits the exact output byte bound ' || mode)
    bounded = llrxasoutput..render(reference source,output.bytes() - 1)
    call check(bounded.error() <> '' & bounded.output().bytes() = 0,'entry rendering below its byte bound publishes nothing ' || mode)
    again = frontend.parse(output.text() as .binary,'entry-roundtrip-' || mode,'fixture:entry-roundtrip')
    call check(again.status() = 0,'typed entry output reads back ' || mode)
    if again.status() = 0 then do
      result = again.result(); body = result.body(result.procedureid('main'))
      call check(body.entrykind() = expected & body.expose() = exposed,'entry kind survives RXAS roundtrip ' || mode)
    end
  end
  do mode = 0 to 4
    select mode
      when 0 then header = 'main() .locals=0 .entry=unknown'
      when 1 then header = 'helper() .locals=0 .entry=program-default'
      when 2 then header = 'main() .locals=0 .entry=program-default .entry=program-default'
      when 3 then header = 'main() .locals=0 .entry=program-default .expose=published.main'
      otherwise header = 'main() .locals=0 .expose=published.main .entry=program-default .entry=program-default'
    end
    invalid = frontend.parse((header || nl || 'ret 0' || nl) as .binary,'entry-invalid-' || mode,'fixture:entry-invalid')
    call check(invalid.status() <> 0,'malformed or unsupported entry header refuses ' || mode)
  end
  parsed = frontend.parse(('main() .locals=0' || nl || '.meta "main.entry"="b" "program-default" main() ""' || nl || 'ret 0' || nl) as .binary,'entry-string','fixture:entry-string')
  call check(parsed.status() = 0,'ordinary metadata string remains ordinary metadata')
  if parsed.status() = 0 then do
    source = parsed.result(); body = source.body(source.procedureid('main'))
    call check(body.entrykind() = 0,'metadata text confers no executable entry contract')
  end
  return

tracecodes: procedure = .int
  arg module = .lltarget..module, expected = .binary
  item = .lltarget..record; value = .lltarget..operand; count = 0
  do i = 1 to module.records()
    item = module.record(i)
    if item.kind() <> '.traceevent' then iterate
    count = count + 1
    do j = 1 to 5
      if j = 2 then iterate
      value = item.operand(j)
      if bin2x(value.bytes()) <> bin2x(expected) then return 0
    end
  end
  return count = 1

/** Diagnostic names label logical frames without asserting executable target
 * identity. Independent parser/model negatives exercise the static contract. */
inlinechecks: procedure = .void
  arg frontend = .llrxasinput..reader, nl = .string
  mode = .int; i = .int; item = .lltarget..record
  do mode = 0 to 10
    parsed = frontend.parse(inlinefixture(mode,nl) as .binary,'inline-diagnostics-' || mode,'fixture:inline-diagnostics')
    if mode > 0 then do
      expected = word('duplicate missing cycle anchor overlapping empty unresolved nonempty conflicting NUL',mode)
      call check(parsed.status() <> 0 & pos(expected,parsed.error()) > 0,'static inline diagnostic refusal ' || mode || ': ' || parsed.error())
      iterate
    end
    call check(parsed.status() = 0,'nested disjoint inline diagnostic source admitted: ' || parsed.error())
    if parsed.status() <> 0 then iterate
    source = parsed.result(); call check(source.inlineframes() = 2 & source.inlinemaps() = 3,'typed static tree and split ranges retained')
    call check(inlinesourcesteps(source),'explicit source step zero clears the caller anchor inside the clone')
    loads = 0
    do i = 1 to source.records()
      item = source.record(i)
      if item.kind() <> 'instruction' | item.mnemonic() <> 'load' then iterate
      loads = loads + 1; expectedframe = 1; if loads = 2 then expectedframe = 2
      call check(source.inlineframeat(item.id()) = expectedframe,'instruction chooses its deepest static frame ' || loads)
    end
    emitted = llrxasoutput..render(reference source)
    call check(emitted.error() = '','static diagnostic records render')
    if emitted.error() = '' then do
      output = emitted.output(); again = frontend.parse(output.text() as .binary,'inline-diagnostics-roundtrip','fixture:inline-roundtrip')
      call check(again.status() = 0,'rendered static diagnostic records parse again: ' || again.error())
      if again.status() = 0 then do
        result = again.result(); call check(result.inlineframes() = 2 & result.inlinemaps() = 3,'static diagnostic tree/ranges survive RXAS roundtrip')
        call check(inlinesourcesteps(result),'source-step clearing survives RXAS roundtrip')
      end
    end
  end
  return

inlinefixture: procedure = .string
  arg mode = .int, nl = .string
  parent = 0; child = 2; childparent = 1; anchor = 7; module = 'provider.rxas'
  if mode = 1 then child = 1
  if mode = 2 then childparent = 99
  if mode = 3 then parent = 2
  if mode = 4 then anchor = 99
  if mode = 8 then module = ''
  if mode = 10 then module = 'provider\x00rxas'
  source = 'main() .locals=1' || nl || '.srcstep 7 7 0 "caller.rxas" 1 0 1 "call helper"' || nl
  source = source || '.inlineframe 1 ' || parent || ' "' || module || '" "helper" ' || anchor || nl
  source = source || 'outer_begin:' || nl || 'load r0,1' || nl
  source = source || '.inlineframe ' || child || ' ' || childparent || ' "nested.rxas" "nested" 7' || nl
  source = source || '.srcstep 0 0 0 "" 0 0 0 ""' || nl || 'child_begin:' || nl || 'load r0,2' || nl || 'child_end:' || nl
  source = source || '.srcstep 7 7 0 "caller.rxas" 1 0 1 "call helper"' || nl || 'load r0,3' || nl || 'outer_end:' || nl || 'ret 0' || nl
  if mode = 5 then source = source || '.inlinemap outer_begin,outer_end,1' || nl
  else if mode = 6 then source = source || '.inlinemap outer_begin,outer_begin,1' || nl
  else if mode = 7 then source = source || '.inlinemap missing,child_begin,1' || nl
  else source = source || '.inlinemap outer_begin,child_begin,1' || nl
  source = source || '.inlinemap child_begin,child_end,' || child || nl || '.inlinemap child_end,outer_end,1' || nl
  /* Identical source-anchor records are legal even at a second address. */
  line = 1; if mode = 9 then line = 2
  source = source || '.srcstep 7 7 0 "caller.rxas" ' || line || ' 0 1 "call helper"' || nl
  return source

inlinesourcesteps: procedure = .int
  arg source = .lltarget..module
  active = 0; loads = 0; item = .lltarget..record; value = .lltarget..operand
  do i = 1 to source.records()
    item = source.record(i)
    if item.kind() = '.srcstep' then do; value = item.operand(1); active = value.index(); end
    if item.kind() = 'instruction' & item.mnemonic() = 'load' then do
      loads = loads + 1; expected = 7; if loads = 2 then expected = 0
      if active <> expected then return 0
    end
  end
  return loads = 3

check: procedure = .void expose checks failures
  arg condition = .int, name = .string
  checks = checks + 1
  if condition = 0 then do; failures = failures + 1; say 'FAIL|' || name; end
  return
