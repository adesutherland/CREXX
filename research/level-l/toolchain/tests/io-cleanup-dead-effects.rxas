/* Shared discardability oracle: stdout is "overflow\ndone\n".
 * ISUB has a dead, independently safe result. IADD also has a dead result,
 * but its overflow must still select the authored handler exactly once. */
.globals=0
main() .locals=4
  load r0,8
  isub r1,r0,3
  load r2,9223372036854775807
  sigpush "OVERFLOW_UNDERFLOW"
  sigbr overflow_observed,"OVERFLOW_UNDERFLOW"
  iadd r3,r2,1
  say "missed-overflow"
  br finished
overflow_observed:
  say "overflow"
finished:
  sigpop "OVERFLOW_UNDERFLOW"
  say "done"
  ret 0
