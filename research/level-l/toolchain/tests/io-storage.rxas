/* Independent fresh-cell status contract: 11/256, then 22/0 after reuse.
 * The empty helper selects this caller for the ordinary cleanup pipeline. */
.globals=0
main() .locals=6
  load r3,11
  settp r3,256
  copy r0,r3
  load r5,22
  copy r1,r5
  call trigger()
  getandtp r2,r0,768
  getandtp r4,r1,768
  itos r0
  say r0
  itos r2
  say r2
  itos r1
  say r1
  itos r4
  say r4
  ret 0
trigger() .locals=0
  ret
