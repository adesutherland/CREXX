# This helper's private lifetimes execute in reverse lexical order. Unique
# placement must not share them with a source-order reset schedule.
foreach(_mode conservative cleaned)
  set(_cleanup_option)
  if(_mode STREQUAL "conservative")
    set(_cleanup_option --no-cleanup)
  endif()
  set(_product "${WORK}/dag-order-${_mode}")
  run_checked("inline reverse-order DAG (${_mode})" "${VM}" "${CLI}" ${RUNTIME} -a
    --module io-dag-order.rxas --profile closed-main-default-halt.v1 ${_cleanup_option}
    -o "${_product}.rxas" "${FIXTURES}/io-dag-order.rxas")
  caller_instructions("${_product}.rxas" main _caller)
  set(_first_temp "")
  set(_second_temp "")
  foreach(_instruction IN LISTS _caller)
    if(_instruction MATCHES "^[ \t]*(call[0-9]*|swapcall|settpswapcall|settpcall)[ \t]")
      message(FATAL_ERROR "${_mode} reverse-order DAG retained its selected call")
    endif()
    if(_instruction MATCHES "^[ \t]*load[ \t]+r([0-9]+)[ \t]*,[ \t]*11$")
      set(_first_temp "${CMAKE_MATCH_1}")
    elseif(_instruction MATCHES "^[ \t]*load[ \t]+r([0-9]+)[ \t]*,[ \t]*22$")
      set(_second_temp "${CMAKE_MATCH_1}")
    endif()
    if(_mode STREQUAL "cleaned" AND _instruction MATCHES "^[ \t]*(null|link|unlink|swap|endlife)[ \t]")
      message(FATAL_ERROR "cleaned reverse-order DAG introduced a reset or retained discharged transport glue")
    endif()
  endforeach()
  if(_first_temp STREQUAL "" OR _second_temp STREQUAL "" OR _first_temp STREQUAL _second_temp)
    message(FATAL_ERROR "${_mode} reverse-order DAG lost its two distinct scalar temporary cells")
  endif()
  run_checked("assemble reverse-order DAG (${_mode})" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
  run_checked("execute reverse-order DAG (${_mode})" "${VM}" "${_product}.rxbin")
  string(REPLACE "\r\n" "\n" _normalized "${_last_stdout}")
  string(STRIP "${_normalized}" _result)
  if(NOT _result STREQUAL "11\n256\n22\n0")
    message(FATAL_ERROR "${_mode} reverse-order DAG expected '11,256,22,0', got '${_result}'")
  endif()
endforeach()

