  set(_product "${WORK}/storage-${_mode}")
  run_checked("inline storage status (${_mode})" "${VM}" "${CLI}" ${RUNTIME} -a
    --module io-storage.rxas --profile closed-main-default-halt.v1 ${_cleanup_option}
    -o "${_product}.rxas" "${FIXTURES}/io-storage.rxas")
  caller_instructions("${_product}.rxas" main _caller)
  set(_first_cell "")
  set(_second_cell "")
  set(_reset_before_second OFF)
  set(_previous "")
  foreach(_instruction IN LISTS _caller)
    if(_instruction MATCHES "^[ \t]*(call[0-9]*|swapcall|settpswapcall|settpcall)[ \t]")
      message(FATAL_ERROR "${_mode} storage caller retained its selected trigger")
    endif()
    if(_instruction MATCHES "^[ \t]*load[ \t]+(r[0-9]+),11$")
      set(_first_cell "${CMAKE_MATCH_1}")
    elseif(_instruction MATCHES "^[ \t]*load[ \t]+(r[0-9]+),22$")
      set(_second_cell "${CMAKE_MATCH_1}")
      if(_previous MATCHES "^[ \t]*null[ \t]+${_second_cell}$")
        set(_reset_before_second ON)
      endif()
    endif()
    set(_previous "${_instruction}")
  endforeach()
  if(_mode STREQUAL "cleaned")
    caller_frame("${_product}.rxas" main _frame)
    if(_first_cell STREQUAL "" OR NOT _first_cell STREQUAL _second_cell
        OR NOT _reset_before_second OR NOT _frame EQUAL 5)
      message(FATAL_ERROR "checked storage needs four observed cells plus one reset private cell")
    endif()
  endif()
  run_checked("assemble storage status (${_mode})" "${ASSEMBLER}" -n
    -o "${_product}" "${_product}.rxas")
  run_checked("execute storage status (${_mode})" "${VM}" "${_product}.rxbin")
  string(REPLACE "\r\n" "\n" _normalized "${_last_stdout}")
  string(STRIP "${_normalized}" _result)
  if(NOT _result STREQUAL "11\n256\n22\n0")
    message(FATAL_ERROR "${_mode} storage expected integer/status pairs 11/256 and 22/0, got '${_result}'")
  endif()
endforeach()
run_checked("assemble deliberate missing-reset witness" "${ASSEMBLER}" -n
  -o "${WORK}/storage-no-reset" "${FIXTURES}/io-storage-no-reset.rxas")
run_checked("execute deliberate missing-reset witness" "${VM}" "${WORK}/storage-no-reset.rxbin")
string(REPLACE "\r\n" "\n" _normalized "${_last_stdout}")
string(STRIP "${_normalized}" _result)
if(NOT _result STREQUAL "11\n256\n22\n256")
  message(FATAL_ERROR "missing-reset witness expected stale compiler status256 on second output, got '${_result}'")
endif()

# MAX_INT+1 has no available-success write proof. The default root ignores its
# overflow signal; require the precise retained-call decision, not a guessed
# arithmetic result or a newly introduced handler policy.
run_checked("retain unproved overflow write" "${VM}" "${CLI}" ${RUNTIME} -a
  --module io-overflow.rxas --profile closed-main-default-halt.v1
  -o "${WORK}/io-overflow.rxas" "${FIXTURES}/io-overflow.rxas")
string(STRIP "${_last_stderr}" _overflow_reason)
if(NOT _overflow_reason STREQUAL "LL_INLINE_KEEP: arithmetic.write.availability.unproved")
  message(FATAL_ERROR "overflow retention reason differs: '${_overflow_reason}'")
endif()
caller_instructions("${WORK}/io-overflow.rxas" main _overflow_caller)
set(_overflow_retained OFF)
foreach(_instruction IN LISTS _overflow_caller)
  if(_instruction MATCHES "^[ \t]*call1[ \t]")
    set(_overflow_retained ON)
  endif()
endforeach()
if(NOT _overflow_retained)
  message(FATAL_ERROR "unproved overflow call was expanded")
endif()
run_checked("assemble retained overflow control" "${ASSEMBLER}" -n
  -o "${WORK}/io-overflow" "${WORK}/io-overflow.rxas")

# A live scope closed only at the original callee end needs its own clear
# before a surviving CNOP carrier. addr-1 lookup at ITOS then sees the clear.
function(check_inline_scope _path)
  file(STRINGS "${_path}" _lines ENCODING UTF-8)
  set(_inside OFF)
  set(_retained_tail OFF)
  set(_scope "")
  set(_metadata 0)
  set(_instructions 0)
  set(_pending_clear OFF)
  set(_carrier -1)
  set(_continued OFF)
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^[^ \t]+\\(\\)[ \t]+\\.locals=")
      set(_inside OFF)
      if(_line MATCHES "^main\\(\\)[ \t]")
        set(_inside ON)
      endif()
    elseif(_inside)
      if(_line MATCHES "^[ \t]*(call[0-9]*|swapcall|settpswapcall|settpcall)[ \t]")
        message(FATAL_ERROR "selected handwritten call was retained")
      endif()
      if(_line MATCHES "^[ \t]*\\.(traceevent|srcstep)[ \t]")
        message(FATAL_ERROR "detached callee observation became reachable at caller continuation")
      elseif(_line MATCHES [=[^[ \t]*\.meta[ \t]+"([^"]+)"="b"[ \t]+"\.int"[ \t]+r[0-9]+$]=])
        if(NOT _scope STREQUAL "")
          message(FATAL_ERROR "caller contains more than the one live cloned binding")
        endif()
        set(_scope "${CMAKE_MATCH_1}")
        math(EXPR _metadata "${_metadata} + 1")
      elseif(_line MATCHES [=[^[ \t]*\.meta[ \t]+"([^"]+)"$]=])
        set(_clear_name "${CMAKE_MATCH_1}")
        if(_scope STREQUAL "" OR NOT _clear_name STREQUAL _scope)
          message(FATAL_ERROR "generated clear does not close the fresh cloned binding")
        endif()
        set(_pending_clear ON)
        math(EXPR _metadata "${_metadata} + 1")
      elseif(_line MATCHES "^[ \t]*[A-Za-z][A-Za-z0-9]*([ \t]|$)")
        if(_pending_clear)
          if(NOT _line MATCHES "^[ \t]*cnop[ \t]*$")
            message(FATAL_ERROR "scope clear is not anchored immediately before its surviving CNOP carrier")
          endif()
          set(_carrier "${_instructions}")
          set(_pending_clear OFF)
        endif()
        if(_line MATCHES "^[ \t]*itos[ \t]")
          math(EXPR _prior "${_instructions} - 1")
          if(NOT _carrier EQUAL _prior)
            message(FATAL_ERROR "scope clear moved to caller continuation or lost its CNOP carrier")
          endif()
          set(_continued ON)
        endif()
        math(EXPR _instructions "${_instructions} + 1")
      endif()
    elseif(_line MATCHES "^[ \t]*\\.(meta|traceevent)[ \t]")
      set(_retained_tail ON)
    endif()
  endforeach()
  if(NOT _metadata EQUAL 2 OR _scope STREQUAL "live" OR NOT _continued OR NOT _retained_tail)
    message(FATAL_ERROR "fresh live scope or original detached tail was not preserved")
  endif()
endfunction()

# Keep execution independent of native assembler optimization in both products.
foreach(_mode conservative cleaned)
  set(_cleanup_option)
  if(_mode STREQUAL "conservative")
    set(_cleanup_option --no-cleanup)
  endif()
  set(_product "${WORK}/handwritten-${_mode}")
  run_checked("inline handwritten scope (${_mode})" "${VM}" "${CLI}" ${RUNTIME} -a
    --module io-handwritten.rxas --profile closed-main-default-halt.v1 ${_cleanup_option}
    -o "${_product}.rxas" "${FIXTURES}/io-handwritten.rxas")
  check_inline_scope("${_product}.rxas")
  run_checked("assemble handwritten scope (${_mode})" "${ASSEMBLER}" -n
    -o "${_product}" "${_product}.rxas")
  run_checked("execute handwritten scope (${_mode})" "${VM}" "${_product}.rxbin")
  string(STRIP "${_last_stdout}" _result)
  if(NOT _result STREQUAL "7")
    message(FATAL_ERROR "handwritten ${_mode} expansion expected 7, got '${_result}'")
  endif()
endforeach()

# Native preparation is outside the B/L request. The optimized instruction body
# is then admitted by the same RXAS reader, with no request-time subprocess.
run_checked("prepare optimized module" "${ASSEMBLER}"
  -o "${WORK}/prepared-opt" "${FIXTURES}/io-handwritten.rxas")
run_checked("render optimized module externally" "${DISASSEMBLER}"
  -o "${WORK}/prepared-opt.rxas" "${WORK}/prepared-opt.rxbin")
run_checked("read prepared optimized body" "${VM}" "${CLI}" ${RUNTIME} -a
  --module io-handwritten.rxas --policy never
  -o "${WORK}/prepared-roundtrip.rxas" "${WORK}/prepared-opt.rxas")
run_checked("assemble prepared roundtrip" "${ASSEMBLER}" -n
  -o "${WORK}/prepared-roundtrip" "${WORK}/prepared-roundtrip.rxas")
run_checked("execute prepared roundtrip" "${VM}" "${WORK}/prepared-roundtrip.rxbin")
string(STRIP "${_last_stdout}" _result)
if(NOT _result STREQUAL "7")
  message(FATAL_ERROR "prepared optimized roundtrip expected 7, got '${_result}'")
endif()

# Reuse maintained storage/alias/component oracles unchanged. This exercises
# adapter preservation, including their wider handlers/globals, without asking
# the inliner to admit those shapes or using native optimization as the oracle.
set(_preservation_cases storage_identity_runtime entry_alias_runtime
  copied_xtoy_component_placement_runtime)
set(_preservation_markers "PASS: C2-E2 storage identity runtime"
  "PASS: incoming argument alias runtime"
  "PASS: PERF3-12A X1 component placement runtime")
foreach(_index RANGE 0 2)
  list(GET _preservation_cases ${_index} _case)
  list(GET _preservation_markers ${_index} _marker)
  set(_product "${WORK}/preserved-${_case}")
  run_checked("roundtrip maintained ${_case}" "${VM}" "${CLI}" ${RUNTIME} -a
    --module "${_case}.rxas" --policy never
    -o "${_product}.rxas" "${OPTIMIZER_FIXTURES}/${_case}.rxas")
  run_checked("assemble maintained ${_case} without optimization" "${ASSEMBLER}" -n
    -o "${_product}" "${_product}.rxas")
  run_checked("execute maintained ${_case}" "${VM}" "${_product}.rxbin")
  string(FIND "${_last_stdout}" "${_marker}" _pass)
  if(_pass LESS 0 OR _last_stdout MATCHES "FAIL" OR _last_stderr MATCHES "FAIL|PANIC:")
    message(FATAL_ERROR "maintained ${_case} preservation failed:\n${_last_stdout}${_last_stderr}")
  endif()
endforeach()

file(WRITE "${WORK}/last-good.rxas" "LAST_GOOD\n")
execute_process(COMMAND "${VM}" "${CLI}" ${RUNTIME} -a
  --module invalid.rxas --policy never -o "${WORK}/last-good.rxas"
  "${FIXTURES}/io-invalid.rxas" RESULT_VARIABLE _status
  OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 90)
if(_status EQUAL 0)
  message(FATAL_ERROR "invalid input unexpectedly succeeded")
endif()
file(READ "${WORK}/last-good.rxas" _preserved)
if(NOT _preserved STREQUAL "LAST_GOOD\n")
  message(FATAL_ERROR "invalid request replaced last-good output")
endif()
file(REMOVE_RECURSE "${WORK}")
message(STATUS "RXAS_IO_CLI|failures=0")
