      message(FATAL_ERROR "${_mode} rebinding caller retained a selected call")
    endif()
    # Each next source call starts with a LOAD; these helpers return registers
    # and have no LOAD in their restoration tail. Cleanup may erase ENDLIFE.
    if(_instruction MATCHES "^[ \t]*load[ \t]" AND NOT _phase STREQUAL "body")
      if(NOT _pending_swaps EQUAL 0)
        message(FATAL_ERROR "${_mode} rebinding return left a slot permutation unrestored")
      endif()
      set(_phase body)
      set(_restored OFF)
    endif()
    if(_instruction MATCHES "^[ \t]*(copy|move)[ \t]")
      if(_instruction MATCHES "^[ \t]*copy[ \t]")
        math(EXPR _copies "${_copies} + 1")
      else()
        math(EXPR _moves "${_moves} + 1")
      endif()
      set(_phase returned)
      set(_restored OFF)
    elseif(_instruction MATCHES "^[ \t]*(swap|unlink)[ \t]")
      if(_phase STREQUAL "lifetimes")
        message(FATAL_ERROR "${_mode} rebinding restored storage after ending an inline lifetime")
      endif()
      if(_phase STREQUAL "returned")
        set(_restored ON)
      endif()
      if(_instruction MATCHES "^[ \t]*swap[ \t]")
        if(_phase STREQUAL "returned")
          math(EXPR _pending_swaps "${_pending_swaps} - 1")
        else()
          math(EXPR _pending_swaps "${_pending_swaps} + 1")
        endif()
      endif()
    elseif(_instruction MATCHES "^[ \t]*endlife[ \t]")
      if(_phase STREQUAL "body" OR NOT _pending_swaps EQUAL 0)
        message(FATAL_ERROR "${_mode} rebinding ended lifetime before result/permutation restoration")
      endif()
      if(_mode STREQUAL "conservative" AND NOT _restored)
        message(FATAL_ERROR "rebinding expansion omitted active/base restoration before ENDLIFE")
      endif()
      set(_phase lifetimes)
      math(EXPR _lifetimes "${_lifetimes} + 1")
    endif()
  endforeach()
  if(NOT _copies EQUAL 6 OR NOT _moves EQUAL 1 OR NOT _pending_swaps EQUAL 0)
    message(FATAL_ERROR "${_mode} rebinding must COPY six borrowed/argument returns and MOVE one owned local")
  endif()
  if(_mode STREQUAL "conservative" AND _lifetimes EQUAL 0)
    message(FATAL_ERROR "rebinding expansion omitted its owned lifetime endings")
  endif()
  if(_mode STREQUAL "cleaned")
    caller_frame("${_product}.rxas" main _frame)
