    endif()
  endif()
  run_checked("assemble rebinding (${_mode})" "${ASSEMBLER}" -n
    -o "${_product}" "${_product}.rxas")
  run_checked("execute rebinding (${_mode})" "${VM}" "${_product}.rxbin")
  string(REPLACE "\r\n" "\n" _normalized "${_last_stdout}")
  string(STRIP "${_normalized}" _result)
  if(NOT _result STREQUAL _rebinding_expected)
    message(FATAL_ERROR "${_mode} rebinding expected '${_rebinding_expected}', got '${_result}'")
  endif()
endforeach()

