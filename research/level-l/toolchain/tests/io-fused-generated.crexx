/* Actual native -n output must contain and expand the counted fused call. */
options levelb
namespace inliofusedgenerated

main: procedure = .int
  value = 5
  result = fifth(1,2,3,4,value)
  say result
  return 0

fifth: procedure = .int
  arg first = .int, second = .int, third = .int, fourth = .int, last = .int
  return last
