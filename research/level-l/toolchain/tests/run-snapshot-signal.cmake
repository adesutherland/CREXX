# Runnable directly for focused development diagnostics or by the registered signal panel.
cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER CLI FIXTURES WORK NATIVE_PAYLOAD_PLUGIN)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
include("${CMAKE_CURRENT_LIST_DIR}/signal-pair-helpers.cmake")

file(READ "${FIXTURES}/io-signal-snapshot.rxas" _snapshot_fixture)
foreach(_case normal fault alias-normal alias-fault known-normal known-fault early-reset endlife)
  set(_original "${_snapshot_fixture}")
  if(_case MATCHES "fault$")
    string(REPLACE "settp r3,0" "settp r3,256" _original "${_original}")
  endif()
  if(_case MATCHES "^known-" OR _case STREQUAL "early-reset" OR _case STREQUAL "endlife")
    set(_input 3)
    if(_case STREQUAL "known-fault" OR _case STREQUAL "early-reset" OR _case STREQUAL "endlife")
      set(_input 12)
    endif()
    string(REPLACE "getandtp r0,r3,256" "load r0,${_input}" _original "${_original}")
  endif()
  if(_case MATCHES "^alias-")
    string(REPLACE "call1 r1,checked_identity(),r0" "call1 r0,checked_identity(),r0" _original "${_original}")
    string(REPLACE "\"r\" 1 1 1 0 \"checked_identity\"" "\"r\" 0 1 1 0 \"checked_identity\"" _original "${_original}")
    string(REPLACE "itos r1\n  say r1" "itos r0\n  say r0" _original "${_original}")
  endif()
  if(_case STREQUAL "early-reset")
    string(REPLACE "  copy r12,r4\n" "  copy r12,r4\n  null r4\n" _original "${_original}")
    string(REPLACE "  null r4\n  null r12" "  null r12" _original "${_original}")
  elseif(_case STREQUAL "endlife")
    string(REPLACE "  null r12\n  br joined" "  null r12\n  endlife r4\n  endlife r12\n  br joined" _original "${_original}")
  endif()
  if(_case STREQUAL "known-normal")
    set(_expected "normal\n3\n3\n1\n55\npreloaded-name\npreloaded-message\n77\n256")
  elseif(_case STREQUAL "known-fault" OR _case STREQUAL "early-reset" OR _case STREQUAL "endlife")
    set(_expected "handler\n12\n99\n2\n8\nOUT_OF_RANGE\n\n77\n256")
  elseif(_case STREQUAL "fault")
    set(_expected "handler\n256\n99\n2\n8\nOUT_OF_RANGE\n\n77\n256")
  elseif(_case STREQUAL "alias-fault")
    set(_expected "handler\n256\n256\n2\n8\nOUT_OF_RANGE\n\n77\n256")
  else()
    set(_expected "normal\n0\n0\n1\n55\npreloaded-name\npreloaded-message\n77\n256")
  endif()
  set(_source "${WORK}/snapshot-${_case}.rxas")
  file(WRITE "${_source}" "${_original}")
  foreach(_mode conservative cleanup)
    set(_options)
    if(_mode STREQUAL "conservative")
      set(_options --no-cleanup)
    endif()
    set(_product "${WORK}/snapshot-${_case}-${_mode}")
    run_checked("expand owned event ${_case} ${_mode}" "${VM}" "${CLI}" ${RUNTIME} -a
      --module snapshot.rxas --profile closed-main-default-halt.v1 --work 12000000 ${_options}
      -o "${_product}.rxas" "${_source}")
    file(READ "${_product}.rxas" _expanded)
    expect_bound_policy("${_original}" "${_expanded}")
    string(FIND "${_expanded}" "checked_identity() .locals" _leaf)
    string(SUBSTRING "${_expanded}" 0 ${_leaf} _main)
    string(REGEX MATCHALL "copy r12,r4" _captures "${_main}")
    string(REGEX MATCHALL "linkattr1 r5,r12,5" _projections "${_main}")
    string(REGEX MATCHALL "null r12" _closures "${_main}")
    string(REGEX MATCHALL "[.]traceevent \"F\"[^\n]*\"checked_identity\"" _result_traces "${_main}")
    list(LENGTH _captures _capture_count)
    list(LENGTH _projections _projection_count)
    list(LENGTH _closures _closure_count)
    list(LENGTH _result_traces _trace_count)
    if(NOT _main MATCHES "main[(][)] [.]locals=13" OR _main MATCHES "(^|\n)[ \t]*(call1|link)[ \t]"
        OR NOT _capture_count EQUAL 1 OR NOT _projection_count EQUAL 3 OR NOT _closure_count EQUAL 2 OR NOT _trace_count EQUAL 1
        OR NOT _main MATCHES "caught:\n[ \t]*sigpop \"OTHER\"")
      message(FATAL_ERROR "Owned-event expansion changed frame, capture, projection owner or reset rows")
    endif()
    if(_mode STREQUAL "cleanup" AND (NOT _last_stderr MATCHES "transport.exceptional.cfg.pending" OR NOT _last_stderr MATCHES "storage.exceptional.cfg.pending"))
      message(FATAL_ERROR "Owned event lost exceptional cleanup refusal")
    endif()
    bound_pair("snapshot-${_case}-${_mode}" "${_original}" "${_expanded}" "${_expected}")
  endforeach()
endforeach()

file(READ "${WORK}/snapshot-known-normal.rxas" _snapshot_original)
file(READ "${WORK}/snapshot-known-normal-conservative.rxas" _snapshot_expanded)
foreach(_point entry before-commit after-commit after-observation)
  set(_original "${_snapshot_original}")
  set(_expanded "${_snapshot_expanded}")
  set(_signal "signal \"CANCEL\",\"owned-message\"")
  set(_result 99)
  if(_point STREQUAL "entry")
    string(REPLACE "call1 r1,checked_identity(),r0" "${_signal}\ncall1 r1,checked_identity(),r0" _original "${_original}")
    string(REPLACE "cnop\n" "${_signal}\ncnop\n" _expanded "${_expanded}")
  elseif(_point STREQUAL "before-commit")
    string(REPLACE "ret a1" "${_signal}\nret a1" _original "${_original}")
    string(REPLACE "copy r1,r0" "${_signal}\ncopy r1,r0" _expanded "${_expanded}")
  elseif(_point STREQUAL "after-commit")
    set(_result 3)
    string(REPLACE "call1 r1,checked_identity(),r0" "call1 r1,checked_identity(),r0\n${_signal}" _original "${_original}")
    string(REPLACE "copy r1,r0" "copy r1,r0\n${_signal}" _expanded "${_expanded}")
  else()
    set(_result 3)
    string(REPLACE "say \"normal\"" "say \"normal\"\n${_signal}" _original "${_original}")
    string(REPLACE "say \"normal\"" "say \"normal\"\n${_signal}" _expanded "${_expanded}")
  endif()
  # Exercise independent saved ownership by resetting delivery storage before
  # every projection. The string view keeps output integer77/status256.
  foreach(_kind original expanded)
    string(REPLACE "copy r12,r4\n" "copy r12,r4\nnull r4\n" _${_kind} "${_${_kind}}")
    string(REPLACE "null r4\nnull r12" "null r12" _${_kind} "${_${_kind}}")
    string(REPLACE "  null r4\n  null r12" "  null r12" _${_kind} "${_${_kind}}")
  endforeach()
  set(_expected "handler\n3\n${_result}\n2\n18\nCANCEL\nowned-message\n77\n256")
  if(_point STREQUAL "after-observation")
    string(PREPEND _expected "normal\n")
  endif()
  bound_pair("snapshot-pending-${_point}" "${_original}" "${_expanded}" "${_expected}")
endforeach()

# Paired nested/reference payload producer and probes are added only after the
# pass. A descriptor copy retains identity, while NULL of the original owning
# attribute tree invalidates its target; the copied ordinary attribute stays42.
set(_payload "setattrs r10,2\nlinkattr1 r11,r10,1\nload r11,42\nunlink r11\nlinkattr1 r5,r10,1\nmkref r6,r5\nlinkattr1 r11,r10,2\ncopy r11,r6\nunlink r11\nunlink r5\nnull r6\nsignal \"CANCEL\",r10\n")
set(_probe "linkattr1 r5,r12,5\nlinkattr1 r6,r5,5\nlinkattr1 r11,r6,2\nrefvalid r7,r11\nitos r7\nsay r7\nlinkattr1 r4,r10,2\nrefsame r7,r11,r4\nitos r7\nsay r7\nunlink r4\nnull r10\nrefvalid r7,r11\nitos r7\nsay r7\nunlink r11\nlinkattr1 r11,r6,1\nicopy r7,r11\nitos r7\nsay r7\nunlink r11\nlinkattr1 r11,r6,2\nrefvalid r7,r11\nitos r7\nsay r7\nunlink r11\nunlink r6\nunlink r5\nnull r11\nnull r6\nnull r5\n")
foreach(_kind original expanded)
  set(_${_kind} "${_snapshot_${_kind}}")
  if(_kind STREQUAL "original")
    string(REPLACE "call1 r1,checked_identity(),r0" "${_payload}call1 r1,checked_identity(),r0" _${_kind} "${_${_kind}}")
  else()
    string(REPLACE "cnop\n" "${_payload}cnop\n" _${_kind} "${_${_kind}}")
  endif()
  string(REPLACE "copy r12,r4\n" "copy r12,r4\nnull r4\n${_probe}" _${_kind} "${_${_kind}}")
  string(REPLACE "null r4\nnull r12" "null r12" _${_kind} "${_${_kind}}")
  string(REPLACE "  null r4\n  null r12" "  null r12" _${_kind} "${_${_kind}}")
endforeach()
bound_pair("snapshot-reference-ownership" "${_original}" "${_expanded}" "handler\n1\n1\n0\n42\n0\n3\n99\n2\n18\nCANCEL\n\n77\n256")

# Reuse the maintained RXPA native-payload owner and its counters. All native
# calls are paired test-only injection after transformation, not input facts.
if(NOT DEFINED NATIVE_PAYLOAD_PLUGIN)
  message(FATAL_ERROR "Owned-event native hook control requires the existing RXPA payload plugin")
endif()
set(_native_imports "payload_reset() .expose=rxpatests.native_payload_reset\npayload_make() .expose=rxpatests.native_payload_make\npayload_id() .expose=rxpatests.native_payload_id\npayload_copies() .expose=rxpatests.native_payload_copies\npayload_finalizers() .expose=rxpatests.native_payload_finalizers\n")
set(_native_source "call payload_reset()\nload r13,1\nload r14,77\ncall r10,payload_make(),r13\nsignal \"CANCEL\",r10\n")
set(_native_capture "call r7,payload_copies()\ncall r3,payload_finalizers()\ncopy r12,r4\ncall r11,payload_copies()\nisub r11,r11,r7\nitos r11\nsay r11\ncall r11,payload_finalizers()\nisub r11,r11,r3\nitos r11\nsay r11\nendlife r4\ncall r11,payload_finalizers()\nisub r11,r11,r3\nitos r11\nsay r11\nnull r4\ncall r11,payload_finalizers()\nisub r11,r11,r3\nitos r11\nsay r11\nlinkattr1 r5,r12,5\nlinkattr1 r6,r5,5\nload r13,1\nlink r14,r6\ncall r11,payload_id(),r13\nunlink r14\nitos r11\nsay r11\nunlink r6\nunlink r5\nnull r6\nnull r5\n")
set(_native_release "null r12\ncall r11,payload_finalizers()\nisub r11,r11,r3\nitos r11\nsay r11\nnull r10\ncall r11,payload_finalizers()\nisub r11,r11,r3\nitos r11\nsay r11\n")
foreach(_kind original expanded)
  set(_injected "${_snapshot_${_kind}}")
  string(REPLACE "main() .locals=13" "${_native_imports}main() .locals=15" _injected "${_injected}")
  if(_kind STREQUAL "original")
    string(REPLACE "call1 r1,checked_identity(),r0" "${_native_source}call1 r1,checked_identity(),r0" _injected "${_injected}")
  else()
    string(REPLACE "cnop\n" "${_native_source}cnop\n" _injected "${_injected}")
  endif()
  string(REPLACE "copy r12,r4\n" "${_native_capture}" _injected "${_injected}")
  string(REPLACE "  null r4\n  null r12\n" "${_native_release}" _injected "${_injected}")
  string(REPLACE "null r4\nnull r12\n" "${_native_release}" _injected "${_injected}")
  set(_product "${WORK}/snapshot-native-${_kind}")
  file(WRITE "${_product}.rxas" "${_injected}")
  run_checked("assemble owned native payload ${_kind}" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
  run_checked("execute owned native payload ${_kind}" "${VM}" "${_product}.rxbin" "${NATIVE_PAYLOAD_PLUGIN}")
  expect_output("handler\n1\n0\n0\n1\n77\n2\n3\n3\n99\n2\n18\nCANCEL\n\n77\n256")
endforeach()

# The copied raw diagnostic still resolves authored source after delivery
# storage is reset. The existing METALOADDATA observer is test-only, as above.
file(READ "${WORK}/snapshot-known-fault.rxas" _original)
file(READ "${WORK}/snapshot-known-fault-conservative.rxas" _expanded)
set(_saved_origin "linkattr1 r5,r12,5\nlinkattr1 r6,r5,2\nicopy r10,r6\nunlink r6\nlinkattr1 r6,r5,3\nicopy r11,r6\nunlink r6\nunlink r5\nnull r6\nnull r5\ncall2 r10,observe_origin(),r10,r11\n")
foreach(_kind original expanded)
  string(REPLACE "  null r12\n  br joined" "${_saved_origin}null r12\n  br joined" _${_kind} "${_${_kind}}")
  string(REPLACE "null r12\nbr joined" "${_saved_origin}null r12\nbr joined" _${_kind} "${_${_kind}}")
  string(APPEND _${_kind} "${_observer}")
endforeach()
bound_pair("snapshot-saved-origin" "${_original}" "${_expanded}" "handler\ncatchall.g\n8\n3\nassembler ichkrng value,-5,5\n12\n99\n2\n8\nOUT_OF_RANGE\n\n77\n256")

# Two pending events overwrite delivery storage before complete restoration;
# the one authored capture sees the second event and executes only afterward.
set(_queue "sigcall snapshot_pending(),\"OTHER\"\nsignal \"OTHER\"\n")
foreach(_kind original expanded)
  set(_${_kind} "${_snapshot_${_kind}}")
  if(_kind STREQUAL "original")
    string(REPLACE "call1 r1,checked_identity(),r0" "${_queue}call1 r1,checked_identity(),r0" _${_kind} "${_${_kind}}")
  else()
    string(REPLACE "cnop\n" "${_queue}cnop\n" _${_kind} "${_${_kind}}")
  endif()
  string(REPLACE "caught:\n" "caught:\ncnop\n" _${_kind} "${_${_kind}}")
  string(APPEND _${_kind} "\nsnapshot_pending() .locals=0\nsignal \"ERROR\",\"first\"\nsignal \"CANCEL\",\"second\"\nret 0\n")
endforeach()
bound_pair("snapshot-second-event" "${_original}" "${_expanded}" "handler\n3\n99\n2\n18\nCANCEL\nsecond\n77\n256")

foreach(_case early alias unreset scalar-overwrite duplicate missing-event missing-saved endlife move escape tree-alias)
  set(_source "${_snapshot_fixture}")
  set(_reason signal.snapshot.consumer.pending)
  if(_case STREQUAL "early")
    string(REPLACE "  copy r12,r4\n" "" _source "${_source}")
    string(REPLACE "caught:\n" "caught:\n  copy r12,r4\n" _source "${_source}")
    set(_reason signal.snapshot.phase.pending)
  elseif(_case STREQUAL "alias")
    string(REPLACE "r12" "r0" _source "${_source}")
    set(_reason signal.snapshot.mapping.pending)
  elseif(_case STREQUAL "unreset")
    string(REPLACE "  null r12\n  sigpush" "  sigpush" _source "${_source}")
    set(_reason signal.snapshot.state.unproved)
  elseif(_case STREQUAL "scalar-overwrite")
    string(REPLACE "  null r12\n  sigpush" "  null r12\n  load r12,0\n  sigpush" _source "${_source}")
    set(_reason signal.snapshot.state.unproved)
  elseif(_case STREQUAL "duplicate")
    string(REPLACE "  copy r12,r4\n" "  copy r12,r4\n  copy r12,r4\n" _source "${_source}")
  elseif(_case STREQUAL "missing-event")
    string(REPLACE "  null r4\n  null r12" "  null r12" _source "${_source}")
    set(_reason signal.snapshot.cleanup.pending)
  elseif(_case STREQUAL "missing-saved")
    string(REPLACE "  null r12\n  br joined" "  br joined" _source "${_source}")
    string(REPLACE "getandtp r0,r3,256" "load r0,12" _source "${_source}")
    set(_reason signal.snapshot.cleanup.pending)
  elseif(_case STREQUAL "endlife")
    string(REPLACE "  null r12\n  br joined" "  endlife r12\n  br joined" _source "${_source}")
    set(_reason signal.snapshot.cleanup.pending)
  elseif(_case STREQUAL "move")
    string(REPLACE "copy r12,r4" "move r12,r4" _source "${_source}")
  elseif(_case STREQUAL "escape")
    string(REPLACE "copy r12,r4" "copy r12,r4\ncopy r10,r12" _source "${_source}")
  else()
    string(REPLACE "  null r12\n  sigpush" "  null r12\n  setattrs r12,1\n  linkattr1 r6,r12,1\n  sigpush" _source "${_source}")
    set(_reason signal.snapshot.mapping.pending)
  endif()
  bound_keep("snapshot-${_case}" "${_source}" "${_reason}")
  if(_case STREQUAL "missing-saved")
    bound_pair("snapshot-retained-missing-closure" "${_source}" "${_bound_kept}" "handler\n12\n99\n2\n8\nOUT_OF_RANGE\n\n77\n256")
  endif()
endforeach()
set(_published "${WORK}/snapshot-known-normal-cleanup.rxas")
file(READ "${_published}" _good)
execute_process(COMMAND "${VM}" "${CLI}" ${RUNTIME} -a --module snapshot.rxas
  --profile closed-main-default-halt.v1 --work 1 -o "${_published}" "${WORK}/snapshot-known-normal.rxas"
  RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
file(READ "${_published}" _after)
if(_status EQUAL 0 OR NOT _after STREQUAL _good OR NOT _stderr MATCHES "LL_INLINE_LIMIT")
  message(FATAL_ERROR "Owned-event refusal changed last-good output")
endif()
