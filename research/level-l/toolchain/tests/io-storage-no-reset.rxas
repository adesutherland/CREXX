/* TEST ONLY: deliberately unsafe manual physical-cell reuse without NULL.
 * LOAD changes the integer, so the copied compiler band stays 256, not 0.
 * This is an executable counterexample for the missing-reset validator gate. */
.globals=0
main() .locals=5
  load r3,11
  settp r3,256
  copy r0,r3
  load r3,22
  copy r1,r3
  getandtp r2,r0,768
  getandtp r4,r1,768
  itos r0
  say r0
  itos r2
  say r2
  itos r1
  say r1
  itos r4
  say r4
  ret 0
