/** A debugger lookup at continuation addr-1 must already see the fresh clear. */
closedcallerscope: procedure = .int
  arg owner = reference .lltarget..module, callername = .string, continuationid = .int
  failures = 0; i = .int; metadata = .int; observations = .int; authored = .int
  opened = .int; cleared = .int; lastglue = .int; continued = .int; openordinal = .int; clearordinal = .int
  freshname = ''; clearname = ''; clearaddress = .int
  constantname = ''; metaname = ''; constantopened = .int; constantcleared = .int
  constantordinal = .int; constantclearordinal = .int; constantaddress = .int
  item = .lltarget..record; value = .lltarget..operand; body = .lltarget..body
  source = dereference owner; body = source.body(source.procedureid('main'))
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() = 'instruction' then do
      if item.id() = continuationid then continued = 1
      else if continued = 0 then lastglue = item.id()
    end
    if item.kind() = '.meta' then do
      metadata = metadata + 1; value = item.operand(1); metaname = value.text()
      if metaname == callername then authored = authored + 1
      else if item.operands() = 4 then do
        value = item.operand(4)
        if value.kind() = 'R' then do
          opened = opened + 1; freshname = metaname; openordinal = i
        end
        else if value.kind() = 'S' then do
          constantopened = constantopened + 1; constantname = metaname; constantordinal = i
          failures = failures + check(value.text() = 'constant','cloned META_CONST retains its exact literal')
        end
      end
      else if item.operands() = 1 then do
        if metaname == freshname then do
          cleared = cleared + 1; clearname = metaname; clearordinal = i; clearaddress = item.addressid()
        end
        else if metaname == constantname then do
          constantcleared = constantcleared + 1; constantclearordinal = i; constantaddress = item.addressid()
        end
        else failures = failures + check(0,'generated clear must match one open fresh binding')
      end
    end
    if item.kind() = '.traceevent' | item.kind() = '.srcstep' then observations = observations + 1
  end
  failures = failures + check(metadata = 6 & authored = 2 & opened = 1 & cleared = 1 & constantopened = 1 & constantcleared = 1 & observations = 0,'caller keeps authored scope and fresh REG/CONST declaration/clear pairs; no detached observations')
  failures = failures + check(freshname <> '' & freshname <> 'live' & freshname <> callername & clearname == freshname & clearordinal > openordinal,'fresh scope avoids authored suffix collision and receives its matching clear')
  failures = failures + check(constantname <> '' & constantname <> 'fixed' & constantname <> callername & constantname <> freshname & constantclearordinal > constantordinal,'fresh constant binding receives its own matching clear')
  failures = failures + check(continued & clearaddress = lastglue & constantaddress = lastglue & clearaddress <> continuationid,'both fresh clears anchor to final surviving glue before continuation for addr-1 lookup')
  if lastglue > 0 then do
    item = source.at(lastglue)
    failures = failures + check(item.mnemonic() = 'cnop','scope clears use a surviving CNOP carrier before continuation')
  end
  return failures

