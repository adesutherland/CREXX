/* cREXX License (MIT). Independent constructed target/expansion contract. */
options levelb
import rxfnsb
import llir
import llirgraph
import lltarget
import lltargetfacts
import llinline
import llcleanup

check: procedure = .int
  arg condition = .int, message = .string
  if condition then return 0
  say 'FAIL:' message
  return 1

one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object
  return body.emit(name,fields,at)
two: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object
  return body.emit(name,fields,at)
three: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, third = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object; fields[3] = third as .object
  return body.emit(name,fields,at)
zero: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, at = .llir..origin
  fields = .object[]
  return body.emit(name,fields,at)
namedlabel: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, at = .llir..origin
  fields = .object[]; fields[1] = .lltarget..operand.symbol(name) as .object
  return body.record('label',fields,at)

/** All branch conditions are defined GETANDTP results, unknown to facts. */
dagmodel: procedure = .lltarget..module
  arg variant = .int
  fields = .object[]
  draft = .lltarget..draft('dag.' || variant,'constructed.dag.' || variant,0); at = draft.synthetic('independent scalar DAG')
  root = draft.procedure('main',5,at)
  ignored = two(root,'load',root.reg('r',4),.lltarget..operand.integer(5),at)
  ignored = three(root,'getandtp',root.reg('r',0),root.reg('r',4),.lltarget..operand.integer(768),at)
  ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(55),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(11),at)
  if variant = 1 then do
    fields[1] = root.reg('r',3) as .object
    fields[2] = .lltarget..operand.procedure('helper') as .object
    fields[3] = root.reg('r',0) as .object; fields[4] = root.reg('r',2) as .object; fields[5] = root.reg('r',1) as .object
    ignored = root.emit('call3',fields,at)
  end
  else ignored = three(root,'call1',root.reg('r',1),.lltarget..operand.procedure('helper'),root.reg('r',0),at)
  if variant = 3 then ignored = two(root,'copy',root.reg('r',2),root.reg('r',1),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  localcount = 1
  if variant = 3 then localcount = 0
  leaf = draft.procedure('helper',localcount,at)
  if variant <> 3 then ignored = one(leaf,'null',leaf.reg('r',0),at)
  if variant = 1 then do
    call objectarraydrop fields; fields[1] = .lltarget..operand.string('daglive' as .binary) as .object
    fields[2] = .lltarget..operand.string('b' as .binary) as .object
    fields[3] = .lltarget..operand.string('.int' as .binary) as .object; fields[4] = leaf.reg('a',1) as .object
    ignored = leaf.record('.meta',fields,at)
  end
  ignored = two(leaf,'brt',.lltarget..operand.symbol('positive'),leaf.reg('a',1),at)
  if variant = 1 then do
    ignored = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(9),at)
    ignored = one(leaf,'ret',leaf.reg('r',0),at)
    ignored = namedlabel(leaf,'positive',at)
    ignored = two(leaf,'swap',leaf.reg('a',2),leaf.reg('a',3),at)
    ignored = two(leaf,'load',leaf.reg('a',2),.lltarget..operand.integer(99),at)
    ignored = one(leaf,'ret',leaf.reg('a',3),at)
    call objectarraydrop fields; fields[1] = .lltarget..operand.string('daglive' as .binary) as .object
    ignored = leaf.record('.meta',fields,at)
  end
  else if variant = 2 then do
    ignored = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(4),at)
    ignored = one(leaf,'br',.lltarget..operand.symbol('joined'),at)
    ignored = namedlabel(leaf,'positive',at)
    ignored = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(8),at)
    ignored = namedlabel(leaf,'joined',at)
    ignored = one(leaf,'ret',leaf.reg('r',0),at)
  end
  else do
    ignored = zero(leaf,'ret',at)
    ignored = namedlabel(leaf,'positive',at)
    ignored = one(leaf,'ret',.lltarget..operand.integer(7),at)
  end
  return draft.finish()

/** Cleanup may remove the last arm's fallthrough BR, but cannot move the
 * common clear before that arm's return transfer or onto caller continuation. */
dagclosed: procedure = .int
  arg owner = reference .lltarget..module, continuationid = .int
  failures = 0; i = .int; opens = .int; clears = .int; clearordinal = .int; clearaddress = .int
  lasttransfer = .int; sharedlabel = .int; lastglue = .int; continued = .int
  freshname = ''; clearname = ''; targetname = ''
  body = .lltarget..body; item = .lltarget..record; value = .lltarget..operand
  source = dereference owner; body = source.body(source.procedureid('main'))
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() = '.meta' then do
      value = item.operand(1)
      if item.operands() = 4 then do; opens = opens + 1; freshname = value.text(); end
      if item.operands() = 1 then do
        clears = clears + 1; clearname = value.text(); clearordinal = i; clearaddress = item.addressid()
      end
    end
    if item.kind() = 'label' then do
      value = item.operand(1)
      if value.text() = targetname then sharedlabel = i
    end
    if item.kind() <> 'instruction' then iterate
    if item.id() = continuationid then continued = 1
    else if continued = 0 then lastglue = item.id()
    if wordpos(item.mnemonic(),'move copy') > 0 then lasttransfer = i
    if item.mnemonic() = 'br' & targetname = '' then do; value = item.operand(1); targetname = value.text(); end
  end
  failures = failures + check(opens = 1 & clears = 1 & freshname <> '' & freshname = clearname,'graph cleanup preserves the one shared scope pair')
  failures = failures + check(sharedlabel > lasttransfer & clearordinal > sharedlabel,'cleaned shared clear still follows both arm transfers')
  failures = failures + check(continued & clearaddress = lastglue & clearaddress <> continuationid,'cleaned DAG scope closes before continuation addr-1')
  if clearaddress > 0 then do
    item = source.at(clearaddress)
    failures = failures + check(item.mnemonic() = 'cnop','graph cleanup retains the shared metadata CNOP')
  end
  if clearordinal > 0 & clearordinal < body.records() then do
    item = body.record(clearordinal + 1)
    failures = failures + check(item.kind() = 'instruction' & item.id() = clearaddress,'cleaned clear remains immediately before its executable carrier')
  end
  return failures

/** Physical cells are already padded; VAL controls the default, independently
 * of NOTSYM and of the captured count. Aliases see earlier defaults in order. */
optionalmodel: procedure = .lltarget..module
  arg variant = .int
  flags = 0; initial = 0; count = 2; mask = 256
  if variant <= 4 then flags = (variant - 1) * 256
  if variant = 3 | variant = 4 | variant >= 7 then initial = 7
  if variant >= 7 then flags = 256
  if variant = 6 then count = 3
  if variant = 9 then mask = 1024
  if variant = 10 then count = 1
  if variant = 12 then count = 100
  draft = .lltarget..draft('optional.' || variant,'constructed.optional',0); at = draft.synthetic('finite padded optional arguments')
  root = draft.procedure('main',6,at)
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(count),at)
  ignored = one(root,'null',root.reg('r',1),at)
  ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(initial),at)
  if variant = 1 then ignored = two(root,'settp',root.reg('r',1),.lltarget..operand.integer(768),at)
  ignored = two(root,'settp',root.reg('r',1),.lltarget..operand.integer(flags),at)
  if variant = 2 then ignored = two(root,'settp',root.reg('r',1),.lltarget..operand.integer(1024),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(9),at)
  secondflags = 256
  if variant = 7 | variant = 8 then secondflags = 512
  ignored = two(root,'settp',root.reg('r',2),.lltarget..operand.integer(secondflags),at)
  if variant = 5 then ignored = two(root,'link',root.reg('r',2),root.reg('r',1),at)
  if variant = 6 | variant = 11 then do
    ignored = two(root,'load',root.reg('r',4),.lltarget..operand.integer(5),at)
    if variant = 6 then ignored = three(root,'getandtp',root.reg('r',3),root.reg('r',4),.lltarget..operand.integer(768),at)
    else ignored = three(root,'getandtp',root.reg('r',0),root.reg('r',4),.lltarget..operand.integer(768),at)
  end
  if variant = 7 then ignored = two(root,'acopy',root.reg('r',1),root.reg('r',2),at)
  if variant = 8 then ignored = two(root,'icopy',root.reg('r',1),root.reg('r',2),at)
  ignored = three(root,'call',root.reg('r',5),.lltarget..operand.procedure('optional'),root.reg('r',0),at)
  if variant = 5 then ignored = one(root,'unlink',root.reg('r',2),at)
  ignored = three(root,'getandtp',root.reg('r',4),root.reg('r',5),.lltarget..operand.integer(768),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('optional',1,at)
  ignored = one(leaf,'null',leaf.reg('r',0),at)
  if variant = 7 | variant = 8 then do
    ignored = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(9),at)
    ignored = two(leaf,'settp',leaf.reg('r',0),.lltarget..operand.integer(512),at)
    if variant = 7 then ignored = two(leaf,'acopy',leaf.reg('a',1),leaf.reg('r',0),at)
    else ignored = two(leaf,'icopy',leaf.reg('a',1),leaf.reg('r',0),at)
    expected = 7
    if variant = 8 then expected = 9
    ignored = three(leaf,'ichkrng',leaf.reg('a',1),.lltarget..operand.integer(expected),.lltarget..operand.integer(expected),at)
    ignored = one(leaf,'ret',leaf.reg('a',1),at)
    return draft.finish()
  end
  if variant = 6 then do
    ignored = two(leaf,'brt',.lltarget..operand.symbol('abi_supplied'),leaf.reg('a',3),at)
    ignored = two(leaf,'settp',leaf.reg('a',1),.lltarget..operand.integer(0),at)
    ignored = one(leaf,'br',.lltarget..operand.symbol('abi_join'),at)
    ignored = namedlabel(leaf,'abi_supplied',at)
    ignored = two(leaf,'settp',leaf.reg('a',1),.lltarget..operand.integer(256),at)
    ignored = namedlabel(leaf,'abi_join',at)
  end
  ignored = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(44),at)
  ignored = two(leaf,'settp',leaf.reg('r',0),.lltarget..operand.integer(256),at)
  ignored = three(leaf,'brtpandt',.lltarget..operand.symbol('first_present'),leaf.reg('a',1),.lltarget..operand.integer(mask),at)
  ignored = two(leaf,'icopy',leaf.reg('a',1),leaf.reg('r',0),at)
  ignored = two(leaf,'acopy',leaf.reg('a',1),leaf.reg('r',0),at)
  ignored = namedlabel(leaf,'first_present',at)
  ignored = three(leaf,'brtpandt',.lltarget..operand.symbol('second_present'),leaf.reg('a',2),.lltarget..operand.integer(256),at)
  ignored = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(88),at)
  ignored = two(leaf,'icopy',leaf.reg('a',2),leaf.reg('r',0),at)
  ignored = two(leaf,'acopy',leaf.reg('a',2),leaf.reg('r',0),at)
  ignored = namedlabel(leaf,'second_present',at)
  ignored = three(leaf,'brtpandt',.lltarget..operand.symbol('any_abi'),leaf.reg('a',1),.lltarget..operand.integer(768),at)
  ignored = one(leaf,'ret',.lltarget..operand.integer(-1),at)
  ignored = namedlabel(leaf,'any_abi',at)
  ignored = three(leaf,'brtpandt',.lltarget..operand.symbol('nonsymbol'),leaf.reg('a',1),.lltarget..operand.integer(512),at)
  ignored = one(leaf,'ret',leaf.reg('a',1),at)
  ignored = namedlabel(leaf,'nonsymbol',at)
  ignored = one(leaf,'ret',leaf.reg('a',1),at)
  return draft.finish()

optionalarguments: procedure = .int
  failures = 0; variant = .int; i = .int; callid = .int; firstbranch = .int; secondbranch = .int; anybranch = .int; symbolbranch = .int
  copyid = .int; expected = .int; count = .int; domain = .int; whole = .int; sourcewhole = .int; mode = .int
  original = .lltarget..module; result = .lltarget..module; kept = .lltarget..module; body = .lltarget..body
  item = .lltarget..record; value = .lltarget..operand
  facts = .lltargetfacts..analysis; request = .llinline..binding; changed = .llinline..change; limited = .llinline..change
  do variant = 1 to 8
    callid = 0; firstbranch = 0; secondbranch = 0; anybranch = 0; symbolbranch = 0; copyid = 0
    original = optionalmodel(variant)
    failures = failures + check(original.valid(),'finite optional source is valid ' || variant)
    if original.valid() = 0 then do; say original.error(); iterate; end
    body = original.body(original.procedureid('main'))
    do i = 1 to body.records()
      item = body.record(i)
      if item.kind() <> 'instruction' then iterate
      if item.mnemonic() = 'call' then callid = item.id()
      if wordpos(item.mnemonic(),'acopy icopy') > 0 then copyid = item.id()
    end
    body = original.body(original.procedureid('optional'))
    do i = 1 to body.records()
      item = body.record(i)
      if item.kind() <> 'instruction' | item.mnemonic() <> 'brtpandt' then iterate
      value = item.operand(1)
      select value.text()
        when 'first_present' then firstbranch = item.id()
        when 'second_present' then secondbranch = item.id()
        when 'any_abi' then anybranch = item.id()
        when 'nonsymbol' then symbolbranch = item.id()
        otherwise nop
      end
    end
    facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
    failures = failures + check(facts.status() = 'ok','source-order optional/status proof succeeds ' || variant)
    if facts.status() <> 'ok' then do; say facts.reason(); iterate; end
    count = 2
    if variant = 6 then count = 3
    failures = failures + check(facts.arguments(callid) = count,'captured physical arity is independent of optional presence ' || variant)
    if variant <= 6 then do
      expected = 2
      if variant = 2 | variant = 4 then expected = 1
      if variant = 6 then expected = 0
      failures = failures + check(facts.branchchoice(callid,firstbranch) = expected,'VAL presence differs from zero, NOTSYM and unknown ABI ' || variant)
      failures = failures + check(facts.branchchoice(callid,secondbranch) = 1,'second formal observes an earlier aliased default rather than its entry snapshot ' || variant)
      failures = failures + check(facts.branchchoice(callid,anybranch) = 1,'successful default guarantees some compiler ABI bit at the final check ' || variant)
      expected = 2
      if variant = 4 then expected = 1
      failures = failures + check(facts.branchchoice(callid,symbolbranch) = expected,'NOTSYM is independent and a default ACOPY carries replacement ABI status ' || variant)
    end
    else do
      projection = .llirgraph..access
      projection = dereference facts.access()
      domain = facts.integerdomain(facts.storage(copyid,1)); whole = facts.wholedomain(facts.storage(copyid,1)); sourcewhole = facts.wholedomain(facts.storage(copyid,2))
      if variant = 7 then failures = failures + check(projection.reads(copyid,sourcewhole) & projection.writes(copyid,whole) & projection.writes(copyid,domain) = 0 & projection.kills(copyid,domain) = 0 & projection.kills(copyid,whole) = 0,'ACOPY changes only status, never integer availability or whole-value identity')
      else failures = failures + check(projection.kills(copyid,domain) & projection.kills(copyid,whole) = 0,'ICOPY changes integer availability while preserving status')
    end
    request = llinline..bind(reference original,callid,reference original,original.procedureid('optional'))
    changed = llinline..expand(request,'closed-main-default-halt.v1')
    failures = failures + check(changed.status() = 'changed' & changed.operation(callid) = 0,'finite padded optional call expands ' || variant)
    if changed.status() <> 'changed' then do; say changed.reason(); iterate; end
    if variant = 1 then do
      graph = dereference original.ir(); before = graph.binary()
      do mode = 1 to 4
        select mode
          when 1 then limited = llinline..expand(request,'closed-main-default-halt.v1',1)
          when 2 then limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1)
          when 3 then limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,1)
          otherwise limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,67108864,0)
        end
        kept = limited.result(); limitedgraph = dereference kept.ir()
        failures = failures + check(limited.status() = 'limit' & bin2x(limitedgraph.binary()) = bin2x(before),'optional work/entry/byte/frame refusal is atomic ' || mode)
      end
    end
  end
  return failures

optionalkeeps: procedure = .int
  failures = 0; variant = .int; i = .int; callid = .int; reason = .string
  original = .lltarget..module; kept = .lltarget..module; item = .lltarget..record; body = .lltarget..body
  request = .llinline..binding; changed = .llinline..change
  do variant = 9 to 12
    original = optionalmodel(variant)
    failures = failures + check(original.valid(),'unproved optional call has valid source structure ' || variant)
    if original.valid() = 0 then do; say original.error(); iterate; end
    body = original.body(original.procedureid('main'))
    do i = 1 to body.records()
      item = body.record(i)
      if item.kind() = 'instruction' & item.mnemonic() = 'call' then callid = item.id()
    end
    select variant
      when 9 then reason = 'status.mask.unproved'
      when 10 then reason = 'argument.slot.unproved'
      when 11 then reason = 'argument.count.unproved'
      otherwise reason = 'argument.window.unproved'
    end
    graph = dereference original.ir(); before = graph.binary()
    request = llinline..bind(reference original,callid,reference original,original.procedureid('optional'))
    changed = llinline..expand(request,'closed-main-default-halt.v1'); kept = changed.result()
    keptgraph = dereference kept.ir()
    failures = failures + check(changed.status() = 'keep' & changed.reason() = reason & bin2x(keptgraph.binary()) = bin2x(before),'optional missing proof has exact reason and unchanged original ' || variant)
    if changed.reason() <> reason then say changed.reason()
  end
  return failures

/** The first activation sets a private ABI bit without returning/moving that
 * local. A later activation may not treat its recycled entry as caller data. */
optionalhistory: procedure = .int
  failures = 0
  original = .lltarget..module; kept = .lltarget..module
  request = .llinline..binding; changed = .llinline..change
  draft = .lltarget..draft('optional.history','constructed.optional.history',0)
  at = draft.synthetic('recycled private ABI observation'); root = draft.procedure('main',3,at)
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(1),at)
  ignored = three(root,'call1',root.reg('r',1),.lltarget..operand.procedure('reused'),root.reg('r',0),at)
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(0),at)
  callid = three(root,'call1',root.reg('r',2),.lltarget..operand.procedure('reused'),root.reg('r',0),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('reused',1,at)
  ignored = two(leaf,'brt',.lltarget..operand.symbol('initialize'),leaf.reg('a',1),at)
  ignored = three(leaf,'brtpandt',.lltarget..operand.symbol('was_set'),leaf.reg('r',0),.lltarget..operand.integer(256),at)
  ignored = one(leaf,'ret',.lltarget..operand.integer(22),at)
  ignored = namedlabel(leaf,'was_set',at)
  ignored = one(leaf,'ret',.lltarget..operand.integer(11),at)
  ignored = namedlabel(leaf,'initialize',at)
  ignored = two(leaf,'settp',leaf.reg('r',0),.lltarget..operand.integer(256),at)
  ignored = one(leaf,'ret',.lltarget..operand.integer(0),at)
  original = draft.finish()
  failures = failures + check(original.valid(),'recycled optional status control has valid target structure')
  if original.valid() = 0 then do; say original.error(); return failures; end
  graph = dereference original.ir(); before = graph.binary()
  request = llinline..bind(reference original,callid,reference original,original.procedureid('reused'))
  changed = llinline..expand(request,'closed-main-default-halt.v1'); kept = changed.result()
  keptgraph = dereference kept.ir()
  failures = failures + check(changed.status() = 'keep' & changed.reason() = 'local.recycler.observation.unproved' & bin2x(keptgraph.binary()) = bin2x(before),'unreset private ABI observation retains exact original instead of assuming fresh or caller-independent status')
  if changed.reason() <> 'local.recycler.observation.unproved' then say changed.reason()
  return failures

/** Refine ABI knowledge on separate successors. The combined-mask true edge
 * is a disjunction; only its false edge establishes both bits clear. */
abiedgemodel: procedure = .lltarget..module
  arg mask = .int
  fields = .object[]
  draft = .lltarget..draft('abi.edge.' || mask,'constructed.abi.edge',0); at = draft.synthetic('independent ABI successor assumptions')
  root = draft.procedure('main',5,at)
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(7),at)
  ignored = two(root,'load',root.reg('r',4),.lltarget..operand.integer(5),at)
  ignored = three(root,'getandtp',root.reg('r',1),root.reg('r',4),.lltarget..operand.integer(768),at)
  ignored = three(root,'getandtp',root.reg('r',2),root.reg('r',4),.lltarget..operand.integer(768),at)
  fields[1] = root.reg('r',3) as .object; fields[2] = .lltarget..operand.procedure('probe') as .object
  fields[3] = root.reg('r',0) as .object; fields[4] = root.reg('r',1) as .object; fields[5] = root.reg('r',2) as .object
  ignored = root.emit('call3',fields,at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('probe',0,at)
  ignored = two(leaf,'brt',.lltarget..operand.symbol('nonzero_abi'),leaf.reg('a',2),at)
  ignored = two(leaf,'settp',leaf.reg('a',1),.lltarget..operand.integer(0),at)
  ignored = one(leaf,'br',.lltarget..operand.symbol('edge_probe'),at)
  ignored = namedlabel(leaf,'nonzero_abi',at)
  if mask = 768 then do
    ignored = two(leaf,'brt',.lltarget..operand.symbol('nonsym_abi'),leaf.reg('a',3),at)
    ignored = two(leaf,'settp',leaf.reg('a',1),.lltarget..operand.integer(256),at)
    ignored = one(leaf,'br',.lltarget..operand.symbol('edge_probe'),at)
    ignored = namedlabel(leaf,'nonsym_abi',at)
    ignored = two(leaf,'settp',leaf.reg('a',1),.lltarget..operand.integer(512),at)
  end
  else ignored = two(leaf,'settp',leaf.reg('a',1),.lltarget..operand.integer(mask),at)
  ignored = namedlabel(leaf,'edge_probe',at)
  ignored = three(leaf,'brtpandt',.lltarget..operand.symbol('edge_true'),leaf.reg('a',1),.lltarget..operand.integer(mask),at)
  testmask = mask
  if mask = 768 then testmask = 256
  ignored = three(leaf,'brtpandt',.lltarget..operand.symbol('false_bad'),leaf.reg('a',1),.lltarget..operand.integer(testmask),at)
  if mask = 768 then ignored = three(leaf,'brtpandt',.lltarget..operand.symbol('false_bad_more'),leaf.reg('a',1),.lltarget..operand.integer(512),at)
  falsevalue = 22
  if mask = 768 then falsevalue = 0
  ignored = one(leaf,'ret',.lltarget..operand.integer(falsevalue),at)
  ignored = namedlabel(leaf,'false_bad',at)
  ignored = one(leaf,'ret',.lltarget..operand.integer(-1),at)
  if mask = 768 then do
    ignored = namedlabel(leaf,'false_bad_more',at)
    ignored = one(leaf,'ret',.lltarget..operand.integer(-2),at)
  end
  ignored = namedlabel(leaf,'edge_true',at)
  ignored = three(leaf,'brtpandt',.lltarget..operand.symbol('true_ok'),leaf.reg('a',1),.lltarget..operand.integer(testmask),at)
  falsevalue = -2
  if mask = 768 then falsevalue = 2
  ignored = one(leaf,'ret',.lltarget..operand.integer(falsevalue),at)
  ignored = namedlabel(leaf,'true_ok',at)
  truevalue = 11
  if mask = 768 then truevalue = 1
  ignored = one(leaf,'ret',.lltarget..operand.integer(truevalue),at)
  return draft.finish()

abiedges: procedure = .int
  failures = 0; mode = .int; mask = .int; i = .int; callid = .int
  firstbranch = .int; falsebranch = .int; falsemore = .int; truebranch = .int
  firstret = .int; secondret = .int; thirdret = .int; badret = .int; badmore = .int
  masks = .int[]; masks[1] = 256; masks[2] = 512; masks[3] = 768
  original = .lltarget..module; body = .lltarget..body; item = .lltarget..record; value = .lltarget..operand
  facts = .lltargetfacts..analysis; request = .llinline..binding; changed = .llinline..change
  do mode = 1 to masks[0]
    mask = masks[mode]; callid = 0; firstbranch = 0; falsebranch = 0; falsemore = 0; truebranch = 0
    firstret = 0; secondret = 0; thirdret = 0; badret = 0; badmore = 0
    original = abiedgemodel(mask)
    failures = failures + check(original.valid(),'ABI edge probe has valid target structure ' || mask)
    if original.valid() = 0 then do; say original.error(); iterate; end
    body = original.body(original.procedureid('main'))
    do i = 1 to body.records()
      item = body.record(i)
      if item.kind() = 'instruction' & item.mnemonic() = 'call3' then callid = item.id()
    end
    body = original.body(original.procedureid('probe'))
    do i = 1 to body.records()
      item = body.record(i)
      if item.kind() <> 'instruction' then iterate
      if item.mnemonic() = 'brtpandt' then do
        value = item.operand(1)
        select value.text()
          when 'edge_true' then firstbranch = item.id()
          when 'false_bad' then falsebranch = item.id()
          when 'false_bad_more' then falsemore = item.id()
          when 'true_ok' then truebranch = item.id()
          otherwise nop
        end
      end
      if item.mnemonic() = 'ret' then do
        value = item.operand(1)
        select value.index()
          when -1 then badret = item.id()
          when -2 then badmore = item.id()
          when 0 then firstret = item.id()
          when 1 then secondret = item.id()
          when 2 then thirdret = item.id()
          when 11 then firstret = item.id()
          when 22 then secondret = item.id()
          otherwise nop
        end
      end
    end
    graph = dereference original.ir(); before = graph.binary()
    facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
    failures = failures + check(facts.status() = 'ok','entry-independent ABI edge assumptions preserve legality ' || mask)
    if facts.status() <> 'ok' then do; say facts.reason(); iterate; end
    failures = failures + check(facts.branchchoice(callid,firstbranch) = 0,'initial unknown ABI test preserves both successors ' || mask)
    failures = failures + check(facts.branchchoice(callid,falsebranch) = 2 & facts.recordlive(callid,badret) = 0,'false successor independently knows its tested ABI bit is clear ' || mask)
    failures = failures + check(facts.recordlive(callid,firstret) & facts.recordlive(callid,secondret),'distinct normal returns on both ABI successors remain live ' || mask)
    if mask = 768 then do
      failures = failures + check(facts.branchchoice(callid,falsemore) = 2 & facts.recordlive(callid,badmore) = 0,'false combined-mask successor clears both VAL and NOTSYM')
      failures = failures + check(facts.branchchoice(callid,truebranch) = 0 & facts.recordlive(callid,thirdret) & facts.returns(callid) = 3,'true combined-mask successor cannot invent either individual bit or lose its two possible returns')
    end
    else do
      failures = failures + check(facts.branchchoice(callid,truebranch) = 1 & facts.recordlive(callid,badmore) = 0 & facts.returns(callid) = 2,'true single-bit knowledge does not leak into the sibling false successor ' || mask)
    end
    request = llinline..bind(reference original,callid,reference original,original.procedureid('probe'))
    changed = llinline..expand(request,'closed-main-default-halt.v1')
    failures = failures + check(changed.status() = 'changed' & changed.operation(callid) = 0,'ABI successor proof expands with its distinct reached returns ' || mask)
    if changed.status() <> 'changed' then say changed.reason()
    failures = failures + check(bin2x(graph.binary()) = bin2x(before),'ABI edge proof preserves its exact frozen input ' || mask)
  end
  return failures

dagpositive: procedure = .int
  arg variant = .int
  failures = 0; i = .int; callid = .int; firstret = .int; secondret = .int; branchid = .int; mode = .int
  moves = .int; copies_found = .int; swaps = .int; returns = .int; exits = .int; left = .int; right = .int
  continuationid = .int; openid = .int; clearid = .int; opens = .int; clears = .int
  lastarm = .int; sharedlabel = .int; clearordinal = .int; clearaddress = .int; lastglue = .int; continued = .int
  freshname = ''; clearname = ''
  firsttarget = ''
  original = .lltarget..module; result = .lltarget..module; kept = .lltarget..module
  item = .lltarget..record; value = .lltarget..operand; body = .lltarget..body
  facts = .lltargetfacts..analysis; request = .llinline..binding; changed = .llinline..change; limited = .llinline..change; cleaned = .llinline..change
  original = dagmodel(variant)
  failures = failures + check(original.valid(),'DAG control has valid typed source ' || variant)
  if original.valid() = 0 then do; say original.error(); return failures; end
  body = original.body(original.procedureid('main'))
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() = 'instruction' & wordpos(item.mnemonic(),'call1 call3') > 0 then callid = item.id()
    if item.kind() = 'instruction' & item.mnemonic() = 'ret' then continuationid = item.id()
  end
  body = original.body(original.procedureid('helper'))
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() = '.meta' then do
      if item.operands() = 4 then openid = item.id()
      if item.operands() = 1 then clearid = item.id()
    end
    if item.kind() <> 'instruction' then iterate
    if item.mnemonic() = 'brt' then branchid = item.id()
    if item.mnemonic() = 'ret' then do
      if firstret = 0 then firstret = item.id()
      else secondret = item.id()
    end
  end
  facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(facts.status() = 'ok','unknown defined condition receives a DAG proof ' || variant)
  if facts.status() <> 'ok' then do; say facts.reason(); return failures; end
  expectedreturns = 2
  if variant = 2 then expectedreturns = 1
  failures = failures + check(facts.returns(callid) = expectedreturns & facts.branchchoice(callid,branchid) = 0,'unknown zero/nonzero condition keeps both feasible arms ' || variant)
  if expectedreturns = 1 then failures = failures + check(facts.returnsite(callid,1) = firstret,'joined RET is identified by its original record')
  else do
    left = facts.returnsite(callid,1); right = facts.returnsite(callid,2)
    failures = failures + check((left = firstret & right = secondret) | (left = secondret & right = firstret),'both original RET identities are enumerated without assuming RPO order ' || variant)
  end
  failures = failures + check(facts.recordlive(callid,firstret),'first RET is a proved feasible source record ' || variant)
  if secondret > 0 then failures = failures + check(facts.recordlive(callid,secondret),'second RET is also feasible ' || variant)
  if variant = 1 then do
    failures = failures + check(facts.returnactionat(callid,firstret) = 'move' & facts.returnactionat(callid,secondret) = 'copy','mixed exits retain true owned MOVE and borrowed COPY')
    failures = failures + check(facts.restores(callid,firstret) = 0 & facts.restores(callid,secondret) = 1,'each exit owns its own inverse permutation')
    left = facts.restoreleft(callid,secondret,1); right = facts.restoreright(callid,secondret,1)
    failures = failures + check((left = 3 & right = 4) | (left = 4 & right = 3),'inverse swaps original a2/a3 private slots, independent of emitted register indices')
  end
  else if variant = 2 then failures = failures + check(facts.returnactionat(callid,firstret) = 'move','unequal joined integer values remain available owned storage')
  else do
    failures = failures + check(facts.returnactionat(callid,firstret) = 'none' & facts.returnactionat(callid,secondret) = 'integer','bare RET preserves destination while the other exit writes its immediate')
    projection = .llirgraph..access
    projection = dereference facts.access()
    domain = facts.integerdomain(facts.storage(callid,1))
    failures = failures + check(domain > 0 & projection.kills(callid,domain) = 0,'bare RET prevents a definite result kill over the call')
  end
  request = llinline..bind(reference original,callid,reference original,original.procedureid('helper'))
  changed = llinline..expand(request,'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','proved direct DAG expands ' || variant)
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  result = changed.result(); body = result.body(result.procedureid('main'))
  continuationid = changed.operation(continuationid)
  do i = 1 to body.records()
    item = body.record(i)
    if variant = 1 then do
      if item.kind() = '.meta' then do
        value = item.operand(1)
        if item.operands() = 4 then do; opens = opens + 1; freshname = value.text(); end
        if item.operands() = 1 then do
          clears = clears + 1; clearname = value.text(); clearordinal = i; clearaddress = item.addressid()
        end
      end
      if item.kind() = 'label' then do
        value = item.operand(1)
        if value.text() = firsttarget then sharedlabel = i
      end
    end
    if item.kind() <> 'instruction' then iterate
    if item.id() = continuationid then continued = 1
    else if continued = 0 then lastglue = item.id()
    if item.mnemonic() = 'ret' then returns = returns + 1
    if item.mnemonic() = 'move' then moves = moves + 1
    if item.mnemonic() = 'copy' then copies_found = copies_found + 1
    if item.mnemonic() = 'swap' then swaps = swaps + 1
    if item.mnemonic() = 'br' then do
      value = item.operand(1)
      if variant = 1 then do
        if firsttarget = '' then firsttarget = value.text()
        else failures = failures + check(value.text() = firsttarget,'both mixed return exits reach one continuation')
        exits = exits + 1
        lastarm = i
      end
    end
  end
  failures = failures + check(returns = 1 & changed.operation(callid) = 0,'cloned RETs never return from the authored caller ' || variant)
  if variant = 1 then failures = failures + check(moves = 1 & copies_found = 1 & swaps = 2 & exits = 2,'mixed exit code retains transfer modes and only the reached inverse')
  if variant = 1 then do
    failures = failures + check(opens = 1 & clears = 1 & freshname <> 'daglive' & freshname <> '' & clearname = freshname,'common-entry DAG binding is freshened and closed exactly once')
    failures = failures + check(sharedlabel > lastarm & clearordinal > sharedlabel,'shared metadata clear follows both complete lexical arms, never the first RET alone')
    failures = failures + check(continued & clearaddress = lastglue & clearaddress <> continuationid,'DAG clear is already visible at continuation addr-1')
    if clearaddress > 0 then do
      item = result.at(clearaddress)
      failures = failures + check(item.mnemonic() = 'cnop','shared DAG scope closes on a surviving CNOP carrier')
    end
    if clearordinal > 0 & clearordinal < body.records() then do
      item = body.record(clearordinal + 1)
      failures = failures + check(item.kind() = 'instruction' & item.id() = clearaddress,'one CNOP immediately follows the generated shared clear')
    end
    item = result.at(changed.operation(openid)); value = item.operand(1)
    failures = failures + check(item.kind() = '.meta' & item.operands() = 4 & value.text() = 'daglive','retained helper keeps its original scope declaration')
    item = result.at(changed.operation(clearid)); value = item.operand(1)
    failures = failures + check(item.addressid() = 0 & item.operands() = 1 & value.text() = 'daglive','original detached clear remains in the retained helper')
    daggraph = dereference result.ir(); dagimage = daggraph.binary()
    /* a1's active slot is restored before the shared clear. Splitting that
     * changing lexical binding is pending; a wrong direct remap is unsafe. */
    cleaned = llcleanup..transport(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
    failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'metadata.binding.change.pending','changing cloned argument scope has a precise transport proof refusal')
    if cleaned.status() <> 'keep' then do; say cleaned.reason(); return failures; end
    continuationid = cleaned.operation(continuationid); result = cleaned.result()
    failures = failures + dagclosed(reference result,continuationid)
    cleaned = llcleanup..storage(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
    failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'metadata.binding.change.pending','changing scope is retained until its placement observation proof exists')
    if cleaned.status() <> 'keep' then do; say cleaned.reason(); return failures; end
    continuationid = cleaned.operation(continuationid); result = cleaned.result()
    failures = failures + dagclosed(reference result,continuationid)
    keptgraph = dereference result.ir()
    failures = failures + check(bin2x(keptgraph.binary()) = bin2x(dagimage),'both changing-scope cleanup refusals preserve exact expanded owner')
  end
  graph = dereference original.ir(); image = graph.binary()
  if variant = 1 then do mode = 1 to 4
    select mode
      when 1 then limited = llinline..expand(request,'closed-main-default-halt.v1',1)
      when 2 then limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1)
      when 3 then limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,1)
      otherwise limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,67108864,0)
    end
    kept = limited.result(); limitedgraph = dereference kept.ir()
    failures = failures + check(limited.status() = 'limit' & limited.reason() <> '' & bin2x(limitedgraph.binary()) = bin2x(image),'DAG work/entry/byte/frame refusal returns exact original ' || mode)
  end
  return failures

/** Valid RXAS with a missing proof stays a call; these are not declarations
 * that differing joins, loops or abrupt exits are inherently uninlinable. */
dagkeepmodel: procedure = .lltarget..module
  arg variant = .int
  draft = .lltarget..draft('dag.keep.' || variant,'constructed.dag.keep.' || variant,0)
  at = draft.synthetic('independent DAG pending proof')
  root = draft.procedure('main',4,at)
  ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(5),at)
  ignored = three(root,'getandtp',root.reg('r',0),root.reg('r',1),.lltarget..operand.integer(768),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(11),at)
  fields = .object[]; fields[1] = root.reg('r',3) as .object
  fields[2] = .lltarget..operand.procedure('helper') as .object
  fields[3] = root.reg('r',0) as .object; fields[4] = root.reg('r',2) as .object
  ignored = root.emit('call2',fields,at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  localcount = 0
  if variant = 3 then localcount = 1
  if variant = 6 then localcount = 2
  leaf = draft.procedure('helper',localcount,at)
  if variant = 2 then do
    ignored = namedlabel(leaf,'again',at)
    ignored = one(leaf,'br',.lltarget..operand.symbol('again'),at)
    return draft.finish()
  end
  if variant = 6 then ignored = one(leaf,'null',leaf.reg('r',0),at)
  if variant = 3 then ignored = two(leaf,'brt',.lltarget..operand.symbol('positive'),leaf.reg('r',0),at)
  else ignored = two(leaf,'brt',.lltarget..operand.symbol('positive'),leaf.reg('a',1),at)
  select variant
    when 1 then do
      ignored = one(leaf,'br',.lltarget..operand.symbol('joined'),at)
      ignored = namedlabel(leaf,'positive',at)
      ignored = two(leaf,'link',leaf.reg('a',2),leaf.reg('a',1),at)
      ignored = namedlabel(leaf,'joined',at)
      ignored = one(leaf,'ret',leaf.reg('a',2),at)
    end
    when 4 then do
      ignored = one(leaf,'call',.lltarget..operand.procedure('inner'),at)
      ignored = one(leaf,'ret',.lltarget..operand.integer(0),at)
      ignored = namedlabel(leaf,'positive',at)
      ignored = one(leaf,'ret',.lltarget..operand.integer(1),at)
      innerbody = draft.procedure('inner',0,at)
      ignored = one(innerbody,'ret',.lltarget..operand.integer(0),at)
    end
    when 6 then do
      ignored = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(1),at)
      ignored = one(leaf,'br',.lltarget..operand.symbol('joined'),at)
      ignored = namedlabel(leaf,'positive',at)
      ignored = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(2),at)
      ignored = namedlabel(leaf,'joined',at)
      ignored = three(leaf,'linkarg',leaf.reg('r',1),leaf.reg('r',0),.lltarget..operand.integer(0),at)
      ignored = one(leaf,'ret',leaf.reg('r',1),at)
    end
    otherwise do
      ignored = one(leaf,'ret',.lltarget..operand.integer(0),at)
      ignored = namedlabel(leaf,'positive',at)
      if variant = 5 then ignored = one(leaf,'exit',.lltarget..operand.integer(7),at)
      else ignored = one(leaf,'ret',.lltarget..operand.integer(1),at)
    end
  end
  return draft.finish()

dagkeeps: procedure = .int
  failures = 0; variant = .int; i = .int; callid = .int; expected = .string
  original = .lltarget..module; kept = .lltarget..module; body = .lltarget..body; item = .lltarget..record
  request = .llinline..binding; decision = .llinline..decision; changed = .llinline..change
  do variant = 1 to 6
    original = dagkeepmodel(variant)
    failures = failures + check(original.valid(),'DAG negative is well-formed typed RXAS ' || variant)
    if original.valid() = 0 then do; say original.error(); iterate; end
    body = original.body(original.procedureid('main'))
    do i = 1 to body.records()
      item = body.record(i)
      if item.kind() = 'instruction' & item.mnemonic() = 'call2' then callid = item.id()
    end
    select variant
      when 1 then expected = 'join.binding.unproved'
      when 2 then expected = 'callee.cfg.cycle.pending'
      when 3 then expected = 'branch.condition.unproved'
      when 4 then expected = 'call.branch.history.pending'
      when 5 then expected = 'profile.callee.exit.pending'
      otherwise expected = 'argument.selector.unproved'
    end
    graph = dereference original.ir(); image = graph.binary()
    request = llinline..bind(reference original,callid,reference original,original.procedureid('helper'))
    decision = llinline..inspect(request,'closed-main-default-halt.v1')
    failures = failures + check(decision.status() = 'keep' & decision.reason() = expected,'DAG missing proof has its specific pending reason ' || variant)
    if decision.reason() <> expected then say decision.reason()
    changed = llinline..expand(request,'closed-main-default-halt.v1'); kept = changed.result()
    keptgraph = dereference kept.ir()
    failures = failures + check(changed.status() = 'keep' & changed.reason() = expected & bin2x(keptgraph.binary()) = bin2x(image),'DAG proof refusal retains byte-identical original ' || variant)
  end
  return failures

/** A counted child can cross locals/a0/arguments without any source SWAP.
 * Its original counter r0 is followed by a0 and a1, not by unrelated glue. */
nestedordered: procedure = .int
  failures = 0; i = .int; calls = .int; fixedcalls = .int; countcell = .int; countload = .int
  item = .lltarget..record; left = .lltarget..operand; right = .lltarget..operand
  draft = .lltarget..draft('nestedordered','constructed.nestedordered',0)
  at = draft.synthetic('retained counted window crosses original r/a boundary')
  root = draft.procedure('main',2,at)
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(7),at)
  callid = three(root,'call1',root.reg('r',1),.lltarget..operand.procedure('outer'),root.reg('r',0),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  outer = draft.procedure('outer',1,at)
  ignored = two(outer,'load',outer.reg('r',0),.lltarget..operand.integer(2),at)
  nestedid = three(outer,'call',outer.reg('a',1),.lltarget..operand.procedure('second'),outer.reg('r',0),at)
  ignored = one(outer,'ret',outer.reg('a',1),at)
  leaf = draft.procedure('second',0,at)
  ignored = one(leaf,'ret',leaf.reg('a',2),at)
  original = draft.finish(); graph = dereference original.ir(); before = graph.binary()
  facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(facts.status() = 'ok','counted child window is checked in its current outer frame')
  if facts.status() <> 'ok' then do; say facts.reason(); return failures; end
  failures = failures + check(facts.orderedslots(callid) & facts.rebinding(callid) = 0 & facts.swaps(callid) = 0,'window ordering is independent of explicit rebinding')
  failures = failures + check(facts.calls() = 1 & facts.callid(1) = callid & facts.bodyid(callid) = original.procedureid('outer'),'nested simulation does not publish or replace root-indexed call facts')
  request = llinline..bind(reference original,callid,reference original,original.procedureid('outer'))
  changed = llinline..expand(request,'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','outer expands while retaining exact counted child')
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  result = changed.result(); body = result.body(result.procedureid('main')); originalcall = original.at(nestedid)
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() <> 'instruction' then iterate
    if item.mnemonic() = 'call1' then fixedcalls = fixedcalls + 1
    if item.mnemonic() = 'call' then do
      calls = calls + 1
      failures = failures + check(item.opcode() = originalcall.opcode(),'retained nested call uses the original opcode')
      left = item.operand(1); right = item.operand(3); countcell = right.index()
      failures = failures + check(left.index() = countcell + 2,'a1 result stays the second member of the counted window')
    end
    if item.mnemonic() = 'load' then do
      left = item.operand(1); right = item.operand(2)
      if right.kind() = 'I' & right.index() = 1 then countload = left.index()
    end
  end
  failures = failures + check(calls = 1 & fixedcalls = 0 & countload = countcell + 1,'owned outer a0 remains adjacent between local counter and borrowed a1')
  failures = failures + check(body.locals() = 10,'ordered no-rebinding layout reserves exactly two complete slot regions plus result/scratch')
  failures = failures + check(changed.operation(callid) = 0,'only the original outer call identity is removed')
  limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,67108864,9)
  failures = failures + check(limited.status() = 'limit' & limited.reason() = 'inline.frame','ordered nested window demand is preflighted per site')
  kept = limited.result(); graph = dereference kept.ir()
  failures = failures + check(bin2x(graph.binary()) = bin2x(before),'ordered-window limit returns the exact original module')
  return failures

/** A selected argument means its active slot at that instruction. The same
 * source record can select different slots at two separately proved sites. */
argumentselection: procedure = .int
  failures = 0; variant = .int; i = .int; swaps = .int; links = .int; guards = .int; calls = .int; selected = .int
  firstcall = .int; secondcall = .int; selectid = .int; guardid = .int; expected = .int; remaining = .int; localcount = .int
  draft = .lltarget..draft; root = .lltarget..bodydraft; leaf = .lltarget..bodydraft
  at = .llir..origin; original = .lltarget..module; result = .lltarget..module
  item = .lltarget..record; next = .lltarget..record; originalselect = .lltarget..record; originalguard = .lltarget..record
  left = .lltarget..operand; right = .lltarget..operand; selectedslot = .lltarget..operand
  fields = .object[]; bindings = .object[]
  do variant = 1 to 3
    draft = .lltarget..draft('argumentselection.' || variant,'constructed.argumentselection',0)
    at = draft.synthetic('finite current-active argument selection')
    root = draft.procedure('main',4,at)
    ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(10),at)
    ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(20),at)
    ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(30),at)
    call objectarraydrop fields
    fields[1] = root.reg('r',3) as .object; fields[2] = .lltarget..operand.procedure('choose') as .object
    fields[3] = root.reg('r',0) as .object; fields[4] = root.reg('r',1) as .object; fields[5] = root.reg('r',2) as .object
    firstcall = root.emit('call3',fields,at); secondcall = 0
    if variant = 1 then do
