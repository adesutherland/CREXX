/* cREXX License (MIT). Independent constructed target/expansion contract. */
options levelb
import rxfnsb
import llir
import lltarget
import lltargetfacts
import llinline
import llcleanup

check: procedure = .int
  arg condition = .int, message = .string
  if condition then return 0
  say 'FAIL:' message
  return 1

one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object
  return body.emit(name,fields,at)
two: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object
  return body.emit(name,fields,at)
three: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, third = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object; fields[3] = third as .object
  return body.emit(name,fields,at)

/** A counted child can cross locals/a0/arguments without any source SWAP.
 * Its original counter r0 is followed by a0 and a1, not by unrelated glue. */
nestedordered: procedure = .int
  failures = 0; i = .int; calls = .int; fixedcalls = .int; countcell = .int; countload = .int
  item = .lltarget..record; left = .lltarget..operand; right = .lltarget..operand
  draft = .lltarget..draft('nestedordered','constructed.nestedordered',0)
  at = draft.synthetic('retained counted window crosses original r/a boundary')
  root = draft.procedure('main',2,at)
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(7),at)
  callid = three(root,'call1',root.reg('r',1),.lltarget..operand.procedure('outer'),root.reg('r',0),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  outer = draft.procedure('outer',1,at)
  ignored = two(outer,'load',outer.reg('r',0),.lltarget..operand.integer(2),at)
  nestedid = three(outer,'call',outer.reg('a',1),.lltarget..operand.procedure('second'),outer.reg('r',0),at)
  ignored = one(outer,'ret',outer.reg('a',1),at)
  leaf = draft.procedure('second',0,at)
  ignored = one(leaf,'ret',leaf.reg('a',2),at)
  original = draft.finish(); graph = dereference original.ir(); before = graph.binary()
  facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(facts.status() = 'ok','counted child window is checked in its current outer frame')
  if facts.status() <> 'ok' then do; say facts.reason(); return failures; end
  failures = failures + check(facts.orderedslots(callid) & facts.rebinding(callid) = 0 & facts.swaps(callid) = 0,'window ordering is independent of explicit rebinding')
  failures = failures + check(facts.calls() = 1 & facts.callid(1) = callid & facts.bodyid(callid) = original.procedureid('outer'),'nested simulation does not publish or replace root-indexed call facts')
  request = llinline..bind(reference original,callid,reference original,original.procedureid('outer'))
  changed = llinline..expand(request,'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','outer expands while retaining exact counted child')
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  result = changed.result(); body = result.body(result.procedureid('main')); originalcall = original.at(nestedid)
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() <> 'instruction' then iterate
    if item.mnemonic() = 'call1' then fixedcalls = fixedcalls + 1
    if item.mnemonic() = 'call' then do
      calls = calls + 1
      failures = failures + check(item.opcode() = originalcall.opcode(),'retained nested call uses the original opcode')
      left = item.operand(1); right = item.operand(3); countcell = right.index()
      failures = failures + check(left.index() = countcell + 2,'a1 result stays the second member of the counted window')
    end
    if item.mnemonic() = 'load' then do
      left = item.operand(1); right = item.operand(2)
      if right.kind() = 'I' & right.index() = 1 then countload = left.index()
    end
  end
  failures = failures + check(calls = 1 & fixedcalls = 0 & countload = countcell + 1,'owned outer a0 remains adjacent between local counter and borrowed a1')
  failures = failures + check(body.locals() = 10,'ordered no-rebinding layout reserves exactly two complete slot regions plus result/scratch')
  failures = failures + check(changed.operation(callid) = 0,'only the original outer call identity is removed')
  limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,67108864,9)
  failures = failures + check(limited.status() = 'limit' & limited.reason() = 'inline.frame','ordered nested window demand is preflighted per site')
  kept = limited.result(); graph = dereference kept.ir()
  failures = failures + check(bin2x(graph.binary()) = bin2x(before),'ordered-window limit returns the exact original module')
  return failures

/** A selected argument means its active slot at that instruction. The same
 * source record can select different slots at two separately proved sites. */
argumentselection: procedure = .int
  failures = 0; variant = .int; i = .int; swaps = .int; links = .int; guards = .int; calls = .int; selected = .int
  firstcall = .int; secondcall = .int; selectid = .int; guardid = .int; expected = .int; remaining = .int; localcount = .int
  draft = .lltarget..draft; root = .lltarget..bodydraft; leaf = .lltarget..bodydraft
  at = .llir..origin; original = .lltarget..module; result = .lltarget..module
  item = .lltarget..record; next = .lltarget..record; originalselect = .lltarget..record; originalguard = .lltarget..record
  left = .lltarget..operand; right = .lltarget..operand; selectedslot = .lltarget..operand
  fields = .object[]; bindings = .object[]
  do variant = 1 to 3
    draft = .lltarget..draft('argumentselection.' || variant,'constructed.argumentselection',0)
    at = draft.synthetic('finite current-active argument selection')
    root = draft.procedure('main',4,at)
    ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(10),at)
    ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(20),at)
    ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(30),at)
    call objectarraydrop fields
    fields[1] = root.reg('r',3) as .object; fields[2] = .lltarget..operand.procedure('choose') as .object
    fields[3] = root.reg('r',0) as .object; fields[4] = root.reg('r',1) as .object; fields[5] = root.reg('r',2) as .object
    firstcall = root.emit('call3',fields,at); secondcall = 0
    if variant = 1 then do
      ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(31),at)
      secondcall = root.emit('call3',fields,at)
    end
    ignored = one(root,'ret',.lltarget..operand.integer(0),at)
    localcount = 1
    if variant = 2 then localcount = 0
    leaf = draft.procedure('choose',localcount,at); guardid = 0
    if variant = 1 then do
      ignored = two(leaf,'swap',leaf.reg('a',1),leaf.reg('a',2),at)
      guardid = three(leaf,'ichkrng',leaf.reg('a',3),.lltarget..operand.integer(30),.lltarget..operand.integer(31),at)
      selectid = three(leaf,'linkarg',leaf.reg('r',0),leaf.reg('a',3),.lltarget..operand.integer(-29),at)
      ignored = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(99),at)
      ignored = one(leaf,'unlink',leaf.reg('r',0),at)
      ignored = one(leaf,'ret',leaf.reg('a',2),at)
    end
    else if variant = 2 then do
      ignored = two(leaf,'load',leaf.reg('a',0),.lltarget..operand.integer(77),at)
      selectid = two(leaf,'linkarg',leaf.reg('a',1),.lltarget..operand.integer(0),at)
      ignored = one(leaf,'ret',leaf.reg('a',1),at)
    end
    else do
      ignored = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(1),at)
      guardid = three(leaf,'ichkrng',leaf.reg('r',0),.lltarget..operand.integer(0),.lltarget..operand.integer(3),at)
      selectid = three(leaf,'linkarg',leaf.reg('r',0),leaf.reg('r',0),.lltarget..operand.integer(1),at)
      ignored = one(leaf,'ret',leaf.reg('r',0),at)
    end
    original = draft.finish()
    failures = failures + check(original.valid(),'finite selector target verifies ' || variant)
    if original.valid() = 0 then do; say original.error(); iterate; end
    facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
    failures = failures + check(facts.status() = 'ok','finite selector has checked current-frame facts ' || variant)
    if facts.status() <> 'ok' then do; say facts.reason(); iterate; end
    expected = 2
    if variant = 1 then expected = 1
    if variant = 2 then expected = 0
    remaining = facts.remaining()
    failures = failures + check(facts.argumentselector(firstcall,selectid) = expected & facts.rebinding(firstcall),'checked selector preserves zero and forces immutable base anchors ' || variant)
    failures = failures + check(facts.returnaction(firstcall) = 'copy','linked original local or argument returns remain whole COPY ' || variant)
    if secondcall > 0 then failures = failures + check(facts.argumentselector(secondcall,selectid) = 2 & facts.argumentselector(firstcall,selectid) = 1,'second activation does not overwrite the first call-site selector')
    failures = failures + check(facts.remaining() = remaining,'sealed selector queries do not consume handed-off work ' || variant)
    call objectarraydrop bindings
    bindings[1] = llinline..bind(reference original,firstcall,reference original,original.procedureid('choose')) as .object
    if secondcall > 0 then bindings[2] = llinline..bind(reference original,secondcall,reference original,original.procedureid('choose')) as .object
    changed = llinline..expandmany(bindings,'closed-main-default-halt.v1')
    failures = failures + check(changed.status() = 'changed','finite LINKARG lowers with ordinary LINK ' || variant)
    if changed.status() <> 'changed' then do; say changed.reason(); iterate; end
    result = changed.result(); body = result.body(result.procedureid('main'))
    if guardid > 0 then originalguard = original.at(guardid)
    swaps = 0; links = 0; guards = 0; calls = 0; selected = 0
    do i = 1 to body.records()
      item = body.record(i)
      if item.kind() <> 'instruction' then iterate
      if wordpos(item.mnemonic(),'call call1 call2 call3 call4 linkarg') > 0 then calls = calls + 1
      if item.mnemonic() = 'ichkrng' then do
        guards = guards + 1
        failures = failures + check(item.opcode() = originalguard.opcode(),'passing range check retains its exact original opcode ' || variant)
      end
      if item.mnemonic() = 'copy' then links = links + 1
      if variant = 1 & item.mnemonic() = 'swap' then do
        swaps = swaps + 1
        if swaps % 2 = 1 then do
          /* The passing guard is retained between the source SWAP and LINK. */
          next = body.record(i + 2); expected = 1
          if swaps = 3 then expected = 2
          selectedslot = item.operand(expected); left = next.operand(1); right = next.operand(2)
          failures = failures + check(next.mnemonic() = 'link' & right.index() = selectedslot.index(),'each site links to its proved active argument after SWAP')
          next = body.record(i + 4); right = next.operand(1); selectedslot = next.operand(2)
          failures = failures + check(next.mnemonic() = 'link' & right.index() = left.index() & selectedslot.index() <> left.index(),'original UNLINK restores the encoded local through a distinct anchor')
          selected = selected + 1
        end
      end
      else if variant > 1 & item.mnemonic() = 'load' then do
        left = item.operand(1); right = item.operand(2)
        if (variant = 2 & right.index() = 77) | (variant = 3 & right.index() = 1) then do
          next = body.record(i + variant - 1); selectedslot = next.operand(1); right = next.operand(2)
          failures = failures + check(next.mnemonic() = 'link','immediate or destination-aliased selector becomes ordinary LINK ' || variant)
          if variant = 2 then failures = failures + check(right.index() = left.index(),'index zero selects the current mutable a0, not captured arity')
          else failures = failures + check(selectedslot.index() = left.index() & right.index() <> left.index(),'selector is evaluated before its destination is rebound')
          selected = selected + 1
        end
      end
    end
    expected = 1
    if variant = 1 then expected = 2
    failures = failures + check(calls = 0 & selected = expected & links = expected,'selected calls and LINKARG are removed with exact COPY returns ' || variant)
    failures = failures + check(swaps = 4 * (variant = 1) & guards = expected * (variant <> 2),'only authored and inverse swaps remain; passing guards retain their opcode ' || variant)
    originalselect = original.at(selectid); item = result.at(changed.operation(selectid))
    failures = failures + check(item.opcode() = originalselect.opcode(),'unexpanded source helper retains its original LINKARG opcode ' || variant)
  end
  return failures

argumentkeeps: procedure = .int
  failures = 0; variant = .int; initial = .int
  reasons = .string[]
  reasons[1] = 'argument.selector.unproved'; reasons[2] = 'argument.selector.overflow.unproved'
  reasons[3] = 'argument.selector.bank.unproved'; reasons[4] = 'argument.range.unproved'; reasons[5] = 'argument.range.failure.unproved'
  draft = .lltarget..draft; root = .lltarget..bodydraft; leaf = .lltarget..bodydraft
  at = .llir..origin; original = .lltarget..module; kept = .lltarget..module
  fields = .object[]
  do variant = 1 to 5
    draft = .lltarget..draft('argumentkeep.' || variant,'constructed.argumentkeep',0)
    at = draft.synthetic('unproved selection retains the exact original call')
    root = draft.procedure('main',3,at); initial = 3
    if variant = 2 then initial = 9223372036854775807
    ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(initial),at)
    ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(1),at)
    if variant = 1 | variant = 4 then ignored = three(root,'getandtp',root.reg('r',0),root.reg('r',1),.lltarget..operand.integer(768),at)
    call objectarraydrop fields
    fields[1] = root.reg('r',2) as .object; fields[2] = .lltarget..operand.procedure('choose') as .object
    fields[3] = root.reg('r',0) as .object; fields[4] = root.reg('r',1) as .object
    callid = root.emit('call2',fields,at)
    ignored = one(root,'ret',.lltarget..operand.integer(0),at)
    leaf = draft.procedure('choose',1,at)
    if variant > 3 then do
      ignored = three(leaf,'ichkrng',leaf.reg('a',1),.lltarget..operand.integer(0),.lltarget..operand.integer(2),at)
      ignored = two(leaf,'linkarg',leaf.reg('r',0),.lltarget..operand.integer(1),at)
    end
    else do
      initial = 0
      if variant = 2 then initial = 1
      ignored = three(leaf,'linkarg',leaf.reg('r',0),leaf.reg('a',1),.lltarget..operand.integer(initial),at)
    end
    ignored = one(leaf,'ret',leaf.reg('r',0),at)
    original = draft.finish()
    failures = failures + check(original.valid(),'unproved selector/range still has a valid original target ' || variant)
    if original.valid() = 0 then do; say original.error(); iterate; end
    graph = dereference original.ir(); before = graph.binary()
    request = llinline..bind(reference original,callid,reference original,original.procedureid('choose'))
    changed = llinline..expand(request,'closed-main-default-halt.v1')
    failures = failures + check(changed.status() = 'keep' & changed.reason() = reasons[variant],'specific selector/range proof refusal ' || variant)
    kept = changed.result(); graph = dereference kept.ir()
    failures = failures + check(bin2x(graph.binary()) = bin2x(before),'unproved selector/range publishes unchanged original IR ' || variant)
  end
  return failures

/** Module storage is shared across activations, while a fixed actual keeps its
 * authored bank. Exercise both private layouts without allocating global bases. */
globalscalar: procedure = .int
  failures = 0; variant = .int; i = .int; locals = .int
  calls = .int; additions = .int; copies_found = .int; borrowed = .int; metadata_found = .int; traces = .int; globalends = .int
  draft = .lltarget..draft; root = .lltarget..bodydraft; leaf = .lltarget..bodydraft
  at = .llir..origin; original = .lltarget..module; result = .lltarget..module; kept = .lltarget..module
  item = .lltarget..record; left = .lltarget..operand; right = .lltarget..operand; number = .lltarget..operand
  fields = .object[]; bindings = .object[]
  do variant = 1 to 2
    draft = .lltarget..draft('globalscalar.' || variant,'constructed.globalscalar',2)
    at = draft.synthetic('private same-module scalar global and actual storage')
    root = draft.procedure('main',2,at)
    ignored = one(root,'null',root.reg('g',0),at)
    ignored = two(root,'load',root.reg('g',0),.lltarget..operand.integer(10),at)
    ignored = one(root,'null',root.reg('g',1),at)
    ignored = two(root,'load',root.reg('g',1),.lltarget..operand.integer(2),at)
    firstcall = three(root,'call1',root.reg('r',0),.lltarget..operand.procedure('addglobal'),root.reg('g',1),at)
    secondcall = three(root,'call1',root.reg('r',1),.lltarget..operand.procedure('addglobal'),root.reg('g',1),at)
    ignored = one(root,'ret',.lltarget..operand.integer(0),at)
    locals = variant - 1; leaf = draft.procedure('addglobal',locals,at)
    call objectarraydrop fields
    fields[1] = .lltarget..operand.string('shared' as .binary) as .object
    fields[2] = .lltarget..operand.string('b' as .binary) as .object
    fields[3] = .lltarget..operand.string('.int' as .binary) as .object; fields[4] = leaf.reg('g',0) as .object
    ignored = leaf.record('.meta',fields,at)
    call objectarraydrop fields
    fields[1] = .lltarget..operand.string('V' as .binary) as .object; fields[2] = .lltarget..operand.integer(4) as .object
    fields[3] = .lltarget..operand.string('R' as .binary) as .object; fields[4] = .lltarget..operand.string('I' as .binary) as .object
    fields[5] = .lltarget..operand.string('g' as .binary) as .object; fields[6] = .lltarget..operand.integer(1) as .object
    do i = 7 to 9; fields[i] = .lltarget..operand.integer(0) as .object; end
    fields[10] = .lltarget..operand.string('increment' as .binary) as .object; fields[11] = .lltarget..operand.string(''x as .binary) as .object
    ignored = leaf.record('.traceevent',fields,at)
    if variant = 1 then ignored = three(leaf,'iadd',leaf.reg('g',0),leaf.reg('g',0),leaf.reg('a',1),at)
    else do
      ignored = two(leaf,'link',leaf.reg('r',0),leaf.reg('a',1),at)
      ignored = three(leaf,'iadd',leaf.reg('g',0),leaf.reg('g',0),leaf.reg('r',0),at)
      ignored = one(leaf,'unlink',leaf.reg('r',0),at)
    end
    ignored = one(leaf,'ret',leaf.reg('g',0),at)
    call objectarraydrop fields
    fields[1] = .lltarget..operand.string('shared' as .binary) as .object
    ignored = leaf.record('.meta',fields,at)
    original = draft.finish()
    failures = failures + check(original.valid(),'same-module global constructed target verifies ' || variant)
    if original.valid() = 0 then do; say original.error(); iterate; end
    facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
    failures = failures + check(facts.status() = 'ok','repeated global effects retain one module storage state ' || variant)
    if facts.status() <> 'ok' then do; say facts.reason(); iterate; end
    failures = failures + check(facts.argumentbank(firstcall,1) = 'g' & facts.argument(firstcall,1) = 1 & facts.argumentbank(secondcall,1) = 'g' & facts.argument(secondcall,1) = 1,'fixed actual exposes logical global bank/index ' || variant)
    failures = failures + check(facts.argumentstorage(firstcall,1) = facts.argumentstorage(secondcall,1),'repeated global actuals retain exact module storage identity ' || variant)
    failures = failures + check(facts.rebinding(firstcall) = (variant = 2) & facts.returnaction(firstcall) = 'copy' & facts.returnaction(secondcall) = 'copy','global returns copy independently of private layout and local history ' || variant)
    call objectarraydrop bindings
    bindings[1] = llinline..bind(reference original,firstcall,reference original,original.procedureid('addglobal')) as .object
    bindings[2] = llinline..bind(reference original,secondcall,reference original,original.procedureid('addglobal')) as .object
    changed = llinline..expandmany(bindings,'closed-main-default-halt.v1')
    failures = failures + check(changed.status() = 'changed','same-module global calls expand atomically ' || variant)
    if changed.status() <> 'changed' then do; say changed.reason(); iterate; end
    result = changed.result(); body = result.body(result.procedureid('main'))
    calls = 0; additions = 0; copies_found = 0; borrowed = 0; metadata_found = 0; traces = 0; globalends = 0
    do i = 1 to body.records()
      item = body.record(i)
      if item.kind() = '.meta' & item.operands() = 4 then do
        left = item.operand(4)
        if left.bank() = 'g' & left.index() = 0 then metadata_found = metadata_found + 1
      end
      if item.kind() = '.traceevent' then do
        left = item.operand(5); number = item.operand(6)
        if left.text() = 'g' & number.index() = 1 then traces = traces + 1
      end
      if item.kind() <> 'instruction' then iterate
      if wordpos(item.mnemonic(),'call call1 call2 call3 call4') > 0 then calls = calls + 1
      if item.mnemonic() = 'endlife' then do
        left = item.operand(1)
        if left.bank() = 'g' then globalends = globalends + 1
      end
      if item.mnemonic() = 'iadd' then do
        left = item.operand(1); right = item.operand(2)
        if left.bank() = 'g' & left.index() = 0 & right.bank() = 'g' & right.index() = 0 then additions = additions + 1
      end
      if wordpos(item.mnemonic(),'copy link') > 0 then do
        right = item.operand(2)
        if item.mnemonic() = 'copy' & right.bank() = 'g' & right.index() = 0 then copies_found = copies_found + 1
        if item.mnemonic() = 'link' & right.bank() = 'g' & right.index() = 1 then borrowed = borrowed + 1
      end
    end
    failures = failures + check(result.globals() = 2 & calls = 0 & additions = 2 & copies_found = 2,'cloned arithmetic and COPY returns preserve module global count/index ' || variant)
    failures = failures + check(borrowed = 2 & globalends = 0,'fixed global actuals borrow original cells without global lifetime cleanup ' || variant)
    failures = failures + check(metadata_found = 2 & traces = 2,'cloned scoped metadata and TRACE preserve their original global bank/index ' || variant)
    graph = dereference result.ir(); before = graph.binary()
    cleaned = llcleanup..transport(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
    failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'transport.global.storage.pending','r-only transport keeps a conservative global caller ' || variant)
    kept = cleaned.result(); graph = dereference kept.ir()
    failures = failures + check(bin2x(graph.binary()) = bin2x(before),'transport global guard preserves exact expanded IR ' || variant)
    cleaned = llcleanup..storage(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
    failures = failures + check(cleaned.status() = 'keep' & cleaned.reason() = 'storage.global.storage.pending','r-only placement keeps a conservative global caller ' || variant)
    kept = cleaned.result(); graph = dereference kept.ir()
    failures = failures + check(bin2x(graph.binary()) = bin2x(before),'placement global guard preserves exact expanded IR ' || variant)
  end
  return failures

main: procedure = .int
  failures = 0
  draft = .lltarget..draft('constructed','constructed.fixture',0)
  at = draft.synthetic('constructed scalar call')
  root = draft.procedure('main',6,at)
  ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(11),at)
  ignored = two(root,'load',root.reg('r',2),.lltarget..operand.integer(23),at)
  ignored = two(root,'load',root.reg('r',3),.lltarget..operand.integer(2),at)
  snapshot_record_id = two(root,'copy',root.reg('r',4),root.reg('r',2),at)
  ignored = two(root,'settp',root.reg('r',4),.lltarget..operand.integer(768),at)
  ignored = two(root,'copy',root.reg('r',5),root.reg('r',1),at)
  ignored = two(root,'settp',root.reg('r',5),.lltarget..operand.integer(768),at)
  fields = .object[]; fields[1] = root.reg('r',0) as .object
  fields[2] = .lltarget..operand.procedure('pickfirst') as .object
  fields[3] = root.reg('r',3) as .object
  callid = root.emit('call',fields,at)
  ignored = one(root,'itos',root.reg('r',0),at)
  ignored = one(root,'say',root.reg('r',0),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('pickfirst',0,at)
  ignored = one(leaf,'ret',leaf.reg('a',1),at)
  original = draft.finish()
  failures = failures + check(original.valid(),'constructed module verifies')
  if original.valid() = 0 then do; say original.error(); say 'CONSTRUCTED_INLINE|failures=' || failures; return failures; end
  failures = failures + check(original.procedures() = 2,'catalogue is not a target procedure')
  failures = failures + check(original.records() = 14,'headers and records preserve source order')
  header = original.record(1); failures = failures + check(header.kind() = 'procedure','first source-order record is the procedure header')
  lastbody = original.procedure(2)
  failures = failures + check(lastbody.locals() = 0 & lastbody.name() = 'pickfirst','zero-local machine body is admitted')
  graph = dereference original.ir(); before = graph.binary()
  request = llinline..bind(reference original,callid,reference original,original.procedureid('pickfirst'))
  unknown = llinline..inspect(request)
  failures = failures + check(unknown.status() = 'keep' & unknown.reason() = 'signal.policy.unproved','unknown inherited policy retains the call')
  admitted = llinline..inspect(request,'closed-main-default-halt.v1')
  failures = failures + check(admitted.status() = 'legal' & admitted.arguments() = 2,'checked root derives the counted argument window')
  if admitted.status() <> 'legal' then say admitted.reason()
  changed = llinline..expand(request,'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','direct scalar return expands')
  if changed.status() <> 'changed' then say changed.reason()
  if changed.status() = 'changed' then do
    result = changed.result(); calls = 0; captures = 0; retainedsnapshot = 0
    do i = 1 to result.records()
      item = result.record(i)
      if item.kind() <> 'instruction' then iterate
      if item.mnemonic() = 'call' then calls = calls + 1
      if item.mnemonic() = 'link' then captures = captures + 1
      if item.id() = changed.operation(snapshot_record_id) then retainedsnapshot = item.mnemonic() = 'copy'
    end
    failures = failures + check(result.valid() & calls = 0 & captures = 3,'call removed with result and two borrowed-pointer anchors')
    failures = failures + check(retainedsnapshot,'conservative expansion retains the original value snapshot')
    failures = failures + check(changed.operation(callid) = 0,'removed call has no surviving instruction identity')
    newmain = result.procedure(1)
    failures = failures + check(newmain.locals() = 11,'fresh transport cells are explicit before cleanup')
  end
  graph = dereference original.ir()
  failures = failures + check(bin2x(graph.binary()) = bin2x(before),'expansion preserves the exact frozen input')
  limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,67108864,65536,1)
  failures = failures + check(limited.status() = 'limit' & limited.reason() = 'inline.code.cells','encoded-cell cap refuses without partial publication')
  kept = limited.result(); graph = dereference kept.ir()
  failures = failures + check(bin2x(graph.binary()) = bin2x(before),'failed expansion returns unchanged content')

  /* Independent negative builders exercise the target owner, not its reader. */
  rejected = .lltarget..draft('bad','bad.fixture',0)
  at = rejected.synthetic('foreign operands'); a = rejected.procedure('a',1,at); b = rejected.procedure('b',1,at)
  ignored = one(a,'ret',b.reg('r',0),at)
  failures = failures + check(pos('foreign register',rejected.error()) > 0,'foreign function operand is rejected before publication')

  forged = .lltarget..draft('forged','forged.fixture',0)
  at = forged.synthetic('forged register'); a = forged.procedure('main',1,at)
  real = a.reg('r',0)
  fake = .lltarget..operand.bound(real.owner(),real.procedureid(),real.slotid(),'r',1)
  ignored = one(a,'ret',fake,at); invalid = forged.finish()
  failures = failures + check(invalid.valid() = 0 & pos('descriptor mismatch',invalid.error()) > 0,'frozen target validation reconstructs bank/index/slot correspondence')

  missing = .lltarget..draft('missing','missing.fixture',0)
  at = missing.synthetic('missing branch'); a = missing.procedure('main',0,at)
  ignored = one(a,'br',.lltarget..operand.symbol('absent'),at)
  invalid = missing.finish()
  failures = failures + check(invalid.valid() = 0 & pos('unresolved branch',invalid.error()) > 0,'forward branch binding rejects a missing target')

  badstring = .lltarget..draft('badstring','badstring.fixture',0)
  at = badstring.synthetic('malformed RXAS string'); a = badstring.procedure('main',0,at)
  ignored = one(a,'say',.lltarget..operand.string('FF'x as .binary),at)
  ignored = one(a,'ret',.lltarget..operand.integer(0),at)
  invalid = badstring.finish()
  failures = failures + check(invalid.valid() = 0 & pos('LL_TARGET_STRING: LL_UTF8',invalid.error()) > 0,'constructed RXAS string rejects malformed UTF-8 before publication')

  baddecimal = .lltarget..draft('baddecimal','baddecimal.fixture',0)
  at = baddecimal.synthetic('noncanonical RXAS decimal'); a = baddecimal.procedure('main',1,at)
  rawdecimal = .lltarget..operand.decoded('D','',0,'1D' as .binary,0,0,0)
  ignored = two(a,'load',a.reg('r',0),rawdecimal,at)
  ignored = one(a,'ret',.lltarget..operand.integer(0),at)
  invalid = baddecimal.finish()
  failures = failures + check(invalid.valid() = 0 & pos('LL_TARGET_LITERAL',invalid.error()) > 0,'decoded decimal cannot bypass canonical lowercase suffix validation')

  small = .lltarget..draft('small','small.fixture',0,1000000,4096,1000000)
  at = small.synthetic('bounded payload'); a = small.procedure('main',1,at)
  huge = copies('x',8192) as .binary
  ignored = two(a,'load',a.reg('r',0),.lltarget..operand.string(huge),at)
  failures = failures + check(pos('budget',small.error()) > 0,'payload preflight fails before vector allocation')
  failures = failures + nestedordered()
  failures = failures + argumentselection() + argumentkeeps()
  failures = failures + globalscalar()
  say 'CONSTRUCTED_INLINE|failures=' || failures
  return failures
