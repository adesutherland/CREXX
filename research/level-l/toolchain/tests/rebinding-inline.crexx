/* cREXX License (MIT). Independent straight-line binding/return expectations. */
options levelb
import llir
import lltarget
import lltargetfacts
import llinline
import llcleanup

check: procedure = .int
  arg value = .int, message = .string
  if value then return 0
  say 'FAIL:' message
  return 1
one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object
  return body.emit(name,fields,at)
two: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object
  return body.emit(name,fields,at)
three: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, third = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object; fields[3] = third as .object
  return body.emit(name,fields,at)
four: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, first = .lltarget..operand, second = .lltarget..operand, third = .lltarget..operand, fourth = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = first as .object; fields[2] = second as .object; fields[3] = third as .object; fields[4] = fourth as .object
  return body.emit(name,fields,at)
instructions: procedure = .int
  arg body = .lltarget..body, name = .string
  count = 0
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() = 'instruction' & item.mnemonic() = name then count = count + 1
  end
  return count

argumentbase: procedure = .int
  failures = 0; i = .int; found = .int
  draft = .lltarget..draft('argumentbase','rebinding.argumentbase',0); at = draft.synthetic('argument base remains its original encoded slot')
  root = draft.procedure('main',3,at)
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(11),at)
  ignored = two(root,'load',root.reg('r',1),.lltarget..operand.integer(22),at)
  callid = four(root,'call2',root.reg('r',2),.lltarget..operand.procedure('entryswap'),root.reg('r',0),root.reg('r',1),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('entryswap',0,at)
  swapid = two(leaf,'swap',leaf.reg('a',1),leaf.reg('a',2),at)
  ignored = one(leaf,'unlink',leaf.reg('a',1),at)
  ignored = two(leaf,'load',leaf.reg('a',1),.lltarget..operand.integer(7),at)
  ignored = one(leaf,'ret',leaf.reg('a',2),at)
  original = draft.finish()
  facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(facts.status() = 'ok','swapped-argument source proof')
  if facts.status() <> 'ok' then do; say facts.reason(); return failures; end
  failures = failures + check(facts.rebinding(callid) & facts.returnaction(callid) = 'copy' & facts.swaps(callid) = 1 & facts.swap(callid,1) = swapid,'immutable binding plan preserves original swap identity and return mode')
  request = llinline..bind(reference original,callid,reference original,original.procedureid('entryswap'))
  changed = llinline..expand(request,'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','swapped argument with UNLINK expands')
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  result = changed.result(); body = result.body(result.procedureid('main')); found = 0
  /* base3,S3: anchors5/6/7 and active8/9/10. UNLINK a1 is
   * LINK active9,entry6, even though identity a1 moved to active10. */
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() <> 'instruction' | item.mnemonic() <> 'link' then iterate
    left = item.operand(1); right = item.operand(2)
    if left.index() = 9 & right.index() = 6 then found = 1
  end
  failures = failures + check(found & body.locals() = 11,'original encoded argument slot selects untouched entry anchor')
  failures = failures + check(instructions(body,'swap') = 2 & instructions(body,'copy') = 1 & instructions(body,'move') = 0,'argument return copies before inverse permutation')
  cleaned = llcleanup..transport(reference result,result.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(cleaned.status() = 'changed','existing whole-caller cleanup accepts rebinding transport')
  return failures

returnmodes: procedure = .int
  failures = 0; variant = .int
  do variant = 1 to 3
    draft = .lltarget..draft('returnmode' || variant,'rebinding.returnmode.' || variant,0)
    at = draft.synthetic('original local slot and own base jointly select MOVE')
    root = draft.procedure('main',2,at)
    ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(40),at)
    callid = three(root,'call1',root.reg('r',1),.lltarget..operand.procedure('helper'),root.reg('r',0),at)
    ignored = one(root,'ret',.lltarget..operand.integer(0),at)
    localcount = 1
    if variant = 3 then localcount = 2
    leaf = draft.procedure('helper',localcount,at)
    ignored = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(9),at)
    if variant = 3 then do
      ignored = two(leaf,'load',leaf.reg('r',1),.lltarget..operand.integer(5),at)
      ignored = two(leaf,'swap',leaf.reg('r',0),leaf.reg('r',1),at)
    end
    else do
      ignored = two(leaf,'link',leaf.reg('r',0),leaf.reg('a',1),at)
      ignored = three(leaf,'iadd',leaf.reg('a',1),leaf.reg('a',1),.lltarget..operand.integer(1),at)
      if variant = 2 then ignored = one(leaf,'unlink',leaf.reg('r',0),at)
    end
    ignored = one(leaf,'ret',leaf.reg('r',0),at)
    original = draft.finish()
    facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
    failures = failures + check(facts.status() = 'ok','local binding return proof ' || variant)
    if facts.status() <> 'ok' then do; say facts.reason(); return failures; end
    expected = 'copy'
    if variant = 2 then expected = 'move'
    failures = failures + check(facts.returnaction(callid) = expected,'linked and different-owned bases COPY; restored own base MOVE ' || variant)
    request = llinline..bind(reference original,callid,reference original,original.procedureid('helper'))
    changed = llinline..expand(request,'closed-main-default-halt.v1')
    failures = failures + check(changed.status() = 'changed','local binding return expands ' || variant)
    if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
    result = changed.result(); body = result.body(result.procedureid('main'))
    failures = failures + check(instructions(body,expected) = 1,'emitted return follows exact action ' || variant)
  end
  return failures

crossslot: procedure = .int
  failures = 0; i = .int; transfer = .int; reverse = .int; lastunlink = .int; firstend = .int; captured = .int; anchored = .int
  draft = .lltarget..draft('crossslot','rebinding.crossslot',0); at = draft.synthetic('cross-bank swap with captured overlapping result')
  root = draft.procedure('main',2,at)
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(70),at)
  callid = three(root,'call1',root.reg('r',0),.lltarget..operand.procedure('crossswap'),root.reg('r',0),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('crossswap',1,at)
  ignored = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(9),at)
  ignored = two(leaf,'swap',leaf.reg('r',0),leaf.reg('a',1),at)
  ignored = one(leaf,'unlink',leaf.reg('r',0),at)
  ignored = one(leaf,'ret',leaf.reg('a',1),at)
  original = draft.finish()
  facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(facts.status() = 'ok','cross-bank source proof')
  if facts.status() <> 'ok' then do; say facts.reason(); return failures; end
  failures = failures + check(facts.returnaction(callid) = 'copy','owned storage through argument spelling still COPYs')
  request = llinline..bind(reference original,callid,reference original,original.procedureid('crossswap'))
  changed = llinline..expand(request,'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','cross-bank binding expands')
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  result = changed.result(); body = result.body(result.procedureid('main'))
  /* base2,S3: result2, anchors4/5/6, active7/8/9. */
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() <> 'instruction' then iterate
    if item.mnemonic() = 'copy' then transfer = i
    if item.mnemonic() = 'swap' then reverse = i
    if item.mnemonic() = 'unlink' then lastunlink = i
    if item.mnemonic() = 'endlife' & firstend = 0 then firstend = i
    if item.mnemonic() = 'link' then do
      left = item.operand(1); right = item.operand(2)
      if left.index() = 2 & right.index() = 0 then captured = i
      if left.index() = 7 & right.index() = 4 then anchored = i
    end
  end
  failures = failures + check(captured > 0 & anchored > captured & transfer > anchored,'entry result capture and original local base survive body rebinding')
  failures = failures + check(reverse > transfer & lastunlink > reverse & firstend > lastunlink,'return then inverse identities then base restoration precede owned cleanup')
  failures = failures + check(instructions(body,'swap') = 2 & instructions(body,'move') = 0,'cross-bank SWAP has a true inverse and COPY return')
  limited = llinline..expand(request,'closed-main-default-halt.v1',1000000,1000000,67108864,9)
  failures = failures + check(limited.status() = 'limit' & limited.reason() = 'inline.frame','2*S+2 frame demand preflights before publication')
  return failures

repeated: procedure = .int
  failures = 0; i = .int; resets = .int; invalidreset = .int
  draft = .lltarget..draft('repeated','rebinding.repeated',0); at = draft.synthetic('mapping-only private bases do not observe recycler state')
  root = draft.procedure('main',3,at)
  ignored = two(root,'load',root.reg('r',0),.lltarget..operand.integer(50),at)
  firstcall = three(root,'call1',root.reg('r',1),.lltarget..operand.procedure('linkedreturn'),root.reg('r',0),at)
  secondcall = three(root,'call1',root.reg('r',2),.lltarget..operand.procedure('linkedreturn'),root.reg('r',0),at)
  ignored = one(root,'ret',.lltarget..operand.integer(0),at)
  leaf = draft.procedure('linkedreturn',1,at)
  ignored = two(leaf,'link',leaf.reg('r',0),leaf.reg('a',1),at)
  ignored = one(leaf,'ret',leaf.reg('r',0),at)
  original = draft.finish()
  facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
  failures = failures + check(facts.status() = 'ok','repeated mapping-only private base is unobserved')
  if facts.status() <> 'ok' then do; say facts.reason(); return failures; end
  failures = failures + check(facts.returnaction(firstcall) = 'copy' & facts.returnaction(secondcall) = 'copy','repeated linked local does not invent an owned MOVE/reset')
  bindings = .object[]
  bindings[1] = llinline..bind(reference original,firstcall,reference original,original.procedureid('linkedreturn')) as .object
  bindings[2] = llinline..bind(reference original,secondcall,reference original,original.procedureid('linkedreturn')) as .object
  changed = llinline..expandmany(bindings,'closed-main-default-halt.v1')
  failures = failures + check(changed.status() = 'changed','repeated rebinding sites expand atomically')
  if changed.status() <> 'changed' then do; say changed.reason(); return failures; end
  result = changed.result(); body = result.body(result.procedureid('main'))
  do i = 1 to body.records()
    item = body.record(i)
    if item.kind() <> 'instruction' | item.mnemonic() <> 'null' then iterate
    value = item.operand(1); resets = resets + 1
    /* First and second private local bases are8 and16; only a0 is reset. */
    if value.index() = 8 | value.index() = 16 then invalidreset = 1
  end
  failures = failures + check(resets = 2 & invalidreset = 0,'no emitted zero initialization substitutes for private recycler proof')
  return failures

ignoredresult: procedure = .int
  failures = 0; variant = .int
  do variant = 1 to 2
    draft = .lltarget..draft('ignored' || variant,'rebinding.ignored.' || variant,0); at = draft.synthetic('ignored return never resets an owned local')
    root = draft.procedure('main',1,at)
    callid = one(root,'call',.lltarget..operand.procedure('helper'),at)
    if variant = 2 then ignored = two(root,'call',root.reg('r',0),.lltarget..operand.procedure('helper'),at)
    ignored = one(root,'ret',.lltarget..operand.integer(0),at)
    leaf = draft.procedure('helper',1,at)
    ignored = two(leaf,'link',leaf.reg('r',0),leaf.reg('r',0),at)
    ignored = two(leaf,'load',leaf.reg('r',0),.lltarget..operand.integer(9),at)
    ignored = one(leaf,'ret',leaf.reg('r',0),at)
    original = draft.finish()
    facts = lltargetfacts..analyse(reference original,original.procedureid('main'),'closed-main-default-halt.v1')
    if variant = 1 then do
      failures = failures + check(facts.status() = 'ok','one ignored result source proof')
      if facts.status() = 'ok' then failures = failures + check(facts.returnaction(callid) = 'none','ignored local return records no MOVE/reset')
    end
    else failures = failures + check(facts.status() = 'keep' & facts.reason() = 'local.recycler.history.unproved','ignored prior RET supplies no reset proof for later whole return')
  end
  return failures

main: procedure = .int
  failures = argumentbase() + returnmodes() + crossslot() + repeated() + ignoredresult()
  say 'REBINDING_INLINE|failures=' || failures
  return failures
