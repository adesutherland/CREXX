/* Both calls use one foreign procedure and share its recycled r0.
 * LOAD changes only integer state: the second COPY observes prior flags256.
 * Fresh-per-site status would incorrectly give0. */
.globals=0
state_left() .expose=fixture.import.private.state
main() .locals=3
  load r0,0
  call1 r0,state_left(),r0
  getandtp r1,r0,768
  call1 r0,state_left(),r0
  getandtp r2,r0,768
  itos r1
  say r1
  itos r2
  say r2
  ret 0
