/* Analysis-unknown actual; independently expected normal, 0, 0, 1. */
.globals=0
main() .locals=4
  settp r3,0
  getandtp r0,r3,256
  load r1,99
  load r2,0
  sigpush "OUT_OF_RANGE"
  sigbr caught,"OUT_OF_RANGE"
  call1 r0,checked_identity(),r0
  .traceevent "F" 4 "R" "I" "r" 0 0 0 0 "checked_identity" ""
  load r2,1
  say "normal"
  sigpop "OUT_OF_RANGE"
  br joined
caught:
  sigpop "OUT_OF_RANGE"
  load r2,2
  say "handler"
  br joined
joined:
  itos r0
  say r0
  say r0
  itos r2
  say r2
  ret 0
checked_identity() .locals=0
  .meta "checked_identity.value"="b" ".int" a1
  .srcstep 1 1 17 "named_signal.g" 8 3 29 "  assembler ichkrng value,-5,5"
  ichkrng a1,-5,5
  ret a1
  .meta "checked_identity.value"
