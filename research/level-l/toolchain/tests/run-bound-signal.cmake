# Included by run-named-signal.cmake; shared helpers also serve scoped diagnostics.
include("${CMAKE_CURRENT_LIST_DIR}/signal-pair-helpers.cmake")
file(READ "${FIXTURES}/io-signal-bound.rxas" _bound_fixture)

foreach(_case normal fault alias-normal alias-fault known-normal known-fault)
  set(_original "${_bound_fixture}")
  if(_case MATCHES "fault$")
    string(REPLACE "settp r3,0" "settp r3,256" _original "${_original}")
  endif()
  if(_case MATCHES "^known-")
    set(_input 3)
    if(_case STREQUAL "known-fault")
      set(_input 12)
    endif()
    string(REPLACE "getandtp r0,r3,256" "load r0,${_input}" _original "${_original}")
  endif()
  set(_result r1)
  if(_case MATCHES "^alias-")
    set(_result r0)
    string(REPLACE "call1 r1,checked_identity(),r0" "call1 r0,checked_identity(),r0" _original "${_original}")
    string(REPLACE "\"r\" 1 1 1 0 \"checked_identity\"" "\"r\" 0 1 1 0 \"checked_identity\"" _original "${_original}")
    string(REPLACE "itos r1\n  say r1" "itos r0\n  say r0" _original "${_original}")
  endif()
  if(_case STREQUAL "known-normal")
    set(_expected "normal\n3\n3\n1\n55\npreloaded-name\npreloaded-message\n77\n256")
  elseif(_case STREQUAL "known-fault")
    set(_expected "handler\n12\n99\n2\n8\nOUT_OF_RANGE\n\n77\n256")
  elseif(_case STREQUAL "fault")
    set(_expected "handler\n256\n99\n2\n8\nOUT_OF_RANGE\n\n77\n256")
  elseif(_case STREQUAL "alias-fault")
    set(_expected "handler\n256\n256\n2\n8\nOUT_OF_RANGE\n\n77\n256")
  else()
    set(_expected "normal\n0\n0\n1\n55\npreloaded-name\npreloaded-message\n77\n256")
  endif()
  set(_source "${WORK}/bound-${_case}.rxas")
  file(WRITE "${_source}" "${_original}")
  foreach(_mode conservative cleanup)
    set(_options)
    if(_mode STREQUAL "conservative")
      set(_options --no-cleanup)
    endif()
    set(_product "${WORK}/bound-${_case}-${_mode}")
    run_checked("expand bound ${_case} ${_mode}" "${VM}" "${CLI}" ${RUNTIME} -a
      --module bound.rxas --profile closed-main-default-halt.v1 --work 12000000 ${_options}
      -o "${_product}.rxas" "${_source}")
    file(READ "${_product}.rxas" _expanded)
    expect_bound_policy("${_original}" "${_expanded}")
    string(FIND "${_expanded}" "checked_identity() .locals" _leaf)
    string(SUBSTRING "${_expanded}" 0 ${_leaf} _main)
    string(REGEX MATCHALL "linkattr1 " _links "${_main}")
    string(REGEX MATCHALL "unlink " _unlinks "${_main}")
    string(REGEX MATCHALL "copy ${_result},r0" _returns "${_main}")
    string(REGEX MATCHALL "[.]traceevent \"F\"[^\n]*\"checked_identity\"" _traces "${_main}")
    list(LENGTH _links _link_count)
    list(LENGTH _unlinks _unlink_count)
    list(LENGTH _returns _return_count)
    list(LENGTH _traces _trace_count)
    if(NOT _main MATCHES "main[(][)] [.]locals=12" OR _main MATCHES "(^|\n)[ \t]*(call1|endlife|link)[ \t]"
        OR NOT _link_count EQUAL 6 OR NOT _unlink_count EQUAL 6 OR NOT _return_count EQUAL 1 OR NOT _trace_count EQUAL 1
        OR NOT _main MATCHES "caught:\n[ \t]*sigpop \"OTHER\"")
      message(FATAL_ERROR "Bound expansion changed frame, consumer closure, policy entry or return/TRACE transport")
    endif()
    if(_mode STREQUAL "cleanup" AND (NOT _last_stderr MATCHES "transport.exceptional.cfg.pending"
        OR NOT _last_stderr MATCHES "storage.exceptional.cfg.pending"))
      message(FATAL_ERROR "Bound consumers lost the exceptional-CFG cleanup refusal")
    endif()
    # Test-only scalar probes occur after the restored join, outside inliner
    # input. They verify untouched normal event preload and closed scratch.
    set(_probe "joined:\nicopy r10,r4\nitos r10\nsay r10\nicopy r10,r5\nitos r10\nsay r10\nicopy r10,r6\nitos r10\nsay r10")
    string(REPLACE "joined:" "${_probe}" _observed_original "${_original}")
    string(REPLACE "joined:" "${_probe}" _observed_expanded "${_expanded}")
    set(_prefix "321\n0\n0")
    if(_case MATCHES "fault$")
      set(_prefix "0\n0\n0")
    endif()
    string(REGEX REPLACE "^(normal|handler)\n" "\\1\n${_prefix}\n" _observed_expected "${_expected}")
    bound_pair("bound-${_case}-${_mode}" "${_observed_original}" "${_observed_expanded}" "${_observed_expected}")
  endforeach()
endforeach()

file(READ "${WORK}/bound-known-normal.rxas" _bound_original)
file(READ "${WORK}/bound-known-normal-conservative.rxas" _bound_expanded)

# The result observation belongs solely to the normal continuation. The
# test-only marker after that source TRACE row must never run on a range fault.
foreach(_case known-normal known-fault)
  file(READ "${WORK}/bound-${_case}.rxas" _original)
  file(READ "${WORK}/bound-${_case}-conservative.rxas" _expanded)
  string(REPLACE "load r2,1" "say \"result-observed\"\nload r2,1" _original "${_original}")
  string(REPLACE "load r2,1" "say \"result-observed\"\nload r2,1" _expanded "${_expanded}")
  if(_case STREQUAL "known-normal")
    set(_expected "result-observed\nnormal\n3\n3\n1\n55\npreloaded-name\npreloaded-message\n77\n256")
  else()
    # Observe the actual delivered module/address only in the paired runtime
    # artifacts. METALOADDATA is the existing source owner; none of these raw
    # fields, helper calls or observations is an inliner proof premise.
    set(_observe "linkattr1 r5,r4,5\nlinkattr1 r6,r5,2\nicopy r10,r6\nunlink r6\nlinkattr1 r6,r5,3\nicopy r11,r6\nunlink r6\nunlink r5\nnull r6\nnull r5\ncall2 r10,observe_origin(),r10,r11\n")
    string(REPLACE "  null r4\n  br joined" "${_observe}null r4\n  br joined" _original "${_original}")
    string(REPLACE "null r4\nbr joined" "${_observe}null r4\nbr joined" _expanded "${_expanded}")
    string(APPEND _original "${_observer}")
    string(APPEND _expanded "${_observer}")
    set(_expected "handler\ncatchall.g\n8\n3\nassembler ichkrng value,-5,5\n12\n99\n2\n8\nOUT_OF_RANGE\n\n77\n256")
  endif()
  bound_pair("bound-observation-${_case}" "${_original}" "${_expanded}" "${_expected}")
endforeach()

foreach(_point entry before-commit after-commit after-observation)
  set(_original "${_bound_original}")
  set(_expanded "${_bound_expanded}")
  set(_signal "signal \"CANCEL\",\"pending-message\"")
  set(_result 99)
  if(_point STREQUAL "entry")
    string(REPLACE "call1 r1,checked_identity(),r0" "${_signal}\ncall1 r1,checked_identity(),r0" _original "${_original}")
    string(REPLACE "cnop\n" "${_signal}\ncnop\n" _expanded "${_expanded}")
  elseif(_point STREQUAL "before-commit")
    string(REPLACE "ret a1" "${_signal}\nret a1" _original "${_original}")
    string(REPLACE "copy r1,r0" "${_signal}\ncopy r1,r0" _expanded "${_expanded}")
  elseif(_point STREQUAL "after-commit")
    set(_result 3)
    string(REPLACE "call1 r1,checked_identity(),r0" "call1 r1,checked_identity(),r0\n${_signal}" _original "${_original}")
    string(REPLACE "copy r1,r0" "copy r1,r0\n${_signal}" _expanded "${_expanded}")
  else()
    set(_result 3)
    string(REPLACE "say \"normal\"" "say \"normal\"\n${_signal}" _original "${_original}")
    string(REPLACE "say \"normal\"" "say \"normal\"\n${_signal}" _expanded "${_expanded}")
  endif()
  foreach(_kind original expanded)
    string(REPLACE "load r2,2" "itos r2\nsay r2\nload r2,2" _${_kind} "${_${_kind}}")
  endforeach()
  set(_flag 0)
  if(_point STREQUAL "after-observation")
    set(_flag 1)
  endif()
  set(_expected "${_flag}\nhandler\n3\n${_result}\n2\n18\nCANCEL\npending-message\n77\n256")
  if(_point STREQUAL "after-observation")
    string(PREPEND _expected "normal\n")
  endif()
  bound_pair("bound-pending-${_point}" "${_original}" "${_expanded}" "${_expected}")
endforeach()

# ERROR=3 precedes CANCEL=18. Queue both while an ordinary SIGCALL activation
# defers delivery. A test-only handler-entry CNOP gives the pending CANCEL a
# dispatch boundary before any pop, overwriting the first bound ERROR event.
set(_queue "sigcall pending_pair(),\"OTHER\"\nsignal \"OTHER\"\n")
foreach(_kind original expanded)
  set(_${_kind} "${_bound_${_kind}}")
  if(_kind STREQUAL "original")
    string(REPLACE "call1 r1,checked_identity(),r0" "${_queue}call1 r1,checked_identity(),r0" _${_kind} "${_${_kind}}")
  else()
    string(REPLACE "cnop\n" "${_queue}cnop\n" _${_kind} "${_${_kind}}")
  endif()
  string(REPLACE "caught:\n" "caught:\ncnop\n" _${_kind} "${_${_kind}}")
  string(APPEND _${_kind} "\npending_pair() .locals=0\nsignal \"ERROR\",\"first\"\nsignal \"CANCEL\",\"second\"\nret 0\n")
endforeach()
bound_pair("bound-second-event" "${_original}" "${_expanded}" "handler\n3\n99\n2\n18\nCANCEL\nsecond\n77\n256")

# Preserve the existing repeated-pop terminal behavior for bound delivery too.
string(REPLACE "  sigpush \"INVALID_SIGNAL_CODE\"\n" "" _reordered "${_bound_original}")
string(REPLACE "  sigbrv caught,r4,\"FAILURE\"" "  sigpush \"INVALID_SIGNAL_CODE\"\n  sigbrv caught,r4,\"FAILURE\"" _reordered "${_reordered}")
string(REPLACE "  sigpop \"INVALID_SIGNAL_CODE\"\n" "" _reordered "${_reordered}")
string(REPLACE "  sigpop \"OTHER\"" "  sigpop \"INVALID_SIGNAL_CODE\"\n  sigpop \"OTHER\"" _reordered "${_reordered}")
file(WRITE "${WORK}/bound-reordered.rxas" "${_reordered}")
run_checked("expand reordered bound scope" "${VM}" "${CLI}" ${RUNTIME} -a --module bound.rxas
  --profile closed-main-default-halt.v1 --no-cleanup --work 12000000
  -o "${WORK}/bound-reordered-expanded.rxas" "${WORK}/bound-reordered.rxas")
file(READ "${WORK}/bound-reordered-expanded.rxas" _reordered_expanded)
foreach(_kind original expanded)
  set(_injected "${_reordered}")
  if(_kind STREQUAL "expanded")
    set(_injected "${_reordered_expanded}")
    string(REPLACE "cnop\n" "signal \"CANCEL\",\"first\"\ncnop\n" _injected "${_injected}")
  else()
    string(REPLACE "call1 r1,checked_identity(),r0" "signal \"CANCEL\",\"first\"\ncall1 r1,checked_identity(),r0" _injected "${_injected}")
  endif()
  string(REPLACE "sigpush \"FAILURE\"" "sighalt \"INVALID_SIGNAL_CODE\"\nsigpush \"FAILURE\"" _injected "${_injected}")
  string(REPLACE "sigpop \"INVALID_SIGNAL_CODE\"\n" "sigpop \"INVALID_SIGNAL_CODE\"\nsignal \"CANCEL\",\"second\"\n" _injected "${_injected}")
  set(_product "${WORK}/bound-restoration-${_kind}")
  file(WRITE "${_product}.rxas" "${_injected}")
  run_checked("assemble bound restoration ${_kind}" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
  execute_process(COMMAND "${VM}" "${_product}.rxbin" RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 15)
  if(NOT _status MATCHES "^[1-9][0-9]*$" OR NOT _stderr MATCHES "SIGNAL INVALID_SIGNAL_CODE[)]")
    message(FATAL_ERROR "Bound restoration ${_kind}: ${_status}\n${_stdout}${_stderr}")
  endif()
endforeach()

# Exact consumer failures retain calls. The whole-payload COPY case remains
# executable: with the empty range payload it replaces message integer/flags.
foreach(_case alias output-alias unreset event-unreset physical dynamic whole-payload missing-unlink escape alternate)
  set(_source "${_bound_fixture}")
  set(_reason signal.bound.consumer.pending)
  if(_case STREQUAL "alias")
    string(REPLACE "sigbrv caught,r4," "sigbrv caught,r0," _source "${_source}")
    set(_reason signal.bound.mapping.pending)
  elseif(_case STREQUAL "output-alias")
    string(REPLACE "copy r7,r6" "copy r0,r6" _source "${_source}")
    set(_reason signal.bound.mapping.pending)
  elseif(_case STREQUAL "unreset")
    string(REPLACE "  null r5\n  null r6\n  load r7" "  null r6\n  load r7" _source "${_source}")
    set(_reason signal.bound.state.unproved)
  elseif(_case STREQUAL "event-unreset")
    string(REPLACE "  null r4\n  load r4,321" "  load r4,321" _source "${_source}")
    set(_reason signal.bound.state.unproved)
  elseif(_case STREQUAL "physical")
    string(REPLACE "linkattr1 r6,r5,1" "linkattr1 r6,r5,2" _source "${_source}")
  elseif(_case STREQUAL "dynamic")
    string(REPLACE "linkattr1 r6,r5,1" "linkattr1 r6,r5,r3" _source "${_source}")
  elseif(_case STREQUAL "whole-payload")
    string(REPLACE "scopy r9,r6" "copy r9,r6" _source "${_source}")
    string(REPLACE "getandtp r0,r3,256" "load r0,12" _source "${_source}")
  elseif(_case STREQUAL "missing-unlink")
    string(REPLACE "  unlink r6\n" "" _source "${_source}")
  elseif(_case STREQUAL "escape")
    string(REPLACE "  scopy r9,r6" "  say r6\n  scopy r9,r6" _source "${_source}")
  else()
    string(REPLACE "  scopy r9,r6" "alternate:\n  scopy r9,r6" _source "${_source}")
    set(_reason signal.named.entry.pending)
  endif()
  bound_keep("${_case}" "${_source}" "${_reason}")
  if(_case STREQUAL "whole-payload")
    bound_pair("bound-retained-payload" "${_source}" "${_bound_kept}" "handler\n12\n99\n2\n8\nOUT_OF_RANGE\n\n0\n0")
  endif()
endforeach()
set(_published "${WORK}/bound-known-normal-cleanup.rxas")
file(READ "${_published}" _good)
execute_process(COMMAND "${VM}" "${CLI}" ${RUNTIME} -a --module bound.rxas
  --profile closed-main-default-halt.v1 --work 1 -o "${_published}" "${WORK}/bound-known-normal.rxas"
  RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
file(READ "${_published}" _after)
if(_status EQUAL 0 OR NOT _after STREQUAL _good OR NOT _stderr MATCHES "LL_INLINE_LIMIT")
  message(FATAL_ERROR "Bound event resource refusal changed last-good output")
endif()
