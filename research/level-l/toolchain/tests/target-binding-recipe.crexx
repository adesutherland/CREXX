/* cREXX License (MIT). Independent ordered semantic-recipe controls. */
options levelb
import rxfnsb
import llir
import lltarget
import lltargettransfer
import llrxascatalog

check: procedure = .int
  arg value = .int, label = .string
  if value then return 0
  say 'FAIL:' || label; return 1
emit: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, values = .object[], at = .llir..origin
  return body.emit(name,values,at)

/** The operational clear remains ordered cleanup. A call's unknown
 * invocation route is a separate effect, never a destination finalizer hook. */
orderedclear: procedure = .int
  arg owner = reference .lltargettransfer..profile, operation = .int, residual = 0, preceding = 0
  profile = dereference owner; row = profile.instruction(operation); catalog = .llrxascatalog..catalog()
  failures = 0; i = .int; cleared = .int; sentinel = .int
  action = .lltargettransfer..action; ref = .lltargettransfer..refview
  do i = 1 to row.actions()
    action = row.action(i)
    failures = failures + check(pos('catalog.callback.clear.',action.detail()) = 0,'cleanup-only clear has no synthesized resource callback or capture')
    if action.kind() = 'clear' & action.detail() = 'value.reset' then do
      cleared = i; ref = profile.ref(action.subject())
      failures = failures + check(i > preceding & action.domain() = 0 & ref.operandordinal() = 1 & ref.anchor() = 'active','whole clear retains its exact ordered active destination')
    end
    if action.kind() = 'callback' & action.detail() = 'catalog.callback.residual.' || catalog.callbackmask('invocation') then sentinel = 1
    if action.kind() = 'callcapture' then failures = failures + check(cleared > preceding & cleared < i,'argument/result pointer capture remains after the preparation clear')
  end
  failures = failures + check(cleared > preceding,'one semantic clear follows earlier binding actions')
  if residual then failures = failures + check(sentinel,'call invocation retains its independent residual callback route')
  return failures

/** Writer implementation owns prewrite release. Destination cleanup adds no
 * Rexx callback; real source-copy and unknown operation routes stay explicit. */
writercontracts: procedure = .int
  failures = 0; i = .int; j = .int; ignored = .int; bit = .int
  captured = .int; callback = .int; firstwrite = .int; cleared = .int; callbacks = .int
  operations = .int[]; fields = .object[]; action = .lltargettransfer..action; domain = .lltargettransfer..domain
  row = .lltargettransfer..instruction; view = .lltargettransfer..refview; catalog = .llrxascatalog..catalog()
  draft = .lltarget..draft('writer.contracts','fixture:writer.contracts',0)
  at = draft.synthetic('shared setters release resources without Rexx callbacks; field copies preserve them'); root = draft.procedure('main',3,at)
  fields[1] = root.reg('r',0) as .object; fields[2] = root.reg('r',1) as .object; fields[3] = .lltarget..operand.integer(7) as .object
  operations[1] = emit(root,'iand',fields,at)
  fields[3] = root.reg('r',2) as .object; operations[2] = emit(root,'iand',fields,at)
  call objectarraydrop fields; fields[1] = root.reg('r',0) as .object; fields[2] = .lltarget..operand.integer(17) as .object
  operations[3] = emit(root,'load',fields,at)
  fields[2] = .lltarget..operand.literal('F','1.25' as .binary) as .object; operations[4] = emit(root,'load',fields,at)
  fields[2] = .lltarget..operand.string('value' as .binary) as .object; operations[5] = emit(root,'load',fields,at)
  fields[2] = root.reg('r',1) as .object; operations[6] = emit(root,'strlen',fields,at)
  call objectarraydrop fields; fields[1] = root.reg('r',0) as .object; operations[7] = emit(root,'getnumdgts',fields,at)
  fields[2] = root.reg('r',1) as .object; operations[8] = emit(root,'icopy',fields,at)
  operations[9] = emit(root,'strupper',fields,at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.integer(0) as .object; ignored = emit(root,'ret',fields,at)
  source = draft.finish(); failures = failures + check(source.valid(),'writer contract source validates independently')
  if source.valid() = 0 then do; say source.error(); return failures; end
  profile = .lltargettransfer..profile(reference source)
  failures = failures + check(profile.status() = 'ok','writer contract canonical profile seals')
  if profile.status() <> 'ok' then do; say profile.message(); return failures; end
  do i = 1 to operations[0]
    row = profile.instruction(operations[i]); item = row.record(); captured = 0; callback = 0; firstwrite = 0; cleared = 0; callbacks = 0
    do j = 1 to row.actions()
      action = row.action(j)
      if action.kind() = 'capture' & action.detail() = 'catalog.callback.condition' then do
        domain = profile.domain(action.domain()); view = profile.ref(action.sourceid())
        if domain.nativebit() = catalog.componentmask('native-payload') & view.operandordinal() = 1 then captured = j
      end
      if wordpos(action.kind(),'write clear transport') > 0 & firstwrite = 0 then firstwrite = j
      if action.kind() = 'clear' then do
        domain = profile.domain(action.domain()); bit = domain.nativebit(); assembler ior cleared,cleared,bit
      end
      if action.kind() = 'callback' then do
        callbacks = callbacks + 1
        if action.detail() = 'catalog.callback.payload' then do
          domain = profile.domain(action.domain())
          if domain.nativebit() = catalog.componentmask('native-payload') then callback = j
        end
        failures = failures + check(action.certainty() = 'may' & action.path() = 'all' & action.phase() = 'unknown' & action.observation() = 'unknown','real copy or unknown operation callback retains its independent observation ' || i)
      end
    end
    if i <= 5 then do
      mask = catalog.componentmask('reference'); bit = catalog.componentmask('native-payload'); assembler ior mask,mask,bit
      failures = failures + check(catalog.valuewriter(item.opcode(),1) = 'setter' & cleared = mask & firstwrite > 0 & captured = 0 & callback = 0 & (callbacks > 0) = (profile.callbackobligations(item.id()) > 0),'shared setter clears released payloads without inventing a destination cleanup callback ' || i)
      if i <= 2 then failures = failures + check(row.complete('signals') = 0,'writer precision does not silently remove bitwise signal uncertainty ' || i)
    end
    else if i <= 8 then failures = failures + check(catalog.valuewriter(item.opcode(),1) = 'field' & cleared = 0 & callbacks = 0,'raw field/copy has no invented resource clear or callback ' || i)
    else failures = failures + check(catalog.valuewriter(item.opcode(),1) = 'unknown' & cleared = 0 & callbacks > 0,'alias-conditional string helper retains its unknown operation route without a must clear')
  end
  return failures

/** A stem GET can select its default child as the output itself. The helper
 * then returns successfully before release, so no must-clear may be emitted. */
stemaliaswriter: procedure = .int
  failures = 0; i = .int; cleared = 0; callback = 0; ignored = .int
  action = .lltargettransfer..action; domain = .lltargettransfer..domain
  catalog = .llrxascatalog..catalog(); draft = .lltarget..draft('writer.stem.alias','fixture:writer.stem.alias',0)
  at = draft.synthetic('successful selected-child alias is not an unconditional stem setter'); root = draft.procedure('main',3,at)
  fields = .object[]; fields[1] = root.reg('r',1) as .object; ignored = emit(root,'steminit',fields,at)
  fields[1] = root.reg('r',0) as .object; fields[2] = root.reg('r',1) as .object
  fields[3] = .lltarget..operand.integer(2) as .object; linked = emit(root,'linkattr',fields,at)
  call objectarraydrop fields; fields[1] = root.reg('r',2) as .object; fields[2] = .lltarget..operand.string('missing' as .binary) as .object
  ignored = emit(root,'load',fields,at)
  fields[1] = root.reg('r',0) as .object; fields[2] = root.reg('r',1) as .object; fields[3] = root.reg('r',2) as .object
  readop = emit(root,'stemget',fields,at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.integer(0) as .object; ignored = emit(root,'ret',fields,at)
  source = draft.finish(); failures = failures + check(source.valid(),'selected default-child alias is representable in target source')
  if source.valid() = 0 then do; say source.error(); return failures; end
  profile = .lltargettransfer..profile(reference source)
  failures = failures + check(profile.status() = 'ok','stem alias transfer profile seals')
  if profile.status() <> 'ok' then do; say profile.message(); return failures; end
  row = profile.instruction(readop); item = row.record()
  do i = 1 to row.actions()
    action = row.action(i)
    if action.kind() = 'clear' then cleared = cleared + 1
    if action.kind() = 'callback' & action.detail() = 'catalog.callback.payload' then do
      domain = profile.domain(action.domain())
      if domain.nativebit() = catalog.componentmask('native-payload') then callback = 1
    end
  end
  failures = failures + check(linked > 0 & catalog.valuewriter(item.opcode(),1) = 'unknown' & cleared = 0 & callback = 0 & profile.callbackobligations(readop) > 0,'successful stem output alias retains unknown copy effects without a destination finalizer or must resource clear')
  return failures

main: procedure = .int
  failures = 0; i = .int; captureid = .int; resizeat = .int
  statusat = .int; swapat = .int; callcaptureat = .int; callat = .int
  source = .lltarget..module; row = .lltargettransfer..instruction; action = .lltargettransfer..action
  ref = .lltargettransfer..refview
  catalog = .llrxascatalog..catalog(); opcode = .int
  draft = .lltarget..draft('ordered.recipes','fixture:ordered.recipes',0)
  at = draft.synthetic('independent recipe semantics')
  root = draft.procedure('main',8,at)
  fields = .object[]; fields[1] = root.reg('r',0) as .object; fields[2] = root.reg('r',1) as .object
  copy = emit(root,'copy',fields,at)
  captured = emit(root,'igetunlink',fields,at)
  assigned = emit(root,'isetunlink',fields,at)
  fields[3] = root.reg('r',0) as .object
  arithmetic = emit(root,'iadd',fields,at)
  call objectarraydrop fields; fields[1] = root.reg('r',4) as .object; fields[2] = root.reg('r',5) as .object; fields[3] = .lltarget..operand.integer(-1) as .object
  indexed = emit(root,'linkarg',fields,at)
  call objectarraydrop fields; fields[1] = root.reg('r',4) as .object; fields[2] = .lltarget..operand.integer(0) as .object
  argument = emit(root,'linkarg',fields,at)
  call objectarraydrop fields; fields[1] = root.reg('r',0) as .object; fields[2] = root.reg('r',1) as .object
  fields[3] = root.reg('r',2) as .object; fields[4] = .lltarget..operand.integer(1) as .object
  capturedindex = emit(root,'minlinkattr1',fields,at)
  call objectarraydrop fields; fields[1] = root.reg('r',0) as .object; fields[2] = .lltarget..operand.procedure('leaf') as .object
  fields[3] = root.reg('r',1) as .object; fields[4] = root.reg('r',2) as .object
  fields[5] = .lltarget..operand.integer(256) as .object; fields[6] = root.reg('r',3) as .object
  fused = emit(root,'settpswapcall',fields,at)
  call objectarraydrop fields; fields[1] = root.reg('r',6) as .object; fields[2] = .lltarget..operand.procedure('leaf') as .object
  resetcall = emit(root,'call',fields,at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.integer(0) as .object
  ignored = emit(root,'ret',fields,at)
  leaf = draft.procedure('leaf',0,at); ignored = emit(leaf,'ret',fields,at)
  source = draft.finish()
  failures = failures + check(source.valid(),'recipe fixture validates')
  if source.valid() = 0 then do; say source.error(); return 1; end
  original = dereference source.ir(); saved = original.binary()
  profile = .lltargettransfer..profile(reference source)
  failures = failures + check(profile.status() = 'ok','canonical decoder publishes checked profile')
  if profile.status() <> 'ok' then do; say profile.message(); return 1; end
  row = profile.instruction(captured)
  opcode = row.record().opcode()
  failures = failures + check(catalog.writes(opcode,2) & catalog.writecomplete(opcode,2) & catalog.writecomponents(opcode,2) = 0,'source slot restore has a known empty pointee-write projection')
  failures = failures + check(catalog.callbackoutputs(opcode,1) = 0 & catalog.callbackoutputs(opcode,2) = 0 & catalog.callbackcapacity(opcode,2) = 0,'captured integer assignment and pointer restore have no generated payload hooks')
  failures = failures + check(catalog.valuewriter(opcode,1) = 'field' & catalog.valuewriter(opcode,2) = 'field','captured integer put and source restoration are raw field/copy operations')
  failures = failures + check(row.actions() = 3,'capture/unlink/put has exactly three ordered effects')
  action = row.action(1); captureid = action.id()
  failures = failures + check(action.kind() = 'capture' & action.sourcekind() = 'reference' & action.offset() = 0,'integer capture records immutable source before restore')
  action = row.action(2)
  failures = failures + check(action.kind() = 'unlink','binding restore occurs after capture')
  action = row.action(3)
  failures = failures + check(action.kind() = 'transport' & action.sourcekind() = 'captured' & action.sourceid() = captureid,'put consumes exact earlier capture identity')
  row = profile.instruction(assigned); action = row.action(1)
  opcode = row.record().opcode()
  failures = failures + check(catalog.writecomplete(opcode,1) & catalog.writecomponents(opcode,1) = catalog.componentmask('I') & catalog.opaqueeffects(opcode) = 0 & catalog.callbackoutputs(opcode,1) = 0,'direct integer field copy has a precise nonopaque generated contract')
  failures = failures + check(row.actions() = 2,'integer field copy and unlink have exactly two ordered effects')
  failures = failures + check(action.kind() = 'transport' & row.complete('bindings') & row.complete('order'),'direct integer field copy precedes unlink without an unknown fallback')
  action = row.action(2); failures = failures + check(action.kind() = 'unlink','ISETUNLINK ordered restoration')
  row = profile.instruction(arithmetic); written = 0; observations = 0
  do i = 1 to row.actions()
    action = row.action(i)
    if action.kind() = 'read' | action.kind() = 'observe' then do
      failures = failures + check(written = 0,'ordinary aliased inputs precede every output write')
      if action.kind() = 'observe' then observations = observations + 1
    end
    if action.kind() = 'write' | action.kind() = 'clear' | action.kind() = 'transport' then written = 1
  end
  failures = failures + check(written & observations >= 2,'ordinary arithmetic publishes input observations and output effects')
  row = profile.instruction(indexed); found = 0
  do i = 1 to row.references()
    ref = row.ref(i)
    if ref.kind() = 'address' then do
      found = 1
      failures = failures + check(ref.addresskind() = 'argument' & ref.selectorkind() = 'reference' & ref.selectoroffset() = -1 & ref.targetbank() = 'a','physical argument address retains selector reference and signed offset')
    end
  end
  failures = failures + check(found,'addressed source remains enumerated')
  row = profile.instruction(capturedindex); captureid = 0; resizeat = 0
  do i = 1 to row.actions()
    action = row.action(i)
    if action.kind() = 'capture' then do
      captureid = action.id(); failures = failures + check(action.offset() = 1,'index adjustment belongs to immutable capture')
    end
    if action.kind() = 'resize' then do
      resizeat = i; failures = failures + check(action.sourcekind() = 'captured' & action.sourceid() = captureid & action.detail() = 'min','resize consumes captured adjusted selector')
    end
  end
  found = 0
  do i = 1 to row.references()
    ref = row.ref(i)
    if ref.kind() = 'address' then do
      found = 1; failures = failures + check(ref.addresskind() = 'attribute1' & ref.selectorkind() = 'captured' & ref.selectorid() = captureid,'attribute link uses same captured index after resize')
    end
  end
  failures = failures + check(found & resizeat > 0,'captured attribute address and resize are explicit')
  row = profile.instruction(fused); statusat = 0; swapat = 0; callcaptureat = 0; callat = 0
  do i = 1 to row.actions()
    action = row.action(i)
    select action.kind()
      when 'status' then statusat = i
      when 'flagwrite' then statusat = i
      when 'swap' then swapat = i
      when 'callcapture' then callcaptureat = i
      when 'call' then callat = i
      otherwise nop
    end
  end
  failures = failures + check(statusat > 0 & statusat < swapat & swapat < callcaptureat & callcaptureat < callat,'fused status/swap precede pointer capture and call')
  failures = failures + orderedclear(reference profile,resetcall,1)
  independent = .lltargettransfer..profiledraft(reference source,'ordered-swap-clear-control')
  ignored = independent.binding(copy,'swap:1:2;clear:1'); projected = independent.finish()
  failures = failures + check(projected.status() = 'ok','generic ordered clear recipe seals independently of native opcode admission')
  failures = failures + orderedclear(reference projected,copy,0,1)
  independent = .lltargettransfer..profiledraft(reference source,'unsupported-program')
  ignored = independent.binding(copy,'link:1:2;future:1'); projected = independent.finish()
  row = projected.instruction(copy); action = row.action(1)
  failures = failures + check(projected.status() = 'ok' & row.actions() = 1 & action.kind() = 'unknown','unsupported suffix discards the whole supported prefix atomically')
  failures = failures + check(row.complete('components') = 0 & row.complete('bindings') = 0 & row.complete('ownership') = 0,'unknown recipe invalidates dependent families together')
  independent = .lltargettransfer..profiledraft(reference source,'unsupported-clear-program')
  ignored = independent.binding(copy,'clear:1;future:1'); projected = independent.finish()
  row = projected.instruction(copy); action = row.action(1)
  failures = failures + check(projected.status() = 'ok' & row.actions() = 1 & action.kind() = 'unknown','unknown clear suffix cannot publish a partial resource checkpoint or waive a possible hook')
  independent = .lltargettransfer..profiledraft(reference source,'malformed-program')
  ignored = independent.binding(copy,'link:1:2;unlink:99'); projected = independent.finish()
  failures = failures + check(projected.status() = 'invalid','malformed second step rejects before publication')
  independent = .lltargettransfer..profiledraft(reference source,'missing-capture')
  ignored = independent.binding(copy,'unlink:2;putint:1'); projected = independent.finish()
  failures = failures + check(projected.status() = 'invalid','put without earlier capture is malformed')
  independent = .lltargettransfer..profiledraft(reference source,'tiny-recipe',1,1)
  ignored = independent.binding(copy,'captureint:2;unlink:2;putint:1'); projected = independent.finish()
  failures = failures + check(projected.status() = 'limit','tiny recipe allowance refuses deterministically')
  original = dereference source.ir()
  failures = failures + check(original.binary() = saved,'all failed and independent profiles preserve input owner')
  failures = failures + writercontracts() + stemaliaswriter()
  say 'TARGET_BINDING_RECIPE|failures=' || failures
  return failures
