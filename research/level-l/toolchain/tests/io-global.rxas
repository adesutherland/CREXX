/* Each private global is fully defined before a read. All calls precede ITOS. */
.globals=2
main() .locals=4
  null g0
  load g0,10
  null g1
  load g1,3
  load r0,2
  call1 r1,addglobal(),r0
  call1 r2,addglobal(),r0
  call1 r3,globalactual(),g1
  itos r1
  say r1
  itos r2
  say r2
  itos g0
  say g0
  itos r3
  say r3
  itos g1
  say g1
  ret 0
addglobal() .locals=0
  iadd g0,g0,a1
  ret g0
globalactual() .locals=0
  .meta "globalvalue"="b" ".int" g1
  iadd a1,a1,1
  iadd g1,g1,a1
  .traceevent "V" 4 "R" "I" "g" 1 0 0 0 "globalvalue" ""
  .meta "globalvalue"
  ret g1
