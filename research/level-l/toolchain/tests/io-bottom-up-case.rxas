/* Case-distinct exact procedure identities occupy different call depths. */
.globals=0
main() .locals=3
  load r0,7
  call1 r1,foo(),r0
  ieq r2,r1,8
  brf failure,r2
  ret 0
failure:
  ret 1
foo() .locals=1
  call1 r0,FOO(),a1
  ret r0
FOO() .locals=1
  call1 r0,leaf(),a1
  ret r0
leaf() .locals=1
  iadd r0,a1,1
  ret r0
