cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER LINKER CLI FIXTURES WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
set(_profile closed-main-static-exact-default-halt.v1)
set(_caller "${FIXTURES}/io-import-nested-caller.rxas")
set(_provider "${FIXTURES}/io-import-nested-provider.rxas")
set(_expected "17\n12\n31\n10\n27\n10\n34\n5\n17\n12")
set(_expected_outer_fixed fixture.import.nested.fixed)
set(_expected_outer_counted fixture.import.nested.counted)
set(_expected_outer_branch fixture.import.nested.branched)
set(_expected_child_left fixture.import.nested.child)
file(SHA256 "${_caller}" _caller_before)
file(SHA256 "${_provider}" _provider_before)

function(run_checked _description)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE _status
    OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 90)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "${_description}: ${_status}\n${_stdout}${_stderr}")
  endif()
  set(_last_stdout "${_stdout}" PARENT_SCOPE)
  set(_last_stderr "${_stderr}" PARENT_SCOPE)
endfunction()

function(execute_pair _source _product)
  run_checked("assemble ${_product}" "${ASSEMBLER}" -n -o "${_product}" "${_source}")
  run_checked("link ${_product}" "${LINKER}" -m "${_product}.map" -o "${_product}-linked"
    "${_product}.rxbin" "${WORK}/provider.rxbin")
  file(READ "${_product}.map" _map)
  string(FIND "${_map}" " from ${WORK}/provider.rxbin" _selected)
  if(_selected LESS 0)
    message(FATAL_ERROR "retained child import did not select the exact original provider")
  endif()
  run_checked("execute ${_product}" "${VM}" "${_product}-linked.rxbin")
  string(REPLACE "\r\n" "\n" _actual "${_last_stdout}")
  string(STRIP "${_actual}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "${_product}: expected '${_expected}', got '${_actual}'")
  endif()
endfunction()

function(expect_keep _name _reason _source _body)
  file(SHA256 "${_source}" _source_before)
  file(SHA256 "${_body}" _body_before)
  set(_output "${WORK}/${_name}-retained.rxas")
  run_checked("retain imported child ${_name}" "${VM}" "${CLI}" ${RUNTIME} -a
    --module io-import-nested-caller.rxas --profile "${_profile}" --work 12000000
    --body io-import-nested-provider.rxas "${_body}" -o "${_output}" "${_source}")
  string(FIND "${_last_stderr}" "LL_INLINE_KEEP: ${_reason}" _found)
  file(STRINGS "${_output}" _lines ENCODING UTF-8)
  set(_outer_calls 0)
  set(_other_calls 0)
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^[ \t]*call2 r[0-9]+,outer_(fixed|counted|branch)\\(\\),r[0-9]+,r[0-9]+$")
      math(EXPR _outer_calls "${_outer_calls} + 1")
    elseif(_line MATCHES "^[ \t]*(call[0-9]*|swapcall|settpswapcall|settpcall)[ \t]")
      math(EXPR _other_calls "${_other_calls} + 1")
    endif()
  endforeach()
  file(SHA256 "${_source}" _source_after)
  file(SHA256 "${_body}" _body_after)
  if(_found LESS 0 OR NOT _outer_calls EQUAL 6 OR NOT _other_calls EQUAL 0
      OR NOT _source_before STREQUAL _source_after OR NOT _body_before STREQUAL _body_after)
    message(FATAL_ERROR "${_name}: exact caller/provider or whole-batch keep '${_reason}' changed: ${_last_stderr}")
  endif()
endfunction()

# Native output checks the independent arithmetic before transformed artifacts.
# This exact provider image is then reused for every transformed link.
run_checked("assemble exact nested provider" "${ASSEMBLER}" -n -o "${WORK}/provider" "${_provider}")
file(SHA256 "${WORK}/provider.rxbin" _binary_before)
execute_pair("${_caller}" "${WORK}/original")

foreach(_mode conservative cleaned)
  set(_cleanup_option)
  if(_mode STREQUAL "conservative")
    set(_cleanup_option --no-cleanup)
  endif()
  set(_product "${WORK}/${_mode}")
  run_checked("expand imported retained child (${_mode})" "${VM}" "${CLI}" ${RUNTIME} -a
    --module io-import-nested-caller.rxas --artifact fixture:import-nested-caller
    --profile "${_profile}" --work 12000000
    --body io-import-nested-provider.rxas "${_provider}" ${_cleanup_option}
    -o "${_product}.rxas" "${_caller}")
  if(_mode STREQUAL "cleaned")
    string(FIND "${_last_stderr}" "LL_CLEANUP_KEEP: body.unavailable" _cleanup_keep)
    file(READ "${WORK}/conservative.rxas" _conservative)
    file(READ "${_product}.rxas" _cleaned)
    if(_cleanup_keep LESS 0 OR NOT _cleaned STREQUAL _conservative)
      message(FATAL_ERROR "caller-only cleanup must preserve the conservative imported-child expansion with its precise reason: ${_last_stderr}")
    endif()
  endif()
  file(STRINGS "${_product}.rxas" _lines ENCODING UTF-8)
  set(_imports 0)
  set(_definitions 0)
  set(_fixed 0)
  set(_counted 0)
  set(_sources 0)
  set(_traces 0)
  set(_caller_points 0)
  set(_snapshot_uses 0)
  set(_steps "")
  set(_last_step "")
  set(_last_clause "")
  set(_pending "")
  set(_previous_instruction "")
  set(_inverse "")
  set(_last_snapshot "")
  set(_snapshot "")
  set(_child_result "")
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^([^ \t]+)\\(\\)[ \t]+\\.expose=([^ \t]+)$")
      set(_alias "${CMAKE_MATCH_1}")
      set(_symbol "${CMAKE_MATCH_2}")
      set(_expected_symbol "${_expected_${_alias}}")
      if(NOT _symbol STREQUAL _expected_symbol)
        message(FATAL_ERROR "${_mode}: synthesized or changed import: ${_line}")
      endif()
      math(EXPR _imports "${_imports} + 1")
    elseif(_line MATCHES "^[^ \t]+\\(\\)[ \t]+\\.locals=")
      if(NOT _line MATCHES "^main\\(\\)[ \t]+\\.locals=([0-9]+)$")
        message(FATAL_ERROR "${_mode}: provider or surrogate definition escaped publication: ${_line}")
      endif()
      set(_locals "${CMAKE_MATCH_1}")
      math(EXPR _definitions "${_definitions} + 1")
    endif()
    if(_line MATCHES "_import\\.body\\.")
      message(FATAL_ERROR "${_mode}: a private surrogate identity escaped publication")
    endif()
    if(_line MATCHES "^[ \t]*\\.srcstep ([0-9]+) ([0-9]+) 0 \"io-import-nested-provider\\.rxas\" (9|17|28) 3 [0-9]+ ")
      set(_last_step "${CMAKE_MATCH_1}")
      set(_last_clause "${CMAKE_MATCH_2}")
      if(_last_step LESS_EQUAL 1 OR _last_clause LESS_EQUAL 1)
        message(FATAL_ERROR "${_mode}: cloned provider source IDs collide with caller observations")
      endif()
      list(APPEND _steps "${_last_step}")
      math(EXPR _sources "${_sources} + 1")
    elseif(_line MATCHES "^[ \t]*\\.srcstep 1 1 0 \"io-import-nested-caller\\.rxas\" 14 3 30 ")
      math(EXPR _caller_points "${_caller_points} + 1")
    endif()
    if(_line MATCHES "^[ \t]*\\.traceevent \"V\" 4 \"R\" \"I\" \"r\" ([0-9]+) ([0-9]+) ([0-9]+) 0 \"(fixed|counted|branched)-child\" \"\"$")
      if(NOT CMAKE_MATCH_2 STREQUAL _last_step OR NOT CMAKE_MATCH_3 STREQUAL _last_clause)
        message(FATAL_ERROR "${_mode}: retained child TRACE lost its source/clause relation")
      endif()
      set(_pending "r${CMAKE_MATCH_1}")
      math(EXPR _traces "${_traces} + 1")
    endif()
    if(NOT _line MATCHES "^[ \t]*[A-Za-z][A-Za-z0-9]*([ \t]|$)")
      continue()
    endif()
    if(NOT _inverse STREQUAL "")
      if(NOT _line STREQUAL _inverse)
        message(FATAL_ERROR "${_mode}: counted child's original inverse swap moved or disappeared: ${_line}")
      endif()
      set(_inverse "")
    endif()
    if(_line MATCHES "^[ \t]*icopy (r[0-9]+),r[0-9]+$")
      set(_last_snapshot "${CMAKE_MATCH_1}")
    endif()
    if(_line MATCHES "^[ \t]*call2 (r[0-9]+),child_left\\(\\),(r[0-9]+),(r[0-9]+)$")
      set(_child_result "${CMAKE_MATCH_1}")
      set(_snapshot "${_last_snapshot}")
      if(NOT CMAKE_MATCH_2 STREQUAL CMAKE_MATCH_3 OR NOT _pending STREQUAL CMAKE_MATCH_2)
        message(FATAL_ERROR "${_mode}: retained fixed child split a repeated actual or moved its TRACE: ${_line}")
      endif()
      math(EXPR _fixed "${_fixed} + 1")
    elseif(_line MATCHES "^[ \t]*call r[0-9]+,child_left\\(\\),r([0-9]+)$")
      math(EXPR _first "${CMAKE_MATCH_1} + 1")
      math(EXPR _second "${CMAKE_MATCH_1} + 2")
      if(_second GREATER_EQUAL _locals OR NOT _pending STREQUAL "r${_first}"
          OR NOT _previous_instruction MATCHES "^[ \t]*swap r${_first},r${_second}$")
        message(FATAL_ERROR "${_mode}: retained counted child lost its exact ordered window or TRACE: ${_line}")
      endif()
      set(_inverse "${_previous_instruction}")
      math(EXPR _counted "${_counted} + 1")
    elseif(_line MATCHES "^[ \t]*(call[0-9]*|swapcall|settpswapcall|settpcall)[ \t]")
      message(FATAL_ERROR "${_mode}: original outer or non-original child target survived: ${_line}")
    endif()
    if(NOT _pending STREQUAL "")
      if(NOT _line MATCHES "^[ \t]*call(2)? r[0-9]+,child_left\\(\\),")
        message(FATAL_ERROR "${_mode}: source/TRACE no longer addresses its retained child CALL: ${_line}")
      endif()
      set(_pending "")
    endif()
    if(NOT _snapshot STREQUAL "" AND _line MATCHES "^[ \t]*iadd r[0-9]+,${_snapshot},${_child_result}$")
      math(EXPR _snapshot_uses "${_snapshot_uses} + 1")
      set(_snapshot "")
    endif()
    set(_previous_instruction "${_line}")
  endforeach()
  list(REMOVE_DUPLICATES _steps)
  list(LENGTH _steps _distinct_steps)
  if(NOT _imports EQUAL 4 OR NOT _definitions EQUAL 1 OR NOT _fixed EQUAL 4 OR NOT _counted EQUAL 2
      OR NOT _sources EQUAL 6 OR NOT _traces EQUAL 6 OR NOT _distinct_steps EQUAL 6
      OR NOT _caller_points EQUAL 1 OR NOT _snapshot_uses EQUAL 4 OR NOT _pending STREQUAL "" OR NOT _inverse STREQUAL "")
    message(FATAL_ERROR "${_mode}: imported-child call/window/snapshot/observation structure changed")
  endif()
  execute_pair("${_product}.rxas" "${_product}")
endforeach()

# Each refusal retains the complete six-site caller. Mutations are temporary
# proof controls; the maintained caller and exact provider remain immutable.
file(READ "${_caller}" _caller_text)
file(READ "${_provider}" _provider_text)
string(REPLACE "child_left() .expose=fixture.import.nested.child\n" "" _missing "${_caller_text}")
file(WRITE "${WORK}/missing.rxas" "${_missing}")
expect_keep(missing-import import.child.import.missing "${WORK}/missing.rxas" "${_provider}")
string(REPLACE "child_left() .expose=fixture.import.nested.child" "child_left() .expose=fixture.import.nested.other" _misbound "${_caller_text}")
file(WRITE "${WORK}/misbound.rxas" "${_misbound}")
expect_keep(misbound-import import.child.import.missing "${WORK}/misbound.rxas" "${_provider}")
string(REPLACE ",child()," ",hidden()," _hidden "${_provider_text}")
file(WRITE "${WORK}/hidden-provider.rxas" "${_hidden}\nhidden() .locals=0\n  iadd a1,a1,7\n  ret a2\n")
expect_keep(private-child import.child.private.pending "${_caller}" "${WORK}/hidden-provider.rxas")
string(REPLACE "  iadd a1,a1,7\n  ret a2" "  call2 a1,deeper(),a1,a2\n  ret a2" _deeper "${_provider_text}")
file(WRITE "${WORK}/deeper-provider.rxas" "${_deeper}\ndeeper() .locals=0 .expose=fixture.import.nested.deeper\n  ret a1\n")
expect_keep(deeper-child nested.call.depth.pending "${_caller}" "${WORK}/deeper-provider.rxas")

set(_output "${WORK}/last-good.rxas")
file(WRITE "${_output}" "last-good-imported-child-output\n")
execute_process(COMMAND "${VM}" "${CLI}" ${RUNTIME} -a
  --module io-import-nested-caller.rxas --profile "${_profile}" --work 1
  --body io-import-nested-provider.rxas "${_provider}" -o "${_output}" "${_caller}"
  RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 90)
file(READ "${_output}" _after)
string(FIND "${_stdout}${_stderr}" "LL_INLINE_LIMIT:" _limit)
if(_status EQUAL 0 OR _limit LESS 0 OR NOT _after STREQUAL "last-good-imported-child-output\n")
  message(FATAL_ERROR "imported-child work refusal did not preserve CLI last-good output: ${_status}: ${_stdout}${_stderr}")
endif()
file(SHA256 "${_caller}" _caller_after)
file(SHA256 "${_provider}" _provider_after)
file(SHA256 "${WORK}/provider.rxbin" _binary_after)
if(NOT _caller_before STREQUAL _caller_after OR NOT _provider_before STREQUAL _provider_after OR NOT _binary_before STREQUAL _binary_after)
  message(FATAL_ERROR "imported-child expansion changed a frozen caller/provider source or provider binary")
endif()
file(REMOVE_RECURSE "${WORK}")
message("RXAS_IMPORTED_NESTED|failures=0")
