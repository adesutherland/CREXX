/* The public name binds caller g2 and provider g1 to one existing cell. */
.globals=2
g1 .expose=fixture.global.value

bump() .locals=0 .expose=fixture.global.bump
  .meta "shared"="b" ".int" g1
  iadd a1,a1,1
  .srcstep 1 1 0 "io-import-global-provider.rxas" 10 3 15 "  iadd g1,g1,a1"
  .traceevent "V" 4 "R" "I" "g" 1 1 1 0 "shared" ""
  iadd g1,g1,a1
  ret g1
