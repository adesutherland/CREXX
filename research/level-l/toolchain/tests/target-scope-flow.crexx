/* cREXX License (MIT). Independent storage binding and ordinary return controls. */
options levelb
import rxfnsb
import llir
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetflow

check: procedure = .int
  arg condition = .int, message = .string
  if condition then return 0
  say 'FAIL:' message
  return 1
one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, value = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = value as .object
  return body.emit(name,fields,at)
label: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, at = .llir..origin
  fields = .object[]; fields[1] = .lltarget..operand.symbol(name) as .object
  return body.record('label',fields,at)
load: procedure = .int
  arg body = .lltarget..bodydraft, destination = .int, value = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = body.reg('r',destination) as .object; fields[2] = value as .object
  return body.emit('load',fields,at)

joins: procedure = .int
  fields = .object[]; failures = 0
  draft = .lltarget..draft('scope.join','fixture:scope.join',0)
  at = draft.synthetic('equal payloads do not canonicalize incompatible bindings')
  body = draft.procedure('main',4,at)
  ignored = load(body,0,.lltarget..operand.integer(7),at)
  ignored = load(body,1,.lltarget..operand.integer(7),at)
  ignored = load(body,3,.lltarget..operand.integer(1),at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.symbol('join') as .object; fields[2] = body.reg('r',3) as .object
  ignored = body.emit('brf',fields,at)
  call objectarraydrop fields; fields[1] = body.reg('r',0) as .object; fields[2] = body.reg('r',1) as .object
  ignored = body.emit('swap',fields,at)
  joined = label(body,'join',at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  target = draft.finish(); root = target.procedureid('main')
  profile = .lltargettransfer..profile.closedmain(reference target,root,'closed-main-default-halt.v1',10000000)
  failures = failures + check(profile.status() = 'ok','exact binding transfer owner builds')
  if profile.status() <> 'ok' then do; say profile.message(); return failures; end
  failures = failures + check(profile.matches(reference target),'binding transfer profile retains its exact source owner')
  cfg = .lltargetcfg..graph(reference target,reference profile,10000000)
  failures = failures + check(cfg.status() = 'ok','exact binding CFG builds')
  if cfg.status() <> 'ok' then do; say cfg.message(); return failures; end
  failures = failures + check(cfg.matches(reference target,reference profile),'binding CFG retains its exact source/profile owners')
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg,10000000)
  failures = failures + check(flow.status() = 'ok','incompatible join remains a valid analysis')
  if flow.status() = 'ok' then do
    binding = flow.storageat(joined,'r',0)
    failures = failures + check(binding.active() = 0 & binding.slotidentity() = 0,'join of different storage/slot permutations stays unknown despite equal payloads')
  end
  else say flow.reason()
  return failures

/** The ordered ISETUNLINK recipe writes the integer before restoring its
 * binding. A later UNLINK cannot resurrect the earlier integer. */
orderedbinding: procedure = .int
  i = .int; failures = 0; fields = .object[]
  draft = .lltarget..draft('binding.unknown','fixture:binding.unknown',0)
  at = draft.synthetic('ordered binding recipe keeps the written component')
  body = draft.procedure('main',2,at)
  ignored = load(body,0,.lltarget..operand.integer(17),at)
  ignored = load(body,1,.lltarget..operand.integer(99),at)
  fields[1] = body.reg('r',0) as .object; fields[2] = body.reg('r',1) as .object
  compound = body.emit('isetunlink',fields,at)
  restored = one(body,'unlink',body.reg('r',0),at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  target = draft.finish(); root = target.procedureid('main')
  profile = .lltargettransfer..profile.closedmain(reference target,root,'closed-main-default-halt.v1',10000000)
  failures = failures + check(profile.status() = 'ok','exact binding transfer owner builds')
  if profile.status() <> 'ok' then do; say profile.message(); return failures; end
  failures = failures + check(profile.matches(reference target),'binding transfer profile retains its exact source owner')
  cfg = .lltargetcfg..graph(reference target,reference profile,10000000)
  failures = failures + check(cfg.status() = 'ok','exact binding CFG builds')
  if cfg.status() <> 'ok' then do; say cfg.message(); return failures; end
  failures = failures + check(cfg.matches(reference target,reference profile),'binding CFG retains its exact source/profile owners')
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg,10000000)
  failures = failures + check(flow.status() = 'ok','ordered compound binding retains usable flow')
  if flow.status() <> 'ok' then do; say flow.reason(); return failures; end
  instruction = profile.instruction(compound); unknown = 0
  do i = 1 to instruction.actions()
    action = instruction.action(i)
    if action.kind() = 'unknown' then unknown = 1
  end
  failures = failures + check(unknown = 0,'ordered binding recipe has no generic unknown transfer')
  failures = failures + check(instruction.complete('components') & instruction.complete('values') & instruction.complete('ownership') & instruction.complete('bindings') & instruction.complete('order'),'ordered compound recipe has complete affected fact families')
  integer = 0
  do i = 1 to profile.domains()
    domain = profile.domain(i)
    if domain.kind() = 'component' & domain.nativebit() = 1 then integer = i
  end
  value = flow.componentat(restored,'r',0,integer,1)
  failures = failures + check(value.known(),'later UNLINK keeps the written integer known')
  if value.known() then do
    literal = value.literal()
    failures = failures + check(literal.index() = 99,'later UNLINK retains the written integer rather than the old constant')
  end
  return failures

/** String setters can release reference/native payload and private status.
 * Their result descriptor must invalidate old optional facts before defining S. */
stringresult: procedure = .int
  arg referencevalue = 0
  entry = .int; continued = .int; ignored = .int
  i = .int; failures = 0; fields = .object[]
  draft = .lltarget..draft('return.invalidation.' || referencevalue,'fixture:return.invalidation',0)
  at = draft.synthetic('return setter invalidation is independent of storage binding')
  body = draft.procedure('main',4,at)
  ignored = load(body,0,.lltarget..operand.integer(17),at)
  binarydefinition = load(body,1,.lltarget..operand.literal('B','0x00FF' as .binary),at)
  if referencevalue then do
    fields[1] = body.reg('r',1) as .object; fields[2] = body.reg('r',0) as .object
    ignored = body.emit('mkref',fields,at)
  end
  call objectarraydrop fields; fields[1] = body.reg('r',1) as .object; fields[2] = .lltarget..operand.integer(256) as .object
  ignored = body.emit('settp',fields,at)
  call objectarraydrop fields; fields[1] = body.reg('r',0) as .object; fields[2] = body.reg('r',1) as .object
  fields[3] = .lltarget..operand.integer(256) as .object
  ignored = body.emit('getandtp',fields,at)
  call objectarraydrop fields; fields[1] = body.reg('r',1) as .object; fields[2] = .lltarget..operand.procedure('leaf') as .object
  fields[3] = body.reg('r',0) as .object
  entry = body.emit('call1',fields,at)
  continued = label(body,'continued',at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  body = draft.procedure('leaf',0,at)
  ignored = one(body,'ret',.lltarget..operand.string('fresh' as .binary),at)
  target = draft.finish(); root = target.procedureid('main')
  profile = .lltargettransfer..profile.closedmain(reference target,root,'closed-main-default-halt.v1',10000000)
  failures = failures + check(profile.status() = 'ok','return invalidation profile builds')
  if profile.status() <> 'ok' then do; say profile.message(); return failures; end
  cfg = .lltargetcfg..graph(reference target,reference profile,10000000)
  failures = failures + check(cfg.status() = 'ok','return invalidation CFG builds')
  if cfg.status() <> 'ok' then do; say cfg.message(); return failures; end
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg,10000000)
  failures = failures + check(flow.status() = 'ok','string setter result flow builds')
  if flow.status() <> 'ok' then do; say flow.reason(); return failures; end
  binary = 0; string = 0; flag = 0
  do i = 1 to profile.domains()
    domain = profile.domain(i)
    if domain.kind() = 'component' & domain.nativebit() = 16 then binary = i
    if domain.kind() = 'component' & domain.nativebit() = 4 then string = i
    if domain.kind() = 'flag' & domain.nativebit() = 256 then flag = i
  end
  failures = failures + check(binary > 0 & string > 0 & flag > 0,'independent binary, string and flag domains are represented')
  if binary > 0 & string > 0 & flag > 0 then do
    prior = flow.componentat(binarydefinition,'r',1,binary,1)
    failures = failures + check(prior.known(),'prior binary constant is independently known before status/reference preparation')
    /* The continuation label also joins failed/resumed call paths. Only the
     * CALL's normal-after projection licenses its successful string setter. */
    payload = flow.componentat(entry,'r',1,string,1)
    oldbinary = flow.componentat(entry,'r',1,binary,1)
    oldflag = flow.flagat(entry,'r',1,flag,1)
    failures = failures + check(payload.known() & oldbinary.kind() = 'unknown' & oldflag.kind() = 'unknown','normal string result defines S while invalidating old payload/status facts ' || referencevalue || ': ' || payload.kind() || '/' || oldbinary.kind() || '/' || oldflag.kind())
    if payload.known() then do
      literal = payload.literal()
      failures = failures + check(literal.kind() = 'S' & literal.text() = 'fresh','normal string result retains the authored return literal')
    end
  end
  return failures

/** Physical signal RETURN retires the current ordinary frame. Logical inline
 * signal exits await the separately selected region/metadata design; retired
 * executable scope entries supply no substitute contract. */
main: procedure = .int
  failures = joins() + orderedbinding() + stringresult() + stringresult(1)
  say 'TARGET_SCOPE_FLOW|failures=' || failures
  return failures
