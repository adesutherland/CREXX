/* Native pick's N-F range, with genuinely unknown interval1..3 actuals. */
.globals=0
main() .locals=10
  .srcstep 1 1 17 "runtime-selector.g" 1 1 18 "result = pick(ix)"
  load r7,0x00
  load r8,0x00
  bineq r0,r7,0x01
  bineq r6,r8,0x01
  iadd r0,r0,r6
  iadd r0,r0,1
  load r1,10
  load r1,"ten"
  settp r1,256
  load r2,20
  load r2,"twenty"
  settp r2,512
  load r3,30
  load r3,"thirty"
  settp r3,768
  call4 r4,pick(),r0,r1,r2,r3
  .traceevent "F" 4 "R" "O" "r" 4 1 1 0 "pick" ""
  call4 r5,pick(),r0,r1,r2,r3
  itos r4
  say r4
  icopy r9,r5
  itos r9
  say r9
  say r5
  getandtp r9,r5,768
  itos r9
  say r9
  icopy r9,r1
  itos r9
  say r9
  icopy r9,r2
  itos r9
  say r9
  icopy r9,r3
  itos r9
  say r9
  say "continued"
  ret 0
pick() .locals=2
  .meta "pick.ix"="b" ".int" a1
  icopy r1,a0
  isub r1,r1,1
  .srcstep 2 2 17 "runtime-selector.g" 14 3 23 "assembler checked pick"
  ichkrng a1,1,r1
  linkarg r0,a1,1
  .srcstep 3 3 17 "runtime-selector.g" 15 3 11 "return item"
  ret r0
  .meta "pick.ix"
