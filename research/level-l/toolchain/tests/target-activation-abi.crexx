  failures = failures + check(flow.complete(source.procedureid('main'),'entry-observation') = 0 & flow.complete(source.procedureid('main'),'entry-normalization') = 0,'unknown demand coverage also vetoes unconditional flow certificates ' || mode)
  return failures

/** An external action's typed intrinsic footprint is separate from its host
 * callback. Constructed events deliberately use an ordinary LOAD record so
 * this consumer proof cannot depend on an output mnemonic. */
externalfootprint: procedure = .int
  arg mode = .int
  failures = 0; ignored = .int; i = .int; initialize = .int; observed = .int; callbackordinal = .int
  referenceid = .int; sourceref = .int; found = .int
  draft = .lltarget..draft('entry.external.footprint.' || mode,'fixture:entry.external.footprint',0)
  at = draft.synthetic('complete intrinsic footprint never removes host callback havoc')
  root = draft.procedure('main',2,at); fields = .object[]; empty = .object[]
  if mode = 3 then do
    fields[1] = root.reg('r',0) as .object; fields[2] = .lltarget..operand.integer(17) as .object
    initialize = root.emit('load',fields,at)
  end
  fields[1] = root.reg('r',1) as .object; fields[2] = .lltarget..operand.integer(29) as .object
  opaque = root.emit('load',fields,at)
  if mode = 3 then do
    fields[1] = root.reg('r',1) as .object; fields[2] = root.reg('r',0) as .object
    fields[3] = .lltarget..operand.integer(0) as .object
    observed = root.emit('iadd',fields,at)
  end
  ignored = root.emit('ret',empty,at); source = draft.finish()
  failures = failures + check(source.valid(),'external footprint source validates ' || mode)
  if source.valid() = 0 then do; say source.error(); return failures; end
  premise = .lltargettransfer..profiledraft(reference source,'independent.external.footprint.' || mode)
  catalog = .llrxascatalog..catalog(); integer = premise.domain('component','fixture.external.integer',catalog.componentmask('I'))
  do i = 1 to source.records()
    item = source.record(i)
    if item.kind() = 'procedure' then iterate
    ignored = premise.operation(item.id()); ignored = premise.relocation(item.id(),'none')
  end
  if mode = 3 then do
    referenceid = premise.ref(initialize,1)
    ignored = premise.event(initialize,'write',referenceid,integer,'literal',0,.lltarget..operand.integer(17))
  end
  if mode = 4 then do
    /* The external operation observes r1 through a separate typed action. */
    referenceid = premise.ref(opaque,1)
    ignored = premise.event(opaque,'observe',referenceid,integer)
  end
  complete = mode <> 0
  ignored = premise.event(opaque,'external',0,0,'none',0,.lltarget..operand(),'must','all','none','fixture.intrinsic',0,'unknown',complete)
  if mode >= 2 then do
    callbackordinal = 2; if mode = 4 then callbackordinal = 3
    ignored = premise.event(opaque,'callback',0,0,'none',0,.lltarget..operand(),'may','all','unknown','fixture.external.host')
  end
  if mode = 3 then do
    referenceid = premise.ref(observed,1); sourceref = premise.ref(observed,2)
    ignored = premise.event(observed,'observe',sourceref,integer)
    ignored = premise.event(observed,'write',referenceid,integer)
  end
  profile = premise.finish(); cfg = .lltargetcfg..graph(reference source,reference profile)
  flow = .lltargetflow..analysis(reference source,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','external footprint flow builds ' || mode)
  if flow.status() <> 'ok' then do; say flow.reason(); return failures; end
  coverage = flow.entrycoverage(source.procedureid('main'))
  if mode = 0 then failures = failures + check(coverage.complete() = 0 & coverage.unresolved() & coverage.reason() = 'target.flow.entry.external.footprint.unproved','unqualified external footprint remains explicitly unresolved')
  else if mode = 1 | mode = 2 then failures = failures + check(coverage.complete() & coverage.demands() = 0 & coverage.unresolved() = 0,'complete empty intrinsic footprint removes only its duplicate unknown-read sentinel ' || mode || ': ' || coverage.reason())
  else if mode = 3 then do
    incoming = flow.componentat(opaque,'r',0,integer); literal = incoming.literal()
    failures = failures + check(incoming.known() & literal.kind() = 'I' & literal.index() = 17,'host-havoc negative starts with a defined live scalar')
    afterhost = flow.componentat(observed,'r',0,integer)
    failures = failures + check(afterhost.availability() = 'unknown' & afterhost.known() = 0 & coverage.complete() = 0 & coverage.unresolved(),'complete intrinsic footprint cannot restore facts after host callback havoc')
  end
  else do
    do i = 1 to coverage.demands()
      demand = coverage.demand(i)
      if demand.operation() = opaque & demand.ownedindex() = 1 then found = 1
    end
    failures = failures + check(coverage.complete() & found,'complete external footprint retains every explicit dirty typed observation')
  end
  if mode >= 2 then do
    failures = failures + check(flow.callbackpossibleat(opaque,callbackordinal),'intrinsic completeness never proves host callback absent ' || mode)
    failures = failures + check(flow.complete(source.procedureid('main'),'entry-normalization') = 0,'intrinsic completeness keeps unconditional callback veto ' || mode)
  end
  return failures

scopecountdemand: procedure = .int
  arg mode = 0
  failures = 0; ignored = .int; i = .int; integer = .int; found = .int; ambiguous = .int; expected = .int
  demand = .lltargetflow..entryread; domain = .lltargettransfer..domain; edge = .lltargetcfg..edge
