# Directly runnable focused lane; registered separately to bound nested cost.
cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER CLI FIXTURES WORK NATIVE_PAYLOAD_PLUGIN)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
include("${CMAKE_CURRENT_LIST_DIR}/signal-pair-helpers.cmake")
if(DEFINED CONSTRUCTED)
  execute_process(COMMAND "${VM}" "${CONSTRUCTED}" ${RUNTIME} -a guarded
    RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 180)
  if(NOT _status EQUAL 0 OR NOT _stdout MATCHES "SIGNAL_GUARDED[|]failures=0")
    message(FATAL_ERROR "Constructed guarded owner: ${_status}\n${_stdout}${_stderr}")
  endif()
endif()
file(READ "${FIXTURES}/io-signal-guarded-owner.rxas" _guarded_fixture)
foreach(_case normal fault known-normal known-fault alias-normal alias-fault code-fault message-fault metadata-fault)
  set(_original "${_guarded_fixture}")
  set(_input 0)
  if(_case MATCHES "fault$")
    set(_input 256)
    string(REPLACE "settp r3,0" "settp r3,256" _original "${_original}")
  endif()
  if(_case MATCHES "^known-")
    set(_input 3)
    if(_case STREQUAL "known-fault")
      set(_input 12)
    endif()
    string(REPLACE "getandtp r0,r3,256" "load r0,${_input}" _original "${_original}")
  endif()
  set(_result ${_input})
  set(_flag 0)
  set(_path 1)
  set(_event normal)
  set(_name preloaded-name)
  set(_code 55)
  set(_message preloaded-message)
  if(_case MATCHES "fault$")
    set(_result 99)
    set(_flag 1)
    set(_path 2)
    set(_event handler)
    set(_name OUT_OF_RANGE)
  endif()
  if(_case MATCHES "^alias-")
    string(REPLACE "call1 r1,checked_identity(),r0" "call1 r0,checked_identity(),r0" _original "${_original}")
    string(REPLACE "\"r\" 1 1 1 0 \"checked_identity\"" "\"r\" 0 1 1 0 \"checked_identity\"" _original "${_original}")
    string(REPLACE "itos r1\n  say r1" "itos r0\n  say r0" _original "${_original}")
    set(_result ${_input})
  endif()
  if(_case STREQUAL "code-fault")
    string(REPLACE "linkattr1 r6,r5,4\n  copy r8,r6" "linkattr1 r6,r5,1\n  copy r7,r6" _original "${_original}")
    set(_code 8)
    set(_name preloaded-name)
  elseif(_case STREQUAL "message-fault")
    string(REPLACE "linkattr1 r6,r5,4\n  copy r8,r6" "linkattr1 r6,r5,5\n  scopy r9,r6" _original "${_original}")
    set(_name preloaded-name)
    set(_message "")
  elseif(_case STREQUAL "metadata-fault")
    string(REPLACE "linkattr1 r5,r12,5\n" "linkattr1 r5,r12,5\n  .srcstep 4 4 17 \"guarded-owner.g\" 14 3 20 \"project saved name\"\n" _original "${_original}")
  endif()
  set(_expected "${_event}\n${_flag}\n${_input}\n${_result}\n${_path}\n${_code}\n${_name}\n${_message}\n77\n256")
  set(_source "${WORK}/guarded-${_case}.rxas")
  file(WRITE "${_source}" "${_original}")
  set(_product "${WORK}/guarded-${_case}-expanded.rxas")
  set(_options --no-cleanup)
  if(_case STREQUAL "known-normal")
    set(_options)
  endif()
  run_checked("expand guarded owner ${_case}" "${VM}" "${CLI}" ${RUNTIME} -a
    --module guarded.rxas --profile closed-main-default-halt.v1 --work 12000000
    ${_options} -o "${_product}" "${_source}")
  if(_case STREQUAL "known-normal" AND (NOT _last_stderr MATCHES "transport.exceptional.cfg.pending" OR NOT _last_stderr MATCHES "storage.exceptional.cfg.pending"))
    message(FATAL_ERROR "Guarded owner lost exceptional cleanup guards")
  endif()
  file(READ "${_product}" _expanded)
  if(_case STREQUAL "metadata-fault" AND NOT _expanded MATCHES "linkattr1 r5,r12,5\n[ \t]*[.]srcstep[^\n]*\"guarded-owner[.]g\"[^\n]*\"project saved name\"\n[ \t]*linkattr1 r6,r5,4")
    message(FATAL_ERROR "Guarded projection lost or moved its metadata address boundary")
  endif()
  expect_bound_policy("${_original}" "${_expanded}")
  string(FIND "${_expanded}" "checked_identity() .locals" _leaf)
  string(SUBSTRING "${_expanded}" 0 ${_leaf} _main)
  string(REGEX MATCHALL "copy r12,r4" _copies "${_main}")
  string(REGEX MATCHALL "null r12" _resets "${_main}")
  string(REGEX MATCHALL "linkattr1" _links "${_main}")
  string(REGEX MATCHALL "[.]traceevent \"F\"[^\n]*\"checked_identity\"" _traces "${_main}")
  list(LENGTH _copies _copy_count)
  list(LENGTH _resets _reset_count)
  list(LENGTH _links _link_count)
  list(LENGTH _traces _trace_count)
  if(NOT _main MATCHES "main[(][)] [.]locals=14" OR _main MATCHES "(^|\n)[ \t]*(call1|endlife|link)[ \t]"
      OR NOT _copy_count EQUAL 1 OR NOT _reset_count EQUAL 2 OR NOT _link_count EQUAL 2 OR NOT _trace_count EQUAL 1
      OR NOT _main MATCHES "joined:\n[ \t]*brf owner_closed,r13"
      OR NOT _main MATCHES "owner_closed:\n[ \t]*null r12\n[ \t]*null r4")
    message(FATAL_ERROR "Guarded owner changed frame, guard, capture, consumer or common resets")
  endif()
  bound_pair("guarded-${_case}" "${_original}" "${_expanded}" "${_expected}")
endforeach()

# An ordinary normal-path NULL has no attribute5. Force the normally skipped
# consumer only after transformation to independently check this oracle.
file(READ "${WORK}/guarded-known-normal.rxas" _original)
file(READ "${WORK}/guarded-known-normal-expanded.rxas" _expanded)
foreach(_kind original expanded)
  string(REPLACE "brf owner_closed,r13" "cnop" _injected "${_${_kind}}")
  set(_product "${WORK}/guarded-forced-empty-${_kind}")
  file(WRITE "${_product}.rxas" "${_injected}")
  run_checked("assemble forced empty owner ${_kind}" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
  execute_process(COMMAND "${VM}" "${_product}.rxbin" RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 15)
  if(NOT _status MATCHES "^[1-9][0-9]*$" OR NOT _stderr MATCHES "SIGNAL OUT_OF_RANGE[)]")
    message(FATAL_ERROR "Skipped empty owner was not a failing projection: ${_status}\n${_stdout}${_stderr}")
  endif()
endforeach()

# Deliver at original boundaries. A committed result stays committed and a
# prior SAY remains visible. The event owner is consumed only after the join.
file(READ "${WORK}/guarded-known-normal.rxas" _guarded_original)
file(READ "${WORK}/guarded-known-normal-expanded.rxas" _guarded_expanded)
foreach(_point entry before-commit after-commit after-observation)
  set(_original "${_guarded_original}")
  set(_expanded "${_guarded_expanded}")
  set(_signal "signal \"CANCEL\",\"guarded-message\"")
  set(_result 99)
  if(_point STREQUAL "entry")
    string(REPLACE "call1 r1,checked_identity(),r0" "${_signal}\ncall1 r1,checked_identity(),r0" _original "${_original}")
    string(REPLACE "cnop\n" "${_signal}\ncnop\n" _expanded "${_expanded}")
  elseif(_point STREQUAL "before-commit")
    string(REPLACE "ret a1" "${_signal}\nret a1" _original "${_original}")
    string(REPLACE "copy r1,r0" "${_signal}\ncopy r1,r0" _expanded "${_expanded}")
  elseif(_point STREQUAL "after-commit")
    set(_result 3)
    string(REPLACE "call1 r1,checked_identity(),r0" "call1 r1,checked_identity(),r0\n${_signal}" _original "${_original}")
    string(REPLACE "copy r1,r0" "copy r1,r0\n${_signal}" _expanded "${_expanded}")
  else()
    set(_result 3)
    string(REPLACE "say \"normal\"" "say \"normal\"\n${_signal}" _original "${_original}")
    string(REPLACE "say \"normal\"" "say \"normal\"\n${_signal}" _expanded "${_expanded}")
  endif()
  set(_expected "handler\n1\n3\n${_result}\n2\n55\nCANCEL\npreloaded-message\n77\n256")
  if(_point STREQUAL "after-observation")
    string(PREPEND _expected "normal\n")
  endif()
  bound_pair("guarded-pending-${_point}" "${_original}" "${_expanded}" "${_expected}")
endforeach()

# A nonempty message remains a string view and retains integer77/status256.
file(READ "${WORK}/guarded-message-fault.rxas" _original)
file(READ "${WORK}/guarded-message-fault-expanded.rxas" _expanded)
foreach(_kind original expanded)
  string(REPLACE "ichkrng a1,-5,5" "signal \"CANCEL\",\"nonempty\"\nichkrng a1,-5,5" _${_kind} "${_${_kind}}")
endforeach()
string(REPLACE "ichkrng r0,-5,5" "signal \"CANCEL\",\"nonempty\"\nichkrng r0,-5,5" _expanded "${_expanded}")
bound_pair("guarded-message-nonempty" "${_original}" "${_expanded}" "handler\n1\n256\n99\n2\n55\npreloaded-name\nnonempty\n77\n256")

# A second queued event overwrites delivery storage before any pop/capture.
set(_queue "sigcall guarded_pending(),\"OTHER\"\nsignal \"OTHER\"\n")
foreach(_kind original expanded)
  set(_${_kind} "${_guarded_${_kind}}")
  if(_kind STREQUAL "original")
    string(REPLACE "call1 r1,checked_identity(),r0" "${_queue}call1 r1,checked_identity(),r0" _${_kind} "${_${_kind}}")
  else()
    string(REPLACE "cnop\n" "${_queue}cnop\n" _${_kind} "${_${_kind}}")
  endif()
  string(REPLACE "caught:\n" "caught:\ncnop\n" _${_kind} "${_${_kind}}")
  string(APPEND _${_kind} "\nguarded_pending() .locals=0\nsignal \"ERROR\",\"first\"\nsignal \"CANCEL\",\"second\"\nret 0\n")
endforeach()
bound_pair("guarded-second-event" "${_original}" "${_expanded}" "handler\n1\n3\n99\n2\n55\nCANCEL\npreloaded-message\n77\n256")

# The saved diagnostic and nested/reference payload survive the join with
# their existing identity/lifetime rules. These probes are paired post-pass
# injection, never part of the admission proof.
file(READ "${WORK}/guarded-known-fault.rxas" _original)
file(READ "${WORK}/guarded-known-fault-expanded.rxas" _expanded)
set(_saved_origin "linkattr1 r5,r12,5\nlinkattr1 r6,r5,2\nicopy r10,r6\nunlink r6\nlinkattr1 r6,r5,3\nicopy r11,r6\nunlink r6\nunlink r5\nnull r6\nnull r5\ncall2 r10,observe_origin(),r10,r11\n")
foreach(_kind original expanded)
  string(REPLACE "brf owner_closed,r13\n" "brf owner_closed,r13\n${_saved_origin}" _${_kind} "${_${_kind}}")
  string(APPEND _${_kind} "${_observer}")
endforeach()
bound_pair("guarded-saved-origin" "${_original}" "${_expanded}" "handler\ncatchall.g\n8\n3\nassembler ichkrng value,-5,5\n1\n12\n99\n2\n55\nOUT_OF_RANGE\npreloaded-message\n77\n256")

set(_payload "setattrs r10,2\nlinkattr1 r11,r10,1\nload r11,42\nunlink r11\nlinkattr1 r5,r10,1\nmkref r6,r5\nlinkattr1 r11,r10,2\ncopy r11,r6\nunlink r11\nunlink r5\nnull r6\nsignal \"CANCEL\",r10\n")
set(_reference_probe "linkattr1 r5,r12,5\nlinkattr1 r6,r5,5\nlinkattr1 r11,r6,2\nrefvalid r7,r11\nitos r7\nsay r7\nlinkattr1 r4,r10,2\nrefsame r7,r11,r4\nitos r7\nsay r7\nunlink r4\nnull r10\nrefvalid r7,r11\nitos r7\nsay r7\nunlink r11\nlinkattr1 r11,r6,1\nicopy r7,r11\nitos r7\nsay r7\nunlink r11\nlinkattr1 r11,r6,2\nrefvalid r7,r11\nitos r7\nsay r7\nunlink r11\nunlink r6\nunlink r5\nnull r11\nnull r6\nnull r5\nload r7,55\n")
foreach(_kind original expanded)
  set(_${_kind} "${_guarded_${_kind}}")
  if(_kind STREQUAL "original")
    string(REPLACE "call1 r1,checked_identity(),r0" "${_payload}call1 r1,checked_identity(),r0" _${_kind} "${_${_kind}}")
  else()
    string(REPLACE "cnop\n" "${_payload}cnop\n" _${_kind} "${_${_kind}}")
  endif()
  string(REPLACE "brf owner_closed,r13\n" "brf owner_closed,r13\n${_reference_probe}" _${_kind} "${_${_kind}}")
endforeach()
bound_pair("guarded-reference-owner" "${_original}" "${_expanded}" "handler\n1\n1\n0\n42\n0\n1\n3\n99\n2\n55\nCANCEL\npreloaded-message\n77\n256")

# Reuse the RXPA fixture's existing native-payload counters. The fresh counted
# CALL window r14/r15 is disjoint from flag13, event4, saved12 and linked r5/r6.
set(_native_imports "payload_reset() .expose=rxpatests.native_payload_reset\npayload_make() .expose=rxpatests.native_payload_make\npayload_id() .expose=rxpatests.native_payload_id\npayload_copies() .expose=rxpatests.native_payload_copies\npayload_finalizers() .expose=rxpatests.native_payload_finalizers\n")
set(_native_source "call payload_reset()\nload r14,1\nload r15,77\ncall r10,payload_make(),r14\nsignal \"CANCEL\",r10\n")
set(_native_capture "call r7,payload_copies()\ncall r3,payload_finalizers()\ncopy r12,r4\ncall r11,payload_copies()\nisub r11,r11,r7\nitos r11\nsay r11\ncall r11,payload_finalizers()\nisub r11,r11,r3\nitos r11\nsay r11\nendlife r4\ncall r11,payload_finalizers()\nisub r11,r11,r3\nitos r11\nsay r11\nnull r4\ncall r11,payload_finalizers()\nisub r11,r11,r3\nitos r11\nsay r11\nload r7,55\n")
set(_native_probe "linkattr1 r5,r12,5\nlinkattr1 r6,r5,5\nload r14,1\nlink r15,r6\ncall r11,payload_id(),r14\nunlink r15\nitos r11\nsay r11\nunlink r6\nunlink r5\nnull r6\nnull r5\n")
set(_native_release "null r12\ncall r11,payload_finalizers()\nisub r11,r11,r3\nitos r11\nsay r11\nnull r10\ncall r11,payload_finalizers()\nisub r11,r11,r3\nitos r11\nsay r11\n")
foreach(_kind original expanded)
  set(_injected "${_guarded_${_kind}}")
  string(REPLACE "main() .locals=14" "${_native_imports}main() .locals=16" _injected "${_injected}")
  if(_kind STREQUAL "original")
    string(REPLACE "call1 r1,checked_identity(),r0" "${_native_source}call1 r1,checked_identity(),r0" _injected "${_injected}")
  else()
    string(REPLACE "cnop\n" "${_native_source}cnop\n" _injected "${_injected}")
  endif()
  string(REGEX REPLACE "copy r12,r4\n[ \t]*null r4\n" "${_native_capture}" _injected "${_injected}")
  string(REPLACE "brf owner_closed,r13\n" "brf owner_closed,r13\n${_native_probe}" _injected "${_injected}")
  string(REGEX REPLACE "owner_closed:\n[ \t]*null r12\n" "owner_closed:\n${_native_release}" _injected "${_injected}")
  set(_product "${WORK}/guarded-native-${_kind}")
  file(WRITE "${_product}.rxas" "${_injected}")
  run_checked("assemble guarded native owner ${_kind}" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
  run_checked("execute guarded native owner ${_kind}" "${VM}" "${_product}.rxbin" "${NATIVE_PAYLOAD_PLUGIN}")
  expect_output("handler\n1\n0\n0\n1\n77\n2\n3\n1\n3\n99\n2\n55\nCANCEL\npreloaded-message\n77\n256")
endforeach()

foreach(_case flag-reset flag-initial flag-commit extra-flag wrong-guard alias early-reset missing-saved missing-event escape alternate)
  set(_source "${_guarded_fixture}")
  set(_reason signal.owner.guard.pending)
  if(_case STREQUAL "flag-reset")
    string(REPLACE "  null r13\n" "" _source "${_source}")
    set(_reason signal.owner.state.unproved)
  elseif(_case STREQUAL "flag-initial")
    string(REPLACE "load r13,0" "load r13,1" _source "${_source}")
    set(_reason signal.owner.state.unproved)
  elseif(_case STREQUAL "flag-commit")
    string(REPLACE "load r13,1" "load r13,2" _source "${_source}")
    set(_reason signal.owner.state.unproved)
  elseif(_case STREQUAL "extra-flag")
    string(REPLACE "load r13,0" "load r13,0\nload r13,0" _source "${_source}")
  elseif(_case STREQUAL "wrong-guard")
    string(REPLACE "brf owner_closed,r13" "brt owner_closed,r13" _source "${_source}")
  elseif(_case STREQUAL "alias")
    string(REPLACE "r13" "r0" _source "${_source}")
    set(_reason signal.owner.mapping.pending)
  elseif(_case STREQUAL "early-reset")
    string(REPLACE "joined:\n" "joined:\nnull r12\n" _source "${_source}")
  elseif(_case STREQUAL "missing-saved")
    string(REPLACE "owner_closed:\n  null r12" "owner_closed:" _source "${_source}")
    set(_reason signal.owner.cleanup.pending)
  elseif(_case STREQUAL "missing-event")
    string(REPLACE "owner_closed:\n  null r12\n  null r4" "owner_closed:\n  null r12" _source "${_source}")
    set(_reason signal.owner.cleanup.pending)
  elseif(_case STREQUAL "escape")
    string(REPLACE "  itos r13" "  copy r10,r12\n  itos r13" _source "${_source}")
    set(_reason signal.owner.consumer.pending)
  else()
    string(REPLACE "  null r5\nowner_closed:" "  null r5\n  br joined\nowner_closed:" _source "${_source}")
    set(_reason signal.named.join.pending)
  endif()
  bound_keep("guarded-${_case}" "${_source}" "${_reason}")
  if(_case STREQUAL "missing-saved")
    bound_pair("guarded-retained-closure" "${_source}" "${_bound_kept}" "normal\n0\n0\n0\n1\n55\npreloaded-name\npreloaded-message\n77\n256")
  endif()
endforeach()
set(_published "${WORK}/guarded-known-normal-expanded.rxas")
file(READ "${_published}" _good)
execute_process(COMMAND "${VM}" "${CLI}" ${RUNTIME} -a --module guarded.rxas
  --profile closed-main-default-halt.v1 --work 1 -o "${_published}" "${WORK}/guarded-known-normal.rxas"
  RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
file(READ "${_published}" _after)
if(_status EQUAL 0 OR NOT _after STREQUAL _good OR NOT _stderr MATCHES "LL_INLINE_LIMIT")
  message(FATAL_ERROR "Guarded-owner refusal changed last-good output")
endif()
file(REMOVE_RECURSE "${WORK}")
message("RXAS_GUARDED_OWNER|failures=0")
