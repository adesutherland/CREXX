/* cREXX License (MIT). Canonical signal destinations and physical returns. */
options levelb
import rxfnsb
import llir
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetflow
import llrxascatalog

check: procedure = .int
  arg condition = .int, message = .string
  if condition then return 0
  say 'FAIL:' message
  return 1
one: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, value = .lltarget..operand, at = .llir..origin
  fields = .object[]; fields[1] = value as .object
  return body.emit(name,fields,at)
label: procedure = .int
  arg body = .lltarget..bodydraft, name = .string, at = .llir..origin
  fields = .object[]; fields[1] = .lltarget..operand.symbol(name) as .object
  return body.record('label',fields,at)

/** Intrinsic NONE does not exclude callback-caused control. The fixed getter
 * control and authored operational profiles keep their separate premises. */
callbackcontrol: procedure = .int
  arg mode = .int
  failures = 0; ignored = .int; i = .int; integer = .int; synchronous = .int; asynchronous = .int; intrinsic = .int; supplied = .int; residual = .int; unknownpolicy = .int; skippossible = .int; haltpossible = .int; closedcallback = .int
  nativepayload = .int; referencepayload = .int; attributes = .int; exceptionalchecked = .int; possible = .int
  produced = .int; following = .int; handler = .int; operand = .int; resultref = .int; sourceref = .int; destination = .int
  item = .lltarget..record
  binding = .lltargetflow..storagefact
  row = .lltargetcfg..edge; action = .lltargettransfer..action; domain = .lltargettransfer..domain; instruction = .lltargettransfer..instruction
  catalog = .llrxascatalog..catalog(); draft = .lltarget..draft('callback.control.' || mode,'fixture:callback.control',0)
  at = draft.synthetic('operation callback paths are separate from intrinsic and ambient signals')
  body = draft.procedure('main',2,at); fields = .object[]; empty = .object[]
  ignored = one(body,'getnumdgts',body.reg('r',0),at)
  fields[1] = body.reg('r',0) as .object; fields[2] = .lltarget..operand.integer(7) as .object
  if mode = 1 then produced = one(body,'call',.lltarget..operand.procedure('leaf'),at)
  else if mode = 2 then produced = one(body,'getnumdgts',body.reg('r',0),at)
  else if mode = 5 then produced = one(body,'sayx',.lltarget..operand.string('callback' as .binary),at)
  else if mode = 4 then do
    fields[1] = .lltarget..operand.symbol('handler') as .object; fields[2] = body.reg('r',0) as .object
    fields[3] = .lltarget..operand.integer(7) as .object; produced = body.emit('beq',fields,at)
  end
  else produced = body.emit('load',fields,at)
  call objectarraydrop fields; fields[1] = body.reg('r',1) as .object; fields[2] = body.reg('r',0) as .object
  fields[3] = .lltarget..operand.integer(0) as .object; following = body.emit('iadd',fields,at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at); handler = label(body,'handler',at)
  ignored = one(body,'ret',.lltarget..operand.integer(1),at)
  leaf = draft.procedure('leaf',0,at); ignored = leaf.emit('ret',empty,at)
  target = draft.finish(); failures = failures + check(target.valid(),'callback control source validates ' || mode)
  if target.valid() = 0 then do; say target.error(); return failures; end
  profile = .lltargettransfer..profile
  if mode < 3 | mode = 5 then profile = .lltargettransfer..profile.closedmain(reference target,target.procedureid('main'),'closed-main-default-halt.v1')
  else do
    premise = .lltargettransfer..profiledraft(reference target,'independent.callback.control.' || mode)
    integer = premise.domain('component','fixture.callback.integer',catalog.componentmask('I'))
    do i = 1 to target.records()
      item = target.record(i)
      if item.kind() = 'procedure' then iterate
      ignored = premise.operation(item.id()); ignored = premise.relocation(item.id(),'none')
      if item.id() = produced then do
        operand = 1; if mode = 4 then operand = 2
        resultref = premise.ref(produced,operand)
        if mode = 4 then ignored = premise.event(produced,'callback',0,0,'none',0,.lltarget..operand(),'may','all','unknown','fixture.callback')
        ignored = premise.event(produced,'write',resultref,integer,'literal',0,.lltarget..operand.integer(7))
        if mode = 4 then do
          destination = premise.ref(produced,1,'label','symbolic')
          ignored = premise.event(produced,'edge',destination,0,'none',0,.lltarget..operand(),'must','all','before','handler')
        end
      end
      else if item.id() = following then do
        resultref = premise.ref(following,1); sourceref = premise.ref(following,2)
        ignored = premise.event(following,'observe',sourceref,integer)
        ignored = premise.event(following,'write',resultref,integer)
      end
      else if item.kind() = 'instruction' then do; if item.mnemonic() = 'ret' then ignored = premise.event(item.id(),'return',0,0); end
    end
    profile = premise.finish()
  end
  cfg = .lltargetcfg..graph(reference target,reference profile)
  failures = failures + check(cfg.status() = 'ok','callback control CFG builds ' || mode)
  if cfg.status() <> 'ok' then do; say cfg.message(); return failures; end
  item = target.at(produced)
  do i = 1 to cfg.outedges(produced)
    row = cfg.outedge(produced,i)
    if row.asynchronous() then do; if row.phase() = 'after' then asynchronous = 1; end
    else do
      if row.phase() = 'unknown' then synchronous = 1
      if row.boundarykind() = 'callback-policy' & row.complete() = 0 then unknownpolicy = 1
      if row.boundarykind() = 'closed-main-default-halt' & row.boundaryid() = produced || '.callback.sync.unknown' then closedcallback = 1
      if row.role() = 'skip' & row.phase() = 'unknown' then skippossible = 1
      if row.boundarykind() = 'callback-policy-halt' & row.role() = 'terminal' then haltpossible = 1
      if catalog.signalstate(item.opcode()) <> 0 & row.phase() = word('none before after partial unknown',catalog.signalphase(item.opcode()) + 1) then intrinsic = 1
      if row.role() = 'handler' & row.targetop() = handler & row.phase() = 'before' then supplied = 1
    end
  end
  if mode = 0 then do
    failures = failures + check(catalog.signalstate(item.opcode()) = 0 & catalog.callbackobligations(item.opcode()) = 0 & synchronous = 0 & asynchronous,'LOAD with intrinsic NONE keeps ambient control without a destination cleanup callback')
    failures = failures + check(closedcallback = 0 & unknownpolicy = 0 & skippossible = 0 & haltpossible = 0,'cleanup-only scalar setter adds no synchronous callback or policy alternative')
  end
  if mode = 1 then failures = failures + check(unknownpolicy = 0 & skippossible = 0 & haltpossible = 0 & closedcallback & cfg.localcomplete(target.procedureid('main')) & cfg.exceptionalcomplete(target.procedureid('main')),'ordinary bytecode child restores the suspended handler table independently of call-closure membership')
  if mode = 5 then do
    failures = failures + check(catalog.callbackobligations(item.opcode()) = catalog.callbackmask('host') & catalog.callbackpreservessignalpolicy(item.opcode()) & catalog.callbacknormalpreservesframe(item.opcode()),'bytes-output callback keeps host and value obligations despite frame preservation')
    failures = failures + check(closedcallback & unknownpolicy = 0 & skippossible = 0 & haltpossible = 0 & synchronous & asynchronous,'bytes-output callback queues signals through the preserved inherited policy without inventing local handlers')
  end
  if mode = 1 then do
    failures = failures + check(synchronous & intrinsic & asynchronous,'no-result CALL keeps raw intrinsic phase plus distinct callback phase and ambient async')
    instruction = profile.instruction(produced)
    do i = 1 to instruction.actions()
      action = instruction.action(i)
      if action.kind() = 'callback' & action.detail() = 'catalog.callback.call-frame' then residual = 1
    end
    failures = failures + check(residual = 0,'same-owner no-result CALL has no prior-frame recycler hook')
  end
  if mode = 2 then failures = failures + check(catalog.callbackobligations(item.opcode()) = 0 & catalog.signalstate(item.opcode()) = 0 & synchronous = 0 & asynchronous,'reviewed raw getter has no operation callback edge and keeps ambient async')
  if mode = 3 then failures = failures + check(catalog.callbackobligations(item.opcode()) = 0 & synchronous = 0 & asynchronous = 0,'constructed callback-free premise and canonical cleanup-only setter add no callback')
  if mode = 4 then failures = failures + check(supplied & synchronous = 0 & asynchronous = 0,'constructed callback keeps only its explicit before-phase handler edge')
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','callback control flow builds ' || mode)
  if flow.status() <> 'ok' then do; say flow.reason(); return failures; end
  do i = 1 to profile.domains()
    domain = profile.domain(i)
    if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('I') then integer = i
    if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('native-payload') then nativepayload = i
    if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('reference') then referencepayload = i
    if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('attribute-count') then attributes = i
  end
  value = flow.componentat(following,'r',0,integer)
  if mode = 0 then do
    literal = value.literal()
    failures = failures + check(value.availability() = 'defined' & value.known() & literal.kind() = 'I' & literal.index() = 7,'licensed normal setter postwrite recovers its captured integer')
    resource = flow.componentat(following,'r',0,nativepayload)
    referencevalue = flow.componentat(following,'r',0,referencepayload); treevalue = flow.componentat(following,'r',0,attributes)
    failures = failures + check(resource.presence() = 'absent' & referencevalue.presence() = 'absent' & treevalue.presence() = 'unknown','sequential scalar setters clear direct payloads while preserving unknown inherited attributes')
    binding = flow.storageat(following,'r',0)
    instruction = profile.instruction(produced)
    do i = 1 to instruction.actions()
      action = instruction.action(i)
      if action.kind() = 'callback' then possible = possible | flow.callbackpossibleat(produced,i)
    end
    failures = failures + check(possible = 0 & flow.complete(target.procedureid('main'),'entry-observation'),'retired prior frame contributes no setter finalizer and the explicit GETNUMDGTS/LOAD sequence has complete entry observation: callback=' || possible || '/complete=' || flow.complete(target.procedureid('main'),'entry-observation'))
    do i = 1 to cfg.outedges(produced)
      row = cfg.outedge(produced,i)
      if row.asynchronous() | row.phase() <> 'unknown' then iterate
      exceptionalvalue = flow.componenton(row.id(),'r',0,integer)
      failures = failures + check(exceptionalvalue.known() = 0,'exceptional callback checkpoint cannot borrow the successful normal postwrite')
      exceptionalchecked = 1
    end
    failures = failures + check(exceptionalchecked = 0,'normal setter has no invented exceptional cleanup callback path')
  end
  else if mode = 4 | mode = 5 then failures = failures + check(value.availability() = 'unknown' & value.known() = 0,'host or independently authored callback retains its scalar havoc ' || mode)
  else failures = failures + check(value.availability() = 'defined','isolated local call or callback-free operation retains its defined scalar ' || mode || ': ' || value.availability() || '/' || value.reason())
  if mode = 4 | mode = 5 then do
    binding = flow.storageat(following,'r',0)
    if mode = 4 then failures = failures + check(binding.active() = 0,'independently authored callback cannot borrow canonical pointer preservation')
    else failures = failures + check(binding.active() > 0,'reviewed bytes-output callback preserves the suspended pointer table')
  end
  if mode = 3 | mode = 4 then do
    coverage = flow.entrycoverage(target.procedureid('main'))
    if mode = 3 then failures = failures + check(coverage.complete(),'callback-free resumed body keeps complete read coverage')
    else failures = failures + check(coverage.complete() = 0 & coverage.unresolved(),'explicit callback before a resumed read retains its unresolved entry demand')
  end
  if mode = 5 then do
    raw = .lltargettransfer..profile(reference target); rawcfg = .lltargetcfg..graph(reference target,reference raw)
    resumed = 0; outward = 0; distinct = 0; firstboundary = ''
    do i = 1 to rawcfg.outedges(produced)
      row = rawcfg.outedge(produced,i)
      if row.asynchronous() | row.phase() <> 'unknown' then iterate
      if row.role() = 'resumed' & row.targetop() = following then resumed = 1
      if row.boundarykind() = 'inherited-signal-policy' & row.complete() = 0 then do
        outward = 1
        if firstboundary = '' then firstboundary = row.boundaryid()
        else if firstboundary <> row.boundaryid() then distinct = 1
      end
    end
    failures = failures + check(resumed & outward,'raw callback control keeps returning inherited handlers and unknown outward departure')
    if mode = 5 then failures = failures + check(catalog.signalstate(item.opcode()) <> 0 & catalog.signalphase(item.opcode()) = 4 & distinct,'intrinsic UNKNOWN and callback UNKNOWN retain distinct boundary identities at the same operation')
    limited = .lltargetcfg..graph(reference target,reference profile,1,1)
    failures = failures + check(limited.status() = 'limit','callback control stays within the shared CFG allowance')
  end
  return failures

/** Signal causes at one checkpoint share instruction work, not the state or
 * ABI effects of their distinct outgoing edges. Different phases stay apart. */
checkpointreplays: procedure = .int
  failures = 0; ignored = .int; i = .int; j = .int; integer = .int
  initial = .int; produced = .int; handler = .int; destination = .int; resultref = .int
  beforecount = 0; aftercount = 0; uncertaincount = 0
  item = .lltarget..record; edge = .lltargetcfg..edge
  draft = .lltarget..draft('checkpoint.replays','fixture:checkpoint.replays',0)
  at = draft.synthetic('same-source phase checkpoints with independent signal causes')
  body = draft.procedure('main',1,at); fields = .object[]
  fields[1] = body.reg('r',0) as .object; fields[2] = .lltarget..operand.integer(7) as .object
  initial = body.emit('load',fields,at)
  fields[1] = .lltarget..operand.symbol('handler') as .object; fields[2] = body.reg('r',0) as .object
  fields[3] = .lltarget..operand.integer(99) as .object; produced = body.emit('beq',fields,at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  handler = label(body,'handler',at); ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  target = draft.finish(); failures = failures + check(target.valid(),'multi-edge checkpoint source validates')
  if target.valid() = 0 then do; say target.error(); return failures; end
  catalog = .llrxascatalog..catalog(); premise = .lltargettransfer..profiledraft(reference target,'independent.checkpoint.replays')
  integer = premise.domain('component','fixture.checkpoint.integer',catalog.componentmask('I'))
  do i = 1 to target.records()
    item = target.record(i)
    if item.kind() = 'procedure' then iterate
    ignored = premise.operation(item.id()); ignored = premise.relocation(item.id(),'none')
    if item.id() = initial then do
      resultref = premise.ref(initial,1)
      ignored = premise.event(initial,'write',resultref,integer,'literal',0,.lltarget..operand.integer(7))
    end
    else if item.id() = produced then do
      resultref = premise.ref(produced,2)
      ignored = premise.event(produced,'write',resultref,integer,'literal',0,.lltarget..operand.integer(99),'must','all','after')
      destination = premise.ref(produced,1,'label','symbolic')
      do j = 1 to 48
        phase = word('before after partial unknown',((j - 1) % 4) + 1)
        ignored = premise.event(produced,'edge',destination,0,'literal',0,.lltarget..operand.string(('CHECKPOINT.' || j) as .binary),'must','all',phase,'handler')
      end
    end
    else if item.kind() = 'instruction' then ignored = premise.event(item.id(),'return',0,0)
  end
  profile = premise.finish(); cfg = .lltargetcfg..graph(reference target,reference profile)
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg,40000)
  failures = failures + check(flow.status() = 'ok','48 same-source signal alternatives reuse four checkpoints within a bounded allowance')
  if flow.status() <> 'ok' then do; say flow.reason(); return failures; end
  do i = 1 to cfg.outedges(produced)
    edge = cfg.outedge(produced,i)
    if edge.role() <> 'handler' then iterate
    failures = failures + check(edge.targetop() = handler,'cached checkpoint retains its exact edge destination')
    value = flow.componenton(edge.id(),'r',0,integer); literal = value.literal()
    if edge.phase() = 'before' then do
      beforecount = beforecount + 1
      failures = failures + check(value.known() & literal.kind() = 'I' & literal.index() = 7,'same-phase before edges retain the prewrite checkpoint')
    end
    else if edge.phase() = 'after' then do
      aftercount = aftercount + 1
      failures = failures + check(value.known() & literal.kind() = 'I' & literal.index() = 99,'same-phase after edges retain the postwrite checkpoint')
    end
    else do
      uncertaincount = uncertaincount + 1
      failures = failures + check(value.availability() = 'defined' & value.known() = 0,'partial and unknown checkpoints cannot borrow an exact before/after value')
    end
  end
  failures = failures + check(beforecount = 12 & aftercount = 12 & uncertaincount = 24,'every named same-phase and distinct-phase signal edge remains present')
  return failures

/** Explicit same/different postwrites meet above unknown pointee defaults. */
postwritediamond: procedure = .int
  arg different = .int
  failures = 0; ignored = .int; i = .int; integer = .int
  draft = .lltarget..draft('postwrite.diamond.' || different,'fixture:postwrite.diamond',0)
  at = draft.synthetic('normal resource callback facts survive only an exact path meet')
  body = draft.procedure('main',2,at); fields = .object[]
  ignored = one(body,'getnumdgts',body.reg('r',1),at)
  fields[1] = .lltarget..operand.symbol('left') as .object; fields[2] = body.reg('r',1) as .object
  ignored = body.emit('brt',fields,at)
  fields[1] = body.reg('r',0) as .object; fields[2] = .lltarget..operand.integer(7 + different) as .object
  ignored = body.emit('load',fields,at); ignored = one(body,'br',.lltarget..operand.symbol('joined'),at)
  ignored = label(body,'left',at)
  fields[2] = .lltarget..operand.integer(7) as .object; ignored = body.emit('load',fields,at)
  ignored = label(body,'joined',at)
  fields[1] = body.reg('r',0) as .object; fields[2] = .lltarget..operand.integer(1) as .object
  fields[3] = .lltarget..operand.integer(20) as .object; observed = body.emit('ichkrng',fields,at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  target = draft.finish(); failures = failures + check(target.valid(),'postwrite diamond source validates ' || different)
  if target.valid() = 0 then do; say target.error(); return failures; end
  profile = .lltargettransfer..profile.closedmain(reference target,target.procedureid('main'),'closed-main-default-halt.v1')
  cfg = .lltargetcfg..graph(reference target,reference profile); flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','postwrite diamond flow builds ' || different)
  if flow.status() <> 'ok' then do; say flow.reason(); return failures; end
  catalog = .llrxascatalog..catalog()
  do i = 1 to profile.domains()
    domain = profile.domain(i)
    if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('I') then integer = i
  end
  value = flow.componentat(observed,'r',0,integer); literal = value.literal(); binding = flow.storageat(observed,'r',0)
  failures = failures + check(value.availability() = 'defined' & binding.active() > 0,'normal diamond keeps definedness and checked pointer identity over unknown defaults ' || different)
  if different then failures = failures + check(value.known() = 0,'different normal postwrites do not donate either branch literal')
  else failures = failures + check(value.known() & literal.kind() = 'I' & literal.index() = 7,'equal normal postwrites retain their exact literal at a diamond')
  coverage = flow.entrycoverage(target.procedureid('main'))
  failures = failures + check(coverage.complete() & coverage.demands() = 0,'normal postwrite diamond has no invented dirty read while callbacks remain observable ' || different)
  return failures

/** Deferred terminal ABI uncertainty preserves earlier body-read witnesses;
 * raw parent/result obligations still require an exact invocation separately. */
departureobservations: procedure = .int
  arg dirty = .int
  failures = 0; ignored = .int; i = .int; observed = .int; found = .int
  draft = .lltarget..draft('departure.observations.' || dirty,'fixture:departure.observations',0)
  at = draft.synthetic('terminal ABI does not retroactively obscure body reads')
  body = draft.procedure('main',1,at); fields = .object[]
  if dirty then do
    fields[1] = body.reg('r',0) as .object
    fields[2] = .lltarget..operand.integer(1) as .object; fields[3] = .lltarget..operand.integer(2) as .object
    observed = body.emit('ichkrng',fields,at)
  end
  returned = one(body,'ret',.lltarget..operand.integer(0),at)
  target = draft.finish(); failures = failures + check(target.valid(),'terminal observation source validates ' || dirty)
  if target.valid() = 0 then do; say target.error(); return failures; end
  profile = .lltargettransfer..profile.closedmain(reference target,target.procedureid('main'),'closed-main-default-halt.v1')
  cfg = .lltargetcfg..graph(reference target,reference profile); flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','terminal observation flow builds ' || dirty)
  if flow.status() <> 'ok' then do; say flow.reason(); return failures; end
  coverage = flow.entrycoverage(target.procedureid('main')); raw = flow.abicallbackat(returned)
  failures = failures + check(coverage.complete() & flow.complete(target.procedureid('main'),'entry-normalization'),'terminal parent/result uncertainty does not invalidate body coverage ' || dirty)
  failures = failures + check(raw.possible() & raw.reason() = 'target.abi.root.copyback.unproved','unknown physical root retains its separate external copyback obligation ' || dirty)
  do i = 1 to coverage.demands()
    demand = coverage.demand(i)
    if demand.operation() = observed & demand.ownedindex() = 0 then found = 1
  end
  if dirty then failures = failures + check(found,'dirty owned read before RETURN remains an exact required clear demand')
  else failures = failures + check(coverage.demands() = 0,'read-free body has no invented dirty entry demand')
  return failures

bcopycontrol: procedure = .int
  failures = 0; i = .int; ignored = .int; possible = .int; callbacks = .int; residual = .int
  draft = .lltarget..draft('bcopy.resource.control','fixture:bcopy.resource.control',0)
  at = draft.synthetic('resource-only does not mean resource callbacks are absent')
  body = draft.procedure('main',2,at); fields = .object[]
  fields[1] = body.reg('r',1) as .object; fields[2] = body.reg('r',0) as .object
  copied = body.emit('bcopy',fields,at); ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  target = draft.finish(); failures = failures + check(target.valid(),'unknown-resource BCOPY source validates')
  if target.valid() = 0 then do; say target.error(); return failures; end
  profile = .lltargettransfer..profile.closedmain(reference target,target.procedureid('main'),'closed-main-default-halt.v1')
  cfg = .lltargetcfg..graph(reference target,reference profile); flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','resource-only BCOPY flow builds')
  if flow.status() <> 'ok' then do; say flow.reason(); return failures; end
  row = profile.instruction(copied)
  do i = 1 to row.actions()
    action = row.action(i)
    if action.kind() <> 'callback' then iterate
    callbacks = callbacks + 1; possible = possible | flow.callbackpossibleat(copied,i)
    if left(action.detail(),26) = 'catalog.callback.residual.' then residual = 1
  end
  failures = failures + check(cfg.localcomplete(target.procedureid('main')) & profile.callbackpolicyunknown(copied) = 0,'resource inventory closes structural policy destinations')
  failures = failures + check(callbacks > 0 & possible & residual = 0,'unknown binary source/destination keep possible resource hooks without an unknown inventory route')
  return failures

/** Private child backing cannot certify an unknown external caller result.
 * No root freshness or caller-result resource absence is supplied here. */
callcauses: procedure = .int
  failures = 0; i = .int; j = .int; ignored = .int; allocation = 0; allocationedge = 0
  action = .lltargettransfer..action
  draft = .lltarget..draft('typed.call.causes','fixture:typed.call.causes',0)
  at = draft.synthetic('local target discharges only its own ingress conditions')
  body = draft.procedure('main',3,at); fields = .object[]
  fields[1] = body.reg('r',0) as .object; fields[2] = .lltarget..operand.integer(7) as .object
  ignored = body.emit('load',fields,at)
  fields[1] = body.reg('r',1) as .object; fields[2] = .lltarget..operand.procedure('middle') as .object; fields[3] = body.reg('r',0) as .object
  outercall = body.emit('call1',fields,at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  body = draft.procedure('middle',1,at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.integer(1) as .object; fields[2] = .lltarget..operand.integer(1) as .object
  fields[3] = .lltarget..operand.integer(0) as .object; fields[4] = .lltarget..operand.string('caller.rexx' as .binary) as .object
  fields[5] = .lltarget..operand.integer(7) as .object; fields[6] = .lltarget..operand.integer(1) as .object
  fields[7] = .lltarget..operand.integer(19) as .object; fields[8] = .lltarget..operand.string('call leaf(value)' as .binary) as .object
  ignored = body.record('.srcstep',fields,at); call objectarraydrop fields
  fields[1] = body.reg('r',0) as .object; fields[2] = .lltarget..operand.procedure('leaf') as .object; fields[3] = body.reg('a',1) as .object
  innercall = body.emit('call1',fields,at); ignored = one(body,'ret',body.reg('r',0),at)
  body = draft.procedure('leaf',1,at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.integer(3) as .object; fields[2] = .lltarget..operand.integer(0) as .object
  fields[3] = .lltarget..operand.string('logical.provider' as .binary) as .object; fields[4] = .lltarget..operand.string('inner' as .binary) as .object
  fields[5] = .lltarget..operand.integer(0) as .object; ignored = body.record('.inlineframe',fields,at)
  ignored = label(body,'inner.begin',at); call objectarraydrop fields
  fields[1] = body.reg('r',0) as .object; fields[2] = body.reg('a',1) as .object; fields[3] = .lltarget..operand.integer(1) as .object
  ignored = body.emit('iadd',fields,at); ignored = label(body,'inner.after',at); ignored = one(body,'ret',.lltarget..operand.integer(8),at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.symbol('inner.begin') as .object; fields[2] = .lltarget..operand.symbol('inner.after') as .object
  fields[3] = .lltarget..operand.integer(3) as .object; ignored = body.record('.inlinemap',fields,at)
  target = draft.finish(); failures = failures + check(target.valid(),'typed local CALL cause source validates')
  if target.valid() = 0 then do; say target.error(); return failures; end
  profile = .lltargettransfer..profile.closedcalls(reference target,target.procedureid('main'),'closed-main-default-halt.v1')
  cfg = .lltargetcfg..graph(reference target,reference profile); catalog = .llrxascatalog..catalog()
  failures = failures + check(cfg.status() = 'ok','typed local CALL cause graph builds')
  if cfg.status() <> 'ok' then do; say cfg.message(); return failures; end
  item = target.at(innercall); absent = 0; framehook = 0; sync = 0; named = 0; aggregate = 0; callbacks = 0
  resources = catalog.callbackmask('output'); bit = catalog.callbackmask('capacity'); assembler ior resources,resources,bit
  do i = 1 to catalog.callcauses(item.opcode())
    cause = profile.callcause(innercall,i)
    if cause.kind() = 'frame-allocation' then allocation = i
    if wordpos(cause.kind(),'target target-kind initializer') > 0 then do
      if cause.status() = 'proved' & cause.possible() = 0 then absent = absent + 1
    end
    if cause.kind() = 'frame-callback' then framehook = cause.possible() & cause.status() = 'unknown' & cause.callbacks() = resources
    if cause.kind() = 'context-sync' then sync = 1
  end
  do i = 1 to cfg.outedges(innercall)
    edge = cfg.outedge(innercall,i)
    if allocation > 0 & pos('.call-cause.' || allocation || '.sync.',edge.boundaryid()) > 0 & edge.signalname() = 'FAILURE' then allocationedge = allocationedge + 1
    if pos('.call-cause.',edge.boundaryid()) > 0 & edge.signalname() = 'FAILURE' then named = named + 1
    if edge.signalname() = '*' & edge.phase() = 'partial' & pos('.call-cause.',edge.boundaryid()) = 0 then aggregate = 1
  end
  row = profile.instruction(innercall)
  do i = 1 to row.actions()
    action = row.action(i)
    if action.kind() = 'callback' & action.detail() = 'catalog.callback.call-frame' then callbacks = callbacks + 1
  end
  failures = failures + check(absent = 3 & framehook = 0 & sync = 0,'local target/kind/initializer are exact and value-only synchronization adds no callback cause: absent=' || absent || '/frame=' || framehook || '/sync=' || sync)
  failures = failures + check(named >= 2 & aggregate & profile.callcausescomplete(innercall) = 0,'named layout/allocation FAILURE rows supplement the retained aggregate wildcard')
  failures = failures + check(allocation > 0 & allocationedge > 0,'retained real child preserves its exact allocation FAILURE producer independently of captured resources')
  failures = failures + check(callbacks = 0 & profile.callbackpolicyunknown(innercall) = 0 & cfg.localcomplete(target.procedureid('middle')),'exact local provider closure proves structural destinations without inventing a recycler frame hook')
  flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
  failures = failures + check(flow.status() = 'ok','composed fixed local resource flow builds')
  if flow.status() = 'ok' then do
    coverage = flow.entrycoverage(target.procedureid('main'))
    failures = failures + check(coverage.complete() & coverage.demands() = 0,'early fixed captures cover provider reads on aggregate UNKNOWN exceptional paths without erasing the root callback: ' || coverage.status() || ' ' || coverage.reason() || ' demands=' || coverage.demands())
    do i = 1 to row.actions()
      action = row.action(i)
      failures = failures + check(action.detail() <> 'catalog.callback.call-frame','current-body resource proof has no retired-frame callback at entry')
    end
  end
  raw = .lltargettransfer..profile(reference target); rawcfg = .lltargetcfg..graph(reference target,reference raw)
  failures = failures + check(raw.callbackpolicyunknown(innercall) = 0 & rawcfg.localcomplete(target.procedureid('middle')) & raw.defaulthalt(target.procedureid('middle')) = 0 & rawcfg.exceptionalcomplete(target.procedureid('middle')) = 0,'ordinary child preserves the suspended table while raw inherited destinations remain explicitly unknown')
  /* A context-value sync is not an observing/reentrant callback under the
   * enforced decimal registration ABI; numeric state remains a context effect. */
  failures = failures + check(catalog.contextsynccontract() = 'value-only-nonreentrant.v1','canonical catalogue exposes only the enforced decimal sync contract')
  return failures

/** Provider structural policy is independent of a later caller host effect.
 * Earlier caller effects and effects inside the provider retain their paths. */
localproviderpolicy: procedure = .int
  arg mode = .int
  failures = 0; ignored = .int; i = .int; callgap = .int; resourcepath = .int; ambient = .int; handlerpath = .int; mainhandler = .int; hook = .int; membership = .int
  row = .lltargetcfg..edge; action = .lltargettransfer..action; fields = .object[]
  draft = .lltarget..draft('local.provider.policy.' || mode,'fixture:local.provider.policy',0)
  at = draft.synthetic('point-local provider policy versus caller call-closure membership')
  body = draft.procedure('main',2,at)
  fields[1] = body.reg('r',0) as .object; fields[2] = .lltarget..operand.integer(7) as .object
  ignored = body.emit('load',fields,at)
  if mode = 1 then ignored = one(body,'sayx',.lltarget..operand.string('earlier caller host' as .binary),at)
  if mode = 4 then do
    call objectarraydrop fields; fields[1] = .lltarget..operand.symbol('caller.handler') as .object
    fields[2] = .lltarget..operand.string('OUT_OF_RANGE' as .binary) as .object
    ignored = body.emit('sigbr',fields,at)
  end
  call objectarraydrop fields; fields[1] = body.reg('r',1) as .object
  fields[2] = .lltarget..operand.procedure('leaf') as .object; fields[3] = body.reg('r',0) as .object
  called = body.emit('call1',fields,at)
  ignored = one(body,'sayx',.lltarget..operand.string('later caller host' as .binary),at)
  ignored = one(body,'ret',.lltarget..operand.integer(0),at)
  if mode = 4 then do
    mainhandler = label(body,'caller.handler',at)
    ignored = one(body,'ret',.lltarget..operand.integer(1),at)
  end
  body = draft.procedure('leaf',1,at)
  if mode = 2 then ignored = one(body,'sayx',.lltarget..operand.string('provider host' as .binary),at)
  if mode = 3 then do
    call objectarraydrop fields; fields[1] = .lltarget..operand.symbol('provider.handler') as .object
    fields[2] = .lltarget..operand.string('OUT_OF_RANGE' as .binary) as .object
    ignored = body.emit('sigbr',fields,at)
  end
  if mode = 5 then do
    call objectarraydrop fields; ignored = body.emit('bpoff',fields,at)
  end
  ignored = one(body,'null',body.reg('r',0),at)
  call objectarraydrop fields; fields[1] = body.reg('r',0) as .object; fields[2] = .lltarget..operand.integer(9) as .object
  ignored = body.emit('load',fields,at); ignored = one(body,'ret',body.reg('r',0),at)
  if mode = 3 then do
    ignored = label(body,'provider.handler',at); ignored = one(body,'ret',.lltarget..operand.integer(1),at)
  end
  target = draft.finish(); failures = failures + check(target.valid(),'local provider policy source validates ' || mode)
  if target.valid() = 0 then do; say target.error(); return failures; end
  profile = .lltargettransfer..profile
  if mode = 6 then profile = .lltargettransfer..profile.closedmain(reference target,target.procedureid('main'),'closed-main-default-halt.v1')
  else profile = .lltargettransfer..profile.closedcalls(reference target,target.procedureid('main'),'closed-main-default-halt.v1')
  cfg = .lltargetcfg..graph(reference target,reference profile)
  failures = failures + check(cfg.status() = 'ok','local provider policy CFG builds ' || mode)
  if cfg.status() <> 'ok' then do; say cfg.message(); return failures; end
  membership = mode < 3
  failures = failures + check(profile.defaulthalt(target.procedureid('main')) & profile.defaulthalt(target.procedureid('leaf')) = membership,'root entry and checked descriptor membership remain separate from provider policy preservation ' || mode)
  if mode <> 6 then failures = failures + check((profile.executionreason() = '') = membership,'host callbacks do not change exact call membership; policy and pending writes still refuse it ' || mode)
  failures = failures + check(profile.callbackpolicyunknown(called) = 0,'ordinary bytecode child owns its handler writes and pending state independently of descriptor membership ' || mode)
  do i = 1 to cfg.outedges(called)
    row = cfg.outedge(called,i)
    if row.boundarykind() = 'callback-policy' then callgap = 1
    if row.asynchronous() & row.phase() = 'after' then ambient = 1
    if row.phase() = 'unknown' & pos('.callback.sync.',row.boundaryid()) > 0 then resourcepath = 1
    if mode = 4 & row.role() = 'handler' & row.targetop() = mainhandler then handlerpath = 1
  end
  failures = failures + check(callgap = 0 & resourcepath & ambient,'isolated bytecode child cannot invent caller policy gaps or remove resource/ambient alternatives ' || mode)
  if mode = 4 then failures = failures + check(handlerpath,'earlier installed caller handler cannot become an all-HALT call-site assumption')
  if mode = 0 then do
    flow = .lltargetflow..analysis(reference target,reference profile,reference cfg)
    failures = failures + check(flow.status() = 'ok','policy-only closure retains usable resource flow')
    if flow.status() = 'ok' then do
      instruction = profile.instruction(called)
      do i = 1 to instruction.actions()
        action = instruction.action(i)
        if action.kind() = 'callback' & action.detail() = 'catalog.callback.call-frame' then hook = flow.callbackpossibleat(called,i)
      end
      failures = failures + check(hook = 0,'structural policy proof has no prior-frame recycler hook')
    end
  end
  return failures

/** Independent control oracles for isolated bytecode children and unknown
 * invocation. Mode 3 returns to the earlier producer; mode 4's call is
 * disconnected and mode 5 has a clean sibling. Mode 7 uses a dynamic target
 * whose possible policy changes must retain explicit destination gaps. */
policyreachability: procedure = .int
  arg mode = .int
  i = .int; ignored = .int; cleanprobe = .int; handlerprobe = .int
  earlygap = .int; lategap = .int; ambientgap = .int; callbackgap = .int; cleangap = .int; handlergap = .int; rootgap = .int
  fields = .object[]; row = .lltargetcfg..edge
  draft = .lltarget..draft('callback.policy.reach.' || mode,'fixture:callback.policy.reach',0)
  at = draft.synthetic('bytecode isolation and unknown dynamic policy follow staged successors')
  body = draft.procedure('main',2,at)
  root = one(body,'getnumdgts',body.reg('r',0),at)
  if mode = 6 then do
    fields[1] = .lltarget..operand.symbol('handler') as .object
    fields[2] = .lltarget..operand.string('OUT_OF_RANGE' as .binary) as .object
    ignored = body.emit('sigbr',fields,at)
  end
  ignored = label(body,'cycle',at)
  call objectarraydrop fields; fields[1] = body.reg('r',0) as .object
  fields[2] = .lltarget..operand.integer(1) as .object; fields[3] = .lltarget..operand.integer(99) as .object
  early = body.emit('ichkrng',fields,at)
  if mode = 4 then do
    ignored = one(body,'br',.lltarget..operand.symbol('live'),at)
    ignored = label(body,'disconnected',at)
  end
  if mode = 5 then do
    call objectarraydrop fields; fields[1] = .lltarget..operand.symbol('callback') as .object
    fields[2] = body.reg('r',0) as .object; ignored = body.emit('brt',fields,at)
    call objectarraydrop fields; fields[1] = body.reg('r',0) as .object
    fields[2] = .lltarget..operand.integer(1) as .object; fields[3] = .lltarget..operand.integer(99) as .object
    cleanprobe = body.emit('ichkrng',fields,at)
    ignored = one(body,'br',.lltarget..operand.symbol('live'),at)
    ignored = label(body,'callback',at)
  end
  if mode = 0 then do
    call objectarraydrop fields; fields[1] = body.reg('r',0) as .object
    fields[2] = .lltarget..operand.integer(7) as .object; ignored = body.emit('load',fields,at)
  end
  else if mode = 1 then ignored = one(body,'sayx',.lltarget..operand.string('policy' as .binary),at)
  else if mode = 7 then do
    call objectarraydrop fields; fields[1] = body.reg('r',0) as .object; fields[2] = body.reg('r',0) as .object; fields[3] = body.reg('r',0) as .object
    ignored = body.emit('dcall',fields,at)
  end
  else ignored = one(body,'call',.lltarget..operand.procedure('leaf'),at)
  ignored = label(body,'live',at)
  call objectarraydrop fields; fields[1] = body.reg('r',0) as .object
  fields[2] = .lltarget..operand.integer(1) as .object; fields[3] = .lltarget..operand.integer(99) as .object
  later = body.emit('ichkrng',fields,at)
  call objectarraydrop fields; fields[1] = body.reg('r',0) as .object
  fields[2] = body.reg('r',1) as .object; resource = body.emit('copy',fields,at)
  ambient = one(body,'getnumdgts',body.reg('r',0),at)
  destination = 'sink'; if mode = 3 then destination = 'cycle'
  ignored = one(body,'br',.lltarget..operand.symbol(destination),at)
  if mode = 6 then do
    ignored = label(body,'handler',at)
    call objectarraydrop fields; fields[1] = body.reg('r',0) as .object
    fields[2] = .lltarget..operand.integer(1) as .object; fields[3] = .lltarget..operand.integer(99) as .object
    handlerprobe = body.emit('ichkrng',fields,at)
    ignored = one(body,'br',.lltarget..operand.symbol('sink'),at)
  end
  ignored = label(body,'sink',at); ignored = one(body,'br',.lltarget..operand.symbol('sink'),at)
  leaf = draft.procedure('leaf',0,at); call objectarraydrop fields; ignored = leaf.emit('ret',fields,at)
  target = draft.finish(); failures = check(target.valid(),'policy reachability source validates ' || mode)
  if target.valid() = 0 then do; say target.error(); return failures; end
  profile = .lltargettransfer..profile.closedmain(reference target,target.procedureid('main'),'closed-main-default-halt.v1')
  cfg = .lltargetcfg..graph(reference target,reference profile)
  failures = failures + check(cfg.status() = 'ok','policy reachability CFG builds ' || mode)
  if cfg.status() <> 'ok' then do; say cfg.message(); return failures; end
  do i = 1 to cfg.edges()
    row = cfg.edge(i)
    if row.boundarykind() <> 'callback-policy' | pos('.reachable-callback.',row.boundaryid()) = 0 then iterate
    if row.sourceop() = root then rootgap = 1
    if row.sourceop() = early & row.phase() = 'before' & row.asynchronous() = 0 then earlygap = 1
    if row.sourceop() = later & row.phase() = 'before' & row.asynchronous() = 0 then lategap = 1
    if row.sourceop() = resource & row.phase() = 'unknown' & row.asynchronous() = 0 then callbackgap = 1
    if row.sourceop() = ambient & row.phase() = 'after' & row.asynchronous() then ambientgap = 1
    if row.sourceop() = cleanprobe then cleangap = 1
    if row.sourceop() = handlerprobe then handlergap = 1
  end
  expected = mode = 7
  failures = failures + check(lategap = expected & callbackgap = expected & ambientgap = expected,'only reachable dynamic invocation opens later intrinsic, resource-callback and ambient policy paths ' || mode)
  failures = failures + check(rootgap = 0 & earlygap = 0,'isolated child backedges preserve earlier policy and dynamic changes do not flow backwards ' || mode)
  if mode <> 7 then do
    fn = target.procedureid('main')
    failures = failures + check(cfg.localcomplete(fn) & cfg.exceptionalcomplete(fn) & cfg.asynchronouscomplete(fn) & cfg.policycorrelationcomplete(fn),'resource/bytes-output and isolated bytecode calls preserve live control completeness ' || mode)
  end
  if mode = 5 then failures = failures + check(cleangap = 0,'an isolated local call preserves the clean staged sibling policy')
  if mode = 6 then failures = failures + check(handlergap = 0,'isolated child leaves the authored caller handler policy exact')
  if mode = 3 then do
    limited = .lltargetcfg..graph(reference target,reference profile,cfg.usedwork() - 1,cfg.usedbytes())
    failures = failures + check(limited.status() = 'limit' & limited.identity() = 0,'bounded policy closure never publishes an unfinished CFG')
  end
  return failures

/** Clearing a pending delivery bit neither uninstalls an authored handler
 * nor restores a table that an earlier callback may have replaced. */
pendingcontrol: procedure = .int
  arg mode = .int
  i = .int; ignored = .int; policies = .int; pendingeffect = .int; opaque = .int; retainedhandler = .int; propagated = .int
  fields = .object[]; empty = .object[]; action = .lltargettransfer..action; row = .lltargetcfg..edge
  catalog = .llrxascatalog..catalog(); draft = .lltarget..draft('pending.control.' || mode,'fixture:pending.control',0)
  at = draft.synthetic('pending breakpoint bit is separate from structural handler policy')
  body = draft.procedure('main',1,at)
  ignored = one(body,'getnumdgts',body.reg('r',0),at)
  if mode = 1 then do
    fields[1] = .lltarget..operand.symbol('handler') as .object
    fields[2] = .lltarget..operand.string('BREAKPOINT' as .binary) as .object
    ignored = body.emit('sigbr',fields,at)
  end
  if mode = 2 then do
    call objectarraydrop fields; fields[1] = body.reg('r',0) as .object; fields[2] = body.reg('r',0) as .object; fields[3] = body.reg('r',0) as .object
    ignored = body.emit('dcall',fields,at)
  end
  pending = body.emit('bpoff',empty,at)
  if mode = 1 then following = one(body,'signal',.lltarget..operand.string('BREAKPOINT' as .binary),at)
  else do
    call objectarraydrop fields; fields[1] = body.reg('r',0) as .object
    fields[2] = .lltarget..operand.integer(7) as .object; following = body.emit('load',fields,at)
  end
  ignored = one(body,'br',.lltarget..operand.symbol('sink'),at)
  handler = label(body,'handler',at); ignored = one(body,'br',.lltarget..operand.symbol('sink'),at)
  ignored = label(body,'sink',at); ignored = one(body,'br',.lltarget..operand.symbol('sink'),at)
  target = draft.finish(); failures = check(target.valid(),'pending control source validates ' || mode)
  if target.valid() = 0 then do; say target.error(); return failures; end
  profile = .lltargettransfer..profile.closedmain(reference target,target.procedureid('main'),'closed-main-default-halt.v1')
  cfg = .lltargetcfg..graph(reference target,reference profile)
  failures = failures + check(cfg.status() = 'ok','pending control CFG builds ' || mode)
  if cfg.status() <> 'ok' then do; say cfg.message(); return failures; end
  item = target.at(pending); properties = catalog.signalproperties(item.opcode())
  failures = failures + check((properties <idiv> 32) % 2 & (properties <idiv> 8) % 2 = 0 & catalog.policyeffect(item.opcode()) = 3 & catalog.policyname(item.opcode()) = 'BREAKPOINT' & (catalog.signaldependencies(item.opcode()) <idiv> 2) % 2 = 0,'BPOFF retains pending effect/name without structural policy write or dependency')
  instruction = profile.instruction(pending)
  do i = 1 to instruction.actions()
    action = instruction.action(i)
    if action.kind() = 'policy' then policies = policies + 1
    if action.kind() = 'external' & action.detail() = 'catalog.opaque' then opaque = 1
    if action.kind() = 'external' & action.detail() = 'catalog.signal.pending.3' then do
      value = action.literal()
      pendingeffect = action.sourcekind() = 'literal' & value.kind() = 'S' & value.text() = 'BREAKPOINT' & action.intrinsicfootprint() = 1
    end
  end
  failures = failures + check(policies = 0 & pendingeffect & opaque & catalog.barrier(item.opcode()) <> 0,'pending delivery remains a distinct observable action and barrier without a structural policy fact')
  do i = 1 to cfg.outedges(following)
    row = cfg.outedge(following,i)
    if row.role() = 'handler' & row.targetop() = handler & row.phase() = 'before' & row.signalname() = 'BREAKPOINT' then retainedhandler = 1
    if row.boundarykind() = 'callback-policy' & pos('.reachable-callback.',row.boundaryid()) > 0 then propagated = 1
  end
  if mode = 0 then do
    fn = target.procedureid('main')
    failures = failures + check(cfg.policycorrelationcomplete(fn) & cfg.localcomplete(fn) & propagated = 0,'pending-only control does not install or invalidate a structural handler table')
    closure = .lltargettransfer..profile.closedcalls(reference target,fn,'closed-main-default-halt.v1')
    failures = failures + check(closure.executionreason() = 'target.context.call.pending.unproved' & closure.defaulthalt(fn),'pending delivery still refuses call closure without erasing the independently declared root entry policy')
  end
  if mode = 1 then failures = failures + check(retainedhandler,'BPOFF cannot erase an installed handler for a later explicit BREAKPOINT')
  if mode = 2 then failures = failures + check(propagated,'clearing a pending bit cannot erase earlier dynamic invocation policy uncertainty')
  return failures

main: procedure = .int
  i = .int; variant = .int; faultpolicy = .int
  catalog = .llrxascatalog..catalog()
  fields = .object[]
  failures = 0; row = .lltargetcfg..edge
  draft = .lltarget..draft('canonical.signal.cfg','fixture:canonical.signal.cfg',0)
  at = draft.synthetic('independent canonical signal CFG')
  body = draft.procedure('main',2,at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.symbol('handler') as .object
  fields[2] = .lltarget..operand.string('OUT_OF_RANGE' as .binary) as .object
  ignored = body.emit('sigbr',fields,at)
  call objectarraydrop fields; fields[1] = body.reg('r',0) as .object
  fields[2] = .lltarget..operand.integer(1) as .object; fields[3] = .lltarget..operand.integer(2) as .object
  fault = body.emit('ichkrng',fields,at)
  call objectarraydrop fields; fields[1] = body.reg('r',1) as .object; fields[2] = .lltarget..operand.integer(7) as .object
  following = body.emit('load',fields,at)
  mainreturn = one(body,'ret',.lltarget..operand.integer(0),at)
  handler = label(body,'handler',at)
  ignored = one(body,'ret',.lltarget..operand.integer(1),at)
  body = draft.procedure('leaf',0,at)
  leafreturn = one(body,'ret',.lltarget..operand.integer(9),at)
  target = draft.finish()
  failures = failures + check(target.valid(),'canonical signal source validates')
  if target.valid() = 0 then do; say target.error(); say 'TARGET_SIGNAL_CFG|failures=' || failures; return failures; end
  profile = .lltargettransfer..profile(reference target)
  foreign = target
  failures = failures + check(profile.matches(reference foreign) = 0,'copied target is not the sealed execution owner')
  cfg = .lltargetcfg..graph(reference target,reference profile)
  failures = failures + check(cfg.status() = 'ok','canonical signal CFG builds')
  if cfg.status() = 'ok' then do
    localhandler = 0; inheritedresume = 0; outward = 0; leafexit = 0; callbackhandler = 0; departurepolicy = 0; faultpolicy = 0
    do i = 1 to cfg.edges()
      row = cfg.edge(i)
      if row.sourceop() = fault then do
        if row.role() = 'handler' & row.targetblock() = cfg.projectedblock(handler) & row.phase() = 'before' then localhandler = 1
        if row.role() = 'resumed' & row.exposure() = 'inherited' & row.targetblock() = cfg.projectedblock(following) then inheritedresume = 1
        if row.boundarykind() = 'inherited-signal-policy' & row.complete() = 0 then outward = 1
        if row.boundarykind() = 'callback-policy' then faultpolicy = 1
      end
      if row.sourceop() = mainreturn & row.boundarykind() = 'callback-policy' & row.complete() = 0 then departurepolicy = 1
      if row.sourceop() = following & row.role() = 'handler' & row.targetop() = handler & row.phase() = 'unknown' & row.asynchronous() = 0 then callbackhandler = 1
      if row.sourceop() = leafreturn & row.role() = 'terminal' & row.targetblock() = 0 then leafexit = 1
    end
    failures = failures + check(localhandler & inheritedresume & outward,'local handler, foreign resumption and unknown outward departure remain distinct')
    failures = failures + check(callbackhandler = 0,'setter cleanup cannot invent a handler-producing Rexx callback')
    failures = failures + check(cfg.localcomplete(target.procedureid('main')) & cfg.exceptionalcomplete(target.procedureid('main')) = 0 & departurepolicy = 0 & faultpolicy = 0,'complete resource-only departure inventory preserves local destinations while raw inherited departures remain open')
    failures = failures + check(leafexit & cfg.physicaldeparture(mainreturn) & cfg.physicaldeparture(leafreturn),'ordinary RETs depart their physical procedure frames')
  end
  else say cfg.message()
  closedprofile = .lltargettransfer..profile.closedmain(reference target,target.procedureid('main'),'closed-main-default-halt.v1')
  closedcfg = .lltargetcfg..graph(reference target,reference closedprofile)
  failures = failures + check(closedcfg.status() = 'ok' & closedprofile.premise() = 'canonical' & closedprofile.executionroot() = target.procedureid('main'),'explicit closed-main context binds one canonical transfer owner')
  if closedcfg.status() = 'ok' then do
    halted = 0; retainedhandler = 0; foreignroot = 0; othersunknown = 0; callbackpolicy = 0; faultpolicy = 0
    do i = 1 to closedcfg.edges()
      row = closedcfg.edge(i)
      if row.sourceop() = fault then do
        if row.boundarykind() = 'closed-main-default-halt' & row.role() = 'terminal' then halted = 1
        if row.role() = 'handler' & row.targetop() = handler then retainedhandler = 1
        if row.boundarykind() = 'inherited-signal-policy' & row.phase() = 'before' then foreignroot = 1
        if row.boundarykind() = 'callback-policy' then faultpolicy = 1
      end
      if row.sourceop() = mainreturn & row.boundarykind() = 'callback-policy' & row.complete() = 0 then callbackpolicy = 1
      if row.sourceop() = leafreturn & row.complete() = 0 then othersunknown = 1
    end
    faultitem = target.at(fault)
    failures = failures + check(halted & retainedhandler & foreignroot = 0 & othersunknown & callbackpolicy = 0 & faultpolicy = 0 & closedcfg.localcomplete(target.procedureid('main')) & catalog.callbackobligations(faultitem.opcode()) = 0,'entry HALT keeps the callback-free intrinsic handler and complete resource-only departure destinations while other procedure policies remain open')
  end
  else say closedcfg.message()
  wrongroot = .lltargettransfer..profile.closedmain(reference target,target.procedureid('leaf'),'closed-main-default-halt.v1')
  failures = failures + check(wrongroot.status() = 'invalid','closed execution context rejects a foreign procedure owner')
  tinycfg = .lltargetcfg..graph(reference target,reference profile,1,1)
  failures = failures + check(tinycfg.status() = 'limit','CFG queries retain deterministic tiny-budget refusal')
  /* Logical signal exits and region-crossing validation await the selected
   * executable-region design. Retired scope entries are not fixture premises. */
  failed_draft = .lltarget..draft('failed.draft','fixture:failed.draft',0)
  failed_at = failed_draft.synthetic('preserve first malformed-draft diagnostic')
  failed_body = failed_draft.procedure('main',0,failed_at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.integer(0) as .object
  ignored = failed_body.emit('not_registered',fields,failed_at)
  first_error = failed_draft.error()
  refused_body = failed_draft.procedure('later',0,failed_at)
  ignored = refused_body.emit('ret',fields,failed_at)
  failed_target = failed_draft.finish()
  failures = failures + check(first_error <> '' & refused_body.functionid() = 0 & failed_target.valid() = 0 & failed_target.error() == first_error,'malformed draft preserves its first diagnostic without constructing expired function handles')
  failures = failures + bcopycontrol()
  failures = failures + departureobservations(0) + departureobservations(1)
  failures = failures + postwritediamond(0) + postwritediamond(1)
  failures = failures + checkpointreplays()
  failures = failures + callcauses()
  do variant = 0 to 5; failures = failures + callbackcontrol(variant); end
  do variant = 0 to 7; failures = failures + policyreachability(variant); end
  do variant = 0 to 6; failures = failures + localproviderpolicy(variant); end
  do variant = 0 to 2; failures = failures + pendingcontrol(variant); end
  say 'TARGET_SIGNAL_CFG|failures=' || failures
  return failures
