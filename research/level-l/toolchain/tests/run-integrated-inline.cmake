cmake_minimum_required(VERSION 3.24)
foreach(_name VM ASSEMBLER CLI FIXTURES WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
include("${FIXTURES}/signal-pair-helpers.cmake")

function(integrated_execute _stem _source _expected)
  set(_product "${WORK}/${_stem}")
  file(WRITE "${_product}.rxas" "${_source}")
  run_checked("assemble ${_stem}" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
  run_checked("execute ${_stem}" "${VM}" "${_product}.rxbin")
  expect_output("${_expected}")
endfunction()

file(READ "${FIXTURES}/io-integrated-inline.rxas" _original)
integrated_execute(integrated-original "${_original}" "5\n-1")
foreach(_mode conservative cleaned)
  set(_option "")
  if(_mode STREQUAL conservative)
    set(_option --no-cleanup)
  endif()
  set(_product "${WORK}/integrated-${_mode}")
  run_checked("expand integrated ${_mode}" "${VM}" "${CLI}" ${RUNTIME} -a
    --module integrated.rxas --profile closed-main-default-halt.v1 ${_option}
    -o "${_product}.rxas" "${FIXTURES}/io-integrated-inline.rxas")
  if(_last_stderr MATCHES "LL_(CLEANUP|STORAGE)_FAILED:")
    message(FATAL_ERROR "Integrated cleanup reported an internal failure: ${_last_stderr}")
  endif()
  file(READ "${_product}.rxas" _expanded)
  string(FIND "${_expanded}" "ordinary() .locals=" _end)
  if(_end LESS 0)
    message(FATAL_ERROR "Integrated output lost the ordinary definition")
  endif()
  string(SUBSTRING "${_expanded}" 0 ${_end} _caller)
  if(_caller MATCHES "(^|\n)[ \t]*call[1234]?[ \t]")
    message(FATAL_ERROR "Integrated ${_mode} retained a selected ordinary call")
  endif()
  if(_mode STREQUAL conservative)
    foreach(_operation strlen beq iand substring iadd)
      string(REGEX MATCHALL "(^|\n)[ \t]*${_operation} " _operations "${_caller}")
      list(LENGTH _operations _count)
      set(_expected 2)
      if(_operation STREQUAL strlen)
        set(_expected 4)
      endif()
      if(NOT _count EQUAL _expected)
        message(FATAL_ERROR "Conservative clone changed ${_operation}: expected ${_expected}, got ${_count}")
      endif()
    endforeach()
  endif()
  integrated_execute("integrated-${_mode}-executed" "${_expanded}" "5\n-1")
endforeach()

# Preserve the existing effective scalar transport case while broad ordinary
# clones may conservatively retain all of their own transport glue.
file(READ "${FIXTURES}/io-reordered.rxas" _reordered)
integrated_execute(reordered-original "${_reordered}" "23")
run_checked("clean simple reordered actuals" "${VM}" "${CLI}" ${RUNTIME} -a
  --module reordered.rxas --profile closed-main-default-halt.v1
  -o "${WORK}/reordered-cleaned.rxas" "${FIXTURES}/io-reordered.rxas")
if(_last_stderr MATCHES "LL_(CLEANUP|STORAGE)_FAILED:")
  message(FATAL_ERROR "Reordered cleanup reported an internal failure: ${_last_stderr}")
endif()
file(READ "${WORK}/reordered-cleaned.rxas" _cleaned)
string(FIND "${_cleaned}" "first() .locals=" _end)
if(_end LESS 0)
  message(FATAL_ERROR "Reordered output lost its retained definition")
endif()
string(SUBSTRING "${_cleaned}" 0 ${_end} _caller)
if(_caller MATCHES "(^|\n)[ \t]*(call[1234]?|swap)[ \t]")
  message(FATAL_ERROR "Simple reordered actuals retained a call or outer permutation")
endif()
integrated_execute(reordered-cleaned-executed "${_cleaned}" "23")
file(REMOVE_RECURSE "${WORK}")
message("RXAS_INTEGRATED_INLINE|failures=0")
