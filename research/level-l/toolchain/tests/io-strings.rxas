/* All calls precede presentation. Numeric/status observations use separate
 * ICOPY/GETANDTP outputs, so ITOS cannot overwrite the string being checked. */
.globals=0
main() .locals=39
  load r0,0
  null r1
  load r1,73
  settp r1,512
  load r1,"old"
  call1 r1,empty(),r0
  icopy r2,r1
  getandtp r3,r1,768
  null r4
  load r4,73
  settp r4,512
  load r4,"old"
  call1 r4,unicode(),r0
  icopy r5,r4
  getandtp r6,r4,768
  call1 r7,owned(),r0
  icopy r8,r7
  getandtp r9,r7,768
  call1 r10,owned(),r0
  icopy r11,r10
  getandtp r12,r10,768
  null r13
  load r13,17
  settp r13,256
  load r13,"before λ"
  call1 r14,borrowed(),r13
  icopy r15,r14
  getandtp r16,r14,768
  call1 r17,rebound(),r13
  icopy r18,r17
  getandtp r19,r17,768
  call2 r20,stringsnapshot(),r13,r13
  icopy r21,r20
  getandtp r22,r20,768
  load r13,"before λ"
  call2 r23,wholesnapshot(),r13,r13
  icopy r24,r23
  getandtp r25,r23,768
  icopy r26,r13
  getandtp r27,r13,768
  null r28
  load r28,17
  settp r28,256
  load r28,"café λ🙂"
  null r29
  settp r29,512
  acopy r28,r29
  call1 r30,borrowed(),r28
  icopy r31,r30
  getandtp r32,r30,768
  null r33
  load r33,19
  settp r33,256
  load r33,"moved λ"
  move r34,r33
  icopy r35,r34
  getandtp r36,r34,768
  icopy r37,r33
  getandtp r38,r33,768
  say "literal-empty"
  say "empty-begin"
  say r1
  say "empty-end"
  itos r2
  say r2
  itos r3
  say r3
  say "literal-unicode"
  say r4
  itos r5
  say r5
  itos r6
  say r6
  say "owned-first"
  say r7
  itos r8
  say r8
  itos r9
  say r9
  say "owned-repeat"
  say r10
  itos r11
  say r11
  itos r12
  say r12
  say "borrowed"
  say r14
  itos r15
  say r15
  itos r16
  say r16
  say "rebound"
  say r17
  itos r18
  say r18
  itos r19
  say r19
  say "string-snapshot"
  say r20
  itos r21
  say r21
  itos r22
  say r22
  say "whole-snapshot"
  say r23
  itos r24
  say r24
  itos r25
  say r25
  say "actual-after"
  say r13
  itos r26
  say r26
  itos r27
  say r27
  say "independent-cert"
  say r30
  itos r31
  say r31
  itos r32
  say r32
  say "whole-move"
  say r34
  itos r35
  say r35
  itos r36
  say r36
  say "move-source"
  say "empty-begin"
  say r33
  say "empty-end"
  itos r37
  say r37
  itos r38
  say r38
  ret 0
empty() .locals=0
  ret ""
unicode() .locals=0
  ret "café λ🙂"
owned() .locals=1
  load r0,11
  load r0,"owned λ"
  settp r0,256
  ret r0
borrowed() .locals=0
  ret a1
rebound() .locals=1
  link r0,a1
  ret r0
stringsnapshot() .locals=1
  null r0
  load r0,23
  settp r0,512
  scopy r0,a1
  load a2,"after"
  ret r0
wholesnapshot() .locals=1
  copy r0,a1
  load a2,"after"
  ret r0
