/* cREXX License (MIT). Qualified procedure identity and explicit call remapping. */
options levelb
import rxfnsb
import lltarget

check: procedure = .int
  arg condition = .int, message = .string
  if condition then return 0
  say 'FAIL:' message
  return 1

main: procedure = .int
  fields = .object[]; replacements = .object[]
  failures = 0; i = .int; value = .lltarget..operand; original = .lltarget..record
  draft = .lltarget..draft('recipe.source','fixture:recipe.source',0)
  at = draft.synthetic('independent qualified call identity')
  body = draft.procedure('main',3,at)
  fields[1] = body.reg('r',0) as .object
  fields[2] = .lltarget..operand.procedure('@2::5') as .object
  fields[3] = body.reg('r',2) as .object
  qualified = body.emit('call1',fields,at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.integer(0) as .object
  ignored = body.emit('ret',fields,at)
  source = draft.finish()
  failures = failures + check(source.valid(),'source with qualified CALL1 validates')
  if source.valid() = 0 then do; say source.error(); say 'TARGET_RECIPE|failures=' || failures; return failures; end
  original = source.at(qualified); value = original.operand(2)
  failures = failures + check(value.kind() = 'P' & value.text() = '@2::5','qualified P keeps image and original procedure identity')
  failures = failures + check(original.registerrefs() = 2,'ordinary CALL1 enumerates its result and actual register')
  output = .lltarget..draft('recipe.output','fixture:recipe.output',0)
  copiedat = output.synthetic('independent explicit call remap')
  copiedbody = output.procedure('main',32,copiedat)
  do i = 1 to original.registerrefs()
    value = original.registerref(i)
    replacements[i] = copiedbody.reg('r',value.index() + 24) as .object
  end
  rewritten = lltarget..remapregisters(original,replacements)
  value = rewritten[1] as .lltarget..operand
  failures = failures + check(value.bank() = 'r' & value.index() = 24,'ordinary CALL1 result remaps')
  value = rewritten[3] as .lltarget..operand
  failures = failures + check(value.bank() = 'r' & value.index() = 26,'ordinary CALL1 actual remaps independently')
  value = rewritten[2] as .lltarget..operand
  failures = failures + check(value.kind() = 'P' & value.text() = '@2::5','register remapping preserves the qualified provider identity')
  say 'TARGET_RECIPE|failures=' || failures
  return failures
