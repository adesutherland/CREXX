/* Explicit first(y): TRACE and caller values observe the complete permutation. */
.globals=0
main() .locals=6
  load r0,11
  load r1,23
  swap r3,r1
  swap r4,r0
  .traceevent "V" 4 "R" "I" "r" 3 0 0 0 "y" ""
  call1 r5,first(),r3
  swap r0,r4
  swap r1,r3
  itos r5
  say r5
  itos r0
  say r0
  itos r1
  say r1
  ret 0
first() .locals=0
  ret a1
