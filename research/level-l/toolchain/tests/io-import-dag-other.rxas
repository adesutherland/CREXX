/* This distinct owner intentionally reuses every label and numeric source ID. */
.globals=0
choose() .locals=1 .expose=fixture.import.dag.second
  null r0
  br dispatch
negative:
negative_alias:
  load r0,9
  .srcstep 1 1 0 "io-import-dag-other.rxas" 11 3 8 "  ret r0"
  .traceevent "V" 4 "R" "I" "r" 0 1 1 0 "dag-owned" ""
  ret r0
positive:
  swap a2,a3
  load a2,99
  br done
  .srcstep 3 3 0 "io-import-dag-other.rxas" 19 3 33 "  brtf positive,negative_alias,a1"
  .traceevent "V" 4 "R" "I" "a" 1 3 3 0 "dag-condition" ""
dispatch:
  brtf positive,negative_alias,a1
done:
  .srcstep 2 2 0 "io-import-dag-other.rxas" 23 3 8 "  ret a3"
  .traceevent "V" 4 "R" "I" "a" 3 2 2 0 "dag-borrowed" ""
  ret a3
