/* cREXX License (MIT). Typed recipe banks and unchanged physical RXAS wire. */
options levelb
import rxfnsb
import lltarget
import lltargetrecipe
import llrxasinput
import llrxasoutput

check: procedure = .int
  arg value = .int, label = .string
  if value then return 0
  say 'FAIL:' || label; return 1

main: procedure = .int
  failures = 0; i = .int; j = .int; found = .int; caught = .int
  item = .lltarget..record
  text = 'count=g1;args=window(a0);a0=r4;proxies=(r5:1,r6:2);owned=(r4,r5,r6);prep=settp(g0,256)+swap(a1,r3)'
  expected = 'count=r9;args=window(r10);a0=r4;proxies=(r5:1,r6:2);owned=(r4,r5,r6);prep=settp(r8,256)+swap(r11,r3)'
  view = .lltargetrecipe..view(text)
  failures = failures + check(view.error() = '', 'typed count/window/preparation banks are admitted')
  if view.error() <> '' then do; say view.error(); return 1; end
  physical = view.physical(8,2)
  failures = failures + check(physical == expected & view.physicalsize(8,2) = length(expected),'physical packing uses final local/global extents exactly')
  decoded = .lltargetrecipe..view(physical)
  failures = failures + check(decoded.logical(8,2) == text,'physical count/window/preparation roundtrip recovers typed banks')
  later = view.physical(16,2)
  failures = failures + check(pos('count=r17;args=window(r18)',later) = 1 & pos('settp(r16,256)+swap(r19,r3)',later) > 0,'later local growth shifts only physical global/argument indices')
  actuals = .lltargetrecipe..view('count=4;args=list(r2,g0,a1,g0);a0=r4;proxies=();owned=(r4);prep=none')
  physical = actuals.physical(8,2); decoded = .lltargetrecipe..view(physical)
  failures = failures + check(physical == 'count=4;args=list(r2,r8,r11,r8);a0=r4;proxies=();owned=(r4);prep=none','explicit ordered mixed-bank actuals preserve duplicate aliases')
  failures = failures + check(decoded.logical(8,2) == 'count=4;args=list(r2,g0,a1,g0);a0=r4;proxies=();owned=(r4);prep=none','explicit mixed-bank actuals roundtrip')
  crossed = .lltargetrecipe..view('count=3;args=window(g1);a0=r4;proxies=();owned=(r4);prep=none')
  physical = crossed.physical(8,2); decoded = .lltargetrecipe..view(physical)
  failures = failures + check(physical == 'count=3;args=window(r9);a0=r4;proxies=();owned=(r4);prep=none','physical window can cross the final global-to-argument boundary')
  failures = failures + check(decoded.logical(8,2) == 'count=3;args=window(g1);a0=r4;proxies=();owned=(r4);prep=none','cross-bank window retains its typed anchor and contiguous physical meaning')
  bad = .lltargetrecipe..view('count=0;args=list();a0=g0;proxies=();owned=(r4);prep=none')
  failures = failures + check(bad.error() <> '', 'scope-owned identity cannot become a global')
  caught = 0
  do
    rejectedtext = view.physical(8,1)
  on signal
    caught = 1
  end
  failures = failures + check(caught,'packing rejects an out-of-frame global rather than shifting it')

  draft = .lltarget..draft('recipe.banks','fixture:recipe.banks',2)
  at = draft.synthetic('typed recipe boundary')
  root = draft.procedure('main',8,at)
  fields = .object[]; fields[1] = root.reg('r',0) as .object
  fields[2] = .lltarget..operand.procedure('leaf') as .object
  fields[3] = .lltarget..operand.string(text as .binary) as .object
  fields[4] = .lltarget..operand.symbol('after') as .object
  entry = root.emit('inlenter',fields,at)
  call objectarraydrop fields; fields[1] = .lltarget..operand.integer(7) as .object
  ignored = root.emit('ret',fields,at)
  fields[1] = .lltarget..operand.symbol('after') as .object; ignored = root.record('label',fields,at)
  fields[1] = .lltarget..operand.integer(0) as .object; ignored = root.emit('ret',fields,at)
  leaf = draft.procedure('leaf',0,at); ignored = leaf.emit('ret',fields,at)
  source = draft.finish()
  failures = failures + check(source.valid(),'typed recipe enrolls banks without growing caller locals')
  if source.valid() = 0 then do; say source.error(); return 1; end
  body = source.body(source.procedureid('main'))
  failures = failures + check(body.locals() = 8,'typed target frame extent remains authored')
  rendered = llrxasoutput..render(reference source)
  failures = failures + check(rendered.error() = '', 'RXAS boundary renders final physical indices')
  if rendered.error() <> '' then do; say rendered.error(); return 1; end
  output = rendered.output(); wire = output.text()
  failures = failures + check(pos(expected,wire) > 0 & pos('main() .locals=8',wire) > 0,'RXAS writer uses physical recipe without changing frame header')
  reader = .llrxasinput..reader()
  parsed = reader.parse(wire as .binary,'recipe.banks','fixture:recipe.banks.roundtrip')
  failures = failures + check(parsed.status() = 0,'native physical spelling parses back into typed model')
  if parsed.status() <> 0 then do; say parsed.diagnostic(); return 1; end
  roundtrip = parsed.result(); body = roundtrip.body(roundtrip.procedureid('main'))
  failures = failures + check(body.locals() = 8 & roundtrip.globals() = 2,'read inversion precedes local register enrollment')
  found = 0
  do i = 1 to roundtrip.records()
    item = roundtrip.record(i)
    if item.kind() <> 'instruction' then iterate
    if item.mnemonic() <> 'inlenter' then iterate
    found = 1; decoded = item.recipe()
    failures = failures + check(decoded.error() = '' & decoded.physical(8,2) == expected,'read recipe retains exact physical roundtrip')
    do j = 1 to view.registers()
      failures = failures + check(decoded.bank(j) = view.bank(j) & decoded.index(j) = view.index(j) & decoded.role(j) = view.role(j),'read typed role identity ' || j)
    end
  end
  failures = failures + check(found,'read logical entry remains present')
  say 'TARGET_RECIPE_BANKS|failures=' || failures
  return failures
