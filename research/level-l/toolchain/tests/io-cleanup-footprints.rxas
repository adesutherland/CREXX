/* Shared fixed-footprint oracle: stdout is "7\n7\n1\n".
 * INC0 must keep its physical r0 constraint or be normalized to an equivalent
 * explicit INC before placement. The explicit control has the same value. */
.globals=0
main() .locals=5
  load r0,6
  inc0
  load r3,6
  inc r3
  ieq r4,r0,r3
  itos r0
  say r0
  itos r3
  say r3
  itos r4
  say r4
  ret 0
