# Included by run-named-signal.cmake; reuse its checked process/output helpers.
file(READ "${FIXTURES}/io-signal-catchall.rxas" _catch_fixture)
function(expect_catch_policies _original _expanded)
  string(REGEX MATCHALL "(sigpush|sigbr|sigpop)[ \t]+[^\n]+" _before "${_original}")
  string(REGEX MATCHALL "(sigpush|sigbr|sigpop)[ \t]+[^\n]+" _after "${_expanded}")
  if(NOT _before STREQUAL _after)
    message(FATAL_ERROR "Complete catch-all changed its executable policy rows")
  endif()
  list(LENGTH _after _count)
  if(NOT _count EQUAL 116)
    message(FATAL_ERROR "Complete catch-all must retain 29 pushes, installs and two pop lists")
  endif()
endfunction()
foreach(_case normal fault alias-normal alias-fault known-normal known-fault)
  set(_original "${_catch_fixture}")
  if(_case MATCHES "fault$")
    string(REPLACE "settp r3,0" "settp r3,256" _original "${_original}")
  endif()
  if(_case MATCHES "^known-")
    set(_input 3)
    if(_case STREQUAL "known-fault")
      set(_input 12)
    endif()
    string(REPLACE "getandtp r0,r3,256" "load r0,${_input}" _original "${_original}")
  endif()
  set(_return "r1")
  if(_case MATCHES "^alias-")
    set(_return "r0")
    string(REPLACE "call1 r1,checked_identity(),r0" "call1 r0,checked_identity(),r0" _original "${_original}")
    string(REPLACE "\"r\" 1 1 1 0 \"checked_identity\"" "\"r\" 0 1 1 0 \"checked_identity\"" _original "${_original}")
    string(REPLACE "itos r1\n  say r1" "itos r0\n  say r0" _original "${_original}")
  endif()
  if(_case STREQUAL "known-normal")
    set(_expected "normal\n3\n3\n1")
  elseif(_case STREQUAL "known-fault")
    set(_expected "handler\n12\n99\n2")
  elseif(_case STREQUAL "fault")
    set(_expected "handler\n256\n99\n2")
  elseif(_case STREQUAL "alias-fault")
    set(_expected "handler\n256\n256\n2")
  else()
    set(_expected "normal\n0\n0\n1")
  endif()
  set(_source "${WORK}/catchall-${_case}.rxas")
  file(WRITE "${_source}" "${_original}")
  run_checked("assemble original catch-all ${_case}" "${ASSEMBLER}" -n -o "${WORK}/catchall-${_case}-original" "${_source}")
  run_checked("execute original catch-all ${_case}" "${VM}" "${WORK}/catchall-${_case}-original.rxbin")
  expect_output("${_expected}")
  foreach(_mode conservative cleanup)
    set(_options)
    if(_mode STREQUAL "conservative")
      set(_options --no-cleanup)
    endif()
    set(_product "${WORK}/catchall-${_case}-${_mode}")
    run_checked("expand catch-all ${_case} ${_mode}" "${VM}" "${CLI}" ${RUNTIME} -a
      --module catchall.rxas --profile closed-main-default-halt.v1 ${_options}
      -o "${_product}.rxas" "${_source}")
    if(_mode STREQUAL "cleanup" AND (NOT _last_stderr MATCHES "LL_CLEANUP_KEEP: transport.exceptional.cfg.pending"
        OR NOT _last_stderr MATCHES "LL_STORAGE_KEEP: storage.exceptional.cfg.pending"))
      message(FATAL_ERROR "Catch-all cleanup lacks its exceptional-CFG refusal: ${_last_stderr}")
    endif()
    file(READ "${_product}.rxas" _expanded)
    expect_catch_policies("${_original}" "${_expanded}")
    string(FIND "${_expanded}" "checked_identity()" _leaf)
    string(SUBSTRING "${_expanded}" 0 ${_leaf} _main)
    if(NOT _main MATCHES "main[(][)] [.]locals=4" OR _main MATCHES "(call1|link|unlink|endlife)[ \t]")
      message(FATAL_ERROR "Catch-all did not use proved direct scalar transport: ${_main}")
    endif()
    if(NOT _main MATCHES "copy ${_return},r0" OR NOT _main MATCHES "caught:\n[ \t]*sigpop \"OTHER\"")
      message(FATAL_ERROR "Catch-all return/handler entry has extra or incorrect transport")
    endif()
    string(REGEX MATCHALL "[.]srcstep 1 1 17 \"catchall.g\"" _caller_steps "${_main}")
    list(LENGTH _caller_steps _caller_count)
    string(REGEX MATCHALL "[.]traceevent \"F\"[^\n]*\"checked_identity\"" _results "${_main}")
    list(LENGTH _results _result_count)
    if(NOT _caller_count EQUAL 2 OR NOT _result_count EQUAL 1
        OR NOT _main MATCHES "[.]srcstep [0-9]+ [0-9]+ 17 \"catchall.g\" 8[^\n]*\n[ \t]*ichkrng r0,-5,5")
      message(FATAL_ERROR "Catch-all lost call/body/continuation source or duplicated result TRACE")
    endif()
    run_checked("assemble catch-all ${_case} ${_mode}" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
    run_checked("execute catch-all ${_case} ${_mode}" "${VM}" "${_product}.rxbin")
    expect_output("${_expected}")
  endforeach()
endforeach()

# A preceding procedure's source anchor cannot become main's continuation.
# Keep the checked leaf first and omit main's own source step deliberately.
file(READ "${WORK}/catchall-known-normal.rxas" _reverse_input)
string(FIND "${_reverse_input}" "main() .locals=4" _main_start)
string(FIND "${_reverse_input}" "checked_identity() .locals=0" _leaf_start)
math(EXPR _main_bytes "${_leaf_start} - ${_main_start}")
string(SUBSTRING "${_reverse_input}" ${_main_start} ${_main_bytes} _reverse_main)
string(SUBSTRING "${_reverse_input}" ${_leaf_start} -1 _reverse_leaf)
string(REPLACE "  .srcstep 1 1 17 \"catchall.g\" 1 1 35 \"result = checked_identity(value)\"\n" "" _reverse_main "${_reverse_main}")
file(WRITE "${WORK}/catchall-reversed.rxas" ".globals=0\n${_reverse_leaf}\n${_reverse_main}")
run_checked("expand leaf-before-main without caller step" "${VM}" "${CLI}" ${RUNTIME} -a
  --module catchall-reversed.rxas --profile closed-main-default-halt.v1 --no-cleanup
  -o "${WORK}/catchall-reversed-expanded.rxas" "${WORK}/catchall-reversed.rxas")
file(READ "${WORK}/catchall-reversed-expanded.rxas" _reverse_expanded)
string(FIND "${_reverse_expanded}" "main() .locals=4" _main_start)
string(SUBSTRING "${_reverse_expanded}" ${_main_start} -1 _reverse_main)
if(NOT _reverse_main MATCHES "[.]srcstep 0 0 6 \"\" 0 0 0 \"\""
    OR _reverse_main MATCHES "[.]srcstep 3 3 17")
  message(FATAL_ERROR "Catch-all continuation inherited another procedure's source step")
endif()
foreach(_kind original expanded)
  set(_source "${WORK}/catchall-reversed.rxas")
  if(_kind STREQUAL "expanded")
    set(_source "${WORK}/catchall-reversed-expanded.rxas")
  endif()
  set(_product "${WORK}/catchall-reversed-${_kind}")
  run_checked("assemble reversed-source ${_kind}" "${ASSEMBLER}" -n -o "${_product}" "${_source}")
  run_checked("execute reversed-source ${_kind}" "${VM}" "${_product}.rxbin")
  expect_output("normal\n3\n3\n1")
endforeach()

# Deterministic pending-signal injection, after transformation, at corresponding
# ordinary instruction boundaries. This does not claim external POSIX timing.
file(READ "${WORK}/catchall-known-normal.rxas" _paired_original)
file(READ "${WORK}/catchall-known-normal-conservative.rxas" _paired_expanded)
foreach(_point entry before-commit after-commit after-observation)
  set(_original "${_paired_original}")
  set(_expanded "${_paired_expanded}")
  if(_point STREQUAL "entry")
    string(REPLACE "call1 r1,checked_identity(),r0" "signal \"CANCEL\"\n  call1 r1,checked_identity(),r0" _original "${_original}")
    string(REPLACE "cnop\n" "signal \"CANCEL\"\ncnop\n" _expanded "${_expanded}")
    set(_expected "0\nhandler\n3\n99\n2")
  elseif(_point STREQUAL "before-commit")
    string(REPLACE "ret a1" "signal \"CANCEL\"\n  ret a1" _original "${_original}")
    string(REPLACE "copy r1,r0" "signal \"CANCEL\"\ncopy r1,r0" _expanded "${_expanded}")
    set(_expected "0\nhandler\n3\n99\n2")
  elseif(_point STREQUAL "after-commit")
    set(_event ".srcstep 1 1 17 \"catchall.g\" 1 1 35 \"result = checked_identity(value)\"\nsignal \"CANCEL\"")
    string(REPLACE "call1 r1,checked_identity(),r0" "call1 r1,checked_identity(),r0\n${_event}" _original "${_original}")
    string(REPLACE "copy r1,r0" "copy r1,r0\n${_event}" _expanded "${_expanded}")
    set(_expected "0\nhandler\n3\n3\n2")
  else()
    string(REPLACE "say \"normal\"" "say \"normal\"\n  signal \"CANCEL\"" _original "${_original}")
    string(REPLACE "say \"normal\"" "say \"normal\"\nsignal \"CANCEL\"" _expanded "${_expanded}")
    set(_expected "normal\n1\nhandler\n3\n3\n2")
  endif()
  foreach(_kind original expanded)
    # Observe the earlier normal-path flag before the handler overwrites it.
    string(REGEX REPLACE "load r2,2" "itos r2\nsay r2\nload r2,2" _injected "${_${_kind}}")
    set(_product "${WORK}/catchall-${_point}-${_kind}")
    file(WRITE "${_product}.rxas" "${_injected}")
    run_checked("assemble paired ${_point} ${_kind}" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
    run_checked("execute paired ${_point} ${_kind}" "${VM}" "${_product}.rxbin")
    expect_output("${_expected}")
  endforeach()
endforeach()

# Queue ERROR and CANCEL in an ordinary signal-call activation, whose existing
# is_interrupt rule defers delivery until its RET. ERROR must win canonical
# priority and halt before the lower-priority CANCEL branch can handle it.
foreach(_kind original expanded)
  set(_injected "${_paired_${_kind}}")
  set(_queue "sighalt \"ERROR\"\nsigcall pending_pair(),\"OTHER\"\nsignal \"OTHER\"\n")
  if(_kind STREQUAL "original")
    string(REPLACE "call1 r1,checked_identity(),r0" "${_queue}call1 r1,checked_identity(),r0" _injected "${_injected}")
  else()
    string(REPLACE "cnop\n" "${_queue}cnop\n" _injected "${_injected}")
  endif()
  string(APPEND _injected "\npending_pair() .locals=0\nsignal \"CANCEL\"\nsignal \"ERROR\"\nret 0\n")
  set(_product "${WORK}/catchall-priority-${_kind}")
  file(WRITE "${_product}.rxas" "${_injected}")
  run_checked("assemble pending priority ${_kind}" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
  execute_process(COMMAND "${VM}" "${_product}.rxbin" RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 15)
  if(NOT _status MATCHES "^[1-9][0-9]*$" OR NOT _stderr MATCHES "SIGNAL ERROR[)]")
    message(FATAL_ERROR "Catch-all priority ${_kind}: ${_status}\n${_stdout}${_stderr}")
  endif()
endforeach()

# Reordered handwritten 29-tag negative control. Pop INVALID_SIGNAL_CODE first
# so a second CANCEL during handler restoration raises a repeated-pop error.
# Install an outer HALT for INVALID_SIGNAL_CODE in the paired runtime artifacts:
# the VM's default for that tag is IGNORE, which would otherwise loop. The
# first CANCEL enters before the selected call.
# The canonical G order above instead may re-enter repeatedly; no recovery is
# claimed for it, and no product policy/pop behavior is rewritten here.
string(REPLACE "  sigpush \"INVALID_SIGNAL_CODE\"\n" "" _reordered "${_paired_original}")
string(REPLACE "  sigbr caught,\"FAILURE\"" "  sigpush \"INVALID_SIGNAL_CODE\"\n  sigbr caught,\"FAILURE\"" _reordered "${_reordered}")
string(REPLACE "  sigpop \"INVALID_SIGNAL_CODE\"\n" "" _reordered "${_reordered}")
string(REPLACE "  sigpop \"OTHER\"" "  sigpop \"INVALID_SIGNAL_CODE\"\n  sigpop \"OTHER\"" _reordered "${_reordered}")
file(WRITE "${WORK}/catchall-reordered.rxas" "${_reordered}")
run_checked("expand reordered catch-all" "${VM}" "${CLI}" ${RUNTIME} -a --module catchall-reordered.rxas
  --profile closed-main-default-halt.v1 --no-cleanup -o "${WORK}/catchall-reordered-expanded.rxas" "${WORK}/catchall-reordered.rxas")
file(READ "${WORK}/catchall-reordered-expanded.rxas" _reordered_expanded)
expect_catch_policies("${_reordered}" "${_reordered_expanded}")
foreach(_kind original expanded)
  if(_kind STREQUAL "original")
    set(_injected "${_reordered}")
    string(REPLACE "call1 r1,checked_identity(),r0" "signal \"CANCEL\"\n  call1 r1,checked_identity(),r0" _injected "${_injected}")
  else()
    set(_injected "${_reordered_expanded}")
    string(REPLACE "cnop\n" "signal \"CANCEL\"\ncnop\n" _injected "${_injected}")
  endif()
  string(REPLACE "sigpush \"FAILURE\"" "sighalt \"INVALID_SIGNAL_CODE\"\nsigpush \"FAILURE\"" _injected "${_injected}")
  if(NOT _injected MATCHES "sighalt \"INVALID_SIGNAL_CODE\"[\n]sigpush \"FAILURE\"")
    message(FATAL_ERROR "Restoration negative lacks its explicit outer HALT policy")
  endif()
  string(REPLACE "sigpop \"INVALID_SIGNAL_CODE\"\n" "sigpop \"INVALID_SIGNAL_CODE\"\nsignal \"CANCEL\"\n" _injected "${_injected}")
  set(_product "${WORK}/catchall-restoration-${_kind}")
  file(WRITE "${_product}.rxas" "${_injected}")
  run_checked("assemble restoration negative ${_kind}" "${ASSEMBLER}" -n -o "${_product}" "${_product}.rxas")
  execute_process(COMMAND "${VM}" "${_product}.rxbin" RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 15)
  if(NOT _status MATCHES "^[1-9][0-9]*$" OR NOT _stderr MATCHES "SIGNAL INVALID_SIGNAL_CODE[)]")
    message(FATAL_ERROR "Catch-all restoration negative ${_kind}: ${_status}\n${_stdout}${_stderr}")
  endif()
endforeach()

set(_published "${WORK}/catchall-known-normal-cleanup.rxas")
file(READ "${_published}" _good)
execute_process(COMMAND "${VM}" "${CLI}" ${RUNTIME} -a --module catchall.rxas
  --profile closed-main-default-halt.v1 --work 1 -o "${_published}" "${WORK}/catchall-known-normal.rxas"
  RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 60)
file(READ "${_published}" _after)
if(_status EQUAL 0 OR NOT _after STREQUAL _good OR NOT _stderr MATCHES "LL_INLINE_LIMIT")
  message(FATAL_ERROR "Catch-all resource refusal did not preserve last-good output")
endif()
