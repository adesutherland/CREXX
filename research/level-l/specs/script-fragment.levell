/* An observed RexxScript profile; it is not Classic Rexx expression semantics. */
options levell
namespace scriptfragment
read: parser semantics ordered input tokens start document
identifier: token = 1
integer: token = 2
quoted: token = 3
assign: token = 4
semi: token = 5
plus: token = 6
minus: token = 7
times: token = 8
divide: token = 9
concat: token = 10
open: token = 11
close: token = 12
comma: token = 13
sayword: token = 20
classify: tokenstage start 1
clause.end: transform stage classify state 0 take semi emit copy next 1
clause.say: transform stage classify state 1 take identifier text 'SAY' unless next assign emit sayword next 2
clause.body: transform stage classify state 1 take any emit copy next 2
name: rule = identifier
number: rule = integer
string: rule = quoted
argument: rule = expression?
call: rule = name open argument (comma argument)* close
primary: rule = call | name | number | string
negative: rule = minus term
term: rule = negative | primary
operator: rule = plus | minus | times | divide | concat
operation: rule = operator term
abut: rule = primary
expression: rule = term (operation | abut)*
assignment: rule = name assign expression
say.statement: rule = sayword expression
statement: rule = say.statement | assignment
rest: rule = statement (semi+ rest?)?
document: rule = semi* rest?
