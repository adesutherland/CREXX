/* Complete TinyConfig section/comment extension; research consumer grammar. */
options levell
namespace tinyconfigsections
read: parser semantics ordered input bytes start document
letter: charset = U+0061 to U+007A | U+0041 to U+005A | U+005F
digit: charset = U+0030 to U+0039
blank: charset = U+0020 | U+0009 | U+000A | U+000D
quoted.byte: charset = U+0020 to U+0021 | U+0023 to U+005B | U+005D to U+007E
not.star: charset = U+0000 to U+0029 | U+002B to U+007F
not.star.slash: charset = U+0000 to U+0029 | U+002B to U+002E | U+0030 to U+007F
comment: rule = '/*' (not.star | '*'+ not.star.slash)* '*'+ '/'
space: rule = (blank | comment)*
name: rule = letter (letter | digit)*
number: rule = '-'? digit+
string: rule = '"' (quoted.byte | '\' ('"' | '\'))* '"'
boolean: rule = 'true' | 'false'
value: rule = number | string | array | boolean
array: rule = '[' space (value space (',' space value space)*)? ']'
binding: rule = name space '=' space value space ';'
section: rule = name space '{' space (entry space)* '}'
entry: rule = section | binding
document: rule = space (entry space)*
