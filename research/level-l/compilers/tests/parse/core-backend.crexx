/* cREXX License (MIT). Hand-built PARSE IR, independent of source frontend. */
options levelb
import rxfnsb
import llir
import llcir
import llcrxas
import llcparseprogram

main: procedure = .int
  arg argv = .string[]
  if argv[0] < 2 | argv[0] > 3 then return 2
  kind = 'ARG'; if argv[0] = 3 then kind = argv[3]
  if wordpos(kind,'ARG LINEIN SOURCE') = 0 then return 2
  statement = 'parse ' || lower(kind) || ' x'
  source = statement as .binary; statements = 1
  if kind = 'LINEIN' then do
    source = (statement || ('0A'x as .string) || 'parse linein y') as .binary
    statements = 2
  end
  registry = .llir..schema(); call llcir..registerfamilies(reference registry)
  contract = registry.finish(); builder = .llir..builder(contract)
  file = builder.source('core-parse-c',source); origin = file.origin(0,length(statement),'exact')
  fn = builder.function('$MAIN',contract.type('crexx.c.result'))
  call fn.exportas('parsecore.run')
  ignored = fn.argument(contract.type('crexx.c.context')); block = fn.block('entry')
  context = block.readarg(1,origin)
  operation = .llir..opdraft; acquired = .llir..opview; executed = .llir..opview
  loaded = .llir..opview; said = .llir..opview; absent = .llir..opview
  integer = .llir..intcodec(); ordinal = '0'; if kind = 'ARG' then ordinal = '1'
  do i = 1 to statements
    first = (i - 1) * (length(statement) + 1); last = first + length(statement)
    origin = file.origin(first,last,'exact'); target = 'x'; if i = 2 then target = 'y'
    packet = .llcparseprogram..builder('core-parse-c',source,1,0,last - 1,last,first + 1)
    call packet.target(target,last - 1,last); program = packet.bytes()
    if packet.error() <> '' then do; say packet.error(); return 1; end
    operation = block.operation(contract.operation('crexx.c.parse.source'),origin)
    call operation.input('context',context); call operation.attribute('kind',kind as .binary)
    call operation.attribute('ordinal',integer.parse(ordinal)); acquired = operation.finish()
    operation = block.operation(contract.operation('crexx.c.parse.execute'),origin)
    call operation.input('context',context); call operation.input('source',acquired.result())
    call operation.attribute('program',program); executed = operation.finish()
  end
  if kind <> 'LINEIN' then do
    operation = block.operation(contract.operation('crexx.c.load'),origin)
    call operation.input('context',context); call operation.attribute('name','x' as .binary)
    loaded = operation.finish()
    operation = block.operation(contract.operation('crexx.c.say'),origin)
    call operation.input('value',loaded.result()); said = operation.finish()
  end
  operation = block.operation(contract.operation('crexx.c.return.absent'),origin)
  absent = operation.finish(); call block.returnvalue(absent.result(),origin)
  graph = builder.finish()
  if graph.error() <> '' then do; say graph.error(); return 1; end
  saved = graph.binary()
  selected = .llcrxas..compilation(graph,argv[1]); output = selected.output()
  if selected.status() <> 0 then do; say selected.error(); return 1; end
  if bin2x(saved) <> bin2x(graph.binary()) then return 1
  if writebinary(argv[2],output.text() as .binary) <> output.bytes() then return 1
  return 0
