/* cREXX License (MIT). Independent all-record C PARSE trust-boundary checks. */
options levelb
import rxfnsb
import llir
import llcir
import llcrxas
import llcparseprogram

main: procedure = .int expose checks failures inspection emission_requests emission_finished inspection_imports
  arg argv = .string[]
  argc = argv[0]; inspection = ''; emission_requests = 0; emission_finished = 0
  if argc = 3 then do
    if argv[2] \== 'emit-only' | argv[3] == '' then return 2
    inspection = argv[3]; argc = 1
  end
  if argc <> 1 then return 2
  inspection_imports = argv[1]
  checks = 0; failures = 0
  do mode = 1 to 13
    call fixture(argv[1],mode)
  end
  if inspection <> '' then do
    expected = 13 * 2
    call check(emission_requests = expected & emission_finished = expected,'complete parse-admission emission inventory')
    say 'EMISSION|owner=PARSE_ADMISSION|requests=' || emission_requests || '|finished=' || emission_finished || '|failures=' || failures
  end
  say 'PARSE_ADMISSION|checks=' || checks || '|failures=' || failures
  return failures

check: procedure = .void expose checks failures
  arg passed = .int, label = .string
  checks = checks + 1
  if passed then return
  failures = failures + 1; say 'FAIL|' || label
  return

fixture: procedure = .void
  arg artifacts = .string, mode = .int
  operation = .llir..opdraft; absent = .llir..opview
  source = 'parse arg x' as .binary; name = 'x'; clause = 1
  if mode = 3 then name = '1invalid'
  if mode = 4 then clause = 2
  packet = .llcparseprogram..builder('admission-c',source,1,0,10,11,clause)
  call packet.target(name,10,11); program = packet.bytes()
  call check(packet.error() = '', 'independent packet constructed ' || mode)
  if mode = 2 then <at..u8>(4) program = 2
  registry = .llir..schema(); call llcir..registerfamilies(reference registry)
  contract = registry.finish(); builder = .llir..builder(contract)
  file = .llir..sourcefile; origin = .llir..origin
  if mode >= 12 then do
    file = builder.source('admission-c',''x as .binary); origin = file.origin(0,0,'synthetic')
  end
  else do; file = builder.source('admission-c',source); origin = file.origin(0,11); end
  if mode = 5 then origin = file.origin(0,10)
  fn = builder.function('$MAIN',contract.type('crexx.c.result'))
  type = contract.type('crexx.c.context'); if mode = 11 then type = contract.type('crexx.c.parseprogram')
  ignored = fn.argument(type)
  ignored = fn.argument(contract.type('crexx.g.int64')); entry = fn.block('entry'); block = entry
  context_slot = fn.slot('$context',contract.type('crexx.c.context'))
  generated = builder.synthetic('test-only PARSE admission unit entry')
  if mode <> 11 then do
    call entry.store(context_slot,entry.readarg(1,generated),generated)
    entry = entrybody(fn,contract,entry,context_slot,generated); block = entry
  end
  if mode > 1 then do
    operation = entry.operation(contract.operation('crexx.c.return.absent'),origin)
    absent = operation.finish(); call entry.returnvalue(absent.result(),origin)
    block = fn.block('dead')
  end
  context = .llir..valuehandle
  if mode <> 11 then context = block.load(context_slot,origin)
  if mode = 9 then unused = block.constantbytes(contract.type('crexx.c.parseprogram'),program,origin)
  else if mode = 10 then slot = fn.slot('forbidden program',contract.type('crexx.c.parseprogram'))
  else if mode >= 6 & mode <= 8 then do
    kind = 'ARG'; ordinal = '1'
    if mode = 6 then kind = 'EXTERNAL'
    if mode = 7 then ordinal = '0'
    if mode = 8 then kind = 'SOURCE'
    operation = block.operation(contract.operation('crexx.c.parse.source'),origin)
    call operation.input('context',context); call operation.attribute('kind',kind as .binary)
    integer = .llir..intcodec(); call operation.attribute('ordinal',integer.parse(ordinal))
    acquired = operation.finish()
  end
  else if mode <> 11 then do
    value = block.constantbytes(contract.type('crexx.c.value'),'held source' as .binary,origin)
    operation = block.operation(contract.operation('crexx.c.parse.execute'),origin)
    call operation.input('context',context); call operation.input('source',value)
    call operation.attribute('program',program); executed = operation.finish()
    if mode = 13 then do
      /* Retained origins still identify one owning instruction when original
       * bytes are absent. Two individually valid packets cannot disagree. */
      packet = .llcparseprogram..builder('admission-c',source,2,0,10,11,2)
      call packet.target(name,10,11); program = packet.bytes()
      operation = block.operation(contract.operation('crexx.c.parse.execute'),origin)
      call operation.input('context',context); call operation.input('source',value)
      call operation.attribute('program',program); executed = operation.finish()
    end
  end
  operation = block.operation(contract.operation('crexx.c.return.absent'),origin)
  absent = operation.finish(); call block.returnvalue(absent.result(),origin)
  graph = builder.finish(); saved = graph.binary()
  call check(graph.error() = '', 'generic-valid dead/fresh fixture ' || mode || ': ' || graph.error())
  restored = llir..loadbinary(contract,saved)
  call check(restored.error() = '' & bin2x(restored.binary()) = bin2x(saved),'loaded packet round trip ' || mode)
  call admitted(artifacts,graph,mode,'fresh')
  call admitted(artifacts,restored,mode,'loaded')
  return

admitted: procedure = .void
  arg artifacts = .string, graph = .llir..module, mode = .int, lane = .string
  caseid = 'parse-admission.' || lane || '-' || mode
  call emissionstart(caseid)
  saved = graph.binary(); backend = .llcrxas..compilation(graph,artifacts); output = backend.output()
  call emissionfinish(caseid,reference graph,reference output,mode = 1 | mode = 12,backend.status(),backend.error())
  if mode = 1 | mode = 12 then call check(backend.status() = 0 & output.bytes() > 0,lane || ' valid program admitted: ' || backend.error())
  else do
    expected = 'PARSE'
    if mode = 3 then expected = 'invalid variable symbol'
    if mode = 9 then expected = 'unsupported constant type'
    if mode = 10 then expected = 'runtime slot'
    if mode = 11 then expected = 'parameter ABI'
    if mode = 13 then expected = 'conflicting clause keys'
    call check(backend.status() <> 0 & output.bytes() = 0 & pos(expected,backend.error()) > 0,lane || ' dead malformed input refused ' || mode || ': ' || backend.error())
  end
  call check(bin2x(saved) = bin2x(graph.binary()),lane || ' admission is immutable ' || mode)
  return

/* Test-only canonical C unit entry. The caller declares both arguments before
 * creating setup and binds argument 1 to the canonical context slot. Keep slot
 * reads in a separate dispatch block so local forwarding preserves them. */
entrybody: procedure = .llir..block
  arg fn = .llir..function, contract = .llir..contract, setup = .llir..block, context = .llir..slot, at = .llir..origin
  entry = fn.slot('$entry',contract.type('crexx.g.int64'))
  call setup.store(entry,setup.readarg(2,at),at)
  dispatch = fn.block('dispatch.0'); body = fn.block('source.body'); invalid = fn.block('entry.invalid')
  call setup.jump(dispatch,at)
  draft = dispatch.operation(contract.operation('crexx.c.entry.test'),at)
  call draft.input('context',dispatch.load(context,at)); call draft.input('entry',dispatch.load(entry,at))
  integer = .llir..intcodec()
  call draft.attribute('id',integer.parse('0')); call draft.attribute('name',''x as .binary)
  operation = draft.finish(); call dispatch.branch(operation.result(),body,invalid,at)
  draft = invalid.operation(contract.operation('crexx.c.entry.invalid'),at); operation = draft.finish()
  draft = invalid.operation(contract.operation('crexx.c.return.absent'),at); operation = draft.finish()
  call invalid.returnvalue(operation.result(),at)
  return body

emissionstart: procedure = .void expose inspection emission_requests
  arg caseid = .string
  if inspection == '' then return
  emission_requests = emission_requests + 1
  say 'START|' || caseid
  return

emissionfinish: procedure = .void expose inspection emission_finished inspection_imports
  arg caseid = .string, graph_ref = reference .llir..module, output_ref = reference .llir..output, expected = .int, status = .int, diagnostic = .string, bytes = 67108864, registers = 65536
  if inspection == '' then return
  graph = dereference graph_ref; output = dereference output_ref
  say 'REQUEST|' || caseid || '|imports=' || inspection_imports || '|output.bytes=' || (bytes as .string) || '|registers=' || (registers as .string)
  call check(graph.error() == '',caseid || ' inspection graph is frozen and valid')
  if graph.error() <> '' then return
  image = graph.binary()
  written = writebinary(inspection || '/' || caseid || '.llir',image) = <blen>(image)
  call check(written,caseid || ' exact temporary graph export')
  if written = 0 then return
  if expected then do
    call check(status = 0 & output.bytes() > 0,caseid || ' inspection requires accepted output: ' || diagnostic)
    if status <> 0 | output.bytes() = 0 then return
    text = output.text() as .binary
    written = writebinary(inspection || '/' || caseid || '.rxas',text) = output.bytes()
    call check(written,caseid || ' exact temporary RXAS export')
    if written = 0 then return
    say 'EMITTED|' || caseid
  end
  else do
    call check(status <> 0 & output.bytes() = 0,caseid || ' inspection refusal has no output')
    if status = 0 | output.bytes() <> 0 then return
    say 'REFUSAL|' || caseid || '|' || diagnostic
  end
  emission_finished = emission_finished + 1
  return
