/* cREXX License (MIT). Independent all-record C PARSE trust-boundary checks. */
options levelb
import rxfnsb
import llir
import llcir
import llcrxas
import llcparseprogram

main: procedure = .int expose checks failures
  arg argv = .string[]
  if argv[0] <> 1 then return 2
  checks = 0; failures = 0
  do mode = 1 to 13
    call fixture(argv[1],mode)
  end
  say 'PARSE_ADMISSION|checks=' || checks || '|failures=' || failures
  return failures

check: procedure = .void expose checks failures
  arg passed = .int, label = .string
  checks = checks + 1
  if passed then return
  failures = failures + 1; say 'FAIL|' || label
  return

fixture: procedure = .void
  arg artifacts = .string, mode = .int
  operation = .llir..opdraft; absent = .llir..opview
  source = 'parse arg x' as .binary; name = 'x'; clause = 1
  if mode = 3 then name = '1invalid'
  if mode = 4 then clause = 2
  packet = .llcparseprogram..builder('admission-c',source,1,0,10,11,clause)
  call packet.target(name,10,11); program = packet.bytes()
  call check(packet.error() = '', 'independent packet constructed ' || mode)
  if mode = 2 then <at..u8>(4) program = 2
  registry = .llir..schema(); call llcir..registerfamilies(reference registry)
  contract = registry.finish(); builder = .llir..builder(contract)
  file = .llir..sourcefile; origin = .llir..origin
  if mode >= 12 then do
    file = builder.source('admission-c',''x as .binary); origin = file.origin(0,0,'synthetic')
  end
  else do; file = builder.source('admission-c',source); origin = file.origin(0,11); end
  if mode = 5 then origin = file.origin(0,10)
  fn = builder.function('$MAIN',contract.type('crexx.c.result'))
  type = contract.type('crexx.c.context'); if mode = 11 then type = contract.type('crexx.c.parseprogram')
  ignored = fn.argument(type); entry = fn.block('entry'); block = entry
  if mode > 1 then do
    operation = entry.operation(contract.operation('crexx.c.return.absent'),origin)
    absent = operation.finish(); call entry.returnvalue(absent.result(),origin)
    block = fn.block('dead')
  end
  context = block.readarg(1,origin)
  if mode = 9 then unused = block.constantbytes(contract.type('crexx.c.parseprogram'),program,origin)
  else if mode = 10 then slot = fn.slot('forbidden program',contract.type('crexx.c.parseprogram'))
  else if mode >= 6 & mode <= 8 then do
    kind = 'ARG'; ordinal = '1'
    if mode = 6 then kind = 'EXTERNAL'
    if mode = 7 then ordinal = '0'
    if mode = 8 then kind = 'SOURCE'
    operation = block.operation(contract.operation('crexx.c.parse.source'),origin)
    call operation.input('context',context); call operation.attribute('kind',kind as .binary)
    integer = .llir..intcodec(); call operation.attribute('ordinal',integer.parse(ordinal))
    acquired = operation.finish()
  end
  else if mode <> 11 then do
    value = block.constantbytes(contract.type('crexx.c.value'),'held source' as .binary,origin)
    operation = block.operation(contract.operation('crexx.c.parse.execute'),origin)
    call operation.input('context',context); call operation.input('source',value)
    call operation.attribute('program',program); executed = operation.finish()
    if mode = 13 then do
      /* Retained origins still identify one owning instruction when original
       * bytes are absent. Two individually valid packets cannot disagree. */
      packet = .llcparseprogram..builder('admission-c',source,2,0,10,11,2)
      call packet.target(name,10,11); program = packet.bytes()
      operation = block.operation(contract.operation('crexx.c.parse.execute'),origin)
      call operation.input('context',context); call operation.input('source',value)
      call operation.attribute('program',program); executed = operation.finish()
    end
  end
  operation = block.operation(contract.operation('crexx.c.return.absent'),origin)
  absent = operation.finish(); call block.returnvalue(absent.result(),origin)
  graph = builder.finish(); saved = graph.binary()
  call check(graph.error() = '', 'generic-valid dead/fresh fixture ' || mode || ': ' || graph.error())
  restored = llir..loadbinary(contract,saved)
  call check(restored.error() = '' & bin2x(restored.binary()) = bin2x(saved),'loaded packet round trip ' || mode)
  call admitted(artifacts,graph,mode,'fresh')
  call admitted(artifacts,restored,mode,'loaded')
  return

admitted: procedure = .void
  arg artifacts = .string, graph = .llir..module, mode = .int, lane = .string
  saved = graph.binary(); backend = .llcrxas..compilation(graph,artifacts); output = backend.output()
  if mode = 1 | mode = 12 then call check(backend.status() = 0 & output.bytes() > 0,lane || ' valid program admitted: ' || backend.error())
  else do
    expected = 'PARSE'
    if mode = 3 then expected = 'invalid variable symbol'
    if mode = 9 then expected = 'unsupported constant type'
    if mode = 10 then expected = 'runtime slot'
    if mode = 11 then expected = 'parameter ABI'
    if mode = 13 then expected = 'conflicting clause keys'
    call check(backend.status() <> 0 & output.bytes() = 0 & pos(expected,backend.error()) > 0,lane || ' dead malformed input refused ' || mode || ': ' || backend.error())
  end
  call check(bin2x(saved) = bin2x(graph.binary()),lane || ' admission is immutable ' || mode)
  return
