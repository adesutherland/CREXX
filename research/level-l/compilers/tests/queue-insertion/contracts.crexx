/* cREXX License (MIT). Independent selected-queue insertion admission oracles. */
options levelb
import rxfnsb
import llir
import llcir
import llcrxas

main: procedure = .int expose checks failures
  arg argv = .string[]
  if argv[0] <> 2 then return 2
  instruction = argv[2]
  if instruction \== 'PUSH' & instruction \== 'QUEUE' then return 2
  checks = 0; failures = 0
  registry = .llir..schema(); call llcir..registerfamilies(reference registry)
  contract = registry.finish()
  call schema(contract,instruction)
  mode = .int; graph = .llir..module; loaded = .llir..module
  diagnostic = .string
  do mode = 1 to 3
    graph = fixture(contract,mode,instruction)
    call check(graph.error() == '', 'generic ' || instruction || ' fixture ' || mode || ': ' || graph.error())
    if graph.error() <> '' then iterate
    diagnostic = ''
    if mode = 2 then diagnostic = 'LL_COMPILER_LOWERING: entry dispatch uses a different bound slot'
    if mode = 3 then diagnostic = 'LL_COMPILER_LOWERING: ' || instruction || ' requires an owned exact source origin'
    call admission(argv[1],graph,mode = 1,instruction || ' fresh ' || mode,diagnostic,mode = 1)
    loaded = loadgraph(reference graph)
    call check(loaded.error() == '' & bincompare(graph.binary(),loaded.binary()) = 0,'loaded ' || instruction || ' fixture ' || mode || ': ' || loaded.error())
    if loaded.error() == '' then call admission(argv[1],loaded,mode = 1,instruction || ' loaded ' || mode,diagnostic)
  end
  stale = stalecontract(contract); graph = fixture(stale,1,instruction)
  call check(graph.error() == '', 'generic stale C13 graph: ' || graph.error())
  if graph.error() == '' then do
    diagnostic = 'unsupported family version crexx.c'
    call admission(argv[1],graph,0,'fresh C13',diagnostic)
    loaded = loadgraph(reference graph)
    call check(loaded.error() == '', 'loaded stale C13 graph: ' || loaded.error())
    if loaded.error() == '' then call admission(argv[1],loaded,0,'loaded C13',diagnostic)
  end
  say instruction || '_CONTRACTS|checks=' || checks || '|failures=' || failures
  return failures

check: procedure = .void expose checks failures
  arg passed = .int, label = .string
  checks = checks + 1
  if passed then return
  failures = failures + 1; say 'FAIL|' || label
  return

schema: procedure = .void
  arg contract = .llir..contract, instruction = .string
  data = dereference contract.data()
  version = 0; count = 0; i = .int
  do i = 1 to data.familycount()
    if data.familyname(i) = 'crexx.c' then version = data.version(i)
  end
  do i = 1 to data.types()
    if left(data.typename(i),8) = 'crexx.c.' then count = count + 1
  end
  call check(version = 16 & count = 5 & data.ops() = 73,'exact C16/five-type/73-operation contract')
  call check(data.opname(64) == 'crexx.c.push' & data.opname(65) == 'crexx.c.queue','append-only PUSH and QUEUE operation order')
  descriptor = contract.operation('crexx.c.' || lower(instruction)); id = descriptor.id()
  call check(descriptor.valid(),instruction || ' descriptor exists')
  call check(data.arity(id,1) = 2 & data.fieldname(id,1,1) == 'value' & data.typename(data.fieldtype(id,1,1)) == 'crexx.c.value',instruction || ' first input is value:V')
  call check(data.fieldname(id,1,2) == 'context' & data.typename(data.fieldtype(id,1,2)) == 'crexx.c.context',instruction || ' second input is context:C')
  call check(data.arity(id,2) = 0 & data.arity(id,3) = 0,instruction || ' has no result or attributes')
  call check(data.effectvalue(id,1) == 'context.output' & data.effectvalue(id,2) == 'condition.resource' & data.effectvalue(id,3) == 'returns',instruction || ' declares its complete contextual effects')
  service = data.callback(id,1)
  call check((service is .llir..evaluator) = 0,instruction || ' has no pure evaluator')
  return

/* Preserve every current declaration, changing only the semantic family
 * version. This refuses C13 independently of unused descriptor/body shape. */
stalecontract: procedure = .llir..contract
  arg canonical = .llir..contract
  source = dereference canonical.data(); data = .llir..schema_data()
  call data.bootstrap()
  i = .int; kind = .int; field = .int; ignored = .int
  do i = 2 to source.familycount()
    version = source.version(i)
    if source.familyname(i) == 'crexx.c' then version = 13
    ignored = data.addfamily(source.familyname(i),version)
  end
  do i = 3 to source.types()
    ignored = data.addtype(source.typename(i),source.codec(i))
  end
  do i = 1 to source.ops()
    declared = .llir..operation(reference data,data.addop(source.opname(i)))
    do kind = 1 to 3
      do field = 1 to source.arity(i,kind)
        spelling = source.fieldname(i,kind,field)
        type = .llir..typeid(data.identity(),source.fieldtype(i,kind,field))
        if kind = 1 then call declared.input(spelling,type)
        else if kind = 2 then call declared.output(spelling,type)
        else call declared.attribute(spelling,type)
      end
    end
    call declared.state(source.effectvalue(i,1)); call declared.failure(source.effectvalue(i,2))
    call declared.termination(source.effectvalue(i,3))
  end
  ignored = data.freeze()
  return .llir..contract(data)

loadgraph: procedure = .llir..module
  arg graph_ref = reference .llir..module
  graph = dereference graph_ref
  storage = dereference graph.storage(); contract = dereference storage.contract()
  return llir..loadbinary(contract,graph.binary())

admission: procedure = .void
  arg artifacts = .string, graph = .llir..module, accepted = .int, label = .string, diagnostic = '', limitcontrol = 0
  saved = graph.binary(); selected = .llcrxas..compilation(graph,artifacts); output = selected.output()
  if accepted then call check(selected.status() = 0 & output.bytes() > 0,label || ' admits canonical insertion: ' || selected.error())
  else call check(selected.status() <> 0 & output.bytes() = 0,label || ' refuses atomically: ' || selected.error())
  if diagnostic <> '' then call check(pos(diagnostic,selected.error()) > 0,label || ' retains its specific cause: ' || selected.error())
  call check(bincompare(saved,graph.binary()) = 0,label || ' preserves the input graph')
  if limitcontrol & accepted & selected.status() = 0 then do
    previous = output.text()
    limited = .llcrxas..compilation(graph,artifacts,128); empty = limited.output()
    call check(limited.status() <> 0 & pos('LL_COMPILER_LIMIT:',limited.error()) > 0 & empty.bytes() = 0,'bounded refusal publishes no partial insertion output')
    call check(output.text() == previous & bincompare(saved,graph.binary()) = 0,'bounded refusal preserves prior owned output and graph')
  end
  return

/* Only three variants are needed here. The second slot is once-bound and
 * typed correctly, but is not the canonical context selected by entry setup.
 * The third insertion is detached so exact-origin admission cannot rely on reach. */
fixture: procedure = .llir..module
  arg contract = .llir..contract, mode = .int, instruction = .string
  builder = .llir..builder(contract)
  name = lower(instruction); source = (name || " 'x'") as .binary
  file = builder.source(name || '-ir.crexx',source)
  authored = file.origin(0,<blen>(source)); generated = builder.synthetic('independent insertion dispatch')
  fn = builder.function('$MAIN',contract.type('crexx.c.result'))
  ignored = fn.argument(contract.type('crexx.c.context'))
  ignored = fn.argument(contract.type('crexx.g.int64'))
  context_slot = fn.slot('$context',contract.type('crexx.c.context'))
  entry_slot = fn.slot('$entry',contract.type('crexx.g.int64'))
  alternate = fn.slot('substituted context',contract.type('crexx.c.context'))
  setup = fn.block('entry'); dispatch = fn.block('dispatch'); body = fn.block('body'); invalid = fn.block('invalid')
  call setup.store(context_slot,setup.readarg(1,generated),generated)
  if mode = 2 then call setup.store(alternate,setup.readarg(1,generated),generated)
  call setup.store(entry_slot,setup.readarg(2,generated),generated)
  call setup.jump(dispatch,generated)
  draft = dispatch.operation(contract.operation('crexx.c.entry.test'),generated)
  call draft.input('context',dispatch.load(context_slot,generated)); call draft.input('entry',dispatch.load(entry_slot,generated))
  integer = .llir..intcodec()
  call draft.attribute('id',integer.parse('0')); call draft.attribute('name',''x)
  tested = draft.finish(); call dispatch.branch(tested.result(),body,invalid,generated)
  draft = invalid.operation(contract.operation('crexx.c.entry.invalid'),generated); finished = draft.finish()
  call absent(invalid,contract,generated)
  context = body.load(context_slot,authored)
  draft = body.operation(contract.operation('crexx.c.procedure.consume'),authored)
  call draft.input('context',context); finished = draft.finish()
  if mode = 3 then do
    call absent(body,contract,authored)
    body = fn.block('dead insertion')
  end
  context = body.load(context_slot,authored)
  if mode = 2 then context = body.load(alternate,authored)
  value = body.constantbytes(contract.type('crexx.c.value'),'x' as .binary,authored)
  origin = authored; if mode = 3 then origin = generated
  draft = body.operation(contract.operation('crexx.c.' || name),origin)
  call draft.input('value',value); call draft.input('context',context); finished = draft.finish()
  call absent(body,contract,authored)
  return builder.finish()

absent: procedure = .void
  arg block = .llir..block, contract = .llir..contract, origin = .llir..origin
  draft = block.operation(contract.operation('crexx.c.return.absent'),origin)
  finished = draft.finish(); call block.returnvalue(finished.result(),origin)
  return
