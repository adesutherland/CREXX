/* cREXX License (MIT). Independent PROCEDURE AST/schema/IR admission oracles. */
options levelb
import rxfnsb
import llir
import llirservices
import llcir
import llcparse
import llcprocedureprotocol
import llcrxas

main: procedure = .int expose checks failures inspection emission_requests emission_finished
  arg argv = .string[]
  argc = argv[0]; inspection = ''; emission_requests = 0; emission_finished = 0
  if argc = 3 then do
    if argv[2] \== 'emit-only' | argv[3] == '' then return 2
    inspection = argv[3]; argc = 1
  end
  if argc <> 1 then return 2
  checks = 0; failures = 0
  mode = .int; graph = .llir..module
  call astcontract()
  call schemacontract()
  call noemission('procedure.source-schema')
  do mode = 1 to 6
    call forgedschema(argv[1],mode)
  end
  do mode = 1 to 30
    graph = fixture(mode)
    call check(graph.error() = '', 'generic fixture ' || mode || ': ' || graph.error())
    if graph.error() <> '' then iterate
    accepted = mode = 1 | mode = 2 | mode = 11 | mode = 17 | mode = 29
    diagnostic = ''
    if mode = 13 | mode = 14 then diagnostic = 'call entry is not a positive declared ID'
    call admission(argv[1],graph,accepted,'fresh ' || mode,diagnostic)
    store = dereference graph.storage(); contract = dereference store.contract()
    restored = llir..loadbinary(contract,graph.binary())
    call check(restored.error() = '' & bincompare(graph.binary(),restored.binary()) = 0,'loaded fixture ' || mode)
    if restored.error() = '' then call admission(argv[1],restored,accepted,'loaded ' || mode,diagnostic)
    if mode <= 2 | mode = 17 then do
      changed = llirservices..optimise(reference graph)
      call check(changed.status() = 'keep' | changed.status() = 'changed','generic optimisation ' || mode)
      if changed.status() = 'keep' | changed.status() = 'changed' then call admission(argv[1],changed.result(),1,'transformed ' || mode)
    end
  end
  call expansioncontracts()
  graph = fixture(1); saved = graph.binary()
  call emissionstart('procedure.prior-output')
  selected = .llcrxas..compilation(graph,argv[1]); previous = selected.output(); previous_text = previous.text()
  call emissionfinish('procedure.prior-output',reference graph,reference previous,1,selected.status(),selected.error())
  call check(selected.status() = 0 & previous.bytes() > 0,'owned output before limit control: ' || selected.error())
  call emissionstart('procedure.limited-output')
  limited = .llcrxas..compilation(graph,argv[1],128); output = limited.output()
  call emissionfinish('procedure.limited-output',reference graph,reference output,0,limited.status(),limited.error())
  call check(limited.status() <> 0 & pos('LIMIT',limited.error()) > 0 & output.bytes() = 0,'bounded output refusal is empty')
  call check(bincompare(saved,graph.binary()) = 0 & previous.text() == previous_text,'limit refusal preserves graph and previous owned output')
  if inspection <> '' then do
    expected = 6 + 30 * 2 + 3 + 2 + 1 + 15 * 2 + 2
    call check(emission_requests = expected & emission_finished = expected,'complete explicit PROCEDURE emission inventory')
    say 'PROCEDURE_EMISSION|requests=' || emission_requests || '|complete=' || emission_finished || '|failures=' || failures
  end
  else say 'PROCEDURE_CONTRACTS|checks=' || checks || '|failures=' || failures
  return failures

check: procedure = .void expose checks failures
  arg passed = .int, label = .string
  checks = checks + 1
  if passed then return
  failures = failures + 1
  say 'FAIL|' || label
  return

astcontract: procedure = .void
  source = 'p: procedure expose α a.key (names)' as .binary
  parsed = .llcparse..parsed(source)
  call check(parsed.status() = 0,'direct/indirect Unicode source parses: ' || parsed.error())
  if parsed.status() <> 0 then return
  tree = parsed.ast(); node = tree.root().child('body').child('items',2)
  call check(node.kind() = 'CProcedure' & node.start() = 3 & node.finish() = 36,'complete PROCEDURE byte span')
  exposes = node.child('exposes')
  call check(exposes.kind() = 'ProcedureExposes' & exposes.count('items') = 3 & exposes.start() = 13 & exposes.finish() = 36,'ordered exposure list retains keyword and complete span')
  direct = exposes.child('items',1); compound = exposes.child('items',2); indirect = exposes.child('items',3)
  call check(direct.kind() = 'ProcedureExposeDirect' & direct.child('name').text('spelling') = 'α','first direct name retains Unicode spelling')
  call check(direct.child('name').start() = 20 & direct.child('name').finish() = 22,'UTF8 name byte span is distinct from scalar length')
  call check(compound.kind() = 'ProcedureExposeDirect' & compound.child('name').text('spelling') = 'a.key','compound remains a raw name')
  call check(indirect.kind() = 'ProcedureExposeIndirect' & indirect.child('name').text('spelling') = 'names','indirect carrier retained as raw name')
  call check(indirect.start() = 29 & indirect.finish() = 36 & indirect.child('name').start() = 30 & indirect.child('name').finish() = 35,'indirect item includes parentheses; Name does not')
  bare = .llcparse..parsed('p: procedure' as .binary)
  call check(bare.status() = 0,'bare PROCEDURE parses')
  if bare.status() = 0 then do
    plain = bare.ast().root().child('body').child('items',2)
    call check(plain.count('exposes') = 0,'bare PROCEDURE has no invented empty list')
  end
  return

schemacontract: procedure = .void
  registry = .llir..schema(); call llcir..registerfamilies(reference registry)
  contract = registry.finish(); data = dereference contract.data()
  version = 0; count = 0; i = .int
  do i = 1 to data.familycount()
    if data.familyname(i) = 'crexx.c' then version = data.version(i)
  end
  do i = 1 to data.types()
    if left(data.typename(i),8) = 'crexx.c.' then count = count + 1
  end
  call check(version = 24 & data.ops() = 97 & count = 5,'exact current C24/97-operation/five-type contract')
  names = 'entry.test entry.invalid procedure.consume procedure.enter procedure.expose'
  do i = 1 to 5
    call check(data.opname(53 + i) = 'crexx.c.' || word(names,i),'append-only operation order ' || i)
  end
  call shape(contract,'entry.test','context:crexx.c.context entry:crexx.g.int64','value:core.boolean','id:crexx.g.int64 name:crexx.g.text','context','condition','returns')
  call shape(contract,'entry.invalid','','','','none','condition','diverges')
  call shape(contract,'procedure.consume','context:crexx.c.context','','','context','condition','returns')
  call shape(contract,'procedure.enter','context:crexx.c.context','','','context','condition.resource','returns')
  call shape(contract,'procedure.expose','context:crexx.c.context','','name:crexx.g.text indirect:core.boolean','context','condition.resource','returns')
  call shape(contract,'call','arguments:crexx.c.arguments context:crexx.c.context','value:crexx.c.result','target:crexx.g.text entry:crexx.g.int64 function:core.boolean','context.output','condition','returns')
  return

shape: procedure = .void
  arg contract = .llir..contract, name = .string, inputs = .string, outputs = .string, attributes = .string, state = .string, failure = .string, termination = .string
  data = dereference contract.data(); descriptor = contract.operation('crexx.c.' || name); id = descriptor.id()
  do kind = 1 to 3
    expected = inputs
    if kind = 2 then expected = outputs
    if kind = 3 then expected = attributes
    call check(data.arity(id,kind) = words(expected),name || ' field count ' || kind)
    do field = 1 to words(expected)
      actual = data.fieldname(id,kind,field) || ':' || data.typename(data.fieldtype(id,kind,field))
      call check(actual = word(expected,field),name || ' ordered field ' || kind || '/' || field)
    end
  end
  call check(data.effectvalue(id,1) = state & data.effectvalue(id,2) = failure & data.effectvalue(id,3) = termination,name || ' effects/failure/termination')
  return

/* A changed unused declaration must fail before instruction reachability. */
forgedschema: procedure = .void
  arg artifacts = .string, mode = .int
  registry = .llir..schema(); call llcir..registerfamilies(reference registry)
  canonical = registry.finish(); source = dereference canonical.data()
  data = .llir..schema_data(); call data.bootstrap()
  ignored = .int; i = .int; kind = .int; field = .int
  do i = 2 to source.familycount()
    version = source.version(i)
    if mode = 1 & source.familyname(i) = 'crexx.c' then version = 11
    ignored = data.addfamily(source.familyname(i),version)
  end
  do i = 3 to source.types()
    ignored = data.addtype(source.typename(i),source.codec(i))
  end
  do i = 1 to source.ops()
    name = source.opname(i)
    declared = .llir..operation(reference data,data.addop(name))
    do kind = 1 to 3
      do field = 1 to source.arity(i,kind)
        spelling = source.fieldname(i,kind,field)
        if mode = 4 & name = 'crexx.c.procedure.expose' & kind = 3 & field = 1 then spelling = 'wrongname'
        type = .llir..typeid(data.identity(),source.fieldtype(i,kind,field))
        if kind = 1 then call declared.input(spelling,type)
        else if kind = 2 then call declared.output(spelling,type)
        else call declared.attribute(spelling,type)
      end
    end
    state = source.effectvalue(i,1); failure = source.effectvalue(i,2); termination = source.effectvalue(i,3)
    if mode = 2 & name = 'crexx.c.procedure.enter' then state = 'none'
    if mode = 3 & name = 'crexx.c.procedure.expose' then failure = 'none'
    if mode = 5 & name = 'crexx.c.entry.invalid' then termination = 'returns'
    if mode = 6 & name = 'crexx.c.entry.test' then state = 'none'
    call declared.state(state); call declared.failure(failure); call declared.termination(termination)
  end
  ignored = data.freeze(); contract = .llir..contract(data)
  builder = .llir..builder(contract); at = builder.synthetic('unused schema declaration')
  fn = builder.function('$MAIN',contract.type('crexx.c.result'))
  ignored = fn.argument(contract.type('crexx.c.context')); ignored = fn.argument(contract.type('crexx.g.int64'))
  block = fn.block('entry'); call absent(block,contract,at)
  graph = builder.finish(); saved = graph.binary()
  call check(graph.error() = '', 'generic forged schema ' || mode)
  call emissionstart('procedure.unused-schema-' || mode)
  backend = .llcrxas..compilation(graph,artifacts); output = backend.output()
  call emissionfinish('procedure.unused-schema-' || mode,reference graph,reference output,0,backend.status(),backend.error())
  diagnostic = 'incompatible operation'
  if mode = 1 then diagnostic = 'unsupported family version crexx.c'
  call check(backend.status() <> 0 & output.bytes() = 0 & pos(diagnostic,backend.error()) > 0,'changed unused descriptor/version refuses before body protocol ' || mode || ': ' || backend.error())
  call check(bincompare(saved,graph.binary()) = 0,'schema refusal preserves original graph ' || mode)
  return

admission: procedure = .void
  arg artifacts = .string, graph = .llir..module, accepted = .int, label = .string, diagnostic = ''
  caseid = 'procedure.' || changestr(' ',label,'-'); call emissionstart(caseid)
  saved = graph.binary(); backend = .llcrxas..compilation(graph,artifacts); output = backend.output()
  call emissionfinish(caseid,reference graph,reference output,accepted,backend.status(),backend.error())
  if accepted then call check(backend.status() = 0 & output.bytes() > 0,label || ' admitted: ' || backend.error())
  else call check(backend.status() <> 0 & output.bytes() = 0,label || ' refuses malformed protocol: ' || backend.error())
  if diagnostic <> '' then call check(pos(diagnostic,backend.error()) > 0,label || ' retains its specific refusal: ' || backend.error())
  call check(bincompare(saved,graph.binary()) = 0,label || ' preserves input')
  return

/** INTERPRET may retain Fresh but cannot recreate it after consume. The raw
 * fixtures isolate that proof from selector, runtime and source validation. */
expansioncontracts: procedure = .void
  graph = .llir..module; mode = .int; diagnostic = .string
  labels = .string[]
  labels[1] = 'consumed INTERPRET permits subsequent write'
  labels[2] = 'Fresh-capable INTERPRET requires consume before write'
  labels[3] = 'Fresh-capable INTERPRET followed by consume permits write'
  labels[4] = 'unrelated clause begin cannot prefix expansion'
  labels[5] = 'same-origin semantic work cannot prefix expansion'
  labels[6] = 'expansion requires its canonical bound context'
  labels[7] = 'unrelated later clause administration gains no Fresh exemption'
  labels[8] = 'unpaired clause begin gains no Fresh exemption'
  labels[9] = 'same-origin semantic work is not a source expression'
  labels[10] = 'same-origin canonical Fresh expansion remains admitted'
  labels[11] = 'Private INTERPRET permits subsequent write'
  labels[12] = 'Consumed and Private union permits subsequent write'
  labels[13] = 'generated group retains its Fresh-capable expansion'
  labels[14] = 'Fresh-capable generated group requires consume before write'
  labels[15] = 'same-origin clause prefix cannot cross semantic work'
  do mode = 1 to 15
    graph = expansionfixture(mode)
    call check(graph.error() = '',labels[mode] || ' is generic-valid: ' || graph.error())
    if graph.error() <> '' then iterate
    accepted = mode = 1 | mode = 3 | mode = 10 | mode = 11 | mode = 12 | mode = 13
    diagnostic = 'fresh entry requires consume or PROCEDURE before semantic work'
    if mode = 2 | mode = 14 then diagnostic = diagnostic || ' (crexx.c.store,'
    if mode = 4 | mode = 7 | mode = 8 | mode = 15 then diagnostic = diagnostic || ' (crexx.c.clause.begin,'
    if mode = 5 then diagnostic = diagnostic || ' (crexx.c.drop,'
    if mode = 6 then diagnostic = 'entry dispatch requires bound slot loads'
    if mode = 9 then diagnostic = 'expansion region contains non-expression semantic work'
    if accepted then diagnostic = ''
    call expansionadmission(graph,accepted,'fresh ' || labels[mode],diagnostic)
    if mode <> 8 then do
      beginnings = 0; executions = 0; anchor = 0
      do i = 1 to graph.operations()
        op = graph.operation(i)
        if wordpos(op.name(),'crexx.c.dynamic.expansion.begin crexx.c.dynamic.interpret') = 0 then iterate
        origin = op.origin()
        call check(origin.kind() = 'exact' & origin.first() = 0 & origin.last() = 17,labels[mode] || ' retains exact INTERPRET extent')
        call check(bincompare(origin.sourcebytes(),'interpret "say 1"; nop' as .binary) = 0,labels[mode] || ' retains complete source bytes')
        if op.name() = 'crexx.c.dynamic.expansion.begin' then do
          beginnings = beginnings + 1; anchor = origin.id()
        end
        else do
          executions = executions + 1
          call check(anchor > 0 & origin.id() = anchor,labels[mode] || ' retains one expansion origin identity')
        end
      end
      call check(beginnings = 1 & executions = 1,labels[mode] || ' retains one explicit expansion pair')
    end
    store = dereference graph.storage(); contract = dereference store.contract()
    restored = llir..loadbinary(contract,graph.binary())
    call check(restored.error() = '' & bincompare(graph.binary(),restored.binary()) = 0,'loaded expansion ' || mode)
    if restored.error() = '' then call expansionadmission(restored,accepted,'loaded ' || labels[mode],diagnostic)
    if mode = 1 | mode = 3 then do
      changed = llirservices..optimise(reference graph)
      call check(changed.status() = 'keep' | changed.status() = 'changed','transformed expansion ' || mode)
      if changed.status() = 'keep' | changed.status() = 'changed' then call expansionadmission(changed.result(),1,'transformed ' || labels[mode])
    end
  end
  return

expansionadmission: procedure = .void
  arg graph = .llir..module, accepted = .int, label = .string, diagnostic = ''
  saved = graph.binary(); proof = .llcprocedureprotocol..checked(reference graph)
  call check((proof.status() = 0) = accepted,label || ': ' || proof.error())
  if diagnostic <> '' then call check(pos(diagnostic,proof.error()) > 0,label || ' retains its specific refusal: ' || proof.error())
  call check(bincompare(saved,graph.binary()) = 0,label || ' preserves input')
  call noemission('procedure.expansion-' || changestr(' ',label,'-'))
  return

/** One named Fresh entry; mode 1 consumes, modes 11/12 commit Private and
 * mode 12 also merges a consumed main path. Modes 13/14 seed a generated
 * group's incoming union. Clause markers use real source extents. */
expansionfixture: procedure = .llir..module
  arg mode = .int
  draft = .llir..opdraft; built = .llir..opview
  registry = .llir..schema(); call llcir..registerfamilies(reference registry,1)
  contract = registry.finish(); builder = .llir..builder(contract)
  file = builder.source('interpret-entry.crexx','interpret "say 1"; nop' as .binary)
  authored = file.origin(0,17); operand = file.origin(10,17); unrelated = file.origin(19,22)
  generated = builder.synthetic('INTERPRET entry dispatch')
  fn = builder.function('$MAIN',contract.type('crexx.c.result'))
  ignored = fn.argument(contract.type('crexx.c.context')); ignored = fn.argument(contract.type('crexx.g.int64'))
  context_slot = fn.slot('$context',contract.type('crexx.c.context')); entry_slot = fn.slot('$entry',contract.type('crexx.g.int64'))
  setup = fn.block('entry'); dispatch = fn.block('dispatch0'); main = fn.block('main')
  test = fn.block('dispatch1'); landing = fn.block('named entry'); body = fn.block('interpret body'); invalid = fn.block('invalid')
  call setup.store(context_slot,setup.readarg(1,generated),generated)
  call setup.store(entry_slot,setup.readarg(2,generated),generated)
  if mode = 13 | mode = 14 then do
    draft = setup.operation(contract.operation('crexx.c.dynamic.group.entry'),generated)
    call draft.input('context',setup.load(context_slot,generated)); built = draft.finish()
  end
  call setup.jump(dispatch,generated)
  integer = .llir..intcodec()
  draft = dispatch.operation(contract.operation('crexx.c.entry.test'),generated)
  call draft.input('context',dispatch.load(context_slot,generated)); call draft.input('entry',dispatch.load(entry_slot,generated))
  call draft.attribute('id',integer.parse('0')); call draft.attribute('name',''x as .binary)
  checked = draft.finish(); call dispatch.branch(checked.result(),main,test,generated)
  if mode = 12 | mode = 13 | mode = 14 then call main.jump(body,generated)
  else call absent(main,contract,generated)
  draft = test.operation(contract.operation('crexx.c.entry.test'),generated)
  call draft.input('context',test.load(context_slot,generated)); call draft.input('entry',test.load(entry_slot,generated))
  call draft.attribute('id',integer.parse('1')); call draft.attribute('name','PROBE' as .binary)
  checked = draft.finish(); call test.branch(checked.result(),landing,invalid,generated)
  if mode = 1 then do
    draft = landing.operation(contract.operation('crexx.c.procedure.consume'),authored)
    call draft.input('context',landing.load(context_slot,authored)); built = draft.finish()
  end
  if mode = 11 | mode = 12 then do
    draft = landing.operation(contract.operation('crexx.c.procedure.enter'),authored)
    call draft.input('context',landing.load(context_slot,authored)); built = draft.finish()
  end
  call landing.jump(body,generated)
  if mode = 5 then call expansiondrop(body,contract,context_slot,authored)
  beginorigin = authored; if mode = 4 then beginorigin = unrelated
  draft = body.operation(contract.operation('crexx.c.clause.begin'),beginorigin)
  call draft.input('context',body.load(context_slot,beginorigin))
  call draft.attribute('id',integer.parse((beginorigin.first() + 1) as .string)); built = draft.finish()
  if mode = 15 then call expansiondrop(body,contract,context_slot,authored)
  if mode <> 8 then do
    context = body.load(context_slot,authored)
    if mode = 6 then context = body.readarg(1,authored)
    draft = body.operation(contract.operation('crexx.c.dynamic.expansion.begin'),authored)
    call draft.input('context',context); built = draft.finish()
    if mode = 9 then call expansiondrop(body,contract,context_slot,authored)
    source = body.constantbytes(contract.type('crexx.c.value'),'say 1' as .binary,operand)
    draft = body.operation(contract.operation('crexx.c.dynamic.interpret'),authored)
    call draft.input('source',source); call draft.input('context',body.load(context_slot,authored)); built = draft.finish()
    if mode = 3 then do
      draft = body.operation(contract.operation('crexx.c.procedure.consume'),unrelated)
      call draft.input('context',body.load(context_slot,unrelated)); built = draft.finish()
    end
    if mode <= 3 | mode = 11 | mode = 12 | mode = 14 then do
      draft = body.operation(contract.operation('crexx.c.store'),unrelated)
      call draft.input('context',body.load(context_slot,unrelated)); call draft.input('value',source)
      call draft.attribute('name','after' as .binary); built = draft.finish()
    end
    if mode = 7 then do
      draft = body.operation(contract.operation('crexx.c.clause.begin'),unrelated)
      call draft.input('context',body.load(context_slot,unrelated)); call draft.attribute('id',integer.parse('20')); built = draft.finish()
    end
  end
  call absent(body,contract,generated)
  draft = invalid.operation(contract.operation('crexx.c.entry.invalid'),generated)
  built = draft.finish(); call absent(invalid,contract,generated)
  return builder.finish()

expansiondrop: procedure = .void
  arg block = .llir..block, contract = .llir..contract, context_slot = .llir..slot, origin = .llir..origin
  draft = block.operation(contract.operation('crexx.c.drop'),origin)
  call draft.input('context',block.load(context_slot,origin)); call draft.attribute('name','early' as .binary)
  boolean = .llir..boolcodec(); call draft.attribute('indirect',boolean.parse('false')); built = draft.finish()
  return

/* Deliberately generic-valid variants cross C's exact entry/procedure boundary.
 * 1 private; 2 shared; 11 late enter (runtime error); 17 two units; and
 * 29 a generated empty trailing-entry epilogue are accepted.
 */
fixture: procedure = .llir..module
  arg mode = .int
  value = .llir..valuehandle; transition_context = .llir..valuehandle; wrote = .llir..opview
  registry = .llir..schema(); call llcir..registerfamilies(reference registry)
  contract = registry.finish(); builder = .llir..builder(contract)
  file = builder.source('procedure-ir.crexx','procedure expose shared' as .binary)
  authored = file.origin(0,23); name_origin = file.origin(17,23)
  generated = builder.synthetic('procedure dispatch')
  fn = builder.function('$MAIN',contract.type('crexx.c.result'))
  ignored = fn.argument(contract.type('crexx.c.context'))
  ignored = fn.argument(contract.type('crexx.g.int64'),mode = 16)
  if mode = 15 then ignored = fn.argument(contract.type('crexx.g.int64'))
  context_slot = fn.slot('$context',contract.type('crexx.c.context'))
  entry_slot = fn.slot('$entry',contract.type('crexx.g.int64'))
  first = fn.block('entry'); main = fn.block('main'); test = fn.block('entry1')
  body = fn.block('body'); invalid = fn.block('invalid'); second_test = .llir..block
  if mode = 18 | mode = 19 then second_test = fn.block('entry2')
  call first.store(context_slot,first.readarg(1,generated),generated)
  incoming = .llir..valuehandle
  if mode = 16 then do
    fallback = first.constant(contract.type('crexx.g.int64'),'0',generated)
    incoming = first.readarg(2,generated,fallback)
  end
  else incoming = first.readarg(2,generated)
  if mode = 22 then incoming = first.constant(contract.type('crexx.g.int64'),'0',generated)
  call first.store(entry_slot,incoming,generated)
  dispatch = fn.block('dispatch0'); call first.jump(dispatch,generated); first = dispatch
  context = first.load(context_slot,generated); entry = first.load(entry_slot,generated)
  dispatch_origin = generated; if mode = 25 then dispatch_origin = authored
  draft = first.operation(contract.operation('crexx.c.entry.test'),dispatch_origin)
  call draft.input('context',context); call draft.input('entry',entry)
  integer = .llir..intcodec(); boolean = .llir..boolcodec()
  call draft.attribute('id',integer.parse('0')); call draft.attribute('name',''x as .binary)
  checked = draft.finish(); call first.branch(checked.result(),main,test,generated)
  context = test.load(context_slot,generated); entry = test.load(entry_slot,generated)
  if mode = 20 then context = test.readarg(1,generated)
  if mode = 21 then context = test.constantbytes(contract.type('crexx.c.context'),'forged context' as .binary,generated)
  id = '1'; if mode = 5 then id = '2'
  name = 'PROBE'; if mode = 6 then name = ''
  draft = test.operation(contract.operation('crexx.c.entry.test'),generated)
  call draft.input('context',context); call draft.input('entry',entry)
  call draft.attribute('id',integer.parse(id)); call draft.attribute('name',name as .binary)
  checked = draft.finish()
  if mode = 18 | mode = 19 then do
    call test.branch(checked.result(),body,second_test,generated)
    context = second_test.load(context_slot,generated); entry = second_test.load(entry_slot,generated)
    draft = second_test.operation(contract.operation('crexx.c.entry.test'),generated)
    call draft.input('context',context); call draft.input('entry',entry)
    call draft.attribute('id',integer.parse('2'))
    name = 'PROBE'; if mode = 19 then name = 'lower'
    call draft.attribute('name',name as .binary); checked = draft.finish()
    call second_test.branch(checked.result(),body,invalid,generated)
  end
  else call test.branch(checked.result(),body,invalid,generated)
  if mode = 13 | mode = 14 then do
    /* Invalid entry identities must refuse before program-exit guard proof. */
    arguments = main.operation(contract.operation('crexx.c.arguments.empty'),generated); packet = arguments.finish()
    context = main.load(context_slot,generated)
    draft = main.operation(contract.operation('crexx.c.call'),generated)
    call draft.input('arguments',packet.result()); call draft.input('context',context)
    call draft.attribute('target','$MAIN' as .binary)
    id = '0'; if mode = 14 then id = '9'
    call draft.attribute('entry',integer.parse(id)); call draft.attribute('function',boolean.parse('false'))
    ignored_call = draft.finish()
  end
  call absent(main,contract,generated)
  context = body.load(context_slot,authored)
  if mode = 23 then do
    selected = builder.source('fresh-select.crexx','select' as .binary)
    draft = body.operation(contract.operation('crexx.c.select.missing'),selected.origin(0,6))
    missing = draft.finish()
  end
  if mode = 24 then do
    draft = body.operation(contract.operation('crexx.c.transfer.invalid'),authored)
    call draft.attribute('code','28.1' as .binary); call draft.attribute('name',''x as .binary)
    transferred = draft.finish()
  end
  if mode = 10 then do
    value = body.constantbytes(contract.type('crexx.c.value'),'unconsumed semantic write' as .binary,authored)
    draft = body.operation(contract.operation('crexx.c.store'),authored)
    call draft.input('context',context); call draft.input('value',value)
    call draft.attribute('name','early' as .binary); wrote = draft.finish()
  end
  if mode = 7 then call body.store(entry_slot,body.constant(contract.type('crexx.g.int64'),'1',generated),generated)
  if mode = 8 then call body.store(context_slot,body.readarg(1,generated),generated)
  if mode = 2 | mode = 4 | mode = 11 | mode = 27 then do
    if mode = 4 then do
      value = body.constantbytes(contract.type('crexx.c.value'),'early' as .binary,authored)
      draft = body.operation(contract.operation('crexx.c.store'),authored)
      call draft.input('context',context); call draft.input('value',value)
      call draft.attribute('name','early' as .binary); wrote = draft.finish()
    end
    transition_context = context
    if mode = 27 then transition_context = body.readarg(1,authored)
    draft = body.operation(contract.operation('crexx.c.procedure.consume'),authored)
    call draft.input('context',transition_context); consumed = draft.finish()
  end
  if mode <> 2 & mode <> 3 & mode <> 4 & mode <> 10 & mode <> 23 & mode <> 24 & mode <> 27 & mode <> 29 & mode <> 30 then do
    transition_context = context
    if mode = 26 then transition_context = body.readarg(1,authored)
    draft = body.operation(contract.operation('crexx.c.procedure.enter'),authored)
    call draft.input('context',transition_context); entered = draft.finish()
  end
  if mode <> 2 & mode <> 4 & mode <> 10 & mode <> 23 & mode <> 24 & mode <> 27 & mode <> 29 & mode <> 30 then do
    name = 'shared'; if mode = 9 then name = '1bad'
    if mode = 28 then context = body.readarg(1,name_origin)
    call emitexpose(body,contract,context,name_origin,name)
  end
  if mode = 30 then do
    draft = body.operation(contract.operation('crexx.c.return.absent'),generated)
    returned = draft.finish(); call body.returnvalue(returned.result(),authored)
  end
  else call absent(body,contract,generated)
  if mode = 12 then do
    dead = fn.block('dead exposure'); context = dead.load(context_slot,authored)
    call emitexpose(dead,contract,context,name_origin,'shared')
    call absent(dead,contract,generated)
  end
  draft = invalid.operation(contract.operation('crexx.c.entry.invalid'),generated)
  failed = draft.finish(); call absent(invalid,contract,generated)
  if mode = 17 then do
    secondary = builder.function('SECOND',contract.type('crexx.c.result'))
    call secondary.exportas('proceduresecondary.run')
    ignored = secondary.argument(contract.type('crexx.c.context'))
    ignored = secondary.argument(contract.type('crexx.g.int64'))
    secondary_context = secondary.slot('$context',contract.type('crexx.c.context'))
    secondary_entry = secondary.slot('$entry',contract.type('crexx.g.int64'))
    secondary_setup = secondary.block('secondary entry')
    secondary_dispatch = secondary.block('secondary dispatch0')
    secondary_body = secondary.block('secondary body')
    secondary_invalid = secondary.block('secondary invalid')
    call secondary_setup.store(secondary_context,secondary_setup.readarg(1,generated),generated)
    call secondary_setup.store(secondary_entry,secondary_setup.readarg(2,generated),generated)
    call secondary_setup.jump(secondary_dispatch,generated)
    context = secondary_dispatch.load(secondary_context,generated); entry = secondary_dispatch.load(secondary_entry,generated)
    draft = secondary_dispatch.operation(contract.operation('crexx.c.entry.test'),generated)
    call draft.input('context',context); call draft.input('entry',entry)
    call draft.attribute('id',integer.parse('0')); call draft.attribute('name',''x as .binary)
    checked = draft.finish(); call secondary_dispatch.branch(checked.result(),secondary_body,secondary_invalid,generated)
    call absent(secondary_body,contract,generated)
    draft = secondary_invalid.operation(contract.operation('crexx.c.entry.invalid'),generated)
    failed = draft.finish(); call absent(secondary_invalid,contract,generated)
  end
  return builder.finish()

emitexpose: procedure = .void
  arg block = .llir..block, contract = .llir..contract, context = .llir..valuehandle, at = .llir..origin, name = .string
  draft = block.operation(contract.operation('crexx.c.procedure.expose'),at)
  call draft.input('context',context); call draft.attribute('name',name as .binary)
  boolean = .llir..boolcodec(); call draft.attribute('indirect',boolean.parse('false'))
  exposed = draft.finish()
  return

absent: procedure = .void
  arg block = .llir..block, contract = .llir..contract, at = .llir..origin
  draft = block.operation(contract.operation('crexx.c.return.absent'),at)
  returned = draft.finish(); call block.returnvalue(returned.result(),at)
  return

/* Inspection is test-owned transport, never part of the compiler service. */
emissionstart: procedure = .void expose inspection emission_requests
  arg caseid = .string
  if inspection == '' then return
  emission_requests = emission_requests + 1
  say 'START|' || caseid
  return

emissionfinish: procedure = .void expose inspection emission_finished
  arg caseid = .string, graph_ref = reference .llir..module, output_ref = reference .llir..output, expected = .int, status = .int, diagnostic = .string
  if inspection == '' then return
  graph = dereference graph_ref; output = dereference output_ref
  call check(graph.error() == '',caseid || ' inspection graph is frozen and valid')
  if graph.error() <> '' then return
  image = graph.binary()
  written = writebinary(inspection || '/' || caseid || '.llir',image) = <blen>(image)
  call check(written,caseid || ' exact temporary graph export')
  if written = 0 then return
  if expected then do
    call check(status = 0 & output.bytes() > 0,caseid || ' inspection requires accepted output: ' || diagnostic)
    if status <> 0 | output.bytes() = 0 then return
    text = output.text() as .binary
    written = writebinary(inspection || '/' || caseid || '.rxas',text) = output.bytes()
    call check(written,caseid || ' exact temporary RXAS export')
    if written = 0 then return
    say 'EMITTED|' || caseid
  end
  else do
    call check(status <> 0 & output.bytes() = 0,caseid || ' inspection refusal has no output')
    if status = 0 | output.bytes() <> 0 then return
    say 'REFUSAL|' || caseid || '|' || diagnostic
  end
  emission_finished = emission_finished + 1
  return

noemission: procedure = .void expose inspection emission_finished
  arg caseid = .string
  if inspection == '' then return
  call emissionstart(caseid)
  say 'NO_EMISSION|' || caseid
  emission_finished = emission_finished + 1
  return
