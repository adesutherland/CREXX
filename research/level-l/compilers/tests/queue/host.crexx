/* Test-only queuefixture.run exports the compiled source's existing entry0.
 * The selected queue belongs to B's execution-local repository, not a frame. */
options levelb
import rxfnsb
import rexxpool
import rexxactivation
import rexxclassicconfig
import rexxclassiccontext
import queuefixture

main: procedure = .int expose checks failures
  arg argv = .string[]
  checks = 0; failures = 0
  previous = rxqueue('QUERY')
  call check(rxqueue('SETX','QUEUE-FIXTURE') == '0','select the owned test queue')
  call check(rxqueue('CLEAR') == '0','clear selected fixture queue')
  visible = .rexxpool..RexxVariablePool()
  if argv[0] > 0 then do
    if argv[1] <> 'late-bare' then return 2
    say 'QUEUE_FATAL|before'
    returned = invokeFixture(argv[1],reference visible)
    say 'UNREACHED fatal host'
    return 1
  end
  call check(rxqueue('SETX','QUEUE-OTHER') == '0','select a second named queue')
  call check(rxqueue('CLEAR') == '0','clear second owned queue')
  call queue 'other untouched'
  payload = 'aéµμ🙂' || ('00'x as .string) || 'b '
  call exercise('bare',payload,'',1,0)
  call exercise('value',payload,payload,1,0)
  call exercise('value','','',1,0)
  call exercise('once',payload,payload,1,1)
  call exercise('private',payload,'nested ' || payload,1,1)
  call exercise('recursive',payload,payload || '2',2,2,payload || '1')
  call exercise('branch',payload,payload,1,0)
  call exercise('contextual',payload,'',0,0)
  call exercise('dead',payload,'',0,0)
  call mixed(payload)
  call operandExit(payload)
  call check(rxqueue('QUERY') == 'QUEUE-FIXTURE','nested C invocations keep the selected queue')
  call check(rxqueue('SET','QUEUE-OTHER') == '0','return to independent named queue')
  call check(queued() = 1 & peek() == 'other untouched','QUEUE leaves another queue untouched')
  if queued() = 1 then call check(pull() == 'other untouched','other queue text remains exact')
  call check(rxqueue('SET',previous) == '0','restore original queue selection')
  call check(rxqueue('DELETE','QUEUE-FIXTURE') == '0' & rxqueue('DELETE','QUEUE-OTHER') == '0','remove only owned fixture queues')
  say 'QUEUE_HOST|checks=' || checks || '|failures=' || failures
  return failures

exercise: procedure = .void
  arg mode = .string, payload = .string, first = .string, inserted = .int, calls = .int, second = ''
  call check(rxqueue('SET','QUEUE-FIXTURE') == '0',mode || ': select fixture queue')
  call check(rxqueue('CLEAR') == '0',mode || ': reset selected queue')
  call queue 'head seed'
  parent = .rexxpool..RexxVariablePool()
  call parent.setString('SHARED',payload)
  visible = .rexxpool..RexxVariablePool()
  call visible.exposeSymbol('SHARED',reference parent)
  call visible.setString('PAYLOAD',payload); call visible.setString('LOCAL','caller local')
  returned = invokeFixture(mode,reference visible)
  call check(returned.hasReturnValue() & returned.returnValue().asString() == '0',mode || ': owned completion')
  call check(visible.symbolValue('COUNT').asString() == (calls as .string),mode || ': expression or recursive effect count')
  call check(visible.symbolValue('LOCAL').asString() == 'caller local',mode || ': private local did not leak')
  expectedshared = payload
  if mode = 'private' then expectedshared = 'nested ' || payload
  call check(parent.symbolValue('SHARED').asString() == expectedshared,mode || ': exact shared alias state')
  if mode = 'private' then call check(visible.symbolValue('RESULT').asString() == 'child local','private call returns its local before cleanup')
  if mode = 'contextual' then call check(visible.symbolValue('QUEUE').asString() == '7' & visible.symbolValue('RESULT').asString() == 'queue label','QUEUE remains variable and local label')
  call check(queued() = inserted + 1 & queued() = inserted + 1,mode || ': QUEUED does not consume')
  if queued() <> inserted + 1 then return
  call check(peek() == 'head seed',mode || ': existing head remains first')
  if inserted > 0 then call check(peek(2) == first,mode || ': tail insertion preserves exact Unicode/Latin1/NUL/empty')
  if inserted = 2 then call check(peek(3) == second,mode || ': recursive insertion is FIFO')
  call check(queued() = inserted + 1,mode || ': peek did not consume')
  call check(pull() == 'head seed',mode || ': consume existing head before appended values')
  if inserted > 0 then call check(pull() == first,mode || ': consume first appended value')
  if inserted = 2 then call check(pull() == second,mode || ': consume second appended value')
  call check(queued() = 0,mode || ': consume exactly the expected entries')
  return

/* Leave a consumed physical slot before C composes front and tail writes. */
mixed: procedure = .void
  arg payload = .string
  call check(rxqueue('SET','QUEUE-FIXTURE') == '0','mixed: select fixture queue')
  call check(rxqueue('CLEAR') == '0','mixed: reset selected queue')
  call queue 'consumed seed'
  call queue 'head seed'
  call check(pull() == 'consumed seed' & queued() = 1,'mixed: retain old head after consuming an earlier slot')
  visible = .rexxpool..RexxVariablePool()
  call visible.setString('PAYLOAD',payload)
  returned = invokeFixture('mixed',reference visible)
  call check(returned.hasReturnValue() & returned.returnValue().asString() == '0','mixed: normal owned completion')
  call check(queued() = 3 & peek() == 'front seed' & peek(2) == 'head seed' & peek(3) == payload,'mixed: exact C PUSH front, old head and C QUEUE Unicode/NUL tail')
  call check(queued() = 3,'mixed: count and every peek leave entries intact')
  call check(pull() == 'front seed','mixed: consume C PUSH front first')
  call check(pull() == 'head seed','mixed: consume old head second')
  call check(pull() == payload & queued() = 0,'mixed: consume exact C QUEUE tail last')
  return

/* EXIT in a private operand ends the program before any insertion. Its
 * complete result survives private cleanup and the helper's owner expiry. */
operandExit: procedure = .void
  arg payload = .string
  call check(rxqueue('SET','QUEUE-FIXTURE') == '0','operand EXIT: select fixture queue')
  call check(rxqueue('CLEAR') == '0','operand EXIT: reset selected queue')
  call queue 'head seed'
  visible = .rexxpool..RexxVariablePool()
  call visible.setString('PAYLOAD',payload); call visible.setString('LOCAL','caller local')
  returned = invokeFixture('operand-exit',reference visible)
  call check(returned.hasReturnValue() & returned.returnValue().asString() == payload,'operand EXIT: exact owned Unicode/NUL result survives helper expiry')
  call check(visible.symbolValue('COUNT').asString() == '1','operand EXIT: private operand executes once')
  call check(visible.symbolValue('LOCAL').asString() == 'caller local','operand EXIT: private local state does not escape')
  call check(queued() = 1 & peek() == 'head seed','operand EXIT: insertion and later statements are skipped')
  call check(pull() == 'head seed' & queued() = 0,'operand EXIT: original selected queue remains intact')
  return

invokeFixture: procedure = .rexxactivation..RexxActivationArguments
  arg mode = .string, visible_ref = reference .rexxpool..RexxVariablePool
  activation = .rexxactivation..RexxActivationArguments()
  call activation.appendText(mode)
  config = .rexxclassicconfig..RexxClassicConfig('UTF8')
  context = .rexxclassiccontext..RexxClassicContext(reference activation,visible_ref,reference config)
  returned = queuefixture..run(reference context,0)
  rebound = context.pool(); reboundactivation = context.activation(); reboundconfig = context.config()
  originalactivation = reference activation; originalconfig = reference config
  call check(<refvalid>(rebound) & (rebound <refsame> visible_ref),mode || ': restore original live pool binding')
  call check((reboundactivation <refsame> originalactivation) & (reboundconfig <refsame> originalconfig),mode || ': retain caller context owners')
  if mode = 'operand-exit' then do
    call check(activation.programExitRequested(),'operand EXIT: records the live caller program root')
    call check(activation.hasReturnValue() & activation.returnValue().asString() == returned.returnValue().asString(),'operand EXIT: caller root retains the full result before owner expiry')
  end
  return returned

check: procedure = .void expose checks failures
  arg passed = .int, label = .string
  checks = checks + 1
  if passed then return
  failures = failures + 1; say 'FAIL|' || label
  return
