/* QUEUE preserves text; PARSE PULL observes it without UPPER. */
options levelc
parse arg MODE
queue = 7
COUNT = 0
if 0 then queue UNREACHED
if MODE = 'bare' then do
  queue
  return 0
end
if MODE = 'value' then do
  queue PAYLOAD
  return 0
end
if MODE = 'once' then do
  queue NEXT()
  return 0
end
if MODE = 'operand-exit' then do
  queue EXITVALUE()
  say 'UNREACHED operand QUEUE'
  return 0
end
if MODE = 'mixed' then do
  push 'front seed'
  queue PAYLOAD
  return 0
end
if MODE = 'private' then do
  call PRIVATE
  return 0
end
if MODE = 'recursive' then do
  call RECURSE 2
  return 0
end
if MODE = 'branch' then do
  select
    when 1 then queue PAYLOAD
    otherwise queue UNREACHED
  end
  return 0
end
if MODE = 'contextual' then do
  call QUEUE
  return 0
end
if MODE = 'dead' then return 0
if MODE = 'late-bare' then call ELIGIBLE
queue 'first'
queue 'second'
say 'count=' || queued() || '|' || queued()
parse pull FIRST
parse pull SECOND
say 'tail=' || FIRST || '|' || SECOND
queue
parse pull EMPTY
say 'bare=' || length(EMPTY)
queue 'a' || '00'x || 'é'
parse pull ORDINAL
say 'latin=' || c2x(ORDINAL)
queue 'é🙂'
parse pull UNICODE
say 'unicode=' || UNICODE || '|' || length(UNICODE)
return 0

NEXT:
COUNT = COUNT + 1
return PAYLOAD
EXITVALUE:
procedure expose COUNT PAYLOAD
COUNT = COUNT + 1
exit PAYLOAD
PRIVATE:
procedure expose SHARED COUNT
LOCAL = 'child local'
SHARED = 'nested ' || SHARED
COUNT = COUNT + 1
queue SHARED
return LOCAL
RECURSE:
procedure expose SHARED COUNT
parse arg DEPTH
if DEPTH = 0 then return
COUNT = COUNT + 1
queue SHARED || DEPTH
call RECURSE DEPTH - 1
return
QUEUE:
return 'queue label'
ELIGIBLE:
queue
LATE:
procedure
say 'UNREACHED late QUEUE'
return
