/* cREXX License (MIT). Independent DROP source, IR and admission contracts. */
options levelb
import rxfnsb
import llir
import llcir
import llcparse
import llcfrontend
import llcrxas

main: procedure = .int expose checks failures artifacts inspection emission_requests emission_finished
  arg argv = .string[]
  argc = argv[0]; inspection = ''; emission_requests = 0; emission_finished = 0
  if argc = 4 then do
    if argv[3] \== 'emit-only' | argv[4] == '' then return 2
    inspection = argv[4]; argc = 2
  end
  if argc <> 2 then return 2
  artifacts = argv[1]; checks = 0; failures = 0
  call sourcecontracts()
  call namecontracts()
  call provider(argv[2])
  call noemission('drop.ast-schema')
  if inspection <> '' then do
    expected = 9 + 1 + 1 + 1
    call check(emission_requests = expected & emission_finished = expected,'complete explicit DROP emission inventory')
    say 'DROP_EMISSION|requests=' || emission_requests || '|complete=' || emission_finished || '|failures=' || failures
  end
  else say 'DROP_CONTRACTS|checks=' || checks || '|failures=' || failures
  return failures

check: procedure = .void expose checks failures
  arg passed = .int, label = .string
  checks = checks + 1
  if passed then return
  failures = failures + 1; say 'FAIL|' || label
  return

/* Raw spellings and byte spans are expectations of the agreed source contract,
 * not snapshots copied from compiler output. Parentheses belong to the item. */
sourcecontracts: procedure = .void expose artifacts
  text = 'drop µ (μ) items.key'
  parsed = .llcparse..parsed(text as .binary)
  call check(parsed.status() = 0,'Unicode DROP parses: ' || parsed.error())
  if parsed.status() <> 0 then return
  tree = parsed.ast(); body = tree.root().child('body'); node = body.child('items',1)
  call check(node.kind() = 'CDrop' & node.count('items') = 3,'ordered nonempty CDrop list')
  call check(node.start() = 0 & node.finish() = 22,'complete original byte span')
  item = node.child('items',1)
  call check(item.kind() = 'DropDirect' & item.text('name') = 'µ' & item.start() = 5 & item.finish() = 7,'micro-sign direct item span')
  item = node.child('items',2)
  call check(item.kind() = 'DropIndirect' & item.text('name') = 'μ' & item.start() = 8 & item.finish() = 12,'Greek indirect item includes parentheses')
  item = node.child('items',3)
  call check(item.kind() = 'DropDirect' & item.text('name') = 'items.key' & item.start() = 13 & item.finish() = 22,'raw compound item span')
  call emissionstart('drop.frontend-spans')
  request = .llcfrontend..request(text as .binary,artifacts,'drop-spans.crexx')
  call check(request.status() = 0,'DROP frontend: ' || request.error())
  if request.status() <> 0 then return
  graph = request.graph(); found = 0; names = ''; flags = ''; starts = ''; finishes = ''
  do i = 1 to graph.operations()
    operation = graph.operation(i)
    if operation.name() <> 'crexx.c.drop' then iterate
    found = found + 1; names = names || (operation.attribute('name') as .string) || '|'
    boolean = .llir..boolcodec(); flags = flags || boolean.format(operation.attribute('indirect')) || '|'
    at = operation.origin(); starts = starts || at.first() || '|'; finishes = finishes || at.last() || '|'
    call check(operation.inputs() = 1 & operation.results() = 0,'one context input, no invented DROP result')
  end
  call check(found = 3 & names = 'µ|μ|items.key|' & flags = 'false|true|false|','one IR operation per item, ordered raw names and kinds')
  call check(starts = '5|8|13|' & finishes = '7|12|22|','IR retains each authored item origin')
  registry = .llir..schema(); call llcir..registerfamilies(reference registry)
  contract = registry.finish(); data = dereference contract.data()
  descriptor = contract.operation('crexx.c.drop')
  id = descriptor.id()
  call check(descriptor.valid() & data.ops() = 97,'current v24 retains DROP in the 97-operation contextual family')
  call check(data.arity(id,1) = 1 & data.fieldname(id,1,1) = 'context' & data.typename(data.fieldtype(id,1,1)) = 'crexx.c.context' & data.arity(id,2) = 0,'DROP consumes context and returns no value')
  call check(data.arity(id,3) = 2 & data.fieldname(id,3,1) = 'name' & data.fieldname(id,3,2) = 'indirect' & data.typename(data.fieldtype(id,3,1)) = 'crexx.g.text' & data.typename(data.fieldtype(id,3,2)) = 'core.boolean','DROP attributes are ordered name:text then indirect:boolean')
  call check(data.effectvalue(id,1) = 'context' & data.effectvalue(id,2) = 'condition' & data.effectvalue(id,3) = 'returns','DROP retains state and condition effects')
  call frontendfinish('drop.frontend-spans',text as .binary,0,request.status(),request.error())
  return

/* The generic verifier admits text bytes; the C selector must enforce its
 * exact shared source-name rule on every load/store/drop, even dead blocks.
 * A few distinct malformed spellings cover token extent, character and shape
 * boundaries without duplicating the Unicode classifier in this fixture. */
namecontracts: procedure = .void expose artifacts
  do mode = 1 to 9
    name = ''; opname = 'drop'; dead = 0
    select mode
      when 1 then do; name = 'two names'; opname = 'load'; end
      when 2 then do; name = '.ordinary'; opname = 'store'; end
      when 3 then do; name = '1bad'; end
      when 4 then do; name = '🙂'; opname = 'load'; dead = 1; end
      when 5 then do; name = 'é'; opname = 'store'; dead = 1; end
      when 6 then do; name = 'a' || ('0A'x as .string); dead = 1; end
      when 7 then do; name = ''; end
      when 8 then do; name = 'µ'; end
      otherwise do; name = '.RESULTx'; end
    end
    registry = .llir..schema(); call llcir..registerfamilies(reference registry)
    contract = registry.finish(); builder = .llir..builder(contract)
    fn = builder.function('$MAIN',contract.type('crexx.c.result'))
    ignored = fn.argument(contract.type('crexx.c.context'))
    ignored = fn.argument(contract.type('crexx.g.int64'))
    at = builder.synthetic('independent C name admission'); entry = fn.block('entry')
    context_slot = fn.slot('$context',contract.type('crexx.c.context'))
    call entry.store(context_slot,entry.readarg(1,at),at)
    entry = entrybody(fn,contract,entry,context_slot,at); block = entry
    if dead then do
      draft = entry.operation(contract.operation('crexx.c.return.absent'),at)
      operation = draft.finish(); call entry.returnvalue(operation.result(),at)
      block = fn.block('dead')
    end
    context = block.load(context_slot,at)
    value = .llir..valuehandle
    if opname = 'store' then value = block.constantbytes(contract.type('crexx.c.value'),'held' as .binary,at)
    draft = block.operation(contract.operation('crexx.c.' || opname),at)
    call draft.input('context',context); call draft.attribute('name',name as .binary)
    if opname = 'store' then call draft.input('value',value)
    if opname = 'drop' then do
      boolean = .llir..boolcodec(); call draft.attribute('indirect',boolean.parse('0'))
    end
    operation = draft.finish()
    draft = block.operation(contract.operation('crexx.c.return.absent'),at)
    operation = draft.finish(); call block.returnvalue(operation.result(),at)
    graph = builder.finish(); saved = graph.binary()
    call check(graph.error() = '', 'valid generic name fixture ' || mode || ': ' || graph.error())
    call emissionstart('drop.raw-name-' || mode)
    backend = .llcrxas..compilation(graph,artifacts); output = backend.output()
    call emissionfinish('drop.raw-name-' || mode,reference graph,reference output,mode = 8,backend.status(),backend.error())
    if mode = 8 then call check(backend.status() = 0 & output.bytes() > 0,'raw micro-sign name admitted: ' || backend.error())
    else call check(backend.status() <> 0 & pos('invalid variable symbol',backend.error()) > 0 & output.bytes() = 0,'malformed ' || opname || ' name refused atomically ' || mode || ': ' || backend.error())
    call check(bin2x(saved) = bin2x(graph.binary()),'name admission preserves graph ' || mode)
  end
  return

/* Test-only export through the existing generic function export facility.
 * A B root owns all borrowed storage and directly invokes this C body; its
 * generated fresh-root wrapper must never execute. No product API is added. */
provider: procedure = .void expose artifacts
  arg destination = .string
  registry = .llir..schema(); call llcir..registerfamilies(reference registry)
  contract = registry.finish(); builder = .llir..builder(contract)
  file = builder.source('drop-provider.crexx','drop items. (names)' as .binary)
  fn = builder.function('$MAIN',contract.type('crexx.c.result'))
  call fn.exportas('dropfixture.run'); ignored = fn.argument(contract.type('crexx.c.context'))
  ignored = fn.argument(contract.type('crexx.g.int64'))
  block = fn.block('entry'); at = file.origin(0,19)
  context_slot = fn.slot('$context',contract.type('crexx.c.context'))
  generated = builder.synthetic('test-only supplied DROP unit entry')
  call block.store(context_slot,block.readarg(1,generated),generated)
  block = entrybody(fn,contract,block,context_slot,generated)
  context = block.load(context_slot,at)
  markerat = builder.synthetic('test-only root execution marker')
  marker = block.constantbytes(contract.type('crexx.c.value'),'DROP_PROVIDER' as .binary,markerat)
  draft = block.operation(contract.operation('crexx.c.say'),markerat)
  call draft.input('value',marker); call draft.input('context',context); operation = draft.finish()
  boolean = .llir..boolcodec()
  do i = 1 to 2
    at = file.origin(5,11); name = 'items.'; indirect = '0'
    if i = 2 then do; at = file.origin(12,19); name = 'names'; indirect = '1'; end
    draft = block.operation(contract.operation('crexx.c.drop'),at)
    call draft.input('context',context); call draft.attribute('name',name as .binary)
    call draft.attribute('indirect',boolean.parse(indirect)); operation = draft.finish()
  end
  draft = block.operation(contract.operation('crexx.c.return.absent'),at)
  operation = draft.finish(); call block.returnvalue(operation.result(),at)
  graph = builder.finish(); saved = graph.binary()
  call check(graph.error() = '', 'exported provider graph: ' || graph.error())
  call emissionstart('drop.provider')
  backend = .llcrxas..compilation(graph,artifacts); output = backend.output()
  call emissionfinish('drop.provider',reference graph,reference output,1,backend.status(),backend.error())
  call check(backend.status() = 0 & output.bytes() > 0,'exported provider selection: ' || backend.error())
  call check(bin2x(saved) = bin2x(graph.binary()),'provider selection preserves graph')
  if backend.status() = 0 then call check(writebinary(destination,output.text() as .binary) > 0,'provider RXAS published for B host integration')
  return

/* Test-only canonical C unit entry. The caller declares both arguments before
 * creating setup and binds argument 1 to the canonical context slot. Keep slot
 * reads in a separate dispatch block so local forwarding preserves them. */
entrybody: procedure = .llir..block
  arg fn = .llir..function, contract = .llir..contract, setup = .llir..block, context = .llir..slot, at = .llir..origin
  entry = fn.slot('$entry',contract.type('crexx.g.int64'))
  call setup.store(entry,setup.readarg(2,at),at)
  dispatch = fn.block('dispatch.0'); body = fn.block('source.body'); invalid = fn.block('entry.invalid')
  call setup.jump(dispatch,at)
  draft = dispatch.operation(contract.operation('crexx.c.entry.test'),at)
  call draft.input('context',dispatch.load(context,at)); call draft.input('entry',dispatch.load(entry,at))
  integer = .llir..intcodec()
  call draft.attribute('id',integer.parse('0')); call draft.attribute('name',''x as .binary)
  operation = draft.finish(); call dispatch.branch(operation.result(),body,invalid,at)
  draft = invalid.operation(contract.operation('crexx.c.entry.invalid'),at); operation = draft.finish()
  draft = invalid.operation(contract.operation('crexx.c.return.absent'),at); operation = draft.finish()
  call invalid.returnvalue(operation.result(),at)
  return body

/* Inspection is test-owned transport, never part of the compiler service. */
emissionstart: procedure = .void expose inspection emission_requests
  arg caseid = .string
  if inspection == '' then return
  emission_requests = emission_requests + 1
  say 'START|' || caseid
  return

emissionfinish: procedure = .void expose inspection emission_finished
  arg caseid = .string, graph_ref = reference .llir..module, output_ref = reference .llir..output, expected = .int, status = .int, diagnostic = .string
  if inspection == '' then return
  graph = dereference graph_ref; output = dereference output_ref
  call check(graph.error() == '',caseid || ' inspection graph is frozen and valid')
  if graph.error() <> '' then return
  image = graph.binary()
  written = writebinary(inspection || '/' || caseid || '.llir',image) = <blen>(image)
  call check(written,caseid || ' exact temporary graph export')
  if written = 0 then return
  if expected then do
    call check(status = 0 & output.bytes() > 0,caseid || ' inspection requires accepted output: ' || diagnostic)
    if status <> 0 | output.bytes() = 0 then return
    text = output.text() as .binary
    written = writebinary(inspection || '/' || caseid || '.rxas',text) = output.bytes()
    call check(written,caseid || ' exact temporary RXAS export')
    if written = 0 then return
    say 'EMITTED|' || caseid
  end
  else do
    call check(status <> 0 & output.bytes() = 0,caseid || ' inspection refusal has no output')
    if status = 0 | output.bytes() <> 0 then return
    say 'REFUSAL|' || caseid || '|' || diagnostic
  end
  emission_finished = emission_finished + 1
  return

noemission: procedure = .void expose inspection emission_finished
  arg caseid = .string
  if inspection == '' then return
  call emissionstart(caseid)
  say 'NO_EMISSION|' || caseid
  emission_finished = emission_finished + 1
  return

/* Frontend-only cases retain exact loop/source bytes without inventing RXAS. */
frontendfinish: procedure = .void expose inspection emission_finished
  arg caseid = .string, source = .binary, refused = .int, status = .int, diagnostic = .string
  if inspection == '' then return
  accepted = (status <> 0) = refused
  call check(accepted,caseid || ' frontend disposition matches its existing oracle: ' || diagnostic)
  if accepted = 0 then return
  written = writebinary(inspection || '/' || caseid || '.source',source) = <blen>(source)
  call check(written,caseid || ' exact temporary frontend source export')
  if written = 0 then return
  if refused then say 'REFUSAL|' || caseid || '|' || diagnostic
  else say 'NO_EMISSION|' || caseid
  emission_finished = emission_finished + 1
  return
