/* cREXX License (MIT). Backend contracts, ownership and failure regressions. */
options levelb
import rxfnsb
import lltestcompiler
import lltestrxas
import lltestfrontend
import lltestfamilies
import llir
import llcompilercontracts

main: procedure = .int expose checks failures artifacts outputfile
  arg argv = .string[]
  if argv[0] < 1 | argv[0] > 3 then return 2
  outputfile = ''; if argv[0] >= 2 then outputfile = argv[2]
  artifacts = argv[1]; checks = 0; failures = 0
  if argv[0] = 3 then do
    select argv[3]
      when 'nop' then call nopchecks(outputfile)
      when 'options' then call optionschecks(outputfile)
      when 'if' then call ifchecks(outputfile)
      when 'select' then call selectchecks(outputfile)
      when 'do' then call dochecks(outputfile)
      when 'do-final' then call dochecks(outputfile,1)
      when 'leave' then call leavechecks(outputfile)
      when 'leave-invalid' then call leavechecks(outputfile,1)
      when 'iterate' then call iteratechecks(outputfile)
      otherwise return 2
    end
  end
  else do
    call requests()
    call graphs()
    call provenance()
    call cleanup()
    call nopchecks()
    call optionschecks()
    call ifchecks()
    call selectchecks()
    call dochecks()
    call leavechecks()
    call iteratechecks()
    if outputfile <> '' then call literals()
  end
  say 'BACKEND|checks=' || checks || '|failures=' || failures
  return failures

/* Equal-width blanks preserve following source coordinates. Source records
 * remain in actual output; only this comparison omits metadata and abstracts
 * diagnostic-location payloads, retaining their executable loads and frames. */
nopchecks: procedure = .void expose artifacts
  arg inspect = ''
  source = .string; written = .int
  do sample = 1 to 5
    select sample
      when 1 then source = "say 'before'; nop; say 'after'"
      when 2 then source = 'exit 0; nop'
      when 3 then source = 'do; exit 0; do; nop; end; end'
      when 4 then source = 'exit 0; p: procedure; return 1; do; nop; end'
      otherwise source = 'if 1 then do; nop; end; else do; nop; end'
    end
    control = changestr('nop',source,'   ')
    do optimise = 0 to 1
      withnop = .lltestcompiler..request('c',source as .binary,artifacts,'nop-shape.crexx',1000000,512,67108864,65536,optimise)
      without = .lltestcompiler..request('c',control as .binary,artifacts,'nop-shape.crexx',1000000,512,67108864,65536,optimise)
      call check(withnop.status() = 0 & without.status() = 0,'valid NOP/control pair ' || sample || '/' || optimise || ': ' || withnop.error() || ' / ' || without.error())
      if withnop.status() <> 0 | without.status() <> 0 then iterate
      graph = withnop.graph(); other = without.graph()
      call check(irshape(graph) = irshape(other),'NOP adds no source IR operation/value/block/slot ' || sample || '/' || optimise)
      graph = withnop.emissiongraph(); other = without.emissiongraph()
      call check(irshape(graph) = irshape(other),'NOP adds no selected IR operation/value/block/slot ' || sample || '/' || optimise)
      output = withnop.output(); blank = without.output()
      if inspect <> '' & optimise = 0 & (sample = 2 | sample = 4) then do
        written = writebinary(inspect || '-' || sample || '-nop.rxas',output.text() as .binary)
        written = writebinary(inspect || '-' || sample || '-blank.rxas',blank.text() as .binary)
      end
      call check(execshape(output.text()) = execshape(blank.text()),'NOP adds no instruction/frame/helper/default ' || sample || '/' || optimise)
      call check(pos('.srcstep',output.text()) > 0 & pos('nop-shape.crexx',output.text()) > 0,'truthful source records retained ' || sample || '/' || optimise)
    end
  end
  return

/** Only the discarded OPTIONS clause changes; the header and layout match. */
optionschecks: procedure = .void expose artifacts
  arg inspect = ''
  source = .string; target = .string; written = .int; graph = .llir..module
  output = .llir..output; blank = .llir..output
  header = 'options levelc; '
  do sample = 1 to 5
    select sample
      when 1 then do
        target = "options; options 'λ'; options 42; options ((42))"
        source = "options levelc; " || target || "; say 'after'"
      end
      when 2 then do; target = "options; options ('λ'); options 42"; source = 'options levelc; exit 0; ' || target; end
      when 3 then do; target = 'options'; source = 'options levelc; do; exit 0; do; ' || target || '; end; end'; end
      when 4 then do; target = "options ((42))"; source = 'options levelc; exit 0; p: procedure; return 1; do; ' || target || '; end'; end
      otherwise do; target = "options 'literal'"; source = 'options levelc; if 1 then do; ' || target || '; end; else do; ' || target || '; end'; end
    end
    control = header || changestr(target,substr(source,length(header) + 1),copies(' ',<blen>(target as .binary)))
    do optimise = 0 to 1
      withoptions = .lltestcompiler..request('c',source as .binary,artifacts,'options-shape.crexx',1000000,512,67108864,65536,optimise)
      without = .lltestcompiler..request('c',control as .binary,artifacts,'options-shape.crexx',1000000,512,67108864,65536,optimise)
      call check(withoptions.status() = 0 & without.status() = 0,'valid OPTIONS/control pair ' || sample || '/' || optimise || ': ' || withoptions.error() || ' / ' || without.error())
      if withoptions.status() <> 0 | without.status() <> 0 then iterate
      graph = withoptions.graph(); other = without.graph()
      call check(irshape(graph) = irshape(other),'OPTIONS adds no source IR value/helper/block/slot ' || sample || '/' || optimise)
      graph = withoptions.emissiongraph(); other = without.emissiongraph()
      call check(irshape(graph) = irshape(other),'OPTIONS adds no selected IR value/helper/block/slot ' || sample || '/' || optimise)
      output = withoptions.output(); blank = without.output()
      call check(execshape(output.text(),'options-shape.crexx') = execshape(blank.text(),'options-shape.crexx'),'OPTIONS adds no instruction/frame/default/dead return ' || sample || '/' || optimise)
      call check(pos('applyoptions',output.text()) = 0,'no empty processor/config-conversion call ' || sample || '/' || optimise)
      if inspect <> '' & optimise = 0 & (sample = 1 | sample = 2 | sample = 4) then do
        written = writebinary(inspect || '-' || sample || '-options.rxas',output.text() as .binary)
        written = writebinary(inspect || '-' || sample || '-blank.rxas',blank.text() as .binary)
      end
    end
  end
  source = 'options levelc; options raw; options +1; options -2; options 1+2; options marker(); exit 0; marker: procedure; return 1'
  request = .lltestcompiler..request('c',source as .binary,artifacts,'options-effects.crexx',1000000,512,67108864,65536,0)
  call check(request.status() = 0,'effectful discarded operands accepted: ' || request.error())
  if request.status() <> 0 then return
  graph = request.graph(); text = graph.dump()
  call check(occurrences(text,'crexx.c.load ') = 2,'header and ordinary Name reads retained')
  call check(pos('crexx.c.positive',text) > 0 & pos('crexx.c.negative',text) > 0 & pos('crexx.c.add',text) > 0,'unary and binary work retained')
  call check(pos('crexx.c.call',text) > 0 & pos('crexx.c.requirevalue',text) > 0,'call and required-result work retained')
  output = request.output()
  call check(pos('applyoptions',output.text()) = 0,'effectful operand still has no OPTIONS processor call')
  if inspect <> '' then written = writebinary(inspect || '-effects.rxas',output.text() as .binary)
  return

/** Closed arms need no join/default result; open endpoints still converge. */
ifchecks: procedure = .void expose artifacts
  arg inspect = ''
  source = .string; expected = .int; written = .int
  sample = .int; optimise = .int; selected = .int; request = .lltestcompiler..request
  graph = .llir..module; output = .llir..output; text = .string
  do sample = 1 to 7
    select sample
      when 1 then do; source = 'if flag then exit 0 else exit 1'; expected = 2; end
      when 2 then do; source = 'exit 0; p: procedure; arg flag; if flag then return 1 else return 2'; expected = 1; end
      when 3 then do; source = 'if flag then if inner then exit 0 else exit 1; else exit 2'; expected = 3; end
      when 4 then do; source = 'do while flag; if flag then leave else iterate; end'; expected = 1; end
      when 5 then do; source = 'if flag then exit 0 else nop'; expected = 2; end
      when 6 then do; source = 'if flag then exit 0'; expected = 2; end
      otherwise do; source = 'if flag then exit 0 else exit 1; do; nop; options ((42)); end'; expected = 2; end
    end
    do optimise = 0 to 1
      request = .lltestcompiler..request('c',source as .binary,artifacts,'if-shape.crexx',1000000,512,67108864,65536,optimise)
      call check(request.status() = 0,'IF endpoint source accepted ' || sample || '/' || optimise || ': ' || request.error())
      if request.status() <> 0 then iterate
      graph = request.graph(); text = graph.dump()
      if sample = 5 | sample = 6 then call check(pos('if.join.',text) > 0,'open or missing ELSE retains convergence ' || sample || '/' || optimise)
      else call check(pos('if.join.',text) = 0,'closed arms add no predecessorless join ' || sample || '/' || optimise)
      call check(sourcepackets(graph) = expected,'only necessary EXIT/absent result packets ' || sample || '/' || optimise)
      output = request.output()
      call check(pos('.srcstep',output.text()) > 0 & pos('if-shape.crexx',output.text()) > 0,'IF source/fatal records retained ' || sample || '/' || optimise)
      if inspect <> '' & (sample = 1 | sample = 2 | sample = 4) then written = writebinary(inspect || '-closed-' || sample || '-' || optimise || '.rxas',output.text() as .binary)
    end
  end
  do optimise = 0 to 1
    source = 'if marker() then nop else nop; exit 0; marker: procedure; return 1'
    request = .lltestcompiler..request('c',source as .binary,artifacts,'if-once.crexx',1000000,512,67108864,65536,optimise)
    call check(request.status() = 0,'effectful condition accepted ' || optimise || ': ' || request.error())
    if request.status() <> 0 then iterate
    do selected = 0 to 1
      graph = request.graph(); if selected then graph = request.emissiongraph()
      text = graph.dump()
      call check(occurrences(text,'crexx.c.call ') = 1 & occurrences(text,'crexx.c.truth ') = 1,'one condition call and contextual truth ' || optimise || '/' || selected)
      call check(pos('crexx.c.call ',text) < pos('crexx.c.truth ',text),'condition precedes truth ' || optimise || '/' || selected)
    end
    output = request.output()
    if inspect <> '' then written = writebinary(inspect || '-once-' || optimise || '.rxas',output.text() as .binary)
    source = "if '1' then say 'yes' else say 'no'; exit 0"
    request = .lltestcompiler..request('c',source as .binary,artifacts,'if-literal.crexx',1000000,512,67108864,65536,optimise)
    call check(request.status() = 0,'literal condition accepted ' || optimise)
    if request.status() <> 0 then iterate
    graph = request.graph(); text = graph.dump()
    call check(occurrences(text,'crexx.c.truth ') = 1 & sourcebranches(graph) = 1,'source retains effectful truth and literal branch')
    graph = request.emissiongraph(); text = graph.dump()
    call check(occurrences(text,'crexx.c.truth ') = 1,'selected literal branch keeps contextual truth ' || optimise)
    call check(sourcebranches(graph) = 1 - optimise,'only IR-on prunes literal branch ' || optimise)
  end
  return

/** Follow the selected end path through CFG edges, not printed block order. */
iteratechecks: procedure = .void expose artifacts
  arg inspect = ''
  source = .string; selectedkey = .string; assembly = .string; instruction = .string
  sample = .int; optimise = .int; selected = .int; first = .int; expected = .int
  ordinal = .int; state = .int; i = .int; closes = .int; selectedcloses = .int
  jumps = .int; invalid = .int; reads = .int; target = .int; truthid = .int
  advanceblock = .int; exitblock = .int; entryblock = .int; advances = .int
  entries = .int; exitcloses = .int; exitadvances = .int; written = .int
  request = .lltestcompiler..request; graph = .llir..module; output = .llir..output
  operation = .llir..opview
  do sample = 1 to 5
    expected = 1; ordinal = 1; instruction = 'iterate'
    select sample
      when 1 then source = 'do i=1 by 2 for 2 until flag; do j=10 for 2; iterate I; end; end'
      when 2 then source = 'do i=1 by 2 for 2; do forever; do; select; when 1 then do j=10; iterate I; end; end; end; end; end'
      when 3 then do; source = 'do i=1 for 1; do I=10 for 2; iterate i; end; end'; expected = 0; ordinal = 2; end
      when 4 then do; source = 'do i=1; do j=10; leave I; end; end'; expected = 2; instruction = 'leave'; end
      otherwise do; source = 'options levelc strictc; do i=1; do j=10; iterate Ghost; end; end'; expected = 0; end
    end
    first = pos(instruction,source) - 1
    do optimise = 0 to 1
      request = .lltestcompiler..request('c',source as .binary,artifacts,'iterate-shape.crexx',1000000,512,67108864,65536,optimise)
      call check(request.status() = 0,'ITERATE shape accepted ' || sample || '/' || optimise || ': ' || request.error())
      if request.status() <> 0 then iterate
      do selected = 0 to 1
        graph = request.graph(); if selected then graph = request.emissiongraph()
        selectedkey = ''; state = 0
        do i = 1 to graph.operations()
          operation = graph.operation(i)
          if operation.name() <> 'crexx.c.do.new' then iterate
          state = state + 1
          if state = ordinal then selectedkey = operation.attribute('key') as .string
        end
        call check(selectedkey <> '', 'selected static state is declared')
        closes = 0; selectedcloses = 0; jumps = 0; invalid = 0; reads = 0; target = 0
        do i = 1 to graph.operations()
          operation = graph.operation(i)
          if operation.origin().first() <> first then iterate
          select operation.name()
            when 'crexx.c.do.close' then do
              closes = closes + 1
              if (operation.attribute('key') as .string) = selectedkey then selectedcloses = selectedcloses + 1
            end
            when 'core.jump' then do; jumps = jumps + 1; target = operation.successor(1); end
            when 'crexx.c.load' then reads = reads + 1
            when 'crexx.c.transfer.invalid' then do
              invalid = invalid + 1
              call check((operation.attribute('code') as .string) = '28.4' & (operation.attribute('name') as .string) = 'Ghost','invalid ITERATE keeps exact code/raw name')
            end
            otherwise nop
          end
        end
        call check(closes = expected & reads = 0,'transfer closes only crossed owners without target pool reads')
        if sample < 4 then do
          call check(selectedcloses = 0 & jumps = 1 & invalid = 0,'ITERATE preserves selected owner and has one normal edge')
          truthid = 0; advanceblock = target; exitblock = 0; entryblock = 0
          if sample = 1 then do
            do i = 1 to graph.operations()
              operation = graph.operation(i)
              if operation.blockid() = target & operation.name() = 'crexx.c.until.truth' then truthid = operation.result().id()
            end
            do i = 1 to graph.operations()
              operation = graph.operation(i)
              if operation.blockid() <> target | operation.name() <> 'core.branch' then iterate
              if operation.input(1).id() = truthid then do; exitblock = operation.successor(1); advanceblock = operation.successor(2); end
            end
            call check(truthid > 0 & exitblock > 0 & advanceblock > 0,'selected continuation evaluates UNTIL before choosing exit or advance')
          end
          advances = 0; entries = 0; exitcloses = 0; exitadvances = 0
          do i = 1 to graph.operations()
            operation = graph.operation(i)
            if operation.blockid() = advanceblock then do
              if operation.name() = 'crexx.c.do.advance' then if (operation.attribute('key') as .string) = selectedkey then advances = advances + 1
              if operation.name() = 'core.jump' then entryblock = operation.successor(1)
            end
            if sample = 1 & operation.blockid() = exitblock then do
              if operation.name() = 'crexx.c.do.close' then if (operation.attribute('key') as .string) = selectedkey then exitcloses = exitcloses + 1
              if operation.name() = 'crexx.c.do.advance' then exitadvances = exitadvances + 1
            end
          end
          do i = 1 to graph.operations()
            operation = graph.operation(i)
            if operation.blockid() = entryblock & operation.name() = 'crexx.c.do.entry' then if (operation.attribute('key') as .string) = selectedkey then entries = entries + 1
          end
          call check(advances = 1 & entries = 1,'selected advance returns to selected count/TO entry')
          if sample = 1 then call check(exitcloses = 1 & exitadvances = 0,'true UNTIL closes selected state without advancing it')
        end
        else if sample = 4 then call check(selectedcloses = 1 & jumps = 1 & invalid = 0,'shared LEAVE still closes selected state and exits')
        else call check(closes = 0 & jumps = 0 & invalid = 1,'invalid ITERATE has no normal cleanup/jump continuation')
      end
      output = request.output(); assembly = output.text()
      call check(occurrences(assembly,',llctarget.invalidtransfer(),') = (sample = 5),'only invalid ITERATE calls the shared bridge')
      if inspect <> '' then written = writebinary(inspect || '-iterate-' || sample || '-' || optimise || '.rxas',assembly as .binary)
    end
  end
  return

/** A static LEAVE edge closes exactly crossed owners and then jumps. */
leavechecks: procedure = .void expose artifacts
  arg inspect = '', invalidonly = 0
  source = .string; sample = .int; optimise = .int; selected = .int
  expected = .int; first = .int; closes = .int; jumps = .int; invalid = .int
  written = .int; i = .int; text = .string; assembly = .string
  request = .lltestcompiler..request; graph = .llir..module; output = .llir..output
  operation = .llir..opview
  do sample = 1 to 6
    if invalidonly & sample <> 6 then iterate
    expected = 1
    select sample
      when 1 then do; source = 'do i=1; do j=1; leave i; end; end'; expected = 2; end
      when 2 then source = 'do i=1 for 1; do i=10 for 1; leave i; end; end'
      when 3 then source = 'do i=1; do forever; do; select; when 1 then leave i; end; end; end; end'
      when 4 then source = 'do 2; do 3; leave; end; end'
      when 5 then do; source = 'do A.KEY=1; do j=1; leave a.key; end; end'; expected = 2; end
      otherwise do; source = 'options levelc strictc; do i=1; do j=1; leave Ghost; end; end'; expected = 0; end
    end
    first = pos('leave',source) - 1
    do optimise = 0 to 1
      request = .lltestcompiler..request('c',source as .binary,artifacts,'leave-shape.crexx',1000000,512,67108864,65536,optimise)
      call check(request.status() = 0,'LEAVE shape accepted ' || sample || '/' || optimise || ': ' || request.error())
      if request.status() <> 0 then iterate
      do selected = 0 to 1
        graph = request.graph(); if selected then graph = request.emissiongraph()
        text = graph.dump(); closes = 0; jumps = 0; invalid = 0
        do i = 1 to graph.operations()
          operation = graph.operation(i)
          if operation.origin().first() <> first then iterate
          if operation.name() = 'crexx.c.do.close' then closes = closes + 1
          if operation.name() = 'core.jump' then jumps = jumps + 1
          if operation.name() = 'crexx.c.transfer.invalid' then do
            invalid = invalid + 1
            call check((operation.attribute('code') as .string) = '28.3' & (operation.attribute('name') as .string) = 'Ghost','invalid edge retains exact code/raw name')
          end
        end
        call check(closes = expected,'LEAVE edge closes only crossed owners ' || sample || '/' || optimise || '/' || selected)
        if sample < 6 then do
          call check(jumps = 1 & invalid = 0,'valid LEAVE is one direct jump ' || sample || '/' || optimise || '/' || selected)
          call check(pos('crexx.c.load ',text) = 0,'static target adds no runtime pool-name read ' || sample || '/' || optimise || '/' || selected)
        end
        else call check(jumps = 0 & invalid = 1,'invalid edge has no normal cleanup/jump continuation')
      end
      output = request.output(); assembly = output.text()
      call check(occurrences(assembly,',llctarget.invalidtransfer(),') = (sample = 6),'only invalid transfer calls the shared error bridge')
      call check(pos('.srcstep',assembly) > 0 & pos('leave-shape.crexx',assembly) > 0,'LEAVE keeps authored source/fatal metadata')
      if inspect <> '' then written = writebinary(inspect || '-leave-' || sample || '-' || optimise || '.rxas',assembly as .binary)
    end
  end
  return

/** Keyed DO owns state only for count/control and preserves header order. */
dochecks: procedure = .void expose artifacts
  arg inspect = '', repaironly = 0
  source = .string; text = .string; assembly = .string; sample = .int; optimise = .int; selected = .int
  states = .int; captures = .int; starts = .int; written = .int
  request = .lltestcompiler..request; graph = .llir..module; output = .llir..output
  operation = .llir..opview; entryvalue = .int; whileblock = .int; guarded = .int; i = .int
  whilefirst = .int; whilelast = .int; whilecalls = .int; incoming = .int; edge = .int
  do sample = 1 to 10
    if repaironly & sample <> 9 then iterate
    select sample
      when 1 then do; source = 'do; nop; end'; states = 0; captures = 0; starts = 0; end
      when 2 then do; source = 'do forever; leave; end'; states = 0; captures = 0; starts = 0; end
      when 3 then do; source = 'do while flag; leave; end'; states = 0; captures = 0; starts = 0; end
      when 4 then do; source = 'do until flag; nop; end'; states = 0; captures = 0; starts = 0; end
      when 5 then do; source = 'do 2; nop; end'; states = 1; captures = 1; starts = 0; end
      when 6 then do; source = 'do i=1 to 2 by 1 for 1; nop; end i'; states = 1; captures = 4; starts = 1; end
      when 7 then do; source = 'do 2; do forever; leave; end; end'; states = 1; captures = 1; starts = 0; end
      when 8 then do; source = 'do i=1 for 2; select; when flag then iterate; otherwise leave; end; end'; states = 1; captures = 2; starts = 1; end
      when 9 then do; source = 'do 2; do j=1 for 2; exit 0; end; end; exit 0; p: procedure; do 2; do k=1 for 2; return 7; end; end'; states = 4; captures = 6; starts = 2; end
      otherwise do; source = "do until '1'; leave; end"; states = 0; captures = 0; starts = 0; end
    end
    do optimise = 0 to 1
      request = .lltestcompiler..request('c',source as .binary,artifacts,'do-shape.crexx',1000000,512,67108864,65536,optimise)
      call check(request.status() = 0,'DO endpoint source accepted ' || sample || '/' || optimise || ': ' || request.error())
      if request.status() <> 0 then iterate
      graph = request.graph(); text = graph.dump()
      call check(occurrences(text,'crexx.c.do.new ') = states,'one static constructor per counted/controlled header ' || sample || '/' || optimise)
      call check(occurrences(text,'crexx.c.do.capture ') = captures,'one capture per authored header term ' || sample || '/' || optimise)
      if states = 0 then call check(pos('crexx.c.do.',text) = 0,'state-free DO has no owned state protocol ' || sample || '/' || optimise)
      if sample = 10 then call check(pos('crexx.c.until.truth',text) = 0 & pos('crexx.c.do.advance',text) = 0,'closed body cannot execute UNTIL or advance ' || optimise)
      output = request.output(); assembly = output.text()
      call check(occurrences(assembly,',llctarget.donew(),') = states,'one factory call per static state ' || sample || '/' || optimise)
      call check(occurrences(assembly,',llctarget.dostart(),') = starts,'count start emits no runtime start call ' || sample || '/' || optimise)
      call check(pos('.srcstep',assembly) > 0 & pos('do-shape.crexx',assembly) > 0,'DO source/fatal locations retained ' || sample || '/' || optimise)
      if inspect <> '' & (sample = 5 | sample = 6 | sample = 8 | sample = 9) then written = writebinary(inspect || '-do-' || sample || '-' || optimise || '.rxas',assembly as .binary)
    end
  end
  source = "do i=mark('S',1) for mark('F',2) by mark('B',1) to mark('T',3) while mark('W',1); leave; end; exit 0; mark: procedure; arg label,value; return value"
  do optimise = 0 to 1
    request = .lltestcompiler..request('c',source as .binary,artifacts,'do-once.crexx',1000000,512,67108864,65536,optimise)
    call check(request.status() = 0,'effectful header/WHILE source accepted ' || optimise || ': ' || request.error())
    if request.status() <> 0 then iterate
    do selected = 0 to 1
      graph = request.graph(); if selected then graph = request.emissiongraph()
      text = graph.dump()
      call check(occurrences(text,'crexx.c.call ') = 5 & occurrences(text,'crexx.c.requirevalue ') = 5,'one evaluation/result check per authored term ' || optimise || '/' || selected)
      call check(occurrences(text,'crexx.c.do.capture ') = 4 & occurrences(text,'crexx.c.do.start ') = 1 & occurrences(text,'crexx.c.while.truth ') = 1,'captures/start/contextual WHILE are retained ' || optimise || '/' || selected)
      entryvalue = 0; whileblock = 0; guarded = 0; incoming = 0; whilecalls = 0
      whilefirst = pos("mark('W',1)",source) - 1; whilelast = whilefirst + length("mark('W',1)")
      do i = 1 to graph.operations()
        operation = graph.operation(i)
        if operation.name() = 'crexx.c.do.entry' then entryvalue = operation.result().id()
        if operation.name() = 'crexx.c.call' & operation.origin().first() = whilefirst & operation.origin().last() = whilelast then do
          whileblock = operation.blockid(); whilecalls = whilecalls + 1
        end
      end
      do i = 1 to graph.operations()
        operation = graph.operation(i)
        do edge = 1 to operation.successors()
          if operation.successor(edge) = whileblock then incoming = incoming + 1
        end
        if operation.name() <> 'core.branch' then iterate
        if operation.input(1).id() = entryvalue then guarded = operation.successor(1) = whileblock
      end
      call check(entryvalue > 0 & whileblock > 0 & whilecalls = 1 & incoming = 1 & guarded,'count/TO true edge alone reaches authored WHILE work ' || optimise || '/' || selected)
    end
    output = request.output()
    if inspect <> '' then written = writebinary(inspect || '-do-once-' || optimise || '.rxas',output.text() as .binary)
  end
  return

/** Ordered WHEN edges retain truth; only open endpoints need convergence. */
selectchecks: procedure = .void expose artifacts
  arg inspect = ''
  source = .string; expected = .int; missing = .int; written = .int
  sample = .int; optimise = .int; selected = .int; request = .lltestcompiler..request
  graph = .llir..module; output = .llir..output; text = .string
  do sample = 1 to 7
    select sample
      when 1 then do; source = 'select; when flag then exit 0; otherwise exit 1; end'; expected = 2; missing = 0; end
      when 2 then do; source = 'exit 0; p: procedure; arg flag; select; when flag then return 1; otherwise return 2; end'; expected = 1; missing = 0; end
      when 3 then do; source = 'select; when flag then select; when inner then exit 0; otherwise exit 1; end; otherwise exit 2; end'; expected = 3; missing = 0; end
      when 4 then do; source = 'do while flag; select; when flag then leave; otherwise iterate; end; end'; expected = 1; missing = 0; end
      when 5 then do; source = 'select; when flag then nop; otherwise; end'; expected = 1; missing = 0; end
      when 6 then do; source = 'select; when flag then exit 0; end; nop; options 42'; expected = 2; missing = 1; end
      otherwise do; source = 'select; when flag then nop; when other then nop; end'; expected = 2; missing = 1; end
    end
    do optimise = 0 to 1
      request = .lltestcompiler..request('c',source as .binary,artifacts,'select-shape.crexx',1000000,512,67108864,65536,optimise)
      call check(request.status() = 0,'SELECT endpoint source accepted ' || sample || '/' || optimise || ': ' || request.error())
      if request.status() <> 0 then iterate
      graph = request.graph(); text = graph.dump()
      if sample = 5 | sample = 7 then call check(pos('select.join.',text) > 0,'open SELECT endpoints retain convergence ' || sample || '/' || optimise)
      else call check(pos('select.join.',text) = 0,'closed SELECT endpoints add no join ' || sample || '/' || optimise)
      call check(sourcepackets(graph) = expected,'only EXIT/missing/normal structural packets ' || sample || '/' || optimise)
      call check(occurrences(text,'crexx.c.select.missing') = missing,'only absent OTHERWISE emits missing path ' || sample || '/' || optimise)
      output = request.output()
      call check(pos('.srcstep',output.text()) > 0 & pos('select-shape.crexx',output.text()) > 0,'SELECT source/fatal records retained ' || sample || '/' || optimise)
      if inspect <> '' & (sample = 1 | sample = 2 | sample = 4 | sample = 6) then written = writebinary(inspect || '-select-' || sample || '-' || optimise || '.rxas',output.text() as .binary)
    end
  end
  do optimise = 0 to 1
    source = 'select; when marker() then nop; when marker() then nop; otherwise nop; end; exit 0; marker: procedure; return 1'
    request = .lltestcompiler..request('c',source as .binary,artifacts,'select-once.crexx',1000000,512,67108864,65536,optimise)
    call check(request.status() = 0,'effectful WHEN conditions accepted ' || optimise || ': ' || request.error())
    if request.status() <> 0 then iterate
    do selected = 0 to 1
      graph = request.graph(); if selected then graph = request.emissiongraph()
      text = graph.dump()
      call check(occurrences(text,'crexx.c.call ') = 2 & occurrences(text,'crexx.c.when.truth ') = 2,'one call/contextual truth per WHEN ' || optimise || '/' || selected)
      call check(pos('crexx.c.call ',text) < pos('crexx.c.when.truth ',text),'first condition precedes its truth ' || optimise || '/' || selected)
    end
    output = request.output()
    if inspect <> '' then written = writebinary(inspect || '-select-once-' || optimise || '.rxas',output.text() as .binary)
    source = "select; when '1' then nop; when marker() then say 'wrong'; otherwise nop; end; exit 0; marker: procedure; return 1"
    request = .lltestcompiler..request('c',source as .binary,artifacts,'select-literal.crexx',1000000,512,67108864,65536,optimise)
    call check(request.status() = 0,'literal WHEN accepted ' || optimise)
    if request.status() <> 0 then iterate
    graph = request.graph(); text = graph.dump()
    call check(occurrences(text,'crexx.c.when.truth ') = 2 & occurrences(text,'crexx.c.call ') = 1,'source retains both checked WHEN paths')
    graph = request.emissiongraph(); text = graph.dump()
    call check(occurrences(text,'crexx.c.when.truth ') = 2 - optimise,'selected first literal keeps its contextual truth ' || optimise)
    call check(occurrences(text,'crexx.c.call ') = 1 - optimise,'only IR-on prunes dormant later WHEN evaluation ' || optimise)
  end
  request = .lltestcompiler..request('c','select; when 0 then nop; end' as .binary,artifacts)
  call check(request.status() = 0,'default anonymous source admits indexed missing path: ' || request.error())
  if request.status() = 0 then do
    output = request.output(); call check(pos('<source>',output.text()) > 0,'anonymous service keeps its logical source identity')
  end
  return

/** Count authored control separately from the required checked-entry branch.
 * This preserves the source-fold oracle when dispatch remains effectful. */
sourcebranches: procedure = .int
  arg graph = .llir..module
  store = dereference graph.storage(); count = 0
  do i = 1 to graph.operations()
    op = graph.operation(i)
    if op.name() <> 'core.branch' then iterate
    producer = store.get(4,op.input(1).id(),1)
    if graph.operation(producer).name() <> 'crexx.c.entry.test' & graph.operation(producer).name() <> 'crexx.c.program.exiting' then count = count + 1
  end
  return count

/** entry.invalid has one mandated cold closure. EXIT owns its real packet,
 * while missing/normal closures remain absent; guards reuse existing packets. */
sourcepackets: procedure = .int
  arg graph = .llir..module
  i = .int; op = .llir..opview
  store = dereference graph.storage(); count = 0; closures = 0; exitpackets = .int[]
  do i = 1 to graph.operations()
    op = graph.operation(i)
    if op.name() = 'crexx.c.exit' then exitpackets[store.get(4,op.input(1).id(),1)] = 1
  end
  do i = 1 to graph.operations()
    op = graph.operation(i)
    if op.name() <> 'crexx.c.return.absent' then do
      if op.name() = 'crexx.c.return.present' & exitpackets[op.id()] then count = count + 1
      iterate
    end
    first = store.get(2,op.blockid(),2)
    if graph.operation(first).name() = 'crexx.c.entry.invalid' then closures = closures + 1
    else count = count + 1
  end
  call check(closures = 1,'one required generated invalid-entry closure')
  return count

irshape: procedure = .string
  arg graph = .llir..module
  value = .llir..valuehandle
  data = dereference graph.storage()
  text = data.count(1) || '/' || data.count(2) || '/' || data.count(3) || '/' || data.count(4) || '/' || data.count(5)
  do i = 1 to graph.operations()
    op = graph.operation(i); text = text || '|' || op.name() || ':' || op.inputs() || ':' || op.results() || ':' || op.successors()
    do input = 1 to op.inputs(); value = op.input(input); text = text || ',' || value.id(); end
    if op.name() = 'core.constant' then do; value = op.result(); text = text || ':' || bin2x(value.bytes()); end
  end
  return text

execshape: procedure = .string
  arg source = .string, logical = 'nop-shape.crexx'
  text = ''; start = 1
  do while start <= length(source)
    finish = pos('0A'x as .string,source,start)
    if finish = 0 then finish = length(source) + 1
    line = strip(substr(source,start,finish - start)); start = finish + 1
    if line = '' | left(line,1) = '.' then iterate
    if pos(logical || ':',line) > 0 then do
      quote = pos('"',line)
      if quote > 0 then line = left(line,quote - 1) || '"<diagnostic location>"'
    end
    text = text || line || ('0A'x as .string)
  end
  return text

check: procedure = .void expose checks failures
  arg condition = .int, name = .string
  checks = checks + 1
  if condition then return
  failures = failures + 1; say 'FAIL|' || name
  return
provenance: procedure = .void expose artifacts
  call check(llcompilercontracts..sourcename('/one/two/demo.rexx') = 'demo.rexx','Unix physical source name')
  call check(llcompilercontracts..sourcename('C:\one\demo.rexx') = 'demo.rexx','Windows physical source name')
  call check(llcompilercontracts..sourcename('\\server\share\demo.rexx') = 'demo.rexx','UNC physical source name')
  call check(llcompilercontracts..sourcename('examples/demo.rexx') = 'examples/demo.rexx','explicit relative source name')
  call check(llcompilercontracts..sourcename('examples/demo.rexx',1) = 'demo.rexx','CLI relative physical name')
  call check(llcompilercontracts..sourcename('<source>') = '<source>','in-memory source name')
  one = .lltestcompiler..request('g','say 1' as .binary,artifacts,'/root-one/demo.rexx')
  two = .lltestcompiler..request('g','say 1' as .binary,artifacts,'C:\root-two\demo.rexx')
  first = one.output(); second = two.output()
  call check(one.status() = 0 & two.status() = 0 & first.text() = second.text(),'physical roots produce identical RXAS')
  one = .lltestcompiler..request('g','say 1' as .binary,artifacts,'one/demo.rexx')
  two = .lltestcompiler..request('g','say 1' as .binary,artifacts,'two/demo.rexx')
  first = one.output(); second = two.output()
  call check(first.text() <> second.text(),'logical names disambiguate colliding basenames')
  one = .lltestcompiler..request('g','say +' as .binary,artifacts,'/private/root/bad.rexx')
  call check(pos('bad.rexx:',one.diagnostic()) = 1 & pos('/private',one.diagnostic()) = 0,'diagnostic uses logical source')
  schema = .llir..schema(); call lltestfamilies..registerfamilies(reference schema)
  contract = schema.finish(); builder = .llir..builder(contract)
  text = 'CEB1CEB20D0A'x as .binary || 'say 1+2' as .binary
  file = builder.source('/physical/unicode.rexx',text)
  at = file.origin(10,13); derived = at.derive(); composite = file.origin(0,13,'composite')
  synthetic = builder.synthetic('not an authored filename')
  fn = builder.function('$MAIN',contract.type('crexx.g.int64')); block = fn.block('entry')
  a = block.constant(contract.type('crexx.g.int64'),'1',at)
  b = block.constant(contract.type('crexx.g.int64'),'2',at)
  c = block.constant(contract.type('crexx.g.int64'),'3',derived)
  d = block.constant(contract.type('crexx.g.int64'),'4',composite)
  e = block.constant(contract.type('crexx.g.int64'),'5',synthetic)
  call block.returnvalue(a,synthetic)
  graph = builder.finish(); saved = graph.binary()
  backend = .lltestrxas..compilation(graph,'g',artifacts); output = backend.output(); assembly = output.text()
  call check(backend.status() = 0,'provenance graph admitted: ' || backend.error())
  exact = ' 0 17 "unicode.rexx" 2 5 8 "say 1+2"'
  call check(pos(exact,assembly) > 0 & occurrences(assembly,exact) = 1,'full exact span, CRLF and unchanged anchor deduplication')
  call check(pos(' 0 34 "unicode.rexx" 2 5 8 ',assembly) > 0,'derived origin retains generated/inherited flags')
  call check(pos(' 0 65 "unicode.rexx" 1 1 3 ',assembly) > 0,'multiline composite first-line Unicode range')
  call check(pos(' 0 6 "" 0 0 0 ""',assembly) > 0,'synthetic source has no authored coordinates')
  call check(pos('not an authored filename',assembly) = 0,'synthetic description is not a filename')
  call check(occurrences(assembly,'.srcstep 0 0 6 "" 0 0 0 ""') = 2,'entry and function clear preceding metadata')
  call check(bin2x(saved) = bin2x(graph.binary()),'backend preserves full IR source ranges')
  return
occurrences: procedure = .int
  arg text = .string, needle = .string
  count = 0; start = 1
  do forever
    found = pos(needle,text,start)
    if found = 0 then return count
    count = count + 1; start = found + length(needle)
  end
retained: procedure = .llir..output expose artifacts
  request = .lltestcompiler..request('g',"say 'owned'" as .binary,artifacts,'owned.crexx')
  return request.output()
requests: procedure = .void expose artifacts
  output = retained()
  call check(output.error() = '' & pos('owned',output.text()) > 0,'output outlives request')
  saved = output.text()
  request = .lltestcompiler..request; other = .llir..output
  do i = 1 to 4
    request = .lltestcompiler..request('g','say 3' as .binary,artifacts,'three.crexx')
    call check(request.status() = 0 & request.status() = 0,'idempotent request ' || i)
    other = request.output(); call check(pos('three.crexx',other.text()) > 0,'independent source identity')
    call check(output.text() = saved,'previous output unchanged')
  end
  request = .lltestcompiler..request('g','say 1 +' as .binary,artifacts,'bad.crexx')
  call check(request.status() <> 0 & pos('LL_COMPILER_SYNTAX',request.diagnostic()) > 0,'syntax diagnostic')
  other = request.output(); call check(other.error() <> '' & other.bytes() = 0,'no partial syntax output')
  request = .lltestcompiler..request('g','say 1' as .binary,artifacts,'bounded.crexx',1000000,512,10)
  call check(request.status() <> 0 & pos('LIMIT',request.error()) > 0,'output budget')
  other = request.output(); call check(other.bytes() = 0,'no partial bounded output')
  request = .lltestcompiler..request('g','say 1 + 2 + 3 + 4 + 5 + 6 + 7 + 8 + 9' as .binary,artifacts,'bounded.crexx',1000000,512,67108864,16,0)
  call check(request.status() <> 0 & pos('LIMIT',request.error()) > 0,'register budget')
  request = .lltestcompiler..request('g','say 1' as .binary,artifacts,'bounded.crexx',1)
  call check(request.status() <> 0,'frontend operation budget')
  request = .lltestcompiler..request('c','say 1' as .binary,artifacts || '/missing','missing.crexx')
  call check(request.status() <> 0,'missing target contract')
  request = .lltestcompiler..request('g',"import rxfnsb; say length('x')" as .binary,artifacts || '/missing','missing.crexx')
  call check(request.status() <> 0 & pos('IMPORT',request.error()) > 0,'missing source import')
  call check(lltestrxas..quote('00225C0D0ACEB1'x as .binary) = '"\x00\x22\x5C\x0D\x0A\xCE\xB1"','byte exact target quoting')
  request = .lltestcompiler..request('g','d = .decimal; say d' as .binary,artifacts,'decimal.crexx')
  graph = request.graph(); call check(pos('crexx.g.decimal.default',graph.dump()) > 0,'decimal absence retained in IR')
  return
cleanup: procedure = .void expose artifacts
  request = .lltestcompiler..request('g','say 1' as .binary,artifacts,'lean.crexx',1000000,512,67108864,16,0)
  output = request.output(); text = output.text(); graph = request.graph()
  call check(request.status() = 0,'small program fits minimum register budget')
  call check(pos('main() .locals=2',text) > 0 & pos('llf1() .locals=4',text) > 0,'call-free body and entry use only needed registers')
  call check(pos('core.constant  : crexx.g.text',graph.dump()) = 0,'explicit G SAY constructs no empty default')
  call check(pos('br llb1',text) = 0,'entry falls through to its first block')
  request = .lltestcompiler..request('c','x = 1; say x' as .binary,artifacts,'lean.crexx')
  graph = request.graph(); output = request.output()
  call check(request.status() = 0 & pos('core.constant  : crexx.c.value',graph.dump()) = 0,'explicit C assignment and SAY construct no unused defaults')
  do i = 1 to 2
    level = word('g c',i)
    request = .lltestcompiler..request(level,'say' as .binary,artifacts,'blank.crexx')
    graph = request.graph()
    call check(request.status() = 0 & pos('core.constant  : ',graph.dump()) > 0,level || ' bare SAY retains empty value')
  end
  request = .lltestcompiler..request('g','s = .string; say s' as .binary,artifacts,'default.crexx')
  graph = request.graph()
  call check(request.status() = 0 & pos('core.constant  : crexx.g.text',graph.dump()) > 0,'declared text default retained')
  return
graphs: procedure = .void expose artifacts
  front = .lltestfrontend..request('g','say 1' as .binary,artifacts,'stable.crexx')
  graph = front.graph(); before = graph.binary()
  backend = .lltestrxas..compilation(graph,'g',artifacts)
  call check(backend.status() = 0,'direct backend')
  call check(bin2x(graph.binary()) = bin2x(before),'IR immutable after selection')
  backend = .lltestrxas..compilation(graph,'c',artifacts)
  call check(backend.status() <> 0,'wrong language ABI')
  schema = .llir..schema(); call lltestfamilies..registerfamilies(reference schema)
  contract = schema.finish(); builder = .llir..builder(contract)
  origin = builder.synthetic('test')
  fn = builder.function('$MAIN',contract.type('crexx.g.int64')); block = fn.block('entry')
  value = block.constant(contract.type('crexx.g.int64'),'0',origin)
  call block.returnvalue(value,origin); graph = builder.finish()
  backend = .lltestrxas..compilation(graph,'g',artifacts)
  call check(backend.status() = 0,'synthetic source origin')
  builder = .llir..builder(contract); fn = builder.function('$MAIN',contract.type('crexx.g.int64')); block = fn.block('entry')
  graph = builder.finish(); backend = .lltestrxas..compilation(graph,'g',artifacts)
  call check(backend.status() <> 0,'unterminated graph rejected')
  builder = .llir..builder(contract); graph = builder.finish(); backend = .lltestrxas..compilation(graph,'g',artifacts)
  call check(backend.status() <> 0,'empty graph rejected')
  /* A valid foreign graph with a forged known operation shape. */
  schema = .llir..schema(); family = schema.family('crexx.g',1)
  integer = family.type('int64',.llir..intcodec() as .object)
  declared = family.operation('int64.add'); call declared.input('wrong',integer); call declared.output('value',integer)
  contract = schema.finish(); builder = .llir..builder(contract); origin = builder.synthetic('forged')
  fn = builder.function('$MAIN',integer); block = fn.block('entry')
  value = block.constant(integer,'1',origin); draft = block.operation(contract.operation('crexx.g.int64.add'),origin)
  call draft.input('wrong',value); op = draft.finish(); call block.returnvalue(op.result(),origin)
  graph = builder.finish(); call check(graph.error() = '', 'forged graph structurally valid')
  backend = .lltestrxas..compilation(graph,'g',artifacts)
  call check(backend.status() <> 0 & pos('incompatible operation',backend.error()) > 0,'forged target shape rejected')
  /* A hostile codec with a familiar type name cannot inject target text. */
  schema = .llir..schema(); family = schema.family('crexx.g',1)
  integer = family.type('int64',.injectcodec() as .object); contract = schema.finish()
  builder = .llir..builder(contract); origin = builder.synthetic('codec')
  fn = builder.function('$MAIN',integer); block = fn.block('entry')
  value = block.constantbytes(integer,'0000000000000000'x as .binary,origin)
  call block.returnvalue(value,origin); graph = builder.finish()
  backend = .lltestrxas..compilation(graph,'g',artifacts); output = backend.output()
  call check(backend.status() = 0 & pos('INJECTED',output.text()) = 0,'canonical target codec ignores foreign formatter')
  builder = .llir..builder(contract); origin = builder.synthetic('bad codec bytes')
  fn = builder.function('$MAIN',integer); block = fn.block('entry')
  value = block.constantbytes(integer,'FF'x as .binary,origin); call block.returnvalue(value,origin)
  graph = builder.finish(); backend = .lltestrxas..compilation(graph,'g',artifacts)
  call check(backend.status() <> 0 & pos('invalid constant bytes',backend.error()) > 0,'canonical codec rejects forged bytes')
  return
injectcodec: class implements .llir..typecodec
  *: factory
    return
  parse: method = .binary
    arg text = .string
    return text as .binary
  check: method = .string
    arg bytes = .binary
    return ''
  format: method = .string
    arg bytes = .binary
    return 'INJECTED'

literals: procedure = .void expose artifacts outputfile
  schema = .llir..schema(); call lltestfamilies..registerfamilies(reference schema)
  contract = schema.finish(); builder = .llir..builder(contract); at = builder.synthetic('exact binary literals')
  fn = builder.function('$MAIN',contract.type('crexx.g.int64')); entry = fn.block('entry')
  text = entry.constantbytes(contract.type('crexx.g.text'),'410042225CCEB1'x as .binary,at)
  draft = entry.operation(contract.operation('crexx.g.say'),at); call draft.input('text',text); op = draft.finish()
  zero = entry.constantbytes(contract.type('crexx.g.float64'),'0000000000000080'x as .binary,at)
  one = entry.constant(contract.type('crexx.g.float64'),'1',at)
  value = entry.binary(contract.operation('crexx.g.float64.div'),one,zero,at)
  draft = entry.operation(contract.operation('crexx.g.convert.float64.text'),at); call draft.input('value',value); op = draft.finish()
  text = op.result(); draft = entry.operation(contract.operation('crexx.g.say'),at); call draft.input('text',text); op = draft.finish()
  status = entry.constant(contract.type('crexx.g.int64'),'0',at); call entry.returnvalue(status,at)
  graph = builder.finish(); backend = .lltestrxas..compilation(graph,'g',artifacts); output = backend.output()
  call check(backend.status() = 0,'exact literal graph: ' || backend.error())
  if backend.status() = 0 then call check(writebinary(outputfile,output.text() as .binary) = output.bytes(),'write exact-literal test output')
  return
