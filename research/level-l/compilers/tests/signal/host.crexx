/* SIGNAL keeps the current invocation; only completion restores private state. */
options levelb
import rexxpool
import rexxactivation
import rexxclassicconfig
import rexxclassiccontext
import signalfixture

main: procedure = .int expose checks failures
  arg argv = .string[]
  checks = 0; failures = 0
  returned = .rexxactivation..RexxActivationArguments
  if argv[0] > 0 then do
    say 'SIGNAL_FATAL|before'
    returned = invokeFixture(argv[1])
    say 'UNREACHED signal host'
    return 1
  end
  payload = 'éµμ雪' || ('00'x as .string) || 'tail '
  returned = invokeFixture('host')
  call check(returned.hasReturnValue() & returned.returnValue().asString() == payload || '|argument|private|1|argument','private SIGNAL result owns exact Unicode/NUL/trailing-space text after owners expire')
  returned = invokeFixture('exit')
  call check(returned.hasReturnValue() & returned.returnValue().asString() == payload,'operand EXIT returns full owned value after owners expire')
  say 'SIGNAL_HOST|checks=' || checks || '|failures=' || failures
  return failures

invokeFixture: procedure = .rexxactivation..RexxActivationArguments
  arg mode = .string
  activation = .rexxactivation..RexxActivationArguments(); call activation.appendText(mode)
  visible = .rexxpool..RexxVariablePool(1)
  payload = 'éµμ雪' || ('00'x as .string) || 'tail '
  call visible.setString('COUNT','0'); call visible.setString('PAYLOAD',payload)
  call visible.setString('LOCAL','caller local'); call visible.setString('.SIGL','777')
  config = .rexxclassicconfig..RexxClassicConfig('UTF8')
  context = .rexxclassiccontext..RexxClassicContext(reference activation,reference visible,reference config)
  returned = signalfixture..run(reference context,0)
  original = reference visible; rebound = context.pool()
  original_activation = reference activation; rebound_activation = context.activation()
  original_config = reference config; rebound_config = context.config()
  call check(<refvalid>(rebound) & (rebound <refsame> original),'original pool binding restored on completion')
  call check((original_activation <refsame> rebound_activation) & (original_config <refsame> rebound_config),'activation/config identity retained')
  call check(visible.symbolValue('COUNT').asString() == '1' & visible.symbolValue('LOCAL').asString() == 'caller local','once-only shared effect with private local isolation')
  if mode == 'host' then do
    call check(activation.programExitRequested() = 0,'same invocation SIGNAL returns without program EXIT')
    call check(visible.symbolValue('.SIGL').asString() == '121','private SIGNAL writes shared reserved causing line')
    call check(visible.symbolValue('SIGL').asString() == '6','ordinary caller SIGL remains the internal CALL line')
  end
  if mode == 'exit' then do
    call check(activation.programExitRequested() & activation.hasReturnValue() & activation.returnValue().asString() == payload,'operand EXIT keeps the owned root result')
    call check(visible.symbolValue('.SIGL').asString() == '777','operand EXIT bypasses outer SIGNAL mark despite nested CALL SIGL effects')
  end
  return returned

check: procedure = .void expose checks failures
  arg passed = .int, label = .string
  checks = checks + 1
  if passed then return
  failures = failures + 1; say 'FAIL|' || label
  return
