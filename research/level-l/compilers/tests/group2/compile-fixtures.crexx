/* cREXX License (MIT). Ordered Group 2 requests in one warm compiler worker.
 * This maintained fixture transport uses the existing public compiler service.
 * Each successful request publishes then invokes the explicit owning assembler.
 */
options levelb
namespace g2compile
import rxfnsb
import _rxsysb
import llccompiler
import llcbindings
import llcdiagnostics
import llfileoutput

main: procedure = .int
  arg argv = .string[]
  if argv[0] <> 3 then return 2
  artifacts = argv[1]; rows = readlines(argv[2]); assembler_path = argv[3]
  requests = 0; index = .int; binding_index = .int; status = .int
  do row_index = 1 to rows[0]
    fields = splitrow(rows[row_index])
    if fields[0] < 7 then return 2
    sourcefile = fields[1]; output = fields[2]; logical = fields[3]
    routine = fields[4]; host = fields[5]; expected = fields[6]; count = fields[7] as .int
    if count < 0 | fields[0] <> 7 + count * 3 then return 2
    bindings = .llcbindings..binding[]
    do binding_index = 1 to count
      at = 8 + (binding_index - 1) * 3
      select fields[at]
        when 'rxbin' then bindings[binding_index] = .llcbindings..binding(fields[at + 1],fields[at + 2])
        when 'native' then bindings[binding_index] = .llcbindings..binding.native(fields[at + 1],fields[at + 2])
        when 'process' then bindings[binding_index] = .llcbindings..binding.process(fields[at + 1],fields[at + 2])
        otherwise return 2
      end
    end
    say 'START|' || logical
    do
      source = readbinary(sourcefile)
      request = .llccompiler..request(source,artifacts,logical,1000000,512,67108864,65536,1,bindings,routine,host)
      status = request.status(); warnings = request.warnings(); warning = .llcdiagnostics..warning
      do index = 1 to warnings[0]
        warning = warnings[index]; call lineout 'stderr',warning.text()
      end
      requests = requests + 1
      if expected <> '' then do
        if status = 0 | pos(expected,request.error()) = 0 then do
          say 'FAIL|refusal|' || logical || '|' || request.diagnostic(); return 1
        end
        refused = request.output()
        if refused.bytes() <> 0 then do; say 'FAIL|partial output|' || logical; return 1; end
        say 'REFUSAL|' || logical || '|' || request.diagnostic()
        iterate
      end
      if status <> 0 then do; say 'FAIL|compile|' || logical || '|' || request.diagnostic(); return 1; end
      message = llfileoutput..publish(request.output(),output)
      if message <> '' then do; say 'FAIL|publish|' || logical || '|' || message; return 1; end
    on signal as problem
      say 'FAIL|fixture|' || logical || '|' || problem.name() || '|' || problem.message()
      return 1
    end
    /* Keep child exit notifications outside the compiler's protected block. */
    arguments = .string[]
    arguments[1] = '-o'; arguments[2] = left(output,length(output) - 5) || '.rxbin'; arguments[3] = output
    status = processrun(assembler_path,arguments)
    if status <> 0 then do; say 'FAIL|assemble|' || logical || '|' || status; return 1; end
    say 'COMPILED|' || logical
  end
  say 'GROUP2_FIXTURES|requests=' || requests || '|PASS'
  return 0

splitrow: procedure = .string[]
  arg row = .string
  fields = .string[]
  do forever
    delimiter = pos('|',row)
    if delimiter = 0 then do; fields[fields[0] + 1] = row; return fields; end
    fields[fields[0] + 1] = left(row,delimiter - 1)
    row = substr(row,delimiter + 1)
  end
