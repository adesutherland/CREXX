/* cREXX License (MIT). Explicit test tool: compile only, no native delegation. */
options levelb
import rxfnsb
import lltestcompiler
main: procedure = .int
  arg argv = .string[]
  if argv[0] <> 4 then return 2
  source = readbinary(argv[2])
  request = .lltestcompiler..request(argv[1],source,argv[3],argv[2])
  if request.status() <> 0 then do
    say request.diagnostic(); return 1
  end
  output = request.output()
  if writebinary(argv[4],output.text() as .binary) <> output.bytes() then return 1
  return 0
