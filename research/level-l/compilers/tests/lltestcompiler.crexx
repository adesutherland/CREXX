/* cREXX License (MIT). Test-only cross-language corpus adapter.
 * Never included in compiler products or installed libraries. */
options levelb
namespace lltestcompiler expose request
import rxfnsb
import llir
import llccompiler
import llgcompiler

request: class
  _level = .string
  _c = .llccompiler..request
  _g = .llgcompiler..request
  *: factory
    arg level = .string, source = .binary, artifacts = '', filename = '<source>', budget = 1000000, nesting = 512, bytes = 67108864, registers = 65536, optimise = 1
    _level = lower(level)
    if _level = 'c' then _c = .llccompiler..request(source,artifacts,filename,budget,nesting,bytes,registers,optimise)
    else _g = .llgcompiler..request(source,artifacts,filename,budget,nesting,bytes,registers,optimise)
    return
  status: method = .int
    if _level = 'c' then return _c.status()
    return _g.status()
  error: method = .string
    if _level = 'c' then return _c.error()
    return _g.error()
  offset: method = .int
    if _level = 'c' then return _c.offset()
    return _g.offset()
  diagnostic: method = .string
    if _level = 'c' then return _c.diagnostic()
    return _g.diagnostic()
  output: method = .llir..output
    if _level = 'c' then return _c.output()
    return _g.output()
  graph: method = .llir..module
    if _level = 'c' then return _c.graph()
    return _g.graph()
  emissiongraph: method = .llir..module
    if _level = 'c' then return _c.emissiongraph()
    return _g.emissiongraph()
