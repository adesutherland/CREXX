/* cREXX License (MIT). C prepared-owner reuse and request isolation. */
options levelb
import rxfnsb
import llclanguage
import lllanguage
import llcsymbols
import llcparse
import llcfrontend
import llcrxas
import llir

main: procedure = .int expose checks failures inspection emission_requests emission_finished inspection_imports
  arg argv = .string[]
  argc = argv[0]; inspection = ''; emission_requests = 0; emission_finished = 0
  if argc >= 3 then do
    if argv[argc - 1] \== 'emit-only' | argv[argc] == '' then return 2
    inspection = argv[argc]; argc = argc - 2
  end
  if argc < 1 | argc > 2 then return 2
  inspection_imports = argv[1]
  checks = 0; failures = 0
  if argc = 2 then do
    if argv[2] == 'fault' then do
      call failurechecks()
      say 'C_PREPARED|checks=' || checks || '|failures=' || failures
      return failures
    end
  end
  owner = reference .lllanguage..definition
  if argc = 2 then do
    owner = llclanguage..prepared()
    call check(<refvalid>(owner) = 0,'failed preparation publishes no owner')
    repeated_failure = llclanguage..prepared()
    call check(<refvalid>(repeated_failure) = 0,'repeated failed preparation publishes no partial owner')
    refused = .llcparse..parsed('nop' as .binary)
    call check(refused.status() = 3 & pos('LL_BORROW_OWNER:',refused.error()) = 1,'source refusal after failed preparation is atomic')
    call noemission('prepared.invalid-grammar-owner')
    if inspection <> '' then do
      call check(emission_requests = 1 & emission_finished = 1,'complete failed-preparation no-emission inventory')
      say 'PREPARED_EMISSION|requests=' || emission_requests || '|complete=' || emission_finished || '|failures=' || failures
    end
    else say 'C_PREPARED|checks=' || checks || '|failures=' || failures
    return failures
  end
  owner = llclanguage..prepared(); repeated = llclanguage..prepared()
  call check(<refvalid>(owner) & (owner <refsame> repeated),'one anchored owner for repeated requests')
  call policies()
  call namechecks()
  source = .string
  do sample = 1 to 3
    select sample
      when 1 then source = "say 'x'; exit 0"
      when 2 then source = 'call p; exit 0; p: nop; return'
      otherwise source = 'call p; exit 0; p: procedure expose X (NAMES); return'
    end
    call emissionstart('prepared.source-' || sample)
    front = .llcfrontend..request(source as .binary,argv[1],'prepared-language.crexx')
    call check(front.status() = 0,'frontend ' || sample || ': ' || front.error())
    if front.status() <> 0 then iterate
    graph = front.graph(); selected = .llcrxas..compilation(graph,argv[1])
    call check(selected.status() = 0,'selector ' || sample || ': ' || selected.error())
    if selected.status() <> 0 then iterate
    previous = selected.output(); saved = previous.text()
    call emissionfinish('prepared.source-' || sample,reference graph,reference previous,1,selected.status(),selected.error())
    call check(previous.bytes() > 0,'owned nonempty output ' || sample)
    if sample = 3 then do
      store = dereference graph.storage(); contract = dereference store.contract()
      loaded = llir..loadbinary(contract,graph.binary())
      call check(loaded.error() = '', 'loaded private graph remains checked')
      call emissionstart('prepared.loaded-3')
      again = .llcrxas..compilation(loaded,argv[1]); loaded_output = again.output()
      call emissionfinish('prepared.loaded-3',reference loaded,reference loaded_output,1,again.status(),again.error())
      call check(again.status() = 0 & again.output().text() == saved,'loaded raw entry/name admission is unchanged')
    end
    current = llclanguage..prepared()
    call check(owner <refsame> current,'frontend/backend preserve prepared owner ' || sample)
  end
  call policies()
  call namechecks()
  call noemission('prepared.policy-name-ownership')
  if inspection <> '' then do
    call check(emission_requests = 4 + 1 & emission_finished = 4 + 1,'complete valid-preparation emission inventory')
    say 'PREPARED_EMISSION|requests=' || emission_requests || '|complete=' || emission_finished || '|failures=' || failures
  end
  else say 'C_PREPARED|checks=' || checks || '|failures=' || failures
  return failures

check: procedure = .void expose checks failures
  arg passed = .int, label = .string
  checks = checks + 1
  if passed then return
  failures = failures + 1; say 'FAIL|' || label
  return

/* The original event and its payload outlive both construction stack frames. */
failurechecks: procedure = .void
  first_event = capturefailure()
  call check(initialized(first_event),'first preparation throws an owned event')
  if initialized(first_event) = 0 then return
  repeated_event = capturefailure()
  call check(initialized(repeated_event),'failed owner relays its cached event')
  if initialized(repeated_event) = 0 then return
  call check(first_event.name() == 'ERROR' & first_event.code() = 3,'recursive preparation retains its tag')
  call check(repeated_event.name() == first_event.name() & repeated_event.code() = first_event.code(),'cached tag/code without reconstruction')
  first_payload = first_event.payload(); repeated_payload = repeated_event.payload()
  first_bytes = .binary; repeated_bytes = .binary
  /* Scalar types are compile-time views, not object RTTI. Inspect the physical
   * binary component without converting the generic transport into text. */
  assembler bcopy first_bytes,first_payload
  assembler bcopy repeated_bytes,repeated_payload
  payload_sizes = <blen>(first_bytes) = 26 & <blen>(repeated_bytes) = 26
  call check(payload_sizes,'cached payload retains its complete binary component')
  if payload_sizes = 0 then return
  matches = 1; byte = .int
  if payload_sizes then do byte = 0 to 25
    if <at..u8>(byte) first_bytes <> <at..u8>(byte) repeated_bytes then matches = 0
  end
  call check(matches,'cached payload retains exact NUL-bearing bytes')
  text_only = 'typed' || ('00'x as .string) || 'tail'
  projected = .binary
  assembler bcopy projected,text_only
  call check(<blen>(projected) = 0,'binary projection does not synthesize bytes from text')
  call check(first_event.module() > 0 & first_event.address() >= 0,'original preparation event has runtime provenance')
  call check(first_event.module() = <at..i64>(0) first_bytes & first_event.address() = <at..i64>(8) first_bytes,'first relay retains independently captured original module/PC')
  call check(repeated_event.module() = first_event.module() & repeated_event.address() = first_event.address(),'cached relay retains original module/PC')
  expected = '7479706564007461696c'x as .binary
  matches = 1
  do byte = 0 to <blen>(expected) - 1
    if <at..u8>(16 + byte) first_bytes <> <at..u8>(byte) expected then matches = 0
  end
  call check(matches,'typed payload retains its NUL-bearing value')
  return

capturefailure: procedure = .runtime_signal
  caught = .runtime_signal
  do
    ignored = llclanguage..prepared()
  on signal as problem
    caught = problem as .runtime_signal
  end
  return caught

policies: procedure = .void
  /* The payload must be invalid when it is not masked as a comment. */
  hash = "say 'hash'; # 'unterminated" || '0a'x || 'exit 0'
  dash = "say 'dash'; -- 'unterminated" || '0a'x || 'exit 0'
  quote_error = 'LL_COMPILER_SYNTAX: RXC-LC-6.2: unmatched single quote'
  parsed = .llcparse..parsed(('options comments_hash; ' || hash) as .binary)
  call check(parsed.status() = 0,'hash override accepts its complete source: ' || parsed.error())
  parsed = .llcparse..parsed(('options comments_dash; ' || dash) as .binary)
  call check(parsed.status() = 0,'dash override accepts its complete source: ' || parsed.error())
  parsed = .llcparse..parsed(hash as .binary)
  call check(parsed.status() = 1 & parsed.error() == quote_error & parsed.offset() = pos("'unterminated",hash) - 1,'hash override does not leak into default request: ' || parsed.error())
  parsed = .llcparse..parsed(dash as .binary)
  call check(parsed.status() = 1 & parsed.error() == quote_error & parsed.offset() = pos("'unterminated",dash) - 1,'dash override does not leak into default request: ' || parsed.error())
  parsed = .llcparse..parsed('options strictc; nop' as .binary)
  call check(parsed.status() = 0 & parsed.strictc() = 1,'STRICTC belongs to this header')
  tree = parsed.ast(); span = tree.root().finish()
  parsed = .llcparse..parsed('nop' as .binary)
  call check(parsed.status() = 0 & parsed.strictc() = 0,'next request starts with default STRICTC')
  call check(tree.root().finish() = span,'materialized prior AST owns its byte spans')
  parsed = .llcparse..parsed('options strictc comments_slash; nop' as .binary)
  call check(parsed.status() <> 0 & parsed.strictc() = 0,'failed header publishes no partial policy')
  parsed = .llcparse..parsed('nop' as .binary,2)
  call check(parsed.status() = 2,'source byte limit refuses locally')
  parsed = .llcparse..parsed('nop' as .binary)
  call check(parsed.status() = 0,'prepared owner recovers after failed header/limit')
  return

namechecks: procedure = .void
  symbols = .llcsymbols..checked()
  call symbols.symbol('#'); call symbols.symbol('α.key'); call symbols.symbol('.RC')
  call check(symbols.error() = '', 'whole generated name rule keeps Unicode/dots/hash outside source comment policy')
  invalid = .llcsymbols..checked()
  call invalid.symbol('a b')
  call check(pos('LOWERING',invalid.error()) > 0,'name refusal is independent of source/graph execution')
  clean = .llcsymbols..checked()
  call clean.symbol('valid')
  call check(clean.error() = '', 'name failure cannot poison the prepared owner')
  return

/* Inspection is test-owned transport, never part of the compiler service. */
emissionstart: procedure = .void expose inspection emission_requests
  arg caseid = .string
  if inspection == '' then return
  emission_requests = emission_requests + 1
  say 'START|' || caseid
  return

emissionfinish: procedure = .void expose inspection emission_finished inspection_imports
  arg caseid = .string, graph_ref = reference .llir..module, output_ref = reference .llir..output, expected = .int, status = .int, diagnostic = .string, bytes = 67108864, registers = 65536
  if inspection == '' then return
  graph = dereference graph_ref; output = dereference output_ref
  say 'REQUEST|' || caseid || '|imports=' || inspection_imports || '|output.bytes=' || (bytes as .string) || '|registers=' || (registers as .string)
  call check(graph.error() == '',caseid || ' inspection graph is frozen and valid')
  if graph.error() <> '' then return
  image = graph.binary()
  written = writebinary(inspection || '/' || caseid || '.llir',image) = <blen>(image)
  call check(written,caseid || ' exact temporary graph export')
  if written = 0 then return
  if expected then do
    call check(status = 0 & output.bytes() > 0,caseid || ' inspection requires accepted output: ' || diagnostic)
    if status <> 0 | output.bytes() = 0 then return
    text = output.text() as .binary
    written = writebinary(inspection || '/' || caseid || '.rxas',text) = output.bytes()
    call check(written,caseid || ' exact temporary RXAS export')
    if written = 0 then return
    say 'EMITTED|' || caseid
  end
  else do
    call check(status <> 0 & output.bytes() = 0,caseid || ' inspection refusal has no output')
    if status = 0 | output.bytes() <> 0 then return
    say 'REFUSAL|' || caseid || '|' || diagnostic
  end
  emission_finished = emission_finished + 1
  return

noemission: procedure = .void expose inspection emission_finished
  arg caseid = .string
  if inspection == '' then return
  call emissionstart(caseid)
  say 'NO_EMISSION|' || caseid
  emission_finished = emission_finished + 1
  return
