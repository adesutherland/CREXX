        original = _captured[_depth]
        call owner.conditionline(_capturelines[_depth])
        result = .llirexecute..outcome('suspend','dynamic.condition','Persistent Classic SIGNAL boundary',''x as .binary,request.origin())
        call result.setevent(original); return result
      end
      call result.add(integer(selected)); return result
    end
    if name = 'signal.selected' then do
      bits = request.at(1).bits(); call result.add(boolean((<at..i64>(0) bits) = attrint(op,'handler'))); return result
    end
    if name = 'signal.deliver' then do
      condition = attrint(op,'condition'); call activation.setSignalPolicy(condition,0)
      signal_event = _captured[_depth] as .runtime_signal
      call rexxclassicbifs..rexxclassic_signal_record_at_line(bundle.pool(),bundle.activation(),signal_event,_capturelines[_depth])
      call cleartransient()
      return result
    end
    if name = 'signal.name' then do
      text = rexxclassicunicodeproperties..rexxclassic_unicode_upper(unboxvalue(request.at(1)).asString(1))
      call result.add(.llirexecute..value('crexx.g.text',text as .binary)); return result
    end
    if name = 'signal.mark' then do; call pool.setSignalLine(mappedline(op.id())); call cleartransient(); return result; end
    if name = 'signal.test' then do
      row_ref = facts.rowname(op.id()); row = dereference row_ref
      target = request.at(2).bits() as .string
      call result.add(boolean(target == row)); return result
    end
    if name = 'signal.invalid' | name = 'signal.handler.invalid' then do
      if name = 'signal.invalid' then target = request.at(1).bits() as .string
      else do
        target_ref = facts.handlername(op.id()); handler_target = dereference target_ref; target = handler_target
      end
      message = 'RXC-LC-' || (op.attribute('code') as .string) || ': Label not found: ' || _trace_escape_text(target)
      assembler signal 'CLASSIC_SYNTAX',message
      return result
    end
    if name = 'signal.relay' then do
      original = _captured[_depth]
      call owner.conditionline(_capturelines[_depth])
      result = .llirexecute..outcome('failure','CLASSIC_RELAY','Uncaught Classic event',''x as .binary,request.origin())
      call result.setevent(original); return result
    end
    if name = 'clause.complete' then do
      if activation.hasPendingCallCondition() then do
        handler = activation.takeCallCondition()
        result = .llirexecute..outcome('suspend','clause.complete','Classic delayed condition boundary',''x as .binary,request.origin())
        call result.addcontrol(integer(handler)); return result
      end
      /* Conditional absence is transported without manufacturing a result. */
      call result.addabsent(); return result
    end
    return .llirexecute..outcome('failure','LL_CLASSIC_OPERATION','Unknown admitted Classic runtime operation ' || name,''x as .binary,request.origin())

/** Trusted registry registration covers each selected C operation and its exact
 * effect premises. Unknown operations remain preflight failures. Context is an
 * executor-minted invocation lease and can never be constructed as a constant.
 */
classicports: procedure = .string
  arg summary = .llireffects..summary
  ports = ''
  if summary.resume() = 'possible' then ports = 'invoke'
  if summary.transfer() = 'possible' then ports = strip(ports || ' transfer')
  return ports

registry: procedure = .llirexecute..registry
  arg graph_ref = reference .llir..module, owner_ref = reference .llcdynamic..scope, group = .int
  i = .int; detail = .string
  graph = dereference graph_ref; store = dereference graph.storage(); contract = dereference store.contract(); data = dereference contract.data()
  owner = dereference owner_ref
  result = .llirexecute..registry(contract)
  groupmode = 0
  do i = 1 to graph.operations(); if graph.operation(i).name() = 'crexx.c.dynamic.group.entry' then groupmode = 1; end
  service = .runtime(owner_ref,owner.signalproof(group),owner.observations(group),groupmode)
  call result.handler('classic',service as .object); call result.lifecycle('classic')
  call result.lease('crexx.c.context')
  do i = 1 to data.types()
    type = data.typename(i)
    if type = 'core.void' | type = 'crexx.c.context' then iterate
    if type = 'crexx.c.value' | type = 'crexx.c.arguments' | type = 'crexx.c.result' then call result.type(type,.valuetype() as .object)
    else call result.type(type,.llirexecute..encodedtype(data.codec(i) as .llir..typecodec) as .object)
  end
  effects = llceffects..model(graph_ref)
  if effects.valid() = 0 then do
    detail = effects.error()
    assembler signal 'INVALID_ARGUMENTS',detail
  end
  do i = 1 to graph.operations()
    operation = graph.operation(i); name = operation.name()
    if left(name,8) <> 'crexx.c.' then iterate
    if result.opindex(name) > 0 then iterate
    summary = effects.at(i)
    call result.operation(name,'classic',summary,1048576)
    ports = classicports(summary)
    if ports <> '' then call result.port(name,ports)
  end
  ignored = result.seal()
  if result.error() <> '' then do
    detail = result.error()
    assembler signal 'INVALID_ARGUMENTS',detail
  end
  return result

executionmanifest: procedure = .llirexecute..manifest
  arg graph_ref = reference .llir..module
  graph = dereference graph_ref; result = .llirexecute..manifest(graph_ref)
  effects = llceffects..model(graph_ref)
  if effects.valid() = 0 then do
    detail = effects.error()
    assembler signal 'INVALID_ARGUMENTS',detail
  end
  do i = 1 to graph.operations()
    operation = graph.operation(i); name = operation.name()
    if name = 'core.protect' then call result.protect(i)
    if left(name,8) <> 'crexx.c.' then iterate
    ports = classicports(effects.at(i))
    if ports <> '' then call result.port(i,ports)
    if name = 'crexx.c.clause.complete' then do
      guard = 0; branch = 0
      do j = i + 1 to graph.operations()
        sibling = graph.operation(j)
        if sibling.blockid() <> operation.blockid() then iterate
        if sibling.name() = 'crexx.c.program.exiting' then guard = sibling.result().id()
        if sibling.name() = 'core.branch' & guard > 0 then do; branch = j; leave; end
      end
      if branch = 0 then assembler signal 'INVALID_ARGUMENTS','Classic conditional completion lacks its admitted branch'
      call result.gate(operation.result().id(),guard,branch,1)
    end
  end
  call result.seal()
  return result

/** Cached state is immutable semantic data only. The runtime registry/session
 * and authoritative Context binding are constructed afresh for every run. */
preparedgraph: class
  _graph = .llir..module
  *: factory
    arg graph = .llir..module
    _graph = graph
    return
  graph: method = .llir..module
    return _graph

/** One preparation entry, shared by top-level and nested expansion. All source
 * bytes are preserved and language admission belongs to the C frontend. */
preparegroup: procedure = .llirexecute..result
  numeric digits inherited
  numeric fuzz inherited
  numeric form inherited
  arg source = .rexxvalue..RexxValue, owner_ref = reference .llcdynamic..scope
  graph = .llir..module; cached = .preparedgraph; front = .llcgraph..request; absent_front = .llcgraph..request
  owner = dereference owner_ref; budget_owner = dereference owner.budget()
  bundle = dereference owner.context(); activation = dereference bundle.activation()
  active_digits = activation.numericDigits(); active_fuzz = activation.numericFuzz(); active_form = activation.numericForm()
  assembler setnumfuz 0
  assembler setnumdgts active_digits
  assembler setnumfuz active_fuzz
  assembler setnumfrm active_form
  bytes = source.asString(1) as .binary; size = <blen>(bytes)
  metadata = owner.definitionbytes()
  if metadata > budget_owner.available() then assembler signal 'OUT_OF_RANGE','Classic binding snapshot preparation budget exhausted'
  if size > (budget_owner.available() - metadata) <idiv> 4 then assembler signal 'OUT_OF_RANGE','Classic source preparation budget exhausted'
  reservation = budget_owner.reserve(size * 4 + metadata,'source.preparation')
  priorgroups = owner.group(); cachedid = 0; pinned = 0; entry_line = 0
  do
  cache_owner = dereference owner.cacheowner()
  identity = owner.source() || ':INTERPRET'
  key = 'CLC-DYN1/C24/Lexec1/BIF1/interpret-group/' || length(identity) || ':' || identity || length(owner.resourceBase()) || ':' || owner.resourceBase() || length(owner.fingerprint()) || ':' || owner.fingerprint() || ':' || owner.sourceGeneration() || ':' || owner.bindingfingerprint()
  cachedid = cache_owner.find(key,bytes)
  if cachedid > 0 then do
    cached = cache_owner.pin(cachedid) as .preparedgraph; pinned = 1
    graph = cached.graph()
  end
  else do
    front = .llcgraph..request.snapshot(bytes,'interpret-group',owner.names(),owner.entries(),owner.fingerprint(),owner.definitions(),identity,1000000,metadata)
    if front.status() then do
      call budget_owner.release(reservation); reservation = 0
      message = 'RXC-LC-40.1: INTERPRET source at offset ' || front.offset() || ': ' || front.error()
      assembler signal 'CLASSIC_SYNTAX',message
      return .llirexecute..result('failure',message,'CLASSIC_SYNTAX')
    end
    graph = front.graph()
    front = absent_front
    cachedid = cache_owner.put(key,bytes,.preparedgraph(graph) as .object,graph.bytes())
    if cachedid = 0 then do
      call budget_owner.release(reservation); reservation = 0
      assembler signal 'OUT_OF_RANGE','Classic dynamic cache quota is exhausted by pinned owners'
    end
    cached = cache_owner.pin(cachedid) as .preparedgraph; pinned = 1
  end
  group = owner.addgraph(graph,cachedid); graph_ref = owner.graph(group)
  services = registry(graph_ref,owner_ref,group)
  manifest = executionmanifest(graph_ref)
  plan = .llirexecute..plan(graph_ref,services,1000000,budget_owner.available(),manifest)
  call budget_owner.release(reservation); reservation = 0
  if plan.valid() = 0 then do
    detail = plan.message()
    assembler signal 'INVALID_ARGUMENTS',detail
  end
  entry_line = owner.takeconditionline()
  started = owner.start(owner_ref,group,plan)
  entry_line = 0
  return started
  on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,quit,term,posix_int,channel_error,task_failure,cancel,classic_syntax,classic_condition,other as problem
    original = problem as .runtime_signal
    if entry_line > 0 then do
      current_line = owner.takeconditionline()
      if current_line = 0 then current_line = entry_line
      call owner.conditionline(current_line)
    end
    if reservation > 0 then call budget_owner.release(reservation)
    if owner.group() > priorgroups then call owner.discardgroup(original as .object)
    else if pinned then call cache_owner.unpin(cachedid)
    call rxfnsb..signalrelay(original)
  end
  return .llirexecute..result('failure','Classic source preparation failed','CLASSIC_SYNTAX')

interpret: procedure = .llcdynamic..boundary
  numeric digits inherited
  numeric fuzz inherited
  numeric form inherited
  arg source = .rexxvalue..RexxValue, owner_ref = reference .llcdynamic..scope
  outcome = .llirexecute..result
  do
    outcome = preparegroup(source,owner_ref)
    return advance(owner_ref,outcome)
  on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,quit,term,posix_int,channel_error,task_failure,cancel,classic_syntax,classic_condition,other as problem
    original = problem as .runtime_signal
    return failureboundary(owner_ref,original)
  end
  return .boundary('failure')

resume: procedure = .llcdynamic..boundary
  numeric digits inherited
  numeric fuzz inherited
  numeric form inherited
  arg owner_ref = reference .llcdynamic..scope, returned = .rexxactivation..RexxActivationArguments, ?event = .object
  owner = dereference owner_ref
  bundle = dereference owner.context()
  if ?event = 0 then call owner.conditionline(0)
  child_ref = owner.sourceChild()
  if <refvalid>(child_ref) then do
    if ?event then answer = resume(child_ref,returned,event)
    else answer = resume(child_ref,returned)
    return owner.sourcecompletion(owner_ref,answer)
  end
  if ?event then call owner.clearcheckpoint()
  else if owner.checkpointwaiting() then do
    clauseid = owner.checkpointid(); clauseline = owner.checkpointline()
    call owner.clearcheckpoint()
    waiting_activation = dereference bundle.activation()
    if waiting_activation.programExitRequested() = 0 then do while waiting_activation.hasPendingCallCondition()
      if waiting_activation.callPolicy(waiting_activation.pendingConditionId()) > 0 then return checkpoint(owner_ref,clauseid,clauseline)
      ignored = waiting_activation.takeCallCondition()
    end
  end
  if owner.group() = 0 then do
    if ?event then return .boundary('failure','',0,.rexxactivation..RexxActivationArguments(),.rexxactivation..RexxActivationArguments(),event,0,'',owner.takeconditionline())
    return .boundary('normal','',0,.rexxactivation..RexxActivationArguments(),rootcompletion(owner_ref))
  end
  pending = owner.pending()
  graph = dereference owner.graph(owner.group()); op = graph.operation(pending.operation())
  completion = .llirexecute..outcome()
  if ?event then do
    completion = .llirexecute..outcome('failure','CLASSIC_CHILD','Child invocation failed')
    call completion.setevent(event)
  end
  else if op.results() > 0 then do
    if op.name() = 'crexx.c.clause.complete' then do
      activation = dereference bundle.activation()
      if activation.programExitRequested() then call completion.add(packet(rootcompletion(owner_ref)))
      else call completion.addabsent()
    end
    else call completion.add(packet(returned))
  end
  return advance(owner_ref,owner.continue(completion))

/** Generic resource/protocol outcomes need a real owned VM signal before an
 * ordinary compiled protection can relay them. Authored location stays in the
 * boundary projection rather than being inferred from this helper's frame. */
materializefailure: procedure = .runtime_signal
  arg answer = .llirexecute..result
  original = .runtime_signal
  detail = answer.code()
  if detail <> '' then detail = detail || ': '
  detail = detail || answer.message()
  do
    if answer.status() = 'limit' then assembler signal 'OUT_OF_RANGE',detail
    else assembler signal 'ERROR',detail
  on signal out_of_range,error as problem
    original = problem as .runtime_signal
  end
  return original

advance: procedure = .llcdynamic..boundary
  numeric digits inherited
  numeric fuzz inherited
  numeric form inherited
  arg owner_ref = reference .llcdynamic..scope, answer = .llirexecute..result
  target = .string
  arguments = .rexxactivation..RexxActivationArguments
  owner = dereference owner_ref
  bundle = dereference owner.context()
  absent_event = .object
  do forever
    if answer.status() = 'done' then do
      completion = .rexxactivation..RexxActivationArguments()
      if answer.size() > 0 then completion = unboxpacket(answer.at(1))
      call owner.finishgroup()
      if owner.group() = 0 then return .boundary('normal','',0,.rexxactivation..RexxActivationArguments(),completion)
      empty = .llirexecute..outcome(); answer = owner.continue(empty)
      iterate
    end
    if answer.status() <> 'suspended' & answer.status() <> 'transferred' then do
      call owner.clearcheckpoint()
      event = .object
      if answer.hasevent() then event = answer.event()
      line = owner.takeconditionline()
      if line = 0 then do
        locations = dereference owner.observations(owner.group())
        line = locations.lineOrigin(answer.origin())
      end
      if answer.hasevent() = 0 then do
        event = materializefailure(answer) as .object
      end
      call owner.finishgroup()
      return .boundary('failure','',0,.rexxactivation..RexxActivationArguments(),.rexxactivation..RexxActivationArguments(),event,answer.origin(),answer.message(),line)
    end
    graph = dereference owner.graph(owner.group()); operation = graph.operation(answer.operation()); name = operation.name()
    if wordpos(name,'crexx.c.call crexx.c.call.external crexx.c.call.missing crexx.c.dynamic.call.owner crexx.c.dynamic.call.resolve') > 0 then do
      caller_pool = dereference bundle.pool()
      call caller_pool.setCallTrapSIGL(owner.authoredline(owner.group(),operation.id()))
    end
    if name = 'crexx.c.signal.select' then return condition(owner_ref,answer.event() as .runtime_signal)
    if name = 'crexx.c.clause.complete' then do
      activation = dereference bundle.activation()
      id = activation.dispatchedConditionId(); definition = activation.dynamicPolicy(id)
      if definition is .rexxclassicstate..RexxClassicHandlerDefinition then do
        policy = definition as .rexxclassicstate..RexxClassicHandlerDefinition
        if policy.fingerprint() <> owner.fingerprint() | policy.generation() <> owner.generation() | policy.kind() <> 'CALL' then assembler signal 'REFERENCE_INVALID','Classic dynamic CALL definition belongs to a foreign catalogue generation'
        if policy.entry() = 0 then assembler signal 'CLASSIC_SYNTAX','RXC-LC-16.2: CALL handler is inside a DO or SELECT group'
        call owner.waitcheckpoint(attrint(operation,'id'),owner.authoredline(owner.group(),operation.id()))
        arguments = .rexxactivation..RexxActivationArguments()
        call arguments.inheritSignalPolicy(bundle.activation()); call arguments.beginInternalCall()
        call arguments.beginCallTrap(id,activation.dispatchedConditionDescription())
        condition_pool = dereference bundle.pool()
        call condition_pool.setCallTrapSIGL(activation.dispatchedConditionLine())
        if policy.entry() < 0 then return resolve(arguments,owner_ref,policy.name(),policy.name(),0,0)
        if owner.isIR() then return owner.internalprogram(arguments,owner_ref,policy.entry(),0)
        return .boundary('invoke',policy.name(),policy.entry(),arguments)
      end
      return .boundary('static','',0)
    end
    if name = 'crexx.c.dynamic.interpret' then do
      answer = preparegroup(unboxvalue(answer.controlat(1)),owner_ref); iterate
    end
    if name = 'crexx.c.dynamic.owner.return' | name = 'crexx.c.exit' then do
      kind = 'return'; if name = 'crexx.c.exit' then kind = 'exit'
      return .boundary(kind,'',0,.rexxactivation..RexxActivationArguments(),unboxpacket(answer.controlat(1)),absent_event,answer.origin())
    end
    if name = 'crexx.c.dynamic.owner.signal' then do
      target = answer.controlat(1).bits() as .string
      call owner.unwindGroups()
      return .boundary('signal',target,owner.entry(target),.rexxactivation..RexxActivationArguments(),.rexxactivation..RexxActivationArguments(),absent_event,answer.origin())
    end
    if name = 'crexx.c.dynamic.call.resolve' then return resolve(unboxpacket(answer.controlat(1)),owner_ref,operation.attribute('name') as .string,operation.attribute('sourceKey') as .string,attrbool(operation,'quoted'),attrbool(operation,'function'))
    if name = 'crexx.c.call.missing' then return resolve(unboxpacket(answer.controlat(1)),owner_ref,operation.attribute('name') as .string,operation.attribute('name') as .string,0,attrbool(operation,'function'))
    if name = 'crexx.c.call.external' then do
      target = operation.attribute('target') as .string; selected = owner.targetbinding(target)
      if selected = 0 then assembler signal 'INVALID_ARGUMENTS','Selected Classic binding is unavailable in the current invocation catalogue'
      arguments = unboxpacket(answer.controlat(1)); retained = owner.binding(selected)
      if retained is .routebox then do
        route = retained as .routebox
        return .boundary('invoke',route.target(),0,externalarguments(arguments,owner_ref,attrbool(operation,'function')))
      end
      completed = invokebinding(retained as .bindingrecord,arguments,owner_ref,attrbool(operation,'function'))
      return resume(owner_ref,completed)
    end
    if name = 'crexx.c.dynamic.call.owner' | name = 'crexx.c.call' | name = 'crexx.c.call.external' then do
      target = ''; entry = 0
      if name <> 'crexx.c.dynamic.call.owner' then target = operation.attribute('target') as .string
      if name <> 'crexx.c.call.external' then entry = attrint(operation,'entry')
      arguments = unboxpacket(answer.controlat(1))
      call arguments.inheritSignalPolicy(bundle.activation())
      if attrbool(operation,'function') then call arguments.beginInternalFunction()
      else call arguments.beginInternalCall()
      pool = dereference bundle.pool(); call pool.setCallTrapSIGL(owner.authoredline(owner.group(),operation.id()))
      if owner.isIR() & name <> 'crexx.c.call.external' then return owner.internalprogram(arguments,owner_ref,entry,attrbool(operation,'function'))
      return .boundary('invoke',target,entry,arguments,.rexxactivation..RexxActivationArguments(),absent_event,answer.origin())
    end
    return .boundary('failure','',0,.rexxactivation..RexxActivationArguments(),.rexxactivation..RexxActivationArguments(),absent_event,answer.origin(),'Unhandled Classic dynamic boundary ' || name)
  end

resolve: procedure = .llcdynamic..boundary
  numeric digits inherited
  numeric fuzz inherited
  numeric form inherited
  arg arguments = .rexxactivation..RexxActivationArguments, owner_ref = reference .llcdynamic..scope, name = .string, sourceKey = .string, quoted = .int, function = .int
  owner = dereference owner_ref; bundle = dereference owner.context(); config = dereference bundle.config()
  activation = dereference bundle.activation()
  active_digits = activation.numericDigits(); active_fuzz = activation.numericFuzz(); active_form = activation.numericForm()
  assembler setnumfuz 0
  assembler setnumdgts active_digits
  assembler setnumfuz active_fuzz
  assembler setnumfrm active_form
  values = .rexxvalue..RexxValue[]; presence = .int[]
  do i = 1 to arguments.rawArgumentCount()
    values[i] = arguments.argument(i); presence[i] = arguments.argumentExists(i) as .int
  end
  do
  if quoted = 0 then do
    lexical = owner.entry(name)
    if lexical = 0 then assembler signal 'CLASSIC_SYNTAX','RXC-LC-16.3: CALL target is inside a DO or SELECT group'
    if lexical > 0 then do
      prepared_arguments = internalarguments(arguments,owner_ref,function)
      if owner.isIR() then return owner.internalprogram(prepared_arguments,owner_ref,lexical,function)
      call owner.conditionline(0)
      return .boundary('invoke',name,lexical,prepared_arguments)
    end
    if llcbifs..entry(name) <> '' then do
      value = .rexxvalue..RexxValue
      delivered = arguments.currentConditionId()
      if delivered > 0 & arguments.currentConditionInstruction() = 'CALL' & arguments.delayedConditionId() = delivered then do
        handler_context = .rexxclassiccontext..RexxClassicContext(reference arguments,bundle.pool(),bundle.config())
        value = llcdynamicbifs..invoke(name,reference handler_context,values,presence,activation.dispatchedConditionLine())
        /* The delivered child suppresses its own ERROR/FAILURE/NOTREADY and
         * buffers HALT through the existing parent link. Other queued events
         * belong to the interrupted caller, as in the static BIF dispatcher. */
        if arguments.hasPendingCallCondition() then do
          ignored_handler = arguments.takeCallCondition()
          forwarded = activation.queueCallCondition(arguments.dispatchedConditionId(),arguments.dispatchedConditionDescription(),arguments.dispatchedConditionLine())
        end
      end
      else value = llcdynamicbifs..invoke(name,owner.context(),values,presence)
      completion = llctarget..present(value)
      call owner.conditionline(0)
      if owner.group() > 0 then return resume(owner_ref,completion)
      return .boundary('normal','',0,.rexxactivation..RexxActivationArguments(),completion)
    end
  end
  selected = owner.findbinding(name)
  if selected > 0 then do
    selected_record = owner.binding(selected)
    if selected_record is .routebox then do
      route = selected_record as .routebox
      child_arguments = externalarguments(arguments,owner_ref,function)
      call owner.conditionline(0)
      return .boundary('invoke',route.target(),0,child_arguments)
    end
    retained = selected_record as .bindingrecord
    completion = invokebinding(retained,arguments,owner_ref,function)
    if owner.group() > 0 then return resume(owner_ref,completion)
    return .boundary('normal','',0,.rexxactivation..RexxActivationArguments(),completion)
  end
  call config.bindHostContext(bundle as .object)
  response = config.externalRoutine(name,function as .boolean,values,presence)
  if response.handled() then do
    completion = .rexxactivation..RexxActivationArguments()
    if response.hasValue() then call completion.setReturnValue(response.value())
    call owner.conditionline(0)
    if owner.group() > 0 then return resume(owner_ref,completion)
    return .boundary('normal','',0,.rexxactivation..RexxActivationArguments(),completion)
  end
  if owner.sourceEnabled() then do
    view = llcsource..resourceview(owner.resourceBase(),owner.sourceRoots(),owner.sourceGeneration())
    budget_owner = dereference owner.budget()
    acquisitionLimit = min(16777216,budget_owner.available() <idiv> 4)
    acquisition = budget_owner.reserve(acquisitionLimit * 2,'source.acquisition')
    if acquisition = 0 then assembler signal 'OUT_OF_RANGE','Classic aggregate source acquisition budget exhausted'
    do
      source = llcsource..resolve(view,name,sourceKey,quoted,acquisitionLimit)
      if source.status() = 1 then do
        /* Drop unused acquisition headroom before frontend preparation while
         * retaining the actual immutable bytes until graph publication. */
        call budget_owner.release(acquisition)
        acquisition = budget_owner.reserve(<blen>(source.bytes()) * 2,'source.acquisition')
        answer = sourceprogram(source,arguments,owner_ref,function)
        call budget_owner.release(acquisition); acquisition = 0
        return answer
      end
      call budget_owner.release(acquisition); acquisition = 0
      if source.status() <> 0 then do
        message = source.message() || ': ' || source.path() || ' (' || source.errorcode() || ')'
        assembler signal 'FAILURE',message
      end
    on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,quit,term,posix_int,channel_error,task_failure,cancel,classic_syntax,classic_condition,other as problem
      original = problem as .runtime_signal
      if acquisition > 0 then call budget_owner.release(acquisition)
      call rxfnsb..signalrelay(original)
    end
  end
  completion = llctarget..missing(name)
  return .boundary('normal','',0,.rexxactivation..RexxActivationArguments(),completion)
  on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,quit,term,posix_int,channel_error,task_failure,cancel,classic_syntax,classic_condition,other as problem
    original = problem as .runtime_signal
    return failureboundary(owner_ref,original)
  end
  return .boundary('failure')

sourceprogram: procedure = .llcdynamic..boundary
  arg source = .llcsource..resolution, arguments = .rexxactivation..RexxActivationArguments, parent_ref = reference .llcdynamic..scope, function = .int
  /* Source-program storage is attached to the parent before any execution;
   * no suspended request can retain this procedure's temporary stack cells. */
  parent = dereference parent_ref
  return parent.sourceprogram(source,arguments,parent_ref,function)

/** Checked dynamic fallback for a compiled invocation's ordinary fault path.
 * A static policy returns `static` so the existing finite ordinal dispatcher
 * remains its owner. The original native event is retained on every boundary.
 */
condition: procedure = .llcdynamic..boundary
  arg owner_ref = reference .llcdynamic..scope, original = .runtime_signal
  owner = dereference owner_ref; bundle = dereference owner.context(); activation = dereference bundle.activation()
  id = rexxclassicbifs..rexxclassic_signal_event_id(original)
  if original.name() = 'CLASSIC_SYNTAX' then id = 1
  if id < 1 then return .boundary('static','',0,.rexxactivation..RexxActivationArguments(),.rexxactivation..RexxActivationArguments(),original as .object)
  definition = activation.dynamicPolicy(id)
  if \(definition is .rexxclassicstate..RexxClassicHandlerDefinition) then return .boundary('static','',activation.signalPolicy(id),.rexxactivation..RexxActivationArguments(),.rexxactivation..RexxActivationArguments(),original as .object)
  policy = definition as .rexxclassicstate..RexxClassicHandlerDefinition
  if policy.fingerprint() <> owner.fingerprint() | policy.generation() <> owner.generation() then assembler signal 'REFERENCE_INVALID','Classic dynamic condition definition belongs to a foreign catalogue generation'
  if policy.kind() <> 'SIGNAL' then return .boundary('static','',0,.rexxactivation..RexxActivationArguments(),.rexxactivation..RexxActivationArguments(),original as .object)
  call owner.clearpolicy(id)
  line = owner.takeconditionline()
  if line > 0 then call rexxclassicbifs..rexxclassic_signal_record_at_line(bundle.pool(),bundle.activation(),original,line)
  else call rexxclassicbifs..rexxclassic_signal_record(bundle.pool(),bundle.activation(),original)
  call owner.unwindGroups()
  return .boundary('signal',policy.name(),policy.entry(),.rexxactivation..RexxActivationArguments(),.rexxactivation..RexxActivationArguments(),original as .object)

/** Clause dispatch shares activation pending/DELAY/CONDITION algorithms. Handler
 * return data is ignored by the caller; a child-local transfer completes that
 * child and permits the interrupted invocation to resume exactly once.
 */
checkpoint: procedure = .llcdynamic..boundary
  arg owner_ref = reference .llcdynamic..scope, clauseid = .int, line = .int
  owner = dereference owner_ref; bundle = dereference owner.context(); activation = dereference bundle.activation()
  pool = dereference bundle.pool()
  do forever
  if activation.programExitRequested() then return .boundary('normal','',0,.rexxactivation..RexxActivationArguments(),rootcompletion(owner_ref))
  if activation.hasPendingCallCondition() = 0 then return .boundary()
  id = activation.pendingConditionId(); selected = activation.callPolicy(id)
  if selected = 0 then do
    ignored = activation.takeCallCondition(); iterate
  end
  definition = activation.dynamicPolicy(id)
  if \(definition is .rexxclassicstate..RexxClassicHandlerDefinition) then return .boundary('static','',selected)
  selected = activation.takeCallCondition()
  policy = definition as .rexxclassicstate..RexxClassicHandlerDefinition
  if policy.fingerprint() <> owner.fingerprint() | policy.generation() <> owner.generation() | policy.kind() <> 'CALL' then assembler signal 'REFERENCE_INVALID','Classic dynamic CALL definition belongs to a foreign catalogue generation'
  if policy.entry() = 0 then assembler signal 'CLASSIC_SYNTAX','RXC-LC-16.2: CALL handler is inside a DO or SELECT group'
  call owner.waitcheckpoint(clauseid,line)
  arguments = .rexxactivation..RexxActivationArguments()
  call arguments.inheritSignalPolicy(bundle.activation())
  call arguments.beginInternalCall()
  call arguments.beginCallTrap(id,activation.dispatchedConditionDescription())
  call pool.setCallTrapSIGL(activation.dispatchedConditionLine())
  if policy.entry() < 0 then do
    answer = resolve(arguments,owner_ref,policy.name(),policy.name(),0,0)
    if answer.kind() = 'normal' & owner.checkpointwaiting() then do
      call owner.clearcheckpoint(); iterate
    end
    return answer
  end
  if owner.isIR() then return owner.internalprogram(arguments,owner_ref,policy.entry(),0)
  return .boundary('invoke',policy.name(),policy.entry(),arguments)
  end

/** A retained checked native capability and existing immutable metadata record.
 * Textual names never become pointers and do not keep stripped symbols alive.
 */
routebox: class
  _target = .string
  _kind = .string
  _signature = .llcompilercontracts..signature
  *: factory
    arg target = .string, kind = .string, ?signature = .llcompilercontracts..signature
    if kind <> 'classic' & kind <> 'process' then assembler signal 'INVALID_ARGUMENTS','Invalid Classic prepared route kind'
    _target = target; _kind = kind
    absent_signature = .llcompilercontracts..signature; _signature = absent_signature
    if ?signature then _signature = signature
    return
  target: method = .string
    return _target
  kind: method = .string
    return _kind
  signature: method = .llcompilercontracts..signature
    return _signature

bindingrecord: class
  _capability = .rxinvoke..binding
  _signature = .llcompilercontracts..signature
  *: factory
    arg capability = .rxinvoke..binding, signature = .llcompilercontracts..signature
    _capability = capability; _signature = signature
    return
  capability: method = .rxinvoke..binding
    return _capability
  signature: method = .llcompilercontracts..signature
    return _signature

invokebinding: procedure = .rexxactivation..RexxActivationArguments
  numeric digits inherited
  numeric fuzz inherited
  numeric form inherited
  arg binding = .bindingrecord, arguments = .rexxactivation..RexxActivationArguments, owner_ref = reference .llcdynamic..scope, function = .int
  owner = dereference owner_ref; bundle = dereference owner.context()
  activation = dereference bundle.activation()
  active_digits = activation.numericDigits(); active_fuzz = activation.numericFuzz(); active_form = activation.numericForm()
  assembler setnumfuz 0
  assembler setnumdgts active_digits
  assembler setnumfuz active_fuzz
  assembler setnumfrm active_form
  signature = binding.signature(); fixed = signature.arguments(); variable = 0
  if fixed > 0 then variable = signature.vararg(fixed)
  fixed = fixed - variable; extent = arguments.rawArgumentCount()
  budget_owner = dereference owner.budget()
  /* The native owner checks its window, payload and completion against this
   * held cap. Separate conservative input/vector storage leaves the remaining
   * tree budget available to callbacks while this ordinary call is active. */
  allowance = 1048576; available = budget_owner.available()
  cells = max(extent,signature.arguments())
  if allowance > available | cells > (available - allowance) <idiv> 256 then assembler signal 'OUT_OF_RANGE','Classic typed invocation aggregate budget exhausted'
  vectorbytes = 256 + cells * 256
  carrier = packet(arguments,'crexx.c.arguments'); valueowner = .valuetype()
  inputbytes = valueowner.bytes(carrier)
  absent_carrier = .llirexecute..value; carrier = absent_carrier
  if vectorbytes > available - allowance | inputbytes > available - allowance - vectorbytes then assembler signal 'OUT_OF_RANGE','Classic typed invocation input budget exhausted'
  ticket = 0
  values = .rxinvoke..scalar[]; presence = .int[]
  invocation = .rxinvoke..invocation; absent_invocation = .rxinvoke..invocation
  returned = .rxinvoke..scalar; absent_scalar = .rxinvoke..scalar
  completion = .rexxactivation..RexxActivationArguments
  failed = 0; original = .runtime_signal; result_is_packet = 0
  do
  ticket = budget_owner.reserve(allowance + vectorbytes + inputbytes,'typed.invocation')
  if ticket = 0 then assembler signal 'OUT_OF_RANGE','Classic typed invocation aggregate budget exhausted'
  completion = .rexxactivation..RexxActivationArguments()
  classic = 0
  if signature.arguments() = 1 then classic = signature.type(1) = '.rexxactivation..rexxactivationarguments' | signature.type(1) = '.rexxactivationarguments'
  if classic then do
    delivered = arguments.currentConditionId(); delivered_description = arguments.currentConditionDescription()
    if arguments.currentConditionInstruction() <> 'CALL' | arguments.delayedConditionId() <> delivered then delivered = 0
    child = arguments
    call child.inheritSignalPolicy(bundle.activation()); call child.captureCallerPool(bundle.pool())
    if delivered > 0 then call child.beginCallTrap(delivered,delivered_description)
    call child.beginExternalProgram(); call child.beginExternalConditionScope()
    if function then call child.beginInternalFunction()
    call child.consumeFirstInstruction()
    values[1] = rxinvoke..nominal(child as .object,'.rexxactivation..rexxactivationarguments'); presence[1] = 1; extent = 1
  end
  else do i = 1 to extent
    present = arguments.argumentExists(i) as .int; presence[i] = present
    if present = 0 then values[i] = rxinvoke..absent()
    else do
      formal = i
      if variable & formal > fixed then formal = signature.arguments()
      if formal > signature.arguments() then assembler signal 'INVALID_ARGUMENTS','Too many arguments for selected Classic binding'
      type = signature.type(formal); value = arguments.argument(i)
      select type
        when '.int' then values[i] = rxinvoke..integer(value.asInt(1))
        when '.boolean' then do
          integer = value.asInt(1)
          if integer <> 0 & integer <> 1 then assembler signal 'INVALID_ARGUMENTS','Selected binding expects boolean zero or one'
          values[i] = rxinvoke..boolean(integer as .boolean)
        end
        when '.float' then values[i] = rxinvoke..floating(value.asFloat(1))
        when '.decimal' then values[i] = rxinvoke..decimal(value.asDecimal(1))
        when '.binary' then values[i] = rxinvoke..binary(value.asBinary())
        when '.string' then values[i] = rxinvoke..text(value.asString(1))
        when '.rexxvalue' then values[i] = rxinvoke..nominal(value as .object,'.rexxvalue..rexxvalue')
        when '.rexxvalue..rexxvalue' then values[i] = rxinvoke..nominal(value as .object,'.rexxvalue..rexxvalue')
        otherwise assembler signal 'INVALID_ARGUMENTS','Selected binding has an unsupported Classic scalar contract'
      end
    end
  end
  invocation = rxinvoke..prepare(binding.capability(),values,presence,extent,allowance)
  call owner.conditionline(0)
  call rxinvoke..invoke(invocation)
  if invocation.state() = 'failed' then do
    original = invocation.event() as .runtime_signal; failed = 1
  end
  if failed = 0 then do
  if invocation.state() <> 'complete' then assembler signal 'INVALID_ARGUMENTS','Selected binding did not complete'
  if invocation.kind() <> 'void' then do
  returned = invocation.result()
  value = .rexxvalue..RexxValue
  select returned.kind()
    when 'int' then value = .rexxvalue..RexxValue.fromInt(returned.asint())
    when 'boolean' then value = .rexxvalue..RexxValue.fromInt(returned.asboolean() as .int)
    when 'float' then value = .rexxvalue..RexxValue.fromFloat(returned.asfloat())
    when 'decimal' then value = .rexxvalue..RexxValue.fromDecimal(returned.asdecimal())
    when 'string' then value = .rexxvalue..RexxValue(returned.astext())
    when 'binary' then value = .rexxvalue..RexxValue.fromBinary(returned.asbinary())
    when 'nominal' then do
      object = returned.asnominal()
      if object is .rexxactivation..RexxActivationArguments then do
        completion = object as .rexxactivation..RexxActivationArguments
        result_is_packet = 1
      end
      else do
        if \(object is .rexxvalue..RexxValue) then assembler signal 'INVALID_ARGUMENTS','Selected binding returned an unsupported Classic nominal value'
        value = object as .rexxvalue..RexxValue
      end
    end
    otherwise assembler signal 'INVALID_ARGUMENTS','Selected binding returned an invalid scalar kind'
  end
  if result_is_packet = 0 then call completion.setReturnValue(value)
  end
  end
  on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,quit,term,posix_int,channel_error,task_failure,cancel,classic_syntax,classic_condition,other as problem
    original = problem as .runtime_signal; failed = 1
  end
  do
    if initialized(invocation) then call invocation.discard()
  on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,quit,term,posix_int,channel_error,task_failure,cancel,classic_syntax,classic_condition,other as cleanup_problem
    if failed = 0 then original = cleanup_problem as .runtime_signal
    failed = 1
  end
  invocation = absent_invocation; returned = absent_scalar
  assembler setattrs values,0
  assembler setattrs presence,0
  do
    if ticket > 0 then call budget_owner.release(ticket)
  on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,quit,term,posix_int,channel_error,task_failure,cancel,classic_syntax,classic_condition,other as cleanup_problem
    if failed = 0 then original = cleanup_problem as .runtime_signal
    failed = 1
  end
  if failed then call rxfnsb..signalrelay(original)
  return completion

/** Compiled and IR ON/OFF statements share the same persistent sidecar owner.
 * The ordinal is retained only for the compatible OFF/ON source interface;
 * executable delivery binds the immutable definition to the current invocation.
 */
policy: procedure = .void
  arg owner_ref = reference .llcdynamic..scope, kind = .string, condition = .int, ordinal = .int, name = .string, source = '', line = 0
  owner = dereference owner_ref
  if ordinal = 0 then do; call owner.clearpolicy(condition); return; end
  if source = '' then source = owner.source()
  definition = .rexxclassicstate..RexxClassicHandlerDefinition(kind,name,owner.entry(name),owner.fingerprint(),owner.generation(),source,line)
  call owner.installpolicy(condition,definition)
  return

/** Detached result of the actual shared Classic program root. Conditional
 * clause callers read it only after the existing programExitRequested gate.
 */
rootcompletion: procedure = .rexxactivation..RexxActivationArguments
  arg owner_ref = reference .llcdynamic..scope
  owner = dereference owner_ref; bundle = dereference owner.context(); activation = dereference bundle.activation()
  completion = .rexxactivation..RexxActivationArguments()
  if activation.programExitRequested() then do
    root = dereference activation.programRoot()
    if root.hasReturnValue() then call completion.setReturnValue(root.returnValue())
  end
  return completion

/** A process binding keeps argv, execution-owned streams and exit-status ABI.
 * No source suffix, shebang, PATH or executable bit can select this adapter.
 */
process: procedure = .rexxactivation..RexxActivationArguments
  numeric digits inherited
  numeric fuzz inherited
  numeric form inherited
  arg arguments = .rexxactivation..RexxActivationArguments, path = .string, owner_ref = reference .llcdynamic..scope
  i = .int; rc = .int
  owner = dereference owner_ref; bundle = dereference owner.context(); activation = dereference bundle.activation(); config = dereference bundle.config()
  active_digits = activation.numericDigits(); active_fuzz = activation.numericFuzz(); active_form = activation.numericForm()
  assembler setnumfuz 0
  assembler setnumdgts active_digits
  assembler setnumfuz active_fuzz
  assembler setnumfrm active_form
  vector = .string[]; tickets = .int[]; budget_owner = dereference owner.budget()
  do i = 1 to arguments.rawArgumentCount()
    if arguments.argumentExists(i) = 0 then assembler signal 'INVALID_ARGUMENTS','Process binding arguments cannot be omitted'
  end
  do
    do i = 1 to arguments.rawArgumentCount()
      text = arguments.argument(i).asString(1)
      if pos('00'x as .string,text) > 0 then assembler signal 'INVALID_ARGUMENTS','Process arguments cannot contain NUL'
      ticket = budget_owner.reserve(<blen>(text as .binary) + 32,'process.argv')
      if ticket = 0 then assembler signal 'OUT_OF_RANGE','Classic process argv aggregate budget exhausted'
      tickets[i] = ticket; vector[i] = text
    end
    rc = _rxsysb..processrun(path,vector,config.processEndpoint(1),config.processEndpoint(2),config.processEndpoint(3))
  on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,quit,term,posix_int,channel_error,task_failure,cancel,classic_syntax,classic_condition,other as problem
    original = problem as .runtime_signal
    do i = 1 to tickets[0]; call budget_owner.release(tickets[i]); end
    call rxfnsb..signalrelay(original)
    return .rexxactivation..RexxActivationArguments()
  end
  do i = 1 to tickets[0]; call budget_owner.release(tickets[i]); end
  return llctarget..present(.rexxvalue..RexxValue.fromInt(rc))

/** Restore an owned native event into the correct waiting IR invocation, or
 * return it to the compiled owner when no IR protection can receive it. */
failureboundary: procedure = .llcdynamic..boundary
  arg owner_ref = reference .llcdynamic..scope, original = .runtime_signal
  failure = .llcdynamic..boundary
  owner = dereference owner_ref
  call owner.clearcheckpoint()
  child = owner.sourceChild()
  if <refvalid>(child) then do
    failure = .boundary('failure','',0,.rexxactivation..RexxActivationArguments(),.rexxactivation..RexxActivationArguments(),original as .object)
    return owner.sourcecompletion(owner_ref,failure)
  end
  if owner.group() > 0 then do
    pending = owner.pending()
    if initialized(pending) then do
      if pending.status() = 'suspended' then do
        fault = .llirexecute..outcome('failure',original.name(),original.message(),''x as .binary,pending.origin())
        call fault.setevent(original as .object)
        return advance(owner_ref,owner.continue(fault))
      end
    end
  end
  return .boundary('failure','',0,.rexxactivation..RexxActivationArguments(),.rexxactivation..RexxActivationArguments(),original as .object,0,'',owner.takeconditionline())

/** Existing signed Classic provider entry preparation, with a delivered CALL
 * marker installed after inheritance so foreign-scope normalization retains it.
 * Process adapters ignore this activation metadata and consume unchanged argv.
 */
internalarguments: procedure = .rexxactivation..RexxActivationArguments
  arg arguments = .rexxactivation..RexxActivationArguments, owner_ref = reference .llcdynamic..scope, function = .int
  owner = dereference owner_ref; bundle = dereference owner.context()
  delivered = arguments.currentConditionId(); description = arguments.currentConditionDescription()
  if arguments.currentConditionInstruction() <> 'CALL' | arguments.delayedConditionId() <> delivered then delivered = 0
  child = arguments
  call child.inheritSignalPolicy(bundle.activation())
  if function then call child.beginInternalFunction()
  else call child.beginInternalCall()
  if delivered > 0 then call child.beginCallTrap(delivered,description)
  return child

externalarguments: procedure = .rexxactivation..RexxActivationArguments
  arg arguments = .rexxactivation..RexxActivationArguments, owner_ref = reference .llcdynamic..scope, function = .int
  owner = dereference owner_ref; bundle = dereference owner.context()
  delivered = arguments.currentConditionId(); description = arguments.currentConditionDescription()
  if arguments.currentConditionInstruction() <> 'CALL' | arguments.delayedConditionId() <> delivered then delivered = 0
  child = arguments
  call child.inheritSignalPolicy(bundle.activation())
  call child.captureCallerPool(bundle.pool()); call child.beginExternalProgram()
  if function then do
    call child.beginInternalFunction(); call child.consumeFirstInstruction()
  end
  if delivered > 0 then call child.beginCallTrap(delivered,description)
  return child
