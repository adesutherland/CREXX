/* cREXX License (MIT). Optional Classic dynamic execution coordinator.
 * C policy adapts the admitted semantic graph to existing shared B owners.
 * It contains no AST evaluator, assembler, bytecode interpreter or BIF body.
 */
options levelb numeric_classic
namespace llcdynamic expose declaration catalogue scope contextbinding boundary interpret resolve resume condition checkpoint policy rootcompletion process linkchild unlinkchild registry owned packet boolean integer
import rxfnsb
import rxjson
import _rxsysb
import llir
import llireffects
import llirexecute
import llceffects
import llcgraph
import llcbifs
import llcbindings
import rxinvoke
import llcompilercontracts
import llcsignalprotocol
import llcprocedureprotocol
import llctarget
import llcdynamicbifs
import llcdynamicobserve
import llcdynamicbudget
import llcsource
import rexxvalue
import rexxpool
import rexxactivation
import rexxclassiccontext
import rexxclassicinvocation
import rexxclassichost
import rexxclassicconfig
import rexxclassicstate
import rexxclassicbifs
import rexxclassicparse
import rexxclassicaddress
import rexxclassicconditionevent
import rexxclassicunicodeproperties
import rexxdostate

boot: initialiser expose serial children
  serial = 0; children = .object[]
  return
nextidentity: procedure = .int expose serial
  if serial = 9223372036854775807 then assembler signal 'OUT_OF_RANGE','Classic dynamic identities exhausted'
  serial = serial + 1
  return serial

childlink: class
  _child = reference .rexxactivation..RexxActivationArguments
  _parent = reference .llcdynamic..scope
  _ticket = .int
  *: factory
    arg child = reference .rexxactivation..RexxActivationArguments, parent = reference .llcdynamic..scope, ticket = .int
    _child = child; _parent = parent; _ticket = ticket
    return
  matches: method = .int
    arg child = reference .rexxactivation..RexxActivationArguments
    return <refvalid>(_child) & (_child <refsame> child)
  parent: method = reference .llcdynamic..scope
    return _parent
  ticket: method = .int
    return _ticket
linkchild: procedure = .int expose children
  arg child = reference .rexxactivation..RexxActivationArguments, parent = reference .llcdynamic..scope
  if <refvalid>(child) = 0 | <refvalid>(parent) = 0 then assembler signal 'REFERENCE_INVALID','Classic child relation owner is expired'
  ticket = nextidentity(); call objectarrayappend children,.childlink(child,parent,ticket) as .object
  return ticket
unlinkchild: procedure = .void expose children
  arg ticket = .int
  do i = children[0] to 1 by -1
    item = children[i] as .childlink
    if item.ticket() = ticket then do; call objectarraydelete children,i,1; return; end
  end
  return
parentfor: procedure = reference .llcdynamic..scope expose children
  arg child = reference .rexxactivation..RexxActivationArguments
  absent = reference .llcdynamic..scope
  do i = children[0] to 1 by -1
    item = children[i] as .childlink
    if item.matches(child) then do
      result = item.parent(); call objectarraydelete children,i,1; return result
    end
  end
  return absent

/** Checked logical retained payload accounting, not an RSS bound. */
catalogueamount: procedure = .int
  arg total = .int, count = .int, width = 1
  if total < 0 | count < 0 | width < 1 then assembler signal 'INVALID_ARGUMENTS','Invalid immutable catalogue dimensions'
  if count > (9223372036854775807 - total) <idiv> width then assembler signal 'OUT_OF_RANGE','Immutable catalogue payload exceeds int64'
  return total + count * width

/** Pure compiler-selected metadata. Construction acquires no live target.
 * @param callable Canonical selected target.
 * @param alias Selected unambiguous basename, or empty.
 * @param kind typed, classic or process.
 * @param result Exact metadata result type.
 * @param arguments Exact metadata argument text.
 * @param provider Existing native-provider identity, possibly empty.
 * @param projection Complete existing metadata-owner signature projection.
 */
declaration: class
  _ready = .int
  _callable = .string
  _alias = .string
  _kind = .string
  _signature = .llcompilercontracts..signature
  _names = .string[]
  _results = .string[]
  _arguments = .string[]
  _providers = .string[]
  _bytes = .int
  *: factory
    arg callable = .string, alias = .string, kind = .string, result = .string, arguments = .string, provider = .string, projection = .string[]
    _ready = 0
    if callable = '' | wordpos(kind,'typed classic process') = 0 then assembler signal 'INVALID_ARGUMENTS','Invalid immutable Classic declaration'
    _callable = callable; _alias = alias; _kind = kind
    _bytes = 256
    _bytes = catalogueamount(_bytes,<blen>(callable as .binary),4)
    _bytes = catalogueamount(_bytes,<blen>(alias as .binary),4)
    _bytes = catalogueamount(_bytes,<blen>(kind as .binary),4)
    if kind <> 'process' then do
      _signature = .llcompilercontracts..signature.projected(projection)
      if _signature.error() <> '' then assembler signal 'INVALID_ARGUMENTS','Invalid immutable Classic signature projection'
      if _signature.name() \== callable | _signature.result() \== result then assembler signal 'INVALID_ARGUMENTS','Immutable Classic signature differs from its declaration'
      _bytes = catalogueamount(_bytes,512)
      _bytes = catalogueamount(_bytes,<blen>(_signature.name() as .binary),4)
      _bytes = catalogueamount(_bytes,<blen>(_signature.result() as .binary),4)
      _bytes = catalogueamount(_bytes,<blen>(_signature.flags_text() as .binary),4)
      do i = 1 to _signature.arguments()
        _bytes = catalogueamount(_bytes,256)
        _bytes = catalogueamount(_bytes,<blen>(_signature.paramname(i) as .binary),4)
        _bytes = catalogueamount(_bytes,<blen>(_signature.type(i) as .binary),4)
        _bytes = catalogueamount(_bytes,<blen>(_signature.defaultkind(i) as .binary),4)
        _bytes = catalogueamount(_bytes,<blen>(_signature.defaultliteral(i) as .binary),4)
      end
    end
    if kind = 'typed' then do
      _names[1] = callable; _results[1] = result; _arguments[1] = arguments; _providers[1] = provider
      _bytes = catalogueamount(_bytes,4,64)
      _bytes = catalogueamount(_bytes,<blen>(callable as .binary),4)
      _bytes = catalogueamount(_bytes,<blen>(result as .binary),4)
      _bytes = catalogueamount(_bytes,<blen>(arguments as .binary),4)
      _bytes = catalogueamount(_bytes,<blen>(provider as .binary),4)
    end
    _ready = 1
    return
  ready: method = .int
    return _ready
  bytes: method = .int
    if _ready = 0 then assembler signal 'INVALID_ARGUMENTS','Immutable Classic declaration is not ready'
    return _bytes
  /** Live capabilities and reservations belong only to the published scope. */
  install: method = .void
    arg owner_ref = reference .llcdynamic..scope
    if _ready = 0 then assembler signal 'INVALID_ARGUMENTS','Immutable Classic declaration is not ready'
    owner = dereference owner_ref
    if owner.findbinding(_callable) > 0 then return
    if _kind = 'typed' then do
      live_catalogue = .rxinvoke..catalogue(_names,_results,_arguments,_providers)
      capability = .rxinvoke..binding(live_catalogue,1)
      call owner.bind(_callable,capability,_signature)
      if _alias <> '' then call owner.bind(_alias,capability,_signature)
    end
    else if _kind = 'classic' then do
      call owner.route(_callable,_callable,_kind,_signature)
      if _alias <> '' then call owner.route(_alias,_callable,_kind,_signature)
    end
    else do
      call owner.route(_callable,_callable,_kind)
      if _alias <> '' then call owner.route(_alias,_callable,_kind)
    end
    return

/** Immutable definition anchored in a never-replaced module global.
 * Reference arguments are borrowed only after their owning array is complete.
 * Owned getters are compatibility snapshots; internal matching never copies
 * the full fingerprint or returns a mutable reference to module data.
 */
catalogue: class
  _ready = .int
  _fingerprint = .string
  _names = .string[]
  _entries = .int[]
  _source = .string
  _declarations = reference .llcdynamic..declaration[]
  _bytes = .int
  *: factory
    arg fingerprint = .string, names = .string[], entries = .int[], sourceIdentity = .string, declarationsRef = reference .llcdynamic..declaration[]
    _ready = 0
    if fingerprint = '' | names[0] <> entries[0] | <refvalid>(declarationsRef) = 0 then assembler signal 'INVALID_ARGUMENTS','Invalid immutable Classic catalogue'
    i = .int
    declarations = dereference declarationsRef
    do i = 1 to declarations[0]
      if initialized(declarations[i]) = 0 then assembler signal 'INVALID_ARGUMENTS','Uninitialized immutable Classic declaration'
      if declarations[i].ready() = 0 then assembler signal 'INVALID_ARGUMENTS','Unready immutable Classic declaration'
    end
    _bytes = catalogueamount(256,<blen>(fingerprint as .binary),4)
    _bytes = catalogueamount(_bytes,<blen>(sourceIdentity as .binary),4)
    _bytes = catalogueamount(_bytes,names[0],64)
    do i = 1 to names[0]
      _bytes = catalogueamount(_bytes,<blen>(names[i] as .binary),4)
    end
    _fingerprint = fingerprint; _names = names; _entries = entries; _source = sourceIdentity
    _declarations = declarationsRef
    _ready = 1
    return
  ready: method = .int
    return _ready & <refvalid>(_declarations)
  require: method = .void
    if ready() = 0 then assembler signal 'REFERENCE_INVALID','Immutable Classic catalogue is unavailable'
    return
  bytes: method = .int
    call require()
    return _bytes
  fingerprint: method = .string
    call require()
    return _fingerprint
  names: method = .string[]
    call require()
    return _names
  entries: method = .int[]
    call require()
    return _entries
  source: method = .string
    call require()
    return _source
  entry: method = .int
    arg name = .string
    call require()
    do i = 1 to _names[0]; if _names[i] == name then return _entries[i]; end
    return -1
  matchesfingerprint: method = .int
    arg fingerprint_ref = reference .string
    call require()
    fingerprint = dereference fingerprint_ref
    return _fingerprint == fingerprint
  matches: method = .int
    arg other_ref = reference .llcdynamic..catalogue
    call require()
    other = dereference other_ref
    return other.matchesfingerprint(reference _fingerprint)
  install: method = .void
    arg owner_ref = reference .llcdynamic..scope
    call require()
    declarations = dereference _declarations
    do i = 1 to declarations[0]
      call declarations[i].install(owner_ref)
    end
    return

/** Stable owner anchored in the compiled caller's frame. Session cleanup owns
 * group state only; close() is reserved for the actual Classic invocation exit.
 */
scope: class
  _context = reference .rexxclassiccontext..RexxClassicContext
  _invocation = .rexxclassicinvocation..RexxClassicInvocation
  _identity = .int
  _generation = .int
  _closed = .int
  _prepared = .int
  _catalogue = reference .llcdynamic..catalogue
  _fingerprint = .string
  _names = .string[]
  _entries = .int[]
  _source = .string
  _base = .string
  _roots = .string[]
  _budget = .llcdynamicbudget..ledger
  _budgetref = reference .llcdynamicbudget..ledger
  _sharedbudget = .int
  _cache = .llcdynamicbudget..cache
  _cacheready = .int
  _cacheref = reference .llcdynamicbudget..cache
  _cachepins = .int[]
  _graphs = .llir..module[]
  _entryproofs = .llcprocedureprotocol..checked[]
  _signalproofs = .llcsignalprotocol..checked[]
  _observations = .llcdynamicobserve..prepared[]
  _entrytickets = .int[]
  _signaltickets = .int[]
  _observationtickets = .int[]
  _sessions = .llirexecute..session[]
  _tickets = .int[]
  _graphtickets = .int[]
  _pending = .llirexecute..result[]
  _groups = .int
  _bindingnames = .string[]
  _bindings = .object[]
  _bindingids = .int[]
  _definitions = .llcbindings..definition[]
  _bindingtickets = .int[]
  _configgeneration = .int
  _sourceenabled = .int
  _isIR = .int
  _programgraph = .llir..module
  _signalentry = .int
  _sourceactive = .int
  _sourceexternal = .int
  _conditionline = .int
  _checkpointwaiting = .int
  _checkpointid = .int
  _checkpointline = .int
  _policytickets = .int[]
  _sourceactivation = .rexxactivation..RexxActivationArguments[]
  _sourcepool = .rexxpool..RexxVariablePool[]
  _sourceconfig = .rexxclassicconfig..RexxClassicConfig[]
  _sourcecontext = .rexxclassiccontext..RexxClassicContext[]
  _sourcescope = .llcdynamic..scope[]
  _sourcehost = .rexxclassichost..RexxClassicHostScope[]
  *: factory
    arg context = reference .rexxclassiccontext..RexxClassicContext, fingerprint = .string, names = .string[], entries = .int[], sourceIdentity = '', resourceBase = ''
    _context = context; _fingerprint = fingerprint; _names = names; _entries = entries; _prepared = 0
    _source = sourceIdentity; _base = resourceBase; _identity = nextidentity(); _generation = 1; _closed = 0; _groups = 0
    _configgeneration = 1; _sourceenabled = 1; _sharedbudget = 0; _isIR = 0; _signalentry = -1; _sourceactive = 0; _cacheready = 0; _conditionline = 0; _checkpointwaiting = 0
    if <refvalid>(context) = 0 | names[0] <> entries[0] | fingerprint = '' then assembler signal 'INVALID_ARGUMENTS','Invalid Classic dynamic invocation catalogue'
    _invocation = .rexxclassicinvocation..RexxClassicInvocation(context)
    do condition = 1 to 7; _policytickets[condition] = 0; end
    _budget = .llcdynamicbudget..ledger(67108864)
    absent_value_20 = .llcdynamicbudget..cache; _cache = absent_value_20
    bundle = dereference context; parent_ref = parentfor(bundle.activation())
    if <refvalid>(parent_ref) then do
      parent = dereference parent_ref; _budgetref = parent.budget(); _cacheref = parent.cacheowner(); _sharedbudget = 1
      if parent.matchesfingerprint(reference _fingerprint) then do
        _bindingnames = parent.bindingnames(); _bindings = parent.bindings(); _bindingids = parent.bindingids(); _definitions = parent.definitions()
        do binding = 1 to _bindingnames[0]; _bindingtickets[binding] = 0; end
      end
      _roots = parent.sourceRoots(); _sourceenabled = parent.sourceEnabled(); _configgeneration = parent.sourceGeneration()
    end
    return
  /** Only immutable definition data is borrowed. Binding is a later operation
   * on the scope after the generated caller has published its owning cell. */
  prepared: factory
    arg contextRef = reference .rexxclassiccontext..RexxClassicContext, catalogueRef = reference .llcdynamic..catalogue, resourceBase = ''
    if <refvalid>(catalogueRef) = 0 then assembler signal 'REFERENCE_INVALID','Immutable Classic catalogue owner is expired'
    definition = dereference catalogueRef
    if initialized(definition) = 0 then assembler signal 'INVALID_ARGUMENTS','Immutable Classic catalogue is not initialized'
    if definition.ready() = 0 then assembler signal 'INVALID_ARGUMENTS','Immutable Classic catalogue is not ready'
    _context = contextRef; _catalogue = catalogueRef; _prepared = 1
    _source = definition.source(); _base = resourceBase; _identity = nextidentity(); _generation = 1; _closed = 0; _groups = 0
    _configgeneration = 1; _sourceenabled = 1; _sharedbudget = 0; _isIR = 0; _signalentry = -1; _sourceactive = 0; _cacheready = 0; _conditionline = 0; _checkpointwaiting = 0
    if <refvalid>(contextRef) = 0 then assembler signal 'INVALID_ARGUMENTS','Invalid Classic dynamic invocation catalogue'
    _invocation = .rexxclassicinvocation..RexxClassicInvocation(contextRef)
    do condition = 1 to 7; _policytickets[condition] = 0; end
    _budget = .llcdynamicbudget..ledger(67108864)
    absent_value_20 = .llcdynamicbudget..cache; _cache = absent_value_20
    bundle = dereference contextRef; parent_ref = parentfor(bundle.activation())
    if <refvalid>(parent_ref) then do
      parent = dereference parent_ref; _budgetref = parent.budget(); _cacheref = parent.cacheowner(); _sharedbudget = 1
      if parent.matchesdefinition(_catalogue) then do
        _bindingnames = parent.bindingnames(); _bindings = parent.bindings(); _bindingids = parent.bindingids(); _definitions = parent.definitions()
        do binding = 1 to _bindingnames[0]; _bindingtickets[binding] = 0; end
      end
      _roots = parent.sourceRoots(); _sourceenabled = parent.sourceEnabled(); _configgeneration = parent.sourceGeneration()
    end
    return
  child: factory
    arg context = reference .rexxclassiccontext..RexxClassicContext, fingerprint = .string, names = .string[], entries = .int[], parent = reference .llcdynamic..scope, sourceIdentity = '', resourceBase = ''
    _context = context; _fingerprint = fingerprint; _names = names; _entries = entries; _prepared = 0
    _source = sourceIdentity; _base = resourceBase; _identity = nextidentity(); _generation = 1; _closed = 0; _groups = 0
    _configgeneration = 1; _sourceenabled = 1; _sharedbudget = 1; _isIR = 0; _signalentry = -1; _sourceactive = 0; _cacheready = 0; _conditionline = 0; _checkpointwaiting = 0
    if <refvalid>(context) = 0 | <refvalid>(parent) = 0 | names[0] <> entries[0] | fingerprint = '' then assembler signal 'INVALID_ARGUMENTS','Invalid Classic dynamic child catalogue'
    _invocation = .rexxclassicinvocation..RexxClassicInvocation(context)
    do condition = 1 to 7; _policytickets[condition] = 0; end
    parent_owner = dereference parent; _budgetref = parent_owner.budget(); _cacheref = parent_owner.cacheowner()
    _bindingnames = parent_owner.bindingnames(); _bindings = parent_owner.bindings(); _bindingids = parent_owner.bindingids(); _definitions = parent_owner.definitions()
    do binding = 1 to _bindingnames[0]; _bindingtickets[binding] = 0; end
    _roots = parent_owner.sourceRoots(); _sourceenabled = parent_owner.sourceEnabled(); _configgeneration = parent_owner.sourceGeneration()
    return
  bindcatalogue: method = .void
    call check(_generation)
    if _prepared = 0 | <refvalid>(_catalogue) = 0 then assembler signal 'REFERENCE_INVALID','Immutable Classic catalogue owner is expired'
    definition = dereference _catalogue
    call definition.install(reference self)
    return
  matchesdefinition: method = .int
    arg catalogueRef = reference .llcdynamic..catalogue
    call check(_generation)
    definition = dereference catalogueRef
    if definition.ready() = 0 then assembler signal 'REFERENCE_INVALID','Immutable Classic catalogue is unavailable'
    if _prepared then do
      held = dereference _catalogue
      if held.ready() = 0 then assembler signal 'REFERENCE_INVALID','Immutable Classic catalogue is unavailable'
      if _catalogue <refsame> catalogueRef then return 1
      return held.matches(catalogueRef)
    end
    return definition.matchesfingerprint(reference _fingerprint)
  matchesfingerprint: method = .int
    arg fingerprintRef = reference .string
    call check(_generation)
    if _prepared then do
      definition = dereference _catalogue
      return definition.matchesfingerprint(fingerprintRef)
    end
    fingerprint = dereference fingerprintRef
    return _fingerprint == fingerprint
  fingerprint: method = .string
    if _prepared then do
      definition = dereference _catalogue
      return definition.fingerprint()
    end
    return _fingerprint
  names: method = .string[]
    if _prepared then do
      definition = dereference _catalogue
      return definition.names()
    end
    return _names
  entries: method = .int[]
    if _prepared then do
      definition = dereference _catalogue
      return definition.entries()
    end
    return _entries
  entry: method = .int
    arg name = .string
    if _prepared then do
      definition = dereference _catalogue
      return definition.entry(name)
    end
    do i = 1 to _names[0]; if _names[i] == name then return _entries[i]; end
    return -1
  check: method = .void
    arg generation = .int
    if _closed | generation <> _generation | <refvalid>(_context) = 0 then assembler signal 'REFERENCE_INVALID','Classic dynamic owner is stale or closed'
    return
  context: method = reference .rexxclassiccontext..RexxClassicContext
    call check(_generation)
    return _context
  identity: method = .int
    return _identity
  generation: method = .int
    return _generation
  source: method = .string
    return _source
  resourceBase: method = .string
    return _base
  sourceRoots: method = .string[]
    return _roots
  bind: method = .void
    arg name = .string, capability = .rxinvoke..binding, signature = .llcompilercontracts..signature
    if signature.error() <> '' then do
      detail = signature.error()
      assembler signal 'INVALID_ARGUMENTS',detail
    end
    key = rexxclassicunicodeproperties..rexxclassic_unicode_upper(name)
    if key = '' | findbinding(key) > 0 then assembler signal 'INVALID_ARGUMENTS','Duplicate or empty Classic prepared binding'
    definition = .llcbindings..definition(key,signature.name(),'typed',signature)
    budget_owner = dereference budget(); ticket = budget_owner.reserve(definition.bytes(),'binding.definition')
    if ticket = 0 then assembler signal 'OUT_OF_RANGE','Classic prepared binding aggregate budget exhausted'
    index = _bindingnames[0] + 1; _bindingnames[index] = key; _definitions[index] = definition; _bindingtickets[index] = ticket
    _bindings[index] = .bindingrecord(capability,signature) as .object; _bindingids[index] = nextidentity()
    return
  route: method = .void
    arg name = .string, target = .string, kind = 'classic', ?signature = .llcompilercontracts..signature
    key = rexxclassicunicodeproperties..rexxclassic_unicode_upper(name)
    if key = '' | target = '' | findbinding(key) > 0 then assembler signal 'INVALID_ARGUMENTS','Invalid Classic prepared route definition'
    definition = .llcbindings..definition
    if ?signature then definition = .llcbindings..definition(key,target,kind,signature)
    else definition = .llcbindings..definition(key,target,kind)
    budget_owner = dereference budget(); ticket = budget_owner.reserve(definition.bytes(),'binding.definition')
    if ticket = 0 then assembler signal 'OUT_OF_RANGE','Classic prepared route aggregate budget exhausted'
    index = _bindingnames[0] + 1; _bindingnames[index] = key; _definitions[index] = definition; _bindingtickets[index] = ticket
    if ?signature then _bindings[index] = .routebox(target,kind,signature) as .object
    else _bindings[index] = .routebox(target,kind) as .object
    _bindingids[index] = nextidentity()
    return
  bindingnames: method = .string[]
    return _bindingnames
  bindings: method = .object[]
    return _bindings
  bindingids: method = .int[]
    return _bindingids
  definitions: method = .llcbindings..definition[]
    return _definitions
  definitionbytes: method = .int
    amount = 64
    do i = 1 to _definitions[0]
      bytes = _definitions[i].bytes()
      if bytes > 67108864 - amount then return 67108865
      amount = amount + bytes
    end
    return amount
  bindingfingerprint: method = .string
    result = ''
    do i = 1 to _bindings[0]
      object = _bindings[i]
      result = result || ':binding:' || _bindingids[i] || ':'
      if object is .routebox then do
        route = object as .routebox; target = route.target()
        result = result || length(_bindingnames[i]) || ':' || _bindingnames[i] || ':route:' || length(target) || ':' || target
        iterate
      end
      record = object as .bindingrecord; signature = record.signature()
      result = result || length(_bindingnames[i]) || ':' || _bindingnames[i] || ':' || signature.result()
      do j = 1 to signature.arguments()
        type = signature.type(j)
        result = result || ':' || length(type) || ':' || type || ':' || signature.optional(j) || signature.exposed(j) || signature.vararg(j)
      end
    end
    return result
  findbinding: method = .int
    arg name = .string
    key = rexxclassicunicodeproperties..rexxclassic_unicode_upper(name)
    do i = 1 to _bindingnames[0]; if _bindingnames[i] == key then return i; end
    return 0
  targetbinding: method = .int
    arg target = .string
    do i = 1 to _bindings[0]
      retained = _bindings[i]
      if retained is .routebox then do
        route = retained as .routebox
        if route.target() == target then return i
      end
      else do
        record = retained as .bindingrecord; signature = record.signature()
        if signature.name() == target then return i
      end
    end
    return 0
  binding: method = .object
    arg index = .int
    return _bindings[index]
  configureSource: method = .void
    arg enabled = .int, roots = .string[]
    if _configgeneration = 9223372036854775807 then assembler signal 'OUT_OF_RANGE','Classic source configuration generation exhausted'
    _configgeneration = _configgeneration + 1; _sourceenabled = enabled; _roots = roots
    return
  sourceGeneration: method = .int
    return _configgeneration
  sourceEnabled: method = .int
    return _sourceenabled
  budget: method = reference .llcdynamicbudget..ledger
    call check(_generation)
    return budgetraw()
  budgetraw: method = reference .llcdynamicbudget..ledger
    if _sharedbudget then return _budgetref
    return reference _budget
  cacheowner: method = reference .llcdynamicbudget..cache
    if _sharedbudget then return _cacheref
    if _cacheready = 0 then do
      _cache = .llcdynamicbudget..cache(budget(),16777216); _cacheready = 1
    end
    return reference _cache
  pinplan: method = .void
    arg group = .int, ticket = .int
    _cachepins[group] = ticket
    return
  consume: method = .void
    call _invocation.consume()
    return
  enterProcedure: method = .void
    call _invocation.enterProcedure()
    return
  expose: method = .void
    arg name = .string, indirect = .int
    call _invocation.expose(name,indirect)
    return
  committed: method = .boolean
    return _invocation.committed()
  installpolicy: method = .void
    arg condition = .int, definition = .rexxclassicstate..RexxClassicHandlerDefinition
    if condition < 1 | condition > 7 then assembler signal 'INVALID_ARGUMENTS','Invalid Classic policy condition'
    budget_owner = dereference budget()
    bytes = 128 + <blen>(definition.name() as .binary) + <blen>(definition.source() as .binary) + <blen>(definition.fingerprint() as .binary)
    ticket = budget_owner.reserve(bytes,'condition.definition')
    if ticket = 0 then assembler signal 'OUT_OF_RANGE','Classic condition definition aggregate budget exhausted'
    bundle = dereference context(); activation = dereference bundle.activation()
    do
      call activation.setDynamicPolicy(condition,definition as .object)
