  sourcetokens: method = reference .llcore..stream
    return reference _sourcetokens

/** Merge existing token decisions, without rescanning source. Contextual spans
 * replace their raw counterparts (including adjacent radix suffixes); raw
 * punctuation omitted from parser layout survives between those spans. Both
 * cursors advance once, and the output cannot exceed the admitted raw count. */
displaytokens: procedure = .llcore..stream
  arg raw_ref = reference .llcore..stream, classified_ref = reference .llcore..stream, limit = .int, status_ref = reference .int, error_ref = reference .string
  raw = dereference raw_ref; classified = dereference classified_ref
  status = dereference status_ref; error = dereference error_ref
  result = .llcore..stream.tokens(raw.source())
  original = 0; contextual = 0
  kind = .int; first = .int; last = .int
  do while original < raw.size() | contextual < classified.size()
    do while contextual < classified.size()
      if classified.start(contextual) <> classified.finish(contextual + 1) then leave
      contextual = contextual + 1
    end
    if original >= raw.size() & contextual >= classified.size() then leave
    use_raw = contextual >= classified.size()
    if use_raw = 0 & original < raw.size() then use_raw = raw.finish(original + 1) <= classified.start(contextual)
    if use_raw then do
      kind = raw.symbol(original); first = raw.start(original); last = raw.finish(original + 1)
      original = original + 1
    end
    else do
      kind = classified.symbol(contextual); first = classified.start(contextual); last = classified.finish(contextual + 1)
      contextual = contextual + 1
      do while original < raw.size()
        if raw.start(original) >= last then leave
        if raw.start(original) < first | raw.finish(original + 1) > last then do
          status = 3; error = 'LL_COMPILER_CONTRACT: contextual display token splits a raw token'; return result
        end
        original = original + 1
      end
    end
    if result.size() >= limit then do
      status = 2; error = 'LL_COMPILER_LIMIT: parse observation record budget exceeded'; return result
    end
    if result.append(kind,first,last) = 0 then do
      status = 3; error = 'LL_COMPILER_CONTRACT: invalid display token: ' || result.error(); return result
    end
  end
  return result

/** Request-local fixed literal roles reuse the original token-name authority.
 * A zero slot is unknown; result+2 preserves token zero and not-found minus one.
 * Only the factory calls this helper with statically checked role/literal pairs.
 */
tokenrole: procedure = .int
  arg language_ref = reference .lllanguage..definition, ids_ref = reference .int[], role = .int, name = .string
  ids = dereference ids_ref; encoded = ids[role]
  if encoded <> 0 then return encoded - 2
  language = dereference language_ref
  id = language.tokenid(name)
  ids[role] = id + 2
  return id

/** Labels and separators cannot satisfy a required arm. Only decorate an LR
 * failure whose arm prefix reaches that failure without a real instruction;
 * existing lexical and instruction-specific error owners have already won. */
armmessage: procedure = .string
  arg language_ref = reference .lllanguage..definition, tokens_ref = reference .llcore..stream, offset_ref = reference .int, original = .string
  language = dereference language_ref; tokens = dereference tokens_ref; offset = dereference offset_ref
  thenword = language.tokenid('thenword'); elseword = language.tokenid('elseword')
  label = language.tokenid('labelname'); colon = language.tokenid('colon'); sep = language.tokenid('separator')
  pending = 0; cause = 0; code = ''; failedkind = -1
  do i = 0 to tokens.size() - 1
    kind = tokens.symbol(i)
    if tokens.start(i) >= offset then do; failedkind = kind; leave; end
    if kind = thenword | kind = elseword then do
      pending = 1; cause = tokens.start(i); code = '14.3'
      if kind = elseword then code = '14.4'
    end
    else if kind <> label & kind <> colon & kind <> sep then pending = 0
  end
