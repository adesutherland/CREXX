      if kind <> sep | condition = 0 then do
        term = kind = id | kind = tokenrole(language_ref,roleids_ref,9,'number') | kind = tokenrole(language_ref,roleids_ref,8,'string') | kind = tokenrole(language_ref,roleids_ref,11,'constantname') | kind = tokenrole(language_ref,roleids_ref,10,'typename') | kind = tokenrole(language_ref,roleids_ref,12,'parsedot') | kind = closing | word = 'END' | word = 'NOP' | word = 'LEAVE' | word = 'ITERATE'
        if emptyrhs | wordpos(word,'SAY PUSH QUEUE ADDRESS RETURN EXIT OPTIONS ARG PULL DIGITS FUZZ FORM SCIENTIFIC ENGINEERING') > 0 then term = 1
        if kind = tokenrole(language_ref,roleids_ref,20,'numericvalue') | kind = tokenrole(language_ref,roleids_ref,26,'signalvalue') | kind = tokenrole(language_ref,roleids_ref,23,'signalname') | word = 'SIGNAL' then term = 1
        if kind = tokenrole(language_ref,roleids_ref,30,'callon') | kind = tokenrole(language_ref,roleids_ref,31,'calloff') | kind = tokenrole(language_ref,roleids_ref,27,'callcondition') | kind = tokenrole(language_ref,roleids_ref,28,'callhandlername') | kind = tokenrole(language_ref,roleids_ref,29,'callname') then term = 1
        if kind = tokenrole(language_ref,roleids_ref,24,'signalon') | kind = tokenrole(language_ref,roleids_ref,25,'signaloff') | kind = tokenrole(language_ref,roleids_ref,21,'signalcondition') | kind = tokenrole(language_ref,roleids_ref,22,'signalhandlername') then term = 1
        if word = 'TRACE' | kind = tokenrole(language_ref,roleids_ref,32,'tracevalue') | kind = tokenrole(language_ref,roleids_ref,33,'traceoption') then term = 1
        if kind = tokenrole(language_ref,roleids_ref,15,'addressenv') | kind = tokenrole(language_ref,roleids_ref,14,'addressquoted') | kind = tokenrole(language_ref,roleids_ref,35,'addressresource') then term = 1
        if kind = tokenrole(language_ref,roleids_ref,39,'addresskind') & spelling = 'NORMAL' then term = 1
