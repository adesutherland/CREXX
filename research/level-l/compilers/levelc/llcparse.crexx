    previous = -1; previousend = 0; previousstart = 0; beforeprevious = -1
    number = tokenrole(language_ref,roleids_ref,9,'number'); string = tokenrole(language_ref,roleids_ref,8,'string')
    callword = tokenrole(language_ref,roleids_ref,49,'callword'); signalword = tokenrole(language_ref,roleids_ref,50,'signalword'); dropword = tokenrole(language_ref,roleids_ref,51,'dropword'); dropping = 0; callpolicy = 0
    parsing = 0; parsetemplate = 0; parsevarname = 0; dot = tokenrole(language_ref,roleids_ref,12,'parsedot')
    do i = 0 to normalized.size() - 1
      kind = normalized.symbol(i); first = normalized.start(i); last = normalized.finish(i + 1)
