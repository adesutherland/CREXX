/* cREXX License (MIT). Owned C/G source admission through generated Level L. */
options levelb
namespace llcparse expose parsed
import rxfnsb
import llcore
import llast
import lllanguage
import lllimits
import llclanguage
import llcomments
import llsource
import rexxclassicunicodeproperties

/** One parse request owns source, diagnostics and projected AST. Token layout
 * filters continuations and inserts zero-width separators; original spans are
 * never rewritten. The generated LR grammar owns syntactic decisions. */
parsed: class
  _tree = .llast..tree
  _error = .string
  _offset = .int
  _status = .int
  _strictc = .int
  *: factory
    arg source = .binary, limit = 1000000
    _error = ''; _offset = 0; _status = 0; _strictc = 0
    _tree = .llast..tree.failed('LL_COMPILER_PARSE: no accepted source tree')

    if limit < 1 | <blen>(source) > limit then do
      _error = 'LL_COMPILER_LIMIT: source byte budget exceeded'; _status = 2; return
    end
    language_ref = llclanguage..prepared()
    if <refvalid>(language_ref) = 0 then do
      _status = 3; _error = 'LL_BORROW_OWNER: C language preparation failed'; return
    end
    language = dereference language_ref
    policy = .lllimits..policy()
    ok = policy.set('source.bytes',limit)
    comments = .llcomments..rules
    comments = headerpolicy(language_ref,source,policy,reference _status,reference _error,reference _offset,reference _strictc)
    if _status <> 0 then return
    request = .lllanguage..request.borrowed(language_ref,source,policy,comments)
    _status = request.lex(0)
    if _status <> 0 then do
      _error = request.error(); _offset = request.offset()
      if left(_error,11) = 'LL_LEXICAL:' then do
        byte = binsubstr(source,_offset + 1,1)
        if byte = "'" as .binary | byte = '"' as .binary then _error = 'LL_COMPILER_SYNTAX: unterminated quoted string'
        else _error = 'LL_COMPILER_SYNTAX: invalid input byte 0x' || bin2x(byte)
      end
      return
    end
    rawlayout = request.tokens()
    id = language.tokenid('identifier'); sep = language.tokenid('separator')
    opening = language.tokenid('open'); closing = language.tokenid('close')
    colon = language.tokenid('colon'); equals = language.tokenid('assign'); comma = language.tokenid('comma')
    kind = .int; first = .int; last = .int; spelling = .string; i = .int; next = .int; emptyrhs = .int
    /* Successful lexing owns comment masking. Filter only a visible physical
     * continuation, retaining original spans/gaps and any second separator.
     * One suffix scan plus one advancing pass is bounded by the source budget;
     * the output never has more tokens than the admitted lexer stream. */
    if rawlayout.size() > limit then do
      _status = 2; _offset = 0; _error = 'LL_COMPILER_LIMIT: token-layout budget exceeded'; return
    end
    significant = rawlayout.size() - 1
    do while significant >= 0
      if rawlayout.symbol(significant) <> sep then leave
      significant = significant - 1
    end
    layout = .llcore..stream.tokens(source)
    do i = 0 to rawlayout.size() - 1
      kind = rawlayout.symbol(i); first = rawlayout.start(i); last = rawlayout.finish(i + 1)
      if kind = comma & rawlayout.symbol(i + 1) = sep & significant > i + 1 then do
        newlinefirst = rawlayout.start(i + 1); newlineend = rawlayout.finish(i + 2)
        newline = binsubstr(source,newlinefirst + 1,newlineend - newlinefirst)
        if newline = '0A'x as .binary | newline = '0D'x as .binary then do
          i = i + 1
          if newline = '0D'x as .binary & rawlayout.symbol(i + 1) = sep then do
            if rawlayout.start(i + 1) = newlineend & rawlayout.finish(i + 2) = newlineend + 1 then do
              if binsubstr(source,newlineend + 1,1) = '0A'x as .binary then i = i + 1
            end
          end
          iterate
        end
      end
      if first = last then ok = layout.synthetic(kind,first)
      else ok = layout.append(kind,first,last)
    end
    classified = .llcore..stream.tokens(source)
    clause = 1; depth = 0; condition = 0; after = ''
    arm = 0; operandmode = ''
    doheader = 0; dofirst = 0; docondition = 0
    parsemode = ''; proceduretail = 0; procedureallowed = 0
    owners = .string[]; ownercontrols = .string[]; ownercount = 0; endcontrol = ''
    previous = -1; term = 0; namespaceclause = 0; exports = 0
    do i = 0 to layout.size() - 1
      kind = layout.symbol(i); first = layout.start(i); last = layout.finish(i + 1)
      spelling = binsubstr(source,first + 1,last - first) as .string
      /* Keywords retain their ASCII spelling contract; Unicode casing must
       * not turn an ordinary variable such as long-s into keyword letters. */
      if verify(spelling,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz') = 0 then spelling = upper(spelling)
      else spelling = ''
      word = ''; next = layout.symbol(i + 1)
      /* Classic radix suffixes are whole adjacent symbols, not concatenated
       * variables. Keep the original bytes in one String token and let the
       * semantic mapper validate/decode them; G retains its own contract. */
      if kind = language.tokenid('string') & next = id & layout.start(i + 1) = last then do
        suffixend = layout.finish(i + 2)
        suffix = upper(binsubstr(source,last + 1,suffixend - last) as .string)
        if suffix = 'X' | suffix = 'B' then do
          last = suffixend; i = i + 1; next = layout.symbol(i + 1)
        end
      end
      if kind = sep then do; namespaceclause = 0; exports = 0; end
      if kind = sep & depth = 0 then operandmode = ''
      if kind = sep & depth = 0 then doheader = 0
      if kind = sep & depth = 0 then do; parsemode = ''; proceduretail = 0; end
      endname = 0
      /* A matching ELSE at the END-name boundary wins before a delimiter or
       * another ELSE; an ordinary following instruction keeps the outer arm.
       * Use the shared variable casing, not keyword promotion's ASCII rules. */
      if after = 'END' & endcontrol <> '' & kind = id & spelling = 'ELSE' then do
        if rexxclassic_unicode_upper(endcontrol) = 'ELSE' then do
          endname = next = sep | next = -1
          if next = id & layout.symbol(i + 2) <> equals then do
            lookahead = binsubstr(source,layout.start(i + 1) + 1,layout.finish(i + 2) - layout.start(i + 1)) as .string
            if verify(lookahead,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz') = 0 then endname = upper(lookahead) = 'ELSE'
          end
        end
      end
      labeltoken = kind = id | kind = language.tokenid('number') | kind = language.tokenid('typename') | kind = language.tokenid('constantname') | kind = language.tokenid('parsedot')
      if labeltoken & next = colon & parsemode = '' then do
        rawlabel = binsubstr(source,first + 1,last - first) as .string
        if pos('+',rawlabel) > 0 | pos('-',rawlabel) > 0 then do
          _status = 1; _offset = first; _error = 'LL_COMPILER_SYNTAX: invalid signed-exponent label'; return
        end
        kind = language.tokenid('labelname')
      end
      if kind = id then do
        if next = colon & parsemode = '' then kind = language.tokenid('labelname')
        else if proceduretail > 0 then do
          if proceduretail = 1 then do
            if spelling <> 'EXPOSE' then do
              _status = 1; _offset = first; _error = 'LL_COMPILER_SYNTAX: RXC-LC-25.17: expected EXPOSE after PROCEDURE'; return
            end
            kind = language.tokenid('exposeword'); proceduretail = 2
          end
        end
        else if parsemode <> '' then do
          if parsemode = 'source' | parsemode = 'header' then do
            if parsemode = 'header' & spelling = 'UPPER' then do
              kind = language.tokenid('parseupper'); parsemode = 'source'
            end
            else if spelling = 'VALUE' then do
              kind = language.tokenid('parsevalue'); parsemode = 'value'
            end
            else if spelling = 'VAR' then do
              kind = language.tokenid('parsevar'); parsemode = 'var'
            end
            else do
              kind = language.tokenid('parsekind'); parsemode = 'template'
            end
          end
          else if parsemode = 'var' then parsemode = 'template'
          else if parsemode = 'value' & depth = 0 & spelling = 'WITH' then do
            kind = language.tokenid('parsewith'); parsemode = 'template'
          end
          else if parsemode = 'template' & depth = 0 & spelling = 'ELSE' & ownercount > 0 then do
            if owners[ownercount] = 'if' then do; word = 'ELSE'; parsemode = ''; end
          end
        end
        else if depth = 0 then do
          if endname then nop
          else if previous = colon & spelling = 'PROCEDURE' then word = 'PROCEDURE'
          else if doheader & docondition = 0 & dofirst & next = equals then do
            kind = language.tokenid('docontrol')
            ownercontrols[ownercount] = binsubstr(source,first + 1,last - first) as .string
          end
          else if doheader & docondition = 0 & next <> equals & wordpos(spelling,'TO BY FOR WHILE UNTIL') > 0 then word = spelling
          else if doheader & dofirst & next <> equals & spelling = 'FOREVER' then word = spelling
          else if after = 'NUMERIC' & wordpos(spelling,'DIGITS FUZZ FORM') > 0 then word = spelling
          else if after = 'FORM' & wordpos(spelling,'SCIENTIFIC ENGINEERING') > 0 then word = spelling
          else if condition > 0 & spelling = 'THEN' & term then do
            word = 'THEN'; condition = condition - 1
          end
          else if spelling = 'ELSE' & next <> equals then do
            if clause then word = 'ELSE'
            else if condition = 0 & term & ownercount > 0 then do
              if owners[ownercount] = 'if' then word = 'ELSE'
            end
          end
          else if clause & next <> equals & wordpos(spelling,'INTERPRET ADDRESS SIGNAL TRACE EXPOSE') > 0 then do
            _status = 1; _offset = first; _error = 'LL_COMPILER_PROFILE: ' || spelling || ' is outside this frontend profile'; return
          end
          else if clause & next <> equals & wordpos(spelling,'IF DO END LEAVE ITERATE RETURN EXIT SAY PUSH QUEUE CALL NOP OPTIONS IMPORT PROCEDURE ARG PULL NUMERIC DROP SELECT WHEN OTHERWISE PARSE') > 0 then word = spelling
        end

        if word <> '' then kind = language.tokenid(lower(word) || 'word')
      end
      if word = 'CALL' then do
        if next = id then do
          policyhead = upper(binsubstr(source,layout.start(i + 1) + 1,layout.finish(i + 2) - layout.start(i + 1)) as .string)
          if policyhead = 'ON' | policyhead = 'OFF' then do
            _status = 1; _offset = first; _error = 'LL_COMPILER_PROFILE: delayed CALL policy is owned by CALL4'; return
          end
        end
        callable = next = id | next = language.tokenid('number') | next = language.tokenid('string') | next = language.tokenid('typename') | next = language.tokenid('constantname') | next = language.tokenid('parsedot')
        if callable = 0 then do
          _status = 1; _offset = first; _error = 'LL_COMPILER_SYNTAX: RXC-LC-19.2: CALL requires a symbol or string target'; return
        end
      end
      /* Source placement is independent of the activation's executed window.
       * Any authored label can open it, including an observation-only group
       * label; executed enclosing instructions still consume eligibility. */
      if word = 'THEN' | word = 'ELSE' | word = 'OTHERWISE' then procedureallowed = 0
      if clause & kind <> sep & kind <> language.tokenid('labelname') then do
        if word = 'PROCEDURE' & procedureallowed = 0 then do
          _status = 1; _offset = first; _error = 'LL_COMPILER_SYNTAX: RXC-LC-17.1: misplaced PROCEDURE'; return
        end
        procedureallowed = 0
      end
      if kind = colon then procedureallowed = 1
      if word = 'PROCEDURE' then proceduretail = 1
      /* Actual statement owners determine ELSE eligibility. DO and SELECT
       * hide enclosing IF owners until their END restores them. */
      if clause & kind <> sep & arm = 0 & word <> 'ELSE' & word <> 'THEN' then do
        do while ownercount > 0
          if owners[ownercount] <> 'if' then leave
          ownercount = ownercount - 1
        end
      end
      if word = 'IF' then do; ownercount = ownercount + 1; owners[ownercount] = 'if'; end
      if word = 'PARSE' then parsemode = 'header'
      if word = 'ARG' | word = 'PULL' then parsemode = 'template'
      if word = 'DO' then do; ownercount = ownercount + 1; owners[ownercount] = 'group'; ownercontrols[ownercount] = ''; end
      if word = 'SELECT' then do; ownercount = ownercount + 1; owners[ownercount] = 'select'; end
      if word = 'END' then do
        endcontrol = ''
        do while ownercount > 0
          closed = owners[ownercount]
          if closed = 'group' then endcontrol = ownercontrols[ownercount]
          ownercount = ownercount - 1
          if closed = 'group' | closed = 'select' then leave
        end
      end
      if word = 'ELSE' & ownercount > 0 then do
        if owners[ownercount] = 'if' then ownercount = ownercount - 1
      end
      ok = classified.append(kind,first,last)
      if kind = opening then depth = depth + 1
      if kind = closing then depth = depth - 1
      if word = 'IF' | word = 'WHEN' then condition = condition + 1
      if word = 'DO' then do; doheader = 1; dofirst = 1; docondition = 0; end
      else if doheader & kind <> sep then do
        dofirst = 0
        if word = 'WHILE' | word = 'UNTIL' then docondition = 1
      end
      /* Empty operands complete only their admitted prefix positions. The
       * first assignment '=' consumes its head; later equals are operators. */
      if clause & depth = 0 & kind = id & next = equals then operandmode = 'assignment-head'
      if word = 'ARG' | word = 'PULL' then operandmode = 'arg'
      if word = 'CALL' then operandmode = 'call-head'
      if operandmode = 'call-head' & depth = 0 & word <> 'CALL' then operandmode = 'call'
      emptyrhs = 0
      if operandmode = 'assignment-head' & depth = 0 & kind = equals then do
        emptyrhs = 1; operandmode = 'assignment'
      end
      if kind <> sep then arm = word = 'THEN' | word = 'ELSE'
      if word = 'THEN' | word = 'ELSE' | word = 'OTHERWISE' then operandmode = ''
      clause = kind = sep | word = 'THEN' | word = 'ELSE' | word = 'OTHERWISE' | kind = colon
      if kind <> sep | condition = 0 then do
        term = kind = id | kind = language.tokenid('number') | kind = language.tokenid('string') | kind = closing | word = 'END' | word = 'NOP' | word = 'LEAVE' | word = 'ITERATE'
        if emptyrhs | wordpos(word,'SAY PUSH QUEUE RETURN EXIT OPTIONS ARG PULL DIGITS FUZZ FORM SCIENTIFIC ENGINEERING') > 0 then term = 1
        if depth = 0 & kind = comma & wordpos(operandmode,'arg call') > 0 then term = 1
      end
      if kind = colon & next <> sep then do
        ok = classified.synthetic(sep,last); clause = 1
      end
      after = word; previous = kind
    end
    /* Normalize separators only after words have their contextual meanings.
     * A variable named THEN/ELSE must never consume the following clause. */
    normalized = .llcore..stream.tokens(source)
    thenword = language.tokenid('thenword'); elseword = language.tokenid('elseword')
    depth = 0; previous = -1; work = 0
    do i = 0 to classified.size() - 1
      work = work + 1
      if work > limit * 16 then do
        _status = 2; _offset = classified.start(i); _error = 'LL_COMPILER_LIMIT: token-layout work budget exceeded'; return
      end
      kind = classified.symbol(i); first = classified.start(i); last = classified.finish(i + 1)
      if kind = sep then do
        ahead = i + 1
        do while classified.symbol(ahead) = sep
          work = work + 1
          if work > limit * 16 then do
            _status = 2; _offset = first; _error = 'LL_COMPILER_LIMIT: token-layout work budget exceeded'; return
          end
          ahead = ahead + 1
        end
        next = classified.symbol(ahead)
        physical = first <> last & binsubstr(source,first + 1,last - first) <> ';' as .binary
        if (depth > 0 & physical) | previous = thenword | previous = elseword | next = thenword | next = elseword then iterate
      end
      if first = last then ok = normalized.synthetic(kind,first)
      else ok = normalized.append(kind,first,last)
      if kind = opening then depth = depth + 1
      if kind = closing then depth = depth - 1
      previous = kind
    end
    joined = .llcore..stream.tokens(source)
    previous = -1; previousend = 0; previousstart = 0; beforeprevious = -1
    number = language.tokenid('number'); string = language.tokenid('string')
    callword = language.tokenid('callword'); dropword = language.tokenid('dropword'); dropping = 0
    parsing = 0; parsetemplate = 0; parsevarname = 0; dot = language.tokenid('parsedot')
    do i = 0 to normalized.size() - 1
      kind = normalized.symbol(i); first = normalized.start(i); last = normalized.finish(i + 1)
      if kind = sep | kind = thenword | kind = elseword then dropping = 0
      if kind = sep | kind = thenword | kind = elseword then do; parsing = 0; parsetemplate = 0; parsevarname = 0; end
      if kind = language.tokenid('parseword') then do; parsing = 1; parsetemplate = 0; parsevarname = 0; end
      if kind = language.tokenid('argword') | kind = language.tokenid('pullword') then do; parsing = 1; parsetemplate = 1; parsevarname = 0; end
      if kind = language.tokenid('parsevalue') then do; parsing = 2; parsetemplate = 0; end
      if kind = language.tokenid('parsevar') then parsevarname = 1
      if kind = language.tokenid('parsekind') | kind = language.tokenid('parsewith') then do; parsing = 1; parsetemplate = 1; end
      /* A constant symbol cannot become multiple template items merely
       * because this narrower lexer recognizes its numeric/dot prefix.
       * Punctuation delimits; comments/whitespace preserve an authored gap. */
      if parsetemplate & previousend = first then do
        if (previous = number & kind = id) | (previous = dot & (kind = dot | kind = id)) then do
          _status = 1; _offset = previousstart
          _error = 'LL_COMPILER_SYNTAX: RXC-LC-38.1: invalid parsing template constant symbol'; return
        end
      end

      leftterm = previous = id | previous = number | previous = string | previous = closing | previous = language.tokenid('constantname') | previous = language.tokenid('typename') | previous = language.tokenid('parsedot') | ('c' = 'g' & previous = language.tokenid('presence'))
      rightterm = kind = id | kind = number | kind = string | kind = opening | kind = language.tokenid('constantname') | kind = language.tokenid('typename') | kind = language.tokenid('parsedot') | ('c' = 'g' & kind = language.tokenid('presence'))
      target = previous = id | previous = number | previous = string | previous = language.tokenid('typename') | previous = language.tokenid('constantname') | previous = language.tokenid('parsedot')
      function = target & kind = opening & previousend = first
      if dropping = 0 & parsing <> 1 & leftterm & rightterm & function = 0 & beforeprevious <> callword then do
        token = language.tokenid('abut')
        if first > previousend then token = language.tokenid('blank')
        ok = joined.synthetic(token,previousend)
      end
      if first = last then ok = joined.synthetic(kind,first)
      else ok = joined.append(kind,first,last)
      if kind = dropword | kind = language.tokenid('exposeword') then dropping = 1
      if parsevarname & kind = id then do; parsetemplate = 1; parsevarname = 0; end
      beforeprevious = previous; previous = kind; previousend = last; previousstart = first
    end
    _status = request.parse_tokens(joined)
    if _status <> 0 then do
      _error = syntaxmessage(request.error()); _offset = request.offset()
      decorated = parsemessage(language_ref,joined,_offset,_error)
      if decorated == _error then _error = completionmessage(language_ref,reference joined,reference _offset,_error)
      else _error = decorated
      return
    end
    _tree = request.ast(); _status = _tree.status(); _error = _tree.error()
    return
  status: method = .int
    return _status
  /** Static source policy belongs to this successful parse only. */
  strictc: method = .int
    if _status <> 0 then return 0
    return _strictc
  error: method = .string
    return _error
  offset: method = .int
    return _offset
  ast: method = .llast..tree
    return _tree

/** Discover only the complete first clause. The shared coordinator owns
 * quotes/comments; raw separators merely frame a candidate for exact lexing.
 * A failed candidate never contributes partial static settings. */
headerpolicy: procedure = .llcomments..rules
  arg language_ref = reference .lllanguage..definition, source = .binary, policy = .lllimits..policy, status_ref = reference .int, error_ref = reference .string, offset_ref = reference .int, strictc_ref = reference .int
  language = dereference language_ref
  status = dereference status_ref; error = dereference error_ref; offset = dereference offset_ref; strictc = dereference strictc_ref
  byte = .int; i = .int; setting = .int
  result = language.comments()
  prepared = .llsource..prepared(source,language.encoding(),'','',policy.limit('source.bytes'),0,result,policy.limit('scan.work'))
  preparedstatus = prepared.status()
  if preparedstatus <> 0 then do
    if preparedstatus <> 1 | left(prepared.error(),11) <> 'LL_COMMENT:' then do
      status = preparedstatus; error = prepared.error(); offset = prepared.offset(); return result
    end
  end
  masked = prepared.bytes(); extent = <blen>(masked); first = 0
  do while first < extent
    byte = <at..u8>(first) masked
    if byte <> 9 & byte <> 32 & byte <> 10 & byte <> 13 & byte <> 59 then leave
    first = first + 1
  end
  finish = first
  do while finish < extent
    byte = <at..u8>(finish) masked
    if byte = 10 | byte = 13 | byte = 59 then leave
    finish = finish + 1
  end
  if preparedstatus <> 0 & prepared.offset() <= finish then do
    status = preparedstatus; error = prepared.error(); offset = prepared.offset(); return result
  end
  if first = extent then return result
  candidate = .lllanguage..request.borrowed(language_ref,binsubstr(source,1,finish),policy)
  candidatestatus = candidate.lex(0)
  if candidatestatus <> 0 then do
    /* A raw delimiter inside a quoted runtime expression can truncate this
     * candidate. The final full-source request owns lexical validity. */
    if candidatestatus <> 1 then do
      status = candidatestatus; error = candidate.error(); offset = candidate.offset()
    end
    return result
  end
  tokens = candidate.tokens(); index = 0
  do while index < tokens.size()
    if tokens.symbol(index) <> language.tokenid('separator') then leave
    index = index + 1
  end
  identifier = language.tokenid('identifier')
  if index >= tokens.size() then return result
  if tokens.symbol(index) <> identifier then return result
  spelling = binsubstr(source,tokens.start(index) + 1,tokens.finish(index + 1) - tokens.start(index)) as .string
  if verify(spelling,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz') <> 0 then return result
  if upper(spelling) <> 'OPTIONS' then return result
  do i = index + 1 to tokens.size() - 1
    if tokens.symbol(i) <> identifier then return result
  end
  /* Every operand is now a bare word. Validate all settings before replacing
   * this request's comment rules; the leading expression still executes. */
  hash = 0; dash = 0; requestedstrict = 0
  do i = index + 1 to tokens.size() - 1
    raw = binsubstr(source,tokens.start(i) + 1,tokens.finish(i + 1) - tokens.start(i)) as .string
    spelling = ''
    if verify(raw,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_') = 0 then spelling = upper(raw)
    message = ''
    if wordpos(spelling,'LEVELA LEVELB LEVELD LEVELG LEVELL NUMERIC_COMMON COMMENTS_SLASH') > 0 then message = 'incompatible source option '
    if spelling = 'SRCMAP' then message = 'unsupported static source option '
    if spelling = 'STRICTC' then requestedstrict = 1
    if spelling = 'COMMENTS_HASH' | spelling = 'COMMENTS_NOHASH' then do
      setting = 1; if spelling = 'COMMENTS_NOHASH' then setting = -1
      if hash <> 0 & hash <> setting then message = 'incompatible source option '
      hash = setting
    end
    if spelling = 'COMMENTS_DASH' | spelling = 'COMMENTS_NODASH' then do
      setting = 1; if spelling = 'COMMENTS_NODASH' then setting = -1
      if dash <> 0 & dash <> setting then message = 'incompatible source option '
      dash = setting
    end
    if message <> '' then do
      status = 1; offset = tokens.start(i); error = 'LL_COMPILER_PROFILE: ' || message || raw; return result
    end
  end
  result = .llcomments..rules()
  ok = result.add('nested','nested','/*','*/')
  if hash = 1 then ok = result.add('hash','line','#')
  if dash = 1 then ok = result.add('dash','line','--')
  if result.error() <> '' then do
    status = 3; offset = 0; error = result.error()
  end
  else strictc = requestedstrict
  return result

/** Translate internal token labels without losing the LR expected-token set. */
syntaxmessage: procedure = .string
  arg text = .string
  keywords = 'if then else do end while leave iterate return exit say push queue call nop options import procedure arg pull numeric digits fuzz form scientific engineering as namespace expose drop select when otherwise forever until to by for parse'
  do i = 1 to words(keywords)
    keyword = word(keywords,i)
    text = changestr(keyword || 'word',text,upper(keyword))
  end
  text = changestr('separator',text,'end of clause')
  text = changestr('typename',text,'type name')
  text = changestr('labelname',text,'routine label')
  marker = pos('; expected ',text)
  if marker > 0 then do
    prefix = left(text,marker + 10); rest = substr(text,marker + 11); text = prefix; first = 1; item = .string
    do while rest <> ''
      split = pos(',',rest)
      if split = 0 then do; item = strip(rest); rest = ''; end
      else do; item = strip(left(rest,split - 1)); rest = substr(rest,split + 1); end
      if first = 0 then text = text || ', '
      text = text || tokenname(item); first = 0
    end
  end
  return 'LL_COMPILER_SYNTAX: ' || text

/** Decorate the LR failure with Classic PARSE's contextual identity. This
 * inspects only classified prefixes at the failed location; LR still owns
 * all template syntax and the frontend owns numeric/literal admission. */
parsemessage: procedure = .string
  arg language_ref = reference .lllanguage..definition, tokens = .llcore..stream, offset = .int, fallback = .string
  i = .int; j = .int; kind = .int
  language = dereference language_ref
  mode = ''; upperflag = 0; prefix = 0; failedkind = -1
  do i = 0 to tokens.size() - 1
    if tokens.start(i) > offset then leave
    kind = tokens.symbol(i)
    if tokens.start(i) = offset then failedkind = kind
    if mode = 'value' & kind = language.tokenid('parsewith') & tokens.start(i) = offset then return fallback
    select
      when kind = language.tokenid('parseword') then do; mode = 'header'; upperflag = 0; prefix = 0; end
      when kind = language.tokenid('argword') | kind = language.tokenid('pullword') then do; mode = 'template'; upperflag = 1; prefix = 0; end
      when mode = '' then nop
      when kind = language.tokenid('parseupper') then do; mode = 'header'; upperflag = 1; end
      when kind = language.tokenid('parsevalue') then mode = 'value'
      when kind = language.tokenid('parsevar') then mode = 'var'
      when kind = language.tokenid('parsekind') | kind = language.tokenid('parsewith') then mode = 'template'
      when mode = 'var' & kind = language.tokenid('identifier') then mode = 'template'
      when kind = language.tokenid('separator') | kind = language.tokenid('elseword') then do
        if tokens.start(i) < offset then mode = ''
      end
      otherwise nop
    end
    if mode = 'template' then do
      if kind = language.tokenid('assign') | kind = language.tokenid('plus') | kind = language.tokenid('minus') then prefix = 1
      else if tokens.start(i) < offset then prefix = 0
    end
  end
  select mode
    when '' then return fallback
    when 'header' then do
      code = '25.12'; if upperflag then code = '25.13'
      return 'LL_COMPILER_SYNTAX: RXC-LC-' || code || ': PARSE requires a source type'
    end
    when 'var' then return 'LL_COMPILER_SYNTAX: RXC-LC-20.1: PARSE VAR requires a variable name'
    when 'value' then do
      /* A present WITH following a malformed expression is not missing.
       * Preserve the LR expected-token message for that existing expression. */
      do j = i to tokens.size() - 1
        kind = tokens.symbol(j)
        if kind = language.tokenid('separator') | kind = language.tokenid('elseword') then leave
        if kind = language.tokenid('parsewith') then return fallback
      end
      return 'LL_COMPILER_SYNTAX: RXC-LC-38.3: PARSE VALUE instruction requires WITH keyword'
    end
    otherwise do
      if prefix & failedkind = language.tokenid('identifier') then return 'LL_COMPILER_SYNTAX: RXC-LC-38.2: invalid parsing position'
      return 'LL_COMPILER_SYNTAX: RXC-LC-38.1: invalid parsing template'
    end
  end
  return fallback

/** Only classified completion/insertion instructions own 35.1. Variables,
 * labels and quoted/function names cannot activate it; lexical and PARSE
 * failures win. */
completionmessage: procedure = .string
  arg language_ref = reference .lllanguage..definition, tokens_ref = reference .llcore..stream, offset_ref = reference .int, fallback = .string
  language = dereference language_ref; tokens = dereference tokens_ref; offset = dereference offset_ref
  i = .int
  active = ''; previouskind = -1; previousstart = 0; failedkind = -1
  separator = language.tokenid('separator'); returnword = language.tokenid('returnword'); exitword = language.tokenid('exitword'); pushword = language.tokenid('pushword'); queueword = language.tokenid('queueword')
  do i = 0 to tokens.size() - 1
    first = tokens.start(i)
    if first > offset then leave
    kind = tokens.symbol(i)
    if first = offset then failedkind = kind
    if kind = returnword then active = 'RETURN'
    else if kind = exitword then active = 'EXIT'
    else if kind = pushword then active = 'PUSH'
    else if kind = queueword then active = 'QUEUE'
    else if kind = separator | kind = language.tokenid('thenword') | kind = language.tokenid('elseword') | kind = language.tokenid('otherwiseword') then do
      if first < offset then active = ''
    end
    if first < offset & kind <> separator then do
      previouskind = kind; previousstart = first
    end
  end
  if active = '' then return fallback
  if failedkind = separator | offset >= tokens.bytes() then do
    operators = 'plus minus times divide concat blank abut lt gt le ge ne strict and or xor not assign'
    do i = 1 to words(operators)
      if previouskind = language.tokenid(word(operators,i)) then do; offset = previousstart; leave; end
    end
  end
  prefix = 'LL_COMPILER_SYNTAX: '
  return prefix || 'RXC-LC-35.1: invalid ' || active || ' expression; ' || substr(fallback,length(prefix) + 1)

tokenname: procedure = .string
  arg name = .string
  keys = 'assign plus minus times divide concat blank abut lt gt le ge ne strict and or xor not open close comma identifier number string'
  values = .string[]
  values[1] = "'='"; values[2] = "'+'"; values[3] = "'-'"; values[4] = "'*'"; values[5] = "'/'"
  values[6] = "'||'"; values[7] = 'blank concatenation'; values[8] = 'abuttal concatenation'
  values[9] = "'<'"; values[10] = "'>'"; values[11] = "'<='"; values[12] = "'>='"; values[13] = "'<>'"
  values[14] = "'=='"; values[15] = "'&'"; values[16] = "'|'"; values[17] = "'&&'"; values[18] = "'\'"
  values[19] = "'('"; values[20] = "')'"; values[21] = "','"; values[22] = 'name'; values[23] = 'number'; values[24] = 'quoted string'
  index = wordpos(name,keys)
  if index > 0 then return values[index]
  return name
