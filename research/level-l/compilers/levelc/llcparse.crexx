      rightterm = kind = id | kind = number | kind = string | kind = opening | kind = tokenrole(language_ref,roleids_ref,11,'constantname') | kind = tokenrole(language_ref,roleids_ref,10,'typename') | kind = tokenrole(language_ref,roleids_ref,12,'parsedot') | ('c' = 'g' & kind = tokenrole(language_ref,roleids_ref,56,'presence'))
