/* cREXX License (MIT). Owned C/G source admission through generated Level L. */
options levelb
namespace llcparse expose parsed
import rxfnsb
import llcore
import llast
import lllanguage
import lllimits
import llclanguage
import llcomments
import llsource
import rexxclassicunicodeproperties
import llcsrcmap

/** One parse request owns source, diagnostics and projected AST. Token layout
 * filters continuations and inserts zero-width separators; original spans are
 * never rewritten. The generated LR grammar owns syntactic decisions.
 * Optional observations retain bounded lexical/comment display data, including
 * failed source, without changing the compiler-private token borrow.
 * @param observations zero disables capture; a positive count bounds retained
 * tokens plus comment regions, subject to existing source/preparation limits
 */
parsed: class
  _tree = .llast..tree
  _error = .string
  _offset = .int
  _status = .int
  _strictc = .int
  _sourcetokens = .llcore..stream
  _source = .binary
  _mapping = .llcsrcmap..prepared
  _mapped = .int
  _observations = .int
  _observedtokens = .llcore..stream
  _observedtrivia = .llcomments..regions
  *: factory
    arg source = .binary, limit = 1000000, filename = '<source>', mode = 'program', observations = 0
    rawlayout = .llcore..stream
    _source = source; empty_mapping = .llcsrcmap..prepared; _mapping = empty_mapping
    _error = ''; _offset = 0; _status = 0; _strictc = 0; _mapped = 0
    _observations = observations
    _tree = .llast..tree.failed('LL_COMPILER_PARSE: no accepted source tree')
    if observations < 0 then do
      _error = 'LL_COMPILER_CONTRACT: observation limit must be nonnegative'; _status = 3; return
    end
    if observations > 0 then do
      _observedtokens = .llcore..stream.tokens(source)
      _observedtrivia = .llcomments..regions(0)
    end
    if limit < 1 | <blen>(source) > limit then do
      _error = 'LL_COMPILER_LIMIT: source byte budget exceeded'; _status = 2; return
    end
    language_ref = llclanguage..prepared()
    if <refvalid>(language_ref) = 0 then do
      _status = 3; _error = 'LL_BORROW_OWNER: C language preparation failed'; return
    end
    language = dereference language_ref
    policy = .lllimits..policy()
    ok = policy.set('source.bytes',limit)
    if observations > 0 then _observations = min(observations,policy.limit('tree.entries'))
    comments = .llcomments..rules
    mapped = 0
    comments = headerpolicy(language_ref,source,policy,reference _status,reference _error,reference _offset,reference _strictc,reference mapped,_observations,reference _observedtrivia)
    _mapped = mapped
    if _status <> 0 then do; _error = lexicalmessage(_error,source,_offset); return; end
    _mapping = .llcsrcmap..prepared(source,mapped,filename,limit)
    if _mapping.status() <> 0 then do
      _status = _mapping.status(); _error = _mapping.error(); _offset = _mapping.offset(); return
    end
    source = _mapping.bytes(); _source = source
    if _status <> 0 then return
    request = .lllanguage..request.borrowed(language_ref,source,policy,comments)
    if observations > 0 then ok = request.capturetrivia(_observations)
    _status = request.lex(0)
    if observations > 0 then do
      rawlayout = request.tokens(); _observedtrivia = request.trivia()
      if rawlayout.size() > _observations - _observedtrivia.size() then do
        _status = 2; _offset = 0; _error = 'LL_COMPILER_LIMIT: parse observation record budget exceeded'; return
      end
      _observedtokens = rawlayout
    end
    if _status <> 0 then do
      _error = lexicalmessage(request.error(),source,request.offset()); _offset = request.offset()
      if left(_error,11) = 'LL_LEXICAL:' then do
        byte = binsubstr(source,_offset + 1,1)
        if byte = "'" as .binary then _error = 'LL_COMPILER_SYNTAX: RXC-LC-6.2: unmatched single quote'
        else if byte = '"' as .binary then _error = 'LL_COMPILER_SYNTAX: RXC-LC-6.3: unmatched double quote'
        else _error = 'LL_COMPILER_SYNTAX: RXC-LC-13.1: invalid input byte 0x' || bin2x(byte)
      end
      return
    end
    if observations = 0 then rawlayout = request.tokens()
    /* Generic comment preparation preserves byte gaps by masking. A Classic
     * composite operator may span only authored space/HT, never a comment
     * that happens to mask to those bytes. Keep this raw-source boundary
     * check here rather than adding another comment parser or lexer. */
    composites = 'concat power remainder strict strictne strictlt strictgt strictle strictge ne le ge xor'
    compositeids = .int[]; rawop = .int; rawindex = .int
    do rawop = 1 to words(composites)
      compositeids[rawop] = language.tokenid(word(composites,rawop))
    end
    do rawindex = 0 to rawlayout.size() - 1
      rawkind = rawlayout.symbol(rawindex); composite = 0
      do rawop = 1 to compositeids[0]
        if rawkind = compositeids[rawop] then do; composite = 1; leave; end
      end
      if composite then do
        rawfirst = rawlayout.start(rawindex); rawlast = rawlayout.finish(rawindex + 1)
        if binpos('/*' as .binary,binsubstr(source,rawfirst + 1,rawlast - rawfirst)) > 0 then do
          _status = 1; _offset = rawfirst; _error = 'LL_COMPILER_SYNTAX: RXC-LC-35.1: comment cannot separate composite operator characters'; return
        end
      end
    end
    roleids = .int[]; roleids_ref = reference roleids
    id = tokenrole(language_ref,roleids_ref,1,'identifier'); sep = tokenrole(language_ref,roleids_ref,2,'separator')
    opening = tokenrole(language_ref,roleids_ref,3,'open'); closing = tokenrole(language_ref,roleids_ref,4,'close')
    colon = tokenrole(language_ref,roleids_ref,5,'colon'); equals = tokenrole(language_ref,roleids_ref,6,'assign'); comma = tokenrole(language_ref,roleids_ref,7,'comma')
    kind = .int; first = .int; last = .int; spelling = .string; i = .int; next = .int; emptyrhs = .int
    labelbyte = .int; gapbyte = .int
    /* Successful lexing owns comment masking. Filter only a visible physical
     * continuation, retaining original spans/gaps and any second separator.
     * One suffix scan plus one advancing pass is bounded by the source budget;
     * the output never has more tokens than the admitted lexer stream. */
    if rawlayout.size() > limit then do
      _status = 2; _offset = 0; _error = 'LL_COMPILER_LIMIT: token-layout budget exceeded'; return
    end
    significant = rawlayout.size() - 1
    do while significant >= 0
      if rawlayout.symbol(significant) <> sep then leave
      significant = significant - 1
    end
    layout = .llcore..stream.tokens(source)
    do i = 0 to rawlayout.size() - 1
      kind = rawlayout.symbol(i); first = rawlayout.start(i); last = rawlayout.finish(i + 1)
      if kind = comma & rawlayout.symbol(i + 1) = sep & significant > i + 1 then do
        newlinefirst = rawlayout.start(i + 1); newlineend = rawlayout.finish(i + 2)
        newline = binsubstr(source,newlinefirst + 1,newlineend - newlinefirst)
        if newline = '0A'x as .binary | newline = '0D'x as .binary then do
          i = i + 1
          if newline = '0D'x as .binary & rawlayout.symbol(i + 1) = sep then do
            if rawlayout.start(i + 1) = newlineend & rawlayout.finish(i + 2) = newlineend + 1 then do
              if binsubstr(source,newlineend + 1,1) = '0A'x as .binary then i = i + 1
            end
          end
          iterate
        end
      end
      if first = last then ok = layout.synthetic(kind,first)
      else ok = layout.append(kind,first,last)
    end
    classified = .llcore..stream.tokens(source)
    clause = 1; depth = 0; condition = 0; after = ''
    addressmode = ''; addressseen = 0; commandseen = 0; addressdirection = ''
    arm = 0; operandmode = ''; signalmode = ''; callmode = ''; tracemode = ''; ownedelse = .int
    doheader = 0; dofirst = 0; docondition = 0
    parsemode = ''; proceduretail = 0; procedureallowed = mode = 'interpret-group'
    owners = .string[]; ownercontrols = .string[]; ownercount = 0; endcontrol = ''
    previous = -1; term = 0; namespaceclause = 0; exports = 0
    do i = 0 to layout.size() - 1
      kind = layout.symbol(i); first = layout.start(i); last = layout.finish(i + 1)
      spelling = binsubstr(source,first + 1,last - first) as .string
      /* Keywords retain their ASCII spelling contract; Unicode casing must
       * not turn an ordinary variable such as long-s into keyword letters. */
      if verify(spelling,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz') = 0 then spelling = upper(spelling)
      else spelling = ''
      word = ''; next = layout.symbol(i + 1)
      /* Classic radix suffixes are whole adjacent symbols, not concatenated
       * variables. Keep the original bytes in one String token and let the
       * semantic mapper validate/decode them; G retains its own contract. */
      if kind = tokenrole(language_ref,roleids_ref,8,'string') & next = id & layout.start(i + 1) = last then do
        suffixend = layout.finish(i + 2)
        suffix = upper(binsubstr(source,last + 1,suffixend - last) as .string)
        if suffix = 'X' | suffix = 'B' then do
          last = suffixend; i = i + 1; next = layout.symbol(i + 1)
        end
      end
      if kind = sep then do; namespaceclause = 0; exports = 0; end
      if kind = sep & depth = 0 then operandmode = ''
      if kind = sep & depth = 0 then doheader = 0
      if kind = sep & depth = 0 then do; parsemode = ''; proceduretail = 0; end
      if kind = sep & depth = 0 then addressmode = ''
      if kind = sep & depth = 0 then do; signalmode = ''; callmode = ''; end
      if kind = sep & depth = 0 then tracemode = ''
      endname = 0
      /* A matching ELSE at the END-name boundary wins before a delimiter or
       * another ELSE; an ordinary following instruction keeps the outer arm.
       * Use the shared variable casing, not keyword promotion's ASCII rules. */
      if after = 'END' & endcontrol <> '' & kind = id & spelling = 'ELSE' then do
        if rexxclassic_unicode_upper(endcontrol) = 'ELSE' then do
          endname = next = sep | next = -1
          if next = id & layout.symbol(i + 2) <> equals then do
            lookahead = binsubstr(source,layout.start(i + 1) + 1,layout.finish(i + 2) - layout.start(i + 1)) as .string
            if verify(lookahead,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz') = 0 then endname = upper(lookahead) = 'ELSE'
          end
        end
      end
      labeltoken = kind = id | kind = tokenrole(language_ref,roleids_ref,9,'number') | kind = tokenrole(language_ref,roleids_ref,10,'typename') | kind = tokenrole(language_ref,roleids_ref,11,'constantname') | kind = tokenrole(language_ref,roleids_ref,12,'parsedot')
      if labeltoken & next = colon & parsemode = '' then do
        /* A label is one authored lexical form. Generic comment masking
         * must not make a raw comment/newline/VT/FF gap look like its admitted
         * optional space/HT before the colon. */
        do labelbyte = last to layout.start(i + 1) - 1
          gapbyte = <at..u8>(labelbyte) source
          if gapbyte <> 9 & gapbyte <> 32 then do
            _status = 1; _offset = layout.start(i + 1); _error = 'LL_COMPILER_SYNTAX: RXC-LC-13.1: invalid colon after a separated label name'; return
          end
        end
        rawlabel = binsubstr(source,first + 1,last - first) as .string
        if pos('+',rawlabel) > 0 | pos('-',rawlabel) > 0 then do
          _status = 1; _offset = layout.start(i + 1); _error = 'LL_COMPILER_SYNTAX: RXC-LC-13.1: invalid colon after signed-exponent label'; return
        end
        kind = tokenrole(language_ref,roleids_ref,13,'labelname')
      end
      /* Fixed environment tokens are not expression terms: no implicit join
       * may be inserted between an environment and its command expression. */
      if addressmode = 'head' & kind = tokenrole(language_ref,roleids_ref,8,'string') then do
        kind = tokenrole(language_ref,roleids_ref,14,'addressquoted'); addressmode = 'command'
      end
      if addressmode = 'head' & (kind = tokenrole(language_ref,roleids_ref,9,'number') | kind = tokenrole(language_ref,roleids_ref,11,'constantname') | kind = tokenrole(language_ref,roleids_ref,10,'typename') | kind = tokenrole(language_ref,roleids_ref,12,'parsedot')) then do
        kind = tokenrole(language_ref,roleids_ref,15,'addressenv'); addressmode = 'command'
      end
      if addressmode = 'head' & (kind = opening | kind = tokenrole(language_ref,roleids_ref,16,'plus') | kind = tokenrole(language_ref,roleids_ref,17,'minus') | kind = tokenrole(language_ref,roleids_ref,18,'not')) then do
        ok = classified.synthetic(tokenrole(language_ref,roleids_ref,19,'addressvalue'),first); addressmode = 'value'
      end
      /* Only a contextual FORM suffix can introduce dynamic numeric input.
       * Keep its token separate from PARSE VALUE's joined-stream state. */
      if after = 'FORM' & depth = 0 then do
        if kind = id & spelling = 'VALUE' then kind = tokenrole(language_ref,roleids_ref,20,'numericvalue')
        else if kind = opening | kind = tokenrole(language_ref,roleids_ref,16,'plus') | kind = tokenrole(language_ref,roleids_ref,17,'minus') | kind = tokenrole(language_ref,roleids_ref,18,'not') then do
          ok = classified.synthetic(tokenrole(language_ref,roleids_ref,20,'numericvalue'),first)
        end
      end
      /* SIGNAL's static symbol is spelling, never a numeric expression. Its
       * VALUE marker is private and cannot activate PARSE expression state. */
      if wordpos(signalmode,'on.condition off.condition') > 0 & kind = id then do
        if wordpos(spelling,'SYNTAX ERROR FAILURE HALT NOTREADY NOVALUE LOSTDIGITS') > 0 then do
          kind = tokenrole(language_ref,roleids_ref,21,'signalcondition')
          if signalmode = 'on.condition' then signalmode = 'on.name'
          else signalmode = 'off.tail'
        end
      end
      else if signalmode = 'on.name' & kind = id & spelling = 'NAME' then do
        kind = tokenrole(language_ref,roleids_ref,22,'signalhandlername'); signalmode = 'on.target'
      end
      else if signalmode = 'on.target' then do
        ownedelse = 0
        if kind = id & spelling = 'ELSE' & condition = 0 & term & ownercount > 0 then ownedelse = owners[ownercount] = 'if'
        if ownedelse = 0 then do
          if labeltoken then do; kind = tokenrole(language_ref,roleids_ref,23,'signalname'); signalmode = 'on.tail'; end
          else if kind = tokenrole(language_ref,roleids_ref,8,'string') then signalmode = 'on.tail'
        end
      end
      if signalmode = 'head' & kind <> sep then do
        signalelse = 0
        if kind = id & spelling = 'ELSE' & condition = 0 & term & ownercount > 0 then signalelse = owners[ownercount] = 'if'
        if signalelse then signalmode = ''
        else if kind = id & spelling = 'ON' then do
          kind = tokenrole(language_ref,roleids_ref,24,'signalon'); signalmode = 'on.condition'
        end
        else if kind = id & spelling = 'OFF' then do
          kind = tokenrole(language_ref,roleids_ref,25,'signaloff'); signalmode = 'off.condition'
        end
        else if kind = id & spelling = 'VALUE' then do
          kind = tokenrole(language_ref,roleids_ref,26,'signalvalue'); signalmode = 'value'
        end
        else if kind = opening | kind = tokenrole(language_ref,roleids_ref,16,'plus') | kind = tokenrole(language_ref,roleids_ref,17,'minus') | kind = tokenrole(language_ref,roleids_ref,18,'not') then do
          ok = classified.synthetic(tokenrole(language_ref,roleids_ref,26,'signalvalue'),first); signalmode = 'value'
        end
        else if labeltoken then do; kind = tokenrole(language_ref,roleids_ref,23,'signalname'); signalmode = 'tail'; end
        else if kind = tokenrole(language_ref,roleids_ref,8,'string') then signalmode = 'tail'
      end
      /* CALL policy words are contextual; ordinary names outside this prefix
       * retain the established call/assignment/label classification. */
      if wordpos(callmode,'on.condition off.condition') > 0 & kind = id then do
        if wordpos(spelling,'ERROR FAILURE HALT NOTREADY') > 0 then do
          kind = tokenrole(language_ref,roleids_ref,27,'callcondition')
          if callmode = 'on.condition' then callmode = 'on.name'
          else callmode = 'off.tail'
        end
      end
      else if callmode = 'on.name' & kind = id & spelling = 'NAME' then do
        kind = tokenrole(language_ref,roleids_ref,28,'callhandlername'); callmode = 'on.target'
      end
      else if callmode = 'on.target' then do
        ownedelse = 0
        if kind = id & spelling = 'ELSE' & condition = 0 & term & ownercount > 0 then ownedelse = owners[ownercount] = 'if'
        if ownedelse = 0 then do
          /* CALL NAME uses a variable symbol or string. Ordinary CALL and
           * SIGNAL retain their broader constant-label target contracts. */
          if kind = id then do; kind = tokenrole(language_ref,roleids_ref,29,'callname'); callmode = 'on.tail'; end
          else if kind = tokenrole(language_ref,roleids_ref,8,'string') then callmode = 'on.tail'
        end
      end
      if callmode = 'head' & kind <> sep then do
        if kind = id & spelling = 'ON' then do
          kind = tokenrole(language_ref,roleids_ref,30,'callon'); callmode = 'on.condition'
        end
        else if kind = id & spelling = 'OFF' then do
          kind = tokenrole(language_ref,roleids_ref,31,'calloff'); callmode = 'off.condition'
        end
        else callmode = ''
      end
      /* Static TRACE options are spelling, never a variable lookup or an
       * expression. VALUE alone enters the ordinary expression grammar. */
      if tracemode = 'signed' & kind = tokenrole(language_ref,roleids_ref,9,'number') then tracemode = 'tail'
      else if tracemode = 'head' & kind <> sep then do
        ownedelse = 0
        if kind = id & spelling = 'ELSE' & condition = 0 & term & ownercount > 0 then ownedelse = owners[ownercount] = 'if'
        if ownedelse then tracemode = ''
        else if kind = id & spelling = 'VALUE' then do
          kind = tokenrole(language_ref,roleids_ref,32,'tracevalue'); tracemode = 'value'
        end
        else if kind = tokenrole(language_ref,roleids_ref,16,'plus') | kind = tokenrole(language_ref,roleids_ref,17,'minus') then tracemode = 'signed'
        else if labeltoken then do; kind = tokenrole(language_ref,roleids_ref,33,'traceoption'); tracemode = 'tail'; end
        else if kind = tokenrole(language_ref,roleids_ref,8,'string') then tracemode = 'tail'
      end
      if kind = id then do
        if next = colon & parsemode = '' then kind = tokenrole(language_ref,roleids_ref,13,'labelname')
        else if proceduretail > 0 then do
          if proceduretail = 1 then do
            if spelling <> 'EXPOSE' then do
              _status = 1; _offset = first; _error = 'LL_COMPILER_SYNTAX: RXC-LC-25.17: expected EXPOSE after PROCEDURE'; return
            end
            kind = tokenrole(language_ref,roleids_ref,34,'exposeword'); proceduretail = 2
          end
        end
        else if addressmode <> '' & depth = 0 then do
          ownedelse = 0
          if addressmode <> 'resource' & spelling = 'ELSE' & condition = 0 & term & ownercount > 0 then do
            ownedelse = owners[ownercount] = 'if'
          end
          if ownedelse then do; word = 'ELSE'; addressmode = ''; end
          else if addressmode = 'resource' then do
            kind = tokenrole(language_ref,roleids_ref,35,'addressresource'); addressmode = 'option'
          end
          else if spelling = 'WITH' then do
            kind = tokenrole(language_ref,roleids_ref,36,'addresswith'); addressmode = 'option'
          end
          else if addressmode = 'head' then do
            if spelling = 'VALUE' then do
              kind = tokenrole(language_ref,roleids_ref,19,'addressvalue'); addressmode = 'value'
            end
            else do; kind = tokenrole(language_ref,roleids_ref,15,'addressenv'); addressmode = 'command'; end
          end
          else if wordpos(addressmode,'option kind typed') > 0 then do
            if wordpos(spelling,'INPUT OUTPUT ERROR') > 0 then do
              kind = tokenrole(language_ref,roleids_ref,37,'addressoption'); addressmode = 'kind'; addressdirection = spelling
            end
            else if wordpos(spelling,'APPEND REPLACE') > 0 & addressmode <> 'option' & addressdirection <> 'INPUT' then do
              kind = tokenrole(language_ref,roleids_ref,38,'addressposition'); addressmode = 'typed'
            end
            else if wordpos(spelling,'NORMAL STREAM STEM') > 0 & addressmode <> 'option' then do
              kind = tokenrole(language_ref,roleids_ref,39,'addresskind'); addressmode = 'resource'
              if spelling = 'NORMAL' then addressmode = 'option'
            end
          end
        end
        else if parsemode <> '' then do
          if parsemode = 'source' | parsemode = 'header' then do
            if parsemode = 'header' & spelling = 'UPPER' then do
              kind = tokenrole(language_ref,roleids_ref,40,'parseupper'); parsemode = 'source'
            end
            else if spelling = 'VALUE' then do
              kind = tokenrole(language_ref,roleids_ref,41,'parsevalue'); parsemode = 'value'
            end
            else if spelling = 'VAR' then do
              kind = tokenrole(language_ref,roleids_ref,42,'parsevar'); parsemode = 'var'
            end
            else do
              kind = tokenrole(language_ref,roleids_ref,43,'parsekind'); parsemode = 'template'
            end
          end
          else if parsemode = 'var' then parsemode = 'template'
          else if parsemode = 'value' & depth = 0 & spelling = 'WITH' then do
            kind = tokenrole(language_ref,roleids_ref,44,'parsewith'); parsemode = 'template'
          end
          else if parsemode = 'template' & depth = 0 & spelling = 'ELSE' & ownercount > 0 then do
            if owners[ownercount] = 'if' then do; word = 'ELSE'; parsemode = ''; end
          end
        end
        else if depth = 0 then do
          if endname then nop
          else if previous = colon & spelling = 'PROCEDURE' then word = 'PROCEDURE'
          else if doheader & docondition = 0 & dofirst & next = equals then do
            kind = tokenrole(language_ref,roleids_ref,45,'docontrol')
            ownercontrols[ownercount] = binsubstr(source,first + 1,last - first) as .string
          end
          else if doheader & docondition = 0 & next <> equals & wordpos(spelling,'TO BY FOR WHILE UNTIL') > 0 then word = spelling
          else if doheader & dofirst & next <> equals & spelling = 'FOREVER' then word = spelling
          else if after = 'NUMERIC' & wordpos(spelling,'DIGITS FUZZ FORM') > 0 then word = spelling
          else if after = 'FORM' & wordpos(spelling,'SCIENTIFIC ENGINEERING') > 0 then word = spelling
          else if condition > 0 & spelling = 'THEN' & term then do
            word = 'THEN'; condition = condition - 1
          end
          else if clause & spelling = 'THEN' & next <> equals then word = 'THEN'
          else if spelling = 'ELSE' & next <> equals then do
            if clause then word = 'ELSE'
            else if condition = 0 & term & ownercount > 0 then do
              if owners[ownercount] = 'if' then word = 'ELSE'
            end
          end
          else if clause & next <> equals & spelling = 'EXPOSE' then do
            _status = 1; _offset = first; _error = 'LL_COMPILER_PROFILE: ' || spelling || ' is outside this frontend profile'; return
          end
          else if clause & next <> equals & wordpos(spelling,'IF DO END LEAVE ITERATE RETURN EXIT SAY PUSH QUEUE ADDRESS SIGNAL TRACE CALL NOP OPTIONS IMPORT PROCEDURE ARG PULL NUMERIC DROP SELECT WHEN OTHERWISE PARSE INTERPRET') > 0 then word = spelling
        end

        if word <> '' then kind = language.tokenid(lower(word) || 'word')
      end
      /* The active IF stack, including restored owners after END, owns ELSE.
       * A prior header or clause cannot hide an otherwise stray keyword. */
      if word = 'ELSE' then do
        ownedelse = 0
        if ownercount > 0 then ownedelse = owners[ownercount] = 'if'
        if ownedelse = 0 then do
          _status = 1; _offset = first; _error = "LL_COMPILER_SYNTAX: RXC-LC-8.2: unexpected 'else' without corresponding THEN"; return
        end
      end
      /* The marker leaves the original expression token/gaps untouched.
       * Recognized instructions, labels and malformed symbol assignments keep
       * their prior ownership before a clause can become an implicit command. */
      if clause & word = '' & parsemode = '' & addressmode = '' & proceduretail = 0 & doheader = 0 then do
        symbolhead = kind = id | kind = tokenrole(language_ref,roleids_ref,9,'number') | kind = tokenrole(language_ref,roleids_ref,11,'constantname') | kind = tokenrole(language_ref,roleids_ref,10,'typename') | kind = tokenrole(language_ref,roleids_ref,12,'parsedot')
        if symbolhead & kind <> id & next = equals then do
          _status = 1; _offset = first; _error = 'LL_COMPILER_SYNTAX: RXC-LC-31.1: a value cannot be assigned to a constant symbol'; return
        end
        expressionhead = symbolhead | kind = tokenrole(language_ref,roleids_ref,8,'string') | kind = opening | kind = tokenrole(language_ref,roleids_ref,16,'plus') | kind = tokenrole(language_ref,roleids_ref,17,'minus') | kind = tokenrole(language_ref,roleids_ref,18,'not')
        if expressionhead & (symbolhead & next = equals) = 0 then do
          ok = classified.synthetic(tokenrole(language_ref,roleids_ref,46,'commandword'),first); commandseen = 1
        end
      end
      if word = 'CALL' then do
        callable = next = id | next = tokenrole(language_ref,roleids_ref,9,'number') | next = tokenrole(language_ref,roleids_ref,8,'string') | next = tokenrole(language_ref,roleids_ref,10,'typename') | next = tokenrole(language_ref,roleids_ref,11,'constantname') | next = tokenrole(language_ref,roleids_ref,12,'parsedot')
        if callable = 0 then do
          _status = 1; _offset = first
          detail = 'CALL requires a symbol or string target; found end-of-clause'
          if next <> sep & next <> -1 then do
            _offset = layout.start(i + 1); detail = 'CALL requires a symbol or string target'
          end
          _error = 'LL_COMPILER_SYNTAX: RXC-LC-19.2: ' || detail; return
        end
      end
      /* Source placement is independent of the activation's executed window.
       * Any authored label can open it, including an observation-only group
       * label; executed enclosing instructions still consume eligibility. */
      if word = 'THEN' | word = 'ELSE' | word = 'OTHERWISE' then procedureallowed = 0
      if clause & kind <> sep & kind <> tokenrole(language_ref,roleids_ref,13,'labelname') then do
