      if kind = sep | kind = thenword | kind = elseword | kind = tokenrole(language_ref,roleids_ref,52,'otherwiseword') then callpolicy = 0
      if kind = tokenrole(language_ref,roleids_ref,30,'callon') | kind = tokenrole(language_ref,roleids_ref,31,'calloff') then callpolicy = 1
      if kind = sep | kind = thenword | kind = elseword then do; parsing = 0; parsetemplate = 0; parsevarname = 0; end
      if kind = tokenrole(language_ref,roleids_ref,53,'parseword') then do; parsing = 1; parsetemplate = 0; parsevarname = 0; end
      if kind = tokenrole(language_ref,roleids_ref,54,'argword') | kind = tokenrole(language_ref,roleids_ref,55,'pullword') then do; parsing = 1; parsetemplate = 1; parsevarname = 0; end
      if kind = tokenrole(language_ref,roleids_ref,41,'parsevalue') then do; parsing = 2; parsetemplate = 0; end
