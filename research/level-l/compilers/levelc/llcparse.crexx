    endingcode = '10.5'; if code = '14.4' then endingcode = '10.6'
    return 'LL_COMPILER_SYNTAX: RXC-LC-' || endingcode || ': END cannot immediately follow THEN or ELSE'
  end
  offset = cause
  return 'LL_COMPILER_SYNTAX: RXC-LC-' || code || ': expected instruction after ' || word('THEN ELSE',1 + (code = '14.4'))

/** Discover only the complete first clause. The shared coordinator owns
 * quotes/comments; raw separators merely frame a candidate for exact lexing.
 * A failed candidate never contributes partial static settings. */
headerpolicy: procedure = .llcomments..rules
  arg language_ref = reference .lllanguage..definition, source = .binary, policy = .lllimits..policy, status_ref = reference .int, error_ref = reference .string, offset_ref = reference .int, strictc_ref = reference .int, srcmap_ref = reference .int, observations = .int, trivia_ref = reference .llcomments..regions
  language = dereference language_ref
  status = dereference status_ref; error = dereference error_ref; offset = dereference offset_ref; strictc = dereference strictc_ref
  srcmap = dereference srcmap_ref
  byte = .int; i = .int; setting = .int
  result = language.comments()
  prepared = .llsource..prepared(source,language.encoding(),'','',policy.limit('source.bytes'),0,result,policy.limit('scan.work'),observations)
  preparedstatus = prepared.status()
  if observations > 0 then do
    trivia = dereference trivia_ref; trivia = prepared.trivia()
  end
  if preparedstatus <> 0 then do
    if preparedstatus <> 1 | left(prepared.error(),11) <> 'LL_COMMENT:' then do
      status = preparedstatus; error = prepared.error(); offset = prepared.offset(); return result
    end
  end
  masked = prepared.bytes(); extent = <blen>(masked); first = 0
  do while first < extent
    byte = <at..u8>(first) masked
    if byte <> 9 & byte <> 11 & byte <> 12 & byte <> 32 & byte <> 10 & byte <> 13 & byte <> 59 then leave
    first = first + 1
  end
  finish = first
  do while finish < extent
    byte = <at..u8>(finish) masked
    if byte = 10 | byte = 13 | byte = 59 then leave
    finish = finish + 1
  end
  if preparedstatus <> 0 & prepared.offset() <= finish then do
    status = preparedstatus; error = prepared.error(); offset = prepared.offset(); return result
  end
  if first = extent then return result
  candidate = .lllanguage..request.borrowed(language_ref,binsubstr(source,1,finish),policy)
  candidatestatus = candidate.lex(0)
  if candidatestatus <> 0 then do
    /* A raw delimiter inside a quoted runtime expression can truncate this
     * candidate. The final full-source request owns lexical validity. */
    if candidatestatus <> 1 then do
      status = candidatestatus; error = candidate.error(); offset = candidate.offset()
    end
    return result
  end
  tokens = candidate.tokens(); index = 0
  do while index < tokens.size()
    if tokens.symbol(index) <> language.tokenid('separator') then leave
    index = index + 1
  end
  identifier = language.tokenid('identifier')
  if index >= tokens.size() then return result
  if tokens.symbol(index) <> identifier then return result
  spelling = binsubstr(source,tokens.start(index) + 1,tokens.finish(index + 1) - tokens.start(index)) as .string
  if verify(spelling,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz') <> 0 then return result
  if upper(spelling) <> 'OPTIONS' then return result
  do i = index + 1 to tokens.size() - 1
    if tokens.symbol(i) <> identifier then return result
  end
  /* Every operand is now a bare word. Validate all settings before replacing
   * this request's comment rules; the leading expression still executes. */
  hash = 0; dash = 0; requestedstrict = 0
  do i = index + 1 to tokens.size() - 1
    raw = binsubstr(source,tokens.start(i) + 1,tokens.finish(i + 1) - tokens.start(i)) as .string
    spelling = ''
    if verify(raw,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_') = 0 then spelling = upper(raw)
    message = ''
    if wordpos(spelling,'LEVELA LEVELB LEVELD LEVELG LEVELL NUMERIC_COMMON COMMENTS_SLASH') > 0 then message = 'incompatible source option '
    if spelling = 'SRCMAP' then srcmap = 1
    if spelling = 'STRICTC' then requestedstrict = 1
    if spelling = 'COMMENTS_HASH' | spelling = 'COMMENTS_NOHASH' then do
      setting = 1; if spelling = 'COMMENTS_NOHASH' then setting = -1
      if hash <> 0 & hash <> setting then message = 'incompatible source option '
      hash = setting
    end
    if spelling = 'COMMENTS_DASH' | spelling = 'COMMENTS_NODASH' then do
      setting = 1; if spelling = 'COMMENTS_NODASH' then setting = -1
      if dash <> 0 & dash <> setting then message = 'incompatible source option '
      dash = setting
    end
    if message <> '' then do
      status = 1; offset = tokens.start(i); error = 'LL_COMPILER_PROFILE: ' || message || raw; return result
    end
  end
  result = .llcomments..rules()
  ok = result.add('nested','nested','/*','*/')
  if hash = 1 then ok = result.add('hash','line','#')
  if dash = 1 then ok = result.add('dash','line','--')
  if result.error() <> '' then do
    status = 3; offset = 0; error = result.error()
  end
  else strictc = requestedstrict
  return result

/** Translate internal token labels without losing the LR expected-token set. */
syntaxmessage: procedure = .string
  arg text = .string
  keywords = 'if then else do end while leave iterate return exit say push queue address signal trace call nop options import procedure arg pull numeric digits fuzz form scientific engineering as namespace expose drop select when otherwise forever until to by for parse'
  do i = 1 to words(keywords)
    keyword = word(keywords,i)
    text = changestr(keyword || 'word',text,upper(keyword))
  end
  text = changestr('separator',text,'end of clause')
  text = changestr('typename',text,'type name')
  text = changestr('labelname',text,'routine label')
  text = changestr('addressenv',text,'environment symbol')
  text = changestr('addressquoted',text,'quoted environment')
  text = changestr('addressvalue',text,'VALUE')
  text = changestr('addresswith',text,'WITH')
  text = changestr('addressoption',text,'INPUT/OUTPUT/ERROR')
  text = changestr('addressposition',text,'APPEND/REPLACE')
  text = changestr('addresskind',text,'NORMAL/STREAM/STEM')
  text = changestr('addressresource',text,'resource variable')
  text = changestr('commandword',text,'expression')
  text = changestr('numericvalue',text,'VALUE')
  text = changestr('signalvalue',text,'VALUE')
  text = changestr('signalname',text,'label name')
  text = changestr('signalhandlername',text,'NAME')
  text = changestr('signalcondition',text,'condition name')
  text = changestr('signalon',text,'ON'); text = changestr('signaloff',text,'OFF')
  text = changestr('callon',text,'ON'); text = changestr('calloff',text,'OFF')
  text = changestr('callcondition',text,'condition name'); text = changestr('callhandlername',text,'NAME')
  text = changestr('callname',text,'handler name')
  text = changestr('tracevalue',text,'VALUE'); text = changestr('traceoption',text,'TRACE option')
  marker = pos('; expected ',text)
  if marker > 0 then do
    prefix = left(text,marker + 10); rest = substr(text,marker + 11); text = prefix; first = 1; item = .string
    do while rest <> ''
      split = pos(',',rest)
      if split = 0 then do; item = strip(rest); rest = ''; end
      else do; item = strip(left(rest,split - 1)); rest = substr(rest,split + 1); end
      if first = 0 then text = text || ', '
      text = text || tokenname(item); first = 0
    end
  end
  return 'LL_COMPILER_SYNTAX: ' || text

/** Decorate the LR failure with Classic PARSE's contextual identity. This
 * inspects only classified prefixes at the failed location; LR still owns
 * all template syntax and the frontend owns numeric/literal admission. */
parsemessage: procedure = .string
  arg language_ref = reference .lllanguage..definition, tokens = .llcore..stream, offset = .int, fallback = .string
  i = .int; j = .int; kind = .int
  language = dereference language_ref
  mode = ''; upperflag = 0; prefix = 0; failedkind = -1
  do i = 0 to tokens.size() - 1
    if tokens.start(i) > offset then leave
    kind = tokens.symbol(i)
    if tokens.start(i) = offset then failedkind = kind
    if mode = 'value' & kind = language.tokenid('parsewith') & tokens.start(i) = offset then return fallback
    select
      when kind = language.tokenid('parseword') then do; mode = 'header'; upperflag = 0; prefix = 0; end
      when kind = language.tokenid('argword') | kind = language.tokenid('pullword') then do; mode = 'template'; upperflag = 1; prefix = 0; end
      when mode = '' then nop
      when kind = language.tokenid('parseupper') then do; mode = 'header'; upperflag = 1; end
      when kind = language.tokenid('parsevalue') then mode = 'value'
      when kind = language.tokenid('parsevar') then mode = 'var'
      when kind = language.tokenid('parsekind') | kind = language.tokenid('parsewith') then mode = 'template'
      when mode = 'var' & kind = language.tokenid('identifier') then mode = 'template'
      when kind = language.tokenid('separator') | kind = language.tokenid('elseword') then do
        if tokens.start(i) < offset then mode = ''
      end
      otherwise nop
    end
    if mode = 'template' then do
      if kind = language.tokenid('assign') | kind = language.tokenid('plus') | kind = language.tokenid('minus') then prefix = 1
      else if tokens.start(i) < offset then prefix = 0
    end
  end
  select mode
    when '' then return fallback
    when 'header' then do
      code = '25.12'; if upperflag then code = '25.13'
      return 'LL_COMPILER_SYNTAX: RXC-LC-' || code || ': PARSE requires a source type'
    end
    when 'var' then return 'LL_COMPILER_SYNTAX: RXC-LC-20.1: PARSE VAR requires a variable name'
    when 'value' then do
      /* A present WITH following a malformed expression is not missing.
       * Preserve the LR expected-token message for that existing expression. */
      do j = i to tokens.size() - 1
        kind = tokens.symbol(j)
        if kind = language.tokenid('separator') | kind = language.tokenid('elseword') then leave
        if kind = language.tokenid('parsewith') then return fallback
      end
      return 'LL_COMPILER_SYNTAX: RXC-LC-38.3: PARSE VALUE instruction requires WITH keyword'
    end
    otherwise do
      if prefix & failedkind = language.tokenid('identifier') then return 'LL_COMPILER_SYNTAX: RXC-LC-38.2: invalid parsing position'
      return 'LL_COMPILER_SYNTAX: RXC-LC-38.1: invalid parsing template'
    end
  end
  return fallback

/** ADDRESS's classified tail owns its keyword/resource diagnostics. This
 * decorates a failed LR prefix only; source expressions remain with LR and
 * completion35.1. Lexical/comment and PARSE failures have already won. */
addressmessage: procedure = .string
  arg language_ref = reference .lllanguage..definition, tokens_ref = reference .llcore..stream, source_ref = reference .binary, offset = .int, fallback = .string
  language = dereference language_ref; tokens = dereference tokens_ref; source = dereference source_ref
  i = .int; kind = .int; first = .int; last = .int
  mode = ''; option = ''; position = ''; resource = ''; sawvalue = 0
  do i = 0 to tokens.size() - 1
    first = tokens.start(i)
    if first >= offset then leave
    kind = tokens.symbol(i); last = tokens.finish(i + 1)
    select
      when kind = language.tokenid('addressword') then do; mode = 'head'; sawvalue = 0; end
      when kind = language.tokenid('separator') | kind = language.tokenid('thenword') | kind = language.tokenid('elseword') | kind = language.tokenid('otherwiseword') then mode = ''
      when mode = '' then nop
      when kind = language.tokenid('addressenv') | kind = language.tokenid('addressquoted') then mode = 'command'
      when kind = language.tokenid('addressvalue') then do; mode = 'value'; sawvalue = 0; end
      when kind = language.tokenid('addresswith') then mode = 'option'
      when kind = language.tokenid('addressoption') then do
        option = upper(binsubstr(source,first + 1,last - first) as .string); mode = 'kind'
      end
      when kind = language.tokenid('addressposition') then do
        position = upper(binsubstr(source,first + 1,last - first) as .string); mode = 'typed'
      end
      when kind = language.tokenid('addresskind') then do
        resource = upper(binsubstr(source,first + 1,last - first) as .string); mode = 'resource'
        if resource = 'NORMAL' then mode = 'option'
      end
      when kind = language.tokenid('addressresource') then mode = 'option'
      when mode = 'value' then sawvalue = 1
      otherwise nop
    end
  end
  code = ''; reason = ''
  select mode
    when 'option' then do; code = '25.5'; reason = 'ADDRESS WITH expects INPUT, OUTPUT or ERROR'; end
    when 'kind' then do
      code = '25.6'; if option = 'OUTPUT' then code = '25.7'
      if option = 'ERROR' then code = '25.14'
      reason = 'invalid ADDRESS ' || option || ' connection'
    end
    when 'typed' then do
      code = '25.8'; if position = 'REPLACE' then code = '25.9'
      reason = 'ADDRESS ' || position || ' expects STREAM or STEM'
    end
    when 'resource' then do
      code = '53.1'; if resource = 'STEM' then code = '53.2'
      reason = 'ADDRESS ' || resource || ' requires a variable resource'
    end
    when 'value' then do
      if sawvalue <> 0 then return fallback
      code = '19.1'; reason = 'ADDRESS VALUE requires an expression'
    end
    otherwise return fallback
  end
  return 'LL_COMPILER_SYNTAX: RXC-LC-' || code || ': ' || reason

/** Decorate only a classified NUMERIC prefix after LR has rejected it. A
 * complete optional/default expression cannot claim an enclosing missing END.
 * Every token is visited at most once; lexical/comment/PARSE errors win. */
numericmessage: procedure = .string
  arg language_ref = reference .lllanguage..definition, tokens_ref = reference .llcore..stream, offset_ref = reference .int, fallback = .string
  language = dereference language_ref; tokens = dereference tokens_ref; offset = dereference offset_ref
  i = .int; kind = .int; first = .int
  mode = ''; keyword = 0; prefix = 0; optional = 0; seen = 0; depth = 0
  previouskind = -1; previousstart = 0; failedkind = -1
  separator = language.tokenid('separator'); numericword = language.tokenid('numericword')
  do i = 0 to tokens.size() - 1
    first = tokens.start(i)
    if first > offset then leave
    kind = tokens.symbol(i)
    if first = offset then failedkind = kind
    boundary = kind = separator | kind = language.tokenid('thenword') | kind = language.tokenid('elseword') | kind = language.tokenid('otherwiseword')
    if kind = numericword then do
      mode = 'head'; keyword = first; prefix = first
    end
    else if boundary then do
      if first < offset then mode = ''
    end
    else select mode
      when 'head' then do
        if kind = language.tokenid('digitsword') | kind = language.tokenid('fuzzword') then do
          mode = 'expression'; prefix = first; optional = 1; seen = 0; depth = 0; previouskind = -1
        end
        else if kind = language.tokenid('formword') then mode = 'form'
        else do
          offset = first
          return 'LL_COMPILER_SYNTAX: RXC-LC-25.15: NUMERIC expects DIGITS, FUZZ or FORM'
        end
      end
      when 'form' then do
        if kind = language.tokenid('scientificword') | kind = language.tokenid('engineeringword') then mode = 'fixed'
        else if kind = language.tokenid('numericvalue') then do
          mode = 'expression'; prefix = first; optional = 0; seen = 0; depth = 0; previouskind = -1
        end
        else do
          offset = first
          return 'LL_COMPILER_SYNTAX: RXC-LC-25.11: NUMERIC FORM expects SCIENTIFIC, ENGINEERING or VALUE'
        end
      end
      when 'fixed' then do
        offset = first
        return 'LL_COMPILER_SYNTAX: RXC-LC-25.11: unexpected operand after fixed NUMERIC FORM'
      end
      when 'expression' then do
        if first < offset then do
          seen = 1; previouskind = kind; previousstart = first
          if kind = language.tokenid('open') then depth = depth + 1
          if kind = language.tokenid('close') then depth = depth - 1
        end
      end
      otherwise nop
    end
  end
  if mode = 'head' then do
    offset = keyword
    return 'LL_COMPILER_SYNTAX: RXC-LC-25.15: NUMERIC expects DIGITS, FUZZ or FORM'
  end
  if mode <> 'expression' then return fallback
  at_end = failedkind = separator | failedkind = language.tokenid('elseword') | offset >= tokens.bytes()
  if at_end then do
    if seen = 0 then do
      if optional then return fallback
      offset = prefix
    end
    else do
      operators = 'plus minus times divide power integerdivide remainder concat blank abut lt gt le ge ne strict strictne strictlt strictgt strictle strictge and or xor not assign'
      trailing = 0
      do i = 1 to words(operators)
        if previouskind = language.tokenid(word(operators,i)) then do
          offset = previousstart; trailing = 1; leave
        end
      end
      if trailing = 0 & depth = 0 then return fallback
    end
  end
  prefix_text = 'LL_COMPILER_SYNTAX: '
  return prefix_text || 'RXC-LC-35.1: invalid NUMERIC expression; ' || substr(fallback,length(prefix_text) + 1)

/** TRACE owns only its classified static tail and VALUE expression errors.
 * Option meaning is checked after AST construction, without source rescanning. */
tracemessage: procedure = .string
  arg language_ref = reference .lllanguage..definition, tokens_ref = reference .llcore..stream, offset_ref = reference .int, fallback = .string
  language = dereference language_ref; tokens = dereference tokens_ref; offset = dereference offset_ref
  i = .int; kind = .int; first = .int
  mode = ''; prefix = 0; seen = 0; previouskind = -1; previousstart = 0
  do i = 0 to tokens.size() - 1
    first = tokens.start(i); if first > offset then leave
    kind = tokens.symbol(i)
    boundary = kind = language.tokenid('separator') | kind = language.tokenid('thenword') | kind = language.tokenid('elseword') | kind = language.tokenid('otherwiseword')
    if kind = language.tokenid('traceword') then mode = 'head'
    else if boundary then do
      if first < offset then mode = ''
    end
    else select mode
      when 'head' then do
        prefix = first
        if kind = language.tokenid('tracevalue') then do; mode = 'value'; seen = 0; end
        else if kind = language.tokenid('traceoption') | kind = language.tokenid('string') then mode = 'static'
        else if kind = language.tokenid('plus') | kind = language.tokenid('minus') then mode = 'signed'
        else do; offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-19.6: invalid TRACE operand'; end
      end
      when 'signed' then do
        if kind = language.tokenid('number') then mode = 'static'
        else do; offset = prefix; return 'LL_COMPILER_SYNTAX: RXC-LC-19.6: TRACE sign requires an integer'; end
      end
      when 'static' then do
        offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-19.6: unexpected operand after TRACE option'
      end
      when 'value' then do
        if first < offset then do; seen = 1; previouskind = kind; previousstart = first; end
      end
      otherwise nop
    end
  end
  if mode = 'signed' then do
    offset = prefix; return 'LL_COMPILER_SYNTAX: RXC-LC-19.6: TRACE sign requires an integer'
  end
  if mode <> 'value' then return fallback
  if seen = 0 then offset = prefix
  else do
    operators = 'plus minus times divide power integerdivide remainder concat blank abut lt gt le ge ne strict strictne strictlt strictgt strictle strictge and or xor not assign'
    do i = 1 to words(operators)
      if previouskind = language.tokenid(word(operators,i)) then do; offset = previousstart; leave; end
    end
  end
  prefix_text = 'LL_COMPILER_SYNTAX: '
  return prefix_text || 'RXC-LC-35.1: invalid TRACE VALUE expression; ' || substr(fallback,length(prefix_text) + 1)

/** Only the classified CALL policy prefix owns these exact diagnostics. */
callmessage: procedure = .string
  arg language_ref = reference .lllanguage..definition, tokens_ref = reference .llcore..stream, offset_ref = reference .int, fallback = .string
  language = dereference language_ref; tokens = dereference tokens_ref; offset = dereference offset_ref
  mode = ''; prefix = 0; i = .int; code = .string
  do i = 0 to tokens.size() - 1
    first = tokens.start(i); if first > offset then leave
    kind = tokens.symbol(i)
    boundary = kind = language.tokenid('separator') | kind = language.tokenid('thenword') | kind = language.tokenid('elseword') | kind = language.tokenid('otherwiseword')
    if kind = language.tokenid('callword') then mode = 'head'
    else if boundary then do
      if first < offset then mode = ''
    end
    else select
      when mode = 'head' then do
        if kind = language.tokenid('callon') then do; mode = 'on.condition'; prefix = first; end
        else if kind = language.tokenid('calloff') then do; mode = 'off.condition'; prefix = first; end
        else mode = ''
      end
      when mode = 'on.condition' | mode = 'off.condition' then do
        if kind = language.tokenid('callcondition') then do
          if mode = 'on.condition' then mode = 'on.name'
          else mode = 'off.tail'
        end
        else do
          code = '25.1'; if mode = 'off.condition' then code = '25.2'
          offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-' || code || ': invalid CALL condition'
        end
      end
      when mode = 'on.name' then do
        if kind = language.tokenid('callhandlername') then do; mode = 'on.target'; prefix = first; end
        else do; offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-19.3: CALL ON requires NAME before its handler'; end
      end
      when mode = 'on.target' then do
        if kind = language.tokenid('callname') | kind = language.tokenid('string') then mode = 'on.tail'
        else do; offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-19.3: invalid CALL handler name'; end
      end
      when mode = 'on.tail' then do
        offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-19.3: unexpected CALL ON operand'
      end
      when mode = 'off.tail' then do
        offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-21.1: unexpected CALL OFF operand'
      end
      otherwise nop
    end
  end
  if mode = 'on.condition' | mode = 'off.condition' then do
    code = '25.1'; if mode = 'off.condition' then code = '25.2'
    /* A missing condition belongs to the actual clause/EOF boundary, as in
     * the native expected-keywords rule; NAME below retains its keyword. */
    return 'LL_COMPILER_SYNTAX: RXC-LC-' || code || ': CALL requires a condition name'
  end
  if mode = 'on.target' then do
    offset = prefix; return 'LL_COMPILER_SYNTAX: RXC-LC-19.3: CALL NAME requires a label'
  end
  return fallback

/** One classified SIGNAL prefix scan owns target/expression diagnostics. */
signalmessage: procedure = .string
  arg language_ref = reference .lllanguage..definition, tokens_ref = reference .llcore..stream, offset_ref = reference .int, fallback = .string
  language = dereference language_ref; tokens = dereference tokens_ref; offset = dereference offset_ref
  i = .int; kind = .int; first = .int; code = .string
  mode = ''; keyword = 0; prefix = 0; previouskind = -1; previousstart = 0; failedkind = -1; seen = 0; depth = 0
  do i = 0 to tokens.size() - 1
    first = tokens.start(i); if first > offset then leave
    kind = tokens.symbol(i); if first = offset then failedkind = kind
    boundary = kind = language.tokenid('separator') | kind = language.tokenid('thenword') | kind = language.tokenid('elseword') | kind = language.tokenid('otherwiseword')
    if kind = language.tokenid('signalword') then do; mode = 'head'; keyword = first; end
    else if boundary then do
      if first < offset then mode = ''
    end
    else if mode = 'off.condition' then do
      if kind = language.tokenid('signalcondition') then mode = 'off.tail'
      else do; offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-25.4: invalid SIGNAL condition'; end
    end
    else if mode = 'off.tail' then do
      offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-19.3: unexpected SIGNAL OFF operand'
    end
    else select mode
      when 'head' then do
        if kind = language.tokenid('signalon') then do; mode = 'on.condition'; prefix = first; end
        else if kind = language.tokenid('signaloff') then do; mode = 'off.condition'; prefix = first; end
        else if kind = language.tokenid('signalvalue') then do; mode = 'value'; prefix = first; seen = 0; depth = 0; end
        else if kind = language.tokenid('signalname') | kind = language.tokenid('string') then mode = 'static'
        else do
          offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-19.4: SIGNAL requires a label or VALUE expression'
        end
      end
      when 'static' then do
        offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-19.4: unexpected operand after SIGNAL target'
      end
      when 'on.condition' then do
        if kind = language.tokenid('signalcondition') then do
          if mode = 'on.condition' then mode = 'on.name'
          else mode = 'off.tail'
        end
        else do
          code = '25.3'; if mode = 'off.condition' then code = '25.4'
          offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-' || code || ': invalid SIGNAL condition'
        end
      end
      when 'on.name' then do
        if kind = language.tokenid('signalhandlername') then do; mode = 'on.target'; prefix = first; end
        else do; offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-19.3: SIGNAL ON requires NAME before its handler'; end
      end
      when 'on.target' then do
        if kind = language.tokenid('signalname') | kind = language.tokenid('string') then mode = 'on.tail'
        else do; offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-19.3: invalid SIGNAL handler name'; end
      end
      when 'on.tail' then do
        offset = first; return 'LL_COMPILER_SYNTAX: RXC-LC-19.3: unexpected SIGNAL policy operand'
      end
      when 'value' then do
        if first < offset then do
          seen = 1; previouskind = kind; previousstart = first
          if kind = language.tokenid('open') then depth = depth + 1
          if kind = language.tokenid('close') then depth = depth - 1
        end
      end
      otherwise nop
    end
  end
  if mode = 'head' then do
    offset = keyword; return 'LL_COMPILER_SYNTAX: RXC-LC-19.4: SIGNAL requires a label or VALUE expression'
  end
  if mode = 'on.condition' | mode = 'off.condition' then do
    code = '25.3'; if mode = 'off.condition' then code = '25.4'
    offset = prefix; return 'LL_COMPILER_SYNTAX: RXC-LC-' || code || ': SIGNAL requires a condition name'
  end
  if mode = 'on.target' then do
    offset = prefix; return 'LL_COMPILER_SYNTAX: RXC-LC-19.3: SIGNAL NAME requires a label'
  end
  if mode <> 'value' then return fallback
  at_end = failedkind = language.tokenid('separator') | failedkind = language.tokenid('elseword') | offset >= tokens.bytes()
  if at_end & seen = 0 then do
    offset = prefix; return 'LL_COMPILER_SYNTAX: RXC-LC-19.4: SIGNAL VALUE requires an expression'
  end
  if at_end then do
    operators = 'plus minus times divide power integerdivide remainder concat blank abut lt gt le ge ne strict strictne strictlt strictgt strictle strictge and or xor not assign'
    trailing = 0
    do i = 1 to words(operators)
      if previouskind = language.tokenid(word(operators,i)) then do; offset = previousstart; trailing = 1; leave; end
    end
    if trailing = 0 & depth = 0 then return fallback
  end
  prefix_text = 'LL_COMPILER_SYNTAX: '
  return prefix_text || 'RXC-LC-35.1: invalid SIGNAL expression; ' || substr(fallback,length(prefix_text) + 1)

/** Only classified completion/insertion/ADDRESS/INTERPRET instructions own
 * 35.1. Variables, labels and quoted/function names cannot activate it;
 * lexical and PARSE failures win. */
completionmessage: procedure = .string
  arg language_ref = reference .lllanguage..definition, tokens_ref = reference .llcore..stream, offset_ref = reference .int, fallback = .string
  language = dereference language_ref; tokens = dereference tokens_ref; offset = dereference offset_ref
  i = .int
  active = ''; previouskind = -1; previousstart = 0; failedkind = -1
  separator = language.tokenid('separator'); returnword = language.tokenid('returnword'); exitword = language.tokenid('exitword'); pushword = language.tokenid('pushword'); queueword = language.tokenid('queueword'); addressword = language.tokenid('addressword'); interpretword = language.tokenid('interpretword')
  do i = 0 to tokens.size() - 1
    first = tokens.start(i)
    if first > offset then leave
    kind = tokens.symbol(i)
    if first = offset then failedkind = kind
    if kind = returnword then active = 'RETURN'
    else if kind = exitword then active = 'EXIT'
    else if kind = pushword then active = 'PUSH'
    else if kind = queueword then active = 'QUEUE'
    else if kind = addressword then active = 'ADDRESS'
    else if kind = interpretword then active = 'INTERPRET'
    else if kind = separator | kind = language.tokenid('thenword') | kind = language.tokenid('elseword') | kind = language.tokenid('otherwiseword') then do
      if first < offset then active = ''
    end
    if first < offset & kind <> separator then do
      previouskind = kind; previousstart = first
    end
  end
  if active = '' then return fallback
  if failedkind = separator | offset >= tokens.bytes() then do
    operators = 'plus minus times divide power integerdivide remainder concat blank abut lt gt le ge ne strict strictne strictlt strictgt strictle strictge and or xor not assign'
    do i = 1 to words(operators)
      if previouskind = language.tokenid(word(operators,i)) then do; offset = previousstart; leave; end
    end
  end
  prefix = 'LL_COMPILER_SYNTAX: '
  return prefix || 'RXC-LC-35.1: invalid ' || active || ' expression; ' || substr(fallback,length(prefix) + 1)

tokenname: procedure = .string
  arg name = .string
  keys = 'assign plus minus times divide concat blank abut lt gt le ge ne strict and or xor not open close comma identifier number string'
  values = .string[]
  values[1] = "'='"; values[2] = "'+'"; values[3] = "'-'"; values[4] = "'*'"; values[5] = "'/'"
  values[6] = "'||'"; values[7] = 'blank concatenation'; values[8] = 'abuttal concatenation'
  values[9] = "'<'"; values[10] = "'>'"; values[11] = "'<='"; values[12] = "'>='"; values[13] = "'<>'"
  values[14] = "'=='"; values[15] = "'&'"; values[16] = "'|'"; values[17] = "'&&'"; values[18] = "'\'"
  values[19] = "'('"; values[20] = "')'"; values[21] = "','"; values[22] = 'name'; values[23] = 'number'; values[24] = 'quoted string'
  index = wordpos(name,keys)
  if index > 0 then return values[index]
  keys = 'power integerdivide remainder strictne strictlt strictgt strictle strictge'
  values[1] = "'**'"; values[2] = "'%'"; values[3] = "'//'"; values[4] = "'\=='"
  values[5] = "'<<'"; values[6] = "'>>'"; values[7] = "'<<='"; values[8] = "'>>='"
  index = wordpos(name,keys)
  if index > 0 then return values[index]
  return name

/** Keep generic source validation single-owned; only translate its identity. */
lexicalmessage: procedure = .string
  arg original = .string, source = .binary, offset = .int
  if left(original,8) = 'LL_UTF8:' then return 'LL_COMPILER_SYNTAX: RXC-LC-22.1: invalid UTF-8 source string ' || bin2x(binsubstr(source,offset + 1,1))
  if left(original,11) = 'LL_COMMENT:' then return 'LL_COMPILER_SYNTAX: RXC-LC-6.1: unmatched comment delimiter'
  return original

/** Comment-only gaps do not introduce a blank. Mark potential blank bytes,
 * then let the shared comment coordinator erase only marks inside comments.
 * Every gap is disjoint, so source traversal remains linear and bounded. */
sourceblank: procedure = .int
  arg source = .binary, first = .int, last = .int, comments = .llcomments..rules
  if first >= last then return 0
  gap = binsubstr(source,first + 1,last - first)
  do i = 0 to <blen>(gap) - 1
    byte = <at..u8>(i) gap
    if byte = 9 | byte = 10 | byte = 11 | byte = 12 | byte = 13 | byte = 32 then <at..u8>(i) gap = 1
  end
  stripped = .llcomments..processor(gap,comments,max(1000,<blen>(gap) * 16))
  status = stripped.run()
  if status <> 0 then return 1
  return binpos('01'x as .binary,stripped.bytes()) > 0

/** Last-resort Classic diagnostic classification after the specific
 * instruction owners. Inspect the rejected prefix once, without recovery or
 * manufacturing an executable AST. Located operators own missing operands. */
generalmessage: procedure = .string
  arg language_ref = reference .lllanguage..definition, tokens_ref = reference .llcore..stream, offset_ref = reference .int, fallback = .string
  language = dereference language_ref; tokens = dereference tokens_ref; offset = dereference offset_ref
  operators = 'plus minus times divide power integerdivide remainder concat blank abut lt gt le ge ne strict strictne strictlt strictgt strictle strictge and or xor not assign'
  sep = language.tokenid('separator'); opening = language.tokenid('open'); closing = language.tokenid('close')
  depth = 0; groups = .string[]; groupoffsets = .int[]; count = 0
  opens = .int[]; active = ''; head = 0; previous = -1; previousstart = 0; failed = -1
  code = ''; reason = ''; instruction = ''; thenpending = 0; whenpending = 0; selectpending = 0
  i = .int
  do i = 0 to tokens.size() - 1
    first = tokens.start(i); kind = tokens.symbol(i)
    if first > offset then leave
    if first = offset then failed = kind
    if selectpending & kind <> language.tokenid('selectword') & kind <> sep & kind <> language.tokenid('labelname') & kind <> language.tokenid('colon') & kind <> language.tokenid('whenword') & kind <> language.tokenid('endword') then do
      code = '7.2'; reason = 'SELECT requires WHEN, OTHERWISE or END'; offset = first; leave
    end
    if kind = closing & depth = 0 then do
      code = '37.2'; reason = 'unmatched closing parenthesis'; offset = first; leave
    end
    if kind = opening then do; depth = depth + 1; opens[depth] = first; end
    if kind = closing & depth > 0 then depth = depth - 1
    if kind = language.tokenid('doword') | kind = language.tokenid('selectword') then do
      count = count + 1; groups[count] = 'DO'; groupoffsets[count] = first
      if kind = language.tokenid('selectword') then do; groups[count] = 'SELECT'; selectpending = 1; end
    end
    if kind = language.tokenid('endword') then do
      if count = 0 then do; code = '10.1'; reason = 'unexpected END'; offset = first; leave; end
      if previous = language.tokenid('thenword') | previous = language.tokenid('elseword') then do
        code = '10.5'; if previous = language.tokenid('elseword') then code = '10.6'
        reason = 'END cannot immediately follow THEN or ELSE'; offset = first; leave
      end
      if groups[count] = 'SELECT' then do
        if selectpending then do; code = '7.1'; reason = 'SELECT requires WHEN'; offset = first; leave; end
        if tokens.symbol(i + 1) <> sep & tokens.symbol(i + 1) <> -1 then do
          code = '10.4'; reason = 'SELECT END must not have a name'; offset = tokens.start(i + 1); leave
        end
      end
      count = count - 1
    end
    if kind = language.tokenid('whenword') | kind = language.tokenid('otherwiseword') then do
      if count = 0 then do
        code = '9.1'; if kind = language.tokenid('otherwiseword') then code = '9.2'
        reason = 'WHEN or OTHERWISE requires SELECT'; offset = first; leave
      end
      if groups[count] <> 'SELECT' then do
        code = '9.1'; if kind = language.tokenid('otherwiseword') then code = '9.2'
        reason = 'WHEN or OTHERWISE requires SELECT'; offset = first; leave
      end
      selectpending = 0; whenpending = kind = language.tokenid('whenword')
    end
    if kind = sep | kind = language.tokenid('thenword') | kind = language.tokenid('elseword') | kind = language.tokenid('otherwiseword') then do
      if first < offset then active = ''
      if kind = language.tokenid('thenword') then do
        if thenpending = 0 & whenpending = 0 then do; code = '8.1'; reason = 'unexpected THEN'; offset = first; leave; end
        thenpending = 0; whenpending = 0
      end
      if kind = language.tokenid('elseword') & i = 0 then do; code = '8.2'; reason = 'unexpected ELSE'; offset = first; leave; end
    end
    else if active = '' then do
      active = 'expression'; head = first
      if kind = language.tokenid('nopword') then active = 'NOP'
      if kind = language.tokenid('dropword') then active = 'DROP'
      if kind = language.tokenid('procedureword') then active = 'PROCEDURE'
      if kind = language.tokenid('leaveword') then active = 'LEAVE'
      if kind = language.tokenid('iterateword') then active = 'ITERATE'
      if kind = language.tokenid('whenword') then active = 'WHEN'
      if kind = language.tokenid('ifword') then do; active = 'IF'; thenpending = 1; end
    end
    if first < offset & kind <> sep then do; previous = kind; previousstart = first; end
  end
  if code = '' & active = 'NOP' then do; code = '21.1'; reason = 'NOP has an unexpected operand'; end
  if code = '' & active = 'DROP' then do
    code = '20.1'; reason = 'DROP requires a variable reference'
    if depth > 0 then do; code = '46.1'; reason = 'closing parenthesis expected in variable reference'; end
  end
  if code = '' & active = 'PROCEDURE' then do; code = '20.1'; reason = 'PROCEDURE EXPOSE requires a variable reference'; end
  if code = '' & (active = 'LEAVE' | active = 'ITERATE') then do
    code = '20.1'; reason = active || ' requires a symbol target'
    if previous = language.tokenid('identifier') then do; code = '21.1'; reason = 'unexpected operand after ' || active || ' target'; end
  end
  if code = '' & count > 0 then do
    if groups[count] = 'DO' then do
      if failed = language.tokenid('toword') | failed = language.tokenid('byword') | failed = language.tokenid('forword') | previous = language.tokenid('foreverword') then do
        code = '27.1'; reason = 'invalid keyword in DO clause'
      end
      if previous = language.tokenid('toword') | previous = language.tokenid('byword') | previous = language.tokenid('forword') | previous = language.tokenid('whileword') | previous = language.tokenid('untilword') then do
        code = '35.1'; reason = 'missing expression in DO clause'; offset = previousstart
      end
    end
  end
  if code = '' & thenpending then do; code = '18.1'; reason = 'IF requires THEN'; end
  if code = '' & whenpending then do; code = '18.2'; reason = 'WHEN requires THEN'; end
  if code = '' & depth > 0 then do; code = '36'; reason = 'unmatched opening parenthesis'; offset = opens[depth]; end
  /* LR can stop at a subsequent statement before reaching EOF when SELECT
   * lacks END. Only its clause-boundary expectation licenses this tail check;
   * nested classified groups must close before an END can close this owner.
   * A present matching END retains the actual rejected-clause diagnostic. */
  if code = '' & count > 0 then do
    if groups[count] = 'SELECT' & pos('END',fallback) > 0 & pos('WHEN',fallback) > 0 & pos('OTHERWISE',fallback) > 0 then do
      taildepth = 1; tailindex = .int
      doid = language.tokenid('doword'); selectid = language.tokenid('selectword'); endid = language.tokenid('endword')
      do tailindex = i to tokens.size() - 1
        tailkind = tokens.symbol(tailindex)
        if tailkind = doid | tailkind = selectid then taildepth = taildepth + 1
        if tailkind = endid then taildepth = taildepth - 1
        if taildepth = 0 then leave
      end
      if taildepth > 0 then do; code = '14.2'; reason = 'SELECT requires END'; offset = groupoffsets[count]; end
    end
  end
  if code = '' & count > 0 & (offset >= tokens.bytes() | failed = sep) then do
    code = '14.1'; reason = 'DO requires END'; offset = groupoffsets[count]
    if groups[count] = 'SELECT' then do; code = '14.2'; reason = 'SELECT requires END'; end
  end
  if code = '' & failed = language.tokenid('comma') then do; code = '37.1'; reason = 'unexpected comma'; end
  if code = '' & failed = language.tokenid('colon') then do; code = '13.1'; reason = 'unexpected colon'; end
  if code = '' then do
    code = '35.1'; reason = 'invalid expression'
    do i = 1 to words(operators)
      if previous = language.tokenid(word(operators,i)) then do; offset = previousstart; leave; end
    end
  end
  return 'LL_COMPILER_SYNTAX: RXC-LC-' || code || ': ' || reason || '; ' || fallback
