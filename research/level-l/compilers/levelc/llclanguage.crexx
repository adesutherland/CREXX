/* cREXX License (MIT). Private, worker-local prepared C language owner. */
options levelb
namespace llclanguage expose prepared
import rxfnsb
import llcgrammar
import lllanguage
import llcore

/** Each mutable module overlay owns one stable definition. Construction is
 * deferred until first use; only a completely checked local value is published.
 * States are cold, preparing, ready and failed. No request can borrow a partial
 * owner or retry a failed construction; typed failure retains its original event. */
prepare: initialiser expose _definition _state _failure
  _definition = .lllanguage..definition
  _failure = .runtime_signal
  _state = 0
  return

/** Compiler-internal borrow. The owning loaded grammar/module instance is never
 * retargeted; source/comment/limit state belongs to individual requests. */
prepared: procedure = reference .lllanguage..definition expose _definition _state _failure
  absent = reference .lllanguage..definition
  if _state = 2 then return reference _definition
  if _state = 3 then do
    if initialized(_failure) then call rxfnsb..signalrelay(_failure)
    return absent
  end
  if _state = 1 then do
    detail = 'LL_BORROW_OWNER: recursive C language preparation'
    assembler signal 'ERROR',detail
    return absent
  end
  _state = 1
  do
    candidate = llcgrammar..language()
    if initialized(candidate) = 0 then do; _state = 3; return absent; end
    if candidate.backend() <> 'lr1' | candidate.hasparser() = 0 then do; _state = 3; return absent; end
    scanner = candidate.borrowedscanner('' as .binary,'munch')
    if scanner.run() <> 0 then do; _state = 3; return absent; end
    parser = candidate.borrowedparser(.llcore..stream.tokens('' as .binary))
    status = parser.run()
    if status <> 0 & status <> 1 then do; _state = 3; return absent; end
    _definition = candidate
    _state = 2
  on signal as problem
    _failure = problem as .runtime_signal
    _state = 3
    call rxfnsb..signalrelay(_failure)
    return absent
  end
  return reference _definition
