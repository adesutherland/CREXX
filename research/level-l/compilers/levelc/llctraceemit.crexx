    when name = 'rxfnsb._trace_context_from_raw' then return '.rxfnsb..tracecontext|.rxfnsb..trace_interrupt_raw||1'
    when name = 'rxfnsb._trace_should_trace_module' then return '.int|.int||'
    when name = 'rxfnsb._trace_should_trace_context' then return '.int|.rxfnsb..tracecontext||'
    when name = 'rxfnsb._trace_needs_breakpoints' then return '.int|.string||'
    when name = 'rxfnsb._trace_capture_result_target' then return '.void|.int .int||'
    when name = 'rxfnsb._trace_next_pending_result' then return '.int|.int||'
    when name = 'rxfnsb._trace_pending_parent_register' then return '.int|.int .string .string||011'
    when name = 'rxfnsb._trace_supply_parent_value' then return '.void|.string||'
    when name = 'rxfnsb._trace_escape_text' then return '.string|.string||'
    when name = 'rxfnsb._trace_write_line' then return '.void|.string||'
    when name = 'rxfnsb._trace_write_value' then return '.void|.string .string||'
    when name = 'rxfnsb._trace_pending_result' then return '.int|||'
    when name = 'rxfnsb._trace_current_mode' | name = 'rxfnsb._trace_current_format' | name = 'rxfnsb._trace_pending_prefix' then return '.string|||'
    when name = 'rxfnsb.tracecontext.column' | name = 'rxfnsb.tracecontext.has_source' | name = 'rxfnsb.tracecontext.line' then return '.int|||'
    when name = 'rxfnsb.tracecontext.asm_line' | name = 'rxfnsb.tracecontext.procedure' | name = 'rxfnsb.tracecontext.source' | name = 'rxfnsb.tracecontext.source_file' then return '.string|||'
    otherwise return ''
  end
  return ''

