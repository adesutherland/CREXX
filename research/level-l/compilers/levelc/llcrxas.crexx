    store = dereference _store; sourceid = store.get(9,origin.id(),1)
    positions = .llsource..index
    if sourceid < 1 then do; call fail('SOURCE: origin has no source record'); return positions; end
    if sourceid <= _sourceindexes[0] then do
      if _sourceindexes[sourceid] is .llsource..index then do
        positions = _sourceindexes[sourceid] as .llsource..index
        _phase = phase; return positions
      end
    end
    _phase = 'source UTF8 validation'
