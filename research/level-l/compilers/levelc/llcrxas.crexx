  /** C-owned dispatch and transitions select existing B methods. Integer
   * mismatch does not touch the context, and enter validates eligibility once. */
  procedureoperation: method = .void
    arg op = .llir..opview, name = .string
    symbol = .string; bytes = .binary; membername = .string; config = .string
    prefix = 'llprocedure' || _fn || '_' || op.id()
    receiver = reg(_workbase + 1); activation = reg(_workbase + 4)
