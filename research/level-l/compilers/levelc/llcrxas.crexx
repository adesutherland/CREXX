  /** Release transient borrowers before restoring the live bundle, then drop
   * the replacement owner. The flag-zero edge never reads the saved pool. */
  /** Handler transfer discards transient owners without leaving its activation. */
  transientcleanup: method = .void
    arg fatal = 0
