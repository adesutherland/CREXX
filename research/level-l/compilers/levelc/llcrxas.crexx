    call emit('linkref',receiver || ',' || config)
    symbol = member('rexxclassicconfig.rexxclassicconfig',name || 'text','.void','.string')
    call argcopy(2,text); call invoke('',symbol,2,receiver)
    call emit('unlink',receiver); call emit('null',config); call emit('null',text)
    return
  /** One Classic conversion in a disposable private window. */
  addresstext: method = .void
    arg value = .string
    symbol = member('rexxvalue.rexxvalue','asstring','.string','.int','1')
    call argcopy(1,value); call emit('load',reg(_callbase + 2) || ',1')
    call invoke(reg(_workbase + 9),symbol,2)
