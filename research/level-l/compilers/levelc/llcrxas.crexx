    if origin.kind() <> 'exact' then return filename || ': generated code in ' || _routine
    positions_ref = sourceindex(origin)
    if _error <> '' then return ''
    positions = dereference positions_ref
    at = positions.position(origin.first())
    if at.error() <> '' then do; call fail('SOURCE: ' || at.error()); return ''; end
    return filename || ':' || at.line() || ':' || at.column()
