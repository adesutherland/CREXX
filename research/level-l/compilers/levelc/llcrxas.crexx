  classic: method = .void
    arg op = .llir..opview, name = .string, entry_ref = reference .llcprocedureprotocol..checked, signal_ref = reference .llcsignalprotocol..checked, loop_ref = reference .llcdoprotocol..checked
    symbol = .string
