    positions = dereference positions_ref
    store = dereference _store; sourceid = store.get(9,origin.id(),1)
    bytes_ref = reference _sourcebytes[sourceid]; bytes = dereference bytes_ref
    at = positions.position(origin.first())
    if at.error() <> '' then do; call fail('SOURCE: ' || at.error()); return; end
    line = at.line(); column = at.column(); first = at.first(); last = at.last()
    finish = min(last,origin.last()); ending = positions.position(finish)
    if ending.error() <> '' then do; call fail('SOURCE: ' || ending.error()); return; end
    endcolumn = ending.column()
