     * both possible method receivers before clearing their borrowed storage. */
    if fatal then do
      call emit('unlink',reg(_workbase)); call emit('unlink',reg(_workbase + 1))
    end
    do i = 1 to _maxargs; call emit('null',reg(_callbase + i)); end
    do i = 0 to 10; call emit('null',reg(_workbase + i)); end
    if _parsestate >= 0 then call emit('null',reg(_parsestate))
