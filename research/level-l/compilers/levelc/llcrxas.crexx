    if wordpos(name,'signal.policy signal.capture signal.select signal.selected signal.deliver signal.handler.invalid signal.relay') > 0 then do; call conditionoperation(op,name,signal_ref); return; end
    if name = 'parse.source' then do; call parsesource(op); return; end
