    end
    return
  selectop: method = .void
    arg op = .llir..opview, entry_ref = reference .llcprocedureprotocol..checked, signal_ref = reference .llcsignalprotocol..checked, clause_ref = reference .llcclauseprotocol..checked, loop_ref = reference .llcdoprotocol..checked
    i = .int
