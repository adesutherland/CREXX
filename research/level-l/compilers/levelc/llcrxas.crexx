    symbol = member('rexxpool.rexxvariablepool',membername,'.void',types)
    call argtext(2,op.attribute('name') as .string); call argcopy(3,reg(_savedpool))
    call invoke('',symbol,count,receiver); call emit('unlink',receiver)
    if count = 4 then call emit('null',config)
    return
