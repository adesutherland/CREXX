  source: method = .void
    arg origin = .llir..origin, clause = 0, diagnostic = 0
    key = .string; location = .string
    if origin.id() = 0 then do; call clearsource(); return; end
    kind = origin.kind()
    if kind = 'synthetic' then do
      key = '6 "" 0 0 0 ""'; location = 'generated code in ' || _routine
