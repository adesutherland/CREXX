/* cREXX License (MIT). Checked Classic IR selection; output uses llir.writer. */
options levelb
namespace llcrxas expose compilation
import rxfnsb
import llir
import llcir
import llcompilercontracts
import llsource
import llrxastext
import llcgrammar
import lllanguage
import lllimits
import llcore

/** A compile owns its source graph and emits only a fully checked output.
 * Registers are stable per function; the disjoint call window is never shared
 * with live IR values. Source graph storage is read-only throughout. */
compilation: class
  _graph = .llir..module
  _store = reference .llir..arena
  _schema = .llir..contract
  _canonical = .llir..contract
  _path = .string
  _limit = .int
  _reglimit = .int
  _phase = .string
  _ready = .int
  _error = .string
  _offset = .int
  _origin = .int
  _fn = .int
  _registers = .int[]
  _slots = .int[]
  _callbase = .int
  _scratch = .int
  _workbase = .int
  _location = .int
  _sizing = .int
  _needsscratch = .int
  _maxargs = .int
  _fallthrough = .int
  _sourceindexes = .object[]
  _lastsource = .string
  _lastlocation = .string
  _routine = .string
  _locals = .int
  _names = .string[]
  _signatures = .object[]
  _packages = .string[]
  _catalogs = .object[]
  _classiccatalog = .llcompilercontracts..catalog
  _classicready = .int
  _classes = .string[]
  _symbolgrammar = .lllanguage..definition
  _symbolpolicy = .lllimits..policy
  _symbolready = .int
  _records = .object[]
  _recordbytes = .int
  _writer = .llir..writer
  _output = .llir..output
  *: factory
    arg graph = .llir..module, artifacts = .string, bytes = 67108864, registers = 65536
    _graph = graph; _path = artifacts; _limit = bytes; _reglimit = registers
    _ready = 0; _error = ''; _origin = 0; _offset = 0; _classicready = 0; _symbolready = 0
    return
  fail: method = .void
    arg reason = .string
    if _error = '' then _error = 'LL_COMPILER_' || reason
    return
  status: method = .int
    call run(); return _error <> ''
  error: method = .string
    call run(); return _error
  offset: method = .int
    call run(); return _offset
  output: method = .llir..output
    call run()
    if _error <> '' then do
      chunks = .binary[]; origins = .int[]
      return .llir..output(chunks,origins,0,_error)
    end
    return _output
  emit: method = .void
    arg mnemonic = .string, operands = ''
    if _error <> '' then return
    if _sizing then return
    _recordbytes = _recordbytes + length(mnemonic) + length(operands) + 2
    if _recordbytes > _limit then do
      call fail('LIMIT: selected output exceeds output.bytes budget'); return
    end
    n = _records[0] + 1
    _records[n] = .llrxastext..instruction(mnemonic,operands,_origin) as .object
    return
  reg: method = .string
    arg index = .int
    if _sizing then do
      if index = _scratch then _needsscratch = 1
      return 'r' || index
    end
    if index < 0 | index >= _locals then call fail('REGISTER: register outside assigned frame')
    return 'r' || index
  input: method = .string
    arg op = .llir..opview, index = 1
    return reg(_registers[op.input(index).id()])
  result: method = .string
    arg op = .llir..opview
    if op.results() = 0 then return ''
    return reg(_registers[op.result().id()])
  typename: method = .string
    arg id = .int
    schema = dereference _schema.data()
    return schema.typename(id)
  targettype: method = .string
    arg id = .int
    name = typename(id)
    select
      when name = 'core.void' then return '.void'
      when name = 'core.boolean' | name = 'crexx.g.int64' then return '.int'
      when name = 'crexx.g.text' then return '.string'
      when name = 'crexx.c.value' then return '.rexxvalue..rexxvalue'
      when name = 'crexx.c.context' then return 'reference .rexxclassiccontext..rexxclassiccontext'
      when name = 'crexx.c.arguments' | name = 'crexx.c.result' then return '.rexxactivation..rexxactivationarguments'
      otherwise call fail('LOWERING: unsupported value type ' || name)
    end
    return ''
  localname: method = .string
    arg identity = .string
    store = dereference _store
    do i = 1 to store.count(1)
      if store.text(store.get(1,i,1)) = identity then return 'llf' || i
    end
    call fail('LOWERING: missing local routine ' || identity)
    return ''
  importsignature: method = .llcompilercontracts..signature
    arg package = .string, name = .string
    i = .int
    do i = 1 to _names[0]
      if _names[i] = name then return _signatures[i] as .llcompilercontracts..signature
    end
    image = .binary; signature = .llcompilercontracts..signature
    if package = 'rxfnsc' then do
      /* Keep lazy-reader state on one live typed owner for this request.
       * A value copy made before lookup would repeatedly decode the image. */
      if _classicready = 0 then do
        do
          image = readbinary(_path || '/' || package || '.rxbin')
        on signal
          call fail('IMPORT: cannot read ' || package || '.rxbin')
          return .llcompilercontracts..signature.failed(_error)
        end
        _classiccatalog = .llcompilercontracts..catalog(image,67108864)
        _classicready = 1
      end
      signature = _classiccatalog.lookup(name)
    end
    else do
      catalog = .llcompilercontracts..catalog; found = 0
      do i = 1 to _packages[0]
        if _packages[i] = package then found = i
      end
      if found = 0 then do
        do
          image = readbinary(_path || '/' || package || '.rxbin')
        on signal
          call fail('IMPORT: cannot read ' || package || '.rxbin')
          return .llcompilercontracts..signature.failed(_error)
        end
        catalog = .llcompilercontracts..catalog(image,67108864)
        found = _packages[0] + 1; _packages[found] = package
      end
      else catalog = _catalogs[found] as .llcompilercontracts..catalog
      signature = catalog.lookup(name)
      if signature.error() = '' then _catalogs[found] = catalog as .object
    end
    if signature.error() <> '' then call fail('IMPORT: ' || signature.error())
    if _error = '' then do
      n = _names[0] + 1; _names[n] = name; _signatures[n] = signature as .object
    end
    return signature
  imported: method = .string
    arg package = .string, name = .string, result = .string, arguments = .string, optional = ''
    signature = importsignature(package,name)
    if _error <> '' then return ''
    if signature.flags_text() <> 'b' | qualifiedtype(signature.result()) <> result | signature.arguments() <> words(arguments) then call fail('IMPORT: incompatible target signature ' || name)
    else do i = 1 to words(arguments)
      expected = word(arguments,i); expected = changestr('@',expected,' ')
      if qualifiedtype(signature.type(i)) <> expected | signature.optional(i) <> (substr(optional,i,1) = '1') then call fail('IMPORT: incompatible target argument ' || name || ':' || i)
    end
    if _error <> '' then return ''
    return name
  /** Only these established Classic short identities have selected aliases.
   * Unrelated namespaces with the same basename never compare equivalent. */
  qualifiedtype: method = .string
    arg type = .string
    prefix = ''
    if left(type,10) = 'reference ' then do; prefix = 'reference '; type = substr(type,11); end
    select
      when type = '.rexxvalue' then type = '.rexxvalue..rexxvalue'
      when type = '.rexxvariablepool' then type = '.rexxpool..rexxvariablepool'
      when type = '.rexxactivationarguments' then type = '.rexxactivation..rexxactivationarguments'
      when type = '.rexxclassicconfig' then type = '.rexxclassicconfig..rexxclassicconfig'
      when type = '.rexxclassiccontext' then type = '.rexxclassiccontext..rexxclassiccontext'
      otherwise nop
    end
    return prefix || type
  /** Existing class members have a hidden live receiver, absent from their
   * declared metadata arguments. Factories have only their declared inputs. */
  member: method = .string
    arg owner = .string, name = .string, result = .string, arguments = '', optional = ''
    symbol = imported('rxfnsc',owner || '.' || name,result,arguments,optional)
    if _error <> '' then return ''
    /* The catalog bytes are immutable for this compilation. Owner admission
     * is reusable; each member's exact signature above is checked every time. */
    do i = 1 to _classes[0]
      if _classes[i] = owner then return symbol
    end
    if _classiccatalog.field(11,owner,'',2) <> 'b' then call fail('IMPORT: incompatible target class ' || owner)
    if _error <> '' then return ''
    _classes[_classes[0] + 1] = owner
    return symbol
  /** Args are already in a private contiguous window. The return destination
   * is distinct; clearing the window after return releases borrowed references. */
  invoke: method = .void
    arg destination = .string, name = .string, count = .int, receiver = ''
    i = .int
    if destination = '' then destination = reg(_scratch)
    if _sizing then do
      _maxargs = max(_maxargs,count); return
    end
    if count < 0 | count > _locals - _callbase - 1 then do
      call fail('REGISTER: call window exceeds frame'); return
    end
    if receiver <> '' then call emit('swap',receiver || ',' || reg(_callbase + 1))
    call emit('load',reg(_callbase) || ',' || count)
    do i = 1 to count
      flags = 768
      if i = 1 & receiver <> '' then flags = 256
      call emit('settp',reg(_callbase + i) || ',' || flags)
    end
    call emit('call',destination || ',' || name || '(),' || reg(_callbase))
    if receiver <> '' then call emit('swap',receiver || ',' || reg(_callbase + 1))
    do i = 1 to count
      call emit('null',reg(_callbase + i))
    end
    return
  argcopy: method = .void
    arg ordinal = .int, value = .string, borrow = 0
    mnemonic = 'copy'; if borrow then mnemonic = 'mkref'
    call emit(mnemonic,reg(_callbase + ordinal) || ',' || value)
    return
  argtext: method = .void
    arg ordinal = .int, text = .string
    call emit('load',reg(_callbase + ordinal) || ',' || llrxastext..quote(text as .binary))
    return
  adapter: method = .void
    arg op = .llir..opview, name = .string, resulttype = .string, types = .string, special = ''
    symbol = imported('llctarget','llctarget.' || name,resulttype,types)
    start = 0
    if special <> '' then do
      call argtext(1,special); start = 1
    end
    do i = 1 to op.inputs()
      call argcopy(start + i,input(op,i))
    end
    call invoke(result(op),symbol,words(types))
    return
  checkschema: method = .void
    arg expected = .llir..contract
    actual = dereference _schema.data(); canonical = dereference expected.data()
    i = .int; j = .int
    do i = 1 to actual.familycount()
      name = actual.familyname(i); version = 0
      do j = 1 to canonical.familycount()
        if canonical.familyname(j) = name then version = canonical.version(j)
      end
      if version = 0 | actual.version(i) <> version then do
        call fail('LOWERING: unsupported family version ' || name); return
      end
    end
    if actual.familycount() <> canonical.familycount() then do; call fail('LOWERING: incomplete Classic family contract'); return; end
    if actual.types() <> canonical.types() | actual.ops() <> canonical.ops() then do; call fail('LOWERING: incompatible Classic schema inventory'); return; end
    do i = 1 to actual.types()
      if canonical.typeindex(actual.typename(i)) = 0 then do; call fail('LOWERING: incompatible Classic type ' || actual.typename(i)); return; end
    end
    do i = 1 to actual.ops()
      call checkdescriptor(actual.opname(i),expected)
      if _error <> '' then return
    end
    return
  checkdescriptor: method = .void
    arg name = .string, expected = .llir..contract
    registry = dereference expected.data(); actual = dereference _schema.data()
    index = registry.opindex(name); source = actual.opindex(name)
    if index = 0 then do
      call fail('LOWERING: unsupported operation ' || name); return
    end
    do effect = 1 to 3
      if registry.effectvalue(index,effect) <> actual.effectvalue(source,effect) then do
        call fail('LOWERING: incompatible operation effects ' || name); return
      end
    end
    do kind = 1 to 3
      if registry.arity(index,kind) <> actual.arity(source,kind) then do
        call fail('LOWERING: incompatible operation shape ' || name); return
      end
      do field = 1 to registry.arity(index,kind)
        if registry.fieldname(index,kind,field) <> actual.fieldname(source,kind,field) | registry.typename(registry.fieldtype(index,kind,field)) <> actual.typename(actual.fieldtype(source,kind,field)) then call fail('LOWERING: incompatible operation field ' || name)
      end
    end
    return
  checkoperation: method = .void
    arg op = .llir..opview
    name = op.name(); bytes = .binary
    if name = 'core.constant' then do
      type = typename(op.result().type().id())
      if wordpos(type,'core.boolean crexx.g.int64 crexx.g.text crexx.c.value') = 0 then call fail('LOWERING: unsupported constant type ' || type)
    end
    if name = 'core.optionalargument' then call fail('LOWERING: optional Classic parameter ABI')
    if name = 'crexx.c.load' | name = 'crexx.c.store' | name = 'crexx.c.drop' then call checksymbol(op.attribute('name') as .string)
    if name = 'crexx.c.numeric.form' then do
      form = op.attribute('form') as .string
      if form <> 'scientific' & form <> 'engineering' then call fail('LOWERING: invalid NUMERIC FORM')
    end
    if name = 'crexx.c.arguments.read' then do
      bytes = op.attribute('ordinal')
      if <at..i64>(0) bytes < 1 then call fail('LOWERING: invalid ARG position')
    end
    if name = 'crexx.c.call' then do
      bytes = op.attribute('function'); boolean = .llir..boolcodec()
      if boolean.check(bytes) <> '' then call fail('LOWERING: invalid invocation kind')
      symbol = localname(op.attribute('target') as .string)
      if symbol = 'llf1' then call fail('LOWERING: call target must be a private routine')
    end
    return
  /** Source and direct IR use one generated variable-symbol authority. Keep
   * its immutable definition per selector; each name is checked in linear work
   * without a growing linear memo or a compiler-host Classic runtime import. */
  checksymbol: method = .void
    arg name = .string
    if _symbolready = 0 then do
      _symbolgrammar = llcgrammar..language()
      _symbolpolicy = .lllimits..policy()
      ok = _symbolpolicy.set('source.bytes',min(_limit,2147483647))
      ok = _symbolpolicy.set('scan.work',max(10000000,min(_limit,134217727) * 16))
      if _symbolpolicy.error() <> '' then do; call fail('LIMIT: ' || _symbolpolicy.error()); return; end
      _symbolready = 1
    end
    bytes = name as .binary
    scan = .lllanguage..request(_symbolgrammar,bytes,_symbolpolicy)
    lexstatus = scan.lex(0)
    if lexstatus = 2 | lexstatus = 3 then do; call fail('LIMIT: variable-symbol admission: ' || scan.error()); return; end
    if lexstatus <> 0 then do; call fail('LOWERING: invalid variable symbol'); return; end
    tokens = scan.tokens()
    if tokens.size() <> 1 then do; call fail('LOWERING: invalid variable symbol'); return; end
    if tokens.symbol(0) <> _symbolgrammar.tokenid('identifier') | tokens.start(0) <> 0 | tokens.finish(1) <> <blen>(bytes) then call fail('LOWERING: invalid variable symbol')
    return
  /** Direct graphs can carry host codecs not identified by their manifest.
   * Recheck every payload with the selected canonical codec, including unused
   * constants and attributes, before any fixed-width/raw interpretation. */
  checkconstants: method = .void
    store = dereference _store; canonical = dereference _canonical.data()
    do i = 1 to store.count(8)
      type = typename(store.get(8,i,1))
      if wordpos(type,'core.boolean crexx.g.int64 crexx.g.text crexx.c.value') = 0 then do
        call fail('LOWERING: unsupported constant type ' || type); return
      end
      codec = canonical.codec(canonical.typeindex(type)) as .llir..typecodec
      message = codec.check(store.bits(store.get(8,i,2)))
      if message <> '' then do; call fail('LOWERING: invalid constant bytes: ' || message); return; end
    end
    return
  /** The opaque C context is entry-bound, not a general mutable reference
   * variable. This profile invariant avoids assuming slot definite assignment
   * from structural IR verification or copying generic dataflow machinery. */
  checkcontextslots: method = .void
    store = dereference _store; ready = .int[]
    i = .int; fn = .int; opid = .int; slot = .int; producer = .int; opcode = .int
    do i = 1 to store.count(5); ready[i] = 0; end
    do fn = 1 to store.count(1)
      entry = store.get(1,fn,3); opid = store.get(2,entry,2)
      do while opid > 0
        opcode = store.get(3,opid,1)
        if opcode = 3 | opcode = 4 then do
          slot = store.get(3,opid,12)
          if typename(store.get(5,slot,2)) = 'crexx.c.context' then do
            if opcode = 3 & ready[slot] = 0 then do; call fail('LOWERING: unbound context slot'); return; end
            if opcode = 4 then do
              if ready[slot] then do; call fail('LOWERING: context slot must be bound once at function entry'); return; end
              producer = store.get(4,store.operand(opid,1),1)
              source = store.get(3,producer,1); proven = 0
              if source = 2 & store.get(3,producer,12) = 1 then proven = 1
              if source = 3 then proven = ready[store.get(3,producer,12)]
              if proven = 0 then do; call fail('LOWERING: unsupported context slot binding'); return; end
              ready[slot] = 1
            end
          end
        end
        opid = store.get(3,opid,3)
      end
    end
    do opid = 1 to store.count(3)
      opcode = store.get(3,opid,1)
      if opcode <> 3 & opcode <> 4 then iterate
      slot = store.get(3,opid,12)
      if typename(store.get(5,slot,2)) <> 'crexx.c.context' then iterate
      if opcode = 3 & ready[slot] = 0 then do; call fail('LOWERING: unbound context slot'); return; end
      block = store.get(3,opid,2); fn = store.get(2,block,1)
      if opcode = 4 & block <> store.get(1,fn,3) then do; call fail('LOWERING: context slot must be bound once at function entry'); return; end
    end
    return
  checkfunctions: method = .void
    f = .int
    store = dereference _store
    if store.count(1) = 0 then do; call fail('LOWERING: missing main function'); return; end
    if store.text(store.get(1,1,1)) <> '$MAIN' then call fail('LOWERING: first Classic function must be $MAIN')
    do f = 1 to store.count(1)
      if store.get(1,f,6) > 0 then do
        identity = store.text(store.get(1,f,6)); split = pos('.',identity)
        if split < 2 | split = length(identity) | pos('.',identity,split + 1) > 0 then call fail('LOWERING: invalid export identity')
        else if verify(identity,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.') <> 0 then call fail('LOWERING: invalid export identity')
        else if verify(left(identity,1) || substr(identity,split + 1,1),'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_') <> 0 then call fail('LOWERING: invalid export identity')
      end
    end
    do f = 1 to store.count(1)
      resulttype = typename(store.get(1,f,2)); count = store.get(1,f,5); first = store.get(1,f,4)
      do
        if resulttype <> 'crexx.c.result' | count <> 1 then call fail('LOWERING: Classic function ABI')
        else if typename(store.get(12,first,2)) <> 'crexx.c.context' | store.get(12,first,3) then call fail('LOWERING: Classic parameter ABI')
      end
    end
    return
  /** Read one checked binding without copying the bundle or its owners. */
  binding: method = .void
    arg context = .string, name = .string, destination = .string
    type = '.rexxactivation..rexxactivationarguments'
    if name = 'pool' then type = '.rexxpool..rexxvariablepool'
    if name = 'config' then type = '.rexxclassicconfig..rexxclassicconfig'
    receiver = reg(_workbase)
    call emit('linkref',receiver || ',' || context)
    symbol = member('rexxclassiccontext.rexxclassiccontext',name,'reference ' || type)
    call invoke(destination,symbol,1,receiver)
    call emit('unlink',receiver)
    return
  /** One authored DROP item uses the live pool. The indirect value/text
   * temporaries occupy otherwise idle child-owner work slots, never IR values.
   * Capture and convert its list once before the existing ordered executor. */
  dropoperation: method = .void
    arg op = .llir..opview
    symbol = .string
    pool = reg(_workbase + 2); receiver = reg(_workbase + 1)
    call binding(input(op),'pool',pool)
    call emit('linkref',receiver || ',' || pool)
    bytes = op.attribute('indirect')
    if <at..u8>(0) bytes = 0 then do
      symbol = member('rexxpool.rexxvariablepool','dropsymbol','.void','.string')
      call argtext(2,op.attribute('name') as .string)
      call invoke('',symbol,2,receiver)
    end
    else do
      value = reg(_workbase + 8); text = reg(_workbase + 9)
      symbol = member('rexxpool.rexxvariablepool','symbolvalue','.rexxvalue..rexxvalue','.string')
      call argtext(2,op.attribute('name') as .string)
      call invoke(value,symbol,2,receiver)
      valuereceiver = reg(_workbase)
      call emit('link',valuereceiver || ',' || value)
      symbol = member('rexxvalue.rexxvalue','asstring','.string','.int','1')
      call emit('load',reg(_callbase + 2) || ',0')
      call invoke(text,symbol,2,valuereceiver)
      call emit('unlink',valuereceiver); call emit('null',value)
      config = reg(_workbase + 3); call binding(input(op),'config',config)
      symbol = member('rexxpool.rexxvariablepool','dropindirectlist','.void','.string reference@.rexxclassicconfig..rexxclassicconfig')
      call argcopy(2,text); call argcopy(3,config)
      call invoke('',symbol,3,receiver)
      call emit('null',text); call emit('null',config)
    end
    call emit('unlink',receiver); call emit('null',pool)
    return
  /** Values are validated integers, never reparsed text. Keep every install
   * in the executing C frame, after normal return from a successful setter. */
  installnumeric: method = .void
    arg context = .string
    activation = reg(_workbase + 4); receiver = reg(_workbase + 1)
    call binding(context,'activation',activation)
    call emit('linkref',receiver || ',' || activation)
    do i = 1 to 3
      symbol = member('rexxactivation.rexxactivationarguments',word('numericdigits numericfuzz numericform',i),'.int')
      call invoke(reg(_workbase + 4 + i),symbol,1,receiver)
    end
    call emit('unlink',receiver); call emit('null',activation)
    call emit('setnumfuz','0')
    call emit('setnumdgts',reg(_workbase + 5))
    call emit('setnumfuz',reg(_workbase + 6))
    call emit('setnumfrm',reg(_workbase + 7))
    return
  newbundle: method = .void
    arg destination = .string, activation = .string, pool = .string, config = .string
    symbol = member('rexxclassiccontext.rexxclassiccontext','§factory','.rexxclassiccontext..rexxclassiccontext','reference@.rexxactivation..rexxactivationarguments reference@.rexxpool..rexxvariablepool reference@.rexxclassicconfig..rexxclassicconfig')
    call argcopy(1,activation,1); call argcopy(2,pool,1); call argcopy(3,config)
    call invoke(destination,symbol,3)
    return
  rootentry: method = .void
    activation = reg(_workbase + 8); pool = reg(_workbase + 9); bundle = reg(_workbase + 10)
    config = reg(_workbase + 7); configref = reg(_workbase + 3)
    symbol = imported('llctarget','llctarget.mainargs','.rexxactivation..rexxactivationarguments','.object')
    call argcopy(1,'a1'); call invoke(activation,symbol,1)
    symbol = imported('llctarget','llctarget.poolnew','.rexxpool..rexxvariablepool','')
    call invoke(pool,symbol,0)
    symbol = member('rexxclassicconfig.rexxclassicconfig','§factory','.rexxclassicconfig..rexxclassicconfig','.string','1')
    call argtext(1,'UTF8'); call invoke(config,symbol,1)
    call emit('mkref',configref || ',' || config)
    call newbundle(bundle,activation,pool,configref)
    call argcopy(1,bundle,1); call invoke('r0','llf1',1)
    symbol = imported('llctarget','llctarget.status','.int','.rexxactivation..rexxactivationarguments')
    call argcopy(1,'r0'); call invoke('r0',symbol,1)
    call emit('null',bundle); call emit('null',configref)
    call emit('null',activation); call emit('null',pool); call emit('null',config)
    call emit('ret','r0')
    return
  /** All child construction precedes borrowing. These hidden locals belong
   * to the caller until the synchronous child invocation returns/unwinds. */
  privatecall: method = .void
    arg op = .llir..opview
    activation = reg(_workbase + 8); pool = reg(_workbase + 9); bundle = reg(_workbase + 10)
    parentactivation = reg(_workbase + 4); parentpool = reg(_workbase + 2); config = reg(_workbase + 3)
    receiver = reg(_workbase + 1); context = input(op,2)
    call emit('copy',activation || ',' || input(op))
    call binding(context,'activation',parentactivation)
    call emit('link',receiver || ',' || activation)
    symbol = member('rexxactivation.rexxactivationarguments','inheritsignalpolicy','.void','reference@.rexxactivation..rexxactivationarguments')
    call argcopy(2,parentactivation); call invoke('',symbol,2,receiver)
    bytes = op.attribute('function'); kind = 'begininternalcall'
    if <at..u8>(0) bytes then kind = 'begininternalfunction'
    symbol = member('rexxactivation.rexxactivationarguments',kind,'.void')
    call invoke('',symbol,1,receiver)
    symbol = member('rexxactivation.rexxactivationarguments','enterprocedure','.void')
    call invoke('',symbol,1,receiver); call emit('unlink',receiver)
    call binding(context,'pool',parentpool); call binding(context,'config',config)
    symbol = imported('llctarget','llctarget.poolnew','.rexxpool..rexxvariablepool','')
    call invoke(pool,symbol,0)
    call emit('link',receiver || ',' || pool)
    symbol = member('rexxpool.rexxvariablepool','inheritcommandstatus','.void','reference@.rexxpool..rexxvariablepool')
    call argcopy(2,parentpool); call invoke('',symbol,2,receiver); call emit('unlink',receiver)
    call newbundle(bundle,activation,pool,config)
    symbol = localname(op.attribute('target') as .string)
    call argcopy(1,bundle,1); call invoke(result(op),symbol,1)
    call emit('null',bundle)
    call emit('null',parentactivation); call emit('null',parentpool); call emit('null',config)
    call emit('null',activation); call emit('null',pool)
    return
  run: method = .void
    if _ready then return
    _ready = 1; _phase = 'admission'
    i = .int
    do
      if _graph.error() <> '' then do; _error = _graph.error(); return; end

      if _limit < 1 | _reglimit < 16 | _reglimit > 2147483647 then do; call fail('LIMIT: invalid output or register budget'); return; end
      _store = _graph.storage(); store = dereference _store; contract = dereference store.contract(); _schema = contract
      canonical = .llir..schema(); call llcir..registerfamilies(reference canonical); expected = canonical.finish()
      _canonical = expected
      call checkschema(expected)
      if _error <> '' then return
      call checkfunctions()
      if _error <> '' then return
      call checkconstants()
      if _error <> '' then return
      call checkcontextslots()
      if _error <> '' then return
      do i = 1 to store.count(3)
        op = _graph.operation(i); _origin = op.origin().id(); _offset = op.origin().first()
        call checkoperation(op)
        if _error <> '' then return
      end
      _phase = 'entry'; _writer = .llir..writer(_limit)
      call _writer.line('.globals=0')
      _origin = 0; _sizing = 0; _scratch = -1; _location = -1; _recordbytes = 0
      _locals = 16; _workbase = 1; _callbase = 12; _scratch = 0
      if store.text(store.get(1,1,1)) = '$MAIN' then do
      call emit('main()','.locals=' || _locals)
      call clearsource()
      call rootentry()
      _phase = 'entry flush'; call flush()
      end
      do f = 1 to store.count(1)
        _phase = 'function ' || f; _fn = f; call procedurebody()
        if _error <> '' then return
      end
      do i = 1 to _names[0]
        signature = _signatures[i] as .llcompilercontracts..signature
        call _writer.line(_names[i] || '() .expose=' || _names[i])
        args = ''
        do j = 1 to signature.arguments()
          if j > 1 then args = args || ','
          if signature.optional(j) then args = args || '?'
          args = args || signature.paramname(j) || '=' || signature.type(j)
        end
        call _writer.line('  .meta ' || llrxastext..quote(_names[i] as .binary) || '=' || llrxastext..quote(signature.flags_text() as .binary) || ' ' || llrxastext..quote(signature.result() as .binary) || ' ' || _names[i] || '() ' || llrxastext..quote(args as .binary))
      end
      _output = _writer.finish()
      if _output.error() <> '' then _error = _output.error()
    on signal as problem
      if _error = '' then call fail('BACKEND: ' || _phase || ': ' || problem.name() || ' at backend line ' || problem.line() || ': ' || problem.message())
    end
    return
  flush: method = .void
    section = _writer.section()
    do i = 1 to _records[0]
      record = _records[i] as .llrxastext..instruction
      call section.line(record.text(),record.origin())
    end
    part = section.finish(); call _writer.append(reference part)
    empty = .object[]; _records = empty; _recordbytes = 0
    if _writer.error() <> '' then _error = _writer.error()
    return
  procedurebody: method = .void
    i = .int; b = .int; id = .int; op = .llir..opview
    store = dereference _store; blocks = .int[]
    _phase = 'slot allocation'; next = 1
    do i = 1 to store.count(5)
      if store.get(5,i,1) = _fn then do
        _slots[i] = next; next = next + 1
      end
    end
    _phase = 'value allocation'
    do b = 1 to store.count(2)
      if store.get(2,b,1) <> _fn then iterate
      blocks[blocks[0] + 1] = b
      id = store.get(2,b,2)
      do while id > 0
        op = _graph.operation(id)
        do r = 1 to op.results()
          _registers[op.result(r).id()] = next; next = next + 1
        end
        id = store.get(3,id,3)
      end
    end
    /* Use the same selector for planning and emission. Hidden helper calls
     * therefore participate without a second arity table to maintain. */
    _phase = 'frame planning'; _workbase = next; next = next + 11
    _scratch = next; _location = next + 1; _callbase = next + 2
    _maxargs = -1; _needsscratch = 0; _sizing = 1; _fallthrough = 0
    do; _maxargs = 2; _needsscratch = 1; end
    call installnumeric('a1')
    do i = 1 to blocks[0] while _error = ''
      id = store.get(2,blocks[i],2)
      do while id > 0 & _error = ''
        op = _graph.operation(id); _origin = op.origin().id(); _offset = op.origin().first()
        call selectop(op)
        id = store.get(3,id,3)
      end
    end
    _sizing = 0
    if _error <> '' then return
    _phase = 'frame limits'; _scratch = -1; _location = -1; _callbase = -1
    if _needsscratch then do; _scratch = next; next = next + 1; end
    do; _location = next; next = next + 1; end
    if _maxargs >= 0 then do; _callbase = next; next = next + _maxargs + 1; end
    _locals = next
    if _locals > _reglimit then do; call fail('LIMIT: function exceeds register budget'); return; end
    _origin = 0
    declaration = '.locals=' || _locals
    if store.get(1,_fn,6) > 0 then declaration = declaration || ' .expose=' || store.text(store.get(1,_fn,6))
    call emit('llf' || _fn || '()',declaration)
    call clearsource()
    _routine = store.text(store.get(1,_fn,1))
    _phase = 'signature'; first = store.get(1,_fn,4)
    args = 'context=' || targettype(store.get(12,first,2))
    _phase = 'metadata'; name = 'llprogram.' || store.text(store.get(1,_fn,1))
    if store.get(1,_fn,6) > 0 then name = store.text(store.get(1,_fn,6))
    call emit('.meta',llrxastext..quote(name as .binary) || '="b" ' || llrxastext..quote(targettype(store.get(1,_fn,2)) as .binary) || ' llf' || _fn || '() ' || llrxastext..quote(args as .binary))
    do
      filename = ''
      firstop = store.get(2,store.get(1,_fn,3),2)
      if firstop > 0 then filename = llcompilercontracts..sourcename(_graph.operation(firstop).origin().filename()) || ': '
      call emit('load',reg(_location) || ',' || llrxastext..quote((filename || 'entering ' || _routine) as .binary))
      do i = 1 to 4
        call emit('sigbrv','llerror' || _fn || '_' || i || ',r0,' || llrxastext..quote(word('CLASSIC_SYNTAX DIVISION_BY_ZERO CONVERSION_ERROR INVALID_ARGUMENTS',i) as .binary))
      end
    end
    call emit('numsci','18,1,2')
    call installnumeric('a1')
    if store.get(1,_fn,3) <> blocks[1] then call emit('br','llb' || store.get(1,_fn,3))
    do blockindex = 1 to blocks[0]
      b = blocks[blockindex]; _fallthrough = 0
      if blockindex < blocks[0] then _fallthrough = blocks[blockindex + 1]
      _origin = 0; call emit('llb' || b || ':')
      /* Predecessors can carry different dynamic location state. */
      _lastsource = ''; _lastlocation = ''
      id = store.get(2,b,2)
      do while id > 0 & _error = ''
        op = _graph.operation(id); _origin = op.origin().id(); _offset = op.origin().first()
        call source(op.origin())
        call selectop(op)
        id = store.get(3,id,3)
      end
    end
    do
      _origin = 0
      do i = 1 to 4
        call emit('llerror' || _fn || '_' || i || ':')
        if i = 1 then call clearsource()
        call emit('load',reg(_scratch) || ',' || i)
        if i < 4 then call emit('br','llerror' || _fn)
      end
      call emit('llerror' || _fn || ':')
      do i = 1 to 4
        call emit('sighalt',llrxastext..quote(word('CLASSIC_SYNTAX DIVISION_BY_ZERO CONVERSION_ERROR INVALID_ARGUMENTS',i) as .binary))
      end
      symbol = imported('llctarget','llctarget.failuremessage','.string','.object .string')
      call argcopy(1,'r0'); call argcopy(2,reg(_location)); call invoke(reg(_location),symbol,2)
      do i = 1 to 3
        call emit('beq','llraise' || _fn || '_' || i || ',' || reg(_scratch) || ',' || i)
      end
      do i = 4 to 1 by -1
        call emit('llraise' || _fn || '_' || i || ':')
        call emit('signalorigin',llrxastext..quote(word('CLASSIC_SYNTAX DIVISION_BY_ZERO CONVERSION_ERROR INVALID_ARGUMENTS',i) as .binary) || ',' || reg(_location) || ',r0')
        call emit('ret')
      end
    end
    call flush()
    return
  /** Explicit no-source anchor prevents generated entries/handlers inheriting
   * the last authored record of a preceding routine. */
  clearsource: method = .void
    call emit('.srcstep','0 0 6 "" 0 0 0 ""')
    _lastsource = ''; _lastlocation = ''
    return
  source: method = .void
    arg origin = .llir..origin
    key = .string; location = .string
    if origin.id() = 0 then do; call clearsource(); return; end
    kind = origin.kind()
    if kind = 'synthetic' then do
      key = '6 "" 0 0 0 ""'; location = 'generated code in ' || _routine
      call sourcerecord(key,location)
      return
    end
    store = dereference _store; sourceid = store.get(9,origin.id(),1)
    positions = .llsource..index
    if sourceid <= _sourceindexes[0] then do
      if _sourceindexes[sourceid] is .llsource..index then positions = _sourceindexes[sourceid] as .llsource..index
    end
    bytes = origin.sourcebytes()
    if initialized(positions) = 0 then do
      positions = .llsource..index(bytes)
      _sourceindexes[sourceid] = positions as .object
    end
    at = positions.position(origin.first())
    if at.error() <> '' then do; call fail('SOURCE: ' || at.error()); return; end
    line = at.line(); column = at.column(); first = at.first(); last = at.last()
    finish = min(last,origin.last()); ending = positions.position(finish)
    if ending.error() <> '' then do; call fail('SOURCE: ' || ending.error()); return; end
    endcolumn = ending.column()
    flags = 17
    if kind = 'derived' then flags = 34
    else if kind = 'composite' then flags = 65
    if origin.last() > last then do
      if flags = 17 then flags = 65
      else if flags = 34 then flags = 98
    end
    filename = llcompilercontracts..sourcename(origin.filename())
    location = filename || ':' || line || ':' || column
    if kind <> 'exact' then location = filename || ': generated code in ' || _routine
    key = flags || ' ' || llrxastext..quote(filename as .binary) || ' ' || line || ' ' || column || ' ' || endcolumn || ' ' || llrxastext..quote(binsubstr(bytes,first + 1,last - first))
    call sourcerecord(key,location)
    return
  /** A source anchor and diagnostic context are independent state. Equal line
   * numbers alone are insufficient: range, flags and text also identify it. */
  sourcerecord: method = .void
    arg key = .string, location = .string
    if key <> _lastsource then do
      call emit('.srcstep',_origin || ' 0 ' || key)
      _lastsource = key
    end
    if location <> _lastlocation then do
      call emit('load',reg(_location) || ',' || llrxastext..quote(location as .binary))
      _lastlocation = location
    end
    return
  selectop: method = .void
    arg op = .llir..opview
    store = dereference _store; name = op.name(); dest = result(op); id = op.id()
    select
      when name = 'core.constant' then do
        value = op.result(); type = typename(value.type().id()); bytes = value.bytes()
        if type = 'crexx.c.value' then do
          call argtext(1,bytes as .string)
          symbol = imported('llctarget','llctarget.literal','.rexxvalue..rexxvalue','.string')
          call invoke(dest,symbol,1)
        end
        else do
          schema = dereference _canonical.data(); typeid = schema.typeindex(type)
          if typeid = 0 then do; call fail('LOWERING: unsupported constant type ' || type); return; end
          codec = schema.codec(typeid) as .llir..typecodec
          problem = codec.check(bytes)
          if problem <> '' then do; call fail('LOWERING: invalid constant bytes: ' || problem); return; end
          literal = codec.format(bytes)
          if type = 'core.boolean' then literal = (literal = 'true') as .string
          if type = 'crexx.g.text' then literal = llrxastext..quote(bytes)

          call emit('load',dest || ',' || literal)
        end
      end
      when name = 'core.argument' then call emit('copy',dest || ',a' || store.get(3,id,12))
      when name = 'core.hasarg' then do
        call emit('getandtp',dest || ',a' || store.get(3,id,12) || ',256')
      end
      when name = 'core.load' then do
        slot = store.get(3,id,12)
        call emit('copy',dest || ',' || reg(_slots[slot]))
      end
      when name = 'core.store' then do
        slot = store.get(3,id,12); dest = reg(_slots[slot])
        call emit('copy',dest || ',' || input(op))
      end
      when name = 'core.jump' then do
        if op.successor(1) <> _fallthrough then call emit('br','llb' || op.successor(1))
      end
      when name = 'core.branch' then do
        call emit('brt','llb' || op.successor(1) || ',' || input(op))
        if op.successor(2) <> _fallthrough then call emit('br','llb' || op.successor(2))
      end
      when name = 'core.return' then do
        if op.inputs() then call emit('ret',input(op))
        else call emit('ret')
      end
      otherwise do
        if left(name,8) = 'crexx.c.' then call classic(op,substr(name,9))
        else call fail('LOWERING: unsupported operation ' || name)
      end
    end
    return
  classic: method = .void
    arg op = .llir..opview, name = .string
    v = '.rexxvalue..rexxvalue'; a = '.rexxactivation..rexxactivationarguments'; p = '.rexxpool..rexxvariablepool'
    contexttype = 'reference@.rexxclassiccontext..rexxclassiccontext'
    if wordpos(name,'add sub mul div eq ne lt le gt ge strict concat blank abut and or xor') then do
      call adapter(op,'binaryop',v,'.string ' || v || ' ' || v || ' ' || contexttype,name); return
    end
    if wordpos(name,'positive negative not') then do
      call adapter(op,'unaryop',v,'.string ' || v || ' ' || contexttype,name); return
    end
    select
      when name = 'truth' then call adapter(op,'truth','.int',v || ' ' || contexttype)
      when name = 'drop' then call dropoperation(op)
      when name = 'say' then call adapter(op,'sayvalue','.void',v)
      when name = 'arguments.empty' then call adapter(op,'arguments',a,'')
      when name = 'arguments.append' then call adapter(op,'append',a,a || ' ' || v || ' .int')
      when name = 'arguments.count' then call adapter(op,'countargs',v,contexttype)
      when name = 'arguments.exists' then call adapter(op,'existsarg',v,contexttype || ' ' || v || ' ' || v)
      when name = 'digits' then call adapter(op,'digits',v,contexttype)
      when name = 'return.present' then call adapter(op,'present',a,v)
      when name = 'return.absent' then call adapter(op,'absent',a,'')
      when name = 'requirevalue' then call adapter(op,'requirevalue',v,a)
      when name = 'setresult' then do
        poolref = reg(_workbase + 2); call binding(input(op),'pool',poolref)
        symbol = imported('llctarget','llctarget.setresult','.void','reference@' || p || ' ' || a)
        call argcopy(1,poolref); call argcopy(2,input(op,2)); call invoke('',symbol,2)
        call emit('null',poolref)
      end
      when name = 'length' then call adapter(op,'lengthvalue',v,v || ' ' || contexttype)
      when name = 'load' | name = 'store' then do
        symbol = 'poolread'; resulttype = v; types = 'reference@' || p || ' .string'; ordinal = 2
        if name = 'store' then do; symbol = 'poolwrite'; resulttype = '.void'; types = 'reference@' || p || ' ' || v || ' .string'; ordinal = 3; end
        symbol = imported('llctarget','llctarget.' || symbol,resulttype,types)
        poolref = reg(_workbase + 2); call binding(input(op),'pool',poolref)
        call argcopy(1,poolref)
        if name = 'store' then call argcopy(2,input(op,2))
        call argtext(ordinal,op.attribute('name') as .string)
        call invoke(result(op),symbol,ordinal)
        call emit('null',poolref)
      end
      when name = 'arguments.read' then do
        bytes = op.attribute('ordinal'); ordinal = <at..i64>(0) bytes
        if ordinal < 1 then do; call fail('LOWERING: invalid ARG position'); return; end
        symbol = imported('llctarget','llctarget.readarg',v,contexttype || ' .int')
        call argcopy(1,input(op)); call emit('load',reg(_callbase + 2) || ',' || ordinal)
        call invoke(result(op),symbol,2)
      end
      when name = 'numeric.digits' | name = 'numeric.fuzz' | name = 'numeric.form' then do
        setting = substr(name,9)
        if setting = 'form' then do
          symbol = imported('llctarget','llctarget.literal',v,'.string')
          call argtext(1,op.attribute('form') as .string); call invoke(reg(_scratch),symbol,1)
          call argcopy(2,input(op)); call argcopy(3,reg(_scratch))
        end
        else do; call argcopy(2,input(op,2)); call argcopy(3,input(op)); end
        call argtext(1,setting)
        symbol = imported('llctarget','llctarget.setting','.void','.string ' || contexttype || ' ' || v)
        call invoke('',symbol,3)
        context = input(op); if setting <> 'form' then context = input(op,2)
        call installnumeric(context)
      end
      when name = 'call' then call privatecall(op)
      when name = 'exit' then do
        symbol = imported('llctarget','llctarget.present',a,v)
        call argcopy(1,input(op)); call invoke(reg(_scratch),symbol,1)
        symbol = imported('llctarget','llctarget.status','.int',a)
        call argcopy(1,reg(_scratch)); call invoke(reg(_scratch),symbol,1)
        call emit('exit',reg(_scratch))
      end
      otherwise call fail('LOWERING: unsupported Classic operation ' || name)
    end
    return
