  /** Explicit no-source anchor prevents generated entries/handlers inheriting
   * the last authored record of a preceding routine. */
  clearsource: method = .void
    call emit('.srcstep','0 0 6 "" 0 0 0 ""')
    _lastsource = ''; _lastlocation = ''
    return
  /** Reuse the existing request-local index for admission and source emission. */
  sourceindex: method = reference .llsource..index
    arg origin = .llir..origin
    phase = _phase; _phase = 'source index lookup'
    store = dereference _store; sourceid = store.get(9,origin.id(),1)
    invalid = reference .llsource..index
    if sourceid < 1 then do; call fail('SOURCE: origin has no source record'); return invalid; end
    if sourceid <= _sourceindexes[0] then do
      if initialized(_sourceindexes[sourceid]) then do
        _phase = phase; return reference _sourceindexes[sourceid]
      end
    end
    _phase = 'source UTF8 validation'
    bytes = origin.sourcebytes(); extent = <blen>(bytes)
    /* One cached source and one index own their payloads. Reserve a
     * conservative line-per-byte index plus both retained byte payloads. */
    if extent > (_limit - _sourceworkspace - 32) <idiv> 18 then do
      call fail('LIMIT: source index workspace exceeded'); return invalid
    end
    _sourceworkspace = _sourceworkspace + extent * 18 + 32
    codec = .llscalar..textcodec(); message = codec.check(bytes)
    if message <> '' then do; call fail('SOURCE: ' || message); return invalid; end
    _phase = 'source index construction'
    positions = .llsource..index(bytes)
    if positions.error() <> '' then do; call fail('LIMIT: ' || positions.error()); return invalid; end
    assembler move _sourceindexes[sourceid],positions
    assembler null positions
    assembler move _sourcebytes[sourceid],bytes
    assembler null bytes
    _phase = phase
    return reference _sourceindexes[sourceid]
  source: method = .void
    arg origin = .llir..origin, clause = 0, diagnostic = 0
    key = .string; location = .string
    if origin.id() = 0 then do; call clearsource(); return; end
    kind = origin.kind()
    if kind = 'synthetic' then do
      key = '6 "" 0 0 0 ""'; location = 'generated code in ' || _routine
      if diagnostic > 0 then location = diagnosticlocation(_graph.operation(diagnostic).origin())
      call sourcerecord(key,location,clause)
      return
    end
    positions_ref = sourceindex(origin)
