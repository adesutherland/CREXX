    call argtext(2,op.attribute('resource') as .string); call invoke(value,symbol,2,reg(_workbase + 1))
    call emit('unlink',reg(_workbase + 1))
    call addresstext(value); call emit('null',value)
    return
  addressoperation: method = .void
    arg op = .llir..opview, name = .string
    symbol = .string; opid = .int; owner = .int; ownerregister = .int
    ownerclass = 'rexxclassicaddress.rexxclassicaddresscommand'
    receiver = reg(_workbase + 1); activation = reg(_workbase + 4); pool = reg(_workbase + 2); text = reg(_workbase + 9)
    storage = .string; context = input(op)
    if name = 'command.new' | name = 'command.active' | name = 'address.select' then context = input(op,2)
    if left(name,8) = 'command.' then do
      opid = op.id(); owner = _commandprotocol.owner(opid)
      ownerregister = _commandowners[owner]; storage = reg(ownerregister)
    end
    select
      when name = 'address.swap' | name = 'address.select' then do
        if name = 'address.select' then call addresstext(input(op))
        call binding(context,'activation',activation); call emit('linkref',receiver || ',' || activation)
        count = 1
        if name = 'address.select' then do
          symbol = member('rexxactivation.rexxactivationarguments','setaddressenvironment','.void','.string'); count = 2
          call argcopy(2,text)
        end
        else symbol = member('rexxactivation.rexxactivationarguments','swapaddressenvironment','.void')
        call invoke('',symbol,count,receiver); call emit('unlink',receiver); call emit('null',activation)
        if name = 'address.select' then call emit('null',text)
      end
      when name = 'command.new' | name = 'command.active' then do
        call addresstext(input(op)); call binding(context,'pool',pool); call binding(context,'activation',activation)
        if name = 'command.active' then do
          call emit('linkref',receiver || ',' || activation)
          symbol = member('rexxactivation.rexxactivationarguments','addressenvironment','.string')
          call invoke(reg(_workbase + 8),symbol,1,receiver); call emit('unlink',receiver)
        end
        symbol = member(ownerclass,'§factory','.rexxclassicaddress..rexxclassicaddresscommand','reference@.rexxpool..rexxvariablepool reference@.rexxactivation..rexxactivationarguments .string .string')
        call argcopy(1,pool); call argcopy(2,activation)
        if name = 'command.active' then call argcopy(3,reg(_workbase + 8))
        else call argtext(3,op.attribute('environment') as .string)
        call argcopy(4,text); call invoke(storage,symbol,4)
        if name = 'command.active' then do
          call emit('link',receiver || ',' || storage)
          symbol = member(ownerclass,'useactiveconnections','.void')
          call invoke('',symbol,1,receiver); call emit('unlink',receiver); call emit('null',reg(_workbase + 8))
        end
        call emit('null',pool); call emit('null',activation); call emit('null',text)
      end
      when name = 'address.connection' | name = 'command.connection' then do
        call addressresource(op)
        if name = 'address.connection' then do
          call binding(context,'activation',activation); call emit('linkref',receiver || ',' || activation)
          symbol = member('rexxactivation.rexxactivationarguments','setaddressconnection','.void','.string .string .string .string')
        end
        else do
          call emit('link',receiver || ',' || storage)
          symbol = member(ownerclass,'withconnection','.void','.string .string .string .string')
        end
        call argtext(2,op.attribute('option') as .string); call argtext(3,op.attribute('position') as .string)
        call argtext(4,op.attribute('kind') as .string); call argcopy(5,text); call invoke('',symbol,5,receiver)
        call emit('unlink',receiver); call emit('null',text)
        if name = 'address.connection' then call emit('null',activation)
      end
      when name = 'command.binding' then do
        call emit('link',receiver || ',' || storage)
        symbol = member(ownerclass,'withbinding','.void','.string .string')
        call argtext(2,op.attribute('kind') as .string); call argtext(3,op.attribute('name') as .string); call invoke('',symbol,3,receiver)
        call emit('unlink',receiver)
      end
      when name = 'command.run' then do
        call emit('link',receiver || ',' || storage)
        symbol = member(ownerclass,'run','._rxsysb..addressresponse'); call invoke('',symbol,1,receiver); call emit('null',reg(_scratch))
        detail = reg(_workbase + 8); condition = reg(_workbase + 5); description = reg(_workbase + 6)
        symbol = member(ownerclass,'syntaxerror','.string'); call invoke(detail,symbol,1,receiver)
        symbol = member(ownerclass,'conditionid','.int'); call invoke(condition,symbol,1,receiver)
        symbol = member(ownerclass,'conditiondescription','.string'); call invoke(description,symbol,1,receiver)
        call emit('unlink',receiver); call emit('null',storage)
        prefix = 'llcommand' || _fn || '_' || op.id()
        call emit('strlen',reg(_workbase + 7) || ',' || detail)
        call emit('beq',prefix || '_ready,' || reg(_workbase + 7) || ',0')
        call emit('signal','"CLASSIC_SYNTAX",' || detail); call emit('ret')
        call emit(prefix || '_ready:'); call emit('null',detail)
        call conditiontransition(context,prefix,_parselines[op.id()])
      end
      otherwise call fail('LOWERING: unsupported command operation')
    end
    return
  /** Shared producer route; adapter fields are owned before any transfer. */
  conditiontransition: method = .void
    arg context = .string, prefix = .string, line = .int
    receiver = reg(_workbase + 1); activation = reg(_workbase + 4); condition = reg(_workbase + 5)
    description = reg(_workbase + 6); flag = reg(_workbase + 7); event = reg(_workbase + 9)
