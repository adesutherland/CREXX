      call emit('null',reg(ownerregister))
    end
    do i = 1 to _signalcleanup[0]
      nameid = _signalcleanup[i]; call emit('null',reg(_registers[nameid]))
    end
    return
  exitcleanup: method = .void
    arg fatal = 0, program = 0
