      call op.input('selected',_block.load(selected,origin)); call op.attribute('key','SIGNAL' as .binary)
      call op.attribute('handler',integer.parse(i as .string)); built = op.finish()
      yes = newblock('signal.handler'); no = newblock('signal.handler.next')
