    return _block.constant(type(name),'0',origin)
  /** Classify only; the selected expression path still owns every visit and
   * literal check. Fallback expression lowering is never visited twice. */
  simpleliteral: method = .int
    arg node = .llast..node
    do forever
      kind = node.kind()
      if kind = 'Group' then node = node.child('value')
      else if kind = 'Chain' then do
        if node.count('operators') <> 0 | node.count('operands') <> 1 then return 0
        node = node.child('operands',1)
      end
      else return kind = 'String' | kind = 'Number' | kind = 'Constant'
    end
  /** Classify suppression before choosing the original head token span. */
  warninghead: method = .llast..node
    arg node = .llast..node
    do forever
      if warningwork(1) = 0 then return node
      kind = node.kind()
      if kind = 'Group' then node = node.child('value')
      else if kind = 'Chain' then do
        if node.count('operators') = 0 then node = node.child('operands',1)
        else do
          operator = node.child('operators',1).kind()
          if wordpos(operator,'concat blank abut') = 0 then return node
          node = node.child('operands',1)
