  signalstatement: method = .void
    arg node = .llast..node
    _signalbuilding = 1
    origin = at(node); name = .string; found = .string; row = .int; labelid = .int
    labelnode = .llast..node; destination = .llir..block; yes = .llir..block; no = .llir..block
    target = .llast..node; value = .llir..valuehandle; named = .llir..valuehandle
