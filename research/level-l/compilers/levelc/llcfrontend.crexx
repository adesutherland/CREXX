      end
      if kind = 'ARG' then value = parsesource(kind,ordinal,origin)
      else if ordinal > 1 then value = defaultvalue('value',at(template))
      op = _block.operation(_contract.operation('crexx.c.parse.execute'),origin)
      call op.input('context',_block.load(_contextslot,origin)); call op.input('source',value)
      call op.attribute('program',bytes); built = op.finish()
    end
    return
  parsesource: method = .llir..valuehandle
    arg kind = .string, ordinal = .int, origin = .llir..origin
    op = _block.operation(_contract.operation('crexx.c.parse.source'),origin)
    call op.input('context',_block.load(_contextslot,origin)); call op.attribute('kind',kind as .binary)
    codec = .llir..intcodec(); call op.attribute('ordinal',codec.parse(ordinal as .string))
    built = op.finish(); return built.result()
  /** Source positions are unsigned decimal integer tokens. Conversion is
   * checked before multiplication, independently of the active DIGITS. */
  parseposition: method = .int
    arg node = .llast..node
    spelling = node.text('spelling'); value = 0
    if spelling = '' | verify(spelling,'0123456789') <> 0 then do
      call fail(node,'SYNTAX: RXC-LC-38.1: invalid PARSE template at ' || spelling); return 0
    end
    do i = 1 to length(spelling)
      digit = pos(substr(spelling,i,1),'0123456789') - 1
      if value > 922337203685477580 | (value = 922337203685477580 & digit > 7) then do
        call fail(node,'LIMIT: PARSE position exceeds signed descriptor range: ' || spelling); return 0
      end
      value = value * 10 + digit
    end
    return value
