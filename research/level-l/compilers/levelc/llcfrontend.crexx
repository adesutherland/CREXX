      if wordpos(kind,'DoCount DoForever DoControl') = 0 then do; call fail(repetition,'PROFILE: invalid DO repetition'); return; end
      if kind = 'DoControl' then do
        named = repetition.child('name'); if tick(named) = 0 then return
        name = named.text('spelling')
        do i = 1 to repetition.count('modifiers')
          modifier = repetition.child('modifiers',i); if tick(modifier) = 0 then return
          part = lower(modifier.text('keyword'))
          if wordpos(part,'to by for') = 0 then do; call fail(modifier,'SYNTAX: invalid DO modifier'); return; end
          if wordpos(part,seen) > 0 then do; call fail(modifier,'SYNTAX: RXC-LC-27.1: duplicate DO ' || upper(part)); return; end
          seen = seen || ' ' || part
        end
      end
    end
    if header.count('condition') then do
      condition = header.child('condition'); conditionkind = condition.kind()
      if tick(condition) = 0 then return
      if conditionkind <> 'DoWhile' & conditionkind <> 'DoUntil' then do; call fail(condition,'PROFILE: invalid DO condition'); return; end
    end
    if ending.count('name') then do
      named = ending.child('name'); if tick(named) = 0 then return
      if name = '' then do; call fail(named,'SYNTAX: RXC-LC-10.3: END name requires a controlled DO'); return; end
      if rexxclassic_unicode_upper(name) <> rexxclassic_unicode_upper(named.text('spelling')) then do
        call fail(named,'SYNTAX: RXC-LC-10.2: END name does not match DO control symbol'); return
      end
    end
