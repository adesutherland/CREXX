      end
      else return node
    end
  warningwork: method = .int
    arg count = .int
    if count < 0 | count > _budget - _work then do
      _error = 'LL_COMPILER_LIMIT: warning diagnostics exceed frontend work budget'; return 0
    end
    _work = _work + count; return 1
  warningspace: method = .int
    arg count = .int, width = 1
    if count < 0 | width < 1 then do
      _error = 'LL_COMPILER_LIMIT: warning diagnostics exceed frontend byte budget'; return 0
    end
    if count > (_bytebudget - _entrybytes) <idiv> width then do
      _error = 'LL_COMPILER_LIMIT: warning diagnostics exceed frontend byte budget'; return 0
    end
    _entrybytes = _entrybytes + count * width; return 1
  /** Publish once after complete collection. Token and coordinate gaps advance
   * monotonically; the index owns one source copy, never one per warning. */
  sourcewarnings: method = .void
    arg parsed_ref = reference .llcparse..parsed
    parsed = dereference parsed_ref
    pending = .llcdiagnostics..warning[]; cursor = 0; ready = 0
    previous = 0; lineend = -1; line = 0; column = 0; searchcost = 2
    node = .llast..node; head = .llast..node; first = .int; last = .int
    gap = .int; extent = .int; remaining = .int; point = .llsource..position
    mapped = .llcsrcmap..location; warningfilename = .string; warningline = .int; warningcolumn = .int
    filenamebytes = <blen>(_filename as .binary)
    walk = _tree.walk('parents first')
    do while walk.next()
      if warningwork(1) = 0 then return
      node = walk.node()
      if node.kind() <> 'CCommand' then iterate
      head = warninghead(node.child('value'))
      if _error <> '' then return
      if head.kind() = 'String' then iterate
      first = head.start(); _offset = first
      if ready = 0 then do
        extent = <blen>(_source)
        /* Conservative retained index cells, plus its one owned source. */
        if warningspace(extent,17) = 0 | warningspace(16) = 0 then return
        if warningwork(extent) = 0 then return
        remaining = extent
        do while remaining > 0
          if warningwork(1) = 0 then return
          searchcost = searchcost + 1; remaining = remaining <idiv> 2
        end
        _parsepositions = .llsource..index(_source,_budget,_bytebudget,_bytebudget)
        if _parsepositions.error() <> '' then do
          _error = 'LL_COMPILER_LIMIT: warning diagnostics exceed frontend byte budget'; return
        end
        _parsepositionsready = 1; ready = 1
      end
      do
        tokens_ref = parsed.sourcetokens(); tokens = dereference tokens_ref
        do while cursor < tokens.size()
          if warningwork(1) = 0 then return
          if tokens.start(cursor) >= first then leave
          cursor = cursor + 1
        end
        if cursor >= tokens.size() then do; _error = 'LL_COMPILER_INVALID: warning head has no original token'; return; end
        if tokens.start(cursor) <> first then do; _error = 'LL_COMPILER_INVALID: warning head is not a token boundary'; return; end
        last = tokens.finish(cursor + 1)
      end
      gap = first - previous
      if warningwork(gap) = 0 then return
      if first > lineend then do
        if warningwork(searchcost) = 0 then return
        point = _parsepositions.position(first)
        if point.error() <> '' then do; _error = 'LL_COMPILER_LIMIT: warning diagnostics exceed frontend work budget'; return; end
        line = point.line(); column = point.column(); lineend = point.last()
      end
      else do
        if warningspace(gap,2) = 0 then return
        column = column + length(binsubstr(_source,previous + 1,gap) as .string)
      end
      warningfilename = _filename; warningline = line; warningcolumn = column
      if _mapping.active() then do
        mapped = _mapping.location(first,last)
        if _mapping.status() <> 0 then do; _error = _mapping.error(); _offset = first; return; end
        if mapped.valid() then do
          warningfilename = mapped.filename(); warningline = mapped.line(); warningcolumn = mapped.column()
        end
      end
      filenamebytes = <blen>(warningfilename as .binary)
      /* Account both pending and published owned record/filename payload. */
      if warningspace(144) = 0 | warningspace(filenamebytes,2) = 0 then return
      if warningwork(filenamebytes) = 0 | warningwork(filenamebytes) = 0 then return
      if warningwork(filenamebytes) = 0 | warningwork(filenamebytes) = 0 | warningwork(32) = 0 then return
      pending[pending[0] + 1] = .llcdiagnostics..warning(warningfilename,first,last,warningline,warningcolumn)
      previous = first
    end
    _warnings = pending; _offset = 0
    return
  /** Begin ownership is explicit IR; the admitted K-use proof erases an
   * unneeded marker and its exclusively used canonical context transport. */
  clausebegin: method = .void
    arg node = .llast..node, first = .int, last = .int
    if 3 > _budget - _work then do; call fail(node,'LIMIT: frontend clause construction work budget exceeded'); return; end
    _work = _work + 3
    origin = _file.origin(first,last,node.origin()); codec = .llir..intcodec()
    op = _block.operation(_contract.operation('crexx.c.clause.begin'),origin)
    call op.input('context',_block.load(_contextslot,origin))
    call op.attribute('id',codec.parse((node.start() + 1) as .string)); built = op.finish()
    if _builder.error() <> '' then _error = _builder.error()
    return
  /** One authored checkpoint, with a conditional EXIT carrier. A normal
   * continuation never reads that carrier or allocates an absent packet. */
  clausecomplete: method = .void
    arg node = .llast..node, first = -1, last = -1
    if _callhandlers = 0 | _error <> '' then return
    if first < 0 then first = node.start()
    if last < 0 then last = node.finish()
    if signalwork(node,32) = 0 then return
    origin = _file.origin(first,last,node.origin()); generated = origin.derive('synthetic')
    integer = .llir..intcodec()
    op = _block.operation(_contract.operation('crexx.c.clause.complete'),origin)
    call op.input('table',_block.load(_signalslot,generated))
    call op.input('context',_block.load(_contextslot,generated))
    call op.attribute('id',integer.parse((node.start() + 1) as .string)); built = op.finish()
    carrier = temporary(type('result')); call _block.store(carrier,built.result(),generated)
    op = _block.operation(_contract.operation('crexx.c.program.exiting'),generated)
    call op.input('context',_block.load(_contextslot,generated)); built = op.finish()
    unwind = newblock('clause.unwind'); continuation = newblock('clause.continue')
    call _block.branch(built.result(),unwind,continuation,generated)
    _block = unwind; call _block.returnvalue(_block.load(carrier,generated),generated)
    _block = continuation
    return
  /** Retain an already evaluated decision or completion across a handler.
   * This temporary carries the original value, never the conditional carrier. */
  checkpointvalue: method = .llir..valuehandle
    arg node = .llast..node, value = .llir..valuehandle, first = -1, last = -1
    if _callhandlers = 0 then return value
    origin = at(node).derive('synthetic'); saved = temporary(value.type())
    call _block.store(saved,value,origin)
    call clausecomplete(node,first,last)
    return _block.load(saved,origin)
  statement: method = .void
    arg node = .llast..node
    if tick(node) = 0 then return
    i = .int
    origin = at(node); kind = node.kind(); value = .llir..valuehandle; op = .llir..opdraft; built = .llir..opview
    /* Visit structural/non-emitting statements without reopening a terminated
     * block. Later emitting statements still lower in checked dead code. */
    nonemitting = kind = 'Sequence' | kind = 'Block' | kind = 'Nop' | kind = 'CLabel' | kind = 'CLabelled'
    if kind = 'CDo' then do
      header = node.child('header')
      nonemitting = header.count('repetition') = 0 & header.count('condition') = 0
    end
    if kind = 'COptions' then do
      nonemitting = 1
      if node.count('value') then nonemitting = simpleliteral(node.child('value'))
    end
    if kind = 'CArg' then do
      nonemitting = 1; templates = node.child('templates')
      do i = 1 to templates.count('items')
        if templates.child('items',i).count('items') > 0 then nonemitting = 0
      end
    end
    if _callhandlers > 0 & wordpos(kind,'Nop COptions CArg') > 0 then nonemitting = 0
    if _terminated & nonemitting = 0 then do
      _block = newblock('unreachable'); _terminated = 0; _alive = 0
    end
    observes = nonemitting = 0 | wordpos(kind,'Nop COptions CArg CSelect') > 0
    if _terminated = 0 & observes & kind <> 'CProcedure' & kind <> 'CDo' then do
      finish = node.finish()
      if kind = 'IfThen' | kind = 'IfElse' then finish = node.child('condition').finish()
      call clausebegin(node,node.start(),finish)
      if _error <> '' then return
    end
    select
      when kind = 'Sequence' then do i = 1 to node.count('items') while _error = ''
        call statement(node.child('items',i))
      end
      when kind = 'Block' then call statement(node.child('body'))
      when kind = 'COptions' then do
        if node.count('value') then value = expression(node.child('value'),'',nonemitting)
      end
      when kind = 'Nop' then nop
      when kind = 'CLabel' then do
        id = node.id()
        if _labelleaders[id] = 0 then return
        target = _sourceblocks[id] as .llir..block
        if _block.id() <> target.id() then do
          if _terminated = 0 then call _block.jump(target,origin.derive())
          _block = target; _terminated = 0
        end
        if _sourceentries[id] > 0 then _alive = 1
      end
      when kind = 'CLabelled' then do
        do i = 1 to node.count('labels') while _error = ''
          call statement(node.child('labels',i))
        end
        if _error = '' then call statement(node.child('value'))
      end
      when kind = 'CProcedure' then do
        call procedurestatement(node)
        if _error = '' then call clausebegin(node,node.start(),node.finish())
      end
      when kind = 'CDrop' then do i = 1 to node.count('items') while _error = ''
        item = node.child('items',i); itemorigin = at(item)
        if item.kind() <> 'DropDirect' & item.kind() <> 'DropIndirect' then do
          call fail(item,'PROFILE: invalid DROP item'); return
        end
        op = _block.operation(_contract.operation('crexx.c.drop'),itemorigin)
        call op.input('context',_block.load(_contextslot,itemorigin))
        call op.attribute('name',item.text('name') as .binary)
        boolean = .llir..boolcodec()
        call op.attribute('indirect',boolean.parse((item.kind() = 'DropIndirect') as .string))
        built = op.finish()
      end
      when kind = 'Assignment' then do
        do
          if node.count('value') then value = expression(node.child('value'))
          else value = defaultvalue('value',origin)
          if _error = '' then do
            op = _block.operation(_contract.operation('crexx.c.store'),origin)
            call op.input('context',_block.load(_contextslot,origin)); call op.input('value',value)
            call op.attribute('name',node.text('name') as .binary); built = op.finish()
          end
        end
      end
      when kind = 'Say' then do
        if node.count('value') then value = expression(node.child('value'))
        else value = defaultvalue('value',origin)
        if _error <> '' then return
        do
          op = _block.operation(_contract.operation('crexx.c.say'),origin); call op.input('value',value)
          call op.input('context',_block.load(_contextslot,origin))
        end
        built = op.finish()
      end
      when kind = 'CPush' | kind = 'CQueue' then do
        if node.count('value') then value = expression(node.child('value'))
        else value = defaultvalue('value',origin)
        if _error <> '' then return
        op = _block.operation(_contract.operation('crexx.c.' || lower(substr(kind,2))),origin)
        call op.input('value',value); call op.input('context',_block.load(_contextslot,origin)); built = op.finish()
      end
      when kind = 'CAddress' then call addressstatement(node)
      when kind = 'CCommand' then call commandstatement(node)
      when kind = 'CSignal' | kind = 'CSignalValue' then call signalstatement(node)
      when kind = 'CSignalOn' | kind = 'CSignalOff' | kind = 'CCallOn' | kind = 'CCallOff' then call conditionpolicy(node)
      when kind = 'CTrace' | kind = 'CTraceValue' then call tracestatement(node)
      when kind = 'CSelect' then call selection(node)
      when kind = 'CDo' then call doloop(node)
      when kind = 'IfThen' | kind = 'IfElse' then do
        value = expression(node.child('condition')); if _error <> '' then return
        value = truth(value,origin)
        value = checkpointvalue(node,value,node.start(),node.child('condition').finish())
        yes = newblock('if.yes'); no = newblock('if.no')
        join = .llir..block; hasjoin = .int; hasjoin = 0
        call _block.branch(value,yes,no,origin)
        incoming = _alive; _block = yes; _terminated = 0
        call statement(node.child('yes')); yesalive = _alive & _terminated = 0
        if _terminated = 0 then do
          join = newblock('if.join'); hasjoin = 1
          call _block.jump(join,origin)
        end
        _block = no; _terminated = 0; _alive = incoming
        if kind = 'IfElse' then call statement(node.child('no'))
        noalive = _alive & _terminated = 0
        if _terminated = 0 then do
          if hasjoin = 0 then do; join = newblock('if.join'); hasjoin = 1; end
          call _block.jump(join,origin)
        end
        /* Even dead open endpoints need structural closure. Closed arms need
         * no join; later dead source still follows the normal checked path. */
        if hasjoin then do; _block = join; _terminated = 0; end
        else _terminated = 1
        _alive = yesalive | noalive
      end
      when kind = 'Leave' | kind = 'Iterate' then call looptransfer(node,origin)
      when kind = 'Return' then do
        do
          if node.count('value') then do
            value = expression(node.child('value')); if _error <> '' then return
            op = _block.operation(_contract.operation('crexx.c.return.present'),origin); call op.input('value',value)
          end
          else do
            op = _block.operation(_contract.operation('crexx.c.return.empty'),origin)
            call op.input('context',_block.load(_contextslot,origin))
          end
          built = op.finish(); value = built.result()
          value = checkpointvalue(node,value)
          call closeactive(origin)
          call _block.returnvalue(value,origin)
        end
        _terminated = 1; _alive = 0
      end
      when kind = 'Exit' then do
        if node.count('value') then do
          value = expression(node.child('value'))
          if _error <> '' then return
          op = _block.operation(_contract.operation('crexx.c.return.present'),origin)
          call op.input('value',value)
        end
        else op = _block.operation(_contract.operation('crexx.c.return.absent'),origin)
        built = op.finish(); value = built.result()
        value = checkpointvalue(node,value)
        if _error <> '' then return
        op = _block.operation(_contract.operation('crexx.c.exit'),origin)
        call op.input('result',value); call op.input('context',_block.load(_contextslot,origin)); built = op.finish()
        /* The proved pair is one program-unwind terminal. Its selector clears
         * every DO phase, including a header not yet on the source loop stack. */
        call _block.returnvalue(value,origin.derive('synthetic'))
        _terminated = 1; _alive = 0
      end
      when kind = 'Invoke' | kind = 'InvokeQuoted' then value = invocation(node,0)
      when kind = 'Parse' | kind = 'CArg' | kind = 'CPull' then call parsestatement(node)
      when kind = 'CNumeric' then do
        setting = lower(node.text('setting'))
        if node.count('value') then value = expression(node.child('value'))
        else do
          initial = '9'; if setting = 'fuzz' then initial = '0'
          value = _block.constantbytes(type('value'),initial as .binary,origin)
        end
        if _error <> '' then return
        op = _block.operation(_contract.operation('crexx.c.numeric.' || setting),origin)
        call op.input('value',value); call op.input('context',_block.load(_contextslot,origin)); built = op.finish()
      end
      when kind = 'CForm' | kind = 'CFormValue' then do
        if kind = 'CForm' then do
          form = lower(node.text('form')); if form = '' then form = 'scientific'
          value = _block.constantbytes(type('value'),form as .binary,origin)
        end
        else value = expression(node.child('value'))
        if _error <> '' then return
        op = _block.operation(_contract.operation('crexx.c.numeric.form'),origin)
        call op.input('value',value); call op.input('context',_block.load(_contextslot,origin)); built = op.finish()
      end
      otherwise call fail(node,'PROFILE: unsupported statement ' || kind)
    end
    if _terminated = 0 & wordpos(kind,'Sequence Block CLabel CLabelled') = 0 then call clausecomplete(node)
    return
  /** Static admission recognizes syntax only. The activation's shared
   * RexxTraceState remains the sole owner of option updates and toggles. */
  traceoption: method = .int
    arg node = .llast..node, option = .string
    extent = <blen>(option as .binary)
    if extent > (_budget - _work) <idiv> 2 then do
      call fail(node,'LIMIT: frontend TRACE option work budget exceeded'); return 0
    end
    _work = _work + extent * 2
    bits = option as .binary; first = 0; codepoint = .int
    do while first < extent
      assembler bgetu8 codepoint,bits,first
      if codepoint <> 63 & codepoint <> 33 then leave
      first = first + 1
    end
    if first = extent then return 1
    remainder = substr(option,first + 1); head = left(remainder,1)
    if head = '+' | head = '-' | pos(head,'0123456789') > 0 then do
      digits = remainder
      if head = '+' | head = '-' then digits = substr(remainder,2)
      if digits <> '' & verify(digits,'0123456789') = 0 then return 1
    end
    else if pos(translate(head),'ACEFILNOR') > 0 then return 1
    call fail(node,'SYNTAX: RXC-LC-24.1: Invalid TRACE option')
    return 0
  tracestatement: method = .void
    arg node = .llast..node
    origin = at(node); value = .llir..valuehandle
    if node.kind() = 'CTraceValue' then value = expression(node.child('value'))
    else do
      spelling = ''
      if node.count('option') then do
        option = node.child('option')
        if tick(option) = 0 then return
        if option.kind() = 'String' then spelling = stringliteral(option)
        else do
          spelling = option.text('spelling')
          if option.kind() = 'TraceSigned' then spelling = option.text('sign') || spelling
        end
        if _error <> '' then return
        if traceoption(option,spelling) = 0 then return
      end
      value = _block.constantbytes(type('value'),spelling as .binary,origin)
    end
    if _error <> '' then return
    op = _block.operation(_contract.operation('crexx.c.trace'),origin)
    call op.input('value',value); call op.input('context',_block.load(_contextslot,origin)); built = op.finish()
    return
  /** PARSE, ARG and PULL share immutable, source-owned template packets. The
   * standalone instructions retain identity and privately imply source/UPPER.
   * The shared executor owns all live name reads and target writes. */
  /** One source-ordered pass over the clean original lexer stream. The parsed
   * owner remains live in run; no stream/source copy is returned per command. */
  addressplans: method = .void
    arg parsed_ref = reference .llcparse..parsed
    parsed = dereference parsed_ref
    walk = _tree.walk('parents first'); cursor = 0; ready = 0
    node = .llast..node; target = .llast..node; command = .llast..node
    do while walk.next()
      node = walk.node()
      if node.kind() = 'CCommand' then command = node.child('value')
      else if node.kind() = 'CAddress' then do
        if node.count('target') = 0 then iterate
        target = node.child('target')
        if target.kind() = 'AddressValue' then iterate
        if target.count('command') = 0 then iterate
        command = target.child('command')
      end
      else iterate
      if ready = 0 then do
        _commandfirst = .stem(); _commandcount = .stem(); _anchorseen = .stem(); ready = 1
      end
      do
        tokens_ref = parsed.sourcetokens(); tokens = dereference tokens_ref
        key = node.start() as .string
        if entryspace(96 + length(key),1,'command binding') = 0 then return
        call _commandfirst.set(key,(_anchorkinds[0] + 1) as .string)
        before = _anchorkinds[0]
        do while cursor < tokens.size()
          if tick(node) = 0 then return
          if tokens.start(cursor) >= command.finish() then leave
          if tokens.start(cursor) >= command.start() then do
            call scananchors(node,tokens.start(cursor),tokens.finish(cursor + 1),tokens.symbol(cursor) = 3)
            if _error <> '' then return
          end
          cursor = cursor + 1
        end
        call _commandcount.set(key,(_anchorkinds[0] - before) as .string)
      end
    end
    return
  anchorstart: method = .int
    arg byte = .int
    return byte = 95 | (byte >= 65 & byte <= 90) | (byte >= 97 & byte <= 122)
  anchorpart: method = .int
    arg byte = .int
    return anchorstart(byte) | (byte >= 48 & byte <= 57)
  /** Byte traversal is monotone within disjoint original tokens; UTF8 source
   * is never repeatedly sliced at scalar offsets to discover ASCII anchors. */
  scananchors: method = .void
    arg node = .llast..node, first = .int, last = .int, allowcolon = .int
    j = .int
    source_ref = reference _source; source = dereference source_ref
    i = first; braces = 1; begin = .int; finish = .int; after = .int; stemflag = .int; valid = .int
    do while i < last
      if tick(node) = 0 then return
      byte = <at..u8>(i) source; begin = -1; finish = -1; after = i + 1; stemflag = 0
      if braces & byte = 36 & i + 1 < last then do
        if <at..u8>(i + 1) source = 123 then do
          j = i + 2
          do while j < last
            if tick(node) = 0 then return
            if <at..u8>(j) source = 125 then leave
            j = j + 1
          end
          if j < last & j > i + 2 then do
            begin = i + 2; finish = j; after = j + 1
            if finish - begin > 2 then do
              if <at..u8>(finish - 2) source = 91 & <at..u8>(finish - 1) source = 93 then do
                stemflag = 1; finish = finish - 2
              end
            end
            if stemflag = 0 & finish > begin then do
              if <at..u8>(finish - 1) source = 46 then do; stemflag = 1; finish = finish - 1; end
            end
          end
          /* One failed suffix search disables later brace searches, while
           * the ordinary pass still discovers any later colon anchors. */
          else if j >= last then braces = 0
        end
      end
      if byte = 58 & allowcolon then do
        previouscolon = 0
        if i > first then previouscolon = <at..u8>(i - 1) source = 58
        if previouscolon = 0 & i + 1 < last then do
          if anchorstart(<at..u8>(i + 1) source) then do
            begin = i + 1; j = begin + 1
            do while j < last
              if tick(node) = 0 then return
              if anchorpart(<at..u8>(j) source) = 0 then leave
              j = j + 1
            end
            finish = j; after = j
            if j + 1 < last then do
              if <at..u8>(j) source = 91 & <at..u8>(j + 1) source = 93 then do; stemflag = 1; after = j + 2; end
            end
            if stemflag = 0 & j < last then do
              if <at..u8>(j) source = 46 then do
                safe = j + 1 = last
                if j + 1 < last then do
                  nextbyte = <at..u8>(j + 1) source
                  safe = nextbyte = 32 | nextbyte = 9 | nextbyte = 10 | nextbyte = 13 | nextbyte = 34 | nextbyte = 39
                end
                if safe then do; stemflag = 1; after = j + 1; end
              end
            end
          end
        end
      end
      if begin >= 0 then do
        valid = finish > begin
        if valid then valid = anchorstart(<at..u8>(begin) source)
        do j = begin + 1 to finish - 1 while valid
          if tick(node) = 0 then return
          valid = anchorpart(<at..u8>(j) source)
        end
        if valid then do
          extent = finish - begin
          if entryspace(extent,4,'command binding') = 0 then return
          if entryspace(128,1,'command binding') = 0 then return
          if extent > (_budget - _work) <idiv> 4 then do
            call fail(node,'LIMIT: frontend command binding work budget exceeded'); return
          end
          _work = _work + extent * 4
          name = upper(binsubstr(source,begin + 1,extent) as .string)
          kind = 'VAR'; if stemflag then kind = 'STEM'
          key = (node.start() as .string) || ':' || kind || ':' || name
          if _anchorseen.get(key) = '' then do
            call _anchorseen.set(key,'1'); n = _anchorkinds[0] + 1
            _anchorkinds[n] = kind; _anchornames[n] = name; _anchorfirst[n] = first; _anchorlast[n] = last
          end
        end
      end
      i = after
    end
    return
  /** Validate the complete authored WITH list before emitting its operations. */
  addressstatement: method = .void
    arg node = .llast..node
    i = .int; option = .string; position = .string; kind = .string; name = .string
    origin = at(node); target = .llast..node; connections = .llast..node
    item = .llast..node; spec = .llast..node; resource = .llast..node
    value = .llir..valuehandle; op = .llir..opdraft; built = .llir..opview
    directions = ''; commandkey = ''; environment = ''; transient = 0
    if node.count('connections') then do
      connections = node.child('connections')
      if node.count('target') = 0 then do; call fail(connections,'SYNTAX: RXC-LC-25.5: ADDRESS WITH requires an environment'); return; end
      do i = 1 to connections.count('items')
        item = connections.child('items',i); option = upper(item.text('option')); spec = item.child('spec'); kind = upper(spec.text('kind'))
        if wordpos(option,'INPUT OUTPUT ERROR') = 0 | wordpos(option,directions) > 0 then do
          call fail(item,'SYNTAX: RXC-LC-25.5: invalid or duplicate ADDRESS direction'); return
        end
        directions = directions || ' ' || option; position = ''; code = '25.6'
        if option = 'OUTPUT' then code = '25.7'
        if option = 'ERROR' then code = '25.14'
        if item.count('position') then do
          position = upper(item.child('position').text('spelling'))
          if option = 'INPUT' then do; call fail(item.child('position'),'SYNTAX: RXC-LC-25.6: INPUT does not accept a position'); return; end
          code = '25.8'; if position = 'REPLACE' then code = '25.9'
        end
        if wordpos(kind,'NORMAL STREAM STEM') = 0 | (position <> '' & kind = 'NORMAL') then do
          call fail(spec,'SYNTAX: RXC-LC-' || code || ': invalid ADDRESS connection type'); return
        end
        if kind <> 'NORMAL' then do
          if spec.count('resource') = 0 then do
            code = '53.1'; if kind = 'STEM' then code = '53.2'
            call fail(spec,'SYNTAX: RXC-LC-' || code || ': ADDRESS resource requires a variable symbol'); return
          end
          resource = spec.child('resource'); name = resource.text('spelling')
          if kind = 'STEM' then do
            if right(name,1) <> '.' | pos('.',name) <> length(name) then do
              call fail(resource,'SYNTAX: RXC-LC-53.3: ADDRESS STEM requires a simple stem'); return
            end
          end
        end
      end
    end
    if node.count('target') = 0 then do
      op = _block.operation(_contract.operation('crexx.c.address.swap'),origin)
      call op.input('context',_block.load(_contextslot,origin)); built = op.finish(); return
    end
    target = node.child('target'); transient = 0
    if target.kind() <> 'AddressValue' then transient = target.count('command') > 0
    if target.kind() = 'AddressValue' then value = expression(target.child('environment'))
    else do
      environment = target.text('environment')
      if target.kind() = 'AddressQuoted' then environment = decodestring(target,environment)
      /* Constant symbols preserve their authored bytes; the shared ADDRESS
       * state owns runtime environment normalization. */
      if transient then value = expression(target.child('command'))
      else value = _block.constantbytes(type('value'),environment as .binary,at(target))
    end
    if _error <> '' then return
    if transient then do
      _commandnumber = _commandnumber + 1; commandkey = 'command.' || _commandnumber
      op = _block.operation(_contract.operation('crexx.c.command.new'),origin)
      call op.attribute('key',commandkey as .binary); call op.attribute('environment',environment as .binary)
      call op.input('command',value)
    end
    else do
      op = _block.operation(_contract.operation('crexx.c.address.select'),origin); call op.input('environment',value)
    end
    call op.input('context',_block.load(_contextslot,origin)); built = op.finish()
    if node.count('connections') then do i = 1 to connections.count('items')
      item = connections.child('items',i); itemorigin = at(item); option = left(upper(item.text('option')),1)
      position = 'REPLACE'; if option = 'I' then position = 'INPUT'
      if item.count('position') then position = upper(item.child('position').text('spelling'))
      spec = item.child('spec'); kind = upper(spec.text('kind')); name = ''
      if spec.count('resource') then name = spec.child('resource').text('spelling')
      operation = 'address.connection'; if transient then operation = 'command.connection'
      op = _block.operation(_contract.operation('crexx.c.' || operation),itemorigin)
      call op.input('context',_block.load(_contextslot,itemorigin))
      if transient then call op.attribute('key',commandkey as .binary)
      call op.attribute('option',option as .binary); call op.attribute('position',position as .binary)
      call op.attribute('kind',kind as .binary); call op.attribute('resource',name as .binary); built = op.finish()
    end
    if transient then call commandfinish(node,commandkey)
    return
  commandstatement: method = .void
    arg node = .llast..node
    value = expression(node.child('value'))
    if _error <> '' then return
    origin = at(node); _commandnumber = _commandnumber + 1; key = 'command.' || _commandnumber
    op = _block.operation(_contract.operation('crexx.c.command.active'),origin)
    call op.input('command',value); call op.input('context',_block.load(_contextslot,origin))
    call op.attribute('key',key as .binary); built = op.finish()
    call commandfinish(node,key)
    return
  commandfinish: method = .void
    arg node = .llast..node, commandkey = .string
    i = .int; origin = at(node)
    op = .llir..opdraft; built = .llir..opview
    key = node.start() as .string; first = _commandfirst.get(key) as .int; count = _commandcount.get(key) as .int
    do i = first to first + count - 1
      bindingorigin = _file.origin(_anchorfirst[i],_anchorlast[i],'exact')
      op = _block.operation(_contract.operation('crexx.c.command.binding'),bindingorigin)
      call op.input('context',_block.load(_contextslot,bindingorigin)); call op.attribute('key',commandkey as .binary)
      call op.attribute('kind',_anchorkinds[i] as .binary); call op.attribute('name',_anchornames[i] as .binary); built = op.finish()
    end
    op = _block.operation(_contract.operation('crexx.c.command.run'),origin)
    call op.input('context',_block.load(_contextslot,origin)); call op.attribute('key',commandkey as .binary); built = op.finish()
    return
  parsestatement: method = .void
    arg node = .llast..node
    name = .llast..node; operand = .llast..node; item = .llast..node
    template = .llast..node; emptyorigin = .llir..origin
    op = .llir..opdraft; built = .llir..opview
    mode = .string; decoded = .string; movement = .int; code = .string; indexwork = .int
    source = .llast..node; templates = node.child('templates'); origin = at(node)
    kind = 'ARG'; if node.kind() = 'CPull' then kind = 'PULL'
    upperflag = 1; value = .llir..valuehandle
    if node.kind() = 'Parse' then do
      source = node.child('source'); spelling = source.text('kind'); kind = ''
      if verify(spelling,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz') = 0 then kind = upper(spelling)
      if wordpos(kind,'ARG PULL SOURCE LINEIN VERSION VALUE VAR') = 0 then do
        code = '25.12'; if node.text('upper') <> '' then code = '25.13'
        call fail(source,'SYNTAX: RXC-LC-' || code || ': invalid PARSE type ' || spelling); return
      end
      uppertext = node.text('upper')
      if uppertext <> '' then do
        if verify(uppertext,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz') <> 0 | upper(uppertext) <> 'UPPER' then do
          call fail(node,'SYNTAX: invalid PARSE UPPER flag'); return
        end
      end
      upperflag = uppertext <> ''
    end
    select
      when kind = 'VALUE' then do
        if source.count('value') then value = expression(source.child('value'))
        else do
          /* VALUE is five authored ASCII bytes. Its end is a truthful empty
           * boundary before WITH, including intervening comments/trivia. */
          emptyorigin = _file.origin(source.start() + 5,source.start() + 5,source.origin())
          value = defaultvalue('value',emptyorigin)
        end
      end
      when kind = 'VAR' then value = expression(source.child('name'))
      when kind <> 'ARG' then value = parsesource(kind,0,origin)
      otherwise nop
    end
    if _error <> '' then return
    do ordinal = 1 to templates.count('items') while _error = ''
      template = templates.child('items',ordinal)
      /* Empty ARG positions advance the ordinal without reading arguments. */
      if kind = 'ARG' & template.count('items') = 0 then iterate
      if _parsepositionsready = 0 then do
        indexwork = _bytebudget
        if indexwork < 10000000 then indexwork = 10000000
        _parsepositions = .llsource..index(_source,_budget,_bytebudget,indexwork)
        if _parsepositions.error() <> '' then do
          call fail(node,'LIMIT: PARSE source index: ' || _parsepositions.error()); return
        end
        _parsepositionsready = 1
      end
      packet = .llcparseprogram..builder(_filename,_source,ordinal,upperflag,template.start(),template.finish(),node.start() + 1,_bytebudget)
      call packet.useindex(_parsepositions)
      do itemindex = 1 to template.count('items') while _error = ''
        item = template.child('items',itemindex)
        if tick(item) = 0 then return
        select item.kind()
          when 'ParseTarget' then do
            name = item.child('name'); call packet.target(name.text('spelling'),name.start(),name.finish())
          end
          when 'ParseDrop' then call packet.drop(item.start(),item.finish())
          when 'ParseLiteral' then do
            decoded = stringliteral(item.child('value'))
            if _error <> '' then return
            call packet.literal(decoded,item.start(),item.finish())
          end
          when 'ParseVariablePattern' then do
            name = item.child('name')
            call packet.input('LITERAL',name.text('spelling'),item.start(),item.finish(),name.start(),name.finish())
          end
          when 'ParsePosition' then do
            mode = item.text('mode'); operand = item.child('operand')
            select mode
              when '' then mode = 'ABS'
              when '=' then mode = 'ABS'
              when '+' then mode = 'PLUS'
              when '-' then mode = 'MINUS'
              otherwise do; call fail(item,'SYNTAX: invalid PARSE position mode'); return; end
            end
            if operand.kind() = 'Name' then call packet.input(mode,operand.text('spelling'),item.start(),item.finish(),operand.start(),operand.finish())
            else if operand.kind() = 'Number' then do
              movement = parseposition(operand)
              if _error <> '' then return
              call packet.position(mode,movement,item.start(),item.finish())
            end
            else do; call fail(operand,'SYNTAX: PARSE position requires a number or variable'); return; end
          end
          otherwise do; call fail(item,'SYNTAX: invalid PARSE template item'); return; end
        end
      end
      bytes = packet.bytes()
      if packet.error() <> '' then do
        _error = packet.error(); _offset = packet.offset(); return
      end
      if kind = 'ARG' then value = parsesource(kind,ordinal,origin)
      else if ordinal > 1 then value = defaultvalue('value',at(template))
      op = _block.operation(_contract.operation('crexx.c.parse.execute'),origin)
      call op.input('context',_block.load(_contextslot,origin)); call op.input('source',value)
      call op.attribute('program',bytes); built = op.finish()
    end
    return
  parsesource: method = .llir..valuehandle
    arg kind = .string, ordinal = .int, origin = .llir..origin
    op = _block.operation(_contract.operation('crexx.c.parse.source'),origin)
    call op.input('context',_block.load(_contextslot,origin)); call op.attribute('kind',kind as .binary)
    codec = .llir..intcodec(); call op.attribute('ordinal',codec.parse(ordinal as .string))
    built = op.finish(); return built.result()
  /** Source positions are unsigned decimal integer tokens. Conversion is
   * checked before multiplication, independently of the active DIGITS. */
  parseposition: method = .int
    arg node = .llast..node
    spelling = node.text('spelling'); value = 0
    if spelling = '' | verify(spelling,'0123456789') <> 0 then do
      call fail(node,'SYNTAX: RXC-LC-38.1: invalid PARSE template at ' || spelling); return 0
    end
    do i = 1 to length(spelling)
      digit = pos(substr(spelling,i,1),'0123456789') - 1
      if value > 922337203685477580 | (value = 922337203685477580 & digit > 7) then do
        call fail(node,'LIMIT: PARSE position exceeds signed descriptor range: ' || spelling); return 0
      end
      value = value * 10 + digit
    end
    return value
  /** Ordinary grouping never owns a transfer target. Repetitive DO targets
   * and edge-local closes are separate from the checked dead-source cursor. */
  loopafter: method = .llir..block
    arg level = .int
    if _hasbreaks[level] = 0 then do
