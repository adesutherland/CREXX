    op = .llir..opdraft; built = .llir..opview
    target = .llir..block
    continuing = node.kind() = 'Iterate'
    if node.count('name') then do
      named = node.child('name'); if tick(named) = 0 then return
      name = named.text('spelling'); selected = 0
      identity = rexxclassic_unicode_upper(name)
      do level = _loops to 1 by -1
        _work = _work + 1
        if _work > _budget then do; call fail(named,'LIMIT: frontend work budget exceeded'); return; end
        if _loopnames[level] = identity then do; selected = level; leave; end
      end
    end
    if selected = 0 then do
      code = '28.1'; if _loops > 0 then code = '28.3'
      if continuing then do; code = '28.2'; if _loops > 0 then code = '28.4'; end
      if _strictc = 0 then do
        instruction = upper(node.kind())
        call fail(node,'FLOW: RXC-LC-' || code || ': invalid ' || instruction || ' target "' || name || '"'); return
      end
      op = _block.operation(_contract.operation('crexx.c.transfer.invalid'),origin)
      call op.attribute('code',code as .binary); call op.attribute('name',name as .binary); built = op.finish()
