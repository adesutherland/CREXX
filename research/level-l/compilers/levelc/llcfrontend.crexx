/* cREXX License (MIT). Classic source-to-checked-IR service, implemented in B. */
options levelb
namespace llcfrontend expose request
import rxfnsb
import llast
import llir
import llsource
import llcir
import llcparse
import llcompilercontracts
import llcdoprotocol
import rexxclassicunicodeproperties

/** Classic routine: one source statement interval and its result contract. */
routine: class
  _name = .string
  _result = .string
  _body = .llast..node
  _first = .int
  _last = .int
  *: factory
    arg identity = .string, type = .string, source = .llast..node, begin = .int, finish = .int
    _name = identity; _result = type; _body = source; _first = begin; _last = finish
    return
  name: method = .string
    return _name
  result: method = .string
    return _result
  body: method = .llast..node
    return _body
  first: method = .int
    return _first
  last: method = .int
    return _last
  endat: method = .void
    arg finish = .int
    _last = finish
    return
  resulttype: method = .void
    arg type = .string
    _result = type
    return

/** Atomic compilation request. A successful graph is published only after
 * source admission, binding, lowering and Level L verification all succeed.
 * Imports are read from an explicit artifact directory; no tool is spawned. */
request: class
  _source = .binary
  _filename = .string
  _rootpath = .string
  _nesting = .int
  _budget = .int
  _work = .int
  _ready = .int
  _building = .int
  _error = .string
  _offset = .int
  _tree = .llast..tree
  _graph = .llir..module
  _registry = .llir..schema
  _contract = .llir..contract
  _builder = .llir..builder
  _file = .llir..sourcefile
  _library = .llcompilercontracts..catalog
  _classic = .llcompilercontracts..catalog
  _hasclassic = .int
  _haslibrary = .int
  _importb = .int
  _namespace = .string
  _importnames = .string[]
  _importcatalogs = .object[]
  _externals = .string[]
  _externalsigs = .object[]
  _callnames = .string[]
  _callmasks = .string[]
  _callitems = .object[]
  _callsymbols = .string[]
  _callpackages = .string[]
  _routines = .object[]
  _functions = .object[]
  _current = .routine
  _scope = .int
  _fn = .llir..function
  _block = .llir..block
  _blocknumber = .int
  _tempnumber = .int
  _terminated = .int
  _alive = .int
  _loops = .int
  _breaks = .object[]
  _continues = .object[]
  _hasbreaks = .int[]
  _hascontinues = .int[]
  _breakalive = .int[]
  _continuealive = .int[]
  _loopkeys = .string[]
  _donumber = .int
  _bindscope = .int[]
  _bindnames = .string[]
  _bindtypes = .string[]
  _explicit = .int[]
  _slots = .object[]
  _contextslot = .llir..slot
  *: factory
    arg source = .binary, artifacts = '', filename = '<source>', budget = 1000000, nesting = 512
    _source = source; _filename = llcompilercontracts..sourcename(filename); _rootpath = artifacts
    _budget = budget; _work = 0; _error = ''; _offset = 0; _haslibrary = 0; _hasclassic = 0; _importb = 0
    _ready = 0; _nesting = nesting; _building = 0
    _tree = .llast..tree.failed('LL_COMPILER_PARSE: no accepted source tree')
    return
  run: method = .void
    if _ready then return
    _ready = 1
    do
      parsed = .llcparse..parsed(_source,_budget)
      if parsed.status() <> 0 then do
        _error = parsed.error(); _offset = parsed.offset(); return
      end
      _tree = parsed.ast()
      if _tree.isrecovered() then do
        _error = 'LL_COMPILER_RECOVERED: executable IR requires clean input'; return
      end
      walk = _tree.walk('parents first')
      do while walk.next()
        if walk.depth() > _nesting then do
          call fail(walk.node(),'LIMIT: AST nesting budget exceeded'); return
        end
      end
      _registry = .llir..schema(); call llcir..registerfamilies(reference _registry)
      call inventory()
      if _error <> '' then return
      if _error <> '' then return
      _contract = _registry.finish()
      if _contract.error() <> '' then do
        _error = _contract.error(); return
      end
      _builder = .llir..builder(_contract,_budget,_budget * 64)
      _building = 1
      _file = _builder.source(_filename,_source)
      if _error <> '' then return
      call lowerall()
      if _error <> '' then return
      _graph = _builder.finish()
      if _graph.error() <> '' then _error = _graph.error()
      if _error = '' then do
        protocol = .llcdoprotocol..checked(reference _graph,_budget * 64,_budget)
        if protocol.status() then do; _error = protocol.error(); _offset = protocol.offset(); end
      end
    on signal as problem
      if _building then _error = _builder.error()
      if _error = '' then _error = 'LL_COMPILER_INVALID: ' || problem.message()
    end
    return
  error: method = .string
    call run()
    return _error
  /** Located user-facing message, with escaped source excerpt and caret. */
  diagnostic: method = .string
    call run()
    if _error = '' then return ''
    split = pos(':',_error)
    if split = 0 then return _filename || ': ' || llsource..diagnostic(_source,_offset,'LL_COMPILER_SYNTAX',_error)
    return _filename || ': ' || llsource..diagnostic(_source,_offset,left(_error,split - 1),strip(substr(_error,split + 1)))
  status: method = .int
    call run()
    return _error <> ''
  offset: method = .int
    call run()
    return _offset
  ast: method = .llast..tree
    call run()
    return _tree
  graph: method = .llir..module
    call run()
    if _error <> '' then do
      empty = .llir..schema(); contract = empty.finish()
      return llir..loadbinary(contract,''x as .binary)
    end
    return _graph
  fail: method = .void
    arg node = .llast..node, reason = .string
    if _error <> '' then return
    _error = 'LL_COMPILER_' || reason
    if node.valid() then _offset = node.offset()
    return
  tick: method = .int
    arg node = .llast..node
    _work = _work + 1
    if _work > _budget then call fail(node,'LIMIT: frontend work budget exceeded')
    return _error = ''
  at: method = .llir..origin
    arg node = .llast..node
    return _file.origin(node.start(),node.finish(),node.origin())
  findroutine: method = .int
    arg name = .string
    do i = 1 to _routines[0]
      item = _routines[i] as .routine
      if item.name() = upper(name) then return i
    end
    return 0
  /** Variable recognition is wider than this existing private-call profile.
   * Do not silently merge newly lexable Unicode or dotted routine names. */
  routinename: method = .int
    arg name = .string
    if name = '' then return 0
    return verify(left(name,1),'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_') = 0 & verify(name,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789') = 0
  inventory: method = .void
    root = _tree.root(); body = root.child('body')
    main = .routine('$MAIN','int64',body,1,body.count('items'))
    call main.resulttype('result')
    _namespace = ''

    if _namespace = '' then _routines[1] = main as .object
    item = .routine; node = .llast..node; next = .llast..node; part = .llast..node; parameter = .llast..node
    name = .string; result = .string; ptype = .string; i = .int; j = .int
    do i = 1 to body.count('items')
      node = body.child('items',i)
      if node.kind() <> 'CLabel' then iterate
      name = node.text('name')
      if routinename(name) = 0 then do
        call fail(node,'PROFILE: routine name is outside the ASCII-undotted profile'); return
      end
      name = upper(name)
      if findroutine(name) > 0 then do
        call fail(node,'BIND: duplicate routine ' || name); return
      end
      if i = body.count('items') then do
        call fail(node,'PROFILE: Classic label requires PROCEDURE'); return
      end
      next = body.child('items',i + 1)
      if next.kind() <> 'CProcedure' then do
        call fail(node,'PROFILE: shared-pool labels are outside this profile'); return
      end
      item = _routines[_routines[0]] as .routine; call item.endat(i - 1)
      _routines[_routines[0]] = item as .object
      item = .routine(name,'result',body,i + 2,body.count('items'))
      _routines[_routines[0] + 1] = item as .object
    end

    return
  type: method = .llir..typeid
    arg name = .string
    if name = 'void' then return _contract.voidtype()
    if wordpos(name,'value context arguments result') > 0 then return _contract.type('crexx.c.' || name)
    return _contract.type('crexx.g.' || name)
  /** Only observed call masks create descriptors; no optional-subset expansion. */
  newblock: method = .llir..block
    arg purpose = .string
    _blocknumber = _blocknumber + 1
    return _fn.block(purpose || '.' || _blocknumber)
  temporary: method = .llir..slot
    arg type = .llir..typeid
    _tempnumber = _tempnumber + 1
    return _fn.slot('$tmp.' || _tempnumber,type)
  lowerall: method = .void
    item = .routine; fn = .llir..function; index = .int; i = .int; j = .int
    slot = .llir..slot; op = .llir..opdraft; built = .llir..opview
    fallback = .llir..valuehandle; value = .llir..valuehandle; defaultorigin = .llir..origin
    do i = 1 to _routines[0]
      item = _routines[i] as .routine
      fn = _builder.function(item.name(),type(item.result()))
      do
        index = fn.argument(type('context'))
      end
      _functions[i] = fn as .object
    end
    do scope = 1 to _routines[0] while _error = ''
      _scope = scope
      _current = _routines[_scope] as .routine; _fn = _functions[_scope] as .llir..function
      _blocknumber = 0; _tempnumber = 0; _loops = 0; _donumber = 0; _terminated = 0; _alive = 1
      _block = newblock('entry'); authored = at(_current.body()); origin = authored.derive()
      do
        _contextslot = _fn.slot('$context',type('context'))
        call _block.store(_contextslot,_block.readarg(1,origin),origin)
      end
      do i = _current.first() to _current.last() while _error = ''
        call statement(_current.body().child('items',i))
      end
      if _error <> '' then return
      if _scope < _routines[0] & _alive & _terminated = 0 then do
        call fail(_current.body(),'PROFILE: fall-through into a Classic label is outside this profile'); return
      end
      if _terminated = 0 then do

        if _current.result() = 'void' then call _block.returnvoid(origin)
        else do
          op = _block.operation(_contract.operation('crexx.c.return.absent'),origin); built = op.finish()
          call _block.returnvalue(built.result(),origin)
        end
      end
    end
    return
  defaultvalue: method = .llir..valuehandle
    arg name = .string, origin = .llir..origin
    if name = 'text' | name = 'value' then return _block.constantbytes(type(name),''x as .binary,origin)
    return _block.constant(type(name),'0',origin)
  /** Classify only; the selected expression path still owns every visit and
   * literal check. Fallback expression lowering is never visited twice. */
  simpleliteral: method = .int
    arg node = .llast..node
    do forever
      kind = node.kind()
      if kind = 'Group' then node = node.child('value')
      else if kind = 'Chain' then do
        if node.count('operators') <> 0 | node.count('operands') <> 1 then return 0
        node = node.child('operands',1)
      end
      else return kind = 'String' | kind = 'Number'
    end
  statement: method = .void
    arg node = .llast..node
    if tick(node) = 0 then return
    i = .int
    origin = at(node); kind = node.kind(); value = .llir..valuehandle; op = .llir..opdraft; built = .llir..opview
    target = .llir..block
    /* Visit structural/non-emitting statements without reopening a terminated
     * block. Later emitting statements still lower in checked dead code. */
    nonemitting = kind = 'Sequence' | kind = 'Block' | kind = 'Nop'
    if kind = 'CDo' then do
      header = node.child('header')
      nonemitting = header.count('repetition') = 0 & header.count('condition') = 0
    end
    if kind = 'COptions' then do
      nonemitting = 1
      if node.count('value') then nonemitting = simpleliteral(node.child('value'))
    end
    if _terminated & nonemitting = 0 then do
      _block = newblock('unreachable'); _terminated = 0; _alive = 0
    end
    select
      when kind = 'Sequence' then do i = 1 to node.count('items') while _error = ''
        call statement(node.child('items',i))
      end
      when kind = 'Block' then call statement(node.child('body'))
      when kind = 'COptions' then do
        if node.count('value') then value = expression(node.child('value'),'',nonemitting)
      end
      when kind = 'Nop' then nop
      when kind = 'CDrop' then do i = 1 to node.count('items') while _error = ''
        item = node.child('items',i); itemorigin = at(item)
        if item.kind() <> 'DropDirect' & item.kind() <> 'DropIndirect' then do
          call fail(item,'PROFILE: invalid DROP item'); return
        end
        op = _block.operation(_contract.operation('crexx.c.drop'),itemorigin)
        call op.input('context',_block.load(_contextslot,itemorigin))
        call op.attribute('name',item.text('name') as .binary)
        boolean = .llir..boolcodec()
        call op.attribute('indirect',boolean.parse((item.kind() = 'DropIndirect') as .string))
        built = op.finish()
      end
      when kind = 'Assignment' then do
        do
          if node.count('value') then value = expression(node.child('value'))
          else value = defaultvalue('value',origin)
          if _error = '' then do
            op = _block.operation(_contract.operation('crexx.c.store'),origin)
            call op.input('context',_block.load(_contextslot,origin)); call op.input('value',value)
            call op.attribute('name',node.text('name') as .binary); built = op.finish()
          end
        end
      end
      when kind = 'Say' then do
        if node.count('value') then value = expression(node.child('value'))
        else value = defaultvalue('value',origin)
        if _error <> '' then return
        do
          op = _block.operation(_contract.operation('crexx.c.say'),origin); call op.input('value',value)
        end
        built = op.finish()
      end
      when kind = 'CSelect' then call selection(node)
      when kind = 'CDo' then call doloop(node)
      when kind = 'IfThen' | kind = 'IfElse' then do
        value = expression(node.child('condition')); if _error <> '' then return
        value = truth(value,origin)
        yes = newblock('if.yes'); no = newblock('if.no')
        join = .llir..block; hasjoin = .int; hasjoin = 0
        call _block.branch(value,yes,no,origin)
        incoming = _alive; _block = yes; _terminated = 0
        call statement(node.child('yes')); yesalive = _alive & _terminated = 0
        if _terminated = 0 then do
          join = newblock('if.join'); hasjoin = 1
          call _block.jump(join,origin)
        end
        _block = no; _terminated = 0; _alive = incoming
        if kind = 'IfElse' then call statement(node.child('no'))
        noalive = _alive & _terminated = 0
        if _terminated = 0 then do
          if hasjoin = 0 then do; join = newblock('if.join'); hasjoin = 1; end
          call _block.jump(join,origin)
        end
        /* Even dead open endpoints need structural closure. Closed arms need
         * no join; later dead source still follows the normal checked path. */
        if hasjoin then do; _block = join; _terminated = 0; end
        else _terminated = 1
        _alive = yesalive | noalive
      end
      when kind = 'Leave' | kind = 'Iterate' then do
        if _loops = 0 then do
          call fail(node,'FLOW: ' || kind || ' requires a surrounding loop'); return
        end
        if kind = 'Iterate' then do
          target = loopcontinue(_loops); _continuealive[_loops] = _continuealive[_loops] | _alive
        end
        else do
          target = loopafter(_loops); _breakalive[_loops] = _breakalive[_loops] | _alive
          if _loopkeys[_loops] <> '' then built = dostate('close',_loopkeys[_loops],origin)
        end
        call _block.jump(target,origin); _terminated = 1; _alive = 0
      end
      when kind = 'Return' then do
        do
          if node.count('value') then do
            value = expression(node.child('value')); if _error <> '' then return
            op = _block.operation(_contract.operation('crexx.c.return.present'),origin); call op.input('value',value)
          end
          else op = _block.operation(_contract.operation('crexx.c.return.absent'),origin)
          built = op.finish(); value = built.result()
          call closeactive(origin)
          call _block.returnvalue(value,origin)
        end
        _terminated = 1; _alive = 0
      end
      when kind = 'Exit' then do
        if node.count('value') then value = expression(node.child('value'),'int64')
        else value = _block.constantbytes(type('value'),'0' as .binary,origin)
        if _error <> '' then return

        call closeactive(origin)
        op = _block.operation(_contract.operation('crexx.' || 'c' || '.exit'),origin); call op.input('value',value); built = op.finish()
        /* EXIT never returns. The final core terminator closes the structural
         * block; it is unreachable after this explicitly diverging operation. */
        do
          op = _block.operation(_contract.operation('crexx.c.return.absent'),origin); built = op.finish()
          call _block.returnvalue(built.result(),origin)
        end
        _terminated = 1; _alive = 0
      end
      when kind = 'Invoke' then value = invocation(node,0)
      when kind = 'CArg' then do i = 1 to node.count('items')
        targetnode = node.child('items',i); name = strip(targetnode.text('name'))
        if name = '' then iterate
        op = _block.operation(_contract.operation('crexx.c.arguments.read'),origin)
        call op.input('context',_block.load(_contextslot,origin))
        codec = .llir..intcodec(); call op.attribute('ordinal',codec.parse(i as .string)); built = op.finish(); value = built.result()
        op = _block.operation(_contract.operation('crexx.c.store'),origin)
        call op.input('context',_block.load(_contextslot,origin)); call op.input('value',value)
        call op.attribute('name',name as .binary); built = op.finish()
      end
      when kind = 'CNumeric' then do
        setting = lower(node.text('setting'))
        if node.count('value') then value = expression(node.child('value'))
        else do
          initial = '9'; if setting = 'fuzz' then initial = '0'
          value = _block.constantbytes(type('value'),initial as .binary,origin)
        end
        if _error <> '' then return
        op = _block.operation(_contract.operation('crexx.c.numeric.' || setting),origin)
        call op.input('value',value); call op.input('context',_block.load(_contextslot,origin)); built = op.finish()
      end
      when kind = 'CForm' then do
        form = lower(node.text('form')); if form = '' then form = 'scientific'
        op = _block.operation(_contract.operation('crexx.c.numeric.form'),origin)
        call op.input('context',_block.load(_contextslot,origin)); call op.attribute('form',form as .binary); built = op.finish()
      end
      otherwise call fail(node,'PROFILE: unsupported statement ' || kind)
    end
    return
  /** Ordinary grouping never owns a transfer target. Repetitive DO targets
   * and edge-local closes are separate from the checked dead-source cursor. */
  loopafter: method = .llir..block
    arg level = .int
    if _hasbreaks[level] = 0 then do
      target = newblock('do.after'); _breaks[level] = target as .object; _hasbreaks[level] = 1
    end
    return _breaks[level] as .llir..block
  loopcontinue: method = .llir..block
    arg level = .int
    if _hascontinues[level] = 0 then do
      target = newblock('do.continue'); _continues[level] = target as .object; _hascontinues[level] = 1
    end
    return _continues[level] as .llir..block
  dostate: method = .llir..opview
    arg action = .string, key = .string, origin = .llir..origin
    op = _block.operation(_contract.operation('crexx.c.do.' || action),origin)
    call op.attribute('key',key as .binary)
    return op.finish()
  docapture: method = .void
    arg key = .string, part = .string, value = .llir..valuehandle, origin = .llir..origin
    op = _block.operation(_contract.operation('crexx.c.do.capture'),origin)
    call op.input('value',value); call op.attribute('key',key as .binary); call op.attribute('part',part as .binary)
    built = op.finish()
    return
  closeactive: method = .void
    arg origin = .llir..origin
    do level = _loops to 1 by -1
      if _loopkeys[level] <> '' then built = dostate('close',_loopkeys[level],origin.derive())
    end
    return
  doloop: method = .void
    arg node = .llast..node
    header = node.child('header'); ending = node.child('ending')
    if tick(header) = 0 | tick(ending) = 0 then return
    repetition = .llast..node; condition = .llast..node; modifier = .llast..node; named = .llast..node
    origin = at(node); headerorigin = at(header); endorigin = at(ending)
    testorigin = .llir..origin
    kind = ''; name = ''; conditionkind = ''; key = ''; seen = ''; i = .int
    value = .llir..valuehandle; built = .llir..opview; op = .llir..opdraft
    entry = .llir..block; body = .llir..block; test = .llir..block; exhausted = .llir..block
    after = .llir..block; advance = .llir..block; continuing = .llir..block
    if header.count('repetition') then do
      repetition = header.child('repetition'); kind = repetition.kind()
      if tick(repetition) = 0 then return
      if wordpos(kind,'DoCount DoForever DoControl') = 0 then do; call fail(repetition,'PROFILE: invalid DO repetition'); return; end
      if kind = 'DoControl' then do
        named = repetition.child('name'); if tick(named) = 0 then return
        name = named.text('spelling')
        do i = 1 to repetition.count('modifiers')
          modifier = repetition.child('modifiers',i); if tick(modifier) = 0 then return
          part = lower(modifier.text('keyword'))
          if wordpos(part,'to by for') = 0 then do; call fail(modifier,'SYNTAX: invalid DO modifier'); return; end
          if wordpos(part,seen) > 0 then do; call fail(modifier,'SYNTAX: RXC-LC-27.1: duplicate DO ' || upper(part)); return; end
          seen = seen || ' ' || part
        end
      end
    end
    if header.count('condition') then do
      condition = header.child('condition'); conditionkind = condition.kind()
      if tick(condition) = 0 then return
      if conditionkind <> 'DoWhile' & conditionkind <> 'DoUntil' then do; call fail(condition,'PROFILE: invalid DO condition'); return; end
    end
    if ending.count('name') then do
      named = ending.child('name'); if tick(named) = 0 then return
      if name = '' then do; call fail(named,'SYNTAX: RXC-LC-10.3: END name requires a controlled DO'); return; end
      if rexxclassic_unicode_upper(name) <> rexxclassic_unicode_upper(named.text('spelling')) then do
        call fail(named,'SYNTAX: RXC-LC-10.2: END name does not match DO control symbol'); return
      end
    end
    if kind = '' & conditionkind = '' then do; call statement(node.child('body')); return; end
    stateful = kind = 'DoCount' | kind = 'DoControl'; incoming = _alive
    if stateful then do
      _donumber = _donumber + 1; key = 'do.' || _donumber
      op = _block.operation(_contract.operation('crexx.c.do.new'),headerorigin)
      call op.input('context',_block.load(_contextslot,headerorigin))
      call op.attribute('key',key as .binary); call op.attribute('name',name as .binary); built = op.finish()
      if kind = 'DoCount' then do
        value = expression(repetition.child('value')); if _error <> '' then return
        call docapture(key,'repeat',value,at(repetition))
      end
      else do
        value = expression(repetition.child('initial')); if _error <> '' then return
        call docapture(key,'start',value,at(repetition.child('initial')))
        do i = 1 to repetition.count('modifiers')
          modifier = repetition.child('modifiers',i)
          value = expression(modifier.child('value')); if _error <> '' then return
          call docapture(key,lower(modifier.text('keyword')),value,at(modifier))
        end
      end
      built = dostate('start',key,headerorigin)
    end
    _loops = _loops + 1; level = _loops
    _loopkeys[level] = key; _hasbreaks[level] = 0; _hascontinues[level] = 0
    _breakalive[level] = 0; _continuealive[level] = 0
    body = newblock('do.body')
    entry = body
    if conditionkind = 'DoWhile' then do; test = newblock('do.while'); entry = test; end
    if stateful then entry = newblock('do.entry')
    call _block.jump(entry,origin)
    if stateful then do
      _block = entry; built = dostate('entry',key,headerorigin)
      exhausted = newblock('do.exhausted'); after = loopafter(level)
      chosen = body
      if conditionkind = 'DoWhile' then chosen = test
      call _block.branch(built.result(),chosen,exhausted,headerorigin)
      _block = exhausted; built = dostate('close',key,endorigin.derive())
      call _block.jump(after,endorigin); _breakalive[level] = incoming
    end
    if conditionkind = 'DoWhile' then do
      _block = test; _terminated = 0; _alive = incoming
      value = expression(condition.child('value')); if _error <> '' then return
      testorigin = _file.origin(condition.start(),condition.start() + 5,condition.origin())
      value = truth(value,testorigin,'crexx.c.while.truth'); after = loopafter(level)
      if stateful then do
        exhausted = newblock('do.while.exit')
        call _block.branch(value,body,exhausted,testorigin)
        _block = exhausted; built = dostate('close',key,endorigin.derive()); call _block.jump(after,endorigin)
      end
      else call _block.branch(value,body,after,testorigin)
      _breakalive[level] = incoming
    end
    if stateful = 0 & conditionkind <> 'DoUntil' then do
      _continues[level] = entry as .object; _hascontinues[level] = 1
    end
    _block = body; _terminated = 0; _alive = incoming
    call statement(node.child('body')); if _error <> '' then return
    if _terminated = 0 then do
      continuing = loopcontinue(level); _continuealive[level] = _continuealive[level] | _alive
      call _block.jump(continuing,endorigin)
    end
    if (stateful | conditionkind = 'DoUntil') & _hascontinues[level] then do
      _block = _continues[level] as .llir..block; _terminated = 0; _alive = _continuealive[level]
      if conditionkind = 'DoUntil' then do
        value = expression(condition.child('value')); if _error <> '' then return
        testorigin = _file.origin(condition.start(),condition.start() + 5,condition.origin())
        value = truth(value,testorigin,'crexx.c.until.truth'); after = loopafter(level)
        advance = entry
        if stateful then advance = newblock('do.advance')
        if stateful then do
          exhausted = newblock('do.until.exit')
          call _block.branch(value,exhausted,advance,testorigin)
          _block = exhausted; built = dostate('close',key,endorigin.derive()); call _block.jump(after,endorigin)
        end
        else call _block.branch(value,after,advance,testorigin)
        _breakalive[level] = _breakalive[level] | _continuealive[level]
        _block = advance
      end
      if stateful then do
        built = dostate('advance',key,endorigin); call _block.jump(entry,endorigin)
      end
    end
    else if conditionkind = 'DoUntil' then do
      /* A closed body still owns static validation of its unreachable UNTIL
       * operand. Simple literals need no dead value/helper construction. */
      if simpleliteral(condition.child('value')) then value = expression(condition.child('value'),'',1)
      else do
        _block = newblock('unreachable.until'); _terminated = 0; _alive = 0
        value = expression(condition.child('value')); if _error <> '' then return
        op = _block.operation(_contract.operation('crexx.c.return.absent'),endorigin.derive()); built = op.finish()
        call _block.returnvalue(built.result(),endorigin.derive())
      end
    end
    _loops = _loops - 1
    if _hasbreaks[level] then do
      _block = _breaks[level] as .llir..block; _terminated = 0; _alive = _breakalive[level]
    end
    else do; _terminated = 1; _alive = 0; end
    return
  /** Ordered SELECT tests share ordinary statement lowering. Semantic liveness
   * and structural completion stay separate, including checked dead source. */
  selection: method = .void
    arg node = .llast..node
    clause = .llast..node; origin = .llir..origin; missingorigin = .llir..origin
    join = .llir..block; chosen = .llir..block; following = .llir..block
    value = .llir..valuehandle; op = .llir..opdraft; built = .llir..opview
    i = .int; kind = .string; hasjoin = 0; hasotherwise = 0; whens = 0
    incoming = _alive; normal = 0
    do i = 1 to node.count('clauses') while _error = ''
      clause = node.child('clauses',i); kind = clause.kind()
      if hasotherwise then do
        call fail(clause,'PROFILE: SELECT clause follows OTHERWISE'); return
      end
      select
        when kind = 'CWhen' then do
          if tick(clause) = 0 then return
          whens = whens + 1
          value = expression(clause.child('condition')); if _error <> '' then return
          origin = _file.origin(clause.start(),clause.start() + 4,clause.origin())
          value = truth(value,origin,'crexx.c.when.truth')
          chosen = newblock('select.when'); following = newblock('select.next')
          call _block.branch(value,chosen,following,origin)
          _block = chosen; _terminated = 0; _alive = incoming
          call statement(clause.child('body')); if _error <> '' then return
          normal = normal | (_alive & _terminated = 0)
          if _terminated = 0 then do
            if hasjoin = 0 then do; join = newblock('select.join'); hasjoin = 1; end
            call _block.jump(join,origin)
          end
          _block = following; _terminated = 0; _alive = incoming
        end
        when kind = 'COtherwise' then do
          if tick(clause) = 0 then return
          if whens = 0 then do
            call fail(clause,'PROFILE: SELECT requires a WHEN clause'); return
          end
          hasotherwise = 1; origin = at(clause)
          call statement(clause.child('body')); if _error <> '' then return
          normal = normal | (_alive & _terminated = 0)
          if _terminated = 0 then do
            if hasjoin = 0 then do; join = newblock('select.join'); hasjoin = 1; end
            call _block.jump(join,origin)
          end
        end
        when kind = 'CLabel' then call statement(clause)
        otherwise do
          call fail(clause,'PROFILE: invalid SELECT clause ' || kind); return
        end
      end
    end
    if _error <> '' then return
    if whens = 0 then do
      call fail(node,'PROFILE: SELECT requires a WHEN clause'); return
    end
    if hasotherwise = 0 then do
      missingorigin = _file.origin(node.start(),node.start() + 6,node.origin())
      op = _block.operation(_contract.operation('crexx.c.select.missing'),missingorigin)
      built = op.finish()
      /* The fatal C profile cannot return here. Close the structural block
       * using the existing return packet contract, as for EXIT. */
      origin = missingorigin.derive()
      op = _block.operation(_contract.operation('crexx.c.return.absent'),origin)
      built = op.finish(); call _block.returnvalue(built.result(),origin)
      _terminated = 1; _alive = 0
    end
    if hasjoin then do; _block = join; _terminated = 0; end
    else _terminated = 1
    _alive = normal
    return
  valuetype: method = .string
    arg value = .llir..valuehandle
    descriptor = dereference _contract.data()
    name = descriptor.typename(value.type().id())
    if left(name,5) = 'core.' then return substr(name,6)
    return substr(name,9)
  truth: method = .llir..valuehandle
    arg value = .llir..valuehandle, origin = .llir..origin, operation = 'crexx.c.truth'
    built = .llir..opview
    op = _block.operation(_contract.operation(operation),origin)
    call op.input('value',value); call op.input('context',_block.load(_contextslot,origin)); built = op.finish()
    /* Preserve owner checks and pool-policy effects even for known truth.
     * A separate exact literal fact lets ordinary branch pruning remain safe. */
    if value.isconstant() then do
      spelling = bin2x(value.bytes())
      if spelling = '30' then return _block.constant(_contract.boolean(),'0',origin.derive())
      if spelling = '31' then return _block.constant(_contract.boolean(),'1',origin.derive())
    end
    return built.result()
  /** Decode Classic source digits once, using the existing B ordinal bridge.
   * Only the leading group may be short; a blank separates complete groups.
   * The original String node retains its spelling and authored source span. */
  ordinalliteral: method = .string
    arg node = .llast..node, spelling = .string
    suffix = upper(right(spelling,1)); text = substr(spelling,2,length(spelling) - 3)
    digits = '0123456789ABCDEF'; group = 2; description = 'hexadecimal'
    if suffix = 'B' then do; digits = '01'; group = 4; description = 'binary'; end
    count = 0; size = length(text)
    do i = size to 1 by -1
      ch = upper(substr(text,i,1))
      if ch = ' ' then do
        if i = 1 | i = size | count % group <> 0 then do
          call fail(node,'SYNTAX: invalid ' || description || ' literal grouping'); return ''
        end
      end
      else if pos(ch,digits) = 0 then do
        call fail(node,'SYNTAX: invalid digit in ' || description || ' literal'); return ''
      end
      else count = count + 1
    end
    if suffix = 'B' then text = b2x(text)
    return x2c(text)
  expression: method = .llir..valuehandle
    arg node = .llast..node, expected = '', discardliteral = 0
    invalid = .llir..valuehandle
    if tick(node) = 0 then return invalid
    _offset = node.offset()
    origin = at(node); kind = node.kind(); value = .llir..valuehandle; op = .llir..opdraft; built = .llir..opview
    select
      when kind = 'Number' then do
        spelling = node.text('spelling')
        do
          if right(lower(spelling),1) = 'd' then do
            call fail(node,'PROFILE: decimal suffix is not Classic syntax'); return invalid
          end
          if discardliteral then return invalid
          return _block.constantbytes(type('value'),spelling as .binary,origin)
        end
      end
      when kind = 'String' then do
        spelling = node.text('spelling'); quote = left(spelling,1)
        if right(spelling,1) <> quote then do
          ordinaltext = ordinalliteral(node,spelling)
          if _error <> '' then return invalid
          if discardliteral then return invalid
          return _block.constantbytes(type('value'),ordinaltext as .binary,origin)
        end
        text = substr(spelling,2,length(spelling) - 2); decoded = ''; i = 1
        do while i <= length(text)
          ch = substr(text,i,1); decoded = decoded || ch
          if ch = quote & substr(text,i + 1,1) = quote then i = i + 1
          i = i + 1
        end
        if discardliteral then return invalid
        target = 'value'
        return _block.constantbytes(type(target),decoded as .binary,origin)
      end
      when kind = 'Name' then do
        name = node.text('spelling')
        do
          op = _block.operation(_contract.operation('crexx.c.load'),origin)
          call op.input('context',_block.load(_contextslot,origin)); call op.attribute('name',name as .binary)
          built = op.finish(); return built.result()
        end
      end
      when kind = 'Group' then return expression(node.child('value'),expected,discardliteral)
      when kind = 'Prefix' then do
        name = node.child('operator').kind(); child = node.child('value')



        value = expression(node.child('value'),expected)
        if _error <> '' then return invalid

        if name = 'plus' then name = 'positive'
        if name = 'minus' then name = 'negative'
        op = _block.operation(_contract.operation('crexx.c.' || name),origin)
        call op.input('value',value)
        call op.input('context',_block.load(_contextslot,origin))
        built = op.finish(); return built.result()
      end
      when kind = 'Chain' then do
        value = expression(node.child('operands',1),expected,discardliteral)
        do i = 1 to node.count('operators') while _error = ''
          operator = node.child('operators',i).kind(); right = node.child('operands',i + 1)
          value = binary(value,operator,right,origin,expected)
        end
        return value
      end
      when kind = 'Call' then return invocation(node,1)
      otherwise call fail(node,'PROFILE: unsupported expression ' || kind)
    end
    return invalid
  binary: method = .llir..valuehandle
    arg left = .llir..valuehandle, operator = .string, rightnode = .llast..node, origin = .llir..origin, expected = ''
    saved = temporary(left.type()); call _block.store(saved,left,origin)
    target = '';
    right = expression(rightnode,target)
    if _error <> '' then return right
    left = _block.load(saved,origin)
    name = operator
    if operator = 'assign' then name = 'eq'
    if operator = 'plus' then name = 'add'
    if operator = 'minus' then name = 'sub'
    if operator = 'times' then name = 'mul'
    if operator = 'divide' then name = 'div'

    op = _block.operation(_contract.operation('crexx.c.' || name),origin)
    call op.input('left',left); call op.input('right',right); call op.input('context',_block.load(_contextslot,origin))
    built = op.finish(); return built.result()
  invocation: method = .llir..valuehandle
    arg node = .llast..node, expressioncall = .int
    invalid = .llir..valuehandle; origin = at(node); name = node.text('name')
    if routinename(name) = 0 then do
      call fail(node,'PROFILE: routine name is outside the ASCII-undotted profile'); return invalid
    end
    name = upper(name)
    arguments = node.child('arguments'); count = arguments.count('items')
    if count = 1 & arguments.child('items',1).count('value') = 0 then count = 0
    target = findroutine(name); argument = .llast..node; value = .llir..valuehandle
    op = .llir..opdraft; built = .llir..opview; i = .int; slot = .llir..slot

    result = .llir..valuehandle
    if target = 0 then do
      if wordpos(name,'LENGTH ARG DIGITS') = 0 then do
        call fail(node,'CALL: unknown Classic routine ' || name); return invalid
      end
      if (name = 'LENGTH' & count <> 1) | (name = 'DIGITS' & count <> 0) | (name = 'ARG' & count <> 0 & count <> 2) then do
        call fail(node,'CALL: BIF argument form outside the admitted profile'); return invalid
      end
      call classiccontract(node,name)
      if _error <> '' then return invalid
      if name = 'DIGITS' then do
        op = _block.operation(_contract.operation('crexx.c.digits'),origin)
        call op.input('context',_block.load(_contextslot,origin)); built = op.finish(); value = built.result()
      end
      else if name = 'ARG' & count = 0 then do
        op = _block.operation(_contract.operation('crexx.c.arguments.count'),origin)
        call op.input('context',_block.load(_contextslot,origin)); built = op.finish(); value = built.result()
      end
      else do
        saved = .object[]
        do i = 1 to count
          argument = arguments.child('items',i)
          if argument.count('value') = 0 then do
            call fail(argument,'CALL: missing BIF argument'); return invalid
          end
          value = expression(argument.child('value'))
          if _error <> '' then return invalid
          slot = temporary(type('value')); call _block.store(slot,value,origin); saved[i] = slot as .object
        end
        if name = 'LENGTH' then do
          call classiccontract(node,'LENGTH')
          if _error <> '' then return invalid
          op = _block.operation(_contract.operation('crexx.c.length'),origin)
          slot = saved[1] as .llir..slot; call op.input('value',_block.load(slot,origin))
          call op.input('context',_block.load(_contextslot,origin))
        end
        else do
          op = _block.operation(_contract.operation('crexx.c.arguments.exists'),origin)
          call op.input('context',_block.load(_contextslot,origin))
          slot = saved[1] as .llir..slot; call op.input('ordinal',_block.load(slot,origin))
          slot = saved[2] as .llir..slot; call op.input('option',_block.load(slot,origin))
        end
        built = op.finish(); value = built.result()
      end
      if expressioncall then return value
      op = _block.operation(_contract.operation('crexx.c.return.present'),origin)
      call op.input('value',value); built = op.finish(); result = built.result()
    end
    else do
      op = _block.operation(_contract.operation('crexx.c.arguments.empty'),origin); built = op.finish()
      packet = temporary(type('arguments')); call _block.store(packet,built.result(),origin)
      do i = 1 to count
        argument = arguments.child('items',i); present = argument.count('value') <> 0
        if present then value = expression(argument.child('value'))
        else value = defaultvalue('value',at(argument))
        if _error <> '' then return invalid
        op = _block.operation(_contract.operation('crexx.c.arguments.append'),at(argument))
        call op.input('arguments',_block.load(packet,origin)); call op.input('value',value)
        call op.input('present',_block.constant(_contract.boolean(),present as .string,origin)); built = op.finish()
        call _block.store(packet,built.result(),origin)
      end
      op = _block.operation(_contract.operation('crexx.c.call'),origin)
      call op.input('arguments',_block.load(packet,origin)); call op.input('context',_block.load(_contextslot,origin))
      call op.attribute('target',name as .binary)
      boolean = .llir..boolcodec(); call op.attribute('function',boolean.parse(expressioncall as .string))
      built = op.finish(); result = built.result()
    end
    if expressioncall then do
      op = _block.operation(_contract.operation('crexx.c.requirevalue'),origin)
      call op.input('result',result); built = op.finish(); return built.result()
    end
    op = _block.operation(_contract.operation('crexx.c.setresult'),origin)
    call op.input('context',_block.load(_contextslot,origin)); call op.input('result',result); built = op.finish()
    return invalid
  classiccontract: method = .void
    arg node = .llast..node, name = .string
    if _rootpath = '' then do
      call fail(node,'IMPORT: Classic BIF requires the rxfnsc artifact contract'); return
    end
    if _hasclassic = 0 then do
      do
        image = readbinary(_rootpath || '/rxfnsc.rxbin')
        _classic = .llcompilercontracts..catalog(image,67108864)
      on signal
        call fail(node,'IMPORT: cannot read rxfnsc.rxbin'); return
      end
      if _classic.error() <> '' then do
        call fail(node,'IMPORT: ' || _classic.error()); return
      end
      if _classic.field(11,'rexxclassicbifs.rexxbifcallcontext','',2) <> 'b' | _classic.field(12,'rexxclassicbifs.rexxbifcallcontext.bif_arg_count','',3) <> '.int' then do
        call fail(node,'IMPORT: incompatible Classic BIF context layout'); return
      end
      _hasclassic = 1
    end
    symbol = 'rexxclassicbiflength.rexxclassicbif_length'; count = 1
    if name = 'ARG' then do; symbol = 'rexxclassicbifarg.rexxclassicbif_arg'; count = 2; end
    if name = 'DIGITS' then symbol = 'rexxclassicbifnumeric.rexxclassicbif_digits'
    signature = _classic.lookup(symbol)
    if signature.error() <> '' then call fail(node,'IMPORT: ' || signature.error())
    else if signature.result() <> '.rexxvalue..rexxvalue' | signature.arguments() <> count then call fail(node,'IMPORT: incompatible Classic ' || name || ' contract')
    else if signature.type(1) <> 'reference .rexxbifcallcontext' then call fail(node,'IMPORT: incompatible Classic BIF context')
    else if signature.optional(1) then call fail(node,'IMPORT: optional Classic context is incompatible')
    else if name = 'ARG' then do
      if signature.type(2) <> 'reference .rexxactivationarguments' | signature.optional(2) then call fail(node,'IMPORT: incompatible Classic activation contract')
    end
    return
