/* cREXX License (MIT). Classic source-to-checked-IR service, implemented in B. */
options levelb
namespace llcfrontend expose request
import rxfnsb
import llast
import llir
import llsource
import llcir
import llcbifs
import llcbindings
import llcparse
import llcore
import llcparseprogram
import llcompilercontracts
import llcdoprotocol
import llcclauseprotocol
import llcprocedureprotocol
import llcsignalprotocol
import llccommandprotocol
import llcdiagnostics
import rexxclassicunicodeproperties
import llcsrcmap

/** First source-unit entry identity and its result contract. */
routine: class
  _name = .string
  _result = .string
  _body = .llast..node
  _first = .int
  _last = .int
  *: factory
    arg identity = .string, type = .string, source = .llast..node, begin = .int, finish = .int
    _name = identity; _result = type; _body = source; _first = begin; _last = finish
    return
  name: method = .string
    return _name
  result: method = .string
    return _result
  body: method = .llast..node
    return _body
  first: method = .int
    return _first
  last: method = .int
    return _last
  endat: method = .void
    arg finish = .int
    _last = finish
    return
  resulttype: method = .void
    arg type = .string
    _result = type
    return

/** Atomic compilation request. A successful graph is published only after
 * source admission, binding, lowering and Level L verification all succeed.
 * Imports are read from an explicit artifact directory; no tool is spawned. */
request: class
  _source = .binary
  _originalsource = .binary
  _mapping = .llcsrcmap..prepared
  _providers = reference .llcbindings..prepared
  _bound = .int
  _filename = .string
  _rootpath = .string
  _nesting = .int
  _budget = .int
  _bytebudget = .int
  _parsepositions = .llsource..index
  _parsepositionsready = .int
  _strictc = .int
  _work = .int
  _ready = .int
  _building = .int
  _error = .string
  _offset = .int
  _tree = .llast..tree
  _graph = .llir..module
  _entryproof = .llcprocedureprotocol..checked
  _signalproof = .llcsignalprotocol..checked
  _loopproof = .llcdoprotocol..checked
  _clauseproof = .llcclauseprotocol..checked
  _registry = .llir..schema
  _contract = .llir..contract
  _builder = .llir..builder
  _file = .llir..sourcefile
  _library = .llcompilercontracts..catalog
  _classic = .llcompilercontracts..catalog
  _hasclassic = .int
  _haslibrary = .int
  _importb = .int
  _namespace = .string
  _importnames = .string[]
  _importcatalogs = .object[]
  _externals = .string[]
  _externalsigs = .object[]
  _callnames = .string[]
  _callmasks = .string[]
  _callitems = .object[]
  _callsymbols = .string[]
  _callpackages = .string[]
  _routines = .object[]
  _routineids = .stem
  _entrybytes = .int
  _sourceentries = .int[]
  _nextinstructions = .object[]
  _labelleaders = .int[]
  _labelnodes = .object[]
  _labelcapacity = .int
  _functions = .object[]
  _current = .routine
  _scope = .int
  _fn = .llir..function
  _block = .llir..block
  _blocknumber = .int
  _tempnumber = .int
  _terminated = .int
  _alive = .int
  _loops = .int
  _breaks = .object[]
  _continues = .object[]
  _hasbreaks = .int[]
  _hascontinues = .int[]
  _breakalive = .int[]
  _continuealive = .int[]
  _loopkeys = .string[]
  _loopnames = .string[]
  _donumber = .int
  _bindscope = .int[]
  _bindnames = .string[]
  _bindtypes = .string[]
  _explicit = .int[]
  _slots = .object[]
  _contextslot = .llir..slot
  _entryslot = .llir..slot
  _sourceblocks = .object[]
  _commandnumber = .int
  _commandfirst = .stem
  _commandcount = .stem
  _anchorseen = .stem
  _anchorkinds = .string[]
  _anchornames = .string[]
  _anchorfirst = .int[]
  _anchorlast = .int[]
  _warnings = .llcdiagnostics..warning[]
  _hassignal = .int
  _signalnames = .string[]
  _signalids = .int[]
  _signalnodes = .llast..node[]
  _signalrows = .stem
  _signalslot = .llir..slot
  _signalbuilding = .int
  _handlernodes = .llast..node[]
  _handlernames = .string[]
  _handlerconditions = .int[]
  _handlerordinals = .int[]
  _handlerrows = .int[]
  _handlermodes = .string[]
  _signalhandlers = .int
  _callhandlers = .int
  _handlercapacity = .int
  _conditionblock = .llir..block
  *: factory
    arg source = .binary, artifacts = '', filename = '<source>', budget = 1000000, nesting = 512
    empty_mapping = .llcsrcmap..prepared; _mapping = empty_mapping
    _source = source; _originalsource = source; _filename = llcompilercontracts..sourcename(filename); _rootpath = artifacts
    _budget = budget; _work = 0; _error = ''; _offset = 0; _haslibrary = 0; _hasclassic = 0; _importb = 0
    _ready = 0; _nesting = nesting; _building = 0; _strictc = 0
    _parsepositionsready = 0
    _tree = .llast..tree.failed('LL_COMPILER_PARSE: no accepted source tree')
    if budget < 1 | budget > (9223372036854775807 <idiv> 64) then do
      _error = 'LL_COMPILER_LIMIT: frontend byte budget is not representable'; _ready = 1; return
    end
    _bytebudget = budget * 64
    return
  /** Borrow only an external anchored snapshot; no self-reference is retained. */
  bound: factory
    arg source = .binary, providers = reference .llcbindings..prepared, filename = '<source>', budget = 1000000, nesting = 512
    empty_mapping = .llcsrcmap..prepared; _mapping = empty_mapping
    _source = source; _originalsource = source; _filename = llcompilercontracts..sourcename(filename); _rootpath = ''; _providers = providers; _bound = 1
    _budget = budget; _work = 0; _error = ''; _offset = 0; _haslibrary = 0; _hasclassic = 0; _importb = 0
    _ready = 0; _nesting = nesting; _building = 0; _strictc = 0
    _parsepositionsready = 0
    _tree = .llast..tree.failed('LL_COMPILER_PARSE: no accepted source tree')
    if budget < 1 | budget > (9223372036854775807 <idiv> 64) then do
      _error = 'LL_COMPILER_LIMIT: frontend byte budget is not representable'; _ready = 1; return
    end
    _bytebudget = budget * 64
    return
  run: method = .void
    if _ready then return
    _ready = 1
    do
      if _bound then do
        if <refvalid>(_providers) = 0 then do; _error = 'LL_COMPILER_IMPORT: provider owner is not live'; return; end
        providers = dereference _providers
        if initialized(providers) = 0 then do; _error = 'LL_COMPILER_IMPORT: provider owner is not initialized'; return; end
        if providers.status() then do; _error = providers.error(); return; end
        _rootpath = providers.root()
      end
      _originalsource = _source
      parsed = .llcparse..parsed(_source,_budget,_filename)
      _source = parsed.bytes(); _mapping = parsed.mapping()
      if parsed.status() <> 0 then do
        _error = parsed.error(); _offset = parsed.offset(); return
      end
      _strictc = parsed.strictc()
      _tree = parsed.ast()
      if _tree.isrecovered() then do
        _error = 'LL_COMPILER_RECOVERED: executable IR requires clean input'; return
      end
      walk = _tree.walk('parents first'); hascommands = 0
      do while walk.next()
        if walk.depth() > _nesting then do
          call fail(walk.node(),'LIMIT: AST nesting budget exceeded'); return
        end
        if walk.node().kind() = 'CCommand' then hascommands = 1
        if wordpos(walk.node().kind(),'CSignal CSignalValue CSignalOn CSignalOff CCallOn CCallOff') > 0 then _hassignal = 1
      end
      _entrybytes = 0
      if hascommands then call sourcewarnings(reference parsed)
      if _error <> '' then return
      call addressplans(reference parsed)
      if _error <> '' then return
      _registry = .llir..schema(); call llcir..registerfamilies(reference _registry)
      call inventory()
      if _error <> '' then return
      _contract = _registry.finish()
      if _contract.error() <> '' then do
        _error = _contract.error(); return
      end
      _builder = .llir..builder(_contract,_budget,_bytebudget)
      _building = 1
      _file = _builder.source(_filename,_source)
      if _error <> '' then return
      call lowerall()
      if _error <> '' then return
      _graph = _builder.finish()
      if _graph.error() <> '' then _error = _graph.error()
      if _error = '' then do
        _entryproof = .llcprocedureprotocol..checked(reference _graph,_bytebudget,_budget)
        if _entryproof.status() then do; _error = _entryproof.error(); _offset = _entryproof.offset(); end
        if _error = '' then do
          _signalproof = .llcsignalprotocol..checked(reference _graph,reference _entryproof,_bytebudget,_budget)
          if _signalproof.status() then do; _error = _signalproof.error(); _offset = _signalproof.offset(); end
        end
        if _error = '' then do
          commands = .llccommandprotocol..checked(reference _graph,reference _entryproof,_bytebudget,_budget)
          if commands.status() then do; _error = commands.error(); _offset = commands.offset(); end
        end
        if _error = '' then do
          _loopproof = .llcdoprotocol..checked.withsignals(reference _graph,reference _entryproof,reference _signalproof,_bytebudget,_budget)
          if _loopproof.status() then do; _error = _loopproof.error(); _offset = _loopproof.offset(); end
        end
        if _error = '' then do
          _clauseproof = .llcclauseprotocol..checked(reference _graph,reference _entryproof,reference _loopproof,_bytebudget,_budget)
          if _clauseproof.status() then do; _error = _clauseproof.error(); _offset = _clauseproof.offset(); end
        end
      end
    on signal as problem
      if _building then _error = _builder.error()
      if _signalbuilding & left(_error,18) = 'LL_RESOURCE_LIMIT:' then _error = 'LL_COMPILER_LIMIT: frontend SIGNAL construction IR budget exceeded'
      if _error = '' then _error = 'LL_COMPILER_INVALID: ' || problem.message()
    end
    return
  error: method = .string
    call run()
    return _error
  /** Located user-facing message, with escaped source excerpt and caret. */
  diagnostic: method = .string
    call run()
    if _error = '' then return ''
    return llcdiagnostics..format(_source,_originalsource,_offset,_error,_filename,_mapping)
  status: method = .int
    call run()
    return _error <> ''
  bytes: method = .binary
    call run()
    return _source
  mapping: method = .llcsrcmap..prepared
    call run()
    return _mapping
  /** Owned completed source warnings survive later lowering failure. */
  warnings: method = .llcdiagnostics..warning[]
    call run()
    return _warnings
  /** Private synchronous borrows; the request remains the strong owner. */
  entryproof: method = reference .llcprocedureprotocol..checked
    call run()
    missing = reference .llcprocedureprotocol..checked
    if _error <> '' then return missing
    return reference _entryproof
  signalproof: method = reference .llcsignalprotocol..checked
    call run()
    missing = reference .llcsignalprotocol..checked
    if _error <> '' then return missing
    return reference _signalproof
  loopproof: method = reference .llcdoprotocol..checked
    call run()
    missing = reference .llcdoprotocol..checked
    if _error <> '' then return missing
    return reference _loopproof
  clauseproof: method = reference .llcclauseprotocol..checked
    call run()
    missing = reference .llcclauseprotocol..checked
    if _error <> '' then return missing
    return reference _clauseproof
  offset: method = .int
    call run()
    return _offset
  ast: method = .llast..tree
    call run()
    return _tree
  graph: method = .llir..module
    call run()
    if _error <> '' then do
      empty = .llir..schema(); contract = empty.finish()
      return llir..loadbinary(contract,''x as .binary)
    end
    return _graph
  fail: method = .void
    arg node = .llast..node, reason = .string
    if _error <> '' then return
    _error = 'LL_COMPILER_' || reason
    if node.valid() then _offset = node.offset()
    return
  tick: method = .int
    arg node = .llast..node
    _work = _work + 1
    if _work > _budget then call fail(node,'LIMIT: frontend work budget exceeded')
    return _error = ''
  at: method = .llir..origin
    arg node = .llast..node
    return _file.origin(node.start(),node.finish(),node.origin())
  findroutine: method = .int
    arg name = .string
    if namework(name) = 0 then return 0
    found = _routineids.get(name)
    if found = '' then return 0
    return found as .int
  namework: method = .int
    arg name = .string
    extent = <blen>(name as .binary)
    if extent > (_budget - _work) <idiv> 2 then do
      call fail(_tree.root(),'LIMIT: frontend label-name work budget exceeded'); return 0
    end
    _work = _work + extent * 2
    return _error = ''
  entryspace: method = .int
    arg count = .int, width = .int, reason = 'entry'
    if count < 0 | width < 1 then do; call fail(_tree.root(),'LIMIT: invalid frontend ' || reason || ' dimensions'); return 0; end
    if count > (_bytebudget - _entrybytes) <idiv> width then do
      call fail(_tree.root(),'LIMIT: frontend ' || reason || ' workspace exceeded'); return 0
    end
    _entrybytes = _entrybytes + count * width
    return 1
  /** Reserve the four sparse node-indexed label maps before any cell growth. */
  labelindex: method = .int
    arg node = .llast..node
    id = node.id()
    if id > _labelcapacity then do
      if entryspace(id - _labelcapacity,32,'label index') = 0 then return 0
      _labelcapacity = id
    end
    return id
  inventory: method = .void
    id = .int; i = .int
    root = _tree.root(); body = root.child('body')
    _routines[1] = .routine('$MAIN','result',body,1,body.count('items')) as .object
    _namespace = ''; _routineids = .stem(); _labelcapacity = 0; _signalrows = .stem()
    groups = .int[]; walk = _tree.walk('parents first')
    node = .llast..node; item = .llast..node; following = .llast..node
    do while walk.next() & _error = ''
      node = walk.node()
      if tick(node) = 0 then return
      level = walk.depth() + 1; grouped = 0
      if level > 1 then grouped = groups[level - 1]
      if node.kind() = 'CDo' | node.kind() = 'CSelect' then grouped = grouped + 1
      if entryspace(1,8,'label traversal') = 0 then return
      groups[level] = grouped
      /* Each source list is indexed once. Consecutive labels share only the
       * continuation of this list; a different IF arm has another list. */
      if node.kind() = 'Sequence' | node.kind() = 'CLabelled' then do
        field = 'items'; hasfollowing = 0; leader = 0
        if node.kind() = 'CLabelled' then do
          field = 'labels'; following = node.child('value'); hasfollowing = 1
        end
        do i = node.count(field) to 1 by -1 while _error = ''
          item = node.child(field,i)
          if tick(item) = 0 then return
          if item.kind() = 'CLabel' then do
            id = labelindex(item); if id = 0 then return
            if entryspace(1,32,'label continuation') = 0 then return
            if hasfollowing then _nextinstructions[id] = following as .object
            else _nextinstructions[id] = item as .object
          end
          else do; following = item; hasfollowing = 1; end
        end
        do i = 1 to node.count(field) while _error = ''
          item = node.child(field,i)
          if tick(item) = 0 then return
          if item.kind() = 'CLabel' then do
            id = labelindex(item); if id = 0 then return
            if leader = 0 then leader = id
            _labelleaders[id] = leader
          end
          else leader = 0
        end
      end
      if node.kind() = 'CSignalOn' | node.kind() = 'CCallOn' then call inventoryhandler(node)
      if node.kind() <> 'CLabel' then iterate
      id = labelindex(node); if id = 0 then return
      raw = node.text('name'); if namework(raw) = 0 then return
      name = rexxclassic_unicode_upper(raw)
      if namework(name) = 0 then return
      if entryspace(1,64,'label record') = 0 then return
      ordinal = _labelnodes[0] + 1; _labelnodes[ordinal] = node as .object
      _sourceentries[id] = 0
      if grouped > 0 then _labelleaders[id] = 0
      else if _labelleaders[id] = 0 then _labelleaders[id] = id
      if _routineids.get(name) <> '' then iterate
      if _hassignal then do
        if entryspace(128,1,'SIGNAL label') = 0 | entryspace(<blen>(name as .binary),2,'SIGNAL label') = 0 then return
        row = _signalnames[0] + 1
        _signalnames[row] = name; _signalnodes[row] = node; _signalids[row] = 0
        if grouped = 0 then _signalids[row] = _routines[0]
        call _signalrows.set(name,row as .string)
      end
      if entryspace(96,1,'label identity') = 0 then return
      if entryspace(<blen>(name as .binary),2,'label identity') = 0 then return
      if grouped > 0 then do
        call _routineids.set(name,'-1'); iterate
      end
      /* Every eligible label belongs to a Sequence or labelled-arm list.
       * Its explicit same-label sentinel denotes EOF, never an object default. */
      entry = _routines[0] + 1; following = _nextinstructions[id] as .llast..node
      _routines[entry] = .routine(name,'result',following,id,0) as .object
      _sourceentries[id] = entry
      call _routineids.set(name,entry as .string)
    end
    return
  /** One source-order declaration, retained independently of a pruned setter. */
  inventoryhandler: method = .void
    arg node = .llast..node
    target = .llast..node; name = .string
    condition = conditionid(node); ordinal = _handlernodes[0] + 1; id = node.id()
    name = word('SYNTAX ERROR FAILURE HALT NOTREADY NOVALUE LOSTDIGITS',condition)
    if node.count('target') then do
      target = node.child('target')
      if target.kind() = 'String' then name = stringliteral(target)
      else name = target.text('spelling')
    end
    if _error <> '' | namework(name) = 0 then return
    name = rexxclassic_unicode_upper(name)
    if namework(name) = 0 | entryspace(128,1,'SIGNAL handler') = 0 then return
    if entryspace(<blen>(name as .binary),2,'SIGNAL handler') = 0 then return
    if id > _handlercapacity then do
      if entryspace(id - _handlercapacity,8,'SIGNAL handler index') = 0 then return
      _handlercapacity = id
    end
    _handlernodes[ordinal] = node; _handlernames[ordinal] = name
    _handlerconditions[ordinal] = condition; _handlerordinals[id] = ordinal
    if node.kind() = 'CCallOn' then do; _handlermodes[ordinal] = 'C'; _callhandlers = _callhandlers + 1; end
    else do; _handlermodes[ordinal] = 'S'; _signalhandlers = _signalhandlers + 1; end
    return
  conditionid: method = .int
    arg node = .llast..node
    return wordpos(upper(node.child('condition').text('spelling')),'SYNTAX ERROR FAILURE HALT NOTREADY NOVALUE LOSTDIGITS')
  type: method = .llir..typeid
    arg name = .string
    if name = 'void' then return _contract.voidtype()
    if wordpos(name,'value context arguments result') > 0 then return _contract.type('crexx.c.' || name)
    return _contract.type('crexx.g.' || name)
  /** Only observed call masks create descriptors; no optional-subset expansion. */
  newblock: method = .llir..block
    arg purpose = .string
    _blocknumber = _blocknumber + 1
    return _fn.block(purpose || '.' || _blocknumber)
  temporary: method = .llir..slot
    arg type = .llir..typeid
    _tempnumber = _tempnumber + 1
    return _fn.slot('$tmp.' || _tempnumber,type)
  lowerall: method = .void
    i = .int; node = .llast..node; target = .llir..block; labelblock = .llir..block
    op = .llir..opdraft; built = .llir..opview
    _scope = 1; _current = _routines[1] as .routine
    _fn = _builder.function('$MAIN',type('result'))
    ignored = _fn.argument(type('context')); ignored = _fn.argument(type('int64'))
    _functions[1] = _fn as .object
    _blocknumber = 0; _tempnumber = 0; _loops = 0; _donumber = 0; _commandnumber = 0; _terminated = 0; _alive = 1
    body = _current.body(); origin = at(body).derive()
    _block = newblock('entry')
    if _mapping.active() then do
      op = _block.operation(_contract.operation('crexx.c.source.map'),origin)
      call op.attribute('original',_originalsource); call op.attribute('filename',_filename as .binary)
      built = op.finish()
    end
    _contextslot = _fn.slot('$context',type('context'))
    _entryslot = _fn.slot('$entry',type('int64'))
    call _block.store(_contextslot,_block.readarg(1,origin),origin)
    call _block.store(_entryslot,_block.readarg(2,origin),origin)
    if _hassignal then do
      _signalslot = _fn.slot('$signal.table',type('text'))
      tablebytes = signaltable()
      if _error <> '' then return
      call _block.store(_signalslot,_block.constantbytes(type('text'),tablebytes,origin),origin)
    end
    dispatch = newblock('entry.dispatch')
    if _signalhandlers > 0 then do
      _conditionblock = newblock('signal.exception')
      call _block.protect(dispatch,_conditionblock,origin)
    end
    else call _block.jump(dispatch,origin)
    mainbody = newblock('source.main')
    do i = 1 to _labelnodes[0] while _error = ''
      node = _labelnodes[i] as .llast..node
      if tick(node) = 0 then return
      id = node.id(); leader = _labelleaders[id]
      if leader = 0 then iterate
      if id = leader then labelblock = newblock('source.label')
      else labelblock = _sourceblocks[leader] as .llir..block
      _sourceblocks[id] = labelblock as .object
    end
    integer = .llir..intcodec(); landing = .llir..block; landingposition = 0
    do i = 1 to _routines[0] while _error = ''
      if tick(body) = 0 then return
      item = _routines[i] as .routine; target = mainbody; name = ''
      if i > 1 then do
        name = item.name(); labelid = item.first(); target = _sourceblocks[labelid] as .llir..block
        first = item.body(); j = first.id()
        if first.kind() <> 'CLabel' then do
          if first.kind() <> 'CProcedure' then do
            if j <> landingposition then do
              landing = newblock('entry.consume'); _block = landing; consumeorigin = at(first)
              op = _block.operation(_contract.operation('crexx.c.procedure.consume'),consumeorigin)
              call op.input('context',_block.load(_contextslot,consumeorigin)); built = op.finish()
              call _block.jump(target,origin); landingposition = j
            end
            target = landing
          end
        end
      end
      _block = dispatch
      op = _block.operation(_contract.operation('crexx.c.entry.test'),origin)
      call op.input('context',_block.load(_contextslot,origin)); call op.input('entry',_block.load(_entryslot,origin))
      call op.attribute('id',integer.parse((i - 1) as .string)); call op.attribute('name',name as .binary)
      built = op.finish(); next = newblock('entry.next')
      call _block.branch(built.result(),target,next,origin); dispatch = next
    end
    _block = dispatch
    op = _block.operation(_contract.operation('crexx.c.entry.invalid'),origin); built = op.finish()
    op = _block.operation(_contract.operation('crexx.c.return.absent'),origin); built = op.finish()
    call _block.returnvalue(built.result(),origin)
    _block = mainbody
    call statement(body)
    if _error <> '' then return
    if _terminated = 0 then do
      op = _block.operation(_contract.operation('crexx.c.return.absent'),origin); built = op.finish()
      call _block.returnvalue(built.result(),origin)
    end
    if _signalhandlers > 0 & _error = '' then call conditiondispatch(origin)
    return
  /** Length framing writes bytes once into the owned table; no source/table
   * is copied per semantic SIGNAL or per label lookup. */
  signalfield: method = .void
    arg target_ref = reference .binary, bytes = .binary
    target = dereference target_ref
    size = <blen>(bytes)
    if entryspace(size,2,'SIGNAL table') = 0 then return
    if size > _budget - _work then do; call fail(_tree.root(),'LIMIT: frontend SIGNAL table work budget exceeded'); return; end
    _work = _work + size
    assembler bappend target,bytes
    return
  signaltable: method = .binary
    bytes = .binary; i = .int; row = .int; found = .string; name = .string; node = .llast..node
    call signalfield(reference bytes,'43534947330A'x as .binary)
    call signalfield(reference bytes,((_signalnames[0] as .string) || ':') as .binary)
    do i = 1 to _signalnames[0] while _error = ''
      node = _signalnodes[i]; name = _signalnames[i]
      call signalfield(reference bytes,((<blen>(name as .binary) as .string) || ':') as .binary)
      call signalfield(reference bytes,name as .binary)
      call signalfield(reference bytes,((_signalids[i] as .string) || ':') as .binary)
      call signalfield(reference bytes,((<blen>(_filename as .binary) as .string) || ':') as .binary)
      call signalfield(reference bytes,_filename as .binary)
      call signalfield(reference bytes,((node.start() as .string) || ':') as .binary)
      call signalfield(reference bytes,((node.finish() as .string) || ':') as .binary)
    end
    call signalfield(reference bytes,((_handlernodes[0] as .string) || ':') as .binary)
    do i = 1 to _handlernodes[0] while _error = ''
      node = _handlernodes[i]; name = _handlernames[i]
      found = _signalrows.get(name); row = 0
      if found <> '' then row = found as .int
      _handlerrows[i] = row
      call signalfield(reference bytes,((i as .string) || ':') as .binary)
      call signalfield(reference bytes,('1:' || _handlermodes[i]) as .binary)
      call signalfield(reference bytes,((_handlerconditions[i] as .string) || ':') as .binary)
      call signalfield(reference bytes,((row as .string) || ':') as .binary)
      call signalfield(reference bytes,((<blen>(name as .binary) as .string) || ':') as .binary)
      call signalfield(reference bytes,name as .binary)
      call signalfield(reference bytes,((<blen>(_filename as .binary) as .string) || ':') as .binary)
      call signalfield(reference bytes,_filename as .binary)
      call signalfield(reference bytes,((node.start() as .string) || ':') as .binary)
      call signalfield(reference bytes,((node.finish() as .string) || ':') as .binary)
    end
    return bytes
  /** Mutable policy names an immutable table declaration; OFF has no target. */
  conditionpolicy: method = .void
    arg node = .llast..node
