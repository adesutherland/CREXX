/* cREXX License (MIT). Classic source-to-checked-IR service, implemented in B. */
options levelb
namespace llcfrontend expose request
import rxfnsb
import llast
import llir
import llsource
import llcir
import llcbifs
import llcparse
import llcparseprogram
import llcompilercontracts
import llcdoprotocol
import llcprocedureprotocol
import rexxclassicunicodeproperties

/** First source-unit entry identity and its result contract. */
routine: class
  _name = .string
  _result = .string
  _body = .llast..node
  _first = .int
  _last = .int
  *: factory
    arg identity = .string, type = .string, source = .llast..node, begin = .int, finish = .int
    _name = identity; _result = type; _body = source; _first = begin; _last = finish
    return
  name: method = .string
    return _name
  result: method = .string
    return _result
  body: method = .llast..node
    return _body
  first: method = .int
    return _first
  last: method = .int
    return _last
  endat: method = .void
    arg finish = .int
    _last = finish
    return
  resulttype: method = .void
    arg type = .string
    _result = type
    return

/** Atomic compilation request. A successful graph is published only after
 * source admission, binding, lowering and Level L verification all succeed.
 * Imports are read from an explicit artifact directory; no tool is spawned. */
request: class
  _source = .binary
  _filename = .string
  _rootpath = .string
  _nesting = .int
  _budget = .int
  _bytebudget = .int
  _parsepositions = .llsource..index
  _parsepositionsready = .int
  _strictc = .int
  _work = .int
  _ready = .int
  _building = .int
  _error = .string
  _offset = .int
  _tree = .llast..tree
  _graph = .llir..module
  _registry = .llir..schema
  _contract = .llir..contract
  _builder = .llir..builder
  _file = .llir..sourcefile
  _library = .llcompilercontracts..catalog
  _classic = .llcompilercontracts..catalog
  _hasclassic = .int
  _haslibrary = .int
  _importb = .int
  _namespace = .string
  _importnames = .string[]
  _importcatalogs = .object[]
  _externals = .string[]
  _externalsigs = .object[]
  _callnames = .string[]
  _callmasks = .string[]
  _callitems = .object[]
  _callsymbols = .string[]
  _callpackages = .string[]
  _routines = .object[]
  _routineids = .stem
  _entrybytes = .int
  _sourceentries = .int[]
  _nextinstructions = .int[]
  _functions = .object[]
  _current = .routine
  _scope = .int
  _fn = .llir..function
  _block = .llir..block
  _blocknumber = .int
  _tempnumber = .int
  _terminated = .int
  _alive = .int
  _loops = .int
  _breaks = .object[]
  _continues = .object[]
  _hasbreaks = .int[]
  _hascontinues = .int[]
  _breakalive = .int[]
  _continuealive = .int[]
  _loopkeys = .string[]
  _loopnames = .string[]
  _donumber = .int
  _bindscope = .int[]
  _bindnames = .string[]
  _bindtypes = .string[]
  _explicit = .int[]
  _slots = .object[]
  _contextslot = .llir..slot
  _entryslot = .llir..slot
  _sourceblocks = .object[]
  *: factory
    arg source = .binary, artifacts = '', filename = '<source>', budget = 1000000, nesting = 512
    _source = source; _filename = llcompilercontracts..sourcename(filename); _rootpath = artifacts
    _budget = budget; _work = 0; _error = ''; _offset = 0; _haslibrary = 0; _hasclassic = 0; _importb = 0
    _ready = 0; _nesting = nesting; _building = 0; _strictc = 0
    _parsepositionsready = 0
    _tree = .llast..tree.failed('LL_COMPILER_PARSE: no accepted source tree')
    if budget < 1 | budget > (9223372036854775807 <idiv> 64) then do
      _error = 'LL_COMPILER_LIMIT: frontend byte budget is not representable'; _ready = 1; return
    end
    _bytebudget = budget * 64
    return
  run: method = .void
    if _ready then return
    _ready = 1
    do
      parsed = .llcparse..parsed(_source,_budget)
      if parsed.status() <> 0 then do
        _error = parsed.error(); _offset = parsed.offset(); return
      end
      _strictc = parsed.strictc()
      _tree = parsed.ast()
      if _tree.isrecovered() then do
        _error = 'LL_COMPILER_RECOVERED: executable IR requires clean input'; return
      end
      walk = _tree.walk('parents first')
      do while walk.next()
        if walk.depth() > _nesting then do
          call fail(walk.node(),'LIMIT: AST nesting budget exceeded'); return
        end
      end
      _registry = .llir..schema(); call llcir..registerfamilies(reference _registry)
      call inventory()
      if _error <> '' then return
      _contract = _registry.finish()
      if _contract.error() <> '' then do
        _error = _contract.error(); return
      end
      _builder = .llir..builder(_contract,_budget,_bytebudget)
      _building = 1
      _file = _builder.source(_filename,_source)
      if _error <> '' then return
      call lowerall()
      if _error <> '' then return
      _graph = _builder.finish()
      if _graph.error() <> '' then _error = _graph.error()
      if _error = '' then do
        entries = .llcprocedureprotocol..checked(reference _graph,_bytebudget,_budget)
        if entries.status() then do; _error = entries.error(); _offset = entries.offset(); end
      end
      if _error = '' then do
        protocol = .llcdoprotocol..checked(reference _graph,_bytebudget,_budget)
        if protocol.status() then do; _error = protocol.error(); _offset = protocol.offset(); end
      end
    on signal as problem
      if _building then _error = _builder.error()
      if _error = '' then _error = 'LL_COMPILER_INVALID: ' || problem.message()
    end
    return
  error: method = .string
    call run()
    return _error
  /** Located user-facing message, with escaped source excerpt and caret. */
  diagnostic: method = .string
    call run()
    if _error = '' then return ''
    split = pos(':',_error)
    if split = 0 then return _filename || ': ' || llsource..diagnostic(_source,_offset,'LL_COMPILER_SYNTAX',_error)
    return _filename || ': ' || llsource..diagnostic(_source,_offset,left(_error,split - 1),strip(substr(_error,split + 1)))
  status: method = .int
    call run()
    return _error <> ''
  offset: method = .int
    call run()
    return _offset
  ast: method = .llast..tree
    call run()
    return _tree
  graph: method = .llir..module
    call run()
    if _error <> '' then do
      empty = .llir..schema(); contract = empty.finish()
      return llir..loadbinary(contract,''x as .binary)
    end
    return _graph
  fail: method = .void
    arg node = .llast..node, reason = .string
    if _error <> '' then return
    _error = 'LL_COMPILER_' || reason
    if node.valid() then _offset = node.offset()
    return
  tick: method = .int
    arg node = .llast..node
    _work = _work + 1
    if _work > _budget then call fail(node,'LIMIT: frontend work budget exceeded')
    return _error = ''
  at: method = .llir..origin
    arg node = .llast..node
    return _file.origin(node.start(),node.finish(),node.origin())
  findroutine: method = .int
    arg name = .string
    if namework(name) = 0 then return 0
    found = _routineids.get(name)
    if found = '' then return 0
    return found as .int
  namework: method = .int
    arg name = .string
    extent = <blen>(name as .binary)
    if extent > (_budget - _work) <idiv> 2 then do
      call fail(_tree.root(),'LIMIT: frontend label-name work budget exceeded'); return 0
    end
    _work = _work + extent * 2
    return _error = ''
  entryspace: method = .int
    arg count = .int, width = .int
    if count < 0 | width < 1 then do; call fail(_tree.root(),'LIMIT: invalid frontend entry dimensions'); return 0; end
    if count > (_bytebudget - _entrybytes) <idiv> width then do
      call fail(_tree.root(),'LIMIT: frontend entry workspace exceeded'); return 0
    end
    _entrybytes = _entrybytes + count * width
    return 1
  inventory: method = .void
    root = _tree.root(); body = root.child('body'); _entrybytes = 0
    if entryspace(body.count('items'),24) = 0 then return
    _routines[1] = .routine('$MAIN','result',body,1,body.count('items')) as .object
    _namespace = ''; _routineids = .stem()
    do i = 1 to body.count('items') while _error = ''
      node = body.child('items',i)
      if tick(node) = 0 then return
      if node.kind() <> 'CLabel' then iterate
      raw = node.text('name'); if namework(raw) = 0 then return
      name = rexxclassic_unicode_upper(raw)
      if namework(name) = 0 then return
      _sourceentries[i] = 0
      if _routineids.get(name) <> '' then iterate
      if entryspace(96,1) = 0 then return
      if entryspace(<blen>(name as .binary),2) = 0 then return
      entry = _routines[0] + 1
      _routines[entry] = .routine(name,'result',body,i,body.count('items')) as .object
      _sourceentries[i] = entry
      call _routineids.set(name,entry as .string)
    end
    return
  type: method = .llir..typeid
    arg name = .string
    if name = 'void' then return _contract.voidtype()
    if wordpos(name,'value context arguments result') > 0 then return _contract.type('crexx.c.' || name)
    return _contract.type('crexx.g.' || name)
  /** Only observed call masks create descriptors; no optional-subset expansion. */
  newblock: method = .llir..block
    arg purpose = .string
    _blocknumber = _blocknumber + 1
    return _fn.block(purpose || '.' || _blocknumber)
  temporary: method = .llir..slot
    arg type = .llir..typeid
    _tempnumber = _tempnumber + 1
    return _fn.slot('$tmp.' || _tempnumber,type)
  lowerall: method = .void
    i = .int; node = .llast..node; target = .llir..block; labelblock = .llir..block
    op = .llir..opdraft; built = .llir..opview
    _scope = 1; _current = _routines[1] as .routine
    _fn = _builder.function('$MAIN',type('result'))
    ignored = _fn.argument(type('context')); ignored = _fn.argument(type('int64'))
    _functions[1] = _fn as .object
    _blocknumber = 0; _tempnumber = 0; _loops = 0; _donumber = 0; _terminated = 0; _alive = 1
    body = _current.body(); origin = at(body).derive()
    _block = newblock('entry')
    _contextslot = _fn.slot('$context',type('context'))
    _entryslot = _fn.slot('$entry',type('int64'))
    call _block.store(_contextslot,_block.readarg(1,origin),origin)
    call _block.store(_entryslot,_block.readarg(2,origin),origin)
    dispatch = newblock('entry.dispatch'); call _block.jump(dispatch,origin)
    mainbody = newblock('source.main'); previouslabel = 0
    do i = 1 to body.count('items') while _error = ''
      node = body.child('items',i)
      if tick(node) = 0 then return
      if node.kind() = 'CLabel' then do
        if previouslabel = 0 then labelblock = newblock('source.label')
        _sourceblocks[i] = labelblock as .object
        previouslabel = 1
      end
      else previouslabel = 0
    end
    following = body.count('items') + 1
    do i = body.count('items') to 1 by -1
      if tick(body) = 0 then return
      if body.child('items',i).kind() = 'CLabel' then _nextinstructions[i] = following
      else following = i
    end
    integer = .llir..intcodec(); landing = .llir..block; landingposition = 0
    do i = 1 to _routines[0] while _error = ''
      if tick(body) = 0 then return
      item = _routines[i] as .routine; target = mainbody; name = ''
      if i > 1 then do
        name = item.name(); target = _sourceblocks[item.first()] as .llir..block
        j = _nextinstructions[item.first()]
        if j <= body.count('items') then do
          first = body.child('items',j)
          if first.kind() <> 'CProcedure' then do
            if j <> landingposition then do
              landing = newblock('entry.consume'); _block = landing; consumeorigin = at(first)
              op = _block.operation(_contract.operation('crexx.c.procedure.consume'),consumeorigin)
              call op.input('context',_block.load(_contextslot,consumeorigin)); built = op.finish()
              call _block.jump(target,origin); landingposition = j
            end
            target = landing
          end
        end
      end
      _block = dispatch
      op = _block.operation(_contract.operation('crexx.c.entry.test'),origin)
      call op.input('context',_block.load(_contextslot,origin)); call op.input('entry',_block.load(_entryslot,origin))
      call op.attribute('id',integer.parse((i - 1) as .string)); call op.attribute('name',name as .binary)
      built = op.finish(); next = newblock('entry.next')
      call _block.branch(built.result(),target,next,origin); dispatch = next
    end
    _block = dispatch
    op = _block.operation(_contract.operation('crexx.c.entry.invalid'),origin); built = op.finish()
    op = _block.operation(_contract.operation('crexx.c.return.absent'),origin); built = op.finish()
    call _block.returnvalue(built.result(),origin)
    _block = mainbody
    do i = 1 to body.count('items') while _error = ''
      node = body.child('items',i)
      if node.kind() = 'CLabel' then do
        target = _sourceblocks[i] as .llir..block
        if _block.id() <> target.id() then do
          if _terminated = 0 then call _block.jump(target,at(node).derive())
          _block = target; _terminated = 0
        end
        if _sourceentries[i] > 0 then _alive = 1
      end
      else call statement(node)
    end
    if _error <> '' then return
    if _terminated = 0 then do
      op = _block.operation(_contract.operation('crexx.c.return.absent'),origin); built = op.finish()
      call _block.returnvalue(built.result(),origin)
    end
    return
  procedurestatement: method = .void
    arg node = .llast..node
    origin = at(node)
    op = _block.operation(_contract.operation('crexx.c.procedure.enter'),origin)
    call op.input('context',_block.load(_contextslot,origin)); built = op.finish()
    if node.count('exposes') then do
      exposes = node.child('exposes'); boolean = .llir..boolcodec()
      do i = 1 to exposes.count('items') while _error = ''
        item = exposes.child('items',i); itemorigin = at(item)
        op = _block.operation(_contract.operation('crexx.c.procedure.expose'),itemorigin)
        call op.input('context',_block.load(_contextslot,itemorigin))
        call op.attribute('name',item.child('name').text('spelling') as .binary)
        call op.attribute('indirect',boolean.parse((item.kind() = 'ProcedureExposeIndirect') as .string))
        built = op.finish()
      end
    end
    return
  defaultvalue: method = .llir..valuehandle
    arg name = .string, origin = .llir..origin
    if name = 'text' | name = 'value' then return _block.constantbytes(type(name),''x as .binary,origin)
    return _block.constant(type(name),'0',origin)
  /** Classify only; the selected expression path still owns every visit and
   * literal check. Fallback expression lowering is never visited twice. */
  simpleliteral: method = .int
    arg node = .llast..node
    do forever
      kind = node.kind()
      if kind = 'Group' then node = node.child('value')
      else if kind = 'Chain' then do
        if node.count('operators') <> 0 | node.count('operands') <> 1 then return 0
        node = node.child('operands',1)
      end
      else return kind = 'String' | kind = 'Number' | kind = 'Constant'
    end
  statement: method = .void
    arg node = .llast..node
    if tick(node) = 0 then return
    i = .int
    origin = at(node); kind = node.kind(); value = .llir..valuehandle; op = .llir..opdraft; built = .llir..opview
    /* Visit structural/non-emitting statements without reopening a terminated
     * block. Later emitting statements still lower in checked dead code. */
    nonemitting = kind = 'Sequence' | kind = 'Block' | kind = 'Nop' | kind = 'CLabel'
    if kind = 'CDo' then do
      header = node.child('header')
      nonemitting = header.count('repetition') = 0 & header.count('condition') = 0
    end
    if kind = 'COptions' then do
      nonemitting = 1
      if node.count('value') then nonemitting = simpleliteral(node.child('value'))
    end
    if kind = 'CArg' then do
      nonemitting = 1; templates = node.child('templates')
      do i = 1 to templates.count('items')
        if templates.child('items',i).count('items') > 0 then nonemitting = 0
      end
    end
    if _terminated & nonemitting = 0 then do
      _block = newblock('unreachable'); _terminated = 0; _alive = 0
    end
    select
      when kind = 'Sequence' then do i = 1 to node.count('items') while _error = ''
        call statement(node.child('items',i))
      end
      when kind = 'Block' then call statement(node.child('body'))
      when kind = 'COptions' then do
        if node.count('value') then value = expression(node.child('value'),'',nonemitting)
      end
      when kind = 'Nop' | kind = 'CLabel' then nop
      when kind = 'CProcedure' then call procedurestatement(node)
      when kind = 'CDrop' then do i = 1 to node.count('items') while _error = ''
        item = node.child('items',i); itemorigin = at(item)
        if item.kind() <> 'DropDirect' & item.kind() <> 'DropIndirect' then do
          call fail(item,'PROFILE: invalid DROP item'); return
        end
        op = _block.operation(_contract.operation('crexx.c.drop'),itemorigin)
        call op.input('context',_block.load(_contextslot,itemorigin))
        call op.attribute('name',item.text('name') as .binary)
        boolean = .llir..boolcodec()
        call op.attribute('indirect',boolean.parse((item.kind() = 'DropIndirect') as .string))
        built = op.finish()
      end
      when kind = 'Assignment' then do
        do
          if node.count('value') then value = expression(node.child('value'))
          else value = defaultvalue('value',origin)
          if _error = '' then do
            op = _block.operation(_contract.operation('crexx.c.store'),origin)
            call op.input('context',_block.load(_contextslot,origin)); call op.input('value',value)
            call op.attribute('name',node.text('name') as .binary); built = op.finish()
          end
        end
      end
      when kind = 'Say' then do
        if node.count('value') then value = expression(node.child('value'))
        else value = defaultvalue('value',origin)
        if _error <> '' then return
        do
          op = _block.operation(_contract.operation('crexx.c.say'),origin); call op.input('value',value)
        end
        built = op.finish()
      end
      when kind = 'CSelect' then call selection(node)
      when kind = 'CDo' then call doloop(node)
      when kind = 'IfThen' | kind = 'IfElse' then do
        value = expression(node.child('condition')); if _error <> '' then return
        value = truth(value,origin)
        yes = newblock('if.yes'); no = newblock('if.no')
        join = .llir..block; hasjoin = .int; hasjoin = 0
        call _block.branch(value,yes,no,origin)
        incoming = _alive; _block = yes; _terminated = 0
        call statement(node.child('yes')); yesalive = _alive & _terminated = 0
        if _terminated = 0 then do
          join = newblock('if.join'); hasjoin = 1
          call _block.jump(join,origin)
        end
        _block = no; _terminated = 0; _alive = incoming
        if kind = 'IfElse' then call statement(node.child('no'))
        noalive = _alive & _terminated = 0
        if _terminated = 0 then do
          if hasjoin = 0 then do; join = newblock('if.join'); hasjoin = 1; end
          call _block.jump(join,origin)
        end
        /* Even dead open endpoints need structural closure. Closed arms need
         * no join; later dead source still follows the normal checked path. */
        if hasjoin then do; _block = join; _terminated = 0; end
        else _terminated = 1
        _alive = yesalive | noalive
      end
      when kind = 'Leave' | kind = 'Iterate' then call looptransfer(node,origin)
      when kind = 'Return' then do
        do
          if node.count('value') then do
            value = expression(node.child('value')); if _error <> '' then return
            op = _block.operation(_contract.operation('crexx.c.return.present'),origin); call op.input('value',value)
          end
          else do
            op = _block.operation(_contract.operation('crexx.c.return.empty'),origin)
            call op.input('context',_block.load(_contextslot,origin))
          end
          built = op.finish(); value = built.result()
          call closeactive(origin)
          call _block.returnvalue(value,origin)
        end
        _terminated = 1; _alive = 0
      end
      when kind = 'Exit' then do
        if node.count('value') then value = expression(node.child('value'),'int64')
        else value = _block.constantbytes(type('value'),'0' as .binary,origin)
        if _error <> '' then return

        call closeactive(origin)
        op = _block.operation(_contract.operation('crexx.' || 'c' || '.exit'),origin); call op.input('value',value); built = op.finish()
        /* EXIT never returns. The final core terminator closes the structural
         * block; it is unreachable after this explicitly diverging operation. */
        do
          op = _block.operation(_contract.operation('crexx.c.return.absent'),origin); built = op.finish()
          call _block.returnvalue(built.result(),origin)
        end
        _terminated = 1; _alive = 0
      end
      when kind = 'Invoke' | kind = 'InvokeQuoted' then value = invocation(node,0)
      when kind = 'Parse' | kind = 'CArg' then call parsestatement(node)
      when kind = 'CNumeric' then do
        setting = lower(node.text('setting'))
        if node.count('value') then value = expression(node.child('value'))
        else do
          initial = '9'; if setting = 'fuzz' then initial = '0'
          value = _block.constantbytes(type('value'),initial as .binary,origin)
        end
        if _error <> '' then return
        op = _block.operation(_contract.operation('crexx.c.numeric.' || setting),origin)
        call op.input('value',value); call op.input('context',_block.load(_contextslot,origin)); built = op.finish()
      end
      when kind = 'CForm' then do
        form = lower(node.text('form')); if form = '' then form = 'scientific'
        op = _block.operation(_contract.operation('crexx.c.numeric.form'),origin)
        call op.input('context',_block.load(_contextslot,origin)); call op.attribute('form',form as .binary); built = op.finish()
      end
      otherwise call fail(node,'PROFILE: unsupported statement ' || kind)
    end
    return
  /** PARSE and ARG share immutable, source-owned template packets. ARG keeps
   * its authored instruction identity and privately implies source ARG/UPPER.
   * The shared executor owns all live name reads and target writes. */
  parsestatement: method = .void
    arg node = .llast..node
    name = .llast..node; operand = .llast..node; item = .llast..node
    template = .llast..node; emptyorigin = .llir..origin
    op = .llir..opdraft; built = .llir..opview
    mode = .string; decoded = .string; movement = .int; code = .string; indexwork = .int
    source = .llast..node; templates = node.child('templates'); origin = at(node)
    kind = 'ARG'; upperflag = 1; value = .llir..valuehandle
    if node.kind() = 'Parse' then do
      source = node.child('source'); spelling = source.text('kind'); kind = ''
      if verify(spelling,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz') = 0 then kind = upper(spelling)
      if wordpos(kind,'ARG PULL SOURCE LINEIN VERSION VALUE VAR') = 0 then do
        code = '25.12'; if node.text('upper') <> '' then code = '25.13'
        call fail(source,'SYNTAX: RXC-LC-' || code || ': invalid PARSE type ' || spelling); return
      end
      uppertext = node.text('upper')
      if uppertext <> '' then do
        if verify(uppertext,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz') <> 0 | upper(uppertext) <> 'UPPER' then do
          call fail(node,'SYNTAX: invalid PARSE UPPER flag'); return
        end
      end
      upperflag = uppertext <> ''
    end
    select
      when kind = 'VALUE' then do
        if source.count('value') then value = expression(source.child('value'))
        else do
          /* VALUE is five authored ASCII bytes. Its end is a truthful empty
           * boundary before WITH, including intervening comments/trivia. */
          emptyorigin = _file.origin(source.start() + 5,source.start() + 5,source.origin())
          value = defaultvalue('value',emptyorigin)
        end
      end
      when kind = 'VAR' then value = expression(source.child('name'))
      when kind <> 'ARG' then value = parsesource(kind,0,origin)
      otherwise nop
    end
    if _error <> '' then return
    do ordinal = 1 to templates.count('items') while _error = ''
      template = templates.child('items',ordinal)
      /* Empty ARG positions advance the ordinal without reading arguments. */
      if kind = 'ARG' & template.count('items') = 0 then iterate
      if _parsepositionsready = 0 then do
        indexwork = _bytebudget
        if indexwork < 10000000 then indexwork = 10000000
        _parsepositions = .llsource..index(_source,_budget,_bytebudget,indexwork)
        if _parsepositions.error() <> '' then do
          call fail(node,'LIMIT: PARSE source index: ' || _parsepositions.error()); return
        end
        _parsepositionsready = 1
      end
      packet = .llcparseprogram..builder(_filename,_source,ordinal,upperflag,template.start(),template.finish(),node.start() + 1,_bytebudget)
      call packet.useindex(_parsepositions)
