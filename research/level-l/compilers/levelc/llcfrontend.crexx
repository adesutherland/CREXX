        item = template.child('items',itemindex)
        if tick(item) = 0 then return
        select item.kind()
          when 'ParseTarget' then do
            name = item.child('name'); call packet.target(name.text('spelling'),name.start(),name.finish())
          end
          when 'ParseDrop' then call packet.drop(item.start(),item.finish())
          when 'ParseLiteral' then do
            decoded = stringliteral(item.child('value'))
            if _error <> '' then return
            call packet.literal(decoded,item.start(),item.finish())
          end
          when 'ParseVariablePattern' then do
            name = item.child('name')
            call packet.input('LITERAL',name.text('spelling'),item.start(),item.finish(),name.start(),name.finish())
          end
          when 'ParsePosition' then do
            mode = item.text('mode'); operand = item.child('operand')
            select mode
              when '' then mode = 'ABS'
              when '=' then mode = 'ABS'
              when '+' then mode = 'PLUS'
              when '-' then mode = 'MINUS'
              otherwise do; call fail(item,'SYNTAX: invalid PARSE position mode'); return; end
            end
            if operand.kind() = 'Name' then call packet.input(mode,operand.text('spelling'),item.start(),item.finish(),operand.start(),operand.finish())
            else if operand.kind() = 'Number' then do
              movement = parseposition(operand)
              if _error <> '' then return
