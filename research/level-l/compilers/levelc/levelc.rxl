/* cREXX License (MIT). STEP03 Level C scalar/control/call profile. */
options levell
namespace llcgrammar

identifier: token = 1
number: token = 2
string: token = 3
separator: token = 4
open: token = 5
close: token = 6
comma: token = 7
colon: token = 8
typename: token = 9
labelname: token = 10
assign: token = 11 then tree assign()
plus: token = 12 then tree plus()
minus: token = 13 then tree minus()
times: token = 14 then tree times()
divide: token = 15 then tree divide()
concat: token = 16 then tree concat()
blank: token = 17 then tree blank()
abut: token = 18 then tree abut()
lt: token = 19 then tree lt()
gt: token = 20 then tree gt()
le: token = 21 then tree le()
ge: token = 22 then tree ge()
ne: token = 23 then tree ne()
strict: token = 24 then tree strict()
and: token = 25 then tree and()
or: token = 26 then tree or()
xor: token = 27 then tree xor()
not: token = 28 then tree not()
ifword: token = 29
thenword: token = 30
elseword: token = 31
doword: token = 32
endword: token = 33
whileword: token = 34
leaveword: token = 35
iterateword: token = 36
returnword: token = 37
exitword: token = 38
sayword: token = 39
callword: token = 40
nopword: token = 41
optionsword: token = 42
importword: token = 43
procedureword: token = 44
argword: token = 45
numericword: token = 46
digitsword: token = 47
fuzzword: token = 48
formword: token = 49
scientificword: token = 50
engineeringword: token = 51
asword: token = 52
dropword: token = 53
selectword: token = 54
whenword: token = 55
otherwiseword: token = 56
foreverword: token = 57
untilword: token = 58
toword: token = 59
byword: token = 60
forword: token = 61
docontrol: token = 62

comment: comments nested "/*" "*/"
scan: lexer input utf8
  digit: charset = U+0030 to U+0039
  letter: charset = unicode.gc.L | '!' | '?' | '_' | '@' | '#' | '$'
  hspace: charset = U+0009 | U+0020
  newline: charset = U+000A | U+000D
  squote.body: charset = (scalar except (U+0000 to U+001F | "'")) | U+0009
  dquote.body: charset = (scalar except (U+0000 to U+001F | '"')) | U+0009
  numeric: pattern = (digit+ ("." digit*)? | "." digit+) (("e" | "E") ("+" | "-")? digit+)?
  name: pattern = letter (letter | digit | ".")*
  reserved: pattern = "." (("m" | "M") ("n" | "N") | ("r" | "R") (("c" | "C") | ("s" | "S") | ("e" | "E") ("s" | "S") ("u" | "U") ("l" | "L") ("t" | "T")) | ("s" | "S") ("i" | "I") ("g" | "G") ("l" | "L"))
  whitespace: rule = hspace+ then skip
  numeric.literal: rule = numeric ("d" | "D")? then emit number
  name.literal: rule = name | reserved then emit identifier
  type.literal: rule = "." name then emit typename
  single.literal: rule = "'" (squote.body | "''")* "'" then emit string
  double.literal: rule = '"' (dquote.body | '""')* '"' then emit string
  terminator: rule = (newline | ";") then emit separator
  op.0: rule = "=" then emit assign
  op.1: rule = "+" then emit plus
  op.2: rule = "-" then emit minus
  op.3: rule = "*" then emit times
  op.4: rule = "/" then emit divide
  op.5: rule = "||" then emit concat
  op.6: rule = "(" then emit open
  op.7: rule = ")" then emit close
  op.8: rule = "," then emit comma
  op.9: rule = ":" then emit colon
  op.10: rule = "<" then emit lt
  op.11: rule = ">" then emit gt
  op.12: rule = "<=" then emit le
  op.13: rule = ">=" then emit ge
  op.14: rule = "<>" then emit ne
  op.15: rule = "==" then emit strict
  op.16: rule = "&" then emit and
  op.17: rule = "|" then emit or
  op.18: rule = "&&" then emit xor
  op.19: rule = "\" then emit not

parse: parser semantics contextfree input tokens start program backend lr1
  program: rule = statements as body then tree Program(body = body)
  statements: rule = separator* (statement as item (separator (statement as item)?)*)?
    then tree Sequence(items = item*)
  statement: rule = closed.statement | open.statement
  closed.statement: rule = simple | block | select.statement | if.closed
  open.statement: rule = if.open | if.continued
  if.closed: rule = ifword expression as condition thenword closed.statement as yes elseword closed.statement as no
    then tree IfElse(condition = condition, yes = yes, no = no)
  if.open: rule = ifword expression as condition thenword statement as yes
    then tree IfThen(condition = condition, yes = yes)
  if.continued: rule = ifword expression as condition thenword closed.statement as yes elseword open.statement as no
    then tree IfElse(condition = condition, yes = yes, no = no)
  select.statement: rule = selectword separator
    (separator | (label.statement as clause separator))*
    select.when as clause separator
    (separator | ((select.when | label.statement) as clause separator))*
    (select.otherwise as clause)? endword
    then tree CSelect(clauses = clause+)
  select.when: rule = whenword expression as condition thenword statement as body
    then tree CWhen(condition = condition, body = body)
  select.otherwise: rule = otherwiseword otherwise.body as body
    then tree COtherwise(body = body)
  otherwise.body: rule = (statement as item)? separator (separator | (statement as item separator))*
    then tree Sequence(items = item*)
  say.statement: rule = sayword (expression as value)? then tree Say(value = value?)
  call.statement: rule = callword identifier as name arguments as arguments then tree Invoke(name = text(name), arguments = arguments)
  return.statement: rule = returnword (expression as value)? then tree Return(value = value?)
  exit.statement: rule = exitword (expression as value)? then tree Exit(value = value?)
  leave.statement: rule = leaveword (name.value as name)? then tree Leave(name = name?)
  iterate.statement: rule = iterateword (name.value as name)? then tree Iterate(name = name?)
  nop.statement: rule = nopword then tree Nop()
  options.statement: rule = optionsword (expression as value)? then tree COptions(value = value?)
  block: rule = doword do.header as header separator statements as body do.end as ending
    then tree CDo(header = header, body = body, ending = ending)
  do.header: rule = (do.repetition as repetition)? (do.condition as condition)?
    then tree DoHeader(repetition = repetition?, condition = condition?)
  do.repetition: rule = do.control | do.count | do.forever
  do.count: rule = expression as value then tree DoCount(value = value)
  do.forever: rule = foreverword then tree DoForever()
  do.control: rule = do.name as name assign expression as initial (do.modifier as modifier)*
    then tree DoControl(name = name, initial = initial, modifiers = modifier*)
  do.name: rule = docontrol then tree Name(spelling = text)
  do.modifier: rule = (toword | byword | forword) as keyword expression as value
    then tree DoModifier(keyword = text(keyword), value = value)
  do.condition: rule = do.while | do.until
  do.while: rule = whileword expression as value then tree DoWhile(value = value)
  do.until: rule = untilword expression as value then tree DoUntil(value = value)
  do.end: rule = endword (name.value as name)? then tree DoEnd(name = name?)
  expression: rule = logical.or
  logical.or: rule = logical.and as item ((or | xor) as op logical.and as item)*
    then tree Chain(operands = item+, operators = op*)
  logical.and: rule = comparison as item (and as op comparison as item)*
    then tree Chain(operands = item+, operators = op*)
  comparison: rule = concatenation as item ((assign | ne | lt | gt | le | ge | strict) as op concatenation as item)*
    then tree Chain(operands = item+, operators = op*)
  concatenation: rule = additive as item ((concat | blank | abut) as op additive as item)*
    then tree Chain(operands = item+, operators = op*)
  additive: rule = multiplicative as item ((plus | minus) as op multiplicative as item)*
    then tree Chain(operands = item+, operators = op*)
  multiplicative: rule = unary as item ((times | divide) as op unary as item)*
    then tree Chain(operands = item+, operators = op*)
  unary: rule = prefix | cast.value
  prefix: rule = (plus | minus | not) as op unary as value then tree Prefix(operator = op, value = value)
  primary: rule = number.value | string.value | name.value | call.value | group.value
  number.value: rule = number then tree Number(spelling = text)
  string.value: rule = string then tree String(spelling = text)
  name.value: rule = identifier then tree Name(spelling = text)
  group.value: rule = open expression as value close then tree Group(value = value)
  call.value: rule = identifier as name open arguments as arguments close then tree Call(name = text(name), arguments = arguments)
  arguments: rule = argument as item (comma argument as item)* then tree Arguments(items = item+)
  argument: rule = (expression as value)? then tree Argument(value = value?)
  simple: rule = assignment | say.statement | call.statement | return.statement | exit.statement | leave.statement | iterate.statement | nop.statement | options.statement | arg.statement | label.statement | procedure.statement | numeric.statement | drop.statement
  drop.statement: rule = dropword drop.item as item (drop.item as item)* then tree CDrop(items = item+)
  drop.item: rule = drop.direct | drop.indirect
  drop.direct: rule = identifier as name then tree DropDirect(name = text(name))
  drop.indirect: rule = open identifier as name close then tree DropIndirect(name = text(name))
  assignment: rule = identifier as name assign (expression as value)? then tree Assignment(name = text(name), value = value?)
  cast.value: rule = primary
  label.statement: rule = labelname as name colon then tree CLabel(name = text(name))
  procedure.statement: rule = procedureword then tree CProcedure()
  arg.statement: rule = argword arg.target as item (comma arg.target as item)* then tree CArg(items = item+)
  arg.target: rule = (identifier as name)? then tree ArgTarget(name = text)
  numeric.statement: rule = numeric.value | numeric.form
  numeric.value: rule = numericword (digitsword | fuzzword) as setting (expression as value)? then tree CNumeric(setting = text(setting), value = value?)
  numeric.form: rule = numericword formword numeric.form.value
  numeric.form.value: rule = (scientificword | engineeringword)? then tree CForm(form = text)
