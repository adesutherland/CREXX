/* cREXX License (MIT). Owned semantic family registration. */
options levelb
namespace llcir expose registerfamilies
import rxfnsb
import llir
import llscalar

/** Register this frontend's operations. Shared scalar types carry typed ABI
 * attributes; no other language's operations or frontend are loaded. */
registerfamilies: procedure = .void
  arg registry = reference .llir..schema
  schema = dereference registry
  g = schema.family('crexx.g',1)
  integer = g.type('int64',.llir..intcodec() as .object)
  text = g.type('text',.llscalar..textcodec() as .object)
  c = schema.family('crexx.c',12)
  value = c.type('value',.llir..bytescodec() as .object)
  context = c.type('context',.llir..bytescodec() as .object)
  op = c.operation('add')
  call op.input('left',value); call op.input('right',value); call op.input('context',context)
  call op.output('value',value)
  call op.state('context'); call op.failure('condition'); call op.termination('returns')
  /* No Classic evaluator is registered until its exact contextual operation
   * contract is implemented. A cached host numeric setting is never a fact. */
  op = c.operation('say')
  call op.input('value',value)
  call op.state('output'); call op.failure('conversion.io'); call op.termination('returns')
  types = .object[]
  types[1] = integer as .object; types[2] = text as .object
  types[6] = value as .object; types[7] = context as .object
  types[9] = c.type('arguments',.llir..bytescodec() as .object) as .object
  types[10] = c.type('result',.llir..bytescodec() as .object) as .object
  types[11] = schema.boolean() as .object
  types[12] = c.type('parseprogram',.llir..bytescodec() as .object) as .object
  k = .int; name = .string
  call llscalar..declare(c,'load',types,'context:7',6,'name:2','context','condition')
  call llscalar..declare(c,'store',types,'context:7 value:6',0,'name:2','context','condition')
  call llscalar..declare(c,'drop',types,'context:7',0,'name:2 indirect:11','context','condition')
  do k = 1 to 16
    name = word('sub mul div eq ne lt le gt ge strict concat blank abut and or xor',k)
    call llscalar..declare(c,name,types,'left:6 right:6 context:7',6,'','context','condition')
  end
  do k = 1 to 3
    call llscalar..declare(c,word('positive negative not',k),types,'value:6 context:7',6,'','context','condition')
  end
  call llscalar..declare(c,'truth',types,'value:6 context:7',11,'','context','condition')
  call llscalar..declare(c,'numeric.digits',types,'value:6 context:7',0,'','context','condition')
  call llscalar..declare(c,'numeric.fuzz',types,'value:6 context:7',0,'','context','condition')
  call llscalar..declare(c,'numeric.form',types,'context:7',0,'form:2','context','condition')
  call llscalar..declare(c,'digits',types,'context:7',6,'','context','condition')
  call llscalar..declare(c,'arguments.empty',types,'',9,'','none','resource')
  call llscalar..declare(c,'arguments.append',types,'arguments:9 value:6 present:11',9,'','none','resource')
  call llscalar..declare(c,'arguments.count',types,'context:7',6,'','context','condition')
  call llscalar..declare(c,'arguments.exists',types,'context:7 ordinal:6 option:6',6,'','context','condition')
  call llscalar..declare(c,'return.present',types,'value:6',10,'','none','resource')
  call llscalar..declare(c,'return.absent',types,'',10,'','none','resource')
  call llscalar..declare(c,'requirevalue',types,'result:10',6,'name:2','none','missing.result')
  call llscalar..declare(c,'setresult',types,'context:7 result:10',0,'','context','condition')
  call llscalar..declare(c,'call',types,'arguments:9 context:7',10,'target:2 entry:1 function:11','context.output','condition')
  call llscalar..declare(c,'length',types,'value:6 context:7',6,'','context','condition')
  call llscalar..declare(c,'exit',types,'result:10 context:7',0,'','context','condition.resource','diverges')
  call llscalar..declare(c,'when.truth',types,'value:6 context:7',11,'','context','condition')
  call llscalar..declare(c,'select.missing',types,'',0,'','none','condition','diverges')
  call llscalar..declare(c,'do.new',types,'context:7',0,'key:2 name:2','loop.context','condition.resource')
  call llscalar..declare(c,'do.capture',types,'value:6',0,'key:2 part:2','loop.context','condition')
  call llscalar..declare(c,'do.start',types,'',0,'key:2','loop.context','condition')
  call llscalar..declare(c,'do.entry',types,'',11,'key:2','loop.context','condition')
  call llscalar..declare(c,'do.advance',types,'',0,'key:2','loop.context','condition')
  call llscalar..declare(c,'do.close',types,'',0,'key:2','loop','none')
  call llscalar..declare(c,'while.truth',types,'value:6 context:7',11,'','context','condition')
  call llscalar..declare(c,'until.truth',types,'value:6 context:7',11,'','context','condition')
  call llscalar..declare(c,'transfer.invalid',types,'',0,'code:2 name:2','none','condition','diverges')
  call llscalar..declare(c,'parse.source',types,'context:7',6,'kind:2 ordinal:1','context.input','condition.resource')
  call llscalar..declare(c,'parse.execute',types,'context:7 source:6',0,'program:12','context.input.output.observation','condition.resource')
  call llscalar..declare(c,'entry.test',types,'context:7 entry:1',11,'id:1 name:2','context','condition')
  call llscalar..declare(c,'entry.invalid',types,'',0,'','none','condition','diverges')
  call llscalar..declare(c,'procedure.consume',types,'context:7',0,'','context','condition')
  call llscalar..declare(c,'procedure.enter',types,'context:7',0,'','context','condition.resource')
  call llscalar..declare(c,'procedure.expose',types,'context:7',0,'name:2 indirect:11','context','condition.resource')
  call llscalar..declare(c,'return.empty',types,'context:7',10,'','context','condition.resource')
  call llscalar..declare(c,'bif',types,'arguments:9 context:7',6,'name:2','context.input.output.observation','condition.resource')
  call llscalar..declare(c,'call.missing',types,'arguments:9 context:7',10,'name:2','context','condition')
  call llscalar..declare(c,'program.exiting',types,'context:7',11,'','context','condition')
  call llscalar..declare(c,'call.external',types,'arguments:9 context:7',10,'target:2','context.input.output.observation','condition.resource')
  return
