/* cREXX License (MIT). Explicit static provider selections, owned by C. */
options levelb
namespace llcbindings expose binding definition prepared
import rxfnsb
import llbinmeta
import llcompilercontracts
import rexxclassicunicodeproperties
import rxcontract

/** One explicit artifact stem and fully qualified callable identity. */
binding: class
  _artifact = .string
  _callable = .string
  _sourcekind = .string
  *: factory
    arg artifact = .string, callable = .string
    _artifact = artifact; _callable = callable; _sourcekind = 'rxbin'
    return
  native: factory
    arg artifact = .string, callable = .string
    _artifact = artifact; _callable = callable; _sourcekind = 'native'
    return
  process: factory
    arg alias = .string, executable = .string
    _artifact = executable; _callable = alias; _sourcekind = 'process'
    return
  sourcekind: method = .string
    return _sourcekind
  artifact: method = .string
    return _artifact
  callable: method = .string
    return _callable

/** Owned metadata projection retained for checked dynamic-call catalogues. */
projectionrecord: class
  _fields = .string[]
  *: factory
    arg fields = .string[]
    _fields = fields
    return
  fields: method = .string[]
    return _fields

/** One immutable source-preparation definition. Its alias and canonical target
 * contain no live callable capability, artifact reader or activation owner.
 * @param name already selected full or basename alias
 * @param callable exact canonical target key
 * @param kind typed, classic or process
 * @param signature existing checked metadata for typed/Classic procedures
 */
definition: class
  _name = .string
  _callable = .string
  _kind = .string
  _signature = .llcompilercontracts..signature
  _hassignature = .int
  *: factory
    arg name = .string, callable = .string, kind = .string, ?signature = .llcompilercontracts..signature
    _name = name; _callable = callable; _kind = kind; _hassignature = ?signature
    if ?signature then _signature = signature
    return
  name: method = .string
    return _name
  callable: method = .string
    return _callable
  kind: method = .string
    return _kind
  hassignature: method = .int
    return _hassignature
  signature: method = .llcompilercontracts..signature
    return _signature
  /** Conservative definition/vector/map/snapshot bound, computed from the
   * existing owned fields before a consumer copies a definition vector. */
  bytes: method = .int
    amount = 512 + 4 * (<blen>(_name as .binary) + <blen>(_callable as .binary) + <blen>(_kind as .binary))
    if _hassignature = 0 then return amount
    signature = _signature
    amount = amount + 512 + 4 * (<blen>(signature.name() as .binary) + <blen>(signature.result() as .binary) + <blen>(signature.flags_text() as .binary))
    do i = 1 to signature.arguments()
      amount = amount + 256 + 4 * (<blen>(signature.paramname(i) as .binary) + <blen>(signature.type(i) as .binary) + <blen>(signature.defaultkind(i) as .binary) + <blen>(signature.defaultliteral(i) as .binary))
    end
    return amount

/** Immutable prepared selections. Images/readers exist only while their group
 * is selected; later queries own small checked records, never image snapshots.
 * Acquisition/projection limits retain LL_RESOURCE_LIMIT after charging their
 * returned counters; other metadata failures retain LL_COMPILER_IMPORT.
 * @param root explicit artifact directory
 * @param bindings ordered selections, not source files or a search path
 * @param bytes aggregate logical retained/acquired payload allowance
 * @param work aggregate logical acquisition/metadata/query allowance
 */
prepared: class
  _root = .string
  _input = .binding[]
  _artifacts = .string[]
  _callables = .string[]
  _signatures = .llcompilercontracts..signature[]
  _projections = .projectionrecord[]
  _rawarguments = .string[]
  _sizes = .int[]
  _kinds = .string[]
  _acquisitions = .string[]
  _providerids = .string[]
  _aliases = .stem
  _bytecap = .int
  _workcap = .int
  _bytes = .int
  _work = .int
  _ready = .int
  _error = .string
  _count = .int
  _snapshot = .int
  _definitions = .llcbindings..definition[]
  *: factory
    arg root = .string, bindings = .binding[], bytes = .int, work = .int
    _bytecap = bytes; _workcap = work; _count = bindings[0]; _snapshot = 0
    if bytes < 0 | work < 0 then do
      _error = 'LL_RESOURCE_LIMIT: provider allowance is negative'; _ready = 1; return
    end
    if pos('00'x as .string,root) > 0 | (bindings[0] > 0 & root = '') then do
      _error = 'LL_COMPILER_IMPORT: provider requires an explicit NUL-free artifact directory'; _ready = 1; return
    end
    extent = <blen>(root as .binary)
    if extent > bytes | extent > work then do
      _error = 'LL_RESOURCE_LIMIT: provider root payload'; _ready = 1; return
    end
    _bytes = extent; _work = extent; _root = root
    if bindings[0] > (bytes - _bytes) <idiv> 8 | bindings[0] > (work - _work) <idiv> 8 then do
      _error = 'LL_RESOURCE_LIMIT: provider binding vector'; _ready = 1; return
    end
    _bytes = _bytes + bindings[0] * 8; _work = _work + bindings[0] * 8
    item = .binding; stem = .string; name = .string
    do i = 1 to bindings[0]
      item = bindings[i]
      if initialized(item) = 0 then do
        _error = 'LL_COMPILER_IMPORT: uninitialized provider binding'; _ready = 1; return
      end
      stem = item.artifact(); name = item.callable()
      extent = <blen>(stem as .binary) + <blen>(name as .binary)
      if extent > _bytecap - _bytes - 16 then do
        _error = 'LL_RESOURCE_LIMIT: provider binding payload'; _ready = 1; return
      end
      _bytes = _bytes + 16 + extent
      if extent > (_workcap - _work) <idiv> 4 then do
        _error = 'LL_RESOURCE_LIMIT: provider binding copy work'; _ready = 1; return
      end
      _work = _work + extent * 4
    end
    _input = bindings
    return
  /** Prepare retained definitions only. Reuse the checked signature and C
   * calling-contract owners; no image/plugin acquisition or signature parsing
   * occurs. This snapshot supplies frontend admission, not backend link roots.
   * @param definitions immutable already selected aliases and target records
   * @param bytes logical retained metadata allowance
   * @param work logical copy/query allowance
   */
  snapshot: factory
    arg definitions = .llcbindings..definition[], bytes = 67108864, work = 1000000
    _bytecap = bytes; _workcap = work; _bytes = 0; _work = 0
    _ready = 0; _error = ''; _root = ''; _snapshot = 1; _count = definitions[0]; _definitions = definitions
    return
  preparesnapshot: method = .void
    _aliases = .stem()
    if _bytecap < 0 | _workcap < 0 then do; _error = 'LL_RESOURCE_LIMIT: provider allowance is negative'; return; end
    if reserve(64,1) = 0 then return
    if _count > (_bytecap - _bytes) <idiv> 64 | _count > (_workcap - _work) <idiv> 8 then do
      _error = 'LL_RESOURCE_LIMIT: provider snapshot vector'; return
    end
    if reserve(_count * 64,_count * 8) = 0 then return
    item = .llcbindings..definition; signature = .llcompilercontracts..signature
    name = .string; callable = .string; kind = .string; key = .string; route = .string
    amount = .int; extent = .int; i = .int; j = .int
    do i = 1 to _count
      item = _definitions[i]; name = item.name(); callable = item.callable(); kind = item.kind()
      extent = <blen>(name as .binary) + <blen>(callable as .binary)
      if reserve(extent,extent) = 0 then return
      if llbinmeta..validname(name) = 0 | llbinmeta..validname(callable) = 0 | wordpos(kind,'typed classic process') = 0 then do
        call fail('invalid retained provider definition'); return
      end
      if kind <> 'process' & pos('.',callable) = 0 then do; call fail('retained provider target must be qualified'); return; end
      key = rexxclassic_unicode_upper(name)
      if _aliases.get(key) <> '' then do; call fail('duplicate retained provider alias ' || name); return; end
      amount = 128 + extent
      if item.hassignature() then do
        signature = item.signature(); route = admitted(signature)
        if _error <> '' then return
        if kind = 'process' | route <> kind | signature.name() \== callable then do; call fail('retained provider signature differs from its target or route'); return; end
        if reserve(128,1) = 0 then return
        amount = amount + 128
        extent = <blen>((signature.result() || signature.flags_text()) as .binary)
        if reserve(extent,extent) = 0 then return
        amount = amount + extent
        do j = 1 to signature.arguments()
          extent = <blen>((signature.paramname(j) || signature.type(j) || signature.defaultkind(j) || signature.defaultliteral(j)) as .binary)
          if reserve(64 + extent,8 + extent) = 0 then return
          amount = amount + 64 + extent
        end
        _signatures[i] = signature
      end
      else do
        if kind = 'typed' then do; call fail('retained typed provider lacks checked metadata'); return; end
        _signatures[i] = .llcompilercontracts..signature.failed('LL_COMPILER_IMPORT: retained route has no procedure metadata')
      end
      call remember(reference _aliases,key,i as .string)
      if _error <> '' then return
      _callables[i] = callable; _kinds[i] = kind; _sizes[i] = amount
      _artifacts[i] = ''; _providerids[i] = ''; _rawarguments[i] = ''
    end
    return
  reserve: method = .int
    arg bytes = .int, work = .int
    if _error <> '' then return 0
    if bytes < 0 | bytes > _bytecap - _bytes then do
      _error = 'LL_RESOURCE_LIMIT: provider metadata.bytes'; return 0
    end
    _bytes = _bytes + bytes
    if work < 0 | work > _workcap - _work then do
      _error = 'LL_RESOURCE_LIMIT: provider metadata.work'; return 0
    end
    _work = _work + work
    return 1
  fail: method = .void
    arg reason = .string
    if _error = '' then _error = 'LL_COMPILER_IMPORT: ' || reason
    return
  /** Reserve before each bounded read/append. Fixed chunk temporaries are not
   * retained payload; actual acquired bytes and reserved read work never refund. */
  readimage: method = .binary
    arg artifact = .string
    image = .binary; chunk = .binary; fileid = 0; eof = 0; status = 0; closed = 0
    path = _root || '/' || artifact || '.rxbin'; mode = 'rb'
    assembler fopen fileid,path,mode
    if fileid = 0 then do; call fail('cannot open provider ' || artifact); return image; end
    do
    do while eof = 0 & _error = ''
      wanted = min(32768,_bytecap - _bytes,_workcap - _work)
      if wanted <= 0 then do
        ignored = reserve(1,1); leave
      end
      if reserve(0,wanted) = 0 then leave
      assembler freadb chunk,fileid,wanted
      size = <blen>(chunk)
      assembler ferror status,fileid
      assembler feof eof,fileid
      if status <> 0 | (size = 0 & eof = 0) then do; call fail('cannot read provider ' || artifact); leave; end
      if reserve(size,0) = 0 then leave
      if size > 0 then assembler bappend image,chunk
    end
    on signal as problem
      assembler fclose closed,fileid
      call fail('cannot read provider ' || artifact || ': ' || problem.name())
      return image
    end
    assembler fclose closed,fileid
    if closed <> 0 then call fail('cannot close provider ' || artifact)
    return image
  /** Charge each retained map projection before insertion/replacement. */
  remember: method = .void
    arg map_ref = reference .stem, key = .string, value = .string
    extent = <blen>(key as .binary) + <blen>(value as .binary)
    if reserve(32 + extent,4 + extent) = 0 then return
    map = dereference map_ref
    call map.set(key,value)
    return
  /** Retain the metadata owner's exact projection; no second signature parser. */
  retainprojection: method = .int
    arg index = .int, fields = .string[], arguments = .string
    amount = 16 + fields[0] * 8 + <blen>(arguments as .binary)
    do i = 1 to fields[0]
      extent = <blen>(fields[i] as .binary)
      if extent > _bytecap - amount then do; ignored = reserve(-1,0); return 0; end
      amount = amount + extent
    end
    if reserve(amount,amount) = 0 then return 0
    _projections[index] = .projectionrecord(fields); _rawarguments[index] = arguments
    return amount
  run: method = .void
    if _ready then return
    _ready = 1
    if _snapshot then do; call preparesnapshot(); return; end
    if _input[0] = 0 then return
    groups = .stem(); tails = .stem(); targets = .stem(); _aliases = .stem()
    next = .int[]; groupnames = .string[]; selected = .llbinmeta..callable[]
    item = .binding; stem = .string; name = .string; canonical = .string; key = .string
    known = .string; i = .int; n = .int; first = .int; tail = .int; group = .int
    image = .binary; reader = .llbinmeta..catalog; raw = .llbinmeta..callable
    signature = .llcompilercontracts..signature; extent = .int; ignored = .int
    fields = .string[]; projection = .string[]; route = .string; sourcekind = .string; retained = .int
    emptyreader = .llbinmeta..catalog
    do
      do i = 1 to _input[0]
        item = _input[i]
        if initialized(item) = 0 then do; call fail('uninitialized provider binding'); return; end
        stem = item.artifact(); name = item.callable(); sourcekind = item.sourcekind()
        extent = <blen>(stem as .binary) + <blen>(name as .binary)
        if extent > 2147483647 <idiv> 4 then do; ignored = reserve(-1,0); return; end
        if reserve(64 + extent,16 + extent * 4) = 0 then return
        if wordpos(sourcekind,'rxbin native process') = 0 then do; call fail('unknown binding acquisition kind'); return; end
        if sourcekind = 'process' then do
          if stem = '' | pos('00'x as .string,stem) > 0 then do; call fail('executable path must be nonempty and NUL-free'); return; end
        end
        else if stem = '' | stem == '.' | stem == '..' | pos('00'x as .string,stem) > 0 | pos('/',stem) > 0 | pos('\',stem) > 0 | pos(':',stem) > 0 then do
          call fail('provider artifact must be a nonempty stem'); return
        end
        if llbinmeta..validname(name) = 0 | (sourcekind <> 'process' & pos('.',name) = 0) then do
          call fail('provider callable must be a qualified metadata identity'); return
        end
        canonical = upper(name)
        if targets.get(canonical) <> '' then do; call fail('duplicate provider callable ' || name); return; end
        call remember(reference targets,canonical,i as .string)
        _artifacts[i] = stem; _callables[i] = name; next[i] = 0; _acquisitions[i] = sourcekind
        if sourcekind = 'process' then _kinds[i] = 'process'
        key = sourcekind || ':' || stem; known = groups.get(key)
        if sourcekind = 'process' then known = 'process'
        if known = '' then do
          call remember(reference groups,key,i as .string); call remember(reference tails,key,i as .string)
          if reserve(8 + <blen>(key as .binary),<blen>(key as .binary)) = 0 then return
          groupnames[groupnames[0] + 1] = key
        end
        else if sourcekind <> 'process' then do
          tail = tails.get(key) as .int; next[tail] = i
          call remember(reference tails,key,i as .string)
        end
        call alias(name,i)
        if _error <> '' then return
        key = substr(name,lastpos('.',name) + 1)
        if key <> '' & key \== name then call alias(key,i)
      end
      do group = 1 to groupnames[0]
        first = groups.get(groupnames[group]) as .int
        if _acquisitions[first] = 'native' then do
          n = first
          do while n > 0
            fields = rxcontract..acquire(_root || '/' || _artifacts[n] || '.rxplugin',_callables[n],_bytecap - _bytes,_workcap - _work)
            if fields[0] <> 13 then do; call fail('incomplete native metadata acquisition'); return; end
            if fields[1] \== 'rxnative1' then do; call fail('unknown native metadata acquisition'); return; end
            if reserve(fields[4] as .int,fields[5] as .int) = 0 then return
            if fields[2] == 'limit' then do; _error = 'LL_RESOURCE_LIMIT: native provider: ' || fields[3]; return; end
            if fields[2] \== 'ok' then do; call fail('native provider ' || fields[2] || ': ' || fields[3]); return; end
            if fields[6] = '' | fields[8] \== '0' | fields[9] <> '' then do; call fail('native binding requires an identified ordinary procedure'); return; end
            projection = rxcontract..project(fields[7],fields[10],fields[11],fields[12],fields[8] as .int,fields[13] as .int,_bytecap - _bytes,_workcap - _work)
            signature = project(projection)
            if _error <> '' then return
            route = admitted(signature)
            if route = '' then return
            extent = <blen>((fields[6] || fields[7] || fields[10] || fields[11] || fields[12]) as .binary)
            if reserve(128 + extent * 4,16 + extent * 4) = 0 then return
            _callables[n] = fields[7]; _providerids[n] = fields[6]; _kinds[n] = route; _sizes[n] = 128 + extent * 4
            retained = retainprojection(n,projection,fields[11]); if _error <> '' then return
            _sizes[n] = _sizes[n] + retained
            assembler move _signatures[n],signature
            assembler null signature
            n = next[n]
          end
          iterate
        end
        image = readimage(_artifacts[first])
        if _error <> '' then return
        reader = .llbinmeta..catalog.bounded(reference image,_bytecap - _bytes,_workcap - _work)
        n = first
        do while n > 0
          raw = reader.classify(_callables[n])
          if raw.error() <> '' | reader.error() <> '' then leave
          /* Transport the already charged owned result. No new checked
           * signature or C payload is constructed while this reader is live. */
          assembler move selected[n],raw
          assembler null raw
          n = next[n]
        end
        ignored = reserve(reader.consumed(),reader.work())
        if _error <> '' then return
        if n > 0 then do; call fail(raw.error()); return; end
        if reader.error() <> '' then do; call fail(reader.error()); return; end
        reader = emptyreader; image = ''x
        /* The complete group is selected/debited before C-owned copies use
         * the remaining allowance. No reader can spend that allowance again. */
        n = first
        do while n > 0
          held_ref = reference selected[n]
          held = dereference held_ref
          if held.kind() \== 'procedure' then do; call fail('provider is not an ordinary procedure: ' || _callables[n]); return; end
          arguments = held.arguments(); declared = held.result()
          extent = <blen>((arguments || declared) as .binary)
          if extent > 2147483647 <idiv> 16 then do; ignored = reserve(-1,0); return; end
          if reserve(0,extent * 16) = 0 then return
          extent = <blen>((held.name() || held.result() || held.arguments() || held.flags()) as .binary)
          if extent > 2147483647 <idiv> 4 then do; ignored = reserve(-1,0); return; end
          if reserve(128 + extent * 4,16 + extent * 4) = 0 then return
          projection = rxcontract..project(held.name(),declared,arguments,held.flags(),0,held.task(),_bytecap - _bytes,_workcap - _work)
          signature = project(projection)
          if _error <> '' then return
          route = admitted(signature)
          if route = '' then return
          _kinds[n] = route; _providerids[n] = ''
          _callables[n] = held.name(); _sizes[n] = extent * 4 + 128
          retained = retainprojection(n,projection,arguments); if _error <> '' then return
          _sizes[n] = _sizes[n] + retained
          assembler move _signatures[n],signature
          assembler null signature
          n = next[n]
        end
        /* End every scoped held borrow before releasing raw result owners. */
        n = first
        do while n > 0
          assembler null selected[n]
          n = next[n]
        end
      end
    on signal as problem
      call fail('provider preparation: ' || problem.name() || ': ' || problem.message())
    end
    return
  /** Native projection owns grammar; C owns the admitted calling contract. */
  project: method = .llcompilercontracts..signature
    arg fields = .string[]
    if fields[0] < 13 then do; call fail('incomplete metadata projection'); return .llcompilercontracts..signature.failed(_error); end
    if fields[1] \== 'rxcontract1' then do; call fail('unknown metadata projection'); return .llcompilercontracts..signature.failed(_error); end
    usedbytes = fields[6] as .int; usedwork = fields[7] as .int
    if reserve(usedbytes,usedwork) = 0 then return .llcompilercontracts..signature.failed(_error)
    if fields[2] == 'limit' then do; _error = 'LL_RESOURCE_LIMIT: provider signature ' || fields[3] || ': ' || fields[4]; return .llcompilercontracts..signature.failed(_error); end
    if fields[2] \== 'ok' then do; call fail('provider signature ' || fields[2] || ': ' || fields[3] || ': ' || fields[4]); return .llcompilercontracts..signature.failed(_error); end
    result = .llcompilercontracts..signature.projected(fields)
    if result.error() <> '' then call fail('provider signature: ' || result.error())
    return result
  admitted: method = .string
    arg signature = .llcompilercontracts..signature
    if signature.error() <> '' | signature.kind() <> 0 | signature.task() | signature.flags_text() \== 'b' then do
      call fail('provider requires an ordinary typed procedure'); return ''
    end
    if signature.result() == '.void' & signature.arguments() = 1 then do
      formal = signature.type(1)
      if (formal == '.rexxactivationarguments' | formal == '.rexxactivation..rexxactivationarguments') &,
         signature.optional(1) = 0 & signature.exposed(1) = 0 & signature.vararg(1) = 0 then return 'classic'
    end
    if signature.result() \== '.void' & scalar(signature.result()) = 0 then do; call fail('unsupported provider result type ' || signature.result()); return ''; end
    do j = 1 to signature.arguments()
      if scalar(signature.type(j)) = 0 then do; call fail('unsupported provider argument type ' || signature.type(j)); return ''; end
    end
    return 'typed'
  /** Positional source presence, including trailing holes, is known statically. */
  accept: method = .string
    arg index = .int, presence = .string
    j = .int
    call run()
    if _error <> '' then return _error
    if index < 1 | index > _kinds[0] then return 'invalid selected binding'
    if reserve(0,length(presence) + 1) = 0 then return _error
    if _kinds[index] = 'classic' then return ''
    if verify(presence,'01') <> 0 then return 'selected call requires statically known argument presence'
    if _kinds[index] = 'process' then do
      if pos('0',presence) > 0 then return 'executable arguments cannot be omitted'
      return ''
    end
    signature = _signatures[index]; count = signature.arguments(); fixed = count; variable = 0
    if count > 0 then variable = signature.vararg(count)
    if variable then fixed = fixed - 1
    if variable = 0 & length(presence) > fixed then return 'too many arguments for selected provider'
    do j = 1 to fixed
      if (j > length(presence) | substr(presence,j,1) = '0') & signature.optional(j) = 0 then return 'required provider argument is omitted at position ' || j
    end
    do j = fixed + 1 to length(presence)
      if substr(presence,j,1) \== '1' then return 'variadic provider arguments cannot be omitted'
    end
    return ''
  kind: method = .string
    arg index = .int
    call run()
    if _error <> '' | index < 1 | index > _kinds[0] then return ''
    return _kinds[index]
  provider: method = .string
    arg index = .int
    call run()
    if _error <> '' | index < 1 | index > _providerids[0] then return ''
    return _providerids[index]
  alias: method = .void
    arg key = .string, index = .int
    extent = <blen>(key as .binary)
    if extent > 2147483647 <idiv> 4 then do; ignored = reserve(-1,0); return; end
    if reserve(0,extent * 4) = 0 then return
    key = rexxclassic_unicode_upper(key)
    known = _aliases.get(key)
    if known <> '' then do
      if known as .int <> index then call remember(reference _aliases,key,'-1')
      return
    end
    call remember(reference _aliases,key,index as .string)
    return
  status: method = .int
    call run(); return _error <> ''
  error: method = .string
    call run(); return _error
  root: method = .string
    if _error <> '' then return ''
    extent = <blen>(_root as .binary)
    if reserve(extent,extent) = 0 then return ''
    return _root
  /** Number of explicitly selected immutable bindings. */
  count: method = .int
    call run(); if _error <> '' then return 0
    return _count
  sourceonly: method = .int
    return _snapshot
  usedbytes: method = .int
    call run()
    return _bytes
  workused: method = .int
    call run()
    return _work
  /** Exact owner-validated projection; process routes have no callable metadata. */
  projection: method = .string[]
    arg index = .int
    call run(); absent = .string[]
    if _error <> '' | _snapshot | index < 1 | index > _count then return absent
    if _kinds[index] = 'process' then return absent
    return _projections[index].fields()
  /** Original complete argument metadata, including default literals. */
  rawarguments: method = .string
    arg index = .int
    call run()
    if _error <> '' | index < 1 | index > _count then return ''
    return _rawarguments[index]
  find: method = .int
    arg name = .string
    call run()
    if _error <> '' | _count = 0 then return 0
    extent = <blen>(name as .binary)
    if extent > 2147483647 <idiv> 4 then do; ignored = reserve(-1,0); return 0; end
    if reserve(0,extent * 4 + 4) = 0 then return 0
    value = _aliases.get(rexxclassic_unicode_upper(name))
    if value = '' then return 0
    return value as .int
  artifact: method = .string
    arg index = .int
    call run()
    if _error <> '' | index < 1 | index > _artifacts[0] then return ''
    if reserve(<blen>(_artifacts[index] as .binary),<blen>(_artifacts[index] as .binary)) = 0 then return ''
    return _artifacts[index]
  callable: method = .string
    arg index = .int
    call run()
    if _error <> '' | index < 1 | index > _callables[0] then return ''
    if reserve(<blen>(_callables[index] as .binary),<blen>(_callables[index] as .binary)) = 0 then return ''
    return _callables[index]
  signature: method = .llcompilercontracts..signature
    arg index = .int
    call run()
    if _error <> '' then return .llcompilercontracts..signature.failed(_error)
    if index < 1 | index > _signatures[0] then return .llcompilercontracts..signature.failed('LL_COMPILER_IMPORT: invalid provider index')
    if reserve(_sizes[index],_sizes[index]) = 0 then return .llcompilercontracts..signature.failed(_error)
    return _signatures[index]

scalar: procedure = .int
  arg type = .string
  return wordpos(type,'.string .binary .int .float .decimal .boolean .rexxvalue .rexxvalue..rexxvalue') > 0
