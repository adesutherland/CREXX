/* cREXX License (MIT). C-owned direct Classic BIF binding catalogue. */
options levelb
namespace llcbifs expose entry activation
import rxfnsb

/** Select an existing shared named entry, never a runtime name dispatcher.
 * Names are exact uppercase Classic spellings; unknown names return empty. */
entry: procedure = .string
  arg name = .string
  names = 'ABBREV ABS ADDRESS ARG B2X BITAND BITOR BITXOR C2D C2X CENTER CENTRE CHANGESTR COMPARE CONDITION COPIES COUNTSTR D2C D2X DATATYPE DATE DELSTR DELWORD DIGITS ERRORTEXT FORM FORMAT FUZZ INSERT LASTPOS LEFT LENGTH LOWER MAX MIN OVERLAY POS QUEUED RANDOM REVERSE RIGHT SIGN SOURCELINE SPACE STRIP SUBSTR SUBWORD SYMBOL TIME TRACE TRANSLATE TRUNC UPPER VALUE VERIFY WORD WORDINDEX WORDLENGTH WORDPOS WORDS X2B X2C X2D XRANGE CHARIN CHAROUT CHARS LINEIN LINEOUT LINES QUALIFY STREAM UNICODEVERSION TONFD TONFC TONFKD TONFKC ISNFD ISNFC ISNFKD ISNFKC TOUPPERCASE TOLOWERCASE TOCASEFOLD TOSIMPLECASEFOLD TOTURKICCASEFOLD TOTURKICSIMPLECASEFOLD GRAPHEMECOUNT GRAPHEMEREVERSE GRAPHEMESUBSTR GRAPHEMEPOS ENCODE DECODE ISDECODABLE ISENCODINGSUPPORTED'
  symbols = 'rexxclassicbifabbrev.rexxclassicbif_abbrev rexxclassicbifabs.rexxclassicbif_abs rexxclassicbifaddress.rexxclassicbif_address_frame rexxclassicbifarg.rexxclassicbif_arg rexxclassicbifb2x.rexxclassicbif_b2x rexxclassicbifs.rexxclassicbif_bitand rexxclassicbifs.rexxclassicbif_bitor rexxclassicbifs.rexxclassicbif_bitxor rexxclassicbifc2d.rexxclassicbif_c2d rexxclassicbifc2x.rexxclassicbif_c2x rexxclassicbifcenter.rexxclassicbif_center rexxclassicbifcenter.rexxclassicbif_centre rexxclassicbifchangestr.rexxclassicbif_changestr rexxclassicbifcompare.rexxclassicbif_compare rexxclassicbifcondition.rexxclassicbif_condition rexxclassicbifcopies.rexxclassicbif_copies rexxclassicbifcountstr.rexxclassicbif_countstr rexxclassicbifd2c.rexxclassicbif_d2c rexxclassicbifd2x.rexxclassicbif_d2x rexxclassicbifdatatype.rexxclassicbif_datatype rexxclassicbifdate.rexxclassicbif_date rexxclassicbifdelstr.rexxclassicbif_delstr rexxclassicbifdelword.rexxclassicbif_delword rexxclassicbifnumeric.rexxclassicbif_digits rexxclassicbiferrortext.rexxclassicbif_errortext rexxclassicbifnumeric.rexxclassicbif_form rexxclassicbifformat.rexxclassicbif_format rexxclassicbifnumeric.rexxclassicbif_fuzz rexxclassicbifinsert.rexxclassicbif_insert rexxclassicbiflastpos.rexxclassicbif_lastpos rexxclassicbifleft.rexxclassicbif_left rexxclassicbiflength.rexxclassicbif_length rexxclassicbifs.rexxclassicbif_lower rexxclassicbifmax.rexxclassicbif_max rexxclassicbifmin.rexxclassicbif_min rexxclassicbifoverlay.rexxclassicbif_overlay rexxclassicbifpos.rexxclassicbif_pos rexxclassicbifqueued.rexxclassicbif_queued rexxclassicbifrandom.rexxclassicbif_random rexxclassicbifreverse.rexxclassicbif_reverse rexxclassicbifright.rexxclassicbif_right rexxclassicbifsign.rexxclassicbif_sign rexxclassicbifsourceline.rexxclassicbif_sourceline rexxclassicbifspace.rexxclassicbif_space rexxclassicbifstrip.rexxclassicbif_strip rexxclassicbifsubstr.rexxclassicbif_substr rexxclassicbifsubword.rexxclassicbif_subword rexxclassicbifsymbol.rexxclassicbif_symbol rexxclassicbiftime.rexxclassicbif_time rexxclassicbiftrace.rexxclassicbif_trace_frame rexxclassicbiftranslate.rexxclassicbif_translate rexxclassicbiftrunc.rexxclassicbif_trunc rexxclassicbifs.rexxclassicbif_upper rexxclassicbifvalue.rexxclassicbif_value rexxclassicbifverify.rexxclassicbif_verify rexxclassicbifword.rexxclassicbif_word rexxclassicbifwordindex.rexxclassicbif_wordindex rexxclassicbifwordlength.rexxclassicbif_wordlength rexxclassicbifwordpos.rexxclassicbif_wordpos rexxclassicbifwords.rexxclassicbif_words rexxclassicbifx2b.rexxclassicbif_x2b rexxclassicbifx2c.rexxclassicbif_x2c rexxclassicbifx2d.rexxclassicbif_x2d rexxclassicbifxrange.rexxclassicbif_xrange rexxclassicbifstream.rexxclassicbif_charin rexxclassicbifstream.rexxclassicbif_charout rexxclassicbifstream.rexxclassicbif_chars rexxclassicbifstream.rexxclassicbif_linein rexxclassicbifstream.rexxclassicbif_lineout rexxclassicbifstream.rexxclassicbif_lines rexxclassicbifstream.rexxclassicbif_qualify rexxclassicbifstream.rexxclassicbif_stream rexxclassicbifunicode.rexxclassicbif_unicodeversion rexxclassicbifunicode.rexxclassicbif_tonfd rexxclassicbifunicode.rexxclassicbif_tonfc rexxclassicbifunicode.rexxclassicbif_tonfkd rexxclassicbifunicode.rexxclassicbif_tonfkc rexxclassicbifunicode.rexxclassicbif_isnfd rexxclassicbifunicode.rexxclassicbif_isnfc rexxclassicbifunicode.rexxclassicbif_isnfkd rexxclassicbifunicode.rexxclassicbif_isnfkc rexxclassicbifunicode.rexxclassicbif_touppercase rexxclassicbifunicode.rexxclassicbif_tolowercase rexxclassicbifunicode.rexxclassicbif_tocasefold rexxclassicbifunicode.rexxclassicbif_tosimplecasefold rexxclassicbifunicode.rexxclassicbif_toturkiccasefold rexxclassicbifunicode.rexxclassicbif_toturkicsimplecasefold rexxclassicbifunicode.rexxclassicbif_graphemecount rexxclassicbifunicode.rexxclassicbif_graphemereverse rexxclassicbifunicode.rexxclassicbif_graphemesubstr rexxclassicbifunicode.rexxclassicbif_graphemepos rexxclassicbifunicode.rexxclassicbif_encode rexxclassicbifunicode.rexxclassicbif_decode rexxclassicbifunicode.rexxclassicbif_isdecodable rexxclassicbifunicode.rexxclassicbif_isencodingsupported'
  ordinal = wordpos(name,names)
  if ordinal = 0 then return ''
  if word(names,ordinal) \== name then return ''
  return word(symbols,ordinal)

/** These shared entries additionally receive the current activation. */
activation: procedure = .int
  arg name = .string
  return name == 'ARG' | name == 'ADDRESS' | name == 'CONDITION' | name == 'TRACE'
