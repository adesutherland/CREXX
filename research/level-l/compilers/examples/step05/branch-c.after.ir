function $MAIN -> crexx.c.result
  argument 1 crexx.c.context required
  entry.1:
    %1 = core.argument argument:1 @origin:2
    core.store %1 slot:$context @origin:2
    %2 = crexx.c.load %1 name="levelc" @origin:10
    %3 = core.constant 31 : crexx.c.value @origin:18
    %4 = core.load slot:$context @origin:11
    %5 = crexx.c.truth %3 %4 @origin:11
    core.jump -> if.yes.2 @origin:36
  if.yes.2:
    %6 = core.constant 796573 : crexx.c.value @origin:27
    crexx.c.say %6 @origin:20
    core.jump -> if.join.4 @origin:11
  if.join.4:
    %7 = crexx.c.return.absent @origin:2
    core.return %7 @origin:2
