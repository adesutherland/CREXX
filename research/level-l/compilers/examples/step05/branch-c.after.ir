function $MAIN -> crexx.c.result
  argument 1 crexx.c.context required
  entry.1:
    %1 = core.argument argument:1 @origin:2
    core.store %1 slot:$context @origin:2
    %2 = core.constant 31 : crexx.c.value @origin:11
    %3 = crexx.c.truth %2 %1 @origin:4
    core.jump -> if.yes.2 @origin:29
  if.yes.2:
    %4 = core.constant 796573 : crexx.c.value @origin:20
    crexx.c.say %4 @origin:13
    core.jump -> if.join.4 @origin:4
  if.join.4:
    %5 = crexx.c.return.absent @origin:2
    core.return %5 @origin:2
