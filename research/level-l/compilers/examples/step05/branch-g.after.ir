function $MAIN -> crexx.g.int64
  entry.1:
    core.jump -> if.yes.2 @origin:31
  if.yes.2:
    %1 = core.constant yes : crexx.g.text @origin:21
    crexx.g.say %1 @origin:13
    core.jump -> if.join.4 @origin:4
  if.join.4:
    %2 = core.constant 0 : crexx.g.int64 @origin:2
    core.return %2 @origin:2
