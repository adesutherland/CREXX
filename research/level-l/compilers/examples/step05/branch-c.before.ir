function $MAIN -> crexx.c.result
  argument 1 crexx.c.context required
  entry.1:
    %1 = core.argument argument:1 @origin:2
    core.store %1 slot:$context @origin:2
    %2 = core.constant 31 : crexx.c.value @origin:11
    %3 = core.load slot:$context @origin:4
    %4 = crexx.c.truth %2 %3 @origin:4
    %5 = core.constant true : core.boolean @origin:12
    core.branch %5 -> if.yes.2 -> if.no.3 @origin:4
  if.yes.2:
    %6 = core.constant 796573 : crexx.c.value @origin:20
    crexx.c.say %6 @origin:13
    core.jump -> if.join.4 @origin:4
  if.no.3:
    %7 = core.constant 6E6F : crexx.c.value @origin:28
    crexx.c.say %7 @origin:21
    core.jump -> if.join.4 @origin:4
  if.join.4:
    %8 = crexx.c.return.absent @origin:2
    core.return %8 @origin:2
