function $MAIN -> crexx.c.result
  argument 1 crexx.c.context required
  entry.1:
    %1 = core.argument argument:1 @origin:2
    core.store %1 slot:$context @origin:2
    %2 = core.load slot:$context @origin:10
    %3 = crexx.c.load %2 name="levelc" @origin:10
    %4 = core.constant 31 : crexx.c.value @origin:18
    %5 = core.load slot:$context @origin:11
    %6 = crexx.c.truth %4 %5 @origin:11
    %7 = core.constant true : core.boolean @origin:19
    core.branch %7 -> if.yes.2 -> if.no.3 @origin:11
  if.yes.2:
    %8 = core.constant 796573 : crexx.c.value @origin:27
    crexx.c.say %8 @origin:20
    core.jump -> if.join.4 @origin:11
  if.no.3:
    %9 = core.constant 6E6F : crexx.c.value @origin:35
    crexx.c.say %9 @origin:28
    core.jump -> if.join.4 @origin:11
  if.join.4:
    %10 = crexx.c.return.absent @origin:2
    core.return %10 @origin:2
