load r25,2
br llerror2
llerror2_3:
load r25,3
br llerror2
llerror2_4:
load r25,4
llerror2:
sighalt "CLASSIC_SYNTAX"
sighalt "DIVISION_BY_ZERO"
sighalt "CONVERSION_ERROR"
sighalt "INVALID_ARGUMENTS"
copy r28,r0
copy r29,r26
load r27,2
settp r28,768
settp r29,768
call r26,llctarget.failuremessage(),r27
null r28
null r29
beq llraise2_1,r25,1
beq llraise2_2,r25,2
beq llraise2_3,r25,3
llraise2_4:
signalorigin "INVALID_ARGUMENTS",r26,r0
ret
llraise2_3:
signalorigin "CONVERSION_ERROR",r26,r0
ret
llraise2_2:
signalorigin "DIVISION_BY_ZERO",r26,r0
ret
llraise2_1:
signalorigin "CLASSIC_SYNTAX",r26,r0
ret
