  entry.next.5:
    %6 = core.load slot:$context @origin:2
    %7 = core.load slot:$entry @origin:2
    %8 = crexx.c.entry.test %6 %7 id="1" name="PROBE" @origin:2
    core.branch %8 -> source.label.4 -> entry.next.6 @origin:2
  entry.next.6:
    crexx.c.entry.invalid @origin:2
