    %23 = core.load slot:$tmp.4 @origin:39
    %24 = core.load slot:$context @origin:39
    %25 = crexx.c.call %23 %24 target="$MAIN" entry="1" function="true" @origin:39
    %26 = crexx.c.requirevalue %25 name="PROBE" @origin:39
    %27 = core.load slot:$tmp.3 @origin:26
    %28 = core.load slot:$context @origin:26
    %29 = crexx.c.or %27 %26 %28 @origin:26
    crexx.c.say %29 @origin:25
    %30 = core.constant 30 : crexx.c.value @origin:47
    crexx.c.exit %30 @origin:40
    %31 = crexx.c.return.absent @origin:40
    core.return %31 @origin:40
  source.label.4:
    %32 = core.load slot:$context @origin:49
    crexx.c.procedure.enter %32 @origin:49
    %33 = core.constant 6576616C7561746564 : crexx.c.value @origin:57
    crexx.c.say %33 @origin:50
    %34 = core.constant 31 : crexx.c.value @origin:65
    %35 = crexx.c.return.present %34 @origin:58
