    %18 = core.load slot:$tmp.1 @origin:13
    %19 = core.load slot:$context @origin:13
    %20 = crexx.c.and %18 %17 %19 @origin:13
    crexx.c.say %20 @origin:11
    %21 = core.constant 31 : crexx.c.value @origin:32
    core.store %21 slot:$tmp.3 @origin:26
    %22 = crexx.c.arguments.empty @origin:39
