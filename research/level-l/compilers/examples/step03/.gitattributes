# Source excerpts deliberately retain trailing trivia; preserve generated bytes.
*.tree text eol=lf whitespace=-blank-at-eol
# Direct probe output includes its final printed newline.
*.ir text eol=lf whitespace=-blank-at-eof
# Diagnostic byte offsets depend on literal CRLF and UTF-8 source bytes.
syntax-error-g.crexx -text -whitespace
