function $MAIN -> crexx.c.result
  argument 1 crexx.c.context required
  argument 2 crexx.g.int64 required
  entry.1:
    %1 = core.argument argument:1 @origin:2
    core.store %1 slot:$context @origin:2
    %2 = core.argument argument:2 @origin:2
    core.store %2 slot:$entry @origin:2
    core.jump -> entry.dispatch.2 @origin:2
  entry.dispatch.2:
    %3 = core.load slot:$context @origin:2
    %4 = core.load slot:$entry @origin:2
    %5 = crexx.c.entry.test %3 %4 id="0" name="" @origin:2
    core.branch %5 -> source.main.3 -> entry.next.4 @origin:2
  source.main.3:
    %7 = core.load slot:$context @origin:10
    %8 = crexx.c.load %7 name="levelc" @origin:10
    %9 = core.constant 3031 : crexx.c.value @origin:18
    core.store %9 slot:$tmp.1 @origin:14
    %10 = core.constant 31 : crexx.c.value @origin:22
    %11 = core.load slot:$tmp.1 @origin:14
    %12 = core.load slot:$context @origin:14
    %13 = crexx.c.strict %11 %10 %12 @origin:14
    crexx.c.say %13 @origin:11
    %14 = core.constant 302E31 : crexx.c.value @origin:30
    core.store %14 slot:$tmp.2 @origin:28
    %15 = core.constant 302E32 : crexx.c.value @origin:32
    %16 = core.load slot:$tmp.2 @origin:28
    %17 = core.load slot:$context @origin:28
    %18 = crexx.c.add %16 %15 %17 @origin:28
    crexx.c.say %18 @origin:23
    %19 = core.constant 33 : crexx.c.value @origin:40
    %20 = core.load slot:$context @origin:33
    crexx.c.numeric.digits %19 %20 @origin:33
    %21 = core.constant 31 : crexx.c.value @origin:48
    core.store %21 slot:$tmp.3 @origin:47
    %22 = core.constant 33 : crexx.c.value @origin:49
    %23 = core.load slot:$tmp.3 @origin:47
    %24 = core.load slot:$context @origin:47
    %25 = crexx.c.div %23 %22 %24 @origin:47
    crexx.c.say %25 @origin:41
    %26 = core.constant 39 : crexx.c.value @origin:57
    %27 = core.load slot:$context @origin:50
    crexx.c.numeric.digits %26 %27 @origin:50
    %28 = core.constant 31 : crexx.c.value @origin:65
    core.store %28 slot:$tmp.4 @origin:64
    %29 = core.constant 33 : crexx.c.value @origin:66
    %30 = core.load slot:$tmp.4 @origin:64
    %31 = core.load slot:$context @origin:64
    %32 = crexx.c.div %30 %29 %31 @origin:64
    crexx.c.say %32 @origin:58
    %33 = core.load slot:$context @origin:74
    %34 = crexx.c.load %33 name="unassigned" @origin:74
    crexx.c.say %34 @origin:67
    %35 = core.constant 30 : crexx.c.value @origin:82
    crexx.c.exit %35 @origin:75
    %36 = crexx.c.return.absent @origin:75
    core.return %36 @origin:75
  entry.next.4:
    crexx.c.entry.invalid @origin:2
    %6 = crexx.c.return.absent @origin:2
    core.return %6 @origin:2

