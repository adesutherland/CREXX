/* cREXX License (MIT). Worked Classic AST, CFG and bounded proof consumer.
 * The normalizer and source-flow explanations belong to this example;
 * Level L supplies checked trees, IR, indexes and proof services. */
options levelb
import rxfnsb
import llast
import llir
import llirgraph
import llireffects
import llcfrontend
import llceffects

main: procedure = .int expose names
  arg argv = .string[]
  if argv[0] = 1 then if argv[1] = '--proof-controls' then return proofcontrols()
  if argv[0] <> 3 then do
    say 'usage: analyse source-file routine-name artifact-directory'
    return 2
  end
  source = readbinary(argv[1])
  front = .llcfrontend..request(source,argv[3],argv[2] || '.rexx')
  if front.status() <> 0 then do
    say 'ERROR|frontend|' || front.diagnostic()
    return 1
  end
  tree = front.ast(); body = tree.root().child('body')
  first = 0; last = body.count('items'); i = .int; node = .llast..node
  do i = 1 to body.count('items')
    node = body.child('items',i)
    if node.kind() <> 'CLabel' then iterate
    if first > 0 then do; last = i - 1; leave; end
    if upper(node.text('name')) = upper(argv[2]) then first = i + 1
  end
  if first = 0 | first > last then do; say 'ERROR|missing top-level routine label'; return 1; end
  label = body.child('items',first - 1)
  lastbyte = body.child('items',last).finish()
  say 'ROUTINE|' || argv[2] || '|line=' || label.line()
  names = .string[]; shape = ''
  do i = first to last
    node = body.child('items',i)
    call showtree(node,0)
    shape = shape || normalized(node,0)
  end
  say 'SHAPE|' || shape
  graph = front.graph()
  if graph.error() <> '' then do; say 'ERROR|IR|' || graph.error(); return 1; end
  index = .llirgraph..index(reference graph,1000000,67108864)
  if index.status() <> 'ok' then do; say 'ERROR|graph|' || index.message(); return 1; end
  loops = index.loops()
  if loops.status() <> 'ok' then do; say 'ERROR|loops|' || loops.message(); return 1; end
  live = index.liveness()
  if live.status() <> 'ok' then do; say 'ERROR|liveness|' || live.message(); return 1; end
  cyclic = 0
  do component = 1 to loops.components()
    if loops.cyclic(component) then cyclic = cyclic + 1
  end
  say 'IR|checked whole-source CFG; cyclic components=' || cyclic
  model = llceffects..model(reference graph)
  if model.valid() = 0 then do; say 'ERROR|effects|' || model.error(); return 1; end
  /* A real result/use in the exact C graph. Indexed uses do not by themselves
   * prove normal result availability through failure or callback boundaries. */
  found = 0
  do i = 1 to graph.operations()
    op = graph.operation(i); origin = op.origin()
    if op.name() <> 'crexx.c.div' | origin.first() < label.start() | origin.last() > lastbyte then iterate
    value = op.result(1)
    if index.uses(value.id()) = 0 then iterate
    useid = index.use(value.id(),1); consumer = graph.operation(useid)
    dominates = index.dominates(index.opblock(i),index.opblock(useid))
    fragment = compact(binsubstr(origin.sourcebytes(),origin.first() + 1,origin.last() - origin.first()) as .string)
    say 'CFG|' || fragment || ' result used by ' || consumer.name() || '; producer block dominates use block=' || dominates
    fnid = index.blockfunction(index.opblock(i))
    say 'LIVENESS|IR function ' || fnid || ' complete=' || live.complete(fnid) || '; this is not a Classic variable-pool proof'
    proof = .llireffects..proof(reference index,reference model,'available',i,useid,'',1)
    say 'PROOF|Classic division result available|' || proof.status() || '|' || proof.reason()
    found = 1; leave
  end
  if found = 0 then do; say 'ERROR|no division result/use found'; return 1; end
  say 'LIMIT|Numerical preconditions, convergence and all-input termination remain unknown.'
  return 0

compact: procedure = .string
  arg text = .string
  text = changestr('0A'x as .string,text,' ')
  text = changestr('0D'x as .string,text,' ')
  return strip(text)

/** The direct-LEAVE explanation is limited to the fixtures' flat loop body;
 * it is not a general Classic control-flow interpreter. */
showtree: procedure = .void
  arg node = .llast..node, depth = .int
  if depth > 128 then assembler signal 'ERROR','SLAM_DEMO: tree depth exceeded'
  kind = node.kind(); text = ''; visible = 1
  select kind
    when 'Assignment' then text = node.text('name') || ' = ' || compact(node.child('value').sourcetext())
    when 'IfThen' then text = compact(node.child('condition').sourcetext())
    when 'Return' then text = compact(node.sourcetext())
    when 'Leave' then text = compact(node.sourcetext())
    when 'CProcedure' then text = compact(node.sourcetext())
    when 'Parse' then text = compact(node.sourcetext())
    when 'CDo' then do
      header = node.child('header'); repetition = header.child('repetition')
      text = repetition.kind()
      if repetition.kind() = 'DoCount' then text = text || ' ' || compact(repetition.child('value').sourcetext())
      if repetition.kind() = 'DoControl' then text = text || ' ' || compact(repetition.sourcetext())
      call loopfacts(node)
    end
    otherwise visible = 0
  end
  if visible then say 'NODE|' || depth || '|' || node.line() || '|' || kind || '|' || text
  if kind = 'Chain' then do i = 1 to node.count('operators')
    operator = node.child('operators',i)
    if operator.kind() <> 'divide' then iterate
    divisor = node.child('operands',i + 1)
    verdict = literalnonzero(divisor)
    say 'OBLIGATION|' || operator.line() || '|nonzero divisor ' || compact(divisor.sourcetext()) || '|' || verdict || '|consumer rule for unsigned ASCII integer literals only'
  end
  children = node.each()
  do while children.next()
    call showtree(children.node(),depth + visible)
  end
  return

/** A small tree-level proof rule owned by this consumer. Transparent grammar
 * chains/groups preserve the literal. No floating arithmetic or variable-range
 * assumption is involved; other expressions remain unknown. */
literalnonzero: procedure = .string
  arg expression = .llast..node
  node = expression
  do depth = 1 to 128
    if node.kind() = 'Group' then do; node = node.child('value'); iterate; end
    if node.kind() = 'Chain' then do
      if node.count('operators') = 0 & node.count('operands') = 1 then do
        node = node.child('operands',1); iterate
      end
    end
    leave
  end
  if node.kind() <> 'Number' then return 'unknown'
  spelling = node.text('spelling')
  if spelling = '' | verify(spelling,'0123456789') <> 0 then return 'unknown'
  if verify(spelling,'0') = 0 then return 'disproved'
  return 'proved'

loopfacts: procedure = .void
  arg loopnode = .llast..node
  body = loopnode.child('body'); exits = 0
  do i = 1 to body.count('items')
    statement = body.child('items',i)
    if statement.kind() <> 'IfThen' then iterate
    yes = statement.child('yes')
    if yes.kind() <> 'Leave' then iterate
    if yes.count('name') <> 0 then iterate
    exits = exits + 1
    say 'FLOW|' || statement.line() || '|direct exit when ' || compact(statement.child('condition').sourcetext())
    do j = i + 1 to body.count('items')
      later = body.child('items',j)
      say 'FLOW|' || later.line() || '|this exit bypasses: ' || compact(later.sourcetext())
    end
  end
  header = loopnode.child('header'); repetition = header.child('repetition')
  if repetition.kind() = 'DoForever' & exits = 0 then say 'FLOW|' || loopnode.line() || '|no direct conditional LEAVE in this flat FOREVER body; missing-exit control is analysis only'
  return

/** Explicit shape policy, not semantic equivalence. Only simple local names
 * are renamed; calls, operators and literal spelling stay. Unknown forms fail. */
normalized: procedure = .string
  arg node = .llast..node, depth = .int
  if depth > 128 then assembler signal 'ERROR','SLAM_DEMO: shape depth exceeded'
  kind = node.kind(); text = ''
  allowed = 'CProcedure Parse ParseSource ParseTemplates ParseTemplate ParseTarget Name IfThen Assignment CDo DoHeader DoCount DoForever DoControl DoModifier DoEnd Sequence Chain Group Number String Constant Return Leave Call Arguments Argument Nop'
  operators = 'plus minus times divide integerdivide remainder power assign ne lt le gt ge strict strictne strictlt strictgt strictle strictge concat blank abut and or xor not'
  if wordpos(kind,allowed) = 0 & wordpos(kind,operators) = 0 then do
    message = 'SLAM_DEMO: unsupported shape kind ' || kind
    assembler signal 'ERROR',message
  end
  if kind = 'CProcedure' then if node.children() > 0 then assembler signal 'ERROR','SLAM_DEMO: EXPOSE is outside local rename policy'
  if kind = 'Name' then text = variable(node.text('spelling'))
  if kind = 'Assignment' then text = variable(node.text('name'))
  if wordpos(kind,'Number String Constant') > 0 then text = node.text('spelling')
  if kind = 'Call' then do
    text = upper(node.text('name'))
    if text <> 'ABS' then assembler signal 'ERROR','SLAM_DEMO: only ABS calls admitted by local shape policy'
  end
  if kind = 'ParseSource' then text = upper(node.text('kind'))
  if kind = 'Parse' then text = upper(node.text('upper'))
  if kind = 'DoModifier' then text = upper(node.text('keyword'))
  if kind = 'Chain' then if node.count('operators') = 0 then return normalized(node.child('operands',1),depth + 1)
  out = kind || '[' || length(text) || ':' || text || ']('
  children = node.each()
  do while children.next()
    out = out || normalized(children.node(),depth + 1)
    if length(out) > 65536 then assembler signal 'ERROR','SLAM_DEMO: shape size exceeded'
  end
  return out || ')'

variable: procedure = .string expose names
  arg name = .string
  name = upper(name)
  if name = '' | verify(name,'ABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789') <> 0 then assembler signal 'ERROR','SLAM_DEMO: rename policy requires simple local names'
  do i = 1 to names[0]
    if names[i] = name then return 'v' || i
  end
  call arrayappend names,name
  return 'v' || names[0]

/** Independent proof-API controls. The tiny IR's declared step contract does
 * not supply the semantics of Newton division or a Classic variable pool. */
proofcontrols: procedure = .int
  schema = .llir..schema(); family = schema.family('slam.demo',1)
  integer = family.type('integer',.llir..intcodec() as .object)
  action = family.operation('step'); call action.input('value',integer); call action.output('result',integer)
  call action.state('none'); call action.failure('none'); call action.termination('returns')
  contract = schema.finish(); draft = .llir..builder(contract)
  origin = draft.synthetic('proof API control; not the Classic numerical routine')
  fn = draft.function('control',contract.voidtype()); entry = fn.block('entry')
  one = entry.constant(integer,'1',origin); op = entry.operation(action,origin)
  call op.input('value',one); step = op.finish(); value = step.result(1)
  cell = fn.slot('estimate',integer); call entry.store(cell,value,origin); call entry.returnvoid(origin)
  graph = draft.finish()
  if graph.error() <> '' then do; say 'ERROR|control IR|' || graph.error(); return 1; end
  index = .llirgraph..index(reference graph)
  if index.status() <> 'ok' then do; say 'ERROR|control graph|' || index.message(); return 1; end
  generator = index.definition(one.id()); useid = index.nextop(step.id())
  failures = 0
  do mode = 1 to 3
    model = .llireffects..model(reference graph,'slam.demo.contract')
    if mode <> 3 then do
      summary = .llireffects..summary(1,1)
      call summary.operand(1,'value'); call summary.result(1,'normal')
      call summary.control('none','none','none')
      if mode = 1 then call summary.write('unrelated')
      else call summary.write('demo.estimate')
      sealed = summary.seal(); call model.put(step.id(),summary)
    end
    sealed = model.seal()
    if sealed = 0 then do; say 'ERROR|control model|' || model.error(); return 1; end
    proof = .llireffects..proof(reference index,reference model,'preserves',generator,useid,'demo.estimate')
    label = word('unrelated-write estimate-write missing-premise',mode)
    say 'CONTROL|' || label || '|' || proof.status() || '|' || proof.reason()
    if mode = 1 then do
      if proof.status() <> 'proved' | proof.matches(reference index,reference model) = 0 then failures = failures + 1
    end
    else if proof.status() <> 'unknown' then failures = failures + 1
  end
  return failures
