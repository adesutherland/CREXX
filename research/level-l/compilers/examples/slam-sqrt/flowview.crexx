/* cREXX License (MIT). Classic FDSqrt -> a tree of execution roles. */
options levelb
namespace sqrtflow expose lower execution
import rxfnsb
import llast
import llflow

schema: procedure = .llast..schema
  shape = .llast..schema()
  ok = shape.mapping('program','Program')
  ok = shape.field('program','body','body','capture','one')
  ok = shape.mapping('sequence','Sequence')
  ok = shape.field('sequence','items','items','capture','many')
  ok = shape.mapping('eval','Eval')
  ok = shape.field('eval','items','items','capture','many')
  ok = shape.mapping('assignment','Assignment')
  ok = shape.field('assignment','name','name','text','one')
  ok = shape.field('assignment','value','value','capture','one')
  ok = shape.mapping('name','Name')
  ok = shape.field('name','spelling','spelling','text','one')
  ok = shape.mapping('value','Value')
  ok = shape.mapping('if','If')
  ok = shape.field('if','condition','condition','capture','one')
  ok = shape.field('if','yes','yes','capture','one')
  ok = shape.field('if','no','no','capture','optional')
  ok = shape.mapping('forever','Forever')
  ok = shape.field('forever','body','body','capture','one')
  ok = shape.mapping('break','Break')
  ok = shape.mapping('return','Return')
  ok = shape.field('return','value','value','capture','optional')
  return shape

/** Lower grammar constructs to execution roles; source locations survive.
 * Expressions retain their operand evaluation order. X enters as the argument.
 */
lower: procedure = .llast..tree
  arg original = reference .llast..tree
  tree = dereference original
  pass = tree.lower(schema())
  do while pass.next()
    node = pass.original(); kind = node.kind()
    select kind
      when 'Program' then ok = pass.keep()
      when 'Sequence' then ok = pass.keep()
      when 'Return' then ok = pass.keep()
      when 'Name' then do
        draft = pass.make('Name')
        ok = draft.settext('spelling',upper(node.text('spelling')))
        ok = pass.replace(draft)
      end
      when 'Assignment' then do
        draft = pass.make('Assignment')
        ok = draft.settext('name',upper(node.text('name')))
        ok = draft.append('value',pass.translated(node.child('value')))
        ok = pass.replace(draft)
      end
      when 'IfThen' then do
        draft = pass.make('If')
        ok = draft.append('condition',pass.translated(node.child('condition')))
        ok = draft.append('yes',pass.translated(node.child('yes')))
        ok = pass.replace(draft)
      end
      when 'CDo' then do
        header = node.child('header')
        if header.child('repetition').kind() <> 'DoForever' | header.count('condition') <> 0 then assembler signal 'ERROR','FDSqrt flow expects DO FOREVER'
        draft = pass.make('Forever')
        ok = draft.append('body',pass.translated(node.child('body')))
        ok = pass.replace(draft)
      end
      when 'Leave' then do
        if node.count('name') <> 0 then assembler signal 'ERROR','FDSqrt flow expects unnamed LEAVE'
        draft = pass.make('Break'); ok = pass.replace(draft)
      end
      when 'Chain' then do
        draft = pass.make('Eval')
        do i = 1 to node.count('operands')
          ok = draft.append('items',pass.translated(node.child('operands',i)))
        end
        ok = pass.replace(draft)
      end
      when 'Group' then do
        draft = pass.make('Eval')
        ok = draft.append('items',pass.translated(node.child('value')))
        ok = pass.replace(draft)
      end
      otherwise do
        inert = 'CLabel CProcedure Parse ParseSource ParseTemplates ParseTemplate ParseTarget DoHeader DoForever DoEnd Number plus divide le lt ge gt'
        if wordpos(kind,inert) = 0 then do
          message = 'Unmapped FDSqrt construct: ' || kind
          assembler signal 'ERROR',message
        end
        if kind = 'CProcedure' then if node.children() <> 0 then assembler signal 'ERROR','FDSqrt flow expects local PROCEDURE'
        draft = pass.make('Value'); ok = pass.replace(draft)
      end
    end
  end
  return pass.finish()

execution: procedure = .llflow..graph
  arg tree = reference .llast..tree
  roles = .llflow..mapping()
  ok = roles.add('Program','evaluate','body')
  ok = roles.add('Sequence','sequence','items')
  ok = roles.add('Eval','sequence','items')
  ok = roles.add('Assignment','assign','name value')
  ok = roles.add('Name','read','spelling')
  ok = roles.add('Value','value')
  ok = roles.add('If','branch','condition yes no')
  ok = roles.add('Forever','loop','body')
  ok = roles.add('Break','break')
  ok = roles.add('Return','return','value')
  return .llflow..graph(tree,roles)
