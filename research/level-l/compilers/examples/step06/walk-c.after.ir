function $MAIN -> crexx.c.result
  argument 1 crexx.c.context required
  entry.1:
    %1 = core.argument argument:1 @origin:2
    core.store %1 slot:$context @origin:2
    %2 = crexx.c.load %1 name="levelc" @origin:10
    %3 = core.constant 3031 : crexx.c.value @origin:18
    crexx.c.say %3 @origin:11
    %4 = core.constant 31 : crexx.c.value @origin:26
    %5 = core.load slot:$context @origin:19
    %6 = crexx.c.truth %4 %5 @origin:19
    core.jump -> if.yes.2 @origin:45
  if.yes.2:
    %7 = core.constant 6F6B : crexx.c.value @origin:35
    crexx.c.say %7 @origin:28
    core.jump -> if.join.4 @origin:19
  if.join.4:
    %8 = crexx.c.return.absent @origin:2
    core.return %8 @origin:2

