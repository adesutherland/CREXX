function $MAIN -> crexx.c.result
  argument 1 crexx.c.context required
  argument 2 crexx.g.int64 required
  entry.1:
    %1 = core.argument argument:1 @origin:2
    core.store %1 slot:$context @origin:2
    %2 = core.argument argument:2 @origin:2
    core.store %2 slot:$entry @origin:2
    core.jump -> entry.dispatch.2 @origin:2
  entry.dispatch.2:
    %3 = core.load slot:$context @origin:2
    %4 = core.load slot:$entry @origin:2
    %5 = crexx.c.entry.test %3 %4 id="0" name="" @origin:2
    core.branch %5 -> source.main.3 -> entry.next.4 @origin:2
  source.main.3:
    %6 = core.load slot:$context @origin:10
    %7 = crexx.c.load %6 name="levelc" @origin:10
    %8 = core.constant 3031 : crexx.c.value @origin:18
    crexx.c.say %8 @origin:11
    %9 = core.constant 31 : crexx.c.value @origin:26
    %10 = core.load slot:$context @origin:19
    %11 = crexx.c.truth %9 %10 @origin:19
    core.jump -> if.yes.5 @origin:45
  entry.next.4:
    crexx.c.entry.invalid @origin:2
    %12 = crexx.c.return.absent @origin:2
    core.return %12 @origin:2
  if.yes.5:
    %13 = core.constant 6F6B : crexx.c.value @origin:35
    crexx.c.say %13 @origin:28
    core.jump -> if.join.7 @origin:19
  if.join.7:
    %14 = crexx.c.return.absent @origin:2
    core.return %14 @origin:2

