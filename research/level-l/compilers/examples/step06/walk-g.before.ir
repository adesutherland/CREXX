function $MAIN -> crexx.g.int64
  entry.1:
    %1 = core.constant 1 : crexx.g.int64 @origin:12
    %2 = crexx.g.convert.int64.text %1 @origin:4
    crexx.g.say %2 @origin:4
    %3 = core.constant 1 : crexx.g.int64 @origin:21
    %4 = crexx.g.convert.int64.boolean %3 @origin:13
    %5 = crexx.g.truth %4 @origin:13
    core.branch %5 -> if.yes.2 -> if.no.3 @origin:13
  if.yes.2:
    %6 = core.constant ok : crexx.g.text @origin:30
    crexx.g.say %6 @origin:22
    core.jump -> if.join.4 @origin:13
  if.no.3:
    %7 = core.constant 1 : crexx.g.int64 @origin:39
    core.store %7 slot:$tmp.1 @origin:37
    %8 = core.constant 0 : crexx.g.int64 @origin:41
    %9 = core.load slot:$tmp.1 @origin:37
    %10 = crexx.g.int64.div %9 %8 @origin:37
    %11 = crexx.g.convert.int64.text %10 @origin:31
    crexx.g.say %11 @origin:31
    core.jump -> if.join.4 @origin:13
  if.join.4:
    %12 = core.constant 0 : crexx.g.int64 @origin:2
    core.return %12 @origin:2

