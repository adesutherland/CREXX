function $MAIN -> crexx.c.result
  argument 1 crexx.c.context required
  argument 2 crexx.g.int64 required
  entry.1:
    %1 = core.argument argument:1 @origin:2
    core.store %1 slot:$context @origin:2
    %2 = core.argument argument:2 @origin:2
    core.store %2 slot:$entry @origin:2
    core.jump -> entry.dispatch.2 @origin:2
  entry.dispatch.2:
    %3 = core.load slot:$context @origin:2
    %4 = core.load slot:$entry @origin:2
    %5 = crexx.c.entry.test %3 %4 id="0" name="" @origin:2
    core.branch %5 -> source.main.3 -> entry.next.4 @origin:2
  source.main.3:
    %7 = core.load slot:$context @origin:10
    %8 = crexx.c.load %7 name="levelc" @origin:10
    %9 = core.constant 3031 : crexx.c.value @origin:18
    crexx.c.say %9 @origin:11
    %10 = core.constant 31 : crexx.c.value @origin:26
    %11 = core.load slot:$context @origin:19
    %12 = crexx.c.truth %10 %11 @origin:19
    %13 = core.constant true : core.boolean @origin:27
    core.branch %13 -> if.yes.5 -> if.no.6 @origin:19
  entry.next.4:
    crexx.c.entry.invalid @origin:2
    %6 = crexx.c.return.absent @origin:2
    core.return %6 @origin:2
  if.yes.5:
    %14 = core.constant 6F6B : crexx.c.value @origin:35
    crexx.c.say %14 @origin:28
    core.jump -> if.join.7 @origin:19
  if.no.6:
    %15 = core.constant 31 : crexx.c.value @origin:43
    core.store %15 slot:$tmp.1 @origin:42
    %16 = core.constant 30 : crexx.c.value @origin:44
    %17 = core.load slot:$tmp.1 @origin:42
    %18 = core.load slot:$context @origin:42
    %19 = crexx.c.div %17 %16 %18 @origin:42
    crexx.c.say %19 @origin:36
    core.jump -> if.join.7 @origin:19
  if.join.7:
    %20 = crexx.c.return.absent @origin:2
    core.return %20 @origin:2

