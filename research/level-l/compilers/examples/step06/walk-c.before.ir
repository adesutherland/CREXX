function $MAIN -> crexx.c.result
  argument 1 crexx.c.context required
  entry.1:
    %1 = core.argument argument:1 @origin:2
    core.store %1 slot:$context @origin:2
    %2 = core.constant 3031 : crexx.c.value @origin:11
    crexx.c.say %2 @origin:4
    %3 = core.constant 31 : crexx.c.value @origin:19
    %4 = core.load slot:$context @origin:12
    %5 = crexx.c.truth %3 %4 @origin:12
    %6 = core.constant true : core.boolean @origin:20
    core.branch %6 -> if.yes.2 -> if.no.3 @origin:12
  if.yes.2:
    %7 = core.constant 6F6B : crexx.c.value @origin:28
    crexx.c.say %7 @origin:21
    core.jump -> if.join.4 @origin:12
  if.no.3:
    %8 = core.constant 31 : crexx.c.value @origin:36
    core.store %8 slot:$tmp.1 @origin:35
    %9 = core.constant 30 : crexx.c.value @origin:37
    %10 = core.load slot:$tmp.1 @origin:35
    %11 = core.load slot:$context @origin:35
    %12 = crexx.c.div %10 %9 %11 @origin:35
    crexx.c.say %12 @origin:29
    core.jump -> if.join.4 @origin:12
  if.join.4:
    %13 = crexx.c.return.absent @origin:2
    core.return %13 @origin:2

