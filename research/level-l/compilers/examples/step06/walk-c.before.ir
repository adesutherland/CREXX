function $MAIN -> crexx.c.result
  argument 1 crexx.c.context required
  entry.1:
    %1 = core.argument argument:1 @origin:2
    core.store %1 slot:$context @origin:2
    %2 = core.load slot:$context @origin:10
    %3 = crexx.c.load %2 name="levelc" @origin:10
    %4 = core.constant 3031 : crexx.c.value @origin:18
    crexx.c.say %4 @origin:11
    %5 = core.constant 31 : crexx.c.value @origin:26
    %6 = core.load slot:$context @origin:19
    %7 = crexx.c.truth %5 %6 @origin:19
    %8 = core.constant true : core.boolean @origin:27
    core.branch %8 -> if.yes.2 -> if.no.3 @origin:19
  if.yes.2:
    %9 = core.constant 6F6B : crexx.c.value @origin:35
    crexx.c.say %9 @origin:28
    core.jump -> if.join.4 @origin:19
  if.no.3:
    %10 = core.constant 31 : crexx.c.value @origin:43
    core.store %10 slot:$tmp.1 @origin:42
    %11 = core.constant 30 : crexx.c.value @origin:44
    %12 = core.load slot:$tmp.1 @origin:42
    %13 = core.load slot:$context @origin:42
    %14 = crexx.c.div %12 %11 %13 @origin:42
    crexx.c.say %14 @origin:36
    core.jump -> if.join.4 @origin:19
  if.join.4:
    %15 = crexx.c.return.absent @origin:2
    core.return %15 @origin:2

