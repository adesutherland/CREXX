/* cREXX License (MIT). Checked C/G IR selection; all output uses llir.writer. */
options levelb
namespace lltrxas expose compilation
import rxfnsb
import llir
import lltir
import llcompilercontracts
import llsource
import llrxastext
import llrxas
import llirgraph

/** A compile owns its source graph and emits only a fully checked output.
 * Fixed owners and the disjoint call window retain their identities; explicit
 * plain scalar candidates use checked target allocation. The graph is read-only. */
compilation: class
  _graph = .llir..module
  _index = .llirgraph..index
  _store = reference .llir..arena
  _schema = .llir..contract
  _canonical = .llir..contract
  _path = .string
  _limit = .int
  _reglimit = .int
  _phase = .string
  _ready = .int
  _error = .string
  _offset = .int
  _origin = .int
  _fn = .int
  _registers = .int[]
  _deferred = .int[]
  _slots = .int[]
  _callbase = .int
  _scratch = .int
  _location = .int
  _sizing = .int
  _needsscratch = .int
  _maxargs = .int
  _fallthrough = .int
  _sourceindexes = .object[]
  _lastsource = .string
  _lastlocation = .string
  _routine = .string
  _locals = .int
  _names = .string[]
  _signatures = .object[]
  _packages = .string[]
  _catalogs = .object[]
  _target = .llrxas..program
  _candidates = .int[]
  _recordbytes = .int
  _writer = .llir..writer
  _output = .llir..output
  *: factory
    arg graph = .llir..module, artifacts = .string, bytes = 67108864, registers = 65536
    _graph = graph; _path = artifacts; _limit = bytes; _reglimit = registers
    _ready = 0; _error = ''; _origin = 0; _offset = 0
    return
  fail: method = .void
    arg reason = .string
    if _error = '' then _error = 'LL_COMPILER_' || reason
    return
  status: method = .int
    call run(); return _error <> ''
  error: method = .string
    call run(); return _error
  offset: method = .int
    call run(); return _offset
  output: method = .llir..output
    call run()
    if _error <> '' then do
      chunks = .binary[]; origins = .int[]
      return .llir..output(chunks,origins,0,_error)
    end
    return _output
  emit: method = .void
    arg mnemonic = .string, operands = ''
    if _error <> '' then return
    if _sizing then return
    _recordbytes = _recordbytes + length(mnemonic) + length(operands) + 2
    if _recordbytes > _limit then do
      call fail('LIMIT: selected output exceeds output.bytes budget'); return
    end
    call _target.record(mnemonic,operands,_origin)
    return
  reg: method = .string
    arg index = .int
    if _sizing then do
      if index = _scratch then _needsscratch = 1
      return 'r' || index
    end
    if index < 0 | index >= _locals then call fail('REGISTER: register outside assigned frame')
    return 'r' || index
  input: method = .string
    arg op = .llir..opview, index = 1
    return reg(_registers[op.input(index).id()])
  result: method = .string
    arg op = .llir..opview
    if op.results() = 0 then return ''
    return reg(_registers[op.result().id()])
  typename: method = .string
    arg id = .int
    schema = dereference _schema.data()
    return schema.typename(id)
  targettype: method = .string
    arg id = .int
    name = typename(id)
    select
      when name = 'core.void' then return '.void'
      when name = 'core.boolean' | name = 'crexx.g.int64' then return '.int'
      when name = 'crexx.g.boolean' then return '.boolean'
      when name = 'crexx.g.text' then return '.string'
      when name = 'crexx.g.float64' then return '.float'
      when name = 'crexx.g.decimal' then return '.decimal'
      otherwise call fail('LOWERING: unsupported value type ' || name)
    end
    return ''
  localname: method = .string
    arg identity = .string
    store = dereference _store
    do i = 1 to store.count(1)
      if store.text(store.get(1,i,1)) = identity then return 'llf' || i
    end
    call fail('LOWERING: missing local routine ' || identity)
    return ''
  importsignature: method = .llcompilercontracts..signature
    arg package = .string, name = .string
    i = .int
    do i = 1 to _names[0]
      if _names[i] = name then return _signatures[i] as .llcompilercontracts..signature
    end
    catalog = .llcompilercontracts..catalog; image = .binary; found = 0
    do i = 1 to _packages[0]
      if _packages[i] = package then found = i
    end
    if found = 0 then do
      do
        image = readbinary(_path || '/' || package || '.rxbin')
      on signal
        call fail('IMPORT: cannot read ' || package || '.rxbin')
        return .llcompilercontracts..signature.failed(_error)
      end
      catalog = .llcompilercontracts..catalog(image,67108864)
      found = _packages[0] + 1; _packages[found] = package; _catalogs[found] = catalog as .object
    end
    else catalog = _catalogs[found] as .llcompilercontracts..catalog
    signature = catalog.lookup(name)
    if signature.error() <> '' then call fail('IMPORT: ' || signature.error())
    if _error = '' then do
      n = _names[0] + 1; _names[n] = name; _signatures[n] = signature as .object
    end
    return signature
  imported: method = .string
    arg package = .string, name = .string, result = .string, arguments = .string
    signature = importsignature(package,name)
    if _error <> '' then return ''
    if signature.result() <> result | signature.arguments() <> words(arguments) then call fail('IMPORT: incompatible target signature ' || name)
    else do i = 1 to words(arguments)
      expected = word(arguments,i); expected = changestr('@',expected,' ')
      expected = changestr('.rexxvalue..',expected,'.'); expected = changestr('.rexxpool..',expected,'.'); expected = changestr('.rexxactivation..',expected,'.')
      if signature.type(i) <> expected | signature.optional(i) | signature.exposed(i) then call fail('IMPORT: incompatible target argument ' || name || ':' || i)
    end
    if _error <> '' then return ''
    return name
  /** Args are already in a private contiguous window. The return destination
   * is distinct; clearing the window after return releases borrowed references. */
  invoke: method = .void
    arg destination = .string, name = .string, count = .int, ?presence = .binary
    i = .int
    if destination = '' then destination = reg(_scratch)
    if _sizing then do
      _maxargs = max(_maxargs,count); return
    end
    if count < 0 | count > _locals - _callbase - 1 then do
      call fail('REGISTER: call window exceeds frame'); return
    end
    call emit('load',reg(_callbase) || ',' || count)
    do i = 1 to count
      flags = 768
      if ?presence then do
        if <at..u8>(i - 1) presence = 0 then flags = 512
      end
      call emit('settp',reg(_callbase + i) || ',' || flags)
    end
    call emit('call',destination || ',' || name || '(),' || reg(_callbase))
    do i = 1 to count
      call emit('null',reg(_callbase + i))
    end
    return
  argcopy: method = .void
    arg ordinal = .int, value = .string, borrow = 0
    mnemonic = 'copy'; if borrow then mnemonic = 'mkref'
    call emit(mnemonic,reg(_callbase + ordinal) || ',' || value)
    return
  argtext: method = .void
    arg ordinal = .int, text = .string
    call emit('load',reg(_callbase + ordinal) || ',' || llrxastext..quote(text as .binary))
    return
  checkoperation: method = .void
    arg op = .llir..opview, expected = .llir..contract
    name = op.name()
    if (left(name,8) = 'crexx.c.') then do
      call fail('PROFILE: operation belongs to another language: ' || name); return
    end
    if left(name,5) = 'core.' then return
    if left(name,12) = 'crexx.calls.' then return
    registry = dereference expected.data(); actual = dereference _schema.data()
    index = registry.opindex(name); source = actual.opindex(name)
    if index = 0 then do
      call fail('LOWERING: unsupported operation ' || name); return
    end
    do kind = 1 to 3
      if registry.arity(index,kind) <> actual.arity(source,kind) then do
        call fail('LOWERING: incompatible operation shape ' || name); return
      end
      do field = 1 to registry.arity(index,kind)
        if registry.fieldname(index,kind,field) <> actual.fieldname(source,kind,field) | registry.typename(registry.fieldtype(index,kind,field)) <> actual.typename(actual.fieldtype(source,kind,field)) then call fail('LOWERING: incompatible operation field ' || name)
      end
    end
    return
  checkfunctions: method = .void
    f = .int
    store = dereference _store
    if store.count(1) = 0 then do; call fail('LOWERING: missing main function'); return; end

    hasexport = 0
    do f = 1 to store.count(1)
      if store.get(1,f,6) > 0 then do
        hasexport = 1; identity = store.text(store.get(1,f,6)); split = pos('.',identity)
        if split < 2 | split = length(identity) | pos('.',identity,split + 1) > 0 then call fail('LOWERING: invalid export identity')
        else if verify(identity,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.') <> 0 then call fail('LOWERING: invalid export identity')
        else if verify(left(identity,1) || substr(identity,split + 1,1),'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_') <> 0 then call fail('LOWERING: invalid export identity')
      end
    end
    if store.text(store.get(1,1,1)) <> '$MAIN' & hasexport = 0 then call fail('LOWERING: library requires an export')
    do f = 1 to store.count(1)
      resulttype = typename(store.get(1,f,2)); count = store.get(1,f,5); first = store.get(1,f,4)
      do
        if store.text(store.get(1,f,1)) = '$MAIN' & (resulttype <> 'crexx.g.int64' | count <> 0) then call fail('LOWERING: G main ABI')
        ignored = targettype(store.get(1,f,2))
        do a = 1 to count
          ignored = targettype(store.get(12,first + a - 1,2))
        end
      end
    end
    return
  run: method = .void
    if _ready then return
    _ready = 1; _phase = 'admission'
    i = .int
    do
      if _graph.error() <> '' then do; _error = _graph.error(); return; end

      if _limit < 1 | _reglimit < 16 | _reglimit > 2147483647 then do; call fail('LIMIT: invalid output or register budget'); return; end
      _store = _graph.storage(); store = dereference _store; contract = dereference store.contract(); _schema = contract
      _phase = 'graph index'
      _index = .llirgraph..index(reference _graph,1000000,_limit)
      if _index.valid() = 0 then do
        if _index.status() = 'limit' then call fail('LIMIT: ' || _index.message())
        else call fail('GRAPH: ' || _index.message())
        return
      end
      call checkfunctions()
      if _error <> '' then return
      canonical = .llir..schema(); call lltir..registerfamilies(reference canonical); expected = canonical.finish()
      _canonical = expected
      actualschema = dereference _schema.data()
      do i = 1 to actualschema.familycount()
        if actualschema.version(i) <> 1 then call fail('LOWERING: unsupported family version ' || actualschema.familyname(i))
      end
      if _error <> '' then return
      do i = 1 to store.count(3)
        op = _graph.operation(i); _origin = op.origin().id(); _offset = op.origin().first()
        call checkoperation(op,expected)
        if _error <> '' then return
      end
      _phase = 'entry'; _writer = .llir..writer(_limit)
      call _writer.line('.globals=0')
      _origin = 0; _sizing = 0; _scratch = -1; _location = -1; _recordbytes = 0
      _locals = 2; _callbase = 1
      _target = .llrxas..program(_locals,_reglimit,1000000)
      call _target.window(_callbase,_locals - _callbase)

      if store.text(store.get(1,1,1)) = '$MAIN' then do
      call emit('main()','.locals=' || _locals)
      call clearsource()
      do
        call invoke('r0','llf1',0); call emit('ret','r0')
      end
      _phase = 'entry flush'; call flush()
      if _error <> '' then return
      end
      do f = 1 to store.count(1)
        _phase = 'function ' || f; _fn = f; call procedurebody()
        if _error <> '' then return
      end
      do i = 1 to _names[0]
        signature = _signatures[i] as .llcompilercontracts..signature
        call _writer.line(_names[i] || '() .expose=' || _names[i])
        args = ''
        do j = 1 to signature.arguments()
          if j > 1 then args = args || ','
          if signature.exposed(j) then args = args || 'expose '
          if signature.optional(j) then args = args || '?'
          args = args || signature.paramname(j) || '=' || signature.type(j)
        end
        call _writer.line('  .meta ' || llrxastext..quote(_names[i] as .binary) || '=' || llrxastext..quote(signature.flags_text() as .binary) || ' ' || llrxastext..quote(signature.result() as .binary) || ' ' || _names[i] || '() ' || llrxastext..quote(args as .binary))
      end
      _output = _writer.finish()
      if _output.error() <> '' then _error = _output.error()
    on signal as problem
      if _error = '' then call fail('BACKEND: ' || _phase || ': ' || problem.name() || ' at backend line ' || problem.line() || ': ' || problem.message())
    end
    return
  flush: method = .void
    selected = _target.finish()
    if selected.valid() = 0 then do
      if pos('LL_RXAS_LIMIT:',selected.error()) = 1 then call fail('LIMIT: ' || selected.error())
      else call fail('TARGET: ' || selected.error())
      return
    end
    section = _writer.section()
    do i = 1 to selected.records()
      call section.line(selected.text(i),selected.origin(i))
    end
    part = section.finish(); call _writer.append(reference part)
    _recordbytes = 0
    if _writer.error() <> '' then _error = _writer.error()
    return
  procedurebody: method = .void
    i = .int; b = .int; id = .int; op = .llir..opview
    blockindex = .int; slotindex = .int; operationindex = .int; valuetype = .string
    store = dereference _store; blocks = .int[]
    _phase = 'default planning'
    valueid = .int; name = .string
    do operationindex = 1 to _index.functionoperations(_fn)
      i = _index.functionoperation(_fn,operationindex); _deferred[i] = 0
    end
    do operationindex = 1 to _index.functionoperations(_fn)
      i = _index.functionoperation(_fn,operationindex)
      if _index.opcode(i) <> 9 then iterate
      valueid = store.operand(i,1); producer = _index.definition(valueid)
      name = store.opname(store.get(3,producer,1))
      if _index.uses(valueid) = 1 & (name = 'core.constant' | name = 'crexx.g.decimal.default') then _deferred[producer] = i
    end
    _phase = 'slot allocation'; next = 1
    do slotindex = 1 to _index.functionslots(_fn)
      i = _index.functionslot(_fn,slotindex)
      _slots[i] = next; next = next + 1
    end
    _phase = 'value allocation'; emptycandidates = .int[]; _candidates = emptycandidates
    do blockindex = 1 to _index.functionblocks(_fn)
      b = _index.functionblock(_fn,blockindex)
      blocks[blockindex] = b
      id = store.get(2,b,2)
      do while id > 0
        op = _graph.operation(id)
        do r = 1 to op.results()
          _registers[op.result(r).id()] = next; next = next + 1
          valuetype = typename(op.result(r).type().id())
          if valuetype = 'core.boolean' | valuetype = 'crexx.g.boolean' | valuetype = 'crexx.g.int64' then _candidates[_candidates[0] + 1] = _registers[op.result(r).id()]
        end
        id = store.get(3,id,3)
      end
    end
    /* Use the same selector for planning and emission. Hidden helper calls
     * therefore participate without a second arity table to maintain. */
    _phase = 'frame planning'; _scratch = next; _location = next + 1; _callbase = next + 2
    _maxargs = -1; _needsscratch = 0; _sizing = 1; _fallthrough = 0

    do i = 1 to blocks[0] while _error = ''
      id = store.get(2,blocks[i],2)
      do while id > 0 & _error = ''
        op = _graph.operation(id); _origin = op.origin().id(); _offset = op.origin().first()
        call selectop(op)
        id = store.get(3,id,3)
      end
    end
    _sizing = 0
    if _error <> '' then return
    _phase = 'frame limits'; _scratch = -1; _location = -1; _callbase = -1
    if _needsscratch then do; _scratch = next; next = next + 1; end

    if _maxargs >= 0 then do; _callbase = next; next = next + _maxargs + 1; end
    _locals = next
    _target = .llrxas..program(_locals,_reglimit,1000000)
    if _callbase >= 0 then call _target.window(_callbase,_locals - _callbase)
    do i = 1 to _candidates[0]
      call _target.candidate(_candidates[i],'integer')
      if _index.pinnedfunction(_fn) then call _target.pin(_candidates[i])
    end
    _origin = 0
    declaration = '.locals=' || _locals
    if store.get(1,_fn,6) > 0 then declaration = declaration || ' .expose=' || store.text(store.get(1,_fn,6))
    call emit('llf' || _fn || '()',declaration)
    call clearsource()
    _routine = store.text(store.get(1,_fn,1))
    _phase = 'signature'; args = ''; first = store.get(1,_fn,4)
    do i = 1 to store.get(1,_fn,5)
      if i > 1 then args = args || ','
      if store.get(12,first + i - 1,3) then args = args || '?'
      args = args || 'p' || i || '=' || targettype(store.get(12,first + i - 1,2))
    end
    _phase = 'metadata'; name = 'llprogram.' || store.text(store.get(1,_fn,1))
    if store.get(1,_fn,6) > 0 then name = store.text(store.get(1,_fn,6))
    call emit('.meta',llrxastext..quote(name as .binary) || '="b" ' || llrxastext..quote(targettype(store.get(1,_fn,2)) as .binary) || ' llf' || _fn || '() ' || llrxastext..quote(args as .binary))
    /* Default typed profile; Classic helpers install their explicit snapshots. */
    call emit('numsci','18,1,1')

    if store.get(1,_fn,3) <> blocks[1] then call emit('br','llb' || store.get(1,_fn,3))
    do blockindex = 1 to blocks[0]
      b = blocks[blockindex]; _fallthrough = 0
      if blockindex < blocks[0] then _fallthrough = blocks[blockindex + 1]
      _origin = 0; call emit('llb' || b || ':')
      /* Predecessors can carry different dynamic location state. */
      _lastsource = ''; _lastlocation = ''
      id = store.get(2,b,2)
      do while id > 0 & _error = ''
        op = _graph.operation(id); _origin = op.origin().id(); _offset = op.origin().first()
        if _deferred[id] = 0 then call source(op.origin())
        call selectop(op)
        id = store.get(3,id,3)
      end
    end

    call flush()
    return
  /** Explicit no-source anchor prevents generated entries/handlers inheriting
   * the last authored record of a preceding routine. */
  clearsource: method = .void
    call emit('.srcstep','0 0 6 "" 0 0 0 ""')
    _lastsource = ''; _lastlocation = ''
    return
  source: method = .void
    arg origin = .llir..origin
    key = .string; location = .string
    if origin.id() = 0 then do; call clearsource(); return; end
    kind = origin.kind()
    if kind = 'synthetic' then do
      key = '6 "" 0 0 0 ""'; location = 'generated code in ' || _routine
      call sourcerecord(key,location)
      return
    end
    store = dereference _store; sourceid = store.get(9,origin.id(),1)
    positions = .llsource..index
    if sourceid <= _sourceindexes[0] then do
      if _sourceindexes[sourceid] is .llsource..index then positions = _sourceindexes[sourceid] as .llsource..index
    end
    bytes = origin.sourcebytes()
    if initialized(positions) = 0 then do
      positions = .llsource..index(bytes)
      _sourceindexes[sourceid] = positions as .object
    end
    at = positions.position(origin.first())
    if at.error() <> '' then do; call fail('SOURCE: ' || at.error()); return; end
    line = at.line(); column = at.column(); first = at.first(); last = at.last()
    finish = min(last,origin.last()); ending = positions.position(finish)
    if ending.error() <> '' then do; call fail('SOURCE: ' || ending.error()); return; end
    endcolumn = ending.column()
    flags = 17
    if kind = 'derived' then flags = 34
    else if kind = 'composite' then flags = 65
    if origin.last() > last then do
      if flags = 17 then flags = 65
      else if flags = 34 then flags = 98
    end
    filename = llcompilercontracts..sourcename(origin.filename())
    location = filename || ':' || line || ':' || column
    if kind <> 'exact' then location = filename || ': generated code in ' || _routine
    key = flags || ' ' || llrxastext..quote(filename as .binary) || ' ' || line || ' ' || column || ' ' || endcolumn || ' ' || llrxastext..quote(binsubstr(bytes,first + 1,last - first))
    call sourcerecord(key,location)
    return
  /** A source anchor and diagnostic context are independent state. Equal line
   * numbers alone are insufficient: range, flags and text also identify it. */
  sourcerecord: method = .void
    arg key = .string, location = .string
    if key <> _lastsource then do
      call emit('.srcstep',_origin || ' 0 ' || key)
      _lastsource = key
    end

    return
  selectop: method = .void
    arg op = .llir..opview
    store = dereference _store; name = op.name(); dest = result(op); id = op.id()
    if _deferred[id] > 0 then return
    select
      when name = 'core.constant' then do
        value = op.result(); type = typename(value.type().id()); bytes = value.bytes()
        schema = dereference _canonical.data(); typeid = schema.typeindex(type)
        if typeid = 0 then do; call fail('LOWERING: unsupported constant type ' || type); return; end
        codec = schema.codec(typeid) as .llir..typecodec
        problem = codec.check(bytes)
        if problem <> '' then do; call fail('LOWERING: invalid constant bytes: ' || problem); return; end
        literal = codec.format(bytes)
        if type = 'core.boolean' then literal = (literal = 'true') as .string
        if type = 'crexx.g.text' then literal = llrxastext..quote(bytes)
        if type = 'crexx.g.decimal' then literal = literal || 'd'
        if type = 'crexx.g.float64' then do
          /* Bit transport avoids decimal formatting loss, including -0. */
          call emit('load',dest || ',0x' || bin2x(bytes))
          call emit('load',reg(_scratch) || ',0')
          call emit('bgetf64',dest || ',' || dest || ',' || reg(_scratch)); return
        end
        call emit('load',dest || ',' || literal)
      end
      when name = 'core.argument' then call emit('copy',dest || ',a' || store.get(3,id,12))
      when name = 'core.hasarg' then do
        call emit('getandtp',dest || ',a' || store.get(3,id,12) || ',256')
      end
      when name = 'core.optionalargument' then do
        label = 'llarg' || id; ordinal = store.get(3,id,12)
        call emit('brtpandt',label || '_present,a' || ordinal || ',256')
        producer = store.get(4,op.input(1).id(),1)
        if _deferred[producer] = id then do
          _deferred[producer] = 0
          call selectop(_graph.operation(producer))
          _deferred[producer] = id
        end
        call emit('copy',dest || ',' || input(op))
        call emit('br',label || '_done')
        call emit(label || '_present:'); call emit('copy',dest || ',a' || ordinal)
        call emit(label || '_done:')
      end
      when name = 'core.load' then do
        slot = store.get(3,id,12); mnemonic = 'copy'
        call emit(mnemonic,dest || ',' || reg(_slots[slot]))
      end
      when name = 'core.store' then do
        slot = store.get(3,id,12); mnemonic = 'copy'; dest = reg(_slots[slot])
        call emit(mnemonic,dest || ',' || input(op))
      end
      when name = 'core.jump' then do
        if op.successor(1) <> _fallthrough then call emit('br','llb' || op.successor(1))
      end
      when name = 'core.branch' then do
        call emit('brt','llb' || op.successor(1) || ',' || input(op))
        if op.successor(2) <> _fallthrough then call emit('br','llb' || op.successor(2))
      end
      when name = 'core.return' then do
        if op.inputs() then call emit('ret',input(op))
        else call emit('ret')
      end
      otherwise do
        if left(name,8) = 'crexx.g.' then call typed(op,substr(name,9))
        else if left(name,12) = 'crexx.calls.' then call typedcall(op)
        else call fail('LOWERING: unsupported operation ' || name)
      end
    end
    return
  typedcall: method = .void
    arg op = .llir..opview
    symbol = .string; resulttype = .int; view = .llir..function
    store = dereference _store; actual = dereference _schema.data(); descriptor = actual.opindex(op.name())
    if actual.arity(descriptor,3) <> 3 then do; call fail('LOWERING: call attributes'); return; end
    if actual.fieldname(descriptor,3,1) <> 'target' | actual.fieldname(descriptor,3,2) <> 'package' | actual.fieldname(descriptor,3,3) <> 'presence' then do; call fail('LOWERING: call attribute names'); return; end
    if typename(actual.fieldtype(descriptor,3,1)) <> 'crexx.g.text' | typename(actual.fieldtype(descriptor,3,2)) <> 'crexx.g.text' | typename(actual.fieldtype(descriptor,3,3)) <> 'crexx.calls.presence' then do; call fail('LOWERING: call attribute types'); return; end
    if actual.effectvalue(descriptor,1) <> 'call' | actual.effectvalue(descriptor,2) <> 'condition' | actual.effectvalue(descriptor,3) <> 'returns' then do; call fail('LOWERING: call effects'); return; end
    identity = op.attribute('target') as .string; package = op.attribute('package') as .string; mask = op.attribute('presence')
    count = <blen>(mask); fn = 0; signature = .llcompilercontracts..signature
    if package = '' then do
      symbol = localname(identity)
      if symbol = '' then return
      fn = substr(symbol,4) as .int; view = _graph.function(fn)
      if view.arguments() <> count then do; call fail('LOWERING: local argument count'); return; end
      resulttype = view.resulttype().id()
    end
    else do
      if verify(package,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_') <> 0 | package = '' then do; call fail('IMPORT: invalid module identity'); return; end
      if package <> 'library' & left(identity,length(package) + 1) <> package || '.' then do; call fail('IMPORT: target is outside selected module'); return; end
      if package = 'library' & identity <> 'rxfnsb.length' then do; call fail('IMPORT: unsupported library callable'); return; end
      member = substr(identity,pos('.',identity) + 1)
      if verify(left(package,1) || left(member,1),'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_') <> 0 | member = '' | verify(member,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_') <> 0 then do; call fail('IMPORT: invalid callable identity'); return; end
      signature = importsignature(package,identity); symbol = identity
      if _error <> '' then return
      if signature.arguments() <> count then do; call fail('IMPORT: argument count changed'); return; end
      if signature.flags_text() <> 'b' & signature.flags_text() <> 'g' then do; call fail('IMPORT: unsupported callable flags'); return; end
      resulttype = importtype(signature.result())
    end
    supplied = 0; i = .int; expected = .int; optional = .int
    do i = 1 to count
      present = <at..u8>(i - 1) mask
      if present > 1 then do; call fail('LOWERING: invalid presence byte'); return; end
      if fn > 0 then do; expected = view.argumenttype(i).id(); optional = view.optional(i); end
      else do
        if signature.exposed(i) then do; call fail('IMPORT: exposed typed source arguments are unsupported'); return; end
        expected = importtype(signature.type(i)); optional = signature.optional(i)
      end
      if present = 0 & optional = 0 then do; call fail('LOWERING: missing required argument'); return; end
      if present then do
        supplied = supplied + 1
        if supplied > op.inputs() then do; call fail('LOWERING: missing supplied input'); return; end
        if op.input(supplied).type().id() <> expected then call fail('LOWERING: argument type')
        if actual.fieldname(descriptor,1,supplied) <> 'arg' || i then call fail('LOWERING: argument position')
        call argcopy(i,input(op,supplied))
      end
    end
    if supplied <> op.inputs() then call fail('LOWERING: excess supplied inputs')
    if resulttype = 1 then do
      if op.results() <> 0 then call fail('LOWERING: void call result')
    end
    else if op.results() <> 1 then call fail('LOWERING: call result count')
    else if op.result().type().id() <> resulttype then call fail('LOWERING: call result type')
    if _error <> '' then return
    call invoke(result(op),symbol,count,mask)
    return
  importtype: method = .int
    arg name = .string
    index = wordpos(name,'.void .int .string .boolean .float .decimal')
    if index = 0 then do; call fail('IMPORT: unsupported scalar type ' || name); return 0; end
    if index = 1 then return 1
    type = _schema.type('crexx.g.' || word('void int64 text boolean float64 decimal',index))
    return type.id()
  typed: method = .void
    arg op = .llir..opview, name = .string
    target = .string
    dest = result(op); left = ''; if op.inputs() > 0 then left = input(op)
    if name = 'fromtruth' then do; call emit('copy',dest || ',' || left); return; end
    if name = 'decimal.default' then do; call emit('null',dest); return; end
    if name = 'say' then do; call emit('say',left); return; end
    if name = 'exit' then do; call emit('exit',left); return; end
    if name = 'truth' then do; call emit('icopy',dest || ',' || left); return; end
    if name = 'boolean.not' then do; call emit('not',dest || ',' || left); return; end
    if name = 'boolean.xor' then do; call emit('ixor',dest || ',' || left || ',' || input(op,2)); return; end
    if name = 'text.concat' then do; call emit('concat',dest || ',' || left || ',' || input(op,2)); return; end
    if name = 'iadd' then name = 'int64.add'
    if name = 'itext' then name = 'convert.int64.text'
    parts = changestr('.',name,' ')
    if word(parts,1) = 'convert' then do
      source = word(parts,2); target = word(parts,3)
      from = word('i s b f d',wordpos(source,'int64 text boolean float64 decimal'))
      targetcode = word('i s b f d',wordpos(target,'int64 text boolean float64 decimal'))
      call emit('copy',dest || ',' || left)
      call emit(from || 'to' || targetcode,dest); return
    end
    type = word(parts,1); operation = word(parts,2)
    prefix = word('i s i f d',wordpos(type,'int64 text boolean float64 decimal'))
    if type = 'text' & operation <> 'strict' then prefix = 'r'
    if operation = 'positive' then do; call emit('copy',dest || ',' || left); return; end
    if operation = 'negative' then do
      if type = 'float64' then do
        call emit('load',dest || ',-1.0')
        call emit('fmult',dest || ',' || dest || ',' || left); return
      end
      zero = '0'; if type = 'decimal' then zero = '0d'
      call emit('load',dest || ',' || zero)
      call emit(prefix || 'sub',dest || ',' || dest || ',' || left); return
    end
    target = operation
    if operation = 'mul' then target = 'mult'
    if operation = 'le' then target = 'lte'
    if operation = 'ge' then target = 'gte'
    if operation = 'strict' then target = 'eq'
    if wordpos(operation,'add sub mul div eq ne lt le gt ge strict') = 0 then do; call fail('LOWERING: unsupported typed operation ' || name); return; end
    call emit(prefix || target,dest || ',' || left || ',' || input(op,2))
    return
