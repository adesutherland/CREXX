/* Native Level L regex-to-Thompson-NFA source generator. */
options levell
import rxfnsb
import lldfabuild
main: procedure = .int expose graph count root bad pattern cursor
arg argv = .string[]
if argv[0] < 2 | argv[0] > 3 then do
  say '/* usage: lexgen specification namespace [dfa] */'; return 1
end
graph = .binary; count = 0; root = 0; bad = 0
do while lines(argv[1])
  line = strip(linein(argv[1]))
  if line = '' then iterate
  if left(line,1) = '#' then iterate
  kind = word(line,1) as .int
  if kind = 0 then do
    say '/* token id zero is reserved */'; return 1
  end
  pattern = strip(substr(line,wordindex(line,2)))
  cursor = 1
  frag = alternative()
  if cursor <= length(pattern) | bad = 1 then do
    say '/* invalid regex:' line 'at' cursor '*/'; return 1
  end
  if nullable(frag[1]) then do
    say '/* nullable lexer rule rejected:' line '*/'; return 1
  end
  accept = node(2,0,0,kind,'')
  call patch frag[2], accept
  if root = 0 then root = frag[1]
  else root = node(0,root,frag[1],0,'')
end
if root = 0 then do
  say '/* empty specification */'; return 1
end
say '/* Generated by native Level L lexgen; do not edit. */'
say 'options levell'
say 'namespace' argv[2] 'expose lex'
if argv[0] = 3 then do
  if argv[3] <> 'dfa' then return 1
  graph = lldfabuild..determinize(graph,root)
  if <blen>(graph) = 0 then do
    say '/* DFA exceeds the 2048-state research budget */'; return 1
  end
  say 'import lldfa'
end
else say 'import lllex'
say 'table: procedure expose DATA'
/* Binary data must use the binary-to-hex conversion, including NULs. */
hex = ''
do byteindex = 0 to <blen>(graph) - 1
  hex = hex || d2x(<at..u8>(byteindex) graph, 2)
end
do offset = 1 to length(hex) by 160
  if offset = 1 then prefix = '  constant DATA = '
  else prefix = '                  '
  suffix = ''
  if offset + 160 > length(hex) then suffix = 'x as .binary'
  say prefix || "'" || substr(hex,offset,160) || "'" || suffix
end
say '  return'
say 'lex: procedure = .binary'
say '  arg source = .string'
if argv[0] = 3 then say '  return lldfa..scan(source, DATA)'
else say '  return lllex..scan(source, DATA,' root ')'
return 0

node: procedure = .int expose graph count
  arg type = .int, a = .int, b = .int, kind = .int, mask = .string
  count = count + 1; base = (count - 1) * 144
  call binresize graph, base + 144
  <at..i32>(base) graph = type
  <at..i32>(base + 4) graph = a
  <at..i32>(base + 8) graph = b
  <at..i32>(base + 12) graph = kind
  if type = 1 then do ch = 0 to 127
    if substr(mask,ch + 1,1) = '1' then <at..u8>(base + 16 + ch) graph = 1
  end
  return count

patch: procedure = .void expose graph
  arg state = .int, dest = .int
  <at..i32>((state - 1) * 144 + 4) graph = dest
  return

alternative: procedure = .int[] expose pattern cursor bad
  result = concatenation()
  do while substr(pattern,cursor,1) = '|'
    cursor = cursor + 1; right = concatenation()
    finish = node(0,0,0,0,'')
    call patch result[2], finish
    call patch right[2], finish
    result[1] = node(0,result[1],right[1],0,''); result[2] = finish
  end
  return result

concatenation: procedure = .int[] expose pattern cursor bad
  result = .int[]; result[1] = 0
  do while cursor <= length(pattern)
    ch = substr(pattern,cursor,1)
    if ch = ')' | ch = '|' then leave
    right = atom()
    if result[1] = 0 then result = right
    else do
      call patch result[2], right[1]; result[2] = right[2]
    end
  end
  if result[1] = 0 then do
    result[1] = node(0,0,0,0,''); result[2] = result[1]
  end
  return result

atom: procedure = .int[] expose pattern cursor bad
  ch = substr(pattern,cursor,1); cursor = cursor + 1
  result = .int[]
  finish = .int; start = .int; byte = .int
  if ch = '(' then do
    result = alternative()
    if substr(pattern,cursor,1) <> ')' then bad = 1
    cursor = cursor + 1
  end
  else do
    mask = copies('0',128)
    if ch = '[' then do
      invert = 0
      if substr(pattern,cursor,1) = '^' then do
        invert = 1; cursor = cursor + 1
      end
      do while cursor <= length(pattern) & substr(pattern,cursor,1) <> ']'
        low = character()
        high = low
        if substr(pattern,cursor,1) = '-' & substr(pattern,cursor + 1,1) <> ']' then do
          cursor = cursor + 1; high = character()
        end
        if high < low then bad = 1
        do byte = low to high
          if byte >= 0 & byte < 128 then mask = overlay('1',mask,byte + 1)
          else bad = 1
        end
      end
      if substr(pattern,cursor,1) <> ']' then bad = 1
      cursor = cursor + 1
      if invert then mask = translate(mask,'10','01')
    end
    else if ch = '.' then mask = copies('1',128)
    else do
      cursor = cursor - 1; byte = character()
      if byte < 128 then mask = overlay('1',mask,byte + 1)
      else bad = 1
    end
    finish = node(0,0,0,0,'')
    result[1] = node(1,finish,0,0,mask); result[2] = finish
  end
  suffix = substr(pattern,cursor,1)
  if suffix = '*' | suffix = '+' | suffix = '?' then do
    cursor = cursor + 1; finish = node(0,0,0,0,'')
    if suffix = '?' then do
      start = node(0,result[1],finish,0,''); call patch result[2], finish
    end
    else do
      loopstate = node(0,result[1],finish,0,''); call patch result[2], loopstate
      if suffix = '*' then start = loopstate
      else start = result[1]
    end
    result[1] = start; result[2] = finish
  end
  return result

character: procedure = .int expose pattern cursor bad
  ch = substr(pattern,cursor,1); cursor = cursor + 1
  if ch = '\' then do
    ch = substr(pattern,cursor,1); cursor = cursor + 1
    select ch
      when 'n' then return 10
      when 'r' then return 13
      when 't' then return 9
      when '' then do; bad = 1; return 0; end
      otherwise return c2d(ch)
    end
  end
  return c2d(ch)

nullable: procedure = .int expose graph count
  arg initial = .int
  seen = .int[]; pending = .int[]; pending[1] = initial; total = 1; seen[initial] = 1
  at = 1
  do while at <= total
    state = pending[at]; at = at + 1
    base = (state - 1) * 144
    if <at..i32>(base) graph <> 0 then iterate
    a = <at..i32>(base + 4) graph; b = <at..i32>(base + 8) graph
    if a = 0 & b = 0 then return 1
    do edge = 1 to 2
      dest = <at..i32>(base + edge * 4) graph
      if dest > 0 then do
        if seen[dest] = 0 then do
          seen[dest] = 1; total = total + 1; pending[total] = dest
        end
      end
    end
  end
  return 0
