/* Native Level L PEG-subset source generator. One rule per line. */
options levell
import rxfnsb
main: procedure = .int expose graph count pattern cursor bad names targets refs rnames rules
  arg argv = .string[]
  if argv[0] <> 2 then do
    say '/* usage: parsegen specification namespace */'; return 1
  end
  clause = .int; base = .int; a = .int; b = .int; rule = .int
  graph = .binary; count = 0; bad = 0; rules = 0
  names = .string[]; targets = .int[]; refs = .int[]; rnames = .string[]
  do while lines(argv[1])
    line = strip(linein(argv[1]))
    if line = '' then iterate
    if left(line,1) = '#' then iterate
    split = pos('<-',line)
    if split = 0 then do
      say '/* expected Name <- expression:' line '*/'; return 1
    end
    name = strip(left(line,split - 1))
    do prior = 1 to rules
      if names[prior] = name then bad = 1
    end
    rules = rules + 1; names[rules] = name
    pattern = strip(substr(line,split + 2)); cursor = 1
    targets[rules] = choice()
    call spaces
    if cursor <= length(pattern) | bad then do
      say '/* invalid grammar:' line 'at' cursor '*/'; return 1
    end
  end
  if rules = 0 then do
    say '/* empty grammar */'; return 1
  end
  do ref = 1 to refs[0]
    found = 0
    do rule = 1 to rules
      if rnames[ref] = names[rule] then found = targets[rule]
    end
    if found = 0 then do
      say '/* undefined rule:' rnames[ref] '*/'; return 1
    end
    <at..i32>((refs[ref] - 1) * 144 + 4) graph = found
  end
  /* Reject nullable repetition instead of looping or silently changing PEG. */
  empty = .int[]; changed = 1
  do while changed
    changed = 0
    do clause = 1 to count
      base = (clause - 1) * 144
      type = <at..i32>(base) graph
      a = <at..i32>(base + 4) graph; b = <at..i32>(base + 8) graph
      nullable = 0
      select type
        when 2 then nullable = empty[a] & empty[b]
        when 3 then nullable = empty[a] | empty[b]
        when 4 then nullable = empty[a]
        when 5 then nullable = 1
        when 6 then nullable = 1
        otherwise nop
      end
      if nullable & empty[clause] = 0 then do
        empty[clause] = 1; changed = 1
      end
    end
  end
  do clause = 1 to count
    base = (clause - 1) * 144
    if <at..i32>(base) graph = 6 then do
      a = <at..i32>(base + 4) graph
      if empty[a] then do
        say '/* nullable repetition rejected at clause' clause '*/'; return 1
      end
    end
  end
  say '/* Generated by native Level L parsegen; Pika-inspired subset. */'
  say 'options levell'
  say 'namespace' argv[2] 'expose parse rulematch diagnose'
  say 'import lldp'
  say 'table: procedure expose DATA'
  hex = ''
  do byteindex = 0 to <blen>(graph) - 1
    hex = hex || d2x(<at..u8>(byteindex) graph,2)
  end
  do offset = 1 to length(hex) by 160
    if offset = 1 then prefix = '  constant DATA = '
    else prefix = '                  '
    suffix = ''
    if offset + 160 > length(hex) then suffix = 'x as .binary'
    say prefix || "'" || substr(hex,offset,160) || "'" || suffix
  end
  say '  return'
  say 'parse: procedure = .int'
  say '  arg input = .int[]'
  say '  return lldp..parse(DATA,' targets[1] ',input)'
  say 'diagnose: procedure = .int'
  say '  arg input = .int[]'
  say '  return lldp..diagnose(DATA,' targets[1] ',input)'
  say 'rulematch: procedure = .int'
  say '  arg rule = .int, at = .int'
  say '  select rule'
  do rule = 1 to rules
    say '    when' rule 'then return lldp..matchat('targets[rule]',at) /*' names[rule] '*/'
  end
  say '    otherwise return -1'
  say '  end'
  say '  return -1'
  return 0

node: procedure = .int expose graph count
  arg type = .int, a = .int, b = .int, mask = .string
  count = count + 1; base = (count - 1) * 144
  call binresize graph,base + 144
  <at..i32>(base) graph = type
  <at..i32>(base + 4) graph = a
  <at..i32>(base + 8) graph = b
  if type = 1 then do symbol = 0 to 127
    if substr(mask,symbol + 1,1) = '1' then <at..u8>(base + 16 + symbol) graph = 1
  end
  return count

choice: procedure = .int expose pattern cursor
  result = concatenate()
  call spaces
  if substr(pattern,cursor,1) = '/' then do
    cursor = cursor + 1; right = choice()
    result = node(3,result,right,'')
  end
  return result

concatenate: procedure = .int expose pattern cursor bad
  result = 0
  do forever
    call spaces
    ch = substr(pattern,cursor,1)
    if ch = '' | ch = ')' | ch = '/' then leave
    next = primary()
    if result = 0 then result = next
    else result = node(2,result,next,'')
    if bad then leave
  end
  if result = 0 then result = node(5,0,0,'')
  return result

primary: procedure = .int expose pattern cursor bad refs rnames
  call spaces
  ch = substr(pattern,cursor,1); cursor = cursor + 1
  result = .int; mask = .string; byte = .int
  select ch
    when '(' then do
      result = choice(); call spaces
      if substr(pattern,cursor,1) <> ')' then bad = 1
      cursor = cursor + 1
    end
    when "'" then do
      result = 0
      do while cursor <= length(pattern) & substr(pattern,cursor,1) <> "'"
        byte = character()
        mask = overlay('1',copies('0',128),byte + 1)
        term = node(1,0,0,mask)
        if result = 0 then result = term
        else result = node(2,result,term,'')
      end
      if substr(pattern,cursor,1) <> "'" then bad = 1
      cursor = cursor + 1
      if result = 0 then result = node(5,0,0,'')
    end
    when '[' then do
      mask = copies('0',128); invert = 0
      if substr(pattern,cursor,1) = '^' then do
        invert = 1; cursor = cursor + 1
      end
      do while cursor <= length(pattern) & substr(pattern,cursor,1) <> ']'
        low = character(); high = low
        if substr(pattern,cursor,1) = '-' & substr(pattern,cursor + 1,1) <> ']' then do
          cursor = cursor + 1; high = character()
        end
        if high < low then bad = 1
        do byte = low to high
          mask = overlay('1',mask,byte + 1)
        end
      end
      if substr(pattern,cursor,1) <> ']' then bad = 1
      if invert then mask = translate(mask,'10','01')
      cursor = cursor + 1; result = node(1,0,0,mask)
    end
    when '@' then do
      start = cursor
      do while pos(substr(pattern,cursor,1),'0123456789') > 0 & cursor <= length(pattern)
        cursor = cursor + 1
      end
      if start = cursor then do
        bad = 1; result = node(5,0,0,'')
      end
      else do
        byte = substr(pattern,start,cursor - start) as .int
        if byte > 127 then bad = 1
        mask = overlay('1',copies('0',128),byte + 1)
        result = node(1,0,0,mask)
      end
    end
    otherwise do
      cursor = cursor - 1; start = cursor
      do while cursor <= length(pattern)
        ch = substr(pattern,cursor,1)
        if pos(ch,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789') = 0 then leave
        cursor = cursor + 1
      end
      if cursor = start then do
        bad = 1; cursor = cursor + 1
      end
      name = substr(pattern,start,cursor - start)
      result = node(4,0,0,'')
      index = refs[0] + 1; refs[index] = result; rnames[index] = name
    end
  end
  call spaces
  suffix = substr(pattern,cursor,1)
  if suffix = '*' | suffix = '+' | suffix = '?' then do
    cursor = cursor + 1
    select suffix
      when '*' then result = node(6,result,0,'')
      when '+' then result = node(2,result,node(6,result,0,''),'')
      when '?' then result = node(3,result,node(5,0,0,''),'')
      otherwise nop
    end
  end
  return result

spaces: procedure = .void expose pattern cursor
  do while cursor <= length(pattern) & substr(pattern,cursor,1) = ' '
    cursor = cursor + 1
  end
  return

character: procedure = .int expose pattern cursor bad
  ch = substr(pattern,cursor,1); cursor = cursor + 1
  if ch = '\' then do
    ch = substr(pattern,cursor,1); cursor = cursor + 1
    select ch
      when 'n' then return 10
      when 'r' then return 13
      when 't' then return 9
      otherwise nop
    end
  end
  byte = c2d(ch)
  if byte >= 128 then do; bad = 1; return 0; end
  return byte
