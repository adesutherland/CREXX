/* cREXX License (MIT). Owned selected Pika tree with explicit alias labels. */
options levell
namespace llpikatree expose projection
import rxfnsb
import llcore
import llhistory
import llpika
import llpikalower

/** Convert selected histories only; speculative matches are not source syntax.
 * The normalized binary-IR profile has at most two selected children.
 * Aliases share a clause and are reported together; wrapper identity is not
 * fabricated after interning. Zero-width recognition nodes (including lookahead)
 * remain in history but are omitted from this consumed-syntax projection.
 * origin() refers to the owned history snapshot.
 */
projection: class
  _lower = .llpikalower..lowering
  _parser = .llpika..parser
  _input = .llcore..stream
  _history = .llhistory..arena
  _tree = .llcore..tree
  _map = .int[]
  _origin = .int[]
  _fuel = .int
  _work = .int
  _depth = .int
  _root = .int
  _ran = .int
  _status = .int
  _error = .string
  *: factory
    arg lower = .llpikalower..lowering, parser = .llpika..parser, fuel = 1000000
    _lower = lower; _parser = parser; _fuel = fuel
    _work = 0; _depth = 0; _root = 0; _ran = 0; _status = 0; _error = ''
    return
  run: method = .int
    if _ran then return _status
    _ran = 1
    if _lower.run() <> 0 | _parser.run() <> 0 then do
      _status = 3; _error = 'selected Pika source tree requires a clean full match'; return _status
    end
    graph = _lower.graph()
    if graph.identity() \== _parser.grammaridentity() then do
      _status = 3; _error = 'Pika tree grammar identity mismatch'; return _status
    end
    _input = _parser.input(); _history = _parser.arena()
    _tree = .llcore..tree.from_source(_input.source())
    _root = copy(_parser.root())
    if _status = 0 then do
      if _tree.validate() = 0 then do
        _status = 3; _error = _tree.error()
      end
    end
    return _status
  copy: method = .int
    arg node = .int
    if _status <> 0 | node = 0 then return 0
    if _history.length(node) = 0 then return 0
    _work = _work + 1
    if _work > _fuel | _depth >= 512 then do
      _status = 2; _error = 'Pika selected-tree work/depth budget exhausted'; return 0
    end
    if _map[node] > 0 then return _map[node]
    _depth = _depth + 1
    count = _history.count(node); a = 0; b = 0
    if count > 2 then do
      _status = 3; _error = 'selected n-ary clause requires an explicit list projection'; return 0
    end
    if count > 0 then a = copy(_history.child(node,1))
    if count > 1 then b = copy(_history.child(node,2))
    clause = _history.clause(node); name = _lower.names(clause)
    if name = '' then name = 'pika.clause.' || clause
    start = _input.start(_history.start(node))
    finish = start
    if _history.length(node) > 0 then finish = _input.finish(_history.start(node) + _history.length(node))
    id = _tree.add(clause,name,start,finish,a,b)
    _origin[id] = node; _map[node] = id; _depth = _depth - 1
    return id
  tree: method = .llcore..tree
    return _tree
  root: method = .int
    return _root
  origin: method = .int
    arg node = .int
    return _origin[node]
  work: method = .int
    return _work
  error: method = .string
    return _error
