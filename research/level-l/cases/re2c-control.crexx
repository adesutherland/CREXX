/* Execute the generated native scanner through Level L's existing ADDRESS. */
options levell
import rxfnsb
import glex
import lllex
arg argv = .string[]
if argv[0] <> 1 then return 1
command = .string[]; command[1] = argv[1]
source = "foo123=12+3; /* opaque + 123 */ bar='it''s'; // skip" || '0a'x
native = glex..lex(source)
nativecount = <blen>(native) / 12
rows = .string[]; err = .string
address crexx 'run :command[]' input source output rows error err
if rc <> 0 | rows[0] <> nativecount then do
  say 'FAIL: re2c transport' rc rows[0] err; return 1
end
do index = 1 to rows[0]
  base = (index - 1) * 12
  kind = word(rows[index],1) as .int
  start = word(rows[index],2) as .int
  size = word(rows[index],3) as .int
  nativekind = <at..i32>(base) native
  nativestart = <at..i32>(base + 4) native
  nativesize = <at..i32>(base + 8) native
  if kind <> nativekind | start <> nativestart | size <> nativesize then do
    say 'FAIL: re2c span equivalence' index; return 1
  end
end
call arraydrop rows
source = "x='broken"
address crexx 'run :command[]' input source output rows error err
if rc <> 1 | rows[rows[0]] <> 'ERR 2' then do
  say 'FAIL: re2c malformed string' rc err; return 1
end
say 'PASS: Level L re2c wrapper, token/span equivalence and malformed string'
return 0
