/* Level B summary of serial research samples; no aggregate product score. */
options levelb
import rxfnsb
main: procedure = .int expose keys phases counts data groups
  arg argv = .string[]
  if argv[0] <> 1 then return 2
  keys = .string[]; phases = .string[]; counts = .int[]; data = .int[]; groups = 0
  pending = ''
  do while lines(argv[1])
    row = translate(linein(argv[1]),' ','|')
    kind = word(row,1)
    if kind = 'PHASEGEN' then do
      pending = row; iterate
    end
    if word(row,2) = '0' then iterate
    select kind
      when 'ROW' then do
        key = word(row,3) || '/' || word(row,4) || '/' || word(row,5)
        do metric = 1 to 9
          field = 16 + metric
          if metric = 9 then field = 7
          phase = word('decode lex stage initialize parse_and_internal_tree extraction visitor total_with_checks request_with_release',metric)
          call sample key,phase,word(row,field) as .int
        end
      end
      when 'GEN' then do
        call sample 'generation','complete',word(row,3) as .int
        if pending <> '' then do metric = 1 to 7
          item = word(pending,metric + 1); equal = pos('=',item)
          call sample 'generation',left(item,equal - 1),substr(item,equal + 1) as .int
        end
        pending = ''
      end
      when 'LEX' then call sample 'lexer/' || word(row,3) || '/' || word(row,4),'scan',word(row,5) as .int
      when 'SPECIAL' then call sample word(row,3) || '/' || word(row,4),'initialize_parse_tree',word(row,5) as .int
      otherwise nop
    end
  end
  if groups = 0 then return 2
  say 'case/engine/route,phase,n,min,q1,median,q3,max,mad,noise'
  do slot = 1 to groups
      values = .int[]
      do itemno = 1 to counts[slot]
        values[itemno] = data[(slot - 1) * 100 + itemno]
      end
      sorted = sort(values); count = sorted[0]; middle = med(sorted)
      deviations = .int[]
      do itemno = 1 to count
        deviations[itemno] = abs(sorted[itemno] - middle)
      end
      ordered = sort(deviations); mad = med(ordered); noisy = 0
      if middle > 0 then noisy = mad * 100 > middle * 3 | (sorted[count] - sorted[1]) * 100 > middle * 10
      else if sorted[count] > 0 then noisy = 1
      q1 = sorted[max(1,(count + 3) <idiv> 4)]; q3 = sorted[min(count,(3 * count + 3) <idiv> 4)]
      say keys[slot] || ',' || phases[slot] || ',' || count || ',' || sorted[1] || ',' || q1 || ',' || middle || ',' || q3 || ',' || sorted[count] || ',' || mad || ',' || noisy
  end
  return 0
sample: procedure = .void expose keys phases counts data groups
  arg key = .string, phase = .string, value = .int
  slot = 0
  do j = 1 to groups
    if keys[j] == key & phases[j] == phase then slot = j
  end
  if slot = 0 then do
    groups = groups + 1; slot = groups; keys[slot] = key; phases[slot] = phase
  end
  counts[slot] = counts[slot] + 1; itemno = counts[slot]
  if itemno > 100 then exit 2
  data[(slot - 1) * 100 + itemno] = value
  return
sort: procedure = .int[]
  arg values = .int[]
  do j = 2 to values[0]
    item = values[j]; k = j - 1
    do while k > 0
      if values[k] <= item then leave
      values[k + 1] = values[k]; k = k - 1
    end
    values[k + 1] = item
  end
  return values
med: procedure = .int
  arg values = .int[]
  n = values[0]
  if n <mod> 2 then return values[(n + 1) <idiv> 2]
  return (values[n <idiv> 2] + values[n <idiv> 2 + 1]) <idiv> 2
