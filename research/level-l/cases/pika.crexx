/* Native execution of pinned Pika normal forms; no Java parser at runtime. */
options levell
import rxfnsb
import llcore
import llpika
main: procedure = .int
  arg argv = .string[]
  if argv[0] <> 2 then return 2
  failures = 0; cases = 0; name = ''; root = 0
  clauses = .llpika..graph()
  zeros = .int[]
  do while lines(argv[1])
    row = linein(argv[1]); command = word(row,1)
    select command
      when 'GRAMMAR' then do
        name = word(row,2); root = word(row,4) as .int
        clauses = .llpika..graph()
      end
      when 'CLAUSE' then do
        id = word(row,2) as .int; op = word(row,3) as .int
        flags = word(row,4) as .int; value = decode(word(row,5))
        zeros[id] = word(row,6) as .int
        children = .int[]
        do i = 7 to words(row)
          children[i - 6] = word(row,i) as .int
        end
        actualid = clauses.add(op,value,children,flags)
        if actualid <> id then failures = failures + 1
      end
      when 'CASE' then do
        cases = cases + 1
        hex = word(row,2); source = decode(hex)
        input = .llcore..stream(source)
        request = .llpika..parser(clauses,root,input)
        status = request.run()
        built = clauses.build()
        if built = 0 | status > 1 then do
          say 'ERROR:' name clauses.error() request.error(); return 1
        end
        if clauses.eventpaths() < 1 then do
          say 'UNEXPECTED MISSING QUIESCENCE PROOF:' name; failures = failures + 1
        end
        do c = 1 to clauses.size()
          if zeros[c] <> clauses.zero(c) then do
            say 'ZERO FLAG DIFFERENCE:' name c 'expected' zeros[c] 'actual' clauses.zero(c); failures = failures + 1
          end
        end
        actual = 'PIKA|' || name || '|' || hex || '|' || request.result() || '|' || request.created() || '|' || request.updates() || '|' || request.entries() || '|' || request.canonical(request.root())
        expected = linein(argv[2])
        say actual
        if actual \== expected then do
          say 'DIFFERENCE: expected' expected; failures = failures + 1
        end
        sparse = .llpika..parser(clauses,root,input,1000000,8000000,'reachable-reference')
        sparsestatus = sparse.run()
        if sparsestatus <> status | sparse.canonical(sparse.root()) \== request.canonical(request.root()) | sparse.work() > request.work() then do
          say 'REACHABLE DIFFERENCE:' name hex; failures = failures + 1
        end
        arena = request.arena()
        if arena.validate(input.size()) = 0 then do
          say 'INVALID HISTORY:' name hex; failures = failures + 1
        end
      end
      otherwise do
        say 'UNKNOWN RECORD:' row; return 2
      end
    end
  end
  if lines(argv[2]) then failures = failures + 1
  input = .llcore..stream('123456789' as .binary)
  limited = .llpika..parser(clauses,root,input,1)
  if limited.run() <> 2 then failures = failures + 1
  limited = .llpika..parser(clauses,root,input,1000000,1)
  if limited.run() <> 2 then failures = failures + 1
  invalid = .llpika..graph()
  kids = .int[]
  a = invalid.add(6,'' as .binary,kids)
  b = invalid.add(1,'a' as .binary,kids)
  kids[1] = a; kids[2] = b
  badroot = invalid.add(3,'' as .binary,kids)
  badparse = .llpika..parser(invalid,badroot,input)
  if badparse.run() <> 3 | pos('nonfinal',badparse.error()) = 0 then failures = failures + 1
  cert = clauses.certificate(root)
  if pos('quadratic-input',cert) = 0 then failures = failures + 1
  chain = .llpika..graph()
  nochildren = .int[]
  a = chain.add(1,'a' as .binary,nochildren)
  pair = .int[]; pair[1] = 3; pair[2] = 1
  seq = chain.add(2,'' as .binary,pair)
  pair[1] = 2; pair[2] = 1
  root = chain.add(3,'' as .binary,pair)
  n = 8
  do while n <= 128
    input = .llcore..stream(copies('a',n) as .binary)
    request = .llpika..parser(chain,root,input)
    if request.run() <> 0 | request.created() <> n * (n + 1) | request.entries() <> 3 * n - 1 then failures = failures + 1
    paths = chain.eventpaths()
    updatebound = 3 * n * (n + 3) <idiv> 2
    /* e <= g*g; this family has no top-down negative calls. */
    eventbound = paths * (3 * n + 9 * updatebound)
    if paths < 1 | request.work() > eventbound then failures = failures + 1
    say 'PIKA_CHAIN n='n 'created='request.created() 'memo='request.entries() 'work='request.work() 'event_bound='eventbound
    n = n * 2
  end
  failures = failures + scorecases()
  /* Unreachable definitions do not consume active memo columns or events. */
  dead = .llpika..graph(); none = .int[]
  live = dead.add(1,'a' as .binary,none)
  unused = dead.add(1,'b' as .binary,none)
  unused = dead.add(1,'c' as .binary,none)
  input = .llcore..stream('a' as .binary)
  full = .llpika..parser(dead,live,input,1000000,2)
  sparse = .llpika..parser(dead,live,input,1000000,2,'reachable-reference')
  if full.run() <> 2 | sparse.run() <> 0 | sparse.active() <> 1 then failures = failures + 1
  full = .llpika..parser(dead,live,input); status = full.run()
  say 'REACHABLE_WORK full='full.work() 'selected='sparse.work() 'clauses='sparse.active()
  say 'pika_reference_cases='cases
  say 'pika_failures='failures
  if failures > 0 then return 1
  return 0
decode: procedure = .binary
  arg hex = .string
  if hex = '-' then return '' as .binary
  return x2bin(hex)

/* An intentionally rejected scoring shortcut: maximum-length alternatives.
   It repairs mixed operator growth but changes ordinary PEG commitment. */
scorecases: procedure = .int
  failures = 0; g = .llpika..graph(); kids = .int[]
  plus = g.add(1,'+' as .binary,kids); atom = g.add(1,'ab' as .binary,kids); minus = g.add(1,'-' as .binary,kids)
  three = .int[]; three[1] = 6; three[2] = plus; three[3] = atom
  seqplus = g.add(2,'' as .binary,three)
  three[2] = minus; seqminus = g.add(2,'' as .binary,three)
  three[1] = seqplus; three[2] = seqminus; three[3] = atom
  root = g.add(3,'' as .binary,three)
  input = .llcore..stream('a+b-a' as .binary)
  faithful = .llpika..parser(g,root,input)
  longest = .llpika..parser(g,root,input,1000000,8000000,'longest-choice-experiment')
  before = faithful.run(); after = longest.run()
  say 'PIKA_SCORING mixed: reference='before 'longest='after
  if before <> 1 | after <> 0 then failures = failures + 1
  /* Shorter first alternative is required to leave b for the caller. */
  g = .llpika..graph(); a = g.add(1,'a' as .binary,kids); ab = g.add(13,'ab' as .binary,kids); b = g.add(1,'b' as .binary,kids)
  pair = .int[]; pair[1] = a; pair[2] = ab; choice = g.add(3,'' as .binary,pair)
  pair[1] = choice; pair[2] = b; root = g.add(2,'' as .binary,pair)
  input = .llcore..stream('ab' as .binary)
  faithful = .llpika..parser(g,root,input)
  longest = .llpika..parser(g,root,input,1000000,8000000,'longest-choice-experiment')
  before = faithful.run(); after = longest.run()
  say 'PIKA_SCORING shorter-prefix-required: reference='before 'longest='after
  if before <> 0 | after <> 1 then failures = failures + 1
  /* A later longer alternative can conversely admit a PEG-rejected word. */
  g = .llpika..graph(); a = g.add(1,'a' as .binary,kids); ab = g.add(13,'ab' as .binary,kids); c = g.add(1,'c' as .binary,kids)
  pair[1] = a; pair[2] = ab; choice = g.add(3,'' as .binary,pair)
  pair[1] = choice; pair[2] = c; root = g.add(2,'' as .binary,pair)
  input = .llcore..stream('abc' as .binary)
  faithful = .llpika..parser(g,root,input)
  longest = .llpika..parser(g,root,input,1000000,8000000,'longest-choice-experiment')
  before = faithful.run(); after = longest.run()
  say 'PIKA_SCORING priority-lost: reference='before 'longest='after
  if before <> 1 | after <> 0 then failures = failures + 1
  return failures
