/* Compare complete canonical success/failure histories and reference counters. */
options levelb
import rxfnsb
arg argv = .string[]
if argv[0] <> 2 then return 2
count = 0; failed = 0
do while lines(argv[1])
  expected = linein(argv[1]); actual = ''
  do while lines(argv[2])
    row = linein(argv[2])
    if left(row,5) = 'CORE|' then do
      actual = space(row,0); leave
    end
  end
  count = count + 1
  if actual \== expected then do
    say 'DIFFERENCE at case' count
    say 'expected:' expected
    say 'actual:  ' actual
    failed = failed + 1
  end
end
do while lines(argv[2])
  if left(linein(argv[2]),5) = 'CORE|' then failed = failed + 1
end
say 'squirrel_reference_cases='count 'differences='failed
if failed > 0 then return 1
return 0
