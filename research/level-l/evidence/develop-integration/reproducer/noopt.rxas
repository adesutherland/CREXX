/*
 * SOURCE                 : float-comparison-reproducer.rexx
 */

.globals=0

main() .locals=1
   .meta "float-comparison-reproducer.main"="b" ".void" main() ""
   numsci 18,1,1
   .srcstep 1 1 17 "float-comparison-reproducer.rexx" 4 1 20 "say 0.1 + 0.2 = 0.3"
   load r0,0.1
   .traceevent "L" 4 "R" "F" "r" 0 1 1 0 "" ""
   fadd r0,r0,0.2
   .traceevent "O" 4 "R" "F" "r" 0 1 1 0 "" ""
   feq r0,r0,0.3
   btos r0
   .traceevent "O" 4 "R" "S" "r" 0 1 1 0 "" ""
   say r0
   .srcstep 2 2 1 "float-comparison-reproducer.rexx" 4 20 20 "say 0.1 + 0.2 = 0.3"
   ret
