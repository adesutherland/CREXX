language: procedure = .lllanguage..definition
  graph = .llcore..grammar('contextfree')
  id = graph.add(1,1,0,'identifier',4)
  id = graph.add(1,2,0,'number',5)
  id = graph.add(1,3,0,'string',6)
  id = graph.add(1,4,0,'equals',7)
  id = graph.add(1,5,0,'separator',8)
  id = graph.add(5,11,0,'root',21)
  id = graph.add(5,12,0,'first',22)
  id = graph.add(5,12,0,'second',23)
  id = graph.add(2,7,3,'sequence',21)
  id = graph.add(2,8,5,'sequence',21)
  id = graph.add(4,9,10,'choice',21)
  id = graph.add(2,2,4,'sequence',22)
  dfa = .llmunch..automaton.loaded(lexerdata())
  tables = .lllr..tables.loaded(graph,6,parserdata(),'11:contextfree;1,1,0,4,10:identifier;;1,2,0,5,6:number;;1,3,0,6,6:string;;1,4,0,7,6:equals;;1,5,0,8,9:separator;;5,11,0,21,4:root;;5,12,0,22,5:first;;5,12,0,23,6:second;;2,7,3,21,8:sequence;;2,8,5,21,8:sequence;;4,9,10,21,6:choice;;2,2,4,22,8:sequence;;|root=6')
  result = .lllanguage..definition(dfa,tables,'utf8','','')
  call result.lexical('','',-1)
  call result.token(1,'identifier')
  call result.token(2,'number')
  call result.token(3,'string')
  call result.token(4,'equals')
  call result.token(5,'separator')
  call result.diagnostic('first.error','first','ONLY_FIRST {found}',x2bin('00000000000000000000000000000000'))
  return result
