/* Level L: checking regular lexer rules */
/* Generated by Level L 1. DFA states: 8 LR states: 16 */
options levelb
namespace levell_settings expose language
import rxfnsb
import llcore
import lllr
import llmunch
import lllanguage
language: procedure = .lllanguage..definition
  graph = .llcore..grammar('contextfree')
  id = graph.add(1,1,0,'identifier',3)
  id = graph.add(1,2,0,'number',4)
  id = graph.add(1,3,0,'equals',5)
  id = graph.add(5,11,0,'root',14)
  id = graph.add(5,1,0,'@field.item',14)
  id = graph.add(7,5,0,'repeat *',14)
  id = graph.add(5,2,0,'@field.contents',14)
  id = graph.add(2,3,7,'sequence',14)
  id = graph.add(6,0,0,'empty',14)
  id = graph.add(4,8,9,'optional',14)
  id = graph.add(2,6,10,'sequence',14)
  dfa = .llmunch..automaton.loaded(lexerdata())
  tables = .lllr..tables.loaded(graph,4,parserdata(),'11:contextfree;1,1,0,3,10:identifier;;1,2,0,4,6:number;;1,3,0,5,6:equals;;5,11,0,14,4:root;;5,1,0,14,11:@field.item;;7,5,0,14,8:repeat *;;5,2,0,14,15:@field.contents;;2,3,7,14,8:sequence;;6,0,0,14,5:empty;;4,8,9,14,8:optional;;2,6,10,14,8:sequence;;|root=4')
  result = .lllanguage..definition(dfa,tables,'utf8','','')
  call result.lexical('','',-1)
  call result.token(1,'identifier')
  call result.token(2,'number')
  call result.token(3,'equals')
  call result.diagnostic('root.error','root','LIST_MESSAGE {found}',x2bin('01000000010100000001000000000000'))
  return result
lexerdata: procedure = .binary
  result = .binary
  chunk = '                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                'x as .binary
  call binappend result,chunk
  return result
parserdata: procedure = .binary
  result = .binary
  chunk = '                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        'x as .binary
  call binappend result,chunk
  return result
