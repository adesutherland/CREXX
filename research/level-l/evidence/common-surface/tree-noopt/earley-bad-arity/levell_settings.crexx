/* Level L: checking regular lexer rules */
/* Generated by Level L 1. DFA states: 8 LR states: 0 */
options levelb
namespace levell_settings expose language
import rxfnsb
import llcore
import llmunch
import lllanguage
language: procedure = .lllanguage..definition
  graph = .llcore..grammar('contextfree')
  id = graph.add(1,1,0,'identifier',3)
  id = graph.add(1,2,0,'number',4)
  id = graph.add(1,3,0,'equals',5)
  id = graph.add(5,8,0,'assignment',14)
  id = graph.add(5,1,0,'name.value',15)
  id = graph.add(5,2,0,'value',16)
  id = graph.add(2,5,3,'sequence',14)
  id = graph.add(2,7,6,'sequence',14)
  dfa = .llmunch..automaton.loaded(lexerdata())
  result = .lllanguage..definition.interpreted(dfa,graph,4,'earley','utf8','','')
  call result.lexical('','',-1)
  ok = result.keep('assignment',10,1)
  ok = result.keep('name.value',11,0)
  ok = result.keep('value',12,0)
  call result.token(1,'identifier')
  call result.token(2,'number')
  call result.token(3,'equals')
  return result
lexerdata: procedure = .binary
  result = .binary
  chunk = '                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                'x as .binary
  call binappend result,chunk
  return result
