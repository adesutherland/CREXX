/* Unicode names keep their original spelling. These are explicit ranges,
 * not a claim to implement all Unicode identifier properties. */
options levell
namespace levell_settings
identifier: token
number: token
string: token
equals: token
separator: token
expression: token
plus: token
times: token
minus: token
lparen: token
rparen: token
lbracket: token
rbracket: token
scan: lexer
  letter: charset = 'a' to 'z' | 'A' to 'Z' | '_' | U+00E9 | U+0394 | U+5EA6 | U+6E29 | U+10400
  mark: charset = U+0301
  digit: charset = '0' to '9'
  space: charset = ' ' | U+0009
  body: charset = scalar except '"' | U+000A | U+000D
  name.lex: rule = letter (letter | digit | mark)* then emit identifier
  number.lex: rule = digit+ then emit number
  string.lex: rule = '"' (body | '""')* '"' then emit string
  equals.lex: rule = '=' then emit equals
  separator.lex: rule = U+000D U+000A | U+000D | U+000A | ';' then emit separator
  plus.lex: rule = '+' then emit plus
  times.lex: rule = '*' then emit times
  minus.lex: rule = '-' then emit minus
  lparen.lex: rule = '(' then emit lparen
  rparen.lex: rule = ')' then emit rparen
  lbracket.lex: rule = '[' then emit lbracket
  rbracket.lex: rule = ']' then emit rbracket
  whitespace: rule = space+ then skip
parse: parser start arithmetic backend pratt
arithmetic: operators atom number group lparen rparen
sum: infix arithmetic plus precedence 10 left
product: infix arithmetic times precedence 20 left
negative: prefix arithmetic minus
