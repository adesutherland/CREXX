/* A delimiter-free even palindrome has a unique split determined from both ends. */
options levell
namespace levell_lesson
a: token
b: token
scan: lexer input utf8
  a.lex: rule = 'a' then emit a
  b.lex: rule = 'b' then emit b
parse: parser start palindrome backend ll1
  palindrome: rule = a palindrome a | b palindrome b | ''
