/* A simple command whose first token identifies its form. */
options levell
namespace levell_lesson
readword: token
writeword: token
identifier: token
number: token
scan: lexer input utf8
  letter: charset = 'a' to 'z'
  digit: charset = '0' to '9'
  read.lex: rule = 'read' then emit readword
  write.lex: rule = 'write' then emit writeword
  name.lex: rule = letter+ then emit identifier
  number.lex: rule = digit+ then emit number
  whitespace: rule = (' ' | U+0009)+ then skip
parse: parser start command backend lr1
  command: rule = readword identifier | writeword identifier number
  command.error: diagnostic rule command = 'Expected read NAME or write NAME NUMBER; found {found}.'
