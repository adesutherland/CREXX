/* The natural left-recursive list fits LR, not ordinary packrat or LL(1). */
options levell
namespace levell_lesson
identifier: token
comma: token
scan: lexer input utf8
  letter: charset = 'a' to 'z'
  name.lex: rule = letter+ then emit identifier
  comma.lex: rule = ',' then emit comma
  whitespace: rule = ' '+ then skip
parse: parser start list backend ll1
  list: rule = list comma identifier | identifier
