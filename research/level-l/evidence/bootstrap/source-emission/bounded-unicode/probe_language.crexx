/* Level L: checking regular lexer rules */
/* Generated by Level L 1. DFA states: 11 LR states: 0 */
options levelb
namespace probe_language expose language
import rxfnsb
import llcore
import llmunch
import lllanguage
language: procedure = .lllanguage..definition
  graph = .llcore..grammar('contextfree')
  id = graph.add(1,0,0,'eof',3)
  id = graph.add(1,1,0,'value',4)
  dfa = .llmunch..automaton.loaded(lexerdata())
  result = .lllanguage..definition.scanner(dfa,'utf8','','')
  call result.lexical('bad_encoding: malformed bytes','bad_character: unmatched scalar',0)
  call result.token(0,'eof')
  call result.token(1,'value')
  return result
lexerdata: procedure = .binary
  result = .binary
  chunk = '                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                'x as .binary
  call binappend result,chunk
  return result
