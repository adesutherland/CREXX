/* Full native c14 recovery reference correspondence, including raw error trees. */
options levell
import rxfnsb
import llcore
import llc14
import llc14cost
main: procedure = .int
  arg argv = .string[]
  if argv[0] <> 2 then return 2
  failures = 0; cases = 0; name = ''; root = 1; input = .llcore..stream
  graph = .llc14..grammar()
  do while lines(argv[1])
    row = linein(argv[1]); command = word(row,1)
    select command
      when 'GRAMMAR' then do
        name = word(row,2); graph = .llc14..grammar()
      end
      when 'CLAUSE' then do
        id = word(row,2) as .int; op = word(row,3) as .int
        a = word(row,4) as .int; b = word(row,5) as .int
        value = decode(word(row,6)); label = word(row,7)
        actualid = 0
        select op
          when 13 then actualid = graph.literal(value)
          when 16 then actualid = graph.charset(value,a)
          otherwise actualid = graph.node(op,label,a,b)
        end
        if actualid <> id then return 2
      end
      when 'EDGES' then do
        id = word(row,2) as .int
        do i = 3 to words(row)
          ok = graph.edge(id,word(row,i) as .int)
          if ok = 0 then return 2
        end
      end
      when 'CASE' then do
        cases = cases + 1; hex = word(row,2); source = decode(hex)
        input = .llcore..stream(source); request = .llc14..parser(graph,root,input,3000000)
        status = request.run()
        if status > 1 then do
          say 'ERROR:' name hex status request.error(); return 1
        end
        actual = 'C14|' || name || '|' || hex || '|' || status || '|' || request.cost() || '|' || request.canonical()
        expected = linein(argv[2]); say actual
        if actual \== expected then do
          say 'DIFFERENCE: expected' expected; failures = failures + 1
        end
        arena = request.history()
        if arena.validate(input.size()) = 0 | bincompare(request.source(),source) <> 0 then do
          say 'INVALID HISTORY:' name hex; failures = failures + 1
        end
      end
      otherwise do
        say 'UNKNOWN:' row; return 2
      end
    end
  end
  if lines(argv[2]) then failures = failures + 1
  input = .llcore..stream('abc' as .binary)
  limited = .llc14..parser(graph,root,input,1)
  if limited.run() <> 2 then failures = failures + 1
  invalid = .llc14..grammar(); node = invalid.node(1,'',97)
  malformed = .llc14..parser(invalid,node,input)
  if malformed.run() <> 3 then failures = failures + 1
  say 'c14_reference_cases='cases
  say 'c14_failures='failures
  if failures > 0 then return 1
  return 0
decode: procedure = .binary
  arg hex = .string
  if hex = '-' then return '' as .binary
  return x2bin(hex)
