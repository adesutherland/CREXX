/* Level B research measurement and ownership harness. No product verdict.
 * Round 0 is warmup; rounds 1..3 are qualification observations.
 * Recognition includes each engine's internal tree/history construction and
 * request-owned admission work. Selected-tree extraction is a separate phase.
 */
options levelb
import rxfnsb
import llcore
import llhistory
import llpeg
import lltabpeg
import llsquirrel
import lllr
import llearley
import llforest
import llpika
import llpikalower
import llpikatree
import llc14
import lllrrepair
import llrepair
import llmunch
import lllex
import lldfabuild
import llstage
import llpratt
import llregional
main: procedure = .int expose failures og cg tg pikalower tlower table ttable merged recovery dfa nfa stages opers region
  arg argv = .string[]
  failures = 0; mode = 'check'; rounds = 0
  if argv[0] > 0 then mode = argv[1]
  if mode = 'measure' then do
    rounds = 3
    if argv[0] > 1 then rounds = argv[2] as .int
    if rounds < 3 | rounds > 30 then return 2
  end
  say 'LIFECYCLE|mode='mode '|units=bytes|timing=microseconds|round0=warmup'
  do round = 0 to rounds
    begin = time('us'); call prepare; generation = time('us') - begin
    say 'GEN|'round '|'generation
    sources = .string[]; names = .string[]
    sources[1] = 'a'; names[1] = 'small'
    sources[2] = copies('a',48); names[2] = 'long-atom'
    sources[3] = 'a' || copies(';a',23); names[3] = 'many-atoms'
    sources[4] = 'a;;a'; names[4] = 'damaged'
    do caseid = 1 to 4
      do route = 0 to 1
        do e = 1 to 12
          /* c14/repair always use raw byte input in this panel. */
          if route & (e >= 9 | e = 5) then iterate
          begin = time('us')
          obs = execute(e,sources[caseid] as .binary,route)
          elapsed = time('us') - begin
          values = obs.metrics(); wanted = 0
          if caseid = 4 then wanted = 1
          call check values[1] = wanted,'expected completion engine ' || e || ' case ' || caseid || ' route ' || route
          call check obs.verify(),'owned observation'
          if e = 11 & caseid = 4 then call check values[9] = 1,'exact repair distance'
          say 'ROW|'round '|'names[caseid] '|'e '|'route '|'length(sources[caseid]) '|'elapsed '|'metricrow(values)
        end
      end
      call lexers(sources[caseid],round,names[caseid])
    end
    call specialist(round)
  end
  /* Requests deliberately overlap in lifetime and execute in different order.
   * The returned observations retain the complete request, not only its tree.
   */
  call prepare
  do e = 1 to 12
    large = execute(e,('a' || copies(';a',23)) as .binary,0)
    small = execute(e,'a' as .binary,0); before = small.fingerprint()
    damage = execute(e,'a;;a' as .binary,0)
    call check large.verify() & small.verify() & damage.verify(),'interleaved owned contexts engine ' || e
    do repetition = 1 to 8
      next = execute(e,'a' as .binary,0)
      call check next.fingerprint() == before & large.verify() & small.verify(),'small-after-large independent retained counts engine ' || e
    end
    say 'OWNED|'e '|'before
  end
  /* Request-scope teardown: repeated scoped calls do not retain results. */
  cycles = 2
  if mode = 'stress' then cycles = 40
  do cycle = 1 to cycles
    call scoped
  end
  call limits
  say 'lifecycle_failures='failures
  if failures then return 1
  return 0

prepare: procedure = .void expose failures og cg tg pikalower tlower table ttable merged recovery dfa nfa stages opers region
  begin = time('us')
  og = grammar('ordered',0); cg = grammar('contextfree',0); tg = grammar('ordered',1)
  pg = grammar('pika',0); ptg = grammar('pika',1); tcg = grammar('contextfree',1)
  grammarus = time('us') - begin
  begin = time('us'); pikalower = .llpikalower..lowering(pg,1); status = pikalower.run()
  tlower = .llpikalower..lowering(ptg,1); ts = tlower.run(); pikaus = time('us') - begin
  call check status = 0 & ts = 0,'Pika lowering'
  begin = time('us'); table = .lllr..tables(cg,1,'lr1'); status = table.status(); lrus = time('us') - begin
  begin = time('us'); ttable = .lllr..tables(tcg,1,'lr1'); ts = ttable.status(); tokenlrus = time('us') - begin
  begin = time('us'); merged = .lllr..tables(cg,1,'lalr'); ms = merged.status(); lalrus = time('us') - begin
  call check status = 0 & ts = 0 & ms = 0,'LR construction'
  begin = time('us'); nfa = makenfa(); bytes = lldfabuild..determinize(nfa,1); dfagen = time('us') - begin
  begin = time('us'); dfa = .llmunch..automaton.legacy(bytes); valid = dfa.verify(); dfainit = time('us') - begin
  call check valid,'DFA construction'
  recovery = recoverygraph(og)
  stages = .llstage..rules(); ok = stages.add('copy',0,-1,-1,1,-1,'',-1,1)
  opers = .llpratt..operators(97,40,41); ok = opers.infix(43,10,0,'add'); ok = opers.infix(42,20,0,'multiply')
  outer = .llcore..grammar('contextfree'); id = outer.add(1,250,0,'expression',1)
  region = .llregional..plan(outer,1,opers,250,91,93); rs = region.build()
  call check rs = 0,'region construction'
  say 'PHASEGEN|grammar='grammarus '|pika='pikaus '|lr='lrus '|token-lr='tokenlrus '|lalr='lalrus '|dfa-generate='dfagen '|dfa-initialize='dfainit '|g='og.size() '|q='dfa.states() '|lrstates='table.states() '|dfabytes=' || <blen>(bytes)
  return

grammar: procedure = .llcore..grammar
  arg profile = .string, token = .int
  g = .llcore..grammar(profile)
  root = g.add(5,0,0,'document',1); record = g.add(5,0,0,'record',2)
  a = g.add(1,97,0,'a',3); body = a
  if token = 0 then do
    tail = g.add(7,a,0,'letters',3); body = g.add(2,a,tail,'word',3)
  end
  ok = g.body(record,body)
  semi = g.add(1,59,0,'semicolon',4); pair = g.add(2,semi,record,'next',4)
  more = g.add(7,pair,0,'records',4); body = g.add(2,record,more,'file',4)
  ok = g.body(root,body)
  return g
makenfa: procedure = .binary
  graph = .binary; call binresize graph,864
  <at..i32>(0) graph = 0; <at..i32>(4) graph = 2; <at..i32>(8) graph = 5
  <at..i32>(144) graph = 1; <at..i32>(148) graph = 3; <at..u8>(160 + 97) graph = 1
  <at..i32>(288) graph = 0; <at..i32>(292) graph = 2; <at..i32>(296) graph = 4
  <at..i32>(432) graph = 2; <at..i32>(444) graph = 97
  <at..i32>(576) graph = 1; <at..i32>(580) graph = 6; <at..u8>(592 + 59) graph = 1
  <at..i32>(720) graph = 2; <at..i32>(732) graph = 59
  return graph

execute: procedure = .observation expose failures og cg tg pikalower tlower table ttable merged recovery dfa stages
  arg engine = .int, bytes = .binary, route = .int
  startall = time('us'); begin = time('us'); input = .llcore..stream(bytes)
  decode = time('us') - begin; lexus = 0; stageus = 0; steps = 0
  graph = og; cfg = cg; lrtable = table; plower = pikalower
  if route then do
    begin = time('us'); scanner = .llmunch..scanner(dfa,bytes,'reverse'); scanstatus = scanner.run()
    input = scanner.tokens(); lexus = time('us') - begin; steps = scanner.steps()
    call check scanstatus = 0,'timed tokenization'
    begin = time('us'); stage = .llstage..transducer(stages,input); stageStatus = stage.run(); input = stage.output()
    stageus = time('us') - begin; call check stageStatus = 0,'token identity stage'
    graph = tg; cfg = grammar('contextfree',1); lrtable = ttable; plower = tlower
  end
  tree = .llcore..tree; history = .llhistory..arena; context = .object
  root = 0; work = 0; objects = 0; secondary = 0; indexbound = 0; cost = 0; depth = 0
  initialize = 0; runus = 0; extractus = 0; passus = 0; status = 0
  begin = time('us')
  select
    when engine = 1 | engine = 2 then do
      name = 'packrat'; if engine = 2 then name = 'll1'
      p = .llpeg..parser(graph,1,input,name); initialize = time('us') - begin
      begin = time('us'); status = p.run(); runus = time('us') - begin
      tree = p.arena(); root = p.root(); work = p.work(); secondary = p.memos(); depth = p.maxdepth()
      again = p.run(); call check again = status & p.work() = work,'idempotent PEG/LL run'
      context = p as .object; indexbound = graph.size() * (input.size() + 1)
    end
    when engine = 3 then do
      tab = .lltabpeg..parser(graph,1,input); initialize = time('us') - begin
      begin = time('us'); status = tab.run(); runus = time('us') - begin
      tree = tab.tree(); root = tab.root(); work = tab.work(); again = tab.run()
      call check again = status & tab.work() = work,'idempotent tabulator'
      context = tab as .object; indexbound = graph.size() * (input.size() + 1)
    end
    when engine = 4 | engine = 5 then do
      if engine = 5 & route = 0 then lrtable = merged
      lr = .lllr..parser(lrtable,input); initialize = time('us') - begin
      begin = time('us'); status = lr.run(); runus = time('us') - begin
      tree = lr.tree(); root = lr.root(); work = lr.work(); again = lr.run()
      call check again = status & lr.work() = work,'idempotent LR'
      context = lr as .object
    end
    when engine = 6 then do
      earley = .llearley..parser(cfg,1,input); initialize = time('us') - begin
      begin = time('us'); status = earley.run(); runus = time('us') - begin
      forest = earley.forest(); work = earley.work(); objects = forest.nodes(); secondary = forest.families()
      begin = time('us'); derivations = forest.derivations(earley.root(),2); extractus = time('us') - begin
      if status = 0 then call check derivations = 1,'unique packed derivation'
      call check forest.validate(),'forest spans'
      again = earley.run(); call check again = status & earley.work() = work,'idempotent Earley'
      context = earley as .object; indexbound = 8000000
    end
    when engine = 7 then do
      pika = .llpika..parser(plower.graph(),plower.root(),input,1000000,8000000,'reachable-reference'); initialize = time('us') - begin
      begin = time('us'); status = pika.run(); runus = time('us') - begin
      history = pika.arena(); objects = pika.created(); secondary = pika.updates(); work = pika.work()
      indexbound = pika.active() * (input.size() + 1)
      if status = 0 then do
        begin = time('us'); projected = .llpikatree..projection(plower,pika); ps = projected.run()
        tree = projected.tree(); root = projected.root(); extractus = time('us') - begin
        call check ps = 0,'Pika selected tree'
      end
      again = pika.run(); call check again = status & pika.work() = work,'idempotent Pika'
      context = pika as .object
    end
    when engine = 8 then do
      squirrel = .llsquirrel..parser(graph,1,input); initialize = time('us') - begin
      begin = time('us'); status = squirrel.run(); runus = time('us') - begin
      history = squirrel.history(); root = squirrel.root(); work = squirrel.work(); objects = history.size(); secondary = squirrel.expansions()
      again = squirrel.run(); call check again = status & squirrel.work() = work,'idempotent Squirrel'
      context = squirrel as .object; indexbound = graph.size() * (input.size() + 1)
    end
    when engine = 9 | engine = 10 then do
      policy = 'c14'; if engine = 10 then policy = 'frontier-experiment'
      repaired = .llc14..parser(recovery,1,input,1000000,policy); initialize = time('us') - begin
      begin = time('us'); status = repaired.run(); runus = time('us') - begin
      history = repaired.history(); work = repaired.work(); objects = repaired.allocations(); secondary = history.size(); cost = repaired.cost()
      again = repaired.run(); call check again = status & repaired.work() = work,'idempotent c14'
      context = repaired as .object
    end
    when engine = 11 then do
      repair = .lllrrepair..request(table,input,3,3,250,500000,30000); initialize = time('us') - begin
      begin = time('us'); status = repair.run(); runus = time('us') - begin
      work = repair.work(); objects = repair.configurations(); cost = repair.cost()
      again = repair.run(); call check again = status & repair.work() = work,'idempotent LR repair'
      context = repair as .object
    end
    when engine = 12 then do
      oracle = .llrepair..oracle(cg,1,bytes,1,1,1,2)
      initialize = time('us') - begin
      begin = time('us'); rawstatus = oracle.run(); runus = time('us') - begin
      status = rawstatus; cost = oracle.cost()
      if rawstatus = 0 & cost > 0 then status = 1
      work = oracle.work(); objects = oracle.states()
      if rawstatus = 0 then do
        forest = oracle.forest(); secondary = forest.nodes()
        call check forest.validate(),'exact repair forest'
      end
      again = oracle.run(); call check again = rawstatus & oracle.work() = work,'idempotent oracle'
      context = oracle as .object
    end
    otherwise do
      call check 0,'unknown measurement engine'; status = 3
    end
  end
  if initialized(tree) then do
    if objects = 0 then objects = tree.size()
    if status = 0 then do
      /* Delayed owned-tree copy is separate from the engine's internal tree. */
      begin = time('us'); selected = copytree(tree,root); extractus = extractus + time('us') - begin
      begin = time('us'); checksum = spanchecksum(selected); passus = time('us') - begin
      call check selected.validate() & selected.owns_source() & checksum > 0,'delayed tree and visitor'
    end
  end
  total = time('us') - startall
  values = .int[]
  values[1] = status; values[2] = input.size(); values[3] = work; values[4] = objects; values[5] = secondary
  values[6] = indexbound; values[7] = steps; values[8] = depth; values[9] = cost
  values[10] = decode; values[11] = lexus; values[12] = stageus; values[13] = initialize
  values[14] = runus; values[15] = extractus; values[16] = passus; values[17] = total
  return .observation(values,bytes,input.size(),context,tree,history)

observation: class
  _data = .int[]
  _source = .binary
  _extent = .int
  _context = .object
  _tree = .llcore..tree
  _history = .llhistory..arena
  *: factory
    arg data = .int[], source = .binary, extent = .int, context = .object, tree = .llcore..tree, history = .llhistory..arena
    _data = data; _source = source; _extent = extent; _context = context; _tree = tree; _history = history
    return
  metrics: method = .int[]
    return _data
  fingerprint: method = .string
    out = ''
    do i = 1 to 9
      out = out || _data[i] || ','
    end
    return out
  verify: method = .int
    if initialized(_context) = 0 then return 0
    if initialized(_tree) then do
      if _tree.validate() = 0 | bincompare(_tree.source(),_source) <> 0 then return 0
    end
    if initialized(_history) then do
      if _history.validate(_extent) = 0 then return 0
    end
    return 1

copytree: procedure = .llcore..tree
  arg original = .llcore..tree, root = .int
  target = .llcore..tree.from_source(original.source()); used = .int[]; mapping = .int[]
  used[root] = 1; i = .int
  do i = original.size() to 1 by -1
    if used[i] then do
      a = original.left(i); b = original.right(i)
      if a > 0 then used[a] = 1
      if b > 0 then used[b] = 1
    end
  end
  do i = 1 to original.size()
    if used[i] then do
      a = original.left(i); b = original.right(i); leftnode = 0; rightnode = 0
      if a > 0 then leftnode = mapping[a]
      if b > 0 then rightnode = mapping[b]
      kind = original.kind(i); name = original.label(i)
      start = original.start(i); finish = original.finish(i)
      created = target.add(kind,name,start,finish,leftnode,rightnode)
      mapping[i] = created
    end
  end
  return target
spanchecksum: procedure = .int
  arg tree = .llcore..tree
  out = 0
  do i = 1 to tree.size()
    out = out + tree.finish(i) - tree.start(i) + 1
  end
  return out

lexers: procedure = .void expose failures nfa dfa
  arg source = .string, round = .int, label = .string
  begin = time('us'); tokens = lllex..scan(source,nfa,1); nfaus = time('us') - begin
  steps = lllex..scansteps(); ns = lllex..scanstatus(); count = <blen>(tokens) <idiv> 12
  say 'LEX|'round '|'label '|nfa|'nfaus '|'steps '|'count
  do mode = 1 to 2
    policy = 'munch'; if mode = 2 then policy = 'reverse'
    begin = time('us'); scan = .llmunch..scanner(dfa,source as .binary,policy); status = scan.run(); elapsed = time('us') - begin
    out = scan.tokens(); call check status = ns & out.size() = count,'lexer equivalence'
    do i = 1 to count
      call check out.symbol(i - 1) = <at..i32>((i - 1) * 12) tokens,'token kind'
    end
    say 'LEX|'round '|'label '|'policy '|'elapsed '|'scan.steps() '|'out.size()
  end
  return

specialist: procedure = .void expose failures opers region
  arg round = .int
  do n = 1 to 16 by 15
    text = 'a' || copies('+a',n - 1); input = .llcore..stream(text as .binary)
    begin = time('us'); p = .llpratt..parser(opers,input); status = p.run(); elapsed = time('us') - begin
    tree = p.tree(); call check status = 0 & tree.validate(),'Pratt lifecycle'
    say 'SPECIAL|'round '|pratt|'n '|'elapsed '|'p.work() '|'tree.size()
    input = .llcore..stream(('[' || text || ']') as .binary)
    begin = time('us'); composite = .llregional..parser(region,input); status = composite.run(); elapsed = time('us') - begin
    tree = composite.tree(); call check status = 0 & tree.validate(),'composite lifecycle'
    say 'SPECIAL|'round '|composite|'n '|'elapsed '|'composite.work() '|'tree.size()
  end
  return

scoped: procedure = .void
  do e = 1 to 12
    one = execute(e,('a' || copies(';a',23)) as .binary,0)
    two = execute(e,'a' as .binary,0)
  end
  return
limits: procedure = .void expose failures og cg pikalower table recovery dfa
  input = .llcore..stream('a;a' as .binary)
  p = .llpeg..parser(og,1,input,'packrat',1); call check p.run() = 2,'PEG fuel'
  s = .llsquirrel..parser(og,1,input,1); call check s.run() = 2,'Squirrel fuel'
  t = .lltabpeg..parser(og,1,input,1000,1); call check t.run() = 2,'tabulator cells'
  k = .llpika..parser(pikalower.graph(),pikalower.root(),input,1000,1); call check k.run() = 2,'Pika cells'
  e = .llearley..parser(cg,1,input,1000,1); call check e.run() = 2,'Earley cells'
  l = .lllr..parser(table,input,1); call check l.run() = 2,'LR fuel'
  r = .llc14..parser(recovery,1,input,1); call check r.run() = 2,'c14 fuel'
  scan = .llmunch..scanner(dfa,'a;a' as .binary,'reverse',1); call check scan.run() = 2,'lexer fuel'
  return
recoverygraph: procedure = .llc14..grammar
  arg source = .llcore..grammar
  target = .llc14..grammar()
  do i = 1 to source.size()
    id = target.node(source.op(i),source.label(i),source.left(i),source.right(i))
  end
  do i = 1 to source.size()
    op = source.op(i)
    if op = 2 | op = 3 then do
      ok = target.edge(i,source.left(i)); ok = target.edge(i,source.right(i))
    end
    else if op = 5 | op = 7 then ok = target.edge(i,source.left(i))
  end
  return target
metricrow: procedure = .string
  arg data = .int[]
  out = ''
  do i = 1 to data[0]
    if i > 1 then out = out || '|'
    out = out || data[i]
  end
  return out
check: procedure = .void expose failures
  arg condition = .int, text = .string
  if condition = 0 then do
    failures = failures + 1; say 'FAIL:' text
  end
  return
