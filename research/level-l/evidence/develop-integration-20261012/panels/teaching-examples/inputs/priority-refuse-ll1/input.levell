/* Configuration values: recognize boolean words before the general word form. */
options levell
namespace levell_lesson
trueword: token
falseword: token
identifier: token
string: token
scan: lexer
  letter: charset = 'a' to 'z'
  body: charset = scalar except ('"' | U+000A | U+000D)
  true.lex: rule = 'true' then emit trueword
  false.lex: rule = 'false' then emit falseword
  name.lex: rule = letter+ then emit identifier
  string.lex: rule = '"' (body | '""')* '"' then emit string
  whitespace: rule = (' ' | U+0009 | U+000A | U+000D)+ then skip
parse: parser start value backend ll1
  value: rule = boolean | bareword | quoted
  boolean: rule = trueword | falseword
  bareword: rule = identifier | trueword | falseword
  quoted: rule = string
