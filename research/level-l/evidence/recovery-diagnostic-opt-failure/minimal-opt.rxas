.globals=0

main() .locals=0
   .meta "diagnostic-call-repro.main"="b" ".int" main() ""
   .srcstep 4 4 17 "diagnostic-call-repro.crexx" 4 1 23 "main: procedure = .int"
   numsci 18,1,1
   .srcstep 2 2 17 "diagnostic-call-repro.crexx" 6 3 42 "  call diagnostic at,'L' || code,'need a'"
   .srcstep 1 1 17 "diagnostic-call-repro.crexx" 10 3 50 "  say 'DIAGNOSTIC|'code '|byte='at '|'expectation"
   say "DIAGNOSTIC|L12 |byte=0 |need a"
   .srcstep 3 3 17 "diagnostic-call-repro.crexx" 7 3 11 "  return 0"
   .meta "diagnostic-call-repro.main.at"="b" ".int" "0"
   .meta "diagnostic-call-repro.main.code"="b" ".int" "12"
   ret 0
   .meta "diagnostic-call-repro.main.at"
   .meta "diagnostic-call-repro.main.code"
