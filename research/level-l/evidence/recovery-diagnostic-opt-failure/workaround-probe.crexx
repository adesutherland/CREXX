/* Frozen compiler probe: imported parser accessor and nested stream lookup. */
options levell
import rxfnsb
import llcore
import lllabel
main: procedure = .int
  g = .llcore..grammar('ordered'); a = g.add(1,97,0,'a',1)
  input = .llcore..stream('b' as .binary)
  value = .lllabel..parser(g,a,input); ok = value.annotate(a,12,'need a'); status = value.run()
  code = value.thrown(); say 'before' status code
  at = value.offset(); code = value.thrown(); say 'after' at code
  call diagnostic 'b' as .binary,value.offset(),'L' || value.thrown(),value.error(),'hint'
  return 0
diagnostic: procedure = .void
  arg bytes = .binary, at = .int, code = .string, expectation = .string, suggestion = .string
  say 'DIAGNOSTIC|'code '|byte='at '|'expectation
  start = 0; line = 1; opener = -1; stack = .int[]; depth = 0
  do i = 0 to min(at,<blen>(bytes)) - 1
    byte = <at..u8>(i) bytes
    if byte = 10 then do
      line = line + 1; start = i + 1
    end
    if byte = 91 then do
      depth = depth + 1; stack[depth] = i
    end
    if byte = 93 & depth > 0 then depth = depth - 1
  end
  if depth > 0 then opener = stack[depth]
  text = ''; column = 0
  do i = start to <blen>(bytes) - 1
    byte = <at..u8>(i) bytes
    if byte = 10 then leave
    piece = d2c(byte)
    if byte < 32 | byte > 126 then piece = '\x' || right(d2x(byte),2,'0')
    text = text || piece
    if i < at then column = column + length(piece)
  end
  say 'Source line' line
  say text
  say copies(' ',column) || '^'
  if opener >= 0 then say 'Related opening [ at byte' opener
  say suggestion
  return
