/* Frozen optimized compiler concatenation of arguments in inlined callee. */
options levell
import rxfnsb
main: procedure = .int
  at = 0; code = 12
  call diagnostic at,'L' || code,'need a'
  return 0
diagnostic: procedure = .void
  arg at = .int, code = .string, expectation = .string
  say 'DIAGNOSTIC|'code '|byte='at '|'expectation
  return
