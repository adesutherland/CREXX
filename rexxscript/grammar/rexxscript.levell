/* RexxScript 1: modern scalar Level G NUMERIC_COMMON; review implementation. */
options levell
namespace rexxscriptgrammar

identifier: token = 1
number: token = 2
string: token = 3
separator: token = 4
assign: token = 5 then tree assign()
plus: token = 6 then tree plus()
minus: token = 7 then tree minus()
times: token = 8 then tree times()
divide: token = 9 then tree divide()
remainder: token = 10 then tree remainder()
power: token = 11 then tree power()
concat: token = 12 then tree concat()
blank: token = 13 then tree blank()
abut: token = 14 then tree abut()
open: token = 15
close: token = 16
comma: token = 17
lt: token = 18 then tree lt()
gt: token = 19 then tree gt()
le: token = 20 then tree le()
ge: token = 21 then tree ge()
ne: token = 22 then tree ne()
strict: token = 23 then tree strict()
strictne: token = 24 then tree strictne()
strictlt: token = 25 then tree strictlt()
strictgt: token = 26 then tree strictgt()
strictle: token = 27 then tree strictle()
strictge: token = 28 then tree strictge()
and: token = 29 then tree and()
or: token = 30 then tree or()
xor: token = 31 then tree xor()
not: token = 32 then tree not()
bitand: token = 33 then tree bitand()
bitor: token = 34 then tree bitor()
bitxor: token = 35 then tree bitxor()
bitnot: token = 36 then tree bitnot()
idiv: token = 37 then tree idiv()
shl: token = 38 then tree shl()
shr: token = 39 then tree shr()
has: token = 40 then tree has()
set: token = 41 then tree set()
clear: token = 42 then tree clear()
ifword: token = 43
thenword: token = 44
elseword: token = 45
doword: token = 46
endword: token = 47
whileword: token = 48
untilword: token = 49
foreverword: token = 50
toword: token = 51
byword: token = 52
leaveword: token = 53
iterateword: token = 54
returnword: token = 55
sayword: token = 56
collectword: token = 57
callword: token = 58
nopword: token = 59

controlvariable: token = 60
imod: token = 61 then tree imod()

comment: comments nested "/*" "*/"
scan: lexer input utf8bytes
  digit: charset = U+0030 to U+0039
  letter: charset = U+0041 to U+005A | U+0061 to U+007A | U+005F
  hex: charset = U+0030 to U+0039 | U+0041 to U+0046 | U+0061 to U+0066
  hspace: charset = U+0009 | U+0020
  newline: charset = U+000A | U+000D
  squote.body: charset = U+0020 to U+0026 | U+0028 to U+00FF | U+0009
  dquote.body: charset = U+0020 to U+0021 | U+0023 to U+00FF | U+0009
  numeric: pattern = (digit+ ("." digit*)? | "." digit+) (("e" | "E") ("+" | "-")? digit+)?
  name: pattern = letter (letter | digit)*
  whitespace: rule = hspace+ then skip
  numeric.literal: rule = (numeric ("d" | "D")? | "0" ("x" | "X") hex+) then emit number
  name.literal: rule = name then emit identifier
  single.literal: rule = "'" (squote.body | "''")* "'" then emit string
  double.literal: rule = '"' (dquote.body | '""')* '"' then emit string
  terminator: rule = (newline | ";") then emit separator
  op.0: rule = "=" then emit assign
  op.1: rule = "+" then emit plus
  op.2: rule = "-" then emit minus
  op.3: rule = "*" then emit times
  op.4: rule = "/" then emit divide
  op.5: rule = "%" then emit remainder
  op.6: rule = "//" then emit remainder
  op.7: rule = "**" then emit power
  op.8: rule = "||" then emit concat
  op.9: rule = "(" then emit open
  op.10: rule = ")" then emit close
  op.11: rule = "," then emit comma
  op.12: rule = "<" then emit lt
  op.13: rule = ">" then emit gt
  op.14: rule = "<=" then emit le
  op.15: rule = ">=" then emit ge
  op.16: rule = "<>" then emit ne
  op.17: rule = "><" then emit ne
  op.18: rule = "\=" then emit ne
  op.19: rule = "/=" then emit ne
  op.20: rule = "==" then emit strict
  op.21: rule = "\==" then emit strictne
  op.22: rule = "/==" then emit strictne
  op.23: rule = "<<" then emit strictlt
  op.24: rule = ">>" then emit strictgt
  op.25: rule = "<<=" then emit strictle
  op.26: rule = ">>=" then emit strictge
  op.27: rule = "&" then emit and
  op.28: rule = "|" then emit or
  op.29: rule = "&&" then emit xor
  op.30: rule = "\" then emit not
  op.31: rule = "<" ("a" | "A") ("n" | "N") ("d" | "D") ">" then emit bitand
  op.32: rule = "<" ("o" | "O") ("r" | "R") ">" then emit bitor
  op.33: rule = "<" ("x" | "X") ("o" | "O") ("r" | "R") ">" then emit bitxor
  op.34: rule = "<" ("n" | "N") ("o" | "O") ("t" | "T") ">" then emit bitnot
  op.35: rule = "<" ("i" | "I") ("d" | "D") ("i" | "I") ("v" | "V") ">" then emit idiv
  op.36: rule = "<" ("m" | "M") ("o" | "O") ("d" | "D") ">" then emit imod
  op.37: rule = "<" ("r" | "R") ("e" | "E") ("m" | "M") ">" then emit imod
  op.38: rule = "<" ("s" | "S") ("h" | "H") ("l" | "L") ">" then emit shl
  op.39: rule = "<" ("s" | "S") ("h" | "H") ("r" | "R") ">" then emit shr
  op.40: rule = "<" ("h" | "H") ("a" | "A") ("s" | "S") ">" then emit has
  op.41: rule = "<" ("s" | "S") ("e" | "E") ("t" | "T") ">" then emit set
  op.42: rule = "<" ("c" | "C") ("l" | "L") ("e" | "E") ("a" | "A") ("r" | "R") ">" then emit clear

parse: parser semantics contextfree input tokens start program
  program: rule = statements as body then tree Program(body = body)
  statements: rule = separator* (statement as item (separator (statement as item)?)*)?
    then tree Sequence(items = item*)
  statement: rule = closed.statement | open.statement
  closed.statement: rule = simple | block | if.closed
  open.statement: rule = if.open | if.continued
  if.closed: rule = ifword expression as condition thenword closed.statement as yes elseword closed.statement as no
    then tree IfElse(condition = condition, yes = yes, no = no)
  if.open: rule = ifword expression as condition thenword statement as yes
    then tree IfThen(condition = condition, yes = yes)
  if.continued: rule = ifword expression as condition thenword closed.statement as yes elseword open.statement as no
    then tree IfElse(condition = condition, yes = yes, no = no)
  simple: rule = assignment | say.statement | collect.statement | call.statement | return.statement | leave.statement | iterate.statement | nop.statement
  assignment: rule = name.value as name assign expression as value
    then tree Assignment(name = text(name), value = value)
  say.statement: rule = sayword expression as value then tree Say(value = value)
  collect.statement: rule = collectword expression as value then tree Collect(value = value)
  call.statement: rule = callword call.value as value then tree Invoke(value = value)
  return.statement: rule = returnword (expression as value)? then tree Return(value = value?)
  leave.statement: rule = leaveword then tree Leave()
  iterate.statement: rule = iterateword then tree Iterate()
  nop.statement: rule = nopword then tree Nop()
  block: rule = do.group | do.while | do.until | do.forever | do.count | do.control
  do.group: rule = doword separator statements as body endword then tree Block(body = body)
  do.while: rule = doword whileword expression as condition separator statements as body endword
    then tree While(condition = condition, body = body)
  do.until: rule = doword untilword expression as condition separator statements as body endword
    then tree Until(condition = condition, body = body)
  do.forever: rule = doword foreverword separator statements as body endword then tree Forever(body = body)
  do.count: rule = doword expression as count separator statements as body endword then tree Repeat(count = count, body = body)
  control.name: rule = controlvariable
  do.control: rule = doword control.name as name expression as initial toword expression as last (byword expression as step)? separator statements as body endword
    then tree Controlled(name = text(name), initial = initial, last = last, step = step?, body = body)

  expression: rule = logical.or
  logical.or: rule = logical.and as item ((or | xor) as op logical.and as item)*
    then tree Chain(operands = item+, operators = op*)
  logical.and: rule = comparison as item (and as op comparison as item)*
    then tree Chain(operands = item+, operators = op*)
  comparison: rule = concatenation as item ((assign | ne | lt | gt | le | ge | strict | strictne | strictlt | strictgt | strictle | strictge) as op concatenation as item)*
    then tree Chain(operands = item+, operators = op*)
  concatenation: rule = integer.or as item ((concat | blank | abut) as op integer.or as item)*
    then tree Chain(operands = item+, operators = op*)
  integer.or: rule = integer.xor as item ((bitor | set) as op integer.xor as item)*
    then tree Chain(operands = item+, operators = op*)
  integer.xor: rule = integer.and as item (bitxor as op integer.and as item)*
    then tree Chain(operands = item+, operators = op*)
  integer.and: rule = shift as item ((bitand | has | clear) as op shift as item)*
    then tree Chain(operands = item+, operators = op*)
  shift: rule = additive as item ((shl | shr) as op additive as item)*
    then tree Chain(operands = item+, operators = op*)
  additive: rule = multiplicative as item ((plus | minus) as op multiplicative as item)*
    then tree Chain(operands = item+, operators = op*)
  multiplicative: rule = unary as item ((times | divide | remainder | idiv | imod) as op unary as item)*
    then tree Chain(operands = item+, operators = op*)
  unary: rule = prefix | exponential
  prefix: rule = (plus | minus | not | bitnot) as op unary as value
    then tree Prefix(operator = op, value = value)
  exponential: rule = primary as item (power as op exponential as item)?
    then tree Chain(operands = item+, operators = op*)
  primary: rule = number.value | string.value | name.value | call.value | group.value
  number.value: rule = number then tree Number(spelling = text)
  string.value: rule = string then tree String(spelling = text)
  name.value: rule = identifier then tree Name(spelling = text)
  group.value: rule = open expression as value close then tree Group(value = value)
  call.value: rule = identifier as name open arguments as arguments close
    then tree Call(name = text(name), arguments = arguments)
  arguments: rule = argument as item (comma argument as item)* then tree Arguments(items = item+)
  argument: rule = (expression as value)? then tree Argument(value = value?)

classify: tokenstage start 1
word.if: transform stage classify state 1 take identifier text "IF" unless next assign emit ifword next 2
word.do: transform stage classify state 1 take identifier text "DO" unless next assign emit doword next 3
word.leave: transform stage classify state 1 take identifier text "LEAVE" unless next assign emit leaveword next 2
word.iterate: transform stage classify state 1 take identifier text "ITERATE" unless next assign emit iterateword next 2
word.return: transform stage classify state 1 take identifier text "RETURN" unless next assign emit returnword next 2
word.say: transform stage classify state 1 take identifier text "SAY" unless next assign emit sayword next 2
word.collect: transform stage classify state 1 take identifier text "COLLECT" unless next assign emit collectword next 2
word.call: transform stage classify state 1 take identifier text "CALL" unless next assign emit callword next 2
word.nop: transform stage classify state 1 take identifier text "NOP" unless next assign emit nopword next 2
word.then: transform stage classify state 0 take identifier text "THEN" emit thenword next 1
word.else: transform stage classify state 0 take identifier text "ELSE" emit elseword next 1
word.end: transform stage classify state 0 take identifier text "END" unless next assign emit endword next 2
word.while: transform stage classify state 0 take identifier text "WHILE" unless next assign emit whileword next 2
word.until: transform stage classify state 0 take identifier text "UNTIL" unless next assign emit untilword next 2
word.forever: transform stage classify state 0 take identifier text "FOREVER" unless next assign emit foreverword next 2
word.to: transform stage classify state 0 take identifier text "TO" unless next assign emit toword next 2
word.by: transform stage classify state 0 take identifier text "BY" unless next assign emit byword next 2
word.control: transform stage classify state 3 take identifier assign emit controlvariable next 2
word.separator: transform stage classify state 0 take separator emit copy next 1
word.other: transform stage classify state 1 take any emit copy next 2
