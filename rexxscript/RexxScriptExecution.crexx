/* cREXX License (MIT). RexxScript 1 execution of selected, owned source trees. */
options levelb numeric_common
namespace rexxscript1run expose execution
import rxfnsb
import rexxscript1
import rexxscriptoperators
import rexxscriptbifs
import rexxvalue
import rexxpool
import rexxclassicconfig
import rexxclassicbifs
import llast
import rexxscriptanalysis
import llsource

/** One execution owns all mutable state. Construct another to rerun a program.
 * No repaired parse is executable. Fuel bounds interpreter work, not arbitrary
 * library implementation work; BIF requests have a separate allocation guard.
 */
execution: class
  _program = .rexxscript1..program
  _tree = .llast..tree
  _fold = .int
  _pool = .RexxVariablePool
  _config = .RexxClassicConfig
  _output = .string[]
  _collected = .RexxValue[]
  _result = .RexxValue
  _fuel = .int
  _maximum = .int
  _bytes = .int
  _cancelled = .int
  _ran = .int
  _status = .int
  _code = .string
  _message = .string
  _node = .llast..node
  _flow = .int
  _loops = .int
  _depth = .int
  *: factory
    arg program = .rexxscript1..program, fuel = 100000, maximum = 1048576, fold = 1
    _program = program; _pool = .RexxVariablePool(); _config = .RexxClassicConfig("UTF8")
    _result = .RexxValue(''); _fuel = fuel; _maximum = maximum; _bytes = 0; _cancelled = 0
    _ran = 0; _status = 0; _code = ''; _message = ''; _fold = fold; _flow = 0; _loops = 0; _depth = 0
    return
  cancel: method = .void
    _cancelled = 1
    return
  fail: method = .void
    arg code = .string, message = .string, node = .llast..node, status = 1
    if _status <> 0 then return
    _status = status; _code = code; _message = message; _node = node
    return
  tick: method = .int
    arg node = .llast..node
    _node = node
    if _cancelled then call fail('RS_CANCELLED','execution cancelled',node,3)
    _fuel = _fuel - 1
    if _fuel < 0 then call fail('RS_FUEL','execution fuel exhausted',node,2)
    return _status = 0
  run: method = .int
    if _ran then return _status
    _ran = 1
    parsed = _program.compile()
    if parsed <> 0 then do
      _status = 1
      if parsed = 2 then _status = 2
      _code = _program.code(); _message = _program.error(); return _status
    end
    _tree = _program.ast()
    call validate(_tree.root(),0,0)
    if _status <> 0 then return _status
    if _cancelled then do
      call fail('RS_CANCELLED','execution cancelled',_tree.root(),3); return _status
    end
    if _fold then do
      folded = rexxscriptanalysis..fold(reference _tree)
      if folded.status() <> 0 then do
        _status = 1
        if folded.status() = 2 then _status = 2
        _code = 'RS_AST'; _message = folded.error(); return _status
      end
      _tree = folded
    end
    do
      call statement(_tree.root())
    on signal
      call fail('RS_VALUE','invalid conversion or arithmetic/BIF operation',_node)
    end
    return _status
  validate: method = .void
    arg node = .llast..node, loops = .int, depth = .int
    levels = .int[]; nestings = .int[]
    walker = _tree.walk('parents first')
    do while walker.next() & _status = 0
      current = walker.node(); level = walker.depth() + 1
      loops = 0; depth = 0
      if level > 1 then do
        loops = levels[level - 1]; depth = nestings[level - 1]
      end
      name = current.kind()
      if (name = 'Leave' | name = 'Iterate') & loops = 0 then do
        call fail('RS_CONTROL',lower(name) || '.statement outside a loop',current); return
      end
      if wordpos(name,'While Until Forever Repeat Controlled') > 0 then loops = loops + 1
      if wordpos(name,'Block While Until Forever Repeat Controlled IfThen IfElse Group Call Prefix') > 0 then depth = depth + 1
      if depth > 128 then do
        call fail('RS_DEPTH','source nesting limit exceeded',current,2); return
      end
      levels[level] = loops; nestings[level] = depth
    end
    return
  sequence: method = .void
    arg node = .llast..node
    items = node.each('items')
    do while items.next()
      if _status <> 0 | _flow <> 0 then return
      child = items.node()
      if tick(child) = 0 then return
      call statement(child)
    end
    return
  statement: method = .void
    arg node = .llast..node
    if node.valid() = 0 | _flow <> 0 | _status <> 0 then return
    if tick(node) = 0 then return
    name = node.kind(); count = node.children()
    select name
      when 'Sequence' then call sequence(node)
      when 'Assignment' then do
        key = upper(strip(node.text('name')))
        value = expression(node.child('value'))
        if _status = 0 then call _pool.setValue(key,value)
      end
      when 'Say' then do
        value = expression(node.child('value')); text = value.asString()
        if _status = 0 then call outputvalue(text,node)
      end
      when 'Collect' then do
        value = expression(node.child('value'))
        if _status = 0 then do
          _bytes = _bytes + <blen>(value.asBinary())
          if _bytes > _maximum then call fail('RS_OUTPUT_LIMIT','collected/output byte limit exceeded',node,2)
          else _collected[_collected[0] + 1] = value
        end
      end
      when 'Invoke' then do
        ignored = expression(node.child('value'))
      end
      when 'Return' then do
        value = .RexxValue('')
        if node.count('value') > 0 then value = expression(node.child('value'))
        if _status = 0 then do
          _result = value; _flow = 3
        end
      end
      when 'Leave' then _flow = 1
      when 'Iterate' then _flow = 2
      when 'Nop' then nop
      when 'IfElse' then call conditional(node)
      when 'IfThen' then call conditional(node)
      when 'Block' then call statement(node.child('body'))
      when 'Program' then call statement(node.child('body'))
      when 'While' then call execute_loop(node)
      when 'Until' then call execute_loop(node)
      when 'Forever' then call execute_loop(node)
      when 'Repeat' then call execute_loop(node)
      when 'Controlled' then call execute_loop(node)
      otherwise do
        /* Transparent statement/list nodes preserve the authored child order. */
        do i = 1 to count while _status = 0 & _flow = 0
          call statement(node.at(i))
        end
      end
    end
    return
  conditional: method = .void
    arg node = .llast..node
    value = expression(node.child('condition'))
    if _status <> 0 then return
    if rexxscriptoperators..truth(value) then call statement(node.child('yes'))
    else if node.kind() = 'IfElse' then call statement(node.child('no'))
    return
  execute_loop: method = .void
    arg node = .llast..node
    value = .RexxValue; condition = .RexxValue; current = .RexxValue
    name = node.kind(); count = node.children(); body = node.child('body')
    iterations = 0; limit = 0; key = ''; step = .RexxValue.fromInt(1); finish = .RexxValue.fromInt(0)
    if name = 'Repeat' then do
      value = expression(node.child('count')); limit = value.asInt()
      if limit < 0 then do
        call fail('RS_LOOP','negative loop count',node); return
      end
    end
    if name = 'Controlled' then do
      header = strip(node.text('name')); key = upper(strip(left(header,length(header) - 1)))
      value = expression(node.child('initial')); finish = expression(node.child('last'))
      if node.count('step') > 0 then step = expression(node.child('step'))
      if step.asDecimal() = 0 then do
        call fail('RS_LOOP','DO BY must be nonzero',node); return
      end
      if _status = 0 then call _pool.setValue(key,value)
    end
    _loops = _loops + 1
    do while _status = 0 & _flow = 0
      if tick(node) = 0 then leave
      if name = 'Repeat' & iterations >= limit then leave
      if name = 'While' then do
        condition = expression(node.child('condition'))
        if rexxscriptoperators..truth(condition) = 0 | _status <> 0 then leave
      end
      if name = 'Controlled' then do
        current = _pool.value(key)
        if step.asDecimal() > 0 & current.asDecimal() > finish.asDecimal() then leave
        if step.asDecimal() < 0 & current.asDecimal() < finish.asDecimal() then leave
      end
      call statement(body)
      if _flow = 3 | _status <> 0 then leave
      if _flow = 1 then do
        _flow = 0; leave
      end
      if _flow = 2 then _flow = 0
      iterations = iterations + 1
      if name = 'Until' then do
        condition = expression(node.child('condition'))
        if rexxscriptoperators..truth(condition) then leave
      end
      if name = 'Controlled' then do
        current = _pool.value(key)
        following = rexxscriptoperators..binary('plus',current,step)
        call _pool.setValue(key,following)
      end
    end
    _loops = _loops - 1
    return
  expression: method = .RexxValue
    arg node = .llast..node
    value = .RexxValue('')
    if node.valid() = 0 | _status <> 0 then return value
    if tick(node) = 0 then return value
    if _depth >= 128 then do
      call fail('RS_DEPTH','expression nesting limit exceeded',node,2); return value
    end
    name = node.kind()
    nested = name = 'Group' | name = 'Call' | name = 'Prefix'
    if name = 'Chain' then do
      if node.count('operators') > 0 then nested = node.child('operators').kind() = 'power'
    end
    _depth = _depth + nested
    select name
      when 'Number' then value = rexxscriptoperators..number(node.text('spelling'))
      when 'String' then value = rexxscriptoperators..stringliteral(node.text('spelling'))
      when 'Name' then do
        key = upper(strip(node.text('spelling')))
        if _pool.hasBinding(key) = 0 then call fail('RS_UNDEFINED','undefined variable ' || key,node)
        else value = _pool.value(key)
      end
      when 'Group' then value = expression(node.child('value'))
      when 'Call' then value = builtin(node)
      when 'Prefix' then do
        operation = node.child('operator').kind(); argument = node.child('value')
        /* The signed minimum's positive magnitude is not representable. */
        if operation = 'minus' & strip(argument.sourcetext()) = '9223372036854775808' then value = .RexxValue.fromInt(-9223372036854775808)
        else do
          operand = expression(argument)
          if _status = 0 then value = rexxscriptoperators..unary(operation,operand)
        end
      end
      when 'Chain' then do
        operands = node.each('operands'); operators = node.each('operators')
        ok = operands.next(); value = expression(operands.node())
        do while operators.next() & _status = 0
          ok = operands.next(); op = operators.node().kind()
          /* Evaluation, unlike analysis, follows only the chosen operands. */
          if op = 'and' then do
            if rexxscriptoperators..truth(value) = 0 then do
              value = .RexxValue.fromInt(0); iterate
            end
          end
          if op = 'or' then do
            if rexxscriptoperators..truth(value) then do
              value = .RexxValue.fromInt(1); iterate
            end
          end
          right = expression(operands.node())
          if _status = 0 then value = rexxscriptoperators..binary(op,value,right)
        end
      end
      otherwise call fail('RS_AST','unexpected expression kind ' || name,node)
    end
    _depth = _depth - nested
    if _status = 0 & (value.hasString() | value.hasBinary()) then do
      if <blen>(value.asBinary()) > _maximum then call fail('RS_VALUE_LIMIT','value byte limit exceeded',node,2)
    end
    return value
  builtin: method = .RexxValue
    arg node = .llast..node
    i = .int
    name = upper(strip(node.text('name')))
    arguments = node.child('arguments'); values = .RexxValue[]; exists = .int[]; total = 0
    items = arguments.each('items')
    do while items.next()
      argument = items.node(); total = total + 1
      exists[total] = argument.count('value') <> 0
      value = .RexxValue('')
      if exists[total] then value = expression(argument.child('value'))
      values[total] = value
    end
    /* f() has zero arguments; f(,) has two omitted argument positions. */
    if total = 1 & exists[1] = 0 then do
      absent = .int[]; empty = .RexxValue[]
      exists = absent; values = empty
    end
    if _status <> 0 then return .RexxValue('')
    context = .RexxBifCallContext(name)
    call context.setArguments(values,exists)
    call context.setCallerPool(reference _pool)
    call context.setConfig(reference _config)
    /* Bound requests to potentially expanding shared BIFs before allocation. */
    if wordpos(name,'COPIES LEFT RIGHT CENTER CENTRE SPACE SUBSTR INSERT OVERLAY D2C D2X FORMAT TRUNC') > 0 then do
      do i = 2 to exists[0]
        if exists[i] then do
          text = values[i].asString()
          if datatype(text,'W') = '1' then do
            if text as .decimal > _maximum then do
              call fail('RS_VALUE_LIMIT','BIF requested extent exceeds value limit',node,2); return .RexxValue('')
            end
          end
        end
      end
      if name = 'COPIES' & exists[0] >= 2 then do
        extent = <blen>(values[1].asBinary()); repeats = values[2].asDecimal()
        if extent * repeats > _maximum then do
          call fail('RS_VALUE_LIMIT','COPIES result exceeds value limit',node,2); return .RexxValue('')
        end
      end
    end
    result = rexxscriptbifs..invoke(reference context)
    if context.hasError() then call fail(context.errorCode(),context.errorMessage(),node)
    return result
  outputvalue: method = .void
    arg value = .string, node = .llast..node
    _bytes = _bytes + <blen>(value as .binary) + 1
    if _bytes > _maximum | _output[0] >= 10000 then do
      call fail('RS_OUTPUT_LIMIT','output limit exceeded',node,2); return
    end
    call arrayappend _output,value
    return
  value: method = .RexxValue
    arg name = .string
    if _pool.hasBinding(name) then return _pool.value(name)
    return .RexxValue('')
  result: method = .RexxValue
    return _result
  output: method = .string[]
    return _output
  collected: method = .RexxValue[]
    return _collected
  code: method = .string
    return _code
  error: method = .string
    if _status = 0 then return ''
    if _code = 'RS_PARSE' | _code = 'RS_PARSE_LIMIT' | _code = 'RS_LANGUAGE' then return _message
    offset = 0
    if initialized(_node) then do
      if _node.valid() then offset = _node.offset()
    end
    return llsource..diagnostic(_program.source(),offset,_code,_message)
