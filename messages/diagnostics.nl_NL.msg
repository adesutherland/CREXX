# cREXX diagnostic message catalog, Dutch (Netherlands)
# Format: CODE = template with {parameter} placeholders.

ALREADY_DECLARED = Symbool is al gedeclareerd.
ARGS_MISMATCH = Geïmporteerde routine "{name}" heeft incompatibele argumenten tussen {defining_file} en {import_file}.
ARGUMENT_REQUIRED = Argument {position} ({name}) is vereist.
ARG_NOT_FIRST_INST = ARG moet de eerste opdracht in een routine zijn.
ARRAY_DIMS_MISMATCH = Arraydimensies komen niet overeen.
ARRAY_ELEMENT_TYPE_MISMATCH = Array-elementtype komt niet overeen met het doeltype.
ASSEMBLER_ONLY_LEVELB = Inline assembler wordt alleen ondersteund in Level B.
BAD_CONVERSION = Waarde kan niet naar het vereiste type worden geconverteerd.
BINARY_MEMORY_AT_REQUIRED = Binaire-geheugentoegang vereist een at-intrinsic.
BINARY_MEMORY_COMPARE_ARGUMENTS = Binaire-geheugenvergelijkingsintrinsic heeft een ongeldige argumentlijst.
BINARY_MEMORY_FIXED_FOR_NOT_ALLOWED = Binaire-geheugentoegang met vaste breedte mag geen lengteargument opgeven.
BINARY_MEMORY_INVALID_STORAGE_TYPE = Binaire-geheugentoegang gebruikt een niet-ondersteund opslagtype.
BINARY_MEMORY_LENGTH_REQUIRED = Binaire-geheugentoegang met variabele lengte vereist een lengteargument.
BINARY_MEMORY_OFFSET_REQUIRED = Binaire-geheugentoegang vereist een bytepositieargument.
BINARY_MEMORY_READ_ONLY = Doel van binaire-geheugentoegang is alleen-lezen.
BINARY_MEMORY_SPAN_WRITE_UNSUPPORTED = Binaire-geheugenschrijfbewerkingen met variabele lengte worden nog niet ondersteund.
BINARY_MEMORY_TARGET_NOT_BINARY = Doel van binaire-geheugentoegang moet een scalaire .binary-waarde zijn.
CANNOT_CAST_BINARY = Binaire gegevens kunnen zonder expliciete codering niet naar tekst worden geconverteerd.
CANNOT_EXPOSED_ARG = Procedureargumenten kunnen niet worden blootgesteld.
CANT_ASSIGN_IN_CLASS_DEF = Toewijzing is niet toegestaan direct in een klassendefinitie.
CANT_ASSIGN_IN_INTERFACE_DEF = Toewijzing is niet toegestaan direct in een interfacedefinitie.
CANT_DEFINE_CLASS_HERE = Klassendefinities zijn hier niet toegestaan.
CANT_DEFINE_INTERFACE_HERE = Interfacedefinities zijn hier niet toegestaan.
CANT_DEFINE_METHOD_HERE = Methodedefinities zijn hier niet toegestaan.
CANT_DEFINE_PROC_HERE = Proceduredefinities zijn hier niet toegestaan.
CERTIFIED_EXIT_DISABLED = Gecertificeerde compiler-exit "{keyword}" is uitgeschakeld.
CLASS_NOT_FOUND = Klasse is niet gevonden.
CONSTANT_REQUIRES_CONSTANT_EXPRESSION = Constantedefinities vereisen een constante expressie.
CONSTANT_OUTSIDE_ROUTINE = Constantdeclaraties moeten binnen een expliciete routinebody staan.
DECIMAL_CASE_VALUE = NUMERIC CASE moet een van de ondersteunde case-waarden zijn.
DECIMAL_DIGITS_RANGE = NUMERIC DIGITS ligt buiten het ondersteunde bereik.
DECIMAL_FORM_VALUE = NUMERIC FORM moet SCIENTIFIC of ENGINEERING zijn.
DECIMAL_FUZZ_RANGE = NUMERIC FUZZ ligt buiten het ondersteunde bereik.
DECIMAL_STANDARD_VALUE = NUMERIC STANDARD wordt niet ondersteund.
DEREFERENCE_REQUIRES_ASSIGNMENT = Dereferentie vereist een toewijzingsdoel.
DEREFERENCE_TARGET_NOT_LOCAL = Dereferentiedoel moet lokale opslag zijn.
DUPLICATE_NAMESPACE = Namespace is al gedeclareerd.
DUPLICATE_SYMBOL = Symbool is al in dit bereik gedeclareerd.
EXIT_BRIDGE_BAD_HELPER = Compiler-exit-helper heeft een ongeldige vorm.
EXIT_BRIDGE_BAD_PLAN = Compiler-exit gaf een ongeldig herschrijfplan terug.
EXIT_BRIDGE_BAD_RESULT = Compiler-exit gaf een ongeldig resultaat terug.
EXIT_BRIDGE_DISPATCH_FAILED = Dispatch van compiler-exit is mislukt.
EXIT_BRIDGE_ERROR = Compiler-exit heeft een fout gemeld.
EXIT_BRIDGE_HELPER_BAD_SHAPE = Compiler-exit-helper {helper_id} heeft een ongeldige definitie.
EXIT_BRIDGE_HELPER_CONFLICT = Compiler-exit-helper {helper_id} conflicteert met een bestaande helper.
EXIT_BRIDGE_HELPER_CONTEXT_FAILED = Compiler-exit-helper {helper_id} kon geen context maken.
EXIT_BRIDGE_HELPER_INTERPOLATION_FAILED = Compiler-exit-helper {helper_id} kon niet worden geïnterpoleerd.
EXIT_BRIDGE_HELPER_MISSING_DEF = Compiler-exit-helper {helper_id} mist zijn definitie.
EXIT_BRIDGE_HELPER_MULTI_DEF = Compiler-exit-helper {helper_id} heeft meer dan één definitie.
EXIT_BRIDGE_HELPER_PARSE_FAILED = Compiler-exit-helper {helper_id} kon niet worden ontleed.
EXIT_BRIDGE_HELPER_REGISTRY_FAILED = Compiler-exit-helper {helper_id} kon niet worden geregistreerd.
EXIT_BRIDGE_PARSE_FAILED = Compiler-exit-resultaat kon niet worden ontleed.
EXIT_BRIDGE_REPLACE_MISSING_TEXT = Compiler-exit-vervanging mist tekst.
EXIT_BRIDGE_UNSUPPORTED_HELPER_SCOPE = Compiler-exit-helperbereik "{scope}" wordt niet ondersteund.
EXPECTING_ARRAY = Arraywaarde verwacht.
EXTERNAL_SHADOW_BYPASS = Extern symbool omzeilt een overschaduwde declaratie.
EXTRANEOUS_RETVAL = RETURN-waarde wordt hier niet verwacht.
FACTORY_NOT_FOUND = Passende factory is niet gevonden.
IMPORTED_FUNCTION = Geïmporteerde functies kunnen in deze context niet worden gebruikt.
IMPLICIT_ADDRESS = Impliciete ADDRESS-opdracht; zet de opdrachttekst tussen aanhalingstekens of gebruik ADDRESS expliciet.
INCOMPATIBLE_DIM_BASE = Arraydimensie {dim} heeft basis {from}; verwacht was {to}.
INCOMPATIBLE_DIM_SIZE = Arraydimensie {dim} heeft grootte {from}; verwacht was {to}.
INCOMPATIBLE_OPTIONS = OPTIONS-instelling is incompatibel met het huidige source-level.
INTERFACE_DEFAULT_METHOD_REDEFINED = Klasse herdefinieert standaardinterfacemethode {interface}.{member}.
INTERFACE_MATCH_SIGNATURE_MISMATCH = MATCH-methode voor {interface}.{member} heeft een incompatibele signatuur.
INTERFACE_MEMBER_BODY_NOT_ALLOWED = Interfaceleden mogen hier geen body hebben.
INTERFACE_MEMBER_NOT_IMPLEMENTED = Klasse implementeert interfacelid {interface}.{member} niet.
INTERFACE_MEMBER_SIGNATURE_MISMATCH = Implementatie van {interface}.{member} heeft een incompatibele signatuur.
INTERFACE_NOT_FOUND = Interface is niet gevonden.
INTERNAL_TEST = Interne testdiagnose.
