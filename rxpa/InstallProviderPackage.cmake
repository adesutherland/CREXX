# Install only the closure named by the generated provider manifest. Never
# recursively harvest the shared providers directory from an incremental build.
file(READ "${provider_manifest}" manifest)
get_filename_component(package_dir "${provider_manifest}" DIRECTORY)
set(package_files "${provider_manifest}")
foreach(kind link_libraries runtime_files)
    string(JSON count LENGTH "${manifest}" "${kind}")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON name GET "${manifest}" "${kind}" ${index} path)
            # Version 1 emits adjacent basenames, not arbitrary source paths.
            if(name MATCHES "[/\\\\]" OR name STREQUAL ".." OR name STREQUAL ".")
                message(FATAL_ERROR "Invalid provider package path: ${name}")
            endif()
            string(JSON expected GET "${manifest}" "${kind}" ${index} sha256)
            file(SHA256 "${package_dir}/${name}" actual)
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "Provider package hash mismatch: ${name}")
            endif()
            list(APPEND package_files "${package_dir}/${name}")
        endforeach()
    endif()
endforeach()
list(REMOVE_DUPLICATES package_files)
file(INSTALL ${package_files} DESTINATION "${CMAKE_INSTALL_PREFIX}/bin/providers" TYPE FILE)
