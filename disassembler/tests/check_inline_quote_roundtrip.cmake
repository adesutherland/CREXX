cmake_minimum_required(VERSION 3.24)
foreach(_required RXAS RXDAS RUNNER WORK)
    if(NOT DEFINED ${_required})
        message(FATAL_ERROR "Missing ${_required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")

function(run_checked label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
    if(NOT result EQUAL 0 OR "${stdout}${stderr}" MATCHES "Warning in |PANIC:")
        message(FATAL_ERROR "${label}: ${result}\n${stdout}${stderr}")
    endif()
endfunction()

# Repeated actuals are legal. Vary only whether an unused actual is r1 or r11
# to set the exact canonical recipe length without huge register indices.
string(REPEAT "r1," 1599 initial_arguments)
string(APPEND initial_arguments "r1")
set(prefix "count=1600;args=list(")
set(suffix ");a0=r112;proxies=();owned=(r112);prep=none")
string(LENGTH "${prefix}${initial_arguments}${suffix}" base_length)
foreach(encoded RANGE 4997 4999)
    math(EXPR padding "${encoded}-${base_length}")
    if(padding LESS 0 OR padding GREATER 1600)
        message(FATAL_ERROR "Recipe boundary construction is out of range")
    endif()
    set(arguments "")
    foreach(index RANGE 0 1599)
        if(index GREATER 0)
            string(APPEND arguments ",")
        endif()
        if(index LESS padding)
            string(APPEND arguments "r11")
        else()
            string(APPEND arguments "r1")
        endif()
    endforeach()
    set(recipe "${prefix}${arguments}${suffix}")
    string(LENGTH "${recipe}" length)
    if(NOT length EQUAL encoded)
        message(FATAL_ERROR "Wrong canonical recipe extent ${length}")
    endif()
    set(stem "${WORK}/inline-quote-${encoded}")
    file(WRITE "${stem}.rxas" ".globals=0\nmain() .locals=114\n    inlenter r0,helper(),\"${recipe}\",after\n    ret 0\nafter:\n    ret 0\nhelper() .locals=0\n    ret\n")
    run_checked("assemble ${encoded}" "${RXAS}" -n -o "${stem}" "${stem}.rxas")
    run_checked("render ${encoded}" "${RXDAS}" -o "${stem}-roundtrip.rxas" "${stem}.rxbin")
    file(READ "${stem}-roundtrip.rxas" rendered)
    string(FIND "${rendered}" "\"${recipe}\"" found)
    if(found LESS 0)
        message(FATAL_ERROR "Recipe ${encoded} was truncated or changed")
    endif()
    run_checked("reassemble ${encoded}" "${RXAS}" -n -o "${stem}-roundtrip" "${stem}-roundtrip.rxas")
    run_checked("execute ${encoded}" "${RUNNER}" "${stem}-roundtrip.rxbin")
endforeach()
file(REMOVE_RECURSE "${WORK}")
message("INLINE_QUOTE_ROUNDTRIP|failures=0")
