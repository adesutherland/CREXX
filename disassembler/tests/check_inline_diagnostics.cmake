cmake_minimum_required(VERSION 3.24)
foreach(_name RXAS RXDAS RXLINK FIXTURE WORK)
  if(NOT DEFINED ${_name})
    message(FATAL_ERROR "Missing ${_name}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
function(run)
  execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 30)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "${ARGV}: ${_rc}\n${_out}\n${_err}")
  endif()
endfunction()
run("${RXAS}" -n -o original "${FIXTURE}")
run("${RXDAS}" -o roundtrip.rxas original.rxbin)
file(READ "${WORK}/roundtrip.rxas" _text)
foreach(_expected ".inlineframe 7 0 \"provider.rxas\" \"outer\" 42" ".inlineframe 8 7 \"provider.rxas\" \"inner\" 43" ".inlinemap" ".srcstep 0 0 0 \"\" 0 0 0 \"\"")
  string(FIND "${_text}" "${_expected}" _found)
  if(_found EQUAL -1)
    message(FATAL_ERROR "Missing ${_expected}\n${_text}")
  endif()
endforeach()
run("${RXAS}" -n -o roundtrip roundtrip.rxas)
run("${RXAS}" -o optimized "${FIXTURE}")
run("${RXDAS}" -o optimized.rxas optimized.rxbin)
file(READ "${WORK}/optimized.rxas" _optimized)
foreach(_expected ".inlineframe 7 0 \"provider.rxas\" \"outer\" 42" ".inlineframe 8 7 \"provider.rxas\" \"inner\" 43" ".inlinemap" ".srcstep 0 0 0 \"\" 0 0 0 \"\"")
  string(FIND "${_optimized}" "${_expected}" _found)
  if(_found EQUAL -1)
    message(FATAL_ERROR "Optimized assembly lost ${_expected}\n${_optimized}")
  endif()
endforeach()
run("${RXAS}" -n -o optimized-again optimized.rxas)
run("${RXLINK}" -s -o stripped original.rxbin)
run("${RXDAS}" -o stripped.rxas stripped.rxbin)
file(READ "${WORK}/stripped.rxas" _stripped)
if(_stripped MATCHES "[.]srcstep" OR NOT _stripped MATCHES "[.]inlineframe 7 0 \"provider[.]rxas\" \"outer\" 0" OR NOT _stripped MATCHES "[.]inlinemap")
  message(FATAL_ERROR "Source stripping lost inline diagnostics or retained source anchor\n${_stripped}")
endif()
run("${RXAS}" -n -o stripped-again stripped.rxas)
file(WRITE "${WORK}/bad.rxas" ".globals=0\nmain() .locals=0\n.inlineframe 7 0 \"x\" \"f\" 0\n.inlinemap missing,done,7\nret 0\ndone:\n")
execute_process(COMMAND "${RXAS}" -n -o bad bad.rxas WORKING_DIRECTORY "${WORK}"
  RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 30)
if(_rc EQUAL 0 OR NOT "${_out}${_err}" MATCHES "unknown inline map begin label")
  message(FATAL_ERROR "Unknown inline endpoint was accepted: ${_rc}\n${_out}\n${_err}")
endif()
file(REMOVE_RECURSE "${WORK}")
message("INLINE_DIAGNOSTIC_ROUNDTRIP|failures=0")
