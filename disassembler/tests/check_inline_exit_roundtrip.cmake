cmake_minimum_required(VERSION 3.24)
foreach(required RXAS RXDAS RXLINK RUNNER SOURCE WORK)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
function(run_checked label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
    if(NOT result EQUAL 0 OR "${stdout}${stderr}" MATCHES "Warning in |PANIC:")
        message(FATAL_ERROR "${label}: ${result}\n${stdout}${stderr}")
    endif()
endfunction()
function(check_metadata path)
    file(READ "${path}" text)
    foreach(fragment ".inlineregion 1,0" ".inlineregion 2,1" "\"digits\",r7" "\"digits\",18"
                     "\"fuzz\",0" "\"form\",1" "\"case\",1" "\"standard\",1"
                     "\"endlife\",r0" "\"unlink\",r1" "\"swap\",r2,g0" "\"link\",r3,a1")
        string(FIND "${text}" "${fragment}" found)
        if(found LESS 0)
            message(FATAL_ERROR "Missing cold metadata ${fragment} in ${path}")
        endif()
    endforeach()
    string(REGEX MATCHALL "[.]inlinerange " ranges "${text}")
    list(LENGTH ranges count)
    if(NOT count EQUAL 3)
        message(FATAL_ERROR "Expected three fragmented range records in ${path}, got ${count}")
    endif()
endfunction()
foreach(mode normal optimized)
    set(flags)
    if(mode STREQUAL normal)
        set(flags -n)
    endif()
    set(stem "${WORK}/${mode}")
    run_checked("assemble ${mode}" "${RXAS}" ${flags} -o "${stem}" "${SOURCE}")
    run_checked("disassemble ${mode}" "${RXDAS}" -o "${stem}.rxas" "${stem}.rxbin")
    check_metadata("${stem}.rxas")
    run_checked("reassemble ${mode}" "${RXAS}" -n -o "${stem}-roundtrip" "${stem}.rxas")
    run_checked("relink ${mode}" "${RXLINK}" -o "${stem}-linked" "${stem}-roundtrip.rxbin")
    run_checked("render linked ${mode}" "${RXDAS}" -o "${stem}-linked.rxas" "${stem}-linked.rxbin")
    check_metadata("${stem}-linked.rxas")
    run_checked("execute ${mode}" "${RUNNER}" "${stem}.rxbin")
    run_checked("execute linked ${mode}" "${RUNNER}" "${stem}-linked.rxbin")
endforeach()
file(READ "${SOURCE}" original)
foreach(invalid cycle unknown_action borrowed_root bad_order)
    set(text "${original}")
    if(invalid STREQUAL cycle)
        string(REPLACE ".inlineregion 1,0" ".inlineregion 1,2" text "${text}")
    elseif(invalid STREQUAL unknown_action)
        string(REPLACE "\"endlife\"" "\"finalize\"" text "${text}")
    elseif(invalid STREQUAL borrowed_root)
        string(REPLACE "\"endlife\",r0" "\"endlife\",g0" text "${text}")
    else()
        string(REPLACE ",5,\"endlife\"" ",0,\"endlife\"" text "${text}")
    endif()
    file(WRITE "${WORK}/${invalid}.rxas" "${text}")
    execute_process(COMMAND "${RXAS}" -n -o "${WORK}/${invalid}" "${WORK}/${invalid}.rxas"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
    if(result EQUAL 0 OR NOT "${stdout}${stderr}" MATCHES "inline.exit|inline-exit")
        message(FATAL_ERROR "Malformed ${invalid} accepted or wrong failure: ${result}\n${stdout}${stderr}")
    endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
message("INLINE_EXIT_ROUNDTRIP|failures=0")
