/* Ordered choice commits when fragment succeeds, before root's stop token. */
options levell
namespace levell_lesson
a: token
b: token
stop: token
scan: lexer input utf8
  a.lex: rule = 'a' then emit a
  b.lex: rule = 'b' then emit b
  stop.lex: rule = 'c' then emit stop
parse: parser semantics ordered start root backend packrat
  root: rule = fragment stop
  fragment: rule = a | a b
