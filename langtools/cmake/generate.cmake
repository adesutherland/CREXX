# One canonical output owner publishes only complete successful generation.
cmake_minimum_required(VERSION 3.24)
get_filename_component(_absolute_output "${OUTPUT}" ABSOLUTE)
get_filename_component(_output_parent "${_absolute_output}" DIRECTORY)
file(MAKE_DIRECTORY "${_output_parent}")
file(REAL_PATH "${_output_parent}" _output_parent)
get_filename_component(_output_name "${OUTPUT}" NAME)
set(_output "${_output_parent}/${_output_name}")
if(EXISTS "${_output}")
  file(REAL_PATH "${_output}" _output)
endif()
if(REUSE_LEXER)
  file(LOCK "${_output}.lexer.lock" GUARD PROCESS TIMEOUT 3600 RESULT_VARIABLE _lock)
  if(NOT _lock STREQUAL "0")
    message(FATAL_ERROR "Cannot lock Level L output ${OUTPUT}: ${_lock}")
  endif()
endif()
string(RANDOM LENGTH 32 ALPHABET 0123456789abcdef _nonce)
set(_stage "${_output}.stage-${_nonce}")
file(MAKE_DIRECTORY "${_stage}")
function(_generation_fail text)
  file(REMOVE_RECURSE "${_stage}")
  message(FATAL_ERROR "${text}")
endfunction()
set(generator_command "${LEVEL_L}")
set(_identity "LLLEXER_GENERATOR1\n")
if(DEFINED LEVEL_L_VM AND DEFINED LEVEL_L_BYTECODE)
  set(generator_command "${LEVEL_L_VM}" "${LEVEL_L_BYTECODE}" -a)
  set(_executables "${LEVEL_L_VM}" "${LEVEL_L_BYTECODE}")
else()
  set(_executables "${LEVEL_L}")
endif()
set(format_option)
if(FORMAT STREQUAL "rxas")
  set(format_option --rxas)
elseif(DEFINED FORMAT AND NOT FORMAT STREQUAL "crexx")
  _generation_fail("Unknown Level L artifact format: ${FORMAT}")
endif()
set(generator_options ${format_option})
foreach(setting IN LISTS GENERATOR_LIMITS)
  list(APPEND generator_options --limit "${setting}")
endforeach()
set(_cache "${_output}.lexer")
set(_manifest "${_output}.lexer.manifest")
if(REUSE_LEXER)
  foreach(_executable IN LISTS _executables)
    if(NOT EXISTS "${_executable}" OR IS_DIRECTORY "${_executable}")
      _generation_fail("Missing Level L generator input: ${_executable}")
    endif()
    file(SHA256 "${_executable}" _hash)
    string(APPEND _identity "${_hash}\n")
  endforeach()
  file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" _hash)
  string(APPEND _identity "${_hash}\n")
  string(SHA256 _fingerprint "${_identity}")
  # These are optional artifacts, never prerequisites of an up-to-date output.
  if(EXISTS "${_cache}" AND NOT IS_DIRECTORY "${_cache}"
      AND EXISTS "${_manifest}" AND NOT IS_DIRECTORY "${_manifest}")
    file(SIZE "${_cache}" _size)
    file(SIZE "${_manifest}" _manifest_size)
    if(_size GREATER 0 AND _size LESS_EQUAL 67108864 AND _manifest_size LESS_EQUAL 256)
      file(READ "${_manifest}" _saved LIMIT 256)
      file(SHA256 "${_cache}" _checksum)
      set(_expected "LLLEXER_CACHE1\n${_fingerprint}\n${_checksum}\n")
      if(_saved STREQUAL _expected)
        list(APPEND generator_options --lexer-in "${_cache}")
      endif()
    endif()
  endif()
  list(APPEND generator_options --lexer-out "${_stage}/candidate")
endif()
execute_process(COMMAND ${generator_command} "${SPEC}" ${generator_options}
  OUTPUT_FILE "${_stage}/output" ERROR_VARIABLE generator_stderr RESULT_VARIABLE generator_result)
if(NOT generator_result EQUAL 0)
  set(generator_message "")
  if(EXISTS "${_stage}/output")
    file(READ "${_stage}/output" generator_message LIMIT 8192)
  endif()
  _generation_fail("${SPEC}\n${generator_message}\n${generator_stderr}")
endif()
if(NOT generator_stderr STREQUAL "")
  message("${generator_stderr}")
endif()
if(REUSE_LEXER AND EXISTS "${_stage}/candidate")
  file(SIZE "${_stage}/candidate" _size)
  if(_size GREATER 0 AND _size LESS_EQUAL 67108864)
    file(SHA256 "${_stage}/candidate" _checksum)
    set(_same OFF)
    if(EXISTS "${_cache}" AND NOT IS_DIRECTORY "${_cache}")
      file(SHA256 "${_cache}" _previous)
      if(_previous STREQUAL _checksum)
        set(_same ON)
      endif()
    endif()
    if(NOT _same)
      file(RENAME "${_stage}/candidate" "${_cache}" RESULT _result)
      if(NOT _result STREQUAL "0")
        _generation_fail("Cannot publish Level L lexical data: ${_result}")
      endif()
    endif()
    set(_current "LLLEXER_CACHE1\n${_fingerprint}\n${_checksum}\n")
    set(_previous "")
    if(EXISTS "${_manifest}" AND NOT IS_DIRECTORY "${_manifest}")
      file(READ "${_manifest}" _previous LIMIT 256)
    endif()
    if(NOT _previous STREQUAL _current)
      file(WRITE "${_stage}/manifest" "${_current}")
      file(RENAME "${_stage}/manifest" "${_manifest}" RESULT _result)
      if(NOT _result STREQUAL "0")
        _generation_fail("Cannot publish Level L lexical manifest: ${_result}")
      endif()
    endif()
  endif()
endif()
file(RENAME "${_stage}/output" "${_output}" RESULT _result)
if(NOT _result STREQUAL "0")
  _generation_fail("Cannot publish Level L output: ${_result}")
endif()
file(REMOVE_RECURSE "${_stage}")
