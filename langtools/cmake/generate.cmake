# Atomic product publication: a failed generator cannot replace a valid artifact.
set(generator_command "${LEVEL_L}")
if(DEFINED LEVEL_L_VM AND DEFINED LEVEL_L_BYTECODE)
  set(generator_command "${LEVEL_L_VM}" "${LEVEL_L_BYTECODE}" -a)
endif()
set(format_option)
if(FORMAT STREQUAL "rxas")
  set(format_option --rxas)
elseif(DEFINED FORMAT AND NOT FORMAT STREQUAL "crexx")
  message(FATAL_ERROR "Unknown Level L artifact format: ${FORMAT}")
endif()
execute_process(COMMAND ${generator_command} "${SPEC}" ${format_option}
  OUTPUT_FILE "${OUTPUT}.tmp" ERROR_VARIABLE generator_stderr RESULT_VARIABLE generator_result)
if(NOT generator_result EQUAL 0)
  file(READ "${OUTPUT}.tmp" generator_message LIMIT 8192)
  file(REMOVE "${OUTPUT}.tmp")
  message(FATAL_ERROR "${SPEC}\n${generator_message}\n${generator_stderr}")
endif()
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
