cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/generator-inputs.cmake")
list(SORT LL_GENERATOR_STAMP_SOURCES)
set(_identity "LLGENERATE_STAMP1\n")
foreach(_path IN LISTS LL_GENERATOR_STAMP_SOURCES)
  file(SHA256 "${ROOT}/${_path}" _hash)
  string(APPEND _identity "source|${_path}|${_hash}\n")
endforeach()
foreach(_role LIBRARY SDK COMPILER ASSEMBLER LINKER VM FLAGS)
  if(NOT EXISTS "${${_role}}")
    message(FATAL_ERROR "Missing pre-L0 generator identity input: ${_role}")
  endif()
  file(SHA256 "${${_role}}" _hash)
  string(APPEND _identity "artifact|${_role}|${_hash}\n")
endforeach()
string(SHA256 _stamp "${_identity}")
file(READ "${ROOT}/langtools/rexx/llgenerate.crexx" _source)
string(REGEX MATCHALL "@LLGENERATE_SOURCE_STAMP@" _markers "${_source}")
list(LENGTH _markers _count)
if(NOT _count EQUAL 1)
  message(FATAL_ERROR "Expected one private generator source-stamp marker")
endif()
string(REPLACE "@LLGENERATE_SOURCE_STAMP@" "${_stamp}" _source "${_source}")
file(WRITE "${OUTPUT}.tmp" "${_source}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}"
  COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${OUTPUT}.tmp")
get_filename_component(_directory "${OUTPUT}" DIRECTORY)
file(WRITE "${_directory}/generator.identity.tmp" "${_stamp}\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
  "${_directory}/generator.identity.tmp" "${_directory}/generator.identity"
  COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${_directory}/generator.identity.tmp")
