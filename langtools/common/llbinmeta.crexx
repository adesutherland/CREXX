/* cREXX License (MIT). Bounded portable RXBIN metadata reader. */
options levelb
namespace llbinmeta expose catalog callable
import rxfnsb

/** Bounded RXBIN007 metadata view. It reads the portable envelope, expands its
 * constant/metadata sections and resolves their pool-local IDs. Instructions
 * and optimiser templates are never executed or treated as declarations. */
catalog: class
  _constants = .binary
  _metadata = .binary
  _keys = .int[]
  _kind = .int[]
  _start = .int[]
  _length = .int[]
  _pool = .int[]
  _constantcount = .int
  _pools = .int
  _error = .string
  _budget = .int
  _image = .binary
  _ready = .int
  *: factory
    arg image = .binary, budget = 16777216
    _error = ''; _constantcount = 0; _pools = 0; _budget = budget
    _image = image; _ready = 0
    return
  run: method = .void
    if _ready then return
    _ready = 1
    do
      call read_image(_image)
    on signal
      _error = 'LL_RXBIN_IMPORT: malformed RXBIN metadata envelope'
    end
    return
  fail: method = .void
    arg reason = .string
    if _error = '' then _error = 'LL_RXBIN_IMPORT: ' || reason
    return
  error: method = .string
    call run()
    return _error
  read_image: method = .void
    arg image = .binary
    size = <blen>(image)
    if size < 304 | size > _budget | binsubstr(image,1,8) <> 'cReXx007' as .binary then do
      call fail('expected bounded RXBIN007 image'); return
    end
    if <at..u32>(8) image <> 64 | <at..u32>(12) image > 255 | <at..i64>(16) image <> size | <at..u32>(24) image <> 6 | <at..u32>(28) image = 0 | <at..i64>(32) image <> 64 then do
      call fail('invalid RXBIN007 header'); return
    end
    if bin2x(binsubstr(image,41,24)) <> copies('00',24) then do
      call fail('nonzero reserved header'); return
    end
    previous = 304; expandedtotal = 0
    do section = 1 to 6
      row = 64 + (section - 1) * 40
      flags = <at..u32>(row + 4) image
      offset = <at..i64>(row + 16) image; stored = <at..i64>(row + 24) image; expanded = <at..i64>(row + 32) image
      if <at..u32>(row) image <> section | flags > 1 | <at..u32>(row + 8) image <> 8 | <at..u32>(row + 12) image <> 0 | offset < previous | offset <mod> 8 <> 0 | stored < 0 | offset > size | stored > size - offset | expanded < 0 | expanded > _budget - expandedtotal then do
        call fail('invalid section range or expansion budget'); return
      end
      if bin2x(binsubstr(image,previous + 1,offset - previous)) <> copies('00',offset - previous) then do
        call fail('nonzero section padding'); return
      end
      expandedtotal = expandedtotal + expanded; previous = offset + stored
      if flags = 0 & stored <> expanded then do
        call fail('uncompressed section length mismatch'); return
      end
      if section = 3 | section = 4 then do
        bytes = binsubstr(image,offset + 1,stored)
        if flags = 1 then bytes = expand(bytes,expanded)
        if _error <> '' then return
        if section = 3 then _constants = bytes
        else _metadata = bytes
      end
    end
    if previous <> size then do
      call fail('trailing envelope bytes'); return
    end
    call records(_constants,0)
    _constantcount = _keys[0]
    call records(_metadata,1)
    if _error <> '' then return
    /* IDs shared by constants and metadata must remain unique within a pool. */
    do i = _constantcount + 1 to _keys[0]
      if search(_keys[i],1,_constantcount) > 0 then do
        call fail('duplicate pool ID across record sections'); return
      end
    end
    return
  expand: method = .binary
    arg input = .binary, size = .int
    result = .binary; extent = <blen>(input)
    if size < 1 | size > _budget | extent >= size | size > extent * 18 then do
      call fail('invalid compressed section size'); return result
    end
    call binresize result,size
    at = 0; written = 0
    do while written < size & _error = ''
      if at >= extent then do
        call fail('truncated compressed control'); leave
      end
      control = <at..u8>(at) input; at = at + 1; mask = 1
      do bit = 0 to 7 while written < size & _error = ''
        if control <and> mask then do
          if at + 2 > extent then do
            call fail('truncated compressed match'); leave
          end
          first = <at..u8>(at) input; second = <at..u8>(at + 1) input; at = at + 2
          count = (first <shr> 4) + 3; distance = (first <and> 15) * 256 + second + 1
          if distance > written | count > size - written then do
            call fail('invalid compressed match'); leave
          end
          do copied = 1 to count
            <at..u8>(written) result = <at..u8>(written - distance) result
            written = written + 1
          end
        end
        else do
          if at >= extent then do
            call fail('truncated compressed literal'); leave
          end
          <at..u8>(written) result = <at..u8>(at) input
          written = written + 1; at = at + 1
        end
        mask = mask * 2
      end
    end
    if at <> extent then call fail('trailing compressed bytes')
    return result
  records: method = .void
    arg data = .binary, metadata = .int
    if _error <> '' then return
    extent = <blen>(data)
    magic = 'RXC7'
    if metadata then magic = 'RXD7'
    if extent < 16 | binsubstr(data,1,4) <> magic as .binary then do
      call fail('record section magic'); return
    end
    pools = <at..u32>(8) data; count = <at..u32>(12) data
    if <at..u32>(4) data <> 1 | pools < 1 | pools > 65536 | count > 1000000 | count > (extent - 16) <idiv> 24 then do
      call fail('record section counts'); return
    end
    if metadata & pools <> _pools then do
      call fail('pool count mismatch'); return
    end
    _pools = pools; at = 16; previous = -1
    do i = 1 to count
      if at > extent - 24 then do
        call fail('truncated record'); return
      end
      pool = <at..u32>(at) data; id = <at..u32>(at + 4) data; kind = <at..u32>(at + 8) data
      size = <at..i64>(at + 16) data; key = pool * 1000001 + id
      if pool >= pools | id > 1000000 | kind > 22 | <at..u32>(at + 12) data <> 0 | size < 0 | size > extent - at - 24 | key <= previous | (kind >= 7) <> metadata then do
        call fail('invalid or unordered record'); return
      end
      n = _keys[0] + 1; _keys[n] = key; _kind[n] = kind; _start[n] = at + 24; _length[n] = size; _pool[n] = pool
      previous = key; at = at + 24 + size
      padding = (8 - at <mod> 8) <mod> 8
      if at + padding > extent | bin2x(binsubstr(data,at + 1,padding)) <> copies('00',padding) then do
        call fail('record padding'); return
      end
      at = at + padding
    end
    if at <> extent then call fail('trailing record bytes')
    return
  search: method = .int
    arg key = .int, first = .int, last = .int
    do while first <= last
      mid = first + (last - first) <idiv> 2
      if _keys[mid] = key then return mid
      if _keys[mid] < key then first = mid + 1
      else last = mid - 1
    end
    return 0
  text: method = .string
    arg pool = .int, id = .int
    if pool < 0 | pool >= _pools | id < 0 | id > 1000000 then do
      call fail('metadata reference is outside its pool'); return ''
    end
    found = search(pool * 1000001 + id,1,_constantcount)
    if found = 0 then do
      call fail('missing string reference'); return ''
    end
    start = _start[found]; size = _length[found]
    if _kind[found] <> 0 | size < 16 then do
      call fail('reference does not name a string'); return ''
    end
    length = <at..i64>(start) _constants
    if length < 0 | length <> size - 16 then do
      call fail('invalid string payload length'); return ''
    end
    result = binsubstr(_constants,start + 17,length) as .string
    if pos('00'x as .string,result) > 0 then call fail('NUL in metadata text')
    return result
  /** Owned selected callable. Unused executable/inline records are opaque. */
  lookup: method = .llbinmeta..callable
    arg name = .string
    call run()
    result = .llbinmeta..callable.failed('imported callable not found: ' || name)
    if _error <> '' then return .llbinmeta..callable.failed(_error)
    matches = 0; named = 0
    do i = _constantcount + 1 to _keys[0]
      if _kind[i] <> 7 then iterate
      at = _start[i]
      if _length[i] <> 36 then return .llbinmeta..callable.failed('invalid callable record size')
      symbol = text(_pool[i],<at..u32>(at + 16) _metadata)
      if _error <> '' then return .llbinmeta..callable.failed(_error)
      if upper(symbol) <> upper(name) then iterate
      named = 1
      /* In a shared pool, a prototype can have the same symbol as a real
       * definition. Eligibility belongs to this META_FUNC's own procedure
       * and its reciprocal export, not another export with the same name. */
      procedureid = <at..u32>(at + 28) _metadata
      if procedureid > 1000000 then return .llbinmeta..callable.failed('callable procedure reference is outside its pool: ' || symbol)
      procindex = search(_pool[i] * 1000001 + procedureid,1,_constantcount)
      if procindex = 0 then return .llbinmeta..callable.failed('callable procedure is missing: ' || symbol)
      if _kind[procindex] <> 4 | _length[procindex] < 24 then return .llbinmeta..callable.failed('invalid callable procedure: ' || symbol)
      procstart = _start[procindex]
      if <at..u32>(procstart + 20) _constants <> _length[procindex] - 24 then return .llbinmeta..callable.failed('invalid procedure payload length: ' || symbol)
      exposeid = <at..u32>(procstart + 16) _constants
      if exposeid = 4294967295 then iterate
      if exposeid > 1000000 then return .llbinmeta..callable.failed('callable export reference is outside its pool: ' || symbol)
      exportindex = search(_pool[i] * 1000001 + exposeid,1,_constantcount)
      if exportindex = 0 then return .llbinmeta..callable.failed('callable export is missing: ' || symbol)
      if _kind[exportindex] <> 6 | _length[exportindex] < 16 then return .llbinmeta..callable.failed('invalid callable export: ' || symbol)
      expstart = _start[exportindex]; extent = <at..u32>(expstart + 12) _constants
      imported = <at..u32>(expstart + 8) _constants
      if extent <> _length[exportindex] - 16 | imported > 1 then return .llbinmeta..callable.failed('invalid callable export payload: ' || symbol)
      if <at..u32>(expstart + 4) _constants <> procedureid then return .llbinmeta..callable.failed('callable export targets another procedure: ' || symbol)
      exportname = binsubstr(_constants,expstart + 17,extent) as .string
      if upper(exportname) <> upper(symbol) then return .llbinmeta..callable.failed('callable export identity mismatch: ' || symbol)
      if imported then iterate
      flags_text = text(_pool[i],<at..u32>(at + 20) _metadata)
      type = text(_pool[i],<at..u32>(at + 24) _metadata)
      arguments = text(_pool[i],<at..u32>(at + 32) _metadata)
      if _error <> '' then return .llbinmeta..callable.failed(_error)
      matches = matches + 1
      if matches > 1 then return .llbinmeta..callable.failed('ambiguous callable: ' || name)
      result = .llbinmeta..callable(symbol,type,arguments,flags_text)
    end
    if matches = 0 & named then return .llbinmeta..callable.failed('callable is not exported: ' || name)
    return result
  exported: method = .int
    arg symbol = .string, pool = .int
    if pool < 0 | pool >= _pools then do; call fail('export pool is outside the image'); return 0; end
    do i = 1 to _constantcount
      if _kind[i] <> 6 | _pool[i] <> pool then iterate
      at = _start[i]
      if _length[i] < 16 then do
        call fail('truncated export record'); return 0
      end
      length = <at..u32>(at + 12) _constants
      if length <> _length[i] - 16 | <at..u32>(at + 8) _constants > 1 then do
        call fail('invalid export record'); return 0
      end
      name = binsubstr(_constants,at + 17,length) as .string
      if upper(name) <> upper(symbol) then iterate
      if <at..u32>(at + 8) _constants then return 0
      procedureid = <at..u32>(at + 4) _constants
      if procedureid > 1000000 then do; call fail('exported procedure reference is outside its pool'); return 0; end
      target = search(pool * 1000001 + procedureid,1,_constantcount)
      if target = 0 then do
        call fail('exported procedure is missing'); return 0
      end
      if _kind[target] <> 4 then do
        call fail('export does not name a procedure'); return 0
      end
      return 1
    end
    return 0
  /** Checked scalar fields for class/member and autoload backend contracts. */
  field: method = .string
    arg kind = .int, owner = .string, member = '', ordinal = 1
    call run()
    if _error <> '' then return ''
    fields = 0; size = 0
    if kind = 11 | kind = 13 then do; fields = 3; size = 28; end
    if kind = 12 then do; fields = 4; size = 36; end
    if kind = 15 then do; fields = 5; size = 36; end
    if kind = 14 | kind = 21 | kind = 22 then do; fields = 2; size = 24; end
    if ordinal < 1 | ordinal > fields then do
      call fail('unsupported metadata field contract'); return ''
    end
    do i = _constantcount + 1 to _keys[0]
      if _kind[i] <> kind then iterate
      at = _start[i]
      if _length[i] <> size then do
        call fail('metadata record size'); return ''
      end
      name = text(_pool[i],<at..u32>(at + 16) _metadata)
      if upper(name) <> upper(owner) then iterate
      if kind = 15 & upper(text(_pool[i],<at..u32>(at + 24) _metadata)) <> upper(member) then iterate
      if kind = 12 & ordinal = 4 then do
        index = <at..i64>(at + 28) _metadata
        if index < -1 | index > 2147483647 then do
          call fail('attribute register index outside -1..INT_MAX'); return ''
        end
        return index as .string
      end
      return text(_pool[i],<at..u32>(at + 12 + ordinal * 4) _metadata)
    end
    return ''

/** Raw callable fields only. Language-specific type admission belongs to clients. */
callable: class
  _name = .string
  _result = .string
  _arguments = .string
  _flags = .string
  _error = .string
  *: factory
    arg name = .string, result = .string, arguments = .string, flags = .string
    _name = name; _result = result; _arguments = arguments; _flags = flags; _error = ''
    return
  failed: factory
    arg reason = .string
    _error = reason
    return
  error: method = .string
    return _error
  name: method = .string
    return _name
  result: method = .string
    return _result
  arguments: method = .string
    return _arguments
  flags: method = .string
    return _flags
