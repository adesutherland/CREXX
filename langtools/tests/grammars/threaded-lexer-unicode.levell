options levell
namespace probe_language
identifier: token = 1
keyword: token = 2
arrow: token = 3
minus: token = 4
other: token = 5
scan: lexer input utf8
  /* A bounded property intersection retains one-to-four-byte identifiers and
     combining continuation without repeating the full-property regression. */
  sample: charset = U+0000 to U+007F | U+00E9 | U+0301 | U+03BB | U+5B57 | U+10400
  excluded: charset = scalar except sample
  first: charset = (unicode.XID_Start except excluded) | '_'
  rest: charset = (unicode.XID_Continue except excluded) | '_'
  all.characters: charset = scalar
  keyword.lex: rule = 'if' then emit keyword
  identifier.lex: rule = first rest* then emit identifier
  arrow.lex: rule = '->' then emit arrow
  minus.lex: rule = '-' then emit minus
  spaces.lex: rule = (' ' | U+0009 | U+000A | U+000D)+ then skip
  other.lex: rule = all.characters then emit other
