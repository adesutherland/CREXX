cmake_minimum_required(VERSION 3.24)

# Fast inventory check after the owning producer stage; no nested build.
foreach(product rxfnsl.rxbin rxfnsl-analysis.rxbin rxfnsl-rxas.rxbin
    rxfnsl-execute.rxbin rxlanglib.rxbin rxlang${SUFFIX})
  if(NOT EXISTS "${BUILD}/bin/${product}")
    message(FATAL_ERROR "Missing Level L product: ${product}")
  endif()
endforeach()
foreach(helper llrxastext llfileoutput llbinmeta)
  if(NOT EXISTS "${BUILD}/langtools/common/${helper}.rxbin")
    message(FATAL_ERROR "Missing Level L helper: ${helper}")
  endif()
endforeach()
if(RESEARCH)
  foreach(language IN LISTS LANGUAGES)
    string(TOLOWER "${language}" language)
    foreach(product ll${language}compiler.rxbin llrxc-${language}${SUFFIX})
      if(NOT EXISTS "${BUILD}/research/level-l/compilers/products/${product}")
        message(FATAL_ERROR "Missing selected research product: ${product}")
      endif()
    endforeach()
  endforeach()
  if("C" IN_LIST LANGUAGES OR "c" IN_LIST LANGUAGES)
    if(NOT EXISTS "${BUILD}/research/level-l/compilers/products/llctarget.rxbin")
      message(FATAL_ERROR "Missing Classic target adapter")
    endif()
  endif()
endif()
message(STATUS "LEVEL_L_PRODUCTS|PASS")
