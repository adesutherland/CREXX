/* Generated deterministic lexer used only by the Unicode build-time parser. */
/* Runtime normalization uses RXVM codepoint operations, not this DFA. */
options levelb

namespace level_l_gennorm2 expose level_l_gennorm2_lex level_l_gennorm2_status level_l_gennorm2_error_offset level_l_gennorm2_error_message level_l_gennorm2_token_count level_l_gennorm2_token_kind level_l_gennorm2_token_start level_l_gennorm2_token_length level_l_gennorm2_token_name
import rxfnsb

level_l_gennorm2_lex: procedure = .binary expose _level_l_status _level_l_error_offset _level_l_error_message
  arg source = .string

  _level_l_status = 0
  _level_l_error_offset = 0
  _level_l_error_message = ""
  tokens = .binary
  count = 0
  pos = 0
  start = 0
  source_len = <blen>(source as .binary)
  scan_bytes = source as .binary
  call binresize scan_bytes, source_len + 1


  yyaccept = 0
  state = 0
  do forever
    select state
      when 0 then do
        byte = <at..u8>(pos) scan_bytes
        pos = pos + 1
        if byte <= 0x2A then do
          if byte <= 0x0D then do
            if byte <= 0x09 then do
              if byte <= 0x00 then do
                state = 1
                iterate
              end
              if byte <= 0x08 then do
                state = 2
                iterate
              end
              state = 4
              iterate
            end
            else do
              if byte <= 0x0A then do
                state = 5
                iterate
              end
              if byte <= 0x0C then do
                state = 2
                iterate
              end
              state = 6
              iterate
            end
          end
          else do
            if byte <= 0x22 then do
              if byte = 0x20 then do
                state = 4
                iterate
              end
              state = 2
              iterate
            end
            else do
              if byte <= 0x23 then do
                state = 7
                iterate
              end
              if byte <= 0x29 then do
                state = 2
                iterate
              end
              state = 9
              iterate
            end
          end
        end
        else do
          if byte <= 0x3C then do
            if byte <= 0x2F then do
              if byte = 0x2E then do
                state = 10
                iterate
              end
              state = 2
              iterate
            end
            else do
              if byte <= 0x39 then do
                state = 11
                iterate
              end
              if byte <= 0x3A then do
                state = 13
                iterate
              end
              state = 2
              iterate
            end
          end
          else do
            if byte <= 0x40 then do
              if byte <= 0x3D then do
                state = 14
                iterate
              end
              if byte <= 0x3E then do
                state = 15
                iterate
              end
              state = 2
              iterate
            end
            else do
              if byte <= 0x46 then do
                state = 16
                iterate
              end
              if byte = 0x55 then do
                state = 17
                iterate
              end
              state = 2
              iterate
            end
          end
        end
      end
      when 1 then do

      call level_l_gennorm2_emit tokens, count, 0, source_len, 0
      return tokens

      end
      when 2 then do
        state = 3
        iterate
      end
      when 3 then do

      _level_l_status = 2
      _level_l_error_offset = start
      _level_l_error_message = "invalid gennorm2 input character"
      return tokens

      end
      when 4 then do
        byte = <at..u8>(pos) scan_bytes
        if byte = 0x09 then do
          pos = pos + 1
          state = 4
          iterate
        end
        if byte = 0x20 then do
          pos = pos + 1
          state = 4
          iterate
        end

      start = pos
      state = 0
      iterate

      end
      when 5 then do

      call level_l_gennorm2_emit tokens, count, 9, start, pos - start
      start = pos
      state = 0
      iterate

      end
      when 6 then do
        byte = <at..u8>(pos) scan_bytes
        if byte = 0x0A then do
          pos = pos + 1
          state = 5
          iterate
        end
        state = 3
        iterate
      end
      when 7 then do
        yyaccept = 0
        yymarker = pos
        byte = <at..u8>(pos) scan_bytes
        if byte <= 0xDF then do
          if byte <= 0x0C then do
            if byte <= 0x00 then do
              state = 8
              iterate
            end
            if byte \= 0x0A then do
              pos = pos + 1
              state = 7
              iterate
            end
            state = 8
            iterate
          end
          else do
            if byte <= 0x0D then do
              state = 8
              iterate
            end
            if byte <= 0x7F then do
              pos = pos + 1
              state = 7
              iterate
            end
            if byte >= 0xC2 then do
              pos = pos + 1
              state = 18
              iterate
            end
            state = 8
            iterate
          end
        end
        else do
          if byte <= 0xEF then do
            if byte <= 0xE0 then do
              pos = pos + 1
              state = 20
              iterate
            end
            if byte = 0xED then do
              pos = pos + 1
              state = 22
              iterate
            end
            pos = pos + 1
            state = 21
            iterate
          end
          else do
            if byte <= 0xF0 then do
              pos = pos + 1
              state = 23
              iterate
            end
            if byte <= 0xF3 then do
              pos = pos + 1
              state = 24
              iterate
            end
            if byte <= 0xF4 then do
              pos = pos + 1
              state = 25
              iterate
            end
            state = 8
            iterate
          end
        end
      end
      when 8 then do

      start = pos
      state = 0
      iterate

      end
      when 9 then do

      call level_l_gennorm2_emit tokens, count, 6, start, pos - start
      start = pos
      state = 0
      iterate

      end
      when 10 then do
        byte = <at..u8>(pos) scan_bytes
        if byte = 0x2E then do
          pos = pos + 1
          state = 26
          iterate
        end
        state = 3
        iterate
      end
      when 11 then do
        yyaccept = 1
        yymarker = pos
        byte = <at..u8>(pos) scan_bytes
        if byte <= 0x2F then do
          if byte = 0x2E then do
            pos = pos + 1
            state = 27
            iterate
          end
          state = 12
          iterate
        end
        else do
          if byte <= 0x39 then do
            pos = pos + 1
            state = 11
            iterate
          end
          if byte <= 0x40 then do
            state = 12
            iterate
          end
          if byte <= 0x46 then do
            pos = pos + 1
            state = 16
            iterate
          end
          state = 12
          iterate
        end
      end
      when 12 then do

      call level_l_gennorm2_emit tokens, count, 1, start, pos - start
      start = pos
      state = 0
      iterate

      end
      when 13 then do

      call level_l_gennorm2_emit tokens, count, 3, start, pos - start
      start = pos
      state = 0
      iterate

      end
      when 14 then do

      call level_l_gennorm2_emit tokens, count, 4, start, pos - start
      start = pos
      state = 0
      iterate

      end
      when 15 then do

      call level_l_gennorm2_emit tokens, count, 5, start, pos - start
      start = pos
      state = 0
      iterate

      end
      when 16 then do
        byte = <at..u8>(pos) scan_bytes
        if byte <= 0x2F then do
          state = 12
          iterate
        end
        if byte <= 0x39 then do
          pos = pos + 1
          state = 16
          iterate
        end
        if byte <= 0x40 then do
          state = 12
          iterate
        end
        if byte <= 0x46 then do
          pos = pos + 1
          state = 16
          iterate
        end
        state = 12
        iterate
      end
      when 17 then do
        yyaccept = 2
        yymarker = pos
        byte = <at..u8>(pos) scan_bytes
        if byte = 0x6E then do
          pos = pos + 1
          state = 28
          iterate
        end
        state = 3
        iterate
      end
      when 18 then do
        byte = <at..u8>(pos) scan_bytes
        if byte <= 0x7F then do
          state = 19
          iterate
        end
        if byte <= 0xBF then do
          pos = pos + 1
          state = 7
          iterate
        end
        state = 19
        iterate
      end
      when 19 then do
        pos = yymarker
        if yyaccept <= 1 then do
          if yyaccept = 0 then do
            state = 8
            iterate
          end
          else do
            state = 12
            iterate
          end
        end
        else do
          if yyaccept = 2 then do
            state = 3
            iterate
          end
          else do
            state = 30
            iterate
          end
        end
      end
      when 20 then do
        byte = <at..u8>(pos) scan_bytes
        if byte <= 0x9F then do
          state = 19
          iterate
        end
        if byte <= 0xBF then do
          pos = pos + 1
          state = 18
          iterate
        end
        state = 19
        iterate
      end
      when 21 then do
        byte = <at..u8>(pos) scan_bytes
        if byte <= 0x7F then do
          state = 19
          iterate
        end
        if byte <= 0xBF then do
          pos = pos + 1
          state = 18
          iterate
        end
        state = 19
        iterate
      end
      when 22 then do
        byte = <at..u8>(pos) scan_bytes
        if byte <= 0x7F then do
          state = 19
          iterate
        end
        if byte <= 0x9F then do
          pos = pos + 1
          state = 18
          iterate
        end
        state = 19
        iterate
      end
      when 23 then do
        byte = <at..u8>(pos) scan_bytes
        if byte <= 0x8F then do
          state = 19
          iterate
        end
        if byte <= 0xBF then do
          pos = pos + 1
          state = 21
          iterate
        end
        state = 19
        iterate
      end
      when 24 then do
        byte = <at..u8>(pos) scan_bytes
        if byte <= 0x7F then do
          state = 19
          iterate
        end
        if byte <= 0xBF then do
          pos = pos + 1
          state = 21
          iterate
        end
        state = 19
        iterate
      end
      when 25 then do
        byte = <at..u8>(pos) scan_bytes
        if byte <= 0x7F then do
          state = 19
          iterate
        end
        if byte <= 0x8F then do
          pos = pos + 1
          state = 21
          iterate
        end
        state = 19
        iterate
      end
      when 26 then do

      call level_l_gennorm2_emit tokens, count, 2, start, pos - start
      start = pos
      state = 0
      iterate

      end
      when 27 then do
        byte = <at..u8>(pos) scan_bytes
        if byte <= 0x2F then do
          state = 19
          iterate
        end
        if byte <= 0x39 then do
          pos = pos + 1
          state = 29
          iterate
        end
        state = 19
        iterate
      end
      when 28 then do
        byte = <at..u8>(pos) scan_bytes
        if byte = 0x69 then do
          pos = pos + 1
          state = 31
          iterate
        end
        state = 19
        iterate
      end
      when 29 then do
        yyaccept = 3
        yymarker = pos
        byte = <at..u8>(pos) scan_bytes
        if byte = 0x2E then do
          pos = pos + 1
          state = 27
          iterate
        end
        if byte <= 0x2F then do
          state = 30
          iterate
        end
        if byte <= 0x39 then do
          pos = pos + 1
          state = 29
          iterate
        end
        state = 30
        iterate
      end
      when 30 then do

      call level_l_gennorm2_emit tokens, count, 8, start, pos - start
      start = pos
      state = 0
      iterate

      end
      when 31 then do
        byte = <at..u8>(pos) scan_bytes
        if byte \= 0x63 then do
          state = 19
          iterate
        end
        pos = pos + 1
        byte = <at..u8>(pos) scan_bytes
        if byte \= 0x6F then do
          state = 19
          iterate
        end
        pos = pos + 1
        byte = <at..u8>(pos) scan_bytes
        if byte \= 0x64 then do
          state = 19
          iterate
        end
        pos = pos + 1
        byte = <at..u8>(pos) scan_bytes
        if byte \= 0x65 then do
          state = 19
          iterate
        end
        pos = pos + 1

      call level_l_gennorm2_emit tokens, count, 7, start, pos - start
      start = pos
      state = 0
      iterate

      end
    end
  end


level_l_gennorm2_status: procedure = .int expose _level_l_status _level_l_error_offset _level_l_error_message
  return _level_l_status

level_l_gennorm2_error_offset: procedure = .int expose _level_l_status _level_l_error_offset _level_l_error_message
  return _level_l_error_offset

level_l_gennorm2_error_message: procedure = .string expose _level_l_status _level_l_error_offset _level_l_error_message
  return _level_l_error_message

level_l_gennorm2_token_count: procedure = .int
  arg tokens = .binary
  return <blen>(tokens) <idiv> 12

level_l_gennorm2_token_kind: procedure = .int
  arg tokens = .binary, index = .int
  return <at..u16>(index * 12) tokens

level_l_gennorm2_token_start: procedure = .int
  arg tokens = .binary, index = .int
  return <at..u32>(index * 12 + 2) tokens

level_l_gennorm2_token_length: procedure = .int
  arg tokens = .binary, index = .int
  return <at..u32>(index * 12 + 6) tokens

level_l_gennorm2_token_name: procedure = .string
  arg kind = .int
  select kind
    when 0 then return "eof"
    when 1 then return "hexadecimal"
    when 2 then return "range"
    when 3 then return "colon"
    when 4 then return "equals"
    when 5 then return "greater"
    when 6 then return "star"
    when 7 then return "unicode_keyword"
    when 8 then return "version"
    when 9 then return "newline"
    otherwise return "unknown"
  end
  return "unknown"

level_l_gennorm2_emit: procedure = .int
  arg expose tokens = .binary, expose count = .int, kind = .int, start = .int, span_length = .int
  offset = count * 12
  call binresize tokens, offset + 12
  <at..u16>(offset) tokens = kind
  <at..u32>(offset + 2) tokens = start
  <at..u32>(offset + 6) tokens = span_length
  count = count + 1
  return count
