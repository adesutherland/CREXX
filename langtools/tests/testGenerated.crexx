/* cREXX License (MIT). Generated second-language and packed-image contracts. */
options levelb
import rxfnsb
import llcore
import llfront
import lllr
import llregular
import llmunch
import lllanguage
import llsource
import lltree
import levell_example
main: procedure = .int expose failures checks
  arg argv = .string[]
  failures = 0; checks = 0
  doc = .llfront..document(readbinary(argv[1]) as .string)
  call check(doc.run() = 0,'specification')
  graph = doc.grammar(); constructed = .lllr..tables(graph,doc.root(),'lr1')
  call check(constructed.status() = 0,'LR admission')
  definition = levell_example..language(); loaded = definition.tables()
  call check(loaded.status() = 0,'generated LR load')
  call check(loaded.image() = constructed.image(),'identical LR image')
  do state = 1 to constructed.states()
    do symbol = 0 to 256
      call check(loaded.action(state,symbol) = constructed.action(state,symbol),'action cell')
    end
    do nt = 1 to graph.size() + 1
      call check(loaded.target(state,nt) = constructed.target(state,nt),'goto cell')
    end
  end
  builder = .llregular..builder(doc.lexgrammar(),doc.lexroots(),doc.lexkinds())
  call check(builder.error() = '', 'DFA admission')
  original = builder.automaton(); scanner = definition.automaton()
  call check(scanner.verify() = 1,'DFA validated')
  call check(scanner.image() = original.image(),'identical DFA image')
  byte = .int
  do byte = 0 to 255
    call check(scanner.classof(byte) = original.classof(byte),'DFA byte class')
  end
  do s = 1 to scanner.states()
    call check(scanner.kind(s) = original.kind(s),'DFA acceptance')
    do byte = 0 to 255
      cls = scanner.classof(byte)
      call check(scanner.target(s,cls) = original.target(s,cls),'DFA transition')
    end
  end
  source = '12, 34,56' as .binary
  request = .lllanguage..request(definition,source)
  call check(request.parse() = 0,'valid list')
  tree = request.tree()
  call check(tree.source() = source,'owned original source')
  source = 'bad' as .binary
  call check(tree.source() = '12, 34,56' as .binary,'source survives caller replacement')
  invalid = .lllanguage..request(definition,'12,' as .binary)
  call check(invalid.parse() = 1,'damaged list rejected')
  call check(pos('number',invalid.error()) > 0,'named expectation')
  image = constructed.image(); identity = graph.signature() || '|root=' || doc.root()
  independent = .lllr..tables.loaded(graph,doc.root(),image,identity)
  image = '00'x as .binary
  call check(independent.action(1,1) = loaded.action(1,1),'image survives caller replacement')
  wrong = .lllr..tables.loaded(graph,doc.root(),image,identity)
  call check(wrong.status() = 3,'truncated LR image')
  image = constructed.image(); <at..i32>(0) image = 0
  wrong = .lllr..tables.loaded(graph,doc.root(),image,identity)
  call check(wrong.status() = 3,'bad LR magic')
  image = constructed.image(); <at..i32>(20) image = <at..i32>(12) image
  wrong = .lllr..tables.loaded(graph,doc.root(),image,identity)
  call check(wrong.status() = 3,'duplicate/reordered LR records')
  wrong = .lllr..tables.loaded(graph,doc.root(),constructed.image(),'changed grammar')
  call check(wrong.status() = 3,'grammar identity mismatch')
  wrong = .lllr..tables.loaded(graph,doc.root() - 1,constructed.image(),identity)
  call check(wrong.status() = 3,'selected root identity mismatch')
  bytes = scanner.image(); <at..i32>(16) bytes = 999
  badscanner = .llmunch..automaton.loaded(bytes)
  call check(badscanner.verify() = 0,'bad DFA class')
  bytes = scanner.image(); <at..i32>(1040) bytes = 1
  badscanner = .llmunch..automaton.loaded(bytes)
  call check(badscanner.verify() = 0,'nullable DFA rejected')
  message = llsource..diagnostic('610d0a62630d6465'x as .binary,7,'TEST','expected item')
  call check(pos('line 3, column 2',message) > 0,'CRLF and CR locations')
  call check(pos('^',message) > 0,'source caret')
  message = llsource..diagnostic('61ff'x as .binary,1,'TEST','invalid UTF8')
  call check(pos('source bytes:',message) > 0,'malformed byte explanation')
  /* Long repeated lists must not materialize every intermediate suffix.
   * The named view has 3,001 nodes and 3,000 visible child references. */
  raw = .llcore..tree.from_source(copies('x',3000) as .binary)
  chain = 0
  do item = 3000 to 1 by -1
    leaf = raw.add(1,'identifier',item - 1,item,0,0)
    chain = raw.add(2,'sequence',item - 1,3000,leaf,chain)
  end
  root = raw.add(5,'items',0,3000,chain,0)
  view = .lltree..view(raw,root,6001)
  call check(view.error() = '', 'flat list within linear entry budget')
  if view.error() = '' then do
    call check(view.count(view.root()) = 3000,'flat list item count')
    call check(view.start(view.child(view.root(),1)) = 0,'flat list first span')
    call check(view.finish(view.child(view.root(),3000)) = 3000,'flat list last span')
  end
  exhausted = .lltree..view(raw,root,6000)
  call check(pos('tree.entries budget 6000',exhausted.error()) > 0,'flat list exact entry budget')
  transparent = raw.add(2,'sequence',0,3000,root,0)
  through = .lltree..view(raw,transparent,6001)
  call check(through.error() = '' & through.root() = root,'transparent root selects named root')
  call regularconstruction()
  say 'generated_checks=' || checks
  say 'generated_failures=' || failures
  return failures
check: procedure = .void expose failures checks
  arg condition = .boolean, label = .string
  checks = checks + 1
  if condition = 0 then do
    failures = failures + 1; say 'FAIL ' || label
  end
  return

/* A separate four-state oracle checks class numbering and first-discovery
 * order, rather than comparing two products of the same DFA construction.
 * Duplicate roots and an overlapping range leave many epsilon/accept rows
 * beside the one consuming row after 'a'. A first accept of kind zero must
 * still win over later nonzero accepts. */
regularconstruction: procedure = .void
  ok = .int; cls = .int; failed = .int; invalidkey = .binary
  graph = .llcore..grammar('contextfree')
  a = graph.add(1,97,0,'a',1)
  b = graph.add(1,98,0,'b',1)
  range = graph.add(11,97,99,'a to c',1)
  pair = graph.add(2,a,b,'ab',1)
  duplicate = graph.add(4,a,a,'duplicate a',1)
  mask = graph.characters('a' as .binary,0,'a mask',1)
  roots = .int[]; kinds = .int[]
  roots[1] = a; kinds[1] = 0
  roots[2] = range; kinds[2] = 2
  roots[3] = pair; kinds[3] = 3
  roots[4] = duplicate; kinds[4] = 7
  roots[5] = mask; kinds[5] = 8
  built = .llregular..builder(graph,roots,kinds)
  call check(built.error() = '','indexed consuming-row grammar admission')
  actual = built.automaton()
  expected = .llmunch..automaton(4,4)
  do byte = 0 to 255
    cls = 0
    if byte = 97 then cls = 1
    if byte = 98 then cls = 2
    if byte = 99 then cls = 3
    ok = expected.mapping(byte,cls)
  end
  do state = 1 to 4
    ok = expected.accepting(state,0)
    do cls = 0 to 3
      ok = expected.transition(state,cls,0)
    end
  end
  ok = expected.transition(1,1,2)
  ok = expected.transition(1,2,3)
  ok = expected.transition(1,3,3)
  ok = expected.transition(2,2,4)
  ok = expected.accepting(3,2)
  ok = expected.accepting(4,3)
  call check(expected.verify() = 1,'independent four-state DFA oracle')
  call check(actual.image() = expected.image(),'exact independent DFA image with duplicate and zero-kind accepts')

  /* Exercise the public value wrapper with an epsilon cycle. Its queue and
   * dense membership are caller-owned and must not be extended in place. */
  empty = .int[]; raw = .llcore..grammar('contextfree')
  helper = .llregular..builder(raw,empty,empty)
  accepted = helper.node(2,0,0,5,'')
  link = helper.node(0,accepted,0,0,'')
  cycle = helper.node(0,link,accepted,0,'')
  call helper.patch(link,cycle)
  active = .binary; call binresize active,3
  <at..u8>(cycle - 1) active = 1
  saved = active; pending = .int[]; pending[1] = cycle
  closed = helper.closure(active,pending)
  call check(closed = '010000000200000003000000'x as .binary,'epsilon cycle canonical membership')
  call check(active = saved & pending[0] = 1 & pending[1] = cycle,'public closure preserves both input values')
  call check(helper.membershipkey('010101'x as .binary,3) = closed,'complete dense membership has the same canonical key')
  failed = 0
  do
    invalidkey = helper.membershipkey('010101'x as .binary,0)
  on signal as problem
    failed = pos('LL_LEX_SUBSET',problem.message()) > 0
  end
  call check(failed,'dense membership rejects understated count before writing')
  failed = 0
  do
    invalidkey = helper.membershipkey('010201'x as .binary,3)
  on signal as problem
    failed = pos('LL_LEX_SUBSET',problem.message()) > 0
  end
  call check(failed,'dense membership rejects invalid bit values')

  keys = .int[]
  keys[1] = 2147483647; keys[2] = -2147483648
  keys[3] = 5; keys[4] = 5; keys[5] = -3; keys[6] = 0; keys[7] = 4
  original = keys
  ordered = helper.subsetkey(keys)
  call check(ordered = '00000080FDFFFFFF00000000040000000500000005000000FFFFFF7F'x as .binary,'packed stable sort preserves signed order and duplicates')
  call check(keys[0] = original[0],'public subset key preserves input length')
  do i = 1 to original[0]
    call check(keys[i] = original[i],'public subset key preserves input element')
  end
  call check(helper.subsetkey(empty) = ''x as .binary,'empty canonical subset')
  return
