/* cREXX License (MIT). Original-byte provenance and recovery lifetime. */
options levelb
import rxfnsb
import llcore
import llast
import llrecover
import lllanguage
import lllimits
import llsource
import llflow
import originlang

main: procedure = .int
  arg argv = .string[]
  if argv[0] = 1 then do
    if argv[1] = 'earley-budget' then return earley_budget()
  end
  if argv[0] <> 0 then do
    say 'usage: ts_llorigins [earley-budget]'
    return 2
  end
  failures = 0; node = .llast..node; draft = .llast..draft; raw = .llcore..tree
  first = 'α = 1;'; prefix = first || '0d0a'x || 'bad = '
  source = prefix || ';' || '0d0a'x || 'say α;' || '0d0a'x || '@; z = 2;'
  request = .llrecover..request(originlang..language(),source as .binary)
  status = request.run()
  failures = failures + check(status = 1,'two-error recovery')
  tree = request.ast(); damage = tree.damage()
  failures = failures + check(tree.status() = 1 & tree.isrecovered() & tree.root().origin() = 'recovered','explicit recovered tree')
  failures = failures + check(pos('LL_AST_RECOVERED',tree.error()) > 0,'recovered status message')
  failures = failures + check(tree.source() = source as .binary & damage.size() = 2,'original bytes and damage count')
  failures = failures + check(damage.offset(1) = <blen>(prefix as .binary),'original syntax byte offset')
  failures = failures + check(damage.first(1) = <blen>(first as .binary) & damage.last(1) = <blen>((prefix || ';') as .binary),'skipped interval')
  failures = failures + check(damage.offset(1) < damage.offset(2),'source order after lexical-first discovery')
  do i = 1 to damage.size()
    failures = failures + check(damage.message(i) = request.message(i) & damage.offset(i) = request.offset(i),'original diagnostic retained')
    raw = request.tree(); errornode = request.errornode(i)
    failures = failures + check(raw.start(errornode) = damage.first(i) & raw.finish(errornode) = damage.last(i),'associated raw error node')
  end
  failures = failures + check(tree.root().count('items') = 3,'surviving records')
  saynode = tree.root().child('items',2)
  failures = failures + check(saynode.line() = 3 & saynode.child('value').text('spelling') = 'α','CRLF and Unicode spelling')
  failures = failures + check(saynode.origin() = 'exact','undamaged child remains exact')
  display = llsource..diagnostic(tree.source(),damage.offset(1),'INPUT',damage.message(1))
  failures = failures + check(pos('line 2, column 7',display) > 0 & pos('bad = ;',display) > 0,'original diagnostic excerpt')
  graph = originlang..execution(reference tree)
  failures = failures + check(graph.points() = 0 & pos('LL_AST_RECOVERED',graph.error()) > 0,'clean-flow gate')
  conditions = .llflow..conditions(reference tree)
  failures = failures + check(pos('LL_AST_RECOVERED',conditions.error()) > 0,'clean-fact gate')
  strict = .lllanguage..request(originlang..language(),source as .binary); status = strict.parse()
  failed = strict.ast()
  failures = failures + check(status <> 0 & failed.status() > 1 & failed.root().valid() = 0,'strict parse refuses recovered input')
  copy = tree; held = copy.root()
  tree = recovered(source as .binary)
  failures = failures + check(tree.status() = 1 & held.valid() & copy.damage().size() = 2,'request release and independent copy')
  detached = tree.damage(); ok = detached.add(0,0,0,0,'extra record')
  failures = failures + check(detached.size() = 3 & tree.damage().size() = 2,'owned metadata copy')
  pass = tree.rewrite()
  do while pass.next()
    node = pass.node()
    if node.kind() = 'Number' then do
      draft = pass.synthetic('Number',node.offset())
      ok = draft.settext('spelling','42'); ok = pass.replace(draft)
    end
  end
  changed = pass.finish()
  failures = failures + check(changed.status() = 1 & changed.damage().size() = 2 & changed.source() = tree.source(),'rewrite retains damage')
  generated = changed.root().child('items',1).child('value')
  failures = failures + check(generated.origin() = 'synthetic' & generated.start() = generated.finish() & generated.sourcetext() = '' & generated.text('spelling') = '42','zero-width generated origin')
  lowerpass = changed.lower(changed.contract())
  do while lowerpass.next()
    ok = lowerpass.keep()
  end
  lowered = lowerpass.finish()
  failures = failures + check(lowered.status() = 1 & lowered.damage().message(1) = damage.message(1),'lowering retains damage')
  failures = failures + check(lowered.root().child('items',1).child('value').origin() = 'synthetic','lowering keeps synthetic child')
  /* Even replacing the recovered root with an empty generated root retains damage. */
  lowerpass = tree.lower(tree.contract())
  do while lowerpass.next()
    if lowerpass.original().kind() = 'Program' then do
      draft = lowerpass.synthetic('Program',0); ok = lowerpass.replace(draft)
    end
    else ok = lowerpass.keep()
  end
  reduced = lowerpass.finish()
  failures = failures + check(reduced.status() = 1 & reduced.root().origin() = 'recovered' & reduced.damage().size() = 2,'root replacement cannot erase damage')
  clean = parseinput('x = 1;' || '0d0a'x || 'say x;')
  failures = failures + check(clean.status() = 0 & clean.damage().size() = 0 & clean.isrecovered() = 0,'clean origin contract')
  lowerpass = clean.lower(clean.contract())
  do while lowerpass.next()
    node = lowerpass.original()
    if node.kind() = 'Name' then do
      draft = lowerpass.synthetic('Number',<blen>(clean.source())); ok = draft.settext('spelling','9'); ok = lowerpass.replace(draft)
    end
    else ok = lowerpass.keep()
  end
  synthetic = lowerpass.finish(); node = synthetic.root().child('items',2).child('value')
  failures = failures + check(synthetic.status() = 0 & node.line() = 2 & node.origin() = 'synthetic' & node.offset() = <blen>(clean.source()),'lowered CRLF synthetic anchor')
  pass = clean.rewrite(); ok = pass.next(); draft = pass.synthetic('Number',<blen>(clean.source()) + 1); failed = pass.finish()
  failures = failures + check(failed.status() > 1 & failed.root().valid() = 0,'out-of-range anchor')
  empty = parseinput(''); lowerpass = empty.lower(empty.contract()); ok = lowerpass.next()
  draft = lowerpass.synthetic('Program',0); ok = lowerpass.replace(draft); ok = lowerpass.next(); result = lowerpass.finish()
  failures = failures + check(result.status() = 0 & result.root().origin() = 'synthetic' & result.root().start() = 0,'empty source anchor')
  store = .llast..storage('x' as .binary,clean.contract())
  nodeid = store.add(clean.contract().kindindex('Number'),0,1,'exact derived')
  failures = failures + check(nodeid = 0 & pos('LL_AST_ORIGIN',store.error()) > 0,'unknown origin rejected')
  store = .llast..storage('x' as .binary,clean.contract())
  nodeid = store.add(clean.contract().kindindex('Number'),0,1,'synthetic')
  failures = failures + check(nodeid = 0,'synthetic range must be empty')
  store = .llast..storage('x' as .binary,clean.contract())
  nodeid = store.add(clean.contract().kindindex('Number'),0,1,'recovered')
  failures = failures + check(nodeid = 0,'recovered origin needs records')
  malformed = ('x = 1;' as .binary) || 'ff'x || (';y = 2;' as .binary)
  broken = recovered(malformed)
  failures = failures + check(broken.status() = 1 & broken.source() = malformed & pos('FF',broken.damage().message(1)) > 0,'malformed UTF8 retains original bytes')
  held = broken.root(); broken = parseinput('')
  failures = failures + check(held.valid() = 0,'recovered handles invalidate on replacement')
  raw = .llcore..tree.from_source(source as .binary)
  root = raw.add(1,'program',0,<blen>(source as .binary),0,0)
  accepted = .llast..tree.recovered(raw,root,clean.contract(),tree.damage(),4)
  failures = failures + check(accepted.status() = 1 & accepted.entries() = 4,'exact metadata entry allowance')
  failed = .llast..tree.recovered(raw,root,clean.contract(),tree.damage(),3)
  failures = failures + check(failed.status() = 2 & failed.root().valid() = 0,'metadata included in entry allowance')
  invalid = .llast..damage(); ok = invalid.add(0,<blen>(source as .binary) + 1,0,0,'invalid record')
  failed = .llast..tree.recovered(raw,root,clean.contract(),invalid)
  failures = failures + check(failed.status() = 3 & pos('LL_AST_ORIGIN',failed.error()) > 0,'record beyond original source')
  if originlang..language().backend() = 'regional' then do
    composite = recovered('a = [1 + 2];bad = [1 + ];z = 3;' as .binary)
    failures = failures + check(composite.status() = 1 & composite.root().count('items') = 2,'regional recovered AST')
    expression = composite.root().child('items',1).child('value')
    failures = failures + check(expression.kind() = 'Add' & expression.child('right').text('spelling') = '2','Pratt region shape and values')
    failures = failures + check(composite.damage().size() = 1 & composite.damage().first(1) = 12,'regional original interval')
  end
  say 'failures=' || failures
  return failures
/* Find the public policy success boundary without duplicating parser charges.
 * The default bounds the search (23 steps today); the baseline and two recovery
 * probes are the only additional requests. Every attempt owns fresh state. */
earley_budget: procedure = .int
  language = .lllanguage..definition; defaults = .lllimits..policy
  low = .int; high = .int; span = .int; maxsteps = .int; steps = .int
  midpoint = .int; before = .int; status = .int
  last_success = .int; last_failure = .int
  recovery_positive = .int; recovery_short = .int
  language = originlang..language()
  if language.backend() <> 'earley' | language.sync() < 0 then return check(0,'Earley recovery definition required')
  defaults = .lllimits..policy(); low = 1; high = defaults.limit('earley.cells')
  if earley_attempt(language,high,0) <> 0 then return check(0,'default Earley budget must produce valid AST')
  last_success = high; last_failure = 0; steps = 0; maxsteps = 0; span = high - 1
  do while span > 0
    maxsteps = maxsteps + 1; span = span <idiv> 2
  end
  do while low < high
    if steps >= maxsteps then return check(0,'Earley budget search exceeded its default-derived bound')
    before = high - low; midpoint = low + ((high - low) <idiv> 2)
    status = earley_attempt(language,midpoint,0); steps = steps + 1
    if status = 0 then do
      high = midpoint; last_success = midpoint
    end
    else if status = 2 then do
      low = midpoint + 1; last_failure = midpoint
    end
    else return check(0,'Earley budget search accepts only clean or chart-resource outcomes')
    if high - low >= before then return check(0,'Earley budget interval must shrink')
  end
  /* Both strict boundary results were observed and checked during the search. */
  if high <= 1 | last_success <> high | last_failure <> high - 1 then return check(0,'exact Earley positive and one-short boundary')
  recovery_positive = earley_attempt(language,high,1)
  recovery_short = earley_attempt(language,high - 1,1)
  if recovery_positive <> 0 | recovery_short <> 2 then return check(0,'recovery must preserve clean and chart-resource outcomes')
  say 'EARLEY_BUDGET|minimum=' || high || '|strict_gap=' || (last_success - last_failure) || '|search_steps=' || steps || '|recovery_positive=' || recovery_positive || '|recovery_short=' || recovery_short || '|failures=0'
  return 0

earley_attempt: procedure = .int
  arg language = .lllanguage..definition, cells = .int, use_recovery = .int
  limits = .lllimits..policy; source = .binary; status = .int
  detail = .string; expected = .string; tree = .llast..tree
  strict = .lllanguage..request; recovering = .llrecover..request
  limits = .lllimits..policy(); source = 'x=1;' as .binary
  if limits.set('earley.cells',cells) = 0 then do
    say 'FAIL: invalid Earley test budget:' limits.error(); return 3
  end
  if use_recovery then do
    /* The public zero argument selects the policy's repair allowance. Clean
     * input must use none, and resource exhaustion must return before repair. */
    recovering = .llrecover..request(language,source,0,limits)
    status = recovering.run(); detail = recovering.error(); tree = recovering.ast()
    if recovering.errors() <> 0 then do
      say 'FAIL: clean Earley budget probe attempted recovery'; return 3
    end
  end
  else do
    strict = .lllanguage..request(language,source,limits)
    status = strict.parse(); detail = strict.error(); tree = strict.ast()
  end
  if status = 0 then do
    if detail <> '' | tree.status() <> 0 | tree.root().valid() = 0 then do
      say 'FAIL: Earley positive budget did not publish a clean owned AST'; return 3
    end
    if tree.source() <> source | tree.root().kind() <> 'Program' | tree.root().count('items') <> 1 then do
      say 'FAIL: Earley positive AST lost source or record'; return 3
    end
    if tree.root().child('items',1).text('name') <> 'x' | tree.root().child('items',1).child('value').text('spelling') <> '1' then do
      say 'FAIL: Earley positive AST has wrong record value'; return 3
    end
    return 0
  end
  expected = 'LL_RESOURCE_LIMIT: earley.cells budget ' || cells || ', more required.'
  if status <> 2 | pos(expected,detail) <> 1 then do
    say 'FAIL: unrelated Earley outcome:' status detail; return 3
  end
  if tree.status() <= 1 | tree.root().valid() | tree.isrecovered() then do
    say 'FAIL: Earley chart exhaustion published a clean/recovered partial AST'; return 3
  end
  return 2

parseinput: procedure = .llast..tree
  arg source = .string
  request = .lllanguage..request(originlang..language(),source as .binary)
  if request.parse() <> 0 then do
    say request.error(); exit 1
  end
  return request.ast()
recovered: procedure = .llast..tree
  arg source = .binary
  request = .llrecover..request(originlang..language(),source)
  return request.ast()
check: procedure = .int
  arg passed = .int, message = .string
  if passed then return 0
  say 'FAIL:' message
  return 1
