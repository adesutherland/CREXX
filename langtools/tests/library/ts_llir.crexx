/* cREXX License (MIT). Independent IR contract regressions. */
options levelb
import rxfnsb
import llir
import llirservices

main: procedure = .int
  s = .llir..schema()
  f = s.family('demo',1)
  integer = f.type('integer',.llir..intcodec() as .object)
  add = f.operation('add')
  call add.input('left',integer)
  call add.input('right',integer)
  call add.output('value',integer)
  call add.state('none')
  call add.failure('none')
  call add.termination('returns')
  c = s.finish()
  failures = check(c.error() = '','schema')
  draft = .llir..builder(c)
  at = draft.synthetic('IR regression')
  mainfn = draft.function('main',c.voidtype())
  entry = mainfn.block('entry')
  total = mainfn.slot('total',integer)
  left = entry.constant(integer,'2',at)
  right = entry.constant(integer,'3',at)
  sum = entry.binary(add,left,right,at)
  call entry.store(total,sum,at)
  call entry.returnvoid(at)
  graph = draft.finish()
  if graph.error() <> '' then say graph.error()
  failures = failures + check(graph.error() = '' & graph.operations() = 5,'constructed graph')
  held = graph.operation(3)
  failures = failures + check(held.name() = 'demo.add' & held.inputs() = 2,'structured view')
  codec = .llir..intcodec()
  bits = codec.parse('-9223372036854775808')
  failures = failures + check(codec.format(bits) = '-9223372036854775808','minimum integer')
  image = graph.binary()
  restored = llir..loadbinary(c,image)
  if restored.error() <> '' then say restored.error()
  failures = failures + check(restored.error() = '' & bin2x(restored.binary()) = bin2x(image),'binary round trip')
  saved = graph.text()
  restored = llir..loadtext(c,saved)
  if restored.error() <> '' then say restored.error()
  failures = failures + check(restored.error() = '' & restored.text() = saved,'text round trip')
  failures = failures + check(pos('demo.add',graph.dump()) > 0,'named dump')
  failures = failures + refusals(c,graph) + emission() + origins(c) + registration() + signatures() + optionalarguments() + protection(c)
  say 'failures=' || failures
  return failures

/** Independent protected-invocation structure and setup-only slot facts. */
protection: procedure = .int
  arg contract = .llir..contract
  draft = .llir..builder(contract); at = draft.synthetic('protected invocation')
  fn = draft.function('protected',contract.voidtype())
  entry = fn.block('setup'); body = fn.block('body'); exceptional = fn.block('exceptional')
  integer = contract.type('demo.integer'); setupslot = fn.slot('setup',integer); bodyslot = fn.slot('body',integer)
  before = entry.constant(integer,'2',at); call entry.store(setupslot,before,at)
  call entry.protect(body,exceptional,at)
  later = body.constant(integer,'3',at); call body.store(bodyslot,later,at); call body.returnvoid(at)
  ready = exceptional.load(setupslot,at); missing = exceptional.load(bodyslot,at); call exceptional.returnvoid(at)
  other = draft.function('other',contract.voidtype()); foreign = other.block('foreign'); call foreign.returnvoid(at)
  graph = draft.finish(); failures = check(graph.error() = '','protect construction: ' || graph.error())
  if graph.error() <> '' then return failures
  op = graph.operation(3)
  failures = failures + check(op.name() = 'core.protect' & op.inputs() = 0 & op.results() = 0 & op.successors() = 2,'protect exact core signature')
  failures = failures + check(op.successor(1) = body.id() & op.successor(2) = exceptional.id(),'protect ordered edges')
  text = graph.text(); image = graph.binary()
  restored = llir..loadtext(contract,text)
  failures = failures + check(restored.error() = '' & restored.text() = text,'protect text round trip')
  restored = llir..loadbinary(contract,image)
  failures = failures + check(restored.error() = '' & bin2x(restored.binary()) = bin2x(image),'protect binary round trip')
  restored = llir..loadtext(contract,legacytext(text))
  failures = failures + check(pos('LL_IR_OPCODE: version 1 core opcode',restored.error()) > 0 & restored.operations() = 0,'v1 text rejects protect')
  restored = llir..loadbinary(contract,legacybinary(image))
  failures = failures + check(pos('LL_IR_OPCODE: version 1 core opcode',restored.error()) > 0 & restored.operations() = 0,'v1 binary rejects protect')
  report = .llirservices..analysis
  report = llirservices..analyse(reference graph)
  failures = failures + check(report.status() = 'ok' & report.issues() = 1,'protect setup-only definite assignment')
  if report.status() = 'ok' then do
    facts = report.facts()
    failures = failures + check(bin2x(facts.get('block',body.id(),'reachable')) = '01' & bin2x(facts.get('block',exceptional.id(),'reachable')) = '01','both protect edges reachable')
    failures = failures + check(bin2x(facts.get('operation',7,'definitely.assigned')) = '01' & bin2x(facts.get('operation',8,'definitely.assigned')) = '00','exceptional input excludes later body store')
  end
  foldfacts = .llirservices..facts(reference graph); answer = llirservices..evaluate(reference graph,3,foldfacts)
  failures = failures + check(answer.status() = 'keep' & answer.size() = 0,'protect is not constant evaluation')
  rebuilt = llirservices..lower(reference graph,contract); restored = rebuilt.result()
  failures = failures + check(rebuilt.status() = 'changed' & restored.text() = text,'reconstruction retains protect and both edges')
  cases = .string[]
  cases[1] = 'operations 3 9 1 LL_IR_TERMINATOR'
  cases[2] = 'operations 3 10 1 LL_IR_ATTRIBUTE'
  cases[3] = 'operations 3 12 1 LL_IR_RESERVED'
  cases[4] = 'edges 1 1 4 LL_IR_OWNER'
  cases[5] = 'operations 3 3 4 LL_IR_TERMINATOR'
  cases[6] = 'operations 3 5 1 LL_IR_'
  cases[7] = 'operations 3 7 1 LL_IR_'
  i = .int
  do i = 1 to cases[0]
    item = cases[i]
    restored = llir..loadtext(contract,corrupt(text,word(item,1),word(item,2) as .int,word(item,3) as .int,word(item,4)))
    failures = failures + check(pos(word(item,5),restored.error()) > 0 & restored.operations() = 0,'protect malformed ' || item)
  end
  draft = .llir..builder(contract); at = draft.synthetic('after protect')
  fn = draft.function('f',contract.voidtype()); entry = fn.block('entry'); body = fn.block('body'); exceptional = fn.block('exceptional')
  call entry.protect(body,exceptional,at); call entry.returnvoid(at)
  call body.returnvoid(at); call exceptional.returnvoid(at); restored = draft.finish()
  failures = failures + check(pos('operation follows a terminator',restored.error()) > 0,'builder refuses work after protect')
  draft = .llir..builder(contract); at = draft.synthetic('foreign protect')
  fn = draft.function('f',contract.voidtype()); entry = fn.block('entry'); body = fn.block('body')
  foreign_draft = .llir..builder(contract); foreign_at = foreign_draft.synthetic('other owner')
  foreign_fn = foreign_draft.function('g',contract.voidtype()); foreign = foreign_fn.block('entry'); call foreign.returnvoid(foreign_at)
  call entry.protect(body,foreign,at); call body.returnvoid(at); restored = draft.finish()
  failures = failures + check(pos('protect successors or origin belong to another module',restored.error()) > 0,'builder refuses foreign protect owner')
  failures = failures + check(graph.text() = text & bin2x(graph.binary()) = bin2x(image),'protect refusals preserve original graph')
  return failures

check: procedure = .int
  arg condition = .int, description = .string
  if condition then return 0
  say 'FAIL: ' || description
  return 1

refusals: procedure = .int
  arg contract = .llir..contract, graph = .llir..module
  failures = 0; image = graph.binary(); restored = .llir..module
  do cut = 0 to <blen>(image) - 1 by 17
    short = binsubstr(image,1,cut)
    restored = llir..loadbinary(contract,short)
    failures = failures + check(restored.error() <> '' & restored.operations() = 0,'truncated image ' || cut)
  end
  saved = graph.text()
  cases = .string[]
  cases[1] = 'operations 4 4 1 LL_IR_OWNERSHIP'
  cases[2] = 'operations 3 5 4 LL_IR_RANGE'
  cases[3] = 'operations 3 1 999 LL_IR_OPCODE'
  cases[4] = 'operations 3 11 999 LL_IR_ORIGIN'
  cases[5] = 'operations 3 12 1 LL_IR_RESERVED'
  cases[6] = 'values 3 4 1 LL_IR_RESERVED'
  cases[7] = 'operations 5 3 1 LL_IR_TERMINATOR'
  cases[8] = 'slots 1 4 1 LL_IR_RESERVED'
  cases[9] = 'functions 1 6 999 LL_IR_EXPORT'
  cases[10] = 'origins 1 4 5 LL_IR_RECOVERED'
  cases[11] = 'origins 1 3 1 LL_IR_ORIGIN'
  cases[12] = 'operands 1 1 999 LL_IR_VALUE'
  cases[13] = 'values 1 3 2 LL_IR_TYPE'
  do i = 1 to cases[0]
    item = cases[i]
    damaged = corrupt(saved,word(item,1),word(item,2) as .int,word(item,3) as .int,word(item,4))
    restored = llir..loadtext(contract,damaged)
    expected = word(item,5)
    if pos(expected,restored.error()) = 0 then say 'Unexpected diagnostic: ' || restored.error()
    failures = failures + check(pos(expected,restored.error()) > 0 & restored.operations() = 0,'malformed ' || item)
  end
  restored = llir..loadbinary(contract,image,1000000,1)
  failures = failures + check(pos('LL_RESOURCE_LIMIT',restored.error()) > 0,'loader byte policy')
  other = .llir..schema(); othercontract = other.finish()
  restored = llir..loadbinary(othercontract,image)
  failures = failures + check(pos('LL_IR_SCHEMA',restored.error()) > 0,'incompatible schema')
  mutated = image; <at..u32>(4) mutated = 999
  restored = llir..loadbinary(contract,mutated)
  failures = failures + check(pos('LL_IR_IMAGE',restored.error()) > 0,'unknown binary version')
  restored = llir..loadtext(contract,saved || 'extra' || '0a'x)
  failures = failures + check(pos('trailing',restored.error()) > 0,'trailing text rejected')
  held = graph.block(1); protected = 0
  do
    at = graph.operation(1); call held.returnvoid(at.origin())
  on signal
    protected = 1
  end
  failures = failures + check(protected & graph.error() = '' & bin2x(graph.binary()) = bin2x(image),'frozen mutation preserves module')
  graph = llir..loadbinary(contract,image)
  failures = failures + check(held.valid() = 0,'handle invalid after owner replacement')
  draft = .llir..builder(contract,1,1); origin = draft.synthetic()
  restored = draft.finish()
  failures = failures + check(pos('LL_RESOURCE_LIMIT',restored.error()) > 0,'builder storage policy')
  draft = .llir..builder(contract); origin = draft.synthetic()
  fn = draft.function('cross',contract.voidtype()); first = fn.block('first'); second = fn.block('second')
  integer = contract.type('demo.integer'); value = first.constant(integer,'1',origin)
  call first.jump(second,origin); target = fn.slot('target',integer)
  call second.store(target,value,origin); call second.returnvoid(origin)
  restored = draft.finish()
  failures = failures + check(pos('temporary crosses a block',restored.error()) > 0,'cross-block temporary rejected')
  return failures

corrupt: procedure = .string
  arg text = .string, table = .string, row = .int, col = .int, replacement = .string
  reader = .llir..textreader(text); out = .llir..writer(); countdown = 0
  do while reader.left() > 0
    line = reader.line()
    if countdown > 0 then do
      countdown = countdown - 1
      if countdown = 0 then do
        fixed = ''
        do i = 1 to words(line)
          if i > 1 then fixed = fixed || ' '
          if i = col then fixed = fixed || replacement
          else fixed = fixed || word(line,i)
        end
        line = fixed
      end
    end
    else if word(line,1) = table then countdown = row
    call out.line(line)
  end
  result = out.finish()
  return result.text()

emission: procedure = .int
  out = .llir..writer(); call out.line('main:'); call out.indent(); call out.line('say "hello"',7); call out.dedent()
  part = out.section(); call part.write('tail'); section = part.finish(); call out.append(reference section)
  result = out.finish()
  expected = 'main:' || '0a'x || '  say "hello"' || '0a'x || 'tail'
  failures = check(result.text() = expected & result.origin(2) = 7,'chunk output, indentation, section and origin')
  sink = .rejectsink()
  failures = failures + check(pos('test sink failure',result.stream(sink)) > 0,'sink failure reported')
  out = .llir..writer(3); call out.write('four'); result = out.finish()
  failures = failures + check(pos('LL_RESOURCE_LIMIT',result.error()) > 0 & result.bytes() = 0 & result.text() = '','emitter limit publishes no partial output')
  out = .llir..writer(); call out.indent(); result = out.finish()
  failures = failures + check(pos('unclosed',result.error()) > 0,'unbalanced indentation')
  return failures

rejectsink: class implements .llir..sink
  *: factory
    return
  write: method = .string
    arg bytes = .binary
    return 'test sink failure'

origins: procedure = .int
  arg contract = .llir..contract
  draft = .llir..builder(contract)
  source = draft.source('δοκιμή.crexx','CEB10D0A00FF'x as .binary)
  exact = source.origin(0,6); derived = exact.derive()
  fn = draft.function('origins',contract.voidtype()); entry = fn.block('entry'); call entry.returnvoid(derived)
  graph = draft.finish(); restored = llir..loadbinary(contract,graph.binary())
  op = restored.operation(1); at = op.origin()
  failures = check(at.filename() = 'δοκιμή.crexx' & at.first() = 0 & at.last() = 6,'Unicode filename and byte span')
  failures = failures + check(bin2x(at.sourcebytes()) = 'CEB10D0A00FF','exact source bytes including CRLF, NUL and opaque byte')
  parent = at.parent(1)
  failures = failures + check(at.kind() = 'derived' & parent.kind() = 'exact','derived provenance survives image')
  return failures

registration: procedure = .int
  failures = 0
  schema = .llir..schema(); first = schema.family('duplicate',1); second = schema.family('duplicate',1)
  contract = schema.finish()
  failures = failures + check(pos('duplicate family',contract.error()) > 0,'duplicate family registration')
  schema = .llir..schema(); first = schema.family('invalid name',1); contract = schema.finish()
  failures = failures + check(pos('invalid family',contract.error()) > 0,'invalid family registration')
  schema = .llir..schema(); first = schema.family('demo',1)
  one = first.type('integer',.llir..intcodec() as .object); two = first.type('integer',.llir..intcodec() as .object)
  contract = schema.finish()
  failures = failures + check(pos('duplicate type',contract.error()) > 0,'duplicate type registration')
  schema = .llir..schema(); first = schema.family('demo',1); op = first.operation('bad')
  call op.evaluator(.llir..intcodec() as .object); contract = schema.finish()
  failures = failures + check(pos('wrong interface',contract.error()) > 0,'wrong service interface')
  schema = .llir..schema(); first = schema.family('demo',1); one = first.type('integer',.llir..intcodec() as .object)
  foreign = .llir..schema(); family = foreign.family('other',1); two = family.type('integer',.llir..intcodec() as .object)
  op = first.operation('foreign'); call op.input('value',two); contract = schema.finish()
  failures = failures + check(pos('invalid operation field',contract.error()) > 0,'foreign type rejected')
  schema = .llir..schema(); first = schema.family('demo',1); one = first.type('integer',.llir..intcodec() as .object)
  op = first.operation('named'); call op.input('value',one); call op.input('value',one); contract = schema.finish()
  failures = failures + check(pos('duplicate operation field',contract.error()) > 0,'duplicate input rejected')
  schema = .llir..schema(); first = schema.family('demo',1); op = first.operation('frozen'); contract = schema.finish()
  saved = contract.manifest(); op = contract.operation('demo.frozen'); caught = 0
  do
    call op.state('none')
  on signal
    caught = 1
  end
  failures = failures + check(caught & contract.error() = '' & saved = contract.manifest(),'frozen schema remains usable')
  return failures


signatures: procedure = .int
  schema = .llir..schema(); family = schema.family('pair',1)
  integer = family.type('integer',.llir..intcodec() as .object)
  pair = family.operation('split'); call pair.input('value',integer)
  call pair.output('first',integer); call pair.output('second',integer)
  call pair.attribute('tag',integer)
  call pair.state('none'); call pair.failure('none'); call pair.termination('returns')
  contract = schema.finish(); draft = .llir..builder(contract); at = draft.synthetic('signature fixture')
  fn = draft.function('identity',integer); ordinal = fn.argument(integer); entry = fn.block('entry')
  argument = entry.readarg(ordinal,at); statement = entry.operation(pair,at)
  call statement.input('value',argument); codec = .llir..intcodec(); call statement.attribute('tag',codec.parse('42'))
  produced = .llir..opview
  produced = statement.finish(); result = produced.namedresult('second'); call entry.returnvalue(result,at)
  graph = draft.finish(); failures = check(graph.error() = '', 'typed argument, multiple results and return')
  if graph.error() <> '' then do
    say graph.error(); return failures
  end
  restored = llir..loadbinary(contract,graph.binary()); held = restored.operation(2)
  failures = failures + check(held.results() = 2 & codec.format(held.attribute('tag')) = '42','named attribute and result round trip')
  failures = failures + check(pos('tag="42"',graph.dump()) > 0,'named attributes in readable dump')
  cases = .string[]
  cases[1] = 'arguments 1 2 2 LL_IR_TYPE'
  cases[2] = 'attributes 1 4 999 LL_IR_ATTRIBUTE'
  cases[3] = 'operations 2 10 0 LL_IR_ATTRIBUTE'
  cases[4] = 'operations 3 5 0 LL_IR_SIGNATURE'
  do i = 1 to cases[0]
    item = cases[i]; damaged = corrupt(graph.text(),word(item,1),word(item,2) as .int,word(item,3) as .int,word(item,4))
    restored = llir..loadtext(contract,damaged)
    failures = failures + check(pos(word(item,5),restored.error()) > 0,'signature refusal ' || item)
  end
  return failures

/* Independent language-neutral invocation contract and wire compatibility. */
optionalarguments: procedure = .int
  mode = .int
  registry = .llir..schema(); family = registry.family('independent',1)
  integer = family.type('integer',.llir..intcodec() as .object); contract = registry.finish()
  draft = .llir..builder(contract); at = draft.synthetic('optional fixture')
  fn = draft.function('choose',integer); call fn.exportas('independent.choose')
  ordinal = fn.argument(integer,1); required = fn.argument(integer)
  entry = fn.block('entry'); fallback = entry.constant(integer,'7',at)
  present = entry.hasarg(ordinal,at); value = entry.readarg(ordinal,at,fallback)
  original = entry.readarg(required,at); call entry.returnvalue(value,at)
  graph = draft.finish(); failures = check(graph.error() = '','optional graph')
  if graph.error() <> '' then do
    say graph.error(); return failures
  end
  view = graph.function(1)
  failures = failures + check(view.name() = 'choose' & view.exportname() = 'independent.choose','function identity view')
  failures = failures + check(view.arguments() = 2 & view.optional(1) = 1 & view.optional(2) = 0,'per-position optional view')
  resulttype = view.resulttype(); argtype = view.argumenttype(1)
  failures = failures + check(resulttype.id() = integer.id() & argtype.id() = integer.id(),'function type views')
  restored = llir..loadbinary(contract,graph.binary())
  failures = failures + check(restored.error() = '' & restored.text() = graph.text(),'optional binary round trip')
  restored = llir..loadtext(contract,graph.text())
  failures = failures + check(restored.error() = '' & restored.text() = graph.text(),'optional text round trip')
  change = .llirservices..change; rewritten = .llir..module
  change = llirservices..optimise(reference graph); rewritten = change.result()
  failures = failures + check(rewritten.error() = '' & rewritten.functions() = 1,'optional optimisation')
  view = rewritten.function(1)
  failures = failures + check(view.exportname() = 'independent.choose' & view.optional(1) & view.optional(2) = 0,'rewrite preserves signature')
  failures = failures + check(pos('core.optionalargument',rewritten.dump()) > 0,'used optional read retained')
  cases = .string[]
  cases[1] = 'arguments 1 3 2 LL_IR_SIGNATURE'
  cases[2] = 'operations 2 12 3 LL_IR_SIGNATURE'
  cases[3] = 'operations 3 12 2 LL_IR_SIGNATURE'
  cases[4] = 'operations 4 12 1 LL_IR_SIGNATURE'
  cases[5] = 'values 2 3 3 LL_IR_TYPE'
  do i = 1 to cases[0]
    item = cases[i]
    restored = llir..loadtext(contract,corrupt(graph.text(),word(item,1),word(item,2) as .int,word(item,3) as .int,word(item,4)))
    failures = failures + check(pos(word(item,5),restored.error()) > 0,'optional malformed ' || item)
  end
  rejected = 0
  do
    view = graph.function(0)
  on signal
    rejected = 1
  end
  failures = failures + check(rejected,'unknown function view rejected')
  rejected = 0
  do
    view = graph.function(1); call view.exportas('replacement')
  on signal
    rejected = 1
  end
  failures = failures + check(rejected,'frozen export rejected')
  before = graph.binary()
  do mode = 1 to 3
    rejected = 0
    do
      view = graph.function(1); block = graph.block(1)
      if mode = 1 then ignored = view.argument(integer,2)
      if mode = 2 then value = block.readarg(999,at)
      if mode = 3 then present = block.hasarg(999,at)
    on signal
      rejected = 1
    end
    failures = failures + check(rejected & bin2x(graph.binary()) = bin2x(before),'frozen optional API atomic ' || mode)
  end
  stale = expiredfunction(contract,integer)
  failures = failures + check(stale.valid() = 0,'expired function view')
  exactdraft = .llir..builder(contract); exactat = exactdraft.synthetic('exact exports')
  do n = 1 to 2
    exactfn = exactdraft.function('export' || n,integer)
    spelling = '1'; if n = 2 then spelling = '01'
    call exactfn.exportas(spelling); exactblock = exactfn.block('entry')
    exactvalue = exactblock.constant(integer,'0',exactat); call exactblock.returnvalue(exactvalue,exactat)
  end
  exactgraph = exactdraft.finish()
  failures = failures + check(exactgraph.error() = '' & exactgraph.functions() = 2,'export identities use exact text equality')
  restored = llir..loadbinary(contract,graph.binary(),1)
  failures = failures + check(pos('LL_RESOURCE_LIMIT',restored.error()) > 0 & restored.text() = '','optional image entry budget')
  restored = llir..loadbinary(contract,graph.binary(),1000000,graph.bytes() - 1)
  failures = failures + check(pos('LL_RESOURCE_LIMIT',restored.error()) > 0 & restored.text() = '','optional image byte budget')
  otherdraft = .llir..builder(contract); otherat = otherdraft.synthetic('foreign')
  otherfn = otherdraft.function('foreign',integer); otherblock = otherfn.block('entry')
  foreign = otherblock.constant(integer,'9',otherat)
  do mode = 1 to 4
    draft = .llir..builder(contract); at = draft.synthetic('fallback refusal')
    fn = draft.function('f',integer); ordinal = fn.argument(integer,1)
    entry = fn.block('entry'); fallback = entry.constant(integer,'0',at)
    if mode = 1 then value = entry.readarg(1,at,foreign)
    if mode = 2 then do
      wrong = entry.constant(contract.type('core.boolean'),'1',at)
      value = entry.readarg(1,at,wrong)
    end
    if mode = 3 then do
      second = fn.block('second'); value = second.readarg(1,at,fallback)
      call second.returnvalue(value,at)
    end
    if mode = 4 then present = entry.hasarg(1,otherat)
    call entry.returnvalue(fallback,at); restored = draft.finish()
    failures = failures + check(restored.error() <> '' & restored.text() = '','fallback ownership/type ' || mode)
  end
  do mode = 1 to 5
    draft = .llir..builder(contract); at = draft.synthetic('refusal')
    fn = draft.function('f',integer); ordinal = fn.argument(integer,mode = 1)
    entry = fn.block('entry'); fallback = entry.constant(integer,'0',at)
    if mode = 1 then value = entry.readarg(1,at)
    if mode = 2 then value = entry.readarg(1,at,fallback)
    if mode = 3 then present = entry.hasarg(2,at)
    if mode = 4 then call fn.exportas('')
    if mode = 5 then do
      call fn.exportas('same'); call fn.exportas('same')
    end
    call entry.returnvalue(fallback,at); restored = draft.finish()
    failures = failures + check(restored.error() <> '' & restored.text() = '','builder contract refusal ' || mode)
  end
  /* Retained v1 encoding is independently constructed from a required-only graph. */
  draft = .llir..builder(contract); at = draft.synthetic('old image')
  fn = draft.function('legacy',integer); ordinal = fn.argument(integer)
  entry = fn.block('entry'); value = entry.readarg(1,at); call entry.returnvalue(value,at)
  oldgraph = draft.finish(); oldtext = legacytext(oldgraph.text())
  restored = llir..loadtext(contract,oldtext)
  failures = failures + check(restored.error() = '' & restored.text() = oldgraph.text(),'v1 required/private text accepted')
  oldimage = legacybinary(oldgraph.binary()); restored = llir..loadbinary(contract,oldimage)
  failures = failures + check(restored.error() = '' & restored.text() = oldgraph.text(),'v1 required/private binary accepted')
  restored = llir..loadtext(contract,corrupt(oldtext,'functions',1,6,'1'))
  failures = failures + check(pos('LL_IR_RESERVED',restored.error()) > 0,'v1 reserved field remains rejected')
  restored = llir..loadtext(contract,corrupt(oldtext,'operations',1,1,'8'))
  failures = failures + check(pos('LL_IR_OPCODE',restored.error()) > 0,'v1 cannot admit new opcodes')
  return failures

expiredfunction: procedure = .llir..function
  arg contract = .llir..contract, integer = .llir..typeid
  draft = .llir..builder(contract)
  return draft.function('expired',integer)

legacytext: procedure = .string
  arg text = .string
  reader = .llir..textreader(text); out = .llir..writer(100000)
  call out.line('LLIR-TEXT-1'); ignored = reader.line(); call out.line(reader.line())
  do t = 1 to 13
    header = reader.line(); count = word(header,2) as .int
    if t = 12 then header = word(header,1) || ' ' || count || ' 2'
    call out.line(header)
    do i = 1 to count
      row = reader.line()
      if t = 12 then row = subword(row,1,2)
      call out.line(row)
    end
  end
  do while reader.left() > 0
    call out.line(reader.line())
  end
  result = out.finish()
  return result.text()

legacybinary: procedure = .binary
  arg image = .binary
  at = 12 + <at..u32>(8) image; result = binsubstr(image,1,at)
  <at..u32>(4) result = 1
  do t = 1 to 13
    count = <at..u32>(at) image; width = <at..u32>(at + 4) image
    header = binsubstr(image,at + 1,8); at = at + 8
    if t = 12 then <at..u32>(4) header = 2
    result = result || header
    do i = 1 to count
      size = width * 4
      if t = 12 then size = 8
      result = result || binsubstr(image,at + 1,size); at = at + width * 4
    end
  end
  return result || binsubstr(image,at + 1)
