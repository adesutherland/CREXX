file(READ "${SOURCE}" text)
if(SEED)
  file(READ "${SEED_SOURCE}" reader)
  string(FIND "${text}" "/* BEGIN FRONTEND READER */" begin)
  string(FIND "${text}" "/* END FRONTEND READER */" end)
  if(begin LESS 0 OR end LESS begin)
    message(FATAL_ERROR "Missing Level L frontend reader boundaries")
  endif()
  string(SUBSTRING "${text}" 0 ${begin} common)
  string(REPLACE "import llsyntax\n" "" common "${common}")
  string(REPLACE "import llmunch\n" "" common "${common}")
  string(REPLACE "import llsource\n" "" common "${common}")
  string(REPLACE "import lllanguage\n" "" common "${common}")
  set(text "${common}\n${reader}")
endif()
file(WRITE "${OUTPUT}.tmp" "${text}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}"
  COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${OUTPUT}.tmp")
