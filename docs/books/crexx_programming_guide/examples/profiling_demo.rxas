/* Small, deterministic input for the VM profiling documentation. */

.globals=0

   .meta "profiling_demo.main"="b" ".int" main() ""
   .meta "profiling_demo.worker"="b" ".void" worker() ""

main() .locals=0
    call worker()
    call worker()
    ret 0

worker() .locals=5
    load r1, 0
    load r2, 5
loop:
    iadd r1, r1, 1
    copy r3, r1
    copy r4, r3
    ilt r0, r1, r2
    brt loop, r0
    ret
