/* rexx */
books = 'crexx_language_reference crexx_programming_guide crexx_vm_spec crexx_library_reference'
loop while books <> ''
  parse var books title books
  'cd /Users/rvjansen/apps/crexx-fork/docs/books/'title
  call build_pdf title
end

exit

build_pdf: procedure
arg title = .string
'mkdir -p tex/book'
'cd tex/book'
'pwd'
address cmd '/Users/rvjansen/apps/oorexx_release/bin/rexx /Users/rvjansen/apps/TextTools/build.rexx -copy'
return
