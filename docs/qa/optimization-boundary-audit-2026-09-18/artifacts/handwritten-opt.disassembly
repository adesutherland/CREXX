                itos r6                                      * 0x000048:00e5 Set register string value from its int value
                seq r9,r6,"41"                               * 0x00004a:0075 String Equals op1=(op2==op3)
                brf lb_73,r9                                 * 0x00004e:0026 Branch to op1 if op2 false
