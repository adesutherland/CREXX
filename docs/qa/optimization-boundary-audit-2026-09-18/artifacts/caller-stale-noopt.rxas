.globals=0

main() .locals=2
   .meta "main.main"="b" ".int" main() ""
   .srcstep 3 3 17 "main.crexx" 4 1 23 "main: procedure = .int"
   numsci 18,1,1
   .srcstep 1 1 17 "main.crexx" 5 3 13 "  say answer()"
   load r0,0
   call r1,auditlib.answer(),r0
   itos r1
   .traceevent "F" 4 "R" "S" "r" 1 1 1 0 "answer" ""
   say r1
   .srcstep 2 2 17 "main.crexx" 6 3 11 "  return 0"
   ret 0

