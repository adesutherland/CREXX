+/* Canonical numeric bit order, independent of host byte order. */
+static inline void rx_double_bit_literal(double number, char literal[19]) {
+    static const char hex[] = "0123456789abcdef";
+    uint64_t bits;
+    size_t i;
+    memcpy(&bits, &number, sizeof(bits));
+    literal[0] = '0'; literal[1] = 'f';
+    for (i = 0; i < 16; ++i)
+        literal[i + 2] = hex[(bits >> (60u - i * 4u)) & 15u];
+    literal[18] = 0;
+}
+static inline int rx_double_from_bit_literal(const char *text, size_t length, double *number) {
+    uint64_t bits = 0;
+    size_t i;
+    if (length != 18 || text[0] != '0' || (text[1] != 'f' && text[1] != 'F')) return 0;
+    for (i = 2; i < 18; ++i) {
+        unsigned int digit;
+        char c = text[i];
+        if (c >= '0' && c <= '9') digit = c - '0';
+        else if (c >= 'a' && c <= 'f') digit = c - 'a' + 10;
+        else if (c >= 'A' && c <= 'F') digit = c - 'A' + 10;
+        else return 0;
+        bits = (bits << 4u) | digit;
+    }
+    memcpy(number, &bits, sizeof(bits));
+    return 1;
+}
