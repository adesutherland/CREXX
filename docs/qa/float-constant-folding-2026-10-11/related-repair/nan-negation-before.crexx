options levelb numeric_common
main: procedure = .int
 arg argv = .string[]
 z = argv[1] as .float
 actual = -(z / z)
 folded = -(0.0 / 0.0)
 data = .binary
 data = '00000000000000000000000000000000'x as .binary
 <at..float>(0) data = actual
 <at..float>(8) data = folded
 a = <at..int>(0) data
 b = <at..int>(8) data
 say a = b
 return 0
