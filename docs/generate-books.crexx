/*
 * Detached book generation through the repository's cREXX TextTools port.
 * René's original buildbooks.rexx and buildbooks.crexx remain as authored.
 * Usage: generate-books check|prepare|build REPO OUTPUT [BOOK|all] [initial|original] [VERSION]
 * Build with the texttools module. See BUILDING-DOCS.md for the commands.
 */
options levelb
import rxfnsb
import texttools

arg args = .string[]
i = .int
book = .string
path = .string
tool = .string
if args[0] < 3 | args[0] > 6 then do
  say 'Usage: generate-books check|prepare|build REPO OUTPUT [BOOK|all] [initial|original] [VERSION]'
  return 2
end
mode = args[1]
if mode <> 'check' & mode <> 'prepare' & mode <> 'build' then return 2
repo = strip(translate(args[2], '/', '\'), 't', '/')
output = strip(translate(args[3], '/', '\'), 't', '/')
books = 'crexx_language_reference crexx_programming_guide crexx_vm_spec crexx_library_reference'
profile = 'initial'
if args[0] >= 4 then do
  if args[4] <> 'all' then do
    if wordpos(args[4], books) = 0 then do
      say 'Unknown book:' args[4]
      return 2
    end
    books = args[4]
  end
end
if args[0] >= 5 then profile = args[5]
if profile <> 'initial' & profile <> 'original' then do
  say 'Unknown font profile:' profile
  return 2
end
version = ''
if args[0] = 6 then do
  version = args[6]
  if valid_version(version) = 0 then do
    say 'Invalid VERSION: use 1-96 ASCII letters, digits, dot, plus, hyphen or underscore; begin with a letter or digit.'
    return 2
  end
end
if absolute_path(repo) = 0 | absolute_path(output) = 0 then do
  say 'Use non-root absolute paths without dot components for REPO and OUTPUT.'
  return 2
end
/* Resolve existing parent directories, including POSIX symlinks, before copying. */
repo = canonical_directory(repo)
if repo = '' then return 2
parent = left(output, lastpos('/', output)-1)
leaf = substr(output, lastpos('/', output)+1)
parent = canonical_directory(parent)
if parent = '' then do
  say 'OUTPUT must have an existing parent directory.'
  return 2
end
output = parent || '/' || leaf
if lower(output) = lower(repo) | left(lower(output), length(repo)+1) = lower(repo) || '/' then do
  say 'OUTPUT must be outside the source tree.'
  return 2
end
errors = .string[]
address crexx 'exists :output' error errors
if rc = 0 then do
  say 'OUTPUT already exists; choose a fresh directory:' output
  return 2
end
missing = 0
do i = 1 to words(books)
  book = word(books, i)
  path = repo || '/docs/books/' || book || '/structure.tex'
  call arraydrop errors
  address crexx 'exists :path' error errors
  if rc <> 0 then do
    say 'Missing book input:' path
    missing = missing + 1
  end
end
tools = 'pandoc'
if mode <> 'prepare' then tools = tools || ' xelatex makeindex biber xdvipdfmx bash crexx rxc rxas rxlink rxdas rxdb rxcpack rxvme stdbuf inkscape sed'
do i = 1 to words(tools)
  tool = word(tools, i)
  call arraydrop errors
  address crexx 'which :tool' error errors
  if rc <> 0 then do
    say 'Missing executable:' tool
    missing = missing + 1
  end
end
say 'Books:' books
say 'Output:' output
say 'Font profile:' profile
if version <> '' then say 'Publication version:' version
if missing > 0 then return 1
if mode = 'check' then do
  say 'Executables and book inputs found. Fonts/packages still need qualification.'
  return 0
end
/* Native copy dereferences guide symlinks and omits only old tex/book outputs. */
if texttools..copytree(repo || '/docs/books', output || '/docs/books', 1) <> 0 then return 1
if texttools..copytree(repo || '/docs/instructions', output || '/docs/instructions') <> 0 then return 1
if texttools..prepareinstructionchapter(output || '/docs/books/crexx_vm_spec/instruction_chapter.tex') <> 0 then return 1
if texttools..preparetypesetting(output || '/docs/books/boilerplate/preamble.tex',,
  repo || '/docs/texttools/splice-guard.tex',,
  repo || '/docs/texttools/glyph-fallback.tex', profile) <> 0 then return 1
if profile = 'initial' then do
  if texttools..applyfontprofile(output || '/docs/books/boilerplate', profile) <> 0 then return 1
  do i = 1 to words(books)
    book = word(books, i)
    if texttools..applyfontprofile(output || '/docs/books/' || book, profile) <> 0 then return 1
  end
end
if version <> '' then do
  if stamp_version(output, books, version) <> 0 then return 1
end
do i = 1 to words(books)
  book = word(books, i)
  source = output || '/docs/books/' || book
  work = source || '/tex/book'
  say 'Publication:' book
  if texttools..build(source, work, book, mode, profile) <> 0 then do
    say 'Build failed for' book 'Inspect the captured command log.'
    return 1
  end
  if mode = 'prepare' then say 'Prepared TeX:' work || '/' || book || '.tex'
  else say 'PDF produced; inspect layout and logs:' work || '/' || book || '.pdf'
end
return 0

absolute_path: procedure = .boolean
  arg path = .string
  if path = '' | path = '/' then return 0
  if left(path, 1) <> '/' & substr(path, 2, 2) <> ':/' then return 0
  if pos('/../', path || '/') > 0 | pos('/./', path || '/') > 0 then return 0
  return 1

canonical_directory: procedure = .string
  arg path = .string
  result = .string[]
  errors = .string[]
  address crexx 'cd :path' error errors
  if rc <> 0 then return ''
  address crexx 'pwd' output result
  if rc <> 0 then return ''
  return strip(translate(result[1], '/', '\'), 't', '/')

valid_version: procedure = .boolean
  arg version = .string
  allowed = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.+-_'
  leading = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'
  i = .int
  if length(version) < 1 | length(version) > 96 then return 0
  if pos(left(version, 1), leading) = 0 then return 0
  do i = 1 to length(version)
    if pos(substr(version, i, 1), allowed) = 0 then return 0
  end
  return 1

/* Printable TeX only receives validated ASCII; underscore is escaped and
 * discretionary breaks keep long development versions inside the cover. */
printable_version: procedure = .string
  arg version = .string
  result = ''
  unbroken = 0
  i = .int
  do i = 1 to length(version)
    ch = substr(version, i, 1)
    if ch = '_' then result = result || '\_'
    else result = result || ch
    if pos(ch, '.+-_') > 0 then do
      result = result || '\allowbreak{}'
      unbroken = 0
    end
    else do
      unbroken = unbroken + 1
      if unbroken = 20 then do
        result = result || '\allowbreak{}'
        unbroken = 0
      end
    end
  end
  return result

/* Stamp only detached inputs. The shared macro makes cover and publication
 * data print exactly the same explicit binary-workflow version. */
stamp_version: procedure = .int
  arg output = .string, books = .string, version = .string
  i = .int
  bytes = .binary
  path = output || '/docs/books/boilerplate/preamble.tex'
  original = readbinary(path) as .string
  if countstr('\usepackage{hyperref}', original) +,
    countstr('\usepackage[hidelinks]{hyperref}', original) <> 1 then do
    say 'Version stamp cannot locate staged preamble:' path
    return 1
  end
  updated = original || '0a'x ||,
    '\newcommand{\BookBuildVersion}{\texttt{' || printable_version(version) || '}}' || '0a'x
  bytes = updated as .binary
  if writebinary(path, bytes) <> binlength(bytes) then return 1
  path = output || '/docs/books/boilerplate/bookmeta.tex'
  original = readbinary(path) as .string
  if countstr('\splice{rxc -v}', original) <> 1 then do
    say 'Version stamp cannot locate staged publication data:' path
    return 1
  end
  updated = changestr('\splice{rxc -v}', original, '\BookBuildVersion')
  bytes = updated as .binary
  if writebinary(path, bytes) <> binlength(bytes) then return 1
  do i = 1 to words(books)
    book = word(books, i)
    path = output || '/docs/books/' || book || '/' || book || '.tex'
    original = readbinary(path) as .string
    anchor = '\date{\null\hfill \today}'
    if countstr(anchor, original) <> 1 then do
      say 'Version stamp cannot locate staged title date:' path
      return 1
    end
    updated = changestr(anchor, original,,
      '\date{\null\hfill \today\\[1ex]' ||,
      '\parbox[t]{0.9\textwidth}{\raggedright\small Build version: \BookBuildVersion}}')
    bytes = updated as .binary
    if writebinary(path, bytes) <> binlength(bytes) then return 1
  end
  return 0
