/*
 * TextTools: cREXX port of René Jansen's RexxLA/TextTools scripts.
 * Upstream: 0767adac303f80ade9af46b509f7ca33353c6065.
 * Original author: René Jansen. See README.md for provenance and port changes.
 */
options levelb
namespace texttools expose build builddocument copyassets erasefiles getMarkdownFilenames,
  includeasm includelisting joinLinesMD newer preprocessMD preprocessTEX,
  replaceHyperlink replaceSplice replacecites replaceindices replacemultiindices,
  writeSourceFile copytree applyfontprofile preparetypesetting prepareinstructionchapter
import rxfnsb
import bookhighlight

/* Absolute paths keep BIF file IO independent of ADDRESS's logical directory. */
build: procedure = .int
  arg source = .string, work = .string, title = .string, mode = 'build', profile = 'original'
  i = .int
  chapter = .string
  original = .string
  generated = .string
  texin = .string
  argv = .string[]
  chapters = getMarkdownFilenames(source)
  address crexx 'mkdir -p :work'
  if rc <> 0 then return rc
  address crexx 'cd :work'
  if rc <> 0 then return rc
  do i = 1 to chapters[0]
    chapter = chapters[i]
    original = source || '/' || chapter || '.md'
    generated = work || '/' || chapter || '.md'
    texin = work || '/' || chapter || '.texin'
    say 'Chapter:' chapter
    /* Always rebuild: source edits, tool versions and helper changes all matter. */
    if erasefiles(work, chapter) <> 0 then return 1
    if preprocessMD(original, generated, work, chapter) <> 0 then return 1
    call arraydrop argv
    argv[1] = 'pandoc'
    argv[2] = '-f'
    /* Book chapters use --- as prose separators, not YAML front matter. */
    argv[3] = 'markdown+latex_macros-yaml_metadata_block'
    argv[4] = '-t'
    argv[5] = 'latex'
    argv[6] = '--top-level-division=chapter'
    /* Marker helpers consume complete lines; do not split long listing tags. */
    argv[7] = '--wrap=none'
    /* Rare indented blocks are already literal examples; no Pandoc template
       defines Highlighting macros, and fenced blocks use our own routes. */
    argv[8] = '--syntax-highlighting=none'
    argv[9] = generated
    argv[10] = '-o'
    argv[11] = texin
    if run_tool(argv) <> 0 then return 1
    linkmap = ''
    if title = 'crexx_language_reference' & chapter = 'rxpp' then linkmap = source || '/rxpp-book-links.tsv'
    if preprocessTEX(texin, work || '/' || chapter || '.tex', linkmap) <> 0 then return 1
    if applyfontprofile(work || '/' || chapter || '.tex', profile) <> 0 then return 1
  end
  if copyassets(source, work) <> 0 then return 1
  if mode = 'prepare' then return 0
  return builddocument(work, title)

getMarkdownFilenames: procedure = .string[]
  arg source = .string
  names = .string[]
  chapters = .string[]
  i = .int
  filename = .string
  path = .string
  address crexx 'ls :source' output names
  if rc <> 0 then do
    call raise 'NOTREADY', 'Cannot list Markdown source', source
    return chapters
  end
  do i = 1 to names[0]
    filename = names[i]
    if right(filename, 3) <> '.md' then iterate
    path = source || '/' || filename
    if file_kind(path) = 'file' then call arrayappend chapters, left(filename, length(filename)-3)
  end
  call arraysort chapters
  return chapters

/* Retained for callers; the build deliberately regenerates every chapter. */
newer: procedure = .boolean
  arg original = .string, generated = .string
  if file_kind(original) <> 'file' then do
    call raise 'NOTREADY', 'Missing original file', original
    return 0
  end
  if file_kind(generated) <> 'file' then return 1
  return modified(original) > modified(generated)

erasefiles: procedure = .int
  arg work = .string, chapter = .string
  i = .int
  path = .string
  do i = 1 to 3
    path = work || '/' || chapter || word('.md .texin .tex', i)
    if file_kind(path) = 'file' then do
      address crexx 'rm :path'
      if rc <> 0 then return rc
    end
  end
  return 0

preprocessMD: procedure = .int
  arg source = .string, output = .string, work = .string, chapter = .string
  input = readlines(source)
  result = '<!--preprocessed md-->' || '0a'x
  i = .int
  fence_end = .int
  serial = 0
  line = .string
  language = .string
  filename = .string
  listing = .string
  program = .string
  fence = .string
  count = .int
  do i = 1 to input[0]
    line = input[i]
    line = changestr('<!--index-->', line, '%index%')
    line = changestr('<!--index:', line, '%indexm%')
    line = changestr('<!--cite-->', line, '%cite%')
    if left(line, 3) = '```' then do
      count = 3
      do while substr(line, count+1, 1) = '`'
        count = count + 1
      end
      fence = left(line, count)
      language = strip(substr(line, count+1))
      filename = ''
      if pos('<!--', language) > 0 then do
        parse var language language '<!--' filename '-->' .
        language = strip(language)
        filename = strip(filename)
      end
      if language = '' then language = 'bash'
      serial = serial + 1
      listing = chapter || '-code-' || serial || '.txt'
      if filename = '' then filename = listing
      if filename = '.' | filename = '..' | pos('/', filename) > 0 | pos('\', filename) > 0 then do
        say 'Invalid source-listing filename:' filename 'in' source
        return 1
      end
      fence_end = i + 1
      do while fence_end <= input[0]
        if strip(input[fence_end]) = fence then leave
        fence_end = fence_end + 1
      end
      if fence_end > input[0] then do
        say 'Unclosed source fence at line' i 'in' source
        return 1
      end
      if writeSourceFile(input, i+1, fence_end-1, work || '/' || filename) <> 0 then return 1
      /* A requested executable name may be reused by another example. Keep a
       * separate immutable render snapshot so every printed snippet survives. */
      if filename <> listing then do
        if writeSourceFile(input, i+1, fence_end-1, work || '/' || listing) <> 0 then return 1
      end
      /* Colour printed fragments from their exact render snapshots. The
       * executable name is used only by an explicit authored splice. */
      if lower(language) = 'rexx' | lower(language) = 'crexx' then do
        if write_text(work || '/' || listing || '.highlight.tex',,
          bookhighlight..render(readbinary(work || '/' || listing) as .string)) <> 0 then return 1
      end
      line = '%includesource=' || filename || ':' || language || ':' || listing || '%'
      i = fence_end
      /* Keep a listing in its own Pandoc paragraph, preserving surrounding prose. */
      result = result || '0a'x || line || '0a'x || '0a'x
      iterate
    end
    if left(line, 10) = '<!--splice' then do
      parse var line '<!--splice--' program '-->' .
      /* Keep shell commands literal: Pandoc must not escape >, _, quotes, etc.
       * Raw blocks also prevent adjacent commands merging into one paragraph. */
      result = result || '0a'x || '```{=latex}' || '0a'x ||,
        replaceSplice('\%splice\%' || strip(program)) || '0a'x || '```' || '0a'x || '0a'x
      iterate
    end
    if left(line, 11) = '<!--listasm' then do
      parse var line '<!--listasm--' program '-->' .
      line = '%listasm%' || strip(program)
    end
    result = result || line || '0a'x
  end
  return write_text(output, result)

writeSourceFile: procedure = .int
  arg input = .string[], first = .int, last = .int, output = .string
  i = .int
  result = ''
  do i = first to last
    result = result || input[i] || '0a'x
  end
  return write_text(output, result)

joinLinesMD: procedure = .int
  arg source = .string, output = .string
  input = readlines(source)
  i = .int
  result = '<!--joined lines md-->' || '0a'x
  pending = ''
  do i = 1 to input[0]
    if strip(input[i]) = '' then do
      if pending <> '' then result = result || pending || '0a'x
      result = result || '0a'x
      pending = ''
    end
    else if pending = '' then pending = input[i]
    else pending = pending || ' ' || input[i]
  end
  if pending <> '' then result = result || pending || '0a'x
  return write_text(output, result)

preprocessTEX: procedure = .int
  arg source = .string, output = .string, linkmap = ''
  input = readlines(source)
  i = .int
  j = .int
  line = .string
  mapping = .string[]
  oldlabel = .string
  newlabel = .string
  targetlabel = .string
  labelstart = .int
  labelend = .int
  scanfrom = .int
  raw_tex = .string
  terminal_begin_count = .int
  terminal_end_count = .int
  rxcpack_help_count = .int
  if right(source, length('/rxcpack.texin')) = '/rxcpack.texin' then do
    terminal_begin_count = 0
    terminal_end_count = 0
    rxcpack_help_count = 0
    do j = 1 to input[0]
      if input[j] = '\begin{terminaloutput}' then terminal_begin_count = terminal_begin_count + 1
      if input[j] = '\end{terminaloutput}' then terminal_end_count = terminal_end_count + 1
      if input[j] = "\obeylines \splice{rxcpack -h | sed 's/\&/\\\&/g'}" then
        rxcpack_help_count = rxcpack_help_count + 1
    end
    if terminal_begin_count <> 1 | terminal_end_count <> 1 |,
      rxcpack_help_count <> 1 then do
      say 'Unexpected rxcpack help splice context; inspect:' source
      return 1
    end
  end
  if linkmap <> '' then do
    if file_kind(linkmap) <> 'file' then do
      say 'Missing book link map:' linkmap
      return 1
    end
    mapping = readlines(linkmap)
    raw_tex = readbinary(source) as .string
    if pos('rxpp-book-links.tsv', linkmap) > 0 then do
      if countstr('\section{RXPP + CREXX Build System Documentation}\label{rxpp-crexx-build-system-documentation}', raw_tex) <> 1 |,
        countstr('\chapter{Table of Contents}\label{table-of-contents}', raw_tex) <> 1 then do
        say 'RXPP generated chapter/contents headings changed; inspect:' source
        return 1
      end
    end
    do j = 1 to mapping[0]
      if left(mapping[j], 1) = '#' then iterate
      oldlabel = word(mapping[j], 1)
      newlabel = word(mapping[j], 2)
      if oldlabel = '' | newlabel = '' |,
        pos('\hyperref[' || oldlabel || ']', raw_tex) = 0 |,
        pos('\label{' || newlabel || '}', raw_tex) = 0 then do
        say 'Book link map/source labels disagree:' mapping[j]
        return 1
      end
    end
  end
  result = '%preprocessed texin' || '0a'x
  do i = 1 to input[0]
    line = changestr('\{\#tbl:id\}', input[i], '')
    /* Keep GitHub Markdown headings intact. The book input sits among full
       chapters, so lift RXPP's first heading and subordinate its local TOC. */
    if pos('rxpp-book-links.tsv', linkmap) > 0 then do
      line = changestr('\section{RXPP + CREXX Build System Documentation}\label{rxpp-crexx-build-system-documentation}', line,,
        '\chapter{RXPP + CREXX Build System Documentation}\label{rxpp-crexx-build-system-documentation}')
      line = changestr('\chapter{Table of Contents}\label{table-of-contents}', line,,
        '\section{Table of Contents}\label{table-of-contents}')
    end
    /* Scope Pandoc's RXPP labels before generated listing labels are added.
       Other chapters use generic headings such as "example" too. */
    if linkmap <> '' then do
      scanfrom = 1
      do while pos('\label{', line, scanfrom) > 0
        labelstart = pos('\label{', line, scanfrom) + 7
        labelend = pos('}', line, labelstart)
        if labelend = 0 then do
          say 'Malformed RXPP label:' line
          return 1
        end
        targetlabel = substr(line, labelstart, labelend - labelstart)
        line = changestr('\label{' || targetlabel || '}', line,,
          '\label{rxpp-book-' || targetlabel || '}')
        scanfrom = labelend + 10
      end
    end
    if pos('\%index\%', line) > 0 then line = replaceindices(line)
    if pos('\%indexm\%', line) > 0 then line = replacemultiindices(line)
    if pos('\%cite\%', line) > 0 then line = replacecites(line)
    if pos('\hyperlink{', line) > 0 then line = replaceHyperlink(line)
    if pos('\%includesource=', line) > 0 then line = includelisting(line)
    if pos('\%listasm\%', line) > 0 then line = includeasm(line)
    if pos('\%splice\%', line) > 0 then line = replaceSplice(line)
    if right(source, length('/rxcpack.texin')) = '/rxcpack.texin' then do
      /* Its sed escaped ampersands for TeX expansion. Literal Verbatim stdout
         needs the original rxcpack help bytes, lines and wrap behavior. */
      if line = '\begin{terminaloutput}' then line = '\begin{bookterminaloutput}'
      if line = '\end{terminaloutput}' then line = '\end{bookterminaloutput}'
      if line = "\obeylines \splice{rxcpack -h | sed 's/\&/\\\&/g'}" then
        line = '\spliceliteral{rxcpack -h}'
    end
    if pos('\hyperref[', line) > 0 & linkmap <> '' then do
      do j = 1 to mapping[0]
        if left(mapping[j], 1) = '#' then iterate
        oldlabel = word(mapping[j], 1)
        newlabel = word(mapping[j], 2)
        if oldlabel = '' | newlabel = '' then do
          say 'Invalid book link map entry:' mapping[j]
          return 1
        end
        line = changestr('\hyperref[' || oldlabel || ']', line,,
          '\hyperref[' || newlabel || ']')
      end
      scanfrom = 1
      do while pos('\hyperref[', line, scanfrom) > 0
        labelstart = pos('\hyperref[', line, scanfrom) + 10
        labelend = pos(']', line, labelstart)
        if labelend = 0 then do
          say 'Malformed RXPP local reference:' line
          return 1
        end
        targetlabel = substr(line, labelstart, labelend - labelstart)
        if pos('\label{' || targetlabel || '}', raw_tex) = 0 then do
          say 'Unresolved RXPP local reference:' targetlabel
          return 1
        end
        line = changestr('\hyperref[' || targetlabel || ']', line,,
          '\hyperref[rxpp-book-' || targetlabel || ']')
        scanfrom = labelend + 13
      end
    end
    /* Permit long authored table signatures to wrap without changing ink. */
    if pos('SETSTRINGLENGTH(host,value,data,byte\_length) &', line) > 0 then
      line = changestr('SETSTRINGLENGTH(host,value,data,byte\_length)', line,,
        'SETSTRING\allowbreak{}LENGTH\allowbreak{}(host,\allowbreak{}value,\allowbreak{}data,\allowbreak{}byte\_length)')
    if pos(' & \texttt{chan', line) > 0 then do
      parse var line tableleft ' & ' tableform ' & ' tableright
      tableform = changestr(',', tableform, ',\allowbreak{}')
      line = tableleft || ' & ' || tableform || ' & ' || tableright
    end
    /* Two long Appendix A terms need legal breaks at their visible separators. */
    if pos('reserve/set/append/concat/slice', line) > 0 then
      line = changestr('reserve/set/append/concat/slice', line,,
        'reserve/\allowbreak{}set/\allowbreak{}append/\allowbreak{}concat/\allowbreak{}slice')
    if pos('BSLICE\ destination,source,start,length', line) > 0 then
      line = changestr('BSLICE\ destination,source,start,length', line,,
        'BSLICE\ destination,\allowbreak{}source,\allowbreak{}start,\allowbreak{}length')
    if pos('BINBYTE/BINSUBSTR/BINOVERLAY', line) > 0 then
      line = changestr('BINBYTE/BINSUBSTR/BINOVERLAY', line,,
        'BINBYTE/\allowbreak{}BINSUBSTR/\allowbreak{}BINOVERLAY')
    if pos('\texttt{BINBYTE}/\texttt{BINSUBSTR}/\texttt{BINOVERLAY}', line) > 0 then
      line = changestr('\texttt{BINBYTE}/\texttt{BINSUBSTR}/\texttt{BINOVERLAY}', line,,
        '\texttt{BINBYTE}/\allowbreak{}\texttt{BINSUBSTR}/\allowbreak{}\texttt{BINOVERLAY}')
    /* This linked path is longer than the library text column. \nolinkurl
       preserves its visible characters while permitting path breaks. */
    if pos('\texttt{docs/planning/beta-3/notes/binary-fastpath-research.md}', line) > 0 then
      line = changestr('\texttt{docs/planning/beta-3/notes/binary-fastpath-research.md}', line,,
        '\nolinkurl{docs/planning/beta-3/notes/binary-fastpath-research.md}')
    if pos('\texttt{performance/UNICODE-CERT-01-WORKLIST.md}', line) > 0 then
      line = changestr('\texttt{performance/UNICODE-CERT-01-WORKLIST.md}', line,,
        '\texttt{performance/\allowbreak{}UNICODE-\allowbreak{}CERT-\allowbreak{}01-\allowbreak{}WORKLIST.md}')
    if pos('.rxunicode..graphemes(text)', line) > 0 then
      line = changestr('.rxunicode..graphemes(text)', line,,
        '.rxunicode..\allowbreak{}graphemes(text)')
    if pos('name,type,size,decimals,nullable', line) > 0 then
      line = changestr('name,type,size,decimals,nullable', line,,
        'name,\allowbreak{}type,\allowbreak{}size,\allowbreak{}decimals,\allowbreak{}nullable')
    if pos('socketnodelay(sock,\ enabled)', line) > 0 then
      line = changestr('socketnodelay(sock,\ enabled)', line,,
        'socket\allowbreak{}nodelay(sock,\allowbreak{}\ enabled)')
    if pos('configuration/runtime/model/session/request', line) > 0 then
      line = changestr('configuration/runtime/model/session/request', line,,
        'configuration/\allowbreak{}runtime/\allowbreak{}model/\allowbreak{}session/\allowbreak{}request')
    if pos('\includegraphics[scale=0.8]{charts/buildflow.pdf}', line) > 0 then
      line = changestr('\includegraphics[scale=0.8]{charts/buildflow.pdf}', line,,
        '\includegraphics[scale=0.65]{charts/buildflow.pdf}')
    /* Keep long programming-guide identifiers and paths within the page. */
    if pos('rxsig1\textbar{}pkg.main\textbar{}.int\textbar{}path=.string', line) > 0 then
      line = changestr('rxsig1\textbar{}pkg.main\textbar{}.int\textbar{}path=.string', line,,
        'rxsig1\textbar{}\allowbreak{}pkg.main\textbar{}\allowbreak{}.int\textbar{}\allowbreak{}path=.string')
    if pos('\%USERPROFILE\%\textbackslash{}AppData\textbackslash{}Local', line) > 0 then
      line = changestr('\%USERPROFILE\%\textbackslash{}AppData\textbackslash{}Local', line,,
        '\%USERPROFILE\%\textbackslash{}\allowbreak{}AppData\textbackslash{}\allowbreak{}Local')
    if pos('\textless{}stem\textgreater{}.crexx-driver.lock', line) > 0 then
      line = changestr('\textless{}stem\textgreater{}.crexx-driver.lock', line,,
        '\textless{}stem\textgreater{}\allowbreak{}.crexx-\allowbreak{}driver.lock')
    if pos('binutils/include/rxopeffects.h', line) > 0 then
      line = changestr('binutils/include/rxopeffects.h', line,,
        'binutils/\allowbreak{}include/\allowbreak{}rxopeffects.h')
    if pos('binutils/include/rxops.h', line) > 0 then
      line = changestr('binutils/include/rxops.h', line,,
        'binutils/\allowbreak{}include/\allowbreak{}rxops.h')
    if pos('binutils/include/rxopsignals.h', line) > 0 then
      line = changestr('binutils/include/rxopsignals.h', line,,
        'binutils/\allowbreak{}include/\allowbreak{}rxopsignals.h')
    if pos('docs/reference/rxas/instructions/12-large-instructions.md', line) > 0 then
      line = changestr('docs/reference/rxas/instructions/12-large-instructions.md', line,,
        'docs/\allowbreak{}reference/\allowbreak{}rxas/\allowbreak{}instructions/\allowbreak{}12-large-\allowbreak{}instructions.md')
    if pos('\texttt{ctest\ -\/-test-dir\ ', line) > 0 then
      line = changestr('\texttt{ctest\ -\/-test-dir\ ', line,,
        '\texttt{ctest\ -\/-test-dir\ \allowbreak{}')
    if pos('\ -L\ linked\_opt\ -\/-label-exclude\ ', line) > 0 then
      line = changestr('\ -L\ linked\_opt\ -\/-label-exclude\ ', line,,
        '\ \allowbreak{}-L\ linked\_opt\ \allowbreak{}-\/-label-exclude\ \allowbreak{}')
    if pos('\ -\/-output-on-failure}', line) > 0 then
      line = changestr('\ -\/-output-on-failure}', line,,
        '\ \allowbreak{}-\/-output-on-failure}')
    if pos('\^{}performance-measurement\$', line) > 0 then
      line = changestr('\^{}performance-measurement\$', line,,
        '\^{}performance-\allowbreak{}measurement\$')
    if pos('\%ntsplice\%', line) > 0 then do
      say 'Unsupported ntsplice tag: upstream helper is absent. File:' source
      return 1
    end
    line = replace_word(line, 'Rexx', '\rexx{}')
    line = replace_word(line, 'Rexx-', '\rexx{}-')
    line = replace_word(line, 'cRexx', '\crexx{}')
    line = replace_word(line, 'cRexx-', '\crexx{}-')
    line = replace_word(line, 'cREXX', '\crexx{}')
    line = replace_word(line, 'cREXX-', '\crexx{}-')
    result = result || line || '0a'x
  end
  return write_text(output, result)

replaceindices: procedure = .string
  arg line = .string
  outline = ''
  start = .string
  rest = .string
  ixword = .string
  do until line = ''
    parse var line start '\%index\%' rest
    ixword = word(rest, 1)
    if ixword = '' then do
      outline = outline || start
      leave
    end
    outline = outline || start || ixword || '\index{' || ixword || '} '
    line = subword(rest, 2)
  end
  return close_footnote(outline)

replacemultiindices: procedure = .string
  arg line = .string
  outline = ''
  start = .string
  rest = .string
  ixwords = .string
  do until line = ''
    parse var line start '\%indexm\%' rest
    parse var rest ixwords '--\textgreater' rest
    if ixwords = '' then do
      outline = outline || start
      leave
    end
    outline = outline || start || '\index{' || ixwords || '} '
    line = rest
  end
  return outline

replacecites: procedure = .string
  arg line = .string
  outline = ''
  start = .string
  rest = .string
  ixword = .string
  lpos = .int
  do until line = ''
    parse var line start '\%cite\%' rest '.'
    parse var rest '{[}' ixword '{]}'
    ixword = strip(translate(ixword, '', '[]{}'))
    if ixword = '' then do
      outline = outline || start
      leave
    end
    outline = outline || start || '\cite{' || ixword || '} '
    lpos = lastpos('}', rest)
    line = substr(rest, lpos+1)
  end
  return close_footnote(outline)

replaceHyperlink: procedure = .string
  arg line = .string
  start = .string
  link = .string
  text = .string
  rest = .string
  parse var line start '\hyperlink{' link '}{' text '}' rest
  return start || '\hyperlink{' || link || '}{' || text || '} on page \pageref{' || link || '}' || rest

replaceSplice: procedure = .string
  arg line = .string
  program = .string
  parse var line . '\%splice\%' program
  return '\begin{bookterminaloutput} \fontspec{IBM Plex Mono}[Scale=0.7] \parskip=0pt \parindent=0pt \spliceliteral{stdbuf -o0 ' || program || '} \end{bookterminaloutput}'

includelisting: procedure = .string
  arg line = .string
  filename = .string
  language = .string
  payload = .string
  listing = .string
  parse var line . 'includesource=' payload '\%' .
  parse var payload filename ':' language ':' listing
  /* Accept the original two-field marker as well as the render snapshot. */
  if listing = '' then listing = filename
  if lower(language) = 'rexx' | lower(language) = 'crexx' then do
    return '\begingroup\captionof{lstlisting}{' || filename || '}\label{' || decode_filename(filename) || '}\endgroup' || '0a'x ||,
      '\input{' || decode_filename(listing) || '.highlight.tex}'
  end
  if lower(language) = 'text' then do
    return '\begingroup\captionof{lstlisting}{' || filename || '}\label{' || decode_filename(filename) || '}\endgroup' || '0a'x ||,
      '\VerbatimInput[breaklines=true,breakanywhere=true,breaksymbolleft={},breaksymbolright={},breakanywheresymbolpre={},breakanywheresymbolpost={},tabsize=8]{\detokenize{' || decode_filename(listing) || '}}'
  end
  /* listings calls the supported Windows batch dialect command.com. */
  if lower(language) = 'bat' then language = '{[WinXP]command.com}'
  return '\lstinputlisting[language=' || language || ',label=' || decode_filename(filename) || ',caption=' || filename || ']{\detokenize{' || decode_filename(listing) || '}}'

includeasm: procedure = .string
  arg line = .string
  filename = .string
  parse var line . '\%listasm\%' filename
  return '\lstinputlisting[language=rxas,label=' || filename || ',caption=' || filename || ']{\detokenize{' || decode_filename(filename) || '}}'

/* Pandoc escapes punctuation as TeX text; listing paths require literal bytes. */
decode_filename: procedure = .string
  arg filename = .string
  filename = changestr('\_', filename, '_')
  filename = changestr('\%', filename, '%')
  filename = changestr('\#', filename, '#')
  return filename

copyassets: procedure = .int
  arg source = .string, work = .string
  names = .string[]
  i = .int
  filename = .string
  original = .string
  target = .string
  base = .string
  address crexx 'ls :source' output names
  if rc <> 0 then return rc
  do i = 1 to names[0]
    filename = names[i]
    original = source || '/' || filename
    target = work || '/' || filename
    if file_kind(original) <> 'file' | right(filename, 3) = '.md' then iterate
    /* Do not overwrite transformed chapters with stale root-level .tex files. */
    if right(filename, 4) = '.tex' then do
      base = source || '/' || left(filename, length(filename)-4) || '.md'
      if file_kind(base) = 'file' then iterate
    end
    address crexx 'copy :original :target'
    if rc <> 0 then return rc
  end
  do i = 1 to 5
    filename = word('charts images svg examples operation', i)
    original = source || '/' || filename
    if file_kind(original) = 'directory' then do
      if copytree(original, work || '/' || filename) <> 0 then return 1
    end
  end
  return 0

/* Native enumeration/copy also dereferences the book's source-guide symlinks. */
copytree: procedure = .int
  arg source = .string, target = .string, exclude_work = 0
  names = .string[]
  i = .int
  original = .string
  destination = .string
  kind = .string
  address crexx 'mkdir -p :target'
  if rc <> 0 then return rc
  address crexx 'ls :source' output names
  if rc <> 0 then return rc
  do i = 1 to names[0]
    /* tex/book is disposable, not an input; do not stage old PDFs or logs. */
    if exclude_work & names[i] = 'book' & right(source, 4) = '/tex' then iterate
    original = source || '/' || names[i]
    destination = target || '/' || names[i]
    kind = file_kind(original)
    if kind = 'directory' then do
      if copytree(original, destination, exclude_work) <> 0 then return 1
    end
    else if kind = 'file' then do
      address crexx 'copy :original :destination'
      if rc <> 0 then return rc
    end
    else do
      say 'Unsupported or unreadable input:' original
      return 1
    end
  end
  return 0

/* The lexical listing renderer uses fvextra in both font profiles. Only the
 * staged preamble is edited; René's source preamble remains byte-for-byte. */
/* Generated VM instruction examples print executable stdout literally. Keep
   compiler/assembler splices and the authored source chapter unchanged. */
prepareinstructionchapter: procedure = .int
  arg path = .string
  lines = .string[]
  i = .int
  if file_kind(path) <> 'file' then do
    say 'Missing staged VM instruction chapter:' path
    return 1
  end
  lines = readlines(path)
  do i = 1 to lines[0]
    if pos('\splice{rxvme', lines[i]) > 0 &,
      (pos('\begin{terminaloutput}', lines[i]) = 0 | pos('\obeylines', lines[i]) = 0) then do
      say 'Unexpected VM terminal splice context:' path 'line' i
      return 1
    end
  end
  original = readbinary(path) as .string
  if countstr('\splice{rxvme', original) = 0 then do
    say 'No VM terminal splices found in:' path
    return 1
  end
  updated = changestr('\splice{rxvme', original, '\spliceliteral{rxvme')
  if countstr('\begin{terminaloutput}', updated) <> countstr('\spliceliteral{rxvme', updated) |,
    countstr('\end{terminaloutput}', updated) <> countstr('\spliceliteral{rxvme', updated) then do
    say 'VM terminal containers differ from runtime splices:' path
    return 1
  end
  updated = changestr('\begin{terminaloutput}', updated, '\begin{bookterminaloutput}')
  updated = changestr('\end{terminaloutput}', updated, '\end{bookterminaloutput}')
  /* The CNOP diagram is wider than the printed description column. */
  if countstr('\includesvg{../../svg/cnop.gv}', updated) <> 1 then do
    say 'Expected one CNOP diagram in:' path
    return 1
  end
  updated = changestr('\includesvg{../../svg/cnop.gv}', updated,,
    '\includesvg[width=\linewidth]{../../svg/cnop.gv}')
  return write_text(path, updated)

preparetypesetting: procedure = .int
  arg preamble = .string, guard_source = .string, fallback_source = .string, profile = .string
  guard_target = left(preamble, lastpos('/', preamble)) || 'splice-guard.tex'
  fallback_target = left(preamble, lastpos('/', preamble)) || 'glyph-fallback.tex'
  cmake_source = left(guard_source, lastpos('/', guard_source)) || 'listings-cmake-compat.tex'
  cmake_target = left(preamble, lastpos('/', preamble)) || 'listings-cmake-compat.tex'
  if file_kind(preamble) <> 'file' then do
    say 'Missing staged preamble:' preamble
    return 1
  end
  if file_kind(guard_source) <> 'file' then do
    say 'Missing splice guard:' guard_source
    return 1
  end
  address crexx 'copy :guard_source :guard_target'
  if rc <> 0 then return rc
  if file_kind(cmake_source) <> 'file' then do
    say 'Missing CMake listings compatibility definition:' cmake_source
    return 1
  end
  address crexx 'copy :cmake_source :cmake_target'
  if rc <> 0 then return rc
  if profile = 'initial' then do
    if file_kind(fallback_source) <> 'file' then do
      say 'Missing font fallback:' fallback_source
      return 1
    end
    address crexx 'copy :fallback_source :fallback_target'
    if rc <> 0 then return rc
  end
  else if profile <> 'original' then return 1
  original = readbinary(preamble) as .string
  /* setspace replaces the footnote text macro, and longtable delays table
     footnotes. Hyperref must load after both to install their PDF anchors. */
  hyperref = '5c'x || 'usepackage{hyperref}'
  setspace = '5c'x || 'usepackage{setspace}'
  longtable = '5c'x || 'usepackage{longtable}'
  if countstr(hyperref, original) <> 1 | countstr(setspace, original) <> 1 |,
    countstr(longtable, original) < 1 then do
    say 'Expected hyperref, setspace and longtable package declarations in:' preamble
    return 1
  end
  first = pos(longtable, original)
  updated = left(original, first-1) || substr(original, first+length(longtable))
  updated = changestr(setspace, updated, '')
  updated = changestr(hyperref, updated,,
    setspace || '0a'x || longtable || '0a'x || hyperref)
  anchor = '5c'x || 'usepackage{fancyvrb}'
  if countstr(anchor, updated) <> 1 then do
    say 'Expected one fancyvrb package declaration in:' preamble
    return 1
  end
  updated = changestr(anchor, updated, anchor || '0a'x || '5c'x || 'usepackage{fvextra}')
  /* listings inserts a display-only \lst@nolig token into indexed keywords.
     Empty it only while writing index entries, so makeindex sees plain text. */
  anchor = '5c'x || 'usepackage{listings}'
  if countstr(anchor, updated) <> 1 then do
    say 'Expected one listings package declaration in:' preamble
    return 1
  end
  updated = changestr(anchor, updated, anchor || '0a'x ||,
    '5c'x || 'makeatletter' || '0a'x ||,
    '5c'x || 'newcommand' || '5c'x || 'BookIndex[1]{' ||,
      '5c'x || 'begingroup' || '5c'x || 'let' || '5c'x || 'lst@nolig' || '5c'x || '@empty' ||,
      '5c'x || 'index{{' || '5c'x || 'ttfamily#1}}' || '5c'x || 'endgroup}' || '0a'x ||,
    '5c'x || 'makeatother' || '0a'x ||,
    '5c'x || 'lstset{indexstyle=' || '5c'x || 'BookIndex}')
  /* Query the installed listings driver without requesting a failing CMake
     load. Its registered definition wins; only older catalogs use our copy. */
  anchor = '5c'x || 'lstset{indexstyle=' || '5c'x || 'BookIndex}'
  updated = changestr(anchor, updated, anchor || '0a'x ||,
    '5c'x || 'makeatletter' || '0a'x ||,
    '5c'x || '@ifundefined{lstlang@cmake$}{' || '0a'x ||,
    '5c'x || 'begingroup' || '0a'x ||,
    '5c'x || 'def' || '5c'x || 'lst@require{cmake$,}' || '0a'x ||,
    '5c'x || 'def' || '5c'x || 'lst@prefix{lang}' || '0a'x ||,
    '5c'x || 'InputIfFileExists{lstlang2.sty}{}{}' || '0a'x ||,
    '5c'x || 'endgroup' || '0a'x ||,
    '5c'x || '@ifundefined{lstlang@cmake$}{' ||,
      '5c'x || 'input{../../../boilerplate/listings-cmake-compat}}{}' || '0a'x ||,
    '}{}' || '0a'x ||,
    '5c'x || 'makeatother')
  if profile = 'initial' then do
    anchor = '5c'x || 'usepackage{fontspec}'
    if countstr(anchor, updated) <> 1 then do
      say 'Expected one fontspec package declaration in:' preamble
      return 1
    end
    updated = changestr(anchor, updated,,
      anchor || '0a'x || '5c'x || 'input{../../../boilerplate/glyph-fallback}')
  end
  else do
    updated = updated || '0a'x || '5c'x || 'newcommand' || '5c'x ||,
      'BookHighlightGlyph[1]{#1}' || '0a'x || '5c'x || 'newcommand' || '5c'x ||,
      'BookHighlightGlyphUpper[1]{#1}' || '0a'x || '5c'x || 'newcommand' || '5c'x ||,
      'BookHighlightInvisible[1]{}' || '0a'x
  end
  anchor = '5c'x || 'usepackage{bashful}'
  if countstr(anchor, updated) <> 1 then do
    say 'Expected one bashful package declaration in:' preamble
    return 1
  end
  updated = changestr(anchor, updated,,
    anchor || '0a'x || '5c'x || 'input{../../../boilerplate/splice-guard}')
  /* A missing glyph is a failed publication, not a silent PDF omission. */
  updated = updated || '0a'x || '5c'x || 'tracinglostchars=3' || '0a'x
  return write_text(preamble, updated)

/* Apply the initial free-font profile only to staged TeX inputs. The original
 * book sources and their authored font choices stay untouched. */
applyfontprofile: procedure = .int
  arg path = .string, profile = .string
  names = .string[]
  i = .int
  child = .string
  kind = .string
  contents = .string
  updated = .string
  api_layout = .string
  slash = '5c'x
  serif = 'texgyrepagella-regular.otf'
  sans = 'texgyreheros-regular.otf'
  mono = 'JuliaMono-Regular.ttf'
  serifopts = 'BoldFont=texgyrepagella-bold.otf,ItalicFont=texgyrepagella-italic.otf,BoldItalicFont=texgyrepagella-bolditalic.otf'
  sansopts = 'BoldFont=texgyreheros-bold.otf,ItalicFont=texgyreheros-italic.otf,BoldItalicFont=texgyreheros-bolditalic.otf'
  monoopts = 'RawFeature=-calt,BoldFont=JuliaMono-Bold.ttf,ItalicFont=JuliaMono-RegularItalic.ttf,BoldItalicFont=JuliaMono-BoldItalic.ttf'
  if profile = 'original' then return 0
  if profile <> 'initial' then do
    say 'Unknown font profile:' profile
    return 1
  end
  kind = file_kind(path)
  if kind = 'directory' then do
    address crexx 'ls :path' output names
    if rc <> 0 then return rc
    do i = 1 to names[0]
      child = path || '/' || names[i]
      if applyfontprofile(child, profile) <> 0 then return 1
    end
    return 0
  end
  if kind <> 'file' then do
    say 'Missing font-profile input:' path
    return 1
  end
  if right(path, 4) <> '.tex' & right(path, 4) <> '.sty' then return 0
  contents = readbinary(path) as .string
  updated = contents
  updated = changestr('Bodoni URW' || '0a'x || '    Light', updated, 'Bodoni URW Light')
  updated = changestr('TeX Gyre' || '0a'x || '    Pagella', updated, 'TeX Gyre Pagella')
  /* listings uses keyval commas: group its whole font style before inserting
   * fontspec's comma-separated face options. */
  updated = changestr('basicstyle=' || slash || 'fontsize{9}{9}' || slash || 'fontspec{JuliaMono}', updated,,
    'basicstyle={' || slash || 'fontsize{9}{9}' || slash || 'fontspec{JuliaMono}}')
  updated = changestr('basicstyle=' || slash || 'fontsize{9}{10}' || slash || 'fontspec{IBM Plex Mono}', updated,,
    'basicstyle={' || slash || 'fontsize{9}{10}' || slash || 'fontspec{IBM Plex Mono}}')
  updated = changestr('basicstyle=' || slash || 'fontspec{IBM Plex Mono}[Scale=0.85]', updated,,
    'basicstyle={' || slash || 'fontspec{IBM Plex Mono}[Scale=0.85]}')
  updated = changestr(slash || 'setmainfont[Mapping=tex-text]{Minion Pro}', updated,,
    slash || 'setmainfont[Mapping=tex-text,' || serifopts || ']{' || serif || '}')
  updated = changestr(slash || 'setmonofont[' || '0a'x || '  Scale=0.75,' || '0a'x ||,
    '  Ligatures=NoCommon' || '0a'x || ']{IBM Plex Mono}', updated,,
    slash || 'setmonofont[Scale=0.75,Ligatures=NoCommon,' || monoopts || ']{' || mono || '}')
  updated = changestr(slash || 'setmonofont[Scale=0.8]{IBM Plex Mono}', updated,,
    slash || 'setmonofont[Scale=0.8,' || monoopts || ']{' || mono || '}')
  updated = changestr(slash || 'newfontfamily' || slash || 'codefont{IBM Plex Mono}', updated,,
    slash || 'newfontfamily' || slash || 'codefont[' || monoopts || ']{' || mono || '}')
  updated = changestr(slash || 'newfontfamily' || slash || 'headingfont{Avenir Next}', updated,,
    slash || 'newfontfamily' || slash || 'headingfont[' || sansopts || ']{' || sans || '}')
  updated = changestr(slash || 'newfontfamily' || slash || 'bignumberfont{Avenir Next}', updated,,
    slash || 'newfontfamily' || slash || 'bignumberfont[' || sansopts || ']{' || sans || '}')
  updated = changestr(slash || 'fontspec{IBM Plex Mono}[Scale=0.7]', updated,,
    slash || 'fontspec[Scale=0.7,' || monoopts || ']{' || mono || '}')
  updated = changestr(slash || 'fontspec{IBM Plex Mono}[Scale=0.85]', updated,,
    slash || 'fontspec[Scale=0.85,' || monoopts || ']{' || mono || '}')
  updated = fontmap(updated, 'IBM Plex Sans Condensed', sans, sansopts)
  updated = fontmap(updated, 'IBM Plex Sans', sans, sansopts)
  updated = fontmap(updated, 'Avenir Next', sans, sansopts)
  updated = fontmap(updated, 'IBM Plex Mono', mono, monoopts)
  updated = fontmap(updated, 'JuliaMono', mono, monoopts)
  updated = fontmap(updated, 'Minion Pro', serif, serifopts)
  updated = fontmap(updated, 'Bodoni URW Light', serif, serifopts)
  updated = fontmap(updated, 'TeX Gyre Pagella', serif, serifopts)
  if right(path, 13) = '/preamble.tex' then do
    main_declaration = slash || 'setmainfont[Mapping=tex-text,' || serifopts || ']{' || serif || '}'
    if countstr(main_declaration, updated) <> 1 then do
      say 'Initial font profile cannot locate staged main font:' path
      return 1
    end
    updated = changestr(main_declaration, updated,,
      main_declaration || '0a'x || slash || 'setsansfont[' || sansopts || ']{' || sans || '}')
  end
  if right(path, 14) = '/structure.tex' & pos('/crexx_library_reference/', path) > 0 then do
    if countstr(slash || 'input{classlib-api}', updated) > 1 then do
      say 'Initial API layout has ambiguous class table:' path
      return 1
    end
    /* Long API names wrap after their visible underscores within the fixed
       name column. A vtop keeps the first baseline beside its arguments. */
    api_layout = slash || 'makeatletter' || '0a'x ||,
      slash || 'renewcommand{' || slash || 'API@NameBox}[1]{%' || '0a'x ||,
      '  ' || slash || 'hbox to ' || slash || 'APINameWidth{%' || '0a'x ||,
      '    ' || slash || 'vtop{' || slash || 'hsize=' || slash || 'APINameWidth' || '0a'x ||,
      '      ' || slash || 'parindent=0pt ' || slash || 'raggedright ' || slash || 'bfseries' || '0a'x ||,
      '      ' || slash || 'def' || slash || '_{' || slash || 'char95' || slash || 'allowbreak{}}#1' || slash || 'par}%' || '0a'x ||,
      '    ' || slash || 'hfil}%' || '0a'x ||,
      '}' || '0a'x || slash || 'makeatother' || '0a'x
    if countstr(slash || 'input{classlib-api}', updated) = 1 then
      updated = changestr(slash || 'input{classlib-api}', updated, api_layout || slash || 'input{classlib-api}')
  end
  if right(path, 17) = '/classlib-api.tex' then do
    /* Constructors without underscores still need natural name breaks in
       the staged API table. Each exact braced token occurs once. */
    updated = changestr('{httpconnectionowner}', updated, '{http' || slash || 'allowbreak{}connection' || slash || 'allowbreak{}owner}')
    updated = changestr('{StringArrayListIterator}', updated, '{String' || slash || 'allowbreak{}Array' || slash || 'allowbreak{}List' || slash || 'allowbreak{}Iterator}')
    updated = changestr('{StringHashMapIterator}', updated, '{String' || slash || 'allowbreak{}HashMap' || slash || 'allowbreak{}Iterator}')
    updated = changestr('{StringHashSetIterator}', updated, '{String' || slash || 'allowbreak{}HashSet' || slash || 'allowbreak{}Iterator}')
    updated = changestr('{StringObjectHashMap}', updated, '{String' || slash || 'allowbreak{}Object' || slash || 'allowbreak{}HashMap}')
    updated = changestr('{StringObjectHashMapIterator}', updated, '{String' || slash || 'allowbreak{}Object' || slash || 'allowbreak{}HashMap' || slash || 'allowbreak{}Iterator}')
    updated = changestr('{StringObjectTreeMap}', updated, '{String' || slash || 'allowbreak{}Object' || slash || 'allowbreak{}TreeMap}')
    updated = changestr('{StringObjectTreeMapIterator}', updated, '{String' || slash || 'allowbreak{}Object' || slash || 'allowbreak{}TreeMap' || slash || 'allowbreak{}Iterator}')
    updated = changestr('{StringTreeMapIterator}', updated, '{String' || slash || 'allowbreak{}TreeMap' || slash || 'allowbreak{}Iterator}')
    updated = changestr('{StringTreeSetIterator}', updated, '{String' || slash || 'allowbreak{}TreeSet' || slash || 'allowbreak{}Iterator}')
  end
  if contents <> updated then return write_text(path, updated)
  return 0

fontmap: procedure = .string
  arg contents = .string, original = .string, filename = .string, fontopts = .string
  slash = '5c'x
  contents = changestr(slash || 'fontspec{' || original || '}', contents,,
    slash || 'fontspec[' || fontopts || ']{' || filename || '}')
  /* JuliaMono is also the replacement filename stem. A global string replace
     would double that stem inside the just-inserted filename/options. */
  if original = 'JuliaMono' then return contents
  return changestr(original, contents, filename)

builddocument: procedure = .int
  arg work = .string, title = .string
  i = .int
  argv = .string[]
  pdf = work || '/' || title || '.pdf'
  if file_kind(pdf) = 'file' then do
    address crexx 'rm :pdf'
    if rc <> 0 then return rc
  end
  address crexx 'cd :work'
  if rc <> 0 then return rc
  do i = 1 to 2
    call arraydrop argv
    argv[1] = 'xelatex'
    argv[2] = '--no-pdf'
    argv[3] = '-shell-escape'
    argv[4] = '-interaction=nonstopmode'
    argv[5] = '-halt-on-error'
    argv[6] = title || '.tex'
    if run_tool(argv) <> 0 then return 1
    call arraydrop argv
    argv[1] = 'makeindex'
    argv[2] = title
    if run_tool(argv) <> 0 then return 1
    indexlog = work || '/' || title || '.ilg'
    if file_kind(indexlog) <> 'file' then do
      say 'Missing makeindex log:' indexlog
      return 1
    end
    if pos(', 0 rejected).', readbinary(indexlog) as .string) = 0 then do
      say 'makeindex rejected an index entry; inspect:' indexlog
      return 1
    end
    argv[1] = 'biber'
    if run_tool(argv) <> 0 then return 1
  end
  /* The final index/bibliography outputs and outline writes require at least
     one more TeX pass. Stop only when cross-references and outlines settle. */
  do i = 1 to 3
    call arraydrop argv
    argv[1] = 'xelatex'
    argv[2] = '--no-pdf'
    argv[3] = '-shell-escape'
    argv[4] = '-interaction=nonstopmode'
    argv[5] = '-halt-on-error'
    argv[6] = title || '.tex'
    if run_tool(argv) <> 0 then return 1
    texlog = work || '/' || title || '.log'
    if file_kind(texlog) <> 'file' then do
      say 'Missing XeLaTeX log:' texlog
      return 1
    end
    logtext = readbinary(texlog) as .string
    if pos('Rerun to get cross-references right', logtext) = 0 &,
      pos('Rerun to get outlines right', logtext) = 0 then leave
    if i = 3 then do
      say 'XeLaTeX cross-references or outlines did not converge:' texlog
      return 1
    end
  end
  call arraydrop argv
  argv[1] = 'xdvipdfmx'
  argv[2] = '-V'
  argv[3] = '1.7'
  argv[4] = title || '.xdv'
  if run_tool(argv) <> 0 then return 1
  if file_kind(pdf) <> 'file' then do
    say 'No PDF produced:' pdf
    return 1
  end
  if bincompare(binsubstr(readbinary(pdf), 1, 5), '%PDF-' as .binary) <> 0 then do
    say 'Invalid PDF header:' pdf
    return 1
  end
  return 0

run_tool: procedure = .int
  arg argv = .string[]
  say 'Tool:' argv[1]
  address crexx 'run :argv[]'
  result = rc
  if result <> 0 then say 'Tool failed:' argv[1] 'return code' result
  return result

write_text: procedure = .int
  arg output = .string, text = .string
  bytes = text as .binary
  if writebinary(output, bytes) <> binlength(bytes) then return 1
  return 0

file_kind: procedure = .string
  arg path = .string
  info = .string[]
  errors = .string[]
  kind = .string
  address crexx 'stat :path' output info error errors
  if rc <> 0 then return ''
  parse var info[1] . ' type=' kind ' size=' .
  return kind

modified: procedure = .int
  arg path = .string
  info = .string[]
  stamp = .string
  address crexx 'stat :path' output info
  if rc <> 0 then return -1
  parse var info[1] . ' mtime=' stamp
  return stamp as .int

close_footnote: procedure = .string
  arg outline = .string
  where = pos('footnote', outline)
  if where > 0 then do
    rest = substr(outline, where)
    if countstr('}', rest) < 2 then outline = left(outline, where-1) || changestr('}', rest, '}}')
  end
  return outline

replace_word: procedure = .string
  arg line = .string, original = .string, replacement = .string
  where = .int
  do while wordpos(original, line) > 0
    where = wordpos(original, line)
    line = subword(line, 1, where-1) || ' ' || replacement || ' ' || subword(line, where+1)
  end
  return line
