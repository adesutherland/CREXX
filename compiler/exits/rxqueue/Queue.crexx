options levelb
namespace rxcpexits expose queueexit

import rxcp
import rxfnsb

queueexit: class
    _node_id = .int

    *: factory
        arg nid = .int
        _node_id = nid

    describe: method = .exitdescriptor
        desc = .exitdescriptor("push")
        call desc.add_flag("certified")
        call desc.add_flag("reserved_keyword")
        call desc.add_import("rxfnsb", "descriptor", "")
        return desc

    pre_process: method = .exitplan
        arg tokens = .token[]
        plan = .exitplan("READY")
        return plan

    process: method = .exitresult
        arg tokens = .token[]
        return queue_push_result(tokens)

queuequeueexit: class
    _node_id = .int

    *: factory
        arg nid = .int
        _node_id = nid

    describe: method = .exitdescriptor
        desc = .exitdescriptor("queue")
        call desc.add_flag("certified")
        call desc.add_flag("reserved_keyword")
        call desc.add_import("rxfnsb", "descriptor", "")
        return desc

    pre_process: method = .exitplan
        arg tokens = .token[]
        return .exitplan("READY")

    process: method = .exitresult
        arg tokens = .token[]
        return queue_queue_result(tokens)

queuepullexit: class
    _node_id = .int

    *: factory
        arg nid = .int
        _node_id = nid

    describe: method = .exitdescriptor
        desc = .exitdescriptor("pull")
        call desc.add_flag("certified")
        call desc.add_flag("reserved_keyword")
        call desc.add_import("rxfnsb", "descriptor", "")
        return desc

    pre_process: method = .exitplan
        arg tokens = .token[]
        return .exitplan("READY")

    process: method = .exitresult
        arg tokens = .token[]
        return queue_pull_result(tokens)

queue_push_result: procedure = .exitresult
    arg tokens = .token[]
    result = .exitresult("EMPTY")
    if tokens.0 < 2 then return error_result(1, "PUSH requires an expression")
    expression = queue_expression(tokens)
    call result.set_status("REPLACE")
    call result.add_replacement_line("call push " || expression)
    return result

queue_queue_result: procedure = .exitresult
    arg tokens = .token[]
    result = .exitresult("EMPTY")
    if tokens.0 < 2 then return error_result(1, "QUEUE requires an expression")
    expression = queue_expression(tokens)
    call result.set_status("REPLACE")
    call result.add_replacement_line("call queue " || expression)
    return result

queue_pull_result: procedure = .exitresult
    arg tokens = .token[]
    result = .exitresult("EMPTY")
    if tokens.0 <> 2 then return error_result(1, "PULL requires one target identifier")
    target = tokens[2]
    if strip(target.get_type()) <> "identifier" then return error_result(2, "PULL target must be an identifier")
    call result.set_status("REPLACE")
    call result.add_replacement_line(target.get_text() || " = pull()")
    return result

queue_expression: procedure = .string
    arg tokens = .token[]
    expression = ""
    do i = 2 to tokens.0
        if expression <> "" then expression = expression || " "
        expression = expression || tokens[i].get_text()
    end
    return expression

error_result: procedure = .exitresult
    arg token_index = .int, message = .string
    result = .exitresult("ERROR")
    call result.set_error(token_index, message)
    return result
