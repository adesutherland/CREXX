options levelb
import rxfnsb

## main: procedure

/* SUBSTR() on the left-hand side */

ok = 0

/* Replace same length */
text = "The quick fox"
substr(text, 11, 3) = "cat"
if text = "The quick cat" then ok = ok+1

/* Assigned string longer than target (truncated) */
text = "The quick fox"
substr(text, 11, 3) = "brown"
if text = "The quick bro" then ok = ok+1
else say 'Test 2 failed "'text'"'

/* Assigned string shorter than target (remaining characters unchanged) */
text = "The quick fox"
substr(text, 11, 3) = "X"
if text = "The quick X  " then ok = ok+1
else say 'Test 3 failed "'text'"'

/* Replace at the beginning */
text = "abcdef"
substr(text, 1, 3) = "XYZ"
if text = "XYZdef" then ok = ok+1
else say 'Test 4 failed "'text'"'

/* Replace at the end */
text = "abcdef"
substr(text, 5, 2) = "XY"
if text = "abcdXY" then ok = ok+1
else say 'Test 5 failed "'text'"'

if ok=5 then say "SUCCESS"
else say "FAILED"
