test_parse_version: procedure = .int
  failures = .int
  parser = .parseexit(2020)
  plan = .exitplan
  result = .exitresult
  failures = 0

  tokens = newtokens()
  call pushidentifier tokens, "PARSE"
  call pushidentifier tokens, "VERSION"
  call pushidentifier tokens, "runtimeVersion", ".string", 0
  plan = parser.pre_process(tokens)
  if check_equal("parse version pre_process", "READY", plan.get_status()) = 0 then failures = failures + 1
  if check_true("parse version keyword", find_keyword(plan, "VERSION") > 0, "keyword claim missing") = 0 then failures = failures + 1
  version_bind = find_binding(plan, "runtimeVersion")
  if check_true("parse version binding", version_bind > 0, "binding missing") = 0 then failures = failures + 1
  if version_bind > 0 then do
     binding = plan.get_binding(version_bind)
     if check_equal("parse version provenance", "parse_target", binding.get_provenance()) = 0 then failures = failures + 1
  end
  result = parser.process(tokens)
  if check_equal("parse version process", "REPLACE", result.get_status()) = 0 then failures = failures + 1
  replacement = join_result_lines(result)
  if check_contains("parse version source", replacement, "version()") = 0 then failures = failures + 1

  parser = .parseexit(2021)
  tokens = newtokens()
  call pushidentifier tokens, "PARSE"
  call pushidentifier tokens, "VERSION"
  call pushidentifier tokens, "one", ".string", 0
  call pushidentifier tokens, "two", ".string", 0
  plan = parser.pre_process(tokens)
  result = parser.process(tokens)
  replacement = join_result_lines(result)
  if check_equal("parse version two process", "REPLACE", result.get_status()) = 0 then failures = failures + 1
  if check_contains("parse version two source", replacement, "version()") = 0 then failures = failures + 1
  if check_contains("parse version two first target", replacement, "one=") = 0 then failures = failures + 1
  if check_contains("parse version two second target", replacement, "two=") = 0 then failures = failures + 1

  parser = .parseexit(2022)
  tokens = newtokens()
  call pushidentifier tokens, "PARSE"
  call pushidentifier tokens, "VERSION"
  call pushidentifier tokens, "one", ".string", 0
  call pushidentifier tokens, "two", ".string", 0
  call pushidentifier tokens, "three", ".string", 0
  plan = parser.pre_process(tokens)
  result = parser.process(tokens)
  replacement = join_result_lines(result)
  if check_equal("parse version three process", "REPLACE", result.get_status()) = 0 then failures = failures + 1
  if check_contains("parse version three source", replacement, "version()") = 0 then failures = failures + 1
  if check_contains("parse version three first target", replacement, "one=") = 0 then failures = failures + 1
  if check_contains("parse version three second target", replacement, "two=") = 0 then failures = failures + 1
  if check_contains("parse version three third target", replacement, "three=") = 0 then failures = failures + 1

  tokens = newtokens()
  call pushidentifier tokens, "PARSE"
  call pushidentifier tokens, "VERSION"
  plan = parser.pre_process(tokens)
  if check_equal("parse version missing target status", "ERROR", plan.get_status()) = 0 then failures = failures + 1
  if plan.get_diagnostic_count() > 0 then do
     diagnostic = plan.get_diagnostic(1)
     if check_equal("parse version missing target code", "MISSING_ARGUMENTS", diagnostic.get_code()) = 0 then failures = failures + 1
     if check_equal("parse version missing target message", "PARSE requires arguments", diagnostic.get_message()) = 0 then failures = failures + 1
  end

  return failures

test_parse_source: procedure = .int
  failures = .int
  parser = .parseexit(2030)
  plan = .exitplan
  result = .exitresult
  failures = 0

  tokens = newtokens()
  call pushidentifier tokens, "PARSE"
  call pushidentifier tokens, "SOURCE"
  call pushidentifier tokens, "sourceInfo", ".string", 0
  plan = parser.pre_process(tokens)
  if check_equal("parse source pre_process", "READY", plan.get_status()) = 0 then failures = failures + 1
  if check_true("parse source keyword", find_keyword(plan, "SOURCE") > 0, "keyword claim missing") = 0 then failures = failures + 1
  result = parser.process(tokens)
  if check_equal("parse source process", "REPLACE", result.get_status()) = 0 then failures = failures + 1
  replacement = join_result_lines(result)
  if check_contains("parse source expression", replacement, "sourceinfo()") = 0 then failures = failures + 1
  if check_contains("parse source target", replacement, "sourceInfo=") = 0 then failures = failures + 1

  parser = .parseexit(2031)
  tokens = newtokens()
  call pushidentifier tokens, "PARSE"
  call pushidentifier tokens, "SOURCE"
  call pushidentifier tokens, "system", ".string", 0
  call pushidentifier tokens, "mode", ".string", 0
  call pushidentifier tokens, "file", ".string", 0
  plan = parser.pre_process(tokens)
  result = parser.process(tokens)
  replacement = join_result_lines(result)
  if check_equal("parse source three process", "REPLACE", result.get_status()) = 0 then failures = failures + 1
  if check_contains("parse source three expression", replacement, "sourceinfo()") = 0 then failures = failures + 1
  if check_contains("parse source first target", replacement, "system=") = 0 then failures = failures + 1
  if check_contains("parse source second target", replacement, "mode=") = 0 then failures = failures + 1
  if check_contains("parse source third target", replacement, "file=") = 0 then failures = failures + 1

  return failures

test_compiled_pattern_lowering: procedure = .int
  failures = .int
  parser = .parseexit(2020)
  plan = .exitplan
  result = .exitresult
  failures = 0

  tokens = newtokens()
  call pushidentifier tokens, "PARSE"
  call pushidentifier tokens, "VAR"
  call pushidentifier tokens, "source", ".string", 0
  call pushidentifier tokens, "left", ".string", 0
  call pushbracket tokens, "("
  call pushidentifier tokens, "delimiter", ".string", 0
  call pushbracket tokens, ")"
  call pushidentifier tokens, "right", ".string", 0
  plan = parser.pre_process(tokens)
  result = parser.process(tokens)
  replacement = join_result_lines(result)
  if check_equal("PERF3-12D delimiter plan", "READY", plan.get_status()) = 0 then failures = failures + 1
  if check_equal("PERF3-12D delimiter result", "REPLACE", result.get_status()) = 0 then failures = failures + 1
  cursor_bind = find_binding(plan, "__rxcpx_pattern_cursor_2020")
  if check_true("PERF3-12D delimiter cursor binding", cursor_bind > 0, "binding missing") = 0 then failures = failures + 1
  if cursor_bind > 0 then do
     binding = plan.get_binding(cursor_bind)
     if check_equal("PERF3-12D delimiter cursor internal", "internal", binding.get_kind()) = 0 then failures = failures + 1
  end
  if check_contains("PERF3-12D delimiter search", replacement, "assembler strpos __rxcpx_pattern_cursor_2020,__rxcpx_pattern_value_2020,__rxcpx_parse_source_2020") = 0 then failures = failures + 1
  if check_contains("PERF3-12D delimiter first span", replacement, "assembler substring __rxcpx_parse_direct1_2020") = 0 then failures = failures + 1
  if check_contains("PERF3-12D delimiter second span", replacement, "assembler substring __rxcpx_parse_direct2_2020") = 0 then failures = failures + 1
  if check_true("PERF3-12D delimiter no parseExec", pos("parseExec(", replacement) = 0, replacement) = 0 then failures = failures + 1
  if check_true("PERF3-12D delimiter no parseplan", pos("assembler parseplan ", replacement) = 0, replacement) = 0 then failures = failures + 1

  parser = .parseexit(2021)
  tokens = newtokens()
  call pushidentifier tokens, "PARSE"
  call pushidentifier tokens, "VAR"
  call pushidentifier tokens, "source", ".string", 0
  call pushidentifier tokens, "x1", ".string", 0
  call pushoperator tokens, "="
  call pushbracket tokens, "("
  call pushidentifier tokens, "start", ".int", 0
  call pushbracket tokens, ")"
  call pushidentifier tokens, "x2", ".string", 0
  call pushoperator tokens, "+"
  call pushbracket tokens, "("
  call pushidentifier tokens, "span", ".int", 0
  call pushbracket tokens, ")"
  call pushidentifier tokens, "x3", ".string", 0
  plan = parser.pre_process(tokens)
  result = parser.process(tokens)
  replacement = join_result_lines(result)
  if check_equal("PERF3-12D positions plan", "READY", plan.get_status()) = 0 then failures = failures + 1
  if check_equal("PERF3-12D positions result", "REPLACE", result.get_status()) = 0 then failures = failures + 1
  if check_contains("PERF3-12D absolute operand", replacement, "__rxcpx_pattern_operand1_2021=(start) as .int") = 0 then failures = failures + 1
  if check_contains("PERF3-12D relative operand", replacement, "__rxcpx_pattern_operand2_2021=(span) as .int") = 0 then failures = failures + 1
  if check_contains("PERF3-12D positions first span", replacement, "assembler substring __rxcpx_parse_direct1_2021") = 0 then failures = failures + 1
  if check_contains("PERF3-12D positions tail", replacement, "assembler substring __rxcpx_parse_direct3_2021") = 0 then failures = failures + 1
  if check_true("PERF3-12D positions no parseExec", pos("parseExec(", replacement) = 0, replacement) = 0 then failures = failures + 1

  parser = .parseexit(2022)
  tokens = newtokens()
  call pushidentifier tokens, "PARSE"
  call pushidentifier tokens, "VAR"
  call pushidentifier tokens, "source", ".string", 0
  call pushidentifier tokens, "left", ".string", 0
  call pushbracket tokens, "("
  call pushidentifier tokens, "delimiter", ".string", 0
  call pushbracket tokens, ")"
  call pushidentifier tokens, "middle", ".string", 0
  call pushstring tokens, '";"'
  call pushidentifier tokens, "tail", ".string", 0
  plan = parser.pre_process(tokens)
  result = parser.process(tokens)
  replacement = join_result_lines(result)
  if check_equal("PERF3-12D general dynamic plan", "READY", plan.get_status()) = 0 then failures = failures + 1
  if check_equal("PERF3-12D general dynamic result", "REPLACE", result.get_status()) = 0 then failures = failures + 1
  if check_contains("PERF3-12D dynamic descriptor v2", replacement, '"50020C00') = 0 then failures = failures + 1
  if check_contains("PERF3-12D dynamic external slot", replacement, "__rxcpx_parse_prepared_2022[4]=(delimiter) as .string") = 0 then failures = failures + 1
  if check_contains("PERF3-12D dynamic compiled opcode", replacement, "assembler parseplan __rxcpx_parse_prepared_2022,") = 0 then failures = failures + 1
  if check_true("PERF3-12D general dynamic no inline search", pos("assembler strpos ", replacement) = 0, replacement) = 0 then failures = failures + 1
  if check_true("PERF3-12D general dynamic no parseExec", pos("parseExec(", replacement) = 0, replacement) = 0 then failures = failures + 1

  return failures

test_nr14_direct_lowering: procedure = .int
  failures = .int
  parser = .parseexit(2010)
  plan = .exitplan
  result = .exitresult
  failures = 0

  tokens = newtokens()
  call pushidentifier tokens, "PARSE"
  call pushidentifier tokens, "VAR"
  call pushidentifier tokens, "source", ".string", 0
  call pushidentifier tokens, "first", ".string", 0
  call pushidentifier tokens, "second", ".string", 0
  call pushidentifier tokens, "third", ".string", 0
  plan = parser.pre_process(tokens)
  result = parser.process(tokens)
  replacement = join_result_lines(result)
  if check_equal("NR-14 words status", "REPLACE", result.get_status()) = 0 then failures = failures + 1
  if check_contains("NR-14 words opcode", replacement, "assembler parsewords3 ") = 0 then failures = failures + 1
  if check_contains("NR-14 words source copy", replacement, "__rxcpx_parse_source_2010=({3}) as .string") = 0 then failures = failures + 1
  if check_contains("NR-14 words first assignment", replacement, "first=__rxcpx_parse_direct1") = 0 then failures = failures + 1
  if check_true("NR-14 words no generic call", pos("parseExec(", replacement) = 0, replacement) = 0 then failures = failures + 1

  parser = .parseexit(2011)
  tokens = newtokens()
  call pushidentifier tokens, "PARSE"
  call pushidentifier tokens, "VAR"
  call pushidentifier tokens, "source", ".string", 0
  call pushidentifier tokens, "first", ".string", 0
  call pushidentifier tokens, "second", ".string", 0
  call pushidentifier tokens, "third", ".string", 0
  dot_index = tokens[0] + 1
  tokens[dot_index] = .token(0,0,".",1,1,1,"exit_test",0,"","other",0,"")
  plan = parser.pre_process(tokens)
  result = parser.process(tokens)
  replacement = join_result_lines(result)
  if check_contains("NR-14 words-drop opcode", replacement, "assembler parsewords3d ") = 0 then failures = failures + 1
  if check_true("NR-14 words-drop no generic call", pos("parseExec(", replacement) = 0, replacement) = 0 then failures = failures + 1

  parser = .parseexit(2012)
  tokens = newtokens()
  call pushidentifier tokens, "PARSE"
  call pushidentifier tokens, "VALUE"
