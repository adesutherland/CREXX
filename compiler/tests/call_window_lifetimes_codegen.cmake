cmake_minimum_required(VERSION 3.20)

foreach(required IN ITEMS RXC BIN_DIR SOURCE_DIR WORK_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing required -D${required}=...")
    endif()
endforeach()

file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")

# Keep each observed swap/copy pair inside one call preparation. In particular,
# the restore swaps from a previous call cannot justify the next call's copy.
function(assert_in_slot_snapshot image_variable)
    set(swaps)
    set(snapshots)
    set(found FALSE)
    string(REPLACE "\n" ";" lines "${${image_variable}}")
    foreach(line IN LISTS lines)
        if(line MATCHES "^[^ \t].*\\(\\)[ \t]+\\.locals=" OR
           line MATCHES "^[ \t]+load[ \t]")
            set(swaps)
            set(snapshots)
        elseif(line MATCHES "^[ \t]+swap r([0-9]+),r([0-9]+)$")
            list(APPEND swaps "${CMAKE_MATCH_1}:${CMAKE_MATCH_2}")
        elseif(line MATCHES "^[ \t]+copy r([0-9]+),r([0-9]+)$")
            set(pair "${CMAKE_MATCH_2}:${CMAKE_MATCH_1}")
            list(FIND swaps "${pair}" preceding_swap)
            if(NOT preceding_swap EQUAL -1)
                list(APPEND snapshots "${pair}")
            endif()
        elseif(line MATCHES "^[ \t]+[a-z0-9]*call[0-9]*[ \t]")
            if(line MATCHES "^[ \t]+call [^,]+,(counted_call_expose_alias\\.)?expose_(after|before)\\(\\),r([0-9]+)$")
                set(passing_order "${CMAKE_MATCH_2}")
                set(window_base "${CMAKE_MATCH_3}")
                if(passing_order STREQUAL "after")
                    math(EXPR exposed_slot "${window_base} + 3")
                else()
                    math(EXPR exposed_slot "${window_base} + 1")
                endif()
                math(EXPR window_end "${window_base} + 4")
                foreach(pair IN LISTS snapshots)
                    string(REGEX MATCH "^([0-9]+):([0-9]+)$" ignored "${pair}")
                    if(CMAKE_MATCH_1 EQUAL exposed_slot AND
                       CMAKE_MATCH_2 GREATER window_base AND CMAKE_MATCH_2 LESS_EQUAL window_end)
                        set(found TRUE)
                    endif()
                endforeach()
            endif()
            set(swaps)
            set(snapshots)
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "Optimized alias fixture has no ordered same-call in-slot EXPOSE snapshot")
    endif()
endfunction()

# The emitter places argc's immediate load after argument evaluation. Require
# that producer in this procedure and since the previous call, with no write
# or swap of the cell before DCALL consumes it. Function scope isolates images.
function(assert_selector_provenance image_variable mode)
    set(count_register "")
    set(argument_count "")
    set(method_count 0)
    set(factory_count 0)
    set(dynamic_count 0)
    string(REPLACE "\n" ";" lines "${${image_variable}}")
    foreach(line IN LISTS lines)
        if(line MATCHES "^[^ \t].*\\(\\)[ \t]+\\.locals=")
            set(count_register "")
            set(argument_count "")
            continue()
        endif()
        if(line MATCHES "^[ \t]+load r([0-9]+),([0-9]+)$")
            set(count_register "${CMAKE_MATCH_1}")
            set(argument_count "${CMAKE_MATCH_2}")
            continue()
        endif()
        if(line MATCHES "^[ \t]+srcmethodsel r([0-9]+),r([0-9]+),")
            if(CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
                message(FATAL_ERROR "Method selector overwrites its receiver in ${mode}")
            endif()
            math(EXPR method_count "${method_count} + 1")
        elseif(line MATCHES "^[ \t]+srcfprocsel ")
            math(EXPR factory_count "${factory_count} + 1")
        elseif(line MATCHES "^[ \t]+dcall r[0-9]+,r([0-9]+),r([0-9]+)$")
            set(selector "${CMAKE_MATCH_1}")
            set(consumed_count "${CMAKE_MATCH_2}")
            if(count_register STREQUAL "" OR NOT consumed_count STREQUAL count_register)
                message(FATAL_ERROR "Dynamic call has no own live argc load in ${mode}")
            endif()
            math(EXPR window_end "${count_register} + ${argument_count}")
            if(selector GREATER_EQUAL count_register AND selector LESS_EQUAL window_end)
                message(FATAL_ERROR "Dynamic selector overlaps its live counted window in ${mode}")
            endif()
            math(EXPR dynamic_count "${dynamic_count} + 1")
        endif()

        if(line MATCHES "^[ \t]+[a-z0-9]*call[0-9]*[ \t]" OR
           line MATCHES "^[^ \t.][^ \t]*:" OR line MATCHES "^[ \t]+br[a-z]*[ \t]")
            set(count_register "")
            set(argument_count "")
        elseif(NOT count_register STREQUAL "")
            if(line MATCHES "^[ \t]+[a-z]*swap[ \t]")
                # Every register operand of a swap preparation can change its
                # pointer identity, including the operand after an immediate.
                string(REGEX MATCHALL "r[0-9]+" operands "${line}")
                list(FIND operands "r${count_register}" overwritten)
                if(NOT overwritten EQUAL -1)
                    set(count_register "")
                    set(argument_count "")
                endif()
            elseif(line MATCHES "^[ \t]+[a-z][a-z0-9]*[ \t]+r([0-9]+)(,|$)")
                # None of the fixture's read-only instructions between argc
                # and DCALL names argc first. Conservatively reject a write.
                if(CMAKE_MATCH_1 STREQUAL count_register)
                    set(count_register "")
                    set(argument_count "")
                endif()
            endif()
        endif()
    endforeach()
    if(method_count LESS 1 OR factory_count LESS 1 OR dynamic_count LESS 1)
        message(FATAL_ERROR "Missing method/factory/dynamic-call controls in ${mode}")
    endif()
endfunction()

foreach(mode IN ITEMS opt noopt)
    set(flags)
    if(mode STREQUAL "noopt")
        set(flags -n)
    endif()
    foreach(fixture IN ITEMS counted_call_expose_alias interface_selector_lifetime)
        execute_process(
                COMMAND "${RXC}" -i "${BIN_DIR}" ${flags}
                        -o "${WORK_DIR}/${fixture}_${mode}"
                        "${SOURCE_DIR}/${fixture}.crexx"
                OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE result)
        if(NOT result EQUAL 0 OR NOT "${out}${err}" STREQUAL "")
            message(FATAL_ERROR "rxc failed or emitted diagnostics for ${fixture}/${mode}:\n${out}${err}")
        endif()
        file(READ "${WORK_DIR}/${fixture}_${mode}.rxas" image)

        if(fixture STREQUAL "counted_call_expose_alias")
            # Local operands may retain their authored bare spelling; metadata
            # carries the namespace independently. Match only this logical target.
            foreach(target IN ITEMS expose_after expose_before value_pair)
                if(NOT image MATCHES "\n[ \t]+call [^,\n]+,(counted_call_expose_alias\\.)?${target}\\(\\),r[0-9]+(\n|$)")
                    message(FATAL_ERROR "Missing counted ${target} control in ${mode}")
                endif()
            endforeach()
            # Match operand roles and target, without fixing register IDs.
            if(NOT image MATCHES "\n[ \t]+sett(pcall|pswapcall) [^,\n]+,(counted_call_expose_alias\\.)?ordinary\\(\\),r[0-9]+,")
                message(FATAL_ERROR "Ordinary counted-call preparation stopped fusing in ${mode}")
            endif()
            if(mode STREQUAL "opt")
                assert_in_slot_snapshot(image)
            endif()
        else()
            assert_selector_provenance(image "${mode}")
            if(mode STREQUAL "opt" AND image MATCHES "\n[ \t]+(call[0-9]*|[a-z]*call) [^,\n]+,(interface_selector_lifetime\\.)?(check|accept)\\(\\)(,|\n|$)")
                message(FATAL_ERROR "Interface selector consumer stopped inlining")
            endif()
        endif()
    endforeach()
endforeach()
