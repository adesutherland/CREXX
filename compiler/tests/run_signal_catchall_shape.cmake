cmake_minimum_required(VERSION 3.24)

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

# The VM signal inventory defines the ordinary event set. KILL is terminal;
# BREAKPOINT belongs to tracing rather than typed block condition handling.
file(READ "${CMAKE_CURRENT_LIST_DIR}/../../interpreter/rxsignal.h" signal_header)
string(REGEX MATCHALL "#define RXSIGNAL_[A-Z0-9_]+[ \t]+[0-9]+" definitions "${signal_header}")
set(expected)
foreach(definition IN LISTS definitions)
    string(REGEX REPLACE "#define RXSIGNAL_([A-Z0-9_]+)[ \t]+[0-9]+" "\\1" name "${definition}")
    if(NOT name MATCHES "^(NONE|KILL|BREAKPOINT|MAX)$")
        list(APPEND expected "${name}")
    endif()
endforeach()
if(NOT "CLASSIC_SYNTAX" IN_LIST expected OR
   NOT "CLASSIC_CONDITION" IN_LIST expected OR NOT "CANCEL" IN_LIST expected)
    message(FATAL_ERROR "VM inventory lost Classic or cancellation controls")
endif()
list(SORT expected)

file(READ "${SOURCE}" catchall_source)
list(JOIN expected ", " explicit_names)
string(REPLACE "on signal as problem" "on signal ${explicit_names} as problem" explicit_source "${catchall_source}")
file(WRITE "${WORK}/signal_catchall_explicit.crexx" "${explicit_source}")

foreach(mode IN ITEMS noopt opt)
    set(flags)
    if(mode STREQUAL "noopt")
        list(APPEND flags -n)
    endif()
    foreach(form IN ITEMS catchall explicit)
        if(form STREQUAL "catchall")
            set(input "${SOURCE}")
        else()
            set(input "${WORK}/signal_catchall_explicit.crexx")
        endif()
        set(output "${form}_${mode}")
        execute_process(
                COMMAND "${RXC}" -i "${IMPORT_DIR}" ${flags} -o "${output}" "${input}"
                WORKING_DIRECTORY "${WORK}"
                OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "${form}/${mode} admission failed (${rc}):\n${out}${err}")
        endif()
        if(NOT out STREQUAL "" OR NOT err STREQUAL "")
            message(FATAL_ERROR "${form}/${mode} emitted diagnostics:\n${out}${err}")
        endif()
        file(READ "${WORK}/${output}.rxas" image)
        foreach(opcode IN ITEMS sigpush sigbrv sigpop)
            string(REGEX MATCHALL "(^|\n)[ \t]+${opcode} [^\n\r]*" instructions "${image}")
            set(${opcode}_names)
            foreach(instruction IN LISTS instructions)
                string(REGEX REPLACE ".*\"([A-Z0-9_]+)\".*" "\\1" name "${instruction}")
                list(APPEND ${opcode}_names "${name}")
            endforeach()
        endforeach()
        set(actual "${sigpush_names}")
        list(SORT actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "${form}/${mode} registration differs from admitted maskable VM events:\nexpected=${expected}\nactual=${actual}")
        endif()
        if(NOT sigbrv_names STREQUAL sigpush_names)
            message(FATAL_ERROR "${form}/${mode} handlers differ from saved entries")
        endif()
        set(reversed "${sigpush_names}")
        list(REVERSE reversed)
        set(expected_pops ${reversed} ${reversed})
        if(NOT sigpop_names STREQUAL expected_pops)
            message(FATAL_ERROR "${form}/${mode} normal and handler exits must each restore every entry in reverse order")
        endif()
    endforeach()
endforeach()
