cmake_minimum_required(VERSION 3.24)

foreach(required IN ITEMS RXC RXAS RXLINK RXBVM LIBRARY SOURCE EXPECTED WORK)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing -D${required}=...")
    endif()
endforeach()

set(cell "${WORK}/binary_concat_target")
file(REMOVE_RECURSE "${cell}")
file(MAKE_DIRECTORY "${cell}")
get_filename_component(imports "${LIBRARY}" DIRECTORY)
file(READ "${EXPECTED}" expected)
string(REPLACE "\r\n" "\n" expected "${expected}")
set(runners "${RXBVM}")
if(DEFINED RXTVM AND NOT "${RXTVM}" STREQUAL "")
    list(APPEND runners "${RXTVM}")
endif()
if(DEFINED INSPECT AND NOT "${INSPECT}" STREQUAL "")
    # Active read-only review only; the caller removes these copies afterward.
    file(MAKE_DIRECTORY "${INSPECT}")
endif()

function(run_checked)
    execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${cell}"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err
        TIMEOUT 900)
    if(NOT "${status}" STREQUAL "0")
        message(FATAL_ERROR "${ARGV} failed (${status}):\n${out}\n${err}")
    endif()
    if(NOT "${err}" STREQUAL "")
        message(FATAL_ERROR "${ARGV} emitted diagnostics:\n${err}")
    endif()
    if(out MATCHES "([Ww]arning in |[Ww]arning:|#WARNING)")
        message(FATAL_ERROR "${ARGV} emitted warnings:\n${out}")
    endif()
    set(last_output "${out}" PARENT_SCOPE)
endfunction()

function(procedure_body name result)
    # Public names may carry the compiler's namespace prefix. Register numbers,
    # source IDs and local counts are deliberately outside this expectation.
    string(REGEX MATCH "(^|\n)[^ \n]*${name}\\(\\)[^\n]*\n" header "${assembly}")
    if("${header}" STREQUAL "")
        message(FATAL_ERROR "${cc_mode}: missing retained ${name} body")
    endif()
    string(FIND "${assembly}" "${header}" start)
    string(LENGTH "${header}" header_length)
    math(EXPR start "${start} + ${header_length}")
    string(SUBSTRING "${assembly}" ${start} -1 tail)
    string(FIND "${tail}" "\n\n" finish)
    if(finish GREATER_EQUAL 0)
        string(SUBSTRING "${tail}" 0 ${finish} tail)
    endif()
    set(${result} "\n${tail}" PARENT_SCOPE)
endfunction()

function(check_text name opcode)
    procedure_body("${name}" body)
    if(NOT body MATCHES "\n[ \t]+${opcode} " OR body MATCHES "\n[ \t]+bconcat ")
        message(FATAL_ERROR "${cc_mode}/${name}: expected text ${opcode} before binary promotion:\n${body}")
    endif()
    string(REGEX MATCHALL "\n[ \t]+stobin [^\n]*" promotions "${body}")
    list(LENGTH promotions count)
    if(NOT count EQUAL 1 OR NOT body MATCHES "\n[ \t]+${opcode} [^\n]*\n([^\n]*\n)*[ \t]+stobin ")
        message(FATAL_ERROR "${cc_mode}/${name}: expected one result promotion after ${opcode}:\n${body}")
    endif()
endfunction()

function(check_binary name)
    procedure_body("${name}" body)
    string(REGEX MATCH "\n[ \t]+bconcat [^\n]*" instruction "${body}")
    if("${instruction}" STREQUAL "")
        message(FATAL_ERROR "${cc_mode}/${name}: genuine binary operands lost BCONCAT:\n${body}")
    endif()
    string(FIND "${body}" "${instruction}" offset)
    string(SUBSTRING "${body}" ${offset} -1 after)
    if(after MATCHES "\n[ \t]+stobin ")
        message(FATAL_ERROR "${cc_mode}/${name}: stale text promotion after BCONCAT:\n${body}")
    endif()
    if(NOT body MATCHES "\n[ \t]+stobin ")
        message(FATAL_ERROR "${cc_mode}/${name}: string operand was not converted to bytes:\n${body}")
    endif()
endfunction()

foreach(cc_mode IN ITEMS noopt opt)
    set(cc_flags)
    if(cc_mode STREQUAL noopt)
        list(APPEND cc_flags -n)
    endif()
    set(stem "${cell}/${cc_mode}")
    run_checked("${RXC}" --no-exe-import ${cc_flags} -i "${imports}"
        -o "${stem}" "${SOURCE}")
    file(READ "${stem}.rxas" assembly)
    if(DEFINED INSPECT AND NOT "${INSPECT}" STREQUAL "")
        file(COPY_FILE "${stem}.rxas" "${INSPECT}/binary-concat-${cc_mode}.rxas")
    endif()
    check_text(textjoin concat)
    check_text(blankjoin sconcat)
    check_binary(byteleft)
    check_binary(byteright)
    if(cc_mode STREQUAL opt AND NOT assembly MATCHES "load [^,\n]+,0x63616[cC]6[cC]20312[eE]32300[aA]312[eE]32303[aA]2072657475726[eE]")
        message(FATAL_ERROR "opt: text constant concat did not retain target binary folding")
    endif()
    foreach(as_mode IN ITEMS noopt opt)
        set(as_flags)
        if(as_mode STREQUAL noopt)
            list(APPEND as_flags -n)
        endif()
        set(image "${cell}/${cc_mode}_${as_mode}")
        run_checked("${RXAS}" ${as_flags} -o "${image}" "${stem}.rxas")
        run_checked("${RXLINK}" -s -o "${image}-linked" "${image}.rxbin" "${LIBRARY}")
        foreach(runner IN LISTS runners)
            run_checked("${runner}" --no-autoload "${image}-linked.rxbin")
            string(REPLACE "\r\n" "\n" actual "${last_output}")
            if(NOT "${actual}" STREQUAL "${expected}")
                message(FATAL_ERROR "${cc_mode}/${as_mode}/${runner}: byte mismatch:\nExpected:\n${expected}\nActual:\n${actual}")
            endif()
        endforeach()
    endforeach()
endforeach()
file(REMOVE_RECURSE "${cell}")
