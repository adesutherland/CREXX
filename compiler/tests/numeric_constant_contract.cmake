cmake_minimum_required(VERSION 3.24)
foreach(required IN ITEMS RXC RXAS RXLINK RXDAS RXBVM MUTATE_FLOAT SOURCE_DIR WORK_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing -D${required}=...")
    endif()
endforeach()
file(MAKE_DIRECTORY "${WORK_DIR}")
file(WRITE "${WORK_DIR}/commands.log" "")
string(TIMESTAMP started "%s")
set(runners "${RXBVM}")
if(DEFINED RXTVM AND NOT RXTVM STREQUAL "")
    list(APPEND runners "${RXTVM}")
endif()

function(run_result)
    execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${WORK_DIR}"
            OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE result)
    string(JOIN " " command ${ARGV})
    file(APPEND "${WORK_DIR}/commands.log" "${command}\nexit=${result}\n${out}${err}\n")
    set(last_output "${out}" PARENT_SCOPE)
    set(last_error "${err}" PARENT_SCOPE)
    set(last_result "${result}" PARENT_SCOPE)
endfunction()
function(run_checked)
    run_result(${ARGV})
    if(NOT last_result EQUAL 0 OR NOT last_error STREQUAL "")
        message(FATAL_ERROR "${ARGV} failed (${last_result}):\n${last_output}${last_error}")
    endif()
    set(last_output "${last_output}" PARENT_SCOPE)
endfunction()
function(run_output expected)
    run_checked(${ARGN})
    string(REPLACE "\r\n" "\n" actual "${last_output}")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${ARGN}: expected [${expected}], got [${actual}]")
    endif()
endfunction()

file(READ "${SOURCE_DIR}/numeric_constant_values.expected" expected_values)
foreach(level IN ITEMS levelb levelg)
    file(READ "${SOURCE_DIR}/numeric_constant_values.crexx" values_source)
    string(REPLACE "options levelb" "options ${level}" values_source "${values_source}")
    file(WRITE "${WORK_DIR}/${level}.crexx" "${values_source}")
    foreach(cc_mode IN ITEMS noopt opt)
        set(cc_flags)
        if(cc_mode STREQUAL "noopt")
            set(cc_flags -n)
        endif()
        set(stem "${WORK_DIR}/${level}_${cc_mode}")
        run_checked("${RXC}" -x --no-exe-import ${cc_flags}
                -o "${stem}" "${WORK_DIR}/${level}.crexx")
        foreach(asm_mode IN ITEMS noopt opt)
            set(asm_flags)
            if(asm_mode STREQUAL "noopt")
                set(asm_flags -n)
            endif()
            set(image "${stem}_${asm_mode}")
            run_checked("${RXAS}" ${asm_flags} -o "${image}" "${stem}.rxas")
            run_checked("${RXLINK}" -o "${image}_linked" "${image}.rxbin")
            foreach(runner IN LISTS runners)
                run_output("${expected_values}" "${runner}" "${image}_linked.rxbin" -a 1.0 0.0 1)
            endforeach()
        endforeach()
    endforeach()

    # Invalid constants may reject at compile time, but must never turn into
    # a successful integer. Noopt must retain the VM's checked conversion.
    foreach(case IN ITEMS near rounded say string_assignment string_fraction)
        if(case STREQUAL "near")
            set(body "i = .int\ni = 1.0000000000000002 as .int\nsay i\n")
        elseif(case STREQUAL "rounded")
            set(body "numeric digits 5\nf = 1.000001\ni = .int\ni = f as .int\nsay i\n")
        elseif(case STREQUAL "say")
            set(body "say (1.5 as .int)\n")
        elseif(case STREQUAL "string_assignment")
            set(body "s = .string\ns = (1.5 as .int)\nsay s\n")
        else()
            set(body "i = .int\ni = \"1.5\" as .int\nsay i\n")
        endif()
        set(source "${WORK_DIR}/${level}_${case}.crexx")
        file(WRITE "${source}" "options ${level} numeric_common\nmain: procedure = .int\n${body}return 0\n")
        foreach(cc_mode IN ITEMS noopt opt)
            set(cc_flags)
            if(cc_mode STREQUAL "noopt")
                set(cc_flags -n)
            endif()
            set(stem "${WORK_DIR}/${level}_${case}_${cc_mode}")
            run_result("${RXC}" -x --no-exe-import --diagnostics raw ${cc_flags}
                    -o "${stem}" "${source}")
            if(cc_mode STREQUAL "opt")
                if(NOT last_result EQUAL 2 OR NOT last_error MATCHES "BAD_CONVERSION")
                    message(FATAL_ERROR "${stem}: expected BAD_CONVERSION, got ${last_result}:\n${last_output}${last_error}")
                endif()
            else()
                if(NOT last_result EQUAL 0 OR NOT last_error STREQUAL "")
                    message(FATAL_ERROR "${stem}: noopt compile failed: ${last_result}\n${last_output}${last_error}")
                endif()
                foreach(asm_mode IN ITEMS noopt opt)
                    set(asm_flags)
                    if(asm_mode STREQUAL "noopt")
                        set(asm_flags -n)
                    endif()
                    set(image "${stem}_${asm_mode}")
                    run_checked("${RXAS}" ${asm_flags} -o "${image}" "${stem}.rxas")
                    run_checked("${RXLINK}" -o "${image}_linked" "${image}.rxbin")
                    foreach(runner IN LISTS runners)
                        run_result("${runner}" "${image}_linked.rxbin")
                        if(NOT last_result EQUAL 6 OR NOT last_output STREQUAL "" OR
                           NOT last_error MATCHES "SIGNAL CONVERSION_ERROR")
                            message(FATAL_ERROR "${image}: expected checked conversion failure, got ${last_result}:\n${last_output}${last_error}")
                        endif()
                    endforeach()
                endforeach()
            endif()
        endforeach()
    endforeach()
endforeach()

if(DEFINED VALUES_ONLY AND VALUES_ONLY)
    message(STATUS "PASS: numeric values/casts B/G compiler/assembler/VM matrix; transport gate still open")
    return()
endif()

file(MAKE_DIRECTORY "${WORK_DIR}/runtime")
foreach(level IN ITEMS levelb levelg)
    file(READ "${SOURCE_DIR}/numeric_nonfinite_provider.crexx" provider)
    file(READ "${SOURCE_DIR}/numeric_nonfinite_consumer.crexx" consumer)
    string(REPLACE "options levelb" "options ${level}" provider "${provider}")
    string(REPLACE "options levelb" "options ${level}" consumer "${consumer}")
    foreach(route IN ITEMS source rxas rxbin)
        set(import_dir "${WORK_DIR}/${level}_${route}")
        file(REMOVE_RECURSE "${import_dir}")
        file(MAKE_DIRECTORY "${import_dir}")
        set(provider_stem "${import_dir}/numeric_nonfinite_provider")
        file(WRITE "${provider_stem}.crexx" "${provider}")
        run_checked("${RXC}" -x --no-exe-import -o "${provider_stem}" "${provider_stem}.crexx")
        run_checked("${RXAS}" -o "${provider_stem}" "${provider_stem}.rxas")
        set(provider_image "${WORK_DIR}/runtime/${level}_${route}_provider.rxbin")
        file(RENAME "${provider_stem}.rxbin" "${provider_image}")
        set(import_flags)
        if(route STREQUAL "source")
            file(REMOVE "${provider_stem}.rxas")
            list(APPEND import_flags -s "${import_dir}")
        else()
            file(REMOVE "${provider_stem}.crexx")
            if(route STREQUAL "rxas")
                list(APPEND import_flags --import-rxas -i "${import_dir}")
            else()
                file(REMOVE "${provider_stem}.rxas")
                file(COPY_FILE "${provider_image}" "${provider_stem}.rxbin")
                list(APPEND import_flags -i "${import_dir}")
            endif()
        endif()
        set(consumer_path "${WORK_DIR}/${level}_${route}_consumer.crexx")
        file(WRITE "${consumer_path}" "${consumer}")
        foreach(cc_mode IN ITEMS noopt opt)
            set(cc_flags)
            if(cc_mode STREQUAL "noopt")
                set(cc_flags -n)
            endif()
            set(stem "${WORK_DIR}/${level}_${route}_${cc_mode}")
            run_checked("${RXC}" -x --no-exe-import ${import_flags} ${cc_flags}
                    --import-resolution-report "${stem}_imports.json" -o "${stem}" "${consumer_path}")
            file(READ "${stem}_imports.json" report)
            string(JSON count LENGTH "${report}" selected_candidates)
            math(EXPR last "${count} - 1")
            set(found FALSE)
            foreach(index RANGE 0 ${last})
                string(JSON module GET "${report}" selected_candidates ${index} module)
                string(JSON kind GET "${report}" selected_candidates ${index} candidate kind)
                if(module STREQUAL "numeric_nonfinite_provider" AND kind STREQUAL route)
                    set(found TRUE)
                endif()
            endforeach()
            if(NOT found)
                message(FATAL_ERROR "${stem}: requested ${route} provider not selected")
            endif()
            foreach(asm_mode IN ITEMS noopt opt)
                set(asm_flags)
                if(asm_mode STREQUAL "noopt")
                    set(asm_flags -n)
                endif()
                set(image "${stem}_${asm_mode}")
                run_checked("${RXAS}" ${asm_flags} -o "${image}" "${stem}.rxas")
                run_checked("${RXLINK}" -o "${image}_linked" "${image}.rxbin" "${provider_image}")
                foreach(runner IN LISTS runners)
                    run_output("import inf nan 0 1\n" "${runner}" "${image}_linked.rxbin" -a 1.0)
                endforeach()
            endforeach()
        endforeach()
    endforeach()
endforeach()

# An exact NaN field imported from an independent RXAS producer must retain
# its bits when inlined, as well as when called normally. Keep record identities
# and the executable return consistent; change only the special scalar value.
foreach(level IN ITEMS levelb levelg)
    file(READ "${WORK_DIR}/${level}_rxas/numeric_nonfinite_provider.rxas" provider)
    string(REGEX REPLACE ",nan(\\([0-9a-f]+\\))?," ",nan(fff8000000001234)," provider "${provider}")
    string(REGEX REPLACE "(ret +)nan(\\([0-9a-f]+\\))?([\r\n])" "\\1nan(fff8000000001234)\\3" provider "${provider}")
    foreach(route IN ITEMS rxas rxbin)
        set(import_dir "${WORK_DIR}/${level}_payload_${route}")
        file(REMOVE_RECURSE "${import_dir}")
        file(MAKE_DIRECTORY "${import_dir}")
        set(provider_stem "${import_dir}/numeric_nonfinite_provider")
        file(WRITE "${provider_stem}.rxas" "${provider}")
        run_checked("${RXAS}" -o "${provider_stem}" "${provider_stem}.rxas")
        set(provider_image "${WORK_DIR}/runtime/${level}_payload_${route}.rxbin")
        file(COPY_FILE "${provider_stem}.rxbin" "${provider_image}")
        set(import_flags -i "${import_dir}")
        if(route STREQUAL "rxas")
            file(REMOVE "${provider_stem}.rxbin")
            list(APPEND import_flags --import-rxas)
        else()
            file(REMOVE "${provider_stem}.rxas")
        endif()
        set(source "${WORK_DIR}/${level}_payload_consumer.crexx")
        file(WRITE "${source}" "options ${level} numeric_common\nimport numeric_nonfinite_provider\nmain: procedure = .int\n data = .binary\n data = '0000000000000000'x as .binary\n f = nanvalue()\n <at..float>(0) data = f\n bits = <at..int>(0) data\n say bits = -2251799813680588\n return 0\n")
        foreach(cc_mode IN ITEMS noopt opt)
            set(cc_flags)
            if(cc_mode STREQUAL "noopt")
                set(cc_flags -n)
            endif()
            set(stem "${WORK_DIR}/${level}_payload_${route}_${cc_mode}")
            run_checked("${RXC}" -x --no-exe-import ${import_flags} ${cc_flags} -o "${stem}" "${source}")
            file(READ "${stem}.rxas" assembly)
            if(cc_mode STREQUAL "opt" AND NOT assembly MATCHES "nan\\(fff8000000001234\\)")
                message(FATAL_ERROR "${stem}: exact NaN inline transport was lost or disabled")
            endif()
            foreach(asm_mode IN ITEMS noopt opt)
                set(asm_flags)
                if(asm_mode STREQUAL "noopt")
                    set(asm_flags -n)
                endif()
                set(image "${stem}_${asm_mode}")
                run_checked("${RXAS}" ${asm_flags} -o "${image}" "${stem}.rxas")
                run_checked("${RXLINK}" -o "${image}_linked" "${image}.rxbin" "${provider_image}")
                foreach(runner IN LISTS runners)
                    run_output("1\n" "${runner}" "${image}_linked.rxbin")
                endforeach()
            endforeach()
        endforeach()
    endforeach()
endforeach()

# Begin with an admitted infinity and inject the exact bits through the owning
# RXBIN API. This independently tests RXDAS output, including signaling NaNs.
# Check bits via binary storage, and integer payloads after LOAD_FLOAT/RET_FLOAT.
foreach(bits IN ITEMS 7ff0000000000000 fff0000000000000 7ff8000000000000
        7ff8000000001234 fff8000000001234 7ff0000000000001 fff0000000004321
        3fd3333333333334 8000000000000000 00000000000007e8)
    string(SUBSTRING "${bits}" 0 8 high_bits)
    string(SUBSTRING "${bits}" 8 8 low_bits)
    math(EXPR signed_bits "(0x${high_bits} << 32) | 0x${low_bits}" OUTPUT_FORMAT DECIMAL)
    set(stem "${WORK_DIR}/bits_${bits}")
    file(WRITE "${stem}.rxas" ".globals=1\nmain() .locals=6\nload r0,0x0000000000000000\nload r1,inf\nload r5,0\nbsetf64 r0,r5,r1\nbgeti64 r2,r0,r5\nieq r3,r2,${signed_bits}\nitos r3\nsay r3\nload r4,23\nload r4,inf\nitos r4\nsay r4\nload g0,0\ncall g0,give()\nitos g0\nsay g0\nret\ngive() .locals=1\nload g0,42\nret inf\n")
    run_checked("${RXAS}" -n -o "${stem}" "${stem}.rxas")
    run_checked("${MUTATE_FLOAT}" "${stem}.rxbin" "${stem}_exact.rxbin" "${bits}")
    foreach(runner IN LISTS runners)
        run_output("1\n23\n42\n" "${runner}" "${stem}_exact.rxbin")
    endforeach()
    run_checked("${RXDAS}" -o "${stem}_dump.rxas" "${stem}_exact.rxbin")
    file(READ "${stem}_dump.rxas" dump)
    if(NOT dump MATCHES "ret +[^r\n]" OR dump MATCHES "bgetf64")
        message(FATAL_ERROR "${stem}: disassembly substituted register operations")
    endif()
    foreach(asm_mode IN ITEMS noopt opt)
        set(asm_flags)
        if(asm_mode STREQUAL "noopt")
            set(asm_flags -n)
        endif()
        set(image "${stem}_roundtrip_${asm_mode}")
        run_checked("${RXAS}" ${asm_flags} -o "${image}" "${stem}_dump.rxas")
        run_checked("${RXLINK}" -o "${image}_linked" "${image}.rxbin")
        foreach(runner IN LISTS runners)
            run_output("1\n23\n42\n" "${runner}" "${image}_linked.rxbin")
        endforeach()
    endforeach()
endforeach()

# Readable literals are case insensitive. Function/label names and longer
# identifiers keep their existing tokens. Decimal overloads use provider text.
file(WRITE "${WORK_DIR}/spelling.rxas" "main() .locals=4\nload r0,+INF\nfeq r1,r0,inf\nitos r1\nsay r1\nload r0,-iNf\nflt r1,r0,0.0\nitos r1\nsay r1\nload r0,NaN\nfne r1,r0,r0\nitos r1\nsay r1\nload r2,\"0\"\nstod r2\ndadd r2,r2,inf\ndtos r2\nsay r2\nload r2,\"0\"\nstod r2\ndadd r2,r2,nan(fff8000000001234)\ndtos r2\nsay r2\ncall r3,inf()\nitos r3\nsay r3\nret\ninf() .locals=1\ninf:\nret 7\n")
foreach(asm_mode IN ITEMS noopt opt)
    set(asm_flags)
    if(asm_mode STREQUAL "noopt")
        set(asm_flags -n)
    endif()
    run_checked("${RXAS}" ${asm_flags} -o "${WORK_DIR}/spelling_${asm_mode}" "${WORK_DIR}/spelling.rxas")
    foreach(runner IN LISTS runners)
        run_output("1\n1\n1\ninf\nnan\n7\n" "${runner}" "${WORK_DIR}/spelling_${asm_mode}.rxbin")
    endforeach()
endforeach()
foreach(bad IN ITEMS "nan(7ff0000000000000)" "nan(3ff0000000000000)" "nan(7ff80000)" "nan(7ff800000000000z)")
    file(WRITE "${WORK_DIR}/bad_literal.rxas" "main() .locals=1\nload r0,${bad}\nret\n")
    foreach(asm_mode IN ITEMS noopt opt)
        set(asm_flags)
        if(asm_mode STREQUAL "noopt")
            set(asm_flags -n)
        endif()
        run_result("${RXAS}" ${asm_flags} -o "${WORK_DIR}/bad_literal" "${WORK_DIR}/bad_literal.rxas")
        if(last_result EQUAL 0 OR last_error STREQUAL "")
            message(FATAL_ERROR "Invalid special float ${bad} was accepted")
        endif()
    endforeach()
endforeach()
string(TIMESTAMP finished "%s")
math(EXPR elapsed "${finished} - ${started}")
message(STATUS "PASS: numeric values/casts/nonfinite B/G compiler/assembler/VM/import and exact RXDAS transport matrix (${elapsed} seconds)")
