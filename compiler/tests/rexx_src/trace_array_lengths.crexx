options levelb
import rxfnsb

main: procedure = .int
  arg arguments = .string[]
  index = arguments[1] as .int
  fixed = .int[10]
  zero = .string[5]
  grid = .int[3, 4]
  open = .string[]
  open[1] = "one"
  open[2] = "two"
  matrix = .int[,]
  matrix[1, 1] = 31
  matrix[1, 3] = 33
  names = .stem()
  names.live = "named"

  trace intermediates
  fixed_length = fixed[]
  zero_length = zero[0]
  grid_length = grid[1, ]
  indexed_length = grid[index, ]
  open_length = open[]
  open_zero_length = open[0]
  matrix_length = matrix[index, ]
  value = open[index]
  stem_value = names.live
  trace off
  say "RESULT" fixed_length zero_length grid_length indexed_length open_length open_zero_length matrix_length value stem_value
  return 0
