options levelb
namespace inline_receiver_storage_main expose receiver_lookups
import inline_receiver_storage_dep

main: procedure = .int
  values = .inline_receiver_storage_dep..store()

  if values.currentText() <> "outer:current" then return fail("object forwarding")
  if .inline_receiver_storage_dep..store().classAt(1) <> 11 then return fail("produced receiver read")
  if values.classAt(1) <> 11 then return fail("integer array read")
  call values.setClass(2, 42)
  if values.classAt(2) <> 42 then return fail("integer array write")
  if values.nameAt(1) <> "alpha" then return fail("string array read")
  call values.setName(2, "beta")
  if values.nameAt(2) <> "beta" then return fail("string array write")
  if values.tokenTextAt(1) <> "first" then return fail("object array read")

  call values.setByte(0, 65)
  call values.setByte(1, 66)
  if values.byteAt(0) <> 65 | values.byteAt(1) <> 66 then return fail("child binary")

  stores = .inline_receiver_storage_dep..store[2]
  stores[1] = .inline_receiver_storage_dep..store()

  receiver_lookups = .int
  receiver_lookups = 0
  if stores[pickReceiver()].classAt(1) <> 11 then return fail("computed receiver read")
  if receiver_lookups <> 1 then return fail("computed receiver read evaluated more than once")

  receiver_lookups = 0
  written = stores[pickReceiver()].setClassAndReport(1, 73)
  if receiver_lookups <> 1 then return fail("computed receiver write evaluated more than once")
  if written <> 73 then return fail("computed receiver return")
  if stores[1].classAt(1) <> 73 then return fail("computed receiver copyback")

  replacement = .int[2]
  replacement[1] = 91
  call values.replaceClasses(replacement)
  if values.classAt(1) <> 91 then return fail("retained whole-array replacement")
  escaped = values.binaryValue()
  if <at..u8>(0) escaped <> 65 then return fail("retained binary escape")

  say "PASS: imported receiver storage"
  return 0

pickReceiver: procedure = .int
  receiver_lookups = receiver_lookups + 1
  return receiver_lookups

fail: procedure = .int
  arg label = .string
  say "FAIL:" label
  return 1
