options levelb
namespace inline_receiver_guard_dep expose probe

Probe: class
  flags = .boolean[0 to 1]

  *: factory
    flags[0] = 0
    flags[1] = 1
    return

  guard: method = .boolean
    arg identity = .int
    if flags[identity] then return 1
    return 0

  caller: method = .boolean
    arg identity = .int
    return guard(identity)
