options levelb

main: procedure = .int
  constant ZERO_NATIVE = '0000000000000000'x as .binary

  data = .binary
  copy = .binary
  i = 0
  f = 0.0
  caught = 0

  call binresize data, 3 * <sizeof..float>

  <packed..int>(0) data = -7
  <packed..int>(1) data = 9223372036854775807
  if <packed..int>(0) data <> -7 then return 10
  if <packed..int>(1) data <> 9223372036854775807 then return 11

  <packed..float>(0) data = 1.5
  <packed..float>(2) data = -2.25
  if <packed..float>(0) data <> 1.5 then return 12
  if <packed..float>(2) data <> -2.25 then return 13

  /* The access, not the buffer, supplies the native interpretation. */
  <packed..int>(0) data = 0
  if <packed..float>(0) data <> 0.0 then return 14
  if <packed..int>(0) ZERO_NATIVE <> 0 then return 15

  /* Destination/index aliasing must read the item index before replacing i. */
  i = 2
  i = <packed..int>(i) data
  if i = 0 then nop

  copy = data
  <packed..float>(1) copy = 4.5
  if <packed..float>(1) copy <> 4.5 then return 16
  if <packed..float>(1) data = 4.5 then return 17

  do
    f = <packed..float>(-1) data
  on signal out_of_range
    caught = caught + 1
  end

  do
    <packed..int>(3) data = 99
  on signal out_of_range
    caught = caught + 1
  end

  do
    f = <packed..float>(9223372036854775807) data
  on signal out_of_range
    caught = caught + 1
  end

  if caught <> 3 then return 18
  if <packed..int>(0) data <> 0 then return 19
  if <blen>(data) <> 24 then return 20

  say "ok"
  return 0
