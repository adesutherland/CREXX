options levelb

main: procedure = .int
  data = '01020304'x as .binary
  span = .binary
  caught = 0

  do
    span = <at..binary(3, 2)> data
  on signal out_of_range
    caught = caught + 1
  end

  do
    span = <at..binary(-1, 0)> data
  on signal out_of_range
    caught = caught + 1
  end

  if caught <> 2 then return 1

  span = <at..binary(4, 0)> data

  say "ok"
  return 0
