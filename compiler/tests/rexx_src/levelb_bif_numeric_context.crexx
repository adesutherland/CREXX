options levelb numeric_classic
import rxfnsb
numeric digits 2
say abs('-1.2345') max('1.2345','1.2346') min('1.2345','1.2346') sign('-0.00012345')
say trunc('12.3456',3) format('12.3456',,3)
call nested
say format('12.3456',,3)
return
nested: procedure
  numeric digits 5
  numeric form engineering
  say abs('-1234567') max('1234567','1234544')
  say trunc('12.3456',3) format('12.3456',,3)
  return
