options levelb

main: procedure = .int
  i = .int

  do i = 1 to 3
    say duplicate_case(i)
    say dynamic_case(i, i + 10)
  end
  return 0

duplicate_case: procedure = .int
  arg value = .int

  select value
    when 1 then return 10
    when 1 then return 11
    when 2 then return 20
    otherwise return -1
  end
  return -2

dynamic_case: procedure = .int
  arg value = .int, dynamic = .int

  select value
    when 1 then return 10
    when dynamic then return 20
    when 3 then return 30
    otherwise return -1
  end
  return -2
