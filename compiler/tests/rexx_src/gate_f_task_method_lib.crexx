options levelg
namespace gate_f_task_method_lib expose workbox answerbox

answerbox: class
  _answer = .int

  *: factory
    arg answer = .int
    _answer = answer
    return

  from_channel: factory
    arg encoded = .channelvalue
    _answer = encoded.as_integer()
    return

  to_channel: method = .channelvalue
    return .channelvalue.integer_value(_answer)

  answer: method = .int
    return _answer

workbox: class
  _base = .int

  *: factory
    arg base = .int
    _base = base
    return

  from_channel: factory
    arg encoded = .channelvalue
    _base = encoded.as_integer()
    return

  to_channel: method = .channelvalue
    return .channelvalue.integer_value(_base)

  increment: task = .int
    arg value = .int
    return _base + value

  result: task = .answerbox
    arg value = .int
    return .answerbox(_base + value)
