options levelg
namespace gate_f_task_method_lib expose workbox

workbox: class
  _base = .int

  *: factory
    arg base = .int
    _base = base
    return

  from_channel: factory
    arg encoded = .channelvalue
    _base = encoded.as_integer()
    return

  to_channel: method = .channelvalue
    return .channelvalue.integer_value(_base)

  increment: task = .int
    arg value = .int
    return _base + value
