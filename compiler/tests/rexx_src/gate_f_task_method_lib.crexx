options levelg
namespace gate_f_task_method_lib expose workbox answerbox inputbox

inputbox: class
  _value = .int

  *: factory
    arg value = .int
    _value = value
    return

  from_channel: factory
    arg encoded = .channelvalue
    _value = encoded.field("value").as_integer()
    return

  to_channel: method = .channelvalue
    names = .string[1]
    values = .channelvalue[1]
    names[1] = "value"
    values[1] = .channelvalue.integer_value(_value)
    return .channelvalue.record_value("gate-f.input", 1, names, values)

  value: method = .int
    return _value

answerbox: class
  _answer = .int

  *: factory
    arg answer = .int
    _answer = answer
    return

  from_channel: factory
    arg encoded = .channelvalue
    _answer = encoded.as_integer()
    return

  to_channel: method = .channelvalue
    return .channelvalue.integer_value(_answer)

  answer: method = .int
    return _answer

workbox: class
  _base = .int

  *: factory
    arg base = .int
    _base = base
    return

  from_channel: factory
    arg encoded = .channelvalue
    _base = encoded.as_integer()
    return

  to_channel: method = .channelvalue
    return .channelvalue.integer_value(_base)

  increment: task = .int
    arg value = .int
    return _base + value

  result: task = .answerbox
    arg value = .int
    return .answerbox(_base + value)

  add: task = .int
    arg value = .inputbox
    return _base + value.value()

  inspect: task = .int
    arg value = .channelvalue
    return _base + value.field("value").as_integer()
