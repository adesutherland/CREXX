options levelb
import rxfnsb
namespace reference_source_dereference_live

main: procedure = .int
  left = .int
  right = .int
  left_ref = reference .int
  right_ref = reference .int

  left = 1
  right = 2
  left_ref = reference left
  right_ref = reference right
  if <refvalid>(left_ref) = 0 | <refvalid>(right_ref) = 0 then return fail("initial refvalid")

  do
    linked = dereference left_ref
    linked = 10
    linked = dereference right_ref
    linked = 20
  end

  if left <> 10 then return fail("left write through")
  if right <> 20 then return fail("right write through")

  left_copy = snapshot left_ref
  left = 11
  if left_copy <> 10 then return fail("snapshot stable")

  returned = returnLinked(left_ref)
  if returned <> 12 then return fail("return linked value")
  if left <> 12 then return fail("return linked target")

  if expectInvalid(makeDeadRef()) <> 1 then return fail("invalid dereference signal")

  /* A linked scalar is observable through its owner even when the local is
   * never read again. These writes must survive optimized dead-store analysis. */
  integer_owner = .int; integer_owner = 3
  integer_ref = reference integer_owner
  call storeLinkedInteger(integer_ref,41,0)
  if integer_owner <> 3 then return fail("untaken linked integer store")
  call storeLinkedInteger(integer_ref,41,1)
  if integer_owner <> 41 then return fail("linked integer argument store")

  boolean_owner = .boolean; boolean_owner = 0
  boolean_ref = reference boolean_owner
  call storeLinkedBoolean(boolean_ref,1,1)
  if boolean_owner <> 1 then return fail("linked boolean argument store")
  call storeLinkedBoolean(boolean_ref,1,0)
  if boolean_owner <> 0 then return fail("linked boolean alternate store")

  float_owner = .float; float_owner = 1.5
  float_ref = reference float_owner
  call storeLinkedFloat(float_ref,2.5)
  if float_owner <> 2.5 then return fail("scoped linked float argument store")

  /* Copying a linked value captures its current value. Reading the link after
   * a direct owner write must instead observe that newer value. */
  do
    observed = dereference integer_ref
    before = observed
    integer_owner = 42
    if before <> 41 | observed <> 42 then return fail("linked read versus value copy")
  end

  say "PASS: Reference Source Dereference Live"
  return 0

storeLinkedInteger: procedure = .void
  arg target = reference .int, source = .int, chooseWrite = .boolean
  linked = dereference target
  requested = linkedIdentity(source)
  if chooseWrite then linked = requested
  return

storeLinkedBoolean: procedure = .void
  arg target = reference .boolean, source = .boolean, chooseWrite = .boolean
  linked = dereference target
  if chooseWrite then linked = source
  else linked = 0
  return

storeLinkedFloat: procedure = .void
  arg target = reference .float, source = .float
  do
    linked = dereference target
    linked = source
  end
  return

/* Ordinary scalar inlining must coexist with the caller's live linked store. */
linkedIdentity: procedure = .int
  arg value = .int
  return value

returnLinked: procedure = .int
  arg r = reference .int
  linked = dereference r
  linked = linked + 1
  return linked

makeDeadRef: procedure = reference .int
  value = .int
  value = 99
  return reference value

expectInvalid: procedure = .int
  arg r = reference .int
  caught = 0
  do
    linked = dereference r
    linked = 1
  on signal reference_invalid as problem
    if problem.name() = "REFERENCE_INVALID" then caught = 1
  end
  return caught

fail: procedure = .int
  arg label = .string
  say "FAIL:" label
  return 1
