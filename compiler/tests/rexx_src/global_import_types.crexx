options levelb
import rxfnsb
namespace global_import_types expose Make Read

Make: procedure = .void expose state labels grid boxes
  state = .stem()
  state["text"] = "hello"
  labels = .string[]
  labels[1] = "value"
  grid = .int[-2 to 2, 1 to 3]
  grid[-2, 1] = 42
  boxes = .stem[]
  box = .stem()
  box["number"] = "7"
  boxes[1] = box
  return

Read: procedure = .string expose state labels grid boxes
  box = boxes[1]
  return state["text"] || ":" || labels[1] || ":" || grid[-2, 1] || ":" || box["number"]
