file(MAKE_DIRECTORY "${WORK}")
set(compiler_flags)
set(assembler_flags)
if(COMPILER_NOOPT)
    list(APPEND compiler_flags -n)
endif()
if(ASSEMBLER_NOOPT)
    list(APPEND assembler_flags -n)
endif()
set(base "${WORK}/iterate_condition_cleanup")
execute_process(COMMAND "${RXC}" -i "${IMPORT_DIR}" ${compiler_flags}
        -o "${base}" "${SOURCE}"
        OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "rxc failed:\n${out}${err}")
endif()
file(READ "${base}.rxas" image)
foreach(accessor IN ITEMS queued pending)
    if(image MATCHES "call[0-9]* [^\n]*iterate_condition_cleanup\\.counter\\.${accessor}\\(\\)")
        if(NOT COMPILER_NOOPT)
            message(FATAL_ERROR "Optimized accessor ${accessor} was not inlined")
        endif()
    elseif(COMPILER_NOOPT)
        message(FATAL_ERROR "Noopt control lost the ${accessor} call")
    endif()
endforeach()
execute_process(COMMAND "${RXAS}" ${assembler_flags} -o "${base}.rxbin" "${base}"
        OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "rxas failed:\n${out}${err}")
endif()
execute_process(COMMAND "${RXLINK}" -s -o "${WORK}/linked"
        "${base}.rxbin" "${LIBRARY}"
        OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "rxlink failed:\n${out}${err}")
endif()
execute_process(COMMAND "${RXVM}" "${WORK}/linked.rxbin"
        OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
string(REPLACE "\r\n" "\n" out "${out}")
if(NOT rc EQUAL 0 OR NOT out STREQUAL "modal on second turn=1\n")
    message(FATAL_ERROR "ITERATE condition cleanup failed (exit ${rc}):\n${out}${err}")
endif()
