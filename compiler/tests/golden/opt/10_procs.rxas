/*
 * SOURCE                 : 10_procs.crexx
 */

.globals=0

main() .locals=2
   .meta "10_procs.main"="b" ".void" main() ""
   numsci 18,1,1
   .srcstep 1 1 17 "10_procs.crexx" 3 1 17 "say \"Main Start\""
   say "Main Start"
   .srcstep 4 4 17 "10_procs.crexx" 4 1 15 "call MyProc 10"
   .srcstep 2 2 33 "10_procs.crexx" 9 7 8 "  arg x = .int"
   load r0,10
   .traceevent "L" 4 "R" "I" "r" 0 2 2 0 "" ""
   .traceevent "A" 6 "R" "I" "r" 0 2 2 0 "x" ""
   .srcstep 3 3 17 "10_procs.crexx" 10 3 22 "  say \"Inside Proc\" x"
   itos r0
   .traceevent "V" 6 "R" "S" "r" 0 3 3 0 "x" ""
   sconcat r1,"Inside Proc",r0
   .traceevent "O" 4 "R" "S" "r" 1 3 3 0 "" ""
   say r1
   .srcstep 5 5 17 "10_procs.crexx" 5 1 15 "say \"Main End\""
   say "Main End"
   .srcstep 6 6 17 "10_procs.crexx" 6 1 7 "return"
   ret
