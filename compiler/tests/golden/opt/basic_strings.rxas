main() .locals=5
   .meta "basic_strings.main"="b" ".void" main() ""
   numsci 18,1,1
   .srcstep 1 1 17 "basic_strings.crexx" 6 1 6 "say c"
   .meta "basic_strings.main.a"="b" ".string" "Hello"
   .meta "basic_strings.main.b"="b" ".string" "World"
   .meta "basic_strings.main.c"="b" ".string" "Hello World"
   say "Hello World"
   .srcstep 2 2 17 "basic_strings.crexx" 9 1 6 "say d"
   .meta "basic_strings.main.d"="b" ".string" "Hello   World"
   say "Hello   World"
   .srcstep 3 3 17 "basic_strings.crexx" 11 1 14 "say length(c)"
   say "11"
   .srcstep 4 4 17 "basic_strings.crexx" 12 1 20 "say substr(c, 1, 5)"
