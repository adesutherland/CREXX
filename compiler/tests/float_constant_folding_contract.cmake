cmake_minimum_required(VERSION 3.24)

foreach(required IN ITEMS RXC RXAS RXLINK RXBVM SOURCE_DIR WORK_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing -D${required}=...")
    endif()
endforeach()

file(MAKE_DIRECTORY "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}/runtime")
file(WRITE "${WORK_DIR}/commands.log" "")
set(runners "${RXBVM}")
if(DEFINED RXTVM AND NOT RXTVM STREQUAL "")
    list(APPEND runners "${RXTVM}")
endif()

function(run_checked)
    execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${WORK_DIR}"
            OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE result)
    string(JOIN " " command ${ARGV})
    file(APPEND "${WORK_DIR}/commands.log"
            "${command}\nexit=${result}\n${out}${err}\n")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${command} failed (${result}):\n${out}${err}")
    endif()
    # Successful compilers/assemblers/linkers should not conceal diagnostics.
    if(NOT err STREQUAL "")
        message(FATAL_ERROR "${command} emitted diagnostics:\n${err}")
    endif()
    set(last_output "${out}" PARENT_SCOPE)
endfunction()

function(run_matrix stem expected)
    foreach(asm_mode IN ITEMS noopt opt)
        set(asm_flags)
        if(asm_mode STREQUAL "noopt")
            set(asm_flags -n)
        endif()
        set(image "${stem}_${asm_mode}")
        run_checked("${RXAS}" ${asm_flags} -o "${image}" "${stem}.rxas")
        # Linking exercises shared-pool transport for both assembler modes.
        run_checked("${RXLINK}" -o "${image}_linked" "${image}.rxbin" ${ARGN})
        foreach(runner IN LISTS runners)
            run_checked("${runner}" "${image}_linked.rxbin" -a 0.1 0.2 0.3)
            string(REPLACE "\r\n" "\n" actual "${last_output}")
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR
                        "${runner}/${image} mismatch:\nExpected:\n${expected}Actual:\n${actual}")
            endif()
        endforeach()
    endforeach()
endfunction()

file(READ "${SOURCE_DIR}/float_constant_folding.expected" expected)
set(import_expected "imported 0 1 1 1\n")

foreach(level IN ITEMS levelb levelg)
    file(READ "${SOURCE_DIR}/float_constant_folding.crexx" source)
    string(REPLACE "options levelb" "options ${level}" source "${source}")
    set(source_path "${WORK_DIR}/${level}.crexx")
    file(WRITE "${source_path}" "${source}")
    foreach(cc_mode IN ITEMS noopt opt)
        set(cc_flags)
        if(cc_mode STREQUAL "noopt")
            set(cc_flags -n)
        endif()
        set(stem "${WORK_DIR}/${level}_${cc_mode}")
        run_checked("${RXC}" -x --no-exe-import ${cc_flags}
                -o "${stem}" "${source_path}")
        file(READ "${stem}.rxas" assembly)
        if(NOT assembly MATCHES "0\\.30000000000000004")
            message(FATAL_ERROR "${stem}: exact typed float transport missing")
        endif()
        string(REGEX MATCHALL "\n[ \t]+fadd " adds "${assembly}")
        list(LENGTH adds add_count_${cc_mode})
        run_matrix("${stem}" "${expected}")
    endforeach()
    if(add_count_opt LESS 1 OR NOT add_count_opt LESS add_count_noopt)
        message(FATAL_ERROR
                "${level}: expected retained runtime fadd and enabled constant folding; "
                "noopt=${add_count_noopt}, opt=${add_count_opt}")
    endif()

    # Import a folded return through source, RXAS and RXBIN inline payloads.
    # Each route is isolated so discovery cannot silently pick a source sibling.
    file(READ "${SOURCE_DIR}/float_fold_provider.crexx" provider)
    string(REPLACE "options levelb" "options ${level}" provider "${provider}")
    foreach(route IN ITEMS source rxas rxbin)
        set(import_dir "${WORK_DIR}/${level}_${route}")
        file(REMOVE_RECURSE "${import_dir}")
        file(MAKE_DIRECTORY "${import_dir}")
        set(provider_stem "${import_dir}/float_fold_provider")
        file(WRITE "${provider_stem}.crexx" "${provider}")
        run_checked("${RXC}" -x --no-exe-import
                -o "${provider_stem}" "${provider_stem}.crexx")
        run_checked("${RXAS}" -o "${provider_stem}" "${provider_stem}.rxas")
        set(provider_image "${WORK_DIR}/runtime/${level}_${route}_provider.rxbin")
        file(RENAME "${provider_stem}.rxbin" "${provider_image}")
        if(NOT route STREQUAL "source")
            file(REMOVE "${provider_stem}.crexx")
        endif()
        set(import_flags)
        if(route STREQUAL "rxas")
            list(APPEND import_flags --import-rxas -i "${import_dir}")
        elseif(route STREQUAL "rxbin")
            # This route requires the image in the binary search root.
            file(COPY_FILE "${provider_image}" "${provider_stem}.rxbin")
            list(APPEND import_flags -i "${import_dir}")
        else()
            list(APPEND import_flags -s "${import_dir}")
        endif()
        if(route STREQUAL "source")
            file(REMOVE "${provider_stem}.rxas")
        elseif(route STREQUAL "rxbin")
            file(REMOVE "${provider_stem}.rxas")
        endif()
        file(READ "${SOURCE_DIR}/float_fold_consumer.crexx" consumer)
        string(REPLACE "options levelb" "options ${level}" consumer "${consumer}")
        set(consumer_path "${WORK_DIR}/${level}_${route}_consumer.crexx")
        file(WRITE "${consumer_path}" "${consumer}")
        foreach(cc_mode IN ITEMS noopt opt)
            set(cc_flags)
            if(cc_mode STREQUAL "noopt")
                set(cc_flags -n)
            endif()
            set(stem "${WORK_DIR}/${level}_${route}_${cc_mode}")
            run_checked("${RXC}" -x --no-exe-import ${import_flags} ${cc_flags}
                    --import-resolution-report "${stem}_imports.json"
                    -o "${stem}" "${consumer_path}")
            file(READ "${stem}_imports.json" report)
            string(JSON count LENGTH "${report}" selected_candidates)
            math(EXPR last "${count} - 1")
            set(found FALSE)
            foreach(index RANGE 0 ${last})
                string(JSON module GET "${report}" selected_candidates ${index} module)
                string(JSON kind GET "${report}" selected_candidates ${index} candidate kind)
                if(module STREQUAL "float_fold_provider" AND kind STREQUAL route)
                    set(found TRUE)
                endif()
            endforeach()
            if(NOT found)
                message(FATAL_ERROR "${stem}: requested ${route} provider not selected")
            endif()
            run_matrix("${stem}" "${import_expected}" "${provider_image}")
        endforeach()
    endforeach()
endforeach()
message(STATUS "PASS: typed float folding B/G compiler/assembler/VM and import matrix")
