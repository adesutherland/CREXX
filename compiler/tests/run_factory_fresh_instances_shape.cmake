foreach(required IN ITEMS RXC SOURCE WRAPPER_SOURCE WORK)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
foreach(mode IN ITEMS noopt opt)
    set(flags)
    if(mode STREQUAL "noopt")
        list(APPEND flags -n)
    endif()
    execute_process(
        COMMAND "${RXC}" ${flags} -x --no-exe-import
                -o "${WORK}/${mode}" "${SOURCE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0 OR NOT out STREQUAL "" OR NOT err STREQUAL "")
        message(FATAL_ERROR "Factory ${mode} compile failed (${result}):\n${out}${err}")
    endif()
    file(READ "${WORK}/${mode}.rxas" assembly)
    string(REPLACE "\n" ";" lines "${assembly}")
    set(in_main FALSE)
    set(main "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^[^ \t].*[.]locals=")
            if(line MATCHES "^main[(][)] [.]locals=")
                set(in_main TRUE)
            else()
                set(in_main FALSE)
            endif()
        endif()
        if(in_main)
            string(APPEND main "${line}\n")
        endif()
    endforeach()
    if(NOT main)
        message(FATAL_ERROR "Missing ${mode} main body")
    endif()
    if(mode STREQUAL "noopt")
        if(NOT main MATCHES "call1[ \t]+[^\n]*fresh[.]§factory")
            message(FATAL_ERROR "No-opt control must call an ordinary constructor")
        endif()
    else()
        if(main MATCHES "call[0-9]*[ \t]+[^\n]*fresh[.]§factory")
            message(FATAL_ERROR "Supported constructor controls must remain inlined")
        endif()
        if(NOT main MATCHES "[ \t]setattrs r[0-9]+,[0-9]+")
            message(FATAL_ERROR "Optimized main did not exercise inline construction")
        endif()
    endif()

    # Derive the receiver from each allocation instead of pinning registers or
    # attribute layout. SETATTRS preserves fields and cannot establish freshness.
    string(REGEX MATCHALL "[ \t]setattrs r[0-9]+,[0-9]+" allocations "${assembly}")
    if(NOT allocations)
        message(FATAL_ERROR "Missing ${mode} factory allocation")
    endif()
    set(previous "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^[ \t]+setattrs (r[0-9]+),[0-9]+")
            set(receiver "${CMAKE_MATCH_1}")
            if(NOT previous MATCHES "^[ \t]+null ${receiver}[ \t]*$")
                message(FATAL_ERROR "${mode} receiver ${receiver} is not fresh before allocation")
            endif()
        endif()
        if(line MATCHES "^[ \t]+[a-z][a-z0-9]*[ \t]+")
            set(previous "${line}")
        endif()
    endforeach()
endforeach()
execute_process(
    COMMAND "${RXC}" -x --no-exe-import
            -o "${WORK}/wrapper" "${WRAPPER_SOURCE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0 OR NOT out STREQUAL "" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Factory wrapper compile failed (${result}):\n${out}${err}")
endif()
file(READ "${WORK}/wrapper.rxas" wrapper)
if(wrapper MATCHES "call[0-9]*[ \t]+[^\n]*buildBox[(][)]")
    message(FATAL_ERROR "Fresh receiver setup displaced supported factory-wrapper inlining")
endif()
message(STATUS "Ordinary and inline factories initialize fresh receiver storage")
