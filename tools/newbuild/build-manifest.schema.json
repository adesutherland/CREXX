{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crexx.org/schemas/build-manifest-v1.json",
  "title": "cREXX staged build manifest",
  "description": "Versioned action and QA graph consumed by future CMake adapters and the Level B runner. Phase 0 projections are explicitly not executable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "source_commit",
    "configuration",
    "actions",
    "tests"
  ],
  "properties": {
    "schema_version": {
      "const": "crexx.build-manifest/v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "observed-provisional-not-executable",
        "draft",
        "executable"
      ]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "configuration": {
      "type": "object"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test"
      }
    }
  },
  "$defs": {
    "product_layer": {
      "type": "string",
      "enum": [
        "C0",
        "C1",
        "B0",
        "X",
        "B1",
        "C",
        "G",
        "L",
        "Product",
        "Optional"
      ]
    },
    "qa_tier": {
      "type": "string",
      "enum": [
        "none",
        "graph",
        "essential",
        "smoke",
        "comprehensive",
        "qualification",
        "stress",
        "measurement"
      ]
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "product_layer",
        "wave",
        "qa_tier",
        "tool",
        "argv",
        "inputs",
        "outputs",
        "byproducts",
        "needs",
        "import_policy",
        "metadata_policy",
        "work_dir",
        "resources",
        "qa_tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "product_layer": {
          "$ref": "#/$defs/product_layer"
        },
        "wave": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "qa_tier": {
          "$ref": "#/$defs/qa_tier"
        },
        "tool": {
          "type": "string"
        },
        "argv": {
          "$ref": "#/$defs/string_array"
        },
        "inputs": {
          "$ref": "#/$defs/string_array"
        },
        "outputs": {
          "$ref": "#/$defs/string_array"
        },
        "byproducts": {
          "$ref": "#/$defs/string_array"
        },
        "needs": {
          "$ref": "#/$defs/string_array"
        },
        "import_policy": {
          "type": "object",
          "required": [
            "status",
            "source_roots",
            "binary_roots",
            "allowed_kinds"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "not-observed",
                "observed",
                "declared"
              ]
            },
            "source_roots": {
              "$ref": "#/$defs/string_array"
            },
            "binary_roots": {
              "$ref": "#/$defs/string_array"
            },
            "allowed_kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "source",
                  "rxas",
                  "rxbin",
                  "rxplugin"
                ]
              },
              "uniqueItems": true
            }
          }
        },
        "metadata_policy": {
          "type": "object",
          "required": [
            "status",
            "required",
            "preserved",
            "stripped"
          ]
        },
        "work_dir": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "required": [
            "cpu",
            "memory_weight",
            "io_weight",
            "exclusive"
          ]
        },
        "qa_tags": {
          "$ref": "#/$defs/string_array"
        },
        "observations": {
          "type": "object"
        }
      }
    },
    "test": {
      "type": "object",
      "required": [
        "id",
        "name",
        "product_layer",
        "wave",
        "qa_tier",
        "labels",
        "fixtures_setup",
        "fixtures_required",
        "fixtures_cleanup",
        "resource_locks",
        "run_serial"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "product_layer": {
          "$ref": "#/$defs/product_layer"
        },
        "wave": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "qa_tier": {
          "$ref": "#/$defs/qa_tier"
        },
        "labels": {
          "$ref": "#/$defs/string_array"
        },
        "fixtures_setup": {},
        "fixtures_required": {},
        "fixtures_cleanup": {},
        "resource_locks": {},
        "run_serial": {
          "type": "boolean"
        },
        "timeout_seconds": {},
        "observations": {
          "type": "object"
        }
      }
    }
  }
}
