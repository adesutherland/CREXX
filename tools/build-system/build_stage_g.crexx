/*
 * Level G dependency-wave builder.
 *
 * This Level B controller owns the explicit dependency waves, action keys and
 * publication policy.  CMake owns the native and Level B bootstrap.  The
 * imported worker adapter supplies only a compiler-sealed task target.
 */
options levelb comments_dash

namespace crexx_stage_g_builder
import rxfnsb
import concurrency
import rxhash
import crexx_stage_g_worker

show_command_failure: procedure = .void
  arg action = .string, command_rc = .int, captured = .string[], errors = .string[]
  i = .int
  say "FAILED:" action "rc=" || command_rc
  do i = 1 to captured[0]
    say captured[i]
  end
  do i = 1 to errors[0]
    say errors[i]
  end
  return

run_argv: procedure = .int
  arg action = .string, argv = .string[]
  captured = .string[]
  errors = .string[]
  address crexx "run :argv[]" output captured error errors
  command_rc = rc
  if command_rc <> 0 then call show_command_failure action, command_rc, captured, errors
  return command_rc

remove_tree: procedure = .int
  arg cmake = .string, path = .string
  command = .string[]
  call arrayappend command, cmake
  call arrayappend command, "-E"
  call arrayappend command, "rm"
  call arrayappend command, "-rf"
  call arrayappend command, path
  return run_argv("remove " || path, command)

make_directory: procedure = .int
  arg cmake = .string, path = .string
  command = .string[]
  call arrayappend command, cmake
  call arrayappend command, "-E"
  call arrayappend command, "make_directory"
  call arrayappend command, path
  return run_argv("make directory " || path, command)

copy_file: procedure = .int
  arg cmake = .string, source = .string, destination = .string
  command = .string[]
  call arrayappend command, cmake
  call arrayappend command, "-E"
  call arrayappend command, "copy"
  call arrayappend command, source
  call arrayappend command, destination
  return run_argv("copy " || source, command)

read_stamp: procedure = .string
  arg path = .string
  do
    return readbinary(path) as .string
  on signal
    return ""
  end
  return ""

file_hash: procedure = .string
  arg path = .string
  do
    return rxhash..sha256filehex(path)
  on signal
    return ""
  end
  return ""

key_update_text: procedure = .binary
  arg state = .binary, text = .string
  state = rxhash..sha256update(state, text as .binary)
  state = rxhash..sha256update(state, '00'x as .binary)
  return state

action_key: procedure = .string
  arg seed = .string, path1 = "", path2 = "", path3 = "", path4 = "", path5 = "", path6 = "", path7 = "", path8 = "", path9 = "", path10 = ""
  paths = .string[]
  paths[1] = path1
  paths[2] = path2
  paths[3] = path3
  paths[4] = path4
  paths[5] = path5
  paths[6] = path6
  paths[7] = path7
  paths[8] = path8
  paths[9] = path9
  paths[10] = path10

  state = rxhash..sha256init()
  state = key_update_text(state, "crexx-stage-g/v1")
  state = key_update_text(state, seed)
  do i = 1 to paths[0]
    if paths[i] <> "" then state = key_update_text(state, rxhash..sha256filehex(paths[i]))
  end
  return rxhash..sha256finalhex(state)

action_current: procedure = .int
  arg output = .string, stamp = .string, key = .string
  if file_hash(output) = "" then return 0
  return read_stamp(stamp) = key

compile_request: procedure = .channelvalue
  arg name = .string, source = .string, work_dir = .string, import_roots = .string, rxc = .string, rxas = .string, cmake = .string, key = .string, compiler_exits = .int
  names = .string[]
  values = .channelvalue[]
  names[1] = "cmake"
  values[1] = .channelvalue.string_value(cmake)
  names[2] = "compilerExits"
  values[2] = .channelvalue.integer_value(compiler_exits)
  names[3] = "importRoots"
  values[3] = .channelvalue.string_value(import_roots)
  names[4] = "key"
  values[4] = .channelvalue.string_value(key)
  names[5] = "name"
  values[5] = .channelvalue.string_value(name)
  names[6] = "rxas"
  values[6] = .channelvalue.string_value(rxas)
  names[7] = "rxc"
  values[7] = .channelvalue.string_value(rxc)
  names[8] = "source"
  values[8] = .channelvalue.string_value(source)
  names[9] = "workDir"
  values[9] = .channelvalue.string_value(work_dir)
  return .channelvalue.record_value("crexx.build.stage-g.compile", 1, names, values)

argv_value: procedure = .channelvalue
  arg argv = .string[]
  values = .channelvalue[]
  do i = 1 to argv[0]
    values[i] = .channelvalue.string_value(argv[i])
  end
  return .channelvalue.array_value(values)

command_request: procedure = .channelvalue
  arg label = .string, work_dir = .string, output = .string, stamp = .string, cmake = .string, key = .string, argv = .string[]
  names = .string[]
  values = .channelvalue[]
  names[1] = "argv"
  values[1] = argv_value(argv)
  names[2] = "cmake"
  values[2] = .channelvalue.string_value(cmake)
  names[3] = "key"
  values[3] = .channelvalue.string_value(key)
  names[4] = "label"
  values[4] = .channelvalue.string_value(label)
  names[5] = "output"
  values[5] = .channelvalue.string_value(output)
  names[6] = "stamp"
  values[6] = .channelvalue.string_value(stamp)
  names[7] = "workDir"
  values[7] = .channelvalue.string_value(work_dir)
  return .channelvalue.record_value("crexx.build.stage-g.command", 1, names, values)

queue_compile: procedure = .int
  arg expose requests = .channelvalue[], name = .string, source = .string, work_dir = .string, import_roots = .string, rxc = .string, rxas = .string, cmake = .string, key = .string, compiler_exits = .int
  output = work_dir || "/" || name || ".rxbin"
  stamp = work_dir || "/action.sha256"
  if action_current(output, stamp, key) then do
    say "SKIP: G member" name
    return 0
  end
  requests[requests[0] + 1] = compile_request(name, source, work_dir, import_roots, rxc, rxas, cmake, key, compiler_exits)
  return 0

queue_command: procedure = .int
  arg expose requests = .channelvalue[], label = .string, work_dir = .string, output = .string, stamp = .string, cmake = .string, key = .string, argv = .string[]
  if action_current(output, stamp, key) then do
    say "SKIP:" label
    return 0
  end
  requests[requests[0] + 1] = command_request(label, work_dir, output, stamp, cmake, key, argv)
  return 0

run_task_wave: procedure = .int
  arg pool = .taskpool, target = .tasktarget, requests = .channelvalue[], label = .string
  i = .int
  if requests[0] = 0 then return 0

  say "WAVE:" label "jobs=" || requests[0]
  scope = .taskscope.collectall(pool, -1)
  children = .task[]
  do i = 1 to requests[0]
    children[i] = scope.submit(target, requests[i])
  end
  completed = scope.join()
  call scope.close()

  failures = 0
  do i = 1 to completed[0]
    if completed[i].succeeded() = 0 then do
      say "FAILED:" label "task" i "code=" || completed[i].error_code() completed[i].message()
      failures = failures + 1
    end
    else if completed[i].value().as_integer() <> 0 then failures = failures + 1
  end
  return failures <> 0

reset_import_root: procedure = .int
  arg cmake = .string, root = .string
  if remove_tree(cmake, root) <> 0 then return 1
  return make_directory(cmake, root)

stage_import: procedure = .int
  arg cmake = .string, root = .string, source = .string, published_name = .string
  return copy_file(cmake, source, root || "/" || published_name)

prepare_import_root: procedure = .int
  arg cmake = .string, root = .string, source1 = "", name1 = "", source2 = "", name2 = "", source3 = "", name3 = "", source4 = "", name4 = "", source5 = "", name5 = "", source6 = "", name6 = ""
  sources = .string[]
  names = .string[]
  sources[1] = source1
  sources[2] = source2
  sources[3] = source3
  sources[4] = source4
  sources[5] = source5
  sources[6] = source6
  names[1] = name1
  names[2] = name2
  names[3] = name3
  names[4] = name4
  names[5] = name5
  names[6] = name6
  if reset_import_root(cmake, root) <> 0 then return 1
  do i = 1 to sources[0]
    if sources[i] <> "" then do
      if stage_import(cmake, root, sources[i], names[i]) <> 0 then return 1
    end
  end
  return 0

write_link_control: procedure = .int
  arg path = .string, output_base = .string, modules = .string[], selectors = .string[], configuration = .string
  i = .int
  newline = '0a'x as .string
  content = "* Generated by the Level G dependency-wave builder" || newline
  do i = 1 to modules[0]
    content = content || "INPUT " || modules[i] || newline
  end
  do i = 1 to selectors[0]
    content = content || "INCLUDE " || selectors[i] || newline
  end
  content = content || "PRESERVE INLINE" || newline
  if upper(configuration) <> "DEBUG" then content = content || "STRIP SOURCE" || newline
  content = content || "OUTPUT " || output_base || newline
  return writebinary(path, content as .binary) <> length(content)

link_library: procedure = .int
  arg work_root = .string, bin_dir = .string, rxlink = .string, cmake = .string, configuration = .string, modules = .string[], selectors = .string[], key = .string

  link_dir = work_root || "/linked"
  linked_image = link_dir || "/rxfnsg.rxbin"
  stamp = link_dir || "/action.sha256"
  if action_current(linked_image, stamp, key) = 0 then do
    if remove_tree(cmake, link_dir) <> 0 then return 1
    if make_directory(cmake, link_dir) <> 0 then return 1
    control = link_dir || "/rxfnsg.ctl"
    if write_link_control(control, link_dir || "/rxfnsg", modules, selectors, configuration) <> 0 then return 1
    command = .string[]
    call arrayappend command, rxlink
    call arrayappend command, "-c"
    call arrayappend command, control
    if run_argv("link Level G library", command) <> 0 then return 1
    written = writebinary(stamp || ".tmp", key as .binary)
    if written <> length(key) then return 1
    rename_stamp = .string[]
    call arrayappend rename_stamp, cmake
    call arrayappend rename_stamp, "-E"
    call arrayappend rename_stamp, "rename"
    call arrayappend rename_stamp, stamp || ".tmp"
    call arrayappend rename_stamp, stamp
    if run_argv("publish Level G link stamp", rename_stamp) <> 0 then return 1
    say "BUILT: Level G library"
  end
  else say "SKIP: Level G link"

  published = bin_dir || "/rxfnsg.rxbin"
  published_hash = file_hash(published)
  linked_hash = file_hash(linked_image)
  if published_hash <> "" & published_hash = linked_hash then do
    say "SKIP: Level G publish"
    return 0
  end

  temporary = published || ".tmp"
  if copy_file(cmake, linked_image, temporary) <> 0 then return 1
  rename_command = .string[]
  call arrayappend rename_command, cmake
  call arrayappend rename_command, "-E"
  call arrayappend rename_command, "rename"
  call arrayappend rename_command, temporary
  call arrayappend rename_command, published
  if run_argv("publish Level G library", rename_command) <> 0 then return 1
  say "PUBLISHED: " || published
  return 0

main: procedure = .int
  arg arguments = .string[]
  i = .int
  if arguments[0] <> 11 then do
    say "usage: build_stage_g source-dir work-root bin-dir rxc rxas rxlink rxbvm cmake configuration jobs scope"
    return 2
  end

  source_dir = arguments[1]
  work_root = arguments[2]
  bin_dir = arguments[3]
  rxc = arguments[4]
  rxas = arguments[5]
  rxlink = arguments[6]
  rxbvm = arguments[7]
  cmake = arguments[8]
  configuration = arguments[9]
  jobs = arguments[10] as .int
  scope_name = lower(arguments[11])
  if jobs < 1 then return 2
  if scope_name <> "base" & scope_name <> "all" then do
    say "unsupported Level G scope:" scope_name
    return 2
  end

  if make_directory(cmake, work_root) <> 0 then return 1
  members_root = work_root || "/members"
  imports_root = work_root || "/imports"
  base_imports = imports_root || "/base"
  library = bin_dir || "/library.rxbin"
  classlib = bin_dir || "/classlib.rxbin"

  if reset_import_root(cmake, base_imports) <> 0 then return 1
  if stage_import(cmake, base_imports, library, "library.rxbin") <> 0 then return 1
  if stage_import(cmake, base_imports, classlib, "classlib.rxbin") <> 0 then return 1

  tool_identity = action_key("compile-tools", rxc, rxas)
  integer_source = source_dir || "/integer.crexx"
  decimal_source = source_dir || "/decimal.crexx"
  packednumeric_source = source_dir || "/packednumeric.crexx"
  statsvalue_source = source_dir || "/statsvalue.crexx"
  httpcodec_source = source_dir || "/httpcodec.crexx"
  httpcore_source = source_dir || "/httpcore.crexx"

  integer_key = action_key(tool_identity || ":integer:-x", integer_source, library, classlib)
  decimal_key = action_key(tool_identity || ":decimal:-x", decimal_source, library, classlib)
  packednumeric_key = action_key(tool_identity || ":packednumeric:-x", packednumeric_source, library, classlib)
  statsvalue_key = action_key(tool_identity || ":statsvalue:-x", statsvalue_source, library, classlib)
  httpcodec_key = action_key(tool_identity || ":httpcodec:-x", httpcodec_source, library, classlib)
  httpcore_key = action_key(tool_identity || ":httpcore:-x", httpcore_source, library, classlib)

  -- rxhash is a native controller dependency, so this linked image is not
  -- eligible for a process pool.  Workers never mutate the shared working
  -- directory; each host command is wrapped in cmake -E chdir instead.
  pool = .taskpool.local(jobs, jobs * 2 + 16)
  worker_target = crexx_stage_g_worker..compile_target()

  wave1 = .channelvalue[]
  call queue_compile wave1, "integer", integer_source, members_root || "/integer", base_imports, rxc, rxas, cmake, integer_key, 0
  call queue_compile wave1, "decimal", decimal_source, members_root || "/decimal", base_imports, rxc, rxas, cmake, decimal_key, 0
  call queue_compile wave1, "packednumeric", packednumeric_source, members_root || "/packednumeric", base_imports, rxc, rxas, cmake, packednumeric_key, 0
  call queue_compile wave1, "statsvalue", statsvalue_source, members_root || "/statsvalue", base_imports, rxc, rxas, cmake, statsvalue_key, 0
  call queue_compile wave1, "httpcodec", httpcodec_source, members_root || "/httpcodec", base_imports, rxc, rxas, cmake, httpcodec_key, 0
  call queue_compile wave1, "httpcore", httpcore_source, members_root || "/httpcore", base_imports, rxc, rxas, cmake, httpcore_key, 0
  if run_task_wave(pool, worker_target, wave1, "G1 independent base members") <> 0 then do
    call pool.close()
    return 1
  end

  http_private = imports_root || "/http-private"
  httpcodec_bin = members_root || "/httpcodec/httpcodec.rxbin"
  httpcore_bin = members_root || "/httpcore/httpcore.rxbin"
  if reset_import_root(cmake, http_private) <> 0 then do
    call pool.close()
    return 1
  end
  if stage_import(cmake, http_private, httpcodec_bin, "httpcodec.rxbin") <> 0 then do
    call pool.close()
    return 1
  end
  if stage_import(cmake, http_private, httpcore_bin, "httpcore.rxbin") <> 0 then do
    call pool.close()
    return 1
  end

  http_source = source_dir || "/http.crexx"
  http_key = action_key(tool_identity || ":http:-x", http_source, library, classlib, httpcodec_bin, httpcore_bin)
  wave2 = .channelvalue[]
  call queue_compile wave2, "http", http_source, members_root || "/http", base_imports || ";" || http_private, rxc, rxas, cmake, http_key, 0
  if run_task_wave(pool, worker_target, wave2, "G2 public HTTP") <> 0 then do
    call pool.close()
    return 1
  end

  http_public = imports_root || "/http-public"
  http_bin = members_root || "/http/http.rxbin"
  if reset_import_root(cmake, http_public) <> 0 then do
    call pool.close()
    return 1
  end
  if stage_import(cmake, http_public, http_bin, "rxfnsg.rxbin") <> 0 then do
    call pool.close()
    return 1
  end
  if stage_import(cmake, http_public, httpcore_bin, "httpcore.rxbin") <> 0 then do
    call pool.close()
    return 1
  end

  httpserver_source = source_dir || "/httpserver.crexx"
  llm_source = source_dir || "/llm.crexx"
  httpserver_key = action_key(tool_identity || ":httpserver:-x", httpserver_source, library, classlib, http_bin, httpcore_bin)
  llm_key = action_key(tool_identity || ":llm:-x", llm_source, library, classlib, http_bin, httpcore_bin)
  wave3 = .channelvalue[]
  call queue_compile wave3, "httpserver", httpserver_source, members_root || "/httpserver", base_imports || ";" || http_public, rxc, rxas, cmake, httpserver_key, 0
  call queue_compile wave3, "llm", llm_source, members_root || "/llm", base_imports || ";" || http_public, rxc, rxas, cmake, llm_key, 0
  wave3_rc = run_task_wave(pool, worker_target, wave3, "G3 HTTP consumers")
  if wave3_rc <> 0 then do
    call pool.close()
    return 1
  end

  if scope_name = "all" then do
    command_target = crexx_stage_g_worker..command_target()
    unicode_root = source_dir || "/../unicode"
    unicode_tools_source = unicode_root || "/tools"
    unicode_data_root = unicode_root || "/data"
    unicode_work = work_root || "/unicode"
    unicode_tools_work = unicode_work || "/tools"
    unicode_imports = imports_root || "/unicode-tools"

    level_l_gennorm2_source = unicode_tools_source || "/level_l_gennorm2.crexx"
    unicode_normprops_source = unicode_tools_source || "/unicode_normprops.crexx"
    encoding_table_source = unicode_tools_source || "/encoding_table.crexx"
    casefold_table_source = unicode_tools_source || "/casefold_table.crexx"
    case_mapping_table_source = unicode_tools_source || "/case_mapping_table.crexx"
    grapheme_table_source = unicode_tools_source || "/grapheme_table.crexx"

    unicode_tool_base_imports = unicode_imports || "/base"
    if prepare_import_root(cmake, unicode_tool_base_imports, library, "library.rxbin") <> 0 then do
      call pool.close()
      return 1
    end

    level_l_gennorm2_key = action_key(tool_identity || ":level_l_gennorm2:-x", level_l_gennorm2_source, library)
    unicode_normprops_key = action_key(tool_identity || ":unicode_normprops:-x", unicode_normprops_source, library)
    encoding_table_key = action_key(tool_identity || ":encoding_table:-x", encoding_table_source, library)
    casefold_table_key = action_key(tool_identity || ":casefold_table:-x", casefold_table_source, library)
    case_mapping_table_key = action_key(tool_identity || ":case_mapping_table:-x", case_mapping_table_source, library)
    grapheme_table_key = action_key(tool_identity || ":grapheme_table:-x", grapheme_table_source, library)

    unicode_wave1 = .channelvalue[]
    call queue_compile unicode_wave1, "level_l_gennorm2", level_l_gennorm2_source, unicode_tools_work || "/level_l_gennorm2", unicode_tool_base_imports, rxc, rxas, cmake, level_l_gennorm2_key, 0
    call queue_compile unicode_wave1, "unicode_normprops", unicode_normprops_source, unicode_tools_work || "/unicode_normprops", unicode_tool_base_imports, rxc, rxas, cmake, unicode_normprops_key, 0
    call queue_compile unicode_wave1, "encoding_table", encoding_table_source, unicode_tools_work || "/encoding_table", unicode_tool_base_imports, rxc, rxas, cmake, encoding_table_key, 0
    call queue_compile unicode_wave1, "casefold_table", casefold_table_source, unicode_tools_work || "/casefold_table", unicode_tool_base_imports, rxc, rxas, cmake, casefold_table_key, 0
    call queue_compile unicode_wave1, "case_mapping_table", case_mapping_table_source, unicode_tools_work || "/case_mapping_table", unicode_tool_base_imports, rxc, rxas, cmake, case_mapping_table_key, 0
    call queue_compile unicode_wave1, "grapheme_table", grapheme_table_source, unicode_tools_work || "/grapheme_table", unicode_tool_base_imports, rxc, rxas, cmake, grapheme_table_key, 0
    if run_task_wave(pool, worker_target, unicode_wave1, "U1 independent table tools") <> 0 then do
      call pool.close()
      return 1
    end

    level_l_gennorm2_bin = unicode_tools_work || "/level_l_gennorm2/level_l_gennorm2.rxbin"
    unicode_normprops_bin = unicode_tools_work || "/unicode_normprops/unicode_normprops.rxbin"
    encoding_table_bin = unicode_tools_work || "/encoding_table/encoding_table.rxbin"
    casefold_table_bin = unicode_tools_work || "/casefold_table/casefold_table.rxbin"
    case_mapping_table_bin = unicode_tools_work || "/case_mapping_table/case_mapping_table.rxbin"
    grapheme_table_bin = unicode_tools_work || "/grapheme_table/grapheme_table.rxbin"

    unicode_gennorm2_imports = unicode_imports || "/unicode_gennorm2"
    generate_encoding_imports = unicode_imports || "/generate_encoding"
    generate_casefold_imports = unicode_imports || "/generate_casefold"
    generate_case_mapping_imports = unicode_imports || "/generate_case_mapping"
    generate_grapheme_imports = unicode_imports || "/generate_grapheme"
    if prepare_import_root(cmake, unicode_gennorm2_imports, library, "library.rxbin", level_l_gennorm2_bin, "level_l_gennorm2.rxbin") <> 0 then do
      call pool.close()
      return 1
    end
    if prepare_import_root(cmake, generate_encoding_imports, library, "library.rxbin", encoding_table_bin, "encoding_table.rxbin") <> 0 then do
      call pool.close()
      return 1
    end
    if prepare_import_root(cmake, generate_casefold_imports, library, "library.rxbin", casefold_table_bin, "casefold_table.rxbin") <> 0 then do
      call pool.close()
      return 1
    end
    if prepare_import_root(cmake, generate_case_mapping_imports, library, "library.rxbin", case_mapping_table_bin, "case_mapping_table.rxbin") <> 0 then do
      call pool.close()
      return 1
    end
    if prepare_import_root(cmake, generate_grapheme_imports, library, "library.rxbin", grapheme_table_bin, "grapheme_table.rxbin") <> 0 then do
      call pool.close()
      return 1
    end

    unicode_gennorm2_source = unicode_tools_source || "/unicode_gennorm2.crexx"
    generate_encoding_source = unicode_tools_source || "/generate_encoding.crexx"
    generate_casefold_source = unicode_tools_source || "/generate_casefold.crexx"
    generate_case_mapping_source = unicode_tools_source || "/generate_case_mapping.crexx"
    generate_grapheme_source = unicode_tools_source || "/generate_grapheme.crexx"
    unicode_gennorm2_key = action_key(tool_identity || ":unicode_gennorm2:-x", unicode_gennorm2_source, library, level_l_gennorm2_bin)
    generate_encoding_key = action_key(tool_identity || ":generate_encoding:-x", generate_encoding_source, library, encoding_table_bin)
    generate_casefold_key = action_key(tool_identity || ":generate_casefold:-x", generate_casefold_source, library, casefold_table_bin)
    generate_case_mapping_key = action_key(tool_identity || ":generate_case_mapping:-x", generate_case_mapping_source, library, case_mapping_table_bin)
    generate_grapheme_key = action_key(tool_identity || ":generate_grapheme:-x", generate_grapheme_source, library, grapheme_table_bin)

    unicode_wave2 = .channelvalue[]
    call queue_compile unicode_wave2, "unicode_gennorm2", unicode_gennorm2_source, unicode_tools_work || "/unicode_gennorm2", unicode_gennorm2_imports, rxc, rxas, cmake, unicode_gennorm2_key, 0
    call queue_compile unicode_wave2, "generate_encoding", generate_encoding_source, unicode_tools_work || "/generate_encoding", generate_encoding_imports, rxc, rxas, cmake, generate_encoding_key, 0
    call queue_compile unicode_wave2, "generate_casefold", generate_casefold_source, unicode_tools_work || "/generate_casefold", generate_casefold_imports, rxc, rxas, cmake, generate_casefold_key, 0
    call queue_compile unicode_wave2, "generate_case_mapping", generate_case_mapping_source, unicode_tools_work || "/generate_case_mapping", generate_case_mapping_imports, rxc, rxas, cmake, generate_case_mapping_key, 0
    call queue_compile unicode_wave2, "generate_grapheme", generate_grapheme_source, unicode_tools_work || "/generate_grapheme", generate_grapheme_imports, rxc, rxas, cmake, generate_grapheme_key, 0
    if run_task_wave(pool, worker_target, unicode_wave2, "U2 dependent generators") <> 0 then do
      call pool.close()
      return 1
    end

    unicode_gennorm2_bin = unicode_tools_work || "/unicode_gennorm2/unicode_gennorm2.rxbin"
    generate_encoding_bin = unicode_tools_work || "/generate_encoding/generate_encoding.rxbin"
    generate_casefold_bin = unicode_tools_work || "/generate_casefold/generate_casefold.rxbin"
    generate_case_mapping_bin = unicode_tools_work || "/generate_case_mapping/generate_case_mapping.rxbin"
    generate_grapheme_bin = unicode_tools_work || "/generate_grapheme/generate_grapheme.rxbin"

    unicode_data_imports = unicode_imports || "/unicode_data"
    if prepare_import_root(cmake, unicode_data_imports, library, "library.rxbin", unicode_gennorm2_bin, "unicode_gennorm2.rxbin") <> 0 then do
      call pool.close()
      return 1
    end
    unicode_data_source_tool = unicode_tools_source || "/unicode_data.crexx"
    unicode_data_key = action_key(tool_identity || ":unicode_data:-x", unicode_data_source_tool, library, unicode_gennorm2_bin)
    unicode_wave3 = .channelvalue[]
    call queue_compile unicode_wave3, "unicode_data", unicode_data_source_tool, unicode_tools_work || "/unicode_data", unicode_data_imports, rxc, rxas, cmake, unicode_data_key, 0
    if run_task_wave(pool, worker_target, unicode_wave3, "U3 normalization data tool") <> 0 then do
      call pool.close()
      return 1
    end
    unicode_data_bin = unicode_tools_work || "/unicode_data/unicode_data.rxbin"

    unicode_d_imports = unicode_imports || "/unicode_d"
    exits_bin = bin_dir || "/rxcexits.rxbin"
    if prepare_import_root(cmake, unicode_d_imports, library, "library.rxbin", unicode_gennorm2_bin, "unicode_gennorm2.rxbin", unicode_data_bin, "unicode_data.rxbin", unicode_normprops_bin, "unicode_normprops.rxbin", exits_bin, "rxcexits.rxbin") <> 0 then do
      call pool.close()
      return 1
    end
    unicode_d_source = unicode_tools_source || "/unicode_d.crexx"
    unicode_d_key = action_key(tool_identity || ":unicode_d:exits", unicode_d_source, library, unicode_gennorm2_bin, unicode_data_bin, unicode_normprops_bin, exits_bin)
    unicode_wave4 = .channelvalue[]
    call queue_compile unicode_wave4, "unicode_d", unicode_d_source, unicode_tools_work || "/unicode_d", unicode_d_imports, rxc, rxas, cmake, unicode_d_key, 1
    if run_task_wave(pool, worker_target, unicode_wave4, "U4 prepared normalization table") <> 0 then do
      call pool.close()
      return 1
    end
    unicode_d_bin = unicode_tools_work || "/unicode_d/unicode_d.rxbin"

    generate_normalization_imports = unicode_imports || "/generate_normalization"
    if prepare_import_root(cmake, generate_normalization_imports, library, "library.rxbin", unicode_data_bin, "unicode_data.rxbin", unicode_normprops_bin, "unicode_normprops.rxbin", unicode_d_bin, "unicode_d.rxbin") <> 0 then do
      call pool.close()
      return 1
    end
    generate_normalization_source = unicode_tools_source || "/generate_normalization.crexx"
    generate_normalization_key = action_key(tool_identity || ":generate_normalization:-x", generate_normalization_source, library, unicode_data_bin, unicode_normprops_bin, unicode_d_bin)
    unicode_wave5 = .channelvalue[]
    call queue_compile unicode_wave5, "generate_normalization", generate_normalization_source, unicode_tools_work || "/generate_normalization", generate_normalization_imports, rxc, rxas, cmake, generate_normalization_key, 0
    if run_task_wave(pool, worker_target, unicode_wave5, "U5 normalization generator") <> 0 then do
      call pool.close()
      return 1
    end
    generate_normalization_bin = unicode_tools_work || "/generate_normalization/generate_normalization.rxbin"

    linked_generator_dir = unicode_work || "/linked-generators"
    generated_source_dir = unicode_work || "/generated"
    if make_directory(cmake, linked_generator_dir) <> 0 then do
      call pool.close()
      return 1
    end
    if make_directory(cmake, generated_source_dir) <> 0 then do
      call pool.close()
      return 1
    end

    encoding_generator_image = linked_generator_dir || "/encoding_generator.rxbin"
    casefold_generator_image = linked_generator_dir || "/casefold_generator.rxbin"
    case_mapping_generator_image = linked_generator_dir || "/case_mapping_generator.rxbin"
    grapheme_generator_image = linked_generator_dir || "/grapheme_generator.rxbin"
    normalization_generator_image = linked_generator_dir || "/normalization_generator.rxbin"

    encoding_link_key = action_key("link-generator:encoding", rxlink, generate_encoding_bin, encoding_table_bin)
    casefold_link_key = action_key("link-generator:casefold", rxlink, generate_casefold_bin, casefold_table_bin)
    case_mapping_link_key = action_key("link-generator:case-mapping", rxlink, generate_case_mapping_bin, case_mapping_table_bin)
    grapheme_link_key = action_key("link-generator:grapheme", rxlink, generate_grapheme_bin, grapheme_table_bin)
    normalization_link_key = action_key("link-generator:normalization", rxlink, generate_normalization_bin, level_l_gennorm2_bin, unicode_gennorm2_bin, unicode_data_bin, unicode_normprops_bin, unicode_d_bin)

    encoding_link_argv = .string[]
    call arrayappend encoding_link_argv, rxlink
    call arrayappend encoding_link_argv, "-s"
    call arrayappend encoding_link_argv, "-o"
    call arrayappend encoding_link_argv, linked_generator_dir || "/encoding_generator"
    call arrayappend encoding_link_argv, generate_encoding_bin
    call arrayappend encoding_link_argv, encoding_table_bin
    casefold_link_argv = .string[]
    call arrayappend casefold_link_argv, rxlink
    call arrayappend casefold_link_argv, "-s"
    call arrayappend casefold_link_argv, "-o"
    call arrayappend casefold_link_argv, linked_generator_dir || "/casefold_generator"
    call arrayappend casefold_link_argv, generate_casefold_bin
    call arrayappend casefold_link_argv, casefold_table_bin
    case_mapping_link_argv = .string[]
    call arrayappend case_mapping_link_argv, rxlink
    call arrayappend case_mapping_link_argv, "-s"
    call arrayappend case_mapping_link_argv, "-o"
    call arrayappend case_mapping_link_argv, linked_generator_dir || "/case_mapping_generator"
    call arrayappend case_mapping_link_argv, generate_case_mapping_bin
    call arrayappend case_mapping_link_argv, case_mapping_table_bin
    grapheme_link_argv = .string[]
    call arrayappend grapheme_link_argv, rxlink
    call arrayappend grapheme_link_argv, "-s"
    call arrayappend grapheme_link_argv, "-o"
    call arrayappend grapheme_link_argv, linked_generator_dir || "/grapheme_generator"
    call arrayappend grapheme_link_argv, generate_grapheme_bin
    call arrayappend grapheme_link_argv, grapheme_table_bin
    normalization_link_argv = .string[]
    call arrayappend normalization_link_argv, rxlink
    call arrayappend normalization_link_argv, "-s"
    call arrayappend normalization_link_argv, "-o"
    call arrayappend normalization_link_argv, linked_generator_dir || "/normalization_generator"
    call arrayappend normalization_link_argv, generate_normalization_bin
    call arrayappend normalization_link_argv, level_l_gennorm2_bin
    call arrayappend normalization_link_argv, unicode_gennorm2_bin
    call arrayappend normalization_link_argv, unicode_data_bin
    call arrayappend normalization_link_argv, unicode_normprops_bin
    call arrayappend normalization_link_argv, unicode_d_bin

    unicode_link_wave = .channelvalue[]
    call queue_command unicode_link_wave, "link encoding generator", linked_generator_dir, encoding_generator_image, linked_generator_dir || "/encoding.action.sha256", cmake, encoding_link_key, encoding_link_argv
    call queue_command unicode_link_wave, "link case-fold generator", linked_generator_dir, casefold_generator_image, linked_generator_dir || "/casefold.action.sha256", cmake, casefold_link_key, casefold_link_argv
    call queue_command unicode_link_wave, "link case-mapping generator", linked_generator_dir, case_mapping_generator_image, linked_generator_dir || "/case-mapping.action.sha256", cmake, case_mapping_link_key, case_mapping_link_argv
    call queue_command unicode_link_wave, "link grapheme generator", linked_generator_dir, grapheme_generator_image, linked_generator_dir || "/grapheme.action.sha256", cmake, grapheme_link_key, grapheme_link_argv
    call queue_command unicode_link_wave, "link normalization generator", linked_generator_dir, normalization_generator_image, linked_generator_dir || "/normalization.action.sha256", cmake, normalization_link_key, normalization_link_argv
    if run_task_wave(pool, command_target, unicode_link_wave, "U6 link source generators") <> 0 then do
      call pool.close()
      return 1
    end

    unicode_17_root = unicode_data_root || "/unicode-17.0.0"
    legacy_data_root = unicode_data_root || "/legacy"
    casefold_data = unicode_17_root || "/CaseFolding.txt"
    grapheme_property_data = unicode_17_root || "/auxiliary/GraphemeBreakProperty.txt"
    emoji_data = unicode_17_root || "/emoji/emoji-data.txt"
    derived_core_data = unicode_17_root || "/DerivedCoreProperties.txt"
    unicode_data_file = unicode_17_root || "/UnicodeData.txt"
    normalization_properties_data = unicode_17_root || "/DerivedNormalizationProps.txt"
    special_casing_data = unicode_17_root || "/SpecialCasing.txt"
    windows1252_data = legacy_data_root || "/CP1252-2.0.0.txt"
    ibm437_data = legacy_data_root || "/CP437-2.0.0.txt"
    ibm850_data = legacy_data_root || "/CP850-2.0.0.txt"
    ibm1047_data = legacy_data_root || "/IBM1047.txt"

    casefold_template = source_dir || "/unicode_casefold.crexx.in"
    case_mapping_template = source_dir || "/unicode_case_mapping.crexx.in"
    encoding_template = source_dir || "/unicode_codec.crexx.in"
    grapheme_template = source_dir || "/unicode_grapheme.crexx.in"
    normalization_template = unicode_tools_source || "/unicode_d.crexx"
    generated_casefold = generated_source_dir || "/unicode_casefold.crexx"
    generated_case_mapping = generated_source_dir || "/unicode_case_mapping.crexx"
    generated_encoding = generated_source_dir || "/unicode_codec.crexx"
    generated_grapheme = generated_source_dir || "/unicode_grapheme.crexx"
    generated_normalization = generated_source_dir || "/unicode_normalization.crexx"

    casefold_run_key = action_key("run-generator:casefold", rxbvm, casefold_generator_image, library, casefold_data, casefold_template)
    case_mapping_run_key = action_key("run-generator:case-mapping", rxbvm, case_mapping_generator_image, library, unicode_data_file, special_casing_data, derived_core_data, case_mapping_template)
    encoding_run_key = action_key("run-generator:encoding", rxbvm, encoding_generator_image, library, windows1252_data, ibm437_data, ibm850_data, ibm1047_data, encoding_template)
    grapheme_run_key = action_key("run-generator:grapheme", rxbvm, grapheme_generator_image, library, grapheme_property_data, emoji_data, derived_core_data, grapheme_template)
    normalization_run_key = action_key("run-generator:normalization", rxbvm, normalization_generator_image, library, unicode_data_file, normalization_properties_data, normalization_template)

    casefold_run_argv = .string[]
    call arrayappend casefold_run_argv, rxbvm
    call arrayappend casefold_run_argv, casefold_generator_image
    call arrayappend casefold_run_argv, library
    call arrayappend casefold_run_argv, "-a"
    call arrayappend casefold_run_argv, casefold_data
    call arrayappend casefold_run_argv, casefold_template
    call arrayappend casefold_run_argv, generated_casefold
    case_mapping_run_argv = .string[]
    call arrayappend case_mapping_run_argv, rxbvm
    call arrayappend case_mapping_run_argv, case_mapping_generator_image
    call arrayappend case_mapping_run_argv, library
    call arrayappend case_mapping_run_argv, "-a"
    call arrayappend case_mapping_run_argv, unicode_data_file
    call arrayappend case_mapping_run_argv, special_casing_data
    call arrayappend case_mapping_run_argv, derived_core_data
    call arrayappend case_mapping_run_argv, case_mapping_template
    call arrayappend case_mapping_run_argv, generated_case_mapping
    encoding_run_argv = .string[]
    call arrayappend encoding_run_argv, rxbvm
    call arrayappend encoding_run_argv, encoding_generator_image
    call arrayappend encoding_run_argv, library
    call arrayappend encoding_run_argv, "-a"
    call arrayappend encoding_run_argv, windows1252_data
    call arrayappend encoding_run_argv, ibm437_data
    call arrayappend encoding_run_argv, ibm850_data
    call arrayappend encoding_run_argv, ibm1047_data
    call arrayappend encoding_run_argv, encoding_template
    call arrayappend encoding_run_argv, generated_encoding
    grapheme_run_argv = .string[]
    call arrayappend grapheme_run_argv, rxbvm
    call arrayappend grapheme_run_argv, grapheme_generator_image
    call arrayappend grapheme_run_argv, library
    call arrayappend grapheme_run_argv, "-a"
    call arrayappend grapheme_run_argv, grapheme_property_data
    call arrayappend grapheme_run_argv, emoji_data
    call arrayappend grapheme_run_argv, derived_core_data
    call arrayappend grapheme_run_argv, grapheme_template
    call arrayappend grapheme_run_argv, generated_grapheme
    normalization_run_argv = .string[]
    call arrayappend normalization_run_argv, rxbvm
    call arrayappend normalization_run_argv, normalization_generator_image
    call arrayappend normalization_run_argv, library
    call arrayappend normalization_run_argv, "-a"
    call arrayappend normalization_run_argv, unicode_data_file
    call arrayappend normalization_run_argv, normalization_properties_data
    call arrayappend normalization_run_argv, normalization_template
    call arrayappend normalization_run_argv, generated_normalization

    unicode_generate_wave = .channelvalue[]
    call queue_command unicode_generate_wave, "generate case-fold source", linked_generator_dir, generated_casefold, generated_source_dir || "/casefold.action.sha256", cmake, casefold_run_key, casefold_run_argv
    call queue_command unicode_generate_wave, "generate case-mapping source", linked_generator_dir, generated_case_mapping, generated_source_dir || "/case-mapping.action.sha256", cmake, case_mapping_run_key, case_mapping_run_argv
    call queue_command unicode_generate_wave, "generate encoding source", linked_generator_dir, generated_encoding, generated_source_dir || "/encoding.action.sha256", cmake, encoding_run_key, encoding_run_argv
    call queue_command unicode_generate_wave, "generate grapheme source", linked_generator_dir, generated_grapheme, generated_source_dir || "/grapheme.action.sha256", cmake, grapheme_run_key, grapheme_run_argv
    call queue_command unicode_generate_wave, "generate normalization source", linked_generator_dir, generated_normalization, generated_source_dir || "/normalization.action.sha256", cmake, normalization_run_key, normalization_run_argv
    if run_task_wave(pool, command_target, unicode_generate_wave, "U7 generate runtime sources") <> 0 then do
      call pool.close()
      return 1
    end

    product_exit_imports = imports_root || "/unicode-product-exits"
    if prepare_import_root(cmake, product_exit_imports, exits_bin, "rxcexits.rxbin") <> 0 then do
      call pool.close()
      return 1
    end
    unicode_casefold_key = action_key(tool_identity || ":unicode_casefold:exits", generated_casefold, library, classlib, exits_bin)
    unicode_case_mapping_key = action_key(tool_identity || ":unicode_case_mapping:exits", generated_case_mapping, library, classlib, exits_bin)
    unicode_codec_key = action_key(tool_identity || ":unicode_codec:exits", generated_encoding, library, classlib, exits_bin)
    unicode_grapheme_key = action_key(tool_identity || ":unicode_grapheme:exits", generated_grapheme, library, classlib, exits_bin)
    unicode_normalization_key = action_key(tool_identity || ":unicode_normalization:exits", generated_normalization, library, classlib, exits_bin)
    unicode_product_wave = .channelvalue[]
    call queue_compile unicode_product_wave, "unicode_casefold", generated_casefold, members_root || "/unicode_casefold", base_imports || ";" || product_exit_imports, rxc, rxas, cmake, unicode_casefold_key, 1
    call queue_compile unicode_product_wave, "unicode_case_mapping", generated_case_mapping, members_root || "/unicode_case_mapping", base_imports || ";" || product_exit_imports, rxc, rxas, cmake, unicode_case_mapping_key, 1
    call queue_compile unicode_product_wave, "unicode_codec", generated_encoding, members_root || "/unicode_codec", base_imports || ";" || product_exit_imports, rxc, rxas, cmake, unicode_codec_key, 1
    call queue_compile unicode_product_wave, "unicode_grapheme", generated_grapheme, members_root || "/unicode_grapheme", base_imports || ";" || product_exit_imports, rxc, rxas, cmake, unicode_grapheme_key, 1
    call queue_compile unicode_product_wave, "unicode_normalization", generated_normalization, members_root || "/unicode_normalization", base_imports || ";" || product_exit_imports, rxc, rxas, cmake, unicode_normalization_key, 1
    if run_task_wave(pool, worker_target, unicode_product_wave, "U8 private Unicode runtimes") <> 0 then do
      call pool.close()
      return 1
    end

    unicode_casefold_bin = members_root || "/unicode_casefold/unicode_casefold.rxbin"
    unicode_case_mapping_bin = members_root || "/unicode_case_mapping/unicode_case_mapping.rxbin"
    unicode_codec_bin = members_root || "/unicode_codec/unicode_codec.rxbin"
    unicode_grapheme_bin = members_root || "/unicode_grapheme/unicode_grapheme.rxbin"
    unicode_normalization_bin = members_root || "/unicode_normalization/unicode_normalization.rxbin"
    unicode_public_imports = imports_root || "/unicode-public"
    if prepare_import_root(cmake, unicode_public_imports, unicode_casefold_bin, "unicode_casefold.rxbin", unicode_case_mapping_bin, "unicode_case_mapping.rxbin", unicode_codec_bin, "unicode_codec.rxbin", unicode_grapheme_bin, "unicode_grapheme.rxbin", unicode_normalization_bin, "unicode_normalization.rxbin") <> 0 then do
      call pool.close()
      return 1
    end
    unicode_source = source_dir || "/unicode.crexx"
    unicode_key = action_key(tool_identity || ":unicode:-x", unicode_source, library, classlib, unicode_casefold_bin, unicode_case_mapping_bin, unicode_codec_bin, unicode_grapheme_bin, unicode_normalization_bin)
    unicode_public_wave = .channelvalue[]
    call queue_compile unicode_public_wave, "unicode", unicode_source, members_root || "/unicode", base_imports || ";" || unicode_public_imports, rxc, rxas, cmake, unicode_key, 0
    if run_task_wave(pool, worker_target, unicode_public_wave, "U9 public Unicode facade") <> 0 then do
      call pool.close()
      return 1
    end
  end

  call pool.close()

  names = .string[]
  names[1] = "integer"
  names[2] = "decimal"
  names[3] = "packednumeric"
  names[4] = "statsvalue"
  next_name = 5
  if scope_name = "all" then do
    names[next_name] = "unicode_casefold"
    names[next_name + 1] = "unicode_case_mapping"
    names[next_name + 2] = "unicode_codec"
    names[next_name + 3] = "unicode_grapheme"
    names[next_name + 4] = "unicode_normalization"
    names[next_name + 5] = "unicode"
    next_name = next_name + 6
  end
  names[next_name] = "httpcodec"
  names[next_name + 1] = "httpcore"
  names[next_name + 2] = "http"
  names[next_name + 3] = "httpserver"
  names[next_name + 4] = "llm"
  modules = .string[]
  do i = 1 to names[0]
    modules[i] = members_root || "/" || names[i] || "/" || names[i] || ".rxbin"
  end

  link_key = action_key("link-tool:" || configuration, rxlink)
  do i = 1 to modules[0]
    link_key = action_key(link_key || ":" || names[i], modules[i])
  end
  return link_library(work_root, bin_dir, rxlink, cmake, configuration, modules, names, link_key)
