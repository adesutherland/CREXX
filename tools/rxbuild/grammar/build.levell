/*
 * rxBuild version 1 grammar.
 *
 * The grammar recognises:
 *
 *   NAME = "value"
 *   FILES IN "directory" EXTENSION ".levell" BASENAMES
 *   FILES IN "directory" RECURSIVE EXTENSION ".levell" BASENAMES
 *   DO OVER NAME AS item ... END;
 *   COMPILE GRAMMAR
 *   COMPILE READER
 *   COMPILE RXPP
 *   COMPILE PROGRAM
 *   COMPILE APPLICATION
 *   CREATE EXE
 *   RUN
 *
 * with named attributes and semicolon-terminated statements.
 *
 * Semantic checks belong in the reader. For example:
 *
 *   - required attributes;
 *   - duplicate attributes;
 *   - valid dependencies;
 *   - valid build order;
 *   - existing source files.
 *
 * FILES selections are regular-file-only and return extensionless names.
 * BASENAMES selections are sorted by relative path; RECURSIVE selections
 * preserve subdirectory names relative to the selected directory.
 */

options levell

namespace rxbuildgrammar


/* -----------------------------
 * Tokens
 * -----------------------------
 */

compileword: token
grammarword: token
readerword: token
rxppword: token
applicationword: token
createword: token
exeword: token
runword: token

outputdirword: token
sourceword: token
outputword: token
dependsword: token
compilerword: token
workdirword: token
programword: token
argumentword: token
stdinword: token
filesword: token
inword: token
extensionword: token
recursiveword: token
basenamesword: token
doword: token
overword: token
asword: token
endword: token

equals: token
terminator: token
string: token
identifier: token


/* -----------------------------
 * Lexer
 * -----------------------------
 */

comment: comments nested "/*" "*/"

scan: lexer input utf8bytes

  letter: charset =
      U+0041 to U+005A |
      U+0061 to U+007A |
      U+005F

  digit: charset =
      U+0030 to U+0039

  hspace: charset =
      U+0009 | U+0020

  newline: charset =
      U+000A | U+000D

  string.body: charset =
      U+0020 to U+0021 |
      U+0023 to U+00FF |
      U+0009

  name.pattern: pattern =
      letter (letter | digit)*

  whitespace:
    rule = (hspace | newline)+ then skip

  string.literal:
    rule = '"' (string.body | '""')* '"' then emit string

  equals.literal:
    rule = "=" then emit equals

  terminator.literal:
    rule = ";" then emit terminator

  name.literal:
    rule = name.pattern then emit identifier


/* -----------------------------
 * Parser
 * -----------------------------
 */

parse: parser semantics contextfree input tokens start program

  program:
    rule = statement*

  statement:
    rule = assignment.statement
         | file.selection.statement
         | loop.statement
         | compile.grammar.statement
         | compile.reader.statement
         | compile.rxpp.statement
         | compile.program.statement
         | compile.application.statement
         | create.exe.statement
         | run.statement

  assignment.statement:
    rule = identifier equals string terminator

  file.selection.statement:
    rule = identifier equals filesword inword string
           extensionword string basenamesword terminator
         | identifier equals filesword inword string
           recursiveword extensionword string basenamesword terminator

  loop.statement:
    rule = doword overword identifier asword identifier
           loop.body endword terminator

  loop.body:
    rule = statement*


  /* ---------------------------
   * Compile grammar
   * ---------------------------
   */

  compile.grammar.statement:
    rule = compileword grammarword
           grammar.attributes
           terminator

  grammar.attributes:
    rule = grammar.attribute*

  grammar.attribute:
    rule = output.dir.attribute
         | source.attribute
         | output.attribute


  /* ---------------------------
   * Compile reader
   * ---------------------------
   */

  compile.reader.statement:
    rule = compileword readerword
           reader.attributes
           terminator

  /* ---------------------------
   * Preprocess RXPP source
   * ---------------------------
   */

  compile.rxpp.statement:
    rule = compileword rxppword
           rxpp.attributes
           terminator

  rxpp.attributes:
    rule = rxpp.attribute*

  rxpp.attribute:
    rule = output.dir.attribute
         | source.attribute
         | output.attribute

  reader.attributes:
    rule = reader.attribute*

  reader.attribute:
    rule = output.dir.attribute
         | source.attribute
         | depends.attribute
         | output.attribute


  /* ---------------------------
   * Compile ordinary program
   * ---------------------------
   */

  compile.program.statement:
    rule = compileword programword
           program.attributes
           terminator

  program.attributes:
    rule = program.compile.attribute*

  program.compile.attribute:
    rule = output.dir.attribute
         | source.attribute
         | output.attribute


  /* ---------------------------
   * Compile source application
   * ---------------------------
   */

  compile.application.statement:
    rule = compileword applicationword
           application.attributes
           terminator

  application.attributes:
    rule = application.attribute*

  application.attribute:
    rule = output.dir.attribute
         | source.attribute
         | depends.attribute
         | compiler.attribute
         | output.attribute


  /* ---------------------------
   * Create native executable
   * ---------------------------
   */

  create.exe.statement:
    rule = createword exeword
           exe.attributes
           terminator

  exe.attributes:
    rule = exe.attribute*

  exe.attribute:
    rule = output.dir.attribute
         | application.reference.attribute
         | output.attribute


  /* ---------------------------
   * Run
   * ---------------------------
   */

  run.statement:
    rule = runword
           run.attributes
           terminator

  run.attributes:
    rule = run.attribute*

  run.attribute:
    rule = work.dir.attribute
         | program.attribute
         | argument.attribute
         | stdin.attribute


  /* ---------------------------
   * Attributes
   * ---------------------------
   */

  output.dir.attribute:
    rule = outputdirword equals string

  source.attribute:
    rule = sourceword equals string

  output.attribute:
    rule = outputword equals string

  depends.attribute:
    rule = dependsword equals string

  compiler.attribute:
    rule = compilerword equals string

  application.reference.attribute:
    rule = applicationword equals string

  work.dir.attribute:
    rule = workdirword equals string

  program.attribute:
    rule = programword equals string

  /*
   * ARGUMENT has two values:
   *
   *   ARGUMENT = "-a" "examples/minibasic/basic1.bas"
   */
  argument.attribute:
    rule = argumentword equals string string

  stdin.attribute:
    rule = stdinword equals string


/* -----------------------------
 * Keyword classification
 * -----------------------------
 */

classify: tokenstage start 1

  word.compile:
    transform stage classify state 1
      take identifier text "COMPILE"
      emit compileword
      next 1

  word.grammar:
    transform stage classify state 1
      take identifier text "GRAMMAR"
      emit grammarword
      next 1

  word.reader:
    transform stage classify state 1
      take identifier text "READER"
      emit readerword
      next 1

  word.rxpp:
    transform stage classify state 1
      take identifier text "RXPP"
      emit rxppword
      next 1

  word.application:
    transform stage classify state 1
      take identifier text "APPLICATION"
      emit applicationword
      next 1

  word.create:
    transform stage classify state 1
      take identifier text "CREATE"
      emit createword
      next 1

  word.exe:
    transform stage classify state 1
      take identifier text "EXE"
      emit exeword
      next 1

  word.run:
    transform stage classify state 1
      take identifier text "RUN"
      emit runword
      next 1

  word.outputdir:
    transform stage classify state 1
      take identifier text "OUTPUT_DIR"
      emit outputdirword
      next 1

  word.source:
    transform stage classify state 1
      take identifier text "SOURCE"
      emit sourceword
      next 1

  word.output:
    transform stage classify state 1
      take identifier text "OUTPUT"
      emit outputword
      next 1

  word.depends:
    transform stage classify state 1
      take identifier text "DEPENDS_ON"
      emit dependsword
      next 1

  word.compiler:
    transform stage classify state 1
      take identifier text "COMPILER"
      emit compilerword
      next 1

  word.workdir:
    transform stage classify state 1
      take identifier text "WORK_DIR"
      emit workdirword
      next 1

  word.program:
    transform stage classify state 1
      take identifier text "PROGRAM"
      emit programword
      next 1

  word.argument:
    transform stage classify state 1
      take identifier text "ARGUMENT"
      emit argumentword
      next 1

  word.stdin:
    transform stage classify state 1
      take identifier text "STDIN"
      emit stdinword
      next 1

  word.files:
    transform stage classify state 1
      take identifier text "FILES"
      emit filesword
      next 1

  word.in:
    transform stage classify state 1
      take identifier text "IN"
      emit inword
      next 1

  word.extension:
    transform stage classify state 1
      take identifier text "EXTENSION"
      emit extensionword
      next 1

  word.recursive:
    transform stage classify state 1
      take identifier text "RECURSIVE"
      emit recursiveword
      next 1

  word.basenames:
    transform stage classify state 1
      take identifier text "BASENAMES"
      emit basenamesword
      next 1

  word.do:
    transform stage classify state 1
      take identifier text "DO"
      emit doword
      next 1

  word.over:
    transform stage classify state 1
      take identifier text "OVER"
      emit overword
      next 1

  word.as:
    transform stage classify state 1
      take identifier text "AS"
      emit asword
      next 1

  word.end:
    transform stage classify state 1
      take identifier text "END"
      emit endword
      next 1

  word.other:
    transform stage classify state 1
      take any
      emit copy
      next 1
