/* Undefined substitutions must be rejected before any tool is invoked. */

COMPILE GRAMMAR OUTPUT_DIR = "${MISSING_DIR}" SOURCE = "tools/rxbuild/grammar/build.levell" OUTPUT = "rxbuildgrammar";
COMPILE READER OUTPUT_DIR = "cmake-build-release/build" SOURCE = "tools/rxbuild/build_reader.crexx" DEPENDS_ON = "rxbuildgrammar" OUTPUT = "build_reader";
RUN WORK_DIR = "cmake-build-release/build" PROGRAM = "build_demo" ARGUMENT = "-a" "tools/rxbuild/example.build" STDIN = "";
