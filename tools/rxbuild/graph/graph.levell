/* Separate experimental graph build grammar.  It intentionally does not
 * share the rxBuild grammar or its reader contract. */

options levell
namespace rxgraphgrammar

ruleword: token
buildword: token
defaultword: token
actionword: token
descriptionword: token
inputword: token
outputword: token
dependsword: token
dependsbuildword: token
buildnameword: token
defaultbuildword: token
includeword: token
filesword: token
inword: token
recursiveword: token
extensionword: token
buildgroupword: token
sourcesword: token
outputdirword: token
asword: token
dot: token
workdirword: token
argumentword: token
runtimeargumentword: token
stdinword: token
endword: token
identifier: token
equals: token
terminator: token
string: token

comment: comments nested "/*" "*/"
scan: lexer input utf8bytes
  letter: charset = U+0041 to U+005A | U+0061 to U+007A | U+005F
  digit: charset = U+0030 to U+0039
  hspace: charset = U+0009 | U+0020
  newline: charset = U+000A | U+000D
  line.character: charset = U+0020 to U+00FF | U+0009
  string.body: charset = U+0020 to U+0021 | U+0023 to U+00FF | U+0009
  name.pattern: pattern = letter (letter | digit)*
  line.comment: rule = '--' line.character* then skip
  whitespace: rule = (hspace | newline)+ then skip
  string.literal: rule = '"' (string.body | '""')* '"' then emit string
  equals.literal: rule = "=" then emit equals
  terminator.literal: rule = ";" then emit terminator
  dot.literal: rule = "." then emit dot
  name.literal: rule = name.pattern then emit identifier

parse: parser semantics contextfree input tokens start program
  program: rule = statement*
  statement: rule = file.selection.assignment | sources.selection.assignment | assignment.statement | rule.statement | build.statement | build.group.statement | default.statement | default.build.statement | include.statement
  assignment.statement: rule = identifier equals string terminator
  file.selection.assignment: rule = identifier equals filesword inword string file.selection.attributes terminator
  sources.selection.assignment: rule = sourcesword equals filesword inword string file.selection.attributes terminator
  file.selection.attributes: rule = file.selection.attribute*
  file.selection.attribute: rule = recursive.attribute | extension.attribute
  recursive.attribute: rule = recursiveword
  extension.attribute: rule = extensionword string
  rule.statement: rule = ruleword identifier rule.attributes endword ruleword terminator
  rule.attributes: rule = rule.attribute*
  rule.attribute: rule = action.attribute | description.attribute
  action.attribute: rule = actionword equals string
  description.attribute: rule = descriptionword equals string
  build.statement: rule = buildword string build.attributes endword buildword terminator
  build.attributes: rule = build.attribute*
  build.attribute: rule = rule.reference.attribute | build.name.attribute | input.attribute | output.attribute | depends.attribute | depends.build.attribute | workdir.attribute | argument.attribute | runtime.argument.attribute | stdin.attribute
  rule.reference.attribute: rule = ruleword equals identifier
  build.name.attribute: rule = buildnameword equals identifier
  input.attribute: rule = inputword equals string
  output.attribute: rule = outputword equals string
  depends.attribute: rule = dependsword equals string
  depends.build.attribute: rule = dependsbuildword equals qualified.identifier
  workdir.attribute: rule = workdirword equals string
  argument.attribute: rule = argumentword equals string argument.tail
  argument.tail: rule = string*
  runtime.argument.attribute: rule = runtimeargumentword equals string
  stdin.attribute: rule = stdinword equals string
  build.group.statement: rule = buildgroupword string build.group.attributes endword buildgroupword terminator
  build.group.attributes: rule = build.group.attribute*
  build.group.attribute: rule = rule.reference.attribute | sources.reference.attribute | output.dir.attribute | depends.build.attribute
  sources.reference.attribute: rule = sourcesword equals source.reference.name
  source.reference.name: rule = identifier | sourcesword
  output.dir.attribute: rule = outputdirword equals string
  default.statement: rule = defaultword string terminator
  default.build.statement: rule = defaultbuildword equals identifier terminator
  include.statement: rule = includeword string include.alias terminator | includeword string include.alias | includeword string terminator | includeword string
  include.alias: rule = asword identifier
  qualified.identifier: rule = identifier (dot identifier)*

classify: tokenstage start 1
  word.rule:
    transform stage classify state 1
      take identifier text "RULE" emit ruleword next 1
  word.build:
    transform stage classify state 1
      take identifier text "BUILD" emit buildword next 1
  word.default:
    transform stage classify state 1
      take identifier text "DEFAULT" emit defaultword next 1
  word.action:
    transform stage classify state 1
      take identifier text "ACTION" emit actionword next 1
  word.description:
    transform stage classify state 1
      take identifier text "DESCRIPTION" emit descriptionword next 1
  word.input:
    transform stage classify state 1
      take identifier text "INPUT" emit inputword next 1
  word.output:
    transform stage classify state 1
      take identifier text "OUTPUT" emit outputword next 1
  word.depends:
    transform stage classify state 1
      take identifier text "DEPENDS_ON" emit dependsword next 1
  word.depends.build:
    transform stage classify state 1
      take identifier text "DEPENDS_ON_BUILD" emit dependsbuildword next 1
  word.build.name:
    transform stage classify state 1
      take identifier text "BUILD_NAME" emit buildnameword next 1
  word.default.build:
    transform stage classify state 1
      take identifier text "DEFAULT_BUILD" emit defaultbuildword next 1
  word.include:
    transform stage classify state 1
      take identifier text "INCLUDE_GRAPH" emit includeword next 1
  word.files:
    transform stage classify state 1
      take identifier text "FILES" emit filesword next 1
  word.in:
    transform stage classify state 1
      take identifier text "IN" emit inword next 1
  word.recursive:
    transform stage classify state 1
      take identifier text "RECURSIVE" emit recursiveword next 1
  word.extension:
    transform stage classify state 1
      take identifier text "EXTENSION" emit extensionword next 1
  word.build.group:
    transform stage classify state 1
      take identifier text "BUILD_GROUP" emit buildgroupword next 1
  word.sources:
    transform stage classify state 1
      take identifier text "SOURCES" emit sourcesword next 1
  word.output.dir:
    transform stage classify state 1
      take identifier text "OUTPUT_DIR" emit outputdirword next 1
  word.as:
    transform stage classify state 1
      take identifier text "AS" emit asword next 1
  word.workdir:
    transform stage classify state 1
      take identifier text "WORK_DIR" emit workdirword next 1
  word.argument:
    transform stage classify state 1
      take identifier text "ARGUMENT" emit argumentword next 1
  word.runtime.argument:
    transform stage classify state 1
      take identifier text "RUNTIME_ARGUMENT" emit runtimeargumentword next 1
  word.stdin:
    transform stage classify state 1
      take identifier text "STDIN" emit stdinword next 1
  word.end:
    transform stage classify state 1
      take identifier text "END" emit endword next 1
  word.other:
    transform stage classify state 1
      take any emit copy next 1
