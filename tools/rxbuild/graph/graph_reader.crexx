/* Experimental Ninja-like graph reader.  This is deliberately independent
 * from build_reader.crexx and only supports typed internal actions. */
options levelb
import rxfnsb
import lllanguage
import llsource
import lltree
import rxfs
import rxhash
import rxgraphgrammar
import concurrency
import rxbuild_graph_worker

main: procedure = .int
  arg argv = .string[]
  graph = ''
  requested = ''
  verbose = 0
  dry_run = 0
  verbose_explicit = 0
  dry_run_explicit = 0
  dump_graph = ''
  explain = 0
  explain_explicit = 0
  query_mode = ''
  toolchain_dir = ''
  toolchain_explicit = 0
  environment_names = .string[]
  environment_values = .string[]
  unset_environment = .string[]
  jobs = 4
  jobs_explicit = 0
  scheduler_task = 0
  do i = 1 to argv[0]
    if argv[i] = '--verbose' | argv[i] = '-v' | argv[i] = '-verbose' | argv[i] = '-verbose1' | argv[i] = '-verbose2' | argv[i] = '-verbose3' | argv[i] = '-verbose4' then do
      verbose = 1
      verbose_explicit = 1
    end
    else if argv[i] = '-verbose0' then do
      verbose = 0
      verbose_explicit = 1
    end
    else if argv[i] = '--dry-run' | argv[i] = '-n' then do
      dry_run = 1
      dry_run_explicit = 1
    end
    else if argv[i] = '--no-dry-run' | argv[i] = '--execute' then do
      dry_run = 0
      dry_run_explicit = 1
    end
    else if argv[i] = '--dump-graph=json' then dump_graph = 'json'
    else if argv[i] = '--dump-graph' then dump_graph = 'text'
    else if argv[i] = '--list-targets' then query_mode = 'list'
    else if argv[i] = '--show-dependencies' then query_mode = 'dependencies'
    else if argv[i] = '--reverse-dependencies' then query_mode = 'reverse'
    else if argv[i] = '--show-graph' then query_mode = 'graph'
    else if argv[i] = '--toolchain-dir' then do
      i = i + 1
      if i > argv[0] then do
        say 'usage: rxbuild [options] graph.build [target]'
        return 2
      end
      toolchain_dir = argv[i]
      toolchain_explicit = 1
    end
    else if argv[i] = '--env' then do
      i = i + 1
      if i > argv[0] then do
        say 'usage: rxbuild [options] graph.build [target]'
        return 2
      end
      assignment = argv[i]
      separator = pos('=',assignment)
      if separator < 2 then do
        say 'RXBUILD: --env requires NAME=VALUE'
        return 2
      end
      environment_names[environment_names[0] + 1] = left(assignment,separator - 1)
      environment_values[environment_values[0] + 1] = substr(assignment,separator + 1)
    end
    else if argv[i] = '--unset-env' then do
      i = i + 1
      if i > argv[0] | argv[i] = '' then do
        say 'RXBUILD: --unset-env requires a variable name'
        return 2
      end
      unset_environment[unset_environment[0] + 1] = argv[i]
    end
    else if argv[i] = '--jobs' then do
      i = i + 1
      if i > argv[0] then do
        say 'RXBUILD: --jobs requires a positive worker count'
        return 2
      end
      jobs = argv[i]
      if jobs < 1 then do
        say 'RXBUILD: --jobs requires a positive worker count'
        return 2
      end
      jobs_explicit = 1
    end
    else if argv[i] = '--scheduler-task' then do
      i = i + 1
      if i > argv[0] then do
        say 'RXBUILD: --scheduler-task requires a positive task number'
        return 2
      end
      scheduler_task = argv[i]
      if scheduler_task < 1 then do
        say 'RXBUILD: --scheduler-task requires a positive task number'
        return 2
      end
    end
    else if argv[i] = '--explain' | argv[i] = '-why' then do
      explain = 1
      explain_explicit = 1
    end
    else if argv[i] = '--no-explain' then do
      explain = 0
      explain_explicit = 1
    end
    else if argv[i] = '-keep' | argv[i] = '--keep' then iterate
    else if graph = '' then graph = argv[i]
    else if requested = '' then requested = argv[i]
    else do
      say 'usage: rxbuild [options] graph.build [target]'
      return 2
    end
  end
  if graph = '' then do
    say 'usage: rxbuild [options] graph.build [target]'
    return 2
  end
  variables = .string[]
  rules = .string[]
  targets = .string[]
  defaults = .string[]
  default_builds = .string[]
  graph_verbose = 0
  graph_dry_run = 0
  graph_verbose_defined = 0
  graph_dry_run_defined = 0
  graph_explain = 0
  graph_explain_defined = 0
  graph_toolchain_dir = ''
  graph_toolchain_defined = 0
  graph_jobs = 4
  graph_jobs_defined = 0
  graph_force = 0
  graph_force_defined = 0
  loaded = .string[]
  loading = .string[]
  rc = load_graph(graph,1,'',loaded,loading,rules,targets,defaults,default_builds,graph_verbose,graph_dry_run,graph_verbose_defined,graph_dry_run_defined,graph_explain,graph_explain_defined,graph_toolchain_dir,graph_toolchain_defined,graph_jobs,graph_jobs_defined,graph_force,graph_force_defined)
  if rc <> 0 then return rc
  if verbose_explicit = 0 & graph_verbose_defined <> 0 then verbose = graph_verbose
  if dry_run_explicit = 0 & graph_dry_run_defined <> 0 then dry_run = graph_dry_run
  if explain_explicit = 0 & graph_explain_defined <> 0 then explain = graph_explain
  if toolchain_explicit = 0 & graph_toolchain_defined <> 0 then toolchain_dir = graph_toolchain_dir
  if jobs_explicit = 0 & graph_jobs_defined <> 0 then jobs = graph_jobs
  if verbose <> 0 & scheduler_task > 0 then say 'RXBUILD SCHEDULER: child task=' || scheduler_task
  return execute_graph(rules,targets,defaults,default_builds,requested,verbose,dry_run,dump_graph,explain,query_mode,toolchain_dir,environment_names,environment_values,unset_environment,jobs,graph_force,graph)

load_graph: procedure = .int
  arg graph = .string, is_root = .int, scope = .string, expose loaded = .string[], expose loading = .string[], expose rules = .string[], expose targets = .string[], expose defaults = .string[], expose default_builds = .string[], expose graph_verbose = .int, expose graph_dry_run = .int, expose graph_verbose_defined = .int, expose graph_dry_run_defined = .int, expose graph_explain = .int, expose graph_explain_defined = .int, expose graph_toolchain_dir = .string, expose graph_toolchain_defined = .int, expose graph_jobs = .int, expose graph_jobs_defined = .int, expose graph_force = .int, expose graph_force_defined = .int
  i = .int
  path = .rxfs..abspath(graph)
  if member(loading,path) then do
    say 'RXBUILD: graph include cycle detected:'
    do i = 1 to loading[0]
      say '  ' || loading[i]
    end
    say '  ' || path
    return 4
  end
  if member(loaded,path) then return 0
  source = .binary
  do
    source = readbinary(path)
  on signal
    say 'RXBUILD_IO: cannot read ' || path
    return 2
  end
  request = .lllanguage..request(rxgraphgrammar..language(),source)
  status = request.parse()
  if status <> 0 then do
    say path || ': ' || llsource..diagnostic(source,request.offset(),'RXBUILD_PARSE',request.error())
    return status
  end
  tree = .lltree..view(request.tree(),request.root())
  if tree.error() <> '' then do
    say 'RXBUILD_TREE: ' || tree.error()
    return 3
  end
  loaded[loaded[0] + 1] = path
  loading[loading[0] + 1] = path
  variables = .string[]
  if scope = '' & is_root = 0 then scope = path
  rc = collect_graph(tree,tree.root(),variables,rules,targets,defaults,default_builds,path,is_root,scope,loaded,loading,graph_verbose,graph_dry_run,graph_verbose_defined,graph_dry_run_defined,graph_explain,graph_explain_defined,graph_toolchain_dir,graph_toolchain_defined,graph_jobs,graph_jobs_defined,graph_force,graph_force_defined)
  depth = loading[0] - 1
  previous_loading = .string[]
  do i = 1 to depth
    previous_loading[i] = loading[i]
  end
  call arraydrop loading
  do i = 1 to previous_loading[0]
    loading[i] = previous_loading[i]
  end
  return rc

execute_graph: procedure = .int
  arg rules = .string[], targets = .string[], defaults = .string[], default_builds = .string[], requested = .string, verbose = .int, dry_run = .int, dump_graph = .string, explain = .int, query_mode = .string, toolchain_dir = .string, environment_names = .string[], environment_values = .string[], unset_environment = .string[], jobs = .int, force = .int, graph = .string
  requested_target = .string
  resolved_toolchain_dir = .string
  rc = validate_graph(rules,targets,defaults,default_builds)
  if rc <> 0 then return rc
  if toolchain_dir <> '' then do
    resolved_toolchain_dir = project_path(toolchain_dir)
    if .rxfs..isdir(resolved_toolchain_dir) = 0 then return graph_error('toolchain directory does not exist: ' || resolved_toolchain_dir)
    if verbose <> 0 | dry_run <> 0 then say 'RXBUILD TOOLCHAIN: root=' || resolved_toolchain_dir
  end
  if environment_names[0] <> 0 | unset_environment[0] <> 0 then do
    if verbose <> 0 | dry_run <> 0 then say 'RXBUILD ENVIRONMENT: overrides=' || environment_names[0] || ' unset=' || unset_environment[0]
  end
  if query_mode = 'list' then do
    call list_targets(targets)
    return 0
  end
  if query_mode = 'dependencies' | query_mode = 'reverse' | query_mode = 'graph' then do
    if requested = '' then return graph_error('query requires a target')
    requested_target = resolve_target(targets,requested)
    if requested_target = '__RXBUILD_AMBIGUOUS__' then return graph_error('ambiguous BUILD_NAME ' || requested)
    if requested_target = '' then return unknown_target_error(targets,requested)
    seen = .string[]
    if query_mode = 'dependencies' then call show_dependencies(targets,requested_target,seen)
    else if query_mode = 'reverse' then call show_reverse_dependencies(targets,requested_target,seen)
    else call show_graph(targets,requested_target,seen,0)
    return 0
  end
  if dump_graph = 'json' then do
    call dump_resolved_graph_json(rules,targets,defaults,default_builds,toolchain_dir,environment_names,unset_environment)
    return 0
  end
  if dump_graph = 'text' then do
    call dump_resolved_graph(rules,targets,defaults,default_builds,toolchain_dir,environment_names,unset_environment)
    return 0
  end
  if requested = '' then do
    if default_builds[0] <> 0 then requested = default_builds[1]
    else if defaults[0] <> 0 then requested = defaults[1]
    else do
      say 'RXBUILD: no default target'
      return 4
    end
  end
  requested_target = resolve_target(targets,requested)
  if requested_target = '__RXBUILD_AMBIGUOUS__' then return graph_error('ambiguous BUILD_NAME ' || requested)
  if requested_target = '' then return unknown_target_error(targets,requested)
  visiting = .string[]
  completed = .string[]
  rebuilt = .string[]
  if verbose <> 0 & jobs > 1 then say 'RXBUILD SCHEDULER: workers=' || jobs
  return build_target(requested_target,rules,targets,visiting,completed,rebuilt,verbose,dry_run,explain,toolchain_dir,environment_names,environment_values,unset_environment,jobs,force,1,graph)

list_targets: procedure
  arg targets = .string[]
  i = .int
  target_scope = .string
  source_graph = .string
  local_name = .string
  separator = .int
  do i = 1 to targets[0] by 12
    target_scope = targets[i + 1]
    source_graph = ''
    local_name = ''
    if target_scope <> '' then do
      separator = lastpos('::',target_scope)
      if separator > 0 then do
        source_graph = left(target_scope,separator - 1)
        local_name = substr(target_scope,separator + 2)
      end
      else local_name = target_scope
    end
    say 'TARGET output=' || target_display(targets[i]) || ' name=' || local_name || ' source_graph=' || source_graph
  end
  return

show_dependencies: procedure
  arg targets = .string[], name = .string, expose seen = .string[]
  i = .int
  index = .int
  base = .int
  dependency_target = .int
  dependency_output = .string
  target_scope = .string
  source_graph = .string
  separator = .int
  if member(seen,name) <> 0 then return
  seen[seen[0] + 1] = name
  index = target_index(targets,name)
  if index = 0 then return
  base = (index - 1) * 12 + 1
  say 'TARGET ' || target_display(name)
  dependencies = split_paths(targets[base + 4])
  do i = 1 to dependencies[0]
    dependency_target = target_index(targets,dependencies[i])
    if dependency_target <> 0 then do
      dependency_output = targets[(dependency_target - 1) * 12 + 1]
      say '  depends=' || project_path(dependencies[i]) || ' -> target=' || target_display(dependency_output)
      call show_dependencies(targets,dependency_output,seen)
    end
    else say '  depends=' || project_path(dependencies[i])
  end
  logical_dependencies = split_paths(targets[base + 5])
  target_scope = targets[base + 1]
  separator = lastpos('::',target_scope)
  if separator > 0 then source_graph = left(target_scope,separator - 1)
  else source_graph = ''
  do i = 1 to logical_dependencies[0]
    dependency_target = resolve_logical_target(targets,logical_dependencies[i],source_graph)
    if dependency_target > 0 then do
      dependency_output = targets[(dependency_target - 1) * 12 + 1]
      say '  depends_build=' || logical_dependencies[i] || ' -> target=' || target_display(dependency_output)
      call show_dependencies(targets,dependency_output,seen)
    end
    else say '  depends_build=' || logical_dependencies[i]
  end
  return

show_reverse_dependencies: procedure
  arg targets = .string[], name = .string, expose seen = .string[]
  i = .int
  j = .int
  candidate = .string
  candidate_scope = .string
  source_graph = .string
  separator = .int
  found = .int
  dependency_target = .int
  dependency_output = .string
  if member(seen,name) <> 0 then return
  seen[seen[0] + 1] = name
  say 'TARGET ' || target_display(name)
  do i = 1 to targets[0] by 12
    candidate = targets[i]
    if candidate = name then iterate
    candidate_scope = targets[i + 1]
    separator = lastpos('::',candidate_scope)
    if separator > 0 then source_graph = left(candidate_scope,separator - 1)
    else source_graph = ''
    found = 0
    dependencies = split_paths(targets[i + 4])
    do j = 1 to dependencies[0]
      dependency_target = target_index(targets,dependencies[j])
      if dependency_target <> 0 then do
        dependency_output = targets[(dependency_target - 1) * 12 + 1]
        if dependency_output = name then found = 1
      end
      else if dependencies[j] = name then found = 1
    end
    logical_dependencies = split_paths(targets[i + 5])
    do j = 1 to logical_dependencies[0]
      dependency_target = resolve_logical_target(targets,logical_dependencies[j],source_graph)
      if dependency_target > 0 then do
        dependency_output = targets[(dependency_target - 1) * 12 + 1]
        if dependency_output = name then found = 1
      end
    end
    if found <> 0 then do
      say '  dependent=' || target_display(candidate)
      call show_reverse_dependencies(targets,candidate,seen)
    end
  end
  return

show_graph: procedure
  arg targets = .string[], name = .string, expose seen = .string[], depth = .int
  index = .int
  base = .int
  i = .int
  dependency_target = .int
  dependency_output = .string
  target_scope = .string
  source_graph = .string
  separator = .int
  logical_dependencies = .string[]
  dependencies = .string[]
  inputs = .string[]
  prefix = ''
  do i = 1 to depth
    prefix = prefix || '    '
  end
  if member(seen,name) <> 0 then do
    say prefix || '└── ' || target_display(name) || ' (already shown)'
    return
  end
  seen[seen[0] + 1] = name
  say prefix || 'TARGET ' || target_display(name)
  index = target_index(targets,name)
  if index = 0 then return
  base = (index - 1) * 12 + 1
  dependencies = split_paths(targets[base + 4])
  do i = 1 to dependencies[0]
    dependency_target = target_index(targets,dependencies[i])
    if dependency_target <> 0 then do
      dependency_output = targets[(dependency_target - 1) * 12 + 1]
      say prefix || '└── ' || target_display(dependency_output)
      call show_graph(targets,dependency_output,seen,depth + 1)
    end
    else say prefix || '└── input ' || project_path(dependencies[i])
  end
  target_scope = targets[base + 1]
  separator = lastpos('::',target_scope)
  if separator > 0 then source_graph = left(target_scope,separator - 1)
  else source_graph = ''
  logical_dependencies = split_paths(targets[base + 5])
  do i = 1 to logical_dependencies[0]
    dependency_target = resolve_logical_target(targets,logical_dependencies[i],source_graph)
    if dependency_target > 0 then do
      dependency_output = targets[(dependency_target - 1) * 12 + 1]
      say prefix || '└── ' || logical_dependencies[i]
      call show_graph(targets,dependency_output,seen,depth + 1)
    end
    else say prefix || '└── unresolved ' || logical_dependencies[i]
  end
  if targets[base + 2] <> '__RXBUILD_GROUP__' then do
    inputs = split_paths(targets[base + 3])
    do i = 1 to inputs[0]
      say prefix || '└── input ' || project_path(inputs[i])
    end
  end
  return

dump_resolved_graph: procedure
  arg rules = .string[], targets = .string[], defaults = .string[], default_builds = .string[], toolchain_dir = .string, environment_names = .string[], unset_environment = .string[]
  i = .int
  j = .int
  logical_target = .int
  scope_separator = .int
  target_scope = .string
  source_graph = .string
  local_name = .string
  logical_output = .string
  resolved_toolchain = .string
  resolved_toolchain = ''
  if toolchain_dir <> '' then resolved_toolchain = project_path(toolchain_dir)
  say 'RXBUILD GRAPH BEGIN'
  say 'TOOLCHAIN_DIR=' || resolved_toolchain
  do i = 1 to environment_names[0]
    say 'ENVIRONMENT_OVERRIDE=' || environment_names[i] || ' <set>'
  end
  do i = 1 to unset_environment[0]
    say 'ENVIRONMENT_UNSET=' || unset_environment[i]
  end
  say 'RULES'
  do i = 1 to rules[0] by 3
    say '  rule=' || rules[i] || ' action=' || rules[i + 1] || ' description=' || rules[i + 2]
  end
  say 'TARGETS'
  do i = 1 to targets[0] by 12
    say '  target=' || targets[i]
    source_graph = ''
    target_scope = targets[i + 1]
    if target_scope <> '' then do
      scope_separator = lastpos('::',target_scope)
      if scope_separator > 0 then do
        source_graph = left(target_scope,scope_separator - 1)
        local_name = substr(target_scope,scope_separator + 2)
        say '    source_graph=' || source_graph
        say '    name=' || local_name
      end
      else say '    name=' || target_scope
    end
    say '    rule=' || targets[i + 2]
    inputs = split_paths(targets[i + 3])
    do j = 1 to inputs[0]
      say '    input=' || project_path(inputs[j])
    end
    dependencies = split_paths(targets[i + 4])
    do j = 1 to dependencies[0]
      say '    depends=' || project_path(dependencies[j])
    end
    logical_dependencies = split_paths(targets[i + 5])
    do j = 1 to logical_dependencies[0]
      logical_target = resolve_logical_target(targets,logical_dependencies[j],source_graph)
      if logical_target > 0 then do
        logical_output = targets[(logical_target - 1) * 12 + 1]
        say '    depends_build=' || logical_dependencies[j] || ' -> output=' || logical_output
      end
      else say '    depends_build=' || logical_dependencies[j]
    end
    if targets[i + 6] <> '' then say '    workdir=' || project_path(targets[i + 6])
    if targets[i + 7] <> '' then say '    argument=' || targets[i + 7] || ' ' || targets[i + 8]
    if targets[i + 9] <> '' then say '    stdin=' || targets[i + 9]
    runtime_arguments = split_paths(targets[i + 10])
    do j = 1 to runtime_arguments[0]
      say '    runtime_argument=' || project_path(runtime_arguments[j])
    end
    outputs = split_paths(targets[i + 11])
    do j = 1 to outputs[0]
      say '    output=' || project_path(outputs[j])
    end
  end
  do i = 1 to defaults[0]
    say 'DEFAULT=' || defaults[i]
  end
  do i = 1 to default_builds[0]
    say 'DEFAULT_BUILD=' || default_builds[i]
  end
  say 'RXBUILD GRAPH END'
  return

dump_resolved_graph_json: procedure
  arg rules = .string[], targets = .string[], defaults = .string[], default_builds = .string[], toolchain_dir = .string, environment_names = .string[], unset_environment = .string[]
  i = .int
  j = .int
  prefix = ''
  target_scope = ''
  source_graph = ''
  local_name = ''
  scope_separator = 0
  resolved_toolchain = .string
  resolved_toolchain = ''
  if toolchain_dir <> '' then resolved_toolchain = project_path(toolchain_dir)
  say '{'
  say '  "toolchain_dir": ' || json_quote(resolved_toolchain) || ','
  say '  "environment": {'
  say '    "overrides": ['
  prefix_inner = ''
  do i = 1 to environment_names[0]
    say prefix_inner || '      ' || json_quote(environment_names[i])
    prefix_inner = ','
  end
  say '    ],'
  say '    "unset": ['
  prefix_inner = ''
  do i = 1 to unset_environment[0]
    say prefix_inner || '      ' || json_quote(unset_environment[i])
    prefix_inner = ','
  end
  say '    ]'
  say '  },'
  say '  "rules": ['
  do i = 1 to rules[0] by 3
    say prefix || '    {"name": ' || json_quote(rules[i]) || ', "action": ' || json_quote(rules[i + 1]) || ', "description": ' || json_quote(rules[i + 2]) || '}'
    prefix = ','
  end
  say '  ],'
  say '  "targets": ['
  prefix = ''
  do i = 1 to targets[0] by 12
    target_scope = targets[i + 1]
    source_graph = ''
    local_name = ''
    if target_scope <> '' then do
      scope_separator = lastpos('::',target_scope)
      if scope_separator > 0 then do
        source_graph = left(target_scope,scope_separator - 1)
        local_name = substr(target_scope,scope_separator + 2)
      end
      else local_name = target_scope
    end
    say prefix || '    {'
    say '      "output": ' || json_quote(project_path(targets[i])) || ','
    say '      "source_graph": ' || json_quote(source_graph) || ','
    say '      "name": ' || json_quote(local_name) || ','
    say '      "rule": ' || json_quote(targets[i + 2]) || ','
    say '      "inputs": ['
    inputs = split_paths(targets[i + 3])
    prefix_inner = ''
    do j = 1 to inputs[0]
      say prefix_inner || '        ' || json_quote(project_path(inputs[j]))
      prefix_inner = ','
    end
    say '      ],'
    say '      "depends": ['
    dependencies = split_paths(targets[i + 4])
    prefix_inner = ''
    do j = 1 to dependencies[0]
      say prefix_inner || '        ' || json_quote(project_path(dependencies[j]))
      prefix_inner = ','
    end
    say '      ],'
    say '      "depends_build": ['
    logical_dependencies = split_paths(targets[i + 5])
    prefix_inner = ''
    do j = 1 to logical_dependencies[0]
      say prefix_inner || '        ' || json_quote(logical_dependencies[j])
      prefix_inner = ','
    end
    say '      ],'
    say '      "workdir": ' || json_quote(project_path(targets[i + 6])) || ','
    say '      "argument": ' || json_quote(targets[i + 7]) || ','
    say '      "argument_value": ' || json_quote(targets[i + 8]) || ','
    say '      "stdin": ' || json_quote(targets[i + 9]) || ','
    say '      "runtime_arguments": ['
    runtime_arguments = split_paths(targets[i + 10])
    prefix_inner = ''
    do j = 1 to runtime_arguments[0]
      say prefix_inner || '        ' || json_quote(project_path(runtime_arguments[j]))
      prefix_inner = ','
    end
    say '      ],'
    say '      "outputs": ['
    outputs = split_paths(targets[i + 11])
    prefix_inner = ''
    do j = 1 to outputs[0]
      say prefix_inner || '        ' || json_quote(project_path(outputs[j]))
      prefix_inner = ','
    end
    say '      ]'
    say '    }'
    prefix = ','
  end
  say '  ],'
  say '  "defaults": ['
  prefix = ''
  do i = 1 to defaults[0]
    say prefix || '    ' || json_quote(project_path(defaults[i]))
    prefix = ','
  end
  say '  ],'
  say '  "default_builds": ['
  prefix = ''
  do i = 1 to default_builds[0]
    say prefix || '    ' || json_quote(default_builds[i])
    prefix = ','
  end
  say '  ]'
  say '}'
  return

validate_graph: procedure = .int
  arg rules = .string[], targets = .string[], defaults = .string[], default_builds = .string[]
  i = .int
  j = .int
  rc = .int
  physical_deps = .string[]
  physical_dependency = .string
  target_dependencies = .string[]
  logical_target = .int
  logical_output = .string
  if defaults[0] <> 0 & default_builds[0] <> 0 then return graph_error('both DEFAULT and DEFAULT_BUILD are defined')
  do i = 1 to targets[0] by 12
    target_name = targets[i]
    rule_name = targets[i + 2]
    if rule_index(rules,rule_name) = 0 then return graph_error('unknown rule ' || rule_name || ' for ' || target_name)
    target_scope = targets[i + 1]
    scope_separator = lastpos('::',target_scope)
    if scope_separator > 0 then target_scope = left(target_scope,scope_separator - 1)
    logical_deps = split_paths(targets[i + 5])
    call arraydrop target_dependencies
    physical_deps = split_paths(targets[i + 4])
    do j = 1 to physical_deps[0]
      physical_dependency = physical_deps[j]
      if member(target_dependencies,physical_dependency) then return graph_error('duplicate dependency ' || physical_dependency || ' for ' || target_name)
      target_dependencies[target_dependencies[0] + 1] = physical_dependency
    end
    do j = 1 to logical_deps[0]
      logical_target = resolve_logical_target(targets,logical_deps[j],target_scope)
      if logical_target < 0 then return graph_error('ambiguous build target name: ' || logical_deps[j] || ' for ' || target_name)
      if logical_target = 0 then return graph_error('Unknown build target name: ' || logical_deps[j] || ' for ' || target_name)
      logical_output = targets[(logical_target - 1) * 12 + 1]
      if member(target_dependencies,logical_output) then return graph_error('duplicate dependency ' || logical_deps[j] || ' for ' || target_name)
      target_dependencies[target_dependencies[0] + 1] = logical_output
    end
  end
  visiting = .string[]
  completed = .string[]
  do i = 1 to targets[0] by 12
    rc = validate_dependency_cycle(targets,targets[i],visiting,completed)
    if rc <> 0 then return rc
  end
  do i = 1 to defaults[0]
    if target_index(targets,defaults[i]) = 0 then return graph_error('unknown default target ' || defaults[i])
  end
  do i = 1 to default_builds[0]
    resolved_default = resolve_target(targets,default_builds[i])
    if resolved_default = '__RXBUILD_AMBIGUOUS__' then return graph_error('ambiguous default BUILD_NAME ' || default_builds[i])
    if resolved_default = '' then return graph_error('unknown default BUILD_NAME ' || default_builds[i])
  end
  return 0

validate_dependency_cycle: procedure = .int
  arg targets = .string[], name = .string, expose visiting = .string[], expose completed = .string[]
  i = .int
  rc = .int
  logical_target = .int
  if member(completed,name) then return 0
  if member(visiting,name) then return graph_error('dependency cycle at ' || name)
  t = target_index(targets,name)
  if t = 0 then return graph_error('unknown target ' || name)
  visiting[visiting[0] + 1] = name
  dependencies = .string[]
  physical_deps = split_paths(targets[(t - 1) * 12 + 5])
  do i = 1 to physical_deps[0]
    if target_index(targets,physical_deps[i]) <> 0 then dependencies[dependencies[0] + 1] = physical_deps[i]
  end
  logical_deps = split_paths(targets[(t - 1) * 12 + 6])
  target_scope = targets[(t - 1) * 12 + 2]
  scope_separator = lastpos('::',target_scope)
  if scope_separator > 0 then target_scope = left(target_scope,scope_separator - 1)
  do i = 1 to logical_deps[0]
    logical_target = resolve_logical_target(targets,logical_deps[i],target_scope)
    if logical_target > 0 then dependencies[dependencies[0] + 1] = targets[(logical_target - 1) * 12 + 1]
  end
  do i = 1 to dependencies[0]
    rc = validate_dependency_cycle(targets,dependencies[i],visiting,completed)
    if rc <> 0 then return rc
  end
  visiting[visiting[0]] = ''
  completed[completed[0] + 1] = name
  return 0

collect_graph: procedure = .int
  arg tree = .lltree..view, container = .int, expose variables = .string[], expose rules = .string[], expose targets = .string[], expose defaults = .string[], expose default_builds = .string[], origin = .string, is_root = .int, scope = .string, expose loaded = .string[], expose loading = .string[], expose graph_verbose = .int, expose graph_dry_run = .int, expose graph_verbose_defined = .int, expose graph_dry_run_defined = .int, expose graph_explain = .int, expose graph_explain_defined = .int, expose graph_toolchain_dir = .string, expose graph_toolchain_defined = .int, expose graph_jobs = .int, expose graph_jobs_defined = .int, expose graph_force = .int, expose graph_force_defined = .int
  name=.string
  child=.string
  argchild=.string
  j=.int
  k=.int
  m=.int
  n=.int
  attr=.string
  attrwrap=.string
  value=.string
  kind=.string
  recursive=.int
  extension=.string
  candidate=.string
  attributes_text=.string
  extension_pos=.int
  quote_start=.int
  quote_end=.int
  source_path=.string
  output_path=.string
  group_action=.string

  do i = 1 to tree.count(container)
    wrapper = tree.child(container,i)
    if tree.name(wrapper) <> 'statement' then iterate
    if tree.count(wrapper) <> 1 then return graph_error_at(origin,'malformed statement')
    node = tree.child(wrapper,1)
    kind = tree.name(node)
    if kind = 'assignment.statement' then do
      name = upper(strip(tree.text(tree.child(node,1))))
      value = substitute_value(unquote(tree.text(tree.child(node,3))),variables)
      if substitution_error(value) then return graph_error_at(origin,value)
      if name = 'VERBOSE' | name = 'DRY_RUN' | name = 'DRYRUN' | name = 'EXPLAIN' | name = 'TOOLCHAIN_DIR' | name = 'JOBS' | name = 'FORCE' then do
        if is_root = 0 then iterate
        if name = 'TOOLCHAIN_DIR' then do
          graph_toolchain_dir = value
          graph_toolchain_defined = 1
          iterate
        end
        if name = 'JOBS' then do
          if value < 1 then return graph_error_at(origin,'JOBS must be a positive worker count')
          if is_root <> 0 then do
            graph_jobs = value
            graph_jobs_defined = 1
          end
          iterate
        end
        if name = 'FORCE' then do
          enabled = graph_boolean(value)
          if enabled < 0 then return graph_error_at(origin,'FORCE must be true or false')
          if is_root <> 0 then do
            graph_force = enabled
            graph_force_defined = 1
          end
          iterate
        end
        enabled = graph_boolean(value)
        if enabled < 0 then return graph_error_at(origin,name || ' must be true or false')
        if name = 'VERBOSE' then do
          graph_verbose = enabled
          graph_verbose_defined = 1
        end
        else if name = 'EXPLAIN' then do
          graph_explain = enabled
          graph_explain_defined = 1
        end
        else do
          graph_dry_run = enabled
          graph_dry_run_defined = 1
        end
      end
      else call set_variable variables,name,value
    end
    else if kind = 'file.selection.assignment' | kind = 'sources.selection.assignment' then do
      name = upper(strip(tree.text(tree.child(node,1))))
      directory = substitute_value(unquote(tree.text(tree.child(node,5))),variables)
      recursive = 0
      extension = ''
      do j = 1 to tree.count(node)
        child = tree.child(node,j)
        if tree.name(child) = 'file.selection.attributes' then do
          attributes_text = tree.text(child)
          if pos('RECURSIVE',upper(attributes_text)) > 0 then recursive = 1
          extension_pos = pos('EXTENSION',upper(attributes_text))
          if extension_pos > 0 then do
            quote_start = pos('"',attributes_text,extension_pos)
            quote_end = pos('"',attributes_text,quote_start + 1)
            if quote_start > 0 & quote_end > quote_start then extension = substitute_value(unquote(substr(attributes_text,quote_start,quote_end - quote_start + 1)),variables)
          end
        end
      end
      if extension = '' then return graph_error_at(origin,'FILES selection requires EXTENSION')
      if substitution_error(directory) then return graph_error_at(origin,directory)
      if substitution_error(extension) then return graph_error_at(origin,extension)
      value = '__RXBUILD_FILESET__' || '0a'x || directory || '0a'x || recursive || '0a'x || extension
      call set_variable variables,name,value
    end
    else if kind = 'rule.statement' then do
      name = ''
      action = ''
      description = ''
      do j = 1 to tree.count(node)
        child = tree.child(node,j)
        if tree.name(child) = 'identifier' then name = tree.text(child)
        if tree.name(child) = 'rule.attributes' then do
          do k = 1 to tree.count(child)
            attrwrap = tree.child(child,k)
            if tree.count(attrwrap) < 1 then iterate
            attr = tree.child(attrwrap,1)
            if tree.name(attr) = 'action.attribute' then action = unquote(tree.text(tree.child(attr,3)))
            if tree.name(attr) = 'description.attribute' then description = unquote(tree.text(tree.child(attr,3)))
          end
        end
      end
      if name = '' | action = '' then return graph_error_at(origin,'RULE requires a name and ACTION')
      existing_rule = rule_index(rules,name)
      if existing_rule <> 0 then do
        if upper(rules[(existing_rule - 1) * 3 + 2]) <> upper(action) | rules[(existing_rule - 1) * 3 + 3] <> description then return graph_error_at(origin,'conflicting rule ' || name)
      end
      else call append_rule rules,name,action,description
    end
    else if kind = 'build.statement' then do
      name = ''
      build_name = ''
      rule = ''
      inputs = .string[]
      outputs = .string[]
      deps = .string[]
      logical_deps = .string[]
      workdir = ''
      argument = ''
      argument_value = ''
      runtime_args = .string[]
      stdin = ''
      command_arguments = .string[]
      argument_values = .string[]
      argument_action = ''
      do j = 1 to tree.count(node)
        child = tree.child(node,j)
        if tree.name(child) = 'string' & name = '' then name = substitute_value(unquote(tree.text(child)),variables)
        if tree.name(child) = 'build.attributes' then do
          do k = 1 to tree.count(child)
            attrwrap = tree.child(child,k)
            if tree.count(attrwrap) < 1 then iterate
            attr = tree.child(attrwrap,1)
            if tree.name(attr) = 'rule.reference.attribute' then rule = strip(tree.text(tree.child(attr,3)))
            if tree.name(attr) = 'build.name.attribute' then build_name = strip(tree.text(tree.child(attr,3)))
            if tree.name(attr) = 'input.attribute' then call append_path inputs,substitute_value(unquote(tree.text(tree.child(attr,3))),variables)
            if tree.name(attr) = 'output.attribute' then call append_path outputs,substitute_value(unquote(tree.text(tree.child(attr,3))),variables)
            if tree.name(attr) = 'depends.attribute' then call append_path deps,substitute_value(unquote(tree.text(tree.child(attr,3))),variables)
            if tree.name(attr) = 'depends.build.attribute' then call append_path logical_deps,strip(tree.text(tree.child(attr,3)))
            if tree.name(attr) = 'workdir.attribute' then workdir = substitute_value(unquote(tree.text(tree.child(attr,3))),variables)
            if tree.name(attr) = 'argument.attribute' then do
              call arraydrop argument_values
              do m = 1 to tree.count(attr)
                argchild = tree.child(attr,m)
                if tree.name(argchild) = 'string' then call append_path argument_values,unquote(tree.text(argchild))
                if tree.name(argchild) = 'argument.tail' then do
                  do n = 1 to tree.count(argchild)
                    if tree.name(tree.child(argchild,n)) = 'string' then call append_path argument_values,unquote(tree.text(tree.child(argchild,n)))
                  end
                end
              end
              do m = 1 to argument_values[0]
                call append_path command_arguments,argument_values[m]
              end
              if argument_values[0] >= 1 then argument = argument_values[1]
              if argument_values[0] >= 2 then argument_value = argument_values[2]
            end
            if tree.name(attr) = 'runtime.argument.attribute' then call append_path runtime_args,substitute_value(unquote(tree.text(tree.child(attr,3))),variables)
            if tree.name(attr) = 'stdin.attribute' then stdin = substitute_value(unquote(tree.text(tree.child(attr,3))),variables)
          end
        end
      end
      if substitution_error(name) then return graph_error_at(origin,name)
      do j = 1 to outputs[0]
        if substitution_error(outputs[j]) then return graph_error_at(origin,outputs[j])
      end
      rule_i = rule_index(rules,rule)
      if rule_i <> 0 then argument_action = upper(rules[(rule_i - 1) * 3 + 2])
      if argument_action = 'COMMAND' then do
        if command_arguments[0] = 0 then return graph_error_at(origin,'COMMAND requires at least one ARGUMENT')
        argument = substitute_command_value(command_arguments[1],name,inputs,outputs,variables)
        if substitution_error(argument) then return graph_error_at(origin,argument)
        argument_value = ''
        call arraydrop runtime_args
        do j = 2 to command_arguments[0]
          value = substitute_command_value(command_arguments[j],name,inputs,outputs,variables)
          if substitution_error(value) then return graph_error_at(origin,value)
          call append_path runtime_args,value
        end
      end
      else do
        argument = substitute_value(argument,variables)
        argument_value = substitute_value(argument_value,variables)
        if substitution_error(argument) then return graph_error_at(origin,argument)
        if substitution_error(argument_value) then return graph_error_at(origin,argument_value)
      end
      if name = '' | rule = '' then return graph_error_at(origin,'BUILD requires an output and RULE')
      if build_name <> '' & name = build_name then return graph_error_at(origin,'BUILD_NAME must differ from its physical output ' || name)
      if target_index(targets,name) <> 0 then return graph_error_at(origin,'duplicate target ' || name)
      if output_target_index(targets,name) <> 0 then return graph_error_at(origin,'duplicate output ' || name)
      do j = 1 to outputs[0]
        if outputs[j] = name | member_before(outputs,outputs[j],j - 1) <> 0 | output_target_index(targets,outputs[j]) <> 0 then return graph_error_at(origin,'duplicate output ' || outputs[j])
      end
      scoped_build_name = ''
      if build_name <> '' then scoped_build_name = scope || '::' || build_name
      if target_index(targets,name) <> 0 then return graph_error_at(origin,'duplicate target ' || name)
      call append_target targets,name,scoped_build_name,rule,join_paths(inputs),join_paths(deps),join_paths(logical_deps),workdir,argument,argument_value,stdin,join_paths(runtime_args),join_paths(outputs)
    end
    else if kind = 'build.group.statement' then do
      group_name = ''
      group_rule = ''
      source_reference = ''
      group_output_dir = ''
      group_logical_deps = .string[]
      do j = 1 to tree.count(node)
        child = tree.child(node,j)
        if tree.name(child) = 'string' & group_name = '' then group_name = substitute_value(unquote(tree.text(child)),variables)
        if tree.name(child) = 'build.group.attributes' then do
          do k = 1 to tree.count(child)
            attrwrap = tree.child(child,k)
            if tree.count(attrwrap) < 1 then iterate
            attr = tree.child(attrwrap,1)
            if tree.name(attr) = 'rule.reference.attribute' then group_rule = strip(tree.text(tree.child(attr,3)))
            if tree.name(attr) = 'sources.reference.attribute' then source_reference = upper(strip(tree.text(tree.child(attr,3))))
            if tree.name(attr) = 'output.dir.attribute' then group_output_dir = substitute_value(unquote(tree.text(tree.child(attr,3))),variables)
            if tree.name(attr) = 'depends.build.attribute' then call append_path group_logical_deps,strip(tree.text(tree.child(attr,3)))
          end
        end
      end
      if group_name = '' | group_rule = '' | source_reference = '' | group_output_dir = '' then return graph_error_at(origin,'BUILD_GROUP requires a name, RULE, SOURCES, and OUTPUT_DIR')
      source_spec = variable_value(variables,source_reference)
      if left(source_spec,19) <> '__RXBUILD_FILESET__' then return graph_error_at(origin,'SOURCES must reference a FILES selection: ' || source_reference)
      source_lines = split_paths(source_spec)
      if source_lines[0] < 4 then return graph_error_at(origin,'invalid FILES selection ' || source_reference)
      discovery_dir = source_lines[2]
      recursive = source_lines[3] as .int
      extension = source_lines[4]
      discovered = discover_group_files(discovery_dir,extension,recursive)
      if discovered[0] = 0 then return graph_error_at(origin,'no matching files for BUILD_GROUP ' || group_name || ' in ' || project_path(discovery_dir))
      group_rule_index = rule_index(rules,group_rule)
      if group_rule_index = 0 then return graph_error_at(origin,'unknown group rule ' || group_rule)
      group_action = upper(rules[(group_rule_index - 1) * 3 + 2])
      if group_action <> 'COMPILE PROGRAM' & group_action <> 'COMPILE RXPP' & group_action <> 'COMPILE RXPP PROGRAM' then return graph_error_at(origin,'BUILD_GROUP currently supports COMPILE PROGRAM, COMPILE RXPP, and COMPILE RXPP PROGRAM')
      group_scope_name = scope || '::' || group_name
      group_token = '@group/' || group_scope_name
      if target_index(targets,group_token) <> 0 | target_name_index(targets,group_scope_name) <> 0 then return graph_error_at(origin,'duplicate BUILD_GROUP ' || group_name)
      member_outputs = .string[]
      group_outputs = .string[]
      do j = 1 to discovered[0]
        source_path = join_group_path(discovery_dir,discovered[j])
        output_path = group_output_path(group_output_dir,discovered[j],group_action)
        if output_target_index(targets,output_path) <> 0 | member(group_outputs,output_path) <> 0 then return graph_error_at(origin,'duplicate BUILD_GROUP output ' || output_path)
        if target_index(targets,output_path) <> 0 then return graph_error_at(origin,'BUILD_GROUP output collides with target ' || output_path)
        call append_path group_outputs,output_path
        call append_path member_outputs,output_path
      end
      if rule_index(rules,'__RXBUILD_GROUP__') = 0 then call append_rule rules,'__RXBUILD_GROUP__','__RXBUILD_GROUP__','virtual aggregate'
      do j = 1 to discovered[0]
        source_path = join_group_path(discovery_dir,discovered[j])
        output_path = member_outputs[j]
        intermediate_output = ''
        if group_action = 'COMPILE RXPP PROGRAM' then intermediate_output = group_intermediate_path(output_path)
        call append_target targets,output_path,'',group_rule,source_path,'','','','','','', '',intermediate_output
      end
      call append_target targets,group_token,group_scope_name,'__RXBUILD_GROUP__',join_paths(discovered),join_paths(member_outputs),join_paths(group_logical_deps),group_output_dir,'','','',join_paths(discovered),''
    end
    else if kind = 'default.statement' then do
      value = substitute_value(unquote(tree.text(tree.child(node,2))),variables)
      if substitution_error(value) then return graph_error_at(origin,value)
      defaults[defaults[0] + 1] = value
    end
    else if kind = 'default.build.statement' then do
      if is_root <> 0 then default_builds[default_builds[0] + 1] = strip(tree.text(tree.child(node,3)))
    end
    else if kind = 'include.statement' then do
      include_path = ''
      include_alias = ''
      do j = 1 to tree.count(node)
        child = tree.child(node,j)
        if tree.name(child) = 'string' then include_path = substitute_value(unquote(tree.text(child)),variables)
        if tree.name(child) = 'include.alias' then include_alias = strip(tree.text(tree.child(child,2)))
      end
      if substitution_error(include_path) then return graph_error_at(origin,include_path)
      include_path = resolve_include_path(origin,include_path)
      if include_alias <> '' & scope_exists(targets,include_alias) then return graph_error_at(origin,'duplicate graph alias ' || include_alias)
      rc = load_graph(include_path,0,include_alias,loaded,loading,rules,targets,defaults,default_builds,graph_verbose,graph_dry_run,graph_verbose_defined,graph_dry_run_defined,graph_explain,graph_explain_defined,graph_toolchain_dir,graph_toolchain_defined,graph_jobs,graph_jobs_defined,graph_force,graph_force_defined)
      if rc <> 0 then return rc
    end
    else return graph_error_at(origin,'unknown statement ' || kind)
  end
  return 0

dependencies_are_independent: procedure = .int
  arg dependencies = .string[], targets = .string[]
  i = .int
  j = .int
  seen = .string[]
  do i = 1 to dependencies[0]
    do j = i + 1 to dependencies[0]
      call arraydrop seen
      if target_reaches(dependencies[i],dependencies[j],targets,seen) <> 0 then return 0
      call arraydrop seen
      if target_reaches(dependencies[j],dependencies[i],targets,seen) <> 0 then return 0
    end
  end
  return 1

target_reaches: procedure = .int
  arg name = .string, wanted = .string, targets = .string[], expose seen = .string[]
  if name = wanted then return 1
  if member(seen,name) <> 0 then return 0
  seen[seen[0] + 1] = name
  index = target_index(targets,name)
  if index = 0 then return 0
  base = (index - 1) * 12 + 1
  physical = split_paths(targets[base + 4])
  do i = 1 to physical[0]
    if target_reaches(physical[i],wanted,targets,seen) <> 0 then return 1
  end
  target_scope = targets[base + 1]
  separator = lastpos('::',target_scope)
  if separator > 0 then target_scope = left(target_scope,separator - 1)
  logical = split_paths(targets[base + 5])
  do i = 1 to logical[0]
    logical_target = resolve_logical_target(targets,logical[i],target_scope)
    if logical_target > 0 then do
      logical_output = targets[(logical_target - 1) * 12 + 1]
      if target_reaches(logical_output,wanted,targets,seen) <> 0 then return 1
    end
  end
  return 0

parallel_request: procedure = .channelvalue
  arg executable = .string, graph = .string, target = .string, task_number = .int, verbose = .int, toolchain_dir = .string, environment_names = .string[], environment_values = .string[], unset_environment = .string[]
  names = .string[]
  values = .channelvalue[]
  argv = .string[]
  call arrayappend argv, executable
  call arrayappend argv, graph
  call arrayappend argv, target
  call arrayappend argv, '--jobs'
  call arrayappend argv, '1'
  call arrayappend argv, '--scheduler-task'
  call arrayappend argv, task_number
  if verbose <> 0 then call arrayappend argv, '--verbose'
  if toolchain_dir <> '' then do
    call arrayappend argv, '--toolchain-dir'
    call arrayappend argv, toolchain_dir
  end
  do i = 1 to environment_names[0]
    call arrayappend argv, '--env'
    call arrayappend argv, environment_names[i] || '=' || environment_values[i]
  end
  do i = 1 to unset_environment[0]
    call arrayappend argv, '--unset-env'
    call arrayappend argv, unset_environment[i]
  end
  names[1] = 'argv'
  values[1] = parallel_argv_value(argv)
  names[2] = 'task'
  values[2] = .channelvalue.integer_value(task_number)
  return .channelvalue.record_value('crexx.rxbuild.graph.command',1,names,values)

parallel_argv_value: procedure = .channelvalue
  arg argv = .string[]
  values = .channelvalue[]
  do i = 1 to argv[0]
    values[i] = .channelvalue.string_value(argv[i])
  end
  return .channelvalue.array_value(values)

build_target: procedure = .int
  arg name = .string, rules = .string[], targets = .string[], expose visiting = .string[], expose completed = .string[], expose rebuilt = .string[], verbose = .int, dry_run = .int, explain = .int, toolchain_dir = .string, environment_names = .string[], environment_values = .string[], unset_environment = .string[], jobs = .int, force = .int, allow_parallel = .int, graph = .string
  rc=.int
  if member(completed,name) then return 0
  if member(visiting,name) then return graph_error('dependency cycle at ' || name)
  t = target_index(targets,name)
  if t = 0 then return graph_error('unknown target ' || name)
  i = .int
  visiting[visiting[0] + 1] = name
  rule_name = targets[(t - 1) * 12 + 3]
  rule_i = rule_index(rules,rule_name)
  if rule_i = 0 then return graph_error('unknown rule ' || rule_name || ' for ' || name)
  action = upper(rules[(rule_i - 1) * 3 + 2])
  physical_deps = split_paths(targets[(t - 1) * 12 + 5])
  logical_deps = split_paths(targets[(t - 1) * 12 + 6])
  target_scope = targets[(t - 1) * 12 + 2]
  scope_separator = lastpos('::',target_scope)
  if scope_separator > 0 then target_scope = left(target_scope,scope_separator - 1)
  deps = .string[]
  do i = 1 to physical_deps[0]
    if member(deps,physical_deps[i]) then return graph_error('duplicate dependency ' || physical_deps[i] || ' for ' || name)
    deps[deps[0] + 1] = physical_deps[i]
  end
  do i = 1 to logical_deps[0]
    logical_target = resolve_logical_target(targets,logical_deps[i],target_scope)
    if logical_target < 0 then return graph_error('ambiguous build target name: ' || logical_deps[i])
    if logical_target = 0 then return graph_error('Unknown build target name: ' || logical_deps[i])
    logical_output = targets[(logical_target - 1) * 12 + 1]
    if logical_output = name then return graph_error('target refers to itself: ' || name)
    if member(deps,logical_output) then return graph_error('duplicate dependency ' || logical_deps[i] || ' for ' || name)
    deps[deps[0] + 1] = logical_output
  end
  do i = 1 to deps[0]
    dep = deps[i]
    if target_index(targets,dep) = 0 then do
      if .rxfs..isfile(project_path(dep)) = 0 then return graph_error('missing dependency ' || dep || ' for ' || name)
    end
  end
  parallel_wave = 0
  if allow_parallel <> 0 & jobs > 1 & deps[0] > 1 & dry_run = 0 then do
    parallel_wave = dependencies_are_independent(deps,targets)
  end
  if parallel_wave <> 0 then do
    if verbose <> 0 then say 'RXBUILD SCHEDULER: parallel wave target=' || name || ' tasks=' || deps[0]
    requests = .channelvalue[]
    executable = tool('rxbuild',toolchain_dir)
    do i = 1 to deps[0]
      requests[i] = parallel_request(executable,graph,deps[i],i,verbose,toolchain_dir,environment_names,environment_values,unset_environment)
    end
    rc = rxbuild_graph_worker..run_wave(requests,name,jobs)
    if rc <> 0 then return rc
  end
  else do
    do i = 1 to deps[0]
      dep = deps[i]
      if target_index(targets,dep) <> 0 then do
        rc = build_target(dep,rules,targets,visiting,completed,rebuilt,verbose,dry_run,explain,toolchain_dir,environment_names,environment_values,unset_environment,jobs,force,0,graph)
        if rc <> 0 then return rc
      end
    end
  end
  if action = '__RXBUILD_GROUP__' then do
    if member(rebuilt,name) = 0 then do
      do i = 1 to deps[0]
        if member(rebuilt,deps[i]) then do
          rebuilt[rebuilt[0] + 1] = name
          leave
        end
      end
    end
    visiting[visiting[0]] = ''
    completed[completed[0] + 1] = name
    return 0
  end
  inputs = split_paths(targets[(t - 1) * 12 + 4])
  workdir = targets[(t - 1) * 12 + 7]
  argument = targets[(t - 1) * 12 + 8]
  argument_value = targets[(t - 1) * 12 + 9]
  stdin = targets[(t - 1) * 12 + 10]
  runtime_args = split_paths(targets[(t - 1) * 12 + 11])
  extra_outputs = split_paths(targets[(t - 1) * 12 + 12])
  marker_path = target_marker_path(name)
  output_paths = .string[]
  if action <> 'RUN' then output_paths[1] = name
  if action = 'CREATE EXE' then output_paths[1] = native_executable_path(project_path(name))
  do i = 1 to extra_outputs[0]
    output_paths[output_paths[0] + 1] = extra_outputs[i]
  end
  do i = 1 to inputs[0]
    if .rxfs..isfile(project_path(inputs[i])) = 0 then return graph_error('missing input ' || inputs[i] || ' for ' || name)
  end
  output = project_path(name)
  if action = 'CREATE EXE' then output = native_executable_path(output)

  if action = 'RUN' then do
    if explain <> 0 then say 'RXBUILD EXPLAIN: target=' || name || ' reason=run action'
    if dry_run <> 0 then do
      if verbose <> 0 then call report_target name,action,inputs,deps,workdir,argument,argument_value,stdin,runtime_args,'dry-run'
      say 'RXBUILD: would run ' || inputs[1]
      visiting[visiting[0]] = ''
      completed[completed[0] + 1] = name
      return 0
    end
    if verbose <> 0 then call report_target name,action,inputs,deps,workdir,argument,argument_value,stdin,runtime_args,'run'
    if inputs[0] <> 1 then return graph_error('RUN requires exactly one INPUT for ' || name)
    rc = run_program(inputs[1],workdir,argument,argument_value,stdin,runtime_args,toolchain_dir,environment_names,environment_values,unset_environment)
    if rc <> 0 then return rc
    do i = 1 to output_paths[0]
      if .rxfs..isfile(project_path(output_paths[i])) = 0 then return graph_error('action did not produce ' || output_paths[i])
    end
    say 'RXBUILD: ran ' || inputs[1]
    visiting[visiting[0]] = ''
    completed[completed[0] + 1] = name
    return 0
  end

  stale = .int
  reason = ''

  if .rxfs..isfile(marker_path) <> 0 then do
    stale = 1
    reason = 'interrupted previous action'
  end
  do i = 1 to output_paths[0]
    if stale = 0 & .rxfs..isfile(project_path(output_paths[i])) = 0 then do
      stale = 1
      reason = 'output missing: ' || output_paths[i]
    end
  end
  output_mtime = 0
  if stale = 0 then do
    output_mtime = modified(project_path(output_paths[1]))
    do i = 2 to output_paths[0]
      if modified(project_path(output_paths[i])) < output_mtime then output_mtime = modified(project_path(output_paths[i]))
    end
  end
  if stale = 0 then do
    current_signature = target_fingerprint(action,name,inputs,deps,output_paths,workdir,argument,argument_value,stdin,runtime_args,targets,toolchain_dir,environment_names,environment_values,unset_environment)
    saved_signature = read_target_state(name)
    if saved_signature = '' then do
      stale = 1
      reason = 'state missing'
    end
    else if saved_signature <> current_signature then do
      stale = 1
      reason = 'content or action changed'
    end
  end
  if stale = 0 then do
    do i = 1 to inputs[0]
      input = project_path(inputs[i])
      if modified(input) > output_mtime then do
        stale = 1
        reason = 'input newer: ' || input
      end
    end
    do i = 1 to deps[0]
      if member(rebuilt,deps[i]) then do
        stale = 1
        reason = 'dependency rebuilt: ' || deps[i]
      end
      if .rxfs..isfile(project_path(deps[i])) \= 0 then do
        if modified(project_path(deps[i])) > output_mtime then do
          stale = 1
          reason = 'dependency newer: ' || deps[i]
        end
      end
    end
  end
  if force <> 0 then do
    stale = 1
    reason = 'forced by root FORCE'
  end
  if stale = 0 then reason = 'up to date'
  if explain <> 0 then say 'RXBUILD EXPLAIN: target=' || name || ' reason=' || reason
  if verbose <> 0 then do
    if stale <> 0 & dry_run <> 0 then call report_target name,action,inputs,deps,workdir,argument,argument_value,stdin,runtime_args,'dry-run'
    else if stale <> 0 then call report_target name,action,inputs,deps,workdir,argument,argument_value,stdin,runtime_args,'build'
    else call report_target name,action,inputs,deps,workdir,argument,argument_value,stdin,runtime_args,'up-to-date'
  end
  if stale <> 0 then do
    if dry_run <> 0 then do
      say 'RXBUILD: would build ' || name
      visiting[visiting[0]] = ''
      completed[completed[0] + 1] = name
      return 0
    end
    if write_target_marker(name) <> 0 then return graph_error('cannot create in-progress marker for ' || name)
    do i = 1 to output_paths[0]
      if ensure_directory_tree(project_path(dirname(output_paths[i]))) <> 0 then return graph_error('cannot create output directory for ' || name)
    end
    if inputs[0] <> 1 then return graph_error(action || ' requires exactly one INPUT for ' || name)
    dir = dirname(name)
    output_name = basename_no_suffix(name)
    if action = 'COMPILE RXPP' then rc = compile_rxpp(name,inputs[1],deps,toolchain_dir,environment_names,environment_values,unset_environment)
    else if action = 'COMPILE RXPP PROGRAM' then rc = compile_rxpp_program(name,inputs[1],deps,toolchain_dir,environment_names,environment_values,unset_environment)
    else if action = 'COMMAND' then rc = run_command_action(workdir,argument,argument_value,runtime_args,environment_names,environment_values,unset_environment)
    else if action = 'COMPILE PROGRAM' then rc = compile_program(dir,inputs[1],output_name,deps,toolchain_dir,environment_names,environment_values,unset_environment)
    else if action = 'COMPILE GRAMMAR' then rc = compile_grammar(dir,inputs[1],output_name,toolchain_dir,environment_names,environment_values,unset_environment)
    else if action = 'COMPILE READER' then do
      if deps[0] <> 1 then return graph_error('COMPILE READER requires one grammar dependency for ' || name)
      rc = compile_reader(dir,inputs[1],basename_no_suffix(deps[1]),output_name,toolchain_dir,environment_names,environment_values,unset_environment)
    end
    else if action = 'COMPILE APPLICATION' then do
      if deps[0] < 2 then return graph_error('COMPILE APPLICATION requires grammar then reader dependencies for ' || name)
      rc = compile_application(dir,inputs[1],basename_no_suffix(deps[1]),basename_no_suffix(deps[2]),output_name,toolchain_dir,environment_names,environment_values,unset_environment)
    end
    else if action = 'CREATE EXE' then rc = create_exe(name,inputs[1],toolchain_dir,environment_names,environment_values,unset_environment)
    else return graph_error('unsupported ACTION ' || action)
    if rc <> 0 then return rc
    do i = 1 to output_paths[0]
      if .rxfs..isfile(project_path(output_paths[i])) = 0 then return graph_error('action did not produce ' || output_paths[i])
    end
    if write_target_state(name,target_fingerprint(action,name,inputs,deps,output_paths,workdir,argument,argument_value,stdin,runtime_args,targets,toolchain_dir,environment_names,environment_values,unset_environment)) <> 0 then return graph_error('cannot write build state for ' || name)
    if clear_target_marker(name) <> 0 then return graph_error('cannot clear in-progress marker for ' || name)
    rebuilt[rebuilt[0] + 1] = name
    say 'RXBUILD: built ' || name
  end
  else say 'RXBUILD: up to date ' || name
  visiting[visiting[0]] = ''
  completed[completed[0] + 1] = name
  return 0

resolve_target: procedure = .string
  arg targets = .string[], requested = .string
  logical = 0
  if pos('.',requested) > 0 then do
    qualifier = left(requested,pos('.',requested) - 1)
    local_name = substr(requested,pos('.',requested) + 1)
    logical = target_name_index(targets,qualifier || '::' || local_name)
  end
  else logical = target_name_index(targets,requested)
  if logical <> 0 then return targets[(logical - 1) * 12 + 1]
  if target_index(targets,requested) <> 0 then return requested
  matches = 0
  result = ''
  suffix = '::' || requested
  do i = 1 to targets[0] by 12
    if right(targets[i + 1],length(suffix)) = suffix then do
      matches = matches + 1
      result = targets[i]
    end
  end
  if matches > 1 then return '__RXBUILD_AMBIGUOUS__'
  if matches = 1 then return result
  return ''

report_target: procedure
  arg name = .string, action = .string, inputs = .string[], deps = .string[], workdir = .string, argument = .string, argument_value = .string, stdin = .string, runtime_args = .string[], state = .string
  i = .int
  line = 'RXBUILD VERBOSE: action=' || action || ' target=' || name || ' state=' || state
  say line
  do i = 1 to inputs[0]
    say '  input=' || project_path(inputs[i])
  end
  if action <> 'RUN' then say '  output=' || native_output_path(name,action)
  do i = 1 to deps[0]
    if .rxfs..isfile(project_path(deps[i])) <> 0 then say '  depends=' || project_path(deps[i])
    else say '  depends=logical:' || deps[i]
  end
  if action = 'RUN' then do
    if workdir = '' then say '  workdir=' || project_path(dirname(inputs[1]))
    else say '  workdir=' || project_path(workdir)
    if argument <> '' then say '  argument=' || argument || ' ' || argument_value
    do i = 1 to runtime_args[0]
      say '  runtime_argument=' || project_path(runtime_args[i])
    end
    if stdin <> '' then say '  stdin=' || stdin
  end
  else if action = 'COMMAND' then do
    say '  executable=' || argument
    if argument_value <> '' then say '  argument=' || argument_value
    do i = 1 to runtime_args[0]
      say '  argument=' || runtime_args[i]
    end
    if workdir <> '' then say '  workdir=' || project_path(workdir)
  end

native_output_path: procedure = .string
  arg name = .string, action = .string
  output = project_path(name)
  if action = 'CREATE EXE' then output = native_executable_path(output)
  return output

compile_program: procedure = .int
  arg dir = .string, source = .string, output = .string, deps = .string[], toolchain_dir = .string, environment_names = .string[], environment_values = .string[], unset_environment = .string[]
  rc = ensure_directory_tree(project_path(dir))
  if rc <> 0 then return rc
  argv = .string[]
  argv[1] = tool('crexx',toolchain_dir)
  argv[2] = '--program'
  argv[3] = project_path(dir) || '/' || output
  argv[4] = project_path(source)
  argv[5] = '-i'
  argv[6] = project_path(dir)
  arg_index = 7
  do i = 1 to deps[0]
    include_dir = dirname(deps[i])
    if include_dir <> '' then do
      argv[arg_index] = '-i'
      argv[arg_index + 1] = project_path(include_dir)
      arg_index = arg_index + 2
    end
  end
  input_lines = .string[]
  return run_command('COMPILE PROGRAM', argv, input_lines,environment_names,environment_values,unset_environment)

compile_rxpp: procedure = .int
  arg target = .string, source = .string, deps = .string[], toolchain_dir = .string, environment_names = .string[], environment_values = .string[], unset_environment = .string[]
  rc = ensure_directory_tree(project_path(dirname(target)))
  if rc <> 0 then return rc
  argv = .string[]
  argv[1] = tool('rxpp',toolchain_dir)
  argv[2] = 'rxprecomp'
  argv[3] = '-I'
  argv[4] = project_path(source)
  argv[5] = '-o'
  argv[6] = project_path(target)
  macro_lib = project_path('preprocessor/Maclib.rexx')
  do i = 1 to deps[0]
    if right(lower(deps[i]),11) = 'maclib.rexx' then macro_lib = project_path(deps[i])
  end
  argv[7] = '-m'
  argv[8] = macro_lib
  input_lines = .string[]
  return run_command('RXPP',argv,input_lines,environment_names,environment_values,unset_environment)

compile_rxpp_program: procedure = .int
  arg target = .string, source = .string, deps = .string[], toolchain_dir = .string, environment_names = .string[], environment_values = .string[], unset_environment = .string[]
  generated = left(target,lastpos('.',target) - 1) || '.crexx'
  rc = compile_rxpp(generated,source,deps,toolchain_dir,environment_names,environment_values,unset_environment)
  if rc <> 0 then return rc
  return compile_program(dirname(target),generated,basename_no_suffix(target),deps,toolchain_dir,environment_names,environment_values,unset_environment)

create_exe: procedure = .int
  arg name = .string, source = .string, toolchain_dir = .string, environment_names = .string[], environment_values = .string[], unset_environment = .string[]
  output = native_executable_path(project_path(name))
  staging_dir = project_path(dirname(name) || '/.rxgraph-generated')
  rc = ensure_directory_tree(staging_dir)
  if rc <> 0 then return rc
  staged_source = staging_dir || '/' || basename_no_suffix(name) || '.crexx'
  rc = copy_binary(project_path(source),staged_source)
  if rc <> 0 then return rc
  argv = .string[]
  argv[1] = tool('crexx',toolchain_dir)
  argv[2] = '--native'
  argv[3] = staged_source
  input_lines = .string[]
  say 'CREATE EXE:' output
  rc = run_command('native executable',argv,input_lines,environment_names,environment_values,unset_environment)
  if rc <> 0 then return rc
  generated = native_executable_path(without_suffix(staged_source))
  if .rxfs..isfile(generated) = 0 then return graph_error('native driver did not create ' || generated)
  return copy_binary(generated,output)

run_program: procedure = .int
  arg program = .string, workdir = .string, argument = .string, argument_value = .string, stdin = .string, runtime_args = .string[], toolchain_dir = .string, environment_names = .string[], environment_values = .string[], unset_environment = .string[]
  argv = .string[]
  argv[1] = tool('rxvm',toolchain_dir)
  argv[2] = '-l'
  if workdir = '' then argv[3] = project_path(dirname(program))
  else argv[3] = project_path(workdir)
  argv[4] = project_path(program)
  if argument <> '' then do
    argv[5] = argument
    argv[6] = argument_value
  end
  do i = 1 to runtime_args[0]
    if argument = '' then argv[4 + i] = project_path(runtime_args[i])
    else argv[6 + i] = project_path(runtime_args[i])
  end
  input_lines = .string[]
  if stdin <> '' then input_lines[1] = stdin
  captured = .string[]
  errors = .string[]
  i = .int
  previous_values = .string[]
  previous_present = .int[]
  rc = capture_environment(environment_names,environment_values,unset_environment,previous_values,previous_present)
  if rc <> 0 then return rc
  rc = apply_environment(environment_names,environment_values,unset_environment)
  if rc <> 0 then return rc
  address crexx "run :argv[]" input input_lines output captured error errors
  restore_rc = restore_environment(environment_names,unset_environment,previous_values,previous_present)
  if restore_rc <> 0 & rc = 0 then rc = restore_rc
  do i = 1 to captured[0]
    say captured[i]
  end
  if rc <> 0 then do
    say 'RXBUILD: failed execute rc=' || rc
    do i = 1 to errors[0]
      say errors[i]
    end
  end
  return rc

run_command: procedure = .int
  arg label = .string, argv = .string[], input_lines = .string[], environment_names = .string[], environment_values = .string[], unset_environment = .string[]
  captured = .string[]
  errors = .string[]
  i = .int
  previous_values = .string[]
  previous_present = .int[]
  rc = capture_environment(environment_names,environment_values,unset_environment,previous_values,previous_present)
  if rc <> 0 then return rc
  rc = apply_environment(environment_names,environment_values,unset_environment)
  if rc <> 0 then return rc
  address crexx "run :argv[]" input input_lines output captured error errors
  restore_rc = restore_environment(environment_names,unset_environment,previous_values,previous_present)
  if restore_rc <> 0 & rc = 0 then rc = restore_rc
  if rc <> 0 then do
    say 'RXBUILD: failed ' || label || ' rc=' || rc
    do i = 1 to captured[0]
      say captured[i]
    end
    do i = 1 to errors[0]
      say errors[i]
    end
  end
  return rc

run_command_action: procedure = .int
  arg workdir = .string, executable = .string, first_argument = .string, arguments = .string[], environment_names = .string[], environment_values = .string[], unset_environment = .string[]
  argv = .string[]
  pushed = 0
  restore_rc = 0
  run_rc = 0
  if executable = '' then return graph_error('COMMAND requires an executable')
  argv[1] = executable
  if first_argument <> '' then argv[2] = first_argument
  do i = 1 to arguments[0]
    if first_argument = '' then argv[i + 1] = arguments[i]
    else argv[i + 2] = arguments[i]
  end
  input_lines = .string[]
  if workdir <> '' then do
    resolved_workdir = project_path(workdir)
    address crexx "pushd :resolved_workdir"
    if rc <> 0 then return graph_error('COMMAND working directory is unavailable: ' || workdir)
    pushed = 1
  end
  rc = run_command('COMMAND',argv,input_lines,environment_names,environment_values,unset_environment)
  run_rc = rc
  if pushed <> 0 then do
    address crexx "popd"
    restore_rc = rc
    rc = run_rc
    if rc = 0 & restore_rc <> 0 then rc = restore_rc
  end
  return rc

apply_environment: procedure = .int
  arg environment_names = .string[], environment_values = .string[], unset_environment = .string[]
  environment_name = .string
  environment_value = .string
  i = .int
  do i = 1 to environment_names[0]
    environment_name = environment_names[i]
    environment_value = environment_values[i]
    address crexx "setenv :environment_name :environment_value"
    if rc <> 0 then return graph_error('cannot set environment variable ' || environment_name)
  end
  do i = 1 to unset_environment[0]
    environment_name = unset_environment[i]
    address crexx "unsetenv :environment_name"
    if rc <> 0 then return graph_error('cannot unset environment variable ' || environment_name)
  end
  return 0

capture_environment: procedure = .int
  arg environment_names = .string[], environment_values = .string[], unset_environment = .string[], expose previous_values = .string[], expose previous_present = .int[]
  environment_name = .string
  query_output = .string[]
  query_errors = .string[]
  i = .int
  do i = 1 to environment_names[0]
    environment_name = environment_names[i]
    call arraydrop query_output
    call arraydrop query_errors
    address crexx "env :environment_name" output query_output error query_errors
    if rc = 0 & query_output[0] <> 0 then do
      previous_values[i] = query_output[1]
      previous_present[i] = 1
    end
    else do
      previous_values[i] = ''
      previous_present[i] = 0
    end
  end
  do i = 1 to unset_environment[0]
    environment_name = unset_environment[i]
    call arraydrop query_output
    call arraydrop query_errors
    address crexx "env :environment_name" output query_output error query_errors
    if rc = 0 & query_output[0] <> 0 then do
      previous_values[environment_names[0] + i] = query_output[1]
      previous_present[environment_names[0] + i] = 1
    end
    else do
      previous_values[environment_names[0] + i] = ''
      previous_present[environment_names[0] + i] = 0
    end
  end
  return 0

restore_environment: procedure = .int
  arg environment_names = .string[], unset_environment = .string[], previous_values = .string[], previous_present = .int[]
  environment_name = .string
  previous_value = .string
  previous_index = .int
  i = .int
  do i = 1 to environment_names[0]
    environment_name = environment_names[i]
    if previous_present[i] <> 0 then do
      previous_value = previous_values[i]
      address crexx "setenv :environment_name :previous_value"
    end
    else address crexx "unsetenv :environment_name"
    if rc <> 0 then return graph_error('cannot restore environment variable ' || environment_name)
  end
  do i = 1 to unset_environment[0]
    environment_name = unset_environment[i]
    previous_index = environment_names[0] + i
    if previous_present[previous_index] <> 0 then do
      previous_value = previous_values[previous_index]
      address crexx "setenv :environment_name :previous_value"
    end
    else address crexx "unsetenv :environment_name"
    if rc <> 0 then return graph_error('cannot restore environment variable ' || environment_name)
  end
  return 0

compile_grammar: procedure = .int
  arg dir = .string, source = .string, output = .string, toolchain_dir = .string, environment_names = .string[], environment_values = .string[], unset_environment = .string[]
  rc = ensure_project_directories(dir,output)
  if rc <> 0 then return rc
  grammar_root = project_path(dir) || '/' || output || '.crexx-build/grammars/' || grammar_stem(source) || '/pending'
  rc = ensure_directory_tree(grammar_root)
  if rc <> 0 then return rc
  argv = .string[]
  argv[1] = tool('crexx',toolchain_dir)
  argv[2] = '--library'
  argv[3] = project_path(dir) || '/' || output
  argv[4] = project_path(source)
  input_lines = .string[]
  say 'BUILD GRAMMAR:' project_path(source)
  return run_command('grammar',argv,input_lines,environment_names,environment_values,unset_environment)

compile_reader: procedure = .int
  arg dir = .string, source = .string, grammar = .string, output = .string, toolchain_dir = .string, environment_names = .string[], environment_values = .string[], unset_environment = .string[]
  rc = ensure_project_directories(dir,output)
  if rc <> 0 then return rc
  member_root = project_path(dir) || '/' || output || '.crexx-build/members/' || source_stem(source)
  rc = ensure_directory_tree(member_root)
  if rc <> 0 then return rc
  argv = .string[]
  argv[1] = tool('crexx',toolchain_dir)
  argv[2] = '--program'
  argv[3] = project_path(dir) || '/' || output
  argv[4] = project_path(source)
  argv[5] = '-i'
  argv[6] = project_path(dir)
  argv[7] = '-l'
  argv[8] = project_path(dir) || '/' || grammar || '.rxbin'
  input_lines = .string[]
  say 'BUILD READER:' project_path(source)
  return run_command('reader',argv,input_lines,environment_names,environment_values,unset_environment)

compile_application: procedure = .int
  arg dir = .string, source = .string, grammar = .string, compiler = .string, output = .string, toolchain_dir = .string, environment_names = .string[], environment_values = .string[], unset_environment = .string[]
  assemble_argv = .string[]
  rc = ensure_project_directories(dir,output)
  if rc <> 0 then return rc
  generated_root = project_path(dir || '/../.rxbuild-generated/' || output)
  rc = ensure_directory_tree(generated_root)
  if rc <> 0 then return rc
  generated_source = generated_root || '/' || source_stem(source) || '_generated.crexx'
  argv = .string[]
  argv[1] = tool('rxvm',toolchain_dir)
  argv[2] = project_path(dir) || '/' || compiler || '.rxbin'
  argv[3] = '-a'
  argv[4] = project_path(source)
  argv[5] = generated_source
  input_lines = .string[]
  say 'BUILD APPLICATION:' project_path(source)
  rc = run_command('application compiler',argv,input_lines,environment_names,environment_values,unset_environment)
  if rc <> 0 then return rc
  argv = .string[]
  argv[1] = tool('rxc',toolchain_dir)
  argv[2] = '--no-exe-import'
  argv[3] = '-i'
  argv[4] = .rxfs..loadpath() || ';' || project_path(dir)
  argv[5] = '-o'
  argv[6] = project_path(dir) || '/' || output
  argv[7] = generated_source
  rc = run_command('application compile',argv,input_lines,environment_names,environment_values,unset_environment)
  if rc <> 0 then return rc
  assemble_argv[1] = tool('rxas',toolchain_dir)
  assemble_argv[2] = '-o'
  assemble_argv[3] = project_path(dir) || '/' || output
  assemble_argv[4] = project_path(dir) || '/' || output
  say 'BUILD APPLICATION RXBIN:' project_path(dir || '/' || output || '.rxbin')
  return run_command('application assemble',assemble_argv,input_lines,environment_names,environment_values,unset_environment)

copy_binary: procedure = .int
  arg source = .string, destination = .string
  data = readbinary(source)
  if binlength(data) = 0 & .rxfs..isfile(source) = 0 then do
    say 'RXBUILD: cannot read ' || source
    return 1
  end
  rc = ensure_directory_tree(dirname(destination))
  if rc <> 0 then return rc
  written = writebinary(destination,data)
  if written <> binlength(data) then do
    say 'RXBUILD: cannot write ' || destination
    return 1
  end
  return 0

append_rule: procedure
  arg expose rules = .string[], name = .string, action = .string, description = .string
  rules[rules[0] + 1] = name
  rules[rules[0] + 1] = action
  rules[rules[0] + 1] = description

append_target: procedure
  arg expose targets = .string[], name = .string, build_name = .string, rule = .string, inputs = .string, deps = .string, logical_deps = .string, workdir = .string, argument = .string, argument_value = .string, stdin = .string, runtime_args = .string, outputs = .string
  targets[targets[0] + 1] = name
  targets[targets[0] + 1] = build_name
  targets[targets[0] + 1] = rule
  targets[targets[0] + 1] = inputs
  targets[targets[0] + 1] = deps
  targets[targets[0] + 1] = logical_deps
  targets[targets[0] + 1] = workdir
  targets[targets[0] + 1] = argument
  targets[targets[0] + 1] = argument_value
  targets[targets[0] + 1] = stdin
  targets[targets[0] + 1] = runtime_args
  targets[targets[0] + 1] = outputs

append_path: procedure
  arg expose values = .string[], value = .string
  values[values[0] + 1] = value

join_paths: procedure = .string
  arg values = .string[]
  result = ''
  do i = 1 to values[0]
    if i > 1 then result = result || '0a'x
    result = result || values[i]
  end
  return result

split_paths: procedure = .string[]
  arg value = .string
  values = .string[]
  if value = '' then return values
  start = 1
  do while start <= length(value)
    separator = pos('0a'x,value,start)
    if separator = 0 then do
      values[values[0] + 1] = substr(value,start)
      leave
    end
    values[values[0] + 1] = substr(value,start,separator-start)
    start = separator + 1
  end
  return values

discover_group_files: procedure = .string[]
  arg directory = .string, extension = .string, recursive = .int
  results = .string[]
  root = project_path(directory)
  if .rxfs..pathkind(root) <> 2 then return results
  error_path = collect_group_files(root,'',extension,recursive,results)
  if error_path <> '' then do
    call arraydrop results
    return results
  end
  call arraysort results
  return results

collect_group_files: procedure = .string
  arg path = .string, relative = .string, extension = .string, recursive = .int, expose results = .string[]
  entries = .string[]
  count = .rxfs..listdir(path,entries)
  if count < 0 then return path
  call arraysort entries
  wanted = upper(extension)
  do i = 1 to entries[0]
    entry = entries[i]
    full_path = path || '/' || entry
    kind = .rxfs..pathkind(full_path)
    if kind = 2 then do
      if recursive = 0 then iterate
      nested = entry
      if relative <> '' then nested = relative || '/' || entry
      error_path = collect_group_files(full_path,nested,extension,recursive,results)
      if error_path <> '' then return error_path
      iterate
    end
    if kind <> 1 then iterate
    if right(upper(entry),length(wanted)) <> wanted then iterate
    item = entry
    if relative <> '' then item = relative || '/' || entry
    results[results[0] + 1] = item
  end
  return ''

join_group_path: procedure = .string
  arg directory = .string, relative = .string
  if directory = '' then return relative
  return directory || '/' || relative

group_output_path: procedure = .string
  arg output_dir = .string, relative = .string, action = .string
  dot = lastpos('.',relative)
  if upper(action) = 'COMPILE RXPP' then suffix = '.crexx'
  else suffix = '.rxbin'
  if dot > lastpos('/',relative) then relative = left(relative,dot - 1) || suffix
  else relative = relative || suffix
  return join_group_path(output_dir,relative)

group_intermediate_path: procedure = .string
  arg output = .string
  dot = lastpos('.',output)
  if dot > lastpos('/',output) then return left(output,dot - 1) || '.crexx'
  return output || '.crexx'

rule_index: procedure = .int
  arg rules = .string[], name = .string
  do i = 1 to rules[0] by 3
    if upper(rules[i]) = upper(name) then return ((i - 1) / 3) + 1
  end
  return 0

target_index: procedure = .int
  arg targets = .string[], name = .string
  do i = 1 to targets[0] by 12
    if targets[i] = name then return ((i - 1) / 12) + 1
  end
  return 0

output_target_index: procedure = .int
  arg targets = .string[], name = .string
  do i = 1 to targets[0] by 12
    if output_equal(targets[i],name) then return ((i - 1) / 12) + 1
    outputs = split_paths(targets[i + 11])
    do j = 1 to outputs[0]
      if output_equal(outputs[j],name) then return ((i - 1) / 12) + 1
    end
  end
  return 0

output_equal: procedure = .int
  arg left_path = .string, right_path = .string
  version = ''
  assembler rxvers version
  if upper(word(version,1)) = 'WINDOWS' then return upper(left_path) = upper(right_path)
  return left_path = right_path

target_name_index: procedure = .int
  arg targets = .string[], name = .string
  do i = 1 to targets[0] by 12
    if targets[i + 1] = name then return ((i - 1) / 12) + 1
  end
  return 0

scope_exists: procedure = .int
  arg targets = .string[], scope = .string
  separator = '::'
  do i = 1 to targets[0] by 12
    target_scope = targets[i + 1]
    position = pos(separator,target_scope)
    if position > 0 & left(target_scope,position - 1) = scope then return 1
  end
  return 0

resolve_logical_target: procedure = .int
  arg targets = .string[], name = .string, scope = .string
  if pos('.',name) > 0 then do
    qualifier = left(name,pos('.',name) - 1)
    local_name = substr(name,pos('.',name) + 1)
    return target_name_index(targets,qualifier || '::' || local_name)
  end
  scoped = target_name_index(targets,scope || '::' || name)
  if scoped <> 0 then return scoped
  matches = 0
  result = 0
  suffix = '::' || name
  do i = 1 to targets[0] by 12
    if right(targets[i + 1],length(suffix)) = suffix then do
      matches = matches + 1
      result = ((i - 1) / 12) + 1
    end
  end
  if matches > 1 then return -1
  return result

member: procedure = .int
  arg values = .string[], value = .string
  do i = 1 to values[0]
    if values[i] = value then return 1
  end
  return 0

member_before: procedure = .int
  arg values = .string[], value = .string, last = .int
  do i = 1 to last
    if values[i] = value then return 1
  end
  return 0

modified: procedure = .int
  arg path = .string
  info = .string[]
  address crexx 'stat :path' output info
  if rc <> 0 then return -1
  parse var info[1] . ' mtime=' stamp
  return stamp as .int

target_state_path: procedure = .string
  arg name = .string
  return project_path(name) || '.rxbuild-state'

target_marker_path: procedure = .string
  arg name = .string
  return target_state_path(name) || '.in-progress'

write_target_marker: procedure = .int
  arg name = .string
  path = target_marker_path(name)
  normalized_name = translate(name,'/','\')
  if ensure_directory_tree(project_path(dirname(normalized_name))) <> 0 then return 1
  written = writebinary(path, 'RXBUILD IN PROGRESS' as .binary)
  if written <> length('RXBUILD IN PROGRESS') then return 1
  return 0

clear_target_marker: procedure = .int
  arg name = .string
  return .rxfs..delete(target_marker_path(name))

read_target_state: procedure = .string
  arg name = .string
  path = target_state_path(name)
  if .rxfs..isfile(path) = 0 then return ''
  return strip(readbinary(path) as .string)

write_target_state: procedure = .int
  arg name = .string, signature = .string
  path = target_state_path(name)
  temporary = path || '.tmp'
  written = writebinary(temporary, (signature || '0a'x) as .binary)
  if written <> length(signature) + 1 then return 1
  ignored = .rxfs..delete(path)
  return .rxfs..rename(temporary,path)

target_fingerprint: procedure = .string
  arg action = .string, name = .string, inputs = .string[], deps = .string[], outputs = .string[], workdir = .string, argument = .string, argument_value = .string, stdin = .string, runtime_args = .string[], targets = .string[], toolchain_dir = .string, environment_names = .string[], environment_values = .string[], unset_environment = .string[]
  i = .int
  key = 'action=' || action || '|target=' || name || '|workdir=' || workdir || '|argument=' || argument || '|argument_value=' || argument_value || '|stdin=' || stdin || '|toolchain=' || project_path(toolchain_dir)
  do i = 1 to inputs[0]
    key = key || '|input=' || inputs[i] || ':' || file_fingerprint(inputs[i])
  end
  do i = 1 to deps[0]
    key = key || '|dependency=' || deps[i] || ':' || dependency_fingerprint(deps[i],targets)
  end
  do i = 1 to outputs[0]
    key = key || '|output=' || outputs[i] || ':' || file_fingerprint(outputs[i])
  end
  do i = 1 to runtime_args[0]
    key = key || '|runtime=' || runtime_args[i]
  end
  do i = 1 to environment_names[0]
    key = key || '|env=' || environment_names[i] || ':' || rxhash..sha256hex(environment_values[i] as .binary)
  end
  do i = 1 to unset_environment[0]
    key = key || '|unset_env=' || unset_environment[i]
  end
  return rxhash..sha256hex(key as .binary)

dependency_fingerprint: procedure = .string
  arg dependency = .string, targets = .string[]
  target_number = target_index(targets,dependency)
  if target_number = 0 then return file_fingerprint(dependency)
  base = (target_number - 1) * 12 + 1
  if targets[base + 2] = '__RXBUILD_GROUP__' then do
    key = 'group=' || dependency || '|manifest=' || targets[base + 3]
    members = split_paths(targets[base + 4])
    do i = 1 to members[0]
      key = key || '|member=' || members[i] || ':' || file_fingerprint(members[i])
    end
    return rxhash..sha256hex(key as .binary)
  end
  return file_fingerprint(dependency)

file_fingerprint: procedure = .string
  arg path = .string
  resolved = project_path(path)
  if .rxfs..isfile(resolved) = 0 then return 'MISSING'
  return rxhash..sha256filehex(resolved)

graph_error: procedure = .int
  arg message = .string
  say 'RXBUILD: ' || message
  return 4

unknown_target_error: procedure = .int
  arg targets = .string[], requested = .string
  say 'RXBUILD: unknown target ' || requested
  say 'RXBUILD: available targets:'
  do i = 1 to targets[0] by 12
    scope = targets[i + 1]
    if scope <> '' then do
      separator = lastpos('::',scope)
      if separator > 0 then say '  ' || substr(scope,separator + 2) || ' -> ' || target_display(targets[i])
      else say '  ' || scope || ' -> ' || target_display(targets[i])
    end
    else say '  ' || target_display(targets[i])
  end
  return 4

graph_error_at: procedure = .int
  arg source = .string, message = .string
  say source || ': RXBUILD: ' || message
  return 4

json_quote: procedure = .string
  arg value = .string
  result = '"'
  do i = 1 to length(value)
    character = substr(value,i,1)
    if character = '\' then result = result || '\\'
    else if character = '"' then result = result || '\"'
    else result = result || character
  end
  return result || '"'

unquote: procedure = .string
  arg value = .string
  if length(value) >= 2 & left(value,1) = '"' & right(value,1) = '"' then return substr(value,2,length(value)-2)
  return value

set_variable: procedure
  arg expose variables = .string[], name = .string, value = .string
  do i = 1 to variables[0] by 2
    if variables[i] = name then do
      variables[i + 1] = value
      return
    end
  end
  variables[variables[0] + 1] = name
  variables[variables[0] + 1] = value

variable_value: procedure = .string
  arg variables = .string[], name = .string
  do i = 1 to variables[0] by 2
    if variables[i] = name then return variables[i + 1]
  end
  return ''

substitute_value: procedure = .string
  arg value = .string, variables = .string[]
  result = ''
  start = 1
  do while start <= length(value)
    opening = pos('${',value,start)
    if opening = 0 then do
      result = result || substr(value,start)
      leave
    end
    result = result || substr(value,start,opening-start)
    closing = pos('}',value,opening+2)
    if closing = 0 then return 'RXBUILD substitution error: missing }'
    name = upper(strip(substr(value,opening+2,closing-opening-2)))
    if variable_value(variables,name) = '' then return 'RXBUILD substitution error: undefined variable ' || name
    result = result || variable_value(variables,name)
    start = closing + 1
  end
  return result

substitute_command_value: procedure = .string
  arg value = .string, primary_output = .string, inputs = .string[], outputs = .string[], variables = .string[]
  result = value
  if pos('${input}',result) > 0 then do
    if inputs[0] < 1 then return 'RXBUILD substitution error: COMMAND requires an INPUT for ${input}'
    result = changestr('${input}',result,project_path(inputs[1]))
  end
  if pos('${output}',result) > 0 then result = changestr('${output}',result,project_path(primary_output))
  return substitute_value(result,variables)

substitution_error: procedure = .int
  arg value = .string
  return pos('RXBUILD substitution error:',value) > 0

graph_boolean: procedure = .int
  arg value = .string
  normalized = lower(strip(value))
  if normalized = 'true' | normalized = 'yes' | normalized = '1' then return 1
  if normalized = 'false' | normalized = 'no' | normalized = '0' then return 0
  return -1

resolve_include_path: procedure = .string
  arg origin = .string, include_path = .string
  if left(include_path,1) = '/' | (length(include_path) >= 2 & substr(include_path,2,1) = ':') then return .rxfs..abspath(include_path)
  normalized_origin = translate(origin,'/','\')
  slash = lastpos('/',normalized_origin)
  if slash = 0 then return .rxfs..abspath(include_path)
  return .rxfs..abspath(left(normalized_origin,slash) || include_path)

project_root: procedure = .string
  root = .rxfs..cwd()
  do i = 1 to 8
    if (.rxfs..isdir(root || '/driver') | .rxfs..isdir(root || '/bin')) & .rxfs..isdir(root || '/examples') then return root
    parent = .rxfs..abspath(root || '/..')
    if parent = root then leave
    root = parent
  end
  return .rxfs..cwd()

project_path: procedure = .string
  arg path = .string
  if left(path,1) = '/' | (length(path) >= 2 & substr(path,2,1) = ':') then return .rxfs..abspath(path)
  return .rxfs..abspath(project_root() || '/' || path)

target_display: procedure = .string
  arg path = .string
  if left(path,7) = '@group/' then return path
  return project_path(path)

ensure_project_directories: procedure = .int
  arg dir = .string, output = .string
  return ensure_directory_tree(project_path(dir))

dirname: procedure = .string
  arg path = .string
  slash = lastpos('\\',path)
  alt_slash = lastpos('/',path)
  if alt_slash > slash then slash = alt_slash
  if slash = 0 then return '.'
  if slash = 1 then return left(path,1)
  if slash = 3 & substr(path,2,1) = ':' then return left(path,3)
  return left(path,slash-1)

basename_no_suffix: procedure = .string
  arg path = .string
  name = substr(path,lastpos('/',path)+1)
  dot = lastpos('.',name)
  if dot > 0 then name = left(name,dot-1)
  return name

without_suffix: procedure = .string
  arg path = .string
  dot = lastpos('.',path)
  if dot > lastpos('/',path) then return left(path,dot-1)
  return path

source_stem: procedure = .string
  arg source = .string
  name = substr(source,lastpos('/',source)+1)
  dot = lastpos('.',name)
  if dot > 0 then name = left(name,dot-1)
  return name

grammar_stem: procedure = .string
  arg source = .string
  return source_stem(source) || '_grammar'

tool: procedure = .string
  arg name = .string, toolchain_dir = .string
  version = ''
  assembler rxvers version
  executable = name
  if upper(word(version,1)) = 'WINDOWS' then executable = executable || '.exe'
  if toolchain_dir <> '' then path = project_path(toolchain_dir)
  else path = .rxfs..loadpath()
  if right(path,1) <> '/' & right(path,1) <> '\\' then path = path || '/'
  return path || executable

native_executable_path: procedure = .string
  arg base = .string
  version = ''
  assembler rxvers version
  if upper(word(version,1)) = 'WINDOWS' & right(upper(base),4) <> '.EXE' then return base || '.exe'
  return base

ensure_directory_tree: procedure = .int
  arg path = .string
  if path = '' then path = '.'
  if .rxfs..isdir(path) <> 0 then return 0
  slash = lastpos('\\',path)
  alt_slash = lastpos('/',path)
  if alt_slash > slash then slash = alt_slash
  if slash = 0 then parent = '.'
  else if slash = 1 then parent = left(path,1)
  else if slash = 3 & substr(path,2,1) = ':' then parent = left(path,3)
  else parent = left(path,slash-1)
  if parent <> path & parent <> '' then do
    if ensure_directory_tree(parent) <> 0 then return 1
  end
  if .rxfs..mkdir(path) = 0 | .rxfs..isdir(path) <> 0 then return 0
  return graph_error('cannot create directory ' || path)
