/* Composed graph example.  The nested graph is loaded relative to this file. */
INCLUDE_GRAPH "nested/demo.graph.build"

RULE compile_program
  ACTION = "COMPILE PROGRAM"
END RULE;

BUILD ".crexx-build/graph-composed-main.rxbin"
  BUILD_NAME = main_program
  RULE = compile_program
  INPUT = "tools/rxbuild/build_demo.crexx"
  DEPENDS_ON_BUILD = nested_program
END BUILD;

DEFAULT_BUILD = main_program;
