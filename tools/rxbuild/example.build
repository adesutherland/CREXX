/* Example rxBuild plan. */

BUILD_DIR = "cmake-build-release/build";
GRAMMAR_SOURCE = "tools/rxbuild/grammar/build.levell";
READER_SOURCE = "tools/rxbuild/build_reader.crexx";
GRAMMAR_OUTPUT = "rxbuildgrammar";
READER_OUTPUT = "build_reader";

COMPILE GRAMMAR OUTPUT_DIR = "${BUILD_DIR}" SOURCE = "${GRAMMAR_SOURCE}" OUTPUT = "${GRAMMAR_OUTPUT}";
COMPILE READER OUTPUT_DIR = "${BUILD_DIR}" SOURCE = "${READER_SOURCE}" DEPENDS_ON = "${GRAMMAR_OUTPUT}" OUTPUT = "${READER_OUTPUT}";
RUN WORK_DIR = "${BUILD_DIR}" PROGRAM = "build_demo" ARGUMENT = "-a" "tools/rxbuild/example.build" STDIN = "";
