/* Product build-time compiler for TUTOR-compatible single-byte mappings. */
options levelb

namespace _rxunicodebuild expose encoding_compile encodingtables
import rxfnsb

encoding_compile: procedure = .encodingtables
  arg windows1252_path = .string, ibm437_path = .string, ibm850_path = .string, ibm1047_path = .string
  tables = .encodingtables()
  call tables.compile(windows1252_path,ibm437_path,ibm850_path,ibm1047_path)
  return tables

encodingtables: class
  _status = .int
  _error = .string
  _error_line = .int
  _image = .binary
  _mapping_count = .int
  _encoding_count = .int

  *: factory
    _status = 0
    _error = ""
    _error_line = 0
    _mapping_count = 0
    _encoding_count = 0
    call binresize _image,64 + 4 * 32
    call binfill _image,0
    return

  compile: method = .void
    arg windows1252_path = .string, ibm437_path = .string, ibm850_path = .string, ibm1047_path = .string
    call _load_format_a windows1252_path,8,1
    if _status = 0 then call _load_format_a ibm437_path,9,0
    if _status = 0 then call _load_format_a ibm850_path,10,0
    if _status = 0 then call _load_ibm1047 ibm1047_path,11
    if _status \= 0 then return
    if _encoding_count \= 4 | _mapping_count \= 1024 then do
      call _fail "legacy encoding mapping count audit failed",0
      return
    end
    call _write_header
    return

  status: method = .int
    return _status

  error: method = .string
    return _error

  error_line: method = .int
    return _error_line

  image: method = .binary
    return _image

  byte_length: method = .int
    return <blen>(_image)

  mapping_count: method = .int
    return _mapping_count

  encoding_count: method = .int
    return _encoding_count

  expected_decode: method = .int
    arg encoding_code = .int, byte = .int
    descriptor = _descriptor_for(encoding_code)
    if descriptor < 0 | byte < 0 | byte > 255 then return -1
    decode_offset = <at..u32>(descriptor + 8) _image
    return <at..u32>(decode_offset + byte * 4) _image

  _descriptor_for: method = .int
    arg encoding_code = .int
    do descriptor_index = 0 to _encoding_count - 1
      descriptor = 64 + descriptor_index * 32
      if <at..u32>(descriptor) _image = encoding_code then return descriptor
    end
    return -1

  _new_map: method = .binary
    result = .binary
    call binresize result,256 * 4
    call binfill result,255
    return result

  _new_seen: method = .binary
    result = .binary
    call binresize result,256
    call binfill result,0
    return result

  _load_format_a: method = .void
    arg path = .string, encoding_code = .int, map_undefined_to_control = .int
    lines = readlines(path)
    if lines[0] <= 0 then do
      call _fail "legacy Format A mapping is empty or unreadable",0
      return
    end
    mapping = _new_map()
    seen = _new_seen()
    count = 0
    do line_number = 1 to lines[0] while _status = 0
      line = lines[line_number]
      comment = pos("#",line)
      if comment > 0 then line = left(line,comment - 1)
      line = strip(line)
      if line = "" then iterate
      source_token = upper(word(line,1))
      if length(source_token) \= 4 | left(source_token,2) \= "0X" |,
         datatype(substr(source_token,3),"X") = 0 then do
        call _fail "legacy Format A source byte is malformed",line_number
        leave
      end
      byte = x2d(substr(source_token,3))
      if byte < 0 | byte > 255 | <at..u8>(byte) seen \= 0 then do
        call _fail "legacy Format A source byte is duplicate or out of range",line_number
        leave
      end
      codepoint = .int
      if words(line) < 2 then do
        if map_undefined_to_control = 0 then do
          call _fail "legacy Format A mapping target is missing",line_number
          leave
        end
        codepoint = byte
      end
      else do
        target_token = upper(word(line,2))
        if length(target_token) < 3 | left(target_token,2) \= "0X" |,
           datatype(substr(target_token,3),"X") = 0 then do
          call _fail "legacy Format A Unicode target is malformed",line_number
          leave
        end
        codepoint = x2d(substr(target_token,3))
      end
      if codepoint < 0 | codepoint > 0xFFFF |,
         (codepoint >= 0xD800 & codepoint <= 0xDFFF) then do
        call _fail "legacy Format A target is not a supported Unicode scalar",line_number
        leave
      end
      <at..u32>(byte * 4) mapping = codepoint
      <at..u8>(byte) seen = 1
      count = count + 1
    end
    if _status = 0 & count \= 256 then,
      call _fail "legacy Format A mapping does not define all 256 bytes",0
    if _status = 0 then call _append_encoding encoding_code,mapping,count
    return

  _load_ibm1047: method = .void
    arg path = .string, encoding_code = .int
    lines = readlines(path)
    if lines[0] <= 0 then do
      call _fail "IBM1047 mapping is empty or unreadable",0
      return
    end
    mapping = _new_map()
    seen = _new_seen()
    count = 0
    do line_number = 1 to lines[0] while _status = 0 & count < 256
      line = strip(lines[line_number])
      if words(line) < 2 then iterate
      source_token = upper(word(line,1))
      target_token = upper(word(line,2))
      if length(source_token) \= 2 | length(target_token) \= 4 then iterate
      if datatype(source_token,"X") = 0 | datatype(target_token,"X") = 0 then iterate
      byte = x2d(source_token)
      codepoint = x2d(target_token)
      if <at..u8>(byte) seen \= 0 then do
        call _fail "IBM1047 source byte is duplicated",line_number
        leave
      end
      if codepoint >= 0xD800 & codepoint <= 0xDFFF then do
        call _fail "IBM1047 target is not a Unicode scalar",line_number
        leave
      end
      <at..u32>(byte * 4) mapping = codepoint
      <at..u8>(byte) seen = 1
      count = count + 1
    end
    if _status = 0 & count \= 256 then,
      call _fail "IBM1047 mapping does not define all 256 bytes",0
    if _status = 0 then call _append_encoding encoding_code,mapping,count
    return

  _append_encoding: method = .void
    arg encoding_code = .int, mapping = .binary, count = .int
    reverse = .binary
    call binresize reverse,0x10000 * 2
    call binfill reverse,255
    byte = .int
    codepoint = .int
    do byte = 0 to 255
      codepoint = <at..u32>(byte * 4) mapping
      if <at..u16>(codepoint * 2) reverse = 0xFFFF then,
        <at..u16>(codepoint * 2) reverse = byte
    end

    page_index = .binary
    records = .binary
    call binresize page_index,257 * 2
    call binresize records,256 * 8
    record_count = 0
    do page = 0 to 255
      <at..u16>(page * 2) page_index = record_count
      first = page * 256
      last = first + 255
      do codepoint = first to last
        byte = <at..u16>(codepoint * 2) reverse
        if byte = 0xFFFF then iterate
        record_offset = record_count * 8
        <at..u32>(record_offset) records = codepoint
        <at..u8>(record_offset + 4) records = byte
        record_count = record_count + 1
      end
    end
    <at..u16>(256 * 2) page_index = record_count
    call binresize records,record_count * 8

    descriptor = 64 + _encoding_count * 32
    decode_offset = <blen>(_image)
    call binappend _image,mapping
    page_offset = <blen>(_image)
    call binappend _image,page_index
    records_offset = <blen>(_image)
    call binappend _image,records

    <at..u32>(descriptor) _image = encoding_code
    <at..u32>(descriptor + 4) _image = 1
    <at..u32>(descriptor + 8) _image = decode_offset
    <at..u32>(descriptor + 12) _image = page_offset
    <at..u32>(descriptor + 16) _image = records_offset
    <at..u32>(descriptor + 20) _image = record_count
    <at..u32>(descriptor + 24) _image = 8
    <at..u32>(descriptor + 28) _image = count
    _encoding_count = _encoding_count + 1
    _mapping_count = _mapping_count + count
    return

  _write_header: method = .void
    <at..u8>(0) _image = 67
    <at..u8>(1) _image = 85
    <at..u8>(2) _image = 69
    <at..u8>(3) _image = 77
    <at..u16>(4) _image = 1
    <at..u16>(6) _image = 64
    <at..u16>(8) _image = _encoding_count
    <at..u16>(10) _image = 32
    <at..u32>(12) _image = 64
    <at..u32>(16) _image = <blen>(_image)
    <at..u32>(20) _image = _mapping_count
    <at..u32>(24) _image = 256
    <at..u32>(28) _image = 257
    return

  _fail: method = .void
    arg message = .string, line_number = .int
    if _status \= 0 then return
    _status = 1
    _error = message
    _error_line = line_number
    return
