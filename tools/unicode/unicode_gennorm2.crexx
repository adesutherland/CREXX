/*
 * cREXX License (MIT)
 *
 * Deterministic build-time parser for ICU gennorm2 normalization rules. The
 * generated Level L lexer supplies the tokens; this Level B parser walks
 * them once, constructs typed records, and panics on the first invalid rule.
 */

options levelb

namespace unicode_gennorm2 expose unicodegennorm2record unicodegennorm2ast unicodegennorm2result unicode_gennorm2_parse unicode_gennorm2_record_dump unicode_gennorm2_semantic_dump
import rxfnsb
import level_l_gennorm2

/** Parse one complete tokenized ICU gennorm2 normalization-rule source. */
unicode_gennorm2_parse: procedure = .unicodegennorm2result
  arg source = .string, tokens = .binary
  parser = .unicodegennorm2parser(source, tokens)
  return parser.parse()

/** Return the deterministic record dump, including token and byte spans. */
unicode_gennorm2_record_dump: procedure = .string
  arg result = .unicodegennorm2result
  if result.status() \= 0 then return ""
  return result.ast().record_dump()

/** Return canonical parsed values for comparison with an independent parser. */
unicode_gennorm2_semantic_dump: procedure = .string
  arg result = .unicodegennorm2result
  if result.status() \= 0 then return ""
  return result.ast().semantic_dump()

unicode_gennorm2_codepoint: procedure = .string
  arg value = .int
  if value <= 0xFFFF then return right(d2x(value), 4, "0")
  return right(d2x(value), 6, "0")

unicode_gennorm2_is_scalar: procedure = .int
  arg value = .int
  if value < 0 | value > 0x10FFFF then return 0
  if value >= 0xD800 & value <= 0xDFFF then return 0
  return 1

/** One typed record in the Unicode normalization-rule AST. */
unicodegennorm2record: class
  _kind = .string
  _line = .int
  _source_start = .int
  _source_length = .int
  _token_start = .int
  _token_count = .int
  _first = .int
  _last = .int
  _number = .int
  _text = .string
  _values = .int[]
  _value_count = .int

  *: factory
    arg kind = .string, line = .int, source_start = .int, source_length = .int, token_start = .int, token_count = .int, first = -1, last = -1, number = -1, text = "", values = .int[], value_count = 0
    _kind = kind
    _line = line
    _source_start = source_start
    _source_length = source_length
    _token_start = token_start
    _token_count = token_count
    _first = first
    _last = last
    _number = number
    _text = text
    _values = values
    _value_count = value_count
    return

  kind: method = .string
    return _kind

  line: method = .int
    return _line

  source_start: method = .int
    return _source_start

  source_length: method = .int
    return _source_length

  source_end: method = .int
    return _source_start + _source_length

  token_start: method = .int
    return _token_start

  token_count: method = .int
    return _token_count

  first: method = .int
    return _first

  last: method = .int
    return _last

  number: method = .int
    return _number

  text: method = .string
    return _text

  value_count: method = .int
    return _value_count

  value_at: method = .int
    arg index = .int
    return _values[index + 1]

  sequence_text: method = .string
    out = ""
    do i = 0 to _value_count - 1
      if i > 0 then out = out || " "
      out = out || unicode_gennorm2_codepoint(_values[i + 1])
    end
    return out

  record_dump: method = .string
    nl = "0a"x
    return _kind || "|" || _line || "|" || _source_start || "|" || _source_length || "|" ||,
           _token_start || "|" || _token_count || "|" || _first || "|" || _last || "|" ||,
           _number || "|" || _text || "|" || sequence_text() || nl

  semantic_dump: method = .string
    nl = "0a"x
    select _kind
      when "version" then return "version|" || _text || nl
      when "ccc_single" then return "ccc_single|" || unicode_gennorm2_codepoint(_first) || "|" || _number || nl
      when "ccc_range" then return "ccc_range|" || unicode_gennorm2_codepoint(_first) || "|" || unicode_gennorm2_codepoint(_last) || "|" || _number || nl
      when "mapping_two_way" then return "mapping_two_way|" || unicode_gennorm2_codepoint(_first) || "|" || sequence_text() || nl
      when "mapping_one_way" then return "mapping_one_way|" || unicode_gennorm2_codepoint(_first) || "|" || sequence_text() || nl
      otherwise return "unsupported|" || _kind || nl
    end
    return ""

/** Root of the typed Unicode normalization-rule AST. */
unicodegennorm2ast: class
  _records = .object[]
  _record_count = .int
  _version = .string
  _ccc_records = .int
  _ccc_codepoints = .int
  _two_way_mappings = .int
  _one_way_mappings = .int
  _mapping_values = .int

  *: factory
    _record_count = 0
    _version = ""
    _ccc_records = 0
    _ccc_codepoints = 0
    _two_way_mappings = 0
    _one_way_mappings = 0
    _mapping_values = 0
    return

  add_record: method = .int
    arg record = .unicodegennorm2record
    _record_count = objectarrayappend(_records, record as .object)
    select record.kind()
      when "version" then _version = record.text()
      when "ccc_single" then do
        _ccc_records = _ccc_records + 1
        _ccc_codepoints = _ccc_codepoints + 1
      end
      when "ccc_range" then do
        _ccc_records = _ccc_records + 1
        _ccc_codepoints = _ccc_codepoints + record.last() - record.first() + 1
      end
      when "mapping_two_way" then do
        _two_way_mappings = _two_way_mappings + 1
        _mapping_values = _mapping_values + record.value_count()
      end
      when "mapping_one_way" then do
        _one_way_mappings = _one_way_mappings + 1
        _mapping_values = _mapping_values + record.value_count()
      end
      otherwise nop
    end
    return _record_count - 1

  record_count: method = .int
    return _record_count

  record_at: method = .unicodegennorm2record
    arg index = .int
    return _records[index + 1] as .unicodegennorm2record

  version: method = .string
    return _version

  ccc_records: method = .int
    return _ccc_records

  ccc_codepoints: method = .int
    return _ccc_codepoints

  two_way_mappings: method = .int
    return _two_way_mappings

  one_way_mappings: method = .int
    return _one_way_mappings

  mapping_values: method = .int
    return _mapping_values

  record_dump: method = .string
    out = ""
    do i = 0 to _record_count - 1
      record = _records[i + 1] as .unicodegennorm2record
      out = out || i || "|" || record.record_dump()
    end
    return out

  semantic_dump: method = .string
    out = ""
    do i = 0 to _record_count - 1
      record = _records[i + 1] as .unicodegennorm2record
      out = out || record.semantic_dump()
    end
    return out

/** Unicode-rule parse result and first-fault panic details. */
unicodegennorm2result: class
  _ast = .unicodegennorm2ast
  _status = .int
  _error = .string
  _error_start = .int
  _error_length = .int
  _error_token = .int
  _error_line = .int

  *: factory
    _ast = .unicodegennorm2ast()
    _status = 0
    _error = ""
    _error_start = 0
    _error_length = 0
    _error_token = 0
    _error_line = 1
    return

  ast: method = .unicodegennorm2ast
    return _ast

  set_ast: method = .void
    arg ast = .unicodegennorm2ast
    _ast = ast
    return

  panic: method = .void
    arg message = .string, start = .int, span_length = .int, token_index = .int, line = .int
    if _status \= 0 then return
    _status = 1
    _error = message
    _error_start = start
    _error_length = span_length
    _error_token = token_index
    _error_line = line
    return

  status: method = .int
    return _status

  error: method = .string
    return _error

  error_start: method = .int
    return _error_start

  error_length: method = .int
    return _error_length

  error_token: method = .int
    return _error_token

  error_line: method = .int
    return _error_line

/* Single-cursor, one-token-lookahead parser with no recovery or backtracking. */
unicodegennorm2parser: class
  _source = .string
  _source_bytes = .binary
  _tokens = .binary
  _cursor = .int
  _line = .int
  _result = .unicodegennorm2result
  _ast = .unicodegennorm2ast
  _ccc_seen = .stem
  _mapping_seen = .stem

  *: factory
    arg source = .string, tokens = .binary
    _source = source
    _source_bytes = source as .binary
    _tokens = tokens
    _cursor = 0
    _line = 1
    _result = .unicodegennorm2result()
    _ast = _result.ast()
    _ccc_seen = .stem()
    _mapping_seen = .stem()
    return

  parse: method = .unicodegennorm2result
    do while _result.status() = 0
      if _cursor >= _token_count() then do
        call _panic_here("missing EOF token")
        leave
      end
      kind = _kind()
      select kind
        when 9 then call _consume_newline()
        when 6 then call _parse_version()
        when 1 then call _parse_data_record()
        when 0 then do
          if _cursor \= _token_count() - 1 then call _panic_here("unexpected token after EOF")
          else if _start(_cursor) \= <blen>(_source_bytes) | _length(_cursor) \= 0 then,
            call _panic_here("invalid EOF token span")
          _cursor = _cursor + 1
          leave
        end
        otherwise call _panic_here("expected a Unicode version, CCC, or mapping record")
      end
    end

    if _result.status() = 0 then do
      if _ast.version() = "" then call _panic_here("missing Unicode version declaration")
      else if _ast.ccc_records() = 0 | (_ast.two_way_mappings() + _ast.one_way_mappings()) = 0 then,
        call _panic_here("incomplete normalization rules")
    end
    call _result.set_ast(_ast)
    return _result

  _token_count: method = .int
    return level_l_gennorm2_token_count(_tokens)

  _kind: method = .int
    if _cursor >= _token_count() then return 0
    return level_l_gennorm2_token_kind(_tokens, _cursor)

  _start: method = .int
    arg index = .int
    if index < 0 | index >= _token_count() then return <blen>(_source_bytes)
    return level_l_gennorm2_token_start(_tokens, index)

  _length: method = .int
    arg index = .int
    if index < 0 | index >= _token_count() then return 0
    return level_l_gennorm2_token_length(_tokens, index)

  _text: method = .string
    arg index = .int
    start = _start(index)
    span_length = _length(index)
    out = ""
    do i = 0 to span_length - 1
      out = out || d2c(<at..u8>(start + i) _source_bytes)
    end
    return out

  _panic_here: method = .void
    arg message = .string
    call _result.panic(message, _start(_cursor), _length(_cursor), _cursor, _line)
    return

  _expect: method = .int
    arg expected = .int, description = .string
    if _result.status() \= 0 then return -1
    if _kind() \= expected then do
      call _panic_here("expected " || description)
      return -1
    end
    index = _cursor
    _cursor = _cursor + 1
    return index

  _consume_newline: method = .void
    ignored = _expect(9, "end of line")
    if ignored >= 0 then _line = _line + 1
    return

  _parse_version: method = .void
    record_line = _line
    first_token = _expect(6, "'*'")
    ignored = _expect(7, "Unicode after '*'")
    version_token = _expect(8, "Unicode version number")
    if _result.status() \= 0 then return

    version = _text(version_token)
    if _ast.version() \= "" then do
      call _result.panic("duplicate Unicode version declaration", _start(first_token), _length(first_token), first_token, record_line)
      return
    end
    if version \= "17.0.0" then do
      call _result.panic("expected Unicode version 17.0.0", _start(version_token), _length(version_token), version_token, record_line)
      return
    end

    newline_token = _expect(9, "end of Unicode version declaration")
    if _result.status() \= 0 then return
    source_start = _start(first_token)
    source_length = _start(newline_token) - source_start
    values = .int[]
    record = .unicodegennorm2record("version", record_line, source_start, source_length, first_token, newline_token - first_token + 1, -1, -1, -1, version, values, 0)
    ignored = _ast.add_record(record)
    _line = _line + 1
    return

  _parse_data_record: method = .void
    record_line = _line
    first_token = _expect(1, "hexadecimal code point")
    first = _parse_codepoint(first_token, "record source")
    if _result.status() \= 0 then return

    select _kind()
      when 2 then call _parse_ccc_range(first_token, first, record_line)
      when 3 then call _parse_ccc_single(first_token, first, record_line)
      when 4 then call _parse_mapping(first_token, first, record_line, 1)
      when 5 then call _parse_mapping(first_token, first, record_line, 0)
      otherwise call _panic_here("expected '..', ':', '=', or '>' after record source")
    end
    return

  _parse_ccc_range: method = .void
    arg first_token = .int, first = .int, record_line = .int
    ignored = _expect(2, "'..'")
    last_token = _expect(1, "range end code point")
    if _result.status() \= 0 then return
    last = _parse_codepoint(last_token, "range end")
    if _result.status() \= 0 then return
    if last < first then do
      call _result.panic("canonical-combining-class range is reversed", _start(last_token), _length(last_token), last_token, record_line)
      return
    end
    if first <= 0xDFFF & last >= 0xD800 then do
      call _result.panic("canonical-combining-class range contains a surrogate", _start(first_token), _start(last_token) + _length(last_token) - _start(first_token), first_token, record_line)
      return
    end
    ignored = _expect(3, "':' after canonical-combining-class range")
    value_token = _expect(1, "decimal canonical combining class")
    if _result.status() \= 0 then return
    value = _parse_ccc(value_token)
    if _result.status() \= 0 then return
    newline_token = _expect(9, "end of canonical-combining-class record")
    if _result.status() \= 0 then return
    if _ccc_overlaps(first, last) then do
      call _result.panic("overlapping canonical-combining-class range", _start(first_token), _start(newline_token) - _start(first_token), first_token, record_line)
      return
    end
    call _remember_ccc first, last
    values = .int[]
    source_start = _start(first_token)
    record = .unicodegennorm2record("ccc_range", record_line, source_start, _start(newline_token) - source_start, first_token, newline_token - first_token + 1, first, last, value, "", values, 0)
    ignored = _ast.add_record(record)
    _line = _line + 1
    return

  _parse_ccc_single: method = .void
    arg first_token = .int, first = .int, record_line = .int
    ignored = _expect(3, "':'")
    value_token = _expect(1, "decimal canonical combining class")
    if _result.status() \= 0 then return
    value = _parse_ccc(value_token)
    if _result.status() \= 0 then return
    newline_token = _expect(9, "end of canonical-combining-class record")
    if _result.status() \= 0 then return
    if _ccc_overlaps(first, first) then do
      call _result.panic("overlapping canonical-combining-class range", _start(first_token), _start(newline_token) - _start(first_token), first_token, record_line)
      return
    end
    call _remember_ccc first, first
    values = .int[]
    source_start = _start(first_token)
    record = .unicodegennorm2record("ccc_single", record_line, source_start, _start(newline_token) - source_start, first_token, newline_token - first_token + 1, first, first, value, "", values, 0)
    ignored = _ast.add_record(record)
    _line = _line + 1
    return

  _parse_mapping: method = .void
    arg first_token = .int, first = .int, record_line = .int, two_way = .int
    if two_way then ignored = _expect(4, "'='")
    else ignored = _expect(5, "'>'")
    if _result.status() \= 0 then return

    values = .int[]
    value_count = 0
    do while _kind() = 1 & _result.status() = 0
      value_token = _expect(1, "mapping code point")
      value = _parse_codepoint(value_token, "mapping value")
      if _result.status() = 0 then do
        value_count = value_count + 1
        values[value_count] = value
      end
    end
    if value_count = 0 then do
      call _panic_here("expected at least one mapping code point")
      return
    end
    if two_way & value_count \= 2 then do
      call _result.panic("two-way mapping must contain exactly two code points", _start(first_token), _start(_cursor) - _start(first_token), first_token, record_line)
      return
    end

    newline_token = _expect(9, "end of decomposition mapping")
    if _result.status() \= 0 then return
    if _mapping_exists(first) then do
      call _result.panic("duplicate decomposition mapping", _start(first_token), _start(newline_token) - _start(first_token), first_token, record_line)
      return
    end
    call _mapping_seen.set(first || "", "1")
    if two_way then kind = "mapping_two_way"
    else kind = "mapping_one_way"
    source_start = _start(first_token)
    record = .unicodegennorm2record(kind, record_line, source_start, _start(newline_token) - source_start, first_token, newline_token - first_token + 1, first, first, -1, "", values, value_count)
    ignored = _ast.add_record(record)
    _line = _line + 1
    return

  _parse_codepoint: method = .int
    arg token_index = .int, description = .string
    value = _parse_hex(token_index)
    if _result.status() \= 0 then return -1
    if unicode_gennorm2_is_scalar(value) = 0 then do
      call _result.panic(description || " is not a Unicode scalar value", _start(token_index), _length(token_index), token_index, _line)
      return -1
    end
    return value

  _parse_hex: method = .int
    arg token_index = .int
    text = _text(token_index)
    value = 0
    do i = 1 to length(text)
      byte = c2d(substr(text, i, 1))
      if byte >= 48 & byte <= 57 then digit = byte - 48
      else if byte >= 65 & byte <= 70 then digit = byte - 55
      else do
        call _result.panic("invalid hexadecimal field", _start(token_index), _length(token_index), token_index, _line)
        return -1
      end
      value = value * 16 + digit
      if value > 0x10FFFF then do
        call _result.panic("code point exceeds U+10FFFF", _start(token_index), _length(token_index), token_index, _line)
        return -1
      end
    end
    return value

  _parse_ccc: method = .int
    arg token_index = .int
    text = _text(token_index)
    value = 0
    do i = 1 to length(text)
      byte = c2d(substr(text, i, 1))
      if byte < 48 | byte > 57 then do
        call _result.panic("canonical combining class is not decimal", _start(token_index), _length(token_index), token_index, _line)
        return -1
      end
      value = value * 10 + byte - 48
    end
    if value < 1 | value > 255 then do
      call _result.panic("canonical combining class must be 1..255", _start(token_index), _length(token_index), token_index, _line)
      return -1
    end
    return value

  _ccc_overlaps: method = .int
    arg first = .int, last = .int
    do codepoint = first to last
      if _ccc_seen.get(codepoint || "") = "1" then return 1
    end
    return 0

  _remember_ccc: method = .void
    arg first = .int, last = .int
    do codepoint = first to last
      call _ccc_seen.set(codepoint || "", "1")
    end
    return

  _mapping_exists: method = .int
    arg source = .int
    return _mapping_seen.get(source || "") = "1"
