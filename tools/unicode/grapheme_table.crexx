/*
 * cREXX License (MIT)
 *
 * Product build-time compiler for the pinned Unicode 17.0.0 extended-
 * grapheme properties. One byte per scalar packs Grapheme_Cluster_Break,
 * Extended_Pictographic, and Indic_Conjunct_Break values.
 */

options levelb

namespace _rxunicodebuild expose graphemetables grapheme_compile
import rxfnsb

/** Compile the three normative property inputs required by extended graphemes. */
grapheme_compile: procedure = .graphemetables
  arg grapheme_path = .string, emoji_path = .string, core_path = .string, version = .string
  tables = .graphemetables()
  call tables.compile(grapheme_path, emoji_path, core_path, version)
  return tables

grapheme_is_scalar: procedure = .int
  arg codepoint = .int
  if codepoint < 0 | codepoint > 0x10FFFF then return 0
  if codepoint >= 0xD800 & codepoint <= 0xDFFF then return 0
  return 1

/** Portable prepared extended-grapheme property section. */
graphemetables: class
  _status = .int
  _error = .string
  _error_line = .int
  _properties = .binary
  _image = .binary
  _gcb_assigned = .int
  _gcb_cr = .int
  _gcb_lf = .int
  _gcb_control = .int
  _gcb_extend = .int
  _gcb_l = .int
  _gcb_v = .int
  _gcb_t = .int
  _gcb_lv = .int
  _gcb_lvt = .int
  _gcb_ri = .int
  _gcb_prepend = .int
  _gcb_spacingmark = .int
  _gcb_zwj = .int
  _extended_pictographic = .int
  _incb_consonant = .int
  _incb_extend = .int
  _incb_linker = .int

  *: factory
    _status = 0
    _error = ""
    _error_line = 0
    _gcb_assigned = 0
    _gcb_cr = 0
    _gcb_lf = 0
    _gcb_control = 0
    _gcb_extend = 0
    _gcb_l = 0
    _gcb_v = 0
    _gcb_t = 0
    _gcb_lv = 0
    _gcb_lvt = 0
    _gcb_ri = 0
    _gcb_prepend = 0
    _gcb_spacingmark = 0
    _gcb_zwj = 0
    _extended_pictographic = 0
    _incb_consonant = 0
    _incb_extend = 0
    _incb_linker = 0
    call binresize _properties, 0x110000
    call binresize _image, 0
    return

  compile: method = .void
    arg grapheme_path = .string, emoji_path = .string, core_path = .string, version = .string
    if version \= "17.0.0" then do
      call _fail "grapheme compiler requires Unicode version 17.0.0", 0
      return
    end
    call _parse_gcb grapheme_path
    if _status = 0 then call _parse_emoji emoji_path
    if _status = 0 then call _parse_incb core_path
    if _status \= 0 then return
    if _gcb_assigned \= 18101 | _gcb_cr \= 1 | _gcb_lf \= 1 |,
       _gcb_control \= 3893 | _gcb_extend \= 2237 |,
       _gcb_l \= 125 | _gcb_v \= 100 | _gcb_t \= 137 |,
       _gcb_lv \= 399 | _gcb_lvt \= 10773 | _gcb_ri \= 26 |,
       _gcb_prepend \= 27 | _gcb_spacingmark \= 381 | _gcb_zwj \= 1 |,
       _extended_pictographic \= 2848 | _incb_consonant \= 911 |,
       _incb_extend \= 2217 | _incb_linker \= 20 then do
      call _fail "Unicode 17 extended-grapheme property count audit failed", 0
      return
    end
    call _assemble_image
    return

  status: method = .int
    return _status

  error: method = .string
    return _error

  error_line: method = .int
    return _error_line

  image: method = .binary
    return _image

  byte_length: method = .int
    return <blen>(_image)

  gcb_assigned: method = .int
    return _gcb_assigned

  extended_pictographic_count: method = .int
    return _extended_pictographic

  incb_consonant_count: method = .int
    return _incb_consonant

  incb_extend_count: method = .int
    return _incb_extend

  incb_linker_count: method = .int
    return _incb_linker

  _parse_gcb: method = .void
    arg path = .string
    first = .int
    last = .int
    lines = readlines(path)
    if lines[0] <= 0 then do
      call _fail "GraphemeBreakProperty input is empty or unreadable", 0
      return
    end
    do line_number = 1 to lines[0] while _status = 0
      line = lines[line_number]
      comment = pos("#", line)
      if comment > 0 then line = left(line, comment - 1)
      line = strip(line)
      if line = "" then iterate
      fields = qsplit(line, ";")
      if fields[0] < 2 then do
        call _fail "GraphemeBreakProperty record is malformed", line_number
        leave
      end
      range = strip(fields[1])
      property = strip(fields[2])
      code = _gcb_code(property)
      if code < 0 then do
        call _fail "unknown Grapheme_Cluster_Break value", line_number
        leave
      end
      dots = pos("..", range)
      if dots = 0 then do
        first = x2d(range)
        last = first
      end
      else do
        first = x2d(strip(left(range, dots - 1)))
        last = x2d(strip(substr(range, dots + 2)))
      end
      if _valid_range(first, last) = 0 then do
        call _fail "invalid Grapheme_Cluster_Break range", line_number
        leave
      end
      call _set_gcb first, last, code, line_number
    end
    return

  _parse_emoji: method = .void
    arg path = .string
    first = .int
    last = .int
    lines = readlines(path)
    if lines[0] <= 0 then do
      call _fail "emoji-data input is empty or unreadable", 0
      return
    end
    do line_number = 1 to lines[0] while _status = 0
      line = lines[line_number]
      comment = pos("#", line)
      if comment > 0 then line = left(line, comment - 1)
      line = strip(line)
      if line = "" then iterate
      fields = qsplit(line, ";")
      if fields[0] < 2 | strip(fields[2]) \= "Extended_Pictographic" then iterate
      range = strip(fields[1])
      dots = pos("..", range)
      if dots = 0 then do
        first = x2d(range)
        last = first
      end
      else do
        first = x2d(strip(left(range, dots - 1)))
        last = x2d(strip(substr(range, dots + 2)))
      end
      if _valid_range(first, last) = 0 then do
        call _fail "invalid Extended_Pictographic range", line_number
        leave
      end
      call _set_extended_pictographic first, last, line_number
    end
    return

  _parse_incb: method = .void
    arg path = .string
    first = .int
    last = .int
    lines = readlines(path)
    if lines[0] <= 0 then do
      call _fail "DerivedCoreProperties input is empty or unreadable", 0
      return
    end
    do line_number = 1 to lines[0] while _status = 0
      line = lines[line_number]
      comment = pos("#", line)
      if comment > 0 then line = left(line, comment - 1)
      line = strip(line)
      if line = "" then iterate
      fields = qsplit(line, ";")
      if fields[0] < 3 | strip(fields[2]) \= "InCB" then iterate
      value = strip(fields[3])
      if value = "Consonant" then incb = 1
      else if value = "Extend" then incb = 2
      else if value = "Linker" then incb = 3
      else do
        call _fail "unknown InCB value", line_number
        leave
      end
      range = strip(fields[1])
      dots = pos("..", range)
      if dots = 0 then do
        first = x2d(range)
        last = first
      end
      else do
        first = x2d(strip(left(range, dots - 1)))
        last = x2d(strip(substr(range, dots + 2)))
      end
      if _valid_range(first, last) = 0 then do
        call _fail "invalid InCB range", line_number
        leave
      end
      call _set_incb first, last, incb, line_number
    end
    return

  _gcb_code: method = .int
    arg property = .string
    if property = "CR" then return 1
    if property = "LF" then return 2
    if property = "Control" then return 3
    if property = "Extend" then return 4
    if property = "L" then return 5
    if property = "V" then return 6
    if property = "T" then return 7
    if property = "LV" then return 8
    if property = "LVT" then return 9
    if property = "Regional_Indicator" then return 10
    if property = "Prepend" then return 11
    if property = "SpacingMark" then return 12
    if property = "ZWJ" then return 13
    return -1

  _set_gcb: method = .void
    arg first = .int, last = .int, code = .int, line_number = .int
    count = last - first + 1
    do codepoint = first to last while _status = 0
      old = <at..u8>(codepoint) _properties
      if (old <and> 0x0F) \= 0 then,
        call _fail "overlapping Grapheme_Cluster_Break range", line_number
      else <at..u8>(codepoint) _properties = old <or> code
    end
    if _status \= 0 then return
    _gcb_assigned = _gcb_assigned + count
    select code
      when 1 then _gcb_cr = _gcb_cr + count
      when 2 then _gcb_lf = _gcb_lf + count
      when 3 then _gcb_control = _gcb_control + count
      when 4 then _gcb_extend = _gcb_extend + count
      when 5 then _gcb_l = _gcb_l + count
      when 6 then _gcb_v = _gcb_v + count
      when 7 then _gcb_t = _gcb_t + count
      when 8 then _gcb_lv = _gcb_lv + count
      when 9 then _gcb_lvt = _gcb_lvt + count
      when 10 then _gcb_ri = _gcb_ri + count
      when 11 then _gcb_prepend = _gcb_prepend + count
      when 12 then _gcb_spacingmark = _gcb_spacingmark + count
      when 13 then _gcb_zwj = _gcb_zwj + count
    end
    return

  _set_extended_pictographic: method = .void
    arg first = .int, last = .int, line_number = .int
    do codepoint = first to last while _status = 0
      old = <at..u8>(codepoint) _properties
      if (old <and> 0x10) \= 0 then,
        call _fail "overlapping Extended_Pictographic range", line_number
      else <at..u8>(codepoint) _properties = old <or> 0x10
    end
    if _status = 0 then _extended_pictographic = _extended_pictographic + last - first + 1
    return

  _set_incb: method = .void
    arg first = .int, last = .int, incb = .int, line_number = .int
    do codepoint = first to last while _status = 0
      old = <at..u8>(codepoint) _properties
      if (old <and> 0x60) \= 0 then,
        call _fail "overlapping InCB range", line_number
      else <at..u8>(codepoint) _properties = old <or> (incb <shl> 5)
    end
    if _status \= 0 then return
    count = last - first + 1
    if incb = 1 then _incb_consonant = _incb_consonant + count
    else if incb = 2 then _incb_extend = _incb_extend + count
    else _incb_linker = _incb_linker + count
    return

  _valid_range: method = .int
    arg first = .int, last = .int
    if first < 0 | last < first | last > 0x10FFFF then return 0
    if first <= 0xDFFF & last >= 0xD800 then return 0
    return 1

  _assemble_image: method = .void
    header_size = 64
    properties_offset = header_size
    total_size = properties_offset + 0x110000
    call binresize _image, total_size
    <at..u8>(0) _image = 67
    <at..u8>(1) _image = 85
    <at..u8>(2) _image = 67
    <at..u8>(3) _image = 71
    <at..u16>(4) _image = 1
    <at..u16>(6) _image = header_size
    <at..u16>(8) _image = 17
    <at..u16>(10) _image = 0
    <at..u16>(12) _image = 0
    <at..u16>(14) _image = 47
    <at..u32>(16) _image = properties_offset
    <at..u32>(20) _image = 0x110000
    <at..u32>(24) _image = _gcb_assigned
    <at..u32>(28) _image = _extended_pictographic
    <at..u32>(32) _image = _incb_consonant
    <at..u32>(36) _image = _incb_extend
    <at..u32>(40) _image = _incb_linker
    <at..u32>(44) _image = total_size
    call bincopy _image, properties_offset, _properties, 0, <blen>(_properties)
    return

  _fail: method = .void
    arg message = .string, line_number = .int
    if _status \= 0 then return
    _status = 1
    _error = message
    _error_line = line_number
    return
