cmake_minimum_required(VERSION 3.24)
include_guard(GLOBAL)

# Inactive prototype for the paused Python-replacement proposal in
# docs/SANITIZER-WORKLIST.md (PYN-AC01..07). No runner, workflow, CTest or build
# registration includes this file. It is not an assurance/fixture-seal authority.
#
# These helpers are incomplete: source fingerprints use a tab separator while
# the maintained Python seal uses NUL, so existing seals are incompatible.
# JSON string escaping does not cover every control character; qa_array does
# not independently require JSON ARRAY type. Adjacent sanitizer-flag
# normalization and CLI/identity failure contracts also remain unqualified.
# Syntax/basic-helper smoke checks cannot establish replacement readiness.
# Integration requires the
# independent positive/negative PYN contracts before any caller is migrated.
function(qa_string out value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(qa_get out json)
  string(JSON value ERROR_VARIABLE error GET "${json}" ${ARGN})
  if(error)
    set(value "")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(qa_require out json)
  string(JSON value ERROR_VARIABLE error GET "${json}" ${ARGN})
  if(error)
    message(FATAL_ERROR "Missing sanitizer data field: ${ARGN}")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(qa_array out json)
  string(JSON length ERROR_VARIABLE error LENGTH "${json}" ${ARGN})
  if(error)
    message(FATAL_ERROR "Expected sanitizer array: ${ARGN}")
  endif()
  set(values)
  if(length GREATER 0)
    math(EXPR last "${length}-1")
    foreach(index RANGE 0 ${last})
      string(JSON value GET "${json}" ${ARGN} ${index})
      string(REPLACE ";" "\\;" value "${value}")
      list(APPEND values "${value}")
    endforeach()
  endif()
  set(${out} "${values}" PARENT_SCOPE)
endfunction()

function(qa_list_json out)
  set(result "[]")
  set(index 0)
  foreach(value IN LISTS ARGN)
    qa_string(quoted "${value}")
    string(JSON result SET "${result}" ${index} "${quoted}")
    math(EXPR index "${index}+1")
  endforeach()
  set(${out} "${result}" PARENT_SCOPE)
endfunction()

function(qa_write path content)
  get_filename_component(directory "${path}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef token)
  set(temporary "${path}.${token}.tmp")
  file(WRITE "${temporary}" "${content}\n")
  file(RENAME "${temporary}" "${path}" RESULT error)
  if(error)
    file(REMOVE "${temporary}")
    message(FATAL_ERROR "Cannot publish sanitizer state: ${path}: ${error}")
  endif()
endfunction()

function(qa_hash out path)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
    message(FATAL_ERROR "Missing sanitizer input: ${path}")
  endif()
  file(SHA256 "${path}" hash)
  set(${out} "${hash}" PARENT_SCOPE)
endfunction()

function(qa_source_identity out root include_docs)
  file(REAL_PATH "${root}" root)
  execute_process(COMMAND git -c core.quotepath=false -C "${root}" ls-files --cached --recurse-submodules
    RESULT_VARIABLE status OUTPUT_VARIABLE tracked ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inventory source inputs: ${root}: ${error}")
  endif()
  execute_process(COMMAND git -c core.quotepath=false -C "${root}" ls-files --others --exclude-standard
    RESULT_VARIABLE status OUTPUT_VARIABLE untracked ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inventory untracked inputs: ${root}: ${error}")
  endif()
  string(REPLACE ";" "\\;" paths "${tracked}${untracked}")
  string(REPLACE "\n" ";" paths "${paths}")
  list(REMOVE_DUPLICATES paths)
  list(SORT paths)
  set(content "")
  foreach(path IN LISTS paths)
    if(path STREQUAL "" OR path MATCHES "(^|/)__pycache__(/|$)|[.]pyc$" OR
       (NOT include_docs AND (path MATCHES "^docs/" OR path MATCHES "[.](md|tex|pdf)$")))
      continue()
    endif()
    # Quoted Git paths have control characters which cannot be represented in
    # the line-oriented inventory. Reject them rather than omit an input.
    if(path MATCHES "^\"")
      message(FATAL_ERROR "Unsupported quoted source path in sanitizer inventory: ${path}")
    endif()
    if(EXISTS "${root}/${path}" AND NOT IS_DIRECTORY "${root}/${path}")
      qa_hash(hash "${root}/${path}")
      string(APPEND content "${path}\t${hash}\n")
    endif()
  endforeach()
  string(SHA256 hash "${content}")
  set(${out} "${hash}" PARENT_SCOPE)
endfunction()

function(qa_config out build)
  file(READ "${build}/qa-fixture-config.json" config)
  set(${out} "${config}" PARENT_SCOPE)
endfunction()

function(qa_dependencies out config)
  set(result "{}")
  qa_get(root "${config}" DSLSH_SOURCE_DIR)
  if(root)
    qa_source_identity(contents "${root}" TRUE)
    execute_process(COMMAND git -C "${root}" rev-parse HEAD
      RESULT_VARIABLE status OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Cannot identify fetched dependency: ${error}")
    endif()
    qa_string(commit "${commit}")
    string(JSON result SET "${result}" DSLSH_SOURCE_DIR "{\"contents\":\"${contents}\",\"commit\":${commit}}")
  endif()
  set(${out} "${result}" PARENT_SCOPE)
endfunction()

function(qa_identity out build)
  file(REAL_PATH "${build}" build)
  qa_config(config "${build}")
  qa_require(source "${config}" CMAKE_HOME_DIRECTORY)
  qa_source_identity(source_hash "${source}" FALSE)
  qa_dependencies(dependencies "${config}")
  set(normalized "{}")
  string(JSON length LENGTH "${config}")
  math(EXPR last "${length}-1")
  qa_get(config_build "${config}" CMAKE_BINARY_DIR)
  foreach(index RANGE 0 ${last})
    string(JSON name MEMBER "${config}" ${index})
    if(name STREQUAL CREXX_QA_FIXTURE_TREE OR name STREQUAL DSLSH_SOURCE_DIR)
      continue()
    endif()
    qa_require(value "${config}" "${name}")
    if(name MATCHES "^CMAKE_(C|CXX|EXE_LINKER|SHARED_LINKER|MODULE_LINKER)_FLAGS")
      string(REGEX REPLACE "(^|[ \t])(-fsanitize=address|-fno-omit-frame-pointer)([ \t]|$)" " " value "${value}")
      string(REGEX REPLACE "[ \t]+" " " value "${value}")
      string(STRIP "${value}" value)
    endif()
    if(NOT config_build STREQUAL "")
      string(REPLACE "${config_build}" "<BUILD>" value "${value}")
    endif()
    string(REPLACE "${build}" "<BUILD>" value "${value}")
    qa_string(quoted "${value}")
    string(JSON normalized SET "${normalized}" "${name}" "${quoted}")
  endforeach()
  set(result "{\"source\":\"${source_hash}\"}")
  string(JSON result SET "${result}" configuration "${normalized}")
  string(JSON result SET "${result}" dependencies "${dependencies}")
  set(${out} "${result}" PARENT_SCOPE)
endfunction()

function(qa_parse_cli)
  set(command "")
  set(extra)
  set(index 0)
  while(index LESS CMAKE_ARGC)
    if(CMAKE_ARGV${index} STREQUAL "--")
      math(EXPR index "${index}+1")
      break()
    endif()
    math(EXPR index "${index}+1")
  endwhile()
  if(index LESS CMAKE_ARGC)
    set(command "${CMAKE_ARGV${index}}")
    math(EXPR index "${index}+1")
  endif()
  while(index LESS CMAKE_ARGC)
    set(arg "${CMAKE_ARGV${index}}")
    if(arg STREQUAL "--")
      math(EXPR index "${index}+1")
      while(index LESS CMAKE_ARGC)
        string(REPLACE ";" "\\;" arg "${CMAKE_ARGV${index}}")
        list(APPEND extra "${arg}")
        math(EXPR index "${index}+1")
      endwhile()
      break()
    endif()
    if(arg MATCHES "^--(artifacts|if-sanitized)$")
      string(REPLACE "-" "_" name "${CMAKE_MATCH_1}")
      set(QA_${name} TRUE PARENT_SCOPE)
    elseif(arg MATCHES "^--([a-z-]+)$")
      string(REPLACE "-" "_" name "${CMAKE_MATCH_1}")
      math(EXPR index "${index}+1")
      if(NOT index LESS CMAKE_ARGC)
        message(FATAL_ERROR "Missing value for ${arg}")
      endif()
      set(QA_${name} "${CMAKE_ARGV${index}}" PARENT_SCOPE)
    else()
      message(FATAL_ERROR "Unknown sanitizer argument: ${arg}")
    endif()
    math(EXPR index "${index}+1")
  endwhile()
  set(QA_COMMAND "${command}" PARENT_SCOPE)
  set(QA_EXTRA "${extra}" PARENT_SCOPE)
endfunction()
