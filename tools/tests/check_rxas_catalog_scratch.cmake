foreach(required GENERATOR DENIED_GENERATOR WORK_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing required variable ${required}")
  endif()
endforeach()

function(run_catalog generator output expect_success)
  execute_process(COMMAND "${generator}" "${output}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(expect_success AND NOT result STREQUAL "0")
    message(FATAL_ERROR "Catalogue generation failed: ${stdout}${stderr}")
  elseif(NOT expect_success AND NOT result STREQUAL "1")
    message(FATAL_ERROR "Catalogue generation must refuse ${output} with exit 1; got ${result}: ${stdout}${stderr}")
  endif()
endfunction()

function(check_scratch output blocker)
  foreach(suffix .tmp .rows.tmp .keys.tmp)
    if(NOT suffix STREQUAL blocker AND EXISTS "${output}${suffix}")
      message(FATAL_ERROR "Catalogue scratch file remains: ${output}${suffix}")
    endif()
  endforeach()
endfunction()

function(check_content path expected)
  file(READ "${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Catalogue failure changed ${path}")
  endif()
endfunction()

file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}/normal output" "${WORK_DIR}/denied temp")
set(normal "${WORK_DIR}/normal output/catalog file.crexx")
set(denied "${WORK_DIR}/denied temp/catalog file.crexx")
run_catalog("${GENERATOR}" "${normal}" TRUE)
check_scratch("${normal}" "")
file(WRITE "${denied}" "previous catalogue\n")
run_catalog("${DENIED_GENERATOR}" "${denied}" TRUE)
check_scratch("${denied}" "")
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${normal}" "${denied}"
  RESULT_VARIABLE different)
if(NOT different EQUAL 0)
  message(FATAL_ERROR "Denied CRT temp access changed catalogue bytes")
endif()

foreach(blocker .tmp .rows.tmp .keys.tmp)
  set(output "${WORK_DIR}/blocked${blocker}.crexx")
  file(WRITE "${output}" "previous catalogue\n")
  file(MAKE_DIRECTORY "${output}${blocker}")
  run_catalog("${GENERATOR}" "${output}" FALSE)
  check_content("${output}" "previous catalogue\n")
  if(NOT IS_DIRECTORY "${output}${blocker}")
    message(FATAL_ERROR "Catalogue generation removed unowned blocker ${output}${blocker}")
  endif()
  check_scratch("${output}" "${blocker}")
endforeach()

set(output "${WORK_DIR}/blocked replacement.crexx")
file(MAKE_DIRECTORY "${output}")
file(WRITE "${output}/owner" "previous output directory\n")
run_catalog("${GENERATOR}" "${output}" FALSE)
check_content("${output}/owner" "previous output directory\n")
check_scratch("${output}" "")

file(REMOVE_RECURSE "${WORK_DIR}")
message(STATUS "Catalogue scratch placement, byte parity and failure cleanup passed")
