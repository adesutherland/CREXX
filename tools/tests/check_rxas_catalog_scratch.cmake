foreach(query callframestate:110 callframefreshmode:111 callframeclearrole:112
    callframeclearextent:113 callframeclearwhen:114 callframelocalmode:115
    callframecountrole:116)
  string(REPLACE ":" ";" parts "${query}")
  list(GET parts 0 name)
  list(GET parts 1 column)
  set(expected "  ${name}: method = .string\n    arg opcode = .int\n")
  if(name STREQUAL "callframestate")
    string(APPEND expected "    if opcode < 0 | opcode >= count() then return 'unknown'\n")
  else()
    string(APPEND expected "    state = callframestate(opcode)\n    if state <> 'known' then return state\n")
  endif()
  string(APPEND expected "    value = field(opcode,${column})\n")
  string(FIND "${catalog}" "${expected}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Catalogue ${name} does not preserve its typed state/column")
  endif()
endforeach()
