foreach(required GENERATOR DENIED_GENERATOR WORK_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing required variable ${required}")
  endif()
endforeach()

function(run_catalog generator output expect_success)
  execute_process(COMMAND "${generator}" "${output}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(expect_success AND NOT result STREQUAL "0")
    message(FATAL_ERROR "Catalogue generation failed: ${stdout}${stderr}")
  elseif(NOT expect_success AND NOT result STREQUAL "1")
    message(FATAL_ERROR "Catalogue generation must refuse ${output} with exit 1; got ${result}: ${stdout}${stderr}")
  endif()
endfunction()

function(check_scratch output blocker)
  foreach(suffix .tmp .rows.tmp .keys.tmp)
    if(NOT suffix STREQUAL blocker AND EXISTS "${output}${suffix}")
      message(FATAL_ERROR "Catalogue scratch file remains: ${output}${suffix}")
    endif()
  endforeach()
endfunction()

function(check_content path expected)
  file(READ "${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Catalogue failure changed ${path}")
  endif()
endfunction()

file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}/normal output" "${WORK_DIR}/denied temp")
set(normal "${WORK_DIR}/normal output/catalog file.crexx")
set(denied "${WORK_DIR}/denied temp/catalog file.crexx")
run_catalog("${GENERATOR}" "${normal}" TRUE)
check_scratch("${normal}" "")
# Check the generated view as well as the native metadata unit assertions.
# Inspect only the serialized opcode row; unrelated columns stay opaque here.
file(READ "${normal}" catalog)
set(row_start "_rows = '")
string(FIND "${catalog}" "${row_start}" begin)
if(begin LESS 0)
  message(FATAL_ERROR "Catalogue has no serialized opcode rows")
endif()
string(LENGTH "${row_start}" prefix_size)
math(EXPR begin "${begin} + ${prefix_size}")
string(SUBSTRING "${catalog}" ${begin} -1 rows)
string(FIND "${rows}" "'x" end)
if(end LESS 0)
  message(FATAL_ERROR "Catalogue opcode rows have no binary terminator")
endif()
string(SUBSTRING "${rows}" 0 ${end} rows)
string(TOUPPER "${rows}" rows)
function(check_frame_row prefix suffix)
  string(HEX "${prefix} " prefix_hex)
  string(TOUPPER "${prefix_hex}" prefix_hex)
  string(FIND "${rows}" "0A${prefix_hex}" begin)
  if(begin LESS 0)
    message(FATAL_ERROR "Catalogue has no ${prefix} frame control row")
  endif()
  math(EXPR begin "${begin} + 2")
  string(SUBSTRING "${rows}" ${begin} -1 tail)
  string(FIND "${tail}" "0A" end)
  if(end LESS 0)
    message(FATAL_ERROR "Catalogue ${prefix} row is unterminated")
  endif()
  string(SUBSTRING "${tail}" 0 ${end} row)
  string(HEX " ${suffix}" suffix_hex)
  string(TOUPPER "${suffix_hex}" suffix_hex)
  if(NOT row MATCHES "${suffix_hex}$")
    message(FATAL_ERROR "Catalogue ${prefix} has incorrect frame preparation fields")
  endif()
endfunction()
