/* REXX */

options levelb comments_dash
import rxfnsb

main: procedure
   /*
    * Usage:
    *   crexx rexxApiDoc --args source.crexx [extra-interface]
    *
    * The generated LaTeX is written to stdout, so a complete directory can
    * be processed repeatably from a shell script and redirected to one file.
    *
    * Example:
    *   crexx rexxApiDoc --args lib/classlib/StringTreeMap.crexx Map > StringTreeMap.tex
    */
   arg sourcea=.string[]

   source = .string
   extraInterface = .string

   source = sourcea.1
   if sourcea[0] >= 2 then extraInterface = sourcea.2
   else extraInterface = ''

   call emitAlmanacClass source, extraInterface
   return


/* ------------------------------------------------------------------
 *  Function:  EMITALMANACCLASS
 *  Purpose:   Extract all cRexx class/interface declarations and their
 *             public factories and methods, and emit crexxalmanac.sty markup.
 *
 *  Scope:
 *      - namespace_ ... expose ...
 *      - Name: class [extends Base] [implements I1 I2 ...]
 *      - *: factory
 *      - name: method = .returnType
 *      - the first following arg statement
 *
 *  Notes:
 *      - Method bodies are not parsed.
 *      - Class fields are deliberately omitted from the public API.
 *      - An optional documentation-only interface can be supplied as the
 *        second command-line argument (for example Map for StringTreeMap).
 *  ------------------------------------------------------------------ */
emitAlmanacClass: procedure
   arg file=.string, extraInterface=.string

   content = loadText(file)
   lines = splitLines(content)

   /* namespace is a cRexx reserved word, so keep namespace_ as the scanner
    * variable and copy it into classNamespace when a declaration starts.
    */
   namespace_ = ''
   classNamespace = ''
   className = ''
   classKind = 'class'
   baseClass = '.object'
   interfaces = .string[]

   memberKind = .string[]
   memberName = .string[]
   memberType = .string[]
   memberArgs = .string[]

   extraUsed = 0
   classCount = 0

   do i = 1 to lines[0]
      line = strip(lines[i])
      low  = lower(line)

      if left(low,10) = 'namespace ' then do
         parse var line . namespace_ .
         namespace_ = strip(namespace_)
         iterate
      end

      pclass = pos(': class', low)
      if pclass > 0 then do
         /* A source file may contain more than one class/interface.
          * Flush the previous declaration before starting the next one.
          */
         if className \= '' then do
            if strip(extraInterface) \= '' & \extraUsed then do
               call appendUnique interfaces, extraInterface
               extraUsed = 1
            end
            call emitOneClass classNamespace, className, classKind, baseClass, ,
                              interfaces, memberKind, memberName, memberType, memberArgs
            classCount = classCount + 1
         end

         classKind = 'class'
         className = strip(left(line,pclass-1))
         classNamespace = namespace_
         baseClass = '.object'
         interfaces = .string[]
         memberKind = .string[]
         memberName = .string[]
         memberType = .string[]
         memberArgs = .string[]

         tail = strip(substr(line,pclass+7))
         call parseClassTail tail, baseClass, interfaces
         iterate
      end

      pinterface = pos(': interface', low)
      if pinterface > 0 then do
         if className \= '' then do
            if strip(extraInterface) \= '' & \extraUsed then do
               call appendUnique interfaces, extraInterface
               extraUsed = 1
            end
            call emitOneClass classNamespace, className, classKind, baseClass, ,
                              interfaces, memberKind, memberName, memberType, memberArgs
            classCount = classCount + 1
         end

         classKind = 'interface'
         className = strip(left(line,pinterface-1))
         classNamespace = namespace_
         baseClass = ''
         interfaces = .string[]
         memberKind = .string[]
         memberName = .string[]
         memberType = .string[]
         memberArgs = .string[]

         tail = strip(substr(line,pinterface+11))
         call parseInterfaceTail tail, interfaces
         iterate
      end

      /* Ignore callable-looking text until a class or interface is active. */
      if className = '' then iterate

      pfactory = pos(': factory', low)
      if pfactory > 0 then do
         name = strip(left(line,pfactory-1))
         if name = '*' then name = className

         memberKind[memberKind[0]+1] = 'factory'
         n = memberKind[0]
         memberName[n] = name
         memberType[n] = ''
         memberArgs[n] = findArguments(lines,i+1)
         iterate
      end

      pmethod = pos(': method', low)
      if pmethod > 0 then do
         name = strip(left(line,pmethod-1))
         tail = strip(substr(line,pmethod+8))
         rtype = ''
         peq = pos('=',tail)
         if peq > 0 then rtype = strip(substr(tail,peq+1))

         memberKind[memberKind[0]+1] = 'method'
         n = memberKind[0]
         memberName[n] = name
         memberType[n] = rtype
         memberArgs[n] = findArguments(lines,i+1)
         iterate
      end
   end

   /* Flush the final declaration in the file. */
   if className \= '' then do
      if strip(extraInterface) \= '' & \extraUsed then do
         call appendUnique interfaces, extraInterface
         extraUsed = 1
      end
      call emitOneClass classNamespace, className, classKind, baseClass, ,
                        interfaces, memberKind, memberName, memberType, memberArgs
      classCount = classCount + 1
   end

   if classCount = 0 then
      say '% rexxApiDoc: no class or interface declaration found in 'latexEscape(file)
return


/* Emit one fully collected class or interface. */
emitOneClass: procedure
   arg classNamespace=.string, className=.string, classKind=.string, ,
       baseClass=.string, interfaces=.string[], memberKind=.string[], ,
       memberName=.string[], memberType=.string[], memberArgs=.string[]

   if classKind = 'interface' then
      displayedClassName = formatInterfaceName(className)
   else
      displayedClassName = formatClassName(className)

   say '\begin{CrexxClass}{'displayedClassName'}{'latexEscape(classNamespace)'}'
   say
   say '  \begin{Hierarchy}'

   hierarchyTail = ''
   if interfaces[0] > 0 then do
      hierarchyTail = ' \hfill'
      do j = 1 to interfaces[0]
         if j > 1 then hierarchyTail = hierarchyTail || ', '
         hierarchyTail = hierarchyTail || formatInterfaceName(interfaces[j])
      end
   end

   if classKind = 'interface' then do
      say '    \HierarchyLine[\APIOpen]{0}{'formatInterfaceName(className)hierarchyTail'}'
   end
   else do
      say '    \HierarchyLine[\APIOpen]{0}{'formatClassName(baseClass)'}'
      say '    \HierarchyLine{1}{\APIHierarchyBranch\ 'formatClassName(className)hierarchyTail'}'
   end

   say '  \end{Hierarchy}'
   say
   say '  \begin{Members}'
   say

   do i = 1 to memberKind[0]
      if memberKind[i] = 'factory' then do
         say '    \Factory'
         say '      {public}'
         say '      {'latexEscape(memberName[i])'}'
         say '      {'renderArgumentList(memberArgs[i])'}'
      end
      else do
         say '    \Method'
         say '      {public}'
         say '      {'latexEscape(memberType[i])'}'
         say '      {'latexEscape(memberName[i])'}'
         say '      {'renderArgumentList(memberArgs[i])'}'
      end
      say
   end

   say '  \end{Members}'
   say '\end{CrexxClass}'
   say
return


/* Split text into a one-based .string[] array. */
splitLines: procedure=.string[]
   arg text=.string
   result = .string[]
   nl = '0a'x
   line = .string
   
   do while text \= ''
      p = pos(nl,text)
      if p = 0 then do
         line = text
         text = ''
      end
      else do
         line = left(text,p-1)
         text = substr(text,p+1)
      end
      if right(line,1) = '0d'x then line = left(line,length(line)-1)
      result[result[0]+1] = line
   end
return result


/* Format class and interface names in one central place.
 *
 * Class names remain upright and retain their cRexx spelling.  Interface
 * names are italicised and retain (or receive) their leading cRexx dot.
 */
formatClassName: procedure=.string
   arg name=.string

   name = strip(name)
   if left(name,1) \= '.' then name = '.' || name
return latexEscape(name)


formatInterfaceName: procedure=.string
   arg name=.string

   name = strip(name)
   if left(name,1) \= '.' then name = '.' || name
return '\textit{' || latexEscape(name) || '}'


/* Parse "extends" and "implements" from the class-header tail. */
parseClassTail: procedure
   arg tail=.string, expose baseClass=.string, expose interfaces=.string[]

   wordCount = words(tail)
   mode = ''
   do i = 1 to wordCount
      word = word(tail,i)
      low = lower(word)
      select
         when low = 'extends' then mode = 'extends'
         when low = 'implements' then mode = 'implements'
         when mode = 'extends' then do
            baseClass = word
            mode = ''
         end
         when mode = 'implements' then call appendUnique interfaces, word
         otherwise nop
      end
   end
return


/* Parse inherited interfaces from an interface-header tail.
 *
 * Supported forms:
 *     Name: interface
 *     Name: interface extends .Parent
 *     Name: interface extends .Parent1 .Parent2
 *
 * Some source levels may use IMPLEMENTS for interface inheritance; accept
 * that spelling as well so the documentation generator remains tolerant.
 */
parseInterfaceTail: procedure
   arg tail=.string, expose interfaces=.string[]

   wordCount = words(tail)
   mode = ''
   do i = 1 to wordCount
      word = word(tail,i)
      low = lower(word)
      select
         when low = 'extends' then mode = 'interfaces'
         when low = 'implements' then mode = 'interfaces'
         when mode = 'interfaces' then call appendUnique interfaces, word
         otherwise nop
      end
   end
return


/* Find the argument declaration belonging to a factory or method.
 *
 * A cRexx callable may put PROCEDURE [EXPOSE ...] before ARG.  The earlier
 * implementation stopped at PROCEDURE and consequently emitted () for those
 * methods.  This version skips declaration scaffolding and preserves the
 * complete ARG signature.
 */
findArguments: procedure=.string
   arg lines=.string[], start=.int

   collecting = 0
   result = ''

   do i = start to lines[0]
      s = strip(lines[i])
      low = lower(s)

      if s = '' then do
         if collecting then leave
         iterate
      end

      /* Skip block, JavaDoc, and dash comments. */
      if left(s,2) = '/*' | left(s,1) = '*' | left(s,2) = '*/' |,
         left(s,2) = '--' then iterate

      /* PROCEDURE and EXPOSE are part of the callable declaration. */
      if left(low,9) = 'procedure' then iterate
      if left(low,7) = 'expose ' then iterate

      if left(low,4) = 'arg ' then do
         result = strip(substr(s,5))
         collecting = 1

         /* A trailing comma means that the ARG declaration continues. */
         do while right(strip(result),1) = ',' & i < lines[0]
            i = i + 1
            continuation = strip(lines[i])
            if continuation = '' then leave
            result = result || ' ' || continuation
         end
         leave
      end

      /* No ARG before the first executable/declaration statement. */
      leave
   end
return normalizeSignature(result)


/* Normalize spacing to the cRexx documentation convention:
 *     key=.string, value=.string
 */
normalizeSignature: procedure=.string
   arg signature=.string

   item = .string
   signature = strip(signature)
   if signature = '' then return ''

   out = ''
   rest = signature
   first = 1

   do while rest \= ''
      p = pos(',',rest)
      if p = 0 then do
         item = strip(rest)
         rest = ''
      end
      else do
         item = strip(left(rest,p-1))
         rest = substr(rest,p+1)
      end

      peq = pos('=',item)
      if peq > 0 then
         item = strip(left(item,peq-1)) || '=' || strip(substr(item,peq+1))

      if \first then out = out || ', '
      out = out || item
      first = 0
   end
return out


/* Render "key=.string, value=.string" using the package's Param helper. */
renderArgumentList: procedure=.string
   arg args=.string

   item = .string
   pname = .string
   ptype = .string
   rendered = .string
   rest = .string
   p = .int
   peq = .int
   count = .int
   index = .int
   params = .string[]
   nl = '0a'x

   args = strip(args)
   if args = '' then return '()'

   /* First render each argument independently. */
   rest = args
   do while rest \= ''
      p = pos(',',rest)
      if p = 0 then do
         item = strip(rest)
         rest = ''
      end
      else do
         item = strip(left(rest,p-1))
         rest = substr(rest,p+1)
      end

      peq = pos('=',item)
      if peq > 0 then do
         pname = strip(left(item,peq-1))
         ptype = strip(substr(item,peq+1))
         rendered = '\Param{'latexEscape(pname)'}{'latexEscape(ptype)'}'
      end
      else rendered = latexEscape(item)

      params[params[0]+1] = rendered
   end

   /* Keep the compact form for a single parameter.  Two or more parameters
    * use the multiline form supplied by crexxalmanac.sty: '(' is on the
    * first line, each parameter gets its own line, and ')' closes the block.
    */
   if params[0] = 1 then return '(' || params[1] || ')'

   out = '\Params{' || nl
   do index = 1 to params[0]
      if index = params[0] then
         out = out || '        \LastParamLine{'params[index]'}' || nl
      else
         out = out || '        \ParamLine{'params[index]'}' || nl
   end
   out = out || '      }'
return out


appendUnique: procedure
   arg expose values=.string[], value=.string
   value = strip(value)
   if value = '' then return

   do i = 1 to values[0]
      if lower(values[i]) = lower(value) then return
   end
   values[values[0]+1] = value
return


stripLeadingDot: procedure=.string
   arg value=.string
   value = strip(value)
   if left(value,1) = '.' then value = substr(value,2)
return value


/* Escape the subset of LaTeX metacharacters likely in cRexx identifiers. */
latexEscape: procedure=.string
   arg s=.string
   s = changestr('\',s,'\textbackslash{}')
   s = changestr('&',s,'\&')
   s = changestr('%',s,'\%')
   s = changestr('#',s,'\#')
   s = changestr('_',s,'\_')
   s = changestr('{',s,'\{')
   s = changestr('}',s,'\}')
return s


/* ------------------------------------------------------------------
 *  Program:   RexxDoc JavaDoc Extractor
 *
 *  Purpose:
 *      Demonstrates a simple RexxDoc extraction and rendering pipeline, based on JavaDoc:
 *
 *        1. Extract raw /** ... */ blocks from a source file
 *        2. Normalize the comment body
 *        3. Split the block into description + tags
 *        4. Render the result as plain text or HTML
 *
 *  Design:
 *      - Parsing and rendering are kept separate
 *      - Parsing preserves structure
 *      - Rendering interprets inline tags and simple HTML markup
 *      - KISS-oriented: reliable extraction first, richer semantics later
 *  ------------------------------------------------------------------ */
rexxDoc: procedure
   arg file=.string, format='dump'
   format=lower(format)

   rexxContent = loadText(file)

   /* Extract all JavaDoc comment blocks including delimiters */
   -- founddocs = QEXTRACTALL('/**','*/',rexxContent,'incl')
   founddocs.1 = '' 
   do i = 1 to founddocs.0
      do         /* Fresh arrays for each parsed block */
         tagName = .string[]
         tagArg = .string[]
         tagText = .string[]
         description = .string[]

         /* Normalize raw JavaDoc block and split into structure */
  ##       say 999 "'"founddocs.i
         part = rexxDocStrip(founddocs.i)
         tags = splittags(part, description, tagName, tagArg, tagText)

         /* HTML dump example */
         if format='html' then do
            html = dumpRexxDocHtml('RexxDoc HTML Sample', description, tagName, tagArg, tagText)
            say html
         end
         else do   /* Plain text dump */
            call dumpRexxDoc 'RexxDoc Sample', description, tagName, tagArg, tagText
            call lintRexxDoc description, tagName, tagArg, tagText
         end
      end
   end
return


/* ------------------------------------------------------------------
 *  Function:  DUMPREXXDOC
 *  Purpose:   Pretty-print one parsed JavaDoc/RexxDoc block to the
 *             console in a readable, grouped form.
 *
 *  Sections:
 *      - Description
 *      - Parameters
 *      - Returns
 *      - Throws
 *      - Other Tags
 *
 *  Notes:
 *      - Uses renderDocText() for presentation-time cleanup
 *  ------------------------------------------------------------------ */
dumpRexxDoc: procedure
   arg title=.string, description=.string[], tagName=.string[], tagArg=.string[], tagText=.string[]

   if title = '' then title = 'RexxDoc'
   say '=================================================='
   say title
   say '=================================================='

   say 'Description:'
   if description[0] = 0 then
      say '  <none>'
   else do
      do i = 1 to description[0]
         say '  'renderDocText(description[i])
      end
   end
   say

   say 'Parameters:'
   found = 0
   do i = 1 to tagName[0]
      if tagName[i] = 'param' then do
         found = 1
         say '  'tagArg[i]': 'renderDocText(tagText[i])
      end
   end
   if \found then say '  <none>'

   say

   say 'Returns:'
   found = 0
   do i = 1 to tagName[0]
      if tagName[i] = 'return' then do
         found = 1
         say '  'renderDocText(tagText[i])
      end
   end
   if \found then say '  <none>'

   say

   say 'Throws:'
   found = 0
   do i = 1 to tagName[0]
      if tagName[i] = 'throws' | tagName[i] = 'exception' then do
         found = 1
         say '  'tagArg[i]': 'renderDocText(tagText[i])
      end
   end
   if \found then say '  <none>'

   say

   say 'Other Tags:'
   found = 0
   do i = 1 to tagName[0]
      select
         when tagName[i] = 'param' then nop
         when tagName[i] = 'return' then nop
         when tagName[i] = 'throws' then nop
         when tagName[i] = 'exception' then nop
         otherwise do
            found = 1
            if tagArg[i] \= '' then
               say '  @'tagName[i] tagArg[i]' -> 'renderDocText(tagText[i])
            else
               say '  @'tagName[i]' -> 'renderDocText(tagText[i])
         end
      end
   end
   if \found then say '  <none>'
return


/* ------------------------------------------------------------------
 *  Function:  DUMPREXXDOCHTML
 *  Purpose:   Produce a minimal HTML representation of one parsed
 *             JavaDoc/RexxDoc block.
 *
 *  Output:
 *      Returns a single HTML document as a string.
 *
 *  Current Scope:
 *      - Description only
 *      - Tag sections can be added later in the same style
 *
 *  Notes:
 *      - Uses renderDocText() for normalization
 *      - Uses escapeHtml() to make content safe for HTML output
 *  ------------------------------------------------------------------ */
dumpRexxDocHtml: procedure=.string
   arg title=.string, description=.string[], tagName=.string[], tagArg=.string[], tagText=.string[]

   html = ''
   nl = '0a'x

   if title = '' then title = 'RexxDoc'

   html = html || '<html>' || nl
   html = html || '<head><meta charset="utf-8"><title>' || title || '</title></head>' || nl
   html = html || '<body>' || nl
   html = html || '<h1>' || title || '</h1>' || nl

   html = html || '<h2>Description</h2>' || nl
   if description[0] = 0 then
      html = html || '<p>&lt;none&gt;</p>' || nl
   else do
      do i = 1 to description[0]
         if strip(description[i]) \= '' then
            html = html || '<p>' || escapeHtml(renderDocText(description[i])) || '</p>' || nl
      end
   end

   html = html || '</body>' || nl || '</html>' || nl
return html


/* ------------------------------------------------------------------
 *  Function:  RENDERDOCTEXT
 *  Purpose:   Apply presentation-time rendering to one text fragment.
 *
 *  Pipeline:
 *      1. Trim trailing blanks
 *      2. Expand inline JavaDoc tags
 *      3. Remove or normalize simple embedded HTML markup
 *
 *  Notes:
 *      - This is a rendering helper only
 *      - It does not change the parsed source data
 *  ------------------------------------------------------------------ */
renderDocText: procedure=.string
   arg s=.string
return htmlDoc(inlineDoc(strip(s, 'T')))


/* ------------------------------------------------------------------
 *  Function:  HTMLDOC
 *  Purpose:   Normalize a small subset of JavaDoc/HTML markup for
 *             readable plain-text or safe downstream rendering.
 *
 *  Supported:
 *      <p>...</p>            -> paragraph markers removed
 *      <br>, <br/>, <br />   -> newline inserted
 *      <i>...</i>            -> keep inner text
 *      <b>...</b>            -> keep inner text
 *      <strong>...</strong>  -> keep inner text
 *
 *  Notes:
 *      - This is intentionally minimal
 *      - It is not a full HTML parser
 *  ------------------------------------------------------------------ */
htmlDoc: procedure=.string
   arg s=.string

   s = changestr('<p>',s,'')
   s = changestr('</p>',s,'')
   s = changestr('<br>',s,'0a'x)
   s = changestr('<br/>',s,'0a'x)
   s = changestr('<br />',s,'0a'x)

   s = stripTag(s, '<i>', '</i>')
   s = stripTag(s, '<b>', '</b>')
   s = stripTag(s, '<strong>', '</strong>')
return s


/* ------------------------------------------------------------------
 *  Function:  INLINEDOC
 *  Purpose:   Expand simple inline JavaDoc tags in a text line.
 *
 *  Supported:
 *      {@code text}         -> text
 *      {@link Target}       -> Target
 *      {@link Target Label} -> Label
 *
 *  Notes:
 *      - This is intentionally lightweight
 *      - Nested inline tags are not handled
 *  ------------------------------------------------------------------ */
inlineDoc: procedure=.string
   arg s=.string

   s = expandInlineCode(s)
   s = expandInlineLink(s)
return s


/* ------------------------------------------------------------------
 *  Function:  EXPANDINLINECODE
 *  Purpose:   Replace all {@code ...} fragments with their inner text.
 *
 *  Example:
 *      {@code containsKey} -> containsKey
 *  ------------------------------------------------------------------ */
expandInlineCode: procedure=.string
   arg s=.string
   token = '{@code '

   do forever
      p1 = pos(token, s)
      if p1 = 0 then leave

      p2 = pos('}', s, p1 + length(token))
      if p2 = 0 then leave

      inner = substr(s, p1 + length(token), p2 - p1 - length(token))
      s = left(s, p1 - 1) || inner || substr(s, p2 + 1)
   end
return s


/* ------------------------------------------------------------------
 *  Function:  EXPANDINLINELINK
 *  Purpose:   Replace all {@link ...} fragments.
 *
 *  Rules:
 *      {@link X}         -> X
 *      {@link X label}   -> label
 *
 *  Notes:
 *      - The first token is interpreted as the target
 *      - Remaining text, if any, is interpreted as the display label
 *  ------------------------------------------------------------------ */
expandInlineLink: procedure=.string
   arg s=.string

   token = '{@link '

   do forever
      p1 = pos(token, s)
      if p1 = 0 then leave

      p2 = pos('}', s, p1 + length(token))
      if p2 = 0 then leave

      inner = strip(substr(s, p1 + length(token), p2 - p1 - length(token)))

      parse var inner target label
      label = strip(label)

      if label \= '' then
         repl = label
      else
         repl = target

      s = left(s, p1 - 1) || repl || substr(s, p2 + 1)
   end

return s


/* ------------------------------------------------------------------
 *  Function:  STRIPTAG
 *  Purpose:   Remove a simple matching tag pair while preserving the
 *             enclosed text.
 *
 *  Example:
 *      <i>abc</i>  -> abc
 *
 *  Notes:
 *      - Repeats until no more matching pairs are found
 *      - Assumes simple, non-nested usage of the same tag type
 *  ------------------------------------------------------------------ */
stripTag: procedure=.string
   arg s=.string, open=.string, close=.string

   do forever
      p1 = pos(open, s)
      if p1 = 0 then leave

      p2 = pos(close, s, p1 + length(open))
      if p2 = 0 then leave

      inner = substr(s, p1 + length(open), p2 - p1 - length(open))
      s = left(s, p1 - 1) || inner || substr(s, p2 + length(close))
   end
return s


/* ------------------------------------------------------------------
 *  Function:  ESCAPEHTML
 *  Purpose:   Escape special characters so text can safely be embedded
 *             inside generated HTML.
 *
 *  Converts:
 *      &  -> &amp;
 *      <  -> &lt;
 *      >  -> &gt;
 *      "  -> &quot;
 *      '  -> &#39;
 *
 *  Notes:
 *      - Order matters: '&' must be escaped first
 *  ------------------------------------------------------------------ */
escapeHtml: procedure=.string
   arg s=.string

   s = changestr('&', s, '&amp;')
   s = changestr('<', s, '&lt;')
   s = changestr('>', s, '&gt;')
   s = changestr('"', s, '&quot;')
   s = changestr("'", s, '&#39;')
return s


/* ------------------------------------------------------------------
 *  Function:  SPLITTAGS
 *  Purpose:   Split cleaned JavaDoc text into:
 *               - description text
 *               - parallel tag arrays
 *
 *  Usage:
 *      tagCount = splittags(cleanText, description, tagName, tagArg, tagText)
 *
 *  Output:
 *      description - description block
 *      tagName[i]  - tag name (param, return, throws, ...)
 *      tagArg[i]   - optional argument (<K>, key, ExceptionName, ...)
 *      tagText[i]  - tag text with continuation lines merged
 *
 *  Tag Rules:
 *      - lines before the first @tag belong to description
 *      - a line starting with @ begins a new tag
 *      - later non-@ lines continue the current tag
 *
 *  Returns:
 *      number of tags found
 *  ------------------------------------------------------------------ */
splittags: procedure=.int
   arg text=.string, expose description=.string[], expose tagName=.string[], expose tagArg=.string[], expose tagText=.string[]

   nl = '0a'x
   inTags = 0
   curTag = 0
   rest = .string
   line = .string

   do while text \= ''
      p = pos(nl, text)
      if p = 0 then do
         line = text
         text = ''
      end
      else do
         line = left(text, p - 1)
         text = substr(text, p + 1)
      end

      if right(line,1) = '0d'x then
         line = left(line, length(line) - 1)

      raw   = line
      sline = strip(line)

      /* ------------------------------------------------------------
       * Tag mode:
       *   - blank line extends current tag as a space
       *   - @... starts a new tag
       *   - any other line continues current tag text
       * ------------------------------------------------------------ */
      if inTags then do
         if sline = '' then do
            if curTag > 0 & tagText[curTag] \= '' then
               tagText[curTag] = tagText[curTag] || ' '
            iterate
         end

         if left(sline,1) = '@' then do
            parse var sline '@' name rest
            name = lower(strip(name))
            rest = strip(rest)

            tagName[tagName[0]+1] = name
            curTag = tagName[0]
            tagArg[curTag]  = ''
            tagText[curTag] = ''

            select
               when name = 'param' then do
                  parse var rest argx restText
                  tagArg[curTag]  = argx
                  tagText[curTag] = strip(restText)
               end
               when name = 'throws' | name = 'exception' then do
                  parse var rest argx restText
                  tagArg[curTag]  = argx
                  tagText[curTag] = strip(restText)
               end
               otherwise do
                  tagText[curTag] = rest
               end
            end
            iterate
         end

         if curTag > 0 then do
            if tagText[curTag] = '' then
               tagText[curTag] = sline
            else
               tagText[curTag] = tagText[curTag] || ' ' || sline
         end
         iterate
      end

      /* ------------------------------------------------------------
       * Description mode:
       *   - blank line stays in description
       *   - first @... switches to tag mode
       *   - anything else belongs to description
       * ------------------------------------------------------------ */
      if sline = '' then do
         description[description[0]+1] = ''
         iterate
      end

      if left(sline,1) = '@' then do
         inTags = 1

         parse var sline '@' name rest
         name = lower(strip(name))
         rest = strip(rest)

         tagName[tagName[0]+1] = name
         curTag = tagName[0]
         tagArg[curTag]  = ''
         tagText[curTag] = ''

         select
            when name = 'param' then do
               parse var rest argx restText
               tagArg[curTag]  = argx
               tagText[curTag] = strip(restText)
            end
            when name = 'throws' | name = 'exception' then do
               parse var rest argx restText
               tagArg[curTag]  = argx
               tagText[curTag] = strip(restText)
            end
            otherwise do
               tagText[curTag] = rest
            end
         end
         iterate
      end

      description[description[0]+1] = strip(raw,'T')
   end

return tagName[0]


/* ------------------------------------------------------------------
 *  Function:  REXXDOCSTRIP
 *  Purpose:   Normalize one raw JavaDoc block into plain multi-line text.
 *
 *  Actions:
 *      - remove opening /** and closing */
 *      - remove decorative leading '*' on each line
 *      - preserve line structure
 *      - trim leading/trailing empty lines from the result
 *
 *  Input:
 *      full raw extracted block, including delimiters
 *
 *  Output:
 *      cleaned JavaDoc body as one multi-line string
 *  ------------------------------------------------------------------ */
rexxdocstrip: procedure=.string
   arg text=.string

   nl = '0a'x
   out = ''
   if text = '' then return ''
   ppi=pos('/**',text)
   if ppi>0 then text = substr(text, ppi+3)
   ppj=pos('*/',text)
   if ppj>0 then text = left(text, ppj - 1)

   line = .string

   do while text \= ''
      p = pos(nl, text)

      if p = 0 then do
         line = text
         text = ''
      end
      else do
         line = left(text, p - 1)
         text = substr(text, p + 1)
      end

      if right(line,1) = '0d'x then line = left(line, length(line) - 1)

      s = strip(line, 'L')

      /* Remove one decorative leading '*' if present */
      if left(s,1) = '*' then do
         s = substr(s,2)
         if left(s,1) = '*' then s = substr(s,2)
         if left(s,1) = ' ' then s = substr(s,2)
      end
      if out = '' then out = s
      else out = out || nl || s
   end

   /* Trim leading blank lines */
   do while out \= ''
      p = pos(nl, out)
      if p = 0 then leave
      first = left(out, p - 1)
      if strip(first) \= '' then leave
      out = substr(out, p + 1)
   end

   /* Trim trailing blank lines */
   do while out \= ''
      p = lastpos(nl, out)
      if p = 0 then leave
      last = substr(out, p + 1)
      if strip(last) \= '' then leave
      out = left(out, p - 1)
   end
return out

/* ------------------------------------------------------------------
 *  Function:  LINTREXXDOC
 *  Purpose:   Check one parsed RexxDoc block for likely documentation
 *             problems and print warnings.
 *
 *  Current Rules:
 *      1. Description line starts with "return ", "throws ", or "param "
 *         -> likely missing '@'
 *      2. Empty tag text
 *      3. Duplicate @return
 *      4. Empty documentation block
 *
 *  Notes:
 *      - Strict mode: does not auto-correct anything
 *      - Intended as a lightweight lint pass
 *  ------------------------------------------------------------------ */
lintRexxDoc: procedure
   arg description=.string[], tagName=.string[], tagArg=.string[], tagText=.string[],quiet=1

   warnings = 0
   returnCount = 0

   /* ------------------------------------------------------------
    * Rule 1: suspicious description lines that look like tags
    * ------------------------------------------------------------ */
   do i = 1 to description[0]
      line = strip(description[i])
      lowerLine = lower(line)

      if left(lowerLine, 7) = 'return ' then do
         if warnings = 0 then say 'Lint:'
         warnings = warnings + 1
         say '  WARNING: possible missing @return tag: ' line
      end
      else if left(lowerLine, 7) = 'throws ' then do
         if warnings = 0 then say 'Lint:'
         warnings = warnings + 1
         say '  WARNING: possible missing @throws tag: ' line
      end
      else if left(lowerLine, 6) = 'param ' then do
         if warnings = 0 then say 'Lint:'
         warnings = warnings + 1
         say '  WARNING: possible missing @param tag: ' line
      end
   end

   /* ------------------------------------------------------------
    * Rule 2 + 3: tag checks
    * ------------------------------------------------------------ */
   do i = 1 to tagName[0]
      name = lower(strip(tagName[i]))
      txt  = strip(tagText[i])

      if name = 'return' then
         returnCount = returnCount + 1

      if txt = '' then do
         if warnings = 0 then say 'Lint:'
         warnings = warnings + 1
         say '  WARNING: empty tag text for @'name
      end
   end

   if returnCount > 1 then do
      if warnings = 0 then say 'Lint:'
      warnings = warnings + 1
      say '  WARNING: multiple @return tags found'
   end

   /* ------------------------------------------------------------
    * Rule 4: completely empty block
    * ------------------------------------------------------------ */
   if description[0] = 0 & tagName[0] = 0 then do
      if warnings = 0 then say 'Lint:'
      warnings = warnings + 1
      say '  WARNING: empty documentation block'
   end

   if warnings = 0 & quiet=0 then say 'Lint: <none>'

return
