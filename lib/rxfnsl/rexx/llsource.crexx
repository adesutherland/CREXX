/* cREXX License (MIT). Source validation and explicitly selected comment stage. */
options levelb
namespace llsource expose prepared diagnostic lexeme message
import rxfnsb
import lllimits
import llcomments

/** Own exact bytes. Never reinterpret a decoding error as a syntax error. */
prepared: class
  _source = .binary
  _masked = .binary
  _status = .int
  _offset = .int
  _error = .string
  _encoding = .string
  _opening = .string
  _closing = .string
  _limit = .int
  _ran = .int
  _recover = .int
  _comments = .llcomments..rules
  _work = .int
  _badfirst = .int[]
  _badlast = .int[]
  _badpoint = .int[]
  *: factory
    arg source = .binary, encoding = 'utf8', opening = '', closing = '', limit = 1048576, recover = 0, ?policies = .llcomments..rules, work = 10000000
    _source = source; _masked = source; _status = 0; _offset = 0; _error = ''
    _encoding = encoding; _opening = opening; _closing = closing; _limit = limit; _ran = 0; _recover = recover; _work = work
    if ?policies then _comments = policies
    else do
      _comments = .llcomments..rules()
      if opening <> '' then ok = _comments.add('nested','nested',opening,closing)
    end
    return
  run: method = .void
    if _ran then return
    _ran = 1; source = _source; encoding = _encoding; limit = _limit
    if _recover <> 0 & _recover <> 1 then do
      _status = 3; _error = 'LL_ENCODING: recovery flag must be 0 or 1'; return
    end
    if <blen>(source) > limit then do
      _status = 2; _error = lllimits..describe('source.bytes',limit,<blen>(source)); return
    end
    if encoding = 'utf8' | encoding = 'utf8bytes' then call utf8()
    else if encoding <> 'bytes' then do
      _status = 3; _error = 'LL_ENCODING: unsupported source encoding'; return
    end
    if _status = 0 then call comments()
    return
  utf8: method = .void
    at = 0; extent = <blen>(_source); broken = 0
    do while at < extent
      c = <at..u8>(at) _source; start = at; count = 0; scalar = c; minimum = 0
      if c < 128 then do
        at = at + 1; iterate
      end
      if c >= 194 & c <= 223 then do
        count = 1; scalar = c - 192; minimum = 128
      end
      else if c >= 224 & c <= 239 then do
        count = 2; scalar = c - 224; minimum = 2048
      end
      else if c >= 240 & c <= 244 then do
        count = 3; scalar = c - 240; minimum = 65536
      end
      else do
        call damage(start,start + 1,start)
        if _status <> 0 then return
        at = start + 1; iterate
      end
      at = at + 1; broken = 0
      do i = 1 to count
        if at >= extent then do
          call damage(start,extent,start); broken = 1; at = extent; leave
        end
        c = <at..u8>(at) _source
        if c < 128 | c > 191 then do
          call damage(start,at,at); broken = 1; leave
        end
        scalar = scalar * 64 + c - 128; at = at + 1
      end
      if _status <> 0 then return
      if broken then iterate
      if scalar < minimum | scalar > 1114111 | (scalar >= 55296 & scalar <= 57343) then do
        call damage(start,at,start)
        if _status <> 0 then return
      end
    end
    return
  damage: method = .void
    arg first = .int, last = .int, point = .int
    if _recover = 0 then do
      call invalid(point); return
    end
    entry = _badfirst[0]
    if entry = 0 | _badlast[entry] <> first then do
      entry = entry + 1
      _badfirst[entry] = first; _badpoint[entry] = point
    end
    _badlast[entry] = last
    do byte = first to last - 1
      <at..u8>(byte) _masked = 32
    end
    return
  errors: method = .int
    return _badfirst[0]
  badstart: method = .int
    arg error = .int
    return _badfirst[error]
  badend: method = .int
    arg error = .int
    return _badlast[error]
  badpoint: method = .int
    arg error = .int
    return _badpoint[error]
  invalid: method = .void
    arg offset = .int
    _status = 1; _offset = offset; _error = 'LL_UTF8: malformed UTF-8'
    return
  comments: method = .void
    before = _masked
    coordinator = .llcomments..processor(_masked,_comments,_work)
    _status = coordinator.run(); _offset = coordinator.offset(); _error = coordinator.error()
    _masked = coordinator.bytes()
    /* Only the proper specification reader requests this candidate-inspection
     * fallback. The original preparation remains failed, never publishable. */
    if _status = 1 & _recover then do i = coordinator.openingend() to <blen>(_masked) - 1
      <at..u8>(i) _masked = <at..u8>(i) before
    end
    return
  bytes: method = .binary
    return _masked
  status: method = .int
    call run()
    return _status
  offset: method = .int
    return _offset
  error: method = .string
    return _error

/** Diagnostic columns count Unicode scalars; offsets remain exact byte offsets. */
diagnostic: procedure = .string
  arg source = .binary, offset = .int, code = .string, message = .string, display = 'escaped'
  if display <> 'escaped' & display <> 'unicode' then return 'LL_DIAGNOSTIC_POLICY: display must be escaped or unicode'
  offset = max(0,min(offset,<blen>(source))); line = 1; column = 1; first = 0; last = <blen>(source)
  i = .int; c = .int; start = .int; previous = -1
  do i = 0 to offset - 1
    c = <at..u8>(i) source
    if c = 13 | c = 10 then do
      if c <> 10 | previous <> 13 then line = line + 1
      column = 1; first = i + 1
    end
    else if c < 128 | c >= 192 then column = column + 1
    previous = c
  end
  do i = offset to <blen>(source) - 1
    c = <at..u8>(i) source
    if c = 10 | c = 13 then do
      last = i; leave
    end
  end
  header = code || ' at line ' || line || ', column ' || column || ' (byte ' || offset || '): ' || message
  checked = .prepared(source,'utf8','','',max(1,<blen>(source)))
  if checked.status() <> 0 then do
    /* Never decode malformed input while reporting its original error. */
    start = max(0,offset - 8)
    return header || '0a'x || '  source bytes: ' || bin2x(binsubstr(source,start + 1,24))
  end
  text = binsubstr(source,first + 1,last - first) as .string
  start = max(1,column - 20); marker = 0; excerpt = ''; part = .string
  if start > 1 then do
    excerpt = '...'; marker = 3
  end
  do i = start to min(length(text),start + 159)
    part = excerptchar(substr(text,i,1),display)
    if i < column then marker = marker + length(part)
    excerpt = excerpt || part
  end
  if length(text) > start + 159 then excerpt = excerpt || '...'
  return header || '0a'x || '  ' || excerpt || '0a'x || '  ' || copies(' ',marker) || '^'

/** An escaped excerpt has deterministic ASCII marker positions, independent
 * of grapheme/font cell widths. The Unicode view still escapes controls. */
excerptchar: procedure = .string
  arg character = .string, display = .string
  ordinal = c2d(character)
  if ordinal = 9 then return '\t'
  if ordinal < 32 | ordinal = 127 then return '\x' || right(d2x(ordinal),2,'0')
  if character = '\' then return '\\'
  if ordinal >= 128 & display = 'escaped' then return '\u{' || d2x(ordinal) || '}'
  return character

/** Safe unexpected-input text. Preserve Unicode spelling; escape controls so
 * the lexeme cannot introduce a second terminal line or terminal escape. */
lexeme: procedure = .string
  arg bytes = .binary, eof = 0
  if eof then return 'end of input'
  checked = .prepared(bytes,'utf8')
  if checked.status() <> 0 then return 'bytes ' || bin2x(bytes)
  value = bytes as .string; out = "'"
  do i = 1 to min(length(value),80)
    c = substr(value,i,1); ordinal = c2d(c)
    select
      when c = "'" then out = out || "''"
      when c = '\' then out = out || '\\'
      when ordinal < 32 | ordinal = 127 then out = out || '\x' || right(d2x(ordinal),2,'0')
      otherwise out = out || c
    end
  end
  if length(value) > 80 then out = out || '…'
  return out || "'"

/** Substitute once: input data is never interpreted as another template. */
message: procedure = .string
  arg template = .string, found = .string, expected = .string, rule = .string
  out = ''; i = 1
  do while i <= length(template)
    c = substr(template,i,1)
    if (c = '{' | c = '}') & substr(template,i + 1,1) = c then do
      out = out || c; i = i + 2; iterate
    end
    if c = '{' then do
      finish = pos('}',template,i + 1)
      if finish = 0 then return template
      field = substr(template,i + 1,finish - i - 1)
      select field
        when 'found' then out = out || found
        when 'expected' then out = out || expected
        when 'rule' then out = out || rule
        otherwise out = out || '{' || field || '}'
      end
      i = finish + 1
    end
    else do
      out = out || c; i = i + 1
    end
  end
  return out
