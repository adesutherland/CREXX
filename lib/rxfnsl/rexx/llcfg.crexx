/* cREXX License (MIT). Pure CFG lowering shared by LR and Earley controls. */
options levelb
namespace llcfg expose productions
import llcore
import llcheck
import lllimits
import llprepared

/** Stable clause handles are nonterminals; terminals are -(symbol+1).
 * Production 1 is the augmented root. Original labels remain on each lhs.
 */
productions: class
  _g = .llcore..grammar
  _facts = .llcheck..analysis
  _root = .int
  _count = .int
  _slots = .int
  _max = .int
  _status = .int
  _built = .int
  _factsready = .int
  _prepared = .int
  _checking = .int
  _frozen = .int
  _frozenfacts = .binary
  _rowdata = .binary
  _rhsdata = .binary
  _expected_count = .int
  _expected_slots = .int
  _expected_max = .int
  _error = .string
  _lhs = .int[]
  _first = .int[]
  _length = .int[]
  _rhs = .int[]
  _limits = .lllimits..policy
  *: factory
    arg graph = .llcore..grammar, root = .int, ?limits = .lllimits..policy
    if ?limits = 0 then limits = .lllimits..policy()
    _limits = limits
    _g = graph; _root = root; _facts = .llcheck..analysis(graph,root,limits)
    _count = 0; _slots = 0; _max = 0; _status = 0; _error = ''; _built = 0; _factsready = 0; _prepared = 0; _checking = 0
    return
  /** Packed layout is checked against the same expansion used by build(). */
  prepared: factory
    arg graph = .llcore..grammar, root = .int, data = .binary, budget_ref = reference .llprepared..budget, ?limits = .lllimits..policy
    if ?limits = 0 then limits = .lllimits..policy.artifact(graph.size())
    _limits = limits; _g = graph; _root = root; _facts = .llcheck..analysis(graph,root,limits)
    _count = 0; _slots = 0; _max = 0; _status = 0; _error = ''; _built = 0
    _factsready = 0; _prepared = 0; _checking = 0
    decoded = .llprepared..reader(data,budget_ref)
    ok = decoded.expect('4c434647'x as .binary); version = decoded.u32()
    selected_root = decoded.i64(); identity = decoded.text()
    count = decoded.count(0); slots = decoded.count(0); maximum = decoded.u32()
    rows = decoded.binary(); rhs = decoded.binary()
    if decoded.finish() = 0 then do
      _status = decoded.status(); _error = decoded.error(); return
    end
    if version <> 1 | selected_root <> root | identity <> graph.signature() then do
      _status = 3; _error = 'prepared CFG grammar/root identity mismatch'; return
    end
    row_extent = <blen>(rows); rhs_extent = <blen>(rhs)
    if count < 1 | count > row_extent <idiv> 16 | slots > rhs_extent <idiv> 8 | maximum > slots then do
      _status = 3; _error = 'invalid prepared CFG dimensions'; return
    end
    if row_extent <> count * 16 | rhs_extent <> slots * 8 then do
      _status = 3; _error = 'prepared CFG extent mismatch'; return
    end
    if decoded.claim(maximum,256) = 0 then do
      _status = decoded.status(); _error = decoded.error(); return
    end
    _rowdata = rows; _rhsdata = rhs
    _expected_count = count; _expected_slots = slots; _expected_max = maximum; _prepared = 1
    return

  /** The generated layout was validated before encoding. */
  compiled: factory
    arg graph = .llcore..grammar, source_ref = reference .binary, first = .int
    source = dereference source_ref
    _g = graph
    wire = first + <at..u32>(first + 8) source
    facts_first = first + <at..u32>(first + 16) source; facts_bytes = <at..u32>(first + 20) source
    call binresize _frozenfacts,facts_bytes
    assembler bcopy _frozenfacts,source,facts_first
    _root = <at..i64>(wire + 8) source
    identity_bytes = <at..u32>(wire + 16) source
    at = wire + 20 + identity_bytes
    _count = <at..u32>(at) source; _slots = <at..u32>(at + 4) source; _max = <at..u32>(at + 8) source
    row_bytes = <at..u32>(at + 12) source; at = at + 16
    call binresize _rowdata,row_bytes
    assembler bcopy _rowdata,source,at
    at = at + row_bytes; rhs_bytes = <at..u32>(at) source; at = at + 4
    call binresize _rhsdata,rhs_bytes
    assembler bcopy _rhsdata,source,at
    _status = 0; _error = ''; _built = 1; _factsready = 1
    _prepared = 1; _checking = 0; _frozen = 1
    return

  /** Existing complete facts run only while encoding this read-ready data. */
  frozenimage: method = .binary
    arg budget_ref = reference .llprepared..budget
    absent = .binary; wire = image(budget_ref)
    if <blen>(wire) = 0 then return absent
    count = nonterminals()
    if <refvalid>(budget_ref) = 0 then do; call llprepared..reject(3,'expired frozen encoding budget'); return absent; end
    budget = dereference budget_ref
    if budget.take(count,258) = 0 then do; call llprepared..reject(4,budget.error()); return absent; end
    facts = .binary; call binresize facts,count * 258
    do nt = 1 to count
      at = (nt - 1) * 258
      <at..u8>(at) facts = nullable(nt)
      do symbol = 0 to 256
        <at..u8>(at + 1 + symbol) facts = first(nt,symbol)
      end
    end
    if _status <> 0 then do; call llprepared..reject(_status,_error); return absent; end
    output = .llprepared..writer(budget_ref)
    call output.raw('46434647'x as .binary); call output.u32(1)
    call output.u32(32); call output.u32(<blen>(wire))
    call output.u32(32 + <blen>(wire)); call output.u32(<blen>(facts))
    call output.u32(count); call output.u32(0)
    call output.raw(wire); call output.raw(facts)
    if output.status() <> 0 then do; call llprepared..reject(output.status(),output.error()); return absent; end
    return output.finish()

  image: method = .binary
    arg budget_ref = reference .llprepared..budget
    call build
    absent = .binary
    if _status <> 0 then do; call llprepared..reject(_status,_error); return absent; end
    output = .llprepared..writer(budget_ref)
    call output.raw('4c434647'x as .binary); call output.u32(1)
    call output.i64(_root); call output.text(_g.signature())
    call output.u32(_count); call output.u32(_slots); call output.u32(_max)
    if _prepared then do
      call output.binary(_rowdata); call output.binary(_rhsdata)
    end
    else do
      rows = .llprepared..writer(budget_ref); rhs_output = .llprepared..writer(budget_ref)
      do production = 1 to _count
        call rows.i64(_lhs[production]); call rows.u32(_length[production]); call rows.u32(_first[production])
      end
      do item = 1 to _slots
        call rhs_output.i64(_rhs[item])
      end
      call output.binary(rows.finish()); call output.binary(rhs_output.finish())
      if rows.status() <> 0 then do; call llprepared..reject(rows.status(),rows.error()); return absent; end
      if rhs_output.status() <> 0 then do; call llprepared..reject(rhs_output.status(),rhs_output.error()); return absent; end
    end
    if output.status() <> 0 then do; call llprepared..reject(output.status(),output.error()); return absent; end
    return output.finish()

  materialize: method = .void
    if _frozen then do; call llprepared..frozenmutation('CFG'); return; end
    if _prepared = 0 then return
    do production = 1 to _count
      at = (production - 1) * 16
      _lhs[production] = <at..i64>(at) _rowdata
      _length[production] = <at..u32>(at + 8) _rowdata
      _first[production] = <at..u32>(at + 12) _rowdata
    end
    do item = 1 to _slots
      _rhs[item] = <at..i64>((item - 1) * 8) _rhsdata
    end
    empty = .binary; _rowdata = empty; _rhsdata = empty; _prepared = 0
    return

  build: method = .void
    if _built then return
    _built = 1; graph = _g; root = _root
    if _facts.structure() = 0 then do
      _status = 3
      if _facts.limit() then _status = 4
      _error = _facts.error(); return
    end
    if graph.profile() <> 'contextfree' | _facts.ordered() | _facts.predicate() then do
      clause = _facts.ordered()
      if _facts.predicate() then clause = _facts.predicate()
      detail = 'declared semantics ' || graph.profile()
      if clause > 0 then detail = _facts.location(clause)
      _status = 1; _error = 'LL_BACKEND_CAPABILITY: ' || detail || '. A CFG backend requires contextfree choice without PEG predicates or ordered choice. Select a compatible backend or explicitly reformulate the rules; changing choice semantics can change the language.'; return
    end
    _checking = _prepared
    ok = pair(graph.size() + 1,root,0)
    i = .int; j = .int; a = .int; b = .int; op = .int; child = .int
    emptyints = .int[]
    do i = 1 to graph.size()
      op = graph.op(i); a = graph.left(i); b = graph.right(i)
      select op
        when 1 then ok = pair(i,-a - 1,0)
        when 2 then ok = pair(i,a,b)
        when 4 then do
          ok = pair(i,a,0); ok = pair(i,b,0)
        end
        when 5 then ok = pair(i,a,0)
        when 6 then ok = pair(i,0,0)
        when 7 then do
          ok = pair(i,a,i); ok = pair(i,0,0)
        end
        when 11 then do j = a to b
          ok = pair(i,-j - 1,0)
        end
        when 12 then do j = 0 to 255
          ok = pair(i,-j - 1,0)
        end
        when 13 then do
          text = graph.text(i); text_extent = <blen>(text)
          if _checking then do
            if text_extent > _expected_max | text_extent > _expected_slots - _slots then do
              _status = 3; _error = 'prepared CFG literal exceeds claimed RHS layout'; _checking = 0; return
            end
          end
          rhs = emptyints
          do j = 0 to text_extent - 1
            byte = <at..u8>(j) text
            rhs[j + 1] = -byte - 1
          end
          ok = append(i,rhs)
        end
        when 14 then do
          ok = pair(i,a,i); ok = pair(i,a,0)
        end
        when 15 then do
          ok = pair(i,a,0); ok = pair(i,0,0)
        end
        when 16 then do j = 0 to 255
          if graph.contains(i,j) then ok = pair(i,-j - 1,0)
        end
        otherwise do
          _status = 1; _error = _facts.location(i) || ': unsupported CFG clause (including explicit EOF assertion)'; return
        end
      end
      if _status <> 0 then do; _checking = 0; return; end
    end
    if _checking then do
      if _count <> _expected_count | _slots <> _expected_slots | _max <> _expected_max then do
        _status = 3; _error = 'prepared CFG does not match canonical production layout'
      end
    end
    _checking = 0
    return
  root: method = .int
    return _root
  pair: method = .int
    arg lhs = .int, a = .int, b = .int
    rhs = .int[]
    if a <> 0 then rhs[1] = a
    if b <> 0 then rhs[2] = b
    return append(lhs,rhs)
  append: method = .int
    arg lhs = .int, rhs = .int[]
    if _frozen then return llprepared..frozenmutation('CFG')
    if _status <> 0 then return 0
    if _prepared & _checking = 0 then call materialize
    if _count >= _limits.limit('cfg.productions') then do
      _status = 4; _error = _limits.exhausted('cfg.productions',_count + 1); return 0
    end
    if _checking then do
      if _count >= _expected_count then do
        _status = 3; _error = 'prepared CFG lacks a canonical production'; return 0
      end
      at = _count * 16
      actual_lhs = <at..i64>(at) _rowdata
      actual_length = <at..u32>(at + 8) _rowdata
      actual_first = <at..u32>(at + 12) _rowdata
      if actual_lhs <> lhs | actual_length <> rhs[0] | actual_first <> _slots + 1 then do
        _status = 3; _error = 'prepared CFG production differs from grammar'; return 0
      end
      if rhs[0] > _expected_slots - _slots then do
        _status = 3; _error = 'prepared CFG RHS exceeds layout'; return 0
      end
      do item = 1 to rhs[0]
        if <at..i64>((_slots + item - 1) * 8) _rhsdata <> rhs[item] then do
          _status = 3; _error = 'prepared CFG RHS differs from grammar'; return 0
        end
      end
      _count = _count + 1; _slots = _slots + rhs[0]
      if rhs[0] > _max then _max = rhs[0]
      return _count
    end
    _count = _count + 1; _lhs[_count] = lhs
    _first[_count] = _slots + 1; _length[_count] = rhs[0]
    if rhs[0] > _max then _max = rhs[0]
    do j = 1 to rhs[0]
      _slots = _slots + 1; _rhs[_slots] = rhs[j]
    end
    return _count
  count: method = .int
    return _count
  nonterminals: method = .int
    return _g.size() + 1
  maxrhs: method = .int
    return _max
  lhs: method = .int
    arg p = .int
    if _prepared then do
      if p < 1 | p > _count then return 0
      return <at..i64>((p - 1) * 16) _rowdata
    end
    return _lhs[p]
  length: method = .int
    arg p = .int
    if _prepared then do
      if p < 1 | p > _count then return 0
      return <at..u32>((p - 1) * 16 + 8) _rowdata
    end
    return _length[p]
  rhs: method = .int
    arg p = .int, at = .int
    if _prepared then do
      if p < 1 | p > _count then return 0
      size = <at..u32>((p - 1) * 16 + 8) _rowdata
      if at < 0 | at >= size then return 0
      first = <at..u32>((p - 1) * 16 + 12) _rowdata
      return <at..i64>((first + at - 1) * 8) _rhsdata
    end
    if at < 0 | at >= _length[p] then return 0
    return _rhs[_first[p] + at]
  /** Loaded tables need production layout only. Construction algorithms demand
   * full facts once; repeated nullable/FIRST queries keep a scalar ready guard. */
  preparefacts: method = .void
    if _factsready then return
    call build
    if _status <> 0 then return
    if (_facts is .llcheck..analysis) = 0 then do
      _limits = .lllimits..policy.artifact(_g.size())
      _facts = .llcheck..analysis(_g,_root,_limits)
    end
    if _facts.run() = 0 then do
      _status = 3
      if _facts.limit() then _status = 4
      _error = _facts.error(); return
    end
    _factsready = 1
    return
  nullable: method = .int
    arg nt = .int
    if _frozen then do
      if nt < 1 then return 0
      if nt > _g.size() then nt = _root
      return <at..u8>((nt - 1) * 258) _frozenfacts
    end
    if _factsready = 0 then call preparefacts
    if _status <> 0 then return 0
    if nt > _g.size() then nt = _root
    return _facts.nullable(nt)
  first: method = .int
    arg nt = .int, symbol = .int
    if _frozen then do
      if nt < 1 | symbol < 0 | symbol > 256 then return 0
      if nt > _g.size() then nt = _root
      return <at..u8>((nt - 1) * 258 + 1 + symbol) _frozenfacts
    end
    if _factsready = 0 then call preparefacts
    if _status <> 0 then return 0
    if nt > _g.size() then nt = _root
    return _facts.first(nt,symbol)
  label: method = .string
    arg nt = .int
    if nt > _g.size() then return '<root>'
    return _g.label(nt)
  /** Read retained symbol metadata without copying the source grammar. */
  symbolkind: method = .int
    arg symbol = .int
    return _g.op(symbol)
  /** Preserve the parser's first declared terminal label and fallback. */
  terminalname: method = .string
    arg token = .int
    if token = 256 then return 'end of input'
    do named = 1 to _g.size()
      if _g.op(named) = 1 & _g.left(named) = token then return _g.label(named)
    end
    return 'token ' || token
  location: method = .string
    arg p = .int
    nt = lhs(p)
    if nt > _g.size() then return '<root>'
    if _g.op(nt) = 5 then return _g.label(nt) || ' (line ' || _g.line(nt) || ')'
    owners = ''; emptyints = .int[]
    do rule = 1 to _g.size()
      if _g.op(rule) <> 5 then iterate
      pending = emptyints; pending[1] = _g.left(rule); used = emptyints; at = 1; found = 0
      do while at <= pending[0]
        child = pending[at]; at = at + 1
        if child = nt then do
          found = 1; leave
        end
        if child < 1 | child > _g.size() then iterate
        if used[child] | _g.op(child) = 5 then iterate
        used[child] = 1; op = _g.op(child)
        if op = 2 | op = 4 then do
          pending[pending[0] + 1] = _g.left(child); pending[pending[0] + 1] = _g.right(child)
        end
        else if op = 7 | op = 14 | op = 15 then pending[pending[0] + 1] = _g.left(child)
      end
      if found then do
        if owners <> '' then owners = owners || ', '
        owners = owners || _g.label(rule) || ' (line ' || _g.line(rule) || ')'
      end
    end
    if owners = '' then return _g.label(nt) || ' (line ' || _g.line(nt) || ')'
    return owners
  status: method = .int
    call build
    return _status
  source: method = .llcore..grammar
    return _g
  error: method = .string
    call build
    return _error
