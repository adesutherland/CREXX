  tables: method = .lllr..tables
    return _parser
  /** Borrow fields of this anchored, live, unchanged definition. The caller
   * must retain this receiver, in the same worker, until its readers end. */
  borrowedscanner: method = .llmunch..scanner
    arg source = .binary, mode = .string, fuel = 10000000
    return .llmunch..scanner.borrowed(reference _dfa,source,mode,fuel)
  borrowedparser: method = .lllr..parser
    arg input = .llcore..stream, fuel = 1000000
    return .lllr..parser.borrowed(reference _parser,input,fuel)
  backend: method = .string
    return _backend
  grammar: method = .llcore..grammar
    return _graph
  root: method = .int
    return _root
  operators: method = .llpratt..operators
    return _operators
  expressionname: method = .string
    if _frozen then return configtext(8)
    return _expressionname
  region: method = .llregional..plan
    return _regional
  encoding: method = .string
    if _frozen then return configtext(2)
    return _encoding
  opening: method = .string
    if _frozen then return configtext(4)
    return _open
  closing: method = .string
    if _frozen then return configtext(5)
    return _close
