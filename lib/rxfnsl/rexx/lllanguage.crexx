    if _frozen then do
      count = <at..u32>(8) _frozendiags
      do i = 1 to count
        at = 32 + (i - 1) * 32 + 24
        first = <at..u32>(at) _frozendiags; size = <at..u32>(at + 4) _frozendiags; matches = 0
        if <blen>(contexts) = size then do state = 0 to size - 1
          if <at..u8>(state) contexts then do
            if <at..u8>(first + state) _frozendiags = 0 then do; matches = 0; leave; end
            matches = 1
          end
        end
        if matches then do
          if selected > 0 then return fallback
          selected = i
        end
      end
      if selected = 0 then return fallback
      return messagetext(selected,1) || ': ' || llsource..message(messagetext(selected,3),found,expected,messagetext(selected,2))
    end
    do i = 1 to _diagnosticname[0]
      mask = _diagnosticmask[i]; matches = 0
      if <blen>(contexts) = <blen>(mask) then do state = 0 to <blen>(mask) - 1
        if <at..u8>(state) contexts then do
          if <at..u8>(state) mask = 0 then do
            matches = 0; leave
          end
          matches = 1
        end
      end
      if matches then do
        if selected > 0 then return fallback
        selected = i
      end
    end
    if selected = 0 then return fallback
    return _diagnosticname[selected] || ': ' || llsource..message(_diagnostictext[selected],found,expected,_diagnosticrule[selected])
  tokenname: method = .string
