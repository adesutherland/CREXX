/* cREXX License (MIT). Reusable generated-language definition and parse request. */
options levelb
namespace lllanguage expose definition request prepared compiled
import rxfnsb
import llcore
import lllr
import llmunch
import llstage
import llsource
import llcomments
import llpeg
import llearley
import llforest
import llpratt
import llregional
import llproject
import llast
import lllimits
import llprepared

/* Fixed envelope directory access; only the compiled header admits it. */
frozenfirst: procedure = .int
  arg owner_ref = reference .binary, id = .int, profile = .int, length = 0
  data = dereference owner_ref
  entry = id - 1
  if profile = 0 & id > 1 then entry = id - 5
  return <at..u32>(24 + entry * 12 + length * 4) data

frozenheader: procedure = .void
  arg output_ref = reference .llprepared..writer, magic = .binary, count = .int, auxiliary = .int, rows = .int, extra = .int, index = .int, pool = .int
  output = dereference output_ref
  call output.raw(magic); call output.u32(1); call output.u32(count); call output.u32(auxiliary)
  call output.u32(rows); call output.u32(extra); call output.u32(index); call output.u32(pool)
  return

frozenstrings: procedure = .binary
  arg values_ref = reference .string[], budget_ref = reference .llprepared..budget, magic = .binary
  values = dereference values_ref; output = .llprepared..writer(budget_ref)
  rows = .llprepared..writer(budget_ref); pool = .llprepared..writer(budget_ref)
  cursor = 32 + values[0] * 8
  call frozenheader(reference output,magic,values[0],0,32,0,0,cursor)
  do i = 1 to values[0]
    bytes = values[i] as .binary; size = <blen>(bytes)
    call rows.u32(cursor); call rows.u32(size); call pool.raw(bytes); cursor = cursor + size
  end
  call output.raw(rows.finish()); call output.raw(pool.finish())
  absent = .binary
  if rows.status() <> 0 then do; call llprepared..reject(rows.status(),rows.error()); return absent; end
  if pool.status() <> 0 then do; call llprepared..reject(pool.status(),pool.error()); return absent; end
  if output.status() <> 0 then do; call llprepared..reject(output.status(),output.error()); return absent; end
  return output.finish()

/* One generated-profile configuration predicate serves encoding and loading. */
configuration: procedure = .int
  arg backend = .string, encoding = .string, eof = .int, sync = .int, hasparser = .int, root = .int, presence = .int
  if backend = 'lr1' then do
    if hasparser <> 1 then return 0
  end
  else if backend <> 'none' | hasparser <> 0 then return 0
  return wordpos(encoding,'utf8 utf8bytes bytes') > 0 & eof >= -1 & eof <= 255 & sync >= -1 & sync <= 255 & root = 0 & presence = 0

definition: class
  _frozen = .int
  _frozenconfig = .binary
  _frozenstages = .binary
  _frozentokens = .binary
  _frozendiags = .binary
  _dfa = .llmunch..automaton
  _parser = .lllr..tables
  _graph = .llcore..grammar
  _root = .int
  _backend = .string
  _operators = .llpratt..operators
  _regional = .llregional..plan
  _expressionname = .string
  _schema = .llproject..schema
  _ast = .llast..schema
  _encoding = .string
  _unicodeversion = .string
  _open = .string
  _close = .string
  _comments = .llcomments..rules
  _stages = .llstage..rules[]
  _tokens = .string[]
  _malformed = .string
  _unmatched = .string
  _eof = .int
  _hasparser = .int
  _sync = .int
  _diagnosticname = .string[]
  _diagnosticrule = .string[]
  _diagnostictext = .string[]
  _diagnosticmask = .binary[]
  *: factory
    arg dfa = .llmunch..automaton, parser = .lllr..tables, encoding = .string, opening = '', closing = ''
    _dfa = dfa; _parser = parser; _encoding = encoding; _open = opening; _close = closing
    _hasparser = 1; _malformed = ''; _unmatched = ''; _eof = -1
    _backend = 'lr1'; _root = 0; _sync = -1
    _schema = .llproject..schema(); _ast = .llast..schema()
    _comments = .llcomments..rules()
    if opening <> '' then ok = _comments.add('nested','nested',opening,closing)
    return
  interpreted: factory
    arg dfa = .llmunch..automaton, graph = .llcore..grammar, root = .int, backend = .string, encoding = .string, opening = '', closing = ''
    _dfa = dfa; _graph = graph; _root = root; _backend = backend
    _encoding = encoding; _open = opening; _close = closing
    _hasparser = 1; _malformed = ''; _unmatched = ''; _eof = -1
    _sync = -1
    _schema = .llproject..schema(); _ast = .llast..schema()
    _comments = .llcomments..rules()
    if opening <> '' then ok = _comments.add('nested','nested',opening,closing)
    return
  scanner: factory
    arg dfa = .llmunch..automaton, encoding = .string, opening = '', closing = ''
    _dfa = dfa; _encoding = encoding; _open = opening; _close = closing
    _hasparser = 0; _malformed = ''; _unmatched = ''; _eof = -1
    _backend = 'none'; _root = 0; _sync = -1
    _schema = .llproject..schema(); _ast = .llast..schema()
    _comments = .llcomments..rules()
    if opening <> '' then ok = _comments.add('nested','nested',opening,closing)
    return
  operatorform: factory
    arg dfa = .llmunch..automaton, operators = .llpratt..operators, name = .string, encoding = .string, opening = '', closing = ''
    _dfa = dfa; _operators = operators; _expressionname = name; _backend = 'pratt'
    _encoding = encoding; _open = opening; _close = closing; _sync = -1
    _hasparser = 1; _malformed = ''; _unmatched = ''; _eof = -1; _root = 0
    _schema = .llproject..schema(); _ast = .llast..schema()
    _comments = .llcomments..rules()
    if opening <> '' then ok = _comments.add('nested','nested',opening,closing)
    return
  regional: factory
    arg dfa = .llmunch..automaton, parser = .lllr..tables, operators = .llpratt..operators, virtual = .int, open = .int, close = .int, encoding = .string, opening = '', closing = ''
    _dfa = dfa; _parser = parser; _operators = operators; _backend = 'regional'
    _regional = .llregional..plan.loaded(parser,operators,virtual,open,close)
    _encoding = encoding; _open = opening; _close = closing; _sync = -1
    _hasparser = 1; _malformed = ''; _unmatched = ''; _eof = -1; _root = 0
    _schema = .llproject..schema(); _ast = .llast..schema()
    _comments = .llcomments..rules()
    if opening <> '' then ok = _comments.add('nested','nested',opening,closing)
    return
  /** Trusted generated data. All retained references are owning values. */
  compiled: factory
    arg source_ref = reference .binary, profile = .int
    source = dereference source_ref
    _frozen = 1; _hasparser = profile; _root = 0; _backend = 'none'
    if profile then _backend = 'lr1'
    first = frozenfirst(source_ref,1,profile); size = frozenfirst(source_ref,1,profile,1)
    call binresize _frozenconfig,size
    assembler bcopy _frozenconfig,source,first
    first = frozenfirst(source_ref,8,profile); size = frozenfirst(source_ref,8,profile,1)
    call binresize _frozenstages,size
    assembler bcopy _frozenstages,source,first
    first = frozenfirst(source_ref,9,profile); size = frozenfirst(source_ref,9,profile,1)
    call binresize _frozentokens,size
    assembler bcopy _frozentokens,source,first
    first = frozenfirst(source_ref,12,profile); size = frozenfirst(source_ref,12,profile,1)
    call binresize _frozendiags,size
    assembler bcopy _frozendiags,source,first
    _dfa = .llmunch..automaton.compiled(source_ref,frozenfirst(source_ref,6,profile),frozenfirst(source_ref,6,profile,1))
    _comments = .llcomments..rules.compiled(source_ref,frozenfirst(source_ref,7,profile),frozenfirst(source_ref,7,profile,1))
    _schema = .llproject..schema.compiled(source_ref,frozenfirst(source_ref,10,profile),frozenfirst(source_ref,10,profile,1))
    _ast = .llast..schema.compiled(source_ref,frozenfirst(source_ref,11,profile),frozenfirst(source_ref,11,profile,1))
    if profile then do
      graph = .llcore..grammar.compiled(source_ref,frozenfirst(source_ref,2,profile),frozenfirst(source_ref,2,profile,1))
      layout = .llcfg..productions.compiled(graph,source_ref,frozenfirst(source_ref,3,profile))
      _parser = .lllr..tables.compiled(layout,source_ref,frozenfirst(source_ref,4,profile),frozenfirst(source_ref,4,profile,1),frozenfirst(source_ref,5,profile),frozenfirst(source_ref,5,profile,1))
    end
    return

  configtext: method = .string
    arg item = .int
    if item < 1 | item > 8 then return ''
    rows = <at..u32>(16) _frozenconfig; at = rows + (item - 1) * 8
    first = <at..u32>(at) _frozenconfig; size = <at..u32>(at + 4) _frozenconfig
    return llprepared..packedtext(reference _frozenconfig,first,size)
  confignumber: method = .int
    arg item = .int
    if item < 1 | item > 5 then return 0
    return <at..i64>(32 + (item - 1) * 8) _frozenconfig

  stagecount: method = .int
    if _frozen then return <at..u32>(8) _frozenstages
    return _stages[0]
  stageat: method = .llstage..rules
    arg item = .int
    if _frozen = 0 then return _stages[item]
    absent = .llstage..rules
    count = <at..u32>(8) _frozenstages
    if item < 1 | item > count then return absent
    at = 32 + (item - 1) * 8
    first = <at..u32>(at) _frozenstages; size = <at..u32>(at + 4) _frozenstages
    return .llstage..rules.compiled(reference _frozenstages,first,size)
  tokencount: method = .int
    if _frozen then return <at..u32>(8) _frozentokens
    return _tokens[0]
  messagecount: method = .int
    if _frozen then return <at..u32>(8) _frozendiags
    return _diagnosticname[0]
  messagetext: method = .string
    arg item = .int, field = .int
    if _frozen = 0 then do
      if field = 1 then return _diagnosticname[item]
      if field = 2 then return _diagnosticrule[item]
      return _diagnostictext[item]
    end
    count = <at..u32>(8) _frozendiags
    if item < 1 | item > count then return ''
    at = 32 + (item - 1) * 32 + (field - 1) * 8
    first = <at..u32>(at) _frozendiags; size = <at..u32>(at + 4) _frozendiags
    return llprepared..packedtext(reference _frozendiags,first,size)
  messagemask: method = .binary
    arg item = .int
    if _frozen = 0 then return _diagnosticmask[item]
    absent = .binary
    count = <at..u32>(8) _frozendiags
    if item < 1 | item > count then return absent
    at = 32 + (item - 1) * 32 + 24
    first = <at..u32>(at) _frozendiags; size = <at..u32>(at + 4) _frozendiags
    return llprepared..packedbytes(reference _frozendiags,first,size)

  /** Explicit compatibility export may rebuild v1; creation never calls it. */
  frozenexport: method = .binary
    arg bytes = .int
    result = .definition
    if _hasparser then result = .definition(_dfa,_parser,encoding(),opening(),closing())
    else result = .definition.scanner(_dfa,encoding(),opening(),closing())
    call result.usecomments(_comments); call result.unicode(unicodeversion())
    call result.lexical(malformed(),unmatched(),eof()); call result.recovery(sync())
    i = .int; ok = .int
    do i = 1 to _schema.size()
      ok = result.keep(_schema.name(i),_schema.kind(i),_schema.arity(i))
    end
    do i = 1 to _ast.size()
      ok = result.astmap(_ast.rule(i),_ast.kind(i))
    end
    do i = 1 to _ast.fields()
      ok = result.astfield(_ast.rule(_ast.owner(i)),_ast.name(i),_ast.source(i),_ast.mode(i),_ast.card(i))
    end
    do i = 1 to stagecount()
      call result.addstage(stageat(i))
    end
    do i = 0 to tokencount() - 1
      call result.token(i,tokenname(i))
    end
    do i = 1 to messagecount()
      call result.diagnostic(messagetext(i,1),messagetext(i,2),messagetext(i,3),messagemask(i))
    end
    return result.image(bytes)

  /** Validate through the checked path before producing trusted compiled data. */
  frozenimage: method = .binary
    arg bytes = 67108864
    absent = .binary; wire = image(bytes)
    if <blen>(wire) = 0 then return absent
    checked = lllanguage..prepared(wire,,bytes)
    if initialized(checked) = 0 then return absent
    return checked.packfrozen(bytes)

  /** Encoder-only row/pool construction. Never called by compiled(). */
  packfrozen: method = .binary
    arg bytes = .int
    budget = .llprepared..budget(bytes); sections = .binary[]; absent = .binary; raw = .binary
    profile = _hasparser; i = .int; size = .int; cursor = .int; total = .int
    config = .llprepared..writer(reference budget)
    rows = .llprepared..writer(reference budget); pool = .llprepared..writer(reference budget)
    settings = .string[]
    settings[1] = backend(); settings[2] = encoding(); settings[3] = unicodeversion()
    settings[4] = opening(); settings[5] = closing(); settings[6] = malformed()
    settings[7] = unmatched(); settings[8] = expressionname()
    call frozenheader(reference config,'46444546'x as .binary,8,5,72,32,0,136)
    call config.i64(eof()); call config.i64(sync()); call config.i64(_hasparser)
    call config.i64(0); call config.i64(0)
    cursor = 136
    do i = 1 to 8
      raw = settings[i] as .binary; size = <blen>(raw)
      call rows.u32(cursor); call rows.u32(size); call pool.raw(raw); cursor = cursor + size
    end
    call config.raw(rows.finish()); call config.raw(pool.finish())
    if rows.status() <> 0 then do; call llprepared..reject(rows.status(),rows.error()); return absent; end
    if pool.status() <> 0 then do; call llprepared..reject(pool.status(),pool.error()); return absent; end
    if config.status() <> 0 then do; call llprepared..reject(config.status(),config.error()); return absent; end
    sections[1] = config.finish()
    if profile then do
      layout = _parser.grammar(); graph = layout.source()
      sections[2] = graph.frozenimage(reference budget); sections[3] = layout.frozenimage(reference budget)
      if budget.take(_parser.packed()) = 0 then do; call llprepared..reject(4,budget.error()); return absent; end
      sections[4] = _parser.image()
      if budget.take(_parser.states(),16) = 0 then do; call llprepared..reject(4,budget.error()); return absent; end
      sections[5] = _parser.directory()
    end
    if budget.take(_dfa.packed()) = 0 then do; call llprepared..reject(4,budget.error()); return absent; end
    sections[6] = _dfa.image(); sections[7] = _comments.frozenimage(reference budget)
    passes = .llprepared..writer(reference budget)
    pass_rows = .llprepared..writer(reference budget); pass_pool = .llprepared..writer(reference budget)
    count = stagecount(); cursor = 32 + count * 8
    call frozenheader(reference passes,'46535453'x as .binary,count,0,32,0,0,cursor)
    do i = 1 to count
      stage = stageat(i); data = stage.frozenimage(reference budget); size = <blen>(data)
      call pass_rows.u32(cursor); call pass_rows.u32(size); call pass_pool.raw(data); cursor = cursor + size
    end
    call passes.raw(pass_rows.finish()); call passes.raw(pass_pool.finish())
    if pass_rows.status() <> 0 then do; call llprepared..reject(pass_rows.status(),pass_rows.error()); return absent; end
    if pass_pool.status() <> 0 then do; call llprepared..reject(pass_pool.status(),pass_pool.error()); return absent; end
    if passes.status() <> 0 then do; call llprepared..reject(passes.status(),passes.error()); return absent; end
    sections[8] = passes.finish(); names = .string[]
    do i = 0 to tokencount() - 1
      names[i + 1] = tokenname(i)
    end
    sections[9] = frozenstrings(reference names,reference budget,'46544f4b'x as .binary)
    sections[10] = _schema.frozenimage(reference budget); sections[11] = _ast.frozenimage(reference budget)
    diagnostics = .llprepared..writer(reference budget)
    diagnostic_rows = .llprepared..writer(reference budget); diagnostic_pool = .llprepared..writer(reference budget)
    count = messagecount(); cursor = 32 + count * 32
    call frozenheader(reference diagnostics,'46444941'x as .binary,count,0,32,0,0,cursor)
    field = .int
    do i = 1 to count
      do field = 1 to 4
        if field = 4 then raw = messagemask(i)
        else raw = messagetext(i,field) as .binary
        size = <blen>(raw)
        call diagnostic_rows.u32(cursor); call diagnostic_rows.u32(size)
        call diagnostic_pool.raw(raw); cursor = cursor + size
      end
    end
    call diagnostics.raw(diagnostic_rows.finish()); call diagnostics.raw(diagnostic_pool.finish())
    if diagnostic_rows.status() <> 0 then do; call llprepared..reject(diagnostic_rows.status(),diagnostic_rows.error()); return absent; end
    if diagnostic_pool.status() <> 0 then do; call llprepared..reject(diagnostic_pool.status(),diagnostic_pool.error()); return absent; end
    if diagnostics.status() <> 0 then do; call llprepared..reject(diagnostics.status(),diagnostics.error()); return absent; end
    sections[12] = diagnostics.finish()
    count = 8; if profile then count = 12
    total = 20 + count * 12
    do i = 1 to 12
      if profile = 0 & i >= 2 & i <= 5 then iterate
      size = <blen>(sections[i])
      if size < 1 then do; call llprepared..reject(3,'empty frozen section after encoding refusal'); return absent; end
      if size > 4294967295 - total then do; call llprepared..reject(4,'frozen image exceeds u32 extent'); return absent; end
      total = total + size
    end
    output = .llprepared..writer(reference budget)
    call output.raw('4c465031'x as .binary); call output.u32(1); call output.u32(total)
    call output.u32(profile); call output.u32(count); cursor = 20 + count * 12
    do i = 1 to 12
      if profile = 0 & i >= 2 & i <= 5 then iterate
      size = <blen>(sections[i]); call output.u32(i); call output.u32(cursor); call output.u32(size)
      cursor = cursor + size
    end
    do i = 1 to 12
      if profile = 0 & i >= 2 & i <= 5 then iterate
      call output.raw(sections[i])
    end
    if output.status() <> 0 then do; call llprepared..reject(output.status(),output.error()); return absent; end
    return output.finish()

  /** Freeze the complete generated scanner/LR profile into one owned image. */
  image: method = .binary
    arg bytes = 67108864
    if _frozen then return frozenexport(bytes)
    absent = .binary; profile = 0
    i = .int; size = .int; total = .int; cursor = .int; count = .int
    if _backend = 'lr1' & _hasparser = 1 then profile = 1
    else if _backend <> 'none' | _hasparser <> 0 then do
      call llprepared..reject(2,'unsupported prepared definition profile'); return absent
    end
    if configuration(_backend,_encoding,_eof,_sync,_hasparser,_root,0) = 0 then do
      call llprepared..reject(3,'invalid prepared definition configuration'); return absent
    end
    if ((_graph is .llcore..grammar) & initialized(_graph)) | ((_operators is .llpratt..operators) & initialized(_operators)) | ((_regional is .llregional..plan) & initialized(_regional)) | _root <> 0 then do
      call llprepared..reject(2,'prepared profile requires generated definition fields'); return absent
    end
    if initialized(_comments) = 0 | initialized(_schema) = 0 | initialized(_ast) = 0 then do
      call llprepared..reject(3,'absent prepared metadata owner'); return absent
    end
    if initialized(_dfa) = 0 then do; call llprepared..reject(3,'missing definition DFA'); return absent; end
    if _dfa.packed() = 0 then do; call llprepared..reject(2,'mutable DFA is outside prepared profile'); return absent; end
    if _dfa.verify() = 0 then do; call llprepared..reject(3,_dfa.error()); return absent; end
    if profile then do
      if initialized(_parser) = 0 then do; call llprepared..reject(3,'missing definition LR tables'); return absent; end
      if _parser.status() <> 0 then do; call llprepared..reject(_parser.status(),_parser.error()); return absent; end
      if _parser.packed() = 0 then do; call llprepared..reject(2,'mutable LR tables are outside prepared profile'); return absent; end
    end
    budget = .llprepared..budget(bytes)
    if budget.take(_tokens[0],256) = 0 then do; call llprepared..reject(4,budget.error()); return absent; end
    if budget.take(_stages[0],256) = 0 then do; call llprepared..reject(4,budget.error()); return absent; end
    if budget.take(_diagnosticname[0],1024) = 0 then do; call llprepared..reject(4,budget.error()); return absent; end
    sections = .binary[]; config = .llprepared..writer(reference budget)
    call config.raw('4c444546'x as .binary); call config.u32(1)
    call config.text(_backend); call config.text(_encoding); call config.text(_unicodeversion)
    call config.text(_open); call config.text(_close); call config.text(_malformed); call config.text(_unmatched)
    call config.i64(_eof); call config.i64(_sync); call config.u32(_hasparser)
    call config.i64(_root); call config.u32(0); call config.text(_expressionname)
    sections[1] = config.finish()
    if config.status() <> 0 then do; call llprepared..reject(config.status(),config.error()); return absent; end
    if profile then do
      if budget.take(_parser.packed()) = 0 then do; call llprepared..reject(4,budget.error()); return absent; end
      layout = _parser.grammar(); graph = layout.source()
      sections[2] = graph.image(reference budget); sections[3] = layout.image(reference budget)
      sections[4] = _parser.image()
      if budget.take(_parser.states(),16) = 0 then do; call llprepared..reject(4,budget.error()); return absent; end
      sections[5] = _parser.directory()
    end
    if budget.take(_dfa.packed()) = 0 then do; call llprepared..reject(4,budget.error()); return absent; end
    sections[6] = _dfa.image(); sections[7] = _comments.image(reference budget)
    passes = .llprepared..writer(reference budget)
    call passes.raw('4c535453'x as .binary); call passes.u32(1); call passes.u32(_stages[0])
    stage = .llstage..rules
    do i = 1 to _stages[0]
      stage = _stages[i]
      if stage.error() <> '' then do; call llprepared..reject(3,stage.error()); return absent; end
      call passes.binary(stage.image(reference budget))
    end
    sections[8] = passes.finish()
    names = .llprepared..writer(reference budget)
    call names.raw('4c544f4b'x as .binary); call names.u32(1); call names.u32(_tokens[0])
    do i = 1 to _tokens[0]
      call names.text(_tokens[i])
    end
    sections[9] = names.finish(); sections[10] = _schema.image(reference budget); sections[11] = _ast.image(reference budget)
    diagnostics = .llprepared..writer(reference budget)
    call diagnostics.raw('4c444941'x as .binary); call diagnostics.u32(1); call diagnostics.u32(_diagnosticname[0])
    do i = 1 to _diagnosticname[0]
      call diagnostics.text(_diagnosticname[i]); call diagnostics.text(_diagnosticrule[i])
      call diagnostics.text(_diagnostictext[i]); call diagnostics.binary(_diagnosticmask[i])
    end
    sections[12] = diagnostics.finish()
    if passes.status() <> 0 then do; call llprepared..reject(passes.status(),passes.error()); return absent; end
    if names.status() <> 0 then do; call llprepared..reject(names.status(),names.error()); return absent; end
    if diagnostics.status() <> 0 then do; call llprepared..reject(diagnostics.status(),diagnostics.error()); return absent; end
    count = 8; if profile then count = 12
    total = 20 + count * 12
    do i = 1 to 12
      if profile = 0 & i >= 2 & i <= 5 then iterate
      size = <blen>(sections[i])
      if size = 0 then do; call llprepared..reject(3,'empty required prepared section'); return absent; end
      if size > 4294967295 - total then do; call llprepared..reject(4,'prepared image exceeds u32 extent'); return absent; end
      total = total + size
    end
    output = .llprepared..writer(reference budget)
    call output.raw('4c445031'x as .binary); call output.u32(1); call output.u32(total)
    call output.u32(profile); call output.u32(count)
    cursor = 20 + count * 12
    do i = 1 to 12
      if profile = 0 & i >= 2 & i <= 5 then iterate
      size = <blen>(sections[i])
      call output.u32(i); call output.u32(cursor); call output.u32(size)
      cursor = cursor + size
    end
    do i = 1 to 12
      if profile = 0 & i >= 2 & i <= 5 then iterate
      call output.raw(sections[i])
    end
    if output.status() <> 0 then do; call llprepared..reject(output.status(),output.error()); return absent; end
    if budget.error() <> '' then do; call llprepared..reject(4,budget.error()); return absent; end
    return output.finish()

  /** Internal atomic metadata install after every section has been checked. */
  installprepared: method = .int
    arg settings_ref = reference .string[], numbers_ref = reference .int[], comments_ref = reference .llcomments..rules, stages_ref = reference .llstage..rules[], tokens_ref = reference .string[], projection_ref = reference .llproject..schema, ast_ref = reference .llast..schema, names_ref = reference .string[], rules_ref = reference .string[], texts_ref = reference .string[], masks_ref = reference .binary[]
    if _frozen then return llprepared..frozenmutation('language definition')
    settings = dereference settings_ref; config_numbers = dereference numbers_ref
    policies = dereference comments_ref; passes = dereference stages_ref; token_names = dereference tokens_ref
    projection = dereference projection_ref; ast_schema = dereference ast_ref
    diag_names = dereference names_ref; diag_rules = dereference rules_ref; diag_texts = dereference texts_ref; diag_masks = dereference masks_ref
    if settings[0] <> 8 | config_numbers[0] <> 5 then return 0
    if settings[1] <> _backend | config_numbers[3] <> _hasparser | config_numbers[4] <> 0 | config_numbers[5] <> 0 then return 0
    if policies.error() <> '' | projection.error() <> '' | ast_schema.error() <> '' then return 0
    if diag_names[0] <> diag_rules[0] | diag_names[0] <> diag_texts[0] | diag_names[0] <> diag_masks[0] then return 0
    _unicodeversion = settings[3]; _malformed = settings[6]; _unmatched = settings[7]; _expressionname = settings[8]
    _eof = config_numbers[1]; _sync = config_numbers[2]
    _comments = policies; _stages = passes; _tokens = token_names; _schema = projection; _ast = ast_schema
    _diagnosticname = diag_names; _diagnosticrule = diag_rules; _diagnostictext = diag_texts; _diagnosticmask = diag_masks
    return 1

  usecomments: method = .void
    arg policies = .llcomments..rules
    if _frozen then do; call llprepared..frozenmutation('language definition'); return; end
    _comments = policies
    return
  comments: method = .llcomments..rules
    return _comments
  unicode: method = .void
