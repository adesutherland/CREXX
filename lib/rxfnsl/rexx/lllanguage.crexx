    if _frozen then do
      result = .llstage..rules[]
      do item = 1 to stagecount()
        result[item] = stageat(item)
      end
      return result
    end
    return _stages

/** Explicit trusted compiled entry: only fixed-size header admission. */
compiled: procedure = .definition
  arg image = .binary
  absent = .definition; extent = <blen>(image)
  if extent < 20 then do; call llprepared..reject(3,'truncated frozen header'); return absent; end
  magic = <at..u32>(0) image; version = <at..u32>(4) image; total = <at..u32>(8) image
  profile = <at..u32>(12) image; count = <at..u32>(16) image
  expected = 8; if profile = 1 then expected = 12
  if magic <> 827344460 | version <> 1 | total <> extent | profile > 1 | count <> expected then do
    call llprepared..reject(3,'invalid frozen header'); return absent
  end
  cursor = 20 + count * 12
  if extent < cursor then do; call llprepared..reject(3,'truncated frozen directory'); return absent; end
  do entry = 0 to count - 1
    at = 20 + entry * 12; id = entry + 1
    if profile = 0 & entry > 0 then id = id + 4
    actual = <at..u32>(at) image; first = <at..u32>(at + 4) image; size = <at..u32>(at + 8) image
    if actual <> id | first <> cursor | size < 1 | size > extent - cursor then do
      call llprepared..reject(3,'invalid frozen directory'); return absent
    end
    cursor = cursor + size
  end
  if cursor <> extent then do; call llprepared..reject(3,'frozen extent mismatch'); return absent; end
  do
    return .definition.compiled(reference image,profile)
  on signal as problem
    original = problem as .runtime_signal
    call rxfnsb..signalrelay(original)
    return absent
  end
  return absent

/** Load one complete data-only definition. A handled failure returns absence,
 * never the local candidate. No new factory-return convention is required. */
prepared: procedure = .definition
  arg image = .binary, ?limits = .lllimits..policy, bytes = 67108864
  absent = .definition
  item = .int; entry = .int; id = .int; first = .int; size = .int; cursor = .int; remaining = .int
  extent = <blen>(image)
  if bytes < 0 | extent > bytes then do; call llprepared..reject(4,'prepared image exceeds byte budget'); return absent; end
  if ?limits then do
    if initialized(limits) = 0 then do; call llprepared..reject(3,'absent explicit prepared policy'); return absent; end
    if limits.error() <> '' then do; call llprepared..reject(3,limits.error()); return absent; end
  end
  explicit_limits = ?limits
  do
    budget = .llprepared..budget(bytes); input = .llprepared..reader(image,reference budget)
    ok = input.expect('4c445031'x as .binary)
    version = input.u32(); total = input.u32(); profile = input.u32(); count = input.u32()
    if input.status() <> 0 then do; call llprepared..reject(input.status(),input.error()); return absent; end
    remaining = input.remaining()
    if version <> 1 | total <> extent | profile > 1 | count < 1 | count > 12 | count > remaining <idiv> 12 then do
      call llprepared..reject(3,'invalid prepared envelope dimensions/version'); return absent
    end
    expected_count = 8; if profile then expected_count = 12
    if count <> expected_count then do; call llprepared..reject(3,'prepared profile section count mismatch'); return absent; end
    if input.claim(count,1024) = 0 then do; call llprepared..reject(input.status(),input.error()); return absent; end
    offsets = .int[]; lengths = .int[]; previous = 0; cursor = 20 + count * 12
    do entry = 1 to count
      id = input.u32(); first = input.u32(); size = input.u32()
      if id <= previous | id > 12 | first <> cursor | size < 1 | size > extent - cursor then do
        call llprepared..reject(3,'invalid prepared section directory'); return absent
      end
      if profile = 0 & id >= 2 & id <= 5 then do; call llprepared..reject(3,'unexpected scanner parser section'); return absent; end
      offsets[id] = first; lengths[id] = size; previous = id; cursor = cursor + size
    end
    if cursor <> extent then do; call llprepared..reject(3,'prepared directory does not consume image'); return absent; end
    sections = .binary[]; section = .binary
    do id = 1 to 12
      if profile = 0 & id >= 2 & id <= 5 then iterate
      if lengths[id] = 0 then do; call llprepared..reject(3,'missing prepared section'); return absent; end
      if input.claim(lengths[id],1) = 0 then do; call llprepared..reject(input.status(),input.error()); return absent; end
      call binresize section,lengths[id]
      offset = offsets[id]
      assembler bcopy section,image,offset
      sections[id] = section
    end
    config = .llprepared..reader(sections[1],reference budget)
    ok = config.expect('4c444546'x as .binary); config_version = config.u32()
    settings = .string[]; config_numbers = .int[]
    if config.claim(13,256) = 0 then do; call llprepared..reject(config.status(),config.error()); return absent; end
    do item = 1 to 7
      settings[item] = config.text()
    end
    config_numbers[1] = config.i64(); config_numbers[2] = config.i64(); config_numbers[3] = config.u32()
    config_numbers[4] = config.i64(); config_numbers[5] = config.u32(); settings[8] = config.text()
    if config.finish() = 0 then do; call llprepared..reject(config.status(),config.error()); return absent; end
    expected_backend = 'none'; if profile then expected_backend = 'lr1'
    if config_version <> 1 | settings[1] <> expected_backend | config_numbers[3] <> profile then do
      call llprepared..reject(3,'invalid prepared definition field presence/profile'); return absent
    end
    if configuration(settings[1],settings[2],config_numbers[1],config_numbers[2],config_numbers[3],config_numbers[4],config_numbers[5]) = 0 then do
      call llprepared..reject(3,'invalid prepared encoding/lexical settings'); return absent
    end
    machine_header = sections[6]; machine_extent = <blen>(machine_header)
    if explicit_limits & machine_extent >= 1040 then do
      if <at..i32>(0) machine_header = 1279542833 then do
        machine_states = <at..i32>(4) machine_header
        if machine_states > limits.limit('dfa.states') then do; call llprepared..reject(4,limits.exhausted('dfa.states',machine_states)); return absent; end
      end
    end
    dfa = .llmunch..automaton.loaded(machine_header)
    if dfa.verify() = 0 then do; call llprepared..reject(3,dfa.error()); return absent; end
    if explicit_limits then do
      if dfa.states() > limits.limit('dfa.states') then do; call llprepared..reject(4,limits.exhausted('dfa.states',dfa.states())); return absent; end
    end
    tables = .lllr..tables
    if profile then do
      graph = .llcore..grammar.prepared(sections[2],reference budget)
      if ?limits = 0 then limits = .lllimits..policy.artifact(graph.size())
      layout_header = sections[3]; layout_extent = <blen>(layout_header)
      if layout_extent < 16 then do; call llprepared..reject(3,'truncated prepared CFG header'); return absent; end
      root = <at..i64>(8) layout_header
      lr_header = sections[4]; lr_extent = <blen>(lr_header)
      if explicit_limits & lr_extent >= 12 then do
        if <at..i32>(0) lr_header = 1279414833 then do
          lr_states = <at..i32>(4) lr_header
          if lr_states > limits.limit('lr.states') then do; call llprepared..reject(4,limits.exhausted('lr.states',lr_states)); return absent; end
        end
      end
      tables = .lllr..tables.prepared(graph,root,sections[3],sections[4],sections[5],reference budget,limits)
      if tables.status() <> 0 then do; call llprepared..reject(tables.status(),tables.error()); return absent; end
      if explicit_limits then do
        if tables.states() > limits.limit('lr.states') then do; call llprepared..reject(4,limits.exhausted('lr.states',tables.states())); return absent; end
        if tables.grammar().maxrhs() > limits.limit('lr.rhs') then do; call llprepared..reject(4,limits.exhausted('lr.rhs',tables.grammar().maxrhs())); return absent; end
      end
    end
    policies = .llcomments..rules
    if explicit_limits then policies = .llcomments..rules.loaded(sections[7],reference budget,limits)
    else policies = .llcomments..rules.loaded(sections[7],reference budget)
    projection = .llproject..schema.loaded(sections[10],reference budget)
    ast_schema = .llast..schema.loaded(sections[11],reference budget)
    if policies.error() <> '' then do; call llprepared..reject(3,policies.error()); return absent; end
    if projection.error() <> '' then do; call llprepared..reject(3,projection.error()); return absent; end
    if ast_schema.error() <> '' then do; call llprepared..reject(3,ast_schema.error()); return absent; end
    stages_input = .llprepared..reader(sections[8],reference budget)
    ok = stages_input.expect('4c535453'x as .binary); stages_version = stages_input.u32(); stages_count = stages_input.u32()
    if stages_input.status() <> 0 then do; call llprepared..reject(stages_input.status(),stages_input.error()); return absent; end
    remaining = stages_input.remaining()
    if stages_version <> 1 | stages_count > remaining <idiv> 4 then do; call llprepared..reject(3,'invalid prepared stage list'); return absent; end
    if stages_input.claim(stages_count,256) = 0 then do; call llprepared..reject(stages_input.status(),stages_input.error()); return absent; end
    passes = .llstage..rules[]; pass = .llstage..rules
    do item = 1 to stages_count
      packed_stage = stages_input.binary()
      if stages_input.status() <> 0 then do; call llprepared..reject(stages_input.status(),stages_input.error()); return absent; end
      pass = .llstage..rules.loaded(packed_stage,reference budget)
      if pass.error() <> '' then do; call llprepared..reject(3,pass.error()); return absent; end
      if explicit_limits then do
        if pass.count() > limits.limit('stage.rules') then do; call llprepared..reject(4,limits.exhausted('stage.rules',pass.count())); return absent; end
      end
      passes[item] = pass
    end
    if stages_input.finish() = 0 then do; call llprepared..reject(stages_input.status(),stages_input.error()); return absent; end
    token_input = .llprepared..reader(sections[9],reference budget)
    ok = token_input.expect('4c544f4b'x as .binary); token_version = token_input.u32(); token_count = token_input.u32()
    if token_input.status() <> 0 then do; call llprepared..reject(token_input.status(),token_input.error()); return absent; end
    remaining = token_input.remaining()
    if token_version <> 1 | token_count > remaining <idiv> 4 then do; call llprepared..reject(3,'invalid prepared token list'); return absent; end
    if token_input.claim(token_count,256) = 0 then do; call llprepared..reject(token_input.status(),token_input.error()); return absent; end
    token_names = .string[]
    do item = 1 to token_count
      token_names[item] = token_input.text()
    end
    if token_input.finish() = 0 then do; call llprepared..reject(token_input.status(),token_input.error()); return absent; end
    diagnostic_input = .llprepared..reader(sections[12],reference budget)
    ok = diagnostic_input.expect('4c444941'x as .binary); diagnostic_version = diagnostic_input.u32(); diagnostic_count = diagnostic_input.u32()
    if diagnostic_input.status() <> 0 then do; call llprepared..reject(diagnostic_input.status(),diagnostic_input.error()); return absent; end
    remaining = diagnostic_input.remaining()
    if diagnostic_version <> 1 | diagnostic_count > remaining <idiv> 16 then do; call llprepared..reject(3,'invalid prepared diagnostic list'); return absent; end
    if diagnostic_input.claim(diagnostic_count,1024) = 0 then do; call llprepared..reject(diagnostic_input.status(),diagnostic_input.error()); return absent; end
    diag_names = .string[]; diag_rules = .string[]; diag_texts = .string[]; diag_masks = .binary[]
    do item = 1 to diagnostic_count
      diag_names[item] = diagnostic_input.text(); diag_rules[item] = diagnostic_input.text()
      diag_texts[item] = diagnostic_input.text(); diag_masks[item] = diagnostic_input.binary()
    end
    if diagnostic_input.finish() = 0 then do; call llprepared..reject(diagnostic_input.status(),diagnostic_input.error()); return absent; end
    /* Reserve the final owned component copy before constructing the candidate. */
    if budget.take(extent) = 0 then do; call llprepared..reject(4,budget.error()); return absent; end
    candidate = .definition
    if profile then candidate = .definition(dfa,tables,settings[2],settings[4],settings[5])
    else candidate = .definition.scanner(dfa,settings[2],settings[4],settings[5])
    installed = candidate.installprepared(reference settings,reference config_numbers,reference policies,reference passes,reference token_names,reference projection,reference ast_schema,reference diag_names,reference diag_rules,reference diag_texts,reference diag_masks)
    if installed = 0 then do; call llprepared..reject(3,'prepared metadata did not install atomically'); return absent; end
    return candidate
  on signal as problem
    original = problem as .runtime_signal
    call rxfnsb..signalrelay(original)
    return absent
  end
  return absent

/** Lexing may be used independently; parsing also accepts a consumer-supplied
 * token stream. Original bytes remain owned by every resulting tree. */
request: class
  _language = .definition
  _borrowed = .int
  _admitted = .int
  _owner = reference .definition
  _comments = .llcomments..rules
  _source = .binary
  _tokens = .llcore..stream
  _tree = .llcore..tree
  _root = .int
  _status = .int
  _offset = .int
  _error = .string
  _lexed = .int
  _forest = .llforest..arena
  _forestroot = .int
  _limits = .lllimits..policy
  _trivialimit = .int
  _triviasealed = .int
  _trivia = .llcomments..regions
  *: factory
    arg language = .definition, source = .binary, ?limits = .lllimits..policy
    _borrowed = 0; _admitted = 1; _trivialimit = 0; _triviasealed = 0
    empty_owner = reference .definition; _owner = empty_owner
    _language = language; _source = source; _root = 0; _status = 0; _offset = 0; _error = ''; _lexed = 0
    _tokens = .llcore..stream.tokens(source); _tree = .llcore..tree.from_source(source)
    _forestroot = 0
    if ?limits = 0 then limits = .lllimits..policy()
    _limits = limits
    if initialized(_limits) = 0 then _limits = .lllimits..policy()
    if _limits.error() <> '' then do
      _status = 3; _error = _limits.error(); _lexed = 1
    end
    return
  /** Borrow a fully prepared DFA/LR definition, without copying its tables.
   * The owner stays live, anchored and unchanged for every reader operation.
   * Source, limits, comments and all results remain request-owned. */
  borrowed: factory
    arg language = reference .definition, source = .binary, ?limits = .lllimits..policy, ?comments = .llcomments..rules
    _borrowed = 1; _admitted = 0; _owner = language; _trivialimit = 0; _triviasealed = 0
    _source = source; _root = 0; _status = 0; _offset = 0; _error = ''; _lexed = 0
    _tokens = .llcore..stream.tokens(source); _tree = .llcore..tree.from_source(source)
    _forestroot = 0
    if ?limits = 0 then limits = .lllimits..policy()
    _limits = limits
    if initialized(_limits) = 0 then _limits = .lllimits..policy()
    if languagealive(_owner) = 0 then do
      _status = 3; _error = 'LL_BORROW_OWNER: request requires a live initialized definition'; _lexed = 1; return
    end
    owner = dereference _owner
    if ?comments then _comments = comments
    else _comments = owner.comments()
    if initialized(_comments) = 0 then do
      _status = 3; _error = 'LL_COMMENT_CONTRACT: comment override requires initialized rules'; _lexed = 1; return
    end
    if _comments.validate() = 0 then do
      _status = 3; _error = _comments.error(); _lexed = 1; return
    end
    if _limits.error() <> '' then do
      _status = 3; _error = _limits.error(); _lexed = 1; return
    end
    _admitted = 1
    return
  /** Select outer-comment observations before any lexing. Zero disables them. */
  capturetrivia: method = .int
    arg limit = .int
    if _lexed | _triviasealed | limit < 0 then do
      _status = 3; _error = 'LL_COMMENT_TRIVIA: select a nonnegative region limit before lexing or parsing'; _lexed = 1; return 0
    end
    _trivialimit = min(limit,_limits.limit('tree.entries'))
    if limit > 0 & _trivialimit = 0 then do
      _status = 2; _error = _limits.exhausted('tree.entries',1); _lexed = 1; return 0
    end
    return 1
  trivia: method = .llcomments..regions
    if initialized(_trivia) then do
      if _trivia is .llcomments..regions then return _trivia
    end
    return .llcomments..regions(0)
  lex: method = .int
    arg classify = 1
    ownerref = reference _language
    if _borrowed then do
      ownerref = _owner
      if languagealive(ownerref) = 0 then do
        _status = 3; _error = 'LL_BORROW_OWNER: request requires a live initialized definition'
        return _status
      end
    end
    language = dereference ownerref
    if _borrowed & _admitted = 0 then return _status
    if _lexed then return _status
    _lexed = 1
    comments = .llcomments..rules
    if _borrowed then comments = _comments
    else comments = language.comments()
    prepared = .llsource..prepared(_source,language.encoding(),'','',_limits.limit('source.bytes'),0,comments,_limits.limit('scan.work'),_trivialimit)
    _status = prepared.status()
    if _trivialimit > 0 then _trivia = prepared.trivia()
    if _status <> 0 then do
      _error = prepared.error(); _offset = prepared.offset()
      if left(_error,8) = 'LL_UTF8:' & language.malformed() <> '' then _error = language.malformed()
      return _status
    end
    scan = .llmunch..scanner
    if _borrowed then scan = language.borrowedscanner(prepared.bytes(),'munch',_limits.limit('scan.work'))
    else scan = .llmunch..scanner(language.automaton(),prepared.bytes(),'munch',_limits.limit('scan.work'))
    _status = scan.run()
    /* Preserve already accepted lexical tokens for inspection/ABI adapters.
     * A nonzero status still prevents parsing or execution of this request. */
    masked = scan.tokens()
    do i = 0 to masked.size() - 1
      ok = _tokens.append(masked.symbol(i),masked.start(i),masked.finish(i + 1))
    end
    if _status <> 0 then do
      _error = scan.error(); _offset = scan.offset()
      if _status = 1 then _error = 'LL_LEXICAL: ' || _error
      if _status = 1 & language.unmatched() <> '' then _error = language.unmatched()
      return _status
    end
    if classify then return classify_tokens(_tokens)
    return 0
  /** Run declared token stages after a consumer has normalized layout. */
  classify_tokens: method = .int
    arg tokens = .llcore..stream
    ownerref = reference _language
    if _borrowed then do
      ownerref = _owner
      if languagealive(ownerref) = 0 then do
        _status = 3; _error = 'LL_BORROW_OWNER: request requires a live initialized definition'
        return _status
      end
    end
    language = dereference ownerref
    if _borrowed & _admitted = 0 then return _status
    if tokens.source() <> _source | tokens.error() <> '' then do
      _status = 3; _error = 'LL_SOURCE_OWNER: invalid staged token source'; return _status
    end
    _tokens = tokens
    do i = 1 to language.stagecount()
      stage = .llstage..transducer(language.stageat(i),_tokens,_limits.limit('parse.work'))
      _status = stage.run()
      if _status <> 0 then do
        _error = stage.error(); return _status
      end
      _tokens = stage.output()
    end
    return 0
  parse: method = .int
    if lex() <> 0 then return _status
    return parse_tokens(_tokens)
  parse_tokens: method = .int
    arg tokens = .llcore..stream
    _triviasealed = 1
    at = .int; bytes = .binary; found = .string; fallback = .string
    ownerref = reference _language
    if _borrowed then do
      ownerref = _owner
      if languagealive(ownerref) = 0 then do
        _status = 3; _error = 'LL_BORROW_OWNER: request requires a live initialized definition'
        return _status
      end
    end
    language = dereference ownerref
    if _borrowed & _admitted = 0 then return _status
    if _limits.error() <> '' then do
      _status = 3; _error = _limits.error(); return _status
    end
    if tokens.source() <> _source then do
      _status = 3; _error = 'LL_SOURCE_OWNER: token source differs'; return _status
    end
    if _borrowed & language.backend() <> 'lr1' then do
      _status = 3; _error = 'LL_BORROW_BACKEND: borrowed parsing requires LR1'; return _status
    end
    if language.hasparser() = 0 then do
      _status = 3; _error = 'LL_NO_PARSER: this specification defines a lexer only'; return _status
    end
    _tokens = tokens
    backend = language.backend()
    if backend = 'pratt' then do
      expression = .llpratt..parser(language.operators(),tokens,_limits.limit('parse.work'))
      _status = expression.run(); _tree = expression.namedtree(); _root = expression.root()
      _offset = expression.offset(); _error = expression.error()
      if _status = 0 then _root = _tree.add(5,language.expressionname(),_tree.start(_root),_tree.finish(_root),_root,0)
      if _status = 1 then do
        at = 0
        do while at < tokens.size() & tokens.start(at) < _offset
          at = at + 1
        end
        bytes = binsubstr(_source,tokens.start(at) + 1,tokens.finish(at + 1) - tokens.start(at))
        found = llsource..lexeme(bytes,at >= tokens.size())
        _error = 'unexpected ' || found || '; ' || _error
      end
      return _status
    end
    if backend = 'regional' then do
      composite = .llregional..parser(language.region(),tokens,_limits.limit('parse.work'),1)
      _status = composite.run(); _tree = composite.tree(); _root = composite.root()
      _offset = composite.offset(); _error = composite.error()
      if _status = 1 then do
        contexts = composite.contexts()
          at = 0
          do while at < tokens.size() & tokens.start(at) < _offset
            at = at + 1
          end
          bytes = binsubstr(_source,tokens.start(at) + 1,tokens.finish(at + 1) - tokens.start(at))
          found = llsource..lexeme(bytes,at >= tokens.size())
          _error = 'unexpected ' || found || '; ' || _error
          if <blen>(contexts) > 0 then _error = language.explain(contexts,found,composite.expected(),_error)
      end
      return _status
    end
    if backend = 'll1' | backend = 'packrat' then do
      predictive = .llpeg..parser(language.grammar(),language.root(),tokens,backend,_limits.limit('parse.work'),_limits)
      _status = predictive.run(); _tree = predictive.arena(); _root = predictive.root()
      _offset = predictive.offset(); _error = predictive.error()
      if _status = 1 then do
        at = predictive.position()
        bytes = binsubstr(_source,tokens.start(at) + 1,tokens.finish(at + 1) - tokens.start(at))
        found = llsource..lexeme(bytes,at >= tokens.size())
        fallback = 'unexpected ' || found || '; expected ' || predictive.expectations()
        _error = language.explain(predictive.contexts(),found,predictive.expectations(),fallback)
      end
      return _status
    end
    if backend = 'earley' then do
      chart = .llearley..parser(language.grammar(),language.root(),tokens,_limits.limit('parse.work'),_limits.limit('earley.cells'),_limits)
      _status = chart.run(); _offset = chart.offset(); _error = chart.error()
      _forest = chart.forest(); _forestroot = chart.root()
      if _status = 1 then do
        at = chart.position()
        bytes = binsubstr(_source,tokens.start(at) + 1,tokens.finish(at + 1) - tokens.start(at))
        found = llsource..lexeme(bytes,at >= tokens.size())
        fallback = 'unexpected ' || found || '; expected ' || chart.expected()
        _error = language.explain(chart.contexts(),found,chart.expected(),fallback)
      end
      if _status = 0 then do
        _root = chart.treeroot(); _tree = chart.tree()
        if chart.status() <> 0 then do
          _status = chart.status(); _error = chart.error(); return _status
        end
        if _root = 0 then do
          _status = 5; _error = 'LL_FOREST: accepted input has no unique finite tree; inspect the forest and choose an explicit policy'
        end
      end
      return _status
    end
    parser = .lllr..parser
    if _borrowed then parser = language.borrowedparser(tokens,_limits.limit('parse.work'))
    else parser = .lllr..parser(language.tables(),tokens,_limits.limit('parse.work'))
    _status = parser.run(); _tree = parser.tree(); _root = parser.root()
    _offset = parser.offset(); _error = parser.error()
    if _status = 1 then do
      at = parser.position(); bytes = binsubstr(_source,tokens.start(at) + 1,tokens.finish(at + 1) - tokens.start(at))
      found = llsource..lexeme(bytes,at >= tokens.size())
      fallback = 'unexpected ' || found || '; expected ' || parser.expected()
      _error = language.explain(parser.contexts(),found,parser.expected(),fallback)
    end
    return _status
  tokens: method = .llcore..stream
    return _tokens
  tree: method = .llcore..tree
    return _tree
  root: method = .int
    return _root
  forest: method = .llforest..arena
    return _forest
  forestroot: method = .int
    return _forestroot
  /** Projection is explicit and refuses failed/forest requests. The original
   * derivation remains available even if an application arity check fails. */
  projection: method = .llproject..projection
    ownerref = reference _language
    if _borrowed then do
      ownerref = _owner
      if languagealive(ownerref) = 0 then do
        _status = 3; _error = 'LL_BORROW_OWNER: request requires a live initialized definition'
        return .llproject..projection(_tree,0,.llproject..schema(),_limits.limit('tree.entries'))
      end
    end
    language = dereference ownerref
    if _borrowed & _admitted = 0 then return .llproject..projection(_tree,0,.llproject..schema(),_limits.limit('tree.entries'))
    root = _root
    if _status <> 0 then root = 0
    return .llproject..projection(_tree,root,language.schema(),_limits.limit('tree.entries'))
  /** Construct an owned AST only from a successful unique parse. */
  ast: method = .llast..tree
    ownerref = reference _language
    if _borrowed then do
      ownerref = _owner
      if languagealive(ownerref) = 0 then do
        _status = 3; _error = 'LL_BORROW_OWNER: request requires a live initialized definition'
        return .llast..tree.failed(_error)
      end
    end
    language = dereference ownerref
    if _borrowed & _admitted = 0 then return .llast..tree.failed(_error)
    if _status <> 0 | _root = 0 then return .llast..tree.failed('LL_AST_PARSE: AST construction requires a successful unique parse; ' || _error)
    return .llast..tree(_tree,_root,language.astschema(),_limits.limit('tree.entries'))
  offset: method = .int
    return _offset
  error: method = .string
    return _error

/** A weak borrow never prolongs storage lifetime; inspect validity first. */
languagealive: procedure = .int
  arg owner = reference .definition
  if <refvalid>(owner) = 0 then return 0
  language = dereference owner
  return initialized(language)
