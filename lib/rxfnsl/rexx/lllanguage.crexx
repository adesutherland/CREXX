    if _frozen then return configtext(3)
    return _unicodeversion
  keep: method = .int
    arg name = .string, kind = .int, arity = .int
    if _frozen then return llprepared..frozenmutation('language definition')
    return _schema.keep(name,kind,arity)
  astmap: method = .int
    arg rule = .string, kind = .string
    if _frozen then return llprepared..frozenmutation('language definition')
    return _ast.mapping(rule,kind)
  astfield: method = .int
    arg rule = .string, name = .string, source = .string, mode = .string, card = .string
    if _frozen then return llprepared..frozenmutation('language definition')
    return _ast.field(rule,name,source,mode,card)
  astschema: method = .llast..schema
