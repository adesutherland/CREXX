/* cREXX License (MIT). Named n-ary view of an owned binary derivation tree. */
options levelb
namespace lltree expose view
import rxfnsb
import llcore
import lllimits

/** Keep authored rules and named terminals, erase only normalization wrappers.
 * Child order and source spans are unchanged. Transparent nodes retain only
 * frontier counts; visible child links are materialized once per named parent.
 * The entry budget bounds the resulting view without copying every list suffix.
 */
view: class
  _source = .llcore..tree
  _first = .int[]
  _counts = .int[]
  _children = .int[]
  _root = .int
  _error = .string
  *: factory
    arg source = .llcore..tree, root = .int, limit = 1000000
    _source = source; _root = root; _error = ''
    if source.validate() = 0 | root < 1 | root > source.size() then do
      _error = 'invalid source tree'; return
    end
    current = .int; top = .int; a = .int; b = .int
    counts = .int[]; pending = .int[]; output = 0; entries = 0
    do node = 1 to source.size()
      a = source.left(node); b = source.right(node); ca = 0; cb = 0
      if a > 0 then ca = counts[a]
      if b > 0 then cb = counts[b]
      if ca > limit - cb then do
        _error = lllimits..describe('tree.entries',limit,limit + 1); return
      end
      kept = source.kind(node) = 5 | (source.kind(node) = 1 & left(source.label(node),7) <> 'symbol.')
      if kept then do
        if entries + output + ca + cb + 1 > limit then do
          _error = lllimits..describe('tree.entries',limit,entries + output + ca + cb + 1); return
        end
        _first[node] = output + 1; _counts[node] = ca + cb
        /* Expand only transparent nodes. A named descendant is one child,
         * and its own descendants belong to that descendant's view. */
        top = 0
        if b > 0 then do
          top = top + 1; pending[top] = b
        end
        if a > 0 then do
          top = top + 1; pending[top] = a
        end
        do while top > 0
          current = pending[top]; top = top - 1
          if counts[current] = 0 then iterate
          named = source.kind(current) = 5 | (source.kind(current) = 1 & left(source.label(current),7) <> 'symbol.')
          if named then do
            output = output + 1; _children[output] = current
          end
          else do
            rightChild = source.right(current); leftChild = source.left(current)
            if rightChild > 0 then do
              top = top + 1; pending[top] = rightChild
            end
            if leftChild > 0 then do
              top = top + 1; pending[top] = leftChild
            end
          end
        end
        counts[node] = 1; entries = entries + 1
      end
      else counts[node] = ca + cb
    end
    if counts[root] <> 1 then _error = 'named tree requires one root'
    else do
      current = root
      do forever
        if source.kind(current) = 5 | (source.kind(current) = 1 & left(source.label(current),7) <> 'symbol.') then leave
        a = source.left(current); b = source.right(current)
        if a > 0 then do
          if counts[a] > 0 then do
            current = a; iterate
          end
        end
        current = b
      end
      _root = current
    end
    return
  root: method = .int
    return _root
  name: method = .string
    arg node = .int
    return _source.label(node)
  count: method = .int
    arg node = .int
    return _counts[node]
  child: method = .int
    arg node = .int, index = .int
    if index < 1 | index > _counts[node] then return 0
    return _children[_first[node] + index - 1]
  /** Named fields are source-owning wrapper nodes. Repeated occurrences keep
   * source order; an absent optional field has count zero. This lookup stays
   * within the current named node, never borrowing a nested rule's field. */
  fieldcount: method = .int
    arg node = .int, name = .string
    total = 0
    do i = 1 to _counts[node]
      field = _children[_first[node] + i - 1]
      if _source.label(field) = '@field.' || lower(name) then total = total + 1
    end
    return total
  field: method = .int
    arg node = .int, name = .string, occurrence = 1
    if occurrence < 1 then return 0
    do i = 1 to _counts[node]
      field = _children[_first[node] + i - 1]
      if _source.label(field) <> '@field.' || lower(name) then iterate
      occurrence = occurrence - 1
      if occurrence = 0 then return field
    end
    return 0
  start: method = .int
    arg node = .int
    return _source.start(node)
  finish: method = .int
    arg node = .int
    return _source.finish(node)
  text: method = .string
    arg node = .int
    return binsubstr(_source.source(),_source.start(node) + 1,_source.finish(node) - _source.start(node)) as .string
  source: method = .binary
    return _source.source()
  error: method = .string
    return _error
