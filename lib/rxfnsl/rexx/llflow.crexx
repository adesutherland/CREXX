/* cREXX License (MIT). Checked structured flow and finite definite assignment. */
options levelb
namespace llflow expose mapping graph result state
import rxfnsb
import llast

failaccess: procedure = .void
  arg message = .string
  assembler signal "ERROR",message
  return

/** Execution roles for AST kinds, independent of parser derivations. */
identities: initialiser expose flow_serial
  flow_serial = 0
  return
next_identity: procedure = .int expose flow_serial
  if flow_serial = 9223372036854775807 then call failaccess('LL_AST_IDENTITY: flow identities exhausted')
  flow_serial = flow_serial + 1
  return flow_serial

mapping: class
  _kind = .string[]
  _op = .string[]
  _fields = .string[]
  _error = .string
  _conflict = .int
  *: factory
    _error = ''; _conflict = 0
    return
  fail: method = .void
    arg message = .string, conflict = .int
    if _error = '' then do
      _error = 'LL_FLOW: ' || message; _conflict = conflict
    end
    return
  add: method = .int
    arg kind = .string, op = .string, fields = ''
    if index(kind) > 0 then do
      call fail('duplicate mapping for ' || kind,_kind[0] + 1); return 0
    end
    n = _kind[0] + 1; _kind[n] = kind; _op[n] = lower(op); _fields[n] = lower(fields)
    return n
  index: method = .int
    arg kind = .string
    do i = 1 to _kind[0]
      if lower(kind) = lower(_kind[i]) then return i
    end
    return 0
  check: method = .int
    arg schema = .llast..schema
    f = .int
    do m = 1 to _kind[0] while _error = ''
      kind = _kind[m]; op = _op[m]; fields = _fields[m]; rule = schema.kindindex(kind)
      if rule = 0 then do
        call fail('unknown AST kind ' || kind,m); leave
      end
      count = words(fields)
      select op
        when 'sequence' then valid = count = 1
        when 'evaluate' then valid = count >= 1
        when 'assign' then valid = count = 2
        when 'branch' then valid = count = 3
        when 'read' then valid = count = 1
        when 'value' then valid = count = 0
        otherwise valid = 0
      end
      if valid = 0 then do
        call fail('invalid ' || op || ' mapping for ' || kind,m); leave
      end
      available = ''
      do f = 1 to schema.fields()
        if schema.owner(f) = rule then available = strip(available || ' ' || schema.name(f))
      end
      used = ''
      do i = 1 to count while _error = ''
        field = word(fields,i); found = 0
        if wordpos(field,used) > 0 then call fail(kind || '.' || field || ' occurs twice in its flow mapping',m)
        used = strip(used || ' ' || field)
        do f = 1 to schema.fields()
          if schema.owner(f) = rule & schema.name(f) = field then do
            found = f; leave
          end
        end
        if found = 0 then do
          call fail(kind || ' has no field ' || field || '; available fields: ' || available,m); leave
        end
        text = (op = 'read' | op = 'assign') & i = 1
        if text then valid = schema.mode(found) = 'text'
        else valid = schema.mode(found) <> 'text'
        if valid = 0 then call fail(kind || '.' || field || ' must be ' || word('a-child text',text + 1),m)
        card = schema.card(found)
        if op = 'assign' & i = 2 then do
          if card <> 'one' then call fail(kind || '.' || field || ' must contain exactly one child',m)
        end
        if op = 'branch' then do
          if card <> 'one' & (i <> 3 | card <> 'optional') then call fail(kind || '.' || field || ' must contain one child (ELSE may be optional)',m)
        end
      end
      /* Every child needs an explicit execution role. Text metadata is inert. */
      do f = 1 to schema.fields() while _error = ''
        if schema.owner(f) <> rule | schema.mode(f) = 'text' then iterate
        if wordpos(schema.name(f),used) = 0 then call fail(kind || '.' || schema.name(f) || ' has no execution role',m)
      end
    end
    do r = 1 to schema.size() while _error = ''
      if index(schema.kind(r)) = 0 then call fail('missing mapping for AST kind ' || schema.kind(r),0)
    end
    return _error = ''
  size: method = .int
    return _kind[0]
  kind: method = .string
    arg i = .int
    return _kind[i]
  op: method = .string
    arg i = .int
    return _op[i]
  fields: method = .string
    arg i = .int
    return _fields[i]
  error: method = .string
    return _error
  conflict: method = .int
    return _conflict

/** A graph owns events and edges, borrowing its immutable AST.
 * Each mapped AST node gets an entry event; assignments write after their value.
 * @param limit Counted flow entries: events plus edges, not source bytes.
 */
graph: class
  _root = .llast..node
  _node = .llast..node[]
  _op = .string[]
  _name = .string[]
  _from = .int[]
  _destination = .int[]
  _label = .string[]
  _head = .int[]
  _next = .int[]
  _entry = .int[]
  _exit = .int[]
  _limit = .int
  _entries = .int
  _start = .int
  _error = .string
  _identity = .int
  _sealed = .int
  _building = .int
  _owner = reference .llast..tree
  _mapping = .mapping
  _ran = .int
  *: factory
    arg owner = reference .llast..tree, mapping = .mapping, limit = 1000000
    _identity = next_identity(); _sealed = 0; _building = 0
    _owner = owner; _mapping = mapping; _limit = limit; _ran = 0; _error = ''
    if <refvalid>(owner) = 0 then _error = 'LL_AST_OWNER: flow tree has expired'
    else do
      tree = dereference owner
      if tree.status() <> 0 then _error = tree.error()
      _root = tree.root()
    end
    return
  build: method = .void
    if _ran then return
    if _error <> '' then return
    _building = 1
    _ran = 1; owner = _owner; mapping = _mapping; limit = _limit
    _limit = limit; _entries = 0; _start = 0; _error = ''
    if limit < 0 then call fail('LL_FLOW_LIMIT: flow.entries must be nonnegative')
    if <refvalid>(owner) = 0 then do
      call fail('LL_AST_OWNER: flow tree has expired'); return
    end
    tree = dereference owner
    if _root.valid() = 0 then do
      call fail('LL_AST_OWNER: flow tree has expired or been replaced'); return
    end
    if tree.status() <> 0 then call fail(tree.error())
    if mapping.check(tree.contract()) = 0 then call fail(mapping.error())
    if _error <> '' then return
    walk = tree.walk()
    do while walk.next() & _error = ''
      node = walk.node(); id = node.id(); m = mapping.index(node.kind())
      if m = 0 then do
        call fail('LL_FLOW: unmapped AST kind ' || node.kind()); leave
      end
      op = mapping.op(m); fields = mapping.fields(m)
      first = event(node,'enter')
      if first = 0 then leave
      _entry[id] = first; last = first
      select op
        when 'read' then do
          _op[first] = 'read'; _name[first] = node.text(word(fields,1))
          if _name[first] = '' | words(_name[first]) <> 1 then call fail('LL_FLOW_NAME: a variable name must be one nonempty word')
        end
        when 'value' then nop
        when 'assign' then do
          value = node.child(word(fields,2)); ok = edge(first,_entry[value.id()])
          last = event(node,'write',node.text(word(fields,1)))
          if last = 0 then leave
          if _name[last] = '' | words(_name[last]) <> 1 then call fail('LL_FLOW_NAME: a variable name must be one nonempty word')
          ok = edge(_exit[value.id()],last)
        end
        when 'branch' then do
          condition = node.child(word(fields,1)); yes = node.child(word(fields,2))
          ok = edge(first,_entry[condition.id()]); decision = event(node,'branch')
          if decision = 0 then leave
          ok = edge(_exit[condition.id()],decision)
          last = event(node,'join')
          if last = 0 then leave
          ok = edge(decision,_entry[yes.id()],'true'); ok = edge(_exit[yes.id()],last)
          if node.count(word(fields,3)) = 1 then do
            no = node.child(word(fields,3)); ok = edge(decision,_entry[no.id()],'false'); ok = edge(_exit[no.id()],last)
          end
          else ok = edge(decision,last,'false')
        end
        otherwise do
          do f = 1 to words(fields)
            children = node.each(word(fields,f))
            do while children.next() & _error = ''
              child = children.node(); ok = edge(last,_entry[child.id()]); last = _exit[child.id()]
            end
            if children.error() <> '' then call fail(children.error())
          end
          finish = event(node,'leave')
          if finish = 0 then leave
          ok = edge(last,finish); last = finish
        end
      end
      _exit[id] = last
    end
    if walk.error() <> '' then call fail(walk.error())
    if _error = '' then _start = _entry[_root.id()]
    _sealed = 1; _building = 0
    return
  fail: method = .void
    arg message = .string
    if _error = '' then _error = message
    _start = 0
    return
  identity: method = .int
    return _identity
  reserve: method = .int
    if _sealed | _building = 0 then call fail('LL_FLOW_FROZEN: flow events are constructed only by the checked mapping')
    if _error <> '' then return 0
    if _entries >= _limit then do
      call fail('LL_RESOURCE_LIMIT: flow.entries limit=' || _limit || ' required=' || (_entries + 1)); return 0
    end
    _entries = _entries + 1
    return 1
  event: method = .int
    arg node = .llast..node, op = .string, name = ''
    if reserve() = 0 then return 0
    i = _node[0] + 1; _node[i] = node; _op[i] = op; _name[i] = name
    return i
  edge: method = .int
    arg from = .int, destination = .int, label = ''
    if reserve() = 0 then return 0
    if from < 1 | destination < 1 then do
      call fail('LL_FLOW_STRUCTURE: edge requires completed child flow'); return 0
    end
    i = _from[0] + 1; _from[i] = from; _destination[i] = destination; _label[i] = label
    _next[i] = _head[from]; _head[from] = i
    return i
  firstedge: method = .int
    arg point = .int
    call checkpoint(point)
    return _head[point]
  nextedge: method = .int
    arg link = .int
    call checkedge(link)
    return _next[link]
  error: method = .string
    call build()
    if initialized(_root) then do
      if _root.valid() = 0 then call fail('LL_AST_OWNER: flow tree has expired or been replaced')
    end
    return _error
  accepts: method = .int
    arg node = .llast..node
    if error() <> '' then return 0
    return _root.sameowner(node)
  before: method = .int
    arg node = .llast..node
    if accepts(node) = 0 then do
      call failaccess('LL_AST_OWNER: flow node belongs to another or expired tree'); return 0
    end
    return _entry[node.id()]
  points: method = .int
    if error() <> '' then return 0
    return _node[0]
  edges: method = .int
    if error() <> '' then return 0
    return _from[0]
  entries: method = .int
    if error() <> '' then return 0
    return _entries
  start: method = .int
    if error() <> '' then return 0
    return _start
  node: method = .llast..node
    arg point = .int
    call checkpoint(point)
    return _node[point]
  op: method = .string
    arg point = .int
    call checkpoint(point)
    return _op[point]
  name: method = .string
    arg point = .int
    call checkpoint(point)
    return _name[point]
  from: method = .int
    arg link = .int
    call checkedge(link)
    return _from[link]
  destination: method = .int
    arg link = .int
    call checkedge(link)
    return _destination[link]
  label: method = .string
    arg link = .int
    call checkedge(link)
    return _label[link]
  checkpoint: method = .void
    arg point = .int
    if error() <> '' then call failaccess(_error)
    if point < 1 | point > _node[0] then call failaccess('LL_FLOW_POINT: unknown flow point')
    return
  checkedge: method = .void
    arg link = .int
    if error() <> '' then call failaccess(_error)
    if link < 1 | link > _from[0] then call failaccess('LL_FLOW_EDGE: unknown flow edge')
    return
  definiteassignment: method = .result
    arg assigned = '', cells = 1000000, work = 10000000
    return .result(reference self,assigned,cells,work)

/** Forward may-unassigned analysis. A fact is published only at convergence.
 * Variable spelling is exact and case-sensitive. Entry names are space-separated.
 * An unsafe read is a diagnostic, distinct from failure to complete the analysis.
 */
result: class
  _graph = reference .graph
  _root = .llast..node
  _names = .string[]
  _unassigned = .binary
  _reach = .int[]
  _problems = .int[]
  _variables = .int
  _points = .int
  _error = .string
  _complete = .int
  _work = .int
  _limit = .int
  _identity = .int
  _graphidentity = .int
  _initial = .string
  _cells = .int
  _ran = .int
  *: factory
    arg owner = reference .graph, assigned = '', cells = 1000000, work = 10000000
    _identity = next_identity()
    _graph = owner; _initial = assigned; _cells = cells; _limit = work; _ran = 0; _complete = 0; _error = ''
    if <refvalid>(owner) = 0 then _error = 'LL_FLOW_OWNER: flow graph has expired'
    else do
      graph = dereference owner; _graphidentity = graph.identity()
    end
    return
  run: method = .void
    if _ran then return
    if _error <> '' then return
    _ran = 1; p = .int; v = .int; ok = .int
    owner = _graph; assigned = _initial; cells = _cells; work = _limit
    _graph = owner; _error = ''; _complete = 0; _work = 0; _limit = work
    if <refvalid>(owner) = 0 then do
      _error = 'LL_FLOW_OWNER: flow graph has expired'; return
    end
    graph = dereference owner
    if graph.identity() <> _graphidentity then do
      _error = 'LL_FLOW_OWNER: flow graph has been replaced'; return
    end
    if graph.error() <> '' then do
      _error = graph.error(); return
    end
    _points = graph.points(); _root = graph.node(graph.start())
    if cells < 0 | work < 0 then do
      _error = 'LL_FLOW_LIMIT: analysis.cells and analysis.work must be nonnegative'; return
    end
    do p = 1 to _points while _error = ''
      if graph.name(p) <> '' then ok = variable(graph.name(p),1)
    end
    do i = 1 to words(assigned) while _error = ''
      ok = variable(word(assigned,i),1)
    end
    if _error <> '' then return
    _variables = _names[0]
    if _points > cells / max(1,_variables) then do
      _error = 'LL_RESOURCE_LIMIT: analysis.cells limit=' || cells || ' required=' || _points || '*' || max(1,_variables); return
    end
    call binresize _unassigned,_points * max(1,_variables)
    first = graph.start(); _reach[first] = 1
    do v = 1 to _variables
      if wordpos(_names[v],assigned) = 0 then <at..u8>((first - 1) * _variables + v - 1) _unassigned = 1
    end
    /* A queued point is revisited only when reachability or a fact grows. */
    pending = .int[]; queued = .int[]; head = 1; tail = 1; pending[1] = first; queued[first] = 1
    do while head <= tail & _error = ''
      from = pending[head]; head = head + 1; queued[from] = 0
      killed = 0
      if graph.op(from) = 'write' then killed = variable(graph.name(from))
      e = graph.firstedge(from)
      do while e > 0 & _error = ''
        if charge() = 0 then leave
        destination = graph.destination(e); e = graph.nextedge(e); changed = _reach[destination] = 0; _reach[destination] = 1
        do v = 1 to _variables while _error = ''
          if charge() = 0 then leave
          if v = killed then iterate
          src = (from - 1) * _variables + v - 1; dst = (destination - 1) * _variables + v - 1
          if <at..u8>(src) _unassigned & <at..u8>(dst) _unassigned = 0 then do
            <at..u8>(dst) _unassigned = 1; changed = 1
          end
        end
        if changed & queued[destination] = 0 then do
          tail = tail + 1; pending[tail] = destination; queued[destination] = 1
        end
      end
    end
    if _error <> '' then return
    do p = 1 to _points
      if graph.op(p) <> 'read' | _reach[p] = 0 then iterate
      v = variable(graph.name(p))
      if _error <> '' then return
      if <at..u8>((p - 1) * _variables + v - 1) _unassigned then _problems[_problems[0] + 1] = p
    end
    _complete = 1
    return
  variable: method = .int
    arg name = .string, create = 0
    i = .int
    do i = 1 to _names[0]
      if _complete = 0 then do
        if charge() = 0 then return 0
      end
      if _names[i] == name then return i
    end
    if create then do
      if _complete then do
        _error = 'LL_FLOW_FROZEN: completed analysis cannot add variables'; return 0
      end
      i = _names[0] + 1; _names[i] = name; return i
    end
    return 0
  charge: method = .int
    if _work >= _limit then do
      _error = 'LL_RESOURCE_LIMIT: analysis.work limit=' || _limit || ' required=' || (_work + 1); return 0
    end
    _work = _work + 1
    return 1
  error: method = .string
    call run()
    if <refvalid>(_graph) = 0 then _error = 'LL_FLOW_OWNER: flow graph has expired'
    else if initialized(_root) then do
      graph = dereference _graph
      if graph.accepts(_root) = 0 | graph.identity() <> _graphidentity then _error = 'LL_FLOW_OWNER: flow graph or AST has been replaced'
    end
    return _error
  identity: method = .int
    return _identity
  ready: method = .void
    if error() <> '' then call failaccess(_error)
    if _complete = 0 then call failaccess('LL_FLOW_INCOMPLETE: analysis is not complete')
    return
  before: method = .state
    arg node = .llast..node
    call ready()
    graph = dereference _graph
    point = graph.before(node)
    return .state(reference self,point)
  assigned: method = .int
    arg point = .int, name = .string
    call ready()
    if point < 1 | point > _points then call failaccess('LL_FLOW_POINT: unknown flow point')
    if _reach[point] = 0 then return 0
    v = variable(name)
    if v = 0 then return 0
    return <at..u8>((point - 1) * _variables + v - 1) _unassigned = 0
  count: method = .int
    if error() <> '' | _complete = 0 then return 0
    return _problems[0]
  node: method = .llast..node
    arg diagnostic = .int
    call ready()
    if diagnostic < 1 | diagnostic > _problems[0] then call failaccess('LL_FLOW_DIAGNOSTIC: unknown diagnostic')
    graph = dereference _graph
    return graph.node(_problems[diagnostic])
  message: method = .string
    arg diagnostic = .int
    item = node(diagnostic); graph = dereference _graph
    return graph.name(_problems[diagnostic]) || ' may be read before it is assigned.'
  /** An actual entry-to-read witness, stopping propagation at assignments.
   * Branch edges on that path explain why the join could not prove assignment.
   */
  witness: method = .string
    arg diagnostic = .int, limit = 1000000
    e = .int; steps = 0
    targetitem = node(diagnostic); graph = dereference _graph
    target = _problems[diagnostic]; name = graph.name(target)
    previous = .int[]; seen = .int[]; pending = .int[]
    first = graph.start(); pending[1] = first; seen[first] = 1; head = 1; tail = 1
    do while head <= tail & seen[target] = 0 & _error = ''
      from = pending[head]; head = head + 1
      if graph.op(from) = 'write' & graph.name(from) == name then iterate
      e = graph.firstedge(from)
      do while e > 0
        if steps >= limit then do
          call failaccess('LL_RESOURCE_LIMIT: witness.work limit=' || limit || ' required=' || (steps + 1)); return ''
        end
        steps = steps + 1
        link = e; e = graph.nextedge(e); destination = graph.destination(link)
        if seen[destination] then iterate
        seen[destination] = 1; previous[destination] = link; tail = tail + 1; pending[tail] = destination
      end
    end
    if _error <> '' then do
      call failaccess(_error); return ''
    end
    result = ''; point = target
    do while point <> first
      e = previous[point]
      if e = 0 then call failaccess('LL_FLOW_WITNESS: diagnostic has no unassigned path')
      if graph.label(e) <> '' then do
        branch = graph.node(graph.from(e))
        result = 'Take the ' || graph.label(e) || ' branch of ' || branch.kind() || ' on line ' || branch.line() || '. ' || result
      end
      point = graph.from(e)
    end
    return 'From entry: ' || result || 'Reach this read without assigning ' || name || '.'
  work: method = .int
    return _work

/** Borrowed point view; keep the completed analysis alive. */
state: class
  _owner = reference .result
  _point = .int
  _identity = .int
  *: factory
    arg owner = reference .result, point = .int
    _owner = owner; _point = point
    result = dereference owner; _identity = result.identity()
    return
  assigned: method = .int
    arg name = .string
    if <refvalid>(_owner) = 0 then do
      call failaccess('LL_FLOW_OWNER: analysis has expired'); return 0
    end
    result = dereference _owner
    if result.identity() <> _identity then call failaccess('LL_FLOW_OWNER: analysis has been replaced')
    return result.assigned(_point,name)
