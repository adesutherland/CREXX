/* cREXX License (MIT). Application trees, field contracts and checked walks. */
options levelb
namespace llast expose schema storage tree node walk rewrite lowering draft analysis facts children damage
import rxfnsb
import llcore
import lltree
import lllimits
import llprepared

/* Direct Level B instruction keeps the bootstrap independent of exits. */
badfield: procedure = .void
  arg message = .string
  assembler signal "ERROR",message
  return

/* The reference identifies an owning variable; the serial identifies its
 * immutable contents. Reassigning that variable must not revive old facts. */
identities: initialiser expose ast_identity
  ast_identity = 0
  return
next_identity: procedure = .int expose ast_identity
  if ast_identity = 9223372036854775807 then do
    call badfield('LL_AST_IDENTITY: snapshot identities exhausted'); return 0
  end
  ast_identity = ast_identity + 1
  return ast_identity


findmapping: procedure = .int
  arg rules_ref = reference .string[], rule = .string
  if <refvalid>(rules_ref) = 0 then return 0
  rules = dereference rules_ref
  do i = 1 to rules[0]
    if rules[i] = lower(rule) then return i
  end
  return 0
mappingadmitted: procedure = .int
  arg rule = .string, kind = .string
  return rule <> '' & kind <> ''
firstkind: procedure = .int
  arg kinds_ref = reference .string[], kind = .string
  if <refvalid>(kinds_ref) = 0 then return 0
  kinds = dereference kinds_ref
  do i = 1 to kinds[0]
    if lower(kinds[i]) = lower(kind) then return i
  end
  return 0
findfield: procedure = .int
  arg owners_ref = reference .int[], fields_ref = reference .string[], owner = .int, name = .string
  if <refvalid>(owners_ref) = 0 | <refvalid>(fields_ref) = 0 then return 0
  owners = dereference owners_ref; fields = dereference fields_ref
  do i = 1 to fields[0]
    if owners[i] = owner & fields[i] = lower(name) then return i
  end
  return 0
fieldshape: procedure = .int
  arg owner = .int, name = .string, mode = .string, card = .string
  if owner = 0 | name = '' | wordpos(mode,'text capture operand') = 0 | wordpos(card,'one optional many some') = 0 then return 0
  if mode = 'text' & card <> 'one' then return -1
  return 1
/* Bound cold case folding/comparison without changing public lookup loops. */
schemawork: procedure = .int
  arg budget_ref = reference .llprepared..budget, kinds_ref = reference .string[], fields_ref = reference .string[], modes_ref = reference .string[], cards_ref = reference .string[]
  if <refvalid>(budget_ref) = 0 | <refvalid>(kinds_ref) = 0 | <refvalid>(fields_ref) = 0 | <refvalid>(modes_ref) = 0 | <refvalid>(cards_ref) = 0 then return 0
  budget = dereference budget_ref; kinds = dereference kinds_ref; fields = dereference fields_ref
  modes = dereference modes_ref; cards = dereference cards_ref; i = .int
  do i = 1 to kinds[0]
    if budget.take(kinds[0],1 + 4 * length(kinds[i])) = 0 then return 0
  end
  do i = 1 to fields[0]
    if budget.take(kinds[0],2 + 4 * (length(fields[i]) + length(modes[i]) + length(cards[i]))) = 0 then return 0
  end
  return 1

/* Preserve one ordered-field authority for public checks and bulk loading. */
schemaerror: procedure = .string
  arg rules_ref = reference .string[], kinds_ref = reference .string[], owners_ref = reference .int[], fields_ref = reference .string[], modes_ref = reference .string[], cards_ref = reference .string[], expose conflict = .int
  if <refvalid>(rules_ref) = 0 | <refvalid>(kinds_ref) = 0 | <refvalid>(owners_ref) = 0 | <refvalid>(fields_ref) = 0 | <refvalid>(modes_ref) = 0 | <refvalid>(cards_ref) = 0 then return 'LL_AST_SCHEMA: expired validation owner'
  rules = dereference rules_ref; kinds = dereference kinds_ref; owners = dereference owners_ref
  fields = dereference fields_ref; modes = dereference modes_ref; cards = dereference cards_ref
  do i = 1 to rules[0]
    first = firstkind(kinds_ref,kinds[i])
    if first = i then iterate
    a = 1; b = 1
    do forever
      do while a <= fields[0]
        if owners[a] = first then leave
        a = a + 1
      end
      do while b <= fields[0]
        if owners[b] = i then leave
        b = b + 1
      end
      if a > fields[0] & b > fields[0] then leave
      if a > fields[0] | b > fields[0] then do
        conflict = i
        return 'LL_AST_SCHEMA: conflicting fields for kind ' || kinds[i]
      end
      if fields[a] <> fields[b] | (modes[a] = 'text') <> (modes[b] = 'text') | cards[a] <> cards[b] then do
        conflict = i
        return 'LL_AST_SCHEMA: conflicting field ' || fields[b] || ' for kind ' || kinds[i]
      end
      a = a + 1; b = b + 1
    end
  end
  return ''

/** Declarative mappings. Field modes are text, capture, or operand; cardinality
 * is one, optional, many or some. Names are case-insensitive, kind spelling is
 * retained for display. No application expression executes in this schema. */
schema: class
  _rule = .string[]
  _kind = .string[]
  _owner = .int[]
  _field = .string[]
  _source = .string[]
  _mode = .string[]
  _card = .string[]
  _error = .string
  _conflict = .int
  *: factory
    _error = ''; _conflict = 0
    return
  mapping: method = .int
    arg rule = .string, kind = .string
    if mappingadmitted(rule,kind) = 0 | index(rule) > 0 then do
      _error = 'LL_AST_SCHEMA: invalid or duplicate mapping for ' || rule; return 0
    end
    slot = _rule[0] + 1; _rule[slot] = lower(rule); _kind[slot] = kind
    return slot
  field: method = .int
    arg rule = .string, name = .string, source = .string, mode = .string, card = .string
    owner = index(rule)
    admission = fieldshape(owner,name,mode,card)
    if admission = 0 then do
      _error = 'LL_AST_SCHEMA: invalid field ' || name || ' in ' || rule; return 0
    end
    if admission = -1 then do
      _error = 'LL_AST_SCHEMA: text field ' || name || ' requires one source'; return 0
    end
    do i = 1 to _field[0]
      if _owner[i] = owner & _field[i] = lower(name) then do
        _error = 'LL_AST_SCHEMA: duplicate field ' || name || ' in ' || rule; return 0
      end
    end
    slot = _field[0] + 1
    _owner[slot] = owner; _field[slot] = lower(name); _source[slot] = lower(source)
    _mode[slot] = mode; _card[slot] = card
    return slot
  index: method = .int
    arg rule = .string
    do i = 1 to _rule[0]
      if _rule[i] = lower(rule) then return i
    end
    return 0
  kindindex: method = .int
    arg kind = .string
    do i = 1 to _kind[0]
      if lower(_kind[i]) = lower(kind) then return i
    end
    return 0
  size: method = .int
    return _rule[0]
  fields: method = .int
    return _field[0]
  rule: method = .string
    arg i = .int
    return _rule[i]
  kind: method = .string
    arg i = .int
    return _kind[i]
  owner: method = .int
    arg i = .int
    return _owner[i]
  name: method = .string
    arg i = .int
    return _field[i]
  source: method = .string
    arg i = .int
    return _source[i]
  mode: method = .string
    arg i = .int
    return _mode[i]
  card: method = .string
    arg i = .int
    return _card[i]
  error: method = .string
    return _error
  conflict: method = .int
    return _conflict
  /** All mappings of one kind must describe the same ordered field contract. */
  check: method = .int
    conflict = _conflict
    problem = schemaerror(reference _rule,reference _kind,reference _owner,reference _field,reference _mode,reference _card,conflict)
    if problem <> '' then do; _error = problem; _conflict = conflict; end
    return _error = ''

  image: method = .binary
    arg budget_ref = reference .llprepared..budget
    empty = .binary; i = .int
    if _error <> '' then do; call llprepared..reject(3,_error); return empty; end
    if <refvalid>(budget_ref) = 0 then do; call llprepared..reject(3,'expired prepared storage budget'); return empty; end
    budget = dereference budget_ref
    if schemawork(budget_ref,reference _kind,reference _field,reference _mode,reference _card) = 0 then do; call llprepared..reject(4,budget.error()); return empty; end
    if check() = 0 then do; call llprepared..reject(3,_error); return empty; end
    out = .llprepared..writer(budget_ref)
    call out.raw('4c415354'x as .binary); call out.u32(1); call out.u32(_rule[0])
    do i = 1 to _rule[0]
      call out.text(_rule[i]); call out.text(_kind[i])
    end
    call out.u32(_field[0])
    do i = 1 to _field[0]
      call out.u32(_owner[i]); call out.text(_field[i]); call out.text(_source[i])
      call out.text(_mode[i]); call out.text(_card[i])
    end
    if out.status() <> 0 then do; call llprepared..reject(out.status(),out.error()); return empty; end
    return out.finish()

  /** Preserve raw kind spelling and normalized lookup names without setters. */
  loaded: factory
    arg data = .binary, budget_ref = reference .llprepared..budget
    _conflict = 0; _error = 'invalid prepared AST section'; i = .int
    input = .llprepared..reader(data,budget_ref)
    if input.expect('4c415354'x as .binary) = 0 then do
      _error = input.error(); call llprepared..reject(input.status(),_error); return
    end
    version = input.u32()
    if input.status() <> 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
    if version <> 1 then do; call llprepared..reject(3,_error); return; end
    count = input.u32()
    if input.status() <> 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
    if input.remaining() < 4 then do; call llprepared..reject(3,_error); return; end
    if count > (input.remaining() - 4) <idiv> 8 then do; call llprepared..reject(3,_error); return; end
    if input.claim(count,256) = 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
    rules = .string[]; kinds = .string[]
    owners = .int[]; fields = .string[]; sources = .string[]; modes = .string[]; cards = .string[]
    _error = ''
    do i = 1 to count
      rule = input.text(); kind = input.text()
      if input.status() <> 0 then leave
      if input.claim(i,1 + 4 * length(rule)) = 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
      if mappingadmitted(rule,kind) = 0 | lower(rule) \== rule | findmapping(reference rules,rule) > 0 then do
        _error = 'invalid prepared AST mapping'; leave
      end
      rules[i] = rule; kinds[i] = kind
    end
    if _error <> '' then do; call llprepared..reject(3,_error); return; end
    fieldcount = input.u32()
    if input.status() <> 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
    if fieldcount > input.remaining() <idiv> 20 then do; call llprepared..reject(3,_error); return; end
    if input.claim(fieldcount,256) = 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
    do i = 1 to fieldcount while _error = ''
      owner = input.u32(); name = input.text(); source = input.text(); mode = input.text(); card = input.text()
      if input.status() <> 0 then leave
      if input.claim(i,1 + 4 * length(name)) = 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
      if owner > count | fieldshape(owner,name,mode,card) <> 1 | lower(name) \== name | lower(source) \== source | findfield(reference owners,reference fields,owner,name) > 0 then do
        _error = 'invalid prepared AST field'; leave
      end
      owners[i] = owner; fields[i] = name; sources[i] = source; modes[i] = mode; cards[i] = card
    end
    if input.finish() = 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
    conflict = 0
    if _error = '' then do
      if schemawork(budget_ref,reference kinds,reference fields,reference modes,reference cards) = 0 then do
        work_budget = dereference budget_ref
        _error = work_budget.error(); call llprepared..reject(4,_error); return
      end
      _error = schemaerror(reference rules,reference kinds,reference owners,reference fields,reference modes,reference cards,conflict)
    end
    if _error <> '' then do; _conflict = conflict; call llprepared..reject(3,_error); return; end
    _rule = rules; _kind = kinds; _owner = owners; _field = fields
    _source = sources; _mode = modes; _card = cards
    return

/** Original-byte recovery records. A tree owns a value copy of these records.
 * The skipped interval and the narrower diagnostic range are kept separately.
 */
damage: class
  _first = .int[]
  _last = .int[]
  _offset = .int[]
  _finish = .int[]
  _message = .string[]
  _error = .string
  *: factory
    _error = ''
    return
  add: method = .int
    arg first = .int, last = .int, offset = .int, finish = .int, message = .string
    if _error <> '' then return 0
    if first < 0 | last < first | offset < first | finish < offset | finish > last | message = '' then do
      _error = 'LL_AST_ORIGIN: invalid recovery record'; return 0
    end
    i = _first[0] + 1
    _first[i] = first; _last[i] = last; _offset[i] = offset; _finish[i] = finish; _message[i] = message
    return 1
  check: method = .int
    arg extent = .int
    do i = 1 to _last[0]
      if _last[i] > extent then _error = 'LL_AST_ORIGIN: recovery range exceeds original source'
    end
    return _error = ''
  affects: method = .int
    arg first = .int, last = .int
    do i = 1 to _first[0]
      if first < _last[i] & last > _first[i] then return 1
      if first = last & first >= _first[i] & first < _last[i] then return 1
    end
    return 0
  size: method = .int
    return _first[0]
  first: method = .int
    arg i = .int
    return _first[i]
  last: method = .int
    arg i = .int
    return _last[i]
  offset: method = .int
    arg i = .int
    return _offset[i]
  finish: method = .int
    arg i = .int
    return _finish[i]
  message: method = .string
    arg i = .int
    return _message[i]
  error: method = .string
    return _error

/** Owned arena. Handles and cursors borrow this storage through explicit Level
 * B references; they never copy its arrays. New nodes may link only to earlier
 * nodes, making cycles impossible. The public tree freezes it after validation.
 * @param source Original bytes, retained even when a literal is rewritten.
 * @param contract Inferred node/field schema.
 * @param limit Maximum combined nodes, fields and child links.
 */
storage: class
  _identity = .int
  _source = .binary
  _damage = .llast..damage
  _schema = .llast..schema
  _limit = .int
  _entries = .int
  _frozen = .int
  _error = .string
  _root = .int
  _generation = .int
  _sealed = .int[]
  _rule = .int[]
  _start = .int[]
  _finish = .int[]
  _offset = .int[]
  _origin = .string[]
  _first = .int[]
  _last = .int[]
  _declaration = .int[]
  _text = .string[]
  _set = .int[]
  _head = .int[]
  _tail = .int[]
  _count = .int[]
  _child = .int[]
  _next = .int[]
  *: factory
    arg source = .binary, contract = .llast..schema, limit = 1000000, ?damage = .llast..damage
    _identity = next_identity()
    _source = source; _schema = contract; _limit = limit
    _entries = 0; _frozen = 0; _error = ''; _root = 0; _generation = 0
    if contract.check() = 0 then _error = contract.error()
    if ?damage = 0 then damage = .llast..damage()
    _damage = damage
    if _error = '' & _damage.check(<blen>(source)) = 0 then _error = _damage.error()
    _entries = _damage.size()
    if _error = '' & _entries > limit then _error = lllimits..describe('tree.entries',limit,_entries)
    return
  /** Immutable content identity; references separately identify the owner. */
  identity: method = .int
    return _identity
  fail: method = .void
    arg message = .string
    if _error = '' then _error = message
    return
  reserve: method = .int
    arg count = .int
    if _error <> '' then return 0
    if _frozen then do
      call fail('LL_AST_FROZEN: completed trees cannot be edited'); return 0
    end
    if count > _limit - _entries then do
      call fail(lllimits..describe('tree.entries',_limit,_entries + count)); return 0
    end
    _entries = _entries + count; return 1
  add: method = .int
    arg rule = .int, start = .int, finish = .int, origin = 'exact'
    i = .int
    extent = <blen>(_source)
    if rule < 1 | rule > _schema.size() | start < 0 | finish < start | finish > extent then do
      call fail('LL_AST_NODE: invalid node kind or source range'); return 0
    end
    if origin <> 'exact' & origin <> 'composite' & origin <> 'derived' & origin <> 'synthetic' & origin <> 'recovered' then do
      call fail('LL_AST_ORIGIN: unknown source origin ' || origin); return 0
    end
    if origin = 'synthetic' & start <> finish then do
      call fail('LL_AST_ORIGIN: synthetic nodes require a zero-width anchor'); return 0
    end
    if origin = 'recovered' & _damage.size() = 0 then do
      call fail('LL_AST_ORIGIN: recovered nodes require recovery records'); return 0
    end
    if _damage.affects(start,finish) then origin = 'recovered'
    fields = 0
    do i = 1 to _schema.fields()
      if _schema.owner(i) = rule then fields = fields + 1
    end
    if reserve(1 + fields) = 0 then return 0
    id = _rule[0] + 1; _rule[id] = rule; _start[id] = start; _finish[id] = finish; _offset[id] = start; _origin[id] = origin
    _first[id] = _declaration[0] + 1
    do i = 1 to _schema.fields()
      if _schema.owner(i) <> rule then iterate
      slot = _declaration[0] + 1; _declaration[slot] = i
      _text[slot] = ''; _set[slot] = 0; _head[slot] = 0; _tail[slot] = 0; _count[slot] = 0
    end
    _last[id] = _declaration[0]
    return id
  field: method = .int
    arg id = .int, name = .string
    if valid(id) = 0 then return 0
    do f = _first[id] to _last[id]
      if _schema.name(_declaration[f]) = lower(name) then return f
    end
    return 0
  generation: method = .int
    return _generation
  advance: method = .void
    _generation = _generation + 1
    return
  seal: method = .int
    arg id = .int
    if validate(id) = 0 then return 0
    _sealed[id] = 1; return 1
  editable: method = .int
    arg id = .int
    if reserve(0) = 0 then return 0
    if valid(id) = 0 then do
      call fail('LL_AST_NODE: invalid draft'); return 0
    end
    if _sealed[id] then do
      call fail('LL_AST_FROZEN: an accepted replacement cannot be edited'); return 0
    end
    return 1
  settext: method = .int
    arg id = .int, name = .string, value = .string
    if editable(id) = 0 then return 0
    f = field(id,name)
    if f = 0 then do
      call fail('LL_AST_FIELD: unknown field ' || name); return 0
    end
    if _schema.mode(_declaration[f]) <> 'text' then do
      call fail('LL_AST_FIELD: ' || name || ' is a child field'); return 0
    end
    _text[f] = value; _set[f] = 1; return 1
  append: method = .int
    arg id = .int, name = .string, child = .int
    if editable(id) = 0 then return 0
    f = field(id,name)
    if f = 0 then do
      call fail('LL_AST_FIELD: unknown field ' || name); return 0
    end
    if _schema.mode(_declaration[f]) = 'text' | child < 1 | child >= id then do
      call fail('LL_AST_CHILD: child must belong to this result and precede its parent'); return 0
    end
    if reserve(1) = 0 then return 0
    edge = _child[0] + 1; _child[edge] = child; _next[edge] = 0
    if _tail[f] > 0 then _next[_tail[f]] = edge
    else _head[f] = edge
    _tail[f] = edge; _count[f] = _count[f] + 1
    return 1
  validate: method = .int
    arg id = .int
    if valid(id) = 0 then do
      call fail('LL_AST_NODE: invalid node handle'); return 0
    end
    do f = _first[id] to _last[id]
      decl = _declaration[f]; count = _count[f]; card = _schema.card(decl)
      if _schema.mode(decl) = 'text' then count = _set[f]
      if (card = 'one' & count <> 1) | (card = 'optional' & count > 1) | (card = 'some' & count < 1) then do
        call fail('LL_AST_CARDINALITY: ' || kind(id) || '.' || _schema.name(decl) || ' requires ' || card || '; found ' || count || ' at byte ' || _start[id]); return 0
      end
    end
    return _error = ''
  freeze: method = .int
    arg root = .int
    if _error <> '' then return 0
    if valid(root) = 0 then do
      call fail('LL_AST_ROOT: mapping must produce exactly one root'); return 0
    end
    /* Only reachable nodes are results; obsolete rewrite intermediates are not
     * validated or traversed as though they belonged to the final tree. */
    pending = .int[]; seen = .int[]; top = 1; pending[top] = root
    do while top > 0 & _error = ''
      id = pending[top]; top = top - 1
      if seen[id] then do
        call fail('LL_AST_SHARED: each child must have one parent in the result tree'); return 0
      end
      seen[id] = 1
      if validate(id) = 0 then leave
      do f = _first[id] to _last[id]
        edge = _head[f]
        do while edge > 0
          top = top + 1; pending[top] = _child[edge]; edge = _next[edge]
        end
      end
    end
    if _error <> '' then return 0
    if _damage.size() > 0 then _origin[root] = 'recovered'
    _root = root; _frozen = 1; return 1
  valid: method = .int
    arg id = .int
    return id > 0 & id <= _rule[0]
  kind: method = .string
    arg id = .int
    if valid(id) = 0 then return ''
    return _schema.kind(_rule[id])
  text: method = .string
    arg id = .int, name = .string
    f = field(id,name)
    if f = 0 then do
      call badfield('LL_AST_FIELD: unknown field ' || name || ' on ' || kind(id)); return 0
    end
    if _schema.mode(_declaration[f]) <> 'text' then do
      call badfield('LL_AST_FIELD: ' || name || ' is a child field'); return 0
    end
    return _text[f]
  count: method = .int
    arg id = .int, name = .string
    f = field(id,name)
    if f = 0 then do
      call badfield('LL_AST_FIELD: unknown field ' || name || ' on ' || kind(id)); return 0
    end
    if _schema.mode(_declaration[f]) = 'text' then do
      call badfield('LL_AST_FIELD: ' || name || ' is a text field'); return 0
    end
    return _count[f]
  child: method = .int
    arg id = .int, name = .string, occurrence = 1
    f = field(id,name)
    if f = 0 then do
      call badfield('LL_AST_FIELD: unknown field ' || name || ' on ' || kind(id)); return 0
    end
    if _schema.mode(_declaration[f]) = 'text' then do
      call badfield('LL_AST_FIELD: ' || name || ' is a text field'); return 0
    end
    if occurrence < 1 then return 0
    edge = _head[f]
    do while edge > 0 & occurrence > 1
      edge = _next[edge]; occurrence = occurrence - 1
    end
    if edge = 0 then return 0
    return _child[edge]
  /** Flatten named child fields in declaration order, lists in source order. */
  children: method = .int
    arg id = .int
    count = 0
    if valid(id) = 0 then return 0
    do f = _first[id] to _last[id]
      count = count + _count[f]
    end
    return count
  childat: method = .int
    arg id = .int, occurrence = .int
    if valid(id) = 0 | occurrence < 1 then return 0
    do f = _first[id] to _last[id]
      if occurrence <= _count[f] then return child(id,_schema.name(_declaration[f]),occurrence)
      occurrence = occurrence - _count[f]
    end
    return 0
  isrecovered: method = .int
    return _damage.size() > 0
  damage: method = .llast..damage
    return _damage
  schema: method = .llast..schema
    return _schema
  contract: method = reference .llast..schema
    return reference _schema
  rule: method = .int
    arg id = .int
    return _rule[id]
  start: method = .int
    arg id = .int
    return _start[id]
  finish: method = .int
    arg id = .int
    return _finish[id]
  offset: method = .int
    arg id = .int
    return _offset[id]
  line: method = .int
    arg id = .int
    line = 1; previous = -1
    do at = 0 to _offset[id] - 1
      c = <at..u8>(at) _source
      if c = 13 | (c = 10 & previous <> 13) then line = line + 1
      previous = c
    end
    return line
  /** A replacement may retain an application's original diagnostic anchor. */
  locate: method = .int
    arg id = .int, offset = .int
    if reserve(0) = 0 then return 0
    if valid(id) = 0 then return 0
    if _sealed[id] then do
      call fail('LL_AST_FROZEN: accepted replacement cannot be edited'); return 0
    end
    if offset < _start[id] | offset > _finish[id] then do
      call fail('LL_AST_ORIGIN: diagnostic offset must lie within the node source range'); return 0
    end
    _offset[id] = offset
    return 1
  origin: method = .string
    arg id = .int
    return _origin[id]
  source: method = .binary
    return _source
  cover: method = .void
    arg id = .int, start = .int, finish = .int
    if reserve(0) = 0 then return
    extent = <blen>(_source)
    if valid(id) = 0 | start < 0 | start > _start[id] | finish < _finish[id] | finish > extent then do
      call fail('LL_AST_ORIGIN: invalid enclosing source range'); return
    end
    _start[id] = start; _finish[id] = finish; _origin[id] = 'composite'
    if _damage.affects(start,finish) then _origin[id] = 'recovered'
    return
  sourcetext: method = .string
    arg id = .int
    return binsubstr(_source,_start[id] + 1,_finish[id] - _start[id]) as .string
  root: method = .int
    return _root
  size: method = .int
    return _rule[0]
  entries: method = .int
    return _entries
  limit: method = .int
    return _limit
  firstfield: method = .int
    arg id = .int
    return _first[id]
  lastfield: method = .int
    arg id = .int
    return _last[id]
  declaration: method = .int
    arg f = .int
    return _declaration[f]
  firstedge: method = .int
    arg f = .int
    return _head[f]
  nextedge: method = .int
    arg edge = .int
    return _next[edge]
  edgechild: method = .int
    arg edge = .int
    return _child[edge]
  error: method = .string
    return _error

/** A small borrowed node handle. Keep the owning tree or rewrite pass alive.
 * @param owner Live arena reference; copying a handle does not copy the tree.
 * @param id Arena-local node number, never transferable to another arena.
 */
node: class
  _identity = .int
  _owner = reference .llast..storage
  _id = .int
  *: factory
    arg owner = reference .llast..storage, id = .int
    _owner = owner; _id = id
    input = dereference owner; _identity = input.identity()
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner
    current = owner.identity()
    return (_identity = current) & owner.valid(_id)
  kind: method = .string
    if valid() = 0 then call badfield('LL_AST_OWNER: node snapshot has expired or been replaced')
    owner = dereference _owner
    return owner.kind(_id)
  text: method = .string
    arg name = .string
    if valid() = 0 then call badfield('LL_AST_OWNER: node snapshot has expired or been replaced')
    owner = dereference _owner
    return owner.text(_id,name)
  count: method = .int
    arg name = .string
    if valid() = 0 then call badfield('LL_AST_OWNER: node snapshot has expired or been replaced')
    owner = dereference _owner
    return owner.count(_id,name)
  child: method = .llast..node
    arg name = .string, occurrence = 1
    if valid() = 0 then call badfield('LL_AST_OWNER: node snapshot has expired or been replaced')
    owner = dereference _owner
    return .llast..node(_owner,owner.child(_id,name,occurrence))
  /** All child fields in declaration order, for schema-independent algorithms. */
  children: method = .int
    if valid() = 0 then call badfield('LL_AST_OWNER: node snapshot has expired or been replaced')
    owner = dereference _owner
    return owner.children(_id)
  at: method = .llast..node
    arg occurrence = .int
    if valid() = 0 then call badfield('LL_AST_OWNER: node snapshot has expired or been replaced')
    owner = dereference _owner
    return .llast..node(_owner,owner.childat(_id,occurrence))
  /** A linear cursor over a named list, or all child fields when omitted. */
  each: method = .llast..children
    arg field = ''
    if valid() = 0 then call badfield('LL_AST_OWNER: node snapshot has expired or been replaced')
    return .llast..children(_owner,_id,field)
  start: method = .int
    if valid() = 0 then call badfield('LL_AST_OWNER: node snapshot has expired or been replaced')
    owner = dereference _owner
    return owner.start(_id)
  finish: method = .int
    if valid() = 0 then call badfield('LL_AST_OWNER: node snapshot has expired or been replaced')
    owner = dereference _owner
    return owner.finish(_id)
  offset: method = .int
    if valid() = 0 then call badfield('LL_AST_OWNER: node snapshot has expired or been replaced')
    owner = dereference _owner
    return owner.offset(_id)
  line: method = .int
    if valid() = 0 then call badfield('LL_AST_OWNER: node snapshot has expired or been replaced')
    owner = dereference _owner
    return owner.line(_id)
  origin: method = .string
    if valid() = 0 then call badfield('LL_AST_OWNER: node snapshot has expired or been replaced')
    owner = dereference _owner
    return owner.origin(_id)
  sourcetext: method = .string
    if valid() = 0 then call badfield('LL_AST_OWNER: node snapshot has expired or been replaced')
    owner = dereference _owner
    return owner.sourcetext(_id)
  id: method = .int
    return _id
  belongs: method = .int
    arg owner = reference .llast..storage
    return valid() & (_owner <refsame> owner)
  /** Compare borrowed snapshots without copying their owning arenas. */
  sameowner: method = .int
    arg other = .llast..node
    return valid() & other.belongs(_owner)

/** Linear child cursor. No list or owner is copied. */
children: class
  _owner = reference .llast..storage
  _identity = .int
  _field = .int
  _last = .int
  _edge = .int
  _current = .int
  _error = .string
  *: factory
    arg owner = reference .llast..storage, id = .int, field = ''
    _owner = owner; input = dereference owner; _identity = input.identity()
    _current = 0; _error = ''; _edge = 0
    _field = input.firstfield(id); _last = input.lastfield(id)
    if field <> '' then do
      _field = input.field(id,field); _last = _field
      if _field = 0 then do
        _error = 'LL_AST_FIELD: unknown child field ' || field; _last = -1
      end
      else do
        contract = dereference input.contract()
        if contract.mode(input.declaration(_field)) = 'text' then do
          _error = 'LL_AST_FIELD: ' || field || ' is a text field'; _last = -1
        end
      end
    end
    if _field <= _last then _edge = input.firstedge(_field)
    return
  next: method = .int
    if _error <> '' then return 0
    if <refvalid>(_owner) = 0 then do
      _error = 'LL_AST_OWNER: child cursor owner has expired'; return 0
    end
    input = dereference _owner
    if _identity <> input.identity() then do
      _error = 'LL_AST_OWNER: child cursor snapshot has been replaced'; return 0
    end
    _current = 0
    do while _edge = 0 & _field <= _last
      _field = _field + 1
      if _field <= _last then _edge = input.firstedge(_field)
    end
    if _edge = 0 then return 0
    _current = input.edgechild(_edge); _edge = input.nextedge(_edge)
    return 1
  node: method = .llast..node
    if <refvalid>(_owner) = 0 then call badfield('LL_AST_OWNER: cursor owner has expired')
    input = dereference _owner
    if input.identity() <> _identity then call badfield('LL_AST_OWNER: cursor snapshot has been replaced')
    return .llast..node(_owner,_current)
  error: method = .string
    return _error

/** Iterative traversal. Each edge is followed once; depth consumes an explicit
 * cursor stack rather than the Rexx call stack. The arena remains borrowed. */
walk: class
  _identity = .int
  _owner = reference .llast..storage
  _pending = .int[]
  _position = .int[]
  _edge = .int[]
  _top = .int
  _level = .int
  _current = .int
  _parents = .int
  _error = .string
  *: factory
    arg owner = reference .llast..storage, root = .int, order = 'children first'
    _owner = owner; input = dereference owner; _identity = input.identity()
    _current = 0; _level = 0; _error = ''; _top = 1
    _pending[1] = root; _position[1] = -1
    _parents = order = 'parents first'
    if order <> 'parents first' & order <> 'children first' then do
      _error = 'LL_AST_ORDER: use parents first or children first'; _top = 0
    end
    return
  next: method = .int
    if <refvalid>(_owner) = 0 then do
      _error = 'LL_AST_OWNER: walk snapshot has expired or been replaced'; return 0
    end
    owner = dereference _owner; identity = owner.identity()
    if (_identity = identity) = 0 then do
      _error = 'LL_AST_OWNER: walk snapshot has been replaced'; return 0
    end
    _current = 0
    do while _top > 0
      id = _pending[_top]
      if owner.valid(id) = 0 then do
        _error = 'LL_AST_NODE: invalid walk root'; _top = 0; return 0
      end
      if _position[_top] = -1 then do
        _position[_top] = owner.firstfield(id)
        _edge[_top] = 0
        if _position[_top] <= owner.lastfield(id) then _edge[_top] = owner.firstedge(_position[_top])
        if _parents then do
          _current = id; _level = _top - 1; return 1
        end
      end
      do while _position[_top] <= owner.lastfield(id) & _edge[_top] = 0
        _position[_top] = _position[_top] + 1
        if _position[_top] <= owner.lastfield(id) then _edge[_top] = owner.firstedge(_position[_top])
      end
      if _edge[_top] > 0 then do
        child = owner.edgechild(_edge[_top]); _edge[_top] = owner.nextedge(_edge[_top])
        _top = _top + 1; _pending[_top] = child; _position[_top] = -1
      end
      else do
        _top = _top - 1
        if _parents = 0 then do
          _current = id; _level = _top; return 1
        end
      end
    end
    return 0
  node: method = .llast..node
    if <refvalid>(_owner) = 0 then call badfield('LL_AST_OWNER: cursor owner has expired')
    input = dereference _owner
    if input.identity() <> _identity then call badfield('LL_AST_OWNER: cursor snapshot has been replaced')
    return .llast..node(_owner,_current)
  depth: method = .int
    return _level
  error: method = .string
    return _error

/* Shared strict/recovered projection; the result owns its source and metadata. */
project: procedure = .llast..storage
  arg source = .llcore..tree, root = .int, contract = .llast..schema, limit = .int, damage = .llast..damage
  ok = .int
  _store = .llast..storage(source.source(),contract,limit,damage)
  if _store.error() <> '' then return _store
  if contract.size() = 0 then do
    call _store.fail('LL_AST_SCHEMA: no then tree mappings were declared'); return _store
  end
  view = .lltree..view(source,root,limit)
  if view.error() <> '' then do
    call _store.fail(view.error()); return _store
  end
  raw = .int; lhs = .int; rhs = .int; current = .int; child = .int
  mapped = .int[]; counts = .int[]
  reachable = .int[]; pending = .int[]; top = 1; pending[top] = root
  do while top > 0
    raw = pending[top]; top = top - 1
    if reachable[raw] then iterate
    reachable[raw] = 1
    lhs = source.left(raw); rhs = source.right(raw)
    if lhs > 0 then do
      top = top + 1; pending[top] = lhs
    end
    if rhs > 0 then do
      top = top + 1; pending[top] = rhs
    end
  end
  /* Earlier-child source IDs permit a single bottom-up projection. A
   * transparent subtree keeps one ID and a saturated count, not a copied
   * list of all of its descendants. */
  do raw = 1 to source.size() while _store.error() = ''
    if reachable[raw] = 0 then iterate
    lhs = source.left(raw); rhs = source.right(raw)
    ca = 0; cb = 0; one = 0
    if lhs > 0 then do
      ca = counts[lhs]; one = mapped[lhs]
    end
    if rhs > 0 then do
      cb = counts[rhs]
      if ca = 0 then one = mapped[rhs]
    end
    rule = contract.index(source.label(raw))
    if rule = 0 then do
      counts[raw] = min(2,ca + cb); mapped[raw] = one
      if counts[raw] = 1 & source.label(raw) = 'group' then call _store.cover(one,source.start(raw),source.finish(raw))
      iterate
    end
    /* Parser derivations wrap binary productions differently. Read the
     * projected frontier in source order, stopping at mapped children, so
     * operand roles mean the same thing for Pratt, LR and Earley. */
    operands = .int[]; total = 0; top = 0
    if rhs > 0 then do
      top = top + 1; pending[top] = rhs
    end
    if lhs > 0 then do
      top = top + 1; pending[top] = lhs
    end
    do while top > 0 & total < 3
      current = pending[top]; top = top - 1
      if counts[current] = 0 then iterate
      if counts[current] = 1 then do
        total = total + 1; operands[total] = mapped[current]
      end
      else do
        child = source.right(current)
        if child > 0 then do
          top = top + 1; pending[top] = child
        end
        child = source.left(current)
        if child > 0 then do
          top = top + 1; pending[top] = child
        end
      end
    end
    created = _store.add(rule,source.start(raw),source.finish(raw))
    if created = 0 then leave
    do f = 1 to contract.fields() while _store.error() = ''
      if contract.owner(f) <> rule then iterate
      name = contract.name(f); selector = contract.source(f); mode = contract.mode(f)
      if mode = 'operand' then do
        chosen = 0
        select selector
          when 'left' then do
            if total = 2 then chosen = operands[1]
          end
          when 'right' then do
            if total = 2 then chosen = operands[2]
          end
          when 'inner' then do
            if total = 1 then chosen = operands[1]
          end
          otherwise nop
        end
        if chosen = 0 then call _store.fail('LL_AST_OPERAND: ' || source.label(raw) || '.' || selector || ' must produce one AST node at byte ' || source.start(raw))
        else ok = _store.append(created,name,chosen)
      end
      else if mode = 'text' & selector = '' then ok = _store.settext(created,name,view.text(raw))
      else do
        found = 0
        do c = 1 to view.count(raw) while _store.error() = ''
          capture = view.child(raw,c)
          if view.name(capture) <> '@field.' || selector then iterate
          found = found + 1
          if mode = 'text' then do
            if found > 1 then call _store.fail('LL_AST_CARDINALITY: text(' || selector || ') matched more than once at byte ' || source.start(raw))
            else ok = _store.settext(created,name,view.text(capture))
          end
          else if counts[capture] <> 1 then call _store.fail('LL_AST_CAPTURE: ' || selector || ' must produce one AST node at byte ' || source.start(capture))
          else ok = _store.append(created,name,mapped[capture])
        end
      end
    end
    ok = _store.validate(created)
    mapped[raw] = created; counts[raw] = 1
  end
  if _store.error() <> '' then return _store
  if counts[root] <> 1 then call _store.fail('LL_AST_ROOT: mapping must produce exactly one root')
  else ok = _store.freeze(mapped[root])
  return _store

/** Frozen application result. A parse request may be released after this tree
 * is constructed. Borrowed node/walk handles remain valid while this owning
 * value stays alive and is not replaced. Copying the tree is an explicit value
 * copy; obtaining nodes or walking does not copy its source or arrays. */
tree: class
  _store = .llast..storage
  *: factory
    arg source = .llcore..tree, root = .int, contract = .llast..schema, limit = 1000000
    _store = project(source,root,contract,limit,.llast..damage())
    return
  recovered: factory
    arg source = .llcore..tree, root = .int, contract = .llast..schema, damage = .llast..damage, limit = 1000000
    _store = project(source,root,contract,limit,damage)
    return
  loaded: factory
    arg store = .llast..storage
    _store = store
    return
  failed: factory
    arg message = .string
    _store = .llast..storage(''x as .binary,.llast..schema())
    call _store.fail(message)
    return
  status: method = .int
    if _store.error() = '' then return isrecovered()
    if left(_store.error(),18) = 'LL_RESOURCE_LIMIT:' then return 2
    return 3
  error: method = .string
    if _store.error() <> '' then return _store.error()
    if isrecovered() then return 'LL_AST_RECOVERED: input contains skipped damage; inspect diagnostics before use'
    return ''
  isrecovered: method = .int
    return _store.isrecovered()
  damage: method = .llast..damage
    return _store.damage()
  root: method = .llast..node
    return .llast..node(reference _store,_store.root())
  walk: method = .llast..walk
    arg order = 'children first'
    return .llast..walk(reference _store,_store.root(),order)
  rewrite: method = .llast..rewrite
    arg order = 'children first'
    return .llast..rewrite(reference _store,order)
  /** Translate into a declared target schema, visiting children first. */
  lower: method = .llast..lowering
    arg contract = .llast..schema, limit = 1000000
    return .llast..lowering(reference _store,contract,limit)
  /** One result per node, with completed children available before parents. */
  analyse: method = .llast..analysis
    arg limit = 1000000
    return .llast..analysis(reference _store,limit)
  source: method = .binary
    return _store.source()
  entries: method = .int
    return _store.entries()
  /** Immutable construction contract for checked analysis mappings. */
  contract: method = .llast..schema
    return _store.schema()

/** A mutable replacement under construction, confined to its owning pass.
 * @param owner Pass-owned arena; expired drafts are invalid references.
 * @param id Fresh replacement node.
 */
draft: class
  _owner = reference .llast..storage
  _id = .int
  _generation = .int
  *: factory
    arg owner = reference .llast..storage, id = .int
    _owner = owner; _id = id
    arena = dereference owner; _generation = arena.generation()
    return
  locate: method = .int
    arg offset = .int
    owner = dereference _owner
    if current() = 0 then return 0
    return owner.locate(_id,offset)
  settext: method = .int
    arg name = .string, value = .string
    owner = dereference _owner
    if current() = 0 then return 0
    return owner.settext(_id,name,value)
  append: method = .int
    arg name = .string, child = .llast..node
    owner = dereference _owner
    if current() = 0 then return 0
    if child.belongs(_owner) = 0 then do
      call owner.fail('LL_AST_OWNER: replacement child belongs to another tree or pass'); return 0
    end
    return owner.append(_id,name,child.id())
  current: method = .int
    owner = dereference _owner
    if _generation <> owner.generation() then do
      call owner.fail('LL_AST_LIFECYCLE: draft belongs to an earlier rewrite step'); return 0
    end
    return 1
  id: method = .int
    return _id
  belongs: method = .int
    arg owner = reference .llast..storage
    return _owner <refsame> owner

/** One children-first reconstruction. Current nodes already contain rewritten
 * children. New replacements are not revisited. The input is never mutated;
 * finish publishes a frozen result only after a complete successful traversal.
 */
rewrite: class
  _identity = .int
  _input = reference .llast..storage
  _output = .llast..storage
  _walk = .llast..walk
  _mapped = .int[]
  _raw = .int
  _current = .int
  _done = .int
  _finished = .int
  *: factory
    arg input = reference .llast..storage, order = 'children first'
    _input = input; owner = dereference input; _identity = owner.identity()
    _output = .llast..storage(owner.source(),owner.schema(),owner.limit(),owner.damage())
    _walk = .llast..walk(input,owner.root(),'children first')
    _raw = 0; _current = 0; _done = 0; _finished = 0
    if order <> 'children first' then call _output.fail('LL_AST_ORDER: rewrites require children first')
    if owner.error() <> '' then call _output.fail(owner.error())
    return
  next: method = .int
    if _finished | _done | _output.error() <> '' then return 0
    call _output.advance()
    if _walk.next() = 0 then do
      _done = 1
      if _walk.error() <> '' then call _output.fail(_walk.error())
      return 0
    end
    original = _walk.node(); _raw = original.id()
    owner = dereference _input; contract = dereference owner.contract()
    _current = _output.add(owner.rule(_raw),owner.start(_raw),owner.finish(_raw),owner.origin(_raw))
    if _current = 0 then return 0
    ok = _output.locate(_current,owner.offset(_raw))
    do f = owner.firstfield(_raw) to owner.lastfield(_raw) while _output.error() = ''
      decl = owner.declaration(f); name = contract.name(decl)
      if contract.mode(decl) = 'text' then ok = _output.settext(_current,name,owner.text(_raw,name))
      else do
        edge = owner.firstedge(f)
        do while edge > 0 & _output.error() = ''
          child = owner.edgechild(edge)
          ok = _output.append(_current,name,_mapped[child]); edge = owner.nextedge(edge)
        end
      end
    end
    _mapped[_raw] = _current
    return _output.error() = ''
  /** Input node corresponding to the current reconstructed node. */
  original: method = .llast..node
    if <refvalid>(_input) = 0 then call badfield('LL_AST_OWNER: rewrite input expired')
    owner = dereference _input
    if owner.identity() <> _identity then call badfield('LL_AST_OWNER: rewrite input replaced')
    return .llast..node(_input,_raw)
  node: method = .llast..node
    return .llast..node(reference _output,_current)
  make: method = .llast..draft
    arg kind = .string
    contract = dereference _output.contract()
    rule = contract.kindindex(kind); id = 0
    if _current = 0 | _done | _finished then call _output.fail('LL_AST_LIFECYCLE: make requires a current rewrite node')
    else if rule = 0 then call _output.fail('LL_AST_KIND: unknown replacement kind ' || kind)
    else id = _output.add(rule,_output.start(_current),_output.finish(_current),'derived')
    return .llast..draft(reference _output,id)
  /** Generate a node with no source spelling, anchored at an original byte. */
  synthetic: method = .llast..draft
    arg kind = .string, offset = .int
    id = 0; contract = dereference _output.contract(); rule = contract.kindindex(kind)
    if _current = 0 | _done | _finished then call _output.fail('LL_AST_LIFECYCLE: synthetic requires a current rewrite node')
    else if rule = 0 then call _output.fail('LL_AST_KIND: unknown replacement kind ' || kind)
    else id = _output.add(rule,offset,offset,'synthetic')
    return .llast..draft(reference _output,id)
  replace: method = .int
    arg replacement = .llast..draft
    if _current = 0 | _done | _finished then do
      call _output.fail('LL_AST_LIFECYCLE: replace requires a current rewrite node'); return 0
    end
    if replacement.belongs(reference _output) = 0 then do
      call _output.fail('LL_AST_OWNER: replacement belongs to another pass'); return 0
    end
    if replacement.current() = 0 then return 0
    id = replacement.id()
    if _output.seal(id) = 0 then return 0
    _mapped[_raw] = id; _current = id
    return 1
  finish: method = .llast..tree
    if _finished then return .llast..tree.failed('LL_AST_LIFECYCLE: rewrite already finished')
    _finished = 1
    call _output.advance()
    if _done = 0 then call _output.fail('LL_AST_LIFECYCLE: finish requires a complete walk')
    if _output.error() <> '' then return .llast..tree.failed(_output.error())
    if <refvalid>(_input) = 0 then return .llast..tree.failed('LL_AST_OWNER: rewrite input expired')
    owner = dereference _input
    if owner.identity() <> _identity then return .llast..tree.failed('LL_AST_OWNER: rewrite input replaced')
    ok = _output.freeze(_mapped[owner.root()])
    if ok = 0 then return .llast..tree.failed(_output.error())
    return .llast..tree.loaded(_output)
  error: method = .string
    return _output.error()

/** Children-first translation into a different schema. Each input node must
 * receive one replacement or an explicit keep(). Completed target children are
 * borrowed with translated(); finish publishes only a validated complete tree.
 * @param limit Combined output nodes, fields and child links, including drafts.
 */
lowering: class
  _input = reference .llast..storage
  _identity = .int
  _output = .llast..storage
  _walk = .llast..walk
  _mapped = .int[]
  _raw = .int
  _done = .int
  _finished = .int
  *: factory
    arg input = reference .llast..storage, contract = .llast..schema, limit = 1000000
    _input = input; owner = dereference input; _identity = owner.identity()
    _output = .llast..storage(owner.source(),contract,limit,owner.damage())
    _walk = .llast..walk(input,owner.root())
    _raw = 0; _done = 0; _finished = 0
    if owner.error() <> '' then call _output.fail(owner.error())
    if limit < 0 then call _output.fail('LL_AST_LIMIT: tree.entries must be nonnegative')
    return
  error: method = .string
    if <refvalid>(_input) = 0 then call _output.fail('LL_AST_OWNER: lowering input expired or replaced')
    else do
      owner = dereference _input
      if owner.identity() <> _identity then call _output.fail('LL_AST_OWNER: lowering input replaced')
    end
    return _output.error()
  active: method = .int
    if error() <> '' then return 0
    if _raw = 0 | _done | _finished then do
      call _output.fail('LL_AST_LIFECYCLE: operation requires a current lowering node'); return 0
    end
    return 1
  next: method = .int
    if error() <> '' | _done | _finished then return 0
    if _raw > 0 then do
      if _mapped[_raw] = 0 then do
        source = original()
        call _output.fail('LL_AST_LOWERING: missing translation for ' || source.kind() || ' at byte ' || source.offset()); return 0
      end
    end
    call _output.advance()
    if _walk.next() = 0 then do
      _done = 1
      if _walk.error() <> '' then call _output.fail(_walk.error())
      return 0
    end
    _raw = _walk.node().id()
    return 1
  original: method = .llast..node
    if active() = 0 then call badfield(_output.error())
    return .llast..node(_input,_raw)
  /** Obtain the completed output for an earlier visited input node. */
  translated: method = .llast..node
    arg source = .llast..node
    id = 0
    if active() then do
      if source.belongs(_input) = 0 then call _output.fail('LL_AST_OWNER: translated node belongs to another input')
      else do
        id = _mapped[source.id()]
        if id = 0 then call _output.fail('LL_AST_LOWERING: requested translation is not complete')
      end
    end
    if _output.error() <> '' then id = 0
    return .llast..node(reference _output,id)
  make: method = .llast..draft
    arg kind = .string
    id = 0
    if active() then do
      contract = dereference _output.contract(); rule = contract.kindindex(kind)
      if rule = 0 then call _output.fail('LL_AST_KIND: unknown target kind ' || kind)
      else do
        source = original()
        id = _output.add(rule,source.start(),source.finish(),'derived')
        if id > 0 then ok = _output.locate(id,source.offset())
      end
    end
    return .llast..draft(reference _output,id)
  /** Generate a target node with no source spelling at an original byte. */
  synthetic: method = .llast..draft
    arg kind = .string, offset = .int
    id = 0
    if active() then do
      contract = dereference _output.contract(); rule = contract.kindindex(kind)
      if rule = 0 then call _output.fail('LL_AST_KIND: unknown target kind ' || kind)
      else id = _output.add(rule,offset,offset,'synthetic')
    end
    return .llast..draft(reference _output,id)
  /** Seal an intermediate target node so another draft can use it as a child. */
  accept: method = .llast..node
    arg replacement = .llast..draft
    id = 0
    if active() then do
      if replacement.belongs(reference _output) = 0 then call _output.fail('LL_AST_OWNER: draft belongs to another pass')
      else if replacement.current() then do
        if _output.seal(replacement.id()) then id = replacement.id()
      end
    end
    return .llast..node(reference _output,id)
  replace: method = .int
    arg replacement = .llast..draft
    if active() = 0 then return 0
    if _mapped[_raw] <> 0 then do
      call _output.fail('LL_AST_LOWERING: current node already translated'); return 0
    end
    node = accept(replacement)
    if _output.error() <> '' then return 0
    _mapped[_raw] = node.id()
    return 1
  /** Preserve the current kind and field names using translated children. */
  keep: method = .int
    if active() = 0 then return 0
    if _mapped[_raw] <> 0 then do
      call _output.fail('LL_AST_LOWERING: current node already translated'); return 0
    end
    owner = dereference _input; source = original()
    contract = dereference _output.contract(); rule = contract.kindindex(source.kind())
    if rule = 0 then do
      call _output.fail('LL_AST_KIND: unknown target kind ' || source.kind()); return 0
    end
    id = _output.add(rule,source.start(),source.finish(),source.origin())
    if id = 0 then return 0
    ok = _output.locate(id,source.offset())
    originalschema = dereference owner.contract()
    do f = owner.firstfield(_raw) to owner.lastfield(_raw) while _output.error() = ''
      declaration = owner.declaration(f); name = originalschema.name(declaration)
      if originalschema.mode(declaration) = 'text' then ok = _output.settext(id,name,source.text(name))
      else do
        edge = owner.firstedge(f)
        do while edge > 0 & _output.error() = ''
          ok = _output.append(id,name,_mapped[owner.edgechild(edge)])
          edge = owner.nextedge(edge)
        end
      end
    end
    if _output.seal(id) = 0 then return 0
    _mapped[_raw] = id
    return 1
  finish: method = .llast..tree
    if _finished then return .llast..tree.failed('LL_AST_LIFECYCLE: lowering already finished')
    _finished = 1; call _output.advance()
    if _done = 0 then call _output.fail('LL_AST_LIFECYCLE: finish requires a complete lowering walk')
    if error() <> '' then return .llast..tree.failed(_output.error())
    owner = dereference _input
    if _output.freeze(_mapped[owner.root()]) = 0 then return .llast..tree.failed(_output.error())
    return .llast..tree.loaded(_output)

/** A completed table of application-defined node results. Values are objects;
 * the language application owns their types and meaning. The table borrows its
 * immutable input tree. Copying or rewriting a tree does not transfer its facts.
 */
facts: class
  _identity = .int
  _owner = reference .llast..storage
  _values = .object[]
  _present = .int[]
  _complete = .int
  _count = .int
  _error = .string
  *: factory
    arg owner = reference .llast..storage
    _owner = owner; input = dereference owner; _identity = input.identity()
    _complete = 0; _count = 0; _error = ''
    return
  fail: method = .void
    arg message = .string
    if _error = '' then _error = message
    return
  accepts: method = .int
    arg node = .llast..node
    if <refvalid>(_owner) = 0 then do
      call fail('LL_AST_OWNER: analysis tree has expired or been replaced'); return 0
    end
    input = dereference _owner; identity = input.identity()
    if (_identity = identity) = 0 then do
      call fail('LL_AST_OWNER: analysis tree has been replaced'); return 0
    end
    if node.belongs(_owner) = 0 | node.valid() = 0 then do
      call fail('LL_AST_OWNER: analysis node belongs to another tree'); return 0
    end
    return _error = ''
  /** Internal pass operation: each visited node has exactly one result. */
  record: method = .int
    arg node = .llast..node, value = .object
    if _complete then do
      call fail('LL_AST_LIFECYCLE: completed facts cannot be edited'); return 0
    end
    if accepts(node) = 0 then return 0
    id = node.id()
    if _present[id] then do
      call fail('LL_AST_DEPENDENCY: node already has an analysis result'); return 0
    end
    if initialized(value) = 0 then do
      call fail('LL_AST_FACT: analysis result must be an initialized object'); return 0
    end
    _values[id] = value; _present[id] = 1; _count = _count + 1
    return 1
  /** Internal dependency lookup: parents cannot read unfinished results. */
  dependency: method = .object
    arg node = .llast..node
    if accepts(node) then do
      if _present[node.id()] then return _values[node.id()]
      call fail('LL_AST_DEPENDENCY: result is not available; analyse children before parents')
    end
    call badfield(_error)
    none = .object; return none
  seal: method = .void
    _complete = 1
    return
  has: method = .int
    arg node = .llast..node
    if _complete = 0 | accepts(node) = 0 then return 0
    return _present[node.id()]
  get: method = .object
    arg node = .llast..node
    if _complete = 0 then call fail('LL_AST_LIFECYCLE: analysis result is incomplete')
    if _error <> '' then do
      call badfield(_error); none = .object; return none
    end
    return dependency(node)
  error: method = .string
    return _error
  size: method = .int
    if _complete = 0 | _error <> '' then return 0
    return _count

/** Finite children-first analysis. Record one object for each current node.
 * @param owner Immutable input storage, borrowed until the results are released.
 * @param limit Maximum visited nodes/results; does not bound callback allocation.
 * @return finish() publishes facts only after the entire traversal succeeds.
 */
analysis: class
  _facts = .llast..facts
  _walk = .llast..walk
  _current = .llast..node
  _active = .int
  _recorded = .int
  _done = .int
  _finished = .int
  _visits = .int
  _limit = .int
  *: factory
    arg owner = reference .llast..storage, limit = 1000000
    input = dereference owner
    _facts = .llast..facts(owner); _walk = .llast..walk(owner,input.root())
    _active = 0; _recorded = 0; _done = 0; _finished = 0; _visits = 0; _limit = limit
    if input.error() <> '' then call _facts.fail(input.error())
    if limit < 0 then call _facts.fail('LL_AST_LIMIT: analysis limit must be nonnegative')
    return
  next: method = .int
    if _finished | _done | _facts.error() <> '' then return 0
    if _active & _recorded = 0 then do
      call _facts.fail('LL_AST_FACT: current node has no analysis result'); return 0
    end
    if _walk.next() = 0 then do
      _done = 1; _active = 0
      if _walk.error() <> '' then call _facts.fail(_walk.error())
      return 0
    end
    if _visits >= _limit then do
      call _facts.fail('LL_RESOURCE_LIMIT: analysis.nodes limit=' || _limit || ' required=' || (_visits + 1)); return 0
    end
    _visits = _visits + 1; _current = _walk.node(); _active = 1; _recorded = 0
    return 1
  node: method = .llast..node
    return _current
  put: method = .int
    arg value = .object
    if _active = 0 | _finished then do
      call _facts.fail('LL_AST_LIFECYCLE: put requires a current analysis node'); return 0
    end
    _recorded = _facts.record(_current,value)
    return _recorded
  get: method = .object
    arg node = .llast..node
    return _facts.dependency(node)
  finish: method = .llast..facts
    if _finished then call _facts.fail('LL_AST_LIFECYCLE: analysis already finished')
    _finished = 1
    if _done = 0 then call _facts.fail('LL_AST_LIFECYCLE: finish requires a complete analysis')
    call _facts.seal()
    return _facts
  error: method = .string
    return _facts.error()
