/* cREXX License (MIT). Declared finite-state, bounded-lookahead token passes. */
options levelb
namespace llstage expose rules transducer
import rxfnsb
import llcore
import lllimits
import llprepared

admitted: procedure = .int
  arg state = .int, first = .int, second = .int, take = .int, unless = .int, emit = .int, next = .int
  return state >= 0 & first >= -1 & first <= 255 & second >= -1 & second <= 255 & take >= 1 & take <= 2 & unless >= -1 & unless <= 255 & emit >= -2 & emit <= 255 & next >= 1

/** First matching declaration wins. State 0 is a wildcard; tokens are 0..255.
 * @param initial Initial positive finite context.
 */
rules: class
  _limit = .int
  _initial = .int
  _count = .int
  _state = .int[]
  _first = .int[]
  _second = .int[]
  _take = .int[]
  _unless = .int[]
  _word = .string[]
  _emit = .int[]
  _next = .int[]
  _label = .string[]
  _error = .string
  _packed = .binary
  *: factory
    arg initial = 1, limit = 2147483647
    _limit = limit
    _initial = initial; _count = 0; _error = ''
    if initial < 1 then _error = 'initial context must be a positive integer'
    return
  add: method = .int
    arg name = .string, state = .int, first = .int, second = .int, take = .int, unless = .int, word = .string, emit = .int, next = .int
    if <blen>(_packed) > 0 then return llprepared..frozenmutation('token stage')
    if _count >= _limit then do
      _error = lllimits..describe('stage.rules',_limit,_count + 1); return 0
    end
    if admitted(state,first,second,take,unless,emit,next) = 0 then do
      _error = 'invalid finite-state token declaration ' || name; return 0
    end
    _count = _count + 1; _label[_count] = name; _state[_count] = state
    _first[_count] = first; _second[_count] = second; _take[_count] = take
    _unless[_count] = unless; _word[_count] = upper(word); _emit[_count] = emit; _next[_count] = next
    return 1
  choose: method = .int
    arg state = .int, first = .int, second = .int, text = .string, remaining = .int
    folded = upper(text); i = .int
    if <blen>(_packed) > 0 then do
      do i = 1 to _count
        at = 48 + (i - 1) * 72
        selected_state = <at..i64>(at) _packed
        if selected_state <> 0 & selected_state <> state then iterate
        selected_first = <at..i64>(at + 8) _packed
        if selected_first <> -1 & selected_first <> first then iterate
        selected_second = <at..i64>(at + 16) _packed
        if selected_second <> -1 & selected_second <> second then iterate
        selected_unless = <at..i64>(at + 32) _packed
        if selected_unless <> -1 & selected_unless = second then iterate
        if <at..i64>(at + 24) _packed > remaining then iterate
        word_first = <at..u32>(at + 64) _packed; word_length = <at..u32>(at + 68) _packed
        if word_length > 0 then do
          if llprepared..packedtext(reference _packed,word_first,word_length) <> folded then iterate
        end
        return i
      end
      return 0
    end
    do i = 1 to _count
      if _state[i] <> 0 & _state[i] <> state then iterate
      if _first[i] <> -1 & _first[i] <> first then iterate
      if _second[i] <> -1 & _second[i] <> second then iterate
      if _unless[i] <> -1 & _unless[i] = second then iterate
      if _take[i] > remaining then iterate
      if _word[i] <> '' & _word[i] <> folded then iterate
      return i
    end
    return 0
  initial: method = .int
    return _initial
  count: method = .int
    return _count
  take: method = .int
    arg rule = .int
    if <blen>(_packed) > 0 then do
      if rule < 1 | rule > _count then return 0
      return <at..i64>(48 + (rule - 1) * 72 + 24) _packed
    end
    return _take[rule]
  emit: method = .int
    arg rule = .int
    if <blen>(_packed) > 0 then do
      if rule < 1 | rule > _count then return 0
      return <at..i64>(48 + (rule - 1) * 72 + 40) _packed
    end
    return _emit[rule]
  next: method = .int
    arg rule = .int
    if <blen>(_packed) > 0 then do
      if rule < 1 | rule > _count then return 0
      return <at..i64>(48 + (rule - 1) * 72 + 48) _packed
    end
    return _next[rule]
  label: method = .string
    arg rule = .int
    if <blen>(_packed) > 0 then do
      if rule < 1 | rule > _count then return ''
      at = 48 + (rule - 1) * 72 + 56
      first = <at..u32>(at) _packed; length = <at..u32>(at + 4) _packed
      return llprepared..packedtext(reference _packed,first,length)
    end
    return _label[rule]
  error: method = .string
    return _error

  field: method = .int
    arg rule = .int, field = .string
    if <blen>(_packed) > 0 then do
      if rule < 1 | rule > _count then return 0
      at = 48 + (rule - 1) * 72
      select field
        when 'state' then return <at..i64>(at) _packed
        when 'first' then return <at..i64>(at + 8) _packed
        when 'second' then return <at..i64>(at + 16) _packed
        when 'unless' then return <at..i64>(at + 32) _packed
        otherwise return 0
      end
    end
    select field
      when 'state' then return _state[rule]
      when 'first' then return _first[rule]
      when 'second' then return _second[rule]
      when 'unless' then return _unless[rule]
      otherwise return 0
    end
    return 0
  word: method = .string
    arg rule = .int
    if <blen>(_packed) > 0 then do
      if rule < 1 | rule > _count then return ''
      at = 48 + (rule - 1) * 72 + 64
      first = <at..u32>(at) _packed; length = <at..u32>(at + 4) _packed
      return llprepared..packedtext(reference _packed,first,length)
    end
    return _word[rule]

  /** Prepared declarations preserve first-match order and the mutation budget. */
  image: method = .binary
    arg budget_ref = reference .llprepared..budget
    empty = .binary
    if _error <> '' then do; call llprepared..reject(3,_error); return empty; end
    out = .llprepared..writer(budget_ref)
    call out.raw('4c535447'x as .binary); call out.u32(1)
    call out.i64(_initial); call out.i64(_limit); call out.u32(_count)
    do i = 1 to _count
      call out.text(label(i)); call out.i64(field(i,'state')); call out.i64(field(i,'first')); call out.i64(field(i,'second'))
      call out.i64(take(i)); call out.i64(field(i,'unless')); call out.text(word(i))
      call out.i64(emit(i)); call out.i64(next(i))
    end
    if out.status() <> 0 then do; call llprepared..reject(out.status(),out.error()); return empty; end
    return out.finish()

  /** Encode fixed read-ready rows at build time; mutable construction stays separate. */
  frozenimage: method = .binary
    arg budget_ref = reference .llprepared..budget
    empty = .binary; i = .int
    if _error <> '' then do; call llprepared..reject(3,_error); return empty; end
    budget = dereference budget_ref
    if <blen>(_packed) > 0 then do
      if budget.take(<blen>(_packed)) = 0 then do; call llprepared..reject(4,budget.error()); return empty; end
      return _packed
    end
    if _count > (4294967295 - 48) <idiv> 72 then do; call llprepared..reject(4,'frozen stage extent'); return empty; end
    base = 48 + _count * 72
    if budget.take(base) = 0 then do; call llprepared..reject(4,budget.error()); return empty; end
    rows = .binary; call binresize rows,base
    <at..u32>(0) rows = 0x47545346; <at..u32>(4) rows = 1; <at..u32>(8) rows = _count
    <at..u32>(16) rows = 48; <at..u32>(28) rows = base
    <at..i64>(32) rows = _initial; <at..i64>(40) rows = _limit
    pool = .llprepared..writer(budget_ref); cursor = base
    do i = 1 to _count
      at = 48 + (i - 1) * 72
      <at..i64>(at) rows = _state[i]; <at..i64>(at + 8) rows = _first[i]
      <at..i64>(at + 16) rows = _second[i]; <at..i64>(at + 24) rows = _take[i]
      <at..i64>(at + 32) rows = _unless[i]; <at..i64>(at + 40) rows = _emit[i]; <at..i64>(at + 48) rows = _next[i]
      label_bytes = _label[i] as .binary; length = <blen>(label_bytes)
      if length > 4294967295 - cursor then do; call llprepared..reject(4,'frozen stage label extent'); return empty; end
      <at..u32>(at + 56) rows = cursor; <at..u32>(at + 60) rows = length
      call pool.raw(label_bytes); cursor = cursor + length
      word_bytes = _word[i] as .binary; length = <blen>(word_bytes)
      if length > 4294967295 - cursor then do; call llprepared..reject(4,'frozen stage word extent'); return empty; end
      <at..u32>(at + 64) rows = cursor; <at..u32>(at + 68) rows = length
      call pool.raw(word_bytes); cursor = cursor + length
    end
    output = .llprepared..writer(budget_ref); call output.raw(rows); call output.raw(pool.finish())
    if pool.status() <> 0 then do; call llprepared..reject(pool.status(),pool.error()); return empty; end
    if output.status() <> 0 then do; call llprepared..reject(output.status(),output.error()); return empty; end
    return output.finish()

  /** Trusted range ownership only: no row decoder or state/index construction. */
  compiled: factory
    arg source_ref = reference .binary, first = .int, extent = .int
    source = dereference source_ref
    call binresize _packed,extent
    assembler bcopy _packed,source,first
    _count = <at..u32>(8) _packed; _initial = <at..i64>(32) _packed; _limit = <at..i64>(40) _packed; _error = ''
    return

  /** No public setters are replayed and no reader/budget reference is retained. */
  loaded: factory
    arg data = .binary, budget_ref = reference .llprepared..budget
    _initial = 1; _limit = 0; _count = 0; _error = 'invalid prepared token stage'
    input = .llprepared..reader(data,budget_ref)
    if input.expect('4c535447'x as .binary) = 0 then do
      _error = input.error(); call llprepared..reject(input.status(),_error); return
    end
    version = input.u32(); initial = input.i64(); limit = input.i64(); count = input.u32()
    if input.status() <> 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
    if version <> 1 | initial < 1 | (count > 0 & count > limit) then do
      call llprepared..reject(3,_error); return
    end
    if count > input.remaining() <idiv> 64 then do; call llprepared..reject(3,_error); return; end
    if input.claim(count,256) = 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
    labels = .string[]; states = .int[]; firsts = .int[]; seconds = .int[]
    takes = .int[]; unlesses = .int[]; words = .string[]; emits = .int[]; nexts = .int[]
    _error = ''
    do i = 1 to count
      label = input.text(); state = input.i64(); first = input.i64(); second = input.i64()
      take = input.i64(); unless = input.i64(); word = input.text(); emit = input.i64(); next = input.i64()
      if input.status() <> 0 then leave
      if admitted(state,first,second,take,unless,emit,next) = 0 | upper(word) \== word then do
        _error = 'invalid prepared token declaration'; leave
      end
      labels[i] = label; states[i] = state; firsts[i] = first; seconds[i] = second
      takes[i] = take; unlesses[i] = unless; words[i] = word; emits[i] = emit; nexts[i] = next
    end
    if input.finish() = 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
    if _error <> '' then do; call llprepared..reject(3,_error); return; end
    _label = labels; _state = states; _first = firsts; _second = seconds
    _take = takes; _unless = unlesses; _word = words; _emit = emits; _next = nexts
    _initial = initial; _limit = limit; _count = count
    return

/** Output spans refer to original source, even when two tokens are merged.
 * Deleted trivia remains available in source(). Origins are input token indexes.
 * A context is request-owned; no memo can leak between differently staged input.
 */
transducer: class
  _rules = .rules
  _input = .llcore..stream
  _out = .llcore..stream
  _first = .int[]
  _last = .int[]
  _selected = .int[]
  _fuel = .int
  _work = .int
  _ran = .int
  _status = .int
  _error = .string
  *: factory
    arg declarations = .rules, input = .llcore..stream, fuel = 1000000
    _rules = declarations; _input = input; _out = .llcore..stream.tokens(input.source())
    _fuel = fuel; _work = 0; _ran = 0; _status = 0; _error = ''
    return
  run: method = .int
    if _ran then return _status
    _ran = 1
    if _rules.error() <> '' | _input.error() <> '' then do
      _status = 3; _error = _rules.error() || _input.error(); return _status
    end
    at = 0; state = _rules.initial(); source = _input.source(); token = .binary
    do while at < _input.size()
      _work = _work + _rules.count() + _input.finish(at + 1) - _input.start(at)
      if _work > _fuel then do
        _status = 2; _error = lllimits..describe('parse.work',_fuel,_work); return _status
      end
      token = binsubstr(source,_input.start(at) + 1,_input.finish(at + 1) - _input.start(at))
      /* Keyword comparison is deliberately ASCII-only. Other bytes copy through. */
      ascii = 1
      do i = 0 to <blen>(token) - 1
        if <at..u8>(i) token > 127 then ascii = 0
      end
      text = ''
      if ascii then text = token as .string
      selected = _rules.choose(state,_input.symbol(at),_input.symbol(at + 1),text,_input.size() - at)
      take = 1; emit = -1
      if selected > 0 then do
        take = _rules.take(selected); emit = _rules.emit(selected); state = _rules.next(selected)
      end
      if emit <> -2 then do
        if emit = -1 then emit = _input.symbol(at)
        ok = _out.append(emit,_input.start(at),_input.finish(at + take))
        if ok = 0 then do
          _status = 3; _error = _out.error(); return _status
        end
        n = _out.size(); _first[n] = at; _last[n] = at + take; _selected[n] = selected
      end
      at = at + take
    end
    return _status
  output: method = .llcore..stream
    return _out
  first: method = .int
    arg position = .int
    return _first[position + 1]
  last: method = .int
    arg position = .int
    return _last[position + 1]
  selected: method = .int
    arg position = .int
    return _selected[position + 1]
  work: method = .int
    return _work
  error: method = .string
    return _error
