/* cREXX License (MIT). General language-tooling research infrastructure. */
options levelb
namespace llcore expose grammar stream tree
import rxfnsb
import llprepared

/** A revisioned grammar graph, independent of a parsing engine.
 * @param profile Declared recognition semantics: ordered, contextfree, pika or squirrel.
 */
grammar: class
  _profile = .string
  _size = .int
  _revision = .int
  _op = .int[]
  _a = .int[]
  _b = .int[]
  _label = .string[]
  _line = .int[]
  _text = .binary[]
  _records = .binary
  _texts = .binary
  _signature = .string
  _frozen = .binary
  _frozenrows = .int
  _frozentext = .int

  *: factory
    arg profile = .string
    _profile = profile; _size = 0; _revision = 1; _signature = ''
    return

  /** Owner-local prepared rows. Semantic grammar admission remains llcheck's. */
  prepared: factory
    arg data = .binary, budget_ref = reference .llprepared..budget
    _size = 0; _revision = 1; _profile = ''; _signature = ''
    decoded = .llprepared..reader(data,budget_ref)
    ok = decoded.expect('4c47524d'x as .binary); version = decoded.u32()
    revision = decoded.i64(); count = decoded.count(0); profile = decoded.text()
    if decoded.status() <> 0 then do
      call llprepared..reject(decoded.status(),decoded.error()); return
    end
    if version <> 1 | revision < 1 then do
      call llprepared..reject(3,'invalid grammar version/revision'); return
    end
    records = decoded.binary(); texts = decoded.binary()
    if decoded.finish() = 0 then do
      call llprepared..reject(decoded.status(),decoded.error()); return
    end
    record_extent = <blen>(records); text_extent = <blen>(texts)
    if count > record_extent <idiv> 48 then do
      call llprepared..reject(3,'grammar row count exceeds section'); return
    end
    if record_extent <> count * 48 then do
      call llprepared..reject(3,'grammar row extent mismatch'); return
    end
    cursor = 0; label = .string
    do row = 0 to count - 1
      at = row * 48
      first = <at..u32>(at + 32) records; size = <at..u32>(at + 36) records
      if first <> cursor | size > text_extent - cursor then do
        call llprepared..reject(3,'invalid grammar label range'); return
      end
      if decoded.claim(size,4) = 0 then do
        call llprepared..reject(decoded.status(),decoded.error()); return
      end
      do
        label = (<at..binary>(first,size) texts) as .string
        if length(label) > size then do
          call llprepared..reject(3,'invalid grammar label extent'); return
        end
      on signal unicode_error
        call llprepared..reject(3,'invalid UTF8 grammar label'); return
      end
      cursor = cursor + size
      first = <at..u32>(at + 40) records; size = <at..u32>(at + 44) records
      if first <> cursor | size > text_extent - cursor then do
        call llprepared..reject(3,'invalid grammar literal range'); return
      end
      cursor = cursor + size
    end
    if cursor <> text_extent then do
      call llprepared..reject(3,'trailing grammar text bytes'); return
    end
    _profile = profile; _revision = revision; _size = count
    _records = records; _texts = texts
    return

  /** Trusted generated rows and canonical text, with no grammar walk. */
  compiled: factory
    arg source_ref = reference .binary, first = .int, extent = .int
    source = dereference source_ref
    call binresize _frozen,extent
    assembler bcopy _frozen,source,first
    _size = <at..u32>(8) _frozen; _revision = <at..i64>(40) _frozen
    _frozenrows = <at..u32>(12) _frozen; _frozentext = <at..u32>(16) _frozen
    _signature = ''
    return

  /** Build-time checked wire export plus direct row/pool/signature offsets. */
  frozenimage: method = .binary
    arg budget_ref = reference .llprepared..budget
    absent = .binary
    wire = image(budget_ref)
    if <blen>(wire) < 24 then return absent
    signature_bytes = signature() as .binary
    profile_bytes = <at..u32>(20) wire
    records_at = 48 + 28 + profile_bytes
    texts_at = records_at + _size * 48 + 4
    signature_at = 48 + <blen>(wire)
    output = .llprepared..writer(budget_ref)
    call output.raw('4647524d'x as .binary); call output.u32(1); call output.u32(_size)
    call output.u32(records_at); call output.u32(texts_at)
    call output.u32(72); call output.u32(profile_bytes)
    call output.u32(signature_at); call output.u32(<blen>(signature_bytes)); call output.u32(0)
    call output.i64(_revision); call output.raw(wire); call output.raw(signature_bytes)
    if output.status() <> 0 then do; call llprepared..reject(output.status(),output.error()); return absent; end
    return output.finish()

  /** Serialize raw labels/operands, never the display fallback or normalized IDs. */
  image: method = .binary
    arg budget_ref = reference .llprepared..budget
    output = .llprepared..writer(budget_ref)
    rows = .llprepared..writer(budget_ref); texts = .llprepared..writer(budget_ref)
    cursor = 0
    do node = 1 to _size
      call rows.i64(op(node)); call rows.i64(left(node)); call rows.i64(right(node)); call rows.i64(line(node))
      label = rawlabel(node) as .binary; value = text(node)
      call rows.u32(cursor); call rows.u32(<blen>(label)); call texts.raw(label)
      cursor = cursor + <blen>(label)
      call rows.u32(cursor); call rows.u32(<blen>(value)); call texts.raw(value)
      cursor = cursor + <blen>(value)
    end
    call output.raw('4c47524d'x as .binary); call output.u32(1)
    call output.i64(_revision); call output.u32(_size); call output.text(profile())
    call output.binary(rows.finish()); call output.binary(texts.finish())
    absent = .binary
    if rows.status() <> 0 then do; call llprepared..reject(rows.status(),rows.error()); return absent; end
    if texts.status() <> 0 then do; call llprepared..reject(texts.status(),texts.error()); return absent; end
    if output.status() <> 0 then do; call llprepared..reject(output.status(),output.error()); return absent; end
    return output.finish()

  /** A mutation materializes this owned value only; no shared writable base. */
  materialize: method = .void
    if <blen>(_frozen) > 0 then do; call llprepared..frozenmutation('grammar'); return; end
    if <blen>(_records) = 0 then return
    do node = 1 to _size
      _op[node] = op(node); _a[node] = left(node); _b[node] = right(node)
      _label[node] = rawlabel(node); _line[node] = line(node); _text[node] = text(node)
    end
    empty = .binary; _records = empty; _texts = empty
    return

  rawlabel: method = .string
    arg node = .int
    first = .int
    if <blen>(_frozen) > 0 then do
      if node < 1 | node > _size then return ''
      row = _frozenrows + (node - 1) * 48
      first = _frozentext + <at..u32>(row + 32) _frozen; size = <at..u32>(row + 36) _frozen
      return llprepared..packedtext(reference _frozen,first,size)
    end
    if <blen>(_records) = 0 then return _label[node]
    if node < 1 | node > _size then return ''
    at = (node - 1) * 48
    first = <at..u32>(at + 32) _records; length = <at..u32>(at + 36) _records
    return (<at..binary>(first,length) _texts) as .string

  /** Append a clause. Handles are stable, one based; mutations invalidate analyses. */
  add: method = .int
    arg op = .int, a = .int, b = .int, label = .string, line = .int
    if <blen>(_frozen) > 0 then return llprepared..frozenmutation('grammar')
    call materialize
    _signature = ''
    _size = _size + 1
    _op[_size] = op; _a[_size] = a; _b[_size] = b
    _label[_size] = label; _line[_size] = line
    _revision = _revision + 1
    return _size

  /** Resolve a rule wrapper after forward references have been constructed. */
  body: method = .int
    arg rule = .int, target = .int
    if <blen>(_frozen) > 0 then return llprepared..frozenmutation('grammar')
    if rule < 1 | rule > _size then return 0
    if op(rule) <> 5 then return 0
    if target < 1 | target > _size then return 0
    call materialize
    _signature = ''
    _a[rule] = target; _revision = _revision + 1
    return 1

  literal: method = .int
    arg text = .binary, label = .string, line = .int
    if <blen>(_frozen) > 0 then return llprepared..frozenmutation('grammar')
    node = add(13,0,0,label,line)
    _text[node] = text
    return node
  characters: method = .int
    arg members = .binary, inverted = .int, label = .string, line = .int
    if <blen>(_frozen) > 0 then return llprepared..frozenmutation('grammar')
    node = add(16,inverted,0,label,line)
    _text[node] = members
    return node
  text: method = .binary
    arg node = .int
    first = .int
    if <blen>(_frozen) > 0 then do
      absent = .binary
      if node < 1 | node > _size then return absent
      row = _frozenrows + (node - 1) * 48
      first = _frozentext + <at..u32>(row + 40) _frozen; size = <at..u32>(row + 44) _frozen
      return llprepared..packedbytes(reference _frozen,first,size)
    end
    if <blen>(_records) = 0 then return _text[node]
    bits = .binary
    if node < 1 | node > _size then return bits
    at = (node - 1) * 48
    first = <at..u32>(at + 40) _records; length = <at..u32>(at + 44) _records
    call binresize bits,length
    assembler bcopy bits,_texts,first
    return bits
  contains: method = .int
    arg node = .int, symbol = .int
    if symbol < 0 | symbol > 255 then return 0
    members = .binary; inverted = .int; found = 0
    if <blen>(_frozen) > 0 then do
      members = text(node); inverted = left(node)
    end
    else if <blen>(_records) = 0 then do
      members = _text[node]; inverted = _a[node]
    end
    else do
      members = text(node); inverted = left(node)
    end
    do i = 0 to <blen>(members) - 1
      if <at..u8>(i) members = symbol then found = 1
    end
    if inverted then return found = 0
    return found

  size: method = .int
    return _size
  revision: method = .int
    return _revision
  profile: method = .string
    if <blen>(_frozen) > 0 then do
      first = <at..u32>(20) _frozen; size = <at..u32>(24) _frozen
      return llprepared..packedtext(reference _frozen,first,size)
    end
    return _profile
  /** Reachability is structural, independent of parser implementation. */
  reachable: method = .int[]
    arg root = .int
    seen = .int[]; pending = .int[]; pending[1] = root; count = 1
    do while count > 0
      node = pending[count]; count = count - 1
      if node < 1 | node > _size then iterate
      if seen[node] then iterate
      seen[node] = 1
      operation = .int; lhs = .int; rhs = .int
      if <blen>(_frozen) > 0 then do
        operation = op(node); lhs = left(node); rhs = right(node)
      end
      else if <blen>(_records) = 0 then do
        operation = _op[node]; lhs = _a[node]; rhs = _b[node]
      end
      else do
        at = (node - 1) * 48
        operation = <at..i64>(at) _records
        lhs = <at..i64>(at + 8) _records; rhs = <at..i64>(at + 16) _records
      end
      if operation = 2 | operation = 3 | operation = 4 then do
        count = count + 1; pending[count] = rhs
      end
      if (operation >= 2 & operation <= 9 & operation <> 6) | operation = 14 | operation = 15 then do
        count = count + 1; pending[count] = lhs
      end
    end
    return seen
  /** Exact canonical description for research certificate identity. */
  signature: method = .string
    if _signature <> '' then return _signature
    if <blen>(_frozen) > 0 then do
      first = <at..u32>(28) _frozen; size = <at..u32>(32) _frozen
      return llprepared..packedtext(reference _frozen,first,size)
    end
    out = length(_profile) || ':' || _profile || ';'
    do i = 1 to _size
      operation = .int; lhs = .int; rhs = .int; source_line = .int
      label = .string; literal = .binary
      if <blen>(_records) = 0 then do
        operation = _op[i]; lhs = _a[i]; rhs = _b[i]; source_line = _line[i]
        label = _label[i]; literal = _text[i]
      end
      else do
        at = (i - 1) * 48
        operation = <at..i64>(at) _records; lhs = <at..i64>(at + 8) _records
        rhs = <at..i64>(at + 16) _records; source_line = <at..i64>(at + 24) _records
        label = rawlabel(i); literal = text(i)
      end
      out = out || operation || ',' || lhs || ',' || rhs || ',' || source_line || ',' || length(label) || ':' || label || ';'
      do j = 0 to <blen>(literal) - 1
        byte = <at..u8>(j) literal
        out = out || byte || ','
      end
      out = out || ';'
    end
    _signature = out
    return out
  op: method = .int
    arg node = .int
    if <blen>(_frozen) > 0 then do
      if node < 1 | node > _size then return 0
      return <at..i64>(_frozenrows + (node - 1) * 48 + 0) _frozen
    end
    if <blen>(_records) = 0 then return _op[node]
    if node < 1 | node > _size then return 0
    return <at..i64>((node - 1) * 48) _records
  left: method = .int
    arg node = .int
    if <blen>(_frozen) > 0 then do
      if node < 1 | node > _size then return 0
      return <at..i64>(_frozenrows + (node - 1) * 48 + 8) _frozen
    end
    if <blen>(_records) = 0 then return _a[node]
    if node < 1 | node > _size then return 0
    return <at..i64>((node - 1) * 48 + 8) _records
  right: method = .int
    arg node = .int
    if <blen>(_frozen) > 0 then do
      if node < 1 | node > _size then return 0
      return <at..i64>(_frozenrows + (node - 1) * 48 + 16) _frozen
    end
    if <blen>(_records) = 0 then return _b[node]
    if node < 1 | node > _size then return 0
    return <at..i64>((node - 1) * 48 + 16) _records
  label: method = .string
    arg node = .int
    label = rawlabel(node)
    if label == '' then return 'clause.' || node
    return label
  line: method = .int
    arg node = .int
    if <blen>(_frozen) > 0 then do
      if node < 1 | node > _size then return 0
      return <at..i64>(_frozenrows + (node - 1) * 48 + 24) _frozen
    end
    if <blen>(_records) = 0 then return _line[node]
    if node < 1 | node > _size then return 0
    return <at..i64>((node - 1) * 48 + 24) _records

/** Original bytes plus a sequence of symbols and original byte spans.
 * The default factory supplies every byte, including NUL, as one symbol.
 * The tokens factory starts an empty stream for an independent lexer.
 */
stream: class
  _source = .binary
  _size = .int
  _kind = .int[]
  _start = .int[]
  _end = .int[]
  _error = .string
  _boundary = .int

  *: factory
    arg source = .binary
    _source = source; _size = <blen>(source); _error = ''
    _boundary = <blen>(source)
    do i = 1 to _size
      _kind[i] = <at..u8>(i - 1) source
      _start[i] = i - 1; _end[i] = i
    end
    return

  tokens: factory
    arg source = .binary
    _source = source; _size = 0; _error = ''
    _boundary = <blen>(source)
    return
  /** A fragment retains original source ownership and a truthful local EOF. */
  boundary: method = .int
    arg finish = .int
    extent = <blen>(_source)
    if finish < 0 | finish > extent then do
      _error = 'fragment boundary outside source'; return 0
    end
    if _size > 0 then do
      if _end[_size] > finish then do
        _error = 'fragment boundary precedes a token'; return 0
      end
    end
    _boundary = finish
    return 1

  /** Append a nonempty token. Gaps retain trivia in the original source. */
  append: method = .int
    arg kind = .int, start = .int, finish = .int
    extent = _boundary
    if kind < 0 | kind > 255 then do
      _error = 'symbol outside the admitted 0..255 alphabet'; return 0
    end
    if start < 0 | finish <= start | finish > extent then do
      _error = 'token span outside source or empty'; return 0
    end
    if _size > 0 then do
      if start < _end[_size] then do
        _error = 'token overlaps its predecessor'; return 0
      end
    end
    _size = _size + 1
    _kind[_size] = kind; _start[_size] = start; _end[_size] = finish
    return 1

  /** Insert an explicit virtual token at a source boundary. Token count still
   * progresses; the zero-width span never invents or consumes source bytes. */
  synthetic: method = .int
    arg kind = .int, offset = .int
    extent = _boundary
    if kind < 0 | kind > 255 | offset < 0 | offset > extent then do
      _error = 'invalid synthetic token'; return 0
    end
    if _size > 0 then do
      if offset < _end[_size] then do
        _error = 'synthetic token overlaps predecessor'; return 0
      end
    end
    _size = _size + 1; _kind[_size] = kind; _start[_size] = offset; _end[_size] = offset
    return 1

  size: method = .int
    return _size
  bytes: method = .int
    return <blen>(_source)
  source: method = .binary
    return _source
  error: method = .string
    return _error
  symbol: method = .int
    arg position = .int
    if position < 0 | position >= _size then return -1
    return _kind[position + 1]
  start: method = .int
    arg position = .int
    if position >= _size then return _boundary
    if position < 0 then return -1
    return _start[position + 1]
  finish: method = .int
    arg position = .int
    if position < 1 then return 0
    if position > _size then return _boundary
    return _end[position]

/** Source-tree DAG arena with revision-bound structural certification.
 * @param source_bytes Size of the immutable source represented by this arena.
 * Child handles must precede their parent. Sharing is explicit and permitted.
 */
tree: class
  _bytes = .int
  _source = .binary
  _owns = .int
  _size = .int
  _revision = .int
  _checked = .int
  _kind = .int[]
  _start = .int[]
  _end = .int[]
  _left = .int[]
  _right = .int[]
  _label = .string[]
  _error = .string

  *: factory
    arg source_bytes = .int
    _bytes = source_bytes; _size = 0; _revision = 1; _checked = 0
    _error = ''; _owns = 0
    return

  /** Retain original bytes with the arena, independent of the parse request. */
  from_source: factory
    arg source = .binary
    _source = source; _bytes = <blen>(source); _owns = 1
    _size = 0; _revision = 1; _checked = 0; _error = ''
    return

  /** Construct a node; validate() establishes the structural postcondition. */
  add: method = .int
    arg kind = .int, label = .string, start = .int, finish = .int, a = .int, b = .int
    _size = _size + 1; _revision = _revision + 1
    _kind[_size] = kind; _label[_size] = label
    _start[_size] = start; _end[_size] = finish
    _left[_size] = a; _right[_size] = b
    return _size

  /** Explicit research mutation; every change invalidates a previous check. */
  relocate: method = .int
    arg node = .int, start = .int, finish = .int
    if node < 1 | node > _size then return 0
    _start[node] = start; _end[node] = finish
    _revision = _revision + 1
    return 1

  /** Check the entire arena, including nonselected speculative nodes. */
  validate: method = .int
    _checked = 0; _error = ''
    if _bytes < 0 then do
      _error = 'negative source extent'; return 0
    end
    do i = 1 to _size
      if _start[i] < 0 | _end[i] < _start[i] | _end[i] > _bytes then do
        _error = 'source span invalid at ' || _label[i]; return 0
      end
      do slot = 1 to 2
        child = _left[i]
        if slot = 2 then child = _right[i]
        if child < 0 | child >= i then do
          _error = 'child must precede parent at ' || _label[i]; return 0
        end
        if child > 0 then do
          if _start[child] < _start[i] | _end[child] > _end[i] then do
            _error = 'child span escapes parent at ' || _label[i]; return 0
          end
        end
      end
      if _left[i] > 0 & _right[i] > 0 then do
        if _end[_left[i]] > _start[_right[i]] then do
          _error = 'ordered children overlap at ' || _label[i]; return 0
        end
      end
    end
    _checked = _revision
    return 1

  certified: method = .int
    return _checked = _revision
  revision: method = .int
    return _revision
  size: method = .int
    return _size
  owns_source: method = .int
    return _owns
  source: method = .binary
    return _source
  error: method = .string
    return _error
  kind: method = .int
    arg node = .int
    return _kind[node]
  label: method = .string
    arg node = .int
    return _label[node]
  start: method = .int
    arg node = .int
    return _start[node]
  finish: method = .int
    arg node = .int
    return _end[node]
  left: method = .int
    arg node = .int
    return _left[node]
  right: method = .int
    arg node = .int
    return _right[node]
