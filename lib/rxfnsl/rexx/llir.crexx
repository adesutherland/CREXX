    arg owner = reference .llir..arena, blockid = .int, opcode = .llir..operation, at = .llir..origin
    _owner = owner; store = dereference owner; _identity = store.identity()
    _block = blockid; _op = opcode.id(); _origin = at.id(); _done = 0
    contract = dereference store.contract(); schema = dereference contract.data()
    if opcode.schemaid() <> contract.identity() | _op < 1 | _op > schema.ops() | at.belongs(owner) = 0 then call store.fail('LL_IR_SCHEMA: invalid extension draft contract or origin')
    return
  require: method = .void
    if <refvalid>(_owner) = 0 then call bad('LL_IR_OWNER: extension draft expired')
    store = dereference _owner
    if store.identity() <> _identity | _done then call bad('LL_IR_LIFECYCLE: extension draft expired or finished')
    return
  input: method = .void
    arg name = .string, input = .llir..valuehandle
    call require(); store = dereference _owner; contract = dereference store.contract(); schema = dereference contract.data()
    if input.belongs(_owner) = 0 then do
      call store.fail('LL_IR_OWNER: extension operand belongs to another module'); return
    end
    do i = 1 to schema.arity(_op,1)
      if schema.fieldname(_op,1,i) = name then do
        if _inputs[i] <> 0 then call store.fail('LL_IR_INPUT: duplicate input ' || name)
        _inputs[i] = input.id(); return
      end
    end
    call store.fail('LL_IR_INPUT: unknown input ' || name)
    return
  attribute: method = .void
    arg name = .string, bits = .binary
    call require(); store = dereference _owner; contract = dereference store.contract(); schema = dereference contract.data()
    do i = 1 to schema.arity(_op,3)
      if schema.fieldname(_op,3,i) = name then do
        if _present[i] then call store.fail('LL_IR_ATTRIBUTE: duplicate attribute ' || name)
        _attributes[i] = bits; _present[i] = 1; return
      end
    end
    call store.fail('LL_IR_ATTRIBUTE: unknown attribute ' || name)
    return
  finish: method = .llir..opview
    call require(); _done = 1; store = dereference _owner; contract = dereference store.contract(); schema = dereference contract.data()
    id = 0; i = .int
    do i = 1 to schema.arity(_op,1)
      if _inputs[i] = 0 then call store.fail('LL_IR_INPUT: missing input ' || schema.fieldname(_op,1,i))
    end
    do i = 1 to schema.arity(_op,3)
      if _present[i] = 0 then call store.fail('LL_IR_ATTRIBUTE: missing attribute ' || schema.fieldname(_op,3,i))
    end
    if store.error() = '' then do
      types = .int[]; edges = .int[]
      do i = 1 to schema.arity(_op,2)
        types[i] = schema.fieldtype(_op,2,i)
      end
      id = store.append(_block,16 + _op,_inputs,types,edges,_origin)
      if id > 0 & schema.arity(_op,3) > 0 then do
        call store.put(3,id,10,store.count(11) + 1)
        do i = 1 to schema.arity(_op,3)
          type = .llir..typeid(contract.identity(),schema.fieldtype(_op,3,i))
          c = store.constant(type,_attributes[i]); a = store.add(11)
          if a = 0 then leave
          call store.put(11,a,1,id); call store.put(11,a,2,i); call store.put(11,a,3,type.id()); call store.put(11,a,4,c)
        end
      end
    end
    return .llir..opview(_owner,id)

builder: class
  _store = .llir..arena
  *: factory
    arg contract = .llir..contract, entries = 1000000, bytes = 67108864
    _store = .llir..arena(contract,entries,bytes)
    return
  function: method = .llir..function
    arg name = .string, type = .llir..typeid
    id = _store.function(name,type)
    return .llir..function(reference _store,id)
  source: method = .llir..sourcefile
    arg name = .string, bytes = .binary
    id = _store.source(name,bytes)
    return .llir..sourcefile(reference _store,id)
  synthetic: method = .llir..origin
    arg description = 'generated'
    source = _store.source(description,''x as .binary)
    id = _store.origin(source,0,0,4)
    return .llir..origin(reference _store,id)
  finish: method = .llir..module
    ok = _store.freeze()
    return .llir..module(_store)
  error: method = .string
    return _store.error()

/** Immutable published graph; returning handles does not copy record buffers. */
module: class
  _store = .llir..arena
  *: factory
    arg store = .llir..arena
    _store = store
    if _store.sealed() = 0 then call _store.fail('LL_IR_LIFECYCLE: only verified frozen modules may be published')
    if _store.error() = '' then call verifyservices(reference _store)
    return
  error: method = .string
    return _store.error()
  identity: method = .int
    return _store.identity()
  storage: method = reference .llir..arena
    return reference _store
  functions: method = .int
    if error() <> '' then return 0
    return _store.count(1)
  function: method = .llir..function
    arg id = .int
    if error() <> '' then call bad(error())
    handle = .llir..function(reference _store,id); call handle.require()
    return handle
  blocks: method = .int
    if error() <> '' then return 0
    return _store.count(2)
  operations: method = .int
    if error() <> '' then return 0
    return _store.count(3)
  operation: method = .llir..opview
    arg id = .int
    if error() <> '' then call bad(error())
    return .llir..opview(reference _store,id)
  block: method = .llir..block
    arg id = .int
    if error() <> '' then call bad(error())
    return .llir..block(reference _store,id)
  bytes: method = .int
    return _store.bytes()
  capacity: method = .int
    return _store.capacity()
  binary: method = .binary
    if error() <> '' then return ''x as .binary
    return encode(reference _store)
  text: method = .string
    if error() <> '' then return ''
    return encodetext(reference _store)
  dump: method = .string
    arg functionid = 0, blockid = 0
    if error() <> '' then return ''
    contract = dereference _store.contract(); schema = dereference contract.data()
    out = .llir..writer(max(1024,_store.bytes() * 8 + 2048))
    do f = 1 to _store.count(1)
      if functionid <> 0 & functionid <> f then iterate
      call out.line('function ' || _store.text(_store.get(1,f,1)) || ' -> ' || schema.typename(_store.get(1,f,2)))
      call out.indent()
      if _store.get(1,f,6) > 0 then call out.line('export ' || _store.text(_store.get(1,f,6)))
      do a = 1 to _store.get(1,f,5)
        row = _store.get(1,f,4) + a - 1; required = 'required'
        if _store.get(12,row,3) then required = 'optional'
        call out.line('argument ' || a || ' ' || schema.typename(_store.get(12,row,2)) || ' ' || required)
      end
      do b = 1 to _store.count(2)
        if _store.get(2,b,1) <> f | (blockid <> 0 & blockid <> b) then iterate
        call out.line(_store.text(_store.get(2,b,4)) || ':')
        call out.indent()
        op = _store.get(2,b,2)
        do while op > 0
          line = ''; i = .int
          do i = 1 to _store.get(3,op,7)
            if i > 1 then line = line || ', '
            line = line || '%' || _store.result(op,i)
          end
          if line <> '' then line = line || ' = '
          opcode = _store.get(3,op,1)
          line = line || _store.opname(opcode)
          do i = 1 to _store.get(3,op,5)
            line = line || ' %' || _store.operand(op,i)
          end
          c = .int; type = .int; codec = .llir..typecodec
          if opcode = 1 then do
            c = _store.get(3,op,12); type = _store.get(8,c,1)
            codec = schema.codec(type) as .llir..typecodec
            line = line || ' ' || codec.format(_store.bits(_store.get(8,c,2))) || ' : ' || schema.typename(type)
          end
          if opcode = 3 | opcode = 4 then line = line || ' slot:' || _store.text(_store.get(5,_store.get(3,op,12),3))
          if opcode = 2 | opcode = 8 | opcode = 9 then line = line || ' argument:' || _store.get(3,op,12)
          if opcode > 16 then do i = 1 to schema.arity(opcode - 16,3)
            attribute = _store.get(3,op,10) + i - 1
            c = _store.get(11,attribute,4); type = _store.get(8,c,1)
            codec = schema.codec(type) as .llir..typecodec
            text = codec.format(_store.bits(_store.get(8,c,2)))
            text = changestr('"',text,'""')
            text = changestr('0d'x,text,'\r'); text = changestr('0a'x,text,'\n')
            line = line || ' ' || schema.fieldname(opcode - 16,3,i) || '="' || text || '"'
          end
          do i = 1 to _store.get(3,op,9)
            target = _store.successor(op,i)
            line = line || ' -> ' || _store.text(_store.get(2,target,4))
          end
          call out.line(line || ' @origin:' || _store.get(3,op,11))
          op = _store.get(3,op,3)
        end
        call out.dedent()
      end
      call out.dedent()
    end
    result = out.finish()
    if result.error() <> '' then call bad(result.error())
    return result.text()

/** Append-only text chunks. Indentation is applied by line(); write is exact.
 * A section is another writer. Finish checks balanced indentation. */
writer: class
  _chunks = .binary[]
  _origins = .int[]
  _bytes = .int
  _limit = .int
  _depth = .int
  _indent = .string
  _error = .string
  *: factory
    arg bytes = 67108864, indent = '  '
    _bytes = 0; _limit = bytes; _depth = 0; _indent = indent; _error = ''
    if bytes < 1 then _error = 'LL_IR_BUDGET: output.bytes must be positive'
    return
  write: method = .void
    arg text = .string, originid = 0
    if _error <> '' then return
    data = text as .binary; size = <blen>(data)
    if size > _limit - _bytes then do
      _error = 'LL_RESOURCE_LIMIT: output.bytes budget ' || _limit || '; increase the host budget'; return
    end
    if size = 0 then return
    i = _chunks[0] + 1; _chunks[i] = data; _origins[i] = originid; _bytes = _bytes + size
    return
  line: method = .void
    arg text = '', originid = 0
    call write(copies(_indent,_depth) || text || '0a'x,originid)
    return
  indent: method = .void
    if _error <> '' then return
    data = _indent as .binary
    if _depth >= _limit <idiv> max(1,<blen>(data)) then _error = 'LL_RESOURCE_LIMIT: output indentation exceeds output.bytes budget'
    else _depth = _depth + 1
    return
  dedent: method = .void
    if _depth = 0 then _error = 'LL_IR_EMITTER: indentation underflow'
    else _depth = _depth - 1
    return
  section: method = .llir..writer
    return .llir..writer(_limit,_indent)
  append: method = .void
    arg section = reference .llir..output
    if _error <> '' then return
    part = dereference section
    if part.error() <> '' then do
      _error = part.error(); return
    end
    if part.bytes() > _limit - _bytes then do
      _error = 'LL_RESOURCE_LIMIT: output.bytes budget ' || _limit || '; increase the host budget'; return
    end
    do i = 1 to part.chunks()
      at = _chunks[0] + 1; _chunks[at] = part.chunk(i); _origins[at] = part.origin(i)
    end
    _bytes = _bytes + part.bytes()
    return
  finish: method = .llir..output
    if _depth <> 0 & _error = '' then _error = 'LL_IR_EMITTER: unclosed indentation'
    return .llir..output(_chunks,_origins,_bytes,_error)
  error: method = .string
    return _error

sink: interface
  write: method = .string
    arg bytes = .binary

output: class
  _chunks = .binary[]
  _origins = .int[]
  _bytes = .int
  _error = .string
  *: factory
    arg chunks = .binary[], origins = .int[], bytes = .int, error = .string
    _error = error; _bytes = 0
    if error = '' then do
      _chunks = chunks; _origins = origins; _bytes = bytes
    end
    return
  error: method = .string
    return _error
  bytes: method = .int
    return _bytes
  chunks: method = .int
    return _chunks[0]
  chunk: method = .binary
    arg i = .int
    return _chunks[i]
  origin: method = .int
    arg i = .int
    return _origins[i]
  text: method = .string
    data = .binary; call binresize data,_bytes
    at = 0
    do i = 1 to _chunks[0]
      part = _chunks[i]; size = <blen>(part)
      call bincopy data,at,part,0,size
      at = at + size
    end
    return data as .string
  stream: method = .string
    arg sink = .llir..sink
    if _error <> '' then return _error
    message = .string
    do i = 1 to _chunks[0]
      do
        message = sink.write(_chunks[i])
      on signal
        return 'LL_IR_OUTPUT: sink signalled failure'
      end
      if message <> '' then return 'LL_IR_OUTPUT: ' || message
    end
    return ''

/** Portable envelope. Numeric records remain encoded u32 little endian. */
encode: procedure = .binary
  arg input = reference .llir..arena
  store = dereference input; contract = dereference store.contract()
  manifest = contract.manifest() as .binary
  size = 8 + 4 + <blen>(manifest) + 13 * 8 + 4
  t = .int; i = .int; bytes = .binary
  do t = 1 to 13
    size = size + store.count(t) * store.width(t) * 4
  end
  do i = 1 to store.poolsize()
    bytes = store.bits(i); size = size + 4 + <blen>(bytes)
  end
  result = .binary; call binresize result,size
  <at..u32>(0) result = 1380535372
  <at..u32>(4) result = 2
  <at..u32>(8) result = <blen>(manifest)
  call bincopy result,12,manifest,0,<blen>(manifest)
  at = 12 + <blen>(manifest)
  do t = 1 to 13
    <at..u32>(at) result = store.count(t); at = at + 4
    <at..u32>(at) result = store.width(t); at = at + 4
    do i = 1 to store.count(t)
      do c = 1 to store.width(t)
        <at..u32>(at) result = store.get(t,i,c); at = at + 4
      end
    end
  end
  <at..u32>(at) result = store.poolsize(); at = at + 4
  do i = 1 to store.poolsize()
    bytes = store.bits(i); size = <blen>(bytes)
    <at..u32>(at) result = size; at = at + 4
    call bincopy result,at,bytes,0,size; at = at + size
  end
  return result

/** A bounded reader validates a span before every access. */
reader: class
  _bytes = reference .binary
  _at = .int
  *: factory
    arg bytes = reference .binary
    _bytes = bytes; _at = 0
    return
  left: method = .int
    bytes = dereference _bytes
    return <blen>(bytes) - _at
  u32: method = .int
    bytes = dereference _bytes
    if left() < 4 then call bad('LL_IR_IMAGE: truncated integer')
    result = <at..u32>(_at) bytes; _at = _at + 4
    return result
  blob: method = .binary
    size = u32(); bytes = dereference _bytes
    if size > left() then call bad('LL_IR_IMAGE: truncated byte sequence')
    result = binsubstr(bytes,_at + 1,size); _at = _at + size
    return result

loadbinary: procedure = .llir..module
  arg contract = .llir..contract, bytes = .binary, entries = 1000000, budget = 67108864
  store = .llir..arena(contract,entries,budget); version = 0
  do
    if <blen>(bytes) > budget then call store.fail('LL_RESOURCE_LIMIT: ir.image.bytes exceeds host budget ' || budget)
    reader = .llir..reader(reference bytes)
    if store.error() = '' then do
      magic = reader.u32(); version = reader.u32()
      if magic <> 1380535372 | (version <> 1 & version <> 2) then call store.fail('LL_IR_IMAGE: unsupported magic or version')
    end
    if store.error() = '' then do
      manifest = reader.blob() as .string
      if manifest <> contract.manifest() then call store.fail('LL_IR_SCHEMA: image requires a different schema or semantic family version')
    end
    t = .int; i = .int; count = .int; id = .int
    do t = 1 to 13 while store.error() = ''
      count = reader.u32(); width = reader.u32()
      expectedwidth = store.width(t)
      if version = 1 & t = 12 then expectedwidth = 2
      if width <> expectedwidth then do
        call store.fail('LL_IR_IMAGE: unsupported table width'); leave
      end
      if count > reader.left() <idiv> (width * 4) then do
        call store.fail('LL_IR_IMAGE: table extent exceeds input'); leave
      end
      do i = 1 to count while store.error() = ''
        id = store.add(t)
        if id = 0 then leave
        do c = 1 to width
          number = reader.u32()
          if version = 1 & t = 1 & c = 6 & number <> 0 then call store.fail('LL_IR_RESERVED: nonzero version 1 reserved field')
          if version = 1 & t = 3 & c = 1 & number >= 8 & number <= 10 then call store.fail('LL_IR_OPCODE: version 1 core opcode')
          call store.put(t,id,c,number)
        end
      end
    end
    if store.error() = '' then do
      count = reader.u32()
      if count > reader.left() <idiv> 4 then call store.fail('LL_IR_IMAGE: pool extent exceeds input')
      do i = 1 to count while store.error() = ''
        id = store.pool(reader.blob())
      end
      if reader.left() <> 0 then call store.fail('LL_IR_IMAGE: trailing bytes')
    end
  on signal
    call store.fail('LL_IR_IMAGE: truncated or invalid encoded data')
  end
  ok = store.freeze()
  return .llir..module(store)

tablename: procedure = .string
  arg t = .int
  return word('functions blocks operations values slots operands edges constants origins sources attributes arguments contributors',t)

encodetext: procedure = .string
  arg input = reference .llir..arena
  store = dereference input; contract = dereference store.contract()
  out = .llir..writer(max(1024,store.bytes() * 8 + length(contract.manifest()) * 4 + 2048))
  call out.line('LLIR-TEXT-2')
  call out.line('schema ' || bin2x(contract.manifest() as .binary))
  t = .int; i = .int
  do t = 1 to 13
    call out.line(tablename(t) || ' ' || store.count(t) || ' ' || store.width(t))
    do i = 1 to store.count(t)
      line = ''
      do c = 1 to store.width(t)
        if c > 1 then line = line || ' '
        line = line || store.get(t,i,c)
      end
      call out.line(line)
    end
  end
  call out.line('pool ' || store.poolsize())
  do i = 1 to store.poolsize()
    call out.line('bytes ' || bin2x(store.bits(i)))
  end
  result = out.finish()
  if result.error() <> '' then call bad(result.error())
  return result.text()

textreader: class
  _text = .string[]
  _position = .int
  *: factory
    arg text = .string
    _position = 0; start = 1
    do i = 1 to length(text)
      if substr(text,i,1) = '0a'x then do
        _text[_text[0] + 1] = substr(text,start,i - start); start = i + 1
      end
    end
    if start <= length(text) then _text[_text[0] + 1] = substr(text,start)
    return
  line: method = .string
    _position = _position + 1
    if _position > _text[0] then call bad('LL_IR_TEXT: unexpected end of input')
    return _text[_position]
  left: method = .int
    return _text[0] - _position

natural: procedure = .int
  arg text = .string
  if text = '' then call bad('LL_IR_TEXT: missing count')
  number = 0
  do i = 1 to length(text)
    digit = pos(substr(text,i,1),'0123456789') - 1
    if digit < 0 | number > 429496729 | (number = 429496729 & digit > 5) then call bad('LL_IR_TEXT: invalid u32 field')
    number = number * 10 + digit
  end
  return number

unhex: procedure = .binary
  arg text = .string
  if length(text) <mod> 2 <> 0 then call bad('LL_IR_TEXT: incomplete hexadecimal byte')
  do i = 1 to length(text)
    if pos(substr(text,i,1),'0123456789ABCDEF') = 0 then call bad('LL_IR_TEXT: invalid hexadecimal byte')
  end
  return x2bin(text)

loadtext: procedure = .llir..module
  arg contract = .llir..contract, text = .string, entries = 1000000, budget = 67108864
  store = .llir..arena(contract,entries,budget); version = 0
  do
    source = text as .binary
    if <blen>(source) > budget then call store.fail('LL_RESOURCE_LIMIT: ir.image.bytes exceeds host budget ' || budget)
    if store.error() = '' then do
      reader = .llir..textreader(text)
      header = reader.line()
      if header = 'LLIR-TEXT-1' then version = 1
      else if header = 'LLIR-TEXT-2' then version = 2
      else call store.fail('LL_IR_TEXT: unsupported text version')
      line = reader.line()
      if word(line,1) <> 'schema' | words(line) <> 2 then call store.fail('LL_IR_TEXT: expected schema')
      manifest = unhex(word(line,2)) as .string
      if manifest <> contract.manifest() then call store.fail('LL_IR_SCHEMA: text requires a different semantic contract')
      t = .int; i = .int; count = .int; id = .int
      do t = 1 to 13 while store.error() = ''
        line = reader.line()
        if word(line,1) <> tablename(t) | words(line) <> 3 then do
          call store.fail('LL_IR_TEXT: expected ' || tablename(t) || ' table'); leave
        end
        count = natural(word(line,2)); width = natural(word(line,3))
        expectedwidth = store.width(t)
        if version = 1 & t = 12 then expectedwidth = 2
        if width <> expectedwidth | count > reader.left() then do
          call store.fail('LL_IR_TEXT: invalid table width or extent'); leave
        end
        do i = 1 to count while store.error() = ''
          line = reader.line()
          if words(line) <> width then do
            call store.fail('LL_IR_TEXT: wrong field count'); leave
          end
          id = store.add(t)
          if id = 0 then leave
          do c = 1 to width
            number = natural(word(line,c))
            if version = 1 & t = 1 & c = 6 & number <> 0 then call store.fail('LL_IR_RESERVED: nonzero version 1 reserved field')
            if version = 1 & t = 3 & c = 1 & number >= 8 & number <= 10 then call store.fail('LL_IR_OPCODE: version 1 core opcode')
            call store.put(t,id,c,number)
          end
        end
      end
      if store.error() = '' then do
        line = reader.line()
        if word(line,1) <> 'pool' | words(line) <> 2 then call store.fail('LL_IR_TEXT: expected byte pool')
        count = natural(word(line,2))
        if count > reader.left() then call store.fail('LL_IR_TEXT: pool extent exceeds input')
        do i = 1 to count while store.error() = ''
          line = reader.line()
          if left(line,6) <> 'bytes ' then do
            call store.fail('LL_IR_TEXT: expected exact hexadecimal bytes'); leave
          end
          id = store.pool(unhex(substr(line,7)))
        end
        if reader.left() <> 0 then call store.fail('LL_IR_TEXT: trailing records')
      end
    end
  on signal
    call store.fail('LL_IR_TEXT: invalid or truncated text image')
  end
  ok = store.freeze()
  return .llir..module(store)

/** Run host-registered semantic checks only after structural verification. */
verifyservices: procedure = .void
  arg owner = reference .llir..arena
  store = dereference owner; contract = dereference store.contract(); schema = dereference contract.data()
  do i = 1 to store.count(3) while store.error() = ''
    opcode = store.get(3,i,1)
    if opcode > 16 then do
      service = schema.callback(opcode - 16,2)
      if service is .llir..verification then do
        do
          verifier = service as .llir..verification
          message = verifier.check(.llir..opview(owner,i))
          if message <> '' then call store.fail('LL_IR_SEMANTIC: ' || message,i,1)
        on signal
          call store.fail('LL_IR_SEMANTIC: verifier signalled failure',i,1)
        end
      end
    end
  end
  return

/** Lowering results are borrowed destination values, never source values. */
fragment: class
  _status = .string
  _message = .string
  _values = .object[]
  *: factory
    arg status = 'keep', message = ''
    _status = status; _message = message
    return
  add: method = .void
    arg value = .llir..valuehandle
    _values[_values[0] + 1] = value as .object
    return
  status: method = .string
    return _status
  message: method = .string
    return _message
  size: method = .int
    return _values[0]
  at: method = .llir..valuehandle
    arg ordinal = .int
    return _values[ordinal] as .llir..valuehandle

/** A lowering service constructs its fragment in this destination block.
 * The coordinator validates ownership, types, effects and the final graph. */
