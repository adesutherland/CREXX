      end
      if store.error() = '' then id = store.append(_id,opcode,inputs,types,edges,at.id(),ordinal)
    end
    return .llir..valuehandle(_owner,store.result(id))
  hasarg: method = .llir..valuehandle
    arg ordinal = .int, at = .llir..origin
    call require(); store = dereference _owner; id = 0; fn = store.get(2,_id,1)
    if store.reserve(0,0) = 0 then return .llir..valuehandle(_owner,0)
    if ordinal < 1 | ordinal > store.get(1,fn,5) then call store.fail('LL_IR_SIGNATURE: unknown argument ordinal')
    if at.belongs(_owner) = 0 then call store.fail('LL_IR_OWNER: argument origin belongs to another module')
    if store.error() = '' then do
      inputs = .int[]; types = .int[]; edges = .int[]; types[1] = 2
      id = store.append(_id,8,inputs,types,edges,at.id(),ordinal)
    end
    return .llir..valuehandle(_owner,store.result(id))
  jump: method = .void
    arg target = .llir..block, at = .llir..origin
    call require(); store = dereference _owner
    if target.belongs(_owner) = 0 | at.belongs(_owner) = 0 then call store.fail('LL_IR_OWNER: jump target or origin belongs to another module')
    if store.error() = '' then do
      inputs = .int[]; types = .int[]; edges = .int[]; edges[1] = target.id()
      id = store.append(_id,5,inputs,types,edges,at.id())
    end
    return
  branch: method = .void
    arg condition = .llir..valuehandle, yes = .llir..block, no = .llir..block, at = .llir..origin
    call require(); store = dereference _owner
    if condition.belongs(_owner) = 0 | yes.belongs(_owner) = 0 | no.belongs(_owner) = 0 | at.belongs(_owner) = 0 then call store.fail('LL_IR_OWNER: branch operands belong to another module')
    if store.error() = '' then do
      inputs = .int[]; types = .int[]; edges = .int[]; inputs[1] = condition.id(); edges[1] = yes.id(); edges[2] = no.id()
      id = store.append(_id,6,inputs,types,edges,at.id())
    end
    return
  /** Declare protected invocation control without an evaluated condition.
   * @param normal Ordinary continuation after setup.
   * @param exceptional Exceptional entry for the protected invocation.
   * @param at Owned source/provenance of this declaration.
   * Runtime binding, event transport and cleanup belong to the host. */
  protect: method = .void
    arg normal = .llir..block, exceptional = .llir..block, at = .llir..origin
    call require(); store = dereference _owner
    if normal.belongs(_owner) = 0 | exceptional.belongs(_owner) = 0 | at.belongs(_owner) = 0 then call store.fail('LL_IR_OWNER: protect successors or origin belong to another module')
    if store.error() = '' then do
      inputs = .int[]; types = .int[]; edges = .int[]; edges[1] = normal.id(); edges[2] = exceptional.id()
      id = store.append(_id,10,inputs,types,edges,at.id())
    end
    return
  returnvoid: method = .void
    arg at = .llir..origin
    call require(); store = dereference _owner
    if at.belongs(_owner) = 0 then call store.fail('LL_IR_OWNER: return origin belongs to another module')
    if store.error() = '' then do
      inputs = .int[]; types = .int[]; edges = .int[]
      id = store.append(_id,7,inputs,types,edges,at.id())
    end
    return
  returnvalue: method = .void
    arg input = .llir..valuehandle, at = .llir..origin
    call require(); store = dereference _owner
    if input.belongs(_owner) = 0 | at.belongs(_owner) = 0 then call store.fail('LL_IR_OWNER: return value or origin belongs to another module')
    if store.error() = '' then do
      inputs = .int[]; types = .int[]; edges = .int[]; inputs[1] = input.id()
      id = store.append(_id,7,inputs,types,edges,at.id())
    end
    return

