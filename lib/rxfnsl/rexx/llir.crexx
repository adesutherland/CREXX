/* cREXX License (MIT). Checked Level B intermediate representation. */
options levelb
namespace llir expose schema contract family typeid operation typecodec bytescodec intcodec boolcodec evaluation evaluator verification lowering request fragment lowerrequest schema_data table arena builder module function block valuehandle slot origin sourcefile opview opdraft writer output sink reader textreader loadbinary loadtext
import rxfnsb

identities: initialiser expose serial
  serial = 0
  return
nextidentity: procedure = .int expose serial
  if serial = 9223372036854775807 then do
    assembler signal "ERROR","LL_IR_IDENTITY: identities exhausted"
    return 0
  end
  serial = serial + 1
  return serial
bad: procedure = .void
  arg message = .string
  assembler signal "ERROR",message
  return

/** A compact checked table. Rows and columns are one based; fields are u32.
 * Capacity grows geometrically. Layout 1 is row-major; layout 2 is column-major.
 * The latter is retained for storage comparison, not a file-format switch.
 */
table: class
  _data = .binary
  _width = .int
  _count = .int
  _capacity = .int
  _layout = .int
  *: factory
    arg width = .int, layout = 1
    _width = width; _count = 0; _capacity = 0; _layout = layout
    if width < 1 | width > 64 | (layout <> 1 & layout <> 2) then call bad('LL_IR_TABLE: invalid record layout')
    return
  size: method = .int
    return _count
  bytes: method = .int
    return <blen>(_data)
  usedbytes: method = .int
    return _count * _width * 4
  offset: method = .int
    arg row = .int, col = .int
    if row < 1 | row > _count | col < 1 | col > _width then do
      call bad('LL_IR_TABLE: record or field outside table'); return 0
    end
    if _layout = 2 then return ((col - 1) * _capacity + row - 1) * 4
    return ((row - 1) * _width + col - 1) * 4
  get: method = .int
    arg row = .int, col = .int
    at = offset(row,col)
    return <at..u32>(at) _data
  put: method = .void
    arg row = .int, col = .int, number = .int
    if number < 0 | number > 4294967295 then do
      call bad('LL_REPRESENTATION_LIMIT: IR field requires an unsigned 32-bit value'); return
    end
    at = offset(row,col)
    <at..u32>(at) _data = number
    return
  add: method = .int
    c = .int
    if _count = 4294967295 then do
      call bad('LL_REPRESENTATION_LIMIT: IR record IDs exhausted'); return 0
    end
    if _count = _capacity then do
      capacity = min(4294967295,max(8,_capacity * 2))
      if _layout = 1 then call binresize _data,capacity * _width * 4
      else do
        fresh = .binary; call binresize fresh,capacity * _width * 4
        do c = 1 to _width
          do r = 1 to _count
            from = ((c - 1) * _capacity + r - 1) * 4
            dest = ((c - 1) * capacity + r - 1) * 4
            <at..u32>(dest) fresh = <at..u32>(from) _data
          end
        end
        _data = fresh
      end
      _capacity = capacity
    end
    _count = _count + 1
    do c = 1 to _width
      call put(_count,c,0)
    end
    return _count

/** Exact encoding services are supplied explicitly by the host. */
typecodec: interface
  parse: method = .binary
    arg text = .string
  check: method = .string
    arg bits = .binary
  format: method = .string
    arg bits = .binary

bytescodec: class implements .typecodec
  *: factory
    return
  parse: method = .binary
    arg text = .string
    return unhex(text)
  check: method = .string
    arg bits = .binary
    return ''
  format: method = .string
    arg bits = .binary
    return bin2x(bits)

intcodec: class implements .typecodec
  *: factory
    return
  parse: method = .binary
    arg text = .string
    if text = '' then call bad('LL_IR_CONSTANT: expected an integer')
    first = 1; negative = 0
    if left(text,1) = '-' then do
      negative = 1; first = 2
    end
    if first > length(text) then call bad('LL_IR_CONSTANT: expected integer digits')
    number = 0
    /* Accumulate negatively so the minimum signed integer is representable. */
    do i = first to length(text)
      digit = pos(substr(text,i,1),'0123456789') - 1
      if digit < 0 then call bad('LL_IR_CONSTANT: expected integer digits')
      if number < -922337203685477580 | (number = -922337203685477580 & digit > 7 + negative) then call bad('LL_IR_CONSTANT: integer exceeds int64')
      number = number * 10 - digit
    end
    if negative = 0 then number = -number
    result = .binary; call binresize result,8
    <at..i64>(0) result = number
    return result
  check: method = .string
    arg bits = .binary
    if <blen>(bits) <> 8 then return 'int64 requires exactly eight bytes'
    return ''
  format: method = .string
    arg bits = .binary
    if check(bits) <> '' then call bad('LL_IR_CONSTANT: invalid int64 encoding')
    return <at..i64>(0) bits

boolcodec: class implements .typecodec
  *: factory
    return
  parse: method = .binary
    arg text = .string
    if text = 'true' | text = '1' then return '01'x as .binary
    if text = 'false' | text = '0' then return '00'x as .binary
    call bad('LL_IR_CONSTANT: Boolean must be true or false')
    return ''x as .binary
  check: method = .string
    arg bits = .binary
    if <blen>(bits) <> 1 then return 'Boolean requires one byte'
    if <at..u8>(0) bits > 1 then return 'Boolean encoding must be zero or one'
    return ''
  format: method = .string
    arg bits = .binary
    if check(bits) <> '' then call bad('LL_IR_CONSTANT: invalid Boolean encoding')
    if <at..u8>(0) bits = 1 then return 'true'
    return 'false'

/** Service outcomes do not turn runtime arithmetic failures into build errors.
 * Values are exact encodings, in declared result order. */
evaluation: class
  _status = .string
  _message = .string
  _values = .binary[]
  _used = .string[]
  *: factory
    arg status = 'keep', message = ''
    _status = status; _message = message
    return
  add: method = .void
    arg bits = .binary
    _values[_values[0] + 1] = bits
    return
  status: method = .string
    return _status
  message: method = .string
    return _message
  size: method = .int
    return _values[0]
  at: method = .binary
    arg i = .int
    return _values[i]

  use: method = .void
    arg key = .string
    _used[_used[0] + 1] = key
    return
  uses: method = .int
    return _used[0]
  used: method = .string
    arg i = .int
    return _used[i]

evaluator: interface
  evaluate: method = .llir..evaluation
    arg input = .llir..request
verification: interface
  check: method = .string
    arg input = .llir..opview
lowering: interface
  lower: method = .llir..fragment
    arg input = .llir..lowerrequest

/** A service receives immutable value copies, never the mutable program pool.
 * Context keys are explicit proved facts; work is an agreed service budget. */
request: class
  _opcode = .string
  _values = .binary[]
  _keys = .string[]
  _facts = .binary[]
  _budget = .int
  _operation = .llir..opview
  *: factory
    arg opcode = .string, values = .binary[], keys = .string[], context = .binary[], budget = .int, operation = .llir..opview
    _operation = operation
    _opcode = opcode; _values = values; _keys = keys; _facts = context; _budget = budget
    return
  operation: method = .llir..opview
    return _operation
  opcode: method = .string
    return _opcode
  size: method = .int
    return _values[0]
  at: method = .binary
    arg i = .int
    return _values[i]
  budget: method = .int
    return _budget
  has: method = .int
    arg name = .string
    do i = 1 to _keys[0]
      if _keys[i] = name then return 1
    end
    return 0
  get: method = .binary
    arg name = .string
    do i = 1 to _keys[0]
      if _keys[i] = name then return _facts[i]
    end
    call bad('LL_IR_FACT: missing semantic context ' || name)
    return ''x as .binary

/** Mutable registry storage; descriptors borrow it until finish freezes it. */
schema_data: class
  _identity = .int
  _sealed = .int
  _error = .string
  _families = .string[]
  _versions = .int[]
  _types = .string[]
  _codecs = .object[]
  _ops = .string[]
  _fields = .llir..table
  _names = .string[]
  _states = .string[]
  _failures = .string[]
  _termination = .string[]
  _evaluators = .object[]
  _verifiers = .object[]
  _lowerers = .object[]
  *: factory
    _identity = nextidentity(); _sealed = 0; _error = ''
    _fields = .llir..table(4)
    return
  bootstrap: method = .void
    id = addfamily('core',1)
    id = addtype('core.void',.bytescodec() as .object)
    id = addtype('core.boolean',.boolcodec() as .object)
    return
  identity: method = .int
    return _identity
  sealed: method = .int
    return _sealed
  error: method = .string
    return _error
  fail: method = .void
    arg message = .string
    if _error = '' then _error = message
    return
  mutable: method = .int
    if _sealed then do
      call bad('LL_IR_SCHEMA: contract is frozen'); return 0
    end
    return _error = ''
  addfamily: method = .int
    arg name = .string, version = .int
    if mutable() = 0 then return 0
    if validname(name) = 0 | version < 1 | version > 4294967295 then do
      call fail('LL_IR_SCHEMA: invalid family name or version'); return 0
    end
    i = .int
    do i = 1 to _families[0]
      if _families[i] = name then do
        call fail('LL_IR_SCHEMA: duplicate family ' || name); return 0
      end
    end
    i = _families[0] + 1; _families[i] = name; _versions[i] = version
    return i
  familyname: method = .string
    arg i = .int
    return _families[i]
  familycount: method = .int
    return _families[0]
  version: method = .int
    arg i = .int
    return _versions[i]
  addtype: method = .int
    arg name = .string, codec = .object
    if mutable() = 0 then return 0
    if validname(name) = 0 | typeindex(name) > 0 then do
      call fail('LL_IR_SCHEMA: invalid or duplicate type ' || name); return 0
    end
    if (codec is .llir..typecodec) = 0 | initialized(codec) = 0 then do
      call fail('LL_IR_SCHEMA: type requires a typecodec service'); return 0
    end
    i = _types[0] + 1; _types[i] = name; _codecs[i] = codec
    return i
  typeindex: method = .int
    arg name = .string
    do i = 1 to _types[0]
      if _types[i] = name then return i
    end
    return 0
  typename: method = .string
    arg i = .int
    return _types[i]
  types: method = .int
    return _types[0]
  codec: method = .object
    arg i = .int
    return _codecs[i]
  addop: method = .int
    arg name = .string
    if mutable() = 0 then return 0
    if validname(name) = 0 | opindex(name) > 0 then do
      call fail('LL_IR_SCHEMA: invalid or duplicate operation ' || name); return 0
    end
    i = _ops[0] + 1; _ops[i] = name
    _states[i] = 'unknown'; _failures[i] = 'unknown'; _termination[i] = 'unknown'
    return i
  opindex: method = .int
    arg name = .string
    do i = 1 to _ops[0]
      if _ops[i] = name then return i
    end
    return 0
  opname: method = .string
    arg i = .int
    return _ops[i]
  ops: method = .int
    return _ops[0]
  field: method = .void
    arg op = .int, mode = .int, name = .string, type = .llir..typeid
    if mutable() = 0 then return
    if op < 1 | op > _ops[0] | validname(name) = 0 | type.schemaid() <> _identity | type.id() < 2 | type.id() > _types[0] | mode < 1 | mode > 3 then do
      call fail('LL_IR_SCHEMA: invalid operation field ' || name); return
    end
    i = .int
    do i = 1 to _fields.size()
      if _fields.get(i,1) = op & _fields.get(i,2) = mode & _names[i] = name then do
        call fail('LL_IR_SCHEMA: duplicate operation field ' || name); return
      end
    end
    i = _fields.add(); call _fields.put(i,1,op); call _fields.put(i,2,mode)
    call _fields.put(i,3,type.id()); _names[i] = name
    return
  arity: method = .int
    arg op = .int, mode = .int
    count = 0
    do i = 1 to _fields.size()
      if _fields.get(i,1) = op & _fields.get(i,2) = mode then count = count + 1
    end
    return count
  fieldid: method = .int
    arg op = .int, mode = .int, ordinal = .int
    count = 0
    do i = 1 to _fields.size()
      if _fields.get(i,1) = op & _fields.get(i,2) = mode then do
        count = count + 1
        if count = ordinal then return i
      end
    end
    return 0
  fieldtype: method = .int
    arg op = .int, mode = .int, ordinal = .int
    i = fieldid(op,mode,ordinal)
    if i = 0 then return 0
    return _fields.get(i,3)
  fieldname: method = .string
    arg op = .int, mode = .int, ordinal = .int
    i = fieldid(op,mode,ordinal)
    if i = 0 then return ''
    return _names[i]
  effect: method = .void
    arg op = .int, which = .int, text = .string
    if mutable() = 0 then return
    if op < 1 | op > _ops[0] | validname(text) = 0 | which < 1 | which > 3 then do
      call fail('LL_IR_SCHEMA: invalid effect declaration'); return
    end
    if which = 1 then _states[op] = text
    else if which = 2 then _failures[op] = text
    else if which = 3 then do
      if wordpos(text,'unknown returns diverges transfer') = 0 then call fail('LL_IR_SCHEMA: invalid termination declaration')
      else _termination[op] = text
    end
    return
  effectvalue: method = .string
    arg op = .int, which = .int
    if which = 1 then return _states[op]
    if which = 2 then return _failures[op]
    return _termination[op]
  service: method = .void
    arg op = .int, which = .int, service = .object
    if mutable() = 0 then return
    if op < 1 | op > _ops[0] | initialized(service) = 0 then do
      call fail('LL_IR_SCHEMA: uninitialised semantic service'); return
    end
    if which = 1 & service is .llir..evaluator then _evaluators[op] = service
    else if which = 2 & service is .llir..verification then _verifiers[op] = service
    else if which = 3 & service is .llir..lowering then _lowerers[op] = service
    else call fail('LL_IR_SCHEMA: semantic service has the wrong interface')
    return
  callback: method = .object
    arg op = .int, which = .int
    if which = 1 then return _evaluators[op]
    if which = 2 then return _verifiers[op]
    return _lowerers[op]
  freeze: method = .int
    _sealed = 1
    return _error = ''
  manifest: method = .string
    i = .int
    text = 'LLIR-SCHEMA-1' || '0a'x
    do i = 1 to familycount()
      text = text || 'family ' || _families[i] || ' ' || _versions[i] || '0a'x
    end
    do i = 1 to types()
      text = text || 'type ' || _types[i] || '0a'x
    end
    do i = 1 to ops()
      text = text || 'operation ' || _ops[i] || ' ' || _states[i] || ' ' || _failures[i] || ' ' || _termination[i] || '0a'x
      do mode = 1 to 3
        do j = 1 to arity(i,mode)
          text = text || mode || ' ' || fieldname(i,mode,j) || ' ' || typename(fieldtype(i,mode,j)) || '0a'x
        end
      end
    end
    return text

validname: procedure = .int
  arg name = .string
  if name = '' then return 0
  do i = 1 to length(name)
    if pos(substr(name,i,1),'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.') = 0 then return 0
  end
  return 1

typeid: class
  _schema = .int
  _id = .int
  *: factory
    arg schema = .int, id = .int
    _schema = schema; _id = id
    return
  schemaid: method = .int
    return _schema
  id: method = .int
    return _id

schema: class
  _data = .llir..schema_data
  *: factory
    _data = .llir..schema_data()
    call _data.bootstrap()
    return
  family: method = .llir..family
    arg name = .string, version = .int
    i = _data.addfamily(name,version)
    return .llir..family(reference _data,i)
  /** Look up an already registered type while defining extension signatures. */
  type: method = .llir..typeid
    arg name = .string
    return .llir..typeid(_data.identity(),_data.typeindex(name))
  /** Core type handles are available while registering extension signatures. */
  boolean: method = .llir..typeid
    return .llir..typeid(_data.identity(),2)
  voidtype: method = .llir..typeid
    return .llir..typeid(_data.identity(),1)
  finish: method = .llir..contract
    ok = _data.freeze()
    return .llir..contract(_data)
  error: method = .string
    return _data.error()

family: class
  _data = reference .llir..schema_data
  _identity = .int
  _id = .int
  *: factory
    arg data = reference .llir..schema_data, id = .int
    _data = data; store = dereference data; _identity = store.identity(); _id = id
    return
  valid: method = .int
    if <refvalid>(_data) = 0 then return 0
    store = dereference _data
    return _identity = store.identity() & _id > 0
  type: method = .llir..typeid
    arg name = .string, codec = .object
    if valid() = 0 then call bad('LL_IR_OWNER: schema family expired')
    store = dereference _data
    i = store.addtype(store.familyname(_id) || '.' || name,codec)
    return .llir..typeid(_identity,i)
  operation: method = .llir..operation
    arg name = .string
    if valid() = 0 then call bad('LL_IR_OWNER: schema family expired')
    store = dereference _data
    i = store.addop(store.familyname(_id) || '.' || name)
    return .llir..operation(_data,i)

operation: class
  _data = reference .llir..schema_data
  _identity = .int
  _id = .int
  *: factory
    arg data = reference .llir..schema_data, id = .int
    _data = data; store = dereference data; _identity = store.identity(); _id = id
    return
  schemaid: method = .int
    return _identity
  id: method = .int
    return _id
  valid: method = .int
    if <refvalid>(_data) = 0 then return 0
    store = dereference _data
    return _identity = store.identity() & _id > 0
  input: method = .void
    arg name = .string, type = .llir..typeid
    if valid() = 0 then call bad('LL_IR_OWNER: operation descriptor expired')
    store = dereference _data; call store.field(_id,1,name,type)
    return
  output: method = .void
    arg name = .string, type = .llir..typeid
    if valid() = 0 then call bad('LL_IR_OWNER: operation descriptor expired')
    store = dereference _data; call store.field(_id,2,name,type)
    return
  attribute: method = .void
    arg name = .string, type = .llir..typeid
    if valid() = 0 then call bad('LL_IR_OWNER: operation descriptor expired')
    store = dereference _data; call store.field(_id,3,name,type)
    return
  state: method = .void
    arg text = .string
    if valid() = 0 then call bad('LL_IR_OWNER: operation descriptor expired')
    store = dereference _data; call store.effect(_id,1,text)
    return
  failure: method = .void
    arg text = .string
    if valid() = 0 then call bad('LL_IR_OWNER: operation descriptor expired')
    store = dereference _data; call store.effect(_id,2,text)
    return
  termination: method = .void
    arg text = .string
    if valid() = 0 then call bad('LL_IR_OWNER: operation descriptor expired')
    store = dereference _data; call store.effect(_id,3,text)
    return
  evaluator: method = .void
    arg service = .object
    if valid() = 0 then call bad('LL_IR_OWNER: operation descriptor expired')
    store = dereference _data; call store.service(_id,1,service)
    return
  verifier: method = .void
    arg service = .object
    if valid() = 0 then call bad('LL_IR_OWNER: operation descriptor expired')
    store = dereference _data; call store.service(_id,2,service)
    return
  lowerer: method = .void
    arg service = .object
    if valid() = 0 then call bad('LL_IR_OWNER: operation descriptor expired')
    store = dereference _data; call store.service(_id,3,service)
    return

contract: class
  _data = .llir..schema_data
  *: factory
    arg data = .llir..schema_data
    _data = data
    return
  error: method = .string
    if _data.sealed() = 0 then return 'LL_IR_SCHEMA: contract is not frozen'
    return _data.error()
  identity: method = .int
    return _data.identity()
  data: method = reference .llir..schema_data
    return reference _data
  type: method = .llir..typeid
    arg name = .string
    return .llir..typeid(_data.identity(),_data.typeindex(name))
  operation: method = .llir..operation
    arg name = .string
    return .llir..operation(reference _data,_data.opindex(name))
  voidtype: method = .llir..typeid
    return .llir..typeid(_data.identity(),1)
  boolean: method = .llir..typeid
    return .llir..typeid(_data.identity(),2)
  manifest: method = .string
    return _data.manifest()

/** Owned graph. Only drafts mutate it. All public results are verified/frozen.
 * Numeric table IDs: functions, blocks, operations, values, slots, operands,
 * edges, constants, origins, sources, attributes, arguments, origin parents.
 */
arena: class
  _identity = .int
  _contract = .llir..contract
  _sealed = .int
  _error = .string
  _entries = .int
  _bytes = .int
  _entrylimit = .int
  _bytelimit = .int
  _pool = .binary[]
  _t1 = .llir..table
  _t2 = .llir..table
  _t3 = .llir..table
  _t4 = .llir..table
  _t5 = .llir..table
  _t6 = .llir..table
  _t7 = .llir..table
  _t8 = .llir..table
  _t9 = .llir..table
  _t10 = .llir..table
  _t11 = .llir..table
  _t12 = .llir..table
  _t13 = .llir..table
  *: factory
    arg contract = .llir..contract, entries = 1000000, bytes = 67108864
    _identity = nextidentity(); _contract = contract; _sealed = 0; _error = contract.error()
    _entries = 0; _bytes = 0; _entrylimit = entries; _bytelimit = bytes
    if entries < 1 | bytes < 1 then _error = 'LL_IR_BUDGET: entries and bytes must be positive'
    _t1 = .llir..table(6)
    _t2 = .llir..table(4)
    _t3 = .llir..table(12)
    _t4 = .llir..table(4)
    _t5 = .llir..table(4)
    _t6 = .llir..table(1)
    _t7 = .llir..table(1)
    _t8 = .llir..table(2)
    _t9 = .llir..table(6)
    _t10 = .llir..table(2)
    _t11 = .llir..table(4)
    _t12 = .llir..table(3)
    _t13 = .llir..table(1)
    return
  identity: method = .int
    return _identity
  sealed: method = .int
    return _sealed
  error: method = .string
    return _error
  contract: method = reference .llir..contract
    return reference _contract
  fail: method = .void
    arg message = .string, op = 0, semanticcheck = 0
    if _sealed & semanticcheck = 0 then call bad('LL_IR_LIFECYCLE: module is frozen')
    if _error <> '' then return
    _error = message
    if op > 0 & op <= count(3) then do
      _error = _error || ' (operation ' || op || ')'
      source = get(3,op,11)
      if source > 0 & source <= count(9) then do
        file = get(9,source,1)
        if file > 0 & file <= count(10) then _error = _error || ' at ' || text(get(10,file,1)) || ':byte ' || get(9,source,2)
      end
    end
    return
  reserve: method = .int
    arg entries = .int, bytes = .int
    if _sealed then do
      call bad('LL_IR_LIFECYCLE: module is frozen'); return 0
    end
    if _error <> '' then return 0
    if entries < 0 | bytes < 0 then do
      call fail('LL_IR_BUDGET: negative reservation'); return 0
    end
    if entries > _entrylimit - _entries then do
      call fail('LL_RESOURCE_LIMIT: ir.entries budget ' || _entrylimit || '; increase the host budget'); return 0
    end
    if bytes > _bytelimit - _bytes then do
      call fail('LL_RESOURCE_LIMIT: ir.bytes budget ' || _bytelimit || '; increase the host budget'); return 0
    end
    _entries = _entries + entries; _bytes = _bytes + bytes
    return 1
  entries: method = .int
    return _entries
  bytes: method = .int
    return _bytes
  capacity: method = .int
    total = _bytes
    total = total + _t1.bytes() - _t1.usedbytes()
    total = total + _t2.bytes() - _t2.usedbytes()
    total = total + _t3.bytes() - _t3.usedbytes()
    total = total + _t4.bytes() - _t4.usedbytes()
    total = total + _t5.bytes() - _t5.usedbytes()
    total = total + _t6.bytes() - _t6.usedbytes()
    total = total + _t7.bytes() - _t7.usedbytes()
    total = total + _t8.bytes() - _t8.usedbytes()
    total = total + _t9.bytes() - _t9.usedbytes()
    total = total + _t10.bytes() - _t10.usedbytes()
    total = total + _t11.bytes() - _t11.usedbytes()
    total = total + _t12.bytes() - _t12.usedbytes()
    total = total + _t13.bytes() - _t13.usedbytes()
    return total
  poolsize: method = .int
    return _pool[0]
  pool: method = .int
    arg bits = .binary
    if reserve(1,<blen>(bits)) = 0 then return 0
    i = _pool[0] + 1; _pool[i] = bits
    return i
  bits: method = .binary
    arg id = .int
    if id < 1 | id > _pool[0] then call bad('LL_IR_POOL: invalid byte-pool reference')
    return _pool[id]
  text: method = .string
    arg id = .int
    return bits(id) as .string
  count: method = .int
    arg table = .int
    select table
      when 1 then return _t1.size()
      when 2 then return _t2.size()
      when 3 then return _t3.size()
      when 4 then return _t4.size()
      when 5 then return _t5.size()
      when 6 then return _t6.size()
      when 7 then return _t7.size()
      when 8 then return _t8.size()
      when 9 then return _t9.size()
      when 10 then return _t10.size()
      when 11 then return _t11.size()
      when 12 then return _t12.size()
      when 13 then return _t13.size()
      otherwise call bad('LL_IR_TABLE: unknown table')
    end
    return 0
  width: method = .int
    arg table = .int
    return word('6 4 12 4 4 1 1 2 6 2 4 3 1',table) as .int
  get: method = .int
    arg table = .int, row = .int, col = .int
    select table
      when 1 then return _t1.get(row,col)
      when 2 then return _t2.get(row,col)
      when 3 then return _t3.get(row,col)
      when 4 then return _t4.get(row,col)
      when 5 then return _t5.get(row,col)
      when 6 then return _t6.get(row,col)
      when 7 then return _t7.get(row,col)
      when 8 then return _t8.get(row,col)
      when 9 then return _t9.get(row,col)
      when 10 then return _t10.get(row,col)
      when 11 then return _t11.get(row,col)
      when 12 then return _t12.get(row,col)
      when 13 then return _t13.get(row,col)
      otherwise call bad('LL_IR_TABLE: unknown table')
    end
    return 0
  put: method = .void
    arg table = .int, row = .int, col = .int, number = .int
    if _sealed then do
      call bad('LL_IR_LIFECYCLE: module is frozen'); return
    end
    if _error <> '' then return
    select table
      when 1 then call _t1.put(row,col,number)
      when 2 then call _t2.put(row,col,number)
      when 3 then call _t3.put(row,col,number)
      when 4 then call _t4.put(row,col,number)
      when 5 then call _t5.put(row,col,number)
      when 6 then call _t6.put(row,col,number)
      when 7 then call _t7.put(row,col,number)
      when 8 then call _t8.put(row,col,number)
      when 9 then call _t9.put(row,col,number)
      when 10 then call _t10.put(row,col,number)
      when 11 then call _t11.put(row,col,number)
      when 12 then call _t12.put(row,col,number)
      when 13 then call _t13.put(row,col,number)
      otherwise call bad('LL_IR_TABLE: unknown table')
    end
