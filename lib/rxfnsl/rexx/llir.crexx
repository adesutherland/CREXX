  add: method = .int
    arg table = .int
    if reserve(1,width(table) * 4) = 0 then return 0
    select table
      when 1 then return _t1.add()
      when 2 then return _t2.add()
      when 3 then return _t3.add()
      when 4 then return _t4.add()
      when 5 then return _t5.add()
      when 6 then return _t6.add()
      when 7 then return _t7.add()
      when 8 then return _t8.add()
      when 9 then return _t9.add()
      when 10 then return _t10.add()
      when 11 then return _t11.add()
      when 12 then return _t12.add()
      when 13 then return _t13.add()
      otherwise call bad('LL_IR_TABLE: unknown table')
    end
    return 0
  validtype: method = .int
    arg type = .llir..typeid, allowvoid = 0
    schema = dereference _contract.data()
    if type.schemaid() <> schema.identity() | type.id() < 2 - allowvoid | type.id() > schema.types() then do
      call fail('LL_IR_TYPE: foreign, absent or invalid type'); return 0
    end
    return 1
  function: method = .int
    arg name = .string, type = .llir..typeid
    if validtype(type,1) = 0 then return 0
    do i = 1 to count(1)
      if text(get(1,i,1)) = name then do
        call fail('LL_IR_FUNCTION: duplicate function ' || name); return 0
      end
    end
    if name = '' then do
      call fail('LL_IR_FUNCTION: function name is empty'); return 0
    end
    nameid = pool(name as .binary); id = add(1)
    if id = 0 then return 0
    call put(1,id,1,nameid); call put(1,id,2,type.id())
    return id
  block: method = .int
    arg fn = .int, name = .string
    if fn < 1 | fn > count(1) then do
      call fail('LL_IR_OWNER: block requires an owning function'); return 0
    end
    do i = 1 to count(2)
      if get(2,i,1) = fn & text(get(2,i,4)) = name then do
        call fail('LL_IR_BLOCK: duplicate block name ' || name); return 0
      end
    end
    nameid = pool(name as .binary); id = add(2)
    if id = 0 then return 0
    call put(2,id,1,fn); call put(2,id,4,nameid)
    if get(1,fn,3) = 0 then call put(1,fn,3,id)
    return id
  slot: method = .int
    arg fn = .int, name = .string, type = .llir..typeid
    if validtype(type) = 0 then return 0
    if fn < 1 | fn > count(1) then do
      call fail('LL_IR_OWNER: slot requires an owning function'); return 0
    end
    do i = 1 to count(5)
      if get(5,i,1) = fn & text(get(5,i,3)) = name then do
        call fail('LL_IR_SLOT: duplicate slot name ' || name); return 0
      end
    end
    nameid = pool(name as .binary); id = add(5)
    if id = 0 then return 0
    call put(5,id,1,fn); call put(5,id,2,type.id()); call put(5,id,3,nameid)
    return id
  argument: method = .int
    arg fn = .int, type = .llir..typeid, optional = 0
    if reserve(0,0) = 0 then return 0
    if optional <> 0 & optional <> 1 then do
      call fail('LL_IR_SIGNATURE: optional flag must be 0 or 1'); return 0
    end
    if validtype(type) = 0 then return 0
    if fn < 1 | fn > count(1) then do
      call fail('LL_IR_OWNER: argument requires an owning function'); return 0
    end
    if get(1,fn,3) <> 0 then do
      call fail('LL_IR_SIGNATURE: declare arguments before blocks'); return 0
    end
    ordinal = get(1,fn,5) + 1; id = add(12)
    if id = 0 then return 0
    if ordinal = 1 then call put(1,fn,4,id)
    else if id <> get(1,fn,4) + ordinal - 1 then do
      call fail('LL_IR_SIGNATURE: finish one argument list before starting another'); return 0
    end
    call put(12,id,1,fn); call put(12,id,2,type.id()); call put(12,id,3,optional); call put(1,fn,5,ordinal)
    return ordinal
  source: method = .int
    arg name = .string, bytes = .binary
    nameid = pool(name as .binary); dataid = pool(bytes); id = add(10)
    if id = 0 then return 0
    call put(10,id,1,nameid); call put(10,id,2,dataid)
    return id
  origin: method = .int
    arg source = .int, first = .int, last = .int, kind = 1, parent = 0
    if source < 1 | source > count(10) | first < 0 | last < first | kind < 1 | kind > 5 then do
      call fail('LL_IR_ORIGIN: invalid source range or provenance'); return 0
    end
    sourcebytes = bits(get(10,source,2)); extent = <blen>(sourcebytes)
    if last > extent | parent < 0 | parent > count(9) then do
      call fail('LL_IR_ORIGIN: range or parent is outside its source'); return 0
    end
    id = add(9)
    if id = 0 then return 0
    call put(9,id,1,source); call put(9,id,2,first); call put(9,id,3,last); call put(9,id,4,kind)
    if parent > 0 then do
      link = add(13)
      if link = 0 then return 0
      call put(13,link,1,parent); call put(9,id,5,link); call put(9,id,6,1)
    end
    return id
  constant: method = .int
    arg type = .llir..typeid, bits = .binary
    if validtype(type) = 0 then return 0
    schema = dereference _contract.data(); codec = schema.codec(type.id()) as .llir..typecodec
    message = codec.check(bits)
    if message <> '' then do
      call fail('LL_IR_CONSTANT: ' || message); return 0
    end
    dataid = pool(bits); id = add(8)
    if id = 0 then return 0
    call put(8,id,1,type.id()); call put(8,id,2,dataid)
    return id
  append: method = .int
    arg blockid = .int, opcode = .int, operands = .int[], types = .int[], edges = .int[], originid = .int, aux = 0
    if blockid < 1 | blockid > count(2) then do
      call fail('LL_IR_OWNER: operation requires a blockid'); return 0
    end
    if originid < 1 | originid > count(9) then do
      call fail('LL_IR_ORIGIN: operation requires an originid'); return 0
    end
    last = get(2,blockid,3)
    if last > 0 then do
      previous = get(3,last,1)
      if (previous >= 5 & previous <= 7) | previous = 10 then do
        call fail('LL_IR_TERMINATOR: operation follows a terminator',last); return 0
      end
    end
    id = add(3)
    if id = 0 then return 0
    call put(3,id,1,opcode); call put(3,id,2,blockid); call put(3,id,11,originid); call put(3,id,12,aux)
    if last = 0 then call put(2,blockid,2,id)
    else call put(3,last,3,id)
    call put(2,blockid,3,id)
    call put(3,id,4,count(6) + 1); call put(3,id,5,operands[0])
    item = .int; i = .int
    do i = 1 to operands[0]
      item = add(6)
      if item = 0 then return 0
      call put(6,item,1,operands[i])
    end
    call put(3,id,6,count(4) + 1); call put(3,id,7,types[0])
    do i = 1 to types[0]
      item = add(4)
      if item = 0 then return 0
      call put(4,item,1,id); call put(4,item,2,i); call put(4,item,3,types[i])
    end
    call put(3,id,8,count(7) + 1); call put(3,id,9,edges[0])
    do i = 1 to edges[0]
      item = add(7)
      if item = 0 then return 0
      call put(7,item,1,edges[i])
    end
    return id
  operand: method = .int
    arg op = .int, index = .int
    if index < 1 | index > get(3,op,5) then call bad('LL_IR_OPERAND: ordinal is outside operation')
    return get(6,get(3,op,4) + index - 1,1)
  result: method = .int
    arg op = .int, index = 1
    if op = 0 then return 0
    if index < 1 | index > get(3,op,7) then call bad('LL_IR_RESULT: ordinal is outside operation')
    return get(3,op,6) + index - 1
  successor: method = .int
    arg op = .int, index = .int
    if index < 1 | index > get(3,op,9) then call bad('LL_IR_EDGE: ordinal is outside operation')
    return get(7,get(3,op,8) + index - 1,1)
  opname: method = .string
    arg opcode = .int
    if opcode >= 1 & opcode <= 10 then return 'core.' || word('constant argument load store jump branch return hasarg optionalargument protect',opcode)
    schema = dereference _contract.data()
    if opcode > 16 & opcode <= schema.ops() + 16 then return schema.opname(opcode - 16)
    return '<unknown>'
  /** Verifies every record, including unreachable blocks. Raw decoding does not
   * bypass this gate. No successful owner is published on failure. */
  verify: method = .int
    if _error <> '' then return 0
    schema = dereference _contract.data()
    i = .int; j = .int; k = .int; fn = .int; blockid = .int; op = .int; type = .int
    name = .string; total = .int; start = .int; last = .int; v = .int; recordid = .int
    usedinputs = .int[]; usededges = .int[]; usedparents = .int[]
    totalparents = 0; totalargs = 0
    if count(1) = 0 then call fail('LL_IR_MODULE: module has no functions')
    do i = 1 to count(10) while _error = ''
      name = text(get(10,i,1)); bytes = bits(get(10,i,2))
      if name = '' then call fail('LL_IR_SOURCE: source identity is empty')
    end
    do i = 1 to count(9) while _error = ''
      source = get(9,i,1); first = get(9,i,2); last = get(9,i,3); kind = get(9,i,4)
      if source < 1 | source > count(10) | last < first | kind < 1 | kind > 5 then do
        call fail('LL_IR_ORIGIN: invalid source range or provenance'); leave
      end
      sourcebytes = bits(get(10,source,2)); extent = <blen>(sourcebytes)
      if last > extent then call fail('LL_IR_ORIGIN: source range exceeds input')
      if kind = 5 then call fail('LL_IR_RECOVERED: recovered input cannot produce an executable module')
      start = get(9,i,5); total = get(9,i,6)
      if total = 0 & start <> 0 then call fail('LL_IR_ORIGIN: empty contributor range must have zero start')
      if total > 0 then do
        if start < 1 | total > count(13) | start > count(13) - total + 1 then do
          call fail('LL_IR_ORIGIN: invalid contributing origins'); leave
        end
        do j = start to start + total - 1
          if usedparents[j] then call fail('LL_IR_OWNERSHIP: overlapping origin contributors')
          usedparents[j] = 1; totalparents = totalparents + 1
          parent = get(13,j,1)
          if parent < 1 | parent >= i then call fail('LL_IR_ORIGIN: origin parents must precede their child')
        end
      end
    end
    do i = 1 to count(8) while _error = ''
      type = get(8,i,1)
      if type < 2 | type > schema.types() then do
        call fail('LL_IR_TYPE: invalid constant type'); leave
      end
      codec = schema.codec(type) as .llir..typecodec
      message = codec.check(bits(get(8,i,2)))
      if message <> '' then call fail('LL_IR_CONSTANT: ' || message)
    end
    do fn = 1 to count(1) while _error = ''
      name = text(get(1,fn,1)); type = get(1,fn,2); blockid = get(1,fn,3)
      if name = '' | type < 1 | type > schema.types() | blockid < 1 | blockid > count(2) then do
        call fail('LL_IR_FUNCTION: invalid name, signature or entry block'); leave
      end
      do i = 1 to fn - 1
        if text(get(1,i,1)) = name then call fail('LL_IR_FUNCTION: duplicate function ' || name)
      end
      if get(2,blockid,1) <> fn then call fail('LL_IR_OWNER: entry block belongs to another function')
      exportid = get(1,fn,6)
      if exportid > 0 then do
        if exportid > poolsize() then do
          call fail('LL_IR_EXPORT: invalid export name'); leave
        end
        if text(exportid) = '' then call fail('LL_IR_EXPORT: empty export name')
        do i = 1 to fn - 1
          otherexport = get(1,i,6)
          if otherexport > 0 then do
            if text(otherexport) == text(exportid) then call fail('LL_IR_EXPORT: duplicate export name')
          end
        end
      end
      total = get(1,fn,5); start = get(1,fn,4); totalargs = totalargs + total
      if total = 0 & start <> 0 then call fail('LL_IR_SIGNATURE: empty argument range must have zero start')
      if total > 0 then do
        if start < 1 | total > count(12) | start > count(12) - total + 1 then do
          call fail('LL_IR_SIGNATURE: argument range is outside table'); leave
        end
        do i = start to start + total - 1
          type = get(12,i,2)
          if get(12,i,1) <> fn | type < 2 | type > schema.types() | get(12,i,3) > 1 then call fail('LL_IR_SIGNATURE: invalid argument')
        end
      end
    end
    do i = 1 to count(5) while _error = ''
      fn = get(5,i,1); type = get(5,i,2); name = text(get(5,i,3))
      if get(5,i,4) <> 0 then call fail('LL_IR_RESERVED: nonzero slot reserved field')
      if fn < 1 | fn > count(1) | type < 2 | type > schema.types() | name = '' then call fail('LL_IR_SLOT: invalid slot')
      do j = 1 to i - 1
        if get(5,j,1) = fn & text(get(5,j,3)) = name then call fail('LL_IR_SLOT: duplicate slot ' || name)
      end
    end
    seen = .int[]; totalops = 0; operands = 0; results = 0; edges = 0; attributes = 0
    do blockid = 1 to count(2) while _error = ''
      fn = get(2,blockid,1); op = get(2,blockid,2); last = get(2,blockid,3); name = text(get(2,blockid,4))
      if fn < 1 | fn > count(1) | op < 1 | op > count(3) | last < 1 | last > count(3) | name = '' then do
        call fail('LL_IR_BLOCK: invalid or unterminated block'); leave
      end
      do j = 1 to blockid - 1
        if get(2,j,1) = fn & text(get(2,j,4)) = name then call fail('LL_IR_BLOCK: duplicate block ' || name)
      end
      do while op > 0 & _error = ''
        if op > count(3) then do
          call fail('LL_IR_ORDER: operation link is outside table'); leave
        end
        if seen[op] then do
          call fail('LL_IR_ORDER: operation chain is cyclic or shared',op); leave
        end
        seen[op] = 1; totalops = totalops + 1
        if get(3,op,2) <> blockid then do
          call fail('LL_IR_OWNER: operation belongs to another block',op); leave
        end
        opcode = get(3,op,1); originid = get(3,op,11)
        if originid < 1 | originid > count(9) then call fail('LL_IR_ORIGIN: operation has no valid origin',op)
        if (opcode < 1 | opcode > 10) & (opcode <= 16 | opcode > schema.ops() + 16) then call fail('LL_IR_OPCODE: unknown operation',op)
        do k = 1 to 3
          tableid = word('6 4 7',k) as .int; column = 2 + 2 * k
          start = get(3,op,column); total = get(3,op,column + 1)
          if start < 1 | total > count(tableid) | start > count(tableid) - total + 1 then call fail('LL_IR_RANGE: invalid operand/result/edge range',op)
        end
        if _error <> '' then leave
        nin = get(3,op,5); nout = get(3,op,7); nedge = get(3,op,9)
        operands = operands + nin; results = results + nout; edges = edges + nedge
        do i = 1 to nin
          recordid = get(3,op,4) + i - 1
          if usedinputs[recordid] then call fail('LL_IR_OWNERSHIP: overlapping operand ranges',op)
          usedinputs[recordid] = 1
          v = operand(op,i)
          if v < 1 | v > count(4) then do
            call fail('LL_IR_VALUE: operand has no definition',op); leave
          end
          def = get(4,v,1)
          if def < 1 | def >= op then do
            call fail('LL_IR_ORDER: value must be defined earlier',op); leave
          end
          if seen[def] = 0 | get(3,def,2) <> blockid then call fail('LL_IR_VALUE: temporary crosses a block; use a typed slot',op)
        end
        do i = 1 to nout
          v = result(op,i); type = get(4,v,3)
          if get(4,v,4) <> 0 then call fail('LL_IR_RESERVED: nonzero value reserved field',op)
          if get(4,v,1) <> op | get(4,v,2) <> i | type < 2 | type > schema.types() then call fail('LL_IR_RESULT: invalid result definition',op)
        end
        do i = 1 to nedge
          recordid = get(3,op,8) + i - 1
          if usededges[recordid] then call fail('LL_IR_OWNERSHIP: overlapping successor ranges',op)
          usededges[recordid] = 1
          target = successor(op,i)
          if target < 1 | target > count(2) then do
            call fail('LL_IR_EDGE: unknown successor',op); leave
          end
          if get(2,target,1) <> fn then call fail('LL_IR_OWNER: successor crosses a function boundary',op)
        end
        if _error <> '' then leave
        aux = get(3,op,12)
        if ((opcode >= 5 & opcode <= 7) | opcode = 10 | opcode > 16) & aux <> 0 then call fail('LL_IR_RESERVED: nonzero operation auxiliary field',op)
        if opcode <= 10 & get(3,op,10) <> 0 then call fail('LL_IR_ATTRIBUTE: core operation cannot have attributes',op)
        select opcode
          when 1 then do
            if nin <> 0 | nout <> 1 | nedge <> 0 | aux < 1 | aux > count(8) then call fail('LL_IR_CONSTANT: invalid constant operation',op)
            else if get(4,result(op),3) <> get(8,aux,1) then call fail('LL_IR_TYPE: constant result has the wrong type',op)
          end
          when 2 then do
            if nin <> 0 | nout <> 1 | nedge <> 0 | aux < 1 | aux > get(1,fn,5) then call fail('LL_IR_SIGNATURE: invalid argument operation',op)
            else if get(12,get(1,fn,4) + aux - 1,3) <> 0 then call fail('LL_IR_SIGNATURE: optional argument requires fallback',op)
            else if get(4,result(op),3) <> get(12,get(1,fn,4) + aux - 1,2) then call fail('LL_IR_TYPE: argument result has the wrong type',op)
          end
          when 3 then do
            if nin <> 0 | nout <> 1 | nedge <> 0 | aux < 1 | aux > count(5) then call fail('LL_IR_SLOT: invalid load',op)
            else if get(5,aux,1) <> fn | get(5,aux,2) <> get(4,result(op),3) then call fail('LL_IR_TYPE: load slot owner/type mismatch',op)
          end
          when 4 then do
            if nin <> 1 | nout <> 0 | nedge <> 0 | aux < 1 | aux > count(5) then call fail('LL_IR_SLOT: invalid store',op)
            else if get(5,aux,1) <> fn | get(5,aux,2) <> get(4,operand(op,1),3) then call fail('LL_IR_TYPE: store slot owner/type mismatch',op)
          end
          when 5 then do
            if nin <> 0 | nout <> 0 | nedge <> 1 then call fail('LL_IR_TERMINATOR: jump needs one successor',op)
          end
          when 6 then do
            if nin <> 1 | nout <> 0 | nedge <> 2 then call fail('LL_IR_TERMINATOR: branch needs a Boolean and two successors',op)
            else if get(4,operand(op,1),3) <> 2 then call fail('LL_IR_TYPE: branch requires core.boolean',op)
          end
          when 7 then do
            type = get(1,fn,2)
            if nout <> 0 | nedge <> 0 | (type = 1 & nin <> 0) | (type <> 1 & nin <> 1) then call fail('LL_IR_SIGNATURE: return does not match function result',op)
            else if nin = 1 then do
              if get(4,operand(op,1),3) <> type then call fail('LL_IR_TYPE: return type does not match function result',op)
            end
          end
          when 8 then do
            if nin <> 0 | nout <> 1 | nedge <> 0 | aux < 1 | aux > get(1,fn,5) then call fail('LL_IR_SIGNATURE: invalid presence operation',op)
            else if get(4,result(op),3) <> 2 then call fail('LL_IR_TYPE: presence requires core.boolean',op)
          end
          when 9 then do
            if nin <> 1 | nout <> 1 | nedge <> 0 | aux < 1 | aux > get(1,fn,5) then call fail('LL_IR_SIGNATURE: invalid optional argument operation',op)
            else do
              formal = get(1,fn,4) + aux - 1; type = get(12,formal,2)
              if get(12,formal,3) <> 1 then call fail('LL_IR_SIGNATURE: required argument cannot have fallback',op)
              if get(4,result(op),3) <> type | get(4,operand(op,1),3) <> type then call fail('LL_IR_TYPE: fallback and argument types must agree',op)
            end
          end
          when 10 then do
            if nin <> 0 | nout <> 0 | nedge <> 2 then call fail('LL_IR_TERMINATOR: protect needs normal and exceptional successors',op)
          end
          otherwise do
            descriptor = opcode - 16
            if nin <> schema.arity(descriptor,1) | nout <> schema.arity(descriptor,2) | nedge <> 0 then call fail('LL_IR_ARITY: extension signature mismatch',op)
            do i = 1 to nin while _error = ''
              if get(4,operand(op,i),3) <> schema.fieldtype(descriptor,1,i) then call fail('LL_IR_TYPE: extension input ' || schema.fieldname(descriptor,1,i) || ' has the wrong type',op)
            end
            do i = 1 to nout while _error = ''
              if get(4,result(op,i),3) <> schema.fieldtype(descriptor,2,i) then call fail('LL_IR_TYPE: extension result type mismatch',op)
            end
            nattr = schema.arity(descriptor,3); start = get(3,op,10)
            if nattr = 0 & start <> 0 then call fail('LL_IR_ATTRIBUTE: empty attribute range must have zero start',op)
            if nattr > 0 then do
              if start < 1 | nattr > count(11) | start > count(11) - nattr + 1 then call fail('LL_IR_ATTRIBUTE: missing extension attributes',op)
              do i = 1 to nattr while _error = ''
                a = start + i - 1; constid = get(11,a,4)
                if get(11,a,1) <> op | get(11,a,2) <> i | constid < 1 | constid > count(8) then call fail('LL_IR_ATTRIBUTE: invalid attribute owner or constant',op)
                else if get(11,a,3) <> schema.fieldtype(descriptor,3,i) | get(8,constid,1) <> schema.fieldtype(descriptor,3,i) then call fail('LL_IR_TYPE: attribute type mismatch',op)
              end
            end
            attributes = attributes + nattr
          end
        end
        if (opcode >= 5 & opcode <= 7) | opcode = 10 then do
          if get(3,op,3) <> 0 | op <> last then call fail('LL_IR_TERMINATOR: terminator must end its block',op)
        end
        else if op = last | get(3,op,3) = 0 then call fail('LL_IR_TERMINATOR: block requires a terminator',op)
        op = get(3,op,3)
      end
    end
    if _error = '' then do
      if totalparents <> count(13) | totalargs <> count(12) then call fail('LL_IR_OWNERSHIP: orphan argument or origin contributor')
      if totalops <> count(3) | operands <> count(6) | results <> count(4) | edges <> count(7) | attributes <> count(11) then call fail('LL_IR_OWNERSHIP: orphan or overlapping records')
    end
    return _error = ''
  freeze: method = .int
    if _sealed then return _error = ''
    ok = 0
    do
      ok = verify()
    on signal
      call fail('LL_IR_INVALID: invalid record, encoding or semantic service')
    end
    _sealed = 1
    return ok & _error = ''

/** Borrowed function handle. A reference plus owner serial prevents stale reuse. */
function: class
  _owner = reference .llir..arena
  _identity = .int
  _id = .int
  *: factory
    arg owner = reference .llir..arena, id = .int
    _owner = owner; store = dereference owner; _identity = store.identity(); _id = id
    return
  id: method = .int
    return _id
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    store = dereference _owner
    return _identity = store.identity() & _id > 0 & _id <= store.count(1)
  belongs: method = .int
    arg owner = reference .llir..arena
    return valid() & (_owner <refsame> owner)
  require: method = .void
    if valid() = 0 then call bad('LL_IR_OWNER: function handle expired, replaced or invalid')
    return
  block: method = .llir..block
    arg name = .string
    call require(); store = dereference _owner
    id = store.block(_id,name)
    return .llir..block(_owner,id)
  slot: method = .llir..slot
    arg name = .string, type = .llir..typeid
    call require(); store = dereference _owner
    id = store.slot(_id,name,type)
    return .llir..slot(_owner,id)
  argument: method = .int
    arg type = .llir..typeid, optional = 0
    call require(); store = dereference _owner
    return store.argument(_id,type,optional)
  /** Export identity is structural; target naming rules belong to the consumer. */
  exportas: method = .void
    arg name = .string
    call require(); store = dereference _owner
    if store.reserve(0,0) = 0 then return
    if name = '' then call store.fail('LL_IR_EXPORT: empty export name')
    if store.get(1,_id,6) <> 0 then call store.fail('LL_IR_EXPORT: function already exported')
    do i = 1 to store.count(1)
      other = store.get(1,i,6)
      if other > 0 then do
        if store.text(other) == name then call store.fail('LL_IR_EXPORT: duplicate export name')
      end
    end
    if store.error() = '' then do
      id = store.pool(name as .binary); call store.put(1,_id,6,id)
    end
    return
  name: method = .string
    call require(); store = dereference _owner
    return store.text(store.get(1,_id,1))
  resulttype: method = .llir..typeid
    call require(); store = dereference _owner; contract = dereference store.contract()
    return .llir..typeid(contract.identity(),store.get(1,_id,2))
  arguments: method = .int
    call require(); store = dereference _owner
    return store.get(1,_id,5)
  formal: method = .int
    arg ordinal = .int
    call require(); store = dereference _owner
    if ordinal < 1 | ordinal > store.get(1,_id,5) then call bad('LL_IR_SIGNATURE: unknown argument ordinal')
    return store.get(1,_id,4) + ordinal - 1
  argumenttype: method = .llir..typeid
    arg ordinal = .int
    row = formal(ordinal); store = dereference _owner; contract = dereference store.contract()
    return .llir..typeid(contract.identity(),store.get(12,row,2))
  optional: method = .int
    arg ordinal = .int
    row = formal(ordinal); store = dereference _owner
    return store.get(12,row,3)
  exportname: method = .string
    call require(); store = dereference _owner; id = store.get(1,_id,6)
    if id = 0 then return ''
    return store.text(id)

/** Borrowed block handle. A reference plus owner serial prevents stale reuse. */
block: class
  _owner = reference .llir..arena
  _identity = .int
  _id = .int
  *: factory
    arg owner = reference .llir..arena, id = .int
    _owner = owner; store = dereference owner; _identity = store.identity(); _id = id
    return
  id: method = .int
    return _id
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    store = dereference _owner
    return _identity = store.identity() & _id > 0 & _id <= store.count(2)
  belongs: method = .int
    arg owner = reference .llir..arena
    return valid() & (_owner <refsame> owner)
  require: method = .void
    if valid() = 0 then call bad('LL_IR_OWNER: block handle expired, replaced or invalid')
    return
  first: method = .llir..opview
    call require(); store = dereference _owner
    return .llir..opview(_owner,store.get(2,_id,2))
  constant: method = .llir..valuehandle
    arg type = .llir..typeid, text = .string, at = .llir..origin
    call require(); store = dereference _owner; contract = dereference store.contract()
    schema = dereference contract.data(); bits = .binary
    if store.validtype(type) then do
      do
        codec = schema.codec(type.id()) as .llir..typecodec
        bits = codec.parse(text)
      on signal
        call store.fail('LL_IR_CONSTANT: invalid ' || schema.typename(type.id()) || ' literal')
      end
    end
    return constantbytes(type,bits,at)
  constantbytes: method = .llir..valuehandle
    arg type = .llir..typeid, bits = .binary, at = .llir..origin
    call require(); store = dereference _owner
    id = 0
    if at.belongs(_owner) = 0 then call store.fail('LL_IR_OWNER: constant origin belongs to another module')
    if store.error() = '' then do
      c = store.constant(type,bits); inputs = .int[]; types = .int[]; edges = .int[]; types[1] = type.id()
      if c > 0 then id = store.append(_id,1,inputs,types,edges,at.id(),c)
    end
    return .llir..valuehandle(_owner,store.result(id))
  binary: method = .llir..valuehandle
    arg opcode = .llir..operation, left = .llir..valuehandle, right = .llir..valuehandle, at = .llir..origin
    call require(); store = dereference _owner; contract = dereference store.contract(); schema = dereference contract.data()
    id = 0
    if opcode.schemaid() <> contract.identity() | opcode.id() < 1 | opcode.id() > schema.ops() then call store.fail('LL_IR_SCHEMA: foreign or invalid operation descriptor')
    if left.belongs(_owner) = 0 | right.belongs(_owner) = 0 | at.belongs(_owner) = 0 then call store.fail('LL_IR_OWNER: binary input or origin belongs to another module')
    if store.error() = '' then do
      if schema.arity(opcode.id(),1) <> 2 | schema.arity(opcode.id(),2) <> 1 | schema.arity(opcode.id(),3) <> 0 then call store.fail('LL_IR_ARITY: binary shorthand requires two inputs, one result and no attributes')
      else do
        inputs = .int[]; types = .int[]; edges = .int[]
        inputs[1] = left.id(); inputs[2] = right.id(); types[1] = schema.fieldtype(opcode.id(),2,1)
        id = store.append(_id,16 + opcode.id(),inputs,types,edges,at.id())
      end
    end
    return .llir..valuehandle(_owner,store.result(id))
  operation: method = .llir..opdraft
    arg opcode = .llir..operation, at = .llir..origin
    call require()
    return .llir..opdraft(_owner,_id,opcode,at)
  load: method = .llir..valuehandle
    arg target = .llir..slot, at = .llir..origin
    call require(); store = dereference _owner; id = 0
    if target.belongs(_owner) = 0 | at.belongs(_owner) = 0 then call store.fail('LL_IR_OWNER: load slot or origin belongs to another module')
    if store.error() = '' then do
      inputs = .int[]; types = .int[]; edges = .int[]; types[1] = store.get(5,target.id(),2)
      id = store.append(_id,3,inputs,types,edges,at.id(),target.id())
    end
    return .llir..valuehandle(_owner,store.result(id))
  store: method = .void
    arg target = .llir..slot, input = .llir..valuehandle, at = .llir..origin
    call require(); data = dereference _owner
    if target.belongs(_owner) = 0 | input.belongs(_owner) = 0 | at.belongs(_owner) = 0 then call data.fail('LL_IR_OWNER: store operands belong to another module')
    if data.error() = '' then do
      inputs = .int[]; types = .int[]; edges = .int[]; inputs[1] = input.id()
      id = data.append(_id,4,inputs,types,edges,at.id(),target.id())
    end
    return
  /** Read the invocation value without changing original presence. */
  readarg: method = .llir..valuehandle
    arg ordinal = .int, at = .llir..origin, ?fallback = .llir..valuehandle
    call require(); store = dereference _owner; id = 0; fn = store.get(2,_id,1)
    if store.reserve(0,0) = 0 then return .llir..valuehandle(_owner,0)
    if ordinal < 1 | ordinal > store.get(1,fn,5) then call store.fail('LL_IR_SIGNATURE: unknown argument ordinal')
    if at.belongs(_owner) = 0 then call store.fail('LL_IR_OWNER: argument origin belongs to another module')
    if ?fallback then do
      if fallback.belongs(_owner) = 0 then call store.fail('LL_IR_OWNER: foreign fallback value')
    end
    if store.error() = '' then do
      inputs = .int[]; types = .int[]; edges = .int[]
      row = store.get(1,fn,4) + ordinal - 1
      types[1] = store.get(12,row,2); opcode = 2
      if store.get(12,row,3) <> ?fallback then call store.fail('LL_IR_SIGNATURE: fallback must match argument optionality')
      if ?fallback then do
