/* cREXX License (MIT). Declarative source-tree to semantic-tree projection. */
options levelb
namespace llproject expose schema projection
import llcore
import lllimits
import llprepared

admitted: procedure = .int
  arg name = .string, kind = .int, arity = .int
  return name <> '' & kind >= 1 & arity >= 0 & arity <= 2
declaration: procedure = .int
  arg names_ref = reference .string[], count = .int, name = .string
  if <refvalid>(names_ref) = 0 then return 0
  names = dereference names_ref
  do i = 1 to count
    if names[i] = name then return i
  end
  return 0

/** Named productions to retain; unlisted structural wrappers are transparent.
 * Arity checks are obligations, not permission to truncate extra children.
 */
schema: class
  _size = .int
  _name = .string[]
  _kind = .int[]
  _arity = .int[]
  _error = .string
  _packed = .binary
  *: factory
    _size = 0; _error = ''
    return
  keep: method = .int
    arg name = .string, kind = .int, arity = .int
    if <blen>(_packed) > 0 then do
      return llprepared..frozenmutation('projection schema')
    end
    if admitted(name,kind,arity) = 0 | index(name) > 0 then do
      _error = 'invalid or duplicate tree projection declaration: ' || name; return 0
    end
    _size = _size + 1; _name[_size] = name; _kind[_size] = kind; _arity[_size] = arity
    return 1
  index: method = .int
    arg name = .string
    i = .int
    if <blen>(_packed) > 0 then do
      do i = 1 to _size
        at = 32 + (i - 1) * 24
        first = <at..u32>(at) _packed; length = <at..u32>(at + 4) _packed
        if llprepared..packedtext(reference _packed,first,length) = name then return i
      end
      return 0
    end
    do i = 1 to _size
      if _name[i] = name then return i
    end
    return 0
  size: method = .int
    return _size
  name: method = .string
    arg rule = .int
    if <blen>(_packed) > 0 then do
      if rule < 1 | rule > _size then return ''
      at = 32 + (rule - 1) * 24
      first = <at..u32>(at) _packed; length = <at..u32>(at + 4) _packed
      return llprepared..packedtext(reference _packed,first,length)
    end
    return _name[rule]
  kind: method = .int
    arg rule = .int
    if <blen>(_packed) > 0 then do
      if rule < 1 | rule > _size then return 0
      return <at..i64>(32 + (rule - 1) * 24 + 8) _packed
    end
    return _kind[rule]
  arity: method = .int
    arg rule = .int
    if <blen>(_packed) > 0 then do
      if rule < 1 | rule > _size then return 0
      return <at..i64>(32 + (rule - 1) * 24 + 16) _packed
    end
    return _arity[rule]
  error: method = .string
    return _error

  /** Owned prepared metadata; the operation-local budget never escapes. */
  image: method = .binary
    arg budget_ref = reference .llprepared..budget
    empty = .binary
    if _error <> '' then do; call llprepared..reject(3,_error); return empty; end
    out = .llprepared..writer(budget_ref)
    call out.raw('4c50524a'x as .binary); call out.u32(1); call out.u32(_size)
    do i = 1 to _size
      call out.text(name(i)); call out.i64(kind(i)); call out.i64(arity(i))
    end
    if out.status() <> 0 then do; call llprepared..reject(out.status(),out.error()); return empty; end
    return out.finish()

  /** Build-time read-ready fixed rows; no builder arrays are replayed on load. */
  frozenimage: method = .binary
    arg budget_ref = reference .llprepared..budget
    empty = .binary; i = .int
    if _error <> '' then do; call llprepared..reject(3,_error); return empty; end
    budget = dereference budget_ref
    if <blen>(_packed) > 0 then do
      if budget.take(<blen>(_packed)) = 0 then do; call llprepared..reject(4,budget.error()); return empty; end
      return _packed
    end
    if _size > (4294967295 - 32) <idiv> 24 then do; call llprepared..reject(4,'frozen projection extent'); return empty; end
    base = 32 + _size * 24
    if budget.take(base) = 0 then do; call llprepared..reject(4,budget.error()); return empty; end
    rows = .binary; call binresize rows,base
    <at..u32>(0) rows = 0x4a525046; <at..u32>(4) rows = 1
    <at..u32>(8) rows = _size; <at..u32>(16) rows = 32; <at..u32>(28) rows = base
    pool = .llprepared..writer(budget_ref); cursor = base
    do i = 1 to _size
      at = 32 + (i - 1) * 24; text = _name[i] as .binary; length = <blen>(text)
      if length > 4294967295 - cursor then do; call llprepared..reject(4,'frozen projection text extent'); return empty; end
      <at..u32>(at) rows = cursor; <at..u32>(at + 4) rows = length
      <at..i64>(at + 8) rows = _kind[i]; <at..i64>(at + 16) rows = _arity[i]
      call pool.raw(text); cursor = cursor + length
    end
    output = .llprepared..writer(budget_ref); call output.raw(rows); call output.raw(pool.finish())
    if pool.status() <> 0 then do; call llprepared..reject(pool.status(),pool.error()); return empty; end
    if output.status() <> 0 then do; call llprepared..reject(output.status(),output.error()); return empty; end
    return output.finish()

  /** Trusted compiled section: one native copy and scalar header reads only. */
  compiled: factory
    arg source_ref = reference .binary, first = .int, extent = .int
    source = dereference source_ref
    call binresize _packed,extent
    assembler bcopy _packed,source,first
    _size = <at..u32>(8) _packed; _error = ''
    return

  /** Hydrate checked arrays directly, preserving declaration order and case. */
  loaded: factory
    arg data = .binary, budget_ref = reference .llprepared..budget
    _size = 0; _error = 'invalid prepared projection section'
    input = .llprepared..reader(data,budget_ref)
    if input.expect('4c50524a'x as .binary) = 0 then do
      _error = input.error(); call llprepared..reject(input.status(),_error); return
    end
    version = input.u32()
    if input.status() <> 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
    if version <> 1 then do; call llprepared..reject(3,_error); return; end
    count = input.u32()
    if input.status() <> 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
    if count > input.remaining() <idiv> 20 then do; call llprepared..reject(3,_error); return; end
    if input.claim(count,256) = 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
    names = .string[]; kinds = .int[]; arities = .int[]
    _error = ''
    do i = 1 to count
      name = input.text(); kind = input.i64(); arity = input.i64()
      if input.status() <> 0 then leave
      if admitted(name,kind,arity) = 0 then do
        _error = 'invalid prepared projection declaration'; leave
      end
      if input.claim(i,1 + 4 * length(name)) = 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
      if declaration(reference names,i - 1,name) > 0 then _error = 'duplicate prepared projection declaration'
      if _error <> '' then leave
      names[i] = name; kinds[i] = kind; arities[i] = arity
    end
    if input.finish() = 0 then do; _error = input.error(); call llprepared..reject(input.status(),_error); return; end
    if _error <> '' then do; call llprepared..reject(3,_error); return; end
    _name = names; _kind = kinds; _arity = arities; _size = count
    return

/** Owned, bottom-up projection. Preserve source and origin for every kept node.
 * The map-entry budget is explicit; arbitrary transparent trees need not have
 * a linear-size map, even though termination follows from earlier-child IDs.
 */
projection: class
  _source = .llcore..tree
  _schema = .schema
  _out = .llcore..tree
  _wanted = .int
  _limit = .int
  _ran = .int
  _status = .int
  _root = .int
  _entries = .int
  _origin = .int[]
  _head = .int[]
  _count = .int[]
  _flat = .int[]
  _error = .string
  *: factory
    arg source = .llcore..tree, root = .int, rules = .schema, limit = 1000000
    _source = source; _wanted = root; _schema = rules; _limit = limit
    _out = .llcore..tree.from_source(source.source())
    _ran = 0; _status = 0; _root = 0; _entries = 0; _error = ''
    return
  run: method = .int
    i = .int
    if _ran then return _status
    _ran = 1
    if _schema.error() <> '' | _source.owns_source() = 0 | _source.validate() = 0 | _wanted < 1 | _wanted > _source.size() then do
      _status = 3; _error = 'invalid projection input: ' || _schema.error() || _source.error(); return _status
    end
    do node = 1 to _source.size()
      rule = _schema.index(_source.label(node))
      a = _source.left(node); b = _source.right(node)
      ca = 0; cb = 0
      if a > 0 then ca = _count[a]
      if b > 0 then cb = _count[b]
      arity = ca + cb
      _head[node] = _entries + 1
      if rule > 0 then do
        if arity <> _schema.arity(rule) then do
          _status = 3; _error = 'projection arity for ' || _source.label(node) || ': expected ' || _schema.arity(rule) || ', found ' || arity; return _status
        end
        first = 0; second = 0
        if ca > 0 then first = _flat[_head[a]]
        if ca > 1 then second = _flat[_head[a] + 1]
        if cb > 0 then do
          if first = 0 then first = _flat[_head[b]]
          else second = _flat[_head[b]]
          if cb > 1 then second = _flat[_head[b] + 1]
        end
        created = _out.add(_schema.kind(rule),_source.label(node),_source.start(node),_source.finish(node),first,second)
        _origin[created] = node
        call append(created); _count[node] = 1
      end
      else do
        do i = 0 to ca - 1
          call append(_flat[_head[a] + i])
        end
        do i = 0 to cb - 1
          call append(_flat[_head[b] + i])
        end
        _count[node] = arity
      end
      if _status > 0 then return _status
    end
    if _count[_wanted] <> 1 then do
      _status = 3; _error = 'projection requires exactly one selected root'; return _status
    end
    _root = _flat[_head[_wanted]]
    if _out.validate() = 0 then do
      _status = 3; _error = _out.error()
    end
    return _status
  append: method = .void
    arg value = .int
    if _entries >= _limit then do
      _status = 2; _error = lllimits..describe('tree.entries',_limit,_entries + 1); return
    end
    _entries = _entries + 1; _flat[_entries] = value
    return
  tree: method = .llcore..tree
    return _out
  root: method = .int
    return _root
  origin: method = .int
    arg node = .int
    return _origin[node]
  error: method = .string
    return _error
