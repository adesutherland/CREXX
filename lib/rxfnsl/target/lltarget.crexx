/* cREXX License (MIT). Optional checked machine-target records over Level L IR. */
options levelb
namespace lltarget expose draft bodydraft module body record operand operandcodec schema isrecord remapregisters remapmetadata normalsuccessors normalfallthrough
import rxfnsb
import llir
import llrxascatalog
import llsource

bad: procedure = .void
  arg message = .string
  assembler signal "ERROR",message
  return

/** Request work is shared by drafts through a reference, not copied per body. */
fuel: class
  _left = .int
  *: factory
    arg work = .int
    _left = work
    return
  take: method = .int
    arg owner = reference .llir..arena, count = .int
    store = dereference owner
    if store.error() <> '' then return 0
    if count < 0 | count > _left then do
      call store.fail('LL_RESOURCE_LIMIT: target.work budget'); return 0
    end
    _left = _left - count
    return 1
  remaining: method = .int
    return _left

/** Operands are typed values, never source instruction fragments. Register
 * operands additionally carry the exact draft owner, function and L slot. */
operand: class
  _kind = .string
  _bank = .string
  _index = .int
  _bytes = .binary
  _owner = .int
  _procedure = .int
  _slot = .int
  *: factory
    return
  integer: factory
    arg number = .int
    _kind = 'I'; _index = number
    return
  string: factory
    arg bytes = .binary
    _kind = 'S'; _bytes = bytes
    return
  symbol: factory
    arg text = .string
    _kind = 'L'; _bytes = text as .binary
    return
  procedure: factory
    arg name = .string
    _kind = 'P'; _bytes = name as .binary
    return
  literal: factory
    arg kind = .string, spelling = .binary
    _kind = kind; _bytes = spelling
    if literalerror(kind,spelling) <> '' then _kind = ''
    return
  bound: factory
    arg owner = .int, procedureid = .int, slotid = .int, bank = .string, index = .int
    _kind = 'R'; _owner = owner; _procedure = procedureid; _slot = slotid
    _bank = bank; _index = index
    return
  decoded: factory
    arg kind = .string, bank = .string, index = .int, bytes = .binary, owner = .int, procedureid = .int, slotid = .int
    _kind = kind; _bank = bank; _index = index; _bytes = bytes
    _owner = owner; _procedure = procedureid; _slot = slotid
    return
  kind: method = .string
    return _kind
  bank: method = .string
    return _bank
  index: method = .int
    return _index
  bytes: method = .binary
    return _bytes
  length: method = .int
    return <blen>(_bytes)
  byte: method = .int
    arg index = .int
    return <at..u8>(index) _bytes
  text: method = .string
    return _bytes as .string
  owner: method = .int
    return _owner
  procedureid: method = .int
    return _procedure
  slotid: method = .int
    return _slot

/** Version 1 vector: u32 count, then kind/bank u32, index i64,
 * function/slot/byte-length u32 and exact payload bytes. This is an internal
 * checked L attribute encoding, not an RXBIN format or packed host structure. */
operandcodec: class implements .llir..typecodec
  *: factory
    return
  parse: method = .binary
    arg text = .string
    codec = .llir..bytescodec()
    return codec.parse(text)
  check: method = .string
    arg bits = .binary
    size = <blen>(bits)
    if size < 4 then return 'target operand vector header'
    count = <at..u32>(0) bits; at = 4
    if count > (size - 4) / 28 then return 'target operand vector count'
    do i = 1 to count
      if at > size - 28 then return 'target operand vector truncated'
      kind = <at..u32>(at) bits; bank = <at..u32>(at + 4) bits
      index = <at..i64>(at + 8) bits; fn = <at..u32>(at + 16) bits
      slot = <at..u32>(at + 20) bits; length = <at..u32>(at + 24) bits
      if kind < 1 | kind > 9 | bank > 3 then return 'target operand tag'
      if kind = 1 then do
        if bank = 0 | index < 0 | fn = 0 | slot = 0 | length <> 0 then return 'target register operand'
      end
      else if bank <> 0 | fn <> 0 | slot <> 0 then return 'target nonregister binding'
      if kind = 2 & length <> 0 then return 'target integer operand'
      if length > size - at - 28 then return 'target operand bytes truncated'
      at = at + 28 + length
    end
    if at <> size then return 'target operand vector trailing bytes'
    return ''
  format: method = .string
    arg bits = .binary
    return bin2x(bits)

literalerror: procedure = .string
  arg kind = .string, spelling = .binary
  i = .int
  text = spelling as .string
  if kind = 'B' then do
    if left(lower(text),2) <> '0x' | (length(text) - 2) % 2 <> 0 then return 'binary spelling'
    do i = 3 to length(text)
      if pos(upper(substr(text,i,1)),'0123456789ABCDEF') = 0 then return 'binary digits'
    end
    return ''
  end
  if kind = 'C' then do
    if left(text,1) <> "'" | right(text,1) <> "'" then return 'character quoting'
    middle = substr(text,2,length(text) - 2)
    if length(middle) = 1 & middle <> "'" & middle <> '\' then return ''
    if length(middle) = 2 & left(middle,1) = '\' & right(middle,1) <> '0a'x & right(middle,1) <> '0d'x then return ''
    return 'character spelling'
  end
  if kind = 'F' then do
    special = lower(text)
    if left(special,1) = '+' | left(special,1) = '-' then special = substr(special,2)
    if special = 'inf' then return ''
    if lower(text) = 'nan' then return ''
    if left(lower(text),4) = 'nan(' & right(text,1) = ')' & length(text) = 21 then do
      do i = 5 to 20
        if pos(upper(substr(text,i,1)),'0123456789ABCDEF') = 0 then return 'NaN payload'
      end
      return ''
    end
    if pos('.',text) = 0 & pos('e',lower(text)) = 0 then return 'float requires float spelling'
  end
  else if kind = 'D' then do
    if right(text,1) <> 'd' then return 'decimal suffix'
    text = left(text,length(text) - 1)
  end
  else return 'literal kind'
  do i = 1 to length(text)
    if pos(substr(text,i,1),'0123456789+-.eE') = 0 then return 'numeric spelling'
  end
  if datatype(text,'N') = 0 then return 'numeric literal'
  return ''

pack: procedure = .binary
  arg fields = .object[], owner = reference .llir..arena, fuel_ref = reference .fuel
  work = dereference fuel_ref; store = dereference owner
  i = .int; j = .int
  size = 4; item = .operand
  do i = 1 to fields[0]
    item = fields[i] as .operand
    if item.length() > 2147483647 - size - 28 then do
      call store.fail('LL_RESOURCE_LIMIT: target operand size'); return ''x as .binary
    end
    size = size + 28 + item.length()
  end
  if store.canreserve(0,size) = 0 then return ''x as .binary
  if work.take(owner,size + fields[0]) = 0 then return ''x as .binary
  result = .binary; call binresize result,size
  <at..u32>(0) result = fields[0]; at = 4
  do i = 1 to fields[0]
    item = fields[i] as .operand
    <at..u32>(at) result = wordpos(item.kind(),'R I S L P F D C B')
    <at..u32>(at + 4) result = wordpos(item.bank(),'r g a')
    <at..i64>(at + 8) result = item.index()
    <at..u32>(at + 16) result = item.procedureid()
    <at..u32>(at + 20) result = item.slotid()
    <at..u32>(at + 24) result = item.length()
    do j = 0 to item.length() - 1
      <at..u8>(at + 28 + j) result = item.byte(j)
    end
    at = at + 28 + item.length()
  end
  return result

unpack: procedure = .operand
  arg bits = .binary, ordinal = .int, owner = .int
  i = .int
  if ordinal < 1 | ordinal > (<at..u32>(0) bits) then do
    call bad('LL_TARGET_OPERAND: ordinal outside vector'); return .operand()
  end
  at = 4
  do i = 1 to ordinal - 1
    at = at + 28 + (<at..u32>(at + 24) bits)
  end
  length = <at..u32>(at + 24) bits; bytes = .binary
  call binresize bytes,length
  do i = 0 to length - 1
    <at..u8>(i) bytes = <at..u8>(at + 28 + i) bits
  end
  kind = word('R I S L P F D C B',<at..u32>(at) bits)
  bank = ''; bankid = <at..u32>(at + 4) bits
  /* Zero is the declared nonregister bank sentinel, not a WORD ordinal. */
  if bankid > 0 then bank = word('r g a',bankid)
  return .operand.decoded(kind,bank,<at..i64>(at + 8) bits,bytes,owner,<at..u32>(at + 16) bits,<at..u32>(at + 20) bits)

schema: procedure = .llir..contract
  registry = .llir..schema(); family = registry.family('rxas.target',2)
  integer = family.type('integer',.llir..intcodec() as .object)
  bytes = family.type('bytes',.llir..bytescodec() as .object)
  vector = family.type('operands',.operandcodec() as .object)
  cell = family.type('cell',.llir..bytescodec() as .object)
  descriptor = family.operation('module')
  call descriptor.attribute('name',bytes); call descriptor.attribute('artifact',bytes)
  call descriptor.attribute('globals',integer); call descriptor.attribute('catalog',bytes)
  descriptor = family.operation('register')
  call descriptor.attribute('body',integer); call descriptor.attribute('slot',integer)
  call descriptor.attribute('bank',bytes); call descriptor.attribute('index',integer)
  descriptor = family.operation('record')
  call descriptor.attribute('kind',bytes); call descriptor.attribute('body',integer)
  call descriptor.attribute('opcode',integer); call descriptor.attribute('operands',vector)
  descriptor = family.operation('control')
  call descriptor.attribute('kind',bytes); call descriptor.attribute('body',integer)
  call descriptor.attribute('opcode',integer); call descriptor.attribute('operands',vector)
  call descriptor.control('terminal',0,2)
  /* No generic executable optimization may consume this target profile. */
  return registry.finish()

/** Source records share one checked field contract; structural L jumps do not
 * belong to source enumeration or rendering. */
isrecord: procedure = .int
  arg name = .string
  return name = 'rxas.target.record' | name = 'rxas.target.control'

/** -1 is ordinary fallthrough, -2 is an unrepresented normal transfer.
 * The canonical normal-flow contract is independent of effect precision:
 * conservative effects can still have exact fallthrough or direct targets.
 * Direct targets retain operand order, with lexical fallthrough last. */
normalsuccessors: procedure = .int
  arg opcode = .int
  catalog = .llrxascatalog..catalog()
  if opcode < 0 | opcode >= catalog.count() then return -2
  return catalog.normalsuccessors(opcode)

/** A one-target conditional has lexical fallthrough; a two-target
 * conditional supplies both successors explicitly. */
normalfallthrough: procedure = .int
  arg opcode = .int
  catalog = .llrxascatalog..catalog()
  if opcode < 0 | opcode >= catalog.count() then return 0
  return catalog.normalfallthrough(opcode)

integerbits: procedure = .binary
  arg value = .int
  result = .binary; call binresize result,8; <at..i64>(0) result = value
  return result

syntheticorigin: procedure = .llir..origin
  arg owner = reference .llir..arena, description = .string
  store = dereference owner
  source = store.source(description,''x as .binary)
  id = store.origin(source,0,0,4)
  return .llir..origin(owner,id)

findprocedure: procedure = .int
  arg owner = reference .llir..module, headers_ref = reference .int[], name = .string
  headers = dereference headers_ref
  do i = 1 to headers[0]
    header = .record(owner,headers[i]); item = header.operand(1)
    if item.text() == name then return header.procedureid()
  end
  return 0

namesafe: procedure = .int
  arg text = .string, empty = 0
  if text = '' then return empty
  if pos(substr(text,1,1),'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_§') = 0 then return 0
  do i = 2 to length(text)
    if pos(substr(text,i,1),'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_§.-#') = 0 then return 0
  end
  return 1

/** An executable qualified procedure reference is syntactically typed here;
 * only the frozen image/linker owner can validate and seal its identities. */
qualifiedprocedure: procedure = .int
  arg text = .string
  if left(text,1) <> '@' then return 0
  separator = pos('::',text)
  if separator < 3 | separator + 2 > length(text) then return 0
  module = substr(text,2,separator - 2); member = substr(text,separator + 2)
  if length(module) > 10 | length(member) > 10 then return 0
  if verify(module,'0123456789') <> 0 | verify(member,'0123456789') <> 0 then return 0
  moduleindex = module as .int; memberindex = member as .int
  if moduleindex > 4294967295 | memberindex > 4294967295 then return 0
  return 1

recordshape: procedure = .string
  arg item = .lltarget..record
  signature = ''; field = .operand; i = .int
  do i = 1 to item.operands()
    field = item.operand(i); signature = signature || field.kind()
  end
  kind = item.kind(); body = item.procedureid()
  select
    when kind = 'instruction' then do
      if body < 2 then return 'instruction outside procedure'
      return ''
    end
    when kind = 'procedure' then do
      if (signature <> 'PIL' & signature <> 'PILI') | body < 2 then return 'procedure shape'
      name = item.operand(1); locals = item.operand(2); exposed = item.operand(3)
      if namesafe(name.text()) = 0 | locals.index() < 0 | namesafe(exposed.text(),1) = 0 then return 'procedure fields'
      if signature = 'PILI' then do
        entry = item.operand(4)
        if entry.index() <> 1 | lower(name.text()) <> 'main' then return 'procedure entry contract'
      end
    end
    when kind = 'label' then do
      if signature <> 'L' | body < 2 then return 'label shape'
    end
    when kind = '.import' then do
      if signature <> 'PL' | body <> 0 then return 'import shape'
    end
    when kind = '.globalexpose' then do
      if signature <> 'IL' | body <> 0 then return 'global exposure shape'
    end
    when kind = '.const' then do
      if (signature <> 'LLS' & signature <> 'LLB') | body <> 0 then return 'constant shape'
      type = item.operand(2)
      if (signature = 'LLS' & type.text() <> 'string') | (signature = 'LLB' & type.text() <> 'binary') then return 'constant type'
    end
    when kind = '.srcfile' then do
      if signature <> 'S' | body < 2 then return 'source file shape'
    end
    when kind = '.srcline' then do
      if signature <> 'I' | body < 2 then return 'source line shape'
    end
    when kind = '.srcstep' then do
      if signature <> 'IIISIIIS' | body < 2 then return 'source step shape'
      do i = 1 to 7
        if i = 4 then iterate
        field = item.operand(i)
        if field.index() < 0 | field.index() > 4294967295 then return 'source step requires canonical u32 fields'
      end
    end
    when kind = '.traceevent' then do
      if signature <> 'SISSSIIIISS' | body < 2 then return 'TRACE event shape'
      do i = 2 to 9
        if wordpos(i as .string,'2 7 8 9') = 0 then iterate
        field = item.operand(i)
        if field.index() < 0 | field.index() > 4294967295 then return 'TRACE requires canonical u32 fields'
      end
      field = item.operand(6)
      if field.index() < -1 then return 'TRACE requires canonical absent reference'
    end
    when kind = '.inlineframe' then do
      if signature <> 'IISSI' | body < 2 then return 'inline frame shape'
      do i = 1 to 5
        field = item.operand(i)
        if i = 3 | i = 4 then do
          if field.length() = 0 then return 'inline frame requires nonempty diagnostic names'
        end
        else if field.index() < 0 | field.index() > 4294967295 | (i = 1 & field.index() = 0) then return 'inline frame requires canonical u32 identities'
      end
    end
    when kind = '.inlinemap' then do
      if signature <> 'LLI' | body < 2 then return 'inline map shape'
      field = item.operand(3)
      if field.index() < 1 | field.index() > 4294967295 then return 'inline map requires nonzero canonical u32 frame'
    end
    when kind = '.inlineregion' then do
      if signature <> 'II' | body < 2 then return 'inline region shape'
      do i = 1 to 2
        field = item.operand(i)
        if field.index() < 0 | field.index() > 4294967295 | (i = 1 & field.index() = 0) then return 'inline region requires canonical u32 identities'
      end
    end
    when kind = '.inlinerange' then do
      if signature <> 'LLI' | body < 2 then return 'inline range shape'
      field = item.operand(3)
      if field.index() < 1 | field.index() > 4294967295 then return 'inline range requires canonical nonzero u32 region'
    end
    when kind = '.inlineexit' then do
      if wordpos(signature,'ILLISI ILLISR ILLISRR') = 0 | body < 2 then return 'inline exit shape'
      field = item.operand(1)
      if field.index() < 1 | field.index() > 4294967295 then return 'inline exit requires canonical nonzero u32 region'
      field = item.operand(4)
      if field.index() < 0 | field.index() > 4294967295 then return 'inline exit requires canonical u32 order'
      name = item.operand(5); field = item.operand(6)
      if wordpos(name.text(),'digits fuzz form case standard') > 0 then do
        if item.operands() <> 6 then return 'numeric inline exit arity'
        if field.kind() = 'R' then do
          if field.bank() <> 'r' then return 'numeric inline exit requires owned local base'
        end
        else do
          if field.index() > 2147483647 then return 'numeric inline exit literal bounds'
          if name.text() = 'digits' then do; if field.index() < 1 then return 'inline DIGITS literal'; end
          else if name.text() = 'fuzz' then do; if field.index() < 0 then return 'inline FUZZ literal'; end
          else if field.index() <> 1 & field.index() <> 2 then return 'inline numeric enum literal'
        end
      end
      else do
        if wordpos(name.text(),'endlife unlink swap link') = 0 | field.kind() <> 'R' then return 'inline exit action'
        if name.text() = 'swap' | name.text() = 'link' then do
          if signature <> 'ILLISRR' then return 'binary inline binding arity'
        end
        else if item.operands() <> 6 then return 'unary inline exit arity'
        if name.text() = 'endlife' & field.bank() <> 'r' then return 'inline ENDLIFE requires owned local base'
      end
    end
    when kind = '.inlinedprivate' then do
      if signature <> 'RSI' | body < 2 then return 'private binding shape'
      field = item.operand(1); provider = item.operand(2); foreign = item.operand(3)
      if field.bank() <> 'r' | field.index() > 4294967295 | foreign.index() < 0 | foreign.index() > 4294967295 then return 'private binding slot bounds'
      if provider.length() < 1 | provider.length() > 4096 then return 'private provider selector length'
      do i = 0 to provider.length() - 1
        if provider.byte(i) = 0 then return 'private provider selector NUL'
      end
      if left(provider.text(),1) = '@' then do
        selector = substr(provider.text(),2)
        if length(selector) < 1 | length(selector) > 10 | verify(selector,'0123456789') <> 0 then return 'private image selector'
        if selector as .int >= 4294967295 then return 'private image selector bounds'
      end
    end
    when kind = '.meta' then do
      if signature = 'S' & body > 1 then return ''
      if signature = 'SSS' then do
        option = item.operand(2)
        if option.text() = '.inline' then return ''
      end
      if (signature = 'SSSR' | signature = 'SSSS') & body > 1 then return ''
      if signature = 'SSSPS' then return ''
      return 'metadata shape/profile'
    end
    otherwise return 'record kind'
  end
  return ''

appendrecord: procedure = .int
  arg owner = reference .llir..arena, fuel_ref = reference .fuel, block = .llir..block, bodyid = .int, kind = .string, opcode = .int, fields = .object[], at = .llir..origin, ?edges = .object[]
  store = dereference owner; work = dereference fuel_ref
  if work.take(owner,fields[0] + 1) = 0 then return 0
  if wordpos(kind,'procedure instruction label .meta .srcfile .srcline .srcstep .traceevent .inlineframe .inlinemap .inlineregion .inlinerange .inlineexit .inlinedprivate .const .import .globalexpose') = 0 then do
    call store.fail('LL_TARGET_RECORD: unsupported record kind ' || kind); return 0
  end
  if at.belongs(owner) = 0 then do
    call store.fail('LL_TARGET_OWNER: foreign record origin'); return 0
  end
  item = .operand; target = .llir..block; i = .int
  do i = 1 to fields[0]
    if fields[i] is .operand then item = fields[i] as .operand
    else do; call store.fail('LL_TARGET_OPERAND: expected typed operand'); return 0; end
    if wordpos(item.kind(),'R I S L P F D C B') = 0 then do
      call store.fail('LL_TARGET_OPERAND: invalid operand kind'); return 0
    end
    if item.kind() = 'R' then do
      if item.owner() <> store.identity() | item.procedureid() <> bodyid then do
        call store.fail('LL_TARGET_OWNER: foreign register operand'); return 0
      end
    end
  end
  contract = dereference store.contract(); opname = 'rxas.target.record'
  if kind = 'instruction' then do
    if normalsuccessors(opcode) <> -1 then opname = 'rxas.target.control'
  end
  operation = contract.operation(opname)
  draft = block.operation(operation,at)
  call draft.attribute('kind',kind as .binary); call draft.attribute('body',integerbits(bodyid))
  bits = pack(fields,owner,fuel_ref)
  if store.error() <> '' then return 0
  call draft.attribute('opcode',integerbits(opcode)); call draft.attribute('operands',bits)
  if ?edges then do i = 1 to edges[0]
    if edges[i] is .llir..block then target = edges[i] as .llir..block
    else do; call store.fail('LL_TARGET_CFG: successor is not a block'); return 0; end
    call draft.successor(target)
  end
  result = draft.finish()
  return result.id()

/** A draft-owned cursor retains only construction handles and label bindings.
 * All executable blocks and edges belong to the shared L arena. Copies of a
 * bodydraft borrow this same cursor rather than copying its current position. */
bodycursor: class
  _owner = reference .llir..arena
  _fuel = reference .fuel
  _function = .llir..function
  _current = .llir..block
  _fallthrough = .llir..block
  _hasfallthrough = .int
  _names = .string[]
  _thunks = .object[]
  _defined = .int[]
  _lastlabel = .int
  _sequence = .int
  _after = .int
  _ended = .int
  *: factory
    arg owner = reference .llir..arena, work = reference .fuel, functionview = .llir..function, entry = .llir..block
    _owner = owner; _fuel = work; _function = functionview; _current = entry; _sequence = 1
    return
  rebind: method = .void
    arg owner = reference .llir..arena, work = reference .fuel
    allowance = dereference work
    if allowance.take(owner,_thunks[0] + 4) = 0 then return
    _owner = owner; _fuel = work
    _function = .llir..function(owner,_function.id())
    _current = .llir..block(owner,_current.id())
    if _hasfallthrough then _fallthrough = .llir..block(owner,_fallthrough.id())
    do i = 1 to _thunks[0]
      prior = _thunks[i] as .llir..block
      _thunks[i] = .llir..block(owner,prior.id()) as .object
    end
    return
  newgroup: method = .llir..block
    work = dereference _fuel
    if work.take(_owner,1) = 0 then return _current
    _sequence = _sequence + 1
    return _function.block('$target.addr.' || _sequence)
  before: method = .llir..block
    arg at = .llir..origin, zero = 0
    store = dereference _owner
    if _ended | (zero & _after) then do
      target = newgroup()
      if store.error() <> '' then return _current
      if _ended = 0 then call _current.jump(target,at)
      _current = target; _after = 0; _ended = 0
    end
    return _current
  labelentry: method = .llir..block
    arg name = .string
    i = .int; size = .int; comparisons = .int
    store = dereference _owner; work = dereference _fuel
    size = length(name) + 1
    if _names[0] > 2147483647 / size then do; call store.fail('LL_RESOURCE_LIMIT: target label work'); return _current; end
    comparisons = _names[0] * size
    if work.take(_owner,comparisons + size) = 0 then return _current
    if namesafe(name) = 0 then do; call store.fail('LL_TARGET_NAME: invalid label'); return _current; end
    do i = 1 to _names[0]
      if _names[i] == name then do; _lastlabel = i; return _thunks[i] as .llir..block; end
    end
    size = length(name)
    if size > (2147483647 - 96) / 2 then do; call store.fail('LL_RESOURCE_LIMIT: target label bytes'); return _current; end
    if store.reserve(0,96 + size * 2) = 0 then return _current
    thunk = _function.block('$target.label.' || name)
    _lastlabel = _names[0] + 1
    _names[_lastlabel] = name; _thunks[_lastlabel] = thunk as .object; _defined[_lastlabel] = 0
    return thunk
  define: method = .void
    arg name = .string, at = .llir..origin
    store = dereference _owner
    thunk = labelentry(name)
    if store.error() <> '' then return
    if _defined[_lastlabel] then do; call store.fail('LL_TARGET_BINDING: duplicate label definition ' || name); return; end
    call thunk.jump(_current,at); _defined[_lastlabel] = 1
    return
  targets: method = .object[]
    arg opcode = .int, fields = .object[]
    edges = .object[]; field = .operand; i = .int
    arity = normalsuccessors(opcode); catalog = .llrxascatalog..catalog()
    if arity > 0 then do
      do i = 1 to fields[0]
        if catalog.branch(opcode,i) = 0 then iterate
        field = fields[i] as .operand
        edges[edges[0] + 1] = labelentry(field.text()) as .object
      end
      if normalfallthrough(opcode) then do
        _fallthrough = newgroup(); _hasfallthrough = 1; edges[edges[0] + 1] = _fallthrough as .object
      end
    end
    return edges
  after: method = .void
    arg opcode = .int
    if normalsuccessors(opcode) = -1 then do; _after = 1; return; end
    if normalfallthrough(opcode) then do
      _current = _fallthrough; _after = 0; _ended = 0
    end
    else do; _ended = 1; _after = 0; end
    return
  finish: method = .void
    arg at = .llir..origin
    store = dereference _owner; work = dereference _fuel
    if work.take(_owner,_names[0] + 1) = 0 then return
    do i = 1 to _names[0]
      if _defined[i] = 0 then do; call store.fail('LL_TARGET_BINDING: unresolved branch label ' || _names[i]); return; end
    end
    if _ended = 0 then call _current.returnvoid(at)
    return

/** All persistent records and IDs use the existing L arena and freeze. The
 * private catalogue function is declarative and never emitted or executed. */
draft: class
  _store = .llir..arena
  _fuel = .fuel
  _catalogue = .llir..block
  _catalogueid = .int
  _name = .string
  _artifact = .string
  _functions = .int[]
  _cursors = .bodycursor[]
  _globals = .int
  _sealed = .int
  _worklimit = .int
  _bytelimit = .int
  _validationbytes = .int
  _finishedok = .int
  *: factory
    arg logicalModule = .string, artifact = .string, globals = .int, entries = 1000000, bytes = 67108864, work = 1000000
    _worklimit = work; _bytelimit = bytes
    contract = schema(); _store = .llir..arena(contract,entries,bytes); _fuel = .fuel(work)
    _globals = globals; _name = logicalModule; _artifact = artifact
    if logicalModule = '' | artifact = '' | globals < 0 | work < 1 then call _store.fail('LL_TARGET_MODULE: invalid identity, globals or work budget')
    return
  /** Factories return owned values by COPY. Interior handles are established
   * only on the receiving draft and rebound after an owning-value copy. */
  prepare: method = .void
    if _store.error() <> '' then return
    if _catalogueid > 0 then do
      if _catalogue.belongs(reference _store) then return
      _catalogue = .llir..block(reference _store,_catalogueid)
      do i = 1 to _cursors[0]
        cursor_ref = reference _cursors[i]; cursor = dereference cursor_ref
        call cursor.rebind(reference _store,reference _fuel)
      end
      return
    end
    contract = dereference _store.contract()
    functionid = _store.function('$target.catalogue',contract.voidtype())
    if _store.error() <> '' then return
    fn = .llir..function(reference _store,functionid)
    _catalogue = fn.block('records'); _catalogueid = _catalogue.id()
    if _store.error() <> '' then return
    sourceid = _store.source('target module',''x as .binary)
    if _store.error() <> '' then return
    originid = _store.origin(sourceid,0,0,4)
    if _store.error() <> '' then return
    origin = .llir..origin(reference _store,originid)
    op = _catalogue.operation(contract.operation('rxas.target.module'),origin)
    if _store.error() <> '' then return
    catalog = .llrxascatalog..catalog()
    call op.attribute('name',_name as .binary); call op.attribute('artifact',_artifact as .binary)
    call op.attribute('globals',integerbits(_globals)); call op.attribute('catalog',catalog.fingerprint() as .binary)
    result = op.finish()
    return
  error: method = .string
    call prepare()
    store_ref = reference _store; store = dereference store_ref
    return store.error()
  /** Charge adapter work before scanning/copying and check prospective bytes
   * through the existing arena owner. No bytes are reserved by this check. */
  preflight: method = .int
    arg work = .int, bytes = .int
    call prepare()
    if _fuel.take(reference _store,work) = 0 then return 0
    return _store.canreserve(0,bytes)
  source: method = .llir..sourcefile
    arg name = .string, bytes = .binary
    call prepare()
    id = _store.source(name,bytes)
    return .llir..sourcefile(reference _store,id)
  synthetic: method = .llir..origin
    arg description = .string
    call prepare()
    return syntheticorigin(reference _store,description)
  /** Create provenance through the L origin owner. A parent is an owned
   * contributor, not an executable/virtual runtime frame. */
  origin: method = .llir..origin
    arg file = .llir..sourcefile, first = .int, last = .int, kind = 'exact', ?parent = .llir..origin
    call prepare()
    parentid = 0
    if file.belongs(reference _store) = 0 then call _store.fail('LL_TARGET_OWNER: foreign source file')
    if ?parent then do
      if parent.belongs(reference _store) = 0 then call _store.fail('LL_TARGET_OWNER: foreign origin parent')
      else parentid = parent.id()
    end
    id = _store.origin(file.id(),first,last,wordpos(kind,'exact composite derived synthetic recovered'),parentid)
    return .llir..origin(reference _store,id)
  contributingorigin: method = .llir..origin
    arg file = .llir..sourcefile, first = .int, last = .int, kind = .string, parents = .object[]
    call prepare()
    if file.belongs(reference _store) = 0 then do
      call _store.fail('LL_TARGET_OWNER: foreign source file'); return .llir..origin(reference _store,0)
    end
    if preflight(parents[0] + 1,0) = 0 then return .llir..origin(reference _store,0)
    return file.contributingorigin(first,last,kind,parents)
  procedure: method = .lltarget..bodydraft
    arg name = .string, locals = .int, at = .llir..origin, exposed = '', entrykind = 0
    call prepare()
    if _store.error() <> '' then return .lltarget..bodydraft()
    if name = '' | locals < 0 then do
      call _store.fail('LL_TARGET_PROCEDURE: invalid name or local count'); return .lltarget..bodydraft()
    end
    if (entrykind <> 0 & entrykind <> 1) | (entrykind = 1 & lower(name) <> 'main') then do
      call _store.fail('LL_TARGET_PROCEDURE: invalid entry contract'); return .lltarget..bodydraft()
    end
    contract = dereference _store.contract()
    functionid = _store.function(name,contract.voidtype())
    if functionid < 1 | _store.error() <> '' then return .lltarget..bodydraft()
    fn = .llir..function(reference _store,functionid)
    block = fn.block('$target.addr.1'); n = _functions[0] + 1
    if _store.reserve(0,160) = 0 then return .lltarget..bodydraft()
    _functions[n] = fn.id(); _cursors[n] = .bodycursor(reference _store,reference _fuel,fn,block)
    fields = .object[]; fields[1] = .operand.procedure(name) as .object
    fields[2] = .operand.integer(locals) as .object; fields[3] = .operand.symbol(exposed) as .object
    if entrykind then fields[4] = .operand.integer(entrykind) as .object
    headerid = appendrecord(reference _store,reference _fuel,_catalogue,fn.id(),'procedure',-1,fields,at)
    return .lltarget..bodydraft(reference _store,reference _fuel,reference _cursors[n],_catalogue,fn.id(),locals,_globals,headerid)
  record: method = .int
    arg kind = .string, fields = .object[], at = .llir..origin
    call prepare()
    return appendrecord(reference _store,reference _fuel,_catalogue,0,kind,-1,fields,at)
  finishfee: method = .int
    arg count = .int, width = .int
    if count < 0 | width < 0 then do; call _store.fail('LL_RESOURCE_LIMIT: target.finish.work'); return 0; end
    if width > 0 then do
      if count > _fuel.remaining() <idiv> width then do; call _store.fail('LL_RESOURCE_LIMIT: target.finish.work'); return 0; end
    end
    return _fuel.take(reference _store,count * width)
  finishsquare: method = .int
    arg count = .int, width = .int
    if count < 0 | width < 1 then do; call _store.fail('LL_RESOURCE_LIMIT: target.finish.work'); return 0; end
    if count = 0 then return 1
    if count > (_fuel.remaining() <idiv> count) <idiv> width then do; call _store.fail('LL_RESOURCE_LIMIT: target.finish.work'); return 0; end
    return _fuel.take(reference _store,count * count * width)
  finishbytes: method = .int
    arg count = .int, width = .int
    if count < 0 | width < 1 then do; call _store.fail('LL_RESOURCE_LIMIT: target.finish.bytes'); return 0; end
    available = _bytelimit - _store.capacity()
    if available < _validationbytes then do; call _store.fail('LL_RESOURCE_LIMIT: target.finish.bytes'); return 0; end
    if count > (available - _validationbytes) <idiv> width then do; call _store.fail('LL_RESOURCE_LIMIT: target.finish.bytes'); return 0; end
    _validationbytes = _validationbytes + count * width; return 1
  preparefinish: method = .int
    i = .int; table = .int; column = .int; maximum = .int; width = .int; count = .int; poolid = .int
    /* The target schema has fixed codecs and no semantic verifier callback.
     * Charge its generic IR verification by actual rows/payload, including
     * duplicate-name scans, before invoking that existing validator. */
    do table = 1 to 13
      if finishfee(_store.count(table),32) = 0 then return 0
    end
    if finishfee(_store.bytes(),4) = 0 then return 0
    do table = 1 to 3
      count = _store.count(table); column = 1
      if table = 2 then column = 4
      if table = 3 then do; count = _store.count(5); column = 3; end
      maximum = 1
      if finishfee(count,4) = 0 then return 0
      do i = 1 to count
        source = table; if table = 3 then source = 5
        poolid = _store.get(source,i,column); bits = _store.bits(poolid)
        maximum = max(maximum,<blen>(bits))
        if table = 1 then do
          poolid = _store.get(1,i,6)
          if poolid > 0 then do; bits = _store.bits(poolid); maximum = max(maximum,<blen>(bits)); end
        end
      end
      if maximum > (9223372036854775807 - 8) <idiv> 2 then do; call _store.fail('LL_RESOURCE_LIMIT: target.finish.names'); return 0; end
      width = maximum * 2 + 8
      if finishsquare(count,width) = 0 then return 0
    end
    /* Logical capacity + a checked envelope for target indexes, sorting and
     * verification vectors/codec scratch; this is not an RSS measurement. */
    if finishbytes(1,4096) = 0 | finishbytes(_store.count(3),512) = 0 then return 0
    if finishbytes(_store.count(2),256) = 0 | finishbytes(_store.count(1),128) = 0 then return 0
    if finishbytes(_store.bytes(),16) = 0 then return 0
    return 1
  usedwork: method = .int
    call prepare()
    if _finishedok = 0 then return _worklimit
    return _worklimit - _fuel.remaining()
  usedbytes: method = .int
    call prepare()
    if _finishedok = 0 then return _bytelimit
    return _store.capacity() + _validationbytes
  finish: method = .lltarget..module
    call prepare()
    if _sealed then do
      call bad('LL_TARGET_STATE: draft already finished'); return .lltarget..module(.llir..module(_store),0)
    end
    _sealed = 1
    if _store.error() <> '' then return .lltarget..module(.llir..module(_store),_globals)
    origin = syntheticorigin(reference _store,'target structural sentinel')
    do i = 1 to _cursors[0]
      cursor_ref = reference _cursors[i]; cursor = dereference cursor_ref
      call cursor.finish(origin)
    end
    call _catalogue.returnvoid(origin)
    if preparefinish() = 0 then return .lltarget..module(.llir..module(_store),0)
    ok = _store.freeze(); graph = .llir..module(_store)
    result = .lltarget..module(graph,_fuel.remaining())
    if result.valid() then do
      if _fuel.take(reference _store,result.validationwork()) then _finishedok = 1
    end
    return result

bodydraft: class
  _owner = reference .llir..arena
  _fuel = reference .fuel
  _cursor = reference .bodycursor
  _catalogue = .llir..block
  _function = .int
  _locals = .int
  _globals = .int
  _header = .int
  *: factory
    arg ?owner = reference .llir..arena, ?work = reference .fuel, ?cursor = reference .bodycursor, ?catalogue = .llir..block, functionid = 0, locals = 0, globals = 0, headerid = 0
    if ?owner then _owner = owner
    if ?work then _fuel = work
    if ?cursor then _cursor = cursor
    if ?catalogue then _catalogue = catalogue
    _function = functionid; _locals = locals; _globals = globals; _header = headerid
    return
  functionid: method = .int
    return _function
  headerid: method = .int
    return _header
  locals: method = .int
    return _locals
  globals: method = .int
    return _globals
  storage: method = reference .llir..arena
    return _owner
  reg: method = .lltarget..operand
    arg bank = .string, index = .int
    if <refvalid>(_owner) = 0 then return .operand()
    store = dereference _owner; work = dereference _fuel
    if store.error() <> '' then return .operand()
    if work.take(_owner,1) = 0 then return .operand()
    if wordpos(bank,'r g a') = 0 | index < 0 | (bank = 'r' & index >= _locals) | (bank = 'g' & index >= _globals) then do
      call store.fail('LL_TARGET_REGISTER: bank/index outside declaration'); return .operand()
    end
    contract = dereference store.contract(); name = bank || index
    slotid = 0
    do i = 1 to store.count(5)
      if work.take(_owner,1) = 0 then return .operand()
      if store.get(5,i,1) = _function & store.text(store.get(5,i,3)) == name then slotid = i
    end
    if slotid = 0 then do
      slotid = store.slot(_function,name,contract.type('rxas.target.cell'))
      origin = .llir..origin(_owner,1)
      descriptor = _catalogue.operation(contract.operation('rxas.target.register'),origin)
      call descriptor.attribute('body',integerbits(_function)); call descriptor.attribute('slot',integerbits(slotid))
      call descriptor.attribute('bank',bank as .binary); call descriptor.attribute('index',integerbits(index))
      result = descriptor.finish()
    end
    return .operand.bound(store.identity(),_function,slotid,bank,index)
  emit: method = .int
    arg mnemonic = .string, fields = .object[], at = .llir..origin
    return emitchecked(mnemonic,fields,at)
  /** Source admission uses the same canonical typed operand contract. */
  emitphysical: method = .int
    arg mnemonic = .string, fields = .object[], at = .llir..origin
    return emitchecked(mnemonic,fields,at)
  emitchecked: method = .int
    arg mnemonic = .string, fields = .object[], at = .llir..origin
    i = .int; j = .int
    if <refvalid>(_owner) = 0 then return 0
    signature = ''; item = .operand; store = dereference _owner; work = dereference _fuel
    if store.error() <> '' then return 0
    do i = 1 to fields[0]
      if fields[i] is .operand then item = fields[i] as .operand
      else do; call store.fail('LL_TARGET_OPERAND: expected typed operand'); return 0; end
      /* A .const declaration is bound by the target owner, never by a reader's
       * second symbol framework. Keep its declaration; use its exact value. */
      if item.kind() = 'L' then do
        do j = 1 to store.count(3)
          if work.take(_owner,1) = 0 then return 0
          existing = .llir..opview(_owner,j)
          if isrecord(existing.name()) = 0 then iterate
          if existing.attribute('kind') as .string <> '.const' then iterate
          vector = existing.attribute('operands')
          if (<at..u32>(0) vector) <> 3 then iterate
          alias = unpack(vector,1,store.identity())
          if alias.text() == item.text() then do
            item = unpack(vector,3,store.identity()); fields[i] = item as .object
            leave
          end
        end
      end
      signature = signature || item.kind()
    end
    catalog = .llrxascatalog..catalog(); opcode = catalog.find(mnemonic,signature)
    if opcode < 0 then do
      call store.fail('LL_TARGET_OPCODE: unknown source-visible instruction/signature ' || mnemonic || '/' || signature); return 0
    end
    cursor = dereference _cursor; block = cursor.before(at)
    edges = cursor.targets(opcode,fields)
    id = appendrecord(_owner,_fuel,block,_function,'instruction',opcode,fields,at,edges)
    call cursor.after(opcode)
    return id
  record: method = .int
    arg kind = .string, fields = .object[], at = .llir..origin
    source = .operand; bank = .operand; number = .operand; registered = .operand
    if <refvalid>(_owner) = 0 then return 0
    store = dereference _owner
    if store.error() <> '' then return 0
    /* TRACE encodes a register as a typed bank/index pair. Register it with
     * the same target storage owner as an explicitly spelled R operand. */
    if kind = '.traceevent' & fields[0] = 11 & fields[3] is .operand & fields[5] is .operand & fields[6] is .operand then do
      source = fields[3] as .operand; bank = fields[5] as .operand; number = fields[6] as .operand
      if source.kind() = 'S' & bank.kind() = 'S' & number.kind() = 'I' then do
        if source.text() = 'R' & number.index() >= 0 & wordpos(lower(bank.text()),'r g a') > 0 then registered = reg(lower(bank.text()),number.index())
      end
    end
    cursor = dereference _cursor; block = cursor.before(at,1)
    if kind = 'label' & fields[0] = 1 & fields[1] is .operand then do
      source = fields[1] as .operand; call cursor.define(source.text(),at)
    end
    return appendrecord(_owner,_fuel,block,_function,kind,-1,fields,at)

/** Views borrow the exact published L owner. No arena copies on scalar queries. */
record: class
  _owner = reference .llir..module
  _identity = .int
  _id = .int
  *: factory
    arg owner = reference .llir..module, id = .int
    _owner = owner; graph = dereference owner; _identity = graph.identity(); _id = id
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    graph = dereference _owner
    if graph.identity() <> _identity | _id < 1 | _id > graph.operations() then return 0
    op = graph.operation(_id)
    return isrecord(op.name())
  require: method = .void
    if valid() = 0 then call bad('LL_TARGET_OWNER: stale or foreign record')
    return
  id: method = .int
    call require(); return _id
  blockid: method = .int
    call require(); graph = dereference _owner; op = graph.operation(_id)
    return op.blockid()
  /** A logical instruction anchor, not an encoded address. Zero denotes the
   * body's end address, including preserved trailing metadata. */
  addressid: method = .int
    i = .int; candidate = .lltarget..record
    call require()
    if kind() = 'instruction' then return _id
    fn = procedureid()
    if fn < 2 then return 0
    graph = dereference _owner
    do i = _id + 1 to graph.operations()
      op = graph.operation(i)
      if isrecord(op.name()) = 0 then iterate
      candidate = .record(_owner,i)
      if candidate.procedureid() = fn & candidate.kind() = 'instruction' then return i
    end
    return 0
  kind: method = .string
    call require(); graph = dereference _owner; op = graph.operation(_id)
    return op.attribute('kind') as .string
  procedureid: method = .int
    call require(); graph = dereference _owner; op = graph.operation(_id)
    bits = op.attribute('body'); return <at..i64>(0) bits
  opcode: method = .int
    call require(); graph = dereference _owner; op = graph.operation(_id)
    bits = op.attribute('opcode'); return <at..i64>(0) bits
  mnemonic: method = .string
    if kind() <> 'instruction' then return ''
    catalog = .llrxascatalog..catalog(); return catalog.field(opcode(),1)
  operands: method = .int
    call require(); graph = dereference _owner; op = graph.operation(_id)
    bits = op.attribute('operands'); return <at..u32>(0) bits
  operand: method = .lltarget..operand
    arg ordinal = .int
    call require(); graph = dereference _owner; op = graph.operation(_id)
    return unpack(op.attribute('operands'),ordinal,_identity)
  /** Enumerate spelled register operands and typed TRACE bank/index pairs.
   * Implicit call windows/addressed registers still require the canonical
   * operation contract plus call-site facts; this is not a completeness proof. */
  registerrefs: method = .int
    total = 0; field = .operand; i = .int
    do i = 1 to operands()
      field = operand(i)
      if field.kind() = 'R' then total = total + 1
    end
    if kind() = '.traceevent' then do
      source = operand(3); bank = operand(5); number = operand(6)
      if source.text() = 'R' & number.index() >= 0 & wordpos(lower(bank.text()),'r g a') > 0 then total = total + 1
    end
    return total
  registerref: method = .lltarget..operand
    arg ordinal = .int
    graph = .llir..module; store = .llir..arena
    graph = dereference _owner; store_ref = graph.storage(); store = dereference store_ref
    total = 0; field = .operand; slotid = .int; i = .int
    do i = 1 to operands()
      field = operand(i)
      if field.kind() <> 'R' then iterate
      total = total + 1
      if total = ordinal then return field
    end
    if kind() = '.traceevent' then do
      source = operand(3); bank = operand(5); number = operand(6)
      if source.text() = 'R' & number.index() >= 0 & wordpos(lower(bank.text()),'r g a') > 0 & ordinal = total + 1 then do
        slotid = 0
        do i = 1 to store.count(5)
          if store.get(5,i,1) = procedureid() & store.text(store.get(5,i,3)) = (lower(bank.text()) || number.index()) then slotid = i
        end
        if slotid = 0 then call bad('LL_TARGET_METADATA: TRACE register has no storage descriptor')
        return .operand.bound(_identity,procedureid(),slotid,lower(bank.text()),number.index())
      end
    end
    call bad('LL_TARGET_METADATA: register reference ordinal outside record')
    return .operand()
  regionid: method = .int
    recordkind = kind(); value = .operand
    if recordkind = '.inlineregion' | recordkind = '.inlineexit' then do; value = operand(1); return value.index(); end
    if recordkind = '.inlinerange' then do; value = operand(3); return value.index(); end
    call bad('LL_TARGET_REGION: record has no executable region identity'); return 0
  parentregion: method = .int
    if kind() <> '.inlineregion' then do; call bad('LL_TARGET_REGION: record is not a region'); return 0; end
    value = operand(2); return value.index()
  action: method = .string
    if kind() <> '.inlineexit' then do; call bad('LL_TARGET_REGION: record is not a cold action'); return ''; end
    value = operand(5); return value.text()
  origin: method = .llir..origin
    call require(); graph = dereference _owner; op = graph.operation(_id)
    return op.origin()

/** Rebind typed references into another body. The receiving builder checks
 * exact storage ownership; no source text or physical-number substitution is
 * involved. Register order agrees with record.registerref(). */
remapregisters: procedure = .object[]
  arg item = .lltarget..record, replacements = .object[]
  fields = .object[]; value = .operand; replacement = .operand; i = .int
  if replacements[0] <> item.registerrefs() then call bad('LL_TARGET_METADATA: register remap arity')
  next = 0
  do i = 1 to item.operands()
    value = item.operand(i)
    if value.kind() = 'R' then do
      next = next + 1
      if replacements[next] is .operand then replacement = replacements[next] as .operand
      else call bad('LL_TARGET_METADATA: untyped replacement register')
      if replacement.kind() <> 'R' then call bad('LL_TARGET_METADATA: replacement is not a register')
      value = replacement
    end
    fields[i] = value as .object
  end
  if item.kind() = '.traceevent' & next < replacements[0] then do
    next = next + 1; replacement = replacements[next] as .operand
    if replacement.kind() <> 'R' then call bad('LL_TARGET_METADATA: replacement is not a register')
    fields[5] = .operand.string(replacement.bank() as .binary) as .object
    fields[6] = .operand.integer(replacement.index()) as .object
  end
  return fields

mappedidentity: procedure = .int
  arg identities = .int[], old = .int
  i = .int
  if old <= 0 | identities[0] = 0 then return old
  if identities[0] % 2 <> 0 then call bad('LL_TARGET_METADATA: identity map shape')
  do i = 1 to identities[0] by 2
    if identities[i] = old then return identities[i + 1]
  end
  call bad('LL_TARGET_METADATA: missing source/clause identity')
  return 0

/** Relocate source identities and paired local-symbol scope records after
 * remapping their registers. Maps contain ordered old/new integer pairs;
 * zero/negative native sentinels are preserved. Callable and opaque compiler
 * transport declarations are retained with their original procedure. */
remapmetadata: procedure = .object[]
  arg item = .lltarget..record, fields = .object[], scope = '', ?steps = .int[], ?clauses = .int[], ?frames = .int[], frameparent = 0, ?regions = .int[], regionparent = 0
  value = .operand; old = .operand
  if fields[0] <> item.operands() then call bad('LL_TARGET_METADATA: field remap arity')
  if item.kind() = '.srcstep' then do
    if ?steps then do; old = fields[1] as .operand; fields[1] = .operand.integer(mappedidentity(steps,old.index())) as .object; end
    if ?clauses then do; old = fields[2] as .operand; fields[2] = .operand.integer(mappedidentity(clauses,old.index())) as .object; end
  end
  else if item.kind() = '.traceevent' then do
    if ?steps then do; old = fields[7] as .operand; fields[7] = .operand.integer(mappedidentity(steps,old.index())) as .object; end
    if ?clauses then do; old = fields[8] as .operand; fields[8] = .operand.integer(mappedidentity(clauses,old.index())) as .object; end
  end
  else if item.kind() = '.inlineframe' then do
    if ?steps then do; old = fields[5] as .operand; fields[5] = .operand.integer(mappedidentity(steps,old.index())) as .object; end
    if ?frames then do
      old = fields[1] as .operand; fields[1] = .operand.integer(mappedidentity(frames,old.index())) as .object
      old = fields[2] as .operand
      if old.index() = 0 then fields[2] = .operand.integer(frameparent) as .object
      else fields[2] = .operand.integer(mappedidentity(frames,old.index())) as .object
    end
  end
  else if item.kind() = '.inlinemap' & ?frames then do; old = fields[3] as .operand; fields[3] = .operand.integer(mappedidentity(frames,old.index())) as .object; end
  else if item.kind() = '.inlineregion' & ?regions then do
    old = fields[1] as .operand; fields[1] = .operand.integer(mappedidentity(regions,old.index())) as .object
    old = fields[2] as .operand
    if old.index() = 0 then fields[2] = .operand.integer(regionparent) as .object
    else fields[2] = .operand.integer(mappedidentity(regions,old.index())) as .object
  end
  else if (item.kind() = '.inlinerange' | item.kind() = '.inlineexit') & ?regions then do
    ordinal = 1
    if item.kind() = '.inlinerange' then ordinal = 3
    old = fields[ordinal] as .operand; fields[ordinal] = .operand.integer(mappedidentity(regions,old.index())) as .object
  end
  else if item.kind() = '.meta' & scope <> '' then do
    if fields[0] = 1 | fields[0] = 4 then do
      value = fields[1] as .operand
      fields[1] = .operand.string(value.bytes() || (scope as .binary)) as .object
    end
  end
  return fields

/** Checked target binding evidence over the existing graph. The small label
 * index and completeness flags are derived once; they are not a second CFG. */
cfgcheck: class
  _identity = .int
  _error = .string
  _complete = .int[]
  _endobservations = .int[]
  _names = .string[]
  _bodies = .int[]
  _entries = .int[]
  _groups = .int[]
  _usedwork = .int
  *: factory
    arg owner = reference .llir..module, records_ref = reference .int[], work = .int, ?diagnostics = .inlineindex
    initialwork = work; _usedwork = work
    i = .int; j = .int; b = .int; f = .int; id = .int; at = .int; prior = .int
    arity = .int; found = .int; operand = .int; code = .int; first = .int; last = .int; ordinal = .int; activefn = .int
    name = .string; expectedname = .string; bits = .binary
    metadataend = .int
    item = .record; field = .operand; op = .llir..opview
    blockkind = .int[]; nextgroup = .int[]; lastgroup = .int[]; sequence = .int[]
    firstrecord = .int[]; lastrecord = .int[]; firstmachine = .int[]; machines = .int[]; priorrecord = .int[]
    do
      if <refvalid>(owner) = 0 then do; _error = 'LL_TARGET_OWNER: expired CFG module'; return; end
      graph = dereference owner; records = dereference records_ref
      _identity = graph.identity(); store = dereference graph.storage(); catalog = .llrxascatalog..catalog()
      /* Charge all retained flags/index rows and traversal scratch before any
       * sparse vector can grow to a block/function/operation identifier. */
      if work < 1 | graph.blocks() > work / 16 then do; _error = 'LL_RESOURCE_LIMIT: target.cfg work'; return; end
      work = work - graph.blocks() * 16
      if graph.functions() > work / 8 then do; _error = 'LL_RESOURCE_LIMIT: target.cfg work'; return; end
      work = work - graph.functions() * 8
      if graph.operations() > work / 8 then do; _error = 'LL_RESOURCE_LIMIT: target.cfg work'; return; end
      work = work - graph.operations() * 8
      do f = 1 to graph.functions()
        _complete[f] = f > 1; _endobservations[f] = 0; machines[f] = 0; sequence[f] = 0; lastgroup[f] = 0; priorrecord[f] = 0
      end
      do b = 1 to graph.blocks()
        f = store.get(2,b,1); name = store.text(store.get(2,b,4))
        firstrecord[b] = 0; lastrecord[b] = 0; firstmachine[b] = 0; nextgroup[b] = 0
        if f = 1 then do
          if b <> store.get(1,1,3) then do; _error = 'LL_TARGET_CFG: extra catalogue block'; return; end
          blockkind[b] = 0; iterate
        end
        if left(name,13) = '$target.addr.' then do
          sequence[f] = sequence[f] + 1
          if name <> ('$target.addr.' || sequence[f]) then do; _error = 'LL_TARGET_CFG: address group sequence'; return; end
          blockkind[b] = 1
          if lastgroup[f] = 0 then do
            if b <> store.get(1,f,3) then do; _error = 'LL_TARGET_CFG: entry address group'; return; end
          end
          else nextgroup[lastgroup[f]] = b
          lastgroup[f] = b
        end
        else if left(name,14) = '$target.label.' then blockkind[b] = 2
        else do; _error = 'LL_TARGET_CFG: unknown target block'; return; end
      end
      activefn = 0
      do i = 1 to records[0]
        if work < 1 then do; _error = 'LL_RESOURCE_LIMIT: target.cfg work'; return; end
        work = work - 1; id = records[i]; item = .record(owner,id); f = item.procedureid()
        if item.kind() = 'procedure' then do; activefn = f; iterate; end
        if item.kind() = '.import' then activefn = 0
        if f < 2 then iterate
        if f <> activefn then do; _error = 'LL_TARGET_CFG: source record outside its procedure stream'; return; end
        b = item.blockid()
        if blockkind[b] <> 1 then do; _error = 'LL_TARGET_CFG: source record outside address group'; return; end
        if priorrecord[f] <> b then do
          prior = priorrecord[f]
          if lastrecord[b] <> 0 | (prior = 0 & b <> store.get(1,f,3)) then do; _error = 'LL_TARGET_CFG: source group order'; return; end
          if prior > 0 then do
            if nextgroup[prior] <> b then do; _error = 'LL_TARGET_CFG: source group skips an address'; return; end
          end
          priorrecord[f] = b
        end
        if firstrecord[b] = 0 then firstrecord[b] = id
        if lastrecord[b] > 0 then do
          if store.get(3,lastrecord[b],3) <> id then do
            _error = 'LL_TARGET_CFG: linked source order disagrees with record order'; return
          end
        end
        lastrecord[b] = id
        if item.kind() = 'instruction' then do
          machines[f] = machines[f] + 1
          if firstmachine[b] = 0 then firstmachine[b] = id
        end
        else if firstmachine[b] > 0 then do
          _error = 'LL_TARGET_CFG: zero-width record follows code in its address group'; return
        end
        if item.kind() <> 'label' then iterate
        field = item.operand(1); name = field.text()
        if _names[0] + 1 > work / (length(name) + 1) then do; _error = 'LL_RESOURCE_LIMIT: target.cfg labels'; return; end
        work = work - (_names[0] + 1) * (length(name) + 1)
        do j = 1 to _names[0]
          if _names[j] == name then do; _error = 'LL_TARGET_BINDING: duplicate label definition ' || name; return; end
        end
        expectedname = '$target.label.' || name
        if graph.blocks() > work / (length(expectedname) + 1) then do; _error = 'LL_RESOURCE_LIMIT: target.cfg labels'; return; end
        work = work - graph.blocks() * (length(expectedname) + 1); found = 0
        do j = 1 to graph.blocks()
          if store.get(2,j,1) <> f then iterate
          if store.text(store.get(2,j,4)) == expectedname then found = j
        end
        if found = 0 then do; _error = 'LL_TARGET_CFG: label has no entry block'; return; end
        at = _names[0] + 1; _names[at] = name; _bodies[at] = f; _entries[at] = found; _groups[at] = b
      end
      do i = 1 to records[0]
        if work < 1 then do; _error = 'LL_RESOURCE_LIMIT: target.cfg work'; return; end
        work = work - 1; id = records[i]; item = .record(owner,id); f = item.procedureid()
        if f < 2 | item.kind() = 'procedure' then iterate
        b = item.blockid(); op = graph.operation(id)
        if item.kind() <> 'instruction' then do
          if op.name() <> 'rxas.target.record' | op.successors() <> 0 then do; _error = 'LL_TARGET_CFG: metadata control edges'; return; end
          if firstmachine[b] = 0 & nextgroup[b] = 0 then do
            bits = op.attribute('operands')
            if <blen>(bits) > work then do; _error = 'LL_RESOURCE_LIMIT: target.cfg metadata'; return; end
            work = work - <blen>(bits)
            if item.registerrefs() > 0 then _endobservations[f] = 1
          end
          iterate
        end
        arity = normalsuccessors(item.opcode())
        if arity = -1 then do
          if op.name() <> 'rxas.target.record' | op.successors() <> 0 then do; _error = 'LL_TARGET_CFG: fallthrough instruction edges'; return; end
          iterate
        end
        if op.name() <> 'rxas.target.control' | op.successors() <> max(0,arity) then do; _error = 'LL_TARGET_CFG: canonical control arity'; return; end
        if store.get(2,b,3) <> id then do; _error = 'LL_TARGET_CFG: control instruction is not last in its block'; return; end
        if arity = -2 then do; _complete[f] = 0; iterate; end
        ordinal = 0
        do operand = 1 to item.operands()
          if work < 1 then do; _error = 'LL_RESOURCE_LIMIT: target.cfg work'; return; end
          work = work - 1
          if catalog.branch(item.opcode(),operand) = 0 then iterate
          ordinal = ordinal + 1
          field = item.operand(operand); found = 0
          name = field.text()
          if _names[0] > work / (length(name) + 1) then do; _error = 'LL_RESOURCE_LIMIT: target.cfg labels'; return; end
          work = work - _names[0] * (length(name) + 1)
          do j = 1 to _names[0]
            if _names[j] == name & _bodies[j] = f then found = j
          end
          if found = 0 then do; _error = 'LL_TARGET_BINDING: unresolved branch label ' || field.text(); return; end
          if op.successor(ordinal) <> _entries[found] then do; _error = 'LL_TARGET_CFG: branch edge disagrees with label'; return; end
        end
        if normalfallthrough(item.opcode()) then do
          if nextgroup[b] = 0 | op.successor(ordinal + 1) <> nextgroup[b] then do; _error = 'LL_TARGET_CFG: conditional fallthrough edge'; return; end
          if firstmachine[nextgroup[b]] = 0 then _complete[f] = 0
        end
      end
      do b = 1 to graph.blocks()
        f = store.get(2,b,1)
        if f = 1 then do
          last = store.get(2,b,3)
          if store.get(3,last,1) <> 7 then do; _error = 'LL_TARGET_CFG: catalogue terminator'; return; end
          iterate
        end
        if work < 1 then do; _error = 'LL_RESOURCE_LIMIT: target.cfg work'; return; end
        work = work - 1; first = store.get(2,b,2); last = store.get(2,b,3); op = graph.operation(last); code = store.get(3,last,1)
        if blockkind[b] = 2 then do
          found = 0
          if _entries[0] > work then do; _error = 'LL_RESOURCE_LIMIT: target.cfg labels'; return; end
          work = work - _entries[0]
          do j = 1 to _entries[0]; if _entries[j] = b then found = j; end
          if found = 0 | first <> last | code <> 5 then do; _error = 'LL_TARGET_CFG: malformed label entry'; return; end
          if op.successors() <> 1 | op.successor(1) <> _groups[found] then do; _error = 'LL_TARGET_CFG: label entry address mismatch'; return; end
          if firstmachine[_groups[found]] = 0 then do
            metadataend = 0
            if ?diagnostics then metadataend = diagnostics.endlabel(f,_names[found])
            if metadataend = 0 then _complete[f] = 0
          end
          iterate
        end
        if firstrecord[b] = 0 then do
          if nextgroup[b] <> 0 | first <> last | code <> 7 then do; _error = 'LL_TARGET_CFG: empty nonterminal address group'; return; end
        end
        else if first <> firstrecord[b] then do; _error = 'LL_TARGET_CFG: hidden operation at address entry'; return; end
        if lastrecord[b] > 0 & (code = 5 | code = 7) then do
          if store.get(3,lastrecord[b],3) <> last then do
            _error = 'LL_TARGET_CFG: structural terminator does not follow the last source record'; return
          end
        end
        if code = 5 then do
          if nextgroup[b] = 0 | op.successors() <> 1 then do; _error = 'LL_TARGET_CFG: structural fallthrough'; return; end
          if op.successor(1) <> nextgroup[b] then do; _error = 'LL_TARGET_CFG: structural fallthrough address mismatch'; return; end
          if firstmachine[nextgroup[b]] = 0 then _complete[f] = 0
        end
        else if code = 7 then do
          if nextgroup[b] <> 0 then do; _error = 'LL_TARGET_CFG: premature structural return'; return; end
          if firstmachine[b] > 0 then _complete[f] = 0
        end
        else if op.name() <> 'rxas.target.control' | last <> lastrecord[b] then do
          _error = 'LL_TARGET_CFG: invalid address-group terminator'; return
        end
      end
      do f = 2 to graph.functions(); if machines[f] = 0 then _complete[f] = 0; end
    on signal as problem
      if _error = '' then _error = 'LL_TARGET_CFG: ' || problem.name() || ': ' || problem.message()
    end
    if _error = '' then _usedwork = initialwork - work
    return
  usedwork: method = .int
    return _usedwork
  valid: method = .int
    return _error = '' & _identity > 0
  identity: method = .int
    return _identity
  error: method = .string
    return _error
  complete: method = .int
    arg functionid = .int
    if valid() = 0 then return 0
    if functionid < 2 | functionid > _complete[0] then do; call bad('LL_TARGET_CFG: function identity'); return 0; end
    return _complete[functionid]
  endobservations: method = .int
    arg functionid = .int
    if valid() = 0 then return 1
    if functionid < 2 | functionid > _complete[0] then do; call bad('LL_TARGET_CFG: function identity'); return 1; end
    return _endobservations[functionid]
  labelblock: method = .int
    arg functionid = .int, name = .string
    if valid() = 0 then do; call bad('LL_TARGET_OWNER: invalid CFG evidence'); return 0; end
    do i = 1 to _names[0]
      if _bodies[i] = functionid & _names[i] == name then return _entries[i]
    end
    call bad('LL_TARGET_BINDING: unknown body label ' || name)
    return 0

body: class
  _owner = reference .llir..module
  _target = reference .lltarget..module
  _identity = .int
  _function = .int
  _header = .int
  *: factory
    arg owner = reference .llir..module, functionid = .int, header = .int, ?target = reference .lltarget..module
    _owner = owner; graph = dereference owner; _identity = graph.identity()
    _function = functionid; _header = header
    if ?target then _target = target
    return
  require: method = .void
    if <refvalid>(_owner) = 0 then do; call bad('LL_TARGET_OWNER: body expired'); return; end
    graph = dereference _owner
    if graph.identity() <> _identity then call bad('LL_TARGET_OWNER: body replaced')
    return
  functionid: method = .int
    call require(); return _function
  name: method = .string
    call require(); header = .record(_owner,_header); item = header.operand(1)
    return item.text()
  locals: method = .int
    call require(); header = .record(_owner,_header); item = header.operand(2)
    return item.index()
  ownedlocals: method = .int
    call require()
    if <refvalid>(_target) = 0 then do; call bad('LL_TARGET_OWNER: body has no checked ownership index'); return 0; end
    checked = dereference _target; graph_ref = checked.ir()
    if (_owner <refsame> graph_ref) = 0 then do; call bad('LL_TARGET_OWNER: replaced target ownership'); return 0; end
    return checked.ownedlocals(_function)
  privatebindings: method = .int
    call require()
    if <refvalid>(_target) = 0 then do; call bad('LL_TARGET_OWNER: body has no checked ownership index'); return 0; end
    checked = dereference _target
    return checked.privatebindings(_function)
  expose: method = .string
    call require(); header = .record(_owner,_header); item = header.operand(3)
    return item.text()
  /** Typed executable entry contract: zero is ordinary, one program-default.
   * The checked header owns this fact; metadata strings grant no permission. */
  entrykind: method = .int
    call require(); header = .record(_owner,_header)
    if header.operands() < 4 then return 0
    item = header.operand(4); return item.index()
  normalcfgcomplete: method = .int
    call require()
    if <refvalid>(_target) = 0 then return 0
    checked = dereference _target; graph_ref = checked.ir()
    if (_owner <refsame> graph_ref) = 0 then return 0
    return checked.normalcfgcomplete(_function)
  endobservations: method = .int
    call require()
    if <refvalid>(_target) = 0 then return 1
    checked = dereference _target; graph_ref = checked.ir()
    if (_owner <refsame> graph_ref) = 0 then return 1
    return checked.endobservations(_function)
  labelblock: method = .int
    arg name = .string
    call require()
    if <refvalid>(_target) = 0 then do; call bad('LL_TARGET_CFG: body has no checked target owner'); return 0; end
    checked = dereference _target; graph_ref = checked.ir()
    if (_owner <refsame> graph_ref) = 0 then do; call bad('LL_TARGET_OWNER: replaced target body'); return 0; end
    return checked.labelblock(_function,name)
  records: method = .int
    call require(); graph = dereference _owner; count = 0
    do i = 1 to graph.operations()
      op = graph.operation(i)
      if isrecord(op.name()) = 0 then iterate
      item = .record(_owner,i)
      if item.procedureid() = _function & item.kind() <> 'procedure' then count = count + 1
    end
    return count
  record: method = .lltarget..record
    arg ordinal = .int
    call require(); graph = dereference _owner; count = 0
    do i = 1 to graph.operations()
      op = graph.operation(i)
      if isrecord(op.name()) = 0 then iterate
      item = .record(_owner,i)
      if item.procedureid() <> _function | item.kind() = 'procedure' then iterate
      count = count + 1
      if count = ordinal then return item
    end
    call bad('LL_TARGET_RECORD: body ordinal outside records')
    return .record(_owner,0)

/** Static diagnostic labels are validated separately from executable binding
 * and proof authority. Addresses count ordinary instruction cells only. */
inlineindex: class
  _owner = reference .llir..module
  _recordsref = reference .int[]
  _prepared = .int
  _identity = .int
  _error = .string
  _used = .int
  _limit = .int
  _addresses = .int[]
  _addresspresent = .int[]
  _frames = .int[]
  _frameids = .int[]
  _maps = .int[]
  _starts = .int[]
  _ends = .int[]
  _mapframes = .int[]
  _labelkeys = .string[]
  _sourceids = .int[]
  _sourcerecords = .int[]
  _endkeys = .string[]
  *: factory
    arg owner = reference .llir..module, records_ref = reference .int[], work = .int
    _owner = owner; _recordsref = records_ref; _limit = work
    return
  matches: method = .int
    arg owner = reference .llir..module, records_ref = reference .int[]
    if _prepared = 0 | <refvalid>(_owner) = 0 | <refvalid>(_recordsref) = 0 then return 0
    graph = dereference owner
    return _identity = graph.identity() & (_owner <refsame> owner) & (_recordsref <refsame> records_ref)
  rebind: method = .int
    arg owner = reference .llir..module, records_ref = reference .int[]
    graph = dereference owner
    if _prepared = 0 | _error <> '' | _identity <> graph.identity() then return 0
    _owner = owner; _recordsref = records_ref
    return 1
  prepare: method = .void
    if _prepared then return
    _prepared = 1
    if <refvalid>(_owner) = 0 | <refvalid>(_recordsref) = 0 then do; _error = 'LL_TARGET_OWNER: expired inline diagnostics input'; return; end
    owner = _owner; records_ref = _recordsref
    graph = dereference owner; records = dereference records_ref; _identity = graph.identity()
    item = .record; prior = .record; field = .operand; name = .operand
    i = .int; j = .int; n = .int; ordinal = .int; parent = .int; next = .int; state = .int[]; path = .int[]
    frames = .string[]; sources = .string[]; maps = .string[]; framefn = .int[]; parents = .int[]
    maprecords = .int[]; coldrecords = .int[]; first = .int; last = .int; row = .string; key = .string
    previous = .int; id = .int; opid = .int; celladdress = .int; levels = .int; ignored = .int
    if spend(graph.operations() * 2 + records[0] * 2) = 0 then return
    celladdress = 0
    do i = 1 to records[0]
      item = .record(owner,records[i]); _addresses[item.id()] = celladdress; _addresspresent[item.id()] = 1
      if item.kind() = 'instruction' then celladdress = celladdress + 1 + item.operands()
      if item.kind() = '.inlineframe' then do
        field = item.operand(1); n = frames[0] + 1
        frames[n] = right(field.index() as .string,10,'0') || ':' || right(item.id() as .string,10,'0')
      end
      if item.kind() = '.inlinemap' then maprecords[maprecords[0] + 1] = item.id()
      if item.kind() = '.inlinerange' | item.kind() = '.inlineexit' then coldrecords[coldrecords[0] + 1] = item.id()
    end
    if frames[0] = 0 & maprecords[0] = 0 & coldrecords[0] = 0 then return
    levels = 1; n = max(1,records[0]); do while n > 1; n = n <idiv> 2; levels = levels + 1; end
    if spend(records[0] * (levels * 4 + 12)) = 0 then return
    ignored = arraysort(frames)
    do i = 1 to frames[0]
      row = frames[i]; _frameids[i] = left(row,10) as .int; _frames[i] = right(row,10) as .int
      if i > 1 then do; if _frameids[i] = _frameids[i - 1] then do; _error = 'LL_TARGET_INLINE: duplicate frame identity'; return; end; end
      item = .record(owner,_frames[i]); framefn[i] = item.procedureid()
      do j = 3 to 4
        field = item.operand(j); if validname(field.bytes()) = 0 then return
      end
    end
    do i = 1 to records[0]
      item = .record(owner,records[i])
      if item.kind() = 'label' then do
        field = item.operand(1); key = right(item.procedureid() as .string,10,'0') || ':' || field.text()
        if spend(length(key)) = 0 then return
        _labelkeys[_labelkeys[0] + 1] = key || ':' || right(item.id() as .string,10,'0')
      end
      if item.kind() = '.srcstep' then do
        field = item.operand(1)
        if field.index() > 0 then sources[sources[0] + 1] = right(field.index() as .string,10,'0') || ':' || right(item.id() as .string,10,'0')
      end
    end
    do i = 1 to coldrecords[0]
      item = .record(owner,coldrecords[i]); ordinal = 2
      if item.kind() = '.inlinerange' then ordinal = 1
      field = item.operand(ordinal + 1)
      _endkeys[_endkeys[0] + 1] = right(item.procedureid() as .string,10,'0') || ':' || field.text()
    end
    ignored = arraysort(_labelkeys); ignored = arraysort(sources)
    previous = 0
    do i = 1 to sources[0]
      row = sources[i]; id = left(row,10) as .int; opid = right(row,10) as .int
      if id = previous then do
        item = .record(owner,opid); prior = .record(owner,_sourcerecords[_sourcerecords[0]])
        if samefields(item,prior) = 0 then do; if _error = '' then _error = 'LL_TARGET_INLINE: conflicting source anchor'; return; end
      end
      else do; n = _sourceids[0] + 1; _sourceids[n] = id; _sourcerecords[n] = opid; previous = id; end
    end
    do i = 1 to _frames[0]
      item = .record(owner,_frames[i]); field = item.operand(2); parent = field.index()
      if parent > 0 then do
        ordinal = frameindex(parent)
        if ordinal = 0 then do; _error = 'LL_TARGET_INLINE: missing parent frame'; return; end
        if framefn[ordinal] <> framefn[i] then do; _error = 'LL_TARGET_INLINE: parent belongs to another physical procedure'; return; end
        parents[i] = ordinal
      end
      else parents[i] = 0
      field = item.operand(5)
      if field.index() > 0 then do
        if sourceindex(field.index()) = 0 then do; if _error = '' then _error = 'LL_TARGET_INLINE: missing source anchor'; return; end
      end
      state[i] = 0
    end
    do i = 1 to _frames[0]
      if state[i] = 2 then iterate
      assembler setattrs path,0
      next = i
      do while next > 0
        if spend(1) = 0 then return
        if state[next] = 1 then do; _error = 'LL_TARGET_INLINE: parent cycle'; return; end
        if state[next] = 2 then leave
        state[next] = 1; path[path[0] + 1] = next; next = parents[next]
      end
      do j = 1 to path[0]; state[path[j]] = 2; end
    end
    do i = 1 to maprecords[0]
      item = .record(owner,maprecords[i]); field = item.operand(3); ordinal = frameindex(field.index())
      if ordinal = 0 then do; _error = 'LL_TARGET_INLINE: map names missing frame'; return; end
      if framefn[ordinal] <> item.procedureid() then do; _error = 'LL_TARGET_INLINE: map belongs to another physical procedure'; return; end
      name = item.operand(1); first = labelid(item.procedureid(),name.text())
      field = item.operand(2); last = labelid(item.procedureid(),field.text())
      _endkeys[_endkeys[0] + 1] = right(item.procedureid() as .string,10,'0') || ':' || field.text()
      if first = 0 | last = 0 then do
        if _error = '' then do
          _error = 'LL_TARGET_INLINE: unresolved range label'
          if first = 0 then _error = _error || ' start=' || name.text()
          if last = 0 then _error = _error || ' end=' || field.text()
        end
        return
      end
      first = _addresses[first]; last = _addresses[last]
      if first >= last then do; _error = 'LL_TARGET_INLINE: empty or reversed range'; return; end
      maps[i] = right(first as .string,20,'0') || ':' || right(last as .string,20,'0') || ':' || right(i as .string,10,'0')
    end
    ignored = arraysort(maps); ignored = arraysort(_endkeys); previous = -1
    do i = 1 to maps[0]
      row = maps[i]; first = left(row,20) as .int; last = substr(row,22,20) as .int; ordinal = right(row,10) as .int
      if first < previous then do; _error = 'LL_TARGET_INLINE: overlapping ranges'; return; end
      _maps[i] = maprecords[ordinal]; _starts[i] = first; _ends[i] = last
      item = .record(owner,_maps[i]); field = item.operand(3); _mapframes[i] = field.index(); previous = last
    end
    return
  spend: method = .int
    arg amount = .int
    if amount < 0 | amount > _limit - _used then do; _error = 'LL_RESOURCE_LIMIT: target.inline diagnostics work'; return 0; end
    _used = _used + amount; return 1
  validname: method = .int
    arg text = .binary
    if <blen>(text) = 0 then do; _error = 'LL_TARGET_INLINE: empty diagnostic name'; return 0; end
    if spend(<blen>(text)) = 0 then return 0
    do n = 0 to <blen>(text) - 1
      if (<at..u8>(n) text) = 0 then do; _error = 'LL_TARGET_INLINE: NUL diagnostic name'; return 0; end
    end
    return 1
  samefields: method = .int
    arg left = .lltarget..record, right = .lltarget..record
    field = .operand; other = .operand
    if left.operands() <> right.operands() then return 0
    if spend(left.operands()) = 0 then return 0
    do n = 1 to left.operands()
      field = left.operand(n); other = right.operand(n)
      if field.kind() <> other.kind() then return 0
      if field.kind() = 'I' then do; if field.index() <> other.index() then return 0; end
      else if field.bytes() <> other.bytes() then return 0
    end
    return 1
  labelid: method = .int
    arg functionid = .int, name = .string, charge = 1
    /* The index sorts key:id rows. Compare the same terminated key: bare
     * names order differently when one is a prefix of another (.1/.10). */
    key = right(functionid as .string,10,'0') || ':' || name || ':'; lower = 1; upper = _labelkeys[0]; less = .int
    do while lower <= upper
      if charge then do; if spend(1) = 0 then return 0; end
      middle = lower + ((upper - lower) <idiv> 2); row = _labelkeys[middle]; candidate = left(row,length(key))
      if key == candidate then return right(row,10) as .int
      assembler slt less,key,row
      if less then upper = middle - 1
      else lower = middle + 1
    end
    return 0
  labeladdress: method = .int
    arg functionid = .int, name = .string
    call prepare()
    id = labelid(functionid,name,0)
    if id = 0 then return -1
    return addressat(id)
  sourceindex: method = .int
    arg id = .int
    call prepare()
    lower = 1; upper = _sourceids[0]
    do while lower <= upper
      middle = lower + (upper - lower) <idiv> 2
      if _sourceids[middle] = id then return middle
      if id < _sourceids[middle] then upper = middle - 1
      else lower = middle + 1
    end
    return 0
  sourcerecord: method = .int
    arg id = .int
    call prepare()
    ordinal = sourceindex(id)
    if ordinal = 0 then return 0
    return _sourcerecords[ordinal]
  frameindex: method = .int
    arg id = .int
    call prepare()
    lower = 1; upper = _frameids[0]
    do while lower <= upper
      middle = lower + (upper - lower) <idiv> 2
      if _frameids[middle] = id then return middle
      if id < _frameids[middle] then upper = middle - 1
      else lower = middle + 1
    end
    return 0
  endlabel: method = .int
    arg functionid = .int, name = .string
    call prepare()
    key = right(functionid as .string,10,'0') || ':' || name; lower = 1; upper = _endkeys[0]; less = .int
    do while lower <= upper
      middle = lower + (upper - lower) <idiv> 2; candidate = _endkeys[middle]
      if key == candidate then return 1
      assembler slt less,key,candidate
      if less then upper = middle - 1
      else lower = middle + 1
    end
    return 0
  identity: method = .int
    call prepare()
    return _identity
  error: method = .string
    call prepare()
    return _error
  usedwork: method = .int
    call prepare()
    return _used
  frames: method = .int
    call prepare()
    return _frames[0]
  frame: method = .int
    arg ordinal = .int
    call prepare()
    return _frames[ordinal]
  maps: method = .int
    call prepare()
    return _maps[0]
  map: method = .int
    arg ordinal = .int
    call prepare()
    return _maps[ordinal]
  mapstart: method = .int
    arg ordinal = .int
    call prepare()
    return _starts[ordinal]
  mapend: method = .int
    arg ordinal = .int
    call prepare()
    return _ends[ordinal]
  addressat: method = .int
    arg operation = .int
    call prepare()
    if operation < 1 | operation > _addresspresent[0] then return -1
    if _addresspresent[operation] = 0 then return -1
    return _addresses[operation]
  frameat: method = .int
    arg operation = .int
    call prepare()
    celladdress = addressat(operation); lower = 1; upper = _maps[0]
    if celladdress < 0 then return -1
    do while lower <= upper
      middle = lower + (upper - lower) <idiv> 2
      if celladdress < _starts[middle] then upper = middle - 1
      else if celladdress >= _ends[middle] then lower = middle + 1
      else return _mapframes[middle]
    end
    return 0

/** Checked executable region and borrowed-suffix metadata. Lexical addresses
 * come from the single target address index, independently of executable CFG
 * reachability and SIGNALORIGIN. This validates representation/ownership; it
 * neither executes actions nor asserts producer save/value correctness. */
coldindex: class
  _owner = reference .llir..module
  _recordsref = reference .int[]
  _globals = .int
  _prepared = .int
  _identity = .int
  _inline = .inlineindex
  _error = .string
  _limit = .int
  _used = .int
  _regionids = .int[]
  _regionops = .int[]
  _parents = .int[]
  _depths = .int[]
  _rangeops = .int[]
  _rangeregions = .int[]
  _rangeparents = .int[]
  _lookupranges = .int[]
  _starts = .int[]
  _ends = .int[]
  _actionops = .int[]
  _actionregions = .int[]
  _actionstarts = .int[]
  _actionends = .int[]
  _actionnext = .int[]
  _actionheads = .int[]
  _actioncounts = .int[]
  _lookuplevels = .int
  _ownedlocals = .int[]
  _privatecounts = .int[]
  *: factory
    arg owner = reference .llir..module, records_ref = reference .int[], addresses = .inlineindex, globals = .int, work = .int
    _owner = owner; _recordsref = records_ref; _inline = addresses; _globals = globals; _limit = work
    return
  matches: method = .int
    arg owner = reference .llir..module, records_ref = reference .int[]
    if _prepared = 0 | <refvalid>(_owner) = 0 | <refvalid>(_recordsref) = 0 then return 0
    graph = dereference owner
    return _identity = graph.identity() & (_owner <refsame> owner) & (_recordsref <refsame> records_ref) & _inline.matches(owner,records_ref)
  rebind: method = .int
    arg owner = reference .llir..module, records_ref = reference .int[], addresses = .inlineindex
    graph = dereference owner
    if _prepared = 0 | _error <> '' | _identity <> graph.identity() then return 0
    _owner = owner; _recordsref = records_ref; _inline = addresses
    return 1
  prepare: method = .void
    if _prepared then return
    _prepared = 1
    if <refvalid>(_owner) = 0 | <refvalid>(_recordsref) = 0 then do; _error = 'LL_TARGET_OWNER: expired cold metadata input'; return; end
    owner = _owner; records_ref = _recordsref; addresses = _inline; globals = _globals
    graph = dereference owner; records = dereference records_ref; _identity = graph.identity()
    rows = .string[]; bindings = .string[]; ranges = .string[]; actionrows = .string[]; actiontails = .int[]
    locals = .int[]; procstarts = .int[]; procends = .int[]; seen = .int[]
    colors = .int[]; path = .int[]; stack = .int[]
    item = .record; region = .record; value = .operand; prior = .record
    i = .int; j = .int; f = .int; active = .int; at = .int; finish = .int
    ordinal = .int; parent = .int; current = .int; first = .int; last = .int; found = .int
    previous = .string; row = .string; ignored = .int; count = .int; top = .int; depth = .int
    if spend(records[0] * 4 + graph.functions() * 8) = 0 then return
    do i = 1 to records[0]
      item = .record(owner,records[i]); f = item.procedureid(); at = addresses.addressat(item.id())
      if item.kind() = 'procedure' then do
        if active > 1 then procends[active] = at
        active = f; value = item.operand(2); locals[f] = value.index(); _ownedlocals[f] = value.index()
        _privatecounts[f] = 0; procstarts[f] = at; seen[f] = 0
      end
      if item.kind() = 'instruction' then do; seen[f] = 1; finish = at + 1 + item.operands(); end
      if item.kind() = '.inlinedprivate' then do
        if seen[f] then do; _error = 'LL_TARGET_PRIVATE: declaration follows executable code'; return; end
        value = item.operand(1); _ownedlocals[f] = min(_ownedlocals[f],value.index())
        _privatecounts[f] = _privatecounts[f] + 1
        bindings[bindings[0] + 1] = right(f as .string,10,'0') || ':' || right(value.index() as .string,10,'0')
      end
      if item.kind() = '.inlineregion' then rows[rows[0] + 1] = right(item.regionid() as .string,10,'0') || ':' || right(item.id() as .string,10,'0')
      if item.kind() = '.inlinerange' then _rangeops[_rangeops[0] + 1] = item.id()
      if item.kind() = '.inlineexit' then _actionops[_actionops[0] + 1] = item.id()
    end
    if active > 1 then procends[active] = finish
    do f = 2 to graph.functions()
      if _privatecounts[f] <> locals[f] - _ownedlocals[f] then do; _error = 'LL_TARGET_PRIVATE: incomplete borrowed local suffix'; return; end
    end
    levels = 1; count = max(1,records[0]); do while count > 1; count = count <idiv> 2; levels = levels + 1; end
    _lookuplevels = levels
    if spend(records[0] * (levels * 4 + 4)) = 0 then return
    ignored = arraysort(bindings); previous = ''
    do i = 1 to bindings[0]
      if bindings[i] = previous then do; _error = 'LL_TARGET_PRIVATE: duplicate borrowed local slot'; return; end
      previous = bindings[i]
    end
    ignored = arraysort(rows)
    do i = 1 to rows[0]
      row = rows[i]; _regionids[i] = left(row,10) as .int; _regionops[i] = right(row,10) as .int
      _parents[i] = 0; _depths[i] = 0; _actionheads[i] = 0; _actioncounts[i] = 0; actiontails[i] = 0; colors[i] = 0
      if i > 1 then do; if _regionids[i] = _regionids[i - 1] then do; _error = 'LL_TARGET_REGION: duplicate identity'; return; end; end
    end
    do i = 1 to _regionids[0]
      item = .record(owner,_regionops[i]); f = item.procedureid(); at = addresses.addressat(item.id())
      if at < procstarts[f] | at >= procends[f] then do; _error = 'LL_TARGET_REGION: declaration outside owning procedure code'; return; end
      parent = index(item.parentregion())
      if item.parentregion() <> 0 & parent = 0 then do; _error = 'LL_TARGET_REGION: missing parent'; return; end
      if parent > 0 then do
        region = .record(owner,_regionops[parent])
        if region.procedureid() <> f then do; _error = 'LL_TARGET_REGION: parent belongs to another procedure'; return; end
      end
      _parents[i] = parent
    end
    do i = 1 to _regionids[0]
      if colors[i] = 2 then iterate
      assembler setattrs path,0
      current = i
      do while current > 0
        if spend(1) = 0 then return
        if colors[current] = 1 then do; _error = 'LL_TARGET_REGION: parent cycle'; return; end
        if colors[current] = 2 then leave
        colors[current] = 1; path[path[0] + 1] = current; current = _parents[current]
      end
      depth = 0
      if current > 0 then depth = _depths[current]
      do j = path[0] to 1 by -1
        depth = depth + 1; current = path[j]; colors[current] = 2; _depths[current] = depth
      end
    end
    do i = 1 to _rangeops[0]
      item = .record(owner,_rangeops[i]); ordinal = index(item.regionid())
      if ordinal = 0 then do; _error = 'LL_TARGET_REGION: range names missing region'; return; end
      region = .record(owner,_regionops[ordinal]); f = item.procedureid()
      if region.procedureid() <> f then do; _error = 'LL_TARGET_REGION: range belongs to another procedure'; return; end
      value = item.operand(1); first = addresses.labeladdress(f,value.text())
      value = item.operand(2); last = addresses.labeladdress(f,value.text())
      if first < procstarts[f] | first >= last | last > procends[f] then do; _error = 'LL_TARGET_REGION: unresolved, empty or foreign range'; return; end
      _rangeregions[i] = ordinal; _starts[i] = first; _ends[i] = last
      ranges[i] = right(first as .string,20,'0') || ':' || right(_depths[ordinal] as .string,10,'0') || ':' || right(i as .string,10,'0')
    end
    ignored = arraysort(ranges); top = 0
    do i = 1 to ranges[0]
      ordinal = right(ranges[i],10) as .int; current = _rangeregions[ordinal]; _lookupranges[i] = ordinal; _rangeparents[ordinal] = 0
      do while top > 0
        if spend(1) = 0 then return
        if _ends[stack[top]] > _starts[ordinal] then leave
        top = top - 1
      end
      if top > 0 then do
        priorrange = stack[top]; _rangeparents[ordinal] = priorrange
        if _parents[current] <> _rangeregions[priorrange] | _ends[ordinal] > _ends[priorrange] then do; _error = 'LL_TARGET_REGION: overlapping sibling or noncontained child range'; return; end
      end
      else if _parents[current] <> 0 then do; _error = 'LL_TARGET_REGION: child range lacks parent range'; return; end
      top = top + 1; stack[top] = ordinal
    end
    do i = 1 to _regionops[0]
      item = .record(owner,_regionops[i]); at = addresses.addressat(item.id()); found = 0
      do j = 1 to _rangeops[0]
        if spend(1) = 0 then return
        if _rangeregions[j] = i & _starts[j] <= at & at < _ends[j] then found = 1
      end
      if found = 0 then do; _error = 'LL_TARGET_REGION: declaration is outside its ranges'; return; end
    end
    do i = 1 to _actionops[0]
      item = .record(owner,_actionops[i]); ordinal = index(item.regionid())
      if ordinal = 0 then do; _error = 'LL_TARGET_REGION: action names missing region'; return; end
      region = .record(owner,_regionops[ordinal]); f = item.procedureid()
      if region.procedureid() <> f then do; _error = 'LL_TARGET_REGION: action belongs to another procedure'; return; end
      value = item.operand(2); first = addresses.labeladdress(f,value.text())
      value = item.operand(3); last = addresses.labeladdress(f,value.text()); found = 0
      if first < 0 | first >= last then do; _error = 'LL_TARGET_REGION: unresolved or empty action phase'; return; end
      do j = 1 to _rangeops[0]
        if spend(1) = 0 then return
        if _rangeregions[j] = ordinal & _starts[j] <= first & last <= _ends[j] then found = 1
      end
      if found = 0 then do; _error = 'LL_TARGET_REGION: action phase is outside its range'; return; end
      do j = 1 to item.registerrefs()
        value = item.registerref(j)
        if value.index() > 4294967295 then do; _error = 'LL_TARGET_REGION: cold register index exceeds u32'; return; end
        if value.bank() = 'a' then do
          if value.index() > 2147483647 - locals[f] - globals then do; _error = 'LL_TARGET_REGION: packed argument index exceeds VM range'; return; end
        end
        if (wordpos(item.action(),'digits fuzz form case standard endlife') > 0) & value.index() >= _ownedlocals[f] then do; _error = 'LL_TARGET_REGION: cold base is borrowed storage'; return; end
      end
      value = item.operand(4)
      do j = 1 to i - 1
        if spend(1) = 0 then return
        if _actionregions[j] <> ordinal | last <= _actionstarts[j] | first >= _actionends[j] then iterate
        prior = .record(owner,_actionops[j]); order = prior.operand(4)
        if order.index() = value.index() then do; _error = 'LL_TARGET_REGION: overlapping action order'; return; end
      end
      _actionregions[i] = ordinal; _actionstarts[i] = first; _actionends[i] = last
      actionrows[i] = right(ordinal as .string,10,'0') || ':' || right(value.index() as .string,10,'0') || ':' || right(first as .string,20,'0') || ':' || right(i as .string,10,'0')
    end
    ignored = arraysort(actionrows)
    do i = 1 to actionrows[0]
      current = right(actionrows[i],10) as .int; ordinal = _actionregions[current]; _actionnext[current] = 0
      if actiontails[ordinal] > 0 then _actionnext[actiontails[ordinal]] = current
      else _actionheads[ordinal] = current
      actiontails[ordinal] = current; _actioncounts[ordinal] = _actioncounts[ordinal] + 1
    end
    return
  spend: method = .int
    arg amount = .int
    if amount < 0 | amount > _limit - _used then do; _error = 'LL_RESOURCE_LIMIT: target.cold metadata work'; return 0; end
    _used = _used + amount; return 1
  index: method = .int
    arg id = .int
    lower = 1; upper = _regionids[0]
    do while lower <= upper
      middle = lower + (upper - lower) <idiv> 2
      if _regionids[middle] = id then return middle
      if id < _regionids[middle] then upper = middle - 1
      else lower = middle + 1
    end
    return 0
  error: method = .string
    call prepare()
    return _error
  usedwork: method = .int
    call prepare()
    return _used
  ownedlocals: method = .int
    arg functionid = .int
    call prepare()
    return _ownedlocals[functionid]
  privatebindings: method = .int
    arg functionid = .int
    call prepare()
    return _privatecounts[functionid]
  regions: method = .int
    call prepare()
    return _regionids[0]
  regionid: method = .int
    arg ordinal = .int
    call prepare()
    return _regionids[ordinal]
  regionop: method = .int
    arg id = .int
    call prepare()
    ordinal = index(id)
    if ordinal = 0 then return 0
    return _regionops[ordinal]
  regionat: method = .int
    arg operation = .int
    call prepare()
    at = _inline.addressat(operation)
    if at < 0 then return -1
    source = .record(_owner,operation)
    if source.valid() = 0 then return -1
    if source.procedureid() < 2 then return 0
    lower = 1; upper = _lookupranges[0]; found = 0; range = .int
    do while lower <= upper
      middle = lower + (upper - lower) <idiv> 2; range = _lookupranges[middle]
      if _starts[range] <= at then do; found = middle; lower = middle + 1; end
      else upper = middle - 1
    end
    if found = 0 then return 0
    range = _lookupranges[found]
    do while range > 0
      if _starts[range] <= at & at < _ends[range] then return _regionids[_rangeregions[range]]
      range = _rangeparents[range]
    end
    return 0
  actionwork: method = .int
    arg id = .int
    call prepare()
    region = index(id)
    if id = 0 then return _lookuplevels * 2 + 8
    if region = 0 then do; call bad('LL_TARGET_REGION: invalid cold action region'); return 0; end
    return _actioncounts[region] * 2 + _lookuplevels * 2 + 8
  /** One owned ordered phase snapshot; reserve its whole possible append cost
   * before retaining any result. An empty active phase is a valid empty array. */
  actionids: method = .int[]
    arg id = .int, operation = .int, work = .int, bytes = .int
    call prepare()
    result = .int[]; region = index(id); at = _inline.addressat(operation)
    if at < 0 | (id <> 0 & region = 0) then do; call bad('LL_TARGET_REGION: invalid cold action phase'); return result; end
    required = actionwork(id)
    if work < required | bytes < 1 then do; call bad('LL_RESOURCE_LIMIT: target.cold query work/bytes'); return result; end
    if id = 0 then return result
    if _actioncounts[region] > bytes <idiv> 8 then do; call bad('LL_RESOURCE_LIMIT: target.cold query bytes'); return result; end
    source = .record(_owner,operation); owner = .record(_owner,_regionops[region])
    if source.valid() = 0 | source.procedureid() <> owner.procedureid() then do; call bad('LL_TARGET_REGION: foreign cold action phase'); return result; end
    current = _actionheads[region]
    do while current > 0
      if _actionstarts[current] <= at & at < _actionends[current] then result[result[0] + 1] = _actionops[current]
      current = _actionnext[current]
    end
    return result
  activeactions: method = .int
    arg id = .int, operation = .int, ordinal = 0
    call prepare()
    region = index(id); at = _inline.addressat(operation); count = 0
    if at < 0 then return -1
    if id = 0 then return 0
    if region = 0 then return -1
    source = .record(_owner,operation); owner = .record(_owner,_regionops[region])
    if source.valid() = 0 | source.procedureid() <> owner.procedureid() then return -1
    current = _actionheads[region]
    do while current > 0
      if _actionstarts[current] <= at & at < _actionends[current] then do
        count = count + 1
        if ordinal = count then return _actionops[current]
      end
      current = _actionnext[current]
    end
    if ordinal = 0 then return count
    return 0

module: class
  _graph = .llir..module
  _cfg = .cfgcheck
  _inline = .inlineindex
  _cold = .coldindex
  _records = .int[]
  _headers = .int[]
  _error = .string
  _name = .string
  _artifact = .string
  _globals = .int
  _validationwork = .int
  _validationlimit = .int
  _prepared = .int
  _revision = .int
  *: factory
    arg graph = .llir..module, work = 1000000
    _graph = graph; _validationlimit = work; _validationwork = work
    return
  prepare: method = .void
    if _prepared then do
      if _revision = _graph.identity() then do
        if _error <> '' then return
        if _inline.matches(reference _graph,reference _records) & _cold.matches(reference _graph,reference _records) then return
        if _inline.rebind(reference _graph,reference _records) then do
          if _cold.rebind(reference _graph,reference _records,_inline) then return
        end
      end
      assembler setattrs _records,0
      assembler setattrs _headers,0
      _error = ''
    end
    _prepared = 1; _revision = _graph.identity()
    work = _validationlimit; initialwork = work; _validationwork = work
    i = .int; j = .int; k = .int; fn = .int; slot = .int
    found = .int; n = .int; size = .int; cost = .int; index = .int
    position = .int; payloadbytes = .int
    bits = .binary; vector = .binary; bank = .string; signature = .string
    item = .record; declaration = .record; op = .llir..opview
    field = .operand; imported = .operand; label = .operand
    trace_source = .operand; trace_bank = .operand; trace_value = .operand
    encoding = .llsource..prepared
    do
    _error = _graph.error(); catalog = .llrxascatalog..catalog()
    if _error <> '' then return
    store = dereference _graph.storage(); contract = dereference store.contract(); expected = schema()
    if contract.manifest() <> expected.manifest() then do
      _error = 'LL_TARGET_SCHEMA: incompatible target contract'; return
    end
    if _graph.functions() < 1 then do; _error = 'LL_TARGET_SCHEMA: missing catalogue'; return; end
    catalogue = _graph.function(1)
    if catalogue.name() <> '$target.catalogue' then do; _error = 'LL_TARGET_SCHEMA: catalogue identity'; return; end
    descriptor = 0
    slotfn = .int[]; slotbank = .string[]; slotindex = .int[]
    headerfn = .int[]; localcount = .int[]; type = contract.type('rxas.target.cell')
    do i = 1 to _graph.operations()
      work = work - 1
      if work < 0 then do; _error = 'LL_RESOURCE_LIMIT: target.validation work'; return; end
      op = _graph.operation(i)
      if op.name() = 'rxas.target.module' then do
        descriptor = descriptor + 1
        _name = op.attribute('name') as .string; _artifact = op.attribute('artifact') as .string
        bits = op.attribute('globals'); _globals = <at..i64>(0) bits
        if op.attribute('catalog') as .string <> catalog.fingerprint() then _error = 'LL_TARGET_SCHEMA: stale opcode catalog'
        else if _name = '' | _artifact = '' | _globals < 0 then _error = 'LL_TARGET_MODULE: invalid descriptor'
        else if store.get(2,op.blockid(),1) <> 1 then _error = 'LL_TARGET_OWNER: module outside catalogue'
        if _error <> '' then return
      end
      else if op.name() = 'rxas.target.register' then do
        bits = op.attribute('body'); fn = <at..i64>(0) bits
        bits = op.attribute('slot'); slot = <at..i64>(0) bits
        bank = op.attribute('bank') as .string; bits = op.attribute('index'); index = <at..i64>(0) bits
        if slot < 1 | slot > store.count(5) | fn < 2 | fn > _graph.functions() | wordpos(bank,'r g a') = 0 | index < 0 then do
          _error = 'LL_TARGET_REGISTER: invalid descriptor'; return
        end
        if slotfn[slot] <> 0 | store.get(5,slot,1) <> fn | store.get(5,slot,2) <> type.id() | store.text(store.get(5,slot,3)) <> (bank || index) then do
          _error = 'LL_TARGET_REGISTER: descriptor/slot mismatch'; return
        end
        if store.get(2,op.blockid(),1) <> 1 then do; _error = 'LL_TARGET_OWNER: register outside catalogue'; return; end
        slotfn[slot] = fn; slotbank[slot] = bank; slotindex[slot] = index
      end
      else if isrecord(op.name()) = 0 & store.get(3,i,1) <> 7 & store.get(3,i,1) <> 5 then do
        _error = 'LL_TARGET_SCHEMA: unexpected executable IR operation'; return
      end
      if isrecord(op.name()) = 0 then iterate
      item = .record(reference _graph,i); _records[_records[0] + 1] = i
      vector = op.attribute('operands'); codec = .operandcodec()
      if codec.check(vector) <> '' then do; _error = 'LL_TARGET_OPERAND: invalid encoded vector'; return; end
      n = item.operands(); size = <blen>(vector)
      if n > work | size > work | n > work / max(1,n) then do; _error = 'LL_RESOURCE_LIMIT: target.validation work'; return; end
      cost = n * n
      if cost > work - size then do; _error = 'LL_RESOURCE_LIMIT: target.validation work'; return; end
      work = work - cost - size
      /* Every S is an RXAS string, including metadata fields. Charge the
       * encoded payload before unpacking or constructing the shared UTF-8
       * validator; B remains arbitrary binary spelling. */
      position = 4
      do j = 1 to n
        payloadbytes = <at..u32>(position + 24) vector
        if (<at..u32>(position) vector) = 3 then do
          if payloadbytes > work then do; _error = 'LL_RESOURCE_LIMIT: target.string work'; return; end
          work = work - payloadbytes
          field = unpack(vector,j,store.identity())
          encoding = .llsource..prepared(field.bytes())
          call encoding.utf8()
          if encoding.error() <> '' then do
            _error = 'LL_TARGET_STRING: ' || encoding.error() || ' at byte ' || encoding.offset(); return
          end
        end
        position = position + 28 + payloadbytes
      end
      shape = recordshape(item)
      if shape <> '' then do; _error = 'LL_TARGET_RECORD: ' || shape; return; end
      fn = item.procedureid()
      if item.kind() = 'procedure' then do
        if fn > _graph.functions() | headerfn[fn] <> 0 then do; _error = 'LL_TARGET_OWNER: procedure/header mismatch'; return; end
        name = item.operand(1); number = item.operand(2); function_view = _graph.function(fn)
        if name.text() <> function_view.name() | store.get(2,op.blockid(),1) <> 1 then do; _error = 'LL_TARGET_OWNER: procedure identity'; return; end
        _headers[_headers[0] + 1] = i; headerfn[fn] = i; localcount[fn] = number.index()
      end
      else if store.get(2,op.blockid(),1) <> max(1,fn) then do
        _error = 'LL_TARGET_OWNER: record/function mismatch'; return
      end
    end
    if descriptor <> 1 then _error = 'LL_TARGET_SCHEMA: expected one module descriptor'
    if _error <> '' then return
    if _headers[0] <> _graph.functions() - 1 | slotfn[0] <> store.count(5) then do
      _error = 'LL_TARGET_OWNER: orphan procedure or register'; return
    end
    do i = 1 to store.count(5)
      if slotfn[i] = 0 then do; _error = 'LL_TARGET_REGISTER: orphan slot'; return; end
      if (slotbank[i] = 'r' & slotindex[i] >= localcount[slotfn[i]]) | (slotbank[i] = 'g' & slotindex[i] >= _globals) then do
        _error = 'LL_TARGET_REGISTER: descriptor bank bounds'; return
      end
    end
    do i = 1 to _records[0]
      item = .record(reference _graph,_records[i])
      signature = ''
      if item.procedureid() > 1 & headerfn[item.procedureid()] = 0 then do; _error = 'LL_TARGET_OWNER: missing procedure'; return; end
      if item.kind() = '.globalexpose' then do
        global = item.operand(1)
        if global.index() < 0 | global.index() >= _globals then do; _error = 'LL_TARGET_REGISTER: exposed global outside module'; return; end
      end
      if item.kind() = '.traceevent' then do
        do k = 1 to 5
          if k = 2 then iterate
          field = item.operand(k)
          if field.length() > 1 then do; _error = 'LL_TARGET_METADATA: TRACE code must be empty or one byte'; return; end
          /* TRACE codes use raw quoted bytes. Admit literal ASCII controls
           * and DEL, while naming the remaining native text boundaries. */
          if field.length() = 1 then do
            bits = field.bytes(); index = <at..u8>(0) bits
            if index = 0 | index = 10 | index = 13 | index = 34 then do
              _error = 'LL_TARGET_PROFILE: TRACE code byte is not representable in native RXAS text: ' || index; return
            end
            if index = 92 then do
              _error = 'LL_TARGET_PROFILE: TRACE backslash token boundary needs lexical proof'; return
            end
            if index > 127 then do
              _error = 'LL_TARGET_PROFILE: TRACE code byte is outside UTF-8 RXAS text'; return
            end
          end
        end
        trace_source = item.operand(3); trace_bank = item.operand(5); trace_value = item.operand(6)
        if trace_source.text() = 'K' & trace_value.index() >= 0 then do
          _error = 'LL_TARGET_PROFILE: TRACE constant-pool offset needs relocatable binding'; return
        end
        if trace_source.text() = 'R' & trace_value.index() >= 0 then do
          if wordpos(lower(trace_bank.text()),'r g a') = 0 then do
            _error = 'LL_TARGET_PROFILE: unsupported logical TRACE register bank'; return
          end
          bank = lower(trace_bank.text()); index = trace_value.index(); fn = item.procedureid(); found = 0
          if (bank = 'r' & index >= localcount[fn]) | (bank = 'g' & index >= _globals) then do; _error = 'LL_TARGET_METADATA: TRACE register bank bounds'; return; end
          do k = 1 to store.count(5)
            work = work - 1
            if work < 0 then do; _error = 'LL_RESOURCE_LIMIT: target.metadata work'; return; end
            if slotfn[k] = fn & slotbank[k] = bank & slotindex[k] = index then found = 1
          end
          if found = 0 then do; _error = 'LL_TARGET_METADATA: TRACE register has no storage descriptor'; return; end
        end
      end
      do j = 1 to item.operands()
        work = work - 1
        if work < 0 then do; _error = 'LL_RESOURCE_LIMIT: target.validation work'; return; end
        field = item.operand(j)
        signature = signature || field.kind()
        if field.kind() = 'R' then do
          slot = field.slotid(); fn = item.procedureid()
          if slot < 1 | slot > store.count(5) then _error = 'LL_TARGET_REGISTER: invalid L slot'
          else if slotfn[slot] <> fn | field.procedureid() <> fn | slotbank[slot] <> field.bank() | slotindex[slot] <> field.index() then _error = 'LL_TARGET_OWNER: register/descriptor mismatch'
          else if (field.bank() = 'r' & field.index() >= localcount[fn]) | (field.bank() = 'g' & field.index() >= _globals) then _error = 'LL_TARGET_REGISTER: bank bounds'
          if _error <> '' then return
        end
        if wordpos(field.kind(),'L P') > 0 then do
          if field.kind() = 'P' & item.kind() = 'instruction' & qualifiedprocedure(field.text()) then nop
          else if namesafe(field.text(),item.kind() = 'procedure' & j = 3) = 0 then _error = 'LL_TARGET_NAME: unsupported identifier spelling'
          if _error <> '' then return
        end
        if wordpos(field.kind(),'F D C B') > 0 then do
          work = work - field.length()
          if work < 0 then do; _error = 'LL_RESOURCE_LIMIT: target.literal work'; return; end
          if literalerror(field.kind(),field.bytes()) <> '' then _error = 'LL_TARGET_LITERAL: invalid spelling'
          if _error <> '' then return
        end
        if item.kind() = 'instruction' & field.kind() = 'P' then do
          work = work - _records[0]
          if work < 0 then do; _error = 'LL_RESOURCE_LIMIT: target.binding work'; return; end
          found = qualifiedprocedure(field.text()) | findprocedure(reference _graph,reference _headers,field.text()) > 0
          do k = 1 to _records[0] while found = 0
            work = work - 1
            if work < 0 then do; _error = 'LL_RESOURCE_LIMIT: target.binding work'; return; end
            declaration = .record(reference _graph,_records[k])
            if declaration.kind() = '.import' & declaration.operands() > 0 then do
              imported = declaration.operand(1); found = imported.text() == field.text()
            end
          end
          if found = 0 then _error = 'LL_TARGET_BINDING: unresolved procedure ' || field.text()
          if _error <> '' then return
        end
        if item.kind() = 'instruction' & catalog.branch(item.opcode(),j) then do
          found = 0
          do k = 1 to _records[0]
            work = work - 1
            if work < 0 then do; _error = 'LL_RESOURCE_LIMIT: target.binding work'; return; end
            declaration = .record(reference _graph,_records[k])
            if declaration.kind() = 'label' & declaration.procedureid() = item.procedureid() then do
              label = declaration.operand(1)
              if label.text() == field.text() then found = 1
            end
          end
          if found = 0 then _error = 'LL_TARGET_BINDING: unresolved branch label ' || field.text()
          if _error <> '' then return
        end
      end
      if item.kind() = 'instruction' then do
        opcode = item.opcode()
        if opcode < 0 | opcode >= catalog.count() then _error = 'LL_TARGET_OPCODE: outside canonical catalog'
        else if catalog.find(catalog.field(opcode,1),signature) <> opcode then _error = 'LL_TARGET_OPCODE: canonical signature mismatch'
      end
      if _error <> '' then return
    end
    _inline = .inlineindex(reference _graph,reference _records,work)
    if _inline.error() <> '' then do; _error = _inline.error(); return; end
    work = work - _inline.usedwork()
    _cold = .coldindex(reference _graph,reference _records,_inline,_globals,work)
    if _cold.error() <> '' then do; _error = _cold.error(); return; end
    work = work - _cold.usedwork()
    _cfg = .cfgcheck(reference _graph,reference _records,work,_inline)
    if _cfg.error() <> '' then _error = _cfg.error()
    else _validationwork = initialwork - work + _cfg.usedwork()
    on signal as problem
      if _error = '' then _error = 'LL_TARGET_INVALID: ' || problem.name() || ': ' || problem.message()
    end
    return
  error: method = .string
    call prepare()
    return _error
  valid: method = .int
    call prepare()
    return _error = ''
  validationwork: method = .int
    call prepare()
    return _validationwork
  identity: method = .int
    call prepare()
    graph_ref = reference _graph; graph = dereference graph_ref
    return graph.identity()
  ir: method = reference .llir..module
    call prepare()
    return reference _graph
  name: method = .string
    call prepare()
    return _name
  artifact: method = .string
    call prepare()
    return _artifact
  globals: method = .int
    call prepare()
    return _globals
  ownedlocals: method = .int
    arg functionid = .int
    call prepare()
    if _error <> '' | functionid < 2 | functionid > _graph.functions() then do; call bad('LL_TARGET_OWNER: invalid owned-local query'); return 0; end
    return _cold.ownedlocals(functionid)
  privatebindings: method = .int
    arg functionid = .int
    call prepare()
    if _error <> '' | functionid < 2 | functionid > _graph.functions() then return 0
    return _cold.privatebindings(functionid)
  regions: method = .int
    call prepare()
    if _error <> '' then return 0
    return _cold.regions()
  regionid: method = .int
    arg ordinal = .int
    call prepare()
    if _error <> '' | ordinal < 1 | ordinal > _cold.regions() then do; call bad('LL_TARGET_REGION: invalid region ordinal'); return 0; end
    return _cold.regionid(ordinal)
  region: method = .lltarget..record
    arg id = .int
    call prepare()
    operation = _cold.regionop(id)
    if _error <> '' | operation = 0 then call bad('LL_TARGET_REGION: missing region identity')
    return .record(reference _graph,operation)
  regionat: method = .int
    arg operation = .int
    call prepare()
    if _error <> '' then return -1
    return _cold.regionat(operation)
  exitactionwork: method = .int
    arg regionid = .int
    call prepare()
    if _error <> '' then do; call bad('LL_TARGET_REGION: invalid target module'); return 0; end
    return _cold.actionwork(regionid)
  exitactionids: method = .int[]
    arg regionid = .int, operation = .int, work = 1000000, bytes = 67108864
    call prepare()
    empty = .int[]
    if _error <> '' then do; call bad('LL_TARGET_REGION: invalid target module'); return empty; end
    return _cold.actionids(regionid,operation,work,bytes)
  exitactions: method = .int
    arg regionid = .int, operation = .int
    call prepare()
    if _error <> '' then do; call bad('LL_TARGET_REGION: invalid target module'); return 0; end
    count = _cold.activeactions(regionid,operation)
    if count < 0 then do; call bad('LL_TARGET_REGION: foreign or invalid phase query'); return 0; end
    return count
  exitaction: method = .lltarget..record
    arg regionid = .int, operation = .int, ordinal = .int
    call prepare()
    selected = _cold.activeactions(regionid,operation,ordinal)
    if _error <> '' | ordinal < 1 | selected = 0 then call bad('LL_TARGET_REGION: invalid active action ordinal')
    return .record(reference _graph,selected)
  /** These are validated diagnostic labels only. Their presence grants no
   * executable selection, activation equivalence or optimizer permission. */
  inlineframes: method = .int
    call prepare()
    if _error <> '' then return 0
    return _inline.frames()
  inlineframe: method = .lltarget..record
    arg ordinal = .int
    call prepare()
    if _error <> '' | ordinal < 1 | ordinal > _inline.frames() then call bad('LL_TARGET_INLINE: invalid frame ordinal')
    return .record(reference _graph,_inline.frame(ordinal))
  inlineframeindex: method = .int
    arg id = .int
    call prepare()
    if _error <> '' then return 0
    return _inline.frameindex(id)
  inlinemaps: method = .int
    call prepare()
    if _error <> '' then return 0
    return _inline.maps()
  inlinemap: method = .lltarget..record
    arg ordinal = .int
    call prepare()
    if _error <> '' | ordinal < 1 | ordinal > _inline.maps() then call bad('LL_TARGET_INLINE: invalid map ordinal')
    return .record(reference _graph,_inline.map(ordinal))
  inlinemapstart: method = .int
    arg ordinal = .int
    call prepare()
    if _error <> '' | ordinal < 1 | ordinal > _inline.maps() then return -1
    return _inline.mapstart(ordinal)
  inlinemapend: method = .int
    arg ordinal = .int
    call prepare()
    if _error <> '' | ordinal < 1 | ordinal > _inline.maps() then return -1
    return _inline.mapend(ordinal)
  inlineaddress: method = .int
    arg operation = .int
    call prepare()
    if _error <> '' then return -1
    return _inline.addressat(operation)
  inlineframeat: method = .int
    arg operation = .int
    call prepare()
    if _error <> '' then return -1
    return _inline.frameat(operation)
  inlinesourceid: method = .int
    arg step = .int
    call prepare()
    if _error <> '' | step < 1 then return 0
    return _inline.sourcerecord(step)
  normalcfgcomplete: method = .int
    arg functionid = .int
    call prepare()
    if _error <> '' then return 0
    graph_ref = reference _graph; graph = dereference graph_ref
    if _cfg.identity() <> graph.identity() then return 0
    return _cfg.complete(functionid)
  endobservations: method = .int
    arg functionid = .int
    call prepare()
    if _error <> '' then return 1
    graph_ref = reference _graph; graph = dereference graph_ref
    if _cfg.identity() <> graph.identity() then return 1
    return _cfg.endobservations(functionid)
  labelblock: method = .int
    arg functionid = .int, name = .string
    call prepare()
    if _error <> '' then do; call bad('LL_TARGET_CFG: invalid target module'); return 0; end
    graph_ref = reference _graph; graph = dereference graph_ref
    if _cfg.identity() <> graph.identity() then do; call bad('LL_TARGET_OWNER: replaced CFG evidence'); return 0; end
    return _cfg.labelblock(functionid,name)
  records: method = .int
    call prepare()
    if _error <> '' then return 0
    return _records[0]
  record: method = .lltarget..record
    arg ordinal = .int
    call prepare()
    if _error <> '' | ordinal < 1 | ordinal > _records[0] then call bad('LL_TARGET_RECORD: invalid module or ordinal')
    return .record(reference _graph,_records[ordinal])
  at: method = .lltarget..record
    arg id = .int
    call prepare()
    return .record(reference _graph,id)
  procedures: method = .int
    call prepare()
    if _error <> '' then return 0
    return _headers[0]
  procedure: method = .lltarget..body
    arg ordinal = .int
    call prepare()
    if _error <> '' | ordinal < 1 | ordinal > _headers[0] then call bad('LL_TARGET_PROCEDURE: invalid module or ordinal')
    header = .record(reference _graph,_headers[ordinal])
    return .body(reference _graph,header.procedureid(),header.id(),reference self)
  procedureid: method = .int
    arg name = .string
    call prepare()
    return findprocedure(reference _graph,reference _headers,name)
  body: method = .lltarget..body
    arg functionid = .int
    call prepare()
    do i = 1 to _headers[0]
      header = .record(reference _graph,_headers[i])
      if header.procedureid() = functionid then return .body(reference _graph,functionid,header.id(),reference self)
    end
    call bad('LL_TARGET_PROCEDURE: unknown function identity')
    return .body(reference _graph,0,0)
