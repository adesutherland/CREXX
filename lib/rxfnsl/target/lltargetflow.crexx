    arg item = .lltarget..record, expose current = .state, scope = .activation, mode = .string, hasinvocation = .int, invocation = .invocationfact, expose rows = .abirow[], expose moved = .abiresource, apply = 0
    catalog = .llrxascatalog..catalog(); rowid = .int; finish = .int; slot = .int; j = .int; count = .int
