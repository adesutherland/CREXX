/* cREXX License (MIT). Point and edge facts over the shared target CFG. */
options levelb
namespace lltargetflow expose analysis analyse valuefact storagefact scopefact lifetimefact entryread
import rxfnsb
import llir
import llirgraph
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetrecipe
import llrxascatalog

boot: initialiser expose serial
  serial = 0
  return
nextidentity: procedure = .int expose serial
  if serial = 9223372036854775807 then assembler signal "ERROR","LL_TARGET_FLOW: identities exhausted"
  serial = serial + 1
  return serial

/** A sparse set for one executable continuation. */
accessrow: class
  _reads = .int[]
  _observations = .int[]
  _writes = .int[]
  _kills = .int[]
  _complete = .int
  *: factory
    _complete = 1
    return
  add: method = .void
    arg kind = .string, domain = .int
    list = .int[]
    if domain < 1 then do; _complete = 0; return; end
    select kind
      when 'read' then list = _reads
      when 'observe' then list = _observations
      when 'write' then list = _writes
      otherwise list = _kills
    end
    do i = 1 to list[0]; if list[i] = domain then return; end
    list[list[0] + 1] = domain
    select kind
      when 'read' then _reads = list
      when 'observe' then _observations = list
      when 'write' then _writes = list
      otherwise _kills = list
    end
    return
  reads: method = .int[]
    return _reads
  observations: method = .int[]
    return _observations
  writes: method = .int[]
    return _writes
  kills: method = .int[]
    return _kills
  complete: method = .int
    return _complete

/** Bounded ordered availability effects through possibly aliased borrows.
 * This is not a value expression: only caller storage identity resolves a
 * guard, and an unavailable effect never becomes a definition. */
aliasproof: class
  _root = .int
  _basekind = .int
  _basesource = .int
  _records = .binary
  _limited = .int
  *: factory
    arg root = .int, basekind = .int, basesource = .int, ?records = .binary, limited = 0
    _root = root; _basekind = basekind; _basesource = basesource; _limited = limited
    if ?records then _records = records
    return
  root: method = .int
    return _root
  basekind: method = .int
    return _basekind
  basesource: method = .int
    return _basesource
  rows: method = .int
    return <blen>(_records) <idiv> 16
  writer: method = .int
    arg ordinal = .int
    return <at..u32>((ordinal - 1) * 16) _records
  kind: method = .int
    arg ordinal = .int
    return <at..u32>((ordinal - 1) * 16 + 4) _records
  source: method = .int
    arg ordinal = .int
    return <at..u32>((ordinal - 1) * 16 + 8) _records
  definite: method = .int
    arg ordinal = .int
    return <at..u32>((ordinal - 1) * 16 + 12) _records
  limited: method = .int
    return _limited
  bytes: method = .int
    return 64 + <blen>(_records)
  key: method = .string
    return _root || ':' || _basekind || ':' || _basesource || ':' || _limited || ':' || bin2x(_records)
  extended: method = .aliasproof
    arg writingstorage = .int, kind = .int, source = .int, definite = .int
    if _limited then return self
    records = .binary; at = 0
    do i = 1 to rows()
      /* A later definite write supersedes earlier writes through that same
       * pointer. Possible writes cannot be reordered past another writer. */
      if definite & writer(i) = writingstorage then iterate
      call binappend records,binsubstr(_records,(i - 1) * 16 + 1,16)
    end
    if <blen>(records) >= 1024 then return .aliasproof(_root,0,0,''x as .binary,1)
    at = <blen>(records); call binresize records,at + 16
    <at..u32>(at) records = writingstorage; <at..u32>(at + 4) records = kind
    <at..u32>(at + 8) records = source; <at..u32>(at + 12) records = definite
    return .aliasproof(_root,_basekind,_basesource,records)

/** An internal immutable abstract value. Entry provenance is independent of
 * value presence: an absent/cleared component is a definition, not unknown. */
cell: class
  _kind = .string
  _value = .int
  _entry = .int
  _availability = .string
  _presence = .string
  _literal = .lltarget..operand
  _entryknown = .int
  _hasalias = .int
  _alias = .aliasproof
  _origins = .int[]
  _originlimited = .int
  *: factory
    arg kind = 'unknown', value = 0, entry = 0, availability = 'unknown', presence = 'unknown', ?literal = .lltarget..operand, entryknown = 1, ?alias = .aliasproof, ?origins = .int[]
    _kind = kind; _value = value; _entry = entry
    _availability = availability; _presence = presence
    _entryknown = entryknown
    if ?literal then _literal = literal
    else _literal = .lltarget..operand()
    _hasalias = 0
    if ?alias then do
      if alias.root() > 0 then do; _hasalias = 1; _alias = alias; end
    end
    if ?origins then do
      if origins[0] > 64 then do
        _originlimited = 1; _entryknown = 0; _entry = -1; _availability = 'unknown'; _kind = 'unknown'
        _literal = .lltarget..operand()
      end
      else do
        _origins = origins
        if origins[0] = 1 then _entry = origins[1]
        else if origins[0] > 1 then _entry = -1
      end
    end
    else if entry > 0 then _origins[1] = entry
    return
  kind: method = .string
    return _kind
  value: method = .int
    return _value
  entry: method = .int
    return _entry
  entryknown: method = .int
    return _entryknown
  availability: method = .string
    return _availability
  presence: method = .string
    return _presence
  literal: method = .lltarget..operand
    return _literal
  known: method = .int
    return _literal.kind() <> ''
  bytes: method = .int
    size = 96 + _literal.length() + _origins[0] * 8
    if _hasalias then size = size + _alias.bytes()
    return size
  hasalias: method = .int
    return _hasalias
  alias: method = .aliasproof
    return _alias
  withalias: method = .cell
    arg proof = .aliasproof
    if proof.limited() then return .cell('unknown',0,0,'unknown','unknown',.lltarget..operand(),0,proof)
    return .cell(_kind,_value,_entry,_availability,_presence,_literal,_entryknown,proof,_origins)
  origincount: method = .int
    return _origins[0]
  origin: method = .int
    arg ordinal = .int
    return _origins[ordinal]
  origins: method = .int[]
    return _origins
  originlimited: method = .int
    return _originlimited
  withorigins: method = .cell
    arg origins = .int[]
    proof = .aliasproof(0,0,0)
    if _hasalias then proof = _alias
    return .cell(_kind,_value,_entry,_availability,_presence,_literal,_entryknown,proof,origins)
  key: method = .string
    result = _kind || '|' || _value || '|' || _entry || '|' || _availability || '|' || _presence || '|' || _literal.kind() || '|' || _literal.index() || '|' || bin2x(_literal.bytes()) || '|' || _entryknown
    if _hasalias then result = result || '|' || _alias.key()
    result = result || '|origins:' || _originlimited
    do i = 1 to _origins[0]; result = result || ':' || _origins[i]; end
    return result
  merged: method = .lltargetflow..cell
    arg other = .cell
    incoming = .lltarget..operand
    if key() == other.key() then return self
    entryknown = _entryknown & other.entryknown()
    entry = _entry
    if entry <> other.entry() then do
      if entry = 0 then entry = other.entry()
      else if other.entry() <> 0 then entry = -1
    end
    availability = _availability
    if availability <> other.availability() then availability = 'mixed'
    if availability = 'unknown' | other.availability() = 'unknown' then availability = 'unknown'
    presence = _presence
    if presence <> other.presence() then presence = 'unknown'
    origins = .int[]; a = 1; b = 1; selected = .int
    do while a <= _origins[0] | b <= other.origincount()
      if a > _origins[0] then do; selected = other.origin(b); b = b + 1; end
      else if b > other.origincount() then do; selected = _origins[a]; a = a + 1; end
      else if _origins[a] < other.origin(b) then do; selected = _origins[a]; a = a + 1; end
      else if _origins[a] > other.origin(b) then do; selected = other.origin(b); b = b + 1; end
      else do; selected = _origins[a]; a = a + 1; b = b + 1; end
      origins[origins[0] + 1] = selected
      if origins[0] > 64 then leave
    end
    result = .cell('phi',0,entry,availability,presence,.lltarget..operand(),entryknown)
    if known() & other.known() then do
      incoming = other.literal()
      if _literal.kind() = incoming.kind() & _literal.index() = incoming.index() & bin2x(_literal.bytes()) == bin2x(incoming.bytes()) then result = .cell('constant',0,entry,availability,presence,_literal,entryknown)
    end
    result = result.withorigins(origins)
    if _originlimited | other.originlimited() then do
      origins[65] = 0
      return result.withorigins(origins)
    end
    if result.originlimited() then return result
    if _hasalias & other.hasalias() then do
      otherproof = other.alias()
      if _alias.key() == otherproof.key() then return result.withalias(_alias)
    end
    else if _hasalias & other.availability() = 'defined' then return result.withalias(_alias)
    else if other.hasalias() & _availability = 'defined' then return result.withalias(other.alias())
    return result

/** One committed logical activation. Pointer captures and the sparse owned
 * snapshot are immutable; leaving restores bindings, never caller payloads. */
activation: class
  _entry = .int
  _result = .int
  _count = .int
  _actuals = .int[]
  _registers = .int[]
  _active = .int[]
  _bases = .int[]
  _slots = .int[]
  *: factory
    arg entry = .int, result = .int, count = .int, actuals = .int[], registers = .int[], active = .int[], bases = .int[], slots = .int[]
    _entry = entry; _result = result; _count = count; _actuals = actuals
    _registers = registers; _active = active; _bases = bases; _slots = slots
    return
  entry: method = .int
    return _entry
  result: method = .int
    return _result
  count: method = .int
    return _count
  actuals: method = .int
    return _actuals[0]
  actual: method = .int
    arg ordinal = .int
    if ordinal < 1 | ordinal > _actuals[0] then return 0
    return _actuals[ordinal]
  owned: method = .int
    return _registers[0]
  reg: method = .int
    arg ordinal = .int
    return _registers[ordinal]
  active: method = .int
    arg ordinal = .int
    return _active[ordinal]
  base: method = .int
    arg ordinal = .int
    return _bases[ordinal]
  slot: method = .int
    arg ordinal = .int
    return _slots[ordinal]
  bytes: method = .int
    return 96 + _actuals[0] * 8 + _registers[0] * 32
  same: method = .int
    arg other = .activation
    i = .int
    if _entry <> other.entry() | _result <> other.result() | _count <> other.count() | _actuals[0] <> other.actuals() | _registers[0] <> other.owned() then return 0
    do i = 1 to _actuals[0]; if _actuals[i] <> other.actual(i) then return 0; end
    do i = 1 to _registers[0]
      if _registers[i] <> other.reg(i) | _active[i] <> other.active(i) | _bases[i] <> other.base(i) | _slots[i] <> other.slot(i) then return 0
    end
    return 1

/** Owned locals start semantically dirty even when recycled storage contains
 * bytes. Argument entry rows borrow availability; binding never defines them.
 * Unknown contents of a defined component are not dirty entry provenance. */
state: class
  _ready = .int
  _map = .int[]
  _base = .int[]
  _slots = .int[]
  _storage = .int[]
  _domain = .int[]
  _cells = .object[]
  _lookup = .int[]
  _domains = .int
  _unknown = .int
  _lifetime = .string[]
  _generation = .int[]
  _scopes = .activation[]
  _depth = .int
  _scopeknown = .int
  *: factory
    arg ?bases = .int[], domains = 0
    _domains = domains; _scopeknown = 1
    if ?bases then do
      _ready = 1
      do i = 1 to bases[0]
        _map[i] = bases[i]; _base[i] = bases[i]; _slots[i] = i
        _lifetime[i] = 'live'; _generation[i] = i
      end
    end
    return
  ready: method = .int
    return _ready
  count: method = .int
    return _cells[0]
  registers: method = .int
    return _map[0]
  isunknown: method = .int
    return _unknown
  initialize: method = .void
    arg ready = .int, unknown = .int, domains = 0
    _ready = ready; _unknown = unknown; _domains = domains
    return
  copy: method = .lltargetflow..state
    i = .int; value = .cell; scope = .activation
    result = .state()
    call result.initialize(_ready,_unknown,_domains)
    do i = 1 to _map[0]
      call result.bind(i,_map[i]); call result.bindbase(i,_base[i]); call result.bindsidentity(i,_slots[i])
      call result.setlifetime(i,_lifetime[i],_generation[i])
    end
    /* Capture from this state before changing the destination receiver. */
    do i = 1 to _depth
      scope = _scopes[i]
      call result.push(scope)
    end
    if _scopeknown = 0 then call result.forgetscopes()
    do i = 1 to _cells[0]
      value = _cells[i] as .cell
      call result.append(_storage[i],_domain[i],value)
    end
    return result
  cellstorage: method = .int
    arg ordinal = .int
    return _storage[ordinal]
  celldomain: method = .int
    arg ordinal = .int
    return _domain[ordinal]
  cellat: method = .lltargetflow..cell
    arg ordinal = .int
    return _cells[ordinal] as .cell
  bytes: method = .int
    i = .int; scope = .activation; value = .cell
    result = 80 + _map[0] * 56 + _cells[0] * 64 + _lookup[0] * 8
    do i = 1 to _depth; scope = _scopes[i]; result = result + scope.bytes(); end
    do i = 1 to _cells[0]; value = _cells[i] as .cell; result = result + value.bytes(); end
    return result
  mapping: method = .int
    arg reg = .int
    if reg < 1 | reg > _map[0] then return 0
    return _map[reg]
  base: method = .int
    arg reg = .int
    if reg < 1 | reg > _base[0] then return 0
    return _base[reg]
  bindbase: method = .void
    arg reg = .int, storage = .int
    _base[reg] = storage
    return
  scopeknown: method = .int
    return _scopeknown
  depth: method = .int
    return _depth
  scope: method = .lltargetflow..activation
    arg ordinal = .int
    return _scopes[ordinal]
  push: method = .void
    arg scope = .activation
    _depth = _depth + 1; _scopes[_depth] = scope
    return
  pop: method = .void
    if _depth > 0 then _depth = _depth - 1
    return
  forgetscopes: method = .void
    _scopeknown = 0; _depth = 0
    call clobberbindings()
    return
  slot: method = .int
    arg reg = .int
    if reg < 1 | reg > _slots[0] then return 0
    return _slots[reg]
  bind: method = .void
    arg reg = .int, storage = .int
    _map[reg] = storage
    return
  bindsidentity: method = .void
    arg reg = .int, identity = .int
    _slots[reg] = identity
    return
  setlifetime: method = .void
    arg storage = .int, lifetime = .string, generation = .int
    if storage > 0 then do; _lifetime[storage] = lifetime; _generation[storage] = generation; end
    return
  lifetime: method = .string
    arg storage = .int
    if storage < 1 | storage > _lifetime[0] then return 'unknown'
    return _lifetime[storage]
  generation: method = .int
    arg storage = .int
    if storage < 1 | storage > _generation[0] then return 0
    return _generation[storage]
  clobberbindings: method = .void
    do i = 1 to _map[0]; _map[i] = 0; _base[i] = 0; _slots[i] = 0; end
    return
  exchange: method = .void
    arg first = .int, second = .int
    value = _map[first]; _map[first] = _map[second]; _map[second] = value
    value = _slots[first]; _slots[first] = _slots[second]; _slots[second] = value
    return
  at: method = .lltargetflow..cell
    arg storage = .int, domain = .int, entryvalue = .int
    if storage = 0 then return .cell()
    if _domains > 0 & domain >= 1 & domain <= _domains then do
      key = (storage - 1) * _domains + domain
      if key <= _lookup[0] then do
        ordinal = _lookup[key]
        if ordinal > 0 then return _cells[ordinal] as .cell
      end
      if _unknown then return .cell()
      return .cell('entry',entryvalue,storage,'entry','unknown')
    end
    do i = 1 to _cells[0]
      if _storage[i] = storage & _domain[i] = domain then return _cells[i] as .cell
    end
    if _unknown then return .cell()
    return .cell('entry',entryvalue,storage,'entry','unknown')
  put: method = .void
    arg storage = .int, domain = .int, value = .cell
    i = .int
    if storage = 0 then do; call clobber(); return; end
    if _domains > 0 & domain >= 1 & domain <= _domains then do
      key = (storage - 1) * _domains + domain
      if key <= _lookup[0] then do
        i = _lookup[key]
        if i > 0 then do; _cells[i] = value as .object; return; end
      end
      call append(storage,domain,value)
      return
    end
    do i = 1 to _cells[0]
      if _storage[i] = storage & _domain[i] = domain then do; _cells[i] = value as .object; return; end
    end
    call append(storage,domain,value)
    return
  putwork: method = .int
    arg storage = .int, domain = .int
    if storage = 0 then return _cells[0] + _lookup[0] + _lifetime[0] + 1
    if _domains > 0 & domain >= 1 & domain <= _domains then do
      key = (storage - 1) * _domains + domain
      return max(0,key - _lookup[0]) + 2
    end
    return _cells[0] + 2
  append: method = .void
    arg storage = .int, domain = .int, value = .cell
    i = _cells[0] + 1; _storage[i] = storage; _domain[i] = domain; _cells[i] = value as .object
    if _domains > 0 & storage > 0 & domain >= 1 & domain <= _domains then _lookup[(storage - 1) * _domains + domain] = i
    return
  clobber: method = .void
    _unknown = 1
    call objectarraydrop _cells
    assembler setattrs _storage,0
    assembler setattrs _domain,0
    assembler setattrs _lookup,0
    do i = 1 to _lifetime[0]; _lifetime[i] = 'unknown'; _generation[i] = 0; end
    return
  merge: method = .lltargetflow..state
    arg other = .state, domains = .int
    value = .cell; incoming = .cell
    i = .int; storage = .int; domain = .int
    if _ready = 0 then return other.copy()
    if other.ready() = 0 then return copy()
    result = copy()
    if _map[0] <> other.registers() then do; call result.clobber(); call result.forgetscopes(); return result; end
    compatible = _scopeknown & other.scopeknown() & _depth = other.depth()
    scope = .activation; incomingScope = .activation
    if compatible then do i = 1 to _depth
      scope = _scopes[i]; incomingScope = other.scope(i)
      if scope.same(incomingScope) = 0 then compatible = 0
    end
    if compatible = 0 then call result.forgetscopes()
    do i = 1 to _map[0]
      if _map[i] <> other.mapping(i) then call result.bind(i,0)
      if _base[i] <> other.base(i) then call result.bindbase(i,0)
      if _slots[i] <> other.slot(i) then call result.bindsidentity(i,0)
      if _lifetime[i] <> other.lifetime(i) | _generation[i] <> other.generation(i) then call result.setlifetime(i,'unknown',0)
    end
    if _unknown | other.isunknown() then do; call result.clobber(); return result; end
    /* Entry defaults participate in a join even if only the other path has
     * an explicit definition. No path silently donates that definition. */
    do i = 1 to _cells[0]
      value = _cells[i] as .cell
      incoming = other.at(_storage[i],_domain[i],(_storage[i] - 1) * domains + _domain[i])
      call result.put(_storage[i],_domain[i],value.merged(incoming))
    end
    do i = 1 to other.count()
      storage = other.cellstorage(i); domain = other.celldomain(i)
      value = at(storage,domain,(storage - 1) * domains + domain)
      incoming = other.cellat(i)
      call result.put(storage,domain,value.merged(incoming))
    end
    return result
  same: method = .int
    arg other = .state
    value = .cell; incoming = .cell
    i = .int
    if _ready <> other.ready() | _unknown <> other.isunknown() | _map[0] <> other.registers() | _cells[0] <> other.count() | _depth <> other.depth() | _scopeknown <> other.scopeknown() then return 0
    scope = .activation; incomingScope = .activation
    do i = 1 to _depth
      scope = _scopes[i]; incomingScope = other.scope(i)
      if scope.same(incomingScope) = 0 then return 0
    end
    do i = 1 to _map[0]
      if _map[i] <> other.mapping(i) | _base[i] <> other.base(i) | _slots[i] <> other.slot(i) then return 0
      if _lifetime[i] <> other.lifetime(i) | _generation[i] <> other.generation(i) then return 0
    end
    do i = 1 to _cells[0]
      value = _cells[i] as .cell; incoming = other.at(_storage[i],_domain[i],0)
      if value.key() <> incoming.key() then return 0
    end
    return 1

/** Analysis-private frozen preparation checkpoints. */
statevector: class
  _values = .state[]
  *: factory
    return
  put: method = .void
    arg ordinal = .int, value = .state
    _values[ordinal] = value
    return
  at: method = .lltargetflow..state
    arg ordinal = .int
    return _values[ordinal]

/** Borrowed facts validate their analysis owner on every public query. */
valuefact: class
  _owner = reference .lltargetflow..analysis
  _analysisid = .int
  _value = .cell
  _storage = .int
  _domain = .int
  *: factory
    arg owner = reference .analysis, value = .cell, storage = .int, domain = .int
    _owner = owner; _value = value; _storage = storage; _domain = domain
    parent = dereference owner; _analysisid = parent.identity()
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner; return owner.valid() & owner.identity() = _analysisid
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _value.kind() = 'unknown' then return 'unknown'
    return 'ok'
  reason: method = .string
    if valid() = 0 then return 'target.flow.owner.expired.or.replaced'
    if _value.originlimited() then return 'target.flow.entry.origins.limit'
    if _value.hasalias() then do
      proof = _value.alias()
      if proof.limited() then return 'target.flow.alias.provenance.limit'
    end
    if _value.kind() = 'unknown' then return 'target.flow.value.unknown'
    return ''
  storage: method = .int
    if valid() = 0 then return 0
    return _storage
  domain: method = .int
    if valid() = 0 then return 0
    return _domain
  valueid: method = .int
    if valid() = 0 then return 0
    return _value.value()
  kind: method = .string
    if valid() = 0 then return 'unknown'
    return _value.kind()
  availability: method = .string
    if valid() = 0 then return 'unknown'
    return _value.availability()
  presence: method = .string
    if valid() = 0 then return 'unknown'
    return _value.presence()
  entrydependent: method = .int
    if valid() = 0 then return 0
    return _value.entry() <> 0
  dirty: method = .int
    if valid() = 0 | _value.entryknown() = 0 then return 0
    owner = dereference _owner
    do i = 1 to _value.origincount()
      if owner.storagebank(_value.origin(i)) = 'r' then return 1
    end
    return 0
  known: method = .int
    return valid() & _value.known()
  literal: method = .lltarget..operand
    if known() then return _value.literal()
    return .lltarget..operand()

storagefact: class
  _owner = reference .lltargetflow..analysis
  _analysisid = .int
  _active = .int
  _base = .int
  _entry = .int
  _slot = .int
  *: factory
    arg owner = reference .analysis, active = .int, base = .int, entry = .int, slot = .int
    _owner = owner; _active = active; _base = base; _entry = entry; _slot = slot
    parent = dereference owner; _analysisid = parent.identity()
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner; return owner.valid() & owner.identity() = _analysisid
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _active = 0 then return 'unknown'
    return 'ok'
  reason: method = .string
    if valid() = 0 then return 'target.flow.owner.expired.or.replaced'
    if _active = 0 then return 'target.flow.binding.unknown'
    return ''
  active: method = .int
    if valid() = 0 then return 0
    return _active
  base: method = .int
    if valid() = 0 then return 0
    return _base
  entry: method = .int
    if valid() = 0 then return 0
    return _entry
  slotidentity: method = .int
    if valid() = 0 then return 0
    return _slot

/** Borrowed immutable logical activation stack. Unknown is distinct from a
 * proved empty stack; entry source IDs are ordered outermost first. */
scopefact: class
  _owner = reference .lltargetflow..analysis
  _analysisid = .int
  _known = .int
  _entries = .int[]
  *: factory
    arg owner = reference .analysis, known = .int, entries = .int[]
    _owner = owner; _known = known; _entries = entries
    parent = dereference owner; _analysisid = parent.identity()
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    parent = dereference _owner
    return parent.valid() & parent.identity() = _analysisid
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _known = 0 then return 'unknown'
    return 'ok'
  reason: method = .string
    if valid() = 0 then return 'target.flow.owner.expired.or.replaced'
    if _known = 0 then return 'target.flow.scope.stack.unknown'
    return ''
  known: method = .int
    return valid() & _known
  depth: method = .int
    if known() = 0 then return 0
    return _entries[0]
  entry: method = .int
    arg ordinal = .int
    if known() = 0 | ordinal < 1 | ordinal > _entries[0] then do
      assembler signal "ERROR","LL_TARGET_FLOW: unavailable scope stack ordinal"; return 0
    end
    return _entries[ordinal]

/** Storage lifetime is independent of payload presence and active register
 * spelling. A generation identifies an operational begin/end site; unknown
 * joins cannot prove reference validity or permission to reuse storage. */
lifetimefact: class
  _owner = reference .lltargetflow..analysis
  _analysisid = .int
  _storage = .int
  _lifetime = .string
  _generation = .int
  *: factory
    arg owner = reference .analysis, storage = .int, lifetime = .string, generation = .int
    _owner = owner; parent = dereference owner; _analysisid = parent.identity()
    _storage = storage; _lifetime = lifetime; _generation = generation
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner; return owner.valid() & owner.identity() = _analysisid
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _lifetime = 'unknown' then return 'unknown'
    return 'proved'
  reason: method = .string
    if valid() = 0 then return 'target.flow.owner.expired.or.replaced'
    if _lifetime = 'unknown' then return 'target.flow.lifetime.unknown'
    return ''
  storage: method = .int
    if valid() = 0 then return 0
    return _storage
  state: method = .string
    if valid() = 0 then return 'unknown'
    return _lifetime
  generation: method = .int
    if valid() = 0 then return 0
    return _generation

/** Only an explicit typed observation can create this witness. Its bank and
 * index identify the owned base to clear, not a possibly linked spelling. */
entryread: class
  _owner = reference .lltargetflow..analysis
  _analysisid = .int
  _operation = .int
  _function = .int
  _storage = .int
  _index = .int
  _domain = .int
  _key = .string
  _activebank = .string
  _activeindex = .int
  *: factory
    arg owner = reference .analysis, operation = .int, functionid = .int, storage = .int, index = .int, domain = .int, key = .string, activebank = .string, activeindex = .int
    _owner = owner; _operation = operation; _function = functionid
    _storage = storage; _index = index; _domain = domain; _key = key
    _activebank = activebank; _activeindex = activeindex
    parent = dereference owner; _analysisid = parent.identity()
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner; return owner.valid() & owner.identity() = _analysisid
  status: method = .string
    if valid() then return 'ok'
    return 'invalid'
  reason: method = .string
    if valid() then return ''
    return 'target.flow.owner.expired.or.replaced'
  require: method = .void
    if valid() = 0 then assembler signal "ERROR","LL_TARGET_FLOW: expired or replaced entry-observation view"
    return
  operation: method = .int
    call require()
    return _operation
  function: method = .int
    call require()
    return _function
  bank: method = .string
    call require()
    return 'r'
  index: method = .int
    call require()
    return _index
  ownedindex: method = .int
    call require()
    return _index
  activebank: method = .string
    call require()
    return _activebank
  activeindex: method = .int
    call require()
    return _activeindex
  storage: method = .int
    call require()
    return _storage
  domain: method = .int
    call require()
    return _domain
  domainkey: method = .string
    call require()
    return _key
  origin: method = .llir..origin
    call require()
    owner = dereference _owner; source_ref = owner.owner(); source = dereference source_ref
    record = source.at(_operation); return record.origin()

/** Shared point analysis. It interprets only operational transfer events,
 * never RXAS mnemonics. Sparse state rows and iteration are budgeted; an
 * incomplete profile remains usable for independently complete fact families.
 * @param owner Exact frozen target owner.
 * @param transfers Checked operational premises for that same owner.
 * @param cfg Its sole checked machine-CFG projection.
 * @param work Maximum elementary traversals and retained-state preparation.
 * @param bytes Maximum conservative retained logical bytes.
 */
analysis: class
  _owner = reference .lltarget..module
  _transfers = reference .lltargettransfer..profile
  _cfg = reference .lltargetcfg..graph
  _index = reference .llirgraph..index
  _revision = .int
  _identity = .int
  _profileid = .int
  _cfgid = .int
  _schema = .int
  _catalog = .string
  _premise = .string
  _status = .string
  _message = .string
  _work = .int
  _worklimit = .int
  _bytes = .int
  _bytelimit = .int
  _domains = .int
  _regfunction = .int[]
  _regbank = .string[]
  _regindex = .int[]
  _bases = .int[]
  _storefunction = .int[]
  _storebank = .string[]
  _storeindex = .int[]
  _capture = .object[]
  _capturepresent = .int[]
  _preparations = .statevector[]
  _before = .object[]
  _after = .object[]
  _edge = .object[]
  _incoming = .object[]
  _beforepresent = .int[]
  _afterpresent = .int[]
  _edgepresent = .int[]
  _incomingpresent = .int[]
  _edgehead = .int[]
  _edgenext = .int[]
  _outhead = .int[]
  _outnext = .int[]
  _callblocks = .int[]
  _witnessops = .int[]
  _instructions = .int[]
  _witnesses = .entryread[]
  _witnesskeys = .string[]
  _entrycomplete = .int[]
  _entryreason = .string[]
  _entrydepends = .string[]
  _returnsites = .int[]
  _scopedfunctions = .int[]
  _projection = .llirgraph..access
  _projected = .int
  *: factory
    arg owner = reference .lltarget..module, transfers = reference .lltargettransfer..profile, cfg = reference .lltargetcfg..graph, work = 1000000, bytes = 67108864
    _owner = owner; _transfers = transfers; _cfg = cfg; _identity = nextidentity()
    _worklimit = work; _bytelimit = bytes; _status = 'building'; _message = ''
    return
  fail: method = .int
    arg status = .string, message = .string
    _status = status; _message = message
    return 0
  spend: method = .int
    arg amount = .int
    if amount < 0 | amount > _worklimit - _work then return fail('limit','target.flow.work')
    _work = _work + amount
    return 1
  reserve: method = .int
    arg amount = .int
    if amount < 0 | amount > _bytelimit - _bytes then return fail('limit','target.flow.bytes')
    _bytes = _bytes + amount
    return 1
  scratch: method = .int
    arg count = .int, width = .int
    if count < 0 | width < 1 then return fail('invalid','target.flow.scratch.dimensions')
    if count > (_bytelimit - _bytes) / width then return fail('limit','target.flow.scratch.bytes')
    return 1
  scaledwork: method = .int
    arg count = .int, width = .int
    if count < 0 | width < 1 then return fail('invalid','target.flow.work.dimensions')
    if count > (_worklimit - _work) / width then return fail('limit','target.flow.work')
    return spend(count * width)
  save: method = .int
    arg expose rows = .object[], expose present = .int[], id = .int, value = .state
    old = .state
    if id < 1 then return fail('invalid','target.flow.state.identity')
    if spend(value.count() + value.registers() + 1) = 0 then return 0
    if present[id] then do; old = rows[id] as .state; _bytes = _bytes - old.bytes(); end
    if reserve(value.bytes()) = 0 then return 0
    rows[id] = value.copy() as .object
    present[id] = 1
    return 1
  registerslot: method = .int
    arg functionid = .int, bank = .string, number = .int
    storage = .int; i = .int
    do i = 1 to _regfunction[0]
      if spend(1) = 0 then return 0
      if _regfunction[i] = functionid & _regbank[i] = bank & _regindex[i] = number then return i
    end
    if reserve(64) = 0 then return 0
    n = _regfunction[0] + 1
    _regfunction[n] = functionid; _regbank[n] = bank; _regindex[n] = number
    storage = 0
    if bank = 'g' then do i = 1 to _storefunction[0]
      if spend(1) = 0 then return 0
      if _storebank[i] = 'g' & _storeindex[i] = number then storage = i
    end
    if storage = 0 then do
      if reserve(48) = 0 then return 0
      storage = _storefunction[0] + 1; _storefunction[storage] = functionid
      _storebank[storage] = bank; _storeindex[storage] = number
    end
    _bases[n] = storage
    return n
  findregister: method = .int
    arg functionid = .int, bank = .string, number = .int
    do i = 1 to _regfunction[0]
      if _regfunction[i] = functionid & _regbank[i] = bank & _regindex[i] = number then return i
    end
    return 0
  capturedcell: method = .cell
    arg ids = .int[], cells = .object[], id = .int
    do i = 1 to ids[0]
      if ids[i] = id then return cells[i] as .cell
    end
    return .cell()
  offsetcell: method = .cell
    arg value = .cell, offset = .int
    if offset = 0 then return value
    literal = value.literal()
    if literal.kind() <> 'I' then return .cell()
    number = literal.index()
    if offset > 0 then do; if number > 9223372036854775807 - offset then return .cell(); end
    if offset < 0 then do; if number < -9223372036854775808 - offset then return .cell(); end
    return .cell('constant',0,0,'defined','present',.lltarget..operand.integer(number + offset))
  integercell: method = .cell
    arg current = .state, storage = .int
    profile = dereference _transfers; catalog = .llrxascatalog..catalog()
    do i = 1 to _domains
      domain = profile.domain(i)
      if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('I') then return cellat(current,storage,i)
    end
    return .cell()
  addressindex: method = .lltarget..operand
    arg instruction = .lltargettransfer..instruction, view = .lltargettransfer..refview, current = .state, ids = .int[], cells = .object[]
    value = .cell; literal = .lltarget..operand()
    if view.selectorkind() = 'literal' then literal = view.selectorvalue()
    else if view.selectorkind() = 'captured' then do
      value = capturedcell(ids,cells,view.selectorid()); literal = value.literal()
    end
    else if view.selectorkind() = 'reference' then do
      storage = refstorage(instruction,view.selectorid(),current,ids,cells)
      value = integercell(current,storage); literal = value.literal()
    end
    if literal.kind() <> 'I' then return .lltarget..operand()
    number = literal.index(); offset = view.selectoroffset()
    if offset > 0 then do; if number > 9223372036854775807 - offset then return .lltarget..operand(); end
    if offset < 0 then do; if number < -9223372036854775808 - offset then return .lltarget..operand(); end
    number = number + offset
    if number < 0 then return .lltarget..operand()
    return .lltarget..operand.integer(number)
  addressoperand: method = .lltarget..operand
    arg instruction = .lltargettransfer..instruction, view = .lltargettransfer..refview, current = .state, ids = .int[], cells = .object[]
    literal = addressindex(instruction,view,current,ids,cells)
    if literal.kind() <> 'I' then return .lltarget..operand()
    number = literal.index()
    if view.addresskind() = 'localindex' then return windowvalue(instruction.function(),.lltarget..operand.bound(0,0,0,'r',0),number)
    if view.addresskind() = 'argument' then return .lltarget..operand.bound(0,0,0,'a',number)
    if view.addresskind() = 'capturedargument' & current.depth() > 0 then do
      target = dereference _owner; scope = current.scope(current.depth()); record = target.at(scope.entry()); recipe = record.recipe()
      if number = 0 then return record.reciperef(recipe.a0ref())
      do i = 1 to recipe.proxies()
        if recipe.proxyargument(i) = number then return record.reciperef(recipe.proxyref(i))
      end
    end
    /* Reference trees, attributes, foreign globals and parent frames stay
     * symbolic until the shared storage owner supplies their identity. */
    return .lltarget..operand()
  refreg: method = .int
    arg instruction = .lltargettransfer..instruction, referenceid = .int, ?current = .state, ?ids = .int[], ?cells = .object[]
    refview = .lltargettransfer..refview; emptyids = .int[]; emptycells = .object[]
    value = .lltarget..operand
    do i = 1 to instruction.references()
      refview = instruction.ref(i)
      if refview.id() <> referenceid then iterate
      if refview.kind() = 'address' then do
        if ?current = 0 then return 0
        if ?ids & ?cells then value = addressoperand(instruction,refview,current,ids,cells)
        else value = addressoperand(instruction,refview,current,emptyids,emptycells)
        if value.kind() <> 'R' then return 0
        return findregister(instruction.function(),value.bank(),value.index())
      end
      if refview.bank() = '' | refview.extentknown() = 0 | refview.extent() <> 1 then return 0
      return findregister(instruction.function(),refview.bank(),refview.index())
    end
    return 0
  refstorage: method = .int
    arg instruction = .lltargettransfer..instruction, referenceid = .int, current = .state, ?ids = .int[], ?cells = .object[]
    refview = .lltargettransfer..refview; literal = .lltarget..operand
    emptyids = .int[]; emptycells = .object[]
    do i = 1 to instruction.references()
      refview = instruction.ref(i)
      if refview.id() <> referenceid then iterate
      if ?ids & ?cells then reg = refreg(instruction,referenceid,current,ids,cells)
      else reg = refreg(instruction,referenceid,current)
      if refview.kind() = 'address' then do
        if reg > 0 then return current.mapping(reg)
        if refview.addresskind() = 'capturedargument' & current.depth() > 0 then do
          if ?ids & ?cells then literal = addressindex(instruction,refview,current,ids,cells)
          else literal = addressindex(instruction,refview,current,emptyids,emptycells)
          if literal.kind() <> 'I' then return 0
          scope = current.scope(current.depth()); number = literal.index()
          target = dereference _owner; record = target.at(scope.entry()); recipe = record.recipe()
          if number = 0 then return 0
          do j = 1 to recipe.proxies()
            if recipe.proxyargument(j) = number then return 0
          end
          if number > 0 & number <= scope.actuals() then return scope.actual(number)
        end
        return 0
      end
      if reg = 0 then return 0
      if refview.anchor() = 'base' then return current.base(reg)
      if refview.anchor() = 'entry' then return _bases[reg]
      if refview.anchor() <> 'active' then return 0
      return current.mapping(reg)
    end
    return 0
  entryvalue: method = .int
    arg storage = .int, domain = .int
    return (storage - 1) * _domains + domain
  ownedbase: method = .int
    arg storage = .int
    if storage < 1 | storage > _storebank[0] then return 0
    if _storebank[storage] = 'r' | _storebank[storage] = 'context' then return 1
    return _storebank[storage] = 'a' & _storeindex[storage] = 0
  cellat: method = .lltargetflow..cell
    arg current = .state, storage = .int, domain = .int
    return current.at(storage,domain,entryvalue(storage,domain))
  applies: method = .int
    arg action = .lltargettransfer..action, exceptional = .int, phase = 'unknown'
    if exceptional = 0 then return action.path() = 'normal' | action.path() = 'all'
    if action.path() <> 'failure' & action.path() <> 'all' then return 0
    if action.phase() = 'none' | action.phase() = phase then return 1
    /* The edge is before any write; an explicitly after-write event cannot
     * occur there. Other incomplete/partial phase relations are possible,
     * never definite. */
    if phase = 'before' & action.phase() = 'after' then return 0
    return 2
  writecell: method = .int
    arg expose current = .state, storage = .int, domain = .int, value = .cell, definite = .int
    old = .cell; possible = .cell; proof = .aliasproof
    tag = .int; origin = .int; basetag = .int; basesource = .int
    /* Indexed scalar lookups do not scan every retained state cell. Charge
     * the actual alias walk, bounded provenance merges and lookup growth. */
    if spend(3) = 0 then return 0
    /* Preserve availability under a possible alias without claiming that
     * distinct symbolic cells receive the same value. The call point later
     * resolves each ordered guard using captured physical storage identities. */
    if storage > 0 & ownedbase(storage) = 0 then do
      if spend(_storefunction[0]) = 0 then return 0
      do i = 1 to _storefunction[0]
      if i = storage | ownedbase(i) then iterate
      old = cellat(current,i,domain); possible = old.merged(value)
      if spend(old.origincount() + value.origincount() + current.putwork(i,domain) + 4) = 0 then return 0
      if old.hasalias() then proof = old.alias()
      else proof = .aliasproof(0,0,0)
      if old.hasalias() = 0 | proof.root() <> i then do
        basetag = 0; basesource = 0
        if old.availability() = 'defined' then basetag = 1
        else if old.entry() > 0 & old.entryknown() & wordpos(old.availability(),'entry mixed') > 0 then do; basetag = 2; basesource = old.entry(); end
        proof = .aliasproof(i,basetag,basesource)
      end
      tag = 0; origin = 0
      if value.availability() = 'defined' then tag = 1
      else if value.entry() > 0 & value.entryknown() & wordpos(value.availability(),'entry mixed') > 0 then do; tag = 2; origin = value.entry(); end
      if spend(proof.rows() + 1) = 0 | scratch(proof.bytes(),3) = 0 then return 0
      proof = proof.extended(storage,tag,origin,definite)
      call current.put(i,domain,possible.withalias(proof))
      end
    end
    if definite = 0 then do
      old = cellat(current,storage,domain); value = old.merged(value)
      if spend(old.origincount() + value.origincount() + 3) = 0 then return 0
    end
    if spend(current.putwork(storage,domain)) = 0 then return 0
    call current.put(storage,domain,value)
    return 1
  /** Resolve only formal entry storages; an absent or uncertain mapping is
   * not evidence that two pointers are distinct. */
  actualstorage: method = .int
    arg storage = .int, functionid = .int, actuals = .string, incoming = .state
    if actuals = '?' | left(actuals,1) = '~' then return 0
    if storage < 1 | storage > _storefunction[0] then return 0
    if _storefunction[storage] <> functionid | _storebank[storage] <> 'a' then return 0
    ordinal = _storeindex[storage]
    if ordinal < 1 | ordinal > words(actuals) then return 0
    reg = word(actuals,ordinal) as .int
    return incoming.mapping(reg)
  availabilityleaf: method = .cell
    arg kind = .int, source = .int, functionid = .int, actuals = .string, incoming = .state, domain = .int
    if kind = 1 then return .cell('defined',0,0,'defined','unknown')
    if kind <> 2 then return .cell()
    storage = actualstorage(source,functionid,actuals,incoming)
    if storage = 0 then return .cell()
    return cellat(incoming,storage,domain)
  instantiatealias: method = .cell
    arg value = .cell, functionid = .int, actuals = .string, incoming = .state, domain = .int
    proof = value.alias(); result = .cell; replacement = .cell
    if proof.limited() | left(actuals,1) = '~' then return .cell()
    if scaledwork(proof.rows() + 1,words(actuals) + _storefunction[0] + 1) = 0 then return .cell()
    root = actualstorage(proof.root(),functionid,actuals,incoming)
    if root = 0 then return .cell()
    result = availabilityleaf(proof.basekind(),proof.basesource(),functionid,actuals,incoming,domain)
    do i = 1 to proof.rows()
      writer = actualstorage(proof.writer(i),functionid,actuals,incoming)
      if writer = 0 then do
        /* Unknown alias loses value identity. Availability can still be
         * defined when both the untouched and written alternatives are. */
        replacement = availabilityleaf(proof.kind(i),proof.source(i),functionid,actuals,incoming,domain)
        result = result.merged(replacement)
        iterate
      end
      if writer <> root then iterate
      replacement = availabilityleaf(proof.kind(i),proof.source(i),functionid,actuals,incoming,domain)
      if proof.definite(i) then result = replacement
      else result = result.merged(replacement)
    end
    /* This summary proves only availability and dirty provenance, never a
     * literal or equality with a borrowed value after a possible write. */
    returned = .cell('returned',0,result.entry(),result.availability(),'unknown',.lltarget..operand(),result.entryknown())
    return returned.withorigins(result.origins())
  windowvalue: method = .lltarget..operand
    arg functionid = .int, first = .lltarget..operand, offset = .int
    target = dereference _owner; body = target.body(functionid); packed = first.index()
    if first.bank() = 'g' then packed = packed + body.locals()
    else if first.bank() = 'a' then packed = packed + body.locals() + target.globals()
    else if first.bank() <> 'r' then return .lltarget..operand()
    if offset < 0 | offset > 9223372036854775807 - packed then return .lltarget..operand()
    number = packed + offset; bank = 'r'
    if number >= body.locals() + target.globals() then do; bank = 'a'; number = number - body.locals() - target.globals(); end
    else if number >= body.locals() then do; bank = 'g'; number = number - body.locals(); end
    return .lltarget..operand.bound(0,0,0,bank,number)
  recipereg: method = .int
    arg item = .lltarget..record, ordinal = .int
    if ordinal < 1 then return 0
    value = item.reciperef(ordinal)
    return findregister(item.procedureid(),value.bank(),value.index())
  /** Preparation is visible even when staging subsequently fails. Commit is
   * separate: failed entry never acquires a scope or owned binding snapshot. */
  scopeprepare: method = .lltargetflow..state
    arg item = .lltarget..record, incoming = .state, publish = 0, limit = -1
    current = incoming.copy(); recipe = item.recipe(); profile = dereference _transfers
    points = .statevector()
    steps = recipe.preparations()
    if limit >= 0 then steps = min(steps,limit)
    reg = .int; storage = .int; other = .int
    domain = .lltargettransfer..domain; value = .cell
    do i = 1 to steps
      if publish then do
        if reserve(current.bytes()) = 0 | spend(current.count() + current.registers() + 1) = 0 then return current
        call points.put(i,current.copy())
      end
      if spend(_regfunction[0] * 2 + _domains + 1) = 0 then return current
      reg = recipereg(item,recipe.preparationref(i,1)); kind = recipe.preparationkind(i)
      if reg = 0 then do; call current.clobber(); call current.clobberbindings(); return current; end
      storage = current.mapping(reg)
      if kind = 'swap' then do
        other = recipereg(item,recipe.preparationref(i,2))
        if other > 0 then call current.exchange(reg,other)
        else call current.clobberbindings()
      end
      else do d = 1 to _domains
        domain = profile.domain(d)
        if domain.kind() = 'whole' | domain.kind() = 'context' then iterate
        if kind = 'clear' then do
          value = .cell('absent',0,0,'defined','absent')
          if domain.kind() = 'component' & domain.nativebit() = 1 then value = .cell('constant',0,0,'defined','present',.lltarget..operand.integer(0))
          call current.put(storage,d,value)
        end
        else if kind = 'settp' & domain.kind() = 'flag' then call current.put(storage,d,.cell('write',item.id(),0,'defined','unknown'))
      end
    end
    if publish then _preparations[item.id()] = points
    return current
  /** Count capture uses the same prepared point facts for scope transfer and
   * access. A register token alone never supplies a finite window extent. */
  scopecapturecount: method = .cell
    arg item = .lltarget..record, current = .state
    recipe = item.recipe()
    if recipe.countkind() = 'literal' then return .cell('constant',0,0,'defined','present',.lltarget..operand.integer(recipe.countvalue()))
    if spend(_regfunction[0] + _domains + 1) = 0 then return .cell()
    reg = recipereg(item,recipe.countref())
    value = integercell(current,current.mapping(reg))
    if value.availability() <> 'defined' then return .cell()
    return value
