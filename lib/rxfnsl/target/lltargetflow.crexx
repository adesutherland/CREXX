    return _revision
  identity: method = .int
    return _identity
  schemaid: method = .int
    return _schema
  catalog: method = .string
    return _catalog
  premise: method = .string
    return _premise
  profileid: method = .int
    return _profileid
  cfgid: method = .int
    return _cfgid
