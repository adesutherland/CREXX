    actuals = callactuals(instruction,incoming,1)
    if actuals = '?' | left(actuals,1) = '~' then return result
    if spend(words(actuals) * _domains * 4 + _storefunction[0] + _domains * 8 + 1) = 0 then return result
    if scratch(_storefunction[0] * 8 + 64,1) = 0 then return result
    exposed = .int[]; exposed[_storefunction[0]] = 0
    resources = catalog.componentmask('reference'); bit = catalog.componentmask('native-payload'); assembler ior resources,resources,bit
    bit = catalog.componentmask('attribute-count'); assembler ior resources,resources,bit
    do i = 1 to words(actuals)
      reg = word(actuals,i) as .int; storage = incoming.mapping(reg)
      if storage < 1 | storage > _storefunction[0] then return result
      exposed[storage] = 1
      /* The shared capacity fact covers an empty attribute tree as well as
       * direct reference and native payload absence. A scalar setter can
       * leave an attribute-count cell unknown without creating an alias. */
      if incoming.capacityclean(storage) then iterate
      do d = 1 to _domains
        domain = profile.domain(d)
        if domain.kind() <> 'component' then iterate
        bit = domain.nativebit(); assembler iand overlap,resources,bit
        if overlap = 0 then iterate
        value = cellat(incoming,storage,d)
        if value.presence() <> 'absent' then do
          if value.availability() <> 'entry' | ownedbase(storage) = 0 | _storebank[storage] <> 'r' then return result
        end
      end
    end
    resultstorage = 0; ordinal = catalog.callresult(item.opcode())
    if ordinal > 0 then resultstorage = refstorage(instruction,operandref(instruction,ordinal),incoming)
    caller = target.body(instruction.function())
    do i = 0 to caller.locals() - 1
      reg = findregister(instruction.function(),'r',i)
      if reg = 0 then iterate
      storage = incoming.mapping(reg)
      if storage < 1 | storage > _storefunction[0] then iterate
      if exposed[storage] | storage = resultstorage | ownedbase(storage) = 0 | _storebank[storage] <> 'r' then iterate
      do d = 1 to _domains
        domain = profile.domain(d)
        if wordpos(domain.kind(),'component flag') = 0 then iterate
        call result.put(storage,d,cellat(incoming,storage,d))
      end
      call result.setlifetime(storage,incoming.lifetime(storage),incoming.generation(storage))
      call result.setcapacity(storage,incoming.capacityclean(storage))
    end
    return result
  /** Unknown aggregate signal names/phase do not imply missing resource
   * effects. The canonical CFG must still retain every typed/wildcard failure
   * and close its scope/handler reach. This proves no signal/scalar absence. */
  resourcefailure: method = .string
    arg instruction = .lltargettransfer..instruction
    if instruction.complete('failure') then return ''
    if _premise <> 'canonical' then return 'target.resource.failure.unproved'
    if wordpos(instruction.unknownreason('failure'),'catalog.signal.names.unknown catalog.signal.contract.unknown') = 0 then return 'target.resource.failure.unproved'
    operation = instruction.opid()
    if operation <= _resourcefailureproved[0] then do; if _resourcefailureproved[operation] then return ''; end
    cfg = dereference _cfg; edge = .lltargetcfg..edge
    producers = 0; i = .int; growth = .int
    do i = 1 to cfg.outedges(operation)
      if spend(i + 1) = 0 then return message()
      edge = cfg.outedge(operation,i)
      if edge.complete() = 0 | edge.scopecomplete() = 0 | edge.role() = 'unknown' then return 'target.resource.failure.departure.unproved'
      if edge.targetblock() > 0 & wordpos(edge.exposure(),'handler-call handler-call-async event-binding event-binding-async') > 0 then return 'target.resource.failure.handler.reach.unproved'
      if edge.asynchronous() = 0 & edge.phase() <> 'none' & edge.role() <> 'normal' & edge.role() <> 'table' then producers = producers + 1
    end
    if producers = 0 then return 'target.resource.failure.producer.unproved'
    growth = max(0,operation - _resourcefailureproved[0])
    if spend(growth + 1) = 0 | reserve(growth * 8) = 0 then return message()
    _resourcefailureproved[operation] = 1
    return ''
  resourceinstruction: method = .string
    arg instruction = .lltargettransfer..instruction, locals = .int, ?selected = .int[], frozen = 0, actiononly = 0, targetselected = 0, sourceselected = 0
    profile = dereference _transfers; item = instruction.record(); catalog = .llrxascatalog..catalog()
    action = .lltargettransfer..action; view = .lltargettransfer..refview; value = .lltarget..operand
    domain = .lltargettransfer..domain
    i = .int; j = .int; mask = .int; overlap = .int; found = .int; ordinal = .int; reg = .int
    resources = catalog.componentmask('reference'); bit = catalog.componentmask('native-payload')
    assembler ior resources,resources,bit
    bit = catalog.componentmask('attribute-count'); assembler ior resources,resources,bit
    if item.kind() = 'instruction' then do
      if catalog.callinvokes(item.opcode()) then do
        if ?selected & actiononly = 0 then return 'target.resource.backing.child.history.unproved'
        if actiononly > 0 then return resourcecallaction(instruction,actiononly,selected)
        do i = 1 to instruction.references()
          if spend(1) = 0 then return 'target.resource.limit'
          view = instruction.ref(i)
          if view.bank() = 'a' then _resourcearguments[instruction.function()] = max(_resourcearguments[instruction.function()],view.index())
        end
        if resourcecallknown(instruction) = 0 then return 'target.resource.call.outward.unproved'
        return ''
      end
    end
    do i = 1 to 7
      if spend(1) = 0 then return 'target.resource.limit'
      family = word('effects references components ownership bindings order control',i)
      if instruction.complete(family) = 0 then return 'target.resource.' || family || '.unproved'
    end
    failure = resourcefailure(instruction)
    if failure <> '' then return failure
    do i = 1 to instruction.references()
      if spend(1) = 0 then return 'target.resource.limit'
      view = instruction.ref(i)
      if view.kind() = 'address' | view.kind() = 'window' | view.extentknown() = 0 then return 'target.resource.reference.extent.unproved'
      if ?selected = 0 & view.bank() = 'a' then _resourcearguments[instruction.function()] = max(_resourcearguments[instruction.function()],view.index())
    end
    if item.kind() <> 'instruction' then return ''
    do i = 1 to item.operands()
      if spend(1) = 0 then return 'target.resource.limit'
      if catalog.writes(item.opcode(),i) = 0 then iterate
      if actiononly > 0 then do
        action = instruction.action(actiononly)
        if wordpos(action.kind(),'write clear transport derive flagwrite status') = 0 then iterate
        if action.subject() = 0 then return 'target.resource.implicit.write.unproved'
        view = profile.ref(action.subject())
        if view.operandordinal() <> i then iterate
        if action.domain() > 0 then do
          domain = profile.domain(action.domain())
          if domain.kind() <> 'whole' then do
            if domain.kind() <> 'component' then iterate
            bit = domain.nativebit(); assembler iand overlap,bit,resources
            if overlap = 0 then iterate
          end
        end
      end
      value = item.operand(i)
      if ?selected then do
        reg = findregister(instruction.function(),value.bank(),value.index())
        if reg = 0 then return 'target.resource.backing.write.selector.unproved'
        if actiononly > 0 then do; if targetselected = 0 then iterate; end
        else if selected[reg] = 0 then iterate
      end
      else if value.kind() <> 'R' | value.bank() <> 'r' | value.index() < 0 | value.index() >= locals then return 'target.resource.external.write.unproved'
      if catalog.writecomplete(item.opcode(),i) = 0 then do
        /* A checked pointer-only event is exact despite having no value
         * projection. Other missing projections are unknown resource writes. */
        if resourcebindingoutput(instruction,i) = 0 then return 'target.resource.write.projection.unproved'
        iterate
      end
      mask = catalog.writecomponents(item.opcode(),i)
      /* Clears are writes in the conservative native inventory. They cannot
       * introduce a resource into an already resource-free owned backing. */
      if ?selected & catalog.transportsource(item.opcode()) = 0 then do
        bit = catalog.clearcomponents(item.opcode(),i)
        assembler iand overlap,mask,bit; mask = mask - overlap
      end
      if ?selected & catalog.transportsource(item.opcode()) > 0 then do
        bit = catalog.callbackinputs(item.opcode(),catalog.transportsource(item.opcode()))
        assembler ior mask,mask,bit
      end
      assembler iand overlap,mask,resources
      if overlap = 0 then iterate
      ordinal = catalog.transportsource(item.opcode())
      if ordinal < 1 then return 'target.resource.creation.unproved'
      /* The inventory write/clear actions do not consume a transport
       * source. Check that dependency at its typed transport action. */
      if actiononly > 0 then do
        action = instruction.action(actiononly)
        if action.kind() <> 'transport' then iterate
      end
      value = item.operand(ordinal)
      if ?selected then do
        if frozen = 0 & value.bank() <> 'r' & (value.bank() <> 'a' | value.index() <> 0) then return 'target.resource.backing.transport.borrowed.unproved'
        reg = findregister(instruction.function(),value.bank(),value.index())
        if reg = 0 then return 'target.resource.backing.transport.selector.unproved'
        if actiononly > 0 then do; if sourceselected = 0 then return 'target.resource.backing.transport.source.unproved.action.' || item.id() || '.' || item.mnemonic(); end
        else if selected[reg] = 0 then return 'target.resource.backing.transport.source.unproved.selected.' || item.id() || '.' || item.mnemonic()
      end
      else if value.kind() <> 'R' | value.bank() <> 'r' | value.index() < 0 | value.index() >= locals then return 'target.resource.transport.source.unproved'
    end
    do i = 1 to instruction.actions()
      if actiononly > 0 & i <> actiononly then iterate
      if spend(1) = 0 then return 'target.resource.limit'
      action = instruction.action(i); kind = action.kind()
      if ?selected & kind = 'external' then do
        /* A complete intrinsic value footprint leaves no hidden resource
         * write beyond the typed actions already checked. No-value-handle
         * host routes retain their separate callback/observer obligations. */
        if action.intrinsicfootprint() then do
          if wordpos(catalog.callbackvaluesurface(item.opcode()),'none bytes-snapshot') > 0 then iterate
        end
      end
      if wordpos(kind,'write clear transport derive flagwrite status') > 0 then do
        if action.subject() = 0 then return 'target.resource.implicit.write.unproved'
        view = profile.ref(action.subject())
        if ?selected then do
          reg = findregister(instruction.function(),view.bank(),view.index())
          if reg = 0 then return 'target.resource.backing.write.selector.unproved'
          if actiononly > 0 then do; if targetselected = 0 then iterate; end
          else if selected[reg] = 0 then iterate
        end
        else if view.bank() <> 'r' | view.index() < 0 | view.index() >= locals then return 'target.resource.external.write.unproved'
      end
      if kind = 'callback' then do
        if ?selected then do
          /* This surface describes value reach only. It preserves the
           * callback, reentry, output effects and physical observers. */
          if catalog.callbackvaluesurface(item.opcode()) = 'bytes-snapshot' then iterate
          mask = catalog.callbackobligations(item.opcode())
          bit = catalog.callbackmask('plugin-sync')
          if catalog.contextsynccontract() = 'value-only-nonreentrant.v1' then do; assembler iand overlap,mask,bit; mask = mask - overlap; end
          if wordpos(action.detail(),'catalog.callback.abi catalog.callback.departure') > 0 then iterate
          bit = catalog.callbackmask('input'); ordinal = catalog.callbackmask('output'); assembler ior bit,bit,ordinal
          ordinal = catalog.callbackmask('capacity'); assembler ior bit,bit,ordinal
          assembler iand overlap,mask,bit
          if mask <> overlap then return 'target.resource.backing.callback.reach.unproved'
          /* Public payload hooks hold opaque reachable handles. Supported
           * nested RXVML entry is a separate root: neither provides a handle
           * to this unescaped original backing. This proves no resource
           * mutation here, not observer equivalence or callback absence. */
          iterate
        end
        if action.detail() = 'catalog.callback.departure' then iterate
        if action.detail() = 'catalog.callback.abi' & catalog.returnkind(item.opcode()) > 0 then iterate
        if wordpos(action.detail(),'catalog.callback.payload catalog.callback.active-tree') > 0 then do
          if action.subject() = 0 then return 'target.resource.callback.condition.unproved'
          view = profile.ref(action.subject())
          if view.bank() <> 'r' | view.index() < 0 | view.index() >= locals then return 'target.resource.callback.borrowed.unproved'
          iterate
        end
        if action.detail() = 'catalog.callback.capacity-or-checkpoint' then do
          found = 0
          do j = 1 to item.operands()
            if spend(1) = 0 then return 'target.resource.limit'
            mask = catalog.callbackinputs(item.opcode(),j); bit = catalog.callbackoutputs(item.opcode(),j)
            assembler ior mask,mask,bit
            if mask = 0 & catalog.callbackcapacity(item.opcode(),j) = 0 then iterate
            found = 1; value = item.operand(j)
            if value.kind() <> 'R' | value.bank() <> 'r' | value.index() < 0 | value.index() >= locals then return 'target.resource.callback.capacity.unproved'
          end
          if found = 0 then return 'target.resource.callback.checkpoint.unproved'
          iterate
        end
        return 'target.resource.callback.' || action.detail() || '.unproved'
      end
      if wordpos(kind,'link unlink swap') > 0 then do
        if ?selected then iterate /* Exact alias/escape closure checked first. */
        if action.subject() = 0 then return 'target.resource.binding.unproved'
        view = profile.ref(action.subject())
        if view.bank() <> 'r' | view.index() < 0 | view.index() >= locals then return 'target.resource.binding.escape.unproved'
        if kind <> 'unlink' then do
          if action.sourcekind() <> 'reference' then return 'target.resource.binding.source.unproved'
          view = profile.ref(action.sourceid())
          if view.bank() <> 'r' | view.index() < 0 | view.index() >= locals then return 'target.resource.binding.escape.unproved'
        end
        iterate
      end
      if wordpos(kind,'read observe capture write clear transport derive flagwrite status return edge raise context') = 0 then return 'target.resource.action.' || kind || '.unproved'
    end
    return ''
  /** Reuse the same native predicates for an original owned backing in the
   * current invocation. The closure follows every published pointer carrier;
   * unmodelled selectors or publication cannot assert nonescape. Incidental
   * recycled-a0 timing supplies no extra veto or callback-absence fact. */
  privatebackinghistory: method = .lltargetflow..backinghistoryfact
    arg functionid = .int, bank = .string, number = .int, preparing = 0
    i = .int; j = .int; k = .int; left = .int; right = .int; reg = .int; cachekey = .int; growth = .int; changed = .int
    mask = .int; bit = .int; resourcebits = .int; overlap = .int; transport = .int
    item = .lltarget..record; instruction = .lltargettransfer..instruction
    view = .lltargettransfer..refview; destination = .lltargettransfer..refview; origin = .lltargettransfer..refview
    action = .lltargettransfer..action; edge = .lltargetcfg..edge
    result = .lltargetflow..backinghistoryfact
    if preparing = 0 then do
      call run()
      if valid() = 0 then return .backinghistoryfact(reference self,functionid,bank,number,'invalid',message())
    end
    else if _status <> 'building' then return .backinghistoryfact(reference self,functionid,bank,number,'invalid','target.resource.backing.preparation.closed')
    source = dereference _owner; profile = dereference _transfers; cfg = dereference _cfg
    reason = ''; state = 'proved'
    graphref = source.ir(); graph = dereference graphref
    if functionid < 2 | functionid > graph.functions() then return .backinghistoryfact(reference self,functionid,bank,number,'unknown','target.resource.backing.function.unavailable')
    body = source.body(functionid)
    if (bank <> 'r' | number < 0 | number >= body.locals()) & (bank <> 'a' | number <> 0) then reason = 'target.resource.backing.not.original.owned'
    if _premise <> 'canonical' then reason = 'target.resource.backing.native.inventory.required'
    if reason <> '' then return .backinghistoryfact(reference self,functionid,bank,number,'unknown',reason)
    reg = findregister(functionid,bank,number)
    /* Unreferenced declared originals need no new solver register. Virtual
     * cache coordinates follow the frozen full declared r-prefix plus a0. */
    cachekey = reg
    if reg = 0 then do
      cachekey = _regfunction[0] + 1
      do i = 2 to functionid - 1
        if spend(1) = 0 then return .backinghistoryfact(reference self,functionid,bank,number,'limit',message())
        previousbody = source.body(i); cachekey = cachekey + previousbody.locals() + 1
      end
      if bank = 'r' then cachekey = cachekey + number + 1
    end
    if cachekey <= _backinghistorypresent[0] then do
      if _backinghistorypresent[cachekey] then do
        result = _backinghistories[cachekey]
        if preparing then return result
        if result.status() = 'proved' then return result
        if cachekey <= _backinghistoryrefined[0] then do; if _backinghistoryrefined[cachekey] then return result; end
        return frozenbackinghistory(functionid,bank,number,reg,cachekey)
      end
    end
    growth = max(0,cachekey - _backinghistorypresent[0])
    if spend(_regfunction[0] + growth + 1) = 0 | reserve(growth * 40 + 192) = 0 | scratch(_regfunction[0],8) = 0 then return .backinghistoryfact(reference self,functionid,bank,number,'limit',message())
    selected = .int[]
    do i = 1 to _regfunction[0]; selected[i] = 0; end
    if reg > 0 then selected[reg] = 1
    changed = 1
    /* Least fixed point of native pointer aliases, never a scalar evaluator.
     * An incoming foreign link into a selected slot is not clean ownership. */
    do while changed & reason = ''
      changed = 0
      do i = 1 to body.records()
        if spend(1) = 0 then do; state = 'limit'; reason = message(); leave; end
        item = body.record(i)
        if item.kind() = 'procedure' then iterate
        if item.kind() = '.inlinedprivate' then do; reason = 'target.resource.backing.borrowed.suffix.unproved'; leave; end
        instruction = profile.instruction(item.id())
        if instruction.complete('references') = 0 | instruction.complete('bindings') = 0 | instruction.complete('order') = 0 then do; reason = 'target.resource.backing.alias.inventory.unproved'; leave; end
        if instruction.complete('relocation') = 0 then do; reason = 'target.resource.backing.frame.reach.unproved'; leave; end
        do j = 1 to instruction.references()
          if spend(1) = 0 then do; state = 'limit'; reason = message(); leave; end
          view = instruction.ref(j)
          if view.kind() = 'address' | view.kind() = 'window' | view.extentknown() = 0 then do; reason = 'target.resource.backing.alias.selector.unproved'; leave; end
        end
        if reason <> '' then leave
        if item.kind() = 'instruction' then do
          catalog = .llrxascatalog..catalog(); transport = catalog.transportsource(item.opcode())
          if transport > 0 then do k = 1 to item.operands()
            if spend(lookupcost() * 2 + 1) = 0 then do; state = 'limit'; reason = message(); leave; end
            if catalog.writes(item.opcode(),k) = 0 then iterate
            resourcebits = catalog.componentmask('reference'); bit = catalog.componentmask('native-payload'); assembler ior resourcebits,resourcebits,bit
            bit = catalog.componentmask('attribute-count'); assembler ior resourcebits,resourcebits,bit
            mask = catalog.writecomponents(item.opcode(),k); bit = catalog.callbackinputs(item.opcode(),transport); assembler ior mask,mask,bit
            assembler iand overlap,mask,resourcebits
            if overlap = 0 then iterate
            destinationvalue = item.operand(k); originvalue = item.operand(transport)
            left = findregister(functionid,destinationvalue.bank(),destinationvalue.index())
            if left = 0 then do; reason = 'target.resource.backing.transport.destination.unproved'; leave; end
            if selected[left] = 0 then iterate
            if originvalue.bank() <> 'r' & (originvalue.bank() <> 'a' | originvalue.index() <> 0) then do; reason = 'target.resource.backing.transport.borrowed.unproved'; leave; end
            right = findregister(functionid,originvalue.bank(),originvalue.index())
            if right = 0 then do; reason = 'target.resource.backing.transport.source.unproved.fixed.' || item.id() || '.' || item.mnemonic() || '.' || originvalue.bank() || originvalue.index(); leave; end
            if selected[right] = 0 then do; selected[right] = 1; changed = 1; end
          end
        end
        if reason <> '' then leave
        do j = 1 to instruction.actions()
          if spend(lookupcost() * 2 + 1) = 0 then do; state = 'limit'; reason = message(); leave; end
          action = instruction.action(j)
          if wordpos(action.kind(),'link swap') = 0 then iterate
          if action.subject() = 0 | action.sourcekind() <> 'reference' then do; reason = 'target.resource.backing.alias.source.unproved'; leave; end
          destination = profile.ref(action.subject()); origin = profile.ref(action.sourceid())
          left = findregister(functionid,destination.bank(),destination.index()); right = findregister(functionid,origin.bank(),origin.index())
          if left = 0 | right = 0 then do; reason = 'target.resource.backing.alias.selector.unproved'; leave; end
          if selected[left] = 0 & selected[right] = 0 then iterate
          if destination.bank() = 'g' | (action.kind() = 'swap' & origin.bank() = 'g') then do; reason = 'target.resource.backing.pointer.exported'; leave; end
          if selected[left] & selected[right] = 0 then do
            if origin.bank() = 'r' | (origin.bank() = 'a' & origin.index() = 0) then do; selected[right] = 1; changed = 1; end
            else do; reason = 'target.resource.backing.foreign.binding.unproved'; leave; end
          end
          if selected[right] & selected[left] = 0 then do; selected[left] = 1; changed = 1; end
          if action.kind() = 'swap' & selected[left] & selected[right] = 0 then do; selected[right] = 1; changed = 1; end
        end
        if reason <> '' then leave
      end
    end
    if reason = '' then do i = 1 to body.records()
      item = body.record(i)
      if item.kind() = 'procedure' then iterate
      instruction = profile.instruction(item.id())
      reason = resourceinstruction(instruction,body.locals(),selected)
      if reason <> '' then leave
      do j = 1 to cfg.outedges(item.id())
        if spend(j + 1) = 0 then do; state = 'limit'; reason = message(); leave; end
        edge = cfg.outedge(item.id(),j)
        if edge.complete() = 0 | edge.scopecomplete() = 0 | edge.role() = 'unknown' then do; reason = 'target.resource.backing.departure.unproved'; leave; end
        if edge.targetblock() > 0 & wordpos(edge.exposure(),'handler-call handler-call-async event-binding event-binding-async') > 0 then do; reason = 'target.resource.backing.handler.reach.unproved'; leave; end
      end
      if reason <> '' then leave
    end
    if _status = 'limit' then do; state = 'limit'; reason = message(); end
    if reason <> '' & state = 'proved' then state = 'unknown'
    result = .backinghistoryfact(reference self,functionid,bank,number,state,reason)
    if state <> 'limit' then do; _backinghistories[cachekey] = result; _backinghistorypresent[cachekey] = 1; _backinghistoryproved[cachekey] = state = 'proved'; end
    if preparing = 0 & state = 'unknown' then return frozenbackinghistory(functionid,bank,number,reg,cachekey)
    return result
  /** The CALL's own canonical resource actions have no implicit provider
   * authority. The complete child/cause projection is checked separately. */
  resourcecallaction: method = .string
    arg instruction = .lltargettransfer..instruction, ordinal = .int, selected = .int[]
    profile = dereference _transfers; invocation = .string
    action = instruction.action(ordinal); item = instruction.record(); catalog = .llrxascatalog..catalog()
    if action.kind() = 'external' then do
      if delegatedcall(instruction,action) then return ''
      return 'target.resource.backing.child.external.unproved'
    end
    if action.kind() = 'callback' then do
      if callframebindings(instruction,action) then return ''
      /* Fused and counted calls publish their frame-preparation and
       * invocation hooks through the ordinary callback inventory. The
       * checked child/cause projection has already discharged these two
       * routes for this exact local provider. */
      if _premise = 'canonical' & profile.callexacttarget(item.id()) & catalog.callcausestate(item.opcode()) = 'known' then do
        invocation = 'catalog.callback.residual.' || catalog.callbackmask('invocation')
        if action.detail() = 'catalog.callback.capacity-or-checkpoint' | action.detail() = invocation then return ''
      end
      return 'target.resource.backing.child.callback.reach.unproved'
    end
    if action.kind() = 'context' then do
      /* Typed ambient cells are separate from Rexx backing components. This
       * footprint proof leaves the context value/restoration unknown. */
      if action.domain() > 0 & action.domain() <= profile.domains() then do
        domain = profile.domain(action.domain())
        if domain.kind() = 'context' then return ''
      end
      return 'target.resource.backing.child.context.domain.unproved'
    end
    /* Fused preparation flags do not create a resource. The swap's checked
     * pointer relation is handled by backingbody at this same action point. */
    if action.kind() = 'status' | action.kind() = 'swap' then return ''
    if wordpos(action.kind(),'read observe capture callcapture call edge raise') > 0 then return ''
    return 'target.resource.backing.child.action.' || action.kind() || '.unproved'
  /** Substitute only frozen StorageIds; zero never means an empty effect. */
  backingmapped: method = .int
    arg storage = .int, bindings = .int[]
    if storage < 1 | storage > bindings[0] then return 0
    return bindings[storage]
  /** Add a resource-source obligation to the same original-owned fixed point.
   * Borrowed/context storage cannot acquire an original-backing invariant. */
  backingrequire: method = .string
    arg storage = .int, expose backings = .int[], expose changed = .int
    if storage < 1 | storage > backings[0] then return 'target.resource.backing.transport.source.unproved.binding.' || storage
    if ownedbase(storage) = 0 | _storebank[storage] = 'context' then return 'target.resource.backing.transport.borrowed.unproved'
    if backings[storage] = 0 then do; backings[storage] = 1; changed = 1; end
    return ''
  /** A call disjoint from the selected original backings needs no child
   * resource import. This is a pointer/range proof, never a scalar-count or
   * callback-absence fact; all native departure paths remain checked below. */
  backingcallisolated: method = .int
    arg instruction = .lltargettransfer..instruction, bindings = .int[], backings = .int[]
    item = instruction.record(); profile = dereference _transfers; catalog = .llrxascatalog..catalog(); source = dereference _owner
    i = .int; reg = .int; storage = .int; first = .int; packed = .int; ordinal = .int
    operand = .lltarget..operand; counter = .lltarget..operand; before = .state
    if _premise <> 'canonical' | catalog.callprefix(item.opcode()) <> '' then return 0
    do i = 1 to 7
