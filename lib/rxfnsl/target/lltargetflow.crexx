lifetimefact: class
  _owner = reference .lltargetflow..analysis
  _analysisid = .int
  _storage = .int
  _lifetime = .string
  _generation = .int
  *: factory
    arg owner = reference .analysis, storage = .int, lifetime = .string, generation = .int
    _owner = owner; parent = dereference owner; _analysisid = parent.identity()
    _storage = storage; _lifetime = lifetime; _generation = generation
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner; return owner.valid() & owner.identity() = _analysisid
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _lifetime = 'unknown' then return 'unknown'
    return 'proved'
  reason: method = .string
    if valid() = 0 then return 'target.flow.owner.expired.or.replaced'
    if _lifetime = 'unknown' then return 'target.flow.lifetime.unknown'
    return ''
  storage: method = .int
    if valid() = 0 then return 0
    return _storage
  state: method = .string
    if valid() = 0 then return 'unknown'
    return _lifetime
  generation: method = .int
    if valid() = 0 then return 0
    return _generation

/** Only an explicit typed observation can create this witness. Its bank and
 * index identify the owned base to clear, not a possibly linked spelling. */
entryread: class
  _owner = reference .lltargetflow..analysis
  _analysisid = .int
  _operation = .int
  _function = .int
  _storage = .int
  _index = .int
  _domain = .int
  _key = .string
  _activebank = .string
  _activeindex = .int
  *: factory
    arg owner = reference .analysis, operation = .int, functionid = .int, storage = .int, index = .int, domain = .int, key = .string, activebank = .string, activeindex = .int
    _owner = owner; _operation = operation; _function = functionid
    _storage = storage; _index = index; _domain = domain; _key = key
    _activebank = activebank; _activeindex = activeindex
    parent = dereference owner; _analysisid = parent.identity()
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner; return owner.valid() & owner.identity() = _analysisid
  status: method = .string
    if valid() then return 'ok'
    return 'invalid'
  reason: method = .string
    if valid() then return ''
    return 'target.flow.owner.expired.or.replaced'
  require: method = .void
    if valid() = 0 then assembler signal "ERROR","LL_TARGET_FLOW: expired or replaced entry-observation view"
    return
  operation: method = .int
    call require()
    return _operation
  function: method = .int
    call require()
    return _function
  bank: method = .string
    call require()
    return 'r'
  index: method = .int
    call require()
    return _index
  ownedindex: method = .int
    call require()
    return _index
  activebank: method = .string
    call require()
    return _activebank
  activeindex: method = .int
    call require()
    return _activeindex
  storage: method = .int
    call require()
    return _storage
  domain: method = .int
    call require()
    return _domain
  domainkey: method = .string
    call require()
    return _key
  origin: method = .llir..origin
    call require()
    owner = dereference _owner; source_ref = owner.owner(); source = dereference source_ref
    record = source.at(_operation); return record.origin()

/** A grouped dirty owned-entry obligation, or an explicit unresolved portion
 * of the extraction. Operation zero denotes unknown coverage, never no read. */
entrydemand: class
  _owner = reference .lltargetflow..analysis
  _identity = .int
  _function = .int
  _witness = .entryread
  _known = .int
  _reason = .string
  *: factory
    arg owner = reference .analysis, functionid = .int, reason = .string, ?witness = .entryread
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _function = functionid; _reason = reason; _known = ?witness
    if ?witness then _witness = witness
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    parent = dereference _owner
    if parent.valid() = 0 | parent.identity() <> _identity then return 0
    if _known then return _witness.valid()
    return 1
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _known then return 'proved'
    return 'unknown'
  reason: method = .string
    if valid() = 0 then return 'target.flow.owner.expired.or.replaced'
    return _reason
  kind: method = .string
    if _known then return 'dirty-owned-entry'
    return 'unresolved'
  function: method = .int
    return _function
  operation: method = .int
    if _known = 0 then return 0
    return _witness.operation()
  ownedindex: method = .int
    if _known = 0 then return -1
    return _witness.ownedindex()
  domain: method = .int
    if _known = 0 then return 0
    return _witness.domain()
  domainkey: method = .string
    if _known = 0 then return ''
    return _witness.domainkey()
  witness: method = .entryread
    if valid() = 0 | _known = 0 then assembler signal "ERROR","LL_TARGET_FLOW: unresolved entry demand has no dirty-origin witness"
    return _witness

/** Completeness concerns all owned-entry demands, independently of callback
 * observation preservation. Defined reads need no clear; known dirty reads
 * are grouped by source operation/base/domain. Unknown extraction always has
 * an unresolved row, so an empty dirty list cannot assert complete coverage.
 * Direct dependency IDs name other procedures owning demanded dirty return
 * origins. They require discharge on the candidate; extraction readiness does
 * not establish that those owners have been normalized. */
entrycoveragefact: class
  _owner = reference .lltargetflow..analysis
  _identity = .int
  _function = .int
  _status = .string
  _reason = .string
  _rows = .entrydemand[]
  _demands = .int
  _dependencies = .int[]
  _operation = .int
  _cone = .lltargetcfg..ingresscone
  _hascone = .int
  *: factory
    arg owner = reference .analysis, functionid = .int, status = .string, reason = .string, rows = .entrydemand[], demands = .int, ?dependencies = .int[], operation = 0, ?cone = .lltargetcfg..ingresscone
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _function = functionid; _status = status; _reason = reason; _rows = rows; _demands = demands
    if ?dependencies then _dependencies = dependencies
    _operation = operation; _hascone = ?cone
    if ?cone then _cone = cone
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    parent = dereference _owner
    if parent.valid() = 0 | parent.identity() <> _identity then return 0
    if _hascone then do; if _cone.valid() = 0 then return 0; end
    do i = 1 to _rows[0]; if _rows[i].valid() = 0 then return 0; end
    return 1
  status: method = .string
    if <refvalid>(_owner) = 0 then return 'invalid'
    parent = dereference _owner
    if parent.status() = 'limit' then return 'limit'
    if valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    if status() = 'invalid' & valid() = 0 then return 'target.flow.entry.coverage.owner.expired.or.replaced'
    if status() = 'limit' & _reason = '' then do; parent = dereference _owner; return parent.message(); end
    return _reason
  complete: method = .int
    return status() = 'proved'
  points: method = reference .lltargetflow..analysis
    return _owner
  function: method = .int
    return _function
  /** Zero denotes exhaustive procedure coverage; nonzero is a site query. */
  operation: method = .int
    return _operation
  demands: method = .int
    return _demands
  /** Direct source-owner procedure IDs, never an already discharged closure.
   * An expired or limited owner cannot masquerade as an empty dependency set. */
  dependencies: method = .int
    if valid() = 0 then assembler signal "ERROR","LL_TARGET_FLOW: unavailable entry-dependency view"
    return _dependencies[0]
  dependency: method = .int
    arg ordinal = .int
    if valid() = 0 then assembler signal "ERROR","LL_TARGET_FLOW: unavailable entry-dependency view"
    if ordinal < 1 | ordinal > _dependencies[0] then assembler signal "ERROR","LL_TARGET_FLOW: entry-dependency ordinal"
    return _dependencies[ordinal]
  unresolved: method = .int
    return complete() = 0
  rows: method = .int
    return _rows[0]
  row: method = .entrydemand
    arg ordinal = .int
    if ordinal < 1 | ordinal > _rows[0] then assembler signal "ERROR","LL_TARGET_FLOW: entry coverage row ordinal"
    return _rows[ordinal]
  demand: method = .entryread
    arg ordinal = .int
    if ordinal < 1 | ordinal > _demands then assembler signal "ERROR","LL_TARGET_FLOW: dirty entry demand ordinal"
    return _rows[ordinal].witness()

/** Analysis-private pure extraction from frozen action/capture checkpoints.
 * Its own bounded collector never changes whole-procedure observation flags.
 * The public site certificate accepts only a complete zero-demand result. */
siteentryquery: class
  _owner = reference .lltargetflow..analysis
  _operation = .int
  _function = .int
  _cone = .lltargetcfg..ingresscone
  _hascone = .int
  _rows = .entrydemand[]
  _keys = .string[]
  _dependencies = .int[]
  _status = .string
  _reason = .string
  _work = .int
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  _flowwork = .int
  _flowbytes = .int
  _chargedflowwork = .int
  _chargedflowbytes = .int
  *: factory
    arg owner = reference .analysis, operation = .int, work = .int, bytes = .int
    _owner = owner; _operation = operation; _worklimit = work; _bytelimit = bytes; _status = 'building'; _hascone = 0
    return
  fail: method = .int
    arg state = .string, reason = .string
    if _status = 'building' then do; _status = state; _reason = reason; end
    return 0
  spend: method = .int
    arg work = 1, bytes = 0
    if work < 0 | bytes < 0 | work > _worklimit - _work | bytes > _bytelimit - _bytes then return fail('limit','target.flow.site.work.or.bytes')
    _work = _work + work; _bytes = _bytes + bytes; return 1
  flowcharge: method = .int
    owner = dereference _owner
    work = owner.usedwork(); bytes = owner.usedbytes()
    morework = max(0,work - _flowwork); morebytes = max(0,bytes - _flowbytes)
    charged = spend(morework,morebytes); _flowwork = work; _flowbytes = bytes
    if charged then do; _chargedflowwork = _chargedflowwork + morework; _chargedflowbytes = _chargedflowbytes + morebytes; end
    if owner.status() <> 'ok' then return fail(owner.status(),owner.reason())
    return charged
  value: method = .int
    arg operation = .int, storage = .int, domainid = .int, value = .cell
    i = .int; j = .int
    owner = dereference _owner; profileref = owner.transfers(); profile = dereference profileref
    if value.availability() = 'unknown' then do
      if storage > 0 then do; if owner.ownedbase(storage) = 0 then return 1; end
      return fail('unknown','target.flow.site.observation.availability.unproved')
    end
    if value.origincount() = 0 & value.entry() = 0 then return 1
    if value.entryknown() = 0 then return fail('unknown','target.flow.site.entry.origins.unproved')
    domain = profile.domain(domainid)
    do i = 1 to value.origincount()
      if spend(_dependencies[0] + _keys[0] + 1) = 0 then return 0
      origin = value.origin(i)
      if owner.storagebank(origin) <> 'r' then iterate
      functionid = owner.storagefunction(origin)
      if functionid <> _function then do
        found = 0
        do j = 1 to _dependencies[0]; if _dependencies[j] = functionid then found = 1; end
        if found = 0 then do
          if spend(1,8) = 0 then return 0
          _dependencies[_dependencies[0] + 1] = functionid
        end
        iterate
      end
      key = operation || '|' || origin || '|' || domainid; found = 0
      do j = 1 to _keys[0]; if _keys[j] = key then found = 1; end
      if found then iterate
      if spend(length(key) + 1,320 + length(key)) = 0 then return 0
      index = owner.storageindex(origin)
      witness = .entryread(_owner,operation,_function,origin,index,domainid,domain.key(),'r',index)
      _keys[_keys[0] + 1] = key; _rows[_rows[0] + 1] = .entrydemand(_owner,_function,'',witness)
    end
    return 1
  observations: method = .int
    arg instruction = .lltargettransfer..instruction, rootop = .int, frames = .object[], functions = .int[], arguments = .string[], depth = .int, allpaths = .int
    owner = dereference _owner; profileref = owner.transfers(); profile = dereference profileref; cfgref = owner.cfg(); cfg = dereference cfgref
    action = .lltargettransfer..action; point = .actionpoint; item = instruction.record(); projected = .cell; edge = .lltargetcfg..edge
    i = .int; e = .int; edgeid = .int
    do i = 1 to 7
      if spend(1) = 0 then return 0
      family = word('observations references effects components bindings order ownership',i)
      if instruction.complete(family) = 0 then return fail('unknown','target.flow.site.operation.' || family || '.unproved')
    end
    do e = 0 to cfg.outedges(item.id())
      edgeid = 0
      if e > 0 then do
        if spend(e + 1) = 0 then return 0
        edge = cfg.outedge(item.id(),e); edgeid = edge.id()
        if allpaths = 0 then do
          if edge.targetop() = 0 then iterate
          if _cone.contains(edge.targetop()) = 0 then iterate
        end
      end
      do i = 1 to instruction.actions()
        if spend(1) = 0 then return 0
        action = instruction.action(i)
        if action.kind() = 'unknown' then return fail('unknown','target.flow.site.hidden.observation.unproved')
        if action.kind() = 'external' & action.intrinsicfootprint() = 0 then do
          if owner.delegatedcall(instruction,action) = 0 then return fail('unknown','target.flow.site.hidden.observation.unproved')
        end
        if action.kind() <> 'observe' then iterate
        if action.domain() = 0 then return fail('unknown','target.flow.site.observation.domain.unproved')
        domain = profile.domain(action.domain())
        if wordpos(domain.kind(),'component flag') = 0 then return fail('unknown','target.flow.site.observation.domain.unproved')
        if domain.kind() = 'flag' & instruction.complete('values') = 0 then return fail('unknown','target.flow.site.flag.observation.unproved')
        path = owner.actionplan(item.id(),edgeid)
        if flowcharge() = 0 then return 0
        if path.has(i) = 0 then do
          exceptional = 0; phase = 'unknown'
          if edgeid > 0 then do
            exceptional = edge.phase() <> 'none' & edge.role() <> 'normal' & edge.role() <> 'table' & right(edge.exposure(),6) <> '-async'
            phase = edge.phase()
          end
          if owner.applies(action,exceptional,phase) = 0 then iterate
          return fail('unknown','target.flow.site.observation.checkpoint.unproved')
        end
        point = path.point(i); storage = owner.pointstorage(point,action.subject()); projected = point.component(action.subject(),action.domain())
        if depth > 0 then do
          projected = owner.projectobservation(projected,action.domain(),frames,functions,arguments,depth)
          if projected.availability() = 'unknown' | projected.entryknown() = 0 then return fail('unknown','target.flow.site.call.observation.unproved')
        end
        if flowcharge() = 0 then return 0
        if value(rootop,storage,action.domain(),projected) = 0 then return 0
      end
    end
    return 1
  child: method = .int
    arg instruction = .lltargettransfer..instruction, rootop = .int, frames = .object[], functions = .int[], arguments = .string[], depth = .int
    owner = dereference _owner; ownerref = owner.owner(); source = dereference ownerref; profileref = owner.transfers(); profile = dereference profileref
    i = .int; j = .int; action = .lltargettransfer..action
    if depth >= 32 then return fail('unknown','target.flow.site.call.depth.unproved')
    catalog = .llrxascatalog..catalog(); item = instruction.record()
    incoming = owner.sitecapture(instruction.opid())
    if incoming.ready() = 0 then return fail('unknown','target.flow.site.capture.unproved')
    captured = 0
    do i = 1 to instruction.actions()
      if spend(1) = 0 then return 0
      action = instruction.action(i)
      if profile.premise() <> 'canonical' & action.kind() = 'call' then do
        if action.sourcekind() <> 'reference' then return fail('unknown','target.flow.site.call.profile.unproved')
        selected = profile.ref(action.sourceid()); expected = item.operand(catalog.calltarget(item.opcode())); supplied = selected.operand()
        if selected.kind() <> 'procedure' | selected.anchor() <> 'symbolic' | selected.operandordinal() <> catalog.calltarget(item.opcode()) | supplied.kind() <> 'P' then return fail('unknown','target.flow.site.call.profile.unproved')
        if (supplied.text() == expected.text()) = 0 then return fail('unknown','target.flow.site.call.profile.unproved')
      end
      if action.kind() = 'callcapture' then captured = 1
      if captured & action.kind() = 'callback' then do
        if owner.callbackpossibleat(instruction.opid(),i) then return fail('unknown','target.flow.site.call.callback.phase.unproved')
      end
    end
    functionid = owner.callobservationtarget(instruction,incoming,1)
    actuals = owner.callactuals(instruction,incoming,1)
    if flowcharge() = 0 then return 0
    if functionid < 2 | actuals = '?' | left(actuals,1) = '~' then return fail('unknown','target.flow.site.call.footprint.unproved')
    do i = 1 to depth; if functions[i] = functionid then return fail('unknown','target.flow.site.call.recursion.unproved'); end
    if spend(depth + words(actuals) + 1,160 + incoming.bytes() + depth * 24 + length(actuals)) = 0 then return 0
    childframes = frames; childfunctions = functions; childarguments = arguments
    childframes[depth + 1] = incoming as .object; childfunctions[depth + 1] = functionid; childarguments[depth + 1] = actuals
    body = source.body(functionid); cfgref = owner.cfg(); cfg = dereference cfgref
    do i = 1 to source.records()
      if spend(1) = 0 then return 0
      item = source.record(i)
      if item.procedureid() <> functionid | item.kind() = 'procedure' then iterate
      before = owner.sitebefore(item.id())
      if before.ready() = 0 then iterate
      described = profile.instruction(item.id())
      if item.kind() = 'instruction' then do
        if catalog.callinvokes(item.opcode()) then do
          if child(described,rootop,childframes,childfunctions,childarguments,depth + 1) = 0 then return 0
        end
      end
      if observations(described,rootop,childframes,childfunctions,childarguments,depth + 1,1) = 0 then return 0
    end
    return 1
  run: method = .void
    ignored = .int; i = .int
    if _status <> 'building' then return
    if <refvalid>(_owner) = 0 then do; ignored = fail('invalid','target.flow.site.owner.expired'); return; end
    owner = dereference _owner
    if owner.status() <> 'ok' then do; ignored = fail(owner.status(),owner.reason()); return; end
    _flowwork = owner.usedwork(); _flowbytes = owner.usedbytes()
    ownerref = owner.owner(); source = dereference ownerref; graphref = source.ir(); graph = dereference graphref
    if _operation < 1 | _operation > graph.operations() then do; ignored = fail('invalid','target.flow.site.operation.invalid'); return; end
    selected = source.at(_operation); _function = selected.procedureid(); catalog = .llrxascatalog..catalog()
    if selected.kind() <> 'instruction' then do; ignored = fail('invalid','target.flow.site.not.call'); return; end
    if catalog.callinvokes(selected.opcode()) = 0 then do; ignored = fail('invalid','target.flow.site.not.call'); return; end
    captured = owner.sitecapture(_operation)
    if captured.ready() = 0 then do; ignored = fail('unknown','target.flow.site.capture.unproved'); return; end
    cfgref = owner.cfg(); cfg = dereference cfgref
    _cone = cfg.ingressat(_operation,_worklimit - _work,_bytelimit - _bytes)
    _hascone = 1
    if _cone.complete() = 0 then do; ignored = fail(_cone.status(),_cone.reason()); return; end
    if spend(_cone.usedwork(),_cone.usedbytes()) = 0 then return
    profileref = owner.transfers(); profile = dereference profileref
    frames = .object[]; functions = .int[]; arguments = .string[]
    do i = 1 to _cone.operations()
      if spend(1) = 0 then return
      operation = _cone.at(i); item = source.at(operation)
      before = owner.sitebefore(operation)
      if before.ready() = 0 then do; ignored = fail('unknown','target.flow.site.prefix.unreached'); return; end
      instruction = profile.instruction(operation)
      if item.kind() = 'instruction' then do
        if catalog.callinvokes(item.opcode()) then do
          if child(instruction,operation,frames,functions,arguments,0) = 0 then return
        end
      end
      if observations(instruction,operation,frames,functions,arguments,0,0) = 0 then return
    end
    if flowcharge() = 0 then return
    _status = 'proved'
    return
  result: method = .lltargetflow..entrycoveragefact
    call run()
    rows = _rows; count = rows[0]
    if _status <> 'proved' then rows[count + 1] = .entrydemand(_owner,_function,_reason)
    /* Missing capture and invalid source can return before a cone exists.
     * A typed field declaration is not a constructed object receiver. */
    if _hascone then do
      if _cone.valid() then return .entrycoveragefact(_owner,_function,_status,_reason,rows,count,_dependencies,_operation,_cone)
    end
    return .entrycoveragefact(_owner,_function,_status,_reason,rows,count,_dependencies,_operation)
  ownwork: method = .int
    return max(0,_work - _chargedflowwork)
  ownbytes: method = .int
    return max(0,_bytes - _chargedflowbytes)

/** Checked call-point context. Construction derives its target rather than
 * accepting a caller's provider/result assertions. */
invocationfact: class
  _owner = reference .lltargetflow..analysis
  _analysisid = .int
  _identity = .int
  _operation = .int
  _target = .lltargetflow..targetfact
  _reason = .string
  _targetpresent = .int
  *: factory
    arg owner = reference .analysis, operation = .int
    _owner = owner; _operation = operation; _identity = nextidentity()
    parent = dereference owner; _analysisid = parent.identity()
    if parent.valid() = 0 then do; _reason = 'target.abi.invocation.owner.unavailable'; return; end
    _target = parent.targetat(operation); _targetpresent = 1
    if _target.status() = 'proved' then _reason = parent.abicallreason(operation,_target)
    return
  unproved: factory
    arg owner = reference .analysis, reason = .string
    _owner = owner; parent = dereference owner; _analysisid = parent.identity(); _identity = nextidentity(); _reason = reason
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    parent = dereference _owner
    if parent.valid() = 0 | parent.identity() <> _analysisid then return 0
    if _targetpresent = 0 then return 1
    return _target.valid()
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _reason <> '' | _targetpresent = 0 then return 'unknown'
    return _target.status()
  reason: method = .string
    if valid() = 0 then return 'target.abi.invocation.owner.stale'
    if _reason <> '' then return _reason
    if _targetpresent = 0 then return 'target.abi.invocation.not.supplied'
    return _target.reason()
  identity: method = .int
    return _identity
  operation: method = .int
    return _operation
  points: method = reference .lltargetflow..analysis
    return _owner
  transfers: method = reference .lltargettransfer..profile
    parent = dereference _owner; return parent.transfers()
  premise: method = .string
    parent = dereference _owner; profile_ref = parent.transfers(); profile = dereference profile_ref
    return profile.premise()
  target: method = .lltargetflow..targetfact
    if _targetpresent = 0 then return .targetfact(_owner,'unknown',_reason)
    return _target
  resultkind: method = .string
    if status() <> 'proved' then return 'unknown'
    parent = dereference _owner; return parent.abicallresultkind(_operation)
  result: method = .lltargetflow..storagefact
    parent = dereference _owner; return parent.abicallresult(_operation)
  actuals: method = .int
    if status() <> 'proved' then return -1
    parent = dereference _owner; return parent.captureargumentcount(_operation)
  actual: method = .lltargetflow..storagefact
    arg ordinal = .int
    parent = dereference _owner; return parent.captureargument(_operation,ordinal)
  resource: method = .lltargetflow..abiresource
    arg storage = .int
    parent = dereference _owner; return parent.abicallresource(_operation,storage)

/** One sparse resource checkpoint. The capacity witness is deliberately
 * stronger than logical child count zero: no retained or active child tree. */
/** Current-invocation original-owned resource/escape footprint, independent
 * of dirty scalar availability and callback observation. Prior private scalar
 * or cache contents and incidental recycler finalizer timing are infrastructure.
 * Current-execution payload installation, explicit clears/transfers and
 * ownership remain checked; this fact grants no callback absence. */
backinghistoryfact: class
  _owner = reference .lltargetflow..analysis
  _identity = .int
  _function = .int
  _bank = .string
  _index = .int
  _status = .string
  _reason = .string
  *: factory
    arg owner = reference .lltargetflow..analysis, functionid = .int, bank = .string, number = .int, status = .string, reason = ''
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _function = functionid; _bank = bank; _index = number; _status = status; _reason = reason
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    parent = dereference _owner
    return parent.valid() & parent.identity() = _identity
  status: method = .string
    if _status = 'limit' then return 'limit'
    if valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    if _status = 'limit' then return _reason
    if valid() = 0 then return 'target.resource.backing.owner.expired.or.replaced'
    return _reason
  resourcefree: method = .int
    return status() = 'proved'
  nonescape: method = .int
    return status() = 'proved'
  points: method = reference .lltargetflow..analysis
    return _owner
  function: method = .int
    return _function
  bank: method = .string
    return _bank
  index: method = .int
    return _index

abiresource: class
