    return _owner
  storage: method = .int
    return _storage
  generation: method = .int
    return _generation
  live: method = .int
    return _live
  referenceabsent: method = .int
    return _referenceabsent
  nativeabsent: method = .int
    return _nativeabsent
  activeempty: method = .int
    return _activeempty
  capacityempty: method = .int
    return _capacityempty
  clean: method = .abiresource
    return .abiresource(_owner,_storage,_generation,_live,1,1,1,1)
  same: method = .int
    arg other = .abiresource
    owner = other.points()
