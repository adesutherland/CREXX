    view = profile.ref(action.subject())
    return view.bank() = 'r' & _storefunction[storage] = instruction.function() & _storebank[storage] = 'r' & ownedbase(storage)
  callbackpossible: method = .int
    arg instruction = .lltargettransfer..instruction, action = .lltargettransfer..action, captured = .cell
    i = .int; mask = .int; output = .int
    endpoint = .lltarget..operand
    profile = dereference _transfers; catalog = .llrxascatalog..catalog()
