    do i = 1 to _regfunction[0]
      if spend(1) = 0 then return 0
      if _regbank[i] <> 'r' & (_regbank[i] <> 'a' | _regindex[i] <> 0) then iterate
      ignoredfact = privatebackinghistory(_regfunction[i],_regbank[i],_regindex[i],1)
      if _status <> 'building' then return 0
      if i > _backinghistoryproved[0] then _privateframeclean[_regfunction[i]] = 0
      else if _backinghistoryproved[i] = 0 then _privateframeclean[_regfunction[i]] = 0
    end
    return 1
  prepareresources: method = .int
    source = dereference _owner; profile = dereference _transfers; cfg = dereference _cfg; index = dereference _index
    body = .lltarget..body; item = .lltarget..record; instruction = .lltargettransfer..instruction
    edge = .lltargetcfg..edge; domain = .lltargettransfer..domain
    catalog = .llrxascatalog..catalog(); i = .int; f = .int; projected = .int; block = .int; child = .int; count = .int
    value = .lltarget..operand
    if reserve(index.functions() * 64 + _domains * 8) = 0 | spend(index.functions() + _domains) = 0 then return 0
    do f = 2 to index.functions()
      _resourceclean[f] = 0; _resourcereasons[f] = 'target.resource.entry.context.unproved'
      _resourcearguments[f] = 0; _resourceactuals[f] = -1; _resourceincoming[f] = 0; _resourcereturnclean[f] = 1
      /* The checked closure excludes other ingress. Its non-root members
