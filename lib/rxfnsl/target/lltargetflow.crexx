              reason = backingrequire(sourcebinding,backings,changed)
              if reason <> '' then return reason
              view = profile.ref(action.sourceid()); reg = findregister(functionid,view.bank(),view.index())
              if reg = 0 then return 'target.resource.backing.transport.source.unproved.op.' || item.id() || '.' || item.mnemonic() || '.' || view.bank() || view.index()
