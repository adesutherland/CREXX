    _owner = owner; _active = active; _base = base; _entry = entry; _slot = slot
    parent = dereference owner; _analysisid = parent.identity()
    return
  unproved: factory
    arg owner = reference .analysis, reason = .string
    _owner = owner; parent = dereference owner; _analysisid = parent.identity(); _reason = reason
    _active = 0; _base = 0; _entry = 0; _slot = 0
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner; return owner.valid() & owner.identity() = _analysisid
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _active = 0 then return 'unknown'
    return 'ok'
  reason: method = .string
    if valid() = 0 then return 'target.flow.owner.expired.or.replaced'
    if _reason <> '' then return _reason
    if _active = 0 then return 'target.flow.binding.unknown'
    return ''
  active: method = .int
    if valid() = 0 then return 0
    return _active
  base: method = .int
    if valid() = 0 then return 0
    return _base
  entry: method = .int
    if valid() = 0 then return 0
    return _entry
  slotidentity: method = .int
    if valid() = 0 then return 0
    return _slot

/** Borrowed immutable logical activation stack. Unknown is distinct from a
 * proved empty stack; entry source IDs are ordered outermost first. */
scopefact: class
  _owner = reference .lltargetflow..analysis
  _analysisid = .int
  _known = .int
  _entries = .int[]
  *: factory
    arg owner = reference .analysis, known = .int, entries = .int[]
    _owner = owner; _known = known; _entries = entries
    parent = dereference owner; _analysisid = parent.identity()
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    parent = dereference _owner
    return parent.valid() & parent.identity() = _analysisid
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _known = 0 then return 'unknown'
    return 'ok'
  reason: method = .string
    if valid() = 0 then return 'target.flow.owner.expired.or.replaced'
    if _known = 0 then return 'target.flow.scope.stack.unknown'
    return ''
  known: method = .int
    return valid() & _known
  depth: method = .int
    if known() = 0 then return 0
    return _entries[0]
  entry: method = .int
    arg ordinal = .int
    if known() = 0 | ordinal < 1 | ordinal > _entries[0] then do
      assembler signal "ERROR","LL_TARGET_FLOW: unavailable scope stack ordinal"; return 0
    end
    return _entries[ordinal]

/** Immutable exact callback checkpoint. A known point does not mean an absent
 * hook or a complete observation projection; canonical opaque hooks stay unknown. */
callbackfact: class
  _owner = reference .lltargetflow..analysis
  _identity = .int
  _status = .string
  _reason = .string
  _operation = .int
  _ordinal = .int
  _edge = .int
  _action = .lltargettransfer..action
  _scope = .scopefact
  _binding = .storagefact
  _anchor = .string
  _function = .int
  _detailed = .int
  _possible = .int
  *: factory
    arg owner = reference .analysis, status = .string, reason = .string, operation = 0, ordinal = 0, edgeid = 0
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _status = status; _reason = reason; _operation = operation; _ordinal = ordinal; _edge = edgeid; _possible = 1
    return
  resolved: factory
    arg owner = reference .analysis, operation = .int, ordinal = .int, edgeid = .int, action = .lltargettransfer..action, functionid = .int, scope = .scopefact, binding = .storagefact, anchor = .string, possible = .int
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _status = 'proved'; _operation = operation; _ordinal = ordinal; _edge = edgeid; _possible = possible
    _action = action; _function = functionid; _scope = scope; _binding = binding; _anchor = anchor; _detailed = 1
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    parent = dereference _owner
    if parent.valid() = 0 | parent.identity() <> _identity then return 0
    if _detailed then return _scope.valid() & _binding.valid()
    return 1
  status: method = .string
    if <refvalid>(_owner) = 0 then return 'invalid'
    parent = dereference _owner
    if parent.status() = 'limit' then return 'limit'
    if valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    if status() = 'invalid' then return 'target.callback.owner.expired.or.replaced'
    if status() = 'limit' & _reason = '' then do; parent = dereference _owner; return parent.message(); end
    return _reason
  points: method = reference .lltargetflow..analysis
    return _owner
  profileid: method = .int
    if valid() = 0 then return 0
    parent = dereference _owner; return parent.profileid()
  operation: method = .int
    return _operation
  ordinal: method = .int
    return _ordinal
  edge: method = .int
    return _edge
  function: method = .int
    return _function
  phase: method = .string
    if _detailed = 0 then return 'unknown'
    return _action.phase()
  path: method = .string
    if _detailed = 0 then return 'unknown'
    return _action.path()
  observation: method = .string
    if _detailed = 0 then return 'unknown'
    return _action.observation()
  detail: method = .string
    if _detailed = 0 then return ''
    return _action.detail()
  domain: method = .int
    if _detailed = 0 then return 0
    return _action.domain()
  anchor: method = .string
    return _anchor
  observed: method = .storagefact
    if _detailed then return _binding
    parent = dereference _owner; return parent.unprovedstorage(reason())
  scope: method = .scopefact
    if _detailed = 0 then do; empty = .int[]; return .scopefact(_owner,0,empty); end
    return _scope
  possible: method = .int
    if status() <> 'proved' then return 1
    return _possible
  binding: method = .storagefact
    arg bank = .string, index = .int
    parent = dereference _owner
    if status() <> 'proved' then return parent.unprovedstorage(reason())
    return parent.callbackbindingat(_operation,_ordinal,bank,index,_edge)

/** Storage lifetime is independent of payload presence and active register
 * spelling. A generation identifies an operational begin/end site; unknown
