  capacitywrites: method = .void
    arg instruction = .lltargettransfer..instruction, incoming = .state, expose current = .state, exceptional = .int
    item = instruction.record(); catalog = .llrxascatalog..catalog()
    value = .lltarget..operand; source = .lltarget..operand
    i = .int; reg = .int; storage = .int; other = .int; mask = .int; overlap = .int; bit = .int; resources = .int; clean = .int
    if item.kind() <> 'instruction' then return
    if catalog.callinvokes(item.opcode()) then do; call current.forgetcapacity(); return; end
    resources = catalog.componentmask('reference'); bit = catalog.componentmask('native-payload'); assembler ior resources,resources,bit
    bit = catalog.componentmask('attribute-count'); assembler ior resources,resources,bit
