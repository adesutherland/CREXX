          if edge.targetblock() > 0 & wordpos(edge.exposure(),'handler-call handler-call-async event-binding event-binding-async') > 0 then return 'target.resource.backing.handler.reach.unproved'
          if edge.phase() <> 'none' & edge.role() <> 'normal' & edge.role() <> 'table' & right(edge.exposure(),6) <> '-async' then do; exceptional = 1; phase = edge.phase(); end
