              end
            end
            projected = index.nextop(projected)
          end
          e = _outhead[b]
          do while e > 0
            edge = cfg.edge(e); next = current.copy(); op = edge.sourceop()
            if op > 0 & edge.phase() <> 'none' & edge.role() <> 'normal' & edge.role() <> 'table' & right(edge.exposure(),6) <> '-async' then do
              if _beforepresent[op] then do
                  before = _before[op] as .state; instruction = profile.instruction(op)
                  next = transfer(instruction,before,1,0,edge.phase())
              end
            end
            if op > 0 & _premise = 'canonical' then do
              record = target.at(op); catalog = .llrxascatalog..catalog()
              if record.kind() = 'instruction' & catalog.scopecontinuation(record.opcode()) > 0 & edge.phase() <> 'none' then do
                before = _before[op] as .state; instruction = profile.instruction(op)
                if edge.phase() = 'after' & right(edge.exposure(),6) = '-async' then next = transfer(instruction,before)
                else next = transfer(instruction,before,1,0,edge.phase())
              end
            end
            next = scopedepart(next,edge)
            if wordpos(edge.exposure(),'inherited inherited-async handler-call handler-call-async event-binding event-binding-async') > 0 & edge.targetblock() > 0 then next = foreignresume(next,edge.function())
            if edge.role() = 'async' | edge.role() = 'unknown' | edge.complete() = 0 then call next.clobber()
            if edge.targetblock() = 0 & edge.complete() then do
              if edge.role() = 'terminal' | edge.role() = 'unwind' then do s = 1 to _storefunction[0]
                if _storefunction[s] = edge.function() & ownedbase(s) & _storebank[s] <> 'context' then call next.setlifetime(s,'ended',_storefunction[0] + edge.id() * 2 + 1)
              end
            end
            previous = .state()
            if _edgepresent[e] then previous = _edge[e] as .state
            if next.same(previous) = 0 then do
              changed = 1; if save(_edge,_edgepresent,e,next) = 0 then return
            end
            e = _outnext[e]
          end
        end
      end
      /* Observe only the frozen solution, never a transient iteration. */
      do i = 1 to _instructions[0]
        op = _instructions[i]
        if _beforepresent[op] & _witnessops[op] then do
          before = _before[op] as .state; instruction = profile.instruction(op)
          normal = cfg.outedges(op) = 0
          do j = 1 to cfg.outedges(op)
            edge = cfg.outedge(op,j)
            if edge.role() = 'normal' | edge.role() = 'table' | edge.phase() = 'none' then normal = 1
            else ignoredstate = transfer(instruction,before,1,1,edge.phase())
          end
          if normal then ignoredstate = transfer(instruction,before,0,1)
          if _status <> 'building' then return
        end
      end
      do f = 2 to index.functions()
        if _entrydepends[f] = '' then iterate
        if entrydependencies(f,'') = 0 then _entrycomplete[f] = 0
        if _status <> 'building' then return
      end
      _status = 'ok'
      on signal as problem
        if _status = 'building' then ignored = fail('invalid','target.flow.' || problem.name() || ': ' || problem.message() || ' [source=' || problem.file() || ':' || problem.line() || ':' || problem.column() || '; address=' || problem.module() || '.' || problem.address() || ']')
    end
    return
  status: method = .string
    call run()
    if _status = 'ok' & valid() = 0 then return 'invalid'
    return _status
  message: method = .string
    call run()
    if _status = 'ok' & valid() = 0 then return 'target.flow.owner.expired.or.replaced'
    return _message
  reason: method = .string
    return message()
  valid: method = .int
    if _status <> 'ok' | <refvalid>(_owner) = 0 | <refvalid>(_transfers) = 0 | <refvalid>(_cfg) = 0 then return 0
    target = dereference _owner; profile = dereference _transfers; cfg = dereference _cfg
    return target.identity() = _revision & profile.identity() = _profileid & cfg.identity() = _cfgid & profile.matches(_owner) & cfg.matches(_owner,_transfers)
  matches: method = .int
    arg owner = reference .lltarget..module
    return valid() & (_owner <refsame> owner)
  owner: method = reference .lltarget..module
    return _owner
  transfers: method = reference .lltargettransfer..profile
    return _transfers
  /** Borrow the exact sealed operational premises used by this analysis.
   * A replacement body, profile or CFG rejects the borrow before a client
   * can use those premises to construct a normalization/remapping clone. */
  operationalprofile: method = reference .lltargettransfer..profile
    call run()
    if valid() = 0 then assembler signal "ERROR","LL_TARGET_FLOW: operational profile unavailable, expired or replaced"
    return _transfers
  cfg: method = reference .lltargetcfg..graph
    return _cfg
  revision: method = .int
    return _revision
  identity: method = .int
    return _identity
  schemaid: method = .int
    return _schema
  catalog: method = .string
    return _catalog
  premise: method = .string
    return _premise
  profileid: method = .int
    return _profileid
  cfgid: method = .int
    return _cfgid
  storagefunction: method = .int
    arg storage = .int
    if valid() = 0 | storage < 1 | storage > _storefunction[0] then return 0
    return _storefunction[storage]
  bindingsexact: method = .int
    arg current = .state, functionid = .int, restored = 0
    if current.ready() = 0 | current.scopeknown() = 0 then return 0
    if restored & current.depth() <> 0 then return 0
    do i = 1 to _regfunction[0]
      if _regfunction[i] <> functionid | _regbank[i] = 'context' then iterate
      if current.mapping(i) = 0 | current.base(i) = 0 | current.slot(i) = 0 then return 0
      if restored then do
        if current.mapping(i) <> _bases[i] | current.base(i) <> _bases[i] | current.slot(i) <> i then return 0
      end
    end
    return 1
  exactat: method = .int
    arg operation = .int, after = 0
    call run()
    if valid() = 0 then return 0
    target = dereference _owner; item = target.at(operation)
    current = .state()
    if after then do
      if operation > 0 & operation <= _afterpresent[0] then do; if _afterpresent[operation] then current = _after[operation] as .state; end
    end
    else if operation > 0 & operation <= _beforepresent[0] then do; if _beforepresent[operation] then current = _before[operation] as .state; end
    return bindingsexact(current,item.procedureid())
  departuresafe: method = .int
    arg edgeid = .int
    i = .int; j = .int
    call run()
    if valid() = 0 then return 0
    cfg = dereference _cfg; edge = cfg.edge(edgeid)
    if edge.complete() = 0 | edge.scopecomplete() = 0 | edge.targetblock() <> 0 | edge.role() <> 'terminal' then return 0
    current = .state()
    if edgeid > 0 & edgeid <= _edgepresent[0] then do; if _edgepresent[edgeid] then current = _edge[edgeid] as .state; end
    if current.ready() = 0 | current.scopeknown() = 0 | current.depth() <> 0 then return 0
    do i = 1 to _regfunction[0]
      if _regfunction[i] <> edge.function() | _regbank[i] = 'context' then iterate
      if current.base(i) <> _bases[i] then return 0
    end
    target = dereference _owner
    do i = 1 to edge.scopeexits()
      item = target.at(edge.scopeexit(i)); recipe = item.recipe()
      do j = 1 to recipe.owned()
        reg = recipereg(item,recipe.ownedref(j))
        if reg = 0 then return 0
        if current.lifetime(_bases[reg]) <> 'ended' then return 0
      end
    end
    return 1
  scopecount: method = .int
    arg operation = .int
    call run()
    if valid() = 0 then return -1
    if operation < 1 | operation > _afterpresent[0] then return -1
    if _afterpresent[operation] = 0 then return -1
    current = _after[operation] as .state
    if current.scopeknown() = 0 | current.depth() = 0 then return -1
    scope = current.scope(current.depth())
    if scope.entry() <> operation then return -1
    return scope.count()
  scopeactual: method = .int
    arg operation = .int, ordinal = .int
    if scopecount(operation) < ordinal | ordinal < 1 then return 0
    current = _after[operation] as .state; scope = current.scope(current.depth())
    return scope.actual(ordinal)
  exacton: method = .int
    arg edgeid = .int, restored = 0
    call run()
    if valid() = 0 then return 0
    cfg = dereference _cfg; edge = cfg.edge(edgeid)
    current = .state()
    if edgeid > 0 & edgeid <= _edgepresent[0] then do; if _edgepresent[edgeid] then current = _edge[edgeid] as .state; end
    return bindingsexact(current,edge.function(),restored)
  storagebank: method = .string
    arg storage = .int
    if valid() = 0 | storage < 1 | storage > _storebank[0] then return ''
    return _storebank[storage]
  storageindex: method = .int
    arg storage = .int
    if valid() = 0 | storage < 1 | storage > _storeindex[0] then return -1
    return _storeindex[storage]
  usedwork: method = .int
    if _projected then return _work + _projection.usedwork()
    return _work
  usedbytes: method = .int
    if _projected then return _bytes + _projection.usedbytes()
    return _bytes
  complete: method = .int
    arg functionid = .int, family = .string
    i = .int; j = .int; record = .lltarget..record
    call run()
    if valid() = 0 then return 0
    profile = dereference _transfers; cfg = dereference _cfg; target = dereference _owner
    if family = 'entry-normalization' then do
      return entryready(functionid)
    end
    if family = 'entry-observation' then do
      if functionid < 2 | functionid > _entrycomplete[0] | _entrycomplete[functionid] = 0 then return 0
      family = 'observations'
    end
    do i = 1 to _instructions[0]
      record = target.at(_instructions[i])
      if record.procedureid() = functionid & profile.complete(record.id(),family) = 0 then return 0
    end
    return cfg.normalcomplete(functionid) & cfg.exceptionalcomplete(functionid)
  unknownreason: method = .string
    arg functionid = .int, family = .string
    if valid() = 0 then return message()
    if complete(functionid,family) then return ''
    if family = 'entry-normalization' then do
      cfg = dereference _cfg; reason = cfg.normalizationreason(functionid)
      if reason <> '' then return reason
      if _entryreason[functionid] <> '' then return _entryreason[functionid]
    end
    return 'target.flow.' || family || '.incomplete'
  lookupcost: method = .int
    return _regfunction[0] + 1
  reached: method = .int
    arg operation = .int
    call run()
    if valid() = 0 | operation < 1 | operation > _beforepresent[0] then return 0
    return _beforepresent[operation]
  pointstate: method = .lltargetflow..state
    arg operation = .int, after = 0
    result = .state
    call run()
    if valid() = 0 then return .state()
    if after then do
      if operation > 0 & operation <= _afterpresent[0] then do; if _afterpresent[operation] then do; result = _after[operation] as .state; return result.copy(); end; end
    end
    else if operation > 0 & operation <= _beforepresent[0] then do; if _beforepresent[operation] then do; result = _before[operation] as .state; return result.copy(); end; end
    return .state()
  edgestate: method = .lltargetflow..state
    arg edgeid = .int
    result = .state
    call run()
    if valid() = 0 then return .state()
    if edgeid > 0 & edgeid <= _edgepresent[0] then do; if _edgepresent[edgeid] then do; result = _edge[edgeid] as .state; return result.copy(); end; end
    return .state()
  scopeview: method = .lltargetflow..scopefact
    arg current = .state
    entries = .int[]
    if current.ready() = 0 | current.scopeknown() = 0 then return .scopefact(reference self,0,entries)
    do i = 1 to current.depth()
      scope = current.scope(i); entries[i] = scope.entry()
    end
    return .scopefact(reference self,1,entries)
  scopeat: method = .lltargetflow..scopefact
    arg operation = .int, after = 0
    call run()
    current = .state()
    if valid() = 0 then return scopeview(current)
    if after then do
      if operation > 0 & operation <= _afterpresent[0] then do; if _afterpresent[operation] then current = _after[operation] as .state; end
    end
    else if operation > 0 & operation <= _beforepresent[0] then do; if _beforepresent[operation] then current = _before[operation] as .state; end
    return scopeview(current)
  scopeon: method = .lltargetflow..scopefact
    arg edgeid = .int
    call run()
    current = .state()
    if valid() = 0 then return scopeview(current)
    if edgeid > 0 & edgeid <= _edgepresent[0] then do; if _edgepresent[edgeid] then current = _edge[edgeid] as .state; end
    return scopeview(current)
  captureat: method = .lltargetflow..storagefact
    arg operation = .int, bank = .string, number = .int
    call run()
    if valid() = 0 then return .storagefact(reference self,0,0,0,0)
    if operation < 1 | operation > _capturepresent[0] then return .storagefact(reference self,0,0,0,0)
    if _capturepresent[operation] = 0 then return .storagefact(reference self,0,0,0,0)
    target = dereference _owner; item = target.at(operation); current = _capture[operation] as .state
    reg = findregister(item.procedureid(),bank,number)
    if reg = 0 then return .storagefact(reference self,0,0,0,0)
    return .storagefact(reference self,current.mapping(reg),current.base(reg),_bases[reg],current.slot(reg))
  capturecomponentat: method = .lltargetflow..valuefact
    arg operation = .int, bank = .string, number = .int, domain = .int
    call run()
    if valid() = 0 | domain < 1 | domain > _domains then return .valuefact(reference self,.cell(),0,domain)
    if operation < 1 | operation > _capturepresent[0] then return .valuefact(reference self,.cell(),0,domain)
    if _capturepresent[operation] = 0 then return .valuefact(reference self,.cell(),0,domain)
    target = dereference _owner; item = target.at(operation); current = _capture[operation] as .state
    reg = findregister(item.procedureid(),bank,number)
    if reg = 0 then return .valuefact(reference self,.cell(),0,domain)
    storage = current.mapping(reg)
    return .valuefact(reference self,cellat(current,storage,domain),storage,domain)
  preparationat: method = .lltargetflow..storagefact
    arg operation = .int, step = .int, bank = .string, number = .int
    call run()
    if valid() = 0 then return .storagefact(reference self,0,0,0,0)
    if operation < 1 | operation > _capturepresent[0] then return .storagefact(reference self,0,0,0,0)
    if _capturepresent[operation] = 0 then return .storagefact(reference self,0,0,0,0)
    target = dereference _owner; item = target.at(operation); recipe = item.recipe()
    if step < 1 | step > recipe.preparations() then return .storagefact(reference self,0,0,0,0)
    points = _preparations[operation]; current = points.at(step)
    reg = findregister(item.procedureid(),bank,number)
    if reg = 0 then return .storagefact(reference self,0,0,0,0)
    return .storagefact(reference self,current.mapping(reg),current.base(reg),_bases[reg],current.slot(reg))
  storageat: method = .lltargetflow..storagefact
    arg operation = .int, bank = .string, number = .int, after = 0
    current = .state()
    call run()
    if valid() = 0 then return .storagefact(reference self,0,0,0,0)
    if after then do
      if operation > 0 & operation <= _afterpresent[0] then do; if _afterpresent[operation] then current = _after[operation] as .state; end
    end
    else if operation > 0 & operation <= _beforepresent[0] then do; if _beforepresent[operation] then current = _before[operation] as .state; end
    target = dereference _owner; record = target.at(operation)
    reg = findregister(record.procedureid(),bank,number)
    if reg = 0 then return .storagefact(reference self,0,0,0,0)
    return .storagefact(reference self,current.mapping(reg),current.base(reg),_bases[reg],current.slot(reg))
  storageon: method = .lltargetflow..storagefact
    arg edgeid = .int, bank = .string, number = .int
    current = .state()
    call run()
    if valid() = 0 then return .storagefact(reference self,0,0,0,0)
    if edgeid > 0 & edgeid <= _edgepresent[0] then do; if _edgepresent[edgeid] then current = _edge[edgeid] as .state; end
    cfg = dereference _cfg; edge = cfg.edge(edgeid)
    reg = findregister(edge.function(),bank,number)
    if reg = 0 then return .storagefact(reference self,0,0,0,0)
    return .storagefact(reference self,current.mapping(reg),current.base(reg),_bases[reg],current.slot(reg))
  componentat: method = .lltargetflow..valuefact
    arg operation = .int, bank = .string, number = .int, domain = .int, after = 0
    current = pointstate(operation,after); target = dereference _owner; record = target.at(operation)
    reg = findregister(record.procedureid(),bank,number); storage = current.mapping(reg)
    if domain < 1 | domain > _domains then return .valuefact(reference self,.cell(),0,domain)
    return .valuefact(reference self,cellat(current,storage,domain),storage,domain)
  componenton: method = .lltargetflow..valuefact
    arg edgeid = .int, bank = .string, number = .int, domain = .int
    current = edgestate(edgeid); cfg = dereference _cfg; edge = cfg.edge(edgeid)
    reg = findregister(edge.function(),bank,number); storage = current.mapping(reg)
    if domain < 1 | domain > _domains then return .valuefact(reference self,.cell(),0,domain)
    return .valuefact(reference self,cellat(current,storage,domain),storage,domain)
  lifetimeat: method = .lltargetflow..lifetimefact
    arg operation = .int, bank = .string, number = .int, after = 0
    current = pointstate(operation,after); target = dereference _owner; record = target.at(operation)
    reg = findregister(record.procedureid(),bank,number); storage = current.mapping(reg)
    return .lifetimefact(reference self,storage,current.lifetime(storage),current.generation(storage))
  lifetimeon: method = .lltargetflow..lifetimefact
    arg edgeid = .int, bank = .string, number = .int
    current = edgestate(edgeid); cfg = dereference _cfg; edge = cfg.edge(edgeid)
    reg = findregister(edge.function(),bank,number); storage = current.mapping(reg)
    return .lifetimefact(reference self,storage,current.lifetime(storage),current.generation(storage))
  flagat: method = .lltargetflow..valuefact
    arg operation = .int, bank = .string, number = .int, domain = .int, after = 0
    return componentat(operation,bank,number,domain,after)
  flagon: method = .lltargetflow..valuefact
    arg edgeid = .int, bank = .string, number = .int, domain = .int
    return componenton(edgeid,bank,number,domain)
  entryobservations: method = .int
    call run()
    if valid() = 0 then return 0
    return _witnesses[0]
  entryobservation: method = .lltargetflow..entryread
    arg ordinal = .int
    call run()
    if valid() = 0 | ordinal < 1 | ordinal > _witnesses[0] then assembler signal "ERROR","LL_TARGET_FLOW: unavailable entry-observation witness"
    return _witnesses[ordinal]
  accessdomain: method = .int
    arg functionid = .int, storage = .int, domainid = .int
    if storage = 0 then return 0
    return _projection.domain(functionid,'target.storage.' || storage || '.domain.' || domainid)
  /** Scope access rows describe captured pointers, owned backing/lifetime
   * observations and result transfer on this same CFG. They intentionally
   * give no dead-definition kills for a possibly failed/resumed operation. */
  scopeaccess: method = .lltargetflow..accessrow
    arg instruction = .lltargettransfer..instruction, incoming = .state, exceptional = .int
    i = .int; d = .int; count = .int; countvalue = .cell; literal = .lltarget..operand
    row = .accessrow(); item = instruction.record(); catalog = .llrxascatalog..catalog(); profile = dereference _transfers
    domain = .lltargettransfer..domain; scope = .activation
    current = incoming.copy(); storages = .int[]
    reg = .int; storage = .int; resultordinal = .int; source = .int; value = .lltarget..operand; selected = .lltarget..operand
    if catalog.scopecontinuation(item.opcode()) > 0 then do
      recipe = item.recipe(); current = scopeprepare(item,incoming)
      do i = 1 to recipe.registers()
        reg = recipereg(item,i); role = recipe.role(i); storage = current.mapping(reg)
        if wordpos(role,'a0-destination proxy-destination owned-destination') > 0 then storage = current.base(reg)
        storages[storages[0] + 1] = storage
      end
      if recipe.argumentkind() = 'window' then do
        countvalue = scopecapturecount(item,current); literal = countvalue.literal()
        if countvalue.known() = 0 | literal.kind() <> 'I' then do; call row.add('observe',0); return row; end
        count = literal.index()
        if count < 0 | count > _regfunction[0] then do; call row.add('observe',0); return row; end
        value = item.reciperef(recipe.windowref())
        do i = 0 to count - 1
          if spend(_regfunction[0] + 1) = 0 then return row
          selected = windowvalue(item.procedureid(),value,i)
          if selected.kind() <> 'R' then do; call row.add('observe',0); return row; end
          reg = findregister(item.procedureid(),selected.bank(),selected.index())
          if reg = 0 then do; call row.add('observe',0); return row; end
          storages[storages[0] + 1] = current.mapping(reg)
        end
      end
      resultordinal = catalog.callresult(item.opcode())
      if resultordinal > 0 then do
        value = item.operand(resultordinal); reg = findregister(item.procedureid(),value.bank(),value.index())
        storages[storages[0] + 1] = current.mapping(reg)
      end
    end
    else if incoming.scopeknown() & incoming.depth() > 0 then do
      scope = incoming.scope(incoming.depth())
      do i = 1 to scope.owned(); storages[storages[0] + 1] = scope.base(i); end
      do i = 1 to scope.actuals(); storages[storages[0] + 1] = scope.actual(i); end
      if catalog.returnkind(item.opcode()) <> 1 then do
        storage = scope.result()
        if storage > 0 then storages[storages[0] + 1] = storage
        if catalog.returnkind(item.opcode()) = 2 then do
          source = refstorage(instruction,operandref(instruction,catalog.returnsource(item.opcode())),incoming)
          storages[storages[0] + 1] = source
        end
      end
    end
    else call row.add('observe',0)
    do i = 1 to storages[0]
      if scaledwork(max(1,_domains),2) = 0 then return row
      do d = 1 to _domains
        domain = profile.domain(d)
        if domain.kind() <> 'component' & domain.kind() <> 'flag' then iterate
        call row.add('observe',accessdomain(item.procedureid(),storages[i],d))
      end
    end
    return row
  callaccess: method = .lltargetflow..accessrow
    arg instruction = .lltargettransfer..instruction, incoming = .state
    row = .accessrow(); profile = dereference _transfers; domain = .lltargettransfer..domain
    if explicitcall(instruction) = 0 then do; call row.add('observe',0); return row; end
    if scaledwork(_storefunction[0],max(1,_domains) * 4) = 0 then return row
    do storage = 1 to _storefunction[0]
      if _storefunction[storage] <> instruction.function() & ownedbase(storage) then iterate
      do d = 1 to _domains
        domain = profile.domain(d)
        if domain.kind() <> 'component' & domain.kind() <> 'flag' then iterate
        id = accessdomain(instruction.function(),storage,d)
        call row.add('read',id); call row.add('observe',id); call row.add('write',id)
      end
    end
    return row
  projectpath: method = .lltargetflow..accessrow
    arg instruction = .lltargettransfer..instruction, incoming = .state, exceptional = .int, phase = 'unknown'
    row = .accessrow(); current = incoming.copy()
    if explicitcall(instruction) then return callaccess(instruction,incoming)
    if _premise = 'canonical' then do
      item = instruction.record(); catalog = .llrxascatalog..catalog(); cfg = dereference _cfg
      if item.kind() = 'instruction' then do
        if catalog.scopecontinuation(item.opcode()) > 0 | cfg.logicalreturn(item.id()) then return scopeaccess(instruction,incoming,exceptional)
      end
    end
    profile = dereference _transfers; action = .lltargettransfer..action
    domain = .lltargettransfer..domain; declared = .lltargettransfer..domain
    /* Addressed/captured actions need phase-local access snapshots. The
     * point transfer above resolves what it can; an incomplete access view
     * must pin liveness instead of dropping a capture, selector or lifetime. */
    do i = 1 to instruction.references()
      view = instruction.ref(i)
      if view.kind() = 'address' then do; call row.add('observe',0); return row; end
    end
    do ordinal = 1 to instruction.actions()
      action = instruction.action(ordinal)
      applicable = applies(action,exceptional,phase)
      if applicable = 0 then iterate
      if wordpos(action.kind(),'capture callcapture resize status') > 0 then do; call row.add('observe',0); return row; end
      if spend(current.count() + _regfunction[0] + _domains * 3 + 1) = 0 then return row
      subject = refreg(instruction,action.subject()); storage = refstorage(instruction,action.subject(),current)
      source = 0; sourceStorage = 0
      if action.sourcekind() = 'reference' then do
        source = refreg(instruction,action.sourceid())
        sourceStorage = refstorage(instruction,action.sourceid(),current)
      end
      kind = action.kind()
      if kind = 'derive' then do; call row.add('read',0); iterate; end
      if wordpos(kind,'link unlink swap') > 0 & (action.certainty() <> 'must' | applicable <> 1) then do; call current.clobberbindings(); iterate; end
      if kind = 'link' & subject > 0 then call current.bind(subject,sourceStorage)
      else if kind = 'unlink' & subject > 0 then call current.bind(subject,current.base(subject))
      else if kind = 'swap' & subject > 0 & source > 0 then call current.exchange(subject,source)
      if wordpos(kind,'read observe transport write clear derive flagwrite context lifetime') = 0 then iterate
      first = action.domain(); last = first; whole = first = 0
      if first > 0 then do; domain = profile.domain(first); whole = domain.kind() = 'whole'; end
      if whole then do; first = 1; last = _domains; end
      do d = first to last
        domain = profile.domain(d)
        if domain.kind() = 'whole' | (whole & domain.kind() = 'context') then iterate
        target = storage
        if domain.kind() = 'context' then do
          reg = findregister(instruction.function(),'context',0)
          if reg > 0 then target = _bases[reg]
        end
        id = accessdomain(instruction.function(),target,d)
        if kind = 'read' then call row.add('read',id)
        else if kind = 'observe' then call row.add('observe',id)
        else if kind = 'lifetime' then call row.add('observe',id)
        else do
          if action.sourcekind() = 'reference' then call row.add('read',accessdomain(instruction.function(),sourceStorage,d))
          call row.add('write',id)
          /* Borrowed/global may aliases prohibit an exact external kill. */
          if action.certainty() = 'must' & applicable = 1 & target > 0 then do
            if ownedbase(target) then call row.add('kill',id)
          end
          if target > 0 then do
            if ownedbase(target) = 0 then do s = 1 to _storefunction[0]
              if ownedbase(s) = 0 then call row.add('write',accessdomain(instruction.function(),s,d))
            end
          end
        end
      end
    end
    return row
  scopeedgeaccess: method = .void
    arg expose row = .accessrow, incoming = .state, edge = .lltargetcfg..edge
    i = .int; j = .int; d = .int
    if edge.scopeexits() = 0 then return
    if edge.scopecomplete() = 0 | incoming.scopeknown() = 0 then do; call row.add('observe',0); return; end
    profile = dereference _transfers; domain = .lltargettransfer..domain; scope = .activation
    do i = 1 to incoming.depth()
      scope = incoming.scope(i); exits = 0
      do j = 1 to edge.scopeexits(); if scope.entry() = edge.scopeexit(j) then exits = 1; end
      if exits = 0 then iterate
      if scaledwork(scope.owned() + scope.actuals() + 1,max(1,_domains) * 2) = 0 then return
      do d = 1 to _domains
        domain = profile.domain(d)
        if domain.kind() <> 'component' & domain.kind() <> 'flag' then iterate
        do j = 1 to scope.owned(); call row.add('observe',accessdomain(edge.function(),scope.base(j),d)); end
        do j = 1 to scope.actuals(); call row.add('observe',accessdomain(edge.function(),scope.actual(j),d)); end
        if scope.result() > 0 then call row.add('observe',accessdomain(edge.function(),scope.result(),d))
      end
    end
    return
  buildprojection: method = .void
    call run()
    if valid() = 0 | _projected then return
    cfg = dereference _cfg; profile = dereference _transfers; index = dereference _index
    _projection = .llirgraph..access(_index,'rxas.target.flow.v1.' || _profileid,1000000,max(1,_bytelimit - _bytes),max(1,_worklimit - _work))
    row = .accessrow; empty = .int[]; before = .state; departing = .state; boundaryrow = .accessrow
    paths = .object[]
    action = .lltargettransfer..action; j = .int; k = .int
    edge = .lltargetcfg..edge
    do i = 1 to _instructions[0]
      op = _instructions[i]; projected = cfg.projectedop(op)
      if projected = 0 | index.opcode(projected) <= 16 then iterate
      instruction = profile.instruction(op)
      f = instruction.function()
      /* An omitted description pins shared liveness. Missing observation or
       * implicit-selector precision is never represented by empty vectors. */
      scopeoperation = 0
      if _premise = 'canonical' then do
        item = instruction.record(); catalog = .llrxascatalog..catalog()
        if item.kind() = 'instruction' then scopeoperation = catalog.scopecontinuation(item.opcode()) > 0 | cfg.logicalreturn(op)
      end
      if scopeoperation = 0 & explicitcall(instruction) = 0 then do
        if instruction.complete('effects') = 0 | instruction.complete('references') = 0 | instruction.complete('components') = 0 | instruction.complete('observations') = 0 | instruction.complete('bindings') = 0 then iterate
      end
      hascall = 0
      do j = 1 to instruction.actions(); action = instruction.action(j); if action.kind() = 'call' then hascall = 1; end
      if hascall & explicitcall(instruction) = 0 then iterate
      if _beforepresent[op] then before = _before[op] as .state
      else iterate
      if cfg.outedges(op) = 0 then do
        row = projectpath(instruction,before,0)
        if _status <> 'ok' then leave
        if row.complete() = 0 then iterate
        call _projection.put(projected,row.reads(),row.observations(),row.writes(),row.kills())
      end
      else do
        complete = 1; call objectarraydrop paths
        do j = 1 to cfg.outedges(op)
          edge = cfg.outedge(op,j)
          exceptional = edge.phase() <> 'none' & edge.role() <> 'normal' & edge.role() <> 'table'
          row = projectpath(instruction,before,exceptional,edge.phase())
          departing = before
          if _afterpresent[op] then do
            if edge.phase() = 'after' | edge.role() = 'normal' then departing = _after[op] as .state
          end
          call scopeedgeaccess(row,departing,edge)
          if _status <> 'ok' then leave
          paths[j] = row as .object
          if row.complete() = 0 then complete = 0
        end
        if _status <> 'ok' then leave
        if complete = 0 then iterate
        call _projection.put(projected,empty,empty,empty,empty)
        boundaryrow = .accessrow(); hasboundary = 0
        do j = 1 to cfg.outedges(op)
          edge = cfg.outedge(op,j); row = paths[j] as .accessrow
          if edge.successorordinal() > 0 then call _projection.edgeput(projected,edge.successorordinal(),row.reads(),row.observations(),row.writes(),row.kills())
          else do
            /* Departure reads include copied values, live borrowed storage
             * and explicit lifetime observations. Boundary kills do not
             * claim to erase caller-owned state. */
            hasboundary = 1; list = row.reads(); observations = row.observations()
            do k = 1 to list[0]; call boundaryrow.add('observe',list[k]); end
            do k = 1 to observations[0]; call boundaryrow.add('observe',observations[k]); end
          end
        end
        if hasboundary then call _projection.boundaryput(projected,boundaryrow.observations())
      end
    end
    if _status <> 'ok' then call _projection.reject(_status,'target.flow.projection.' || _message)
    ignored = _projection.seal(); _projected = 1
    /* A stronger liveness capability cannot invalidate already frozen point
     * facts if its separate projection budget is unavailable. */
    if _status = 'limit' then do; _status = 'ok'; _message = ''; end
    return
  projection: method = reference .llirgraph..access
    call buildprojection()
    return reference _projection
  liveness: method = .llirgraph..live
    arg work = 1000000, bytes = 67108864
    call buildprojection()
    index = dereference _index
    return index.accessliveness(reference _projection,work,bytes)

analyse: procedure = .lltargetflow..analysis
  arg owner = reference .lltarget..module, transfers = reference .lltargettransfer..profile, cfg = reference .lltargetcfg..graph, work = 1000000, bytes = 67108864
  return .analysis(owner,transfers,cfg,work,bytes)
