/* cREXX License (MIT). Point and edge facts over the shared target CFG. */
options levelb
namespace lltargetflow expose analysis analyse valuefact storagefact scopefact lifetimefact entryread entrycoveragefact entrydemand targetfact invocationfact abicallbackfact abirow abiresource callbackfact backinghistoryfact
import rxfnsb
import llir
import llirgraph
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetrecipe
import llrxascatalog

boot: initialiser expose serial
  serial = 0
  return
nextidentity: procedure = .int expose serial
  if serial = 9223372036854775807 then assembler signal "ERROR","LL_TARGET_FLOW: identities exhausted"
  serial = serial + 1
  return serial

/** A sparse set for one executable continuation. */
accessrow: class
  _reads = .int[]
  _observations = .int[]
  _writes = .int[]
  _kills = .int[]
  _complete = .int
  *: factory
    _complete = 1
    return
  add: method = .void
    arg kind = .string, domain = .int
    list = .int[]
    if domain < 1 then do; _complete = 0; return; end
    select kind
      when 'read' then list = _reads
      when 'observe' then list = _observations
      when 'write' then list = _writes
      otherwise list = _kills
    end
    do i = 1 to list[0]; if list[i] = domain then return; end
    list[list[0] + 1] = domain
    select kind
      when 'read' then _reads = list
      when 'observe' then _observations = list
      when 'write' then _writes = list
      otherwise _kills = list
    end
    return
  reads: method = .int[]
    return _reads
  observations: method = .int[]
    return _observations
  writes: method = .int[]
    return _writes
  kills: method = .int[]
    return _kills
  complete: method = .int
    return _complete

/** Sparse immutable before-action bindings and component cells. Captured
 * values live separately: their IDs are not instruction reference IDs. */
actionpoint: class
  _domains = .int
  _refs = .int[]
  _active = .int[]
  _base = .int[]
  _entry = .int[]
  _slot = .int[]
  _first = .int[]
  _counts = .int[]
  _domainids = .int[]
  _values = .object[]
  *: factory
    arg domains = .int
    _domains = domains
    return
  add: method = .void
    arg refid = .int, active = .int, base = .int, entry = .int, slot = .int, domains = .int[], values = .object[]
    n = _refs[0] + 1
    _refs[n] = refid; _active[n] = active; _base[n] = base; _entry[n] = entry; _slot[n] = slot
    _first[n] = _values[0] + 1; _counts[n] = domains[0]
    do d = 1 to domains[0]
      at = _values[0] + 1; _domainids[at] = domains[d]; _values[at] = values[d]
    end
    return
  lookup: method = .int
    arg refid = .int
    if refid > 0 & refid <= _refs[0] then do; if _refs[refid] = refid then return refid; end
    do i = 1 to _refs[0]; if _refs[i] = refid then return i; end
    return 0
  active: method = .int
    arg refid = .int
    n = lookup(refid); if n = 0 then return 0
    return _active[n]
  base: method = .int
    arg refid = .int
    n = lookup(refid); if n = 0 then return 0
    return _base[n]
  entry: method = .int
    arg refid = .int
    n = lookup(refid); if n = 0 then return 0
    return _entry[n]
  slot: method = .int
    arg refid = .int
    n = lookup(refid); if n = 0 then return 0
    return _slot[n]
  component: method = .lltargetflow..cell
    arg refid = .int, domainid = .int
    n = lookup(refid)
    if n = 0 | domainid < 1 | domainid > _domains then return .cell()
    do i = _first[n] to _first[n] + _counts[n] - 1
      if _domainids[i] = domainid then return _values[i] as .cell
    end
    return .cell()

actionpath: class
  _reason = .string
  _points = .actionpoint[]
  _present = .int[]
  _captureids = .int[]
  _capturedomains = .int[]
  _captures = .object[]
  _callbackbindings = .actionpoint[]
  _callbackscopes = .scopefact[]
  _callbackpresent = .int[]
  *: factory
    arg reason = ''
    _reason = reason
    return
  reason: method = .string
    return _reason
  unproved: method = .void
    arg reason = .string
    _reason = reason
    return
  put: method = .void
    arg ordinal = .int, point = .actionpoint
    _points[ordinal] = point; _present[ordinal] = 1
    return
  has: method = .int
    arg ordinal = .int
    if ordinal < 1 | ordinal > _present[0] then return 0
    return _present[ordinal]
  point: method = .actionpoint
    arg ordinal = .int
    return _points[ordinal]
  callback: method = .void
    arg ordinal = .int, bindings = .actionpoint, scope = .scopefact
    _callbackbindings[ordinal] = bindings; _callbackscopes[ordinal] = scope; _callbackpresent[ordinal] = 1
    return
  hascallback: method = .int
    arg ordinal = .int
    if ordinal < 1 | ordinal > _callbackpresent[0] then return 0
    return _callbackpresent[ordinal]
  callbackextent: method = .int
    return _callbackpresent[0]
  callbackbindings: method = .actionpoint
    arg ordinal = .int
    return _callbackbindings[ordinal]
  callbackscope: method = .scopefact
    arg ordinal = .int
    return _callbackscopes[ordinal]
  capture: method = .void
    arg id = .int, domainid = .int, value = .cell
    n = _captureids[0] + 1
    _captureids[n] = id; _capturedomains[n] = domainid; _captures[n] = value as .object
    return
  captured: method = .cell
    arg id = .int, domainid = .int
    do i = 1 to _captureids[0]
      if _captureids[i] = id & _capturedomains[i] = domainid then return _captures[i] as .cell
    end
    return .cell()

/** Bounded ordered availability effects through possibly aliased borrows.
 * This is not a value expression: only caller storage identity resolves a
 * guard, and an unavailable effect never becomes a definition. */
aliasproof: class
  _root = .int
  _basekind = .int
  _basesource = .int
  _records = .binary
  _limited = .int
  *: factory
    arg root = .int, basekind = .int, basesource = .int, ?records = .binary, limited = 0
    _root = root; _basekind = basekind; _basesource = basesource; _limited = limited
    if ?records then _records = records
    return
  root: method = .int
    return _root
  basekind: method = .int
    return _basekind
  basesource: method = .int
    return _basesource
  rows: method = .int
    return <blen>(_records) <idiv> 16
  writer: method = .int
    arg ordinal = .int
    return <at..u32>((ordinal - 1) * 16) _records
  kind: method = .int
    arg ordinal = .int
    return <at..u32>((ordinal - 1) * 16 + 4) _records
  source: method = .int
    arg ordinal = .int
    return <at..u32>((ordinal - 1) * 16 + 8) _records
  definite: method = .int
    arg ordinal = .int
    return <at..u32>((ordinal - 1) * 16 + 12) _records
  limited: method = .int
    return _limited
  bytes: method = .int
    return 64 + <blen>(_records)
  key: method = .string
    return _root || ':' || _basekind || ':' || _basesource || ':' || _limited || ':' || bin2x(_records)
  extended: method = .aliasproof
    arg writingstorage = .int, kind = .int, source = .int, definite = .int
    if _limited then return self
    records = .binary; at = 0
    do i = 1 to rows()
      /* A later definite write supersedes earlier writes through that same
       * pointer. Possible writes cannot be reordered past another writer. */
      if definite & writer(i) = writingstorage then iterate
      call binappend records,binsubstr(_records,(i - 1) * 16 + 1,16)
    end
    if <blen>(records) >= 1024 then return .aliasproof(_root,0,0,''x as .binary,1)
    at = <blen>(records); call binresize records,at + 16
    <at..u32>(at) records = writingstorage; <at..u32>(at + 4) records = kind
    <at..u32>(at + 8) records = source; <at..u32>(at + 12) records = definite
    return .aliasproof(_root,_basekind,_basesource,records)

/** An internal immutable abstract value. Entry provenance is independent of
 * value presence: an absent/cleared component is a definition, not unknown. */
cell: class
  _kind = .string
  _value = .int
  _entry = .int
  _availability = .string
  _presence = .string
  _literal = .lltarget..operand
  _entryknown = .int
  _hasalias = .int
  _alias = .aliasproof
  _origins = .int[]
  _originlimited = .int
  *: factory
    arg kind = 'unknown', value = 0, entry = 0, availability = 'unknown', presence = 'unknown', ?literal = .lltarget..operand, entryknown = 1, ?alias = .aliasproof, ?origins = .int[]
    _kind = kind; _value = value; _entry = entry
    _availability = availability; _presence = presence
    _entryknown = entryknown
    if ?literal then _literal = literal
    else _literal = .lltarget..operand()
    _hasalias = 0
    if ?alias then do
      if alias.root() > 0 then do; _hasalias = 1; _alias = alias; end
    end
    if ?origins then do
      if origins[0] > 64 then do
        _originlimited = 1; _entryknown = 0; _entry = -1; _availability = 'unknown'; _kind = 'unknown'
        _literal = .lltarget..operand()
      end
      else do
        _origins = origins
        if origins[0] = 1 then _entry = origins[1]
        else if origins[0] > 1 then _entry = -1
      end
    end
    else if entry > 0 then _origins[1] = entry
    return
  kind: method = .string
    return _kind
  value: method = .int
    return _value
  entry: method = .int
    return _entry
  entryknown: method = .int
    return _entryknown
  availability: method = .string
    return _availability
  presence: method = .string
    return _presence
  literal: method = .lltarget..operand
    return _literal
  known: method = .int
    return _literal.kind() <> ''
  bytes: method = .int
    size = 96 + _literal.length() + _origins[0] * 8
    if _hasalias then size = size + _alias.bytes()
    return size
  hasalias: method = .int
    return _hasalias
  alias: method = .aliasproof
    return _alias
  withalias: method = .cell
    arg proof = .aliasproof
    if proof.limited() then return .cell('unknown',0,0,'unknown','unknown',.lltarget..operand(),0,proof)
    return .cell(_kind,_value,_entry,_availability,_presence,_literal,_entryknown,proof,_origins)
  origincount: method = .int
    return _origins[0]
  origin: method = .int
    arg ordinal = .int
    return _origins[ordinal]
  origins: method = .int[]
    return _origins
  originlimited: method = .int
    return _originlimited
  withorigins: method = .cell
    arg origins = .int[]
    proof = .aliasproof(0,0,0)
    if _hasalias then proof = _alias
    return .cell(_kind,_value,_entry,_availability,_presence,_literal,_entryknown,proof,origins)
  key: method = .string
    result = _kind || '|' || _value || '|' || _entry || '|' || _availability || '|' || _presence || '|' || _literal.kind() || '|' || _literal.index() || '|' || bin2x(_literal.bytes()) || '|' || _entryknown
    if _hasalias then result = result || '|' || _alias.key()
    result = result || '|origins:' || _originlimited
    do i = 1 to _origins[0]; result = result || ':' || _origins[i]; end
    return result
  merged: method = .lltargetflow..cell
    arg other = .cell
    incoming = .lltarget..operand
    if key() == other.key() then return self
    entryknown = _entryknown & other.entryknown()
    entry = _entry
    if entry <> other.entry() then do
      if entry = 0 then entry = other.entry()
      else if other.entry() <> 0 then entry = -1
    end
    availability = _availability
    if availability <> other.availability() then availability = 'mixed'
    if _availability = 'unknown' | other.availability() = 'unknown' then availability = 'unknown'
    presence = _presence
    if presence <> other.presence() then presence = 'unknown'
    origins = .int[]; a = 1; b = 1; selected = .int
    do while a <= _origins[0] | b <= other.origincount()
      if a > _origins[0] then do; selected = other.origin(b); b = b + 1; end
      else if b > other.origincount() then do; selected = _origins[a]; a = a + 1; end
      else if _origins[a] < other.origin(b) then do; selected = _origins[a]; a = a + 1; end
      else if _origins[a] > other.origin(b) then do; selected = other.origin(b); b = b + 1; end
      else do; selected = _origins[a]; a = a + 1; b = b + 1; end
      origins[origins[0] + 1] = selected
      if origins[0] > 64 then leave
    end
    result = .cell('phi',0,entry,availability,presence,.lltarget..operand(),entryknown)
    if known() & other.known() then do
      incoming = other.literal()
      if _literal.kind() = incoming.kind() & _literal.index() = incoming.index() & bin2x(_literal.bytes()) == bin2x(incoming.bytes()) then result = .cell('constant',0,entry,availability,presence,_literal,entryknown)
    end
    result = result.withorigins(origins)
    if _originlimited | other.originlimited() then do
      origins[65] = 0
      return result.withorigins(origins)
    end
    if result.originlimited() then return result
    if _hasalias & other.hasalias() then do
      otherproof = other.alias()
      if _alias.key() == otherproof.key() then return result.withalias(_alias)
    end
    else if _hasalias & other.availability() = 'defined' then return result.withalias(_alias)
    else if other.hasalias() & _availability = 'defined' then return result.withalias(other.alias())
    return result

/** One committed logical activation. Pointer captures and the sparse owned
 * snapshot are immutable; leaving restores bindings, never caller payloads. */
activation: class
  _entry = .int
  _result = .int
  _count = .int
  _actuals = .int[]
  _registers = .int[]
  _active = .int[]
  _bases = .int[]
  _slots = .int[]
  *: factory
    arg entry = .int, result = .int, count = .int, actuals = .int[], registers = .int[], active = .int[], bases = .int[], slots = .int[]
    _entry = entry; _result = result; _count = count; _actuals = actuals
    _registers = registers; _active = active; _bases = bases; _slots = slots
    return
  entry: method = .int
    return _entry
  result: method = .int
    return _result
  count: method = .int
    return _count
  actuals: method = .int
    return _actuals[0]
  actual: method = .int
    arg ordinal = .int
    if ordinal < 1 | ordinal > _actuals[0] then return 0
    return _actuals[ordinal]
  owned: method = .int
    return _registers[0]
  reg: method = .int
    arg ordinal = .int
    return _registers[ordinal]
  active: method = .int
    arg ordinal = .int
    return _active[ordinal]
  base: method = .int
    arg ordinal = .int
    return _bases[ordinal]
  slot: method = .int
    arg ordinal = .int
    return _slots[ordinal]
  bytes: method = .int
    return 96 + _actuals[0] * 8 + _registers[0] * 32
  same: method = .int
    arg other = .activation
    i = .int
    if _entry <> other.entry() | _result <> other.result() | _count <> other.count() | _actuals[0] <> other.actuals() | _registers[0] <> other.owned() then return 0
    do i = 1 to _actuals[0]; if _actuals[i] <> other.actual(i) then return 0; end
    do i = 1 to _registers[0]
      if _registers[i] <> other.reg(i) | _active[i] <> other.active(i) | _bases[i] <> other.base(i) | _slots[i] <> other.slot(i) then return 0
    end
    return 1

/** Owned locals start semantically dirty even when recycled storage contains
 * bytes. Argument entry rows borrow availability; binding never defines them.
 * Unknown contents of a defined component are not dirty entry provenance. */
state: class
  _ready = .int
  _map = .int[]
  _base = .int[]
  _slots = .int[]
  _storage = .int[]
  _domain = .int[]
  _cells = .object[]
  _lookup = .int[]
  _domains = .int
  _unknown = .int
  _lifetime = .string[]
  _generation = .int[]
  _capacityclean = .int[]
  _scopes = .activation[]
  _depth = .int
  _scopeknown = .int
  *: factory
    arg ?bases = .int[], domains = 0
    _domains = domains; _scopeknown = 1
    if ?bases then do
      _ready = 1
      do i = 1 to bases[0]
        _map[i] = bases[i]; _base[i] = bases[i]; _slots[i] = i
        _lifetime[i] = 'live'; _generation[i] = i
      end
    end
    return
  ready: method = .int
    return _ready
  count: method = .int
    return _cells[0]
  registers: method = .int
    return _map[0]
  isunknown: method = .int
    return _unknown
  initialize: method = .void
    arg ready = .int, unknown = .int, domains = 0
    _ready = ready; _unknown = unknown; _domains = domains
    return
  copy: method = .lltargetflow..state
    i = .int; value = .cell; scope = .activation
    result = .state()
    call result.initialize(_ready,_unknown,_domains)
    do i = 1 to _map[0]
      call result.bind(i,_map[i]); call result.bindbase(i,_base[i]); call result.bindsidentity(i,_slots[i])
      call result.setlifetime(i,_lifetime[i],_generation[i])
    end
    do i = 1 to _capacityclean[0]; call result.setcapacity(i,_capacityclean[i]); end
    /* Capture from this state before changing the destination receiver. */
    do i = 1 to _depth
      scope = _scopes[i]
      call result.push(scope)
    end
    if _scopeknown = 0 then call result.forgetscopeownership()
    do i = 1 to _cells[0]
      value = _cells[i] as .cell
      call result.append(_storage[i],_domain[i],value)
    end
    return result
  cellstorage: method = .int
    arg ordinal = .int
    return _storage[ordinal]
  celldomain: method = .int
    arg ordinal = .int
    return _domain[ordinal]
  cellat: method = .lltargetflow..cell
    arg ordinal = .int
    return _cells[ordinal] as .cell
  bytes: method = .int
    i = .int; scope = .activation; value = .cell
    result = 80 + _map[0] * 56 + _cells[0] * 64 + _lookup[0] * 8 + _capacityclean[0] * 8
    do i = 1 to _depth; scope = _scopes[i]; result = result + scope.bytes(); end
    do i = 1 to _cells[0]; value = _cells[i] as .cell; result = result + value.bytes(); end
    return result
  mapping: method = .int
    arg reg = .int
    if reg < 1 | reg > _map[0] then return 0
    return _map[reg]
  base: method = .int
    arg reg = .int
    if reg < 1 | reg > _base[0] then return 0
    return _base[reg]
  bindbase: method = .void
    arg reg = .int, storage = .int
    _base[reg] = storage
    return
  scopeknown: method = .int
    return _scopeknown
  depth: method = .int
    return _depth
  scope: method = .lltargetflow..activation
    arg ordinal = .int
    return _scopes[ordinal]
  push: method = .void
    arg scope = .activation
    _depth = _depth + 1; _scopes[_depth] = scope
    return
  pop: method = .void
    if _depth > 0 then _depth = _depth - 1
    return
  forgetscopes: method = .void
    call forgetscopeownership()
    call clobberbindings()
    return
  /** Logical ownership can be unknown while the public resource-callback
   * contract still preserves the suspended physical pointer tables. */
  forgetscopeownership: method = .void
    _scopeknown = 0; _depth = 0
    return
  slot: method = .int
    arg reg = .int
    if reg < 1 | reg > _slots[0] then return 0
    return _slots[reg]
  bind: method = .void
    arg reg = .int, storage = .int
    _map[reg] = storage
    return
  bindsidentity: method = .void
    arg reg = .int, identity = .int
    _slots[reg] = identity
    return
  setlifetime: method = .void
    arg storage = .int, lifetime = .string, generation = .int
    if storage > 0 then do; _lifetime[storage] = lifetime; _generation[storage] = generation; end
    return
  lifetime: method = .string
    arg storage = .int
    if storage < 1 | storage > _lifetime[0] then return 'unknown'
    return _lifetime[storage]
  generation: method = .int
    arg storage = .int
    if storage < 1 | storage > _generation[0] then return 0
    return _generation[storage]
  capacityextent: method = .int
    return _capacityclean[0]
  capacityclean: method = .int
    arg storage = .int
    if storage < 1 | storage > _capacityclean[0] then return 0
    return _capacityclean[storage]
  setcapacity: method = .void
    arg storage = .int, clean = .int
    if storage > 0 then _capacityclean[storage] = clean <> 0
    return
  forgetcapacity: method = .void
    assembler setattrs _capacityclean,0
    return
  clobberbindings: method = .void
    do i = 1 to _map[0]; _map[i] = 0; _base[i] = 0; _slots[i] = 0; end
    return
  exchange: method = .void
    arg first = .int, second = .int
    value = _map[first]; _map[first] = _map[second]; _map[second] = value
    value = _slots[first]; _slots[first] = _slots[second]; _slots[second] = value
    return
  at: method = .lltargetflow..cell
    arg storage = .int, domain = .int, entryvalue = .int
    if storage = 0 then return .cell()
    if _domains > 0 & domain >= 1 & domain <= _domains then do
      key = (storage - 1) * _domains + domain
      if key <= _lookup[0] then do
        ordinal = _lookup[key]
        if ordinal > 0 then return _cells[ordinal] as .cell
      end
      if _unknown then return .cell()
      return .cell('entry',entryvalue,storage,'entry','unknown')
    end
    do i = 1 to _cells[0]
      if _storage[i] = storage & _domain[i] = domain then return _cells[i] as .cell
    end
    if _unknown then return .cell()
    return .cell('entry',entryvalue,storage,'entry','unknown')
  put: method = .void
    arg storage = .int, domain = .int, value = .cell
    i = .int
    if storage = 0 then do; call clobber(); return; end
    if _domains > 0 & domain >= 1 & domain <= _domains then do
      key = (storage - 1) * _domains + domain
      if key <= _lookup[0] then do
        i = _lookup[key]
        if i > 0 then do; _cells[i] = value as .object; return; end
      end
      call append(storage,domain,value)
      return
    end
    do i = 1 to _cells[0]
      if _storage[i] = storage & _domain[i] = domain then do; _cells[i] = value as .object; return; end
    end
    call append(storage,domain,value)
    return
  putwork: method = .int
    arg storage = .int, domain = .int
    if storage = 0 then return _cells[0] + _lookup[0] + _lifetime[0] + 1
    if _domains > 0 & domain >= 1 & domain <= _domains then do
      key = (storage - 1) * _domains + domain
      return max(0,key - _lookup[0]) + 2
    end
    return _cells[0] + 2
  append: method = .void
    arg storage = .int, domain = .int, value = .cell
    i = _cells[0] + 1; _storage[i] = storage; _domain[i] = domain; _cells[i] = value as .object
    if _domains > 0 & storage > 0 & domain >= 1 & domain <= _domains then _lookup[(storage - 1) * _domains + domain] = i
    return
  clobber: method = .void
    _unknown = 1
    call objectarraydrop _cells
    assembler setattrs _storage,0
    assembler setattrs _domain,0
    assembler setattrs _lookup,0
    assembler setattrs _capacityclean,0
    do i = 1 to _lifetime[0]; _lifetime[i] = 'unknown'; _generation[i] = 0; end
    return
  merge: method = .lltargetflow..state
    arg other = .state, domains = .int
    value = .cell; incoming = .cell
    i = .int; storage = .int; domain = .int
    if _ready = 0 then return other.copy()
    if other.ready() = 0 then return copy()
    result = copy()
    if _map[0] <> other.registers() then do; call result.clobber(); call result.forgetscopes(); return result; end
    compatible = _scopeknown & other.scopeknown() & _depth = other.depth()
    scope = .activation; incomingScope = .activation
    if compatible then do i = 1 to _depth
      scope = _scopes[i]; incomingScope = other.scope(i)
      if scope.same(incomingScope) = 0 then compatible = 0
    end
    if compatible = 0 then call result.forgetscopeownership()
    do i = 1 to _map[0]
      if _map[i] <> other.mapping(i) then call result.bind(i,0)
      if _base[i] <> other.base(i) then call result.bindbase(i,0)
      if _slots[i] <> other.slot(i) then call result.bindsidentity(i,0)
      if _lifetime[i] <> other.lifetime(i) | _generation[i] <> other.generation(i) then call result.setlifetime(i,'unknown',0)
    end
    /* Unknown defaults do not erase explicit postwrite cells. Each absent
     * side is read through at(), so only facts present on both paths survive. */
    call result.initialize(_ready,_unknown | other.isunknown(),_domains)
    do i = 1 to _capacityclean[0]
      call result.setcapacity(i,_capacityclean[i] & other.capacityclean(i))
    end
    /* Entry defaults participate in a join even if only the other path has
     * an explicit definition. No path silently donates that definition. */
    do i = 1 to _cells[0]
      value = _cells[i] as .cell
      incoming = other.at(_storage[i],_domain[i],(_storage[i] - 1) * domains + _domain[i])
      call result.put(_storage[i],_domain[i],value.merged(incoming))
    end
    do i = 1 to other.count()
      storage = other.cellstorage(i); domain = other.celldomain(i)
      value = at(storage,domain,(storage - 1) * domains + domain)
      incoming = other.cellat(i)
      call result.put(storage,domain,value.merged(incoming))
    end
    return result
  same: method = .int
    arg other = .state
    value = .cell; incoming = .cell
    i = .int
    if _ready <> other.ready() | _unknown <> other.isunknown() | _map[0] <> other.registers() | _cells[0] <> other.count() | _depth <> other.depth() | _scopeknown <> other.scopeknown() then return 0
    scope = .activation; incomingScope = .activation
    do i = 1 to _depth
      scope = _scopes[i]; incomingScope = other.scope(i)
      if scope.same(incomingScope) = 0 then return 0
    end
    do i = 1 to _map[0]
      if _map[i] <> other.mapping(i) | _base[i] <> other.base(i) | _slots[i] <> other.slot(i) then return 0
      if _lifetime[i] <> other.lifetime(i) | _generation[i] <> other.generation(i) then return 0
    end
    do i = 1 to max(_capacityclean[0],other.capacityextent())
      if capacityclean(i) <> other.capacityclean(i) then return 0
    end
    do i = 1 to _cells[0]
      value = _cells[i] as .cell; incoming = other.at(_storage[i],_domain[i],0)
      if value.key() <> incoming.key() then return 0
    end
    return 1

/** Exact target provenance is bound to the analysis and selected image owner.
 * Unknown target values never expose a usable provider or procedure. */
targetfact: class
  _owner = reference .lltargetflow..analysis
  _identity = .int
  _status = .string
  _reason = .string
  _provider = reference .lltarget..module
  _procedure = .int
  _selection = .int
  _binding = .string
  _native = .lltargettransfer..selectionbinding
  _checked = .int
  *: factory
    arg owner = reference .analysis, status = .string, reason = .string, ?provider = reference .lltarget..module, procedureid = 0, selection = 0, bindingidentity = ''
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _status = status; _reason = reason; _procedure = procedureid; _selection = selection; _binding = bindingidentity
    if ?provider then _provider = provider
    return
  certified: factory
    arg owner = reference .analysis, proof = .lltargettransfer..selectionbinding
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _native = proof; _checked = 1; _status = 'proved'
    _provider = proof.provider(); _procedure = proof.procedure(); _selection = proof.selection(); _binding = proof.bindingidentity()
    if proof.typeoperation() = 0 then _selection = 0
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    parent = dereference _owner
    if _checked then do; if _native.valid() = 0 then return 0; end
    return parent.valid() & parent.identity() = _identity
  status: method = .string
    if valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    if valid() = 0 then return 'target.flow.owner.expired.or.replaced'
    return _reason
  require: method = .void
    if status() <> 'proved' then assembler signal "ERROR","LL_TARGET_FLOW: exact target unavailable"
    return
  provider: method = reference .lltarget..module
    call require(); return _provider
  procedure: method = .int
    call require(); return _procedure
  selection: method = .int
    call require(); return _selection
  bindingidentity: method = .string
    call require(); return _binding
  transfers: method = reference .lltargettransfer..profile
    call require()
    if _checked then return _native.providerprofile()
    parent = dereference _owner
    return parent.transfers()

/** Analysis-private frozen preparation checkpoints. */
statevector: class
  _values = .state[]
  *: factory
    return
  put: method = .void
    arg ordinal = .int, value = .state
    _values[ordinal] = value
    return
  at: method = .lltargetflow..state
    arg ordinal = .int
    if ordinal < 1 | ordinal > _values[0] then return .state()
    return _values[ordinal]

/** Borrowed facts validate their analysis owner on every public query. */
valuefact: class
  _owner = reference .lltargetflow..analysis
  _analysisid = .int
  _value = .cell
  _storage = .int
  _domain = .int
  _reason = .string
  *: factory
    arg owner = reference .analysis, value = .cell, storage = .int, domain = .int
    _owner = owner; _value = value; _storage = storage; _domain = domain
    parent = dereference owner; _analysisid = parent.identity()
    return
  unproved: factory
    arg owner = reference .analysis, domainid = .int, reason = .string
    _owner = owner; parent = dereference owner; _analysisid = parent.identity()
    _value = .cell(); _storage = 0; _domain = domainid; _reason = reason
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner; return owner.valid() & owner.identity() = _analysisid
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _value.kind() = 'unknown' then return 'unknown'
    return 'ok'
  reason: method = .string
    if valid() = 0 then return 'target.flow.owner.expired.or.replaced'
    if _reason <> '' then return _reason
    if _value.originlimited() then return 'target.flow.entry.origins.limit'
    if _value.hasalias() then do
      proof = _value.alias()
      if proof.limited() then return 'target.flow.alias.provenance.limit'
    end
    if _value.kind() = 'unknown' then return 'target.flow.value.unknown'
    return ''
  storage: method = .int
    if valid() = 0 then return 0
    return _storage
  domain: method = .int
    if valid() = 0 then return 0
    return _domain
  valueid: method = .int
    if valid() = 0 then return 0
    return _value.value()
  kind: method = .string
    if valid() = 0 then return 'unknown'
    return _value.kind()
  availability: method = .string
    if valid() = 0 then return 'unknown'
    return _value.availability()
  presence: method = .string
    if valid() = 0 then return 'unknown'
    return _value.presence()
  entrydependent: method = .int
    if valid() = 0 then return 0
    return _value.entry() <> 0
  originscomplete: method = .int
    return valid() & _value.entryknown()
  dirty: method = .int
    if valid() = 0 | _value.entryknown() = 0 then return 0
    owner = dereference _owner
    do i = 1 to _value.origincount()
      if owner.storagebank(_value.origin(i)) = 'r' then return 1
    end
    return 0
  known: method = .int
    return valid() & _value.known()
  literal: method = .lltarget..operand
    if known() then return _value.literal()
    return .lltarget..operand()

storagefact: class
  _owner = reference .lltargetflow..analysis
  _analysisid = .int
  _active = .int
  _base = .int
  _entry = .int
  _slot = .int
  _reason = .string
  *: factory
