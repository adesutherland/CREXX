    call run()
    current = .state()
    if valid() = 0 then return scopeview(current)
    if edgeid > 0 & edgeid <= _edgepresent[0] then do; if _edgepresent[edgeid] then current = _edge[edgeid] as .state; end
    return scopeview(current)
  captureat: method = .lltargetflow..storagefact
    arg operation = .int, bank = .string, number = .int
    call run()
    if valid() = 0 then return .storagefact(reference self,0,0,0,0)
    if operation < 1 | operation > _capturepresent[0] then return .storagefact(reference self,0,0,0,0)
    if _capturepresent[operation] = 0 then return .storagefact(reference self,0,0,0,0)
    target = dereference _owner; item = target.at(operation); current = _capture[operation] as .state
    reg = findregister(item.procedureid(),bank,number)
    if reg = 0 then return .storagefact(reference self,0,0,0,0)
    return .storagefact(reference self,current.mapping(reg),current.base(reg),_bases[reg],current.slot(reg))
  capturecomponentat: method = .lltargetflow..valuefact
    arg operation = .int, bank = .string, number = .int, domain = .int
    call run()
    if valid() = 0 | domain < 1 | domain > _domains then return .valuefact(reference self,.cell(),0,domain)
    if operation < 1 | operation > _capturepresent[0] then return .valuefact(reference self,.cell(),0,domain)
    if _capturepresent[operation] = 0 then return .valuefact(reference self,.cell(),0,domain)
    target = dereference _owner; item = target.at(operation); current = _capture[operation] as .state
    reg = findregister(item.procedureid(),bank,number)
    if reg = 0 then return .valuefact(reference self,.cell(),0,domain)
    storage = current.mapping(reg)
    return .valuefact(reference self,cellat(current,storage,domain),storage,domain)
  actionquery: method = .int
    arg sourceop = .int, ordinal = .int, refid = .int, domainid = 0
    call run()
    if valid() = 0 then return 0
    profile = dereference _transfers; instruction = profile.instruction(sourceop)
    if ordinal < 1 | ordinal > instruction.actions() | domainid < 0 | domainid > _domains then do
      assembler signal "ERROR","LL_TARGET_FLOW: action ordinal/domain unavailable"; return 0
    end
    if spend(instruction.references() + 1) = 0 then return 0
    do i = 1 to instruction.references()
      view = instruction.ref(i)
      if view.id() = refid then return 1
    end
    assembler signal "ERROR","LL_TARGET_FLOW: action reference has another source"
    return 0
  actionstorage: method = .lltargetflow..storagefact
    arg sourceop = .int, actionOrdinal = .int, refId = .int, edgeId = 0
    if actionquery(sourceop,actionOrdinal,refId) = 0 then return .storagefact(reference self,0,0,0,0)
    path = actionplan(sourceop,edgeId)
    if valid() = 0 then return .storagefact(reference self,0,0,0,0)
    if path.has(actionOrdinal) = 0 then return .storagefact.unproved(reference self,path.reason())
    point = path.point(actionOrdinal)
    if point.lookup(refId) = 0 then return .storagefact.unproved(reference self,'target.flow.action.reference.unmaterialized')
    return .storagefact(reference self,point.active(refId),point.base(refId),point.entry(refId),point.slot(refId))
  actioncomponent: method = .lltargetflow..valuefact
    arg sourceop = .int, actionOrdinal = .int, refId = .int, domainId = .int, edgeId = 0
    if domainId < 1 then do; assembler signal "ERROR","LL_TARGET_FLOW: action component domain unavailable"; return .valuefact(reference self,.cell(),0,domainId); end
    if actionquery(sourceop,actionOrdinal,refId,domainId) = 0 then return .valuefact(reference self,.cell(),0,domainId)
    path = actionplan(sourceop,edgeId)
    if valid() = 0 then return .valuefact(reference self,.cell(),0,domainId)
    if path.has(actionOrdinal) = 0 then return .valuefact.unproved(reference self,domainId,path.reason())
    point = path.point(actionOrdinal); profile = dereference _transfers; view = profile.ref(refId)
    storage = point.active(refId)
    if view.anchor() = 'base' then storage = point.base(refId)
    else if view.anchor() = 'entry' then storage = point.entry(refId)
    return .valuefact(reference self,point.component(refId,domainId),storage,domainId)
  actioncapture: method = .lltargetflow..valuefact
    arg sourceop = .int, captureActionId = .int, domainId = .int, edgeId = 0
    call run()
    if valid() = 0 then return .valuefact(reference self,.cell(),0,domainId)
    profile = dereference _transfers; instruction = profile.instruction(sourceop); found = 0
    if domainId < 1 | domainId > _domains then do
      assembler signal "ERROR","LL_TARGET_FLOW: capture domain unavailable"; return .valuefact(reference self,.cell(),0,domainId)
    end
    do i = 1 to instruction.actions()
      if spend(1) = 0 then return .valuefact(reference self,.cell(),0,domainId)
      action = instruction.action(i)
      if action.id() = captureActionId & action.kind() = 'capture' then do; found = 1; leave; end
    end
    if found = 0 then do
      assembler signal "ERROR","LL_TARGET_FLOW: capture action has another source/kind"; return .valuefact(reference self,.cell(),0,domainId)
    end
    path = actionplan(sourceop,edgeId)
    return .valuefact(reference self,path.captured(captureActionId,domainId),0,domainId)
  /** Zero certifies only this typed hook's captured no-callback condition.
   * Missing phase, capture, tree/capacity evidence is always possible. */
  callbackpossibleat: method = .int
    arg sourceop = .int, actionOrdinal = .int, edgeId = 0
    call run()
    if valid() = 0 then return 1
    profile = dereference _transfers; instruction = profile.instruction(sourceop)
    if actionOrdinal < 1 | actionOrdinal > instruction.actions() then do; assembler signal "ERROR","LL_TARGET_FLOW: callback action ordinal"; return 1; end
    action = instruction.action(actionOrdinal)
    if action.kind() <> 'callback' then do; assembler signal "ERROR","LL_TARGET_FLOW: action is not a callback"; return 1; end
    if wordpos(action.detail(),'catalog.callback.abi catalog.callback.departure') > 0 then do
      abi = abicallbackat(sourceop,edgeId)
      return abi.intrinsicpossible()
    end
    path = actionplan(sourceop,edgeId)
    if edgeId > 0 then do
      cfg = dereference _cfg; edge = cfg.edge(edgeId)
      exceptional = edge.phase() <> 'none' & edge.role() <> 'normal' & edge.role() <> 'table' & right(edge.exposure(),6) <> '-async'
      if applies(action,exceptional,edge.phase()) = 0 then return 0
    end
    else if applies(action,0) = 0 then return 0
    value = .cell()
    if action.sourcekind() = 'captured' then value = path.captured(action.sourceid(),action.domain())
    return callbackpossible(instruction,action,value)
  /** Read one real before-action callback checkpoint. ABI aggregates need an
   * individual native row before they can become a point-local event. */
  callbackat: method = .lltargetflow..callbackfact
    arg sourceop = .int, actionOrdinal = .int, edgeId = 0
    call run()
    if valid() = 0 then return .callbackfact(reference self,status(),message(),sourceop,actionOrdinal,edgeId)
    if spend(1) = 0 | reserve(224) = 0 then return .callbackfact(reference self,'limit',message(),sourceop,actionOrdinal,edgeId)
    if sourceop < 1 | sourceop > _beforepresent[0] then return .callbackfact(reference self,'invalid','target.callback.source.invalid',sourceop,actionOrdinal,edgeId)
    profile = dereference _transfers; instruction = profile.instruction(sourceop); cfg = dereference _cfg
    if actionOrdinal < 1 | actionOrdinal > instruction.actions() then return .callbackfact(reference self,'invalid','target.callback.action.invalid',sourceop,actionOrdinal,edgeId)
    if edgeId < 0 | edgeId > cfg.edges() then return .callbackfact(reference self,'invalid','target.callback.edge.invalid',sourceop,actionOrdinal,edgeId)
    if edgeId > 0 then do
      edge = cfg.edge(edgeId)
      if edge.sourceop() <> sourceop then return .callbackfact(reference self,'invalid','target.callback.edge.source.mismatch',sourceop,actionOrdinal,edgeId)
    end
    action = instruction.action(actionOrdinal)
    if action.kind() <> 'callback' then return .callbackfact(reference self,'invalid','target.callback.action.not.callback',sourceop,actionOrdinal,edgeId)
    if wordpos(action.detail(),'catalog.callback.abi catalog.callback.departure') > 0 then return .callbackfact(reference self,'unknown','target.callback.abi.row.required',sourceop,actionOrdinal,edgeId)
    path = actionplan(sourceop,edgeId)
    if valid() = 0 then return .callbackfact(reference self,status(),message(),sourceop,actionOrdinal,edgeId)
    if path.hascallback(actionOrdinal) = 0 then return .callbackfact(reference self,'unknown','target.callback.checkpoint.unproved',sourceop,actionOrdinal,edgeId)
    scope = path.callbackscope(actionOrdinal)
    if scope.known() = 0 then return .callbackfact(reference self,'unknown',scope.reason(),sourceop,actionOrdinal,edgeId)
    binding = unprovedstorage('target.callback.observation.unknown'); anchor = ''
    if action.observation() = 'component' then do
      view = profile.ref(action.subject()); anchor = view.anchor()
      binding = actionstorage(sourceop,actionOrdinal,action.subject(),edgeId)
      if binding.active() = 0 then return .callbackfact(reference self,'unknown','target.callback.observation.binding.unproved',sourceop,actionOrdinal,edgeId)
    end
    possible = callbackpossibleat(sourceop,actionOrdinal,edgeId)
    return .callbackfact.resolved(reference self,sourceop,actionOrdinal,edgeId,action,instruction.function(),scope,binding,anchor,possible)
  callbackbindingat: method = .lltargetflow..storagefact
    arg sourceop = .int, actionOrdinal = .int, bank = .string, number = .int, edgeId = 0
    call run()
    if valid() = 0 then return unprovedstorage(message())
    profile = dereference _transfers; instruction = profile.instruction(sourceop)
    path = actionplan(sourceop,edgeId)
    if valid() = 0 then return unprovedstorage(message())
    if path.hascallback(actionOrdinal) = 0 then return unprovedstorage('target.callback.checkpoint.unproved')
    if spend(lookupcost()) = 0 then return unprovedstorage(message())
    reg = findregister(instruction.function(),bank,number)
    if reg = 0 then return unprovedstorage('target.callback.delta.binding.unproved')
    point = path.callbackbindings(actionOrdinal)
    return .storagefact(reference self,point.active(reg),point.base(reg),point.entry(reg),point.slot(reg))
  /** Distinct symbolic borrows are not a nonalias proof. This bounded query
   * admits only distinct owned cells in this exact current physical frame. */
  privatedistinct: method = .int
    arg functionid = .int, left = .int, right = .int
    if valid() = 0 | left < 1 | right < 1 | left = right then return 0
    if left > _storefunction[0] | right > _storefunction[0] then return 0
    return _storefunction[left] = functionid & _storefunction[right] = functionid & ownedbase(left) & ownedbase(right)
  targetat: method = .lltargetflow..targetfact
    arg sourceop = .int
    current = .state
    call run()
    if valid() = 0 then return .targetfact(reference self,'unknown',message())
    profile = dereference _transfers; target = dereference _owner; catalog = .llrxascatalog..catalog()
    item = target.at(sourceop)
    if item.kind() <> 'instruction' then return .targetfact(reference self,'unknown','target.site.not.call')
    if catalog.callinvokes(item.opcode()) = 0 then return .targetfact(reference self,'unknown','target.site.not.call')
    value = item.operand(catalog.calltarget(item.opcode()))
    if value.kind() = 'P' then do
      checked = profile.invocationtarget(sourceop)
      if checked.procedure() > 0 then do
        if checked.status() = 'proved' then return .targetfact.certified(reference self,checked)
        return .targetfact(reference self,'unknown',checked.reason())
      end
      functionid = target.procedureid(value.text())
      if functionid > 0 then return .targetfact(reference self,'proved','',_owner,functionid,0,'owner.' || target.identity() || '.procedure.' || functionid)
      return .targetfact(reference self,'unknown','target.body.unavailable')
    end
    instruction = profile.instruction(sourceop)
    current = .state()
    if sourceop > 0 & sourceop <= _capturepresent[0] then do; if _capturepresent[sourceop] then current = _capture[sourceop] as .state; end
    if current.ready() = 0 & sourceop > 0 & sourceop <= _beforepresent[0] then do; if _beforepresent[sourceop] then current = _before[sourceop] as .state; end
    if current.ready() = 0 then return .targetfact(reference self,'unknown','target.call.unreached')
    storage = refstorage(instruction,operandref(instruction,catalog.calltarget(item.opcode())),current)
    component = integercell(current,storage)
    if component.value() > 0 then do i = 1 to _selectedvalues[0]
      if spend(1) = 0 then return .targetfact(reference self,'unknown','target.flow.work')
      if _selectedvalues[i] = component.value() then return .targetfact(reference self,'unknown','target.selection.authority.unavailable')
    end
    return .targetfact(reference self,'unknown','target.value.provenance.unproved')
  capturearguments: method = .int
    arg sourceop = .int
    ignored = .int
    call run()
    if valid() = 0 | sourceop < 1 then return -1
    profile = dereference _transfers; instruction = profile.instruction(sourceop)
    item = instruction.record(); catalog = .llrxascatalog..catalog()
    if item.kind() <> 'instruction' then return -1
    if catalog.callinvokes(item.opcode()) = 0 then return -1
    if sourceop <= _argumentpresent[0] then do; if _argumentpresent[sourceop] then return _argumentcounts[sourceop]; end
    current = .state(); prepared = 0
    if sourceop <= _capturepresent[0] then do; if _capturepresent[sourceop] then do; current = _capture[sourceop] as .state; prepared = 1; end; end
    if current.ready() = 0 & sourceop <= _beforepresent[0] then do; if _beforepresent[sourceop] then current = _before[sourceop] as .state; end
    if current.ready() = 0 then return -1
    actuals = callactuals(instruction,current,prepared)
    count = -1
    if actuals <> '?' & left(actuals,1) <> '~' then count = words(actuals)
    growth = max(0,sourceop - _argumentpresent[0])
    if growth > (_bytelimit - _bytes) / 48 then do; ignored = fail('limit','target.flow.argument.index.bytes'); return -1; end
    if spend(growth + 1) = 0 | reserve(growth * 48 + 64) = 0 then return -1
    point = .actionpoint(0); empty = .object[]; emptydomains = .int[]
    if count > 0 then do
      if scaledwork(count,length(actuals) + 1) = 0 then return -1
      if count > (_bytelimit - _bytes) / 48 then do; ignored = fail('limit','target.flow.argument.bytes'); return -1; end
      if reserve(count * 48) = 0 then return -1
      do i = 1 to count
        reg = word(actuals,i) as .int
        call point.add(i,current.mapping(reg),current.base(reg),_bases[reg],current.slot(reg),emptydomains,empty)
      end
    end
    _argumentpoints[sourceop] = point; _argumentcounts[sourceop] = count; _argumentpresent[sourceop] = 1
    return count
  captureargumentcount: method = .int
    arg sourceop = .int
    return capturearguments(sourceop)
  captureargument: method = .lltargetflow..storagefact
    arg sourceop = .int, ordinal = .int
    count = capturearguments(sourceop)
    if valid() = 0 | ordinal < 1 | ordinal > count then return .storagefact(reference self,0,0,0,0)
    point = _argumentpoints[sourceop]
    return .storagefact(reference self,point.active(ordinal),point.base(ordinal),point.entry(ordinal),point.slot(ordinal))
  preparationat: method = .lltargetflow..storagefact
    arg operation = .int, step = .int, bank = .string, number = .int
    call run()
    if valid() = 0 then return .storagefact(reference self,0,0,0,0)
    if operation < 1 | operation > _capturepresent[0] then return .storagefact(reference self,0,0,0,0)
    if _capturepresent[operation] = 0 then return .storagefact(reference self,0,0,0,0)
    target = dereference _owner; item = target.at(operation); recipe = item.recipe()
    if step < 1 | step > recipe.preparations() then return .storagefact(reference self,0,0,0,0)
    points = _preparations[operation]; current = points.at(step)
    reg = findregister(item.procedureid(),bank,number)
    if reg = 0 then return .storagefact(reference self,0,0,0,0)
    return .storagefact(reference self,current.mapping(reg),current.base(reg),_bases[reg],current.slot(reg))
  /** Construct an explicitly unproved binding in this exact analysis owner.
   * External consumers cannot fabricate an active/base/entry storage tuple. */
  unprovedstorage: method = .lltargetflow..storagefact
    arg reason = .string
    call run()
    if valid() = 0 then return .storagefact.unproved(reference self,message())
    return .storagefact.unproved(reference self,reason)
  storageat: method = .lltargetflow..storagefact
    arg operation = .int, bank = .string, number = .int, after = 0
    current = .state()
    call run()
    if valid() = 0 then return .storagefact(reference self,0,0,0,0)
    if after then do
      if operation > 0 & operation <= _afterpresent[0] then do; if _afterpresent[operation] then current = _after[operation] as .state; end
    end
    else if operation > 0 & operation <= _beforepresent[0] then do; if _beforepresent[operation] then current = _before[operation] as .state; end
    target = dereference _owner; record = target.at(operation)
    reg = findregister(record.procedureid(),bank,number)
    if reg = 0 then return .storagefact(reference self,0,0,0,0)
    return .storagefact(reference self,current.mapping(reg),current.base(reg),_bases[reg],current.slot(reg))
  storageon: method = .lltargetflow..storagefact
    arg edgeid = .int, bank = .string, number = .int
    current = .state()
    call run()
    if valid() = 0 then return .storagefact(reference self,0,0,0,0)
    if edgeid > 0 & edgeid <= _edgepresent[0] then do; if _edgepresent[edgeid] then current = _edge[edgeid] as .state; end
    cfg = dereference _cfg; edge = cfg.edge(edgeid)
    reg = findregister(edge.function(),bank,number)
    if reg = 0 then return .storagefact(reference self,0,0,0,0)
    return .storagefact(reference self,current.mapping(reg),current.base(reg),_bases[reg],current.slot(reg))
  componentat: method = .lltargetflow..valuefact
    arg operation = .int, bank = .string, number = .int, domain = .int, after = 0
    current = .state()
    call run()
    if valid() = 0 then return .valuefact(reference self,.cell(),0,domain)
    if after then do
      if operation > 0 & operation <= _afterpresent[0] then do; if _afterpresent[operation] then current = _after[operation] as .state; end
    end
    else if operation > 0 & operation <= _beforepresent[0] then do; if _beforepresent[operation] then current = _before[operation] as .state; end
    target = dereference _owner; record = target.at(operation)
    reg = findregister(record.procedureid(),bank,number); storage = current.mapping(reg)
    if domain < 1 | domain > _domains then return .valuefact(reference self,.cell(),0,domain)
    return .valuefact(reference self,cellat(current,storage,domain),storage,domain)
  entrycomponentat: method = .lltargetflow..valuefact
    arg operation = .int, bank = .string, number = .int, domain = .int, after = 0
    current = .state()
    call run()
    if valid() = 0 then return .valuefact(reference self,.cell(),0,domain)
    if after then do
      if operation > 0 & operation <= _afterpresent[0] then do; if _afterpresent[operation] then current = _after[operation] as .state; end
    end
    else if operation > 0 & operation <= _beforepresent[0] then do; if _beforepresent[operation] then current = _before[operation] as .state; end
    target = dereference _owner; record = target.at(operation)
    reg = findregister(record.procedureid(),bank,number); storage = 0
    if reg > 0 then storage = _bases[reg]
    if domain < 1 | domain > _domains then return .valuefact(reference self,.cell(),0,domain)
    return .valuefact(reference self,cellat(current,storage,domain),storage,domain)
  componenton: method = .lltargetflow..valuefact
    arg edgeid = .int, bank = .string, number = .int, domain = .int
    current = edgestate(edgeid); cfg = dereference _cfg; edge = cfg.edge(edgeid)
    reg = findregister(edge.function(),bank,number); storage = current.mapping(reg)
    if domain < 1 | domain > _domains then return .valuefact(reference self,.cell(),0,domain)
    return .valuefact(reference self,cellat(current,storage,domain),storage,domain)
  lifetimeat: method = .lltargetflow..lifetimefact
    arg operation = .int, bank = .string, number = .int, after = 0
    current = pointstate(operation,after); target = dereference _owner; record = target.at(operation)
    reg = findregister(record.procedureid(),bank,number); storage = current.mapping(reg)
    return .lifetimefact(reference self,storage,current.lifetime(storage),current.generation(storage))
  lifetimeon: method = .lltargetflow..lifetimefact
    arg edgeid = .int, bank = .string, number = .int
    current = edgestate(edgeid); cfg = dereference _cfg; edge = cfg.edge(edgeid)
    reg = findregister(edge.function(),bank,number); storage = current.mapping(reg)
    return .lifetimefact(reference self,storage,current.lifetime(storage),current.generation(storage))
  flagat: method = .lltargetflow..valuefact
    arg operation = .int, bank = .string, number = .int, domain = .int, after = 0
    return componentat(operation,bank,number,domain,after)
  flagon: method = .lltargetflow..valuefact
    arg edgeid = .int, bank = .string, number = .int, domain = .int
    return componenton(edgeid,bank,number,domain)
  entryobservations: method = .int
    call run()
    if valid() = 0 then return 0
    return _witnesses[0]
  entryobservation: method = .lltargetflow..entryread
    arg ordinal = .int
    call run()
    if valid() = 0 | ordinal < 1 | ordinal > _witnesses[0] then assembler signal "ERROR","LL_TARGET_FLOW: unavailable entry-observation witness"
    return _witnesses[ordinal]
  /** Exhaustive grouped owned-entry demands. Callback preservation is a
   * separate obligation; its havoc still makes a later unknown read fail. */
  entrycoverage: method = .lltargetflow..entrycoveragefact
    arg functionid = .int
    rows = .entrydemand[]; count = 0; i = .int; state = .string; reason = .string
    dependencies = .int[]; dependencytext = .string; dependencycount = .int; requiredowner = .int
    call run()
    if valid() = 0 then return .entrycoveragefact(reference self,functionid,status(),message(),rows,0)
    if functionid < 2 | functionid > _entrydemandcomplete[0] then return .entrycoveragefact(reference self,functionid,'invalid','target.flow.entry.coverage.function.invalid',rows,0)
    if spend(_instructions[0] * 5 + _witnesses[0] + 1) = 0 then return .entrycoveragefact(reference self,functionid,'limit',message(),rows,0)
    dependencytext = _entrydepends[functionid]; dependencycount = words(dependencytext)
    if scaledwork(dependencycount,length(dependencytext) + 1) = 0 then return .entrycoveragefact(reference self,functionid,'limit',message(),rows,0)
    state = 'proved'; reason = ''
    if entryready(functionid,1) = 0 then do
      state = 'unknown'; cfg = dereference _cfg; reason = cfg.normalizationreason(functionid)
      if reason = '' then reason = _entryreason[functionid]
      if reason = '' | reason = 'target.flow.callback.observations.unproved' then reason = 'target.flow.entry.demand.unproved'
    end
    if reserve(256 + (_witnesses[0] + 1) * 320 + length(reason) + dependencycount * 16) = 0 then return .entrycoveragefact(reference self,functionid,'limit',message(),rows,0)
    do i = 1 to dependencycount
      requiredowner = word(dependencytext,i) as .int
      if requiredowner < 2 | requiredowner > _entrydemandcomplete[0] then do
        ignored = fail('invalid','target.flow.entry.dependency.owner.invalid')
        return .entrycoveragefact(reference self,functionid,'invalid',message(),rows,0)
      end
      dependencies[i] = requiredowner
    end
    do i = 1 to _witnesses[0]
      witness = _witnesses[i]
      if witness.function() <> functionid then iterate
      count = count + 1; rows[count] = .entrydemand(reference self,functionid,'',witness)
    end
    if state <> 'proved' then rows[count + 1] = .entrydemand(reference self,functionid,reason)
    return .entrycoveragefact(reference self,functionid,state,reason,rows,count,dependencies)
  /** A strict frozen checkpoint, with no fallback to an earlier phase. */
  sitecapture: method = .lltargetflow..state
    arg operation = .int
    call run()
    if valid() = 0 | operation < 1 | operation > _capturepresent[0] then return .state()
    if _capturepresent[operation] = 0 then return .state()
    return _capture[operation] as .state
  sitebefore: method = .lltargetflow..state
    arg operation = .int
    call run()
    if valid() = 0 | operation < 1 | operation > _beforepresent[0] then return .state()
    if _beforepresent[operation] = 0 then return .state()
    return _before[operation] as .state
  /** Site coverage is deliberately separate from entrycoverage(function).
   * Frozen global completeness and callback/ABI facts are never upgraded. */
  entrycoverageat: method = .lltargetflow..entrycoveragefact
    arg operation = .int, work = 1000000, bytes = 67108864
    call run()
    query = .siteentryquery(reference self,operation,work,bytes)
    result = query.result()
    ignored = spend(query.ownwork()) & reserve(query.ownbytes())
    return result
  accessdomain: method = .int
    arg functionid = .int, storage = .int, domainid = .int
    if storage = 0 then return 0
    return _projection.domain(functionid,'target.storage.' || storage || '.domain.' || domainid)
  pointstorage: method = .int
    arg point = .actionpoint, refid = .int
    if refid = 0 then return 0
    profile = dereference _transfers; view = profile.ref(refid)
    if view.anchor() = 'base' then return point.base(refid)
    if view.anchor() = 'entry' then return point.entry(refid)
    if view.anchor() <> 'active' & view.anchor() <> 'symbolic' then return 0
    return point.active(refid)
  /** Scope access rows describe captured pointers, owned backing/lifetime
   * observations and result transfer on this same CFG. They intentionally
   * give no dead-definition kills for a possibly failed/resumed operation. */
  scopeaccess: method = .lltargetflow..accessrow
    arg instruction = .lltargettransfer..instruction, incoming = .state, exceptional = .int
    i = .int; d = .int; count = .int; countvalue = .cell; literal = .lltarget..operand
    row = .accessrow(); item = instruction.record(); catalog = .llrxascatalog..catalog(); profile = dereference _transfers
    domain = .lltargettransfer..domain; scope = .activation
    current = incoming.copy(); storages = .int[]
    reg = .int; storage = .int; resultordinal = .int; source = .int; value = .lltarget..operand; selected = .lltarget..operand
    if catalog.scopecontinuation(item.opcode()) > 0 then do
      recipe = item.recipe(); current = scopeprepare(item,incoming)
      do i = 1 to recipe.registers()
        reg = recipereg(item,i); role = recipe.role(i); storage = current.mapping(reg)
        if wordpos(role,'a0-destination proxy-destination owned-destination') > 0 then storage = current.base(reg)
        storages[storages[0] + 1] = storage
      end
      if recipe.argumentkind() = 'window' then do
        countvalue = scopecapturecount(item,current); literal = countvalue.literal()
        if countvalue.known() = 0 | literal.kind() <> 'I' then do; call row.add('observe',0); return row; end
        count = literal.index()
        if count < 0 | count > _regfunction[0] then do; call row.add('observe',0); return row; end
        value = item.reciperef(recipe.windowref())
        do i = 0 to count - 1
          if spend(_regfunction[0] + 1) = 0 then return row
          selected = windowvalue(item.procedureid(),value,i)
          if selected.kind() <> 'R' then do; call row.add('observe',0); return row; end
          reg = findregister(item.procedureid(),selected.bank(),selected.index())
          if reg = 0 then do; call row.add('observe',0); return row; end
          storages[storages[0] + 1] = current.mapping(reg)
        end
      end
      resultordinal = catalog.callresult(item.opcode())
      if resultordinal > 0 then do
        value = item.operand(resultordinal); reg = findregister(item.procedureid(),value.bank(),value.index())
        storages[storages[0] + 1] = current.mapping(reg)
      end
    end
    else if incoming.scopeknown() & incoming.depth() > 0 then do
      scope = incoming.scope(incoming.depth())
      do i = 1 to scope.owned(); storages[storages[0] + 1] = scope.base(i); end
      do i = 1 to scope.actuals(); storages[storages[0] + 1] = scope.actual(i); end
      if catalog.returnkind(item.opcode()) <> 1 then do
        storage = scope.result()
        if storage > 0 then storages[storages[0] + 1] = storage
        if catalog.returnkind(item.opcode()) = 2 then do
          source = refstorage(instruction,operandref(instruction,catalog.returnsource(item.opcode())),incoming)
          storages[storages[0] + 1] = source
        end
      end
    end
    else call row.add('observe',0)
    do i = 1 to storages[0]
      if scaledwork(max(1,_domains),2) = 0 then return row
      do d = 1 to _domains
        domain = profile.domain(d)
        if domain.kind() <> 'component' & domain.kind() <> 'flag' then iterate
        call row.add('observe',accessdomain(item.procedureid(),storages[i],d))
      end
    end
    return row
  callaccess: method = .lltargetflow..accessrow
    arg instruction = .lltargettransfer..instruction, incoming = .state
    row = .accessrow(); profile = dereference _transfers; domain = .lltargettransfer..domain
    if callprojectable(instruction) = 0 then do; call row.add('observe',0); return row; end
    if scaledwork(_storefunction[0],max(1,_domains) * 4) = 0 then return row
    do storage = 1 to _storefunction[0]
      if _storefunction[storage] <> instruction.function() & ownedbase(storage) then iterate
      do d = 1 to _domains
        domain = profile.domain(d)
        if domain.kind() <> 'component' & domain.kind() <> 'flag' then iterate
        id = accessdomain(instruction.function(),storage,d)
        call row.add('read',id); call row.add('observe',id); call row.add('write',id)
      end
    end
    return row
  /** Post-solve access permission, independent of the fixed-call transfer
   * fast path. A finite captured bank and exact local provider permit the
   * conservative whole-caller row without inventing an implicit extent. */
  callprojectable: method = .int
    arg instruction = .lltargettransfer..instruction
    if _premise <> 'canonical' then return 0
    item = instruction.record(); catalog = .llrxascatalog..catalog()
    if item.kind() <> 'instruction' then return 0
    if catalog.callinvokes(item.opcode()) = 0 | instruction.complete('references') = 0 then return 0
    if _callbackops[instruction.opid()] then do i = 1 to instruction.actions()
      action = instruction.action(i)
      if action.kind() = 'callback' then do; if callbackpossibleat(instruction.opid(),i) then return 0; end
    end
    if spend(lookupcost() + instruction.references() + 1) = 0 then return 0
    if captureargumentcount(item.id()) < 0 then return 0
    target = targetat(item.id())
    if target.status() <> 'proved' then return 0
    provider = target.provider()
    return provider <refsame> _owner
  projectpath: method = .lltargetflow..accessrow
    arg instruction = .lltargettransfer..instruction, incoming = .state, exceptional = .int, phase = 'unknown', edgeid = 0
    action = .lltargettransfer..action; ordinal = .int
    row = .accessrow(); current = incoming.copy()
    if callprojectable(instruction) then return callaccess(instruction,incoming)
    if _premise = 'canonical' then do
      item = instruction.record(); catalog = .llrxascatalog..catalog(); cfg = dereference _cfg
      if item.kind() = 'instruction' then do
        if catalog.scopecontinuation(item.opcode()) > 0 | cfg.logicalreturn(item.id()) then do
          /* The scope adapter describes its ABI pointers, not arbitrary
           * reads through an entry/departure hook. Keep that boundary unknown
           * on each applicable path until its shared condition is disproved. */
          do ordinal = 1 to instruction.actions()
            if spend(1) = 0 then return row
            action = instruction.action(ordinal)
            if action.kind() <> 'callback' then iterate
            if applies(action,exceptional,phase) = 0 then iterate
            if callbackpossibleat(instruction.opid(),ordinal,edgeid) then do; call row.add('observe',0); return row; end
          end
          return scopeaccess(instruction,incoming,exceptional)
        end
      end
    end
    profile = dereference _transfers
    domain = .lltargettransfer..domain; declared = .lltargettransfer..domain
    path = actionplan(instruction.opid(),edgeid)
    point = .actionpoint
    do ordinal = 1 to instruction.actions()
      action = instruction.action(ordinal)
      applicable = applies(action,exceptional,phase)
      if applicable = 0 then iterate
      if action.kind() = 'callback' then do
        if callbackpossibleat(instruction.opid(),ordinal,edgeid) then do; call row.add('observe',0); return row; end
        iterate
      end
      if path.has(ordinal) = 0 then do; call row.add('observe',0); return row; end
      point = path.point(ordinal)
      if spend(current.count() + _regfunction[0] + _domains * 3 + 1) = 0 then return row
      storage = pointstorage(point,action.subject())
      source = 0; sourceStorage = 0
      if action.sourcekind() = 'reference' then do
        sourceStorage = pointstorage(point,action.sourceid())
      end
      kind = action.kind()
      if kind = 'capture' then do
        if action.sourcekind() = 'reference' then call row.add('read',accessdomain(instruction.function(),sourceStorage,action.domain()))
        iterate
      end
      if kind = 'callcapture' | kind = 'select' then iterate
      if kind = 'resize' then do
        /* The addressed parent is known, but released child trees still
         * require the shared ownership extent before a complete footprint. */
        call row.add('observe',0); return row
      end
      if kind = 'derive' then do; call row.add('read',0); iterate; end
      if wordpos(kind,'read observe transport write clear derive flagwrite context lifetime status') = 0 then iterate
      first = action.domain(); last = first; whole = first = 0
      if first > 0 then do; domain = profile.domain(first); whole = domain.kind() = 'whole'; end
      if whole then do; first = 1; last = _domains; end
      do d = first to last
        domain = profile.domain(d)
        if domain.kind() = 'whole' | (whole & domain.kind() = 'context') then iterate
        if kind = 'status' & domain.kind() <> 'flag' then iterate
        target = storage
        if domain.kind() = 'context' then do
          reg = findregister(instruction.function(),'context',0)
          if reg > 0 then target = _bases[reg]
        end
        id = accessdomain(instruction.function(),target,d)
        if kind = 'read' then call row.add('read',id)
        else if kind = 'observe' then call row.add('observe',id)
        else if kind = 'lifetime' then call row.add('observe',id)
        else if kind = 'status' then do; call row.add('read',id); call row.add('write',id); end
        else do
          if action.sourcekind() = 'reference' then call row.add('read',accessdomain(instruction.function(),sourceStorage,d))
          call row.add('write',id)
          /* Borrowed/global may aliases prohibit an exact external kill. */
          if action.certainty() = 'must' & applicable = 1 & target > 0 then do
            if ownedbase(target) then call row.add('kill',id)
          end
          if target > 0 then do
            if ownedbase(target) = 0 then do s = 1 to _storefunction[0]
              if ownedbase(s) = 0 then call row.add('write',accessdomain(instruction.function(),s,d))
            end
          end
        end
      end
    end
    return row
  scopeedgeaccess: method = .void
    arg expose row = .accessrow, incoming = .state, edge = .lltargetcfg..edge
    i = .int; j = .int; d = .int
    if edge.scopeexits() = 0 then return
    if edge.scopecomplete() = 0 | incoming.scopeknown() = 0 then do; call row.add('observe',0); return; end
    profile = dereference _transfers; domain = .lltargettransfer..domain; scope = .activation
    do i = 1 to incoming.depth()
      scope = incoming.scope(i); exits = 0
      do j = 1 to edge.scopeexits(); if scope.entry() = edge.scopeexit(j) then exits = 1; end
      if exits = 0 then iterate
      if scaledwork(scope.owned() + scope.actuals() + 1,max(1,_domains) * 2) = 0 then return
      do d = 1 to _domains
        domain = profile.domain(d)
        if domain.kind() <> 'component' & domain.kind() <> 'flag' then iterate
        do j = 1 to scope.owned(); call row.add('observe',accessdomain(edge.function(),scope.base(j),d)); end
        do j = 1 to scope.actuals(); call row.add('observe',accessdomain(edge.function(),scope.actual(j),d)); end
        if scope.result() > 0 then call row.add('observe',accessdomain(edge.function(),scope.result(),d))
      end
    end
    return
  buildprojection: method = .void
    call run()
    if valid() = 0 | _projected then return
    cfg = dereference _cfg; profile = dereference _transfers; index = dereference _index
    _projection = .llirgraph..access(_index,'rxas.target.flow.v1.' || _profileid,1000000,max(1,_bytelimit - _bytes),max(1,_worklimit - _work))
    row = .accessrow; empty = .int[]; before = .state; departing = .state; boundaryrow = .accessrow
    paths = .object[]; observations = .int[]; list = .int[]
    action = .lltargettransfer..action; j = .int; k = .int
    edge = .lltargetcfg..edge; continuation = .accessrow; abi = .abicallbackfact
    do i = 1 to _instructions[0]
      op = _instructions[i]; projected = cfg.projectedop(op)
      if projected = 0 | index.opcode(projected) <= 16 then iterate
      instruction = profile.instruction(op)
      f = instruction.function()
      /* An omitted description pins shared liveness. Missing observation or
       * implicit-selector precision is never represented by empty vectors. */
      scopeoperation = 0
      if _premise = 'canonical' then do
        item = instruction.record(); catalog = .llrxascatalog..catalog()
        if item.kind() = 'instruction' then scopeoperation = catalog.scopecontinuation(item.opcode()) > 0 | cfg.logicalreturn(op)
      end
      supportedcall = callprojectable(instruction)
      if scopeoperation = 0 & supportedcall = 0 then do
        if instruction.complete('effects') = 0 | instruction.complete('references') = 0 | instruction.complete('components') = 0 | instruction.complete('observations') = 0 | instruction.complete('bindings') = 0 then iterate
      end
      hascall = 0
      do j = 1 to instruction.actions(); action = instruction.action(j); if action.kind() = 'call' then hascall = 1; end
      if hascall & supportedcall = 0 then iterate
      if _beforepresent[op] then before = _before[op] as .state
      else iterate
      if cfg.outedges(op) = 0 then do
        row = projectpath(instruction,before,0)
        if _status <> 'ok' then leave
        if row.complete() = 0 then iterate
        call _projection.put(projected,row.reads(),row.observations(),row.writes(),row.kills())
      end
      else do
        complete = 1; call objectarraydrop paths
        do j = 1 to cfg.outedges(op)
          edge = cfg.outedge(op,j)
          exceptional = edge.phase() <> 'none' & edge.role() <> 'normal' & edge.role() <> 'table' & right(edge.exposure(),6) <> '-async'
          row = projectpath(instruction,before,exceptional,edge.phase(),edge.id())
          abi = abicallbackat(op,edge.id())
          if abi.possible() then call _projection.pincontinuation(projected)
          departing = before
          if _afterpresent[op] then do
            if edge.phase() = 'after' | edge.role() = 'normal' then departing = _after[op] as .state
          end
          continuation = .accessrow()
          call scopeedgeaccess(continuation,departing,edge)
          if continuation.complete() = 0 then call _projection.pincontinuation(projected)
          else do
            observations = continuation.observations()
            do k = 1 to observations[0]; call row.add('observe',observations[k]); end
          end
          if _status <> 'ok' then leave
          paths[j] = row as .object
          if row.complete() = 0 then complete = 0
        end
        if _status <> 'ok' then leave
        if complete = 0 then iterate
        call _projection.put(projected,empty,empty,empty,empty)
        boundaryrow = .accessrow(); hasboundary = 0
        do j = 1 to cfg.outedges(op)
          edge = cfg.outedge(op,j); row = paths[j] as .accessrow
          if edge.successorordinal() > 0 then call _projection.edgeput(projected,edge.successorordinal(),row.reads(),row.observations(),row.writes(),row.kills())
          else do
            /* Departure reads include copied values, live borrowed storage
             * and explicit lifetime observations. Boundary kills do not
             * claim to erase caller-owned state. */
            hasboundary = 1; list = row.reads(); observations = row.observations()
            do k = 1 to list[0]; call boundaryrow.add('observe',list[k]); end
            do k = 1 to observations[0]; call boundaryrow.add('observe',observations[k]); end
          end
        end
        if hasboundary then call _projection.boundaryput(projected,boundaryrow.observations())
      end
    end
    if _status <> 'ok' then call _projection.reject(_status,'target.flow.projection.' || _message)
    ignored = _projection.seal(); _projected = 1
    /* A stronger liveness capability cannot invalidate already frozen point
     * facts if its separate projection budget is unavailable. */
    if _status = 'limit' then do; _status = 'ok'; _message = ''; end
    return
  projection: method = reference .llirgraph..access
    call buildprojection()
    return reference _projection
  liveness: method = .llirgraph..live
    arg work = 1000000, bytes = 67108864
    call buildprojection()
    index = dereference _index
    return index.accessliveness(reference _projection,work,bytes)

analyse: procedure = .lltargetflow..analysis
  arg owner = reference .lltarget..module, transfers = reference .lltargettransfer..profile, cfg = reference .lltargetcfg..graph, work = 1000000, bytes = 67108864
  return .analysis(owner,transfers,cfg,work,bytes)
