            previous = _incoming[b] as .state
            if spend(joined.count() + previous.count() + joined.registers() + 1) = 0 then return
            if joined.same(previous) then iterate
          end
          if save(_incoming,_incomingpresent,b,joined) = 0 then return
          current = joined.copy(); projected = index.firstop(b)
