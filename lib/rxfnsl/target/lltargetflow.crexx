  incidentalentrycleanup: method = .int
    arg instruction = .lltargettransfer..instruction, action = .lltargettransfer..action, captured = .cell, original = .state
    profile_ref = reference .lltargettransfer..profile; profile_ref = _transfers
    profile = dereference profile_ref; catalog = .llrxascatalog..catalog()
    i = .int; d = .int; reg = .int; storage = .int; mask = .int; bit = .int; overlap = .int; found = 0
    resources = .int; componentmask = .int; other = .int; capacity = .int
    value = .lltarget..operand; domain = .lltargettransfer..domain; prior = .cell; item = .lltarget..record
    if _premise <> 'canonical' then return 0
    if action.detail() = 'catalog.callback.call-frame' then do
      /* The recycled child frame's old a0 payload belongs to an already
       * retired activation. Its eventual cleanup remains a raw possible
       * callback, but timing cannot alter this execution's value facts. */
      return profile.recyclercleanup(instruction.opid(),action.ordinal(),'callback')
    end
    if action.detail() = 'catalog.callback.capacity-or-checkpoint' then do
      /* A checked capacity hook may retire storage inherited from an older
       * activation. It is incidental only when every callback operand has
       * no current-execution resource reach, and each capacity-bearing owned
       * cell still carries its dirty-entry attribute origin. The raw hook
       * and any failure edge remain present in the catalogue/CFG. */
      item = instruction.record(); mask = catalog.callbackobligations(item.opcode())
      resources = catalog.callbackmask('input'); bit = catalog.callbackmask('output'); assembler ior resources,resources,bit
      bit = catalog.callbackmask('capacity'); assembler ior resources,resources,bit
      assembler iand overlap,mask,resources
      if mask = 0 | mask <> overlap then return 0
      componentmask = catalog.componentmask('reference'); other = catalog.componentmask('native-payload'); assembler ior componentmask,componentmask,other
      other = catalog.componentmask('attribute-count'); assembler ior componentmask,componentmask,other
      do i = 1 to item.operands()
