            if sourceid = 0 then iterate
            view = profile.ref(sourceid)
            if view.bank() = '' & view.kind() <> 'address' then iterate
            if view.kind() = 'address' | view.kind() = 'window' | view.extentknown() = 0 then return 'target.resource.backing.alias.selector.unproved'
            storage = backingmapped(pointstorage(point,sourceid),bindings)
