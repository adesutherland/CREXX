    source = dereference _owner; profile = dereference _transfers; cfg = dereference _cfg; catalog = .llrxascatalog..catalog()
    body = source.body(functionid); item = .lltarget..record; instruction = .lltargettransfer..instruction
    action = .lltargettransfer..action; location = .storagefact; i = .int; j = .int
