  /** Refine the same inductive theorem with frozen action/capture bindings.
   * All resource imports grow one owned-backing least fixed point. */
  frozenbackinghistory: method = .lltargetflow..backinghistoryfact
    arg functionid = .int, bank = .string, number = .int, rootreg = .int, cachekey = .int
    if spend(_storefunction[0] + 1) = 0 | scratch(_storefunction[0],16) = 0 then return .backinghistoryfact(reference self,functionid,bank,number,'limit',message())
    backings = .int[]; bindings = .int[]
    do i = 1 to _storefunction[0]; backings[i] = 0; bindings[i] = i; end
    if rootreg > 0 then backings[_bases[rootreg]] = 1
    reason = ''; changed = 1
    do while changed & reason = ''
      changed = 0
      reason = backingbody(functionid,bindings,0,backings,functionid as .string,changed)
    end
    state = 'proved'
    if reason <> '' then state = 'unknown'
    if _status = 'limit' then do; state = 'limit'; reason = message(); end
    result = .backinghistoryfact(reference self,functionid,bank,number,state,reason)
    if state <> 'limit' then do; _backinghistories[cachekey] = result; _backinghistorypresent[cachekey] = 1; _backinghistoryproved[cachekey] = state = 'proved'; _backinghistoryrefined[cachekey] = 1; end
    return result
  preparebackinghistories: method = .int
    if _prepareprivatehistory = 0 then return 1
