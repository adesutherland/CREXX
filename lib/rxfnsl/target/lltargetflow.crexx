/** Factory-time indexing uses exposed fields: Level B factories have no
 * source-level receiver on which to invoke an instance method. */
indexabirows: procedure = .void
  arg rows = .abirow[], expose status = .string, expose reason = .string, expose intrinsicstatus = .string, expose intrinsicreason = .string, expose indices = .int[]
  do i = 1 to rows[0]
    if rows[i].cause() <> 'ambient' then do
      indices[indices[0] + 1] = i
      if rows[i].possible() then do
        intrinsicstatus = 'unknown'
        if intrinsicreason = '' then intrinsicreason = rows[i].reason()
      end
    end
    if rows[i].possible() then do
      status = 'unknown'
      if reason = '' then reason = rows[i].reason()
    end
  end
  return

abicallbackfact: class
  _owner = reference .lltargetflow..analysis
  _identity = .int
  _status = .string
  _reason = .string
  _rows = .abirow[]
  _context = .invocationfact
  _contextual = .int
  _structuralreason = .string
  _intrinsicstructural = .string
  _ambientreason = .string
  _intrinsicstatus = .string
  _intrinsicreason = .string
  _intrinsicindices = .int[]
  *: factory
    arg owner = reference .analysis, status = .string, reason = .string, rows = .abirow[], ?invocation = .invocationfact
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _status = status; _reason = reason; _rows = rows; _contextual = ?invocation
    _structuralreason = reason; _intrinsicstructural = reason; _intrinsicstatus = status; _intrinsicreason = reason
    if ?invocation then _context = invocation
    call indexabirows(_rows,_status,_reason,_intrinsicstatus,_intrinsicreason,_intrinsicindices)
    return
  path: factory
    arg owner = reference .analysis, structuralreason = .string, rows = .abirow[], ?invocation = .invocationfact
    _owner = owner; parent = dereference owner; _identity = parent.identity(); _rows = rows
    _structuralreason = structuralreason; _intrinsicstructural = structuralreason; _reason = structuralreason
    _status = 'proved'; _intrinsicstatus = 'proved'; _intrinsicreason = structuralreason; _contextual = ?invocation
    if ?invocation then _context = invocation
    if structuralreason <> '' then do; _status = 'unknown'; _intrinsicstatus = 'unknown'; end
    call indexabirows(_rows,_status,_reason,_intrinsicstatus,_intrinsicreason,_intrinsicindices)
    return
  sealed: factory
    arg owner = reference .analysis, intrinsicreason = .string, ambientreason = .string, rows = .abirow[], ?invocation = .invocationfact
    _owner = owner; parent = dereference owner; _identity = parent.identity(); _rows = rows
    _intrinsicstructural = intrinsicreason; _ambientreason = ambientreason
    _structuralreason = intrinsicreason; if _structuralreason = '' then _structuralreason = ambientreason
    _reason = _structuralreason; _status = 'proved'; _intrinsicstatus = 'proved'; _intrinsicreason = intrinsicreason; _contextual = ?invocation
    if ?invocation then _context = invocation
    if _structuralreason <> '' then _status = 'unknown'
    if intrinsicreason <> '' then _intrinsicstatus = 'unknown'
    call indexabirows(_rows,_status,_reason,_intrinsicstatus,_intrinsicreason,_intrinsicindices)
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    parent = dereference _owner
    if parent.valid() = 0 | parent.identity() <> _identity then return 0
    if _contextual then return _context.valid()
    return 1
  status: method = .string
    if valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    if valid() = 0 then return 'target.abi.owner.stale'
    return _reason
  possible: method = .int
    if status() <> 'proved' then return 1
    do i = 1 to _rows[0]; if _rows[i].possible() then return 1; end
    return 0
  /** Analysis-private construction access; public consumers use possible(). */
  rawpossible: method = .int
    if _status <> 'proved' then return 1
    do i = 1 to _rows[0]; if _rows[i].possible() then return 1; end
    return 0
  bytes: method = .int
    return 224 + _rows[0] * 672
  rawrows: method = .int
    return _rows[0]
  structuralreason: method = .string
    return _structuralreason
  intrinsicstructuralreason: method = .string
    return _intrinsicstructural
  ambientreason: method = .string
    return _ambientreason
  intrinsicstatus: method = .string
    if valid() = 0 then return 'invalid'
    return _intrinsicstatus
  intrinsicreason: method = .string
    if valid() = 0 then return 'target.abi.owner.stale'
    return _intrinsicreason
  intrinsicpossible: method = .int
    return intrinsicstatus() <> 'proved'
  intrinsicrows: method = .int
    if intrinsicstatus() <> 'proved' then return 0
    return _intrinsicindices[0]
  intrinsicrow: method = .lltargetflow..abirow
    arg ordinal = .int
    if intrinsicstatus() <> 'proved' | ordinal < 1 | ordinal > _intrinsicindices[0] then assembler signal "ERROR","LL_TARGET_FLOW: intrinsic ABI row unavailable"
    return _rows[_intrinsicindices[ordinal]]
  rawrow: method = .lltargetflow..abirow
    arg ordinal = .int
    return _rows[ordinal]
  rows: method = .int
    if status() <> 'proved' then return 0
    return _rows[0]
  row: method = .lltargetflow..abirow
    arg ordinal = .int
    if status() <> 'proved' | ordinal < 1 | ordinal > _rows[0] then assembler signal "ERROR","LL_TARGET_FLOW: ABI row unavailable"
    return _rows[ordinal]

/** One transient execution path. Only the frozen replay publishes its rows. */
abicursor: class
  _source = .int
  _rows = .abirow[]
  _reason = .string
  _ambientreason = .string
  _cause = .string
  _exits = .int[]
  *: factory
    arg sourceop = .int
    _source = sourceop; _cause = 'intrinsic'
    return
  source: method = .int
    return _source
  rows: method = .abirow[]
    return _rows
  putrows: method = .void
    arg rows = .abirow[]
    _rows = rows
    return
  reject: method = .void
    arg reason = .string
    if _cause = 'ambient' then do; if _ambientreason = '' then _ambientreason = reason; end
    else if _reason = '' then _reason = reason
    return
  ambient: method = .void
    _cause = 'ambient'
    return
  cause: method = .string
    return _cause
  intrinsicreason: method = .string
    return _reason
  ambientreason: method = .string
    return _ambientreason
  reason: method = .string
    if _reason <> '' then return _reason
    return _ambientreason
  possible: method = .int
    if _reason <> '' | _ambientreason <> '' then return 1
    do i = 1 to _rows[0]; if _rows[i].possible() then return 1; end
    return 0
  exited: method = .void
    arg entry = .int
    _exits[_exits[0] + 1] = entry
    return
  exits: method = .int
    return _exits[0]
  bytes: method = .int
    return 96 + _rows[0] * 672 + _exits[0] * 8 + length(_reason) + length(_ambientreason) + length(_cause)
  exit: method = .int
    arg ordinal = .int
    return _exits[ordinal]
  fork: method = .abicursor
    result = .abicursor(_source); call result.putrows(_rows)
    call result.reject(_reason)
    if _cause = 'ambient' then do; call result.ambient(); call result.reject(_ambientreason); end
    do i = 1 to _exits[0]; call result.exited(_exits[i]); end
    return result

/** Analysis-private checkpoints for one immutable block/source replay.
 * Edges fork the cursor before adding their own ambient and departure rows. */
replaycache: class
  _sources = .int[]
  _exceptional = .int[]
  _phases = .string[]
  _states = .state[]
  _cursors = .abicursor[]
  _bytes = .int
  *: factory
    return
  rows: method = .int
    return _sources[0]
  lookup: method = .int
    arg sourceop = .int, exceptional = .int, phase = .string
    do i = 1 to _sources[0]
      if _sources[i] = sourceop & _exceptional[i] = exceptional & _phases[i] = phase then return i
    end
    return 0
  put: method = .void
    arg sourceop = .int, exceptional = .int, phase = .string, value = .state, cursor = .abicursor
    n = _sources[0] + 1
    _sources[n] = sourceop; _exceptional[n] = exceptional; _phases[n] = phase
    _states[n] = value.copy(); _cursors[n] = cursor.fork()
    _bytes = _bytes + 128 + length(phase) + value.bytes() + cursor.bytes()
    return
  at: method = .state
    arg ordinal = .int
    return _states[ordinal].copy()
  cursor: method = .abicursor
    arg ordinal = .int
    return _cursors[ordinal].fork()
  copywork: method = .int
    arg ordinal = .int
    value = _states[ordinal]; cursor = _cursors[ordinal]; rows = cursor.rows()
    return value.count() + value.registers() + rows[0] + cursor.exits() + 1
  copybytes: method = .int
    arg ordinal = .int
    value = _states[ordinal]; cursor = _cursors[ordinal]
    return value.bytes() + cursor.bytes()
  bytes: method = .int
    return _bytes

/** Shared point analysis. It interprets only operational transfer events,
 * never RXAS mnemonics. Sparse state rows and iteration are budgeted; an
 * incomplete profile remains usable for independently complete fact families.
 * @param owner Exact frozen target owner.
 * @param transfers Checked operational premises for that same owner.
 * @param cfg Its sole checked machine-CFG projection.
 * @param work Maximum elementary traversals and retained-state preparation.
 * @param bytes Maximum conservative retained logical bytes.
 */
analysis: class
  _owner = reference .lltarget..module
  _transfers = reference .lltargettransfer..profile
  _cfg = reference .lltargetcfg..graph
  _index = reference .llirgraph..index
  _revision = .int
  _identity = .int
  _profileid = .int
  _cfgid = .int
  _schema = .int
  _catalog = .string
  _premise = .string
  _status = .string
  _message = .string
  _work = .int
  _worklimit = .int
  _bytes = .int
  _bytelimit = .int
  _domains = .int
  _regfunction = .int[]
  _regbank = .string[]
  _regindex = .int[]
  _bases = .int[]
  _storefunction = .int[]
  _storebank = .string[]
  _storeindex = .int[]
  _capture = .object[]
  _capturepresent = .int[]
  _preparations = .statevector[]
  _before = .object[]
  _after = .object[]
  _edge = .object[]
  _incoming = .object[]
  _beforepresent = .int[]
  _afterpresent = .int[]
  _edgepresent = .int[]
  _incomingpresent = .int[]
  _edgehead = .int[]
  _edgenext = .int[]
  _outhead = .int[]
  _outnext = .int[]
  _witnessops = .int[]
  _callbackops = .int[]
  _instructions = .int[]
  _witnesses = .entryread[]
  _witnesskeys = .string[]
  _entrycomplete = .int[]
  _entrydemandcomplete = .int[]
  _entryreason = .string[]
  _entrydepends = .string[]
  _returnsites = .int[]
  _normalactions = .actionpath[]
  _normalactionpresent = .int[]
  _edgeactions = .actionpath[]
  _edgeactionpresent = .int[]
  _actionbuilding = .int
  _actionbuild = .actionpath
  _selectedvalues = .int[]
  _selectedoperations = .int[]
  _argumentpoints = .actionpoint[]
  _argumentcounts = .int[]
  _argumentpresent = .int[]
  _scopedfunctions = .int[]
  _resourceclean = .int[]
  _resourcereasons = .string[]
  _resourcereturnclean = .int[]
  _resourcedomains = .int[]
  _resourcearguments = .int[]
  _resourceactuals = .int[]
  _resourceincoming = .int[]
  _resourcefailureproved = .int[]
  _backinghistories = .backinghistoryfact[]
  _backinghistorypresent = .int[]
  _backinghistoryproved = .int[]
  _backinghistoryrefined = .int[]
  _prepareprivatehistory = .int
  _privateframeclean = .int[]
  _invocations = .invocationfact[]
  _invocationpresent = .int[]
  _abicached = .abicallbackfact[]
  _abisources = .int[]
  _abiedges = .int[]
  _abicontexts = .int[]
  _abibuckets = .int[]
  _abiinputstable = .int[]
  _abiinputready = .int[]
  _abiacyclicstate = .int[]
  _abicurrent = .abicursor
  _abifreezing = .int
  _abinormal = .abicallbackfact[]
  _abinormalpresent = .int[]
  _abiedgeplans = .abicallbackfact[]
  _abiedgepresent = .int[]
  _projection = .llirgraph..access
  _projected = .int
  *: factory
    arg owner = reference .lltarget..module, transfers = reference .lltargettransfer..profile, cfg = reference .lltargetcfg..graph, work = 1000000, bytes = 67108864
    _owner = owner; _transfers = transfers; _cfg = cfg; _identity = nextidentity()
    _worklimit = work; _bytelimit = bytes; _status = 'building'; _message = ''
    return
  /** Opt-in current-footprint refinement for a frozen final candidate. It
   * seeds only checked original-owned reference-record absence. Dirty scalar,
   * native payload and capacity/attribute entry states remain unknown. */
  relational: factory
    arg owner = reference .lltarget..module, transfers = reference .lltargettransfer..profile, cfg = reference .lltargetcfg..graph, work = 1000000, bytes = 67108864
    _owner = owner; _transfers = transfers; _cfg = cfg; _identity = nextidentity()
    _worklimit = work; _bytelimit = bytes; _status = 'building'; _message = ''; _prepareprivatehistory = 1
    return
  fail: method = .int
    arg status = .string, message = .string
    _status = status; _message = message
    return 0
  spend: method = .int
    arg amount = .int
    if amount < 0 | amount > _worklimit - _work then return fail('limit','target.flow.work')
    _work = _work + amount
    return 1
  reserve: method = .int
    arg amount = .int
    if amount < 0 | amount > _bytelimit - _bytes then return fail('limit','target.flow.bytes')
    _bytes = _bytes + amount
    return 1
  scratch: method = .int
    arg count = .int, width = .int
    if count < 0 | width < 1 then return fail('invalid','target.flow.scratch.dimensions')
    if count > (_bytelimit - _bytes) / width then return fail('limit','target.flow.scratch.bytes')
    return 1
  scaledwork: method = .int
    arg count = .int, width = .int
    if count < 0 | width < 1 then return fail('invalid','target.flow.work.dimensions')
    if count > (_worklimit - _work) / width then return fail('limit','target.flow.work')
    return spend(count * width)
  save: method = .int
    arg expose rows = .object[], expose present = .int[], id = .int, value = .state
    old = .state
    if id < 1 then return fail('invalid','target.flow.state.identity')
    if spend(value.count() + value.registers() + 1) = 0 then return 0
    if present[id] then do; old = rows[id] as .state; _bytes = _bytes - old.bytes(); end
    if reserve(value.bytes()) = 0 then return 0
    rows[id] = value.copy() as .object
    present[id] = 1
    return 1
  registerslot: method = .int
    arg functionid = .int, bank = .string, number = .int
    storage = .int; i = .int
    do i = 1 to _regfunction[0]
      if spend(1) = 0 then return 0
      if _regfunction[i] = functionid & _regbank[i] = bank & _regindex[i] = number then return i
    end
    if reserve(64) = 0 then return 0
    n = _regfunction[0] + 1
    _regfunction[n] = functionid; _regbank[n] = bank; _regindex[n] = number
    storage = 0
    if bank = 'g' then do i = 1 to _storefunction[0]
      if spend(1) = 0 then return 0
      if _storebank[i] = 'g' & _storeindex[i] = number then storage = i
    end
    if storage = 0 then do
      if reserve(48) = 0 then return 0
      storage = _storefunction[0] + 1; _storefunction[storage] = functionid
      _storebank[storage] = bank; _storeindex[storage] = number
    end
    _bases[n] = storage
    return n
  findregister: method = .int
    arg functionid = .int, bank = .string, number = .int
    do i = 1 to _regfunction[0]
      if _regfunction[i] = functionid & _regbank[i] = bank & _regindex[i] = number then return i
    end
    return 0
  capturedcell: method = .cell
    arg ids = .int[], cells = .object[], id = .int
    do i = 1 to ids[0]
      if ids[i] = id then return cells[i] as .cell
    end
    return .cell()
  offsetcell: method = .cell
    arg value = .cell, offset = .int
    if offset = 0 then return value
    literal = value.literal()
    if literal.kind() <> 'I' then return .cell()
    number = literal.index()
    if offset > 0 then do; if number > 9223372036854775807 - offset then return .cell(); end
    if offset < 0 then do; if number < -9223372036854775808 - offset then return .cell(); end
    return .cell('constant',0,0,'defined','present',.lltarget..operand.integer(number + offset))
  integercell: method = .cell
    arg current = .state, storage = .int
    profile = dereference _transfers; catalog = .llrxascatalog..catalog()
    do i = 1 to _domains
      domain = profile.domain(i)
      if domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('I') then return cellat(current,storage,i)
    end
    return .cell()
  addressindex: method = .lltarget..operand
    arg instruction = .lltargettransfer..instruction, view = .lltargettransfer..refview, current = .state, ids = .int[], cells = .object[]
    value = .cell; literal = .lltarget..operand()
    if view.selectorkind() = 'literal' then literal = view.selectorvalue()
    else if view.selectorkind() = 'captured' then do
      value = capturedcell(ids,cells,view.selectorid()); literal = value.literal()
    end
    else if view.selectorkind() = 'reference' then do
      storage = refstorage(instruction,view.selectorid(),current,ids,cells)
      value = integercell(current,storage); literal = value.literal()
    end
    if literal.kind() <> 'I' then return .lltarget..operand()
    number = literal.index(); offset = view.selectoroffset()
    if offset > 0 then do; if number > 9223372036854775807 - offset then return .lltarget..operand(); end
    if offset < 0 then do; if number < -9223372036854775808 - offset then return .lltarget..operand(); end
    number = number + offset
    if number < 0 then return .lltarget..operand()
    return .lltarget..operand.integer(number)
  addressoperand: method = .lltarget..operand
    arg instruction = .lltargettransfer..instruction, view = .lltargettransfer..refview, current = .state, ids = .int[], cells = .object[]
    literal = addressindex(instruction,view,current,ids,cells)
    if literal.kind() <> 'I' then return .lltarget..operand()
    number = literal.index()
    if view.addresskind() = 'localindex' then return windowvalue(instruction.function(),.lltarget..operand.bound(0,0,0,'r',0),number)
    if view.addresskind() = 'argument' then return .lltarget..operand.bound(0,0,0,'a',number)
    if view.addresskind() = 'capturedargument' & current.depth() > 0 then do
      target = dereference _owner; scope = current.scope(current.depth()); record = target.at(scope.entry()); recipe = record.recipe()
      if number = 0 then return record.reciperef(recipe.a0ref())
      do i = 1 to recipe.proxies()
        if recipe.proxyargument(i) = number then return record.reciperef(recipe.proxyref(i))
      end
    end
    /* Reference trees, attributes, foreign globals and parent frames stay
     * symbolic until the shared storage owner supplies their identity. */
    return .lltarget..operand()
  refreg: method = .int
    arg instruction = .lltargettransfer..instruction, referenceid = .int, ?current = .state, ?ids = .int[], ?cells = .object[]
    refview = .lltargettransfer..refview; emptyids = .int[]; emptycells = .object[]
    value = .lltarget..operand
    do i = 1 to instruction.references()
      refview = instruction.ref(i)
      if refview.id() <> referenceid then iterate
      if refview.kind() = 'address' then do
        if ?current = 0 then return 0
        if ?ids & ?cells then value = addressoperand(instruction,refview,current,ids,cells)
        else value = addressoperand(instruction,refview,current,emptyids,emptycells)
        if value.kind() <> 'R' then return 0
        return findregister(instruction.function(),value.bank(),value.index())
      end
      if refview.bank() = '' | refview.extentknown() = 0 | refview.extent() <> 1 then return 0
      return findregister(instruction.function(),refview.bank(),refview.index())
    end
    return 0
  refstorage: method = .int
    arg instruction = .lltargettransfer..instruction, referenceid = .int, current = .state, ?ids = .int[], ?cells = .object[]
    refview = .lltargettransfer..refview; literal = .lltarget..operand
    emptyids = .int[]; emptycells = .object[]
    do i = 1 to instruction.references()
      refview = instruction.ref(i)
      if refview.id() <> referenceid then iterate
      if ?ids & ?cells then reg = refreg(instruction,referenceid,current,ids,cells)
      else reg = refreg(instruction,referenceid,current)
      if refview.kind() = 'address' then do
        if reg > 0 then return current.mapping(reg)
        if refview.addresskind() = 'capturedargument' & current.depth() > 0 then do
          if ?ids & ?cells then literal = addressindex(instruction,refview,current,ids,cells)
          else literal = addressindex(instruction,refview,current,emptyids,emptycells)
          if literal.kind() <> 'I' then return 0
          scope = current.scope(current.depth()); number = literal.index()
          target = dereference _owner; record = target.at(scope.entry()); recipe = record.recipe()
          if number = 0 then return 0
          do j = 1 to recipe.proxies()
            if recipe.proxyargument(j) = number then return 0
          end
          if number > 0 & number <= scope.actuals() then return scope.actual(number)
        end
        return 0
      end
      if reg = 0 then return 0
      if refview.anchor() = 'base' then return current.base(reg)
      if refview.anchor() = 'entry' then return _bases[reg]
      if refview.anchor() <> 'active' then return 0
      return current.mapping(reg)
    end
    return 0
  entryvalue: method = .int
    arg storage = .int, domain = .int
    return (storage - 1) * _domains + domain
  ownedbase: method = .int
    arg storage = .int
    if storage < 1 | storage > _storebank[0] then return 0
    if _storebank[storage] = 'r' | _storebank[storage] = 'context' then return 1
    return _storebank[storage] = 'a' & _storeindex[storage] = 0
  cellat: method = .lltargetflow..cell
    arg current = .state, storage = .int, domain = .int
    return current.at(storage,domain,entryvalue(storage,domain))
  applies: method = .int
    arg action = .lltargettransfer..action, exceptional = .int, phase = 'unknown'
    if exceptional = 0 then return action.path() = 'normal' | action.path() = 'all'
    if action.path() <> 'failure' & action.path() <> 'all' then return 0
    if action.phase() = 'none' | action.phase() = phase then return 1
    /* The edge is before any write; an explicitly after-write event cannot
     * occur there. Other incomplete/partial phase relations are possible,
     * never definite. */
    if phase = 'before' & action.phase() = 'after' then return 0
    return 2
  writecell: method = .int
    arg expose current = .state, storage = .int, domain = .int, value = .cell, definite = .int
    old = .cell; possible = .cell; proof = .aliasproof
    tag = .int; origin = .int; basetag = .int; basesource = .int
    /* Indexed scalar lookups do not scan every retained state cell. Charge
     * the actual alias walk, bounded provenance merges and lookup growth. */
    if spend(3) = 0 then return 0
    /* Preserve availability under a possible alias without claiming that
     * distinct symbolic cells receive the same value. The call point later
     * resolves each ordered guard using captured physical storage identities. */
    if storage > 0 & ownedbase(storage) = 0 then do
      if spend(_storefunction[0]) = 0 then return 0
      do i = 1 to _storefunction[0]
      if i = storage | ownedbase(i) then iterate
      old = cellat(current,i,domain); possible = old.merged(value)
      if spend(old.origincount() + value.origincount() + current.putwork(i,domain) + 4) = 0 then return 0
      if old.hasalias() then proof = old.alias()
      else proof = .aliasproof(0,0,0)
      if old.hasalias() = 0 | proof.root() <> i then do
        basetag = 0; basesource = 0
        if old.availability() = 'defined' then basetag = 1
        else if old.entry() > 0 & old.entryknown() & wordpos(old.availability(),'entry mixed') > 0 then do; basetag = 2; basesource = old.entry(); end
        proof = .aliasproof(i,basetag,basesource)
      end
      tag = 0; origin = 0
      if value.availability() = 'defined' then tag = 1
      else if value.entry() > 0 & value.entryknown() & wordpos(value.availability(),'entry mixed') > 0 then do; tag = 2; origin = value.entry(); end
      if spend(proof.rows() + 1) = 0 | scratch(proof.bytes(),3) = 0 then return 0
      proof = proof.extended(storage,tag,origin,definite)
      call current.put(i,domain,possible.withalias(proof))
      end
    end
    if definite = 0 then do
      old = cellat(current,storage,domain); value = old.merged(value)
      if spend(old.origincount() + value.origincount() + 3) = 0 then return 0
    end
    if spend(current.putwork(storage,domain)) = 0 then return 0
    call current.put(storage,domain,value)
    return 1
  /** Resolve only formal entry storages; an absent or uncertain mapping is
   * not evidence that two pointers are distinct. */
  actualstorage: method = .int
    arg storage = .int, functionid = .int, actuals = .string, incoming = .state
    if actuals = '?' | left(actuals,1) = '~' then return 0
    if storage < 1 | storage > _storefunction[0] then return 0
    if _storefunction[storage] <> functionid | _storebank[storage] <> 'a' then return 0
    ordinal = _storeindex[storage]
    if ordinal < 1 | ordinal > words(actuals) then return 0
    reg = word(actuals,ordinal) as .int
    return incoming.mapping(reg)
  availabilityleaf: method = .cell
    arg kind = .int, source = .int, functionid = .int, actuals = .string, incoming = .state, domain = .int
    if kind = 1 then return .cell('defined',0,0,'defined','unknown')
    if kind <> 2 then return .cell()
    storage = actualstorage(source,functionid,actuals,incoming)
    if storage = 0 then return .cell()
    return cellat(incoming,storage,domain)
  instantiatealias: method = .cell
    arg value = .cell, functionid = .int, actuals = .string, incoming = .state, domain = .int
    proof = value.alias(); result = .cell; replacement = .cell
    if proof.limited() | left(actuals,1) = '~' then return .cell()
    if scaledwork(proof.rows() + 1,words(actuals) + _storefunction[0] + 1) = 0 then return .cell()
    root = actualstorage(proof.root(),functionid,actuals,incoming)
    if root = 0 then return .cell()
    result = availabilityleaf(proof.basekind(),proof.basesource(),functionid,actuals,incoming,domain)
    do i = 1 to proof.rows()
      writer = actualstorage(proof.writer(i),functionid,actuals,incoming)
      if writer = 0 then do
        /* Unknown alias loses value identity. Availability can still be
         * defined when both the untouched and written alternatives are. */
        replacement = availabilityleaf(proof.kind(i),proof.source(i),functionid,actuals,incoming,domain)
        result = result.merged(replacement)
        iterate
      end
      if writer <> root then iterate
      replacement = availabilityleaf(proof.kind(i),proof.source(i),functionid,actuals,incoming,domain)
      if proof.definite(i) then result = replacement
      else result = result.merged(replacement)
    end
    /* This summary proves only availability and dirty provenance, never a
     * literal or equality with a borrowed value after a possible write. */
    returned = .cell('returned',0,result.entry(),result.availability(),'unknown',.lltarget..operand(),result.entryknown())
    return returned.withorigins(result.origins())
  windowvalue: method = .lltarget..operand
    arg functionid = .int, first = .lltarget..operand, offset = .int
    target = dereference _owner; body = target.body(functionid); packed = first.index()
    if first.bank() = 'g' then packed = packed + body.locals()
    else if first.bank() = 'a' then packed = packed + body.locals() + target.globals()
    else if first.bank() <> 'r' then return .lltarget..operand()
    if offset < 0 | offset > 9223372036854775807 - packed then return .lltarget..operand()
    number = packed + offset; bank = 'r'
    if number >= body.locals() + target.globals() then do; bank = 'a'; number = number - body.locals() - target.globals(); end
    else if number >= body.locals() then do; bank = 'g'; number = number - body.locals(); end
    return .lltarget..operand.bound(0,0,0,bank,number)
  recipereg: method = .int
    arg item = .lltarget..record, ordinal = .int
    if ordinal < 1 then return 0
    value = item.reciperef(ordinal)
    return findregister(item.procedureid(),value.bank(),value.index())
  /** Preparation is visible even when staging subsequently fails. Commit is
   * separate: failed entry never acquires a scope or owned binding snapshot. */
  scopeprepare: method = .lltargetflow..state
    arg item = .lltarget..record, incoming = .state, publish = 0, limit = -1
    return scopepreparation(item,incoming,publish,limit,0)
  scopeprepareabi: method = .lltargetflow..state
    arg item = .lltarget..record, incoming = .state, publish = 0, limit = -1
    return scopepreparation(item,incoming,publish,limit,1)
  scopepreparation: method = .lltargetflow..state
    arg item = .lltarget..record, incoming = .state, publish = .int, limit = .int, recordabi = .int
    current = incoming.copy(); recipe = item.recipe(); profile = dereference _transfers
    points = .statevector()
    steps = recipe.preparations()
    if limit >= 0 then steps = min(steps,limit)
    reg = .int; storage = .int; other = .int
    domain = .lltargettransfer..domain; value = .cell
    do i = 1 to steps
      if publish then do
        if reserve(current.bytes()) = 0 | spend(current.count() + current.registers() + 1) = 0 then return current
        call points.put(i,current.copy())
      end
      if spend(_regfunction[0] * 2 + _domains + 1) = 0 then return current
      reg = recipereg(item,recipe.preparationref(i,1)); kind = recipe.preparationkind(i)
      if reg = 0 then do; call current.clobber(); call current.clobberbindings(); return current; end
      storage = current.mapping(reg)
      if recordabi & kind = 'clear' then do
        resource = abiresourcepoint(current,storage)
        if resource.live() = 0 | resource.nativeabsent() = 0 | resource.referenceabsent() = 0 | resource.activeempty() = 0 then call _abicurrent.reject('target.abi.preparation.resources.unproved')
      end
      if kind = 'swap' then do
        other = recipereg(item,recipe.preparationref(i,2))
        if other > 0 then call current.exchange(reg,other)
        else call current.clobberbindings()
      end
      else do d = 1 to _domains
        domain = profile.domain(d)
        if domain.kind() = 'whole' | domain.kind() = 'context' then iterate
        if kind = 'clear' then do
          value = .cell('absent',0,0,'defined','absent')
          if domain.kind() = 'component' & domain.nativebit() = 1 then value = .cell('constant',0,0,'defined','present',.lltarget..operand.integer(0))
          call current.put(storage,d,value)
        end
        else if kind = 'settp' & domain.kind() = 'flag' then call current.put(storage,d,.cell('write',item.id(),0,'defined','unknown'))
      end
    end
    if publish then _preparations[item.id()] = points
    return current
  /** Count capture uses the same prepared point facts for scope transfer and
   * access. A register token alone never supplies a finite window extent. */
  scopecapturecount: method = .cell
    arg item = .lltarget..record, current = .state
    recipe = item.recipe()
    if recipe.countkind() = 'literal' then return .cell('constant',0,0,'defined','present',.lltarget..operand.integer(recipe.countvalue()))
    if spend(_regfunction[0] + _domains + 1) = 0 then return .cell()
    reg = recipereg(item,recipe.countref())
    value = integercell(current,current.mapping(reg))
    if value.availability() <> 'defined' then return .cell()
    return value
  /** Observe the count at the executor's post-preparation, pre-capture point.
   * Keep raw dirty provenance: scopecapturecount deliberately erases it when
   * deciding whether a finite operational count is available. */
  scopecountobservation: method = .void
    arg instruction = .lltargettransfer..instruction, prepared = .state, exact = .int
    item = instruction.record(); recipe = item.recipe()
    if recipe.countkind() <> 'register' then return
    if exact = 0 | prepared.ready() = 0 | prepared.scopeknown() = 0 then do
      _entrydemandcomplete[instruction.function()] = 0
      _entryreason[instruction.function()] = 'target.flow.entry.scope.observation.checkpoint.unproved'
      return
    end
    profile = dereference _transfers; catalog = .llrxascatalog..catalog()
    action = .lltargettransfer..action; view = .lltargettransfer..refview; domain = .lltargettransfer..domain
    i = .int; found = 0; reg = .int; storage = .int; value = .cell
    do i = 1 to instruction.actions()
      if spend(instruction.references() + _regfunction[0] + _domains + 1) = 0 then return
      action = instruction.action(i)
      if action.kind() <> 'observe' then iterate
      if action.subject() = 0 | action.domain() = 0 then iterate
      view = profile.ref(action.subject()); domain = profile.domain(action.domain())
      if view.role() <> 'count-capture' | domain.kind() <> 'component' | domain.nativebit() <> catalog.componentmask('I') then iterate
      found = found + 1; reg = recipereg(item,recipe.countref()); storage = prepared.mapping(reg)
      value = integercell(prepared,storage)
      if witness(instruction,action,reg,storage,action.domain(),value) = 0 then return
    end
