     * existing call-point count proof and remain unknown in this entry theorem. */
    do i = 1 to _instructions[0]
      if spend(1) = 0 then return 0
      item = source.at(_instructions[i]); f = item.procedureid()
      if item.kind() <> 'instruction' then iterate
      if catalog.returnkind(item.opcode()) <> 2 then iterate
      value = item.operand(catalog.returnsource(item.opcode()))
      if value.kind() <> 'R' | value.bank() <> 'r' then _resourcereturnclean[f] = 0
    end
    do i = 1 to _instructions[0]
      if spend(1) = 0 then return 0
      item = source.at(_instructions[i]); f = item.procedureid()
      if item.kind() <> 'instruction' | profile.defaulthalt(f) = 0 then iterate
      if catalog.callinvokes(item.opcode()) = 0 | catalog.callkind(item.opcode()) <> 1 then iterate
      value = item.operand(catalog.calltarget(item.opcode()))
      if value.kind() <> 'P' then iterate
      child = source.procedureid(value.text()); if child < 2 then iterate
      projected = cfg.projectedop(item.id()); if projected = 0 then iterate
      if index.reachable(index.opblock(projected)) = 0 then iterate
      count = -1
      if catalog.callcount(item.opcode()) = 0 then count = words(translate(catalog.callactuals(item.opcode()),' ',','))
      if _resourceincoming[child] = 0 then _resourceactuals[child] = count
      else if count < 0 | _resourceactuals[child] < 0 then _resourceactuals[child] = -1
      else _resourceactuals[child] = min(_resourceactuals[child],count)
      _resourceincoming[child] = 1
    end
    do i = 1 to _instructions[0]
      if spend(1) = 0 then return 0
      item = source.at(_instructions[i]); f = item.procedureid()
      if _resourceclean[f] = 0 then iterate
      projected = cfg.projectedop(item.id()); if projected = 0 then iterate
      block = index.opblock(projected); if index.reachable(block) = 0 then iterate
      body = source.body(f); instruction = profile.instruction(item.id())
      reason = resourceinstruction(instruction,body.locals())
      if reason <> '' then do; _resourceclean[f] = 0; _resourcereasons[f] = reason; end
      if _status <> 'building' then return 0
    end
    do f = 2 to index.functions()
      if spend(1) = 0 then return 0
      if _resourceclean[f] & _resourcearguments[f] > 0 then do
        if _resourceincoming[f] = 0 | _resourceactuals[f] < _resourcearguments[f] then do
          _resourceclean[f] = 0; _resourcereasons[f] = 'target.resource.argument.presence.unproved'
        end
      end
    end
    do i = 1 to cfg.edges()
      if spend(1) = 0 then return 0
      edge = cfg.edge(i); f = edge.function()
      if f < 2 | f > _resourceclean[0] then iterate
      if _resourceclean[f] = 0 then iterate
      if index.reachable(edge.sourceblock()) = 0 then iterate
      if edge.complete() = 0 | edge.scopecomplete() = 0 | edge.role() = 'unknown' then do
        _resourceclean[f] = 0; _resourcereasons[f] = 'target.resource.edge.unproved'
      end
      else if edge.targetblock() > 0 & wordpos(edge.exposure(),'inherited inherited-async handler-call handler-call-async event-binding event-binding-async') > 0 then do
        _resourceclean[f] = 0; _resourcereasons[f] = 'target.resource.returning.handler.unproved'
      end
    end
    changed = 1
    do while changed
      changed = 0
      do i = 1 to _instructions[0]
        if spend(1) = 0 then return 0
        item = source.at(_instructions[i]); f = item.procedureid()
        if item.kind() <> 'instruction' then iterate
        if _resourceclean[f] = 0 | catalog.callinvokes(item.opcode()) = 0 then iterate
        instruction = profile.instruction(item.id())
        if resourcecallknown(instruction) = 0 then do
          _resourceclean[f] = 0; _resourcereasons[f] = 'target.resource.call.outward.unproved'; changed = 1
        end
      end
    end
    return 1
  resourceentry: method = .lltargetflow..state
    arg functionid = .int
    current = .state(_bases,_domains); i = .int; j = .int; d = .int
    profile = dereference _transfers; domain = .lltargettransfer..domain; catalog = .llrxascatalog..catalog()
    if _resourceclean[functionid] = 0 & _prepareprivatehistory = 0 then return current
    if spend(_storefunction[0] + _resourcedomains[0]) = 0 then return current
    do i = 1 to _storefunction[0]
      if _storefunction[i] <> functionid then iterate
      selected = _resourceclean[functionid] & _storebank[i] = 'r'
      if selected = 0 & _prepareprivatehistory then do
        reg = findregister(functionid,_storebank[i],_storeindex[i])
        if reg > 0 & reg <= _backinghistoryproved[0] then selected = _backinghistoryproved[reg]
      end
      if selected = 0 then iterate
      /* Retained capacity/native payload may invoke published finalizers.
       * The body footprint is not their entry absence theorem. */
      do j = 1 to _resourcedomains[0]
        d = _resourcedomains[j]; domain = profile.domain(d)
        if domain.nativebit() <> catalog.componentmask('reference') then iterate
        growth = current.putwork(i,d)
        if spend(growth + 1) = 0 | scratch(current.bytes() + growth * 8 + 160,1) = 0 then return current
        /* Resource absence does not define or reveal dirty scalar values. */
        call current.put(i,d,.cell('entry',entryvalue(i,d),i,'entry','absent'))
      end
    end
    return current
  /** Immutable resource projection of one borrowed solver state. */
  abiresourcepoint: method = .lltargetflow..abiresource
    arg current = .state, storage = .int
    referenceabsent = 0; nativeabsent = 0; activeempty = 0; capacityempty = 0
    i = .int; d = .int; value = .cell; literal = .lltarget..operand
    profile = dereference _transfers; catalog = .llrxascatalog..catalog()
    if spend(_resourcedomains[0] + 1) = 0 then return .abiresource(reference self,0,0,0,0,0,0,0)
    live = storage > 0 & current.lifetime(storage) = 'live' & current.generation(storage) > 0
    capacityempty = live & current.capacityclean(storage)
    do i = 1 to _resourcedomains[0]
      d = _resourcedomains[i]; domain = profile.domain(d); value = cellat(current,storage,d)
      if domain.nativebit() = catalog.componentmask('reference') then referenceabsent = value.presence() = 'absent'
      if domain.nativebit() = catalog.componentmask('native-payload') then nativeabsent = value.presence() = 'absent'
      if domain.nativebit() = catalog.componentmask('attribute-count') then do
        literal = value.literal(); activeempty = value.presence() = 'absent'
        if value.known() & literal.kind() = 'I' then activeempty = literal.index() = 0
      end
    end
    if capacityempty then do; referenceabsent = 1; nativeabsent = 1; activeempty = 1; end
    return .abiresource(reference self,storage,current.generation(storage),live,referenceabsent,nativeabsent,activeempty,capacityempty)
  abicallstate: method = .lltargetflow..state
    arg operation = .int
    if operation > 0 & operation <= _capturepresent[0] then do; if _capturepresent[operation] then return _capture[operation] as .state; end
    profile = dereference _transfers; instruction = profile.instruction(operation); item = instruction.record(); catalog = .llrxascatalog..catalog()
    if catalog.callcapture(item.opcode()) = 1 & catalog.callcount(item.opcode()) = 0 & catalog.callprefix(item.opcode()) = '' then do
      if operation > 0 & operation <= _beforepresent[0] then do; if _beforepresent[operation] then return _before[operation] as .state; end
    end
    return .state()
  abicallreason: method = .string
    arg operation = .int, target = .targetfact
    count = .int; ordinal = .int; binding = .storagefact; selectedowner = reference .lltarget..module
    profile = dereference _transfers; source = dereference _owner; catalog = .llrxascatalog..catalog(); item = source.at(operation)
    if catalog.callinvokes(item.opcode()) = 0 then return 'target.abi.invocation.not.call'
    instruction = profile.instruction(operation)
    if instruction.complete('references') = 0 | instruction.complete('bindings') = 0 | instruction.complete('order') = 0 then return 'target.abi.invocation.premise.unproved'
    if instruction.complete('calls') = 0 then do
