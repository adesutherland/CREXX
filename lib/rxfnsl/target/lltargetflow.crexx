        reg = findregister(instruction.function(),value.bank(),value.index()); storage = original.mapping(reg)
        if storage < 1 | storage > _storefunction[0] | ownedbase(storage) = 0 | _storebank[storage] <> 'r' then return 0
        if capacity then found = 1
