  backingbody: method = .string
    arg functionid = .int, bindings = .int[], resultstorage = .int, expose backings = .int[], stack = .string, expose changed = .int
    i = .int; j = .int; k = .int; p = .int; d = .int; reg = .int; storage = .int; sourceid = .int
    edgeid = .int; exceptional = .int; selectedsource = .int; selectedtarget = .int; sourcebinding = .int; targetbinding = .int
    resources = .int; bit = .int; overlap = .int; mask = .int; transport = .int
    action = .lltargettransfer..action; view = .lltargettransfer..refview; origin = .lltargettransfer..refview
    instruction = .lltargettransfer..instruction; item = .lltarget..record; edge = .lltargetcfg..edge
    path = .actionpath; point = .actionpoint; domain = .lltargettransfer..domain
    source = dereference _owner; profile = dereference _transfers; cfg = dereference _cfg; catalog = .llrxascatalog..catalog()
    body = source.body(functionid)
    resources = catalog.componentmask('reference'); bit = catalog.componentmask('native-payload'); assembler ior resources,resources,bit
    bit = catalog.componentmask('attribute-count'); assembler ior resources,resources,bit
    do i = 1 to body.records()
      if spend(1) = 0 then return message()
      item = body.record(i)
      if item.kind() = '.inlinedprivate' then return 'target.resource.backing.borrowed.suffix.unproved'
      if item.kind() <> 'instruction' then iterate
      instruction = profile.instruction(item.id())
      if instruction.complete('references') = 0 | instruction.complete('bindings') = 0 | instruction.complete('order') = 0 then return 'target.resource.backing.alias.inventory.unproved'
      if instruction.complete('relocation') = 0 then return 'target.resource.backing.frame.reach.unproved'
