/* cREXX License (MIT). One checked, split machine CFG over shared L IR. */
options levelb
namespace lltargetcfg expose graph edge
import rxfnsb
import llir
import llirgraph
import lltarget
import lltargettransfer
import llrxascatalog

bad: procedure = .void
  arg message = .string
  assembler signal "ERROR",message
  return
bits: procedure = .binary
  arg value = .int
  result = .binary; call binresize result,8; <at..i64>(0) result = value
  return result
contract: procedure = .llir..contract
  schema = .llir..schema(); family = schema.family('rxas.target.analysis',1)
  integer = family.type('source',.llir..intcodec() as .object)
  point = family.operation('point'); call point.attribute('source',integer)
  /* This operation is an analysis control marker, not execution of the source
   * instruction. Source effects live in the checked transfer profile and
   * missing departures are explicit incomplete typed boundary rows. */
  call point.state('none'); call point.failure('none'); call point.termination('returns')
  call point.control('terminal',0,65536)
  return schema.finish()

/** Edge rows are typed observations of actual projection successors or checked
 * boundary departures. Duplicate successor blocks retain distinct ordinals. */
edge: class
  _id = .int
  _source = .int
  _projected = .int
  _block = .int
  _function = .int
  _role = .string
  _ordinal = .int
  _target = .int
  _boundary = .string
  _boundaryid = .string
  _signal = .string
  _phase = .string
  _complete = .int
  _reason = .string
  _exposure = .string
  _targetop = .int
  _scopecomplete = .int
  _scopeexits = .string
  _scopeenters = .string
  _scopereason = .string
  *: factory
    arg id = .int, source = .int, projected = .int, block = .int, functionid = .int, role = .string, ordinal = .int, target = .int, boundary = .string, boundaryid = .string, signalname = .string, phase = .string, complete = .int, reason = .string, exposure = 'local', targetop = 0, scopecomplete = 0, scopeexits = '', scopeenters = '', scopereason = 'scope.transition.unavailable'
    _id = id; _source = source; _projected = projected; _block = block; _function = functionid
    _role = role; _ordinal = ordinal; _target = target; _boundary = boundary; _boundaryid = boundaryid
    _signal = signalname; _phase = phase; _complete = complete; _reason = reason
    _exposure = exposure; _targetop = targetop; _scopecomplete = scopecomplete
    _scopeexits = scopeexits; _scopeenters = scopeenters; _scopereason = scopereason
    return
  id: method = .int
    return _id
  sourceop: method = .int
    return _source
  projectedop: method = .int
    return _projected
  sourceblock: method = .int
    return _block
  function: method = .int
    return _function
  role: method = .string
    return _role
  successorordinal: method = .int
    return _ordinal
  targetblock: method = .int
    return _target
  boundarykind: method = .string
    return _boundary
  boundaryid: method = .string
    return _boundaryid
  signalname: method = .string
    return _signal
  phase: method = .string
    return _phase
  complete: method = .int
    return _complete
  unknownreason: method = .string
    return _reason
  /** The edge destination can be known while a foreign handler may modify
   * reachable storage before resumption. This is not an ordinary local edge. */
  exposure: method = .string
    return _exposure
  /** Destination source record, distinct from the projected block identity. */
  targetop: method = .int
    return _targetop
  /** Zero means the transition cannot be treated as an empty scope effect. */
  scopecomplete: method = .int
    return _scopecomplete
  scopeunknownreason: method = .string
    return _scopereason
  scopeexits: method = .int
    return words(_scopeexits)
  scopeexit: method = .int
    arg ordinal = .int
    if ordinal < 1 | ordinal > words(_scopeexits) then call bad('LL_TARGET_CFG: scope exit ordinal')
    return word(_scopeexits,ordinal) as .int
  scopeenters: method = .int
    return words(_scopeenters)
  scopeentry: method = .int
    arg ordinal = .int
    if ordinal < 1 | ordinal > words(_scopeenters) then call bad('LL_TARGET_CFG: scope entry ordinal')
    return word(_scopeenters,ordinal) as .int

graph: class
  _owner = reference .lltarget..module
  _profile = reference .lltargettransfer..profile
  _profileid = .int
  _revision = .int
  _ir = .llir..module
  _edges = .llirgraph..edgeprofile
  _index = .llirgraph..index
  _status = .string
  _message = .string
  _work = .int
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  _source = .int[]
  _projected = .int[]
  _block = .int[]
  _next = .int[]
  _group = .int[]
  _normal = .int[]
  _exceptional = .int[]
  _async = .int[]
  _local = .int[]
  _policyexact = .int[]
  _scopeexit = .int[]
  _scopeowner = .int[]
  _scopeparent = .int[]
  _scopecontinuation = .int[]
  _policyops = .int[]
  _policyfunction = .int[]
  _policynames = .string[]
  _from = .int[]
  _stagefirst = .int[]
  _stagelast = .int[]
  _stagenext = .int[]
  _outfirst = .int[]
  _outlast = .int[]
  _outnext = .int[]
  _outcount = .int[]
  _to = .int[]
  _roles = .string[]
  _phases = .string[]
  _bounds = .string[]
  _boundids = .string[]
  _signals = .string[]
  _known = .int[]
  _reasons = .string[]
  _exposures = .string[]
  _rows = .lltargetcfg..edge[]
  *: factory
    arg owner = reference .lltarget..module, profile = reference .lltargettransfer..profile, work = 1000000, bytes = 67108864
    _owner = owner; _profile = profile; _worklimit = work; _bytelimit = bytes; _status = 'building'
    return
  reserve: method = .int
    arg bytes = .int, work = .int
    if _status <> 'building' then return 0
    if bytes < 0 | work < 0 | bytes > _bytelimit - _bytes | work > _worklimit - _work then do
      call reject('limit','LL_RESOURCE_LIMIT: target.cfg work/bytes'); return 0
    end
    _bytes = _bytes + bytes; _work = _work + work
    return 1
  reject: method = .void
    arg state = .string, message = .string
    if _status = 'building' then do; _status = state; _message = message; end
    return
  stage: method = .void
    arg source = .int, target = .int, role = .string, phase = 'none', boundary = '', boundaryid = '', signalname = '', complete = 1, reason = '', exposure = 'local'
    if wordpos(role,'normal table skip handler resumed async unwind terminal unknown') = 0 | wordpos(phase,'none before partial after unknown') = 0 | (target = 0 & boundary = '') | (target > 0 & boundary <> '') | (complete = 0 & reason = '') then do
      call reject('invalid','LL_TARGET_CFG: edge shape'); return
    end
    if reserve(160 + length(boundaryid) + length(signalname) + length(reason),1) = 0 then return
    id = _from[0] + 1; _from[id] = source; _to[id] = target; _roles[id] = role; _phases[id] = phase
    _bounds[id] = boundary; _boundids[id] = boundaryid; _signals[id] = signalname; _known[id] = complete; _reasons[id] = reason
    _exposures[id] = exposure
    _stagenext[id] = 0
    if _stagelast[source] > 0 then _stagenext[_stagelast[source]] = id
    else _stagefirst[source] = id
    _stagelast[source] = id
    return
  indexrow: method = .void
    arg source = .int, row = .int
    key = source + 1; _outnext[row] = 0
    if _outlast[key] > 0 then _outnext[_outlast[key]] = row
    else _outfirst[key] = row
    _outlast[key] = row; _outcount[key] = _outcount[key] + 1
    return
  resolveblock: method = .int
    arg oldblock = .int
    target = dereference _owner; source_ref = target.ir(); source = dereference source_ref; store_ref = source.storage(); store = dereference store_ref
    do steps = 1 to source.blocks() + 1
      if reserve(0,1) = 0 then return 0
      if oldblock < 1 | oldblock > _group[0] then return 0
      if _group[oldblock] > 0 then return _group[oldblock]
      last = store.get(2,oldblock,3); op = source.operation(last)
      if op.successors() <> 1 then return 0
      oldblock = op.successor(1)
    end
    return 0
  /** All authored policies are possible until a path-sensitive policy meet
   * proves otherwise. This procedure-local union is a conservative control
   * interpretation, never an assertion that a policy is active at this point.
   * Inherited handlers remain separate foreign resume/departure alternatives. */
  policyname: method = .string
    arg item = .lltarget..record
    catalog = .llrxascatalog..catalog(); code = item.opcode()
    if catalog.policysource(code) = 1 then return catalog.policyname(code)
    if catalog.policysource(code) = 2 then do
      index = catalog.policysourceoperand(code) + 1
      if index > 0 & index <= item.operands() then do
        value = item.operand(index)
        if value.kind() = 'S' then return upper(value.text())
      end
    end
    return '*'
  raisednames: method = .string
    arg item = .lltarget..record
    catalog = .llrxascatalog..catalog(); code = item.opcode()
    if catalog.signalsource(code) = 1 then return catalog.signalnames(code)
    if catalog.signalsource(code) = 2 then do
      index = catalog.signalsourceoperand(code) + 1
      if index > 0 & index <= item.operands() then do
        value = item.operand(index)
        if value.kind() = 'S' then do
          /* Operand-selected raises can also fail their own validation. The
           * canonical static alternatives augment the requested name. */
          names = upper(value.text()); alternatives = translate(catalog.signalnames(code),' ','|')
          do ordinal = 1 to words(alternatives)
            name = word(alternatives,ordinal)
            if wordpos(name,translate(names,' ','|')) = 0 then names = names || '|' || name
          end
          return names
        end
      end
    end
    return '*'
  /** Committed receiver of a policy response. An asynchronous safe point is
   * after the instruction: entry has committed and a logical RET has already
   * left its innermost owner. Synchronous failure never commits a new entry. */
  activeowner: method = .int
    arg source = .int, asynchronous = .int
    owner = _scopeowner[source]
    if asynchronous then do
      if _scopecontinuation[source] > 0 then owner = source
      else if _scopeexit[source] > 0 then owner = _scopeowner[_scopeexit[source]]
    end
    return owner
  /** Policy table changes are private to their logical owner. Its inherited
   * table is restored on departure; inner installations cannot affect prior
   * entry or a later outer source point. Timing within one owner is still a
   * conservative union and is not an assertion of an active installation. */
  policyvisible: method = .int
    arg installation = .int, source = .int, asynchronous = .int
    installedowner = _scopeowner[installation]
    if installedowner = 0 then return 1
    owner = activeowner(source,asynchronous)
    do while owner > 0
      if reserve(0,1) = 0 then return 0
      if owner = installedowner then return 1
      owner = _scopeparent[owner]
    end
    return 0
  signalpaths: method = .void
    arg item = .lltarget..record, phase = .string, names = .string, asynchronous = 0
    exposure = .string; localexposure = .string
    target = dereference _owner; catalog = .llrxascatalog..catalog()
    id = item.id(); f = item.procedureid()
    /* Inherited CALL/action handlers can resume after the signal point. An
     * unknown outward destination does not remove that local successor. */
    profile = dereference _profile
    if profile.defaulthalt(f) then do
      /* An exact root or checked call-closure member has an explicit inherited
       * HALT contract. Authored policy alternatives below remain possible. */
      exposure = 'inherited'; boundaryid = id || '.sync.' || phase
      if asynchronous then do; exposure = 'inherited-async'; boundaryid = id || '.async.' || phase; end
      /* Boundary annotations have no successor ordinal. Keep synchronous and
       * asynchronous alternatives distinct even when role/name/phase match. */
      call stage(id,0,'terminal',phase,'closed-main-default-halt',boundaryid,names,1,'',exposure)
    end
    else do
      call resumepaths(id,'resumed',phase,names,'inherited',asynchronous)
      role = 'unwind'; boundary = 'inherited-signal-policy'; reason = 'signal.inherited.destination.unknown'
      if asynchronous then do; role = 'async'; boundary = 'asynchronous-policy'; reason = 'asynchronous.policy.unknown'; end
      call stage(id,0,role,phase,boundary,id as .string,names,0,reason,'inherited')
    end
    localexposure = 'local'
    if asynchronous then localexposure = 'local-async'
    do p = 1 to _policyops[0]
      if reserve(0,1) = 0 then return
      if _policyfunction[p] <> f then iterate
      if policyvisible(_policyops[p],id,asynchronous) = 0 then iterate
      tag = _policynames[p]
      if tag <> '*' & names <> '*' & wordpos(tag,translate(names,' ','|')) = 0 then iterate
      installed = target.at(_policyops[p]); effect = catalog.policyeffect(installed.opcode())
      policyid = installed.id() || '.sync.' || phase
      if asynchronous then policyid = installed.id() || '.async.' || phase
      if effect = 4 then do
        call resumepaths(id,'skip',phase,tag,'local',asynchronous)
      end
      else if effect = 5 | effect = 6 then call stage(id,0,'terminal',phase,'policy-halt',policyid,tag,1,'',localexposure)
      else if effect = 10 then do
        if _scopecontinuation[id] > 0 & asynchronous = 0 then do
          /* A failed/partial entry carries no newly committed logical scope.
           * Keep the response explicit until incoming stack state proves the
           * surviving owner, instead of treating it as a successful entry. */
          call stage(id,0,'unknown',phase,'policy-return-entry',policyid,tag,0,'scope.entry.return.owner.unproved',localexposure)
          _exceptional[f] = 0; _local[f] = 0
        end
        else do
          owner = activeowner(id,asynchronous)
          if owner > 0 then call stage(id,_scopecontinuation[owner],'unwind',phase,'','',tag,1,'',localexposure)
          else call stage(id,0,'unwind',phase,'policy-return',policyid,tag,1,'',localexposure)
        end
      end
      else if effect = 7 | effect = 9 | effect = 14 then do
        dest = 0
        do operand = 1 to installed.operands()
          value = installed.operand(operand)
          if value.kind() = 'L' then do
            dest = resolveblock(target.labelblock(f,value.text())); leave
          end
        end
        if dest > 0 then do
          exposure = 'local'
          if effect = 9 then exposure = 'handler-call'
          if effect = 14 then exposure = 'event-binding'
          if asynchronous then exposure = exposure || '-async'
          call stage(id,dest,'handler',phase,'','',tag,1,'',exposure)
        end
        else do
          call stage(id,0,'unknown',phase,'local-policy',policyid,tag,0,'signal.local.target.unknown',localexposure)
          _local[f] = 0
        end
      end
      else if effect = 1 | effect = 2 | effect = 8 | effect = 11 then do
        call resumepaths(id,'resumed',phase,tag,'handler-call',asynchronous)
        if effect = 11 then call stage(id,0,'terminal',phase,'policy-action-fail',policyid,tag,1,'',localexposure)
      end
    end
    return
  resumepaths: method = .void
    arg id = .int, role = .string, phase = .string, name = .string, exposure = .string, asynchronous = .int
    if asynchronous then do
      exposure = exposure || '-async'
      /* An interrupt after a branch resumes its selected successor, not the
       * lexical next instruction. Preserve every normal successor alternative. */
      row = _stagefirst[id]; stop = _stagelast[id]
      do while row > 0
        if reserve(0,1) = 0 then return
        following = _stagenext[row]
        if _roles[row] = 'normal' & _to[row] > 0 then call stage(id,_to[row],role,phase,'','',name,1,'',exposure)
        if row = stop then leave
        row = following
      end
    end
    else do
      successor = _next[id]
      if _scopeexit[id] > 0 then successor = _scopeexit[id]
      if successor > 0 then call stage(id,successor,role,phase,'','',name,1,'',exposure)
    end
    return
  /** Compute the committed logical stack transition, separately from signal
   * destination completeness. A known target never proves successful entry
   * on a before/partial failure, nor an unknown inherited policy departure. */
  scopetransition: method = .lltargetcfg..edge
    arg row = .int, projected = .int, ordinal = .int, destblock = .int
    depth = .int
    target = dereference _owner; catalog = .llrxascatalog..catalog()
    id = _from[row]; destination = _to[row]; item = target.at(id)
    complete = _known[row]; reason = ''; exits = ''; enters = ''
    fromstack = ''; cursor = _scopeowner[id]
    do while cursor > 0
      if reserve(0,1) = 0 then leave
      fromstack = cursor || ' ' || fromstack; cursor = _scopeparent[cursor]
    end
    if item.kind() = 'instruction' & _phases[row] = 'after' & right(_exposures[row],6) = '-async' then do
      if catalog.scopecontinuation(item.opcode()) > 0 then fromstack = fromstack || ' ' || id
    end
    tostack = ''; cursor = 0
    if destination > 0 then cursor = _scopeowner[destination]
    do while cursor > 0
      if reserve(0,1) = 0 then leave
      tostack = cursor || ' ' || tostack; cursor = _scopeparent[cursor]
    end
    if complete = 0 then reason = _reasons[row]
    else if destination = 0 & wordpos(_roles[row],'terminal unwind') = 0 then do
      complete = 0; reason = 'scope.departure.destination.unproved'
    end
    else do
      common = 0
      do depth = 1 to min(words(fromstack),words(tostack))
        if reserve(0,1) = 0 then leave
        if word(fromstack,depth) <> word(tostack,depth) then leave
        common = depth
      end
      do depth = words(fromstack) to common + 1 by -1
        exits = exits || ' ' || word(fromstack,depth)
      end
      do depth = common + 1 to words(tostack)
        enters = enters || ' ' || word(tostack,depth)
      end
      if words(enters) > 0 then do
        if words(enters) <> 1 | word(enters,1) <> (id as .string) | catalog.scopecontinuation(item.opcode()) = 0 then do
          complete = 0; reason = 'scope.entry.control.unproved'
        end
        else if _roles[row] <> 'normal' & _phases[row] <> 'after' then do
          complete = 0; reason = 'scope.entry.commit.unproved'
        end
      end
      if _scopeexit[id] > 0 & words(exits) > 0 & _roles[row] <> 'normal' & _phases[row] <> 'after' then do
        complete = 0; reason = 'scope.return.commit.unproved'
      end
    end
    if complete = 0 then do; exits = ''; enters = ''; end
    return .lltargetcfg..edge(row,id,projected,_block[id],item.procedureid(),_roles[row],ordinal,destblock,_bounds[row],_boundids[row],_signals[row],_phases[row],_known[row],_reasons[row],_exposures[row],destination,complete,strip(exits),strip(enters),reason)
  run: method = .void
    if _status <> 'building' then return
    i = .int; j = .int; n = .int; id = .int; f = .int; row = .int; ordinal = .int; dest = .int; code = .int
    phase = .string; signalname = .string; role = .string; reason = .string; known = .int
    body = .lltarget..body; item = .lltarget..record; field = .lltarget..operand
    action = .lltargettransfer..action; ref = .lltargettransfer..refview
    fn = .llir..function; point = .llir..opdraft; result = .llir..opview
    blocks = .llir..block[]; functions = .llir..function[]; first = .int[]; last = .int[]
    if _worklimit < 1 | _bytelimit < 1 then do; call reject('limit','LL_RESOURCE_LIMIT: target.cfg budgets'); return; end
    if <refvalid>(_owner) = 0 | <refvalid>(_profile) = 0 then do; call reject('invalid','LL_TARGET_OWNER: expired CFG input'); return; end
    target = dereference _owner; profile = dereference _profile
    if target.valid() = 0 | profile.matches(_owner) = 0 then do; call reject('invalid','LL_TARGET_OWNER: CFG profile mismatch'); return; end
    _revision = target.identity(); _profileid = profile.identity(); source_ref = target.ir(); source = dereference source_ref; store_ref = source.storage(); store = dereference store_ref
    if source.operations() > (_bytelimit - _bytes) <idiv> 512 then do; call reject('limit','LL_RESOURCE_LIMIT: target.cfg projection'); return; end
    if reserve(source.operations() * 512 + source.blocks() * 16 + source.functions() * 32,source.operations() + source.blocks() + source.functions()) = 0 then return
    do i = 1 to source.operations()
      _projected[i] = 0; _block[i] = 0; _next[i] = 0; _scopeexit[i] = 0; _scopeowner[i] = 0; _scopeparent[i] = 0; _scopecontinuation[i] = 0; _stagefirst[i] = 0; _stagelast[i] = 0
    end
    do i = 1 to source.operations() + 1; _outfirst[i] = 0; _outlast[i] = 0; _outcount[i] = 0; end
    do i = 1 to source.blocks(); _group[i] = 0; end
    schema = contract(); builder = .llir..builder(schema,_worklimit,_bytelimit)
    origin = builder.synthetic('checked target analysis projection')
    fn = builder.function('$target.catalogue',schema.voidtype()); sentinel = fn.block('catalogue'); call sentinel.returnvoid(origin)
    do n = 1 to target.procedures()
      body = target.procedure(n); f = body.functionid(); fn = builder.function(body.name(),schema.voidtype()); functions[f] = fn
      _normal[f] = target.normalcfgcomplete(f); _exceptional[f] = 1; _async[f] = 1; _local[f] = _normal[f]; _policyexact[f] = 1; first[f] = 0; last[f] = 0
      do j = 1 to body.records()
        if reserve(0,1) = 0 then return
        item = body.record(j)
        if item.kind() = 'procedure' then iterate
        id = item.id(); blocks[id] = fn.block('point.' || id); _block[id] = blocks[id].id()
        if first[f] = 0 then first[f] = id
        if last[f] > 0 then _next[last[f]] = id
        last[f] = id
        if _group[item.blockid()] = 0 then _group[item.blockid()] = id
      end
      if first[f] = 0 then do
        sentinel = fn.block('empty'); call sentinel.returnvoid(origin)
        _normal[f] = 0; _exceptional[f] = 0; _async[f] = 0; _local[f] = 0
      end
    end
    catalog = .llrxascatalog..catalog()
    do n = 1 to target.procedures()
      body = target.procedure(n); f = body.functionid(); depth = 0; scope = .string[]; scopeowner = .int[]
      do j = 1 to body.records()
        if reserve(0,1) = 0 then return
        item = body.record(j); id = item.id()
        if item.kind() = 'label' & depth > 0 then do
          field = item.operand(1)
          if field.text() = scope[depth] then depth = depth - 1
        end
        if depth > 0 then _scopeowner[id] = scopeowner[depth]
        if item.kind() <> 'instruction' then iterate
        code = item.opcode()
        if catalog.returnkind(code) > 0 & depth > 0 then do
          _scopeexit[id] = resolveblock(target.labelblock(f,scope[depth]))
          if _scopeexit[id] = 0 then do; call reject('invalid','LL_TARGET_CFG: unresolved inline continuation'); return; end
        end
        continuation = catalog.scopecontinuation(code)
        if continuation > 0 then do
          if continuation > item.operands() then do; call reject('invalid','LL_TARGET_CFG: missing inline continuation'); return; end
          field = item.operand(continuation)
          if field.kind() <> 'L' then do; call reject('invalid','LL_TARGET_CFG: inline continuation is not label'); return; end
          _scopeparent[id] = _scopeowner[id]
          _scopecontinuation[id] = resolveblock(target.labelblock(f,field.text()))
          if _scopecontinuation[id] = 0 then do; call reject('invalid','LL_TARGET_CFG: unresolved inline continuation'); return; end
          depth = depth + 1; scope[depth] = field.text(); scopeowner[depth] = id
        end
        if catalog.policyeffect(code) <> 0 then do
          if profile.premise() = 'canonical' then _policyexact[f] = 0
          name = policyname(item)
          if reserve(32 + length(name),1) = 0 then return
          p = _policyops[0] + 1; _policyops[p] = id; _policyfunction[p] = f; _policynames[p] = name
          if catalog.policyeffect(code) = 15 then _local[f] = 0
        end
      end
      if depth <> 0 then do; call reject('invalid','LL_TARGET_CFG: unclosed inline continuation scope'); return; end
    end
    do n = 1 to target.records()
      if reserve(0,1) = 0 then return
      item = target.record(n); id = item.id(); f = item.procedureid()
      if f < 2 | item.kind() = 'procedure' then iterate
      if item.kind() <> 'instruction' then do
        if _next[id] > 0 then call stage(id,_next[id],'normal')
        else call stage(id,0,'terminal','none','end',f as .string)
        iterate
      end
      op = source.operation(id); code = item.opcode(); arity = lltarget..normalsuccessors(code)
      if catalog.scopecontinuation(code) > 0 then do
        /* Native FLOW_COND retains the continuation label for the assembler;
         * execution enters the clone body. Only a scoped RET reaches after. */
        if _next[id] = 0 then do; call reject('invalid','LL_TARGET_CFG: inline entry lacks body'); return; end
        call stage(id,_next[id],'normal')
      end
      else if _scopeexit[id] > 0 then call stage(id,_scopeexit[id],'normal')
      else if arity = -2 then do
        call stage(id,0,'unknown','unknown','normal-target',id as .string,'',0,'normal.successor.unknown'); _normal[f] = 0
      end
      else if op.successors() > 0 then do
        do ordinal = 1 to op.successors()
          dest = resolveblock(op.successor(ordinal))
          if dest = 0 then do
            call stage(id,0,'unknown','none','normal-target',id || '.' || ordinal,'',0,'normal.target.unavailable'); _normal[f] = 0
          end
          else call stage(id,dest,'normal')
        end
      end
      else if arity = -1 | lltarget..normalfallthrough(code) then do
        if _next[id] > 0 then call stage(id,_next[id],'normal')
        else do
          call stage(id,0,'unknown','none','falloff',id as .string,'',0,'normal.falloff.unknown'); _normal[f] = 0
        end
      end
      else call stage(id,0,'terminal','none','departure',id as .string)
      if profile.premise() = 'canonical' then do
        if catalog.signalstate(code) <> 0 then do
          phase = word('none before after partial unknown',catalog.signalphase(code) + 1)
          call signalpaths(item,phase,raisednames(item))
          if profile.defaulthalt(f) = 0 then _exceptional[f] = 0
        end
        if catalog.flow(code) <> 3 | _scopeexit[id] > 0 then call signalpaths(item,'after','*',1)
        if profile.defaulthalt(f) = 0 then _async[f] = 0
      end
      else do
        view = profile.instruction(id)
        if view.complete('signals') = 0 then do
          call stage(id,0,'unknown','unknown','signal-contract',id as .string,'',0,view.unknownreason('signals')); _exceptional[f] = 0
          _local[f] = 0
        end
        do a = 1 to view.actions()
          if reserve(0,1) = 0 then return
          action = view.action(a)
          if action.kind() <> 'edge' & action.kind() <> 'raise' then iterate
          role = action.detail(); phase = action.phase(); signalname = ''; field = action.literal()
          if action.sourcekind() = 'literal' & field.kind() = 'S' then signalname = field.text()
          if wordpos(role,'normal table skip handler resumed async unwind terminal unknown') = 0 then role = 'unknown'
          dest = 0
          if action.subject() > 0 then do
            ref = profile.ref(action.subject()); field = ref.operand()
            if ref.kind() <> 'label' then do; call reject('invalid','LL_TARGET_CFG: edge subject is not label'); return; end
            dest = resolveblock(target.labelblock(f,field.text()))
            if dest = 0 then do; call reject('invalid','LL_TARGET_CFG: unresolved operational edge'); return; end
          end
          if dest > 0 then call stage(id,dest,role,phase,'','',signalname)
          else do
            known = action.certainty() <> 'unknown' & role <> 'unknown'; reason = ''
            if known = 0 then reason = 'operational.edge.destination.unknown'
            call stage(id,0,role,phase,'operational-' || role,action.id() as .string,signalname,known,reason)
            if known = 0 then do; _exceptional[f] = 0; _local[f] = 0; end
          end
        end
      end
    end
    /* Lexical scopes have a checked single entry and RET-only departure.
     * Follow metadata to its next instruction before comparing owners, so a
     * directive cannot hide a branch into or fallthrough out of a scope. */
    do n = 1 to _from[0]
      if reserve(0,1) = 0 then return
      if _roles[n] <> 'normal' | _to[n] = 0 then iterate
      id = _from[n]; dest = _to[n]; item = target.at(id)
      if item.kind() <> 'instruction' then iterate
      do steps = 1 to target.records() + 1
        following = target.at(dest)
        if following.kind() = 'instruction' | _next[dest] = 0 then leave
        dest = _next[dest]
        if reserve(0,1) = 0 then return
      end
      if _scopeowner[id] = _scopeowner[dest] | _scopeexit[id] = _to[n] then iterate
      if catalog.scopecontinuation(item.opcode()) > 0 & _scopeowner[dest] = id then iterate
      call reject('invalid','LL_TARGET_CFG: control crosses logical activation boundary'); return
    end
    do n = 1 to target.records()
      item = target.record(n); id = item.id(); f = item.procedureid()
      if f < 2 | item.kind() = 'procedure' then iterate
      point = blocks[id].operation(schema.operation('rxas.target.analysis.point'),origin)
      call point.attribute('source',bits(id))
      row = _stagefirst[id]
      do while row > 0
        if reserve(0,1) = 0 then return
        if _to[row] > 0 then call point.successor(blocks[_to[row]])
        row = _stagenext[row]
      end
      result = point.finish(); _projected[id] = result.id(); _source[result.id()] = id
    end
    if builder.error() <> '' then do; call reject('invalid',builder.error()); return; end
    _ir = builder.finish()
    if _ir.error() <> '' then do; call reject('invalid',_ir.error()); return; end
    _edges = .llirgraph..edgeprofile(reference _ir,_worklimit - _work,_bytelimit - _bytes)
    ordinals = .int[]
    do i = 1 to _ir.operations(); ordinals[i] = 0; end
    do row = 1 to _from[0]
      id = _from[row]; projected = _projected[id]; ordinal = 0; dest = 0
      if _to[row] > 0 then do
        ordinal = ordinals[projected] + 1; ordinals[projected] = ordinal; dest = _block[_to[row]]
        call _edges.put(projected,ordinal,_roles[row],_phases[row],_signals[row])
      end
      else call _edges.boundary(projected,_roles[row],_phases[row],_bounds[row],_boundids[row],_signals[row],_known[row],_reasons[row])
      item = target.at(id)
      _rows[row] = scopetransition(row,projected,ordinal,dest)
      if _status <> 'building' then return
      call indexrow(id,row)
    end
    /* Synthetic catalogue/empty blocks have no actual successors. Their
     * terminal boundaries are visible too, with source operation zero. */
    projectionstore_ref = _ir.storage(); projectionstore = dereference projectionstore_ref
    do b = 1 to _ir.blocks()
      lastop = projectionstore.get(2,b,3)
      if lastop <= _source[0] then do; if _source[lastop] > 0 then iterate; end
      if reserve(160,1) = 0 then return
      row = _rows[0] + 1; f = projectionstore.get(2,b,1)
      call _edges.boundary(lastop,'terminal','none','synthetic-end',b as .string)
      _rows[row] = .lltargetcfg..edge(row,0,lastop,b,f,'terminal',0,0,'synthetic-end',b as .string,'','none',1,'','local',0,1,'','','')
      call indexrow(0,row)
    end
    if _edges.seal() = 0 then do; call reject(_edges.status(),_edges.message()); return; end
    _work = _work + _edges.usedwork(); _bytes = _bytes + _edges.usedbytes()
    _index = .llirgraph..index.typed(reference _ir,reference _edges,_worklimit - _work,_bytelimit - _bytes)
    if _index.status() <> 'ok' then do; call reject(_index.status(),_index.message()); return; end
    _work = _work + _index.usedwork(); _bytes = _bytes + _index.usedbytes(); _status = 'ok'
    return
  valid: method = .int
    call run()
    if _status <> 'ok' | <refvalid>(_owner) = 0 | <refvalid>(_profile) = 0 then return 0
    target = dereference _owner; profile = dereference _profile
    return target.valid() & target.identity() = _revision & profile.matches(_owner) & profile.identity() = _profileid & _index.valid()
  matches: method = .int
    arg owner = reference .lltarget..module, profile = reference .lltargettransfer..profile
    return valid() & (_owner <refsame> owner) & (_profile <refsame> profile)
  require: method = .void
    if valid() = 0 then call bad('LL_TARGET_OWNER: CFG expired, incomplete or replaced')
    return
  status: method = .string
    call run()
    if _status = 'ok' & valid() = 0 then return 'invalid'
    return _status
  message: method = .string
    if _status = 'ok' & valid() = 0 then return 'LL_TARGET_OWNER: stale CFG input'
    return _message
  identity: method = .int
    call run()
    if _status <> 'ok' then return 0
    return _index.identity()
  revision: method = .int
    return _revision
  owner: method = reference .lltarget..module
    call require(); return _owner
  profile: method = reference .lltargettransfer..profile
    call require(); return _profile
  ir: method = reference .llir..module
    call require(); return reference _ir
  index: method = reference .llirgraph..index
    call require(); return reference _index
  sourceop: method = .int
    arg projected = .int
    call require()
    if projected < 1 | projected > _ir.operations() then call bad('LL_TARGET_CFG: projected operation ordinal')
    if projected > _source[0] then return 0
    return _source[projected]
  projectedop: method = .int
    arg source = .int
    call require()
    if source < 1 | source > _projected[0] then call bad('LL_TARGET_CFG: source operation ordinal')
    return _projected[source]
  projectedblock: method = .int
    arg source = .int
    call require()
    if source < 1 | source > _block[0] then call bad('LL_TARGET_CFG: source block ordinal')
    return _block[source]
  edges: method = .int
    call require(); return _rows[0]
  edge: method = .lltargetcfg..edge
    arg id = .int
    call require()
    if id < 1 | id > _rows[0] then call bad('LL_TARGET_CFG: edge ordinal')
    return _rows[id]
  outedges: method = .int
    arg source = .int
    call require()
    if source < 0 | source + 1 > _outcount[0] then call bad('LL_TARGET_CFG: source edge identity')
    return _outcount[source + 1]
  outedge: method = .lltargetcfg..edge
    arg source = .int, ordinal = .int
    call require()
    if ordinal < 1 | ordinal > outedges(source) then call bad('LL_TARGET_CFG: source edge ordinal')
    row = _outfirst[source + 1]
    do i = 2 to ordinal; row = _outnext[row]; end
    return _rows[row]
  checksource: method = .void
    arg source = .int
    call require()
    if source < 0 | source > _scopeowner[0] then call bad('LL_TARGET_CFG: scope source identity')
    if source > 0 then do
      if _projected[source] = 0 then call bad('LL_TARGET_CFG: source is not a projected record')
    end
    return
  /** The stack immediately before this record; zero names the physical root. */
  scopeowner: method = .int
    arg source = .int
    call checksource(source)
    if source = 0 then return 0
    return _scopeowner[source]
  checkscope: method = .void
    arg scope = .int
    call checksource(scope)
    if scope = 0 then call bad('LL_TARGET_CFG: physical root is not inline scope')
    if _scopecontinuation[scope] = 0 then call bad('LL_TARGET_CFG: source is not a scope entry')
    return
  scopeparent: method = .int
    arg scope = .int
    call checkscope(scope); return _scopeparent[scope]
  scopecontinuation: method = .int
    arg scope = .int
    call checkscope(scope); return _scopecontinuation[scope]
  scopedepth: method = .int
    arg source = .int
    cursor = scopeowner(source); depth = 0
    do while cursor > 0
      depth = depth + 1; cursor = _scopeparent[cursor]
    end
    return depth
  scopeat: method = .int
    arg source = .int, depth = .int
    count = scopedepth(source)
    if depth < 1 | depth > count then call bad('LL_TARGET_CFG: scope stack ordinal')
    cursor = _scopeowner[source]
    do i = depth + 1 to count; cursor = _scopeparent[cursor]; end
    return cursor
  logicalreturn: method = .int
    arg source = .int
    call checksource(source)
    if source = 0 then return 0
    return _scopeexit[source] > 0
  physicaldeparture: method = .int
    arg source = .int
    call checksource(source)
    if source = 0 then return 0
    target = dereference _owner; item = target.at(source)
    if item.kind() <> 'instruction' | _scopeexit[source] > 0 then return 0
    catalog = .llrxascatalog..catalog(); return catalog.flow(item.opcode()) = 3
  normalcomplete: method = .int
    arg functionid = .int
    call require(); return _normal[functionid]
  exceptionalcomplete: method = .int
    arg functionid = .int
    call require(); return _exceptional[functionid]
  asynchronouscomplete: method = .int
    arg functionid = .int
    call require(); return _async[functionid]
  /** Completeness of possible destinations inside this logical procedure.
   * Foreign handler effects and unknown outward departures remain visible on
   * their edges; this query does not certify their absence or known values. */
  localcomplete: method = .int
    arg functionid = .int
    call require(); return _normal[functionid] & _local[functionid]
  /** Exact policy/path correlation is independent of conservative local
   * destination coverage. Zero never means that no policy is installed. */
  policycorrelationcomplete: method = .int
    arg functionid = .int
    call require(); return _policyexact[functionid]
  /** Entry-read normalization uses a may-read proof over this complete local
   * supergraph. All inherited, resumed and unknown outward effects remain on
   * their existing edges; value/origin/binding completeness belongs to flow. */
  normalizationcomplete: method = .int
    arg functionid = .int
    call require(); return localcomplete(functionid)
  normalizationreason: method = .string
    arg functionid = .int
    call require()
    if localcomplete(functionid) = 0 then return 'signal.local.destinations.unproved'
    return ''
  usedwork: method = .int
    return _work
  usedbytes: method = .int
    return _bytes
