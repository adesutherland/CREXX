/* cREXX License (MIT). One checked, split machine CFG over shared L IR. */
options levelb
namespace lltargetcfg expose graph edge ingresscone policyfact
import rxfnsb
import llir
import llirgraph
import lltarget
import lltargettransfer
import llrxascatalog

bad: procedure = .void
  arg message = .string
  assembler signal "ERROR",message
  return
bits: procedure = .binary
  arg value = .int
  result = .binary; call binresize result,8; <at..i64>(0) result = value
  return result
contract: procedure = .llir..contract
  schema = .llir..schema(); family = schema.family('rxas.target.analysis',1)
  integer = family.type('source',.llir..intcodec() as .object)
  point = family.operation('point'); call point.attribute('source',integer)
  /* This operation is an analysis control marker, not execution of the source
   * instruction. Source effects live in the checked transfer profile and
   * missing departures are explicit incomplete typed boundary rows. */
  call point.state('none'); call point.failure('none'); call point.termination('returns')
  call point.control('terminal',0,65536)
  return schema.finish()

/** Edge rows are typed observations of actual projection successors or checked
 * boundary departures. Duplicate successor blocks retain distinct ordinals. */
edge: class
  _id = .int
  _source = .int
  _projected = .int
  _block = .int
  _function = .int
  _role = .string
  _ordinal = .int
  _target = .int
  _boundary = .string
  _boundaryid = .string
  _signal = .string
  _phase = .string
  _complete = .int
  _reason = .string
  _exposure = .string
  _targetop = .int
  _asynchronous = .int
  _regionexits = .string
  _regioncomplete = .int
  _regionreason = .string
  _coldactions = .lltarget..record[]
  _policyinstallation = .int
  *: factory
    arg id = .int, source = .int, projected = .int, block = .int, functionid = .int, role = .string, ordinal = .int, target = .int, boundary = .string, boundaryid = .string, signalname = .string, phase = .string, complete = .int, reason = .string, exposure = 'local', targetop = 0, asynchronous = 0, regionexits = '', regioncomplete = 1, regionreason = '', ?coldactions = .lltarget..record[], policyinstallation = 0
    _policyinstallation = policyinstallation
    _id = id; _source = source; _projected = projected; _block = block; _function = functionid
    _role = role; _ordinal = ordinal; _target = target; _boundary = boundary; _boundaryid = boundaryid
    _signal = signalname; _phase = phase; _complete = complete; _reason = reason
    _exposure = exposure; _targetop = targetop; _asynchronous = asynchronous
    _regionexits = regionexits; _regioncomplete = regioncomplete; _regionreason = regionreason
    if ?coldactions then _coldactions = coldactions
    return
  id: method = .int
    return _id
  sourceop: method = .int
    return _source
  projectedop: method = .int
    return _projected
  sourceblock: method = .int
    return _block
  function: method = .int
    return _function
  role: method = .string
    return _role
  /** Certified canonical asynchronous signal producer, never phase inference. */
  asynchronous: method = .int
    return _asynchronous
  successorordinal: method = .int
    return _ordinal
  targetblock: method = .int
    return _target
  boundarykind: method = .string
    return _boundary
  boundaryid: method = .string
    return _boundaryid
  signalname: method = .string
    return _signal
  phase: method = .string
    return _phase
  complete: method = .int
    return _complete
  unknownreason: method = .string
    return _reason
  /** The edge destination can be known while a foreign handler may modify
   * reachable storage before resumption. This is not an ordinary local edge. */
  exposure: method = .string
    return _exposure
  /** Exact source installation owning this handler edge, zero if inherited. */
  policyinstallation: method = .int
    return _policyinstallation
  /** Destination source record, distinct from the projected block identity. */
  targetop: method = .int
    return _targetop
  /** Executable region transitions use checked lexical ancestry. Zero does
   * not mean an empty cleanup set; the destination is then unproved. */
  regioncomplete: method = .int
    return _regioncomplete
  regionreason: method = .string
    return _regionreason
  regionexits: method = .int
    return words(_regionexits)
  regionexit: method = .int
    arg ordinal = .int
    if ordinal < 1 | ordinal > words(_regionexits) then call bad('LL_TARGET_CFG: region exit ordinal')
    return word(_regionexits,ordinal) as .int
  coldactions: method = .int
    return _coldactions[0]
  coldaction: method = .lltarget..record
    arg ordinal = .int
    if ordinal < 1 | ordinal > _coldactions[0] then call bad('LL_TARGET_CFG: cold action ordinal')
    return _coldactions[ordinal]

/** A backwards source-point cone, including every known local ingress.
 * Incomplete local destinations are not absent predecessors. Outward unwind
 * at physical depth zero and terminal departure retain their unknown target
 * without inventing an edge back into this activation. */
ingresscone: class
  _owner = reference .lltargetcfg..graph
  _identity = .int
  _operation = .int
  _function = .int
  _members = .int[]
  _operations = .int[]
  _status = .string
  _reason = .string
  _work = .int
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  *: factory
    arg owner = reference .graph, operation = .int, work = 1000000, bytes = 67108864
    _owner = owner; _operation = operation; _worklimit = work; _bytelimit = bytes; _status = 'building'
    return
  fail: method = .int
    arg state = .string, reason = .string
    if _status = 'building' then do; _status = state; _reason = reason; end
    return 0
  spend: method = .int
    arg work = 1, bytes = 0
    if work < 0 | bytes < 0 | work > _worklimit - _work | bytes > _bytelimit - _bytes then return fail('limit','target.cfg.ingress.work.or.bytes')
    _work = _work + work; _bytes = _bytes + bytes; return 1
  run: method = .void
    i = .int; row = .int; head = .int; point = .int; previous = .int; ignored = .int
    edge = .lltargetcfg..edge
    heads = .int[]; next = .int[]; sources = .int[]; pending = .int[]
    if _status <> 'building' then return
    if <refvalid>(_owner) = 0 then do; ignored = fail('invalid','target.cfg.ingress.owner.expired'); return; end
    cfg = dereference _owner
    if cfg.status() <> 'ok' then do; ignored = fail(cfg.status(),cfg.message()); return; end
    _identity = cfg.identity(); source_ref = cfg.owner(); source = dereference source_ref
    graph_ref = source.ir(); graph = dereference graph_ref; index_ref = cfg.index(); index = dereference index_ref
    if _operation < 1 | _operation > graph.operations() then do; ignored = fail('invalid','target.cfg.ingress.operation.invalid'); return; end
    selected = source.at(_operation); _function = selected.procedureid()
    if _function < 2 | cfg.projectedop(_operation) = 0 then do; ignored = fail('invalid','target.cfg.ingress.operation.unprojected'); return; end
    if index.reachable(cfg.projectedblock(_operation)) = 0 then do; ignored = fail('unknown','target.cfg.ingress.operation.unreached'); return; end
    if graph.operations() > (_bytelimit - _bytes) <idiv> 32 | cfg.edges() > (_bytelimit - _bytes) <idiv> 24 then do; ignored = fail('limit','target.cfg.ingress.work.or.bytes'); return; end
    if spend(graph.operations() + cfg.edges() + 1,graph.operations() * 32 + cfg.edges() * 24) = 0 then return
    do i = 1 to graph.operations(); heads[i] = 0; _members[i] = 0; end
    do i = 1 to cfg.edges()
      edge = cfg.edge(i); next[i] = 0; sources[i] = 0
      if edge.function() <> _function | edge.sourceop() = 0 then iterate
      if index.reachable(edge.sourceblock()) = 0 then iterate
      if edge.complete() = 0 then do
        outward = edge.targetblock() = 0 & edge.role() = 'terminal'
        if edge.targetblock() = 0 & edge.role() = 'unwind' then outward = 1
        if outward = 0 then do; ignored = fail('unknown','target.cfg.ingress.local.destination.unproved'); return; end
      end
      if edge.targetblock() = 0 then iterate
      point = edge.targetop()
      if point < 1 | point > graph.operations() then do; ignored = fail('unknown','target.cfg.ingress.target.unrepresented'); return; end
      sources[i] = edge.sourceop(); next[i] = heads[point]; heads[point] = i
    end
    pending[1] = _operation; _members[_operation] = 1; head = 1
    do while head <= pending[0]
      if spend(1) = 0 then return
      point = pending[head]; head = head + 1; row = heads[point]
      do while row > 0
        if spend(1) = 0 then return
        previous = sources[row]
        if _members[previous] = 0 then do
          _members[previous] = 1; pending[pending[0] + 1] = previous
        end
        row = next[row]
      end
    end
    if spend(cfg.edges()) = 0 then return
    do i = 1 to cfg.edges()
      edge = cfg.edge(i)
      if edge.function() <> _function | edge.targetblock() = 0 then iterate
    end
    if spend(source.records()) = 0 then return
    do i = 1 to source.records()
      item = source.record(i)
      if _members[item.id()] then _operations[_operations[0] + 1] = item.id()
    end
    _status = 'proved'
    return
  valid: method = .int
    call run()
    if <refvalid>(_owner) = 0 | _identity = 0 then return 0
    cfg = dereference _owner; return cfg.valid() & cfg.identity() = _identity
  status: method = .string
    call run()
    if _status = 'proved' & valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    call run()
    if _status = 'proved' & valid() = 0 then return 'target.cfg.ingress.owner.expired.or.replaced'
    return _reason
  complete: method = .int
    return status() = 'proved'
  owner: method = reference .lltargetcfg..graph
    return _owner
  operation: method = .int
    return _operation
  function: method = .int
    return _function
  operations: method = .int
    if complete() = 0 then call bad('LL_TARGET_CFG: incomplete ingress cone has no exhaustive node list')
    return _operations[0]
  at: method = .int
    arg ordinal = .int
    if complete() = 0 | ordinal < 1 | ordinal > _operations[0] then call bad('LL_TARGET_CFG: ingress cone operation ordinal')
    return _operations[ordinal]
  contains: method = .int
    arg operation = .int
    if complete() = 0 | operation < 1 | operation > _members[0] then return 0
    return _members[operation]
  usedwork: method = .int
    return _work
  usedbytes: method = .int
    return _bytes

/** One complete path's handler table and ordered source-owned named saves.
 * Handler zero is an inherited parameter, not an absent/default handler. */
policystate: class
  _function = .int
  _handlers = .int[]
  _markers = .int[]
  _savetags = .int[]
  _saveops = .int[]
  _savehandlers = .int[]
  _savemarkers = .int[]
  _depth = .int
  _reason = .string
  *: factory
    arg functionid = 0, tags = 0
    _function = functionid
    do i = 1 to tags; _handlers[i] = 0; _markers[i] = 0; end
    return
  function: method = .int
    return _function
  reason: method = .string
    return _reason
  unknown: method = .void
    arg reason = .string
    _reason = reason
    return
  tags: method = .int
    return _handlers[0]
  installation: method = .int
    arg tag = .int
    return _handlers[tag]
  marker: method = .int
    arg tag = .int
    return _markers[tag]
  install: method = .void
    arg tag = .int, operation = .int
    _handlers[tag] = operation; _markers[tag] = _depth
    return
  saves: method = .int
    return _depth
  savetag: method = .int
    arg ordinal = .int
    return _savetags[ordinal]
  saveop: method = .int
    arg ordinal = .int
    return _saveops[ordinal]
  savedinstallation: method = .int
    arg ordinal = .int
    return _savehandlers[ordinal]
  savedmarker: method = .int
    arg ordinal = .int
    return _savemarkers[ordinal]
  push: method = .void
    arg tag = .int, operation = .int
    _depth = _depth + 1; _savetags[_depth] = tag; _saveops[_depth] = operation
    _savehandlers[_depth] = _handlers[tag]; _savemarkers[_depth] = _markers[tag]
    return
  remove: method = .void
    arg ordinal = .int
    i = .int
    tag = _savetags[ordinal]; _handlers[tag] = _savehandlers[ordinal]; _markers[tag] = _savemarkers[ordinal]
    /* A marker names the newest still-live saved node. Removing a named save
     * in the middle rebases current and saved entries to its older neighbour. */
    do i = 1 to _handlers[0]
      if _markers[i] >= ordinal then _markers[i] = _markers[i] - 1
    end
    do i = 1 to _depth
      if _savemarkers[i] >= ordinal then _savemarkers[i] = _savemarkers[i] - 1
    end
    do i = ordinal to _depth - 1
      _savetags[i] = _savetags[i + 1]; _saveops[i] = _saveops[i + 1]
      _savehandlers[i] = _savehandlers[i + 1]; _savemarkers[i] = _savemarkers[i + 1]
    end
    _depth = _depth - 1
    return
  pop: method = .int
    arg tag = .int
    do i = _depth to 1 by -1
      if _savetags[i] = tag then do; call remove(i); return 1; end
    end
    return 0
  unwind: method = .void
    arg marker = .int
    do while _depth > marker; call remove(_depth); end
    return
  copy: method = .lltargetcfg..policystate
    i = .int
    result = .policystate(_function,_handlers[0])
    do i = 1 to _handlers[0]; call result.setentry(i,_handlers[i],_markers[i]); end
    do i = 1 to _depth; call result.addsave(_savetags[i],_saveops[i],_savehandlers[i],_savemarkers[i]); end
    call result.unknown(_reason)
    return result
  setentry: method = .void
    arg tag = .int, operation = .int, marker = .int
    _handlers[tag] = operation; _markers[tag] = marker
    return
  addsave: method = .void
    arg tag = .int, operation = .int, installation = .int, marker = .int
    _depth = _depth + 1; _savetags[_depth] = tag; _saveops[_depth] = operation
    _savehandlers[_depth] = installation; _savemarkers[_depth] = marker
    return
  bytes: method = .int
    return 64 + _handlers[0] * 16 + _depth * 32 + length(_reason)
  key: method = .string
    if _reason <> '' then return '?' || _reason
    i = .int
    result = _function as .string
    do i = 1 to _handlers[0]; result = result || ':' || _handlers[i] || '.' || _markers[i]; end
    do i = 1 to _depth; result = result || '/' || _savetags[i] || '.' || _saveops[i] || '.' || _savehandlers[i] || '.' || _savemarkers[i]; end
    return result

/** Immutable owner-checked correlated policy alternative. Saves are oldest
 * first. Each save belongs to this source procedure's initially empty stack;
 * an unmatched POP cannot consume a caller's or a later consumer's saves. */
policyfact: class
  _owner = reference .lltargetcfg..graph
  _identity = .int
  _state = .policystate
  *: factory
    arg owner = reference .lltargetcfg..graph, state = .policystate
    _owner = owner; _state = state; cfg = dereference owner; _identity = cfg.identity()
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    cfg = dereference _owner; return cfg.valid() & cfg.identity() = _identity
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _state.reason() <> '' then return 'unknown'
    return 'proved'
  reason: method = .string
    if valid() = 0 then return 'target.cfg.policy.owner.expired.or.replaced'
    return _state.reason()
  require: method = .void
    if valid() = 0 then call bad('LL_TARGET_CFG: expired policy fact')
    return
  function: method = .int
    call require(); return _state.function()
  tags: method = .int
    call require(); return _state.tags()
  tag: method = .string
    arg ordinal = .int
    call require(); cfg = dereference _owner; return cfg.policytag(ordinal)
  installation: method = .int
    arg tag = .string
    call require(); cfg = dereference _owner; ordinal = cfg.policytagid(tag)
    if ordinal = 0 | status() <> 'proved' then return 0
    return _state.installation(ordinal)
  action: method = .int
    arg tag = .string
    installedop = installation(tag)
    if installedop = 0 then return 0
    cfg = dereference _owner; return cfg.policyeffect(installedop,tag)
  marker: method = .int
    arg tag = .string
    call require(); cfg = dereference _owner; ordinal = cfg.policytagid(tag)
    if ordinal = 0 | status() <> 'proved' then return 0
    return _state.marker(ordinal)
  saves: method = .int
    call require(); return _state.saves()
  checksave: method = .void
    arg ordinal = .int
    call require()
    if status() <> 'proved' | ordinal < 1 | ordinal > _state.saves() then call bad('LL_TARGET_CFG: policy save ordinal or unknown state')
    return
  saveop: method = .int
    arg ordinal = .int
    call checksave(ordinal); return _state.saveop(ordinal)
  savetag: method = .string
    arg ordinal = .int
    call checksave(ordinal); cfg = dereference _owner; return cfg.policytag(_state.savetag(ordinal))
  saveowner: method = .int
    arg ordinal = .int
    call checksave(ordinal); return _state.function()
  savedinstallation: method = .int
    arg ordinal = .int
    call checksave(ordinal); return _state.savedinstallation(ordinal)
  savedmarker: method = .int
    arg ordinal = .int
    call checksave(ordinal); return _state.savedmarker(ordinal)

graph: class
  _owner = reference .lltarget..module
  _profile = reference .lltargettransfer..profile
  _profileid = .int
  _revision = .int
  _ir = .llir..module
  _edges = .llirgraph..edgeprofile
  _index = .llirgraph..index
  _status = .string
  _message = .string
  _work = .int
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  _source = .int[]
  _projected = .int[]
  _block = .int[]
  _next = .int[]
  _group = .int[]
  _normal = .int[]
  _exceptional = .int[]
  _async = .int[]
  _local = .int[]
  _localreason = .string[]
  _policyexact = .int[]
  _tags = .string[]
  _policystates = .policystate[]
  _policypoints = .int[]
  _policynext = .int[]
  _policyheads = .int[]
  _policylasts = .int[]
  _edgepolicyheads = .int[]
  _edgepolicylasts = .int[]
  _edgepolicynext = .int[]
  _edgepolicystates = .policystate[]
  _edgeinstall = .int[]
  _edgepossible = .int[]
  _policyops = .int[]
  _policyfunction = .int[]
  _policynames = .string[]
  _from = .int[]
  _stagefirst = .int[]
  _stagelast = .int[]
  _stagenext = .int[]
  _outfirst = .int[]
  _outlast = .int[]
  _outnext = .int[]
  _outcount = .int[]
  _to = .int[]
  _roles = .string[]
  _phases = .string[]
  _bounds = .string[]
  _boundids = .string[]
  _signals = .string[]
  _known = .int[]
  _reasons = .string[]
  _exposures = .string[]
  _asynchronous = .int[]
  _rows = .lltargetcfg..edge[]
  *: factory
    arg owner = reference .lltarget..module, profile = reference .lltargettransfer..profile, work = 1000000, bytes = 67108864
    _owner = owner; _profile = profile; _worklimit = work; _bytelimit = bytes; _status = 'building'
    return
  reserve: method = .int
    arg bytes = .int, work = .int
    if _status <> 'building' then return 0
    if bytes < 0 | work < 0 | bytes > _bytelimit - _bytes | work > _worklimit - _work then do
      call reject('limit','LL_RESOURCE_LIMIT: target.cfg work/bytes'); return 0
    end
    _bytes = _bytes + bytes; _work = _work + work
    return 1
  reject: method = .void
    arg state = .string, message = .string
    if _status = 'building' then do; _status = state; _message = message; end
    return
  stage: method = .void
    arg source = .int, target = .int, role = .string, phase = 'none', boundary = '', boundaryid = '', signalname = '', complete = 1, reason = '', exposure = 'local', asynchronous = 0, policyinstallation = 0
    if wordpos(role,'normal table skip handler resumed async unwind terminal unknown') = 0 | wordpos(phase,'none before partial after unknown') = 0 | (target = 0 & boundary = '') | (target > 0 & boundary <> '') | (complete = 0 & reason = '') then do
      call reject('invalid','LL_TARGET_CFG: edge shape'); return
    end
    if reserve(168 + length(boundaryid) + length(signalname) + length(reason),1) = 0 then return
    id = _from[0] + 1; _from[id] = source; _to[id] = target; _roles[id] = role; _phases[id] = phase
    _bounds[id] = boundary; _boundids[id] = boundaryid; _signals[id] = signalname; _known[id] = complete; _reasons[id] = reason
    _exposures[id] = exposure; _asynchronous[id] = asynchronous; _edgeinstall[id] = policyinstallation; _edgepossible[id] = 1; _edgepolicyheads[id] = 0; _edgepolicylasts[id] = 0
    _stagenext[id] = 0
    if _stagelast[source] > 0 then _stagenext[_stagelast[source]] = id
    else _stagefirst[source] = id
    _stagelast[source] = id
    return
  indexrow: method = .void
    arg source = .int, row = .int
    key = source + 1; _outnext[row] = 0
    if _outlast[key] > 0 then _outnext[_outlast[key]] = row
    else _outfirst[key] = row
    _outlast[key] = row; _outcount[key] = _outcount[key] + 1
    return
  resolveblock: method = .int
    arg oldblock = .int
    target = dereference _owner; source_ref = target.ir(); source = dereference source_ref; store_ref = source.storage(); store = dereference store_ref
    do steps = 1 to source.blocks() + 1
      if reserve(0,1) = 0 then return 0
      if oldblock < 1 | oldblock > _group[0] then return 0
      if _group[oldblock] > 0 then return _group[oldblock]
      last = store.get(2,oldblock,3); op = source.operation(last)
      if op.successors() <> 1 then return 0
      oldblock = op.successor(1)
    end
    return 0
  /** All authored policies are possible until a path-sensitive policy meet
   * proves otherwise. This procedure-local union is a conservative control
   * interpretation, never an assertion that a policy is active at this point.
   * Inherited handlers remain separate foreign resume/departure alternatives. */
  policyname: method = .string
    arg item = .lltarget..record
    catalog = .llrxascatalog..catalog(); code = item.opcode()
    if catalog.policysource(code) = 1 then return catalog.policyname(code)
    if catalog.policysource(code) = 2 then do
      index = catalog.policysourceoperand(code) + 1
      if index > 0 & index <= item.operands() then do
        value = item.operand(index)
        if value.kind() = 'S' then return upper(value.text())
      end
    end
    return '*'
  raisednames: method = .string
    arg item = .lltarget..record
    catalog = .llrxascatalog..catalog(); code = item.opcode()
    if catalog.signalsource(code) = 1 then return catalog.signalnames(code)
    if catalog.signalsource(code) = 2 then do
      index = catalog.signalsourceoperand(code) + 1
      if index > 0 & index <= item.operands() then do
        value = item.operand(index)
        if value.kind() = 'S' then do
          /* Terminal validation alternatives are separate from the requested
           * event. Only nonterminal static alternatives share its policy. */
          names = upper(value.text()); alternatives = ''
          if wordpos(names,catalog.programdefaultsignals()) = 0 then return ''
          if catalog.signalproperties(code) <idiv> 64 % 2 = 0 then alternatives = translate(catalog.signalnames(code),' ','|')
          do ordinal = 1 to words(alternatives)
            name = word(alternatives,ordinal)
            if wordpos(name,translate(names,' ','|')) = 0 then names = names || '|' || name
          end
          return names
        end
      end
    end
    return '*'
  /** Committed receiver of a policy response. An asynchronous safe point is
   * after the instruction: entry has committed and a logical RET has already
   * left its innermost owner. Synchronous failure never commits a new entry. */
  signalpaths: method = .void
    arg item = .lltarget..record, phase = .string, names = .string, asynchronous = 0, callback = 0, policyunknown = 0, causeid = ''
    exposure = .string; localexposure = .string
    target = dereference _owner; catalog = .llrxascatalog..catalog()
    id = item.id(); f = item.procedureid(); cause = causeid
    if callback then cause = '.callback'
    /* Inherited CALL/action handlers can resume after the signal point. An
     * unknown outward destination does not remove that local successor. */
    profile = dereference _profile
    if profile.defaulthalt(f) & policyunknown = 0 then do
      /* An exact root or checked call-closure member has an explicit inherited
       * HALT contract. Authored policy alternatives below remain possible. */
      exposure = 'inherited'; boundaryid = id || cause || '.sync.' || phase
      if asynchronous then do; exposure = 'inherited-async'; boundaryid = id || cause || '.async.' || phase; end
      /* Boundary annotations have no successor ordinal. Keep synchronous and
       * asynchronous alternatives distinct even when role/name/phase match. */
      call stage(id,0,'terminal',phase,'closed-main-default-halt',boundaryid,names,1,'',exposure,asynchronous)
    end
    else do
      call resumepaths(id,'resumed',phase,names,'inherited',asynchronous)
      role = 'unwind'; boundary = 'inherited-signal-policy'; reason = 'signal.inherited.destination.unknown'
      if asynchronous then do; role = 'async'; boundary = 'asynchronous-policy'; reason = 'asynchronous.policy.unknown'; end
      call stage(id,0,role,phase,boundary,(id as .string) || cause,names,0,reason,'inherited',asynchronous)
    end
    if policyunknown then do
      /* An unproved callback route may replace the receiver policy.
       * A complete public callback structural-policy contract preserves the
       * suspended frame's structural handler table before interrupt dispatch.
       * Both retain their separate signal producers and handler effects. */
      call policygap(item,phase,names,asynchronous,'.callback',0)
    end
    localexposure = 'local'
    if asynchronous then localexposure = 'local-async'
    do p = 1 to _policyops[0]
      if reserve(0,1) = 0 then return
      if _policyfunction[p] <> f then iterate
      tag = _policynames[p]
      if tag <> '*' & names <> '*' & wordpos(tag,translate(names,' ','|')) = 0 then iterate
      installed = target.at(_policyops[p]); effect = catalog.policyeffect(installed.opcode())
      policyid = installed.id() || cause || '.sync.' || phase
      if asynchronous then policyid = installed.id() || cause || '.async.' || phase
      if effect = 4 then do
        call resumepaths(id,'skip',phase,tag,'local',asynchronous,installed.id())
      end
      else if effect = 5 | effect = 6 then call stage(id,0,'terminal',phase,'policy-halt',policyid,tag,1,'',localexposure,asynchronous,installed.id())
      else if effect = 7 | effect = 9 | effect = 14 then do
        dest = 0
        do operand = 1 to installed.operands()
          value = installed.operand(operand)
          if value.kind() = 'L' then do
            dest = resolveblock(target.labelblock(f,value.text())); leave
          end
        end
        if dest > 0 then do
          exposure = 'local'
          if effect = 9 then exposure = 'handler-call'
          if effect = 14 then exposure = 'event-binding'
          if asynchronous then exposure = exposure || '-async'
          call stage(id,dest,'handler',phase,'','',tag,1,'',exposure,asynchronous,installed.id())
        end
        else do
          call stage(id,0,'unknown',phase,'local-policy',policyid,tag,0,'signal.local.target.unknown',localexposure,asynchronous,installed.id())
          _local[f] = 0
        end
      end
      else if effect = 1 | effect = 2 | effect = 8 | effect = 11 then do
        call resumepaths(id,'resumed',phase,tag,'handler-call',asynchronous,installed.id())
        if effect = 11 then call stage(id,0,'terminal',phase,'policy-action-fail',policyid,tag,1,'',localexposure,asynchronous,installed.id())
      end
    end
    return
  /** Typed ingress rows supplement aggregate propagation. A known target or
   * initializer condition is discharged only by this exact profile's owner;
   * any unproved cause retains the original aggregate wildcard producer. */
  callcausepaths: method = .void
    arg item = .lltarget..record
    profile = dereference _profile; catalog = .llrxascatalog..catalog(); code = item.opcode()
    if catalog.callcausestate(code) <> 'known' then return
    do ordinal = 1 to catalog.callcauses(code)
      if reserve(0,1) = 0 then return
      cause = profile.callcause(item.id(),ordinal)
      if cause.possible() = 0 | cause.status() <> 'proved' then iterate
      call signalpaths(item,cause.phase(),cause.names(),0,0,0,'.call-cause.' || ordinal)
    end
    return
  /** Additional alternatives after a reachable non-resource callback may
   * have replaced the suspended policy. Existing HALT/authored alternatives
   * remain possible; their destinations do not close this new policy gap. */
  policygap: method = .void
    arg item = .lltarget..record, phase = .string, names = .string, asynchronous = .int, cause = .string, inherited = 1
    id = item.id(); identity = id || cause || '.sync.' || phase
    exposure = 'inherited'; localexposure = 'local'
    if asynchronous then do
      identity = id || cause || '.async.' || phase
      exposure = 'inherited-async'; localexposure = 'local-async'
    end
    if inherited then do
      call resumepaths(id,'resumed',phase,names,'inherited',asynchronous)
      role = 'unwind'; boundary = 'inherited-signal-policy'
      if asynchronous then do; role = 'async'; boundary = 'asynchronous-policy'; end
      call stage(id,0,role,phase,boundary,identity,names,0,'signal.callback.policy.destination.unknown',exposure,asynchronous)
    end
    call resumepaths(id,'skip',phase,names,'inherited',asynchronous)
    call stage(id,0,'terminal',phase,'callback-policy-halt',identity || '.halt',names,1,'',exposure,asynchronous)
    call stage(id,0,'unknown',phase,'callback-policy',identity || '.policy',names,0,'signal.callback.policy.destination.unknown',localexposure,asynchronous)
    return
  /** Expand only this reachable producer. Intrinsic, operation callback and
   * ambient events retain their own names, phases and boundary identities. */
  policyproducers: method = .void
    arg item = .lltarget..record, owncallback = .int
    catalog = .llrxascatalog..catalog(); code = item.opcode(); id = item.id(); f = item.procedureid()
    /* Initial staging also describes unreachable source operations. Only a
     * reachable producer may contribute these callback completeness gaps. */
    _exceptional[f] = 0; _local[f] = 0; _policyexact[f] = 0
    if _localreason[f] = '' then do
      profile = dereference _profile
      if catalog.callinvokes(code) then _localreason[f] = profile.callcausereason(id)
      if _localreason[f] = '' then _localreason[f] = 'signal.callback.policy.destination.unknown'
    end
    if catalog.signalstate(code) <> 0 then do
      phase = word('none before after partial unknown',catalog.signalphase(code) + 1)
      names = raisednames(item)
      terminalstatic = catalog.signalproperties(code) <idiv> 64 % 2
      if terminalstatic = 0 | catalog.signalsource(code) <> 1 then do
        if names <> '' then call policygap(item,phase,names,0,'.reachable-callback.intrinsic')
      end
    end
    /* A direct non-resource callback already has its own unknown-policy
     * alternatives. A resource-only callback needs the incoming policy gap. */
    if catalog.callbackobligations(code) <> 0 & owncallback = 0 then call policygap(item,'unknown','*',0,'.reachable-callback.callback')
    if catalog.flow(code) <> 3 then do
      call policygap(item,'after','*',1,'.reachable-callback.ambient'); _async[f] = 0
    end
    return
  /** Joint reachability/policy fixed point over staged local successors.
   * State grows only unreachable -> reachable -> policy-unknown, so every
   * source point enters the worklist at most twice. New resumed/skip edges
   * are visited before publishing the checked graph, including backedges.
   * Unknown local destinations remain explicit incomplete boundaries. */
  propagatepolicy: method = .void
    arg seeds = .int[], roots = .int[]
    states = .int[]; expanded = .int[]; workpoints = .int[]
    i = .int; id = .int; row = .int; destination = .int; incoming = .int; cursor = .int
    item = .lltarget..record; target = dereference _owner
    nodes = _projected[0]
    if _bytelimit - _bytes < 192 then do; call reject('limit','LL_RESOURCE_LIMIT: target.cfg policy worklist'); return; end
    if nodes > (_bytelimit - _bytes - 192) <idiv> 32 then do; call reject('limit','LL_RESOURCE_LIMIT: target.cfg policy worklist'); return; end
    if reserve(nodes * 32 + 192,nodes) = 0 then return
    do i = 1 to nodes; states[i] = 0; expanded[i] = 0; end
    do i = 2 to roots[0]
      if reserve(0,1) = 0 then return
      id = roots[i]
      if id > 0 then do; states[id] = 1; workpoints[workpoints[0] + 1] = id; end
    end
    cursor = 1
    do while cursor <= workpoints[0]
      if reserve(0,1) = 0 then return
      id = workpoints[cursor]; cursor = cursor + 1
      incoming = states[id] = 2 | seeds[id]
      if incoming & expanded[id] = 0 then do
        expanded[id] = 1; item = target.at(id)
        if item.kind() = 'instruction' then call policyproducers(item,seeds[id])
        if _status <> 'building' then return
      end
      row = _stagefirst[id]
      do while row > 0
        if reserve(0,1) = 0 then return
        destination = _to[row]
        if destination > 0 then do
          if states[destination] < incoming + 1 then do
            states[destination] = incoming + 1
            if workpoints[0] >= nodes * 2 then do; call reject('limit','LL_RESOURCE_LIMIT: target.cfg policy worklist'); return; end
            workpoints[workpoints[0] + 1] = destination
          end
        end
        row = _stagenext[row]
      end
    end
    return
  resumepaths: method = .void
    arg id = .int, role = .string, phase = .string, name = .string, exposure = .string, asynchronous = .int, policyinstallation = 0
    if asynchronous then do
      exposure = exposure || '-async'
      /* An interrupt after a branch resumes its selected successor, not the
       * lexical next instruction. Preserve every normal successor alternative. */
      row = _stagefirst[id]; stop = _stagelast[id]
      do while row > 0
        if reserve(0,1) = 0 then return
        following = _stagenext[row]
        if _roles[row] = 'normal' & _to[row] > 0 then call stage(id,_to[row],role,phase,'','',name,1,'',exposure,asynchronous,policyinstallation)
        if row = stop then leave
        row = following
      end
    end
    else do
      successor = _next[id]
      if successor > 0 then call stage(id,successor,role,phase,'','',name,1,'',exposure,asynchronous,policyinstallation)
    end
    return
  /** Project one canonical boundary and its lexical cold-region duties. */
  edgerow: method = .lltargetcfg..edge
    arg row = .int, projected = .int, ordinal = .int, destblock = .int
    target = dereference _owner; id = _from[row]; destination = _to[row]; item = target.at(id)
    regionexits = ''; regionreason = ''; regioncomplete = 1; coldactions = .lltarget..record[]
    fromregion = target.regionat(id); toregion = 0
    if destination > 0 then toregion = target.regionat(destination)
    if fromregion < 0 | toregion < 0 then do; regioncomplete = 0; regionreason = 'target.cfg.region.source.or.destination.invalid'; end
    /* Returning handlers/IGNORE retain the suspended activation. Terminal
     * cleanup belongs to physical retirement, with no per-clone finalizer. */
    cold = _roles[row] = 'handler' | _roles[row] = 'unwind'
    if cold & regioncomplete then do
      cursor = fromregion
      do while cursor > 0 & cursor <> toregion
        if reserve(16,1) = 0 then leave
        regionexits = regionexits || ' ' || cursor
        actionwork = target.exitactionwork(cursor)
        if actionwork > (_bytelimit - _bytes) <idiv> 8 then do; call reject('limit','LL_RESOURCE_LIMIT: target.cfg cold action bytes'); leave; end
        if reserve(actionwork * 8,actionwork) = 0 then leave
        actionids = target.exitactionids(cursor,id,actionwork,max(8,actionwork * 8))
        do actionordinal = 1 to actionids[0]
          action = target.at(actionids[actionordinal])
          if reserve(16,1) = 0 then leave
          coldactions[coldactions[0] + 1] = action
        end
        region = target.region(cursor); cursor = region.parentregion()
      end
      if cursor <> toregion then do
        regioncomplete = 0; regionreason = 'target.cfg.region.destination.not.ancestor'
      end
    end
    if _roles[row] = 'unknown' | (_roles[row] = 'async' & fromregion > 0) then do
      regioncomplete = 0; regionreason = 'target.cfg.region.destination.unknown'
    end
    if regioncomplete = 0 then do; regionexits = ''; assembler setattrs coldactions,0; end
    return .lltargetcfg..edge(row,id,projected,_block[id],item.procedureid(),_roles[row],ordinal,destblock,_bounds[row],_boundids[row],_signals[row],_phases[row],_known[row],_reasons[row],_exposures[row],destination,_asynchronous[row],strip(regionexits),regioncomplete,regionreason,coldactions,_edgeinstall[row])
  /** Append each distinct whole path once. No tag-wise meet invents a
   * handler/save combination, and every comparison/copy consumes this budget. */
  addpolicypoint: method = .int
    arg operation = .int, state = .policystate
    cursor = _policyheads[operation]; key = state.key()
    do while cursor > 0
      previous = _policystates[cursor]
      if reserve(0,previous.tags() + previous.saves() + 1) = 0 then return 0
      if previous.key() == key then return cursor
      cursor = _policynext[cursor]
    end
    if reserve(state.bytes() + length(key) + 32,state.tags() + state.saves() + 1) = 0 then return 0
    cursor = _policystates[0] + 1; _policystates[cursor] = state; _policypoints[cursor] = operation; _policynext[cursor] = 0
    if _policylasts[operation] > 0 then _policynext[_policylasts[operation]] = cursor
    else _policyheads[operation] = cursor
    _policylasts[operation] = cursor
    if state.reason() <> '' then _policyexact[state.function()] = 0
    return cursor
  addedgepolicy: method = .int
    arg edgeid = .int, state = .policystate
    cursor = _edgepolicyheads[edgeid]; key = state.key()
    do while cursor > 0
      previous = _edgepolicystates[cursor]
      if reserve(0,previous.tags() + previous.saves() + 1) = 0 then return 0
      if previous.key() == key then return cursor
      cursor = _edgepolicynext[cursor]
    end
    if reserve(state.bytes() + length(key) + 16,state.tags() + state.saves() + 1) = 0 then return 0
    cursor = _edgepolicystates[0] + 1; _edgepolicystates[cursor] = state; _edgepolicynext[cursor] = 0
    if _edgepolicylasts[edgeid] > 0 then _edgepolicynext[_edgepolicylasts[edgeid]] = cursor
    else _edgepolicyheads[edgeid] = cursor
    _edgepolicylasts[edgeid] = cursor; _edgepossible[edgeid] = 1
    return cursor
  tagindex: method = .int
    arg name = .string
    do i = 1 to _tags[0]
      if reserve(0,1) = 0 then return 0
      if _tags[i] == name then return i
    end
    return 0
  policytransfer: method = .lltargetcfg..policystate
    arg operation = .int, incoming = .policystate
    result = incoming.copy(); source = dereference _owner; profile = dereference _profile
    item = source.at(operation); catalog = .llrxascatalog..catalog()
    if result.reason() <> '' | item.kind() <> 'instruction' then return result
    if profile.premise() = 'canonical' then do
      if profile.callbackpolicyunknown(operation) then call result.unknown('target.cfg.policy.callback.write.unknown')
    end
    view = profile.instruction(operation)
    do ordinal = 1 to view.actions()
      action = view.action(ordinal)
      if action.kind() = 'callback' & profile.premise() <> 'canonical' then call result.unknown('target.cfg.policy.independent.callback.unknown')
      if action.kind() <> 'policy' then iterate
      effect = action.policyeffect(); name = '*'; value = action.literal()
      if action.sourcekind() = 'literal' & value.kind() = 'S' then name = upper(value.text())
      tag = tagindex(name)
      if name <> '*' & (wordpos(name,catalog.programdefaultsignals()) = 0 | (name = 'KILL' & wordpos(effect as .string,'5 6') = 0)) then do
        call result.unknown('target.cfg.policy.invalid.signal.instruction'); return result
      end
      if tag = 0 | name = '*' | effect = 0 | effect = 15 | action.certainty() <> 'must' | action.path() = 'failure' then do
        call result.unknown('target.cfg.policy.dynamic.tag.or.effect'); return result
      end
      if effect = 12 then call result.push(tag,operation)
      else if effect = 13 then do
        if result.pop(tag) = 0 then do; call result.unknown('target.cfg.policy.pop.without.source.save'); return result; end
      end
      else call result.install(tag,operation)
    end
    return result
  policyedgeaccepts: method = .int
    arg row = .int, state = .policystate
    i = .int
    if state.reason() <> '' then return 1
    if _roles[row] = 'normal' | _roles[row] = 'table' | _bounds[row] = 'instruction-self-error' then return 1
    if _edgeinstall[row] = 0 & wordpos(_exposures[row],'inherited inherited-async') = 0 then return 1
    names = translate(_signals[row],' ','|')
    if _signals[row] = '*' then do
      /* Unauthored names retain their inherited parameter. */
      if _edgeinstall[row] = 0 then return 1
      do i = 1 to state.tags()
        if reserve(0,1) = 0 then return 0
        if state.installation(i) = _edgeinstall[row] then return 1
      end
      return 0
    end
    do i = 1 to words(names)
      tag = tagindex(word(names,i)); installation = 0
      if tag > 0 then installation = state.installation(tag)
      if installation = _edgeinstall[row] then return 1
    end
    return 0
  correlatepolicy: method = .void
    arg first = .int[]
    source = dereference _owner; profile = dereference _profile; catalog = .llrxascatalog..catalog()
    state = .policystate; incoming = .policystate; outgoing = .policystate; selected = .policystate
    item = .lltarget..record; installed = .lltarget..record
    ignored = .int; tag = .int; row = .int; head = .int; id = .int; f = .int; i = .int; ordinal = .int
    name = .string; view = .lltargettransfer..instruction; action = .lltargettransfer..action; value = .lltarget..operand
    /* Stable tag order is the first canonical policy-source occurrence. */
    do i = 1 to _policynames[0]
      name = _policynames[i]
      if name = '*' | tagindex(name) > 0 then iterate
      if reserve(length(name) + 16,1) = 0 then return
      _tags[_tags[0] + 1] = name
    end
    do i = 1 to source.records()
      item = source.record(i)
      if item.kind() = 'procedure' then iterate
      view = profile.instruction(item.id())
      do ordinal = 1 to view.actions()
        if reserve(0,1) = 0 then return
        action = view.action(ordinal); value = action.literal()
        if action.kind() <> 'policy' | action.sourcekind() <> 'literal' | value.kind() <> 'S' then iterate
        name = upper(value.text())
        if name = '*' | tagindex(name) > 0 then iterate
        if reserve(length(name) + 16,1) = 0 then return
        _tags[_tags[0] + 1] = name
      end
    end
    if reserve(_from[0] * 8,_from[0]) = 0 then return
    do row = 1 to _from[0]; _edgepossible[row] = 0; end
    do f = 2 to first[0]
      if first[f] = 0 then iterate
      state = .policystate(f,_tags[0]); ignored = addpolicypoint(first[f],state)
      if _status <> 'building' then return
    end
    head = 1
    do while head <= _policystates[0]
      id = _policypoints[head]; incoming = _policystates[head]; head = head + 1
      if reserve(incoming.bytes(),incoming.tags() + incoming.saves() + 1) = 0 then return
      outgoing = policytransfer(id,incoming); item = source.at(id); row = _stagefirst[id]
      do while row > 0
        if reserve(incoming.bytes(),incoming.tags() + incoming.saves() + 1) = 0 then return
        selected = incoming.copy()
        if _roles[row] = 'normal' | _roles[row] = 'table' | _asynchronous[row] | _phases[row] = 'after' then selected = outgoing.copy()
        if _bounds[row] = 'instruction-self-error' then selected = incoming.copy()
        if _phases[row] = 'partial' | _phases[row] = 'unknown' then do
          if incoming.key() <> outgoing.key() then call selected.unknown('target.cfg.policy.failure.phase.unproved')
        end
        /* Source POP failure has no successful continuation. It never uses
         * an inherited save stack even when inherited policy is unknown. */
        feasible = 1
        if wordpos(outgoing.reason(),'target.cfg.policy.pop.without.source.save target.cfg.policy.invalid.signal.instruction') > 0 & (_roles[row] = 'normal' | _asynchronous[row]) then feasible = 0
        if feasible & policyedgeaccepts(row,selected) then do
          if _edgeinstall[row] > 0 & selected.reason() = '' then do
            installed = source.at(_edgeinstall[row]); effect = catalog.policyeffect(installed.opcode())
            if wordpos(effect as .string,'7 9 14') > 0 then do
              tag = tagindex(_signals[row])
              if tag > 0 then call selected.unwind(selected.marker(tag))
            end
          end
          ignored = addedgepolicy(row,selected)
          if _status <> 'building' then return
          if _to[row] > 0 then ignored = addpolicypoint(_to[row],selected)
          if _status <> 'building' then return
        end
        row = _stagenext[row]
      end
    end
    return
  run: method = .void
    if _status <> 'building' then return
    i = .int; j = .int; n = .int; id = .int; f = .int; row = .int; ordinal = .int; dest = .int; code = .int
    resources = .int; bit = .int; obligations = .int; overlap = .int
    phase = .string; signalname = .string; role = .string; reason = .string; known = .int
    body = .lltarget..body; item = .lltarget..record; field = .lltarget..operand
    action = .lltargettransfer..action; ref = .lltargettransfer..refview
    fn = .llir..function; point = .llir..opdraft; result = .llir..opview
    blocks = .llir..block[]; functions = .llir..function[]; first = .int[]; last = .int[]
    policyseeds = .int[]
    if _worklimit < 1 | _bytelimit < 1 then do; call reject('limit','LL_RESOURCE_LIMIT: target.cfg budgets'); return; end
    if <refvalid>(_owner) = 0 | <refvalid>(_profile) = 0 then do; call reject('invalid','LL_TARGET_OWNER: expired CFG input'); return; end
    target = dereference _owner; profile = dereference _profile
    if target.valid() = 0 | profile.matches(_owner) = 0 then do; call reject('invalid','LL_TARGET_OWNER: CFG profile mismatch'); return; end
    _revision = target.identity(); _profileid = profile.identity(); source_ref = target.ir(); source = dereference source_ref; store_ref = source.storage(); store = dereference store_ref
    if source.operations() > (_bytelimit - _bytes) <idiv> 512 then do; call reject('limit','LL_RESOURCE_LIMIT: target.cfg projection'); return; end
    if reserve(source.operations() * 512 + source.blocks() * 16 + source.functions() * 48,source.operations() + source.blocks() + source.functions()) = 0 then return
    if reserve(source.operations() * 8 + 64,source.operations()) = 0 then return
    do i = 1 to source.operations()
      _projected[i] = 0; _block[i] = 0; _next[i] = 0; _stagefirst[i] = 0; _stagelast[i] = 0
      policyseeds[i] = 0; _policyheads[i] = 0; _policylasts[i] = 0
    end
    do i = 1 to source.operations() + 1; _outfirst[i] = 0; _outlast[i] = 0; _outcount[i] = 0; end
    do i = 1 to source.blocks(); _group[i] = 0; end
    schema = contract(); builder = .llir..builder(schema,_worklimit,_bytelimit)
    origin = builder.synthetic('checked target analysis projection')
    fn = builder.function('$target.catalogue',schema.voidtype()); sentinel = fn.block('catalogue'); call sentinel.returnvoid(origin)
    do n = 1 to target.procedures()
      body = target.procedure(n); f = body.functionid(); fn = builder.function(body.name(),schema.voidtype()); functions[f] = fn
      _normal[f] = target.normalcfgcomplete(f); _exceptional[f] = 1; _async[f] = 1; _local[f] = _normal[f]; _localreason[f] = ''; _policyexact[f] = 1; first[f] = 0; last[f] = 0
      do j = 1 to body.records()
        if reserve(0,1) = 0 then return
        item = body.record(j)
        if item.kind() = 'procedure' then iterate
        id = item.id(); blocks[id] = fn.block('point.' || id); _block[id] = blocks[id].id()
        if first[f] = 0 then first[f] = id
        if last[f] > 0 then _next[last[f]] = id
        last[f] = id
        if _group[item.blockid()] = 0 then _group[item.blockid()] = id
      end
      if first[f] = 0 then do
        sentinel = fn.block('empty'); call sentinel.returnvoid(origin)
        _normal[f] = 0; _exceptional[f] = 0; _async[f] = 0; _local[f] = 0
      end
    end
    catalog = .llrxascatalog..catalog()
    do n = 1 to target.procedures()
      body = target.procedure(n); f = body.functionid()
      do j = 1 to body.records()
        if reserve(0,1) = 0 then return
        item = body.record(j); id = item.id()
        if item.kind() <> 'instruction' then iterate
        code = item.opcode()
        /* A typed effect can describe pending-bit control without changing
         * the structural handler table. Only POLICY_WRITE installs policy. */
        if (catalog.signalproperties(code) <idiv> 8) % 2 then do
          name = policyname(item)
          if reserve(32 + length(name),1) = 0 then return
          p = _policyops[0] + 1; _policyops[p] = id; _policyfunction[p] = f; _policynames[p] = name
          if catalog.policyeffect(code) = 15 then _local[f] = 0
        end
      end
    end
    do n = 1 to target.records()
      if reserve(0,1) = 0 then return
      item = target.record(n); id = item.id(); f = item.procedureid()
      if f < 2 | item.kind() = 'procedure' then iterate
      if item.kind() <> 'instruction' then do
        if _next[id] > 0 then call stage(id,_next[id],'normal')
        else call stage(id,0,'terminal','none','end',f as .string)
        iterate
      end
      op = source.operation(id); code = item.opcode(); arity = lltarget..normalsuccessors(code)
      if arity = -2 then do
        call stage(id,0,'unknown','unknown','normal-target',id as .string,'',0,'normal.successor.unknown'); _normal[f] = 0
      end
      else if op.successors() > 0 then do
        do ordinal = 1 to op.successors()
          dest = resolveblock(op.successor(ordinal))
          if dest = 0 then do
            call stage(id,0,'unknown','none','normal-target',id || '.' || ordinal,'',0,'normal.target.unavailable'); _normal[f] = 0
          end
          else call stage(id,dest,'normal')
        end
      end
      else if arity = -1 | lltarget..normalfallthrough(code) then do
        if _next[id] > 0 then call stage(id,_next[id],'normal')
        else do
          call stage(id,0,'unknown','none','falloff',id as .string,'',0,'normal.falloff.unknown'); _normal[f] = 0
        end
      end
      else call stage(id,0,'terminal','none','departure',id as .string)
      if profile.premise() = 'canonical' then do
        if catalog.callinvokes(code) then call callcausepaths(item)
        aggregate = 1
        if catalog.callinvokes(code) then aggregate = profile.callcausescomplete(id) = 0
        if catalog.signalstate(code) <> 0 & aggregate then do
          phase = word('none before after partial unknown',catalog.signalphase(code) + 1)
          if catalog.signalproperties(code) <idiv> 64 % 2 then do
            call stage(id,0,'terminal',phase,'instruction-self-error',id as .string,catalog.signalnames(code))
            if catalog.signalsource(code) <> 1 then do
              names = raisednames(item)
              if names <> '' then call signalpaths(item,phase,names)
            end
          end
          else call signalpaths(item,phase,raisednames(item))
          if profile.defaulthalt(f) = 0 then _exceptional[f] = 0
        end
        /* A finalizer/native hook can queue a signal during this operation
         * even when its intrinsic contract is NONE. Its names and checkpoint
         * are unknown; an ambient after-operation interrupt is a distinct
         * producer and cannot stand in for these synchronous alternatives. */
        if profile.callbackobligations(id) <> 0 then do
          /* This exact whole-operation inventory, including UNKNOWN, is the
           * same public resource-route premise used by native flow. It says
           * nothing about pointee values or absence of queued interrupts. */
          policyseeds[id] = profile.callbackpolicyunknown(id)
          call signalpaths(item,'unknown','*',0,1,policyseeds[id])
        end
        if catalog.flow(code) <> 3 then call signalpaths(item,'after','*',1)
        if profile.defaulthalt(f) = 0 then _async[f] = 0
      end
      else do
        view = profile.instruction(id)
        if view.complete('signals') = 0 then do
          call stage(id,0,'unknown','unknown','signal-contract',id as .string,'',0,view.unknownreason('signals')); _exceptional[f] = 0
          _local[f] = 0
        end
        do a = 1 to view.actions()
          if reserve(0,1) = 0 then return
          action = view.action(a)
          if action.kind() <> 'edge' & action.kind() <> 'raise' then iterate
          role = action.detail(); phase = action.phase(); signalname = ''; field = action.literal()
          if action.sourcekind() = 'literal' & field.kind() = 'S' then signalname = field.text()
          if wordpos(role,'normal table skip handler resumed async unwind terminal unknown') = 0 then role = 'unknown'
          dest = 0
          if action.subject() > 0 then do
            ref = profile.ref(action.subject()); field = ref.operand()
            if ref.kind() <> 'label' then do; call reject('invalid','LL_TARGET_CFG: edge subject is not label'); return; end
            dest = resolveblock(target.labelblock(f,field.text()))
            if dest = 0 then do; call reject('invalid','LL_TARGET_CFG: unresolved operational edge'); return; end
          end
          if dest > 0 then call stage(id,dest,role,phase,'','',signalname)
          else do
            known = action.certainty() <> 'unknown' & role <> 'unknown'; reason = ''
            if known = 0 then reason = 'operational.edge.destination.unknown'
            call stage(id,0,role,phase,'operational-' || role,action.id() as .string,signalname,known,reason)
            if known = 0 then do; _exceptional[f] = 0; _local[f] = 0; end
          end
        end
      end
    end
    if profile.premise() = 'canonical' then do
      call propagatepolicy(policyseeds,first)
      if _status <> 'building' then return
    end
    call correlatepolicy(first)
    if _status <> 'building' then return
    do n = 1 to target.records()
      item = target.record(n); id = item.id(); f = item.procedureid()
      if f < 2 | item.kind() = 'procedure' then iterate
      point = blocks[id].operation(schema.operation('rxas.target.analysis.point'),origin)
      call point.attribute('source',bits(id))
      row = _stagefirst[id]
      do while row > 0
        if reserve(0,1) = 0 then return
        if _to[row] > 0 then call point.successor(blocks[_to[row]])
        row = _stagenext[row]
      end
      result = point.finish(); _projected[id] = result.id(); _source[result.id()] = id
    end
    if builder.error() <> '' then do; call reject('invalid',builder.error()); return; end
    _ir = builder.finish()
    if _ir.error() <> '' then do; call reject('invalid',_ir.error()); return; end
    _edges = .llirgraph..edgeprofile(reference _ir,_worklimit - _work,_bytelimit - _bytes)
    ordinals = .int[]
    do i = 1 to _ir.operations(); ordinals[i] = 0; end
    do row = 1 to _from[0]
      id = _from[row]; projected = _projected[id]; ordinal = 0; dest = 0
      if _to[row] > 0 then do
        ordinal = ordinals[projected] + 1; ordinals[projected] = ordinal; dest = _block[_to[row]]
        call _edges.put(projected,ordinal,_roles[row],_phases[row],_signals[row])
      end
      else call _edges.boundary(projected,_roles[row],_phases[row],_bounds[row],_boundids[row],_signals[row],_known[row],_reasons[row])
      item = target.at(id)
      _rows[row] = edgerow(row,projected,ordinal,dest)
      if _status <> 'building' then return
      call indexrow(id,row)
    end
    /* Synthetic catalogue/empty blocks have no actual successors. Their
     * terminal boundaries are visible too, with source operation zero. */
    projectionstore_ref = _ir.storage(); projectionstore = dereference projectionstore_ref
    do b = 1 to _ir.blocks()
      lastop = projectionstore.get(2,b,3)
      if lastop <= _source[0] then do; if _source[lastop] > 0 then iterate; end
      if reserve(160,1) = 0 then return
      row = _rows[0] + 1; f = projectionstore.get(2,b,1)
      call _edges.boundary(lastop,'terminal','none','synthetic-end',b as .string)
      _rows[row] = .lltargetcfg..edge(row,0,lastop,b,f,'terminal',0,0,'synthetic-end',b as .string,'','none',1,'','local',0)
      call indexrow(0,row)
    end
    if _edges.seal() = 0 then do; call reject(_edges.status(),_edges.message()); return; end
    _work = _work + _edges.usedwork(); _bytes = _bytes + _edges.usedbytes()
    _index = .llirgraph..index.typed(reference _ir,reference _edges,_worklimit - _work,_bytelimit - _bytes)
    if _index.status() <> 'ok' then do; call reject(_index.status(),_index.message()); return; end
    _work = _work + _index.usedwork(); _bytes = _bytes + _index.usedbytes(); _status = 'ok'
    return
  valid: method = .int
    call run()
    if _status <> 'ok' | <refvalid>(_owner) = 0 | <refvalid>(_profile) = 0 then return 0
    target = dereference _owner; profile = dereference _profile
    return target.valid() & target.identity() = _revision & profile.matches(_owner) & profile.identity() = _profileid & _index.valid()
  matches: method = .int
    arg owner = reference .lltarget..module, profile = reference .lltargettransfer..profile
    return valid() & (_owner <refsame> owner) & (_profile <refsame> profile)
  require: method = .void
    if valid() = 0 then call bad('LL_TARGET_OWNER: CFG expired, incomplete or replaced')
    return
  status: method = .string
    call run()
    if _status = 'ok' & valid() = 0 then return 'invalid'
    return _status
  message: method = .string
    if _status = 'ok' & valid() = 0 then return 'LL_TARGET_OWNER: stale CFG input'
    return _message
  identity: method = .int
    call run()
    if _status <> 'ok' then return 0
    return _index.identity()
  revision: method = .int
    return _revision
  owner: method = reference .lltarget..module
    call require(); return _owner
  profile: method = reference .lltargettransfer..profile
    call require(); return _profile
  ir: method = reference .llir..module
    call require(); return reference _ir
  index: method = reference .llirgraph..index
    call require(); return reference _index
  sourceop: method = .int
    arg projected = .int
    call require()
    if projected < 1 | projected > _ir.operations() then call bad('LL_TARGET_CFG: projected operation ordinal')
    if projected > _source[0] then return 0
    return _source[projected]
  projectedop: method = .int
    arg source = .int
    call require()
    if source < 1 | source > _projected[0] then call bad('LL_TARGET_CFG: source operation ordinal')
    return _projected[source]
  projectedblock: method = .int
    arg source = .int
    call require()
    if source < 1 | source > _block[0] then call bad('LL_TARGET_CFG: source block ordinal')
    return _block[source]
  edges: method = .int
    call require(); return _rows[0]
  edge: method = .lltargetcfg..edge
    arg id = .int
    call require()
    if id < 1 | id > _rows[0] then call bad('LL_TARGET_CFG: edge ordinal')
    return _rows[id]
  outedges: method = .int
    arg source = .int
    call require()
    if source < 0 | source + 1 > _outcount[0] then call bad('LL_TARGET_CFG: source edge identity')
    return _outcount[source + 1]
  outedge: method = .lltargetcfg..edge
    arg source = .int, ordinal = .int
    call require()
    if ordinal < 1 | ordinal > outedges(source) then call bad('LL_TARGET_CFG: source edge ordinal')
    row = _outfirst[source + 1]
    do i = 2 to ordinal; row = _outnext[row]; end
    return _rows[row]
  checksource: method = .void
    arg source = .int
    call require()
    if source < 0 | source > _projected[0] then call bad('LL_TARGET_CFG: source identity')
    if source > 0 then do
      if _projected[source] = 0 then call bad('LL_TARGET_CFG: source is not a projected record')
    end
    return
  physicaldeparture: method = .int
    arg source = .int
    call checksource(source)
    if source = 0 then return 0
    target = dereference _owner; item = target.at(source)
    if item.kind() <> 'instruction' then return 0
    catalog = .llrxascatalog..catalog(); return catalog.flow(item.opcode()) = 3
  normalcomplete: method = .int
    arg functionid = .int
    call require(); return _normal[functionid]
  exceptionalcomplete: method = .int
    arg functionid = .int
    call require(); return _exceptional[functionid]
  asynchronouscomplete: method = .int
    arg functionid = .int
    call require(); return _async[functionid]
  /** Completeness of possible destinations inside this logical procedure.
   * Foreign handler effects and unknown outward departures remain visible on
   * their edges; this query does not certify their absence or known values. */
  localcomplete: method = .int
    arg functionid = .int
    call require(); return _normal[functionid] & _local[functionid]
  /** Exact policy/path correlation is independent of conservative local
   * destination coverage. Zero never means that no policy is installed. */
  policycorrelationcomplete: method = .int
    arg functionid = .int
    call require(); return _policyexact[functionid]
  /** Entry-read normalization uses a may-read proof over this complete local
   * supergraph. All inherited, resumed and unknown outward effects remain on
   * their existing edges; value/origin/binding completeness belongs to flow. */
  normalizationcomplete: method = .int
    arg functionid = .int
    call require(); return localcomplete(functionid)
  normalizationreason: method = .string
    arg functionid = .int
    call require()
    if localcomplete(functionid) = 0 then do
      if _localreason[functionid] <> '' then return _localreason[functionid]
      return 'signal.local.destinations.unproved'
    end
    return ''
  /** Query completeness at a source point without upgrading function facts. */
  /** Full correlated alternatives; zero alternatives denotes unreachable.
   * Inherited handler entries are symbolic inputs even on proved paths. */
  policyeffect: method = .int
    arg operation = .int, tag = .string
    call checksource(operation); profile = dereference _profile; view = profile.instruction(operation); result = 0
    do i = 1 to view.actions()
      action = view.action(i); value = action.literal()
      if action.kind() <> 'policy' | action.sourcekind() <> 'literal' | value.kind() <> 'S' then iterate
      if upper(value.text()) == upper(tag) then result = action.policyeffect()
    end
    return result
  policytag: method = .string
    arg ordinal = .int
    call require()
    if ordinal < 1 | ordinal > _tags[0] then call bad('LL_TARGET_CFG: policy tag ordinal')
    return _tags[ordinal]
  policytagid: method = .int
    arg tag = .string
    call require(); name = upper(tag)
    do i = 1 to _tags[0]; if _tags[i] == name then return i; end
    return 0
  policiesat: method = .int
    arg operation = .int
    call checksource(operation)
    if operation = 0 then call bad('LL_TARGET_CFG: policy point requires a source record')
    cursor = _policyheads[operation]; count = 0
    do while cursor > 0; count = count + 1; cursor = _policynext[cursor]; end
    return count
  policyat: method = .lltargetcfg..policyfact
    arg operation = .int, ordinal = 1
    call checksource(operation)
    if operation = 0 then call bad('LL_TARGET_CFG: policy point requires a source record')
    cursor = _policyheads[operation]
    do i = 2 to ordinal; if cursor > 0 then cursor = _policynext[cursor]; end
    if cursor = 0 | ordinal < 1 then call bad('LL_TARGET_CFG: policy point alternative')
    return .policyfact(reference self,_policystates[cursor])
  policieson: method = .int
    arg edgeid = .int
    checked = edge(edgeid); count = 0
    if edgeid > _edgepolicyheads[0] then return 0
    cursor = _edgepolicyheads[edgeid]
    do while cursor > 0; count = count + 1; cursor = _edgepolicynext[cursor]; end
    return count
  policyon: method = .lltargetcfg..policyfact
    arg edgeid = .int, ordinal = 1
    checked = edge(edgeid); cursor = 0
    if edgeid <= _edgepolicyheads[0] then cursor = _edgepolicyheads[edgeid]
    do i = 2 to ordinal; if cursor > 0 then cursor = _edgepolicynext[cursor]; end
    if cursor = 0 | ordinal < 1 then call bad('LL_TARGET_CFG: policy edge alternative')
    return .policyfact(reference self,_edgepolicystates[cursor])
  edgefeasible: method = .int
    arg edgeid = .int
    checked = edge(edgeid)
    if edgeid > _edgepossible[0] then return 1
    return _edgepossible[edgeid]
  ingressat: method = .lltargetcfg..ingresscone
    arg operation = .int, work = 1000000, bytes = 67108864
    return .ingresscone(reference self,operation,work,bytes)
  usedwork: method = .int
    return _work
  usedbytes: method = .int
    return _bytes
