      if _expanded = 0 & _saved[0] <> restoration.saves() then do; ignored = fail('unknown','target.diagnostic.clone.entry.getter.missing'); return; end
      if ordinal > originalops[0] then do; ignored = fail('invalid','target.diagnostic.clone.source.extra'); return; end
      if id <> originalops[ordinal] then do; ignored = fail('invalid','target.diagnostic.clone.source.order.or.coverage'); return; end
      ordinal = ordinal + 1; sourceitem = source.at(id)
      do while cursor <= copiedops[0]
        if spend(1) = 0 then return
        if copiedops[cursor] >= _first[i] then leave
        cursor = cursor + 1
      end
      if cursor > copiedops[0] then do; ignored = fail('invalid','target.diagnostic.clone.candidate.missing'); return; end
      if copiedops[cursor] <> _first[i] | _counts[i] < 1 | _counts[i] > copiedops[0] - cursor + 1 then do; ignored = fail('invalid','target.diagnostic.clone.region.invalid'); return; end
      if previous > 0 & cursor <> previous + 1 then do; ignored = fail('invalid','target.diagnostic.clone.region.gap'); return; end
      first = candidate.at(copiedops[cursor]); last = candidate.at(copiedops[cursor + _counts[i] - 1])
      if firstaddress < 0 then firstaddress = candidate.inlineaddress(first.id())
      endaddress = candidate.inlineaddress(last.id()) + last.operands() + 1
      returnkind = catalog.returnkind(sourceitem.opcode())
      if returnkind = 0 then do
        /* Expanded rows retain these diagnostic/coverage checks. Their
         * semantic recipes belong to the correspondence and final theorem;
         * a valid base-sensitive binding need not keep the source opcode. */
        if _expanded = 0 then do
          if _counts[i] <> 1 | first.opcode() <> sourceitem.opcode() | first.operands() <> sourceitem.operands() then do; ignored = fail('unknown','target.diagnostic.clone.instruction.mismatch'); return; end
          do j = 1 to sourceitem.operands()
            if sameoperand(sourceitem.operand(j),first.operand(j),callitem,source,candidate,f) = 0 then do; ignored = fail('unknown','target.diagnostic.clone.operand.mismatch'); return; end
          end
        end
      end
      else do
        /* Match the licensed result/restore/branch sequence, preserving
         * every field's order and exact literal or captured saved cell. */
        if last.mnemonic() <> 'br' | last.operands() <> 1 then do; ignored = fail('unknown','target.diagnostic.clone.return.branch.missing'); return; end
        if _expanded then do
          value = last.operand(1)
          if previouscontinuation = '' then previouscontinuation = value.text()
          if value.text() <> previouscontinuation | value.text() <> _instance.continuation() then do; ignored = fail('unknown','target.diagnostic.clone.return.continuation.mismatch'); return; end
        end
        else do
        expected = restoration.fields() + 1; resultops = 0
        if catalog.callresult(callitem.opcode()) > 0 & returnkind > 1 then do
          resultops = 1
          if returnkind = 3 | returnkind = 4 then resultops = 2
          expected = expected + resultops
        end
        if _counts[i] <> expected then do; ignored = fail('unknown','target.diagnostic.clone.return.lowering.unproved'); return; end
        if resultops > 0 then do
          result = callitem.operand(catalog.callresult(callitem.opcode()))
          setter = first
          if returnkind = 3 | returnkind = 4 then do
            if first.mnemonic() <> 'load' | first.operands() <> 2 then do; ignored = fail('unknown','target.diagnostic.clone.return.lowering.unproved'); return; end
            value = first.operand(1); other = first.operand(2); original = sourceitem.operand(catalog.returnsource(sourceitem.opcode()))
            if value.kind() <> 'R' | value.bank() <> 'r' | value.index() < caller.locals() | samevalue(other,original) = 0 then do; ignored = fail('unknown','target.diagnostic.clone.return.literal.mismatch'); return; end
            do savedordinal = 1 to _saved[0]
              reserved = _saved[savedordinal]
              if reserved.bank() = value.bank() & reserved.index() = value.index() then do; ignored = fail('unknown','target.diagnostic.clone.return.saved.slot.overwrite'); return; end
            end
            setter = candidate.at(copiedops[cursor + 1]); expectedname = 'icopy'; if returnkind = 4 then expectedname = 'fcopy'
            if setter.mnemonic() <> expectedname | setter.operands() <> 2 then do; ignored = fail('unknown','target.diagnostic.clone.return.setter.mismatch'); return; end
            other = setter.operand(2)
            if other.kind() <> 'R' | other.bank() <> value.bank() | other.index() <> value.index() then do; ignored = fail('unknown','target.diagnostic.clone.return.literal.mismatch'); return; end
          end
          else if returnkind = 2 then do
            permission = owner.directplan(_call); expectedname = permission.returnmode(sourceitem.id())
            if wordpos(expectedname,'copy move') = 0 | setter.mnemonic() <> expectedname | setter.operands() <> 2 then do; ignored = fail('unknown','target.diagnostic.clone.return.setter.mismatch'); return; end
            original = sourceitem.operand(catalog.returnsource(sourceitem.opcode()))
            if sameoperand(original,setter.operand(2),callitem,source,candidate,f) = 0 then do; ignored = fail('unknown','target.diagnostic.clone.return.value.mismatch'); return; end
          end
          else do
            if setter.mnemonic() <> 'load' | setter.operands() <> 2 then do; ignored = fail('unknown','target.diagnostic.clone.return.setter.mismatch'); return; end
            original = sourceitem.operand(catalog.returnsource(sourceitem.opcode()))
            if samevalue(original,setter.operand(2)) = 0 then do; ignored = fail('unknown','target.diagnostic.clone.return.literal.mismatch'); return; end
          end
          value = setter.operand(1)
          if value.kind() <> 'R' | value.bank() <> result.bank() | value.index() <> result.index() then do; ignored = fail('unknown','target.diagnostic.clone.return.result.mismatch'); return; end
        end
        if restoration.fields() > 0 then do
          matchedexit = 0
          do exitid = 1 to restoration.exits()
            if restoration.exit(exitid) = sourceitem.id() then do; matchedexit = 1; leave; end
          end
          if matchedexit = 0 then do; ignored = fail('unknown','target.diagnostic.clone.return.exit.unlicensed'); return; end
          do fieldid = 1 to restoration.fields()
            setter = candidate.at(copiedops[cursor + resultops + fieldid - 1])
            if setter.mnemonic() <> restoration.setter(fieldid) | setter.operands() <> 1 then do; ignored = fail('unknown','target.diagnostic.clone.return.context.setter.mismatch'); return; end
            value = setter.operand(1)
            if restoration.mode(fieldid) = 'literal' then do
              if samevalue(value,restoration.literal(fieldid)) = 0 then do; ignored = fail('unknown','target.diagnostic.clone.return.context.literal.mismatch'); return; end
            end
            else if restoration.mode(fieldid) = 'saved' then do
              savedordinal = restoration.saveordinal(fieldid)
              if savedordinal < 1 | savedordinal > _saved[0] then do; ignored = fail('unknown','target.diagnostic.clone.entry.getter.missing'); return; end
              reserved = _saved[savedordinal]
              if value.kind() <> 'R' | value.bank() <> reserved.bank() | value.index() <> reserved.index() then do; ignored = fail('unknown','target.diagnostic.clone.return.context.saved.slot.mismatch'); return; end
            end
            else do; ignored = fail('unknown','target.diagnostic.clone.return.context.mode.unproved'); return; end
          end
        end
        value = last.operand(1)
        if previouscontinuation = '' then previouscontinuation = value.text()
        if value.text() <> previouscontinuation then do; ignored = fail('unknown','target.diagnostic.clone.return.continuation.mismatch'); return; end
        end
      end
      do k = cursor to cursor + _counts[i] - 1
        if spend(1) = 0 then return
        copied = candidate.at(copiedops[k])
        if covered[copied.id()] | sameorigin(sourceitem.origin(),copied.origin()) = 0 | samechain(source,sourceitem,candidate,copied) = 0 then do; ignored = fail('unknown','target.diagnostic.clone.source.or.map.mismatch'); return; end
        if sameanchor(source,stepat(source,sourceitem.id()),candidate,stepat(candidate,copied.id())) = 0 then do; ignored = fail('unknown','target.diagnostic.clone.active.source.step.mismatch'); return; end
        covered[copied.id()] = 1
      end
      previous = cursor + _counts[i] - 1; cursor = previous + 1
    end
    if ordinal <> originalops[0] + 1 | candidate.inlineaddress(frame.id()) <> firstaddress then do; ignored = fail('unknown','target.diagnostic.clone.entry.or.source.coverage'); return; end
    if previouscontinuation <> '' then do
      found = 0
      do i = 1 to receiver.records()
        if spend(1) = 0 then return
        row = receiver.record(i)
        if row.kind() <> 'label' then iterate
        value = row.operand(1)
        if value.text() <> previouscontinuation then iterate
        found = candidate.inlineaddress(row.id()) = endaddress; leave
      end
      if found = 0 then do; ignored = fail('unknown','target.diagnostic.clone.return.continuation.mismatch'); return; end
    end
    /* Every instruction attributed to this root (including descendants) must
     * have exactly one source region. Disjoint unrelated sites are ignored. */
    do i = 1 to copiedops[0]
      if spend(candidate.inlineframes() + 1) = 0 then return
      copied = candidate.at(copiedops[i]); mapped = candidate.inlineframeat(copied.id()); belongs = 0
      if entrycovered[copied.id()] then iterate
      do depth = 1 to candidate.inlineframes() + 1
        if mapped = 0 then leave
        if mapped = _frame then do; belongs = 1; leave; end
        nested = candidate.inlineframe(candidate.inlineframeindex(mapped)); value = nested.operand(2); mapped = value.index()
      end
      if belongs <> covered[copied.id()] then do; ignored = fail('unknown','target.diagnostic.clone.map.coverage'); return; end
    end
    _status = 'proved'
    return
  valid: method = .int
    call run(); return _status = 'proved' & ownersvalid()
  status: method = .string
    call run()
    if _status = 'proved' & ownersvalid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    call run()
    if _status = 'proved' & ownersvalid() = 0 then return 'target.diagnostic.clone.owner.expired.or.replaced'
    return _reason
  owner: method = reference .lltargetsummary..analysis
    return _owner
  operation: method = .int
    return _call
  candidate: method = reference .lltarget..module
    return _candidate
  frame: method = .int
    return _frame
  rows: method = .int
    return _sources[0]
  sourceentry: method = .int
    arg ordinal = .int
    return _sources[ordinal]
  candidateentry: method = .int
    arg ordinal = .int
    return _first[ordinal]
  entrycount: method = .int
    arg ordinal = .int
    return _counts[ordinal]
  usedwork: method = .int
    return _work
  usedbytes: method = .int
    return _bytes

/** Borrowed peer owners supply facts, never target-binding authority. */
providerbundle: class
  _flow = reference .lltargetflow..analysis
  _summary = reference .lltargetsummary..analysis
  _flowid = .int
  _summaryid = .int
  *: factory
    arg flow = reference .lltargetflow..analysis, summaries = reference .lltargetsummary..analysis
    _flow = flow; _summary = summaries
    points = dereference flow; effects = dereference summaries
    _flowid = points.identity(); _summaryid = effects.identity()
    return
  valid: method = .int
    if <refvalid>(_flow) = 0 | <refvalid>(_summary) = 0 then return 0
    points = dereference _flow; effects = dereference _summary
    actual = effects.flow()
    return points.valid() & effects.valid() & points.identity() = _flowid & effects.identity() = _summaryid & (actual <refsame> _flow)
  points: method = reference .lltargetflow..analysis
    return _flow
  summaries: method = reference .lltargetsummary..analysis
    return _summary

/** Point-local observation preservation is not callback absence or permission
 * to move a write across earlier operations. Both checkpoint owners survive. */
preservationfact: class
  _proof = .siteproof
  _source = .lltargetflow..callbackfact
  _candidate = .lltargetflow..callbackfact
  _correspondence = reference .lltargetremap..correspondence
  _hascorrespondence = .int
  *: factory
    arg proof = .siteproof, source = .lltargetflow..callbackfact, candidate = .lltargetflow..callbackfact, ?correspondence = reference .lltargetremap..correspondence
    _proof = proof; _source = source; _candidate = candidate
    if ?correspondence & proof.status() = 'proved' then do
      if <refvalid>(correspondence) then do; _correspondence = correspondence; _hascorrespondence = 1; end
    end
    return
  valid: method = .int
    if _proof.valid() = 0 | _source.valid() = 0 | _candidate.valid() = 0 then return 0
    if _hascorrespondence then do
      if <refvalid>(_correspondence) = 0 then return 0
      mapping = dereference _correspondence
      if mapping.valid() = 0 then return 0
      sourceflow = _source.points(); candidateflow = _candidate.points()
      before = dereference sourceflow; after = dereference candidateflow
      beforeowner = mapping.sourceowner(); afterowner = mapping.candidateowner()
      beforeprofile = mapping.sourceprofile(); afterprofile = mapping.candidateprofile()
      beforecfg = mapping.sourcecfg(); aftercfg = mapping.candidatecfg()
      actualowner = before.owner(); resultowner = after.owner()
      actualprofile = before.transfers(); resultprofile = after.transfers()
      actualcfg = before.cfg(); resultcfg = after.cfg()
      if (beforeowner <refsame> actualowner) = 0 | (afterowner <refsame> resultowner) = 0 | (beforeprofile <refsame> actualprofile) = 0 | (afterprofile <refsame> resultprofile) = 0 | (beforecfg <refsame> actualcfg) = 0 | (aftercfg <refsame> resultcfg) = 0 then return 0
      event = mapping.event(_source.operation(),_source.ordinal(),_source.edge())
      if event.valid() = 0 then return 0
      if event.candidateoperation() <> _candidate.operation() | event.candidateordinal() <> _candidate.ordinal() | event.candidateedge() <> _candidate.edge() then return 0
    end
    return 1
  status: method = .string
    if _proof.status() = 'limit' | _source.status() = 'limit' | _candidate.status() = 'limit' then return 'limit'
    if valid() = 0 then return 'invalid'
    return _proof.status()
  reason: method = .string
    if _proof.status() = 'limit' then return _proof.reason()
    if _source.status() = 'limit' then return _source.reason()
    if _candidate.status() = 'limit' then return _candidate.reason()
    if valid() = 0 then return 'target.callback.preservation.owner.expired.or.replaced'
    return _proof.reason()
  preserved: method = .int
    return status() = 'proved'
  source: method = .lltargetflow..callbackfact
    return _source
  candidate: method = .lltargetflow..callbackfact
    return _candidate

/** Explicit argument/global substitution keeps pointee effects, but may not replace
 * a callee-private pointer slot by the caller's slot without this proof.
 * Window geometry and addressed references retain their separate obligations. */
directmappingfact: class
  _proof = .siteproof
  _target = .lltargetflow..targetfact
  _hastarget = .int
  *: factory
    arg proof = .siteproof, ?target = .lltargetflow..targetfact
    _proof = proof; _hastarget = ?target
    if ?target then _target = target
    return
  valid: method = .int
    if _proof.valid() = 0 then return 0
    if _hastarget then return _target.valid()
    return 1
  status: method = .string
    if _proof.status() = 'limit' then return 'limit'
    if valid() = 0 then return 'invalid'
    return _proof.status()
  reason: method = .string
    if _proof.status() = 'limit' then return _proof.reason()
    if valid() = 0 then return 'target.argument.mapping.owner.expired.or.replaced'
    return _proof.reason()
  allowed: method = .int
    return status() = 'proved'

/** A numeric context delta for one exact call. Activation, initializer,
 * result and storage proofs remain independent obligations. Saved fields use
 * dedicated appended integer-only cells. Their complete write inventory,
 * rather than assumed recycled freshness, preserves resource absence.
 * Restores follow result transfer at every copied return, including dead
 * returns that a generic emitter preserves. Departure proof considers only
 * graph-reachable execution. */
restorationfact: class
  _bound = .int
  _proof = .siteproof
  _operation = .int
  _procedure = .int
  _domains = .int[]
  _modes = .string[]
  _getters = .string[]
  _setters = .string[]
  _literals = .lltarget..operand[]
  _saveordinals = .int[]
  _saves = .int
  _exits = .int[]
  *: factory
    return
  bound: factory
    arg proof = .siteproof, operation = .int, procedureid = .int, domains = .int[], modes = .string[], getters = .string[], setters = .string[], literals = .lltarget..operand[], saveordinals = .int[], saves = .int, exits = .int[]
    _bound = 1; _proof = proof; _operation = operation; _procedure = procedureid
    _domains = domains; _modes = modes; _getters = getters; _setters = setters
    _literals = literals; _saveordinals = saveordinals; _saves = saves; _exits = exits
    return
  valid: method = .int
    if _bound = 0 then return 0
    return _proof.valid()
  status: method = .string
    if _bound = 0 then return 'invalid'
    return _proof.status()
  reason: method = .string
    if _bound = 0 then return 'target.context.restore.unbound'
    return _proof.reason()
  allowed: method = .int
    return valid() & status() = 'proved'
  require: method = .void
    if _bound = 0 then assembler signal "ERROR","LL_TARGET_SITE: unbound restoration plan"
    call _proof.require()
    return
  row: method = .void
    arg ordinal = .int
    call require()
    if ordinal < 1 | ordinal > _domains[0] then assembler signal "ERROR","LL_TARGET_SITE: restoration field ordinal"
    return
  operation: method = .int
    if valid() = 0 then return 0
    return _operation
  procedure: method = .int
    if valid() = 0 then return 0
    return _procedure
  fields: method = .int
    call require(); return _domains[0]
  domain: method = .int
    arg ordinal = .int
    call row(ordinal); return _domains[ordinal]
  mode: method = .string
    arg ordinal = .int
    call row(ordinal); return _modes[ordinal]
  getter: method = .string
    arg ordinal = .int
    call row(ordinal); return _getters[ordinal]
  setter: method = .string
    arg ordinal = .int
    call row(ordinal); return _setters[ordinal]
  literal: method = .lltarget..operand
    arg ordinal = .int
    call row(ordinal); return _literals[ordinal]
  saveordinal: method = .int
    arg ordinal = .int
    call row(ordinal); return _saveordinals[ordinal]
  saves: method = .int
    call require(); return _saves
  exits: method = .int
    call require(); return _exits[0]
  exit: method = .int
    arg ordinal = .int
    call require()
    if ordinal < 1 | ordinal > _exits[0] then assembler signal "ERROR","LL_TARGET_SITE: restoration exit ordinal"
    return _exits[ordinal]

scopefreefact: class
  _proof = .siteproof
  _allowed = .int
  _diagnosticpending = .int
  _retainedpending = .int
  _returnops = .int[]
  _returnmodes = .string[]
  _restoration = .restorationfact
  *: factory
    arg proof = .siteproof, allowed = .int, ?returnops = .int[], ?returnmodes = .string[], ?restoration = .restorationfact, diagnosticpending = 0, retainedpending = 0
    _proof = proof; _allowed = allowed; _diagnosticpending = diagnosticpending; _retainedpending = retainedpending
    if ?returnops then _returnops = returnops
    if ?returnmodes then _returnmodes = returnmodes
    if ?restoration then _restoration = restoration
    return
  valid: method = .int
    return _proof.valid()
  status: method = .string
    if _proof.status() = 'proved' & _retainedpending > 0 then return 'unknown'
    if _proof.status() = 'proved' & _diagnosticpending > 0 then return 'unknown'
    return _proof.status()
  reason: method = .string
    if _proof.status() = 'proved' & _retainedpending > 0 then return 'target.activation.retained.caller.certificate.required'
    if _proof.status() = 'proved' & _diagnosticpending > 0 then return 'target.activation.static.diagnostic.certificate.required'
    return _proof.reason()
  allowed: method = .int
    return semanticallowed() & _diagnosticpending = 0
  semanticallowed: method = .int
    return draftallowed() & _retainedpending = 0
  draftallowed: method = .int
    return valid() & _proof.status() = 'proved' & _allowed
  retainedpending: method = .int
    return _retainedpending
  diagnosticpending: method = .int
    return _diagnosticpending
  restoration: method = .lltargetsummary..restorationfact
    return _restoration
  returnmode: method = .string
    arg sourceReturnOp = .int
    if draftallowed() = 0 then return 'unproved'
    low = 1; high = _returnops[0]
    do while low <= high
      middle = (low + high) <idiv> 2
      if _returnops[middle] = sourceReturnOp then return _returnmodes[middle]
      if _returnops[middle] < sourceReturnOp then low = middle + 1
      else high = middle - 1
    end
    return 'unproved'

/** An owner-bound construction recipe, never a semantic admission receipt.
 * In particular symbolic unknown actual values and dirty owned entry payloads
 * are not converted into absolute availability facts by this recipe. */
expansionplanfact: class
  _proof = .siteproof
  _owner = reference .lltargetsummary..analysis
  _operation = .int
  _target = .lltargetflow..targetfact
  _layout = .layoutfact
  _invocation = .lltargetflow..invocationfact
  _restoration = .restorationfact
  _returns = .int[]
  _modes = .string[]
  *: factory
    arg owner = reference .analysis, operation = .int, proof = .siteproof, target = .lltargetflow..targetfact, layout = .layoutfact, invocation = .lltargetflow..invocationfact, restoration = .restorationfact, returns = .int[], modes = .string[]
    _owner = owner; _operation = operation; _proof = proof; _target = target
    _layout = layout; _invocation = invocation; _restoration = restoration
    _returns = returns; _modes = modes
    return
  valid: method = .int
    return _proof.valid()
  status: method = .string
    return _proof.status()
  reason: method = .string
    return _proof.reason()
  owner: method = reference .lltargetsummary..analysis
    return _owner
  operation: method = .int
    return _operation
  draftallowed: method = .int
    return valid() & status() = 'proved'
  /** A caller cannot publish the draft by mistaking this for scopefree. */
  allowed: method = .int
    return 0
  semanticallowed: method = .int
    return 0
  layout: method = .lltargetsummary..layoutfact
    return _layout
  target: method = .lltargetflow..targetfact
    return _target
  invocation: method = .lltargetflow..invocationfact
    return _invocation
  restoration: method = .lltargetsummary..restorationfact
    return _restoration
  returnmode: method = .string
    arg operation = .int
    if draftallowed() = 0 then return 'unproved'
    do i = 1 to _returns[0]
      if _returns[i] = operation then return _modes[i]
    end
    return 'unproved'

/** An internal receipt for checked entry/body/result phases. It cannot be
 * replaced by a caller-supplied boolean or confer final publication. */
controlreceipt: class
  _owner = reference .analysis
  _mapping = reference .lltargetremap..expansioncorrespondence
  _ownerid = .int
  _mappingid = .int
  _sourceid = .int
  _candidateid = .int
  _catalog = .string
  _ordinal = .int
  _operation = .int
  _procedure = .int
  _nohooks = .string
  _pairedhooks = .string
  _status = .string
  _reason = .string
  _work = .int
  _bytes = .int
  *: factory
    arg relation = reference .expansionequivalencefact, ordinal = .int, work = 1000000, bytes = 67108864
    _status = 'invalid'; _reason = 'target.expansion.frame.checked.phase.unavailable'
    if work < 1 | bytes < 256 then do; _status = 'limit'; _reason = 'target.expansion.frame.checked.phase.work.or.bytes'; return; end
    if <refvalid>(relation) = 0 then return
    parent = dereference relation
    if parent.phasevalid(ordinal,parent.phaseidentity()) = 0 then return
    hookbytes = parent.phasehooklength(ordinal) + parent.phasepairedhooklength(ordinal); catalog = .llrxascatalog..catalog(); fingerprint = catalog.fingerprint()
    if hookbytes > work - length(fingerprint) - 16 | hookbytes > bytes - length(fingerprint) - 256 then do; _status = 'limit'; _reason = 'target.expansion.frame.checked.phase.work.or.bytes'; return; end
    _work = hookbytes + length(fingerprint) + 16; _bytes = hookbytes + length(fingerprint) + 256
    if _work > work | _bytes > bytes then do; _work = 0; _bytes = 0; _status = 'limit'; _reason = 'target.expansion.frame.checked.phase.work.or.bytes'; return; end
    /* Snapshot only external owners and immutable proof data. A prepared
     * relation is returned by value; its own fields are not stable owners. */
    _owner = parent.phaseowner(); _mapping = parent.phasemapping(); _ordinal = ordinal; _nohooks = parent.phasehooks(ordinal); _pairedhooks = parent.phasepairedhooks(ordinal); _catalog = fingerprint
    owner = dereference _owner; mapping = dereference _mapping; _ownerid = owner.identity(); _mappingid = mapping.identity()
    plan = parent.phaseplan(ordinal); target = plan.target(); _operation = plan.operation(); _procedure = target.procedure()
    sourceref = mapping.sourceowner(); candidateref = mapping.candidateowner(); source = dereference sourceref; candidate = dereference candidateref
    _sourceid = source.identity(); _candidateid = candidate.identity(); _status = 'proved'; _reason = ''
    return
  valid: method = .int
    if _status <> 'proved' | <refvalid>(_owner) = 0 | <refvalid>(_mapping) = 0 then return 0
    owner = dereference _owner; mapping = dereference _mapping; catalog = .llrxascatalog..catalog()
    if owner.valid() = 0 | owner.identity() <> _ownerid | mapping.valid() = 0 | mapping.identity() <> _mappingid | catalog.fingerprint() <> _catalog then return 0
    if _ordinal < 1 | _ordinal > mapping.instances() then return 0
    instance = mapping.instance(_ordinal)
    if instance.callid() <> _operation | instance.procedure() <> _procedure then return 0
    sourceref = mapping.sourceowner(); candidateref = mapping.candidateowner(); source = dereference sourceref; candidate = dereference candidateref
    return source.identity() = _sourceid & candidate.identity() = _candidateid
  status: method = .string
    if _status = 'proved' & valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    if _status = 'proved' & valid() = 0 then return 'target.expansion.frame.checked.phase.owner.expired.or.replaced'
    return _reason
  owner: method = reference .analysis
    return _owner
  operation: method = .int
    return _operation
  procedure: method = .int
    return _procedure
  instance: method = .lltargetremap..expansioninstance
    mapping = dereference _mapping; return mapping.instance(_ordinal)
  lookupwork: method = .int
    mapping = dereference _mapping
    return length(_nohooks) + length(_pairedhooks) + (mapping.instances() + 1) * (length(_catalog) + 8) + 8
  nohook: method = .int
    arg operation = .int, ordinal = .int
    if valid() = 0 then return 0
    owner = dereference _owner; flowref = owner.flow(); points = dereference flowref; profileref = points.transfers(); profile = dereference profileref
    instruction = profile.instruction(operation)
    if ordinal < 1 | ordinal > instruction.actions() then return 0
    action = instruction.action(ordinal)
    return wordpos(action.id() as .string,_nohooks) > 0
  pairedhook: method = .int
    arg operation = .int, ordinal = .int
    if valid() = 0 then return 0
    owner = dereference _owner; flowref = owner.flow(); points = dereference flowref; profileref = points.transfers(); profile = dereference profileref
    instruction = profile.instruction(operation)
    if ordinal < 1 | ordinal > instruction.actions() then return 0
    action = instruction.action(ordinal)
    return wordpos(action.id() as .string,_pairedhooks) > 0
  usedwork: method = .int
    return _work
  usedbytes: method = .int
    return _bytes

/** Published frame-control ownership is separate from dirty value backing,
 * result transport, diagnostics and the eventual dispatch certificate. */
framecontrolhistoryfact: class
  _owner = reference .analysis
  _ownerid = .int
  _phase = .controlreceipt
  _call = .int
  _catalog = .string
  _status = .string
  _reason = .string
  _work = .int
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  *: factory
    arg owner = reference .analysis, phase = .controlreceipt, work = 1000000, bytes = 67108864
    _owner = owner; _phase = phase; _worklimit = work; _bytelimit = bytes; _status = 'building'
    if work < 1 | bytes < 256 then do; _status = 'limit'; _reason = 'target.expansion.frame.control.work.or.bytes'; end
    else do; _work = 1; _bytes = 256; end
    return
  fail: method = .int
    arg state = .string, reason = .string
    if _status = 'building' then do; _status = state; _reason = reason; end
    return 0
  spend: method = .int
    arg work = 1, bytes = 0
    if work < 0 | bytes < 0 | work > _worklimit - _work | bytes > _bytelimit - _bytes then return fail('limit','target.expansion.frame.control.work.or.bytes')
    _work = _work + work; _bytes = _bytes + bytes
    return 1
  retireprogram: method = .int
    arg catalog = .llrxascatalog..catalog, opcode = .int
    if catalog.abistate(opcode,'frame-retire') <> 'known' | catalog.abisteps(opcode,'frame-retire') <> 7 then return fail('unknown','target.expansion.frame.control.retire.inventory.unproved')
    do k = 1 to 7
      if spend(8) = 0 then return 0
      expected = word('leave-frame-scopes clear-frame-handlers release-frame-policy release-frame-references abandon-frame-invocation unpin-frame-invocation recycle-frame',k)
      checkpoint = word('retire-scopes retire-handlers retire-policy retire-references retire-invocation-abandon retire-invocation-unpin retire-recycle',k)
      source = word('frame-scopes frame-handlers frame-private-policy frame-references frame-invocation frame-invocation physical-frame',k)
      destination = 'none'; if k = 5 then destination = 'frame-invocation'; if k = 7 then destination = 'procedure-recycler'
      sourceextent = 'none'; if k = 5 | k = 6 then sourceextent = 'full-capacity'
      destinationextent = 'none'; if k = 5 then destinationextent = 'full-capacity'
      rule = 'retiring-frame'; if k = 4 then rule = 'frame-references-marked'; if k = 5 | k = 6 then rule = 'frame-invocation-present'
      if catalog.abioperation(opcode,'frame-retire',k) <> expected | catalog.abicheckpoint(opcode,'frame-retire',k) <> checkpoint | catalog.abisource(opcode,'frame-retire',k) <> source | catalog.abidestination(opcode,'frame-retire',k) <> destination | catalog.abisourceextent(opcode,'frame-retire',k) <> sourceextent | catalog.abidestinationextent(opcode,'frame-retire',k) <> destinationextent | catalog.abirule(opcode,'frame-retire',k) <> rule | catalog.abirepeat(opcode,'frame-retire',k) <> 'once' then return fail('unknown','target.expansion.frame.control.retire.order.unproved')
    end
    return 1
  run: method = .void
    ignored = .int; i = .int; j = .int; k = .int; mask = .int; bit = .int; overlap = .int
    name = .string; expected = .string
    action = .lltargettransfer..action; item = .lltarget..record; edge = .lltargetcfg..edge
    if _status <> 'building' then return
    if <refvalid>(_owner) = 0 | _phase.valid() = 0 then do; ignored = fail('invalid','target.expansion.frame.checked.phase.unavailable'); return; end
    actualowner = _phase.owner()
    if (actualowner <refsame> _owner) = 0 then do; ignored = fail('invalid','target.expansion.frame.checked.phase.owner.mismatch'); return; end
    owner = dereference _owner; _ownerid = owner.identity(); flowref = owner.flow(); points = dereference flowref
    sourceref = points.owner(); source = dereference sourceref; profileref = points.transfers(); profile = dereference profileref
    cfgref = points.cfg(); cfg = dereference cfgref
    instance = _phase.instance(); _call = _phase.operation(); called = source.at(_call); supplied = instance.provider()
    if (supplied <refsame> sourceref) = 0 | _phase.procedure() <> instance.procedure() then do; ignored = fail('invalid','target.expansion.frame.provider.owner.mismatch'); return; end
    body = source.body(instance.procedure()); catalog = .llrxascatalog..catalog(); _catalog = catalog.fingerprint()
    if body.entrykind() = 'program-default' | catalog.callframecontrolstate(called.opcode()) <> 'known' then do; ignored = fail('unknown','target.expansion.frame.control.entry.kind.unproved'); return; end
    if catalog.framepluginownership() <> 'none-published-interface.v1' then do; ignored = fail('unknown','target.expansion.frame.plugin.ownership.unproved'); return; end
    do i = 1 to 10
      if spend(1) = 0 then return
      name = word('plugins pluginowners invocation scope handlers policy references interrupt action callerwindow',i)
      expected = word('parent-borrowed none empty empty empty parent-borrowed-cow unmarked parent-inherited off none',i)
      if name = 'callerwindow' & catalog.callwindow(called.opcode()) > 0 then expected = 'mapped-window'
      if catalog.callframecontrolentry(called.opcode(),name) <> expected then do; ignored = fail('unknown','target.expansion.frame.control.entry.' || name || '.unproved'); return; end
    end
    /* Child-local policy/scopes are separate owners. Their only intrinsic
     * direct effect on this frame is marked ancestor reference ownership. */
    closure = owner.framecontrolrow(instance.procedure(),'transitive')
    if spend(closure.count() + closure.unknowns() + 1) = 0 then return
    if closure.isunknown('framecontrol') then do; ignored = fail('unknown','target.expansion.frame.control.child.inventory.unproved'); return; end
    bit = catalog.framecontrolmasknamed('ancestor-references')
    if bit = 0 then do; ignored = fail('unknown','target.expansion.frame.control.mask.inventory.unproved'); return; end
    do i = 1 to closure.count()
      if closure.family(i) <> 'framecontrol' then iterate
      mask = closure.domain(i) as .int; assembler iand overlap,mask,bit
      if overlap <> 0 then do; ignored = fail('unknown','target.expansion.frame.control.ancestor.references.unproved'); return; end
    end
    do i = 1 to instance.rows()
      if spend(1) = 0 then return
      sourceop = instance.source(i)
      if sourceop = 0 then iterate
      item = source.at(sourceop); instruction = profile.instruction(sourceop)
      if catalog.framecontrolstate(item.opcode()) <> 'known' then do; ignored = fail('unknown','target.expansion.frame.control.inventory.unproved'); return; end
      mask = catalog.framecontrolmask(item.opcode())
      do j = 1 to 7
        name = word('plugin-owners policy handlers scope references ancestor-references unknown',j); bit = catalog.framecontrolmasknamed(name)
        if spend(1) = 0 then return
        if bit = 0 then do; ignored = fail('unknown','target.expansion.frame.control.mask.inventory.unproved'); return; end
        assembler iand overlap,mask,bit
        if overlap = 0 then iterate
        if name = 'scope' & catalog.returnkind(item.opcode()) > 0 then iterate /* retire of an empty scope owner */
        ignored = fail('unknown','target.expansion.frame.control.' || name || '.correspondence.unproved'); return
      end
      /* The checked receipt couples source/candidate effects and operands.
       * Any remaining actual hook still needs a native control-preservation
       * contract; observer equivalence alone cannot install an empty owner. */
      bit = catalog.framecontrolmasknamed('foreign'); assembler iand overlap,mask,bit
      if overlap <> 0 then do
        callbacks = 0
        do j = 1 to instruction.actions()
          if spend(1) = 0 then return
          action = instruction.action(j)
          if action.kind() <> 'callback' then iterate
          callbacks = callbacks + 1
          if owner.abiaction(action) & catalog.returnkind(item.opcode()) > 0 then iterate /* checked result/retire phase */
          if action.detail() = 'catalog.callback.plugin-sync' & catalog.contextsynccontract() = 'value-only-nonreentrant.v1' then iterate
          if profile.recyclercleanup(sourceop,j,'callback') then iterate
          if spend(_phase.lookupwork() + j + 1) = 0 then return
          if _phase.nohook(sourceop,j) = 0 & (_phase.pairedhook(sourceop,j) = 0 | catalog.callbacknormalpreservesframe(item.opcode()) = 0) then do; ignored = fail('unknown','target.expansion.frame.control.foreign.correspondence.unproved'); return; end
        end
        if callbacks = 0 then do; ignored = fail('unknown','target.expansion.frame.control.foreign.inventory.unproved'); return; end
      end
      do j = 1 to cfg.outedges(sourceop)
        if spend(j + 1) = 0 then return
        edge = cfg.outedge(sourceop,j)
        if edge.complete() = 0 | edge.scopecomplete() = 0 | edge.role() = 'unknown' then do; ignored = fail('unknown','target.expansion.frame.control.departure.unproved'); return; end
        if edge.targetblock() > 0 & wordpos(edge.exposure(),'inherited inherited-async handler-call handler-call-async event-binding event-binding-async') > 0 then do; ignored = fail('unknown','target.expansion.frame.control.handler.correspondence.unproved'); return; end
        if edge.targetblock() = 0 & wordpos(edge.boundarykind(),'policy-return inherited-signal-policy asynchronous-policy') > 0 then do; ignored = fail('unknown','target.expansion.frame.control.unwind.correspondence.unproved'); return; end
      end
      if catalog.returnkind(item.opcode()) > 0 then do
        if retireprogram(catalog,item.opcode()) = 0 then return
      end
    end
    /* Native free_frame empties the control owners above; the published
     * plugin invariant leaves no delayed owned-plugin destructor. Payloads
     * installed by this execution keep their independent ownership checks. */
    _status = 'proved'
    return
  valid: method = .int
    call run()
    if _status <> 'proved' | <refvalid>(_owner) = 0 | _phase.valid() = 0 then return 0
    owner = dereference _owner; catalog = .llrxascatalog..catalog()
    return owner.valid() & owner.identity() = _ownerid & catalog.fingerprint() = _catalog
  status: method = .string
    call run()
    if _status = 'proved' & valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    call run()
    if _status = 'proved' & valid() = 0 then return 'target.expansion.frame.control.owner.expired.or.replaced'
    return _reason
  preserved: method = .int
    return valid()
  operation: method = .int
    return _call
  usedwork: method = .int
    return _work
  usedbytes: method = .int
    return _bytes
  budgetrefusal: method = .void
    arg reason = .string
    _status = 'limit'; _reason = reason
    return

/** Parametric source-to-clone relation. Equal ordered native operations act on
 * corresponding storage even when the values there are unknown. This checker
 * compares effects; it does not execute a second copy of opcode semantics. */
expansionequivalencefact: class
  _owner = reference .lltargetsummary..analysis
  _ownerid = .int
  _plan = .expansionplanfact
  _mapping = reference .lltargetremap..expansioncorrespondence
  _plans = .expansionplanfact[]
  _diagnostics = .diagnosticclone[]
  _profile = .lltargettransfer..profile
  _cfg = .lltargetcfg..graph
  _flow = .lltargetflow..analysis
  _next = .int[]
  _saved = .lltarget..operand[]
  _expected = .int
  _status = .string
  _reason = .string
  _work = .int
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  _dependenciesready = .int
  _chargesclosed = .int
  _candidateflowready = .int
  _sourcework = .int
  _sourcebytes = .int
  _sourcequerywork = .int
  _sourcequerybytes = .int
  _summarywork = .int
  _summarybytes = .int
  _candidatework = .int
  _candidatebytes = .int
  _phaseidentity = .int
  _phasepresent = .int[]
  _nohooks = .string[]
  _pairedhooks = .string[]
  _checking = .int
  _lifecycles = .framecontrolhistoryfact[]
  *: factory
    arg owner = reference .analysis, plan = .expansionplanfact, mapping = reference .lltargetremap..expansioncorrespondence, work = 1000000, bytes = 67108864
    _owner = owner; _plan = plan; _mapping = mapping
    _status = 'building'; _worklimit = work; _bytelimit = bytes; _phaseidentity = nextidentity()
    if work < 1 | bytes < 1 then do; _status = 'limit'; _reason = 'target.expansion.relation.work.or.bytes'; end
    return
  fail: method = .int
    arg state = .string, reason = .string
    if _status = 'building' then do; _status = state; _reason = reason; end
    return 0
  spend: method = .int
    arg work = 1, bytes = 0
    if work < 0 | bytes < 0 | work > _worklimit - _work | bytes > _bytelimit - _bytes then return fail('limit','target.expansion.relation.work.or.bytes')
    _work = _work + work; _bytes = _bytes + bytes
    return 1
  /** Record already-performed owner work, even on limit. Prospective work
   * still uses spend(); incurred counters never discard a finished query. */
  incurred: method = .int
    arg work = .int, bytes = .int
    overflow = 0
    if work < 0 | bytes < 0 then do; _status = 'invalid'; _reason = 'target.expansion.relation.counter.invalid'; return 0; end
    if work > 9223372036854775807 - _work then do; _work = 9223372036854775807; overflow = 1; end
    else _work = _work + work
    if bytes > 9223372036854775807 - _bytes then do; _bytes = 9223372036854775807; overflow = 1; end
    else _bytes = _bytes + bytes
    if overflow | _work > _worklimit | _bytes > _bytelimit then do
      _status = 'limit'; _reason = 'target.expansion.relation.work.or.bytes'; return 0
    end
    return 1
  /** Queries continue to grow shared immutable-owner ledgers after solving.
   * Charge each delta once, including work performed before a refusal. */
  dependencycharge: method = .int
    if _dependenciesready = 0 | _chargesclosed then return 1
    if <refvalid>(_owner) = 0 then do; _status = 'invalid'; _reason = 'target.expansion.relation.owner.expired'; _chargesclosed = 1; return 0; end
    owner = dereference _owner; flowref = owner.flow(); points = dereference flowref
    sourcework = points.usedwork(); sourcebytes = points.usedbytes()
    summarywork = owner.usedwork(); summarybytes = owner.usedbytes()
    candidatework = 0; candidatebytes = 0
    if _candidateflowready then do; candidatework = _flow.usedwork(); candidatebytes = _flow.usedbytes(); end
    sourcequerywork = max(0,sourcework - _sourcework); sourcequerybytes = max(0,sourcebytes - _sourcebytes)
    _sourcequerywork = _sourcequerywork + sourcequerywork; _sourcequerybytes = _sourcequerybytes + sourcequerybytes
    charged = incurred(sourcequerywork,sourcequerybytes)
    charged = incurred(max(0,summarywork - _summarywork),max(0,summarybytes - _summarybytes)) & charged
    charged = incurred(max(0,candidatework - _candidatework),max(0,candidatebytes - _candidatebytes)) & charged
    _sourcework = sourcework; _sourcebytes = sourcebytes; _summarywork = summarywork; _summarybytes = summarybytes
    _candidatework = candidatework; _candidatebytes = candidatebytes
    if _status <> 'building' then _chargesclosed = 1
    return charged
  samevalue: method = .int
    arg left = .lltarget..operand, right = .lltarget..operand
    if left.kind() <> right.kind() then return 0
    if left.kind() = 'R' then return left.bank() = right.bank() & left.index() = right.index()
    if left.kind() = 'I' then return left.index() = right.index()
    if spend(left.length() + right.length() + 1) = 0 then return 0
    return (bin2x(left.bytes()) == bin2x(right.bytes()))
  expect: method = .int
    arg candidate = .lltarget..module, operation = .int, name = .string, left = .lltarget..operand, ?right = .lltarget..operand
    if spend(1) = 0 then return 0
    if operation < 1 then return fail('unknown','target.expansion.recipe.operation.missing')
    item = candidate.at(operation); count = 1 + ?right
    if item.kind() <> 'instruction' | item.mnemonic() <> name | item.operands() <> count then return fail('unknown','target.expansion.recipe.operation.mismatch')
    if samevalue(item.operand(1),left) = 0 then return fail('unknown','target.expansion.recipe.destination.mismatch')
    if ?right then do; if samevalue(item.operand(2),right) = 0 then return fail('unknown','target.expansion.recipe.source.mismatch'); end
    _expected = _expected + 1
