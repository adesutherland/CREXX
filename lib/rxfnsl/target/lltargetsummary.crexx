    return sitespend(work) & sitereserve(bytes)
  /** Resolve this procedure's own pending rows against the actual invocation.
   * Descendant calls obtain their own caller-point context and final cache. */
  contextactivation: method = .lltargetsummary..activationfact
    arg functionid = .int, scoped = .int, invocation = .lltargetflow..invocationfact, depth = .int
    dependencies = .activationfact[]; targets = .lltargetflow..targetfact[]
    invocations = .lltargetflow..invocationfact[]; proofs = .lltargetflow..abicallbackfact[]
    child = .activationfact; abi = .lltargetflow..abicallbackfact
    if depth >= 32 then return .activationfact(.siteproof(reference self,'unknown','target.activation.recursion.or.depth.unproved'),0)
    generic = genericactivation(functionid,scoped,depth)
    if generic.genericallowed() = 0 then return generic
    if invocation.status() <> 'proved' then return .activationfact(.siteproof(reference self,'unknown',invocation.reason()),0)
    flow = dereference _flow; owner = flow.owner(); profile_ref = flow.transfers(); target = invocation.target()
    provider = target.provider(); transfers = target.transfers()
    if (provider <refsame> owner) = 0 | (transfers <refsame> profile_ref) = 0 | target.procedure() <> functionid then return .activationfact(.siteproof(reference self,'unknown','target.activation.invocation.provider.mismatch'),0)
    if activationcharge(generic) = 0 | sitereserve(256) = 0 then return .activationfact(.siteproof(reference self,'limit',_sitefailure),0)
    dependencies[1] = generic; invocations[1] = invocation
    state = 'proved'; reason = ''; allowed = 1; pending = _activationabihead[functionid]
    do while pending > 0
      if sitespend(1) = 0 then return .activationfact(.siteproof(reference self,'limit',_sitefailure),0)
      abi = flow.abicallbackat(_activationabiop[pending],_activationabiedge[pending],invocation)
      if flow.status() <> 'ok' then do; ignored = fail(flow.status(),flow.reason()); return .activationfact(.siteproof(reference self,flow.status(),flow.reason()),0); end
      if sitespend(abi.rows() * 8 + 1) = 0 | sitereserve(abi.bytes()) = 0 then return .activationfact(.siteproof(reference self,'limit',_sitefailure),0)
      proofs[proofs[0] + 1] = abi
      if abi.possible() then do
        state = abi.status(); if state = 'proved' then state = 'unknown'
        reason = abi.reason(); if reason = '' then reason = 'target.activation.abi.callback.possible'
        allowed = 0
      end
      pending = _activationabinext[pending]
    end
    c = _activationcallhead[functionid]
    do while c > 0
      if sitespend(1) = 0 then return .activationfact(.siteproof(reference self,'limit',_sitefailure),0)
      child = callactivation(_calloperation[c],scoped,depth + 1)
      if activationcharge(child) = 0 then return .activationfact(.siteproof(reference self,'limit',_sitefailure),0)
      dependencies[dependencies[0] + 1] = child
      if child.allowed() = 0 then do; state = child.status(); reason = child.reason(); allowed = 0; end
      c = _activationcallnext[c]
    end
    return .activationfact.contextual(.siteproof(reference self,state,reason),allowed,dependencies,targets,invocations,proofs)
  activationequivalence: method = .lltargetsummary..activationfact
    arg sourceop = .int, scoped = 1
    return callactivation(sourceop,scoped,0)
  callactivation: method = .lltargetsummary..activationfact
    arg sourceop = .int, scoped = .int, depth = .int
    if scoped <> 0 & scoped <> 1 then return .activationfact(.siteproof(reference self,'invalid','target.activation.mode.invalid'),0)
    if sitebegin(sourceop) = 0 then return .activationfact(.siteproof(reference self,'limit',_sitefailure),0)
    key = sourceop * 2 + scoped
    if key <= _activationpresent[0] then do; if _activationpresent[key] then return _activationfacts[key]; end
    if depth >= 32 then return .activationfact(.siteproof(reference self,'unknown','target.activation.recursion.or.depth.unproved'),0)
    if key <= _activationinprogress[0] then do; if _activationinprogress[key] then return .activationfact(.siteproof(reference self,'unknown','target.activation.recursion.or.depth.unproved'),0); end
    if sitespend(max(0,key - _activationinprogress[0]) + 1) = 0 | sitereserve(max(0,key - _activationinprogress[0]) * 32 + 128) = 0 then return .activationfact(.siteproof(reference self,'limit',_sitefailure),0)
    _activationstarted = 1; _activationinprogress[key] = 1
    result = resolvecallactivation(sourceop,scoped,depth)
    _activationinprogress[key] = 0
    _activationfacts[key] = result; _activationpresent[key] = 1
    return result
  resolvecallactivation: method = .lltargetsummary..activationfact
    arg sourceop = .int, scoped = .int, depth = .int
    dependencies = .activationfact[]; targets = .lltargetflow..targetfact[]
    invocations = .lltargetflow..invocationfact[]; proofs = .lltargetflow..abicallbackfact[]
    childproof = .activationfact; peer = .int; i = .int; abi = .lltargetflow..abicallbackfact
    flow = dereference _flow; owner = flow.owner(); source = dereference owner
    profile_ref = flow.transfers(); profile = dereference profile_ref; cfg_ref = flow.cfg(); cfg = dereference cfg_ref
    catalog = .llrxascatalog..catalog(); item = source.at(sourceop)
    if item.kind() <> 'instruction' then return .activationfact(.siteproof(reference self,'unknown','target.site.not.call'),0)
    if catalog.callinvokes(item.opcode()) = 0 then return .activationfact(.siteproof(reference self,'unknown','target.site.not.call'),0)
    state = 'proved'; reason = ''; allowed = 1
    transport = scoped & catalog.scopeddiagnostics() & profile.premise() = 'canonical'
    do i = 1 to cfg.outedges(sourceop)
      if sitespend(i + 1) = 0 then return .activationfact(.siteproof(reference self,'limit',_sitefailure),0)
      edge = cfg.outedge(sourceop,i)
      if activationedgeknown(edge,transport) = 0 then do; state = 'unknown'; reason = 'target.activation.signal.context.unproved'; allowed = 0; end
      if transport = 0 & edge.role() = 'terminal' & (edge.phase() <> 'none' | edge.signalname() <> '') then do; state = 'unknown'; reason = 'target.activation.terminal.diagnostic.unproved'; allowed = 0; end
      if abiedge(edge,cfg) then do
        abi = flow.abicallbackat(sourceop,edge.id())
        if flow.status() <> 'ok' then do; ignored = fail(flow.status(),flow.reason()); return .activationfact(.siteproof(reference self,flow.status(),flow.reason()),0); end
        if sitespend(abi.rows() * 8 + 1) = 0 | sitereserve(abi.bytes()) = 0 then return .activationfact(.siteproof(reference self,'limit',_sitefailure),0)
        proofs[proofs[0] + 1] = abi
        if abi.possible() then do; state = 'unknown'; reason = abi.reason(); if reason = '' then reason = 'target.activation.abi.callback.possible'; allowed = 0; end
      end
    end
    if allowed then do
      invocation = flow.invocationat(sourceop)
      if invocation.status() <> 'proved' then do; state = invocation.status(); reason = invocation.reason(); allowed = 0; end
      else do
        target = invocation.target(); targets[1] = target; invocations[1] = invocation; provider = target.provider()
        if sitereserve(576) = 0 then return .activationfact(.siteproof(reference self,'limit',_sitefailure),0)
        if provider <refsame> owner then childproof = contextactivation(target.procedure(),scoped,invocation,depth)
        else do
          transfers = target.transfers(); peer = 0
          if <refvalid>(transfers) then peer = providerindex(provider,transfers)
          if peer = 0 then childproof = .activationfact(.siteproof(reference self,'unknown','target.activation.provider.facts.unavailable'),0)
          else do
