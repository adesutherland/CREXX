          end
        end
        if activationcharge(childproof) = 0 then return .activationfact(.siteproof(reference self,'limit',_sitefailure),0)
        dependencies[1] = childproof
        if childproof.allowed() = 0 then do; state = childproof.status(); reason = childproof.reason(); allowed = 0; end
      end
    end
    return .activationfact.contextual(.siteproof(reference self,state,reason),allowed,dependencies,targets,invocations,proofs)
  /** A component delta immediately before this exact callback may change only
   * storage outside its complete observed projection. A checked correspondence
   * can relate two unchanged activations, but is not a delta-history proof.
   * Earlier entry insertion needs separately checked prefix/dependency facts. */
  callbackpreservation: method = .lltargetsummary..preservationfact
    arg source = .lltargetflow..callbackfact, candidate = .lltargetflow..callbackfact, deltaBank = .string, deltaIndex = .int, deltaDomain = 0, ?correspondence = reference .lltargetremap..correspondence
    event = .lltargetremap..eventmap
    mappedentry = .int; i = .int
    mappingref = reference .lltargetremap..correspondence
    if ?correspondence then mappingref = correspondence
    if sitebegin(source.operation()) = 0 then return .preservationfact(.siteproof(reference self,'limit',_sitefailure),source,candidate,mappingref)
    if sitespend(16) = 0 | sitereserve(256) = 0 then return .preservationfact(.siteproof(reference self,'limit',_sitefailure),source,candidate,mappingref)
    if source.status() <> 'proved' then return .preservationfact(.siteproof(reference self,source.status(),source.reason()),source,candidate,mappingref)
    if candidate.status() <> 'proved' then return .preservationfact(.siteproof(reference self,candidate.status(),candidate.reason()),source,candidate,mappingref)
    if source.phase() <> candidate.phase() | wordpos(source.phase(),'none before after') = 0 | source.path() <> candidate.path() then return .preservationfact(.siteproof(reference self,'unknown','target.callback.phase.unproved'),source,candidate,mappingref)
    if source.observation() = 'physical' | candidate.observation() = 'physical' then return .preservationfact(.siteproof(reference self,'unknown','target.callback.physical.observation.unproved'),source,candidate,mappingref)
    if source.observation() <> 'component' | candidate.observation() <> 'component' then return .preservationfact(.siteproof(reference self,'unknown','target.callback.observation.projection.unproved'),source,candidate,mappingref)
    sourceflow = source.points(); candidateflow = candidate.points()
    if (sourceflow <refsame> _flow) = 0 then return .preservationfact(.siteproof(reference self,'invalid','target.callback.preservation.flow.mismatch'),source,candidate,mappingref)
    flow = dereference sourceflow; resultflow = dereference candidateflow
    mapped = <refvalid>(mappingref)
    if ?correspondence & mapped = 0 then return .preservationfact(.siteproof(reference self,'invalid','target.callback.correspondence.owner.expired'),source,candidate,mappingref)
    leftscope = source.scope(); rightscope = candidate.scope()
    if leftscope.known() = 0 | rightscope.known() = 0 | leftscope.depth() <> rightscope.depth() then return .preservationfact(.siteproof(reference self,'unknown','target.callback.activation.unproved'),source,candidate,mappingref)
    if sitespend(leftscope.depth() + 1) = 0 then return .preservationfact(.siteproof(reference self,'limit',_sitefailure),source,candidate,mappingref)
    if mapped then do
      checkedref = reference .lltargetremap..correspondence; checkedref = mappingref
      mapping = dereference checkedref
      if mapping.status() <> 'proved' then return .preservationfact(.siteproof(reference self,mapping.status(),mapping.reason()),source,candidate,mappingref)
      beforeowner = mapping.sourceowner(); afterowner = mapping.candidateowner()
      beforeprofile = mapping.sourceprofile(); afterprofile = mapping.candidateprofile()
      beforecfg = mapping.sourcecfg(); aftercfg = mapping.candidatecfg()
      actualowner = flow.owner(); resultowner = resultflow.owner()
      actualprofile = flow.transfers(); resultprofile = resultflow.transfers()
      actualcfg = flow.cfg(); resultcfg = resultflow.cfg()
      if (beforeowner <refsame> actualowner) = 0 | (afterowner <refsame> resultowner) = 0 | (beforeprofile <refsame> actualprofile) = 0 | (afterprofile <refsame> resultprofile) = 0 | (beforecfg <refsame> actualcfg) = 0 | (aftercfg <refsame> resultcfg) = 0 then return .preservationfact(.siteproof(reference self,'invalid','target.callback.correspondence.owner.mismatch'),source,candidate,mappingref)
      event = mapping.event(source.operation(),source.ordinal(),source.edge())
      if event.status() <> 'proved' then return .preservationfact(.siteproof(reference self,event.status(),event.reason()),source,candidate,mappingref)
      if event.candidateoperation() <> candidate.operation() | event.candidateordinal() <> candidate.ordinal() | event.candidateedge() <> candidate.edge() then return .preservationfact(.siteproof(reference self,'unknown','target.callback.event.correspondence.unproved'),source,candidate,mappingref)
      if event.sourcefunction() <> source.function() | event.candidatefunction() <> candidate.function() then return .preservationfact(.siteproof(reference self,'unknown','target.callback.activation.unproved'),source,candidate,mappingref)
      if mapping.mapsregister(deltaBank,deltaIndex,deltaBank,deltaIndex) = 0 then return .preservationfact(.siteproof(reference self,'unknown','target.callback.delta.mapping.unproved'),source,candidate,mappingref)
      do i = 1 to leftscope.depth()
        mappedentry = mapping.operation(leftscope.entry(i))
        if mappedentry = 0 | mappedentry <> rightscope.entry(i) then return .preservationfact(.siteproof(reference self,'unknown','target.callback.activation.unproved'),source,candidate,mappingref)
      end
    end
    else do
      if (sourceflow <refsame> candidateflow) = 0 then return .preservationfact(.siteproof(reference self,'unknown','target.callback.correspondence.required'),source,candidate,mappingref)
      if source.function() <> candidate.function() then return .preservationfact(.siteproof(reference self,'unknown','target.callback.activation.unproved'),source,candidate,mappingref)
      if source.operation() <> candidate.operation() | source.ordinal() <> candidate.ordinal() | source.edge() <> candidate.edge() then return .preservationfact(.siteproof(reference self,'unknown','target.callback.event.correspondence.unproved'),source,candidate,mappingref)
      do i = 1 to leftscope.depth()
        if leftscope.entry(i) <> rightscope.entry(i) then return .preservationfact(.siteproof(reference self,'unknown','target.callback.activation.unproved'),source,candidate,mappingref)
      end
    end
    if source.possible() <> candidate.possible() then return .preservationfact(.siteproof(reference self,'unknown','target.callback.presence.unproved'),source,candidate,mappingref)
    profile_ref = flow.transfers(); profile = dereference profile_ref
    if deltaIndex < 0 | wordpos(deltaBank,'r g a') = 0 | deltaDomain < 0 | deltaDomain > profile.domains() then return .preservationfact(.siteproof(reference self,'invalid','target.callback.delta.selector.invalid'),source,candidate,mappingref)
    if deltaDomain > 0 then do
      domain = profile.domain(deltaDomain)
      if wordpos(domain.kind(),'component flag') = 0 then return .preservationfact(.siteproof(reference self,'unknown','target.callback.delta.domain.unproved'),source,candidate,mappingref)
    end
    if sitespend(flow.lookupcost() + resultflow.lookupcost() + 4) = 0 then return .preservationfact(.siteproof(reference self,'limit',_sitefailure),source,candidate,mappingref)
    observed = source.observed(); changed = source.binding(deltaBank,deltaIndex); storage = observed.active()
    if source.anchor() = 'base' then storage = observed.base()
    else if source.anchor() = 'entry' then storage = observed.entry()
    if flow.valid() = 0 then return .preservationfact(.siteproof(reference self,flow.status(),flow.message()),source,candidate,mappingref)
    if storage = 0 | changed.active() = 0 | changed.slotidentity() = 0 then return .preservationfact(.siteproof(reference self,'unknown','target.callback.delta.binding.unproved'),source,candidate,mappingref)
    if flow.privatedistinct(source.function(),storage,changed.active()) = 0 then return .preservationfact(.siteproof(reference self,'unknown','target.callback.delta.alias.unproved'),source,candidate,mappingref)
    resultobserved = candidate.observed(); resultchanged = candidate.binding(deltaBank,deltaIndex); resultstorage = resultobserved.active()
    if candidate.anchor() = 'base' then resultstorage = resultobserved.base()
    else if candidate.anchor() = 'entry' then resultstorage = resultobserved.entry()
    if resultflow.valid() = 0 then return .preservationfact(.siteproof(reference self,resultflow.status(),resultflow.message()),source,candidate,mappingref)
    if resultstorage = 0 | resultchanged.active() = 0 | resultchanged.slotidentity() = 0 then return .preservationfact(.siteproof(reference self,'unknown','target.callback.delta.binding.unproved'),source,candidate,mappingref)
    if resultflow.privatedistinct(candidate.function(),resultstorage,resultchanged.active()) = 0 then return .preservationfact(.siteproof(reference self,'unknown','target.callback.delta.alias.unproved'),source,candidate,mappingref)
    return .preservationfact(.siteproof(reference self,'proved'),source,candidate,mappingref)
  /** A per-reference proof, independent of activation/context omission. Reads
   * and writes through aN preserve caller-owned pointees. Binding/permutation
   * actions instead modify a callee-private pointer slot: only an identical
   * slot action is already an identity in both executions. A different-slot
   * action needs a proxy/restoration mapping, even if values happen to agree. */
  directactualmapping: method = .lltargetsummary..directmappingfact
    arg sourceop = .int
    i = .int; j = .int; leftargument = .int; rightargument = .int; callerentry = .int
    extent = .int; knownextent = .int; firstslot = .int
    item = .lltarget..record; view = .lltargettransfer..refview
    leftview = .lltargettransfer..refview; rightview = .lltargettransfer..refview
    action = .lltargettransfer..action
    if sitebegin(sourceop) = 0 then return .directmappingfact(.siteproof(reference self,'limit',_sitefailure))
    flow = dereference _flow; owner = flow.owner(); source = dereference owner
    target = flow.targetat(sourceop)
    if target.status() <> 'proved' then return .directmappingfact(.siteproof(reference self,'unknown',target.reason()),target)
    provider = target.provider()
    if (provider <refsame> owner) = 0 then return .directmappingfact(.siteproof(reference self,'unknown','target.argument.mapping.provider.unproved'),target)
    profile_ref = flow.transfers(); profile = dereference profile_ref; body = source.body(target.procedure()); catalog = .llrxascatalog..catalog()
    callrecord = source.at(sourceop); callerbody = source.body(callrecord.procedureid()); callerentry = 0
    do i = 1 to callerbody.records()
      if sitespend(1) = 0 then return .directmappingfact(.siteproof(reference self,'limit',_sitefailure),target)
      item = callerbody.record(i)
      if item.kind() <> 'procedure' then do; callerentry = item.id(); leave; end
    end
    layout = calllayout(sourceop)
    if layout.status() <> 'proved' then return .directmappingfact(.siteproof(reference self,layout.status(),layout.reason()),target)
    do i = 1 to body.records()
      if sitespend(1) = 0 then return .directmappingfact(.siteproof(reference self,'limit',_sitefailure),target)
      item = body.record(i)
      if item.kind() = 'procedure' then iterate
      instruction = profile.instruction(item.id())
      do j = 1 to 3
        family = word('references bindings order',j)
        if instruction.complete(family) = 0 then return .directmappingfact(.siteproof(reference self,'unknown',instruction.unknownreason(family)),target)
      end
      do j = 1 to instruction.references()
        if sitespend(1) = 0 then return .directmappingfact(.siteproof(reference self,'limit',_sitefailure),target)
        view = instruction.ref(j)
        if view.kind() = 'window' | view.role() = 'window-capture' then do
          knownextent = view.extentknown(); extent = view.extent()
          if knownextent = 0 & item.kind() = 'instruction' then do
            if catalog.callinvokes(item.opcode()) then do
              childlayout = calllayout(item.id())
              if childlayout.countknown() then do; knownextent = 1; extent = childlayout.count() + 1; end
            end
          end
          if knownextent = 0 then return .directmappingfact(.siteproof(reference self,'unknown','target.argument.mapping.window.extent.unproved'),target)
          firstslot = view.index()
          if view.bank() = 'g' then firstslot = firstslot + body.locals()
          else if view.bank() = 'a' then firstslot = firstslot + body.locals() + source.globals()
          if extent > 0 & firstslot < body.locals() + source.globals() then do
            if firstslot >= body.locals() | extent > body.locals() - firstslot then return .directmappingfact(.siteproof(reference self,'unknown','target.global.mapping.window.unproved'),target)
          end
        end
        if view.bank() = 'a' & view.index() > 0 then do
          if view.anchor() <> 'active' then return .directmappingfact(.siteproof(reference self,'unknown','target.argument.mapping.anchor.unproved'),target)
          if view.index() > layout.count() then return .directmappingfact(.siteproof(reference self,'unknown','target.argument.mapping.presence.unproved'),target)
        end
        if view.bank() = 'g' then do
          if view.anchor() <> 'active' then return .directmappingfact(.siteproof(reference self,'unknown','target.global.mapping.anchor.unproved'),target)
          if sitespend(flow.lookupcost() * 2 + 1) = 0 then return .directmappingfact(.siteproof(reference self,'limit',_sitefailure),target)
          incoming = flow.captureat(sourceop,'g',view.index()); initial = flow.storageat(callerentry,'g',view.index())
          if incoming.active() = 0 | initial.slotidentity() = 0 then return .directmappingfact(.siteproof(reference self,'unknown','target.global.mapping.entry.unproved'),target)
          if incoming.active() <> incoming.entry() | incoming.base() <> incoming.entry() | incoming.slotidentity() <> initial.slotidentity() then return .directmappingfact(.siteproof(reference self,'unknown','target.global.mapping.entry.unproved'),target)
        end
      end
      do j = 1 to instruction.actions()
        if sitespend(1) = 0 then return .directmappingfact(.siteproof(reference self,'limit',_sitefailure),target)
        action = instruction.action(j)
        if wordpos(action.kind(),'link unlink swap') = 0 then iterate
        leftargument = 0; rightargument = 0
        if action.subject() > 0 then do
          leftview = profile.ref(action.subject())
          leftargument = (leftview.bank() = 'a' & leftview.index() > 0) | leftview.bank() = 'g'
        end
        if action.sourcekind() = 'reference' then do
          rightview = profile.ref(action.sourceid())
          rightargument = (rightview.bank() = 'a' & rightview.index() > 0) | rightview.bank() = 'g'
        end
        if leftargument = 0 & (action.kind() <> 'swap' | rightargument = 0) then iterate
        identical = 0
        if leftargument & rightargument & action.kind() <> 'unlink' & action.detail() <> 'active-base' then do
          identical = leftview.bank() = rightview.bank() & leftview.index() = rightview.index() & leftview.anchor() = 'active' & rightview.anchor() = 'active'
        end
        if identical = 0 then do
          reason = 'target.argument.mapping.binding.unproved'
          if leftargument then do; if leftview.bank() = 'g' then reason = 'target.global.mapping.binding.unproved'; end
          if rightargument & action.kind() = 'swap' then do; if rightview.bank() = 'g' then reason = 'target.global.mapping.binding.unproved'; end
          return .directmappingfact(.siteproof(reference self,'unknown',reason),target)
        end
      end
    end
    return .directmappingfact(.siteproof(reference self,'proved'),target)
  scopefree: method = .lltargetsummary..scopefreefact
    arg sourceop = .int
    returnops = .int[]; returnmodes = .string[]
    i = .int; j = .int; k = .int; d = .int; kind = .int; providerfunction = .int; mode = .string
    value = .lltarget..operand; point = .lltargetflow..valuefact; binding = .lltargetflow..storagefact
    if sitebegin(sourceop) = 0 then return .scopefreefact(.siteproof(reference self,'limit',_sitefailure),0)
    if sourceop <= _scopepresent[0] then do; if _scopepresent[sourceop] then return _scopefacts[sourceop]; end
    flow = dereference _flow; owner = flow.owner(); source = dereference owner
    profile_ref = flow.transfers(); profile = dereference profile_ref; cfg_ref = flow.cfg(); cfg = dereference cfg_ref
    catalog = .llrxascatalog..catalog(); callrecord = source.at(sourceop)
    if callrecord.kind() <> 'instruction' then return .scopefreefact(.siteproof(reference self,'unknown','target.site.not.call'),0)
    if catalog.callinvokes(callrecord.opcode()) = 0 then return .scopefreefact(.siteproof(reference self,'unknown','target.site.not.call'),0)
    activation = activationequivalence(sourceop,0)
    if activation.allowed() = 0 then return .scopefreefact(.siteproof(reference self,activation.status(),activation.reason()),0)
    directmapping = directactualmapping(sourceop)
    if directmapping.allowed() = 0 then return .scopefreefact(.siteproof(reference self,directmapping.status(),directmapping.reason()),0)
    target = flow.targetat(sourceop)
    if target.status() <> 'proved' then return .scopefreefact(.siteproof(reference self,'unknown',target.reason()),0)
    provider_ref = target.provider()
    if (provider_ref <refsame> owner) = 0 then return .scopefreefact(.siteproof(reference self,'unknown','scopefree.provider.context.unproved'),0)
    providerfunction = target.procedure(); body = source.body(providerfunction)
    state = 'proved'; reason = ''; allowed = 1
    if profile.executioncontext() = '' | profile.defaulthalt(callrecord.procedureid()) = 0 | profile.defaulthalt(providerfunction) = 0 then do; state = 'unknown'; reason = 'scopefree.signal.context.unproved'; allowed = 0; end
    if catalog.callprefix(callrecord.opcode()) <> '' then do; state = 'unknown'; reason = 'scopefree.preparation.unproved'; allowed = 0; end
    layout = calllayout(sourceop)
    if layout.status() <> 'proved' then do; state = layout.status(); reason = layout.reason(); allowed = 0; end
    if cfg.normalizationcomplete(providerfunction) = 0 | flow.complete(providerfunction,'entry-normalization') = 0 then do; state = 'unknown'; reason = 'scopefree.entry.normalization.unproved'; allowed = 0; end
    if sitespend(body.records() * 8 + max(0,sourceop - _scopepresent[0]) + 1) = 0 | sitereserve(body.records() * 32 + max(0,sourceop - _scopepresent[0]) * 24 + 160) = 0 then return .scopefreefact(.siteproof(reference self,'limit',_sitefailure),0)
    /* The exact sealed execution profile owns startup/initializer certainty.
     * A same-owner target does not acquire a new foreign ingress here. */
    do i = 1 to body.records()
      item = body.record(i)
      if item.kind() = 'procedure' then iterate
      instruction = profile.instruction(item.id())
      do j = 1 to 8
        family = word('references bindings order relocation observations ownership effects control',j)
        if instruction.complete(family) = 0 then do; state = 'unknown'; reason = instruction.unknownreason(family); allowed = 0; end
      end
      if item.kind() <> 'instruction' then iterate
      /* Pending delivery is observable even when no handler-table write is
       * present. This scope proof retains both as independent barriers. */
      if (catalog.signalproperties(item.opcode()) <idiv> 8) % 2 | (catalog.signalproperties(item.opcode()) <idiv> 32) % 2 | catalog.observations(item.opcode()) <> 0 then do; state = 'unknown'; reason = 'scopefree.activation.observer.unproved'; allowed = 0; end
      do j = 1 to instruction.references()
        if sitespend(1) = 0 then return .scopefreefact(.siteproof(reference self,'limit',_sitefailure),0)
        view = instruction.ref(j)
        if view.kind() = 'address' then do; state = 'unknown'; reason = 'scopefree.argument.or.address.view.unproved'; allowed = 0; end
        if view.bank() = 'a' & layout.countknown() then do
          if view.index() > layout.count() then do; state = 'unknown'; reason = 'scopefree.argument.presence.unproved'; allowed = 0; end
        end
      end
      do j = 1 to instruction.actions()
        if sitespend(1) = 0 then return .scopefreefact(.siteproof(reference self,'limit',_sitefailure),0)
        action = instruction.action(j)
        if action.kind() = 'callback' then do
          if callbackmay(item.id(),action.ordinal(),1) then do; state = 'unknown'; reason = 'scopefree.callback.unproved'; allowed = 0; end
          if _sitefailure <> '' then return .scopefreefact(.siteproof(reference self,'limit',_sitefailure),0)
        end
        if wordpos(action.kind(),'context policy lifetime resize scope-enter unknown') > 0 then do; state = 'unknown'; reason = 'scopefree.restoration.' || action.kind() || '.unproved'; allowed = 0; end
        if action.kind() = 'call' then do
          child = flow.targetat(item.id())
          if child.status() <> 'proved' then do; state = 'unknown'; reason = 'scopefree.child.effects.unproved'; allowed = 0; end
        end
      end
      kind = catalog.returnkind(item.opcode())
      if kind = 0 then iterate
      mode = 'unproved'; value = .lltarget..operand()
      if kind = 5 then do; state = 'unknown'; reason = 'scopefree.return.setter.unproved'; allowed = 0; end
      if kind = 2 then do
        value = item.operand(catalog.returnsource(item.opcode())); binding = flow.storageat(item.id(),value.bank(),value.index())
        mode = 'copy'
        if binding.active() = 0 then do; mode = 'unproved'; state = 'unknown'; reason = 'scopefree.return.binding.unproved'; allowed = 0; end
        else if value.bank() = 'r' & binding.active() = binding.entry() then mode = 'move'
        n = returnops[0] + 1; returnops[n] = item.id(); returnmodes[n] = mode
      end
      /* Omitted frame cleanup may not delay a native/object finalizer in an
       * unrelated private backing cell. Strings/binaries retain value proof;
       * opaque payloads require a separate absence/lifetime certificate. */
      do k = 0 to body.locals() - 1
        if sitespend(1) = 0 then return .scopefreefact(.siteproof(reference self,'limit',_sitefailure),0)
        if kind = 2 & value.bank() = 'r' & value.index() = k & mode = 'move' then iterate
        ownershipdomains = 0
        do d = 1 to profile.domains()
          if sitespend(1) = 0 then return .scopefreefact(.siteproof(reference self,'limit',_sitefailure),0)
          domain = profile.domain(d)
          if domain.kind() <> 'component' then iterate
          if domain.nativebit() <> catalog.componentmask('reference') & domain.nativebit() <> catalog.componentmask('native-payload') & domain.nativebit() <> catalog.componentmask('attributes') then iterate
          ownershipdomains = ownershipdomains + 1
          if sitespend(flow.lookupcost() + 1) = 0 then return .scopefreefact(.siteproof(reference self,'limit',_sitefailure),0)
          point = flow.entrycomponentat(item.id(),'r',k,d)
          if point.presence() <> 'absent' then do; state = 'unknown'; reason = 'scopefree.owned.cleanup.unproved'; allowed = 0; end
        end
        if ownershipdomains <> 3 then do; state = 'unknown'; reason = 'scopefree.owned.cleanup.domains.unproved'; allowed = 0; end
      end
    end
    result = .scopefreefact(.siteproof(reference self,state,reason),allowed,returnops,returnmodes)
    _scopefacts[sourceop] = result; _scopepresent[sourceop] = 1
    return result
  procedure: method = .lltargetsummary..summary
    arg functionid = .int, mode = 'transitive'
    call run()
    if valid() = 0 | functionid < 2 | functionid > _direct[0] | wordpos(mode,'direct transitive') = 0 then assembler signal "ERROR","LL_TARGET_SUMMARY: invalid procedure query"
    return .summary(reference self,functionid,mode)
  effect: method = .lltargetsummary..effectfact
    arg functionid = .int, mode = .string, family = .string, kind = .string, domain = '*', depth = 64
    call run(); current = .row
    if valid() = 0 then return .effectfact(reference self,1,0,1)
    if mode = 'direct' then current = _direct[functionid] as .row
    else current = _transitive[functionid] as .row
    may = current.has(family,kind,domain); unknown = current.isunknown(family)
    if wordpos(family,'effects references components flags numeric signals order control values observations ownership calls arguments globals return bindings') = 0 then unknown = 1
    if depth < 0 then assembler signal "ERROR","LL_TARGET_SUMMARY: negative must-query depth"
    if may = 0 & unknown = 0 then return .effectfact(reference self,0,0,0)
    if depth = 0 then return .effectfact(reference self,may,0,1,'target.summary.must.depth',1)
    /* Each recursive step receives its own active vector. Preflight their
     * worst permitted logical extent before the first vector is allocated. */
    levels = min(depth,max(1,_direct[0])) + 2
    if _direct[0] > (_bytelimit - _bytes) / 8 / levels then return .effectfact(reference self,may,0,1,'target.summary.must.bytes',1)
    _querywork = 0; _querylimit = 0; _queryreason = ''
    if queryspend(_direct[0]) = 0 then return .effectfact(reference self,may,0,1,_queryreason,1)
    active = .int[]
    do i = 1 to _direct[0]; active[i] = 0; end
    must = mustproof(functionid,mode,family,kind,domain,active,0,depth)
    if _querylimit then return .effectfact(reference self,may,0,1,_queryreason,1)
    return .effectfact(reference self,may,must,unknown)
  /** Outward effects describe an actual retained call after NORMAL return.
   * Internal numeric/policy changes are isolated by that real frame. This
   * query cannot authorize deleting an inline restoration mechanism. */
  outwardeffect: method = .lltargetsummary..effectfact
    arg functionid = .int, mode = .string, family = .string, kind = .string, domain = '*'
    call run()
    if valid() = 0 then return .effectfact(reference self,1,0,1)
    if (family = 'numeric' & kind = 'write') | (family = 'signals' & kind = 'policy') then do
      if _returnpossible[functionid] = 0 then return .effectfact(reference self,1,0,1)
      return .effectfact(reference self,0,0,0)
    end
    return effect(functionid,mode,family,kind,domain)
  /** A bounded sufficient must proof: each applicable normal return is
   * dominated by a definite event, or by an exact child call with the same
   * guarantee. Active recursion cannot prove its own guarantee. */
  mustproof: method = .int
    arg functionid = .int, mode = .string, family = .string, kind = .string, domain = .string, active = .int[], depth = .int, maximum = .int
    direct = .row; edge = .lltargetcfg..edge
    sourceblock = .int
    if depth >= maximum then do; _querylimit = 1; _queryreason = 'target.summary.must.depth'; return 0; end
    if queryspend(active[0] + 1) = 0 then return 0
    if valid() = 0 | _returnpossible[functionid] = 0 | _returnunknown[functionid] then return 0
    if active[functionid] then return 0
    active[functionid] = 1
    flow = dereference _flow; cfg_ref = flow.cfg(); cfg = dereference cfg_ref; index_ref = cfg.index(); index = dereference index_ref
    if cfg.normalcomplete(functionid) = 0 | cfg.exceptionalcomplete(functionid) = 0 then return 0
    direct = _direct[functionid] as .row
    if direct.isunknown(family) then return 0
    returns = 0
    do r = 1 to _retfunction[0]
      if queryspend(1) = 0 then return 0
      if _retfunction[r] <> functionid then iterate
      returns = returns + 1; covered = 0; targetblock = cfg.projectedblock(_retoperation[r])
      do i = 1 to direct.count()
        if queryspend(1) = 0 then return 0
        if direct.family(i) <> family | direct.kind(i) <> kind | direct.definite(i) = 0 then iterate
        if domain <> '*' & direct.domain(i) <> domain then iterate
        sourceblock = cfg.projectedblock(direct.operation(i))
        /* Same-operation subevent order needs a separate event-order proof. */
        if sourceblock <> targetblock & index.dominates(sourceblock,targetblock) then covered = 1
      end
      if mode = 'transitive' & covered = 0 then do c = 1 to _callfunction[0]
        if queryspend(1) = 0 then return 0
        if _callfunction[c] <> functionid | _calltarget[c] = 0 then iterate
        sourceblock = cfg.projectedblock(_calloperation[c])
        if sourceblock = targetblock | index.dominates(sourceblock,targetblock) = 0 then iterate
        safe = 1
        if queryspend(1) = 0 then return 0
        do e = 1 to cfg.outedges(_calloperation[c])
          /* Indexed edge lookup follows e linked rows. Charge its full scan. */
          if queryspend(e) = 0 then return 0
          edge = cfg.outedge(_calloperation[c],e)
          if edge.role() <> 'normal' & edge.role() <> 'table' & edge.phase() <> 'none' & edge.targetblock() > 0 then safe = 0
        end
        if safe then do
          if mustproof(_calltarget[c],'transitive',family,kind,domain,active,depth + 1,maximum) then covered = 1
        end
      end
      if covered = 0 then return 0
    end
    return returns > 0
  calls: method = .int
    arg functionid = .int
    count = 0
    do i = 1 to _callfunction[0]; if _callfunction[i] = functionid then count = count + 1; end
    return count
  calltarget: method = .int
    arg functionid = .int, ordinal = .int
    count = 0
    do i = 1 to _callfunction[0]
      if _callfunction[i] <> functionid then iterate
      count = count + 1
      if count = ordinal then return _calltarget[i]
    end
    return 0
  returns: method = .int
    arg functionid = .int
    count = 0
    do i = 1 to _retfunction[0]; if _retfunction[i] = functionid then count = count + 1; end
    return count
  returnoperation: method = .int
    arg functionid = .int, ordinal = .int
    count = 0
    do i = 1 to _retfunction[0]
      if _retfunction[i] <> functionid then iterate
      count = count + 1
      if count = ordinal then return _retoperation[i]
    end
    return 0
  returnpossible: method = .lltargetsummary..effectfact
    arg functionid = .int
    call run()
    return .effectfact(reference self,_returnpossible[functionid],0,_returnunknown[functionid])
  returnvalue: method = .lltargetsummary..returnfact
    arg functionid = .int, domainid = .int
    call run()
    literal = .lltarget..operand(); candidate = .lltarget..operand()
    action = .lltargettransfer..action; refview = .lltargettransfer..refview
    flow = dereference _flow; profile_ref = flow.transfers(); profile = dereference profile_ref
    if valid() = 0 then return .returnfact(reference self,0,literal,'target.summary.owner.invalid')
    if _returnpossible[functionid] = 0 then return .returnfact(reference self,0,literal,'target.summary.no.finite.normal.return')
    if _returnunknown[functionid] then return .returnfact(reference self,0,literal,'target.summary.return.paths.unknown')
    count = 0
    do i = 1 to _retfunction[0]
      if _retfunction[i] <> functionid then iterate
      count = count + 1; action = profile.action(_retaction[i]); instruction = profile.instruction(_retoperation[i])
      candidate = .lltarget..operand()
      if action.domain() <> domainid then return .returnfact(reference self,0,literal,'target.summary.return.component.unknown')
      if action.sourcekind() = 'literal' then candidate = action.literal()
      else do j = 1 to instruction.references()
        refview = instruction.ref(j)
        if refview.id() <> action.subject() & refview.id() <> action.sourceid() then iterate
        fact = flow.componentat(_retoperation[i],refview.bank(),refview.index(),domainid)
        if fact.known() then candidate = fact.literal()
      end
      if candidate.kind() = '' then return .returnfact(reference self,0,literal,'target.summary.return.value.unknown')
      if count = 1 then literal = candidate
      else if literal.kind() <> candidate.kind() | literal.index() <> candidate.index() | bin2x(literal.bytes()) <> bin2x(candidate.bytes()) then return .returnfact(reference self,0,literal,'target.summary.return.values.conflict')
    end
    if count = 0 then return .returnfact(reference self,0,literal,'target.summary.no.normal.return')
    return .returnfact(reference self,1,literal,'')

analyse: procedure = .lltargetsummary..analysis
  arg flow = reference .lltargetflow..analysis, work = 1000000, bytes = 67108864
  return .analysis(flow,work,bytes)
