    end
    result = .footprintfact.checkpointed(.siteproof(reference self,state,reason),roles,constraints,abiproofs)
    _footprintfacts[sourceop] = result; _footprintpresent[sourceop] = 1
    return result
  useprovider: method = .int
    arg flowref = reference .lltargetflow..analysis, summaryref = reference .lltargetsummary..analysis
    call run()
    if valid() = 0 | <refvalid>(flowref) = 0 | <refvalid>(summaryref) = 0 then return 0
