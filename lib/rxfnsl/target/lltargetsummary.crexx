  actual: method = .lltarget..operand
    arg plan = .expansionplanfact, ordinal = .int
    value = .lltarget..operand
    owner = dereference _owner; flowref = owner.flow(); points = dereference flowref
    sourceref = points.owner(); source = dereference sourceref; called = source.at(plan.operation()); catalog = .llrxascatalog..catalog()
    ordinals = translate(catalog.callactuals(called.opcode()),' ',',')
    if catalog.callcount(called.opcode()) = 0 then do
      if ordinal < 1 | ordinal > words(ordinals) then return .lltarget..operand()
      value = called.operand(word(ordinals,ordinal) as .int)
    end
    else do
      first = called.operand(catalog.callwindow(called.opcode()))
      value = points.windowvalue(called.procedureid(),first,ordinal)
    end
    if value.kind() <> 'R' then return .lltarget..operand()
