    return result
  activationcharge: method = .int
    arg proof = .activationfact
    work = proof.proofs() + proof.targets() + proof.contexts() + proof.abiproofs() + 1
    bytes = proof.proofs() * 192 + proof.targets() * 320 + proof.contexts() * 256 + 128
