  procedureactivation: method = .lltargetsummary..activationfact
    arg functionid = .int, scoped = 1, depth = 0
    return genericactivation(functionid,scoped,depth)
  genericactivation: method = .lltargetsummary..activationfact
    arg functionid = .int, scoped = .int, depth = .int
    dependencies = .activationfact[]; targets = .lltargetflow..targetfact[]
    childproof = .activationfact; target = .lltargetflow..targetfact
    child = .int; c = .int; peer = .int
    call run()
    if valid() = 0 then return .activationfact(.siteproof(reference self,'invalid',message()),0)
    if functionid < 2 | functionid > _direct[0] | (scoped <> 0 & scoped <> 1) then return .activationfact(.siteproof(reference self,'unknown','target.activation.procedure.unproved'),0)
    _activationstarted = 1
    if prepareactivation(scoped) = 0 then return .activationfact(.siteproof(reference self,'limit',_sitefailure),0)
    key = functionid * 2 + scoped
    if _activationprocedurepresent[key] then return _activationprocedures[key]
    if depth >= 32 | _activationpreparing[key] then return .activationfact(.siteproof(reference self,'unknown','target.activation.recursion.or.depth.unproved'),0)
    _activationpreparing[key] = 1; state = 'proved'; reason = _activationdirectreason[key]; allowed = reason = ''
    if allowed = 0 then state = 'unknown'
    flow = dereference _flow; owner = flow.owner()
    c = _activationcallhead[functionid]
    do while c > 0
      if sitespend(1) = 0 | sitereserve(128) = 0 then do; _activationpreparing[key] = 0; return .activationfact(.siteproof(reference self,'limit',_sitefailure),0); end
      child = _calltarget[c]
      if child > 0 then childproof = genericactivation(child,scoped,depth + 1)
      else do
        target = flow.targetat(_calloperation[c])
        if target.status() <> 'proved' then childproof = .activationfact(.siteproof(reference self,'unknown',target.reason()),0)
        else do
          provider = target.provider(); transfers = target.transfers(); peer = 0
          if <refvalid>(transfers) then peer = providerindex(provider,transfers)
