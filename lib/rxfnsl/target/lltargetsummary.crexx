      if value.bank() <> 'r' then fixed = 1
      if binding.active() = 0 & fixed = 0 then do; state = 'unknown'; reason = 'target.footprint.binding.unproved'; end
      roles[roles[0] + 1] = .rolefact(proof,i,kind,value.bank(),value.index(),anchor,binding,fixed)
