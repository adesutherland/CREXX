      cursor = instance.candidate(r); _expected = 0; transfermode = 'ignored'
      from = .lltarget..operand(); into = .lltarget..operand()
      sourcepoint = points.resourceat(sourceop,'r',0); destination = sourcepoint.unknown()
      if catalog.callresult(called.opcode()) > 0 & kind > 1 then do
        into = mapping.callerregister(called.operand(catalog.callresult(called.opcode())),called.procedureid())
        if kind = 2 then do
          from = original.operand(catalog.returnsource(original.opcode())); mapped = instance.mapped(from)
          if mapped.kind() <> 'R' then return fail('unknown','target.expansion.return.source.mapping.unproved')
          transfermode = 'copy'
          if from.bank() = 'r' then do
            binding = _flow.storageat(cursor,mapped.bank(),mapped.index())
            if binding.active() = 0 | binding.entry() = 0 then return fail('unknown','target.expansion.return.source.binding.unproved')
            if binding.active() = binding.entry() then transfermode = 'move'
          end
          if transfermode <> plan.returnmode(sourceop) then return fail('unknown','target.expansion.return.transfer.mode.mismatch')
          sourcepoint = _flow.resourceat(cursor,mapped.bank(),mapped.index()); destination = _flow.resourceat(cursor,into.bank(),into.index())
          cursor = expect(candidate,cursor,transfermode,into,mapped)
        end
        else if kind = 3 | kind = 4 then do
          item = candidate.at(cursor); temporary = item.operand(1); registered = 0
          do j = 1 to instance.additions()
            if instance.additionrole(j) = 'return-temp' | instance.additionrole(j) = 'result-temp' then do
              if samevalue(instance.addition(j),temporary) then registered = 1
            end
          end
          if registered = 0 then return fail('unknown','target.expansion.return.literal.temporary.unproved')
          value = original.operand(catalog.returnsource(original.opcode()))
          cursor = expect(candidate,cursor,'load',temporary,value)
          name = 'icopy'; if kind = 4 then name = 'fcopy'
          destination = _flow.resourceat(cursor,into.bank(),into.index())
          cursor = expect(candidate,cursor,name,into,temporary)
          transfermode = 'field'
        end
        else return fail('unknown','target.expansion.return.string.setter.correspondence.unproved')
        if _status <> 'building' then return 0
      end
      /* Native rows remain the sole owner of hidden result/retire semantics.
       * Candidate endpoint facts discharge predicates under the storage map;
       * unknown source payloads are never assigned arbitrary defined values. */
      if catalog.abistate(original.opcode(),'physical-return') <> 'known' then return fail('unknown','target.expansion.return.abi.inventory.unproved')
      do j = 1 to catalog.abisteps(original.opcode(),'physical-return')
        operation = catalog.abioperation(original.opcode(),'physical-return',j)
        if operation = 'restore-numeric' then do
          if catalog.contextsynccontract() <> 'value-only-nonreentrant.v1' then return fail('unknown','target.expansion.return.numeric.sync.unproved')
        end
        else if operation = 'return-register' then do
          /* The checked result mapping and returnmode above select the same
           * copy_value or move_value operation as physical RET. The candidate
           * instruction has just been checked at this exact endpoint. Its
           * destination may already own resources: both executions release
           * them through that same value operation. Absolute ABI resource
           * absence is needed to remove a return hook, not to pair it. */
          if transfermode <> 'ignored' & transfermode <> 'copy' & transfermode <> 'move' then return fail('unknown','target.expansion.return.transfer.mode.unproved')
        end
        else do
          reason = _flow.abicondition(operation,sourcepoint,destination,transfermode,1,cleanprivate,1)
          if reason <> '' then return fail('unknown',reason)
        end
      end
      do i = 1 to restoration.fields()
        value = restoration.literal(i)
        if restoration.mode(i) = 'saved' then value = _saved[restoration.saveordinal(i)]
        cursor = expect(candidate,cursor,restoration.setter(i),value)
        if _status <> 'building' then return 0
      end
      /* Source retirement removes the slot view. Surviving caller views must
       * detach before continuation, including base proxies and owned locals. */
      do i = 1 to instance.mappings()
        value = instance.replacement(i)
        if mapping.callerfresh(called.procedureid(),value) = 0 then iterate
        cursor = expect(candidate,cursor,'unlink',value)
        if _status <> 'building' then return 0
      end
      do i = 1 to instance.mappings()
        value = instance.base(instance.original(i))
        if value.kind() <> 'R' then iterate
        cursor = expect(candidate,cursor,'unlink',value)
        if _status <> 'building' then return 0
      end
      cursor = expect(candidate,cursor,'br',.lltarget..operand.symbol(instance.continuation()))
      if _status <> 'building' then return 0
      if _expected <> instance.count(r) then return fail('unknown','target.expansion.return.extra.or.missing.event')
    end
    return 1
  /** Pair the native boundary program under its runtime rules. Root variants
   * stay conditional: live a0 and saved number_args are different endpoints,
   * and copyback/free count captures keep their distinct native phases. */
  boundaryprogram: method = .int
    arg original = .lltarget..record, copied = .lltarget..record, mode = .string
    catalog = .llrxascatalog..catalog()
    if catalog.abistate(original.opcode(),mode) <> 'known' | catalog.abistate(copied.opcode(),mode) <> 'known' then return fail('unknown','target.expansion.retained.' || mode || '.inventory.unproved')
    if catalog.abisteps(original.opcode(),mode) <> catalog.abisteps(copied.opcode(),mode) then return fail('unknown','target.expansion.retained.boundary.program.mismatch')
    do i = 1 to catalog.abisteps(original.opcode(),mode)
      if spend(1) = 0 then return 0
      operation = catalog.abioperation(original.opcode(),mode,i)
      if wordpos(operation,'return-register return-integer return-float return-string restore-numeric retire-frame deactivate-root capture-root-count copy-root-argument free-root-argument free-root-argument-unbind forget-root-argv-owner begin-recycled-frame clear-frame-control destroy-storage release-frame-plugins release-recycled-frame finish-runtime-storage finish-runtime-control cleanup-execution-signals reset-storage capture-root-status publish-root-status') = 0 then return fail('unknown','target.expansion.retained.boundary.operation.' || operation || '.unproved')
      if operation <> catalog.abioperation(copied.opcode(),mode,i) | catalog.abicheckpoint(original.opcode(),mode,i) <> catalog.abicheckpoint(copied.opcode(),mode,i) | catalog.abisource(original.opcode(),mode,i) <> catalog.abisource(copied.opcode(),mode,i) | catalog.abidestination(original.opcode(),mode,i) <> catalog.abidestination(copied.opcode(),mode,i) | catalog.abisourceextent(original.opcode(),mode,i) <> catalog.abisourceextent(copied.opcode(),mode,i) | catalog.abidestinationextent(original.opcode(),mode,i) <> catalog.abidestinationextent(copied.opcode(),mode,i) | catalog.abirule(original.opcode(),mode,i) <> catalog.abirule(copied.opcode(),mode,i) | catalog.abirepeat(original.opcode(),mode,i) <> catalog.abirepeat(copied.opcode(),mode,i) then return fail('unknown','target.expansion.retained.boundary.event.mismatch')
    end
    return 1
  retainedrelation: method = .int
    i = .int; j = .int
    owner = dereference _owner; flowref = owner.flow(); points = dereference flowref; sourceref = points.owner(); source = dereference sourceref
    mapping = dereference _mapping; candidate_ref = mapping.candidateowner(); candidate = dereference candidate_ref
    profile_ref = points.transfers(); before = dereference profile_ref; cfgref = points.cfg(); sourcecfg = dereference cfgref
    graphref = source.ir(); graph = dereference graphref; affected = .int[]
    if spend(graph.functions() + 1,(graph.functions() + 1) * 8) = 0 then return 0
    do i = 1 to graph.functions(); affected[i] = 0; end
    do i = 1 to mapping.instances()
      instance = mapping.instance(i); called = source.at(instance.callid()); affected[called.procedureid()] = 1
      caller = source.body(called.procedureid())
      /* Every newly surviving original backing, including inactive proxy
       * bases and temporary values, has a complete recycler/lifetime proof.
       * Merely choosing a fresh register number proves none of these facts. */
      do j = 1 to instance.mappings() + instance.additions()
        if spend(1) = 0 then return 0
        if j <= instance.mappings() then value = instance.replacement(j)
        else value = instance.addition(j - instance.mappings())
        if mapping.callerfresh(called.procedureid(),value) = 0 then iterate
        history = _flow.privatebackinghistory(value.procedureid(),'r',value.index())
        if history.resourcefree() = 0 | history.nonescape() = 0 then return fail(history.status(),history.reason())
      end
    end
    catalog = .llrxascatalog..catalog()
    do i = 1 to source.records()
      if spend(1) = 0 then return 0
      original = source.record(i)
      if original.kind() <> 'instruction' | affected[original.procedureid()] = 0 then iterate
      if mapping.instanceat(original.id()) > 0 then iterate
      operation = mapping.operation(original.id())
      if operation < 1 then return fail('invalid','target.expansion.retained.operation.missing')
      copied = candidate.at(operation); left = before.instruction(original.id()); right = _profile.instruction(copied.id())
      if left.complete('relocation') = 0 | right.complete('relocation') = 0 then return fail('unknown','target.expansion.retained.physical.observation.unproved')
      if left.references() <> right.references() then return fail('unknown','target.expansion.caller.reference.inventory.mismatch')
      do j = 1 to left.references()
        if spend(1) = 0 then return 0
        a = left.ref(j); b = right.ref(j)
        if a.kind() <> b.kind() | a.anchor() <> b.anchor() | a.extentknown() <> b.extentknown() | a.extent() <> b.extent() | a.role() <> b.role() | a.roleordinal() <> b.roleordinal() | a.targetbank() <> b.targetbank() | a.targetanchor() <> b.targetanchor() then return fail('unknown','target.expansion.caller.reference.mapping.unproved')
        if a.kind() = 'address' then return fail('unknown','target.expansion.caller.physical.address.mapping.unproved')
        if a.kind() = 'window' then do
          /* A checked front insertion maps the complete old packed suffix
           * R/G/A by one displacement. Every forward window, its dynamic
           * extent and its bounds failures are therefore preserved without
           * requiring an abstract scalar count in either flow owner. */
          if mapping.callersuffix(original.procedureid()) then do
            expected = mapping.callerregister(a.operand(),original.procedureid())
            if samevalue(expected,b.operand()) = 0 then return fail('unknown','target.expansion.caller.window.mapping.unproved')
            iterate
          end
          if a.extentknown() = 0 then return fail('unknown','target.expansion.caller.window.extent.unproved')
          do k = 0 to a.extent() - 1
            if spend(1) = 0 then return 0
            oldvalue = points.windowvalue(original.procedureid(),a.operand(),k)
            newvalue = _flow.windowvalue(copied.procedureid(),b.operand(),k)
            if samevalue(oldvalue,newvalue) = 0 then return fail('unknown','target.expansion.caller.window.mapping.unproved')
          end
        end
      end
      do j = 1 to left.actions()
        if spend(1) = 0 then return 0
        action = left.action(j)
        if action.kind() <> 'callback' | owner.abiaction(action) then iterate
        if catalog.callbackvaluesurface(original.opcode()) = 'bytes-snapshot' then iterate
        if before.recyclercleanup(original.id(),j,'callback') then iterate
        /* The caller instruction is retained in the same physical frame.
         * Its paired resource-only value hook remains on the same mapped
         * operands, with its possible result and exceptional effects intact. */
        if _flow.callbackpossibleat(copied.id(),j) & catalog.callbacknormalpreservesframe(original.opcode()) = 0 then return fail('unknown','target.expansion.retained.callback.observation.unproved')
      end
      if sourcecfg.outedges(original.id()) <> _cfg.outedges(copied.id()) then return fail('unknown','target.expansion.retained.departure.inventory.mismatch')
      do j = 1 to sourcecfg.outedges(original.id())
        if spend(j + 1) = 0 then return 0
        edge = sourcecfg.outedge(original.id(),j); projected = _cfg.outedge(copied.id(),j)
        if edge.complete() = 0 | projected.complete() = 0 | edge.scopecomplete() = 0 | projected.scopecomplete() = 0 then return fail('unknown','target.expansion.retained.departure.inventory.unproved')
        if edge.role() <> projected.role() | edge.phase() <> projected.phase() | edge.signalname() <> projected.signalname() | edge.asynchronous() <> projected.asynchronous() | edge.scopeexits() <> projected.scopeexits() | edge.scopeenters() <> projected.scopeenters() then return fail('unknown','target.expansion.retained.departure.mismatch')
        if edge.targetblock() > 0 then do
          targetop = mappedcalleroperation(source,mapping,edge.targetop())
          if targetop = 0 | projected.targetop() = 0 then return fail('unknown','target.expansion.retained.control.target.mismatch')
          if candidate.inlineaddress(targetop) <> candidate.inlineaddress(projected.targetop()) then return fail('unknown','target.expansion.retained.control.target.mismatch')
        end
        else do
          if edge.boundarykind() <> projected.boundarykind() | edge.exposure() <> projected.exposure() then return fail('unknown','target.expansion.retained.boundary.mismatch')
          if catalog.returnkind(original.opcode()) > 0 then do
            if boundaryprogram(original,copied,'physical-return') = 0 | boundaryprogram(original,copied,'root-return') = 0 then return 0
          end
          else if boundaryprogram(original,copied,'frame-unwind') = 0 | boundaryprogram(original,copied,'root-unwind') = 0 | boundaryprogram(original,copied,'root-sigreturn') = 0 then return 0
          if boundaryprogram(original,copied,'execution-finish') = 0 then return 0
        end
      end
    end
    return 1
  /** Control ownership is proved after the same checked relational phases.
   * Neither a naked boolean nor value-backing history supplies this receipt. */
  lifecyclerelation: method = .int
    owner = dereference _owner
    do i = 1 to _plans[0]
      receipt = .controlreceipt(reference self,i,_worklimit - _work,_bytelimit - _bytes)
      if incurred(receipt.usedwork(),receipt.usedbytes()) = 0 then return 0
      if receipt.status() <> 'proved' then return fail(receipt.status(),receipt.reason())
      priorownerwork = owner.usedwork(); priorownerbytes = owner.usedbytes()
      history = owner.framecontrolhistory(receipt,_worklimit - _work,_bytelimit - _bytes)
      /* A failed summary reservation may not own all of the helper's actual
       * cost. Retain that remainder before folding the shared owner delta. */
      if incurred(max(0,history.usedwork() - max(0,owner.usedwork() - priorownerwork)),max(0,history.usedbytes() - max(0,owner.usedbytes() - priorownerbytes))) = 0 then return 0
      if dependencycharge() = 0 then return 0
      if history.status() <> 'proved' then return fail(history.status(),history.reason())
      _lifecycles[i] = history
    end
    return 1
  phaseidentity: method = .int
    return _phaseidentity
  phasevalid: method = .int
    arg ordinal = .int, identity = .int
    if identity <> _phaseidentity | ordinal < 1 | ordinal > _phasepresent[0] | _candidateflowready = 0 then return 0
    if _phasepresent[ordinal] = 0 | <refvalid>(_owner) = 0 | <refvalid>(_mapping) = 0 then return 0
    owner = dereference _owner; mapping = dereference _mapping
    return owner.valid() & owner.identity() = _ownerid & mapping.valid() & _plans[ordinal].valid() & _flow.valid() & _profile.valid() & _cfg.valid()
  phaseowner: method = reference .analysis
    return _owner
  phasemapping: method = reference .lltargetremap..expansioncorrespondence
    return _mapping
  phaseplan: method = .expansionplanfact
    arg ordinal = .int
    return _plans[ordinal]
  phaseinstance: method = .lltargetremap..expansioninstance
    arg ordinal = .int
    mapping = dereference _mapping; return mapping.instance(ordinal)
  phasehooks: method = .string
    arg index = .int
    return _nohooks[index]
  phasehooklength: method = .int
    arg index = .int
    return length(_nohooks[index])
  phasepairedhooks: method = .string
    arg index = .int
    return _pairedhooks[index]
  phasepairedhooklength: method = .int
    arg index = .int
    return length(_pairedhooks[index])
  mappedoperation: method = .int
    arg source = .lltarget..module, instance = .lltargetremap..expansioninstance, sourceop = .int
    coordinate = source.inlineaddress(sourceop)
    do row = 1 to instance.rows()
      if spend(1) = 0 then return 0
      if instance.source(row) = 0 then iterate
      if source.inlineaddress(instance.source(row)) = coordinate then return instance.candidate(row)
    end
    return 0
  mappedcalleroperation: method = .int
    arg source = .lltarget..module, mapping = .lltargetremap..expansioncorrespondence, sourceop = .int
    coordinate = source.inlineaddress(sourceop); item = source.at(sourceop); functionid = item.procedureid()
    do row = 1 to source.records()
      if spend(1) = 0 then return 0
      item = source.record(row)
      if item.procedureid() <> functionid | item.kind() <> 'instruction' then iterate
      if source.inlineaddress(item.id()) <> coordinate then iterate
      targetop = mapping.operation(item.id())
      if targetop > 0 then return targetop
      instanceid = mapping.instanceat(item.id())
      if instanceid > 0 then do; instance = mapping.instance(instanceid); return instance.candidate(1); end
    end
    return 0
  samedomain: method = .int
    arg before = .lltargettransfer..profile, after = .lltargettransfer..profile, left = .int, right = .int
    if left = 0 | right = 0 then return left = right
    a = before.domain(left); b = after.domain(right)
    return a.kind() = b.kind() & a.key() = b.key() & a.nativebit() = b.nativebit()
  sameref: method = .int
    arg before = .lltargettransfer..profile, after = .lltargettransfer..profile, left = .int, right = .int, instance = .lltargetremap..expansioninstance
    if left = 0 | right = 0 then return left = right
    a = before.ref(left); b = after.ref(right)
    if a.kind() <> b.kind() | a.anchor() <> b.anchor() | a.extentknown() <> b.extentknown() | a.extent() <> b.extent() then return 0
    if a.role() <> b.role() | a.roleordinal() <> b.roleordinal() | a.addresskind() <> b.addresskind() | a.selectorkind() <> b.selectorkind() | a.selectoroffset() <> b.selectoroffset() | a.targetanchor() <> b.targetanchor() then return 0
    original = a.operand(); replacement = b.operand()
    if original.kind() = 'R' then do
      mapped = instance.mapped(original)
      if mapped.kind() <> 'R' | samevalue(mapped,replacement) = 0 then return 0
      /* A source base is not the original dirty backing of an active proxy.
       * Base-sensitive bindings require their separately checked lowering. */
      if a.anchor() = 'base' then do
        base = instance.base(original)
        if base.kind() = 'R' & samevalue(base,replacement) = 0 then return 0
      end
      return 1
    end
    if original.kind() = 'L' then return a.operandordinal() = b.operandordinal()
    return samevalue(original,replacement)
  sameaction: method = .int
    arg before = .lltargettransfer..profile, after = .lltargettransfer..profile, left = .lltargettransfer..action, right = .lltargettransfer..action, instance = .lltargetremap..expansioninstance
    if left.kind() <> right.kind() | left.sourcekind() <> right.sourcekind() | left.certainty() <> right.certainty() | left.path() <> right.path() | left.phase() <> right.phase() | left.detail() <> right.detail() | left.offset() <> right.offset() | left.observation() <> right.observation() | left.intrinsicfootprint() <> right.intrinsicfootprint() then return 0
    if samedomain(before,after,left.domain(),right.domain()) = 0 | sameref(before,after,left.subject(),right.subject(),instance) = 0 then return 0
    if left.sourcekind() = 'reference' then return sameref(before,after,left.sourceid(),right.sourceid(),instance)
    if left.sourcekind() = 'literal' then return samevalue(left.literal(),right.literal())
    if left.sourcekind() = 'captured' then do
      a = before.action(left.sourceid()); b = after.action(right.sourceid())
      /* Capture identity is its ordered native event, not a process-local ID. */
      return a.ordinal() = b.ordinal() & a.kind() = 'capture' & b.kind() = 'capture'
    end
    return left.sourceid() = right.sourceid()
  callcauses: method = .int
    arg plan = .expansionplanfact, instance = .lltargetremap..expansioninstance
    owner = dereference _owner; flowref = owner.flow(); points = dereference flowref
    sourceref = points.owner(); source = dereference sourceref; profile_ref = points.transfers(); before = dereference profile_ref
    item = source.at(plan.operation()); catalog = .llrxascatalog..catalog()
    if catalog.callcausestate(item.opcode()) <> 'known' then return fail('unknown','target.expansion.call.causes.unproved')
    do i = 1 to catalog.callcauses(item.opcode())
      if spend(1) = 0 then return 0
      cause = before.callcause(item.id(),i)
      if cause.valid() = 0 then return fail('invalid',cause.reason())
      if cause.possible() = 0 then iterate
      condition = cause.condition()
      select
        when condition = 'bytecode-allocation-failed' then do
          /* The approved exception is exact: infrastructure allocation only.
           * A callback or initializer failure cannot borrow this exception. */
          if cause.kind() <> 'frame-allocation' | cause.checkpoint() <> 'frame-allocation' | cause.callbacks() <> 0 | cause.names() <> 'FAILURE' then return fail('unknown','target.expansion.call.allocation.cause.unproved')
        end
        when condition = 'bytecode-window-invalid' | condition = 'bytecode-frame-layout-invalid' then do
          layout = plan.layout()
          if layout.status() <> 'proved' | layout.countknown() = 0 | layout.count() < 0 then return fail('unknown','target.expansion.call.layout.cause.unproved')
        end
        when condition = 'bytecode-frame-hook' then do
          if before.recyclercleanup(item.id(),i,'cause') = 0 then return fail('unknown','target.expansion.call.frame.preparation.unproved')
          /* This exact cause is incidental recycled-a0 cleanup. Its timing
           * is outside per-call equivalence; raw flow keeps its possible
           * callback and havoc. Current-body explicit resource operations
           * still pass through the ordinary body/exit ownership relation. */
        end
        when condition = 'provider-invoked' | condition = 'bytecode-provider-invoked' then nop /* The checked body relation owns this producer. */
        otherwise return fail('unknown','target.expansion.call.cause.' || cause.kind() || '.unmatched')
      end
    end
    return 1
  /** The existing native binding decoder owns primitive identity and operand
   * roles. A base-sensitive UNLINK is one LINK to the captured original base;
   * splitting a compound primitive still needs an exact phase partition. */
  bindingrelation: method = .int
    arg before = .lltargettransfer..profile, original = .lltarget..record, copied = .lltarget..record, count = .int, instance = .lltargetremap..expansioninstance
    right = .lltarget..operand
    sourceprogram = before.bindingprogram(original.id(),'binding',_worklimit - _work,_bytelimit - _bytes)
    if incurred(sourceprogram.usedwork(),sourceprogram.usedbytes()) = 0 then return 0
    candidateprogram = _profile.bindingprogram(copied.id(),'binding',_worklimit - _work,_bytelimit - _bytes)
    if incurred(candidateprogram.usedwork(),candidateprogram.usedbytes()) = 0 then return 0
    if sourceprogram.status() <> 'ok' then return fail(sourceprogram.status(),sourceprogram.reason())
    if candidateprogram.status() <> 'ok' then return fail(candidateprogram.status(),candidateprogram.reason())
    if count <> 1 | sourceprogram.steps() <> 1 | candidateprogram.steps() <> 1 then return fail('unknown','target.expansion.binding.phase.partition.unproved')
    kind = sourceprogram.kind(1); replacementkind = candidateprogram.kind(1)
    a = sourceprogram.operand(1,1); b = sourceprogram.operand(1,2)
    if a < 1 | a > original.operands() then return fail('invalid','target.expansion.binding.source.operand')
    subject = original.operand(a); expected = instance.mapped(subject)
    destination = copied.operand(candidateprogram.operand(1,1))
    if samevalue(expected,destination) = 0 then return fail('unknown','target.expansion.binding.destination.mismatch')
    if kind = 'unlink' then do
      base = instance.base(subject)
      if base.kind() <> 'R' | replacementkind <> 'link' then return fail('unknown','target.expansion.binding.base.mapping.unproved')
      right = copied.operand(candidateprogram.operand(1,2))
      if samevalue(base,right) = 0 then return fail('unknown','target.expansion.binding.base.mapping.unproved')
    end
    else if kind = 'argument' | kind = 'capturedargument' then do
      index = original.operand(b)
      if index.kind() <> 'I' then return fail('unknown','target.expansion.binding.argument.selector.unproved')
      ordinal = index.index(); offset = sourceprogram.operand(1,3)
      if offset > 0 then do; index = original.operand(offset); if index.kind() <> 'I' then return fail('unknown','target.expansion.binding.argument.offset.unproved'); ordinal = ordinal + index.index(); end
      provider_ref = instance.provider(); provider = dereference provider_ref
      formal = .lltarget..operand.bound(provider.identity(),instance.procedure(),0,'a',ordinal)
      expected = instance.mapped(formal)
      if kind = 'capturedargument' then expected = instance.base(formal)
      if expected.kind() <> 'R' | replacementkind <> 'link' then return fail('unknown','target.expansion.binding.argument.mapping.unproved')
      right = copied.operand(candidateprogram.operand(1,2))
      if samevalue(expected,right) = 0 then return fail('unknown','target.expansion.binding.argument.mapping.unproved')
    end
    else return fail('unknown','target.expansion.binding.primitive.correspondence.unproved')
    catalog = .llrxascatalog..catalog()
    if catalog.callbackobligations(original.opcode()) <> 0 | catalog.callbackobligations(copied.opcode()) <> 0 then return fail('unknown','target.expansion.binding.callback.phase.unproved')
    return 1
  bodyrelation: method = .int
    arg plan = .expansionplanfact, instance = .lltargetremap..expansioninstance
    mapid = .int; key = .string; bindingview = .lltargettransfer..refview
    owner = dereference _owner; flowref = owner.flow(); points = dereference flowref
    sourceref = points.owner(); source = dereference sourceref; profile_ref = points.transfers(); before = dereference profile_ref
    mapping = dereference _mapping; candidate_ref = mapping.candidateowner(); candidate = dereference candidate_ref
    catalog = .llrxascatalog..catalog(); cfgref = points.cfg(); sourcecfg = dereference cfgref
    do r = 1 to instance.rows()
      if spend(1) = 0 then return 0
      sourceop = instance.source(r)
      if sourceop = 0 then iterate
      original = source.at(sourceop); copied = candidate.at(instance.candidate(r))
      if catalog.returnkind(original.opcode()) > 0 then iterate
      left = before.instruction(sourceop); right = _profile.instruction(copied.id())
      do f = 1 to 12
        family = word('references components flags numeric signals order control values observations ownership effects bindings',f)
        if left.complete(family) = 0 | right.complete(family) = 0 then return fail('unknown','target.expansion.body.' || family || '.unproved')
      end
      do referenceid = 1 to left.references()
        if spend(1) = 0 then return 0
        bindingview = left.ref(referenceid); mapid = instance.mappingid(bindingview.operand())
        if mapid > 0 & bindingview.anchor() = 'base' then do
          if instance.mappingrole(mapid) = 'argument' then return fail('unknown','target.expansion.argument.base.requires.proxy')
        end
      end
      identical = instance.count(r) = 1 & original.opcode() = copied.opcode() & left.actions() = right.actions()
      if identical = 0 then do
        if bindingrelation(before,original,copied,instance.count(r),instance) = 0 then return 0
      end
      do a = 1 to left.actions()
        if spend(1) = 0 then return 0
        action = left.action(a)
        /* A child formal has its own pointer view. Rebinding a direct actual
         * would instead mutate the caller's slot; such views require proxies. */
        if wordpos(action.kind(),'link unlink swap') > 0 then do
          do bindingoperand = 1 to 2
            bindingref = action.subject()
            if bindingoperand = 2 then do
              if action.kind() <> 'swap' | action.sourcekind() <> 'reference' then iterate
              bindingref = action.sourceid()
            end
            if bindingref = 0 then return fail('unknown','target.expansion.argument.binding.inventory.unproved')
            bindingview = before.ref(bindingref); mapid = instance.mappingid(bindingview.operand())
            if mapid > 0 then do
              if instance.mappingrole(mapid) = 'argument' then return fail('unknown','target.expansion.argument.binding.requires.proxy')
            end
          end
        end
        if identical = 0 then iterate
        projected = right.action(a)
        if sameaction(before,_profile,action,projected,instance) = 0 then return fail('unknown','target.expansion.body.event.correspondence.unproved')
        if action.kind() = 'callback' then do
          if before.recyclercleanup(sourceop,a,'callback') then iterate
          if _flow.callbackpossibleat(copied.id(),a) then do
            /* A copied instruction invokes the same resource-only native
             * value hook with the mapped operands. Its unknown internal
             * checkpoint is shared by both executions; it does not acquire
             * a physical-frame observation merely because the VM may call a
             * payload copy/finalizer. Preserve the hook's full value/binding
             * havoc and all exceptional edges. Other callback routes still
             * need an explicit activation/phase observation contract. */
            if catalog.callbacknormalpreservesframe(original.opcode()) = 0 | catalog.callbacknormalpreservesframe(copied.opcode()) = 0 then do
              if wordpos(action.observation(),'physical unknown') > 0 then return fail('unknown','target.expansion.callback.activation.observation.unproved')
              if wordpos(action.phase(),'none before after') = 0 then return fail('unknown','target.expansion.callback.phase.correspondence.unproved')
            end
            else do
              key = action.id() as .string
              if spend(length(_pairedhooks[_checking]) + 1,length(key) + 1) = 0 then return 0
              _pairedhooks[_checking] = _pairedhooks[_checking] || ' ' || key
            end
          end
          else do
            key = action.id() as .string
            if spend(length(_nohooks[_checking]) + 1,length(key) + 1) = 0 then return 0
            _nohooks[_checking] = _nohooks[_checking] || ' ' || key
          end
        end
        if action.kind() = 'policy' then return fail('unknown','target.expansion.signal.policy.restoration.unproved')
        if action.kind() = 'call' then return fail('unknown','target.expansion.child.parent.observation.unproved')
      end
      if sourcecfg.outedges(sourceop) <> _cfg.outedges(copied.id()) then return fail('unknown','target.expansion.body.departure.correspondence.unproved')
      do e = 1 to sourcecfg.outedges(sourceop)
        if spend(e + 1) = 0 then return 0
        edge = sourcecfg.outedge(sourceop,e); projectededge = _cfg.outedge(copied.id(),e)
        if edge.complete() = 0 | projectededge.complete() = 0 | edge.scopecomplete() = 0 | projectededge.scopecomplete() = 0 then return fail('unknown','target.expansion.body.departure.inventory.unproved')
        if edge.role() <> projectededge.role() | edge.phase() <> projectededge.phase() | edge.signalname() <> projectededge.signalname() | edge.asynchronous() <> projectededge.asynchronous() | edge.scopeexits() <> projectededge.scopeexits() | edge.scopeenters() <> projectededge.scopeenters() then return fail('unknown','target.expansion.body.departure.correspondence.unproved')
        if edge.targetblock() > 0 then do
          targetop = mappedoperation(source,instance,edge.targetop())
          if targetop = 0 | projectededge.targetop() = 0 then return fail('unknown','target.expansion.body.control.target.mismatch')
          if candidate.inlineaddress(targetop) <> candidate.inlineaddress(projectededge.targetop()) then return fail('unknown','target.expansion.body.control.target.mismatch')
        end
        else do
          if edge.boundarykind() <> projectededge.boundarykind() | edge.exposure() <> projectededge.exposure() then return fail('unknown','target.expansion.body.boundary.correspondence.unproved')
          if edge.role() = 'unwind' then return fail('unknown','target.expansion.signal.return.restoration.unproved')
        end
      end
    end
    return 1
  run: method = .void
    ignored = .int; instance = .lltargetremap..expansioninstance; plan = .expansionplanfact
    i = .int
    if _status <> 'building' then return
    if <refvalid>(_owner) = 0 | <refvalid>(_mapping) = 0 then do; ignored = fail('invalid','target.expansion.relation.owner.expired'); return; end
    owner = dereference _owner; expected = _plan.owner()
    if (expected <refsame> _owner) = 0 | owner.valid() = 0 then do; ignored = fail('invalid','target.expansion.plan.owner.mismatch'); return; end
    _ownerid = owner.identity()
    flowref = owner.flow(); points = dereference flowref
    _sourcework = points.usedwork(); _sourcebytes = points.usedbytes(); _summarywork = owner.usedwork(); _summarybytes = owner.usedbytes(); _dependenciesready = 1
    if _plan.draftallowed() = 0 then do; ignored = fail(_plan.status(),_plan.reason()); return; end
    mapping = dereference _mapping
    /* A supplied frozen structural proof has already paid its construction
     * cost. Only materialization performed by this stage belongs here,
     * including work that ends in a structural refusal. */
    priorwork = mapping.usedwork(); priorbytes = mapping.usedbytes(); mappingstatus = mapping.status()
    if incurred(max(0,mapping.usedwork() - priorwork),max(0,mapping.usedbytes() - priorbytes)) = 0 then return
    if mappingstatus <> 'proved' then do; ignored = fail(mappingstatus,mapping.reason()); return; end
    if mapping.instances() > (_bytelimit - _bytes) <idiv> 24 then do; ignored = fail('limit','target.expansion.relation.work.or.bytes'); return; end
    if spend(mapping.instances(),mapping.instances() * 24) = 0 then return
    flowref = owner.flow(); points = dereference flowref; sourceref = points.owner(); supplied = mapping.sourceowner()
    if (supplied <refsame> sourceref) = 0 | mapping.instanceat(_plan.operation()) = 0 then do; ignored = fail('invalid','target.expansion.correspondence.source.mismatch'); return; end
    source = dereference sourceref; candidate_ref = mapping.candidateowner(); candidate = dereference candidate_ref
    graphref = candidate.ir(); graph = dereference graphref
    if spend(candidate.records() + graph.operations(),graph.operations() * 8) = 0 then return
    do i = 1 to graph.operations(); _next[i] = 0; end
    next = 0; functionid = 0
    do i = candidate.records() to 1 by -1
      item = candidate.record(i)
      if item.procedureid() <> functionid then do; next = 0; functionid = item.procedureid(); end
      if item.kind() <> 'instruction' then iterate
      _next[item.id()] = next; next = item.id()
    end
    profile_ref = points.transfers(); before = dereference profile_ref
    if before.premise() <> 'canonical' then do; ignored = fail('unknown','target.expansion.native.inventory.required'); return; end
    if before.executioncontext() <> '' then do
      root = source.body(before.executionroot()); functionid = candidate.procedureid(root.name())
      _profile = .lltargettransfer..profile.closedcalls(candidate_ref,functionid,before.executioncontext(),_worklimit - _work,_bytelimit - _bytes)
    end
    else _profile = .lltargettransfer..profile(candidate_ref,_worklimit - _work,_bytelimit - _bytes)
    profilestatus = _profile.status()
    if incurred(_profile.usedwork(),_profile.usedbytes()) = 0 then return
    if profilestatus <> 'ok' then do; ignored = fail(profilestatus,_profile.message()); return; end
    _cfg = .lltargetcfg..graph(candidate_ref,reference _profile,_worklimit - _work,_bytelimit - _bytes)
    cfgstatus = _cfg.status()
    if incurred(_cfg.usedwork(),_cfg.usedbytes()) = 0 then return
    if cfgstatus <> 'ok' then do; ignored = fail(cfgstatus,_cfg.message()); return; end
    _flow = .lltargetflow..analysis.relational(candidate_ref,reference _profile,reference _cfg,_worklimit - _work,_bytelimit - _bytes)
    _candidateflowready = 1
    if _flow.status() <> 'ok' then do; ignored = fail(_flow.status(),_flow.reason()); return; end
    if dependencycharge() = 0 then return
    do i = 1 to mapping.instances()
      instance = mapping.instance(i); plan = owner.expansionplan(instance.callid())
      _phasepresent[i] = 0; _nohooks[i] = ''; _pairedhooks[i] = ''; _checking = i
      if plan.draftallowed() = 0 then do; ignored = fail(plan.status(),plan.reason()); return; end
      _plans[i] = plan
      coverage = points.entrycoverage(instance.procedure())
      if coverage.valid() = 0 then do; ignored = fail(coverage.status(),coverage.reason()); return; end
      if coverage.complete() = 0 then do; ignored = fail(coverage.status(),coverage.reason()); return; end
      if coverage.demands() > 0 then do; ignored = fail('unknown','target.expansion.source.owned.entry.read.unresolved'); return; end
      if coverage.dependencies() > 0 then do; ignored = fail('unknown','target.expansion.source.owned.entry.dependency.unresolved'); return; end
      if callcauses(plan,instance) = 0 | entryrelation(plan,instance) = 0 | bodyrelation(plan,instance) = 0 | exitrelation(plan,instance) = 0 then return
      _phasepresent[i] = 1
      diagnostic = .diagnosticclone.expanded(_owner,candidate_ref,instance,_worklimit - _work,_bytelimit - _bytes)
      diagnosticstatus = diagnostic.status()
      if incurred(diagnostic.usedwork(),diagnostic.usedbytes()) = 0 then return
      if diagnosticstatus <> 'proved' then do; ignored = fail(diagnosticstatus,diagnostic.reason()); return; end
      _diagnostics[i] = diagnostic
    end
    if retainedrelation() = 0 then return
    if lifecyclerelation() = 0 then return
    _status = 'proved'
    return
  valid: method = .int
    call run()
    if dependencycharge() = 0 then return 0
    i = .int
    if _status <> 'proved' | <refvalid>(_owner) = 0 | <refvalid>(_mapping) = 0 then return 0
    owner = dereference _owner; mapping = dereference _mapping
    if owner.valid() = 0 | owner.identity() <> _ownerid | mapping.valid() = 0 | _plan.valid() = 0 | _flow.valid() = 0 | _cfg.valid() = 0 | _profile.valid() = 0 then return 0
    do i = 1 to _plans[0]; if _plans[i].valid() = 0 | _diagnostics[i].valid() = 0 then return 0; end
    if _lifecycles[0] <> _plans[0] then return 0
    do i = 1 to _lifecycles[0]; if _lifecycles[i].valid() = 0 then return 0; end
    return 1
  status: method = .string
    call run()
    if dependencycharge() = 0 then return _status
    if _status = 'proved' & valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    call run()
    if dependencycharge() = 0 then return _reason
    if _status = 'proved' & valid() = 0 then return 'target.expansion.relation.owner.expired.or.replaced'
    return _reason
  allowed: method = .int
    return valid()
  preserved: method = .int
    return valid()
  usedwork: method = .int
    ignored = dependencycharge()
    return _work
  usedbytes: method = .int
    ignored = dependencycharge()
    return _bytes
  sourcequerywork: method = .int
    return _sourcequerywork
  sourcequerybytes: method = .int
    return _sourcequerybytes
  /** Revoke only; wrapping a completed fact must not replace its actual
   * candidate/query counters with an empty zero-quota fact. */
  budgetrefusal: method = .void
    arg reason = .string
    ignored = dependencycharge()
    _status = 'limit'; _reason = reason; _chargesclosed = 1
    return
  result: method = .lltarget..module
    mapping = dereference _mapping
    if allowed() then do; result_ref = mapping.candidateowner(); output = dereference result_ref; return output; end
    owner = dereference _owner; flowref = owner.flow(); points = dereference flowref; source_ref = points.owner(); source = dereference source_ref
    return source

/** Expansion-aware preservation of the caller's existing physical boundary.
 * The provider clone and every unchanged caller record are checked together;
 * an identity correspondence cannot authorize this CALL-to-clone change.
 * The first theorem admits no new caller cells and no provider state delta.
 * Unknown entry payload is preserved, never relabelled clean. */
directequivalencefact: class
  _owner = reference .lltargetsummary..analysis
  _ownerid = .int
  _clone = .diagnosticclone
  _plan = .scopefreefact
  _call = .int
  _status = .string
  _reason = .string
  _work = .int
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  _covered = .int[]
  _nextinstruction = .int[]
  _sourcesteps = .string[]
  _candidatesteps = .string[]
  _firstaddress = .int
  _endaddress = .int
  _function = .int
  *: factory
    arg owner = reference .analysis, sourceop = .int, clone = .diagnosticclone, work = 1000000, bytes = 67108864
    _owner = owner; _call = sourceop; _clone = clone
    _status = 'building'; _worklimit = work; _bytelimit = bytes
    return
  failed: factory
    arg owner = reference .analysis, sourceop = .int, clone = .diagnosticclone, state = .string, reason = .string
    _owner = owner; _call = sourceop; _clone = clone; _status = state; _reason = reason
    return
  fail: method = .int
    arg state = .string, reason = .string
    if _status = 'building' then do; _status = state; _reason = reason; end
    return 0
  spend: method = .int
    arg work = 1, bytes = 0
    if work < 0 | bytes < 0 | work > _worklimit - _work | bytes > _bytelimit - _bytes then return fail('limit','target.retained.caller.work.or.bytes')
    _work = _work + work; _bytes = _bytes + bytes
    return 1
  samevalue: method = .int
    arg left = .lltarget..operand, right = .lltarget..operand
    if left.kind() <> right.kind() then return 0
    if left.kind() = 'R' then return left.bank() = right.bank() & left.index() = right.index()
    if left.kind() = 'I' then return left.index() = right.index()
    if spend(left.length() + right.length() + 1) = 0 then return 0
    return (bin2x(left.bytes()) == bin2x(right.bytes()))
  sameorigin: method = .int
    arg left = .llir..origin, right = .llir..origin
    a = left.sourcebytes(); b = right.sourcebytes()
    if spend(length(left.filename()) + length(right.filename()) + <blen>(a) + <blen>(b) + 1) = 0 then return 0
    return (left.filename() == right.filename()) & left.first() = right.first() & left.last() = right.last() & (bin2x(a) == bin2x(b))
  diagnostic: method = .int
    arg item = .lltarget..record
    return wordpos(item.kind(),'.srcfile .srcline .srcstep .inlineframe .inlinemap') > 0
  steps: method = .int
    arg source = .lltarget..module, candidate = .int
    value = .lltarget..operand
    graphref = source.ir(); graph = dereference graphref
    if spend(source.records(),graph.operations() * 24) = 0 then return 0
    active = '||'; legacyfile = ''; legacyline = ''; step = ''; functionid = 0
    do i = 1 to source.records()
      item = source.record(i)
      if item.procedureid() <> functionid then do
        functionid = item.procedureid(); active = '||'; legacyfile = ''; legacyline = ''; step = ''
      end
      if item.kind() = '.srcfile' | item.kind() = '.srcline' | item.kind() = '.srcstep' then do
        signature = ''; unavailable = 1
        do j = 1 to item.operands()
          value = item.operand(j)
          if spend(value.length() + 1) = 0 then return 0
          if item.kind() = '.srcstep' & j = 1 then iterate
          if value.kind() = 'I' then do
            signature = signature || 'I:' || value.index() || ';'
            if value.index() <> 0 then unavailable = 0
          end
          else do
            signature = signature || value.kind() || ':' || bin2x(value.bytes()) || ';'
            if value.length() <> 0 then unavailable = 0
          end
        end
        if item.kind() = '.srcfile' then legacyfile = signature
        else if item.kind() = '.srcline' then legacyline = signature
        else do
          value = item.operand(1); step = signature
          if value.index() = 0 then do
            if unavailable = 0 then return fail('unknown','target.retained.source.unavailable.payload.unproved')
            step = ''
          end
        end
        active = legacyfile || '|' || legacyline || '|' || step
      end
      if item.kind() = 'instruction' then do
        if spend(length(active) + 1,length(active)) = 0 then return 0
        if candidate then _candidatesteps[item.id()] = active
        else _sourcesteps[item.id()] = active
      end
    end
    return 1
  samerecord: method = .int
    arg left = .lltarget..record, right = .lltarget..record
    if left.kind() <> right.kind() | left.operands() <> right.operands() then return 0
    if left.kind() = 'instruction' then do
      if left.opcode() <> right.opcode() then return 0
      if (_sourcesteps[left.id()] == _candidatesteps[right.id()]) = 0 then return 0
    end
    if sameorigin(left.origin(),right.origin()) = 0 then return 0
    do i = 1 to left.operands()
      if spend(1) = 0 then return 0
      if samevalue(left.operand(i),right.operand(i)) = 0 then return 0
    end
    return 1
  providerunchangedstate: method = .int
    arg source = .lltarget..module, profile = .lltargettransfer..profile, cfg = .lltargetcfg..graph, provider = .lltarget..body
    i = .int; j = .int; family = .string
    do i = 1 to provider.records()
      item = provider.record(i)
      if item.kind() <> 'instruction' then iterate
      instruction = profile.instruction(item.id())
      do j = 1 to 12
        if spend(1) = 0 then return 0
        family = word('references components flags numeric signals order control values observations ownership effects bindings',j)
        if instruction.complete(family) = 0 then return fail('unknown','target.retained.provider.effects.unproved')
      end
      do j = 1 to instruction.actions()
        if spend(1) = 0 then return 0
        action = instruction.action(j)
        /* Source-only directplan has already discharged every provider hook,
         * including its exact invocation ABI. Reads and normal control leave
         * caller cells/context/policy untouched. All other effect vocabulary
         * needs a separate delta theorem; this is not an opcode allowlist. */
        if wordpos(action.kind(),'read return edge callback') = 0 then return fail('unknown','target.retained.provider.state.delta.unproved')
      end
      do j = 1 to cfg.outedges(item.id())
        if spend(j + 1) = 0 then return 0
        edge = cfg.outedge(item.id(),j)
        if edge.complete() = 0 | edge.scopecomplete() = 0 | edge.scopeexits() <> 0 | edge.scopeenters() <> 0 then return fail('unknown','target.retained.provider.departure.delta.unproved')
        if edge.targetblock() > 0 & wordpos(edge.role(),'normal table skip') > 0 then iterate
        if cfg.physicaldeparture(item.id()) & edge.boundarykind() = 'departure' & edge.phase() = 'none' then iterate
        return fail('unknown','target.retained.provider.departure.delta.unproved')
      end
    end
    return 1
  run: method = .void
    ignored = .int; i = .int; j = .int; cursor = .int; first = .int; remaining = .int; next = .int; celladdress = .int
    pastcall = .int; calladdress = .int
    instruction = .lltargettransfer..instruction; action = .lltargettransfer..action
    before = .lltarget..record; after = .lltarget..record; field = .lltarget..operand
    if _status <> 'building' then return
    if <refvalid>(_owner) = 0 then do; ignored = fail('invalid','target.retained.caller.owner.expired'); return; end
    owner = dereference _owner
    if owner.valid() = 0 then do; ignored = fail('invalid','target.retained.caller.owner.invalid'); return; end
    _ownerid = owner.identity(); actual = _clone.owner()
    if (actual <refsame> _owner) = 0 | _clone.operation() <> _call then do; ignored = fail('invalid','target.retained.caller.clone.owner.mismatch'); return; end
    if _clone.status() <> 'proved' then do; ignored = fail(_clone.status(),_clone.reason()); return; end
    _plan = owner.directplan(_call)
    if _plan.draftallowed() = 0 then do; ignored = fail(_plan.status(),_plan.reason()); return; end
    flowref = owner.flow(); flow = dereference flowref; sourceref = flow.owner(); source = dereference sourceref
    candidateref = _clone.candidate(); candidate = dereference candidateref
    profileref = flow.transfers(); profile = dereference profileref; cfgref = flow.cfg(); cfg = dereference cfgref
    catalog = .llrxascatalog..catalog(); called = source.at(_call); _function = called.procedureid()
    target = flow.targetat(_call); providerref = target.provider()
    if (providerref <refsame> sourceref) = 0 then do; ignored = fail('unknown','target.retained.foreign.provider.unproved'); return; end
    provider = source.body(target.procedure()); caller = source.body(_function)
    receiver = candidate.body(candidate.procedureid(caller.name()))
    layout = owner.calllayout(_call); restoration = _plan.restoration()
    if layout.resultkind() <> 'absent' | layout.countknown() = 0 then do; ignored = fail('unknown','target.retained.call.capture.delta.unproved'); return; end
    if layout.count() <> 0 then do; ignored = fail('unknown','target.retained.call.capture.delta.unproved'); return; end
    if provider.locals() <> 0 | receiver.locals() <> caller.locals() | restoration.fields() <> 0 then do; ignored = fail('unknown','target.retained.caller.extra.cells.unproved'); return; end
    if profile.boundaryobservation(_function) <> 'none' then do; ignored = fail('unknown','target.retained.caller.observations.unproved'); return; end
    if source.inlineframes() <> 0 then do; ignored = fail('unknown','target.retained.caller.existing.static.frames.unproved'); return; end
    if candidate.inlineframes() <> 1 then do; ignored = fail('unknown','target.retained.caller.extra.static.frames.unproved'); return; end
    if (source.name() == candidate.name()) = 0 | source.globals() <> candidate.globals() | source.procedures() <> candidate.procedures() then do; ignored = fail('unknown','target.retained.caller.module.shape.mismatch'); return; end
    scope = flow.scopeat(_call)
    if scope.known() = 0 then do; ignored = fail('unknown','target.retained.caller.scope.unproved'); return; end
    if scope.depth() <> 0 | cfg.scopedepth(_call) <> 0 then do; ignored = fail('unknown','target.retained.caller.scope.unproved'); return; end
    instruction = profile.instruction(_call)
    do i = 1 to 12
      if spend(1) = 0 then return
      family = word('references components flags numeric signals order control values observations ownership effects bindings',i)
      if instruction.complete(family) = 0 then do; ignored = fail('unknown','target.retained.call.effects.unproved'); return; end
    end
    do i = 1 to instruction.actions()
      if spend(1) = 0 then return
      action = instruction.action(i)
      if wordpos(action.kind(),'call callcapture capture read callback') = 0 then do; ignored = fail('unknown','target.retained.call.departure.correspondence.unproved'); return; end
      if action.kind() = 'callback' then do
        if owner.equivalencecallback(_call,i,1) then do; ignored = fail('unknown','target.retained.call.callback.unproved'); return; end
      end
    end
    do i = 1 to cfg.outedges(_call)
      if spend(i + 1) = 0 then return
      edge = cfg.outedge(_call,i)
      if edge.complete() & edge.targetblock() > 0 & wordpos(edge.role(),'normal table skip') > 0 then iterate
      /* Pairing an arbitrary CALL failure with a normal-only clone would
       * silently erase that event. Typed CALL-cause correspondence, including
       * the approved removable infrastructure opportunity, is a distinct
       * extension; no reason text or signal name can assert it here. */
      ignored = fail('unknown','target.retained.call.departure.correspondence.unproved'); return
    end
    if providerunchangedstate(source,profile,cfg,provider) = 0 then return
    graphref = candidate.ir(); graph = dereference graphref
    if spend(source.records() + candidate.records() * 2 + graph.operations(),graph.operations() * 16) = 0 then return
    do i = 1 to graph.operations(); _covered[i] = 0; _nextinstruction[i] = 0; end
    functionid = 0; next = 0
    do i = candidate.records() to 1 by -1
      after = candidate.record(i)
      if after.procedureid() <> functionid then do; functionid = after.procedureid(); next = 0; end
      if after.kind() <> 'instruction' then iterate
      _nextinstruction[after.id()] = next; next = after.id()
    end
    _firstaddress = -1; _endaddress = -1
    do i = 1 to _clone.rows()
      if _clone.sourceentry(i) = 0 then do; ignored = fail('unknown','target.retained.caller.entry.cells.unproved'); return; end
      first = _clone.candidateentry(i); remaining = _clone.entrycount(i)
      do while remaining > 0 & first > 0
        if spend(1) = 0 then return
        after = candidate.at(first)
        _covered[after.id()] = 1; remaining = remaining - 1
        celladdress = candidate.inlineaddress(after.id())
        if _firstaddress < 0 then _firstaddress = celladdress
        _endaddress = celladdress + after.operands() + 1
        first = _nextinstruction[first]
      end
      if remaining <> 0 then do; ignored = fail('invalid','target.retained.caller.clone.locator.extent'); return; end
    end
    if steps(source,0) = 0 | steps(candidate,1) = 0 then return
    cursor = 1; pastcall = 0; calladdress = source.inlineaddress(_call)
    do i = 1 to source.records()
      if spend(1) = 0 then return
      before = source.record(i)
      if before.id() = _call then do; pastcall = 1; iterate; end
      if diagnostic(before) then iterate
      if before.kind() = 'instruction' then do
        instruction = profile.instruction(before.id())
        if instruction.complete('relocation') = 0 then do; ignored = fail('unknown','target.retained.caller.instruction.observer.unproved'); return; end
        do j = 1 to instruction.actions()
          if spend(1) = 0 then return
          action = instruction.action(j)
          if action.kind() = 'callback' & owner.abiaction(action) = 0 & wordpos(action.observation(),'physical unknown') > 0 then do
            if owner.equivalencecallback(before.id(),j,1) then do; ignored = fail('unknown','target.retained.caller.callback.observer.unproved'); return; end
          end
        end
      end
      do while cursor <= candidate.records()
        if spend(1) = 0 then return
        after = candidate.record(cursor)
        if diagnostic(after) then do; cursor = cursor + 1; iterate; end
        if after.kind() = 'instruction' then do
          if _covered[after.id()] then do; cursor = cursor + 1; iterate; end
        end
        if after.kind() = 'label' & after.procedureid() = receiver.functionid() then do
          if samerecord(before,after) then leave
          celladdress = candidate.inlineaddress(after.id())
          if celladdress >= _firstaddress & celladdress <= _endaddress then do; cursor = cursor + 1; iterate; end
        end
        leave
      end
      if cursor > candidate.records() then do; ignored = fail('unknown','target.retained.caller.record.missing'); return; end
      after = candidate.record(cursor)
      if samerecord(before,after) = 0 then do; ignored = fail('unknown','target.retained.caller.record.delta.unproved'); return; end
      if before.procedureid() = _function & before.kind() <> 'procedure' then do
        celladdress = candidate.inlineaddress(after.id())
        if pastcall then do
          if celladdress < _endaddress then do; ignored = fail('unknown','target.retained.caller.control.boundary.mismatch'); return; end
        end
        else do
          extent = 0
          if before.kind() = 'instruction' then extent = before.operands() + 1
          if celladdress + extent > _firstaddress then do; ignored = fail('unknown','target.retained.caller.control.boundary.mismatch'); return; end
          /* A label naming the removed CALL's entry must still enter its
           * replacement. In particular a post-CALL bypass label cannot be
           * moved before covered clone instructions while retaining its text. */
          if before.kind() <> 'instruction' & source.inlineaddress(before.id()) = calladdress & celladdress <> _firstaddress then do; ignored = fail('unknown','target.retained.caller.control.boundary.mismatch'); return; end
        end
      end
      if before.kind() = 'instruction' & candidate.inlineframeat(after.id()) <> 0 then do; ignored = fail('unknown','target.retained.caller.frame.attribution.mismatch'); return; end
      cursor = cursor + 1
    end
    do while cursor <= candidate.records()
      if spend(1) = 0 then return
      after = candidate.record(cursor)
      if diagnostic(after) = 0 then do; ignored = fail('unknown','target.retained.caller.record.extra'); return; end
      cursor = cursor + 1
    end
    _status = 'proved'
    return
  valid: method = .int
    call run()
    if _status <> 'proved' | <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner
    return owner.valid() & owner.identity() = _ownerid & _plan.valid() & _clone.valid()
  status: method = .string
    call run()
    if _status = 'proved' & valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    call run()
    if _status = 'proved' & valid() = 0 then return 'target.retained.caller.owner.expired.or.replaced'
    return _reason
  allowed: method = .int
    return valid()
  /** Preserved is distinct from the raw ABI's possible() result. */
  preserved: method = .int
    return valid()
  usedwork: method = .int
    return _work
  usedbytes: method = .int
    return _bytes
  result: method = .lltarget..module
    if allowed() then do; candidateref = _clone.candidate(); output = dereference candidateref; return output; end
    owner = dereference _owner; flowref = owner.flow(); flow = dereference flowref; sourceref = flow.owner()
    source = dereference sourceref; return source

/** An immutable procedure/mode view. Direct effects do not include callee
 * bodies; transitive may effects include the exact locally bound closure. */
summary: class
  _owner = reference .lltargetsummary..analysis
  _identity = .int
  _function = .int
  _mode = .string
  *: factory
    arg owner = reference .analysis, functionid = .int, mode = .string
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _function = functionid; _mode = mode
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner; return owner.valid() & owner.identity() = _identity
  status: method = .string
    if valid() then return 'ok'
    return 'invalid'
  reason: method = .string
    if valid() then return ''
    return 'target.summary.owner.expired.or.replaced'
  require: method = .void
    if valid() = 0 then assembler signal "ERROR","LL_TARGET_SUMMARY: expired or replaced procedure view"
    return
  function: method = .int
    call require()
    return _function
  mode: method = .string
    call require()
    return _mode
  effect: method = .lltargetsummary..effectfact
    arg family = .string, kind = .string, domain = '*', depth = 64
    call require(); owner = dereference _owner; return owner.effect(_function,_mode,family,kind,domain,depth)
  outwardeffect: method = .lltargetsummary..effectfact
    arg family = .string, kind = .string, domain = '*'
    call require(); owner = dereference _owner; return owner.outwardeffect(_function,_mode,family,kind,domain)
  calls: method = .int
    call require(); owner = dereference _owner; return owner.calls(_function)
  calltarget: method = .int
    arg ordinal = .int
    call require(); owner = dereference _owner; return owner.calltarget(_function,ordinal)
  returns: method = .int
    call require(); owner = dereference _owner; return owner.returns(_function)
  returnoperation: method = .int
    arg ordinal = .int
    call require(); owner = dereference _owner; return owner.returnoperation(_function,ordinal)
  returnvalue: method = .lltargetsummary..returnfact
    arg domain = .int
    call require(); owner = dereference _owner; return owner.returnvalue(_function,domain)
  mayreturn: method = .lltargetsummary..effectfact
    call require(); owner = dereference _owner; return owner.returnpossible(_function)

/** Module analysis shares the exact point/edge owner and its dependency
 * identity. Fixed points grow may sets from direct events; child uncertainty
 * widens affected families, never establishes a must effect or constant. */
analysis: class
  _flow = reference .lltargetflow..analysis
  _flowid = .int
  _identity = .int
  _status = .string
  _message = .string
  _work = .int
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  _direct = .object[]
  _transitive = .object[]
  _callfunction = .int[]
  _calloperation = .int[]
  _calltarget = .int[]
  _retfunction = .int[]
  _retoperation = .int[]
  _retaction = .int[]
  _returnpossible = .int[]
  _returnunknown = .int[]
  _querywork = .int
  _querylimit = .int
  _queryreason = .string
  _sitework = .int
  _sitebytes = .int
  _sitefailure = .string
  _discardfacts = .discardfact[]
  _discardpresent = .int[]
  _footprintfacts = .footprintfact[]
  _footprintpresent = .int[]
  _layoutfacts = .layoutfact[]
  _layoutpresent = .int[]
  _scopefacts = .scopefreefact[]
  _scopepresent = .int[]
  _restorefacts = .restorationfact[]
  _restorepresent = .int[]
  _activationfacts = .activationfact[]
  _activationpresent = .int[]
  _providers = .providerbundle[]
  _activationstarted = .int
  _activationdirectready = .int[]
  _activationdirectreason = .string[]
  _activationdiagnostic = .int[]
  _activationprocedures = .activationfact[]
  _activationprocedurepresent = .int[]
  _activationpreparing = .int[]
  _activationcallhead = .int[]
  _activationcallnext = .int[]
  _activationcallsready = .int
  _activationabihead = .int[]
  _activationabitail = .int[]
  _activationabicount = .int[]
  _activationabiop = .int[]
  _activationabiedge = .int[]
  _activationabinext = .int[]
  _activationabiready = .int
  _activationinprogress = .int[]
  *: factory
    arg flow = reference .lltargetflow..analysis, work = 1000000, bytes = 67108864
    _flow = flow; _identity = nextidentity(); _status = 'building'
    _worklimit = work; _bytelimit = bytes
    return
  fail: method = .int
    arg status = .string, message = .string
    _status = status; _message = message
    return 0
  spend: method = .int
    arg amount = .int
    if amount < 0 | amount > _worklimit - _work then return fail('limit','target.summary.work')
    _work = _work + amount
    return 1
  reserve: method = .int
    arg amount = .int
    if amount < 0 | amount > _bytelimit - _bytes then return fail('limit','target.summary.bytes')
    _bytes = _bytes + amount
    return 1
  queryspend: method = .int
    arg amount = .int
    if amount < 0 | amount > _worklimit - _work - _sitework - _querywork then do; _querylimit = 1; _queryreason = 'target.summary.must.work'; return 0; end
    _querywork = _querywork + amount
    return 1
  sitespend: method = .int
    arg amount = .int
    if amount < 0 | amount > _worklimit - _work - _sitework then do; _sitefailure = 'target.site.work'; return 0; end
    _sitework = _sitework + amount; return 1
  sitereserve: method = .int
    arg amount = .int
    if amount < 0 | amount > _bytelimit - _bytes - _sitebytes then do; _sitefailure = 'target.site.bytes'; return 0; end
    _sitebytes = _sitebytes + amount; return 1
  sitebegin: method = .int
    arg sourceop = .int
    call run()
    if valid() = 0 | _sitefailure <> '' then return 0
    flow = dereference _flow; owner = flow.owner(); source = dereference owner; item = source.at(sourceop)
    return item.valid()
  addoutput: method = .int
    arg expose outputs = .int[], domainid = .int
    if sitespend(outputs[0] + 1) = 0 then return 0
    do i = 1 to outputs[0]; if outputs[i] = domainid then return 1; end
    if sitereserve(8) = 0 then return 0
    outputs[outputs[0] + 1] = domainid
    return 1
  /** Shared flow owns hook-condition proof, including captured BEFORE state
   * on normal and exceptional prefixes. No absence is inferred from a facet's
   * missing row, nor from the fact that a callback eventually returned. */
  callbackmay: method = .int
    arg sourceop = .int, ordinal = .int, site = 0
    flow = dereference _flow; cfg_ref = flow.cfg(); cfg = dereference cfg_ref
    do i = 0 to cfg.outedges(sourceop)
      if site then do; if sitespend(1) = 0 then return 1; end
      else if spend(1) = 0 then return 1
      edgeid = 0
      if i > 0 then do; edge = cfg.outedge(sourceop,i); edgeid = edge.id(); end
      possible = flow.callbackpossibleat(sourceop,ordinal,edgeid)
      if flow.status() <> 'ok' then do; ignored = fail(flow.status(),flow.reason()); return 1; end
      if possible then return 1
    end
    return 0
  /** Only inliner equivalence uses the incidental-cleanup contract. Shared
   * effects, discard/liveness and actual callback-state flow stay raw. */
  equivalencecallback: method = .int
    arg sourceop = .int, ordinal = .int, site = 0
    if site then do; if sitespend(max(0,ordinal) + 24) = 0 then return 1; end
    else if spend(max(0,ordinal) + 24) = 0 then return 1
    flow = dereference _flow; profileref = flow.transfers(); profile = dereference profileref
    if profile.recyclercleanup(sourceop,ordinal,'callback') then return 0
    return callbackmay(sourceop,ordinal,site)
  abiaction: method = .int
    arg action = .lltargettransfer..action
    return action.kind() = 'callback' & wordpos(action.detail(),'catalog.callback.abi catalog.callback.departure') > 0
  abiedge: method = .int
    arg edge = .lltargetcfg..edge, cfg = .lltargetcfg..graph
    if edge.scopeexits() > 0 | edge.scopeenters() > 0 then return 1
    if edge.sourceop() > 0 then do
      if edge.scopecomplete() = 0 & cfg.scopedepth(edge.sourceop()) > 0 then return 1
    end
    /* Independent operational premises acquire only their explicit effects.
     * Actual RXAS admission separately requires the canonical native profile. */
    profile_ref = cfg.profile(); profile = dereference profile_ref
    if profile.premise() <> 'canonical' then return 0
    /* Empty logical scope exits do not prove absent physical-frame cleanup. */
    if wordpos(edge.role(),'terminal unwind') > 0 then return 1
    if edge.targetblock() = 0 & edge.boundarykind() <> '' then return 1
    return 0
  /** Full departures remain obligations for outward and activation facts. */
  abimay: method = .int
    arg sourceop = .int, site = 0
    return abipossible(sourceop,site,0)
  /** Local output/placement edits use the same sealed fact's intrinsic view.
   * Async origin and row attribution are owned by CFG/flow, never guessed here. */
  abiintrinsicmay: method = .int
    arg sourceop = .int, site = 1
    return abipossible(sourceop,site,1)
  abipossible: method = .int
    arg sourceop = .int, site = .int, intrinsic = .int
    i = .int; hiddenabi = .int; proof = .lltargetflow..abicallbackfact; ignored = .int
    flow = dereference _flow; cfg_ref = flow.cfg(); cfg = dereference cfg_ref
    profile_ref = flow.transfers(); profile = dereference profile_ref; instruction = profile.instruction(sourceop)
    hiddenabi = 0
    do i = 1 to instruction.actions()
      if site then do; if sitespend(1) = 0 then return 1; end
      else if spend(1) = 0 then return 1
      if abiaction(instruction.action(i)) then hiddenabi = 1
    end
    if hiddenabi then do
      proof = flow.abicallbackat(sourceop)
      if flow.status() <> 'ok' then do; ignored = fail(flow.status(),flow.reason()); return 1; end
      if intrinsic then do
        if proof.intrinsicstatus() = 'limit' then do; ignored = fail('limit',proof.intrinsicreason()); return 1; end
        if proof.intrinsicpossible() then return 1
      end
      else do
        if proof.status() = 'limit' then do; ignored = fail('limit',proof.reason()); return 1; end
        if proof.possible() then return 1
      end
    end
    do i = 1 to cfg.outedges(sourceop)
      if site then do; if sitespend(i + 1) = 0 then return 1; end
      else if spend(i + 1) = 0 then return 1
      edge = cfg.outedge(sourceop,i)
      if hiddenabi = 0 & abiedge(edge,cfg) = 0 then iterate
      proof = flow.abicallbackat(sourceop,edge.id())
      if flow.status() <> 'ok' then do; ignored = fail(flow.status(),flow.reason()); return 1; end
      if intrinsic then do
        if proof.intrinsicstatus() = 'limit' then do; ignored = fail('limit',proof.intrinsicreason()); return 1; end
        if proof.intrinsicpossible() then return 1
      end
      else do
        if proof.status() = 'limit' then do; ignored = fail('limit',proof.reason()); return 1; end
        if proof.possible() then return 1
      end
    end
    return 0
  abiunknown: method = .void
    arg expose result = .row
    ignored = .int
    do i = 1 to 13
      family = word('effects calls bindings ownership numeric values observations arguments globals components flags signals control',i)
      ignored = result.unknown(family)
    end
    return
  addactivationabi: method = .int
    arg functionid = .int, sourceop = .int, edgeid = .int
    if sitespend(1) = 0 | sitereserve(32) = 0 then return 0
    id = _activationabiop[0] + 1
    _activationabiop[id] = sourceop; _activationabiedge[id] = edgeid; _activationabinext[id] = 0
    if _activationabihead[functionid] = 0 then _activationabihead[functionid] = id
    else _activationabinext[_activationabitail[functionid]] = id
    _activationabitail[functionid] = id; _activationabicount[functionid] = _activationabicount[functionid] + 1
    return 1
  abirole: method = .int
    arg expose roles = .rolefact[], proof = .siteproof, kind = .string, checkpoint = .string, extent = .string, resource = .lltargetflow..abiresource, functionid = .int
    if resource.storage() = 0 then return extent = 'none'
    if resource.valid() = 0 | resource.live() = 0 then return 0
    points_ref = resource.points()
    if (points_ref <refsame> _flow) = 0 then return 0
    points = dereference points_ref; storage = resource.storage()
    bank = points.storagebank(storage); number = points.storageindex(storage)
    if bank = '' | number < 0 then return 0
    if bank <> 'g' & points.storagefunction(storage) <> functionid then return 0
    if sitespend(1) = 0 | sitereserve(320) = 0 then return 0
    roles[roles[0] + 1] = .rolefact.checkpoint(proof,'abi.' || kind,bank,number,'abi.' || checkpoint,resource)
    return 1
  abifootprint: method = .string
    arg sourceop = .int, expose roles = .rolefact[], expose constraints = .constraintfact[], expose proofs = .lltargetflow..abicallbackfact[], proof = .siteproof
    i = .int; j = .int; hiddenabi = .int; edgeid = .int; ignored = .int
    row = .lltargetflow..abirow; abi = .lltargetflow..abicallbackfact
    flow = dereference _flow
    cfg_ref = flow.cfg(); cfg = dereference cfg_ref; profile_ref = flow.transfers(); profile = dereference profile_ref
    instruction = profile.instruction(sourceop); item = instruction.record(); hiddenabi = 0
    do i = 1 to instruction.actions()
      if sitespend(1) = 0 then return _sitefailure
      if abiaction(instruction.action(i)) then hiddenabi = 1
    end
    do i = 0 to cfg.outedges(sourceop)
      if sitespend(i + 1) = 0 then return _sitefailure
      edgeid = 0
      if i = 0 then do; if hiddenabi = 0 then iterate; end
      else do
        edge = cfg.outedge(sourceop,i); edgeid = edge.id()
        if hiddenabi = 0 & abiedge(edge,cfg) = 0 then iterate
      end
      abi = flow.abicallbackat(sourceop,edgeid)
      if flow.status() <> 'ok' then do; ignored = fail(flow.status(),flow.reason()); return flow.reason(); end
      if abi.intrinsicstatus() = 'limit' then do; ignored = fail('limit',abi.intrinsicreason()); return abi.intrinsicreason(); end
      if abi.intrinsicstatus() <> 'proved' | abi.intrinsicpossible() then return 'target.footprint.abi.unproved'
      if sitespend(abi.intrinsicrows() * 2 + 1) = 0 | sitereserve(abi.bytes()) = 0 then return _sitefailure
      proofs[proofs[0] + 1] = abi
      do j = 1 to abi.intrinsicrows()
        row = abi.intrinsicrow(j)
        if abirole(roles,proof,row.sourcerole(),row.checkpoint(),row.sourceextent(),row.source(),item.procedureid()) = 0 then return 'target.footprint.abi.resource.unproved'
        if abirole(roles,proof,row.destinationrole(),row.checkpoint(),row.destinationextent(),row.destination(),item.procedureid()) = 0 then return 'target.footprint.abi.resource.unproved'
        if row.operation() = 'restore-slot' | row.operation() = 'bind-proxy' then do
          if row.slotknown() = 0 | row.slotfunction() <> item.procedureid() then return 'target.footprint.abi.slot.unproved'
          bank = row.slotbank(); number = row.slotindex()
          if bank = '' | number < 0 then return 'target.footprint.abi.slot.unproved'
          if sitespend(1) = 0 | sitereserve(384) = 0 then return _sitefailure
          binding = flow.unprovedstorage('target.footprint.abi.slot.only')
          roles[roles[0] + 1] = .rolefact(proof,0,'abi.' || row.destinationrole(),bank,number,'slot',binding,1)
          empty = .int[]
          constraints[constraints[0] + 1] = .constraintfact(proof,'fixed',bank,number,1,empty)
        end
      end
    end
    return ''
  boundchild: method = .int
    arg instruction = .lltargettransfer..instruction, action = .lltargettransfer..action
    literal = .lltarget..operand(); refview = .lltargettransfer..refview; i = .int
    flow = dereference _flow; source_ref = flow.owner(); source = dereference source_ref
    profile_ref = flow.transfers(); profile = dereference profile_ref
    if profile.premise() = 'canonical' then do
      target = flow.targetat(instruction.opid())
      if target.status() <> 'proved' then return 0
      provider = target.provider()
      if (provider <refsame> source_ref) = 0 then return 0
      return target.procedure()
    end
    if action.sourcekind() = 'literal' then literal = action.literal()
    else if action.sourcekind() = 'reference' then do
      do i = 1 to instruction.references()
        refview = instruction.ref(i)
        if refview.id() = action.sourceid() then literal = refview.operand()
      end
    end
    else do i = 1 to instruction.references()
      refview = instruction.ref(i)
      if refview.kind() = 'procedure' then do
        if literal.kind() <> '' then return 0
        literal = refview.operand()
      end
    end
    if literal.kind() <> 'P' then return 0
    return source.procedureid(literal.text())
  symboliceffect: method = .void
    arg expose result = .row, instruction = .lltargettransfer..instruction, refid = .int, operation = .string, key = .string, profile = .lltargettransfer..profile, ordinal = .int
    ignored = .int; i = .int
    if refid = 0 then return
    refview = profile.ref(refid)
    if refview.bank() = '' & refview.kind() <> 'address' then return
    flow = dereference _flow; cfg_ref = flow.cfg(); cfg = dereference cfg_ref
    action = instruction.action(ordinal)
    do i = 0 to cfg.outedges(instruction.opid())
      edgeid = 0; exceptional = 0; phase = 'unknown'
      if i > 0 then do
        edge = cfg.outedge(instruction.opid(),i); edgeid = edge.id(); phase = edge.phase()
        exceptional = phase <> 'none' & edge.role() <> 'normal' & edge.role() <> 'table' & right(edge.exposure(),6) <> '-async'
        if exceptional = 0 then iterate
      end
      if flow.applies(action,exceptional,phase) = 0 then iterate
      location = flow.actionstorage(instruction.opid(),ordinal,refid,edgeid)
      if flow.status() <> 'ok' then do; ignored = result.unknown('effects'); return; end
    storage = location.active()
    if refview.anchor() = 'base' then storage = location.base()
    else if refview.anchor() = 'entry' then storage = location.entry()
    else if refview.anchor() <> 'active' then storage = 0
    bank = flow.storagebank(storage)
    if storage = 0 | bank = '' then do
      ignored = result.unknown('arguments'); ignored = result.unknown('globals'); ignored = result.unknown('ownership'); iterate
    end
    if bank = 'a' then ignored = result.add('arguments',operation,'argument.' || flow.storageindex(storage) || '.' || key,instruction.opid(),0)
    else if bank = 'g' then ignored = result.add('globals',operation,'global.' || flow.revision() || '.' || flow.storageindex(storage) || '.' || key,instruction.opid(),0)
    /* Without call-site no-alias premises, mutation through a borrowed or
     * global storage can also be visible through another incoming alias. */
    if (operation = 'write' | operation = 'release') & (bank = 'a' | bank = 'g') then do
      ignored = result.unknown('arguments'); ignored = result.unknown('globals')
    end
    end
    return
  eventrow: method = .void
    arg expose result = .row, instruction = .lltargettransfer..instruction, action = .lltargettransfer..action, profile = .lltargettransfer..profile
    domain = .lltargettransfer..domain; refview = .lltargettransfer..refview
    ignored = .int; i = .int
    kind = action.kind(); family = 'components'; key = '*'; whole = action.domain() = 0
    if kind = 'callback' then do
      /* One ABI aggregate below also includes non-action scope-exit edges. */
      if abiaction(action) then return
      if callbackmay(instruction.opid(),action.ordinal()) then call abiunknown(result)
      return
    end
    if action.domain() > 0 then do
      domain = profile.domain(action.domain()); key = domain.key()
      whole = domain.kind() = 'whole'
      if domain.kind() = 'context' then family = 'numeric'
      else if domain.kind() = 'flag' then family = 'flags'
    end
    observedfamily = family
    select kind
      when 'read' then operation = 'read'
      when 'observe' then do; family = 'observations'; operation = 'read'; end
      when 'transport' then operation = 'write'
      when 'write' then operation = 'write'
      when 'clear' then operation = 'write'
      when 'derive' then operation = 'write'
      when 'capture' then operation = 'read'
      when 'callcapture' then do; family = 'calls'; operation = 'capture'; end
      when 'select' then do; family = 'values'; operation = 'selection'; end
      when 'status' then do; family = 'flags'; operation = 'write'; end
      when 'resize' then do; family = 'ownership'; operation = 'release'; end
      when 'scope-enter' then do; family = 'bindings'; operation = 'activation'; end
      when 'external' then do; family = 'effects'; operation = 'external'; key = action.detail(); end
      when 'flagwrite' then do; family = 'flags'; operation = 'write'; end
      when 'context' then do; family = 'numeric'; operation = 'write'; end
      when 'policy' then do; family = 'signals'; operation = 'policy'; key = action.detail(); end
      when 'raise' then do
        family = 'signals'; operation = 'raise'; name = action.literal()
        if action.sourcekind() = 'literal' & name.kind() = 'S' then key = name.text()
        else do; key = '*'; ignored = result.unknown('signals'); end
      end
      when 'edge' then do; family = 'control'; operation = action.detail(); end
      when 'link' then do; family = 'bindings'; operation = 'change'; end
      when 'unlink' then do; family = 'bindings'; operation = 'change'; end
      when 'swap' then do; family = 'bindings'; operation = 'change'; end
      when 'lifetime' then do; family = 'ownership'; operation = 'release'; end
      when 'call' then do; family = 'calls'; operation = 'call'; key = action.detail(); end
      when 'return' then do; family = 'return'; operation = 'return'; end
      when 'unknown' then do; ignored = result.unknown('*'); return; end
      otherwise do; ignored = result.unknown('effects'); return; end
    end
    definite = action.certainty() = 'must' & action.path() <> 'failure'
    if definite & action.path() = 'normal' then do
      flow = dereference _flow; cfg_ref = flow.cfg(); cfg = dereference cfg_ref
      do e = 1 to cfg.outedges(instruction.opid())
        edge = cfg.outedge(instruction.opid(),e)
        if edge.role() <> 'normal' & edge.role() <> 'table' & edge.phase() <> 'none' & edge.targetblock() > 0 then definite = 0
      end
    end
    ignored = result.add(family,operation,key,instruction.opid(),definite)
    if kind = 'observe' then ignored = result.add(observedfamily,'read',key,instruction.opid(),definite)
    if whole & wordpos(kind,'read observe transport write clear derive') > 0 then do
      ignored = result.add('flags',operation,'*',instruction.opid(),definite)
      if kind = 'transport' & action.sourcekind() = 'reference' then ignored = result.add('flags','read','*',instruction.opid(),0)
    end
    if action.certainty() = 'unknown' then ignored = result.unknown(family)
    call symboliceffect(result,instruction,action.subject(),operation,key,profile,action.ordinal())
    if action.sourcekind() = 'reference' & wordpos(kind,'transport derive write flagwrite capture status resize') > 0 then do
      ignored = result.add(family,'read',key,instruction.opid(),0)
      call symboliceffect(result,instruction,action.sourceid(),'read',key,profile,action.ordinal())
    end
    return
  run: method = .void
    if _status <> 'building' then return
    direct = .row; result = .row; child = .row
    action = .lltargettransfer..action; instruction = .lltargettransfer..instruction
    f = .int; i = .int; j = .int; n = .int; c = .int; ignored = .int
    target = .int; changed = .int; familyordinal = .int; controlmask = .int
    do
      if _worklimit < 1 | _bytelimit < 1 then do; ignored = fail('limit','target.summary.budgets'); return; end
      if <refvalid>(_flow) = 0 then do; ignored = fail('invalid','target.summary.owner.expired'); return; end
      flow = dereference _flow
      if flow.status() <> 'ok' then do; ignored = fail(flow.status(),flow.message()); return; end
      _flowid = flow.identity(); source_ref = flow.owner(); source = dereference source_ref
      catalog = .llrxascatalog..catalog()
      profile_ref = flow.transfers(); profile = dereference profile_ref
      cfg_ref = flow.cfg(); cfg = dereference cfg_ref; index_ref = cfg.index(); index = dereference index_ref
      if reserve(index.functions() * 64) = 0 then return
      do f = 2 to index.functions()
        _direct[f] = .row() as .object; _returnpossible[f] = 0; _returnunknown[f] = 0
        if cfg.normalcomplete(f) = 0 | cfg.exceptionalcomplete(f) = 0 | cfg.asynchronouscomplete(f) = 0 then _returnunknown[f] = 1
      end
      do i = 1 to source.records()
        if spend(1) = 0 then return
        record = source.record(i); f = record.procedureid()
        if f < 2 | record.kind() = 'procedure' then iterate
        instruction = profile.instruction(record.id()); direct = _direct[f] as .row
        do familyordinal = 1 to 12
          family = word('effects references components flags numeric signals order control values observations ownership calls',familyordinal)
          if instruction.complete(family) = 0 then ignored = direct.unknown(family)
        end
        if cfg.projectedop(record.id()) = 0 then do; ignored = direct.unknown('control'); _direct[f] = direct as .object; iterate; end
        if index.reachable(cfg.projectedblock(record.id())) = 0 then do; _direct[f] = direct as .object; iterate; end
        if record.kind() = 'instruction' then do
          if spend(direct.count() + 1) = 0 | reserve(96) = 0 then return
          if catalog.framecontrolstate(record.opcode()) <> 'known' then ignored = direct.unknown('framecontrol')
          else do
            controlmask = catalog.framecontrolmask(record.opcode())
            if controlmask <> 0 then ignored = direct.add('framecontrol','may',controlmask as .string,record.id(),1)
          end
        end
        do j = 1 to instruction.actions()
          if spend(direct.count() + instruction.references() + 1) = 0 | reserve(128) = 0 then return
          action = instruction.action(j); call eventrow(direct,instruction,action,profile)
          if _status <> 'building' then return
          if action.kind() = 'call' then do
            n = _callfunction[0] + 1; _callfunction[n] = f; _calloperation[n] = record.id(); _calltarget[n] = boundchild(instruction,action)
            if _calltarget[n] = 0 then do; ignored = direct.unknown('calls'); _returnunknown[f] = 1; end
          end
          if action.kind() = 'return' then do
            n = _retfunction[0] + 1; _retfunction[n] = f; _retoperation[n] = record.id(); _retaction[n] = action.id()
          end
        end
        if abimay(record.id()) then do
          if reserve(512) = 0 then return
          call abiunknown(direct)
        end
        if _status <> 'building' then return
        if direct.isunknown('control') | direct.isunknown('signals') then _returnunknown[f] = 1
        _direct[f] = direct as .object
      end
      do f = 2 to index.functions(); direct = _direct[f] as .row; _transitive[f] = direct.copy() as .object; end
      changed = 1
      do while changed
        changed = 0
        do c = 1 to _callfunction[0]
          if spend(1) = 0 then return
          target = _calltarget[c]; f = _callfunction[c]
          if target > 0 then do
            if _returnunknown[target] & _returnunknown[f] = 0 then do; _returnunknown[f] = 1; changed = 1; end
          end
        end
      end
      changed = 1
      do while changed & _status = 'building'
        changed = 0
        do f = 2 to index.functions()
          prior = _transitive[f] as .row; result = prior.copy()
          do c = 1 to _callfunction[0]
            if _callfunction[c] <> f then iterate
            target = _calltarget[c]
            if target = 0 then do; changed = changed | result.unknown('*'); iterate; end
            prior = _transitive[target] as .row; child = prior.copy()
            do n = 1 to child.count()
              if spend(result.count() + 1) = 0 | reserve(96) = 0 then return
              /* Callee argument symbols need a call-site binding before they
               * can be renamed to the caller's formals or global aliases. */
              if child.family(n) = 'arguments' then do; changed = changed | result.unknown('arguments'); iterate; end
              changed = changed | result.add(child.family(n),child.kind(n),child.domain(n),0,0)
            end
            do n = 1 to child.unknowns(); changed = changed | result.unknown(child.unknownat(n)); end
          end
          _transitive[f] = result as .object
        end
      end
      /* Least fixed point of finite normal-return paths. A recursive call
       * with no returning base case cannot justify its own continuation. */
      changed = 1
      do while changed & _status = 'building'
        changed = 0
        do f = 2 to index.functions()
          if _returnpossible[f] then iterate
          if spend(index.blocks() + cfg.edges() + _callfunction[0] + 1) = 0 then return
          if finitepath(f,cfg,index) then do; _returnpossible[f] = 1; changed = 1; end
        end
      end
      _status = 'ok'
      return
      on signal as problem
        if _status = 'building' then ignored = fail('invalid','target.summary.' || problem.name() || ': ' || problem.message())
    end
    return
  finitepath: method = .int
    arg functionid = .int, cfg = .lltargetcfg..graph, index = .llirgraph..index
    reachable = .int[]; pending = .int[]; head = 1; b = .int
    if index.blocks() > (_bytelimit - _bytes) / 16 then do; ignored = fail('limit','target.summary.path.bytes'); return 0; end
    do b = 1 to index.blocks(); reachable[b] = 0; end
    entry = index.functionentry(functionid); reachable[entry] = 1; pending[1] = entry
    do while head <= pending[0]
      if spend(1) = 0 then return 0
      b = pending[head]; head = head + 1
      do r = 1 to _retfunction[0]
        if spend(1) = 0 then return 0
        if _retfunction[r] = functionid & cfg.projectedblock(_retoperation[r]) = b then return 1
      end
      do e = 1 to cfg.edges()
        if spend(1) = 0 then return 0
        edge = cfg.edge(e)
        if edge.sourceblock() <> b | edge.targetblock() = 0 then iterate
        blocked = 0
        if edge.role() = 'normal' | edge.role() = 'table' | edge.phase() = 'none' then do c = 1 to _callfunction[0]
          if spend(1) = 0 then return 0
          if _calloperation[c] <> edge.sourceop() then iterate
          target = _calltarget[c]
          if target > 0 then blocked = _returnpossible[target] = 0 & _returnunknown[target] = 0
        end
        if blocked then iterate
        next = edge.targetblock()
        if reachable[next] = 0 then do; reachable[next] = 1; pending[pending[0] + 1] = next; end
      end
    end
    return 0
  status: method = .string
    call run()
    if _status = 'ok' & valid() = 0 then return 'invalid'
    return _status
  message: method = .string
    call run()
    if _status = 'ok' & valid() = 0 then return 'target.summary.owner.expired.or.replaced'
    return _message
  reason: method = .string
    return message()
  valid: method = .int
    if _status <> 'ok' | <refvalid>(_flow) = 0 then return 0
    flow = dereference _flow; return flow.valid() & flow.identity() = _flowid
  identity: method = .int
    return _identity
  flow: method = reference .lltargetflow..analysis
    return _flow
  usedwork: method = .int
    return _work + _sitework
  usedbytes: method = .int
    return _bytes + _sitebytes
  calllayout: method = .lltargetsummary..layoutfact
    arg sourceop = .int
    if sitebegin(sourceop) = 0 then return .layoutfact(.siteproof(reference self,'limit',_sitefailure))
    if sourceop <= _layoutpresent[0] then do; if _layoutpresent[sourceop] then return _layoutfacts[sourceop]; end
    flow = dereference _flow; owner = flow.owner(); source = dereference owner
    profile_ref = flow.transfers(); profile = dereference profile_ref; catalog = .llrxascatalog..catalog()
    item = source.at(sourceop); actuals = .lltargetflow..storagefact[]
    result = flow.storageat(sourceop,'',0); counter = flow.storageat(sourceop,'',0)
    state = 'proved'; reason = ''; countkind = 'unknown'; resultkind = 'absent'; count = -1
    bank = ''; first = -1; span = 0; phase = ''; countordinal = 0; resultordinal = 0
    recipe = .lltargetrecipe..view; value = .lltarget..operand; selected = .lltarget..operand; target = .lltargetflow..targetfact
    if item.kind() <> 'instruction' then return .layoutfact(.siteproof(reference self,'unknown','target.layout.not.activation'))
    scoped = catalog.scopecontinuation(item.opcode()) > 0 & catalog.recipeoperand(item.opcode()) > 0
    if scoped then do
      recipe = item.recipe(); count = flow.scopecount(sourceop); phase = 'before-initializer'
      countkind = 'fixed'; if recipe.countkind() <> 'literal' then countkind = 'captured'
      if countkind = 'captured' then do
        value = item.reciperef(recipe.countref()); counter = flow.captureat(sourceop,value.bank(),value.index())
      end
      resultkind = recipe.resultmode()
      if resultkind <> 'ignored' then resultkind = 'captured'
      if recipe.argumentkind() = 'window' then do
        value = item.reciperef(recipe.windowref()); bank = value.bank(); first = value.index(); span = max(0,count)
      end
    end
    else do
      if catalog.callinvokes(item.opcode()) = 0 then return .layoutfact(.siteproof(reference self,'unknown','target.site.not.call'))
      count = flow.captureargumentcount(sourceop); countordinal = catalog.callcount(item.opcode())
      countkind = 'fixed'; phase = 'before-initializer'
      if countordinal > 0 then do
        countkind = 'captured'; phase = 'after-initializer'
        value = item.operand(countordinal); counter = flow.captureat(sourceop,value.bank(),value.index())
        if counter.active() = 0 then counter = flow.storageat(sourceop,value.bank(),value.index())
        value = item.operand(catalog.callwindow(item.opcode())); bank = value.bank(); first = value.index(); span = max(0,count + 1)
        target = flow.targetat(sourceop)
        if target.status() <> 'proved' then do; state = 'unknown'; if reason = '' then reason = 'target.layout.ingress.unproved'; end
        else do
          provider_ref = target.provider()
          if (provider_ref <refsame> owner) = 0 then do; state = 'unknown'; if reason = '' then reason = 'target.layout.initializer.capture.unproved'; end
        end
      end
      if catalog.callresult(item.opcode()) > 0 then resultkind = 'captured'
    end
    if count < 0 then do; state = 'unknown'; if reason = '' then reason = 'target.layout.count.unproved'; countkind = 'unknown'; end
    if resultkind = 'captured' then do
      resultordinal = catalog.callresult(item.opcode())
      value = item.operand(resultordinal); result = flow.captureat(sourceop,value.bank(),value.index())
      if result.active() = 0 & scoped = 0 then result = flow.storageat(sourceop,value.bank(),value.index())
      if result.active() = 0 then do; state = 'unknown'; if reason = '' then reason = 'target.layout.result.binding.unproved'; end
    end
    if countkind = 'captured' then do
      if counter.active() = 0 then do; state = 'unknown'; if reason = '' then reason = 'target.layout.count.binding.unproved'; end
    end
    if sitespend(max(0,count) + max(0,sourceop - _layoutpresent[0]) + 1) = 0 | sitereserve(max(0,count) * 64 + max(0,sourceop - _layoutpresent[0]) * 24 + 192) = 0 then return .layoutfact(.siteproof(reference self,'limit',_sitefailure))
    do i = 1 to count
      if scoped then do
        if recipe.argumentkind() = 'list' then value = item.reciperef(recipe.argumentref(i))
        else value = flow.windowvalue(item.procedureid(),item.reciperef(recipe.windowref()),i - 1)
        actuals[i] = flow.captureat(sourceop,value.bank(),value.index())
      end
      else actuals[i] = flow.captureargument(sourceop,i)
      selectedbinding = actuals[i]
      if selectedbinding.active() = 0 then do; state = 'unknown'; if reason = '' then reason = 'target.layout.actual.binding.unproved'; end
    end
    proof = .siteproof(reference self,state,reason)
    layout = .layoutfact(proof,countkind,count,resultkind,result,counter,actuals,bank,first,span,phase)
    _layoutfacts[sourceop] = layout; _layoutpresent[sourceop] = 1
    return layout
  discardability: method = .lltargetsummary..discardfact
    arg sourceop = .int
    i = .int; j = .int; d = .int; ordinal = .int; p = .int; overlap = .int; nativebit = .int; writesmask = .int; clearedmask = .int
    value = .lltargetflow..valuefact
    outputs = .int[]
    if sitebegin(sourceop) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
    if sourceop <= _discardpresent[0] then do; if _discardpresent[sourceop] then return _discardfacts[sourceop]; end
    flow = dereference _flow; owner = flow.owner(); source = dereference owner; item = source.at(sourceop)
    profile_ref = flow.transfers(); profile = dereference profile_ref; cfg_ref = flow.cfg(); cfg = dereference cfg_ref
    catalog = .llrxascatalog..catalog(); instruction = profile.instruction(sourceop)
    state = 'proved'; reason = ''; safe = 1; residual = 0; ownershiprequired = 0; ownershipproved = 1
    if item.kind() <> 'instruction' then do; state = 'unknown'; reason = 'target.discard.not.instruction'; safe = 0; end
    else do
      do i = 1 to 7
        family = word('effects references components observations ownership bindings order',i)
        if instruction.complete(family) = 0 then do; state = 'unknown'; reason = instruction.unknownreason(family); safe = 0; end
      end
      if catalog.flow(item.opcode()) <> 0 | catalog.callinvokes(item.opcode()) | catalog.selectionkind(item.opcode()) <> 0 then do; state = 'unknown'; reason = 'target.discard.control.or.selection'; safe = 0; end
      if catalog.signalstate(item.opcode()) <> 0 then do; state = 'unknown'; reason = 'target.discard.signal.unproved'; safe = 0; end
      residual = catalog.residualobservable(item.opcode())
      if catalog.opaqueeffects(item.opcode()) then do; state = 'unknown'; reason = 'target.discard.external.observable'; safe = 0; end
    end
    do i = 1 to instruction.actions()
      if sitespend(instruction.references() + 1) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
      action = instruction.action(i); kind = action.kind()
      if kind = 'callback' then do
        /* Native ABI rows are aggregated once using their intrinsic slice. */
        if abiaction(action) then iterate
        if callbackmay(sourceop,action.ordinal(),1) = 0 then iterate
        if _sitefailure <> '' then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
        state = 'unknown'; reason = 'target.discard.callback.unproved'; safe = 0; iterate
      end
      if wordpos(kind,'read observe write clear transport derive flagwrite capture status') = 0 then do; state = 'unknown'; reason = 'target.discard.residual.' || kind; safe = 0; end
      if action.subject() > 0 & wordpos(kind,'write clear transport derive') > 0 then do
        do d = 1 to profile.domains()
          if sitespend(1) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
          domain = profile.domain(d)
          if domain.kind() <> 'component' then iterate
          if domain.nativebit() <> catalog.componentmask('reference') & domain.nativebit() <> catalog.componentmask('native-payload') & domain.nativebit() <> catalog.componentmask('attribute-count') then iterate
          if action.domain() <> 0 & action.domain() <> d then iterate
          ref = profile.ref(action.subject()); nativebit = domain.nativebit()
          if ref.kind() = 'explicit' & ref.operandordinal() > 0 & catalog.bindingrecipe(item.opcode()) = '' then do
            /* A may-write envelope includes unrelated components. Only the
             * canonical precise write/clear resource masks impose old-payload
             * obligations; public attribute status is not a child tree. */
            writesmask = catalog.writecomponents(item.opcode(),ref.operandordinal())
            clearedmask = catalog.clearcomponents(item.opcode(),ref.operandordinal())
            assembler ior writesmask,writesmask,clearedmask
            assembler iand overlap,writesmask,nativebit
            if overlap = 0 then iterate
            ownershiprequired = ownershiprequired + 1
            if sitespend(flow.lookupcost() * 2) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
            value = flow.componentat(sourceop,ref.bank(),ref.index(),d)
            destination = flow.storageat(sourceop,ref.bank(),ref.index())
            do p = 1 to item.operands()
              if sitespend(1) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
              if p = ref.operandordinal() | catalog.writes(item.opcode(),p) = 0 then iterate
              other = item.operand(p)
              if other.kind() <> 'R' then iterate
              if sitespend(flow.lookupcost()) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
              otherbinding = flow.storageat(sourceop,other.bank(),other.index())
              if otherbinding.active() = 0 | otherbinding.active() = destination.active() then ownershipproved = 0
            end
          end
          else do
            ownershiprequired = ownershiprequired + 1
            value = flow.actioncomponent(sourceop,i,action.subject(),d)
          end
          if value.presence() <> 'absent' then ownershipproved = 0
        end
      end
    end
    if abiintrinsicmay(sourceop,1) then do; state = 'unknown'; reason = 'target.discard.abi.unproved'; safe = 0; end
    if _sitefailure <> '' then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
    if ownershipproved = 0 then do; state = 'unknown'; reason = 'target.discard.ownership.unproved'; safe = 0; end
    if residual & ownershiprequired = 0 & safe then do; state = 'unknown'; reason = 'target.discard.residual.unproved'; safe = 0; end
    access_ref = flow.projection(); access = dereference access_ref; projected = cfg.projectedop(sourceop)
    if access.status() <> 'ok' then return .discardfact(.siteproof(reference self,'limit',access.message()),0,outputs)
    if projected = 0 then do; state = 'unknown'; reason = 'target.discard.access.unavailable'; safe = 0; end
    else if access.known(projected) = 0 then do; state = 'unknown'; reason = 'target.discard.access.unproved'; safe = 0; end
    else do
      do i = 1 to access.accesses(projected)
        if access.accesskind(projected,i) = 4 then do; if addoutput(outputs,access.accessdomain(projected,i)) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs); end
      end
      do i = 1 to cfg.outedges(sourceop)
        edge = cfg.outedge(sourceop,i); ordinal = edge.successorordinal()
        if ordinal = 0 then iterate
        do j = 1 to access.edgeaccesses(projected,ordinal)
          if access.edgeaccesskind(projected,ordinal,j) = 4 then do; if addoutput(outputs,access.edgeaccessdomain(projected,ordinal,j)) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs); end
        end
      end
    end
    if sitespend(max(0,sourceop - _discardpresent[0]) + 1) = 0 | sitereserve(max(0,sourceop - _discardpresent[0]) * 24 + 128) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
    result = .discardfact(.siteproof(reference self,state,reason),safe,outputs)
    _discardfacts[sourceop] = result; _discardpresent[sourceop] = 1
    return result
  footprint: method = .lltargetsummary..footprintfact
    arg sourceop = .int
    roles = .rolefact[]; constraints = .constraintfact[]; members = .int[]
    result = .footprintfact; abiproofs = .lltargetflow..abicallbackfact[]
    i = .int; j = .int; k = .int; fixed = .int; found = .int; step = .int; number = .int
    if sitebegin(sourceop) = 0 then return .footprintfact(.siteproof(reference self,'limit',_sitefailure),roles,constraints)
    if sourceop <= _footprintpresent[0] then do; if _footprintpresent[sourceop] then return _footprintfacts[sourceop]; end
    flow = dereference _flow; owner = flow.owner(); source = dereference owner; item = source.at(sourceop)
    profile_ref = flow.transfers(); profile = dereference profile_ref; instruction = profile.instruction(sourceop)
    cfg_ref = flow.cfg(); cfg = dereference cfg_ref
    catalog = .llrxascatalog..catalog(); state = 'proved'; reason = ''; identity = 0
    binding = .lltargetflow..storagefact; view = .lltargettransfer..refview; action = .lltargettransfer..action
    value = .lltarget..operand; field = .lltarget..operand; recipe = .lltargetrecipe..view; layout = .layoutfact
    scoped = 0
    if item.kind() = 'instruction' then scoped = catalog.scopecontinuation(item.opcode()) > 0 & catalog.recipeoperand(item.opcode()) > 0
    proof = .siteproof(reference self,'proved')
    do i = 1 to 3
      family = word('references bindings order',i)
      if instruction.complete(family) = 0 then do; state = 'unknown'; reason = instruction.unknownreason(family); end
    end
    if scoped then recipe = item.recipe()
    if sitespend(item.registerrefs() * (instruction.references() + instruction.actions() + 1) + max(0,sourceop - _footprintpresent[0]) + 1) = 0 | sitereserve(item.registerrefs() * 192 + max(0,sourceop - _footprintpresent[0]) * 24 + 128) = 0 then return .footprintfact(.siteproof(reference self,'limit',_sitefailure),roles,constraints)
    do i = 1 to instruction.actions()
      if sitespend(1) = 0 then return .footprintfact(.siteproof(reference self,'limit',_sitefailure),roles,constraints)
      action = instruction.action(i)
      if action.kind() <> 'callback' then iterate
      if abiaction(action) then iterate
      possible = callbackmay(sourceop,i,1)
      if _sitefailure <> '' then return .footprintfact(.siteproof(reference self,'limit',_sitefailure),roles,constraints)
      if possible then do
        result = .footprintfact(.siteproof(reference self,'unknown','target.footprint.callback.unproved'),roles,constraints)
        _footprintfacts[sourceop] = result; _footprintpresent[sourceop] = 1
        return result
      end
    end
    abireason = abifootprint(sourceop,roles,constraints,abiproofs,proof)
    if abireason <> '' then do
      if _sitefailure <> '' then return .footprintfact(.siteproof(reference self,'limit',_sitefailure),roles,constraints)
      result = .footprintfact(.siteproof(reference self,'unknown',abireason),roles,constraints)
      _footprintfacts[sourceop] = result; _footprintpresent[sourceop] = 1
      return result
    end
    do i = 1 to item.registerrefs()
      value = item.registerref(i); kind = item.registerrole(i); if kind = '' then kind = 'explicit'
      anchor = 'active'; fixed = 0; binding = flow.storageat(sourceop,value.bank(),value.index())
      if wordpos(kind,'a0-destination proxy-destination owned-destination') > 0 then do; anchor = 'slot'; fixed = 1; end
      else if scoped & wordpos(kind,'explicit result-capture count-capture actual-capture window-capture') > 0 then binding = flow.captureat(sourceop,value.bank(),value.index())
      else if scoped & wordpos(kind,'prep-clear prep-status prep-swap') > 0 then do
        step = item.registerroleordinal(i); binding = flow.preparationat(sourceop,step,value.bank(),value.index()); fixed = 1
      end
      else if cfg.logicalreturn(sourceop) = 0 then do
        found = 0
        do j = 1 to instruction.references()
          view = instruction.ref(j)
          if view.bank() <> value.bank() | view.index() <> value.index() then iterate
          do k = 1 to instruction.actions()
            action = instruction.action(k)
            if wordpos(action.kind(),'link unlink swap') > 0 then fixed = 1
            if found then iterate
            used = action.subject() = view.id()
