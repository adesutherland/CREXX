      end
    end
    if _expected <> entrycount then return fail('unknown','target.expansion.entry.extra.or.missing.event')
    return 1
  exitrelation: method = .int
    arg plan = .expansionplanfact, instance = .lltargetremap..expansioninstance
    i = .int; j = .int; value = .lltarget..operand
    owner = dereference _owner; flowref = owner.flow(); points = dereference flowref; sourceref = points.owner(); source = dereference sourceref
    mapping = dereference _mapping; candidate_ref = mapping.candidateowner(); candidate = dereference candidate_ref
    called = source.at(plan.operation()); catalog = .llrxascatalog..catalog(); restoration = plan.restoration(); body = source.body(instance.procedure()); caller = source.body(called.procedureid())
    cleanprivate = 1
