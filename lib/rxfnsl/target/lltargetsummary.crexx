      if instance.source(i) > 0 then do; bodyentry = instance.candidate(i); leave; end
    end
    do i = 1 to instance.mappings()
      if spend(1) = 0 then return 0
      if instance.mappingrole(i) <> 'argument' then iterate
      original = instance.original(i); value = instance.replacement(i); captured = actual(plan,original.index())
      if captured.kind() <> 'R' | bodyentry = 0 then return fail('unknown','target.expansion.argument.capture.correspondence.unproved')
      expectedbinding = _flow.storageat(bodyentry,captured.bank(),captured.index())
      actualbinding = _flow.storageat(bodyentry,value.bank(),value.index())
      if actualbinding.active() = 0 | actualbinding.active() <> expectedbinding.active() then return fail('unknown','target.expansion.argument.capture.correspondence.unproved')
    end
    cursor = instance.candidate(1); entrycount = 0
    if instance.source(1) = 0 then entrycount = instance.count(1)
    _expected = 0; program = before.bindingprogram(called.id(),'preparation',_worklimit - _work,_bytelimit - _bytes)
    if incurred(program.usedwork(),program.usedbytes()) = 0 then return 0
    if program.status() <> 'ok' then return fail(program.status(),program.reason())
    /* The checked primitive program below preserves the fused preparation
     * order. Its former atomic-phase veto required exact asynchronous CALL
     * checkpoints, which are outside the direct-inline signal contract. */
    do i = 1 to program.steps()
      kind = program.kind(i); left = mapping.callerregister(called.operand(program.operand(i,1)),called.procedureid())
      if kind = 'clear' then cursor = expect(candidate,cursor,'null',left)
      else do
        right = mapping.callerregister(called.operand(program.operand(i,2)),called.procedureid()); name = ''
        if kind = 'flags' then name = 'settp'
        if kind = 'swap' then name = 'swap'
        if name = '' then return fail('unknown','target.expansion.preparation.primitive.unproved')
        cursor = expect(candidate,cursor,name,left,right)
      end
      if _status <> 'building' then return 0
    end
    restoration = plan.restoration(); saveordinal = 0
    do i = 1 to restoration.fields()
      if restoration.mode(i) <> 'saved' then iterate
      saveordinal = saveordinal + 1; value = .lltarget..operand(); seen = 0
      do j = 1 to instance.additions()
        if spend(1) = 0 then return 0
        if instance.additionrole(j) <> 'save' then iterate
        seen = seen + 1
        if seen = saveordinal then do; value = instance.addition(j); leave; end
      end
      if value.kind() <> 'R' then return fail('unknown','target.expansion.context.save.mapping.unproved')
      _saved[restoration.saveordinal(i)] = value
      cursor = expect(candidate,cursor,restoration.getter(i),value)
      if _status <> 'building' then return 0
    end
    body = source.body(instance.procedure())
    do i = 0 to body.locals() - 1
      original = .lltarget..operand.bound(source.identity(),instance.procedure(),0,'r',i); value = instance.mapped(original)
      if value.kind() <> 'R' then return fail('unknown','target.expansion.private.entry.mapping.unproved')
      cursor = expect(candidate,cursor,'unlink',value)
      if _status <> 'building' then return 0
    end
    original = .lltarget..operand.bound(source.identity(),instance.procedure(),0,'a',0); value = instance.mapped(original)
    if value.kind() = 'R' then do
      layout = plan.layout()
      cursor = expect(candidate,cursor,'unlink',value)
      cursor = expect(candidate,cursor,'null',value)
      cursor = expect(candidate,cursor,'load',value,.lltarget..operand.integer(layout.count()))
      if _status <> 'building' then return 0
    end
    do pass = 1 to 2
      do i = 1 to instance.mappings()
        if spend(1) = 0 then return 0
        original = instance.original(i); value = instance.replacement(i)
        if original.bank() <> 'g' & (original.bank() <> 'a' | original.index() = 0) then iterate
        if value.bank() <> 'r' | instance.mappingrole(i) = 'argument' then iterate
        captured = .lltarget..operand()
        if original.bank() = 'a' then captured = actual(plan,original.index())
        else do
          binding = points.storageat(called.id(),'g',original.index())
          if binding.active() <> binding.entry() | binding.base() <> binding.entry() | binding.slotidentity() = 0 then return fail('unknown','target.expansion.global.original.binding.unproved')
          captured = .lltarget..operand.bound(source.identity(),called.procedureid(),0,'g',original.index())
        end
        if captured.kind() <> 'R' then return fail('unknown','target.expansion.argument.capture.correspondence.unproved')
        if pass = 2 then do; value = instance.base(original); if value.kind() <> 'R' then return fail('unknown','target.expansion.argument.base.correspondence.unproved'); end
        cursor = expect(candidate,cursor,'link',value,captured)
