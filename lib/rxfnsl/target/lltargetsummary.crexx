    if current.active() = 0 & catalog.callprefix(called.opcode()) = '' then current = points.storageat(called.id(),value.bank(),value.index())
    if captured.active() = 0 | captured.active() <> current.active() | captured.base() <> current.base() | captured.entry() <> current.entry() | captured.slotidentity() <> current.slotidentity() then return .lltarget..operand()
    mapping = dereference _mapping
    return mapping.callerregister(value,called.procedureid())
  entryrelation: method = .int
    arg plan = .expansionplanfact, instance = .lltargetremap..expansioninstance
    i = .int; j = .int; value = .lltarget..operand; original = .lltarget..operand; captured = .lltarget..operand
    owner = dereference _owner; flowref = owner.flow(); points = dereference flowref; sourceref = points.owner(); source = dereference sourceref
    mapping = dereference _mapping; candidate_ref = mapping.candidateowner(); candidate = dereference candidate_ref
    called = source.at(plan.operation()); catalog = .llrxascatalog..catalog(); profile_ref = points.transfers(); before = dereference profile_ref
    /* A structural argument-role manifest is still untrusted capture data.
