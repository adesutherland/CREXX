            binding = flow.actionstorage(sourceop,k,view.id()); found = 1; leave
          end
          if found = 0 | binding.active() = 0 then do; state = 'unknown'; reason = 'target.footprint.address.unproved'; iterate; end
          bank = flow.storagebank(binding.active()); number = flow.storageindex(binding.active()); empty = .int[]
