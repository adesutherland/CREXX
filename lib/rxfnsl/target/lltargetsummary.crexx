/* cREXX License (MIT). Inferred procedure facts over shared target evidence. */
options levelb
namespace lltargetsummary expose analysis analyse summary effectfact returnfact discardfact footprintfact rolefact constraintfact layoutfact restorationfact preservationfact
import rxfnsb
import llirgraph
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetflow
import lltargetbodyview
import lltargetremap
import llrxascatalog

boot: initialiser expose serial
  serial = 0
  return
nextidentity: procedure = .int expose serial
  if serial = 9223372036854775807 then assembler signal "ERROR","LL_TARGET_SUMMARY: identities exhausted"
  serial = serial + 1
  return serial

/** The enforced decimal ABI makes value-only synchronization nonobserving.
 * Other callback bits remain obligations of the existing storage/ABI owners. */
observablecallbacks: procedure = .int
  arg opcode = .int
  overlap = .int
  catalog = .llrxascatalog..catalog(); mask = catalog.callbackobligations(opcode)
  if catalog.contextsynccontract() = 'value-only-nonreentrant.v1' then do
    bit = catalog.callbackmask('plugin-sync'); assembler iand overlap,mask,bit; mask = mask - overlap
  end
  return mask

/** Sparse conservative effect set. Missing families remain explicit unknowns;
 * an unknown signal set does not erase an independently complete numeric set. */
row: class
  _family = .string[]
  _kind = .string[]
  _domain = .string[]
  _operation = .int[]
  _definite = .int[]
  _hash = .int[]
  _next = .int[]
  _keybytes = .int[]
  _heads = .int[]
  _unknown = .string[]
  _bytes = .int
  _textwork = .int
  *: factory
    _bytes = 64
    return
  count: method = .int
    return _family[0]
  family: method = .string
    arg ordinal = .int
    return _family[ordinal]
  kind: method = .string
    arg ordinal = .int
    return _kind[ordinal]
  domain: method = .string
    arg ordinal = .int
    return _domain[ordinal]
  operation: method = .int
    arg ordinal = .int
    return _operation[ordinal]
  definite: method = .int
    arg ordinal = .int
    return _definite[ordinal]
  /** Hashes select candidates only. Every collision checks the exact tuple;
   * byte loops and probes are prepaid against the constructing owner. */
  add: method = .int
    arg family = .string, kind = .string, domain = .string, operation = .int, definite = .int, budget = reference .analysis
    bucket = .int
    owner = dereference budget
    if operation < 0 | (definite <> 0 & definite <> 1) then return owner.fail('invalid','target.summary.row.tuple')
    /* Bound each addition before scaling the UTF-8 upper bound or temporary
     * allocation debit. Even a maximum signed work allowance cannot wrap. */
    textlength = length(family); textlimit = (9223372036854775807 - 4) <idiv> 8
    if textlength > textlimit then return owner.fail('limit','target.summary.bytes')
    if length(kind) > textlimit - textlength then return owner.fail('limit','target.summary.bytes')
    textlength = textlength + length(kind)
    if length(domain) > textlimit - textlength then return owner.fail('limit','target.summary.bytes')
    keybytes = (textlength + length(domain)) * 4 + 2
    if owner.spend(keybytes + 16) = 0 | owner.spend(keybytes) = 0 | owner.reserve(keybytes * 2) = 0 then return 0
    /* Hash each field's UTF-8 directly, avoiding a growing concatenation.
     * The reduced accumulator times 131 plus one byte fits signed 64 bits. */
    hash = ((operation % 2147483647) * 131 + definite) % 2147483647
    key = .binary
    do part = 1 to 3
      select part
        when 1 then key = family as .binary
        when 2 then key = kind as .binary
        otherwise key = domain as .binary
      end
      do offset = 0 to <blen>(key) - 1
        value = <at..u8>(offset) key; hash = (hash * 131 + value) % 2147483647
      end
      if part < 3 then hash = (hash * 131 + 124) % 2147483647
    end
    capacity = _heads[0]; i = 0
    if capacity > 0 then i = _heads[hash % capacity + 1]
    do while i > 0
      if owner.spend(1) = 0 then return 0
      if _hash[i] = hash then do
        if owner.spend(keybytes) = 0 | owner.spend(_keybytes[i] + 5) = 0 then return 0
        if _family[i] == family & _kind[i] == kind & _domain[i] == domain & _operation[i] = operation & _definite[i] = definite then return 0
      end
      i = _next[i]
    end
    if owner.spend(8) = 0 | owner.reserve(128 + keybytes) = 0 then return 0
    if _family[0] >= capacity then do
      capacity = max(31,capacity * 2 + 1)
      if capacity > 9223372036854775807 <idiv> 8 then return owner.fail('limit','target.summary.bytes')
      if owner.spend(capacity + _family[0] * 2 + 1) = 0 | owner.reserve(capacity * 8) = 0 then return 0
      heads = .int[]; heads[capacity] = 0
      do i = 1 to _family[0]
        bucket = _hash[i] % capacity + 1; _next[i] = heads[bucket]; heads[bucket] = i
      end
      _bytes = _bytes + (capacity - _heads[0]) * 8; _heads = heads
    end
    i = _family[0] + 1; _family[i] = family; _kind[i] = kind; _domain[i] = domain; _operation[i] = operation; _definite[i] = definite
    bucket = hash % capacity + 1; _hash[i] = hash; _keybytes[i] = keybytes; _next[i] = _heads[bucket]; _heads[bucket] = i
    _bytes = _bytes + 128 + keybytes; _textwork = _textwork + keybytes
    return 1
  unknown: method = .int
    arg family = .string, budget = reference .analysis
    owner = dereference budget
    if length(family) > (9223372036854775807 - 16) <idiv> 4 then return owner.fail('limit','target.summary.bytes')
    textbytes = length(family) * 4
    if owner.spend(_unknown[0] + 1) = 0 then return 0
    i = .int
    do i = 1 to _unknown[0]
      if owner.spend(textbytes + 1) = 0 then return 0
      if _unknown[i] == family then return 0
    end
    if owner.reserve(16 + textbytes) = 0 then return 0
    _unknown[_unknown[0] + 1] = family
    _bytes = _bytes + 16 + textbytes; _textwork = _textwork + textbytes
    return 1
  isunknown: method = .int
    arg family = .string
    do i = 1 to _unknown[0]; if _unknown[i] == family | _unknown[i] == '*' then return 1; end
    return 0
  unknowns: method = .int
    return _unknown[0]
  unknownat: method = .string
    arg ordinal = .int
    return _unknown[ordinal]
  has: method = .int
    arg family = .string, kind = .string, domain = '*'
    do i = 1 to _family[0]
      if _family[i] == family & _kind[i] == kind & (domain == '*' | _domain[i] == domain | _domain[i] == '*') then return 1
    end
    return 0
  bytes: method = .int
    return _bytes
  /** The explicit deep snapshot preserves insertion order and the exact
   * index. Mutating a fixed-point copy cannot change direct/prior rows. */
  copy: method = .lltargetsummary..row
    arg budget = reference .analysis
    owner = dereference budget
    if owner.spend(_family[0] * 8 + _heads[0] + _unknown[0] + 1) = 0 | owner.spend(_textwork) = 0 | owner.reserve(_bytes) = 0 then return .row()
    self_ref = reference self; result = snapshot self_ref
    return result

effectfact: class
  _owner = reference .lltargetsummary..analysis
  _identity = .int
  _may = .int
  _must = .int
  _unknown = .int
  _reason = .string
  _limited = .int
  *: factory
    arg owner = reference .analysis, may = .int, must = .int, unknown = .int, reason = '', limited = 0
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _may = may; _must = must; _unknown = unknown
    _reason = reason; _limited = limited
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner; return owner.valid() & owner.identity() = _identity
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _limited then return 'limit'
    if _unknown then return 'unknown'
    return 'proved'
  reason: method = .string
    if valid() = 0 then return 'target.summary.owner.expired.or.replaced'
    if _reason <> '' then return _reason
    if _unknown then return 'target.summary.effect.incomplete'
    return ''
  may: method = .int
    if valid() = 0 then return 1
    return _may | _unknown
  must: method = .int
    return valid() & _must
  unknown: method = .int
    return valid() = 0 | _unknown

returnfact: class
  _owner = reference .lltargetsummary..analysis
  _identity = .int
  _known = .int
  _literal = .lltarget..operand
  _reason = .string
  _limited = .int
  *: factory
    arg owner = reference .analysis, known = .int, literal = .lltarget..operand, reason = .string, limited = 0
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _known = known; _literal = literal; _reason = reason; _limited = limited
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner; return owner.valid() & owner.identity() = _identity
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _limited then return 'limit'
    if _known then return 'proved'
    return 'unknown'
  reason: method = .string
    if valid() = 0 then return 'target.summary.owner.expired.or.replaced'
    return _reason
  known: method = .int
    return valid() & _known
  literal: method = .lltarget..operand
    if known() then return _literal
    return .lltarget..operand()

/** Shared immutable site-facet stamp. Enumeration is unavailable when the
 * facet is incomplete, rather than presenting an unknown set as empty. */
siteproof: class
  _owner = reference .lltargetsummary..analysis
  _identity = .int
  _status = .string
  _reason = .string
  _bodyview = .lltargetbodyview..view
  _hasbodyview = .int
  *: factory
    arg owner = reference .analysis, status = .string, reason = '', ?bodyview = .lltargetbodyview..view
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _status = status; _reason = reason
    _hasbodyview = ?bodyview
    if ?bodyview then _bodyview = bodyview
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    parent = dereference _owner
    if parent.valid() = 0 | parent.identity() <> _identity then return 0
    if _hasbodyview then return _bodyview.valid()
    return 1
  status: method = .string
    if <refvalid>(_owner) = 0 then return 'invalid'
    parent = dereference _owner
    if parent.identity() <> _identity then return 'invalid'
    if parent.status() = 'limit' then return 'limit'
    if valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    if status() = 'invalid' & valid() = 0 then return 'target.summary.owner.expired.or.replaced'
    if status() = 'limit' & _reason = '' then do; parent = dereference _owner; return parent.message(); end
    return _reason
  require: method = .void
    if status() <> 'proved' then assembler signal "ERROR","LL_TARGET_SITE: unavailable proof enumeration"
    return

discardfact: class
  _proof = .siteproof
  _safe = .int
  _outputs = .int[]
  *: factory
    arg proof = .siteproof, safe = .int, outputs = .int[]
    _proof = proof; _safe = safe; _outputs = outputs
    return
  valid: method = .int
    return _proof.valid()
  status: method = .string
    return _proof.status()
  reason: method = .string
    return _proof.reason()
  safeifdead: method = .int
    return valid() & status() = 'proved' & _safe
  outputs: method = .int
    call _proof.require(); return _outputs[0]
  outputdomain: method = .int
    arg ordinal = .int
    call _proof.require()
    if ordinal < 1 | ordinal > _outputs[0] then assembler signal "ERROR","LL_TARGET_SITE: output domain ordinal"
    return _outputs[ordinal]

rolefact: class
  _proof = .siteproof
  _ordinal = .int
  _kind = .string
  _bank = .string
  _index = .int
  _anchor = .string
  _binding = .lltargetflow..storagefact
  _resource = .lltargetflow..abiresource
  _hasresource = .int
  _fixed = .int
  *: factory
    arg proof = .siteproof, ordinal = .int, kind = .string, bank = .string, index = .int, anchor = .string, binding = .lltargetflow..storagefact, fixed = 0
    _proof = proof; _ordinal = ordinal; _kind = kind; _bank = bank; _index = index; _anchor = anchor; _binding = binding; _fixed = fixed
    return
  checkpoint: factory
    arg proof = .siteproof, kind = .string, bank = .string, index = .int, anchor = .string, resource = .lltargetflow..abiresource
    _proof = proof; _kind = kind; _bank = bank; _index = index; _anchor = anchor
    _resource = resource; _hasresource = 1; _fixed = 1
    points_ref = reference .lltargetflow..analysis; points_ref = resource.points()
    points = dereference points_ref
    _binding = points.unprovedstorage('target.footprint.abi.resource.checkpoint')
    return
  valid: method = .int
    if _proof.valid() = 0 | _binding.valid() = 0 then return 0
    if _hasresource then return _resource.valid()
    return 1
  status: method = .string
    if _proof.status() = 'limit' then return 'limit'
    if valid() = 0 then return 'invalid'
    return _proof.status()
  reason: method = .string
    if _proof.status() = 'limit' then return _proof.reason()
    if valid() = 0 then return 'target.footprint.resource.expired.or.replaced'
    return _proof.reason()
  require: method = .void
    if status() <> 'proved' then assembler signal "ERROR","LL_TARGET_SITE: unavailable footprint role"
    return
  ordinal: method = .int
    call require(); return _ordinal
  kind: method = .string
    call require(); return _kind
  bank: method = .string
    call require(); return _bank
  index: method = .int
    call require(); return _index
  anchor: method = .string
    call require(); return _anchor
  binding: method = .lltargetflow..storagefact
    call require(); return _binding
  fixed: method = .int
    call require(); return _fixed

  hasresource: method = .int
    return valid() & _hasresource
  resource: method = .lltargetflow..abiresource
    call require()
    if _hasresource = 0 then assembler signal "ERROR","LL_TARGET_SITE: role has no ABI resource checkpoint"
    return _resource

constraintfact: class
  _proof = .siteproof
  _kind = .string
  _bank = .string
  _first = .int
  _width = .int
  _members = .int[]
  *: factory
    arg proof = .siteproof, kind = .string, bank = .string, first = .int, width = .int, members = .int[]
    _proof = proof; _kind = kind; _bank = bank; _first = first; _width = width; _members = members
    return
  valid: method = .int
    return _proof.valid()
  kind: method = .string
    call _proof.require(); return _kind
  bank: method = .string
    call _proof.require(); return _bank
  first: method = .int
    call _proof.require(); return _first
  width: method = .int
    call _proof.require(); return _width
  roles: method = .int
    call _proof.require(); return _members[0]
  role: method = .int
    arg ordinal = .int
    call _proof.require()
    if ordinal < 1 | ordinal > _members[0] then assembler signal "ERROR","LL_TARGET_SITE: constraint member ordinal"
    return _members[ordinal]

footprintfact: class
  _proof = .siteproof
  _roles = .rolefact[]
  _constraints = .constraintfact[]
  _abi = .lltargetflow..abicallbackfact[]
  *: factory
    arg proof = .siteproof, roles = .rolefact[], constraints = .constraintfact[]
    _proof = proof; _roles = roles; _constraints = constraints
    return
  checkpointed: factory
    arg proof = .siteproof, roles = .rolefact[], constraints = .constraintfact[], abi = .lltargetflow..abicallbackfact[]
    _proof = proof; _roles = roles; _constraints = constraints; _abi = abi
    return
  valid: method = .int
    if _proof.valid() = 0 then return 0
    do i = 1 to _abi[0]; if _abi[i].valid() = 0 then return 0; end
    return 1
  status: method = .string
    if _proof.status() = 'limit' then return 'limit'
    if valid() = 0 then return 'invalid'
    return _proof.status()
  reason: method = .string
    if _proof.status() = 'limit' then return _proof.reason()
    if valid() = 0 then return 'target.footprint.abi.owner.expired.or.replaced'
    return _proof.reason()
  require: method = .void
    if status() <> 'proved' then assembler signal "ERROR","LL_TARGET_SITE: unavailable footprint enumeration"
    return
  roles: method = .int
    call require(); return _roles[0]
  role: method = .rolefact
    arg ordinal = .int
    call require()
    if ordinal < 1 | ordinal > _roles[0] then assembler signal "ERROR","LL_TARGET_SITE: footprint role ordinal"
    return _roles[ordinal]
  constraints: method = .int
    call require(); return _constraints[0]
  constraint: method = .constraintfact
    arg ordinal = .int
    call require()
    if ordinal < 1 | ordinal > _constraints[0] then assembler signal "ERROR","LL_TARGET_SITE: footprint constraint ordinal"
    return _constraints[ordinal]

layoutfact: class
  _proof = .siteproof
  _countkind = .string
  _count = .int
  _resultkind = .string
  _result = .lltargetflow..storagefact
  _counter = .lltargetflow..storagefact
  _actuals = .lltargetflow..storagefact[]
  _bank = .string
  _first = .int
  _span = .int
  _phase = .string
  *: factory
    arg proof = .siteproof, countkind = 'unknown', count = -1, resultkind = 'unknown', ?result = .lltargetflow..storagefact, ?counter = .lltargetflow..storagefact, ?actuals = .lltargetflow..storagefact[], bank = '', first = -1, span = 0, phase = ''
    _proof = proof; _countkind = countkind; _count = count; _resultkind = resultkind
    if ?result then _result = result
    if ?counter then _counter = counter
    if ?actuals then _actuals = actuals
    _bank = bank; _first = first; _span = span; _phase = phase
    return
  valid: method = .int
    return _proof.valid()
  status: method = .string
    return _proof.status()
  reason: method = .string
    return _proof.reason()
  countknown: method = .int
    return valid() & _countkind <> 'unknown' & _count >= 0
  countkind: method = .string
    if valid() = 0 then return 'unknown'
    return _countkind
  resultkind: method = .string
    if valid() = 0 then return 'unknown'
    return _resultkind
  count: method = .int
    if countknown() = 0 then return -1
    return _count
  result: method = .lltargetflow..storagefact
    call _proof.require()
    if _resultkind <> 'captured' then assembler signal "ERROR","LL_TARGET_SITE: layout result has no storage"
    return _result
  countstorage: method = .lltargetflow..storagefact
    call _proof.require()
    if _countkind <> 'captured' then assembler signal "ERROR","LL_TARGET_SITE: layout count has no storage"
    return _counter
  actual: method = .lltargetflow..storagefact
    arg ordinal = .int
    call _proof.require()
    if ordinal < 1 | ordinal > _actuals[0] then assembler signal "ERROR","LL_TARGET_SITE: layout actual ordinal"
    return _actuals[ordinal]
  windowbank: method = .string
    call _proof.require(); return _bank
  windowfirst: method = .int
    call _proof.require(); return _first
  windowspan: method = .int
    call _proof.require(); return _span
  capturephase: method = .string
    call _proof.require(); return _phase

/** Point-local observation preservation is not callback absence or permission
 * to move a write across earlier operations. Both checkpoint owners survive. */
preservationfact: class
  _proof = .siteproof
  _source = .lltargetflow..callbackfact
  _candidate = .lltargetflow..callbackfact
  _correspondence = reference .lltargetremap..correspondence
  _hascorrespondence = .int
  *: factory
    arg proof = .siteproof, source = .lltargetflow..callbackfact, candidate = .lltargetflow..callbackfact, ?correspondence = reference .lltargetremap..correspondence
    _proof = proof; _source = source; _candidate = candidate
    if ?correspondence & proof.status() = 'proved' then do
      if <refvalid>(correspondence) then do; _correspondence = correspondence; _hascorrespondence = 1; end
    end
    return
  valid: method = .int
    if _proof.valid() = 0 | _source.valid() = 0 | _candidate.valid() = 0 then return 0
    if _hascorrespondence then do
      if <refvalid>(_correspondence) = 0 then return 0
      mapping = dereference _correspondence
      if mapping.valid() = 0 then return 0
      sourceflow = _source.points(); candidateflow = _candidate.points()
      before = dereference sourceflow; after = dereference candidateflow
      beforeowner = mapping.sourceowner(); afterowner = mapping.candidateowner()
      beforeprofile = mapping.sourceprofile(); afterprofile = mapping.candidateprofile()
      beforecfg = mapping.sourcecfg(); aftercfg = mapping.candidatecfg()
      actualowner = before.owner(); resultowner = after.owner()
      actualprofile = before.transfers(); resultprofile = after.transfers()
      actualcfg = before.cfg(); resultcfg = after.cfg()
      if (beforeowner <refsame> actualowner) = 0 | (afterowner <refsame> resultowner) = 0 | (beforeprofile <refsame> actualprofile) = 0 | (afterprofile <refsame> resultprofile) = 0 | (beforecfg <refsame> actualcfg) = 0 | (aftercfg <refsame> resultcfg) = 0 then return 0
      event = mapping.event(_source.operation(),_source.ordinal(),_source.edge())
      if event.valid() = 0 then return 0
      if event.candidateoperation() <> _candidate.operation() | event.candidateordinal() <> _candidate.ordinal() | event.candidateedge() <> _candidate.edge() then return 0
    end
    return 1
  status: method = .string
    if _proof.status() = 'limit' | _source.status() = 'limit' | _candidate.status() = 'limit' then return 'limit'
    if valid() = 0 then return 'invalid'
    return _proof.status()
  reason: method = .string
    if _proof.status() = 'limit' then return _proof.reason()
    if _source.status() = 'limit' then return _source.reason()
    if _candidate.status() = 'limit' then return _candidate.reason()
    if valid() = 0 then return 'target.callback.preservation.owner.expired.or.replaced'
    return _proof.reason()
  preserved: method = .int
    return status() = 'proved'
  source: method = .lltargetflow..callbackfact
    return _source
  candidate: method = .lltargetflow..callbackfact
    return _candidate

/** A numeric context delta for one exact call. Activation, initializer,
 * result and storage duties remain independent. Unknown caller fields use
 * dedicated saved integer cells; known fields use literals. Normal returns
 * and potential cold exits are reported separately. This numeric delta does
 * not certify that a call can be deleted. */
restorationfact: class
  _bound = .int
  _proof = .siteproof
  _operation = .int
  _procedure = .int
  _domains = .int[]
  _modes = .string[]
  _getters = .string[]
  _setters = .string[]
  _literals = .lltarget..operand[]
  _saveordinals = .int[]
  _saves = .int
  _exits = .int[]
  _coldexits = .int[]
  *: factory
    return
  bound: factory
    arg proof = .siteproof, operation = .int, procedureid = .int, domains = .int[], modes = .string[], getters = .string[], setters = .string[], literals = .lltarget..operand[], saveordinals = .int[], saves = .int, exits = .int[], ?coldexits = .int[]
    _bound = 1; _proof = proof; _operation = operation; _procedure = procedureid
    _domains = domains; _modes = modes; _getters = getters; _setters = setters
    _literals = literals; _saveordinals = saveordinals; _saves = saves; _exits = exits
    if ?coldexits then _coldexits = coldexits
    return
  valid: method = .int
    if _bound = 0 then return 0
    return _proof.valid()
  status: method = .string
    if _bound = 0 then return 'invalid'
    return _proof.status()
  reason: method = .string
    if _bound = 0 then return 'target.context.restore.unbound'
    return _proof.reason()
  allowed: method = .int
    return valid() & status() = 'proved'
  require: method = .void
    if _bound = 0 then assembler signal "ERROR","LL_TARGET_SITE: unbound restoration plan"
    call _proof.require()
    return
  row: method = .void
    arg ordinal = .int
    call require()
    if ordinal < 1 | ordinal > _domains[0] then assembler signal "ERROR","LL_TARGET_SITE: restoration field ordinal"
    return
  operation: method = .int
    if valid() = 0 then return 0
    return _operation
  procedure: method = .int
    if valid() = 0 then return 0
    return _procedure
  fields: method = .int
    call require(); return _domains[0]
  domain: method = .int
    arg ordinal = .int
    call row(ordinal); return _domains[ordinal]
  mode: method = .string
    arg ordinal = .int
    call row(ordinal); return _modes[ordinal]
  getter: method = .string
    arg ordinal = .int
    call row(ordinal); return _getters[ordinal]
  setter: method = .string
    arg ordinal = .int
    call row(ordinal); return _setters[ordinal]
  literal: method = .lltarget..operand
    arg ordinal = .int
    call row(ordinal); return _literals[ordinal]
  saveordinal: method = .int
    arg ordinal = .int
    call row(ordinal); return _saveordinals[ordinal]
  saves: method = .int
    call require(); return _saves
  exits: method = .int
    call require(); return _exits[0]
  exit: method = .int
    arg ordinal = .int
    call require()
    if ordinal < 1 | ordinal > _exits[0] then assembler signal "ERROR","LL_TARGET_SITE: restoration exit ordinal"
    return _exits[ordinal]
  coldexits: method = .int
    call require(); return _coldexits[0]
  coldexit: method = .int
    arg ordinal = .int
    call require()
    if ordinal < 1 | ordinal > _coldexits[0] then assembler signal "ERROR","LL_TARGET_SITE: restoration cold exit ordinal"
    return _coldexits[ordinal]

/** An immutable procedure/mode view. Direct effects do not include callee
 * bodies; transitive may effects include the exact locally bound closure. */
summary: class
  _owner = reference .lltargetsummary..analysis
  _identity = .int
  _function = .int
  _mode = .string
  *: factory
    arg owner = reference .analysis, functionid = .int, mode = .string
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _function = functionid; _mode = mode
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner; return owner.valid() & owner.identity() = _identity
  status: method = .string
    if valid() then return 'ok'
    return 'invalid'
  reason: method = .string
    if valid() then return ''
    return 'target.summary.owner.expired.or.replaced'
  require: method = .void
    if valid() = 0 then assembler signal "ERROR","LL_TARGET_SUMMARY: expired or replaced procedure view"
    return
  function: method = .int
    call require()
    return _function
  mode: method = .string
    call require()
    return _mode
  effect: method = .lltargetsummary..effectfact
    arg family = .string, kind = .string, domain = '*', depth = 64
    call require(); owner = dereference _owner; return owner.effect(_function,_mode,family,kind,domain,depth)
  outwardeffect: method = .lltargetsummary..effectfact
    arg family = .string, kind = .string, domain = '*'
    call require(); owner = dereference _owner; return owner.outwardeffect(_function,_mode,family,kind,domain)
  calls: method = .int
    call require(); owner = dereference _owner; return owner.calls(_function)
  calltarget: method = .int
    arg ordinal = .int
    call require(); owner = dereference _owner; return owner.calltarget(_function,ordinal)
  returns: method = .int
    call require(); owner = dereference _owner; return owner.returns(_function)
  returnoperation: method = .int
    arg ordinal = .int
    call require(); owner = dereference _owner; return owner.returnoperation(_function,ordinal)
  returnvalue: method = .lltargetsummary..returnfact
    arg domain = .int
    call require(); owner = dereference _owner; return owner.returnvalue(_function,domain)
  mayreturn: method = .lltargetsummary..effectfact
    call require(); owner = dereference _owner; return owner.returnpossible(_function)

/** Module analysis shares the exact point/edge owner and its dependency
 * identity. Fixed points grow may sets from direct events; child uncertainty
 * widens affected families, never establishes a must effect or constant. */
analysis: class
  _flow = reference .lltargetflow..analysis
  _flowid = .int
  _identity = .int
  _status = .string
  _message = .string
  _work = .int
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  _direct = .object[]
  _transitive = .object[]
  _callfirst = .int[]
  _callcount = .int[]
  _retfirst = .int[]
  _retcount = .int[]
  _callfunction = .int[]
  _calloperation = .int[]
  _calltarget = .int[]
  _retfunction = .int[]
  _retoperation = .int[]
  _retaction = .int[]
  _returnpossible = .int[]
  _returnunknown = .int[]
  _querywork = .int
  _querylimit = .int
  _queryreason = .string
  _sitework = .int
  _sitebytes = .int
  _sitefailure = .string
  _discardfacts = .discardfact[]
  _discardpresent = .int[]
  _footprintfacts = .footprintfact[]
  _footprintpresent = .int[]
  _layoutfacts = .layoutfact[]
  _layoutpresent = .int[]
  _restorefacts = .restorationfact[]
  _restorepresent = .int[]
  *: factory
    arg flow = reference .lltargetflow..analysis, work = 1000000, bytes = 67108864
    _flow = flow; _identity = nextidentity(); _status = 'building'
    _worklimit = work; _bytelimit = bytes
    return
  fail: method = .int
    arg status = .string, message = .string
    _status = status; _message = message
    return 0
  spend: method = .int
    arg amount = .int
    if amount < 0 | amount > _worklimit - _work then return fail('limit','target.summary.work')
    _work = _work + amount
    return 1
  reserve: method = .int
    arg amount = .int
    if amount < 0 | amount > _bytelimit - _bytes then return fail('limit','target.summary.bytes')
    _bytes = _bytes + amount
    return 1
  rowadd: method = .int
    arg expose result = .row, family = .string, kind = .string, domain = .string, operation = 0, definite = 0
    if _status <> 'building' then return 0
    return result.add(family,kind,domain,operation,definite,reference self)
  rowunknown: method = .int
    arg expose result = .row, family = .string
    if _status <> 'building' then return 0
    return result.unknown(family,reference self)
  queryspend: method = .int
    arg amount = .int
    if amount < 0 | amount > _worklimit - _work - _sitework - _querywork then do; _querylimit = 1; _queryreason = 'target.summary.query.work'; return 0; end
    _querywork = _querywork + amount
    return 1
  sitespend: method = .int
    arg amount = .int
    if amount < 0 | amount > _worklimit - _work - _sitework - _querywork then do; _sitefailure = 'target.site.work'; return 0; end
    _sitework = _sitework + amount; return 1
  sitereserve: method = .int
    arg amount = .int
    if amount < 0 | amount > _bytelimit - _bytes - _sitebytes then do; _sitefailure = 'target.site.bytes'; return 0; end
    _sitebytes = _sitebytes + amount; return 1
  sitebegin: method = .int
    arg sourceop = .int
    call run()
    if valid() = 0 | _sitefailure <> '' then return 0
    flow = dereference _flow; owner = flow.owner(); source = dereference owner; item = source.at(sourceop)
    return item.valid()
  addoutput: method = .int
    arg expose outputs = .int[], domainid = .int
    if sitespend(outputs[0] + 1) = 0 then return 0
    do i = 1 to outputs[0]; if outputs[i] = domainid then return 1; end
    if sitereserve(8) = 0 then return 0
    outputs[outputs[0] + 1] = domainid
    return 1
  /** Shared flow owns hook-condition proof, including captured BEFORE state
   * on normal and exceptional prefixes. No absence is inferred from a facet's
   * missing row, nor from the fact that a callback eventually returned. */
  callbackmay: method = .int
    arg sourceop = .int, ordinal = .int, site = 0
    flow = dereference _flow; cfg_ref = flow.cfg(); cfg = dereference cfg_ref
    do i = 0 to cfg.outedges(sourceop)
      if site then do; if sitespend(1) = 0 then return 1; end
      else if spend(1) = 0 then return 1
      edgeid = 0
      if i > 0 then do; edge = cfg.outedge(sourceop,i); if cfg.edgefeasible(edge.id()) = 0 then iterate; edgeid = edge.id(); end
      possible = flow.callbackpossibleat(sourceop,ordinal,edgeid)
      if flow.status() <> 'ok' then do; ignored = fail(flow.status(),flow.reason()); return 1; end
      if possible then return 1
    end
    return 0
  abiaction: method = .int
    arg action = .lltargettransfer..action
    return action.kind() = 'callback' & wordpos(action.detail(),'catalog.callback.abi catalog.callback.departure') > 0
  /** Event population is a deferred slot write and may COPY a raw payload.
   * Immediate installer precision does not prove those later hooks absent. */
  deliverymay: method = .int
    arg edge = .lltargetcfg..edge
    return wordpos(edge.exposure(),'event-binding event-binding-async') > 0
  abiedge: method = .int
    arg edge = .lltargetcfg..edge, cfg = .lltargetcfg..graph
    if edge.regioncomplete() = 0 then return 1
    /* Independent operational premises acquire only their explicit effects.
     * Actual RXAS admission separately requires the canonical native profile. */
    profile_ref = cfg.profile(); profile = dereference profile_ref
    if profile.premise() <> 'canonical' then return 0
    /* Empty logical region exits do not prove absent physical-frame cleanup. */
    if wordpos(edge.role(),'terminal unwind') > 0 then return 1
    if edge.targetblock() = 0 & edge.boundarykind() <> '' then return 1
    return 0
  /** Physical departure effects remain separate from local transformations. */
  abimay: method = .int
    arg sourceop = .int, site = 0
    return abipossible(sourceop,site,0)
  /** Local output/placement edits use the same sealed fact's intrinsic view.
   * Async origin and row attribution are owned by CFG/flow, never guessed here. */
  abiintrinsicmay: method = .int
    arg sourceop = .int, site = 1
    return abipossible(sourceop,site,1)
  abipossible: method = .int
    arg sourceop = .int, site = .int, intrinsic = .int
    i = .int; hiddenabi = .int; proof = .lltargetflow..abicallbackfact; ignored = .int
    flow = dereference _flow; cfg_ref = flow.cfg(); cfg = dereference cfg_ref
    profile_ref = flow.transfers(); profile = dereference profile_ref; instruction = profile.instruction(sourceop)
    hiddenabi = 0
    do i = 1 to instruction.actions()
      if site then do; if sitespend(1) = 0 then return 1; end
      else if spend(1) = 0 then return 1
      if abiaction(instruction.action(i)) then hiddenabi = 1
    end
    if hiddenabi then do
      proof = flow.abicallbackat(sourceop)
      if flow.status() <> 'ok' then do; ignored = fail(flow.status(),flow.reason()); return 1; end
      if intrinsic then do
        if proof.intrinsicstatus() = 'limit' then do; ignored = fail('limit',proof.intrinsicreason()); return 1; end
        if proof.intrinsicpossible() then return 1
      end
      else do
        if proof.status() = 'limit' then do; ignored = fail('limit',proof.reason()); return 1; end
        if proof.possible() then return 1
      end
    end
    do i = 1 to cfg.outedges(sourceop)
      if site then do; if sitespend(i + 1) = 0 then return 1; end
      else if spend(i + 1) = 0 then return 1
      edge = cfg.outedge(sourceop,i)
      if cfg.edgefeasible(edge.id()) = 0 then iterate
      if deliverymay(edge) then return 1
      if hiddenabi = 0 & abiedge(edge,cfg) = 0 then iterate
      proof = flow.abicallbackat(sourceop,edge.id())
      if flow.status() <> 'ok' then do; ignored = fail(flow.status(),flow.reason()); return 1; end
      if intrinsic then do
        if proof.intrinsicstatus() = 'limit' then do; ignored = fail('limit',proof.intrinsicreason()); return 1; end
        if proof.intrinsicpossible() then return 1
      end
      else do
        if proof.status() = 'limit' then do; ignored = fail('limit',proof.reason()); return 1; end
        if proof.possible() then return 1
      end
    end
    return 0
  abiunknown: method = .void
    arg expose result = .row
    ignored = .int
    do i = 1 to 13
      family = word('effects calls bindings ownership numeric values observations arguments globals components flags signals control',i)
      ignored = rowunknown(result,family)
    end
    return
  abirole: method = .int
    arg expose roles = .rolefact[], proof = .siteproof, kind = .string, checkpoint = .string, extent = .string, resource = .lltargetflow..abiresource, functionid = .int
    if resource.storage() = 0 then return extent = 'none'
    if resource.valid() = 0 | resource.live() = 0 then return 0
    points_ref = resource.points()
    if (points_ref <refsame> _flow) = 0 then return 0
    points = dereference points_ref; storage = resource.storage()
    bank = points.storagebank(storage); number = points.storageindex(storage)
    if bank = '' | number < 0 then return 0
    if bank <> 'g' & points.storagefunction(storage) <> functionid then return 0
    if sitespend(1) = 0 | sitereserve(320) = 0 then return 0
    roles[roles[0] + 1] = .rolefact.checkpoint(proof,'abi.' || kind,bank,number,'abi.' || checkpoint,resource)
    return 1
  abifootprint: method = .string
    arg sourceop = .int, expose roles = .rolefact[], expose constraints = .constraintfact[], expose proofs = .lltargetflow..abicallbackfact[], proof = .siteproof
    i = .int; j = .int; hiddenabi = .int; edgeid = .int; ignored = .int
    row = .lltargetflow..abirow; abi = .lltargetflow..abicallbackfact
    flow = dereference _flow
    cfg_ref = flow.cfg(); cfg = dereference cfg_ref; profile_ref = flow.transfers(); profile = dereference profile_ref
    instruction = profile.instruction(sourceop); item = instruction.record(); hiddenabi = 0
    do i = 1 to instruction.actions()
      if sitespend(1) = 0 then return _sitefailure
      if abiaction(instruction.action(i)) then hiddenabi = 1
    end
    do i = 0 to cfg.outedges(sourceop)
      if sitespend(i + 1) = 0 then return _sitefailure
      edgeid = 0
      if i = 0 then do; if hiddenabi = 0 then iterate; end
      else do
        edge = cfg.outedge(sourceop,i); edgeid = edge.id()
        if cfg.edgefeasible(edge.id()) = 0 then iterate
        if deliverymay(edge) then return 'target.footprint.signal.event.delivery.unproved'
        if hiddenabi = 0 & abiedge(edge,cfg) = 0 then iterate
      end
      abi = flow.abicallbackat(sourceop,edgeid)
      if flow.status() <> 'ok' then do; ignored = fail(flow.status(),flow.reason()); return flow.reason(); end
      if abi.intrinsicstatus() = 'limit' then do; ignored = fail('limit',abi.intrinsicreason()); return abi.intrinsicreason(); end
      if abi.intrinsicstatus() <> 'proved' | abi.intrinsicpossible() then return 'target.footprint.abi.unproved'
      if sitespend(abi.intrinsicrows() * 2 + 1) = 0 | sitereserve(abi.bytes()) = 0 then return _sitefailure
      proofs[proofs[0] + 1] = abi
      do j = 1 to abi.intrinsicrows()
        row = abi.intrinsicrow(j)
        if abirole(roles,proof,row.sourcerole(),row.checkpoint(),row.sourceextent(),row.source(),item.procedureid()) = 0 then return 'target.footprint.abi.resource.unproved'
        if abirole(roles,proof,row.destinationrole(),row.checkpoint(),row.destinationextent(),row.destination(),item.procedureid()) = 0 then return 'target.footprint.abi.resource.unproved'
        if row.operation() = 'restore-slot' | row.operation() = 'bind-proxy' then do
          if row.slotknown() = 0 | row.slotfunction() <> item.procedureid() then return 'target.footprint.abi.slot.unproved'
          bank = row.slotbank(); number = row.slotindex()
          if bank = '' | number < 0 then return 'target.footprint.abi.slot.unproved'
          if sitespend(1) = 0 | sitereserve(384) = 0 then return _sitefailure
          binding = flow.unprovedstorage('target.footprint.abi.slot.only')
          roles[roles[0] + 1] = .rolefact(proof,0,'abi.' || row.destinationrole(),bank,number,'slot',binding,1)
          empty = .int[]
          constraints[constraints[0] + 1] = .constraintfact(proof,'fixed',bank,number,1,empty)
        end
      end
    end
    return ''
  boundchild: method = .int
    arg instruction = .lltargettransfer..instruction, action = .lltargettransfer..action
    literal = .lltarget..operand(); refview = .lltargettransfer..refview; i = .int
    flow = dereference _flow; source_ref = flow.owner(); source = dereference source_ref
    profile_ref = flow.transfers(); profile = dereference profile_ref
    if profile.premise() = 'canonical' then do
      target = flow.targetat(instruction.opid())
      if target.status() <> 'proved' then return 0
      provider = target.provider()
      if (provider <refsame> source_ref) = 0 then return 0
      return target.procedure()
    end
    if action.sourcekind() = 'literal' then literal = action.literal()
    else if action.sourcekind() = 'reference' then do
      do i = 1 to instruction.references()
        refview = instruction.ref(i)
        if refview.id() = action.sourceid() then literal = refview.operand()
      end
    end
    else do i = 1 to instruction.references()
      refview = instruction.ref(i)
      if refview.kind() = 'procedure' then do
        if literal.kind() <> '' then return 0
        literal = refview.operand()
      end
    end
    if literal.kind() <> 'P' then return 0
    return source.procedureid(literal.text())
  symboliceffect: method = .void
    arg expose result = .row, instruction = .lltargettransfer..instruction, refid = .int, operation = .string, key = .string, profile = .lltargettransfer..profile, ordinal = .int
    ignored = .int; i = .int
    if refid = 0 then return
    refview = profile.ref(refid)
    if refview.bank() = '' & refview.kind() <> 'address' then return
    flow = dereference _flow; cfg_ref = flow.cfg(); cfg = dereference cfg_ref
    action = instruction.action(ordinal)
    do i = 0 to cfg.outedges(instruction.opid())
      edgeid = 0; exceptional = 0; phase = 'unknown'
      if i > 0 then do
        edge = cfg.outedge(instruction.opid(),i); edgeid = edge.id(); phase = edge.phase()
        if cfg.edgefeasible(edge.id()) = 0 then iterate
        exceptional = phase <> 'none' & edge.role() <> 'normal' & edge.role() <> 'table' & right(edge.exposure(),6) <> '-async'
        if exceptional = 0 then iterate
      end
      if flow.applies(action,exceptional,phase) = 0 then iterate
      location = flow.actionstorage(instruction.opid(),ordinal,refid,edgeid)
      if flow.status() <> 'ok' then do; ignored = rowunknown(result,'effects'); return; end
    storage = location.active()
    if refview.anchor() = 'base' then storage = location.base()
    else if refview.anchor() = 'entry' then storage = location.entry()
    else if refview.anchor() <> 'active' then storage = 0
    bank = flow.storagebank(storage)
    if storage = 0 | bank = '' then do
      ignored = rowunknown(result,'arguments'); ignored = rowunknown(result,'globals'); ignored = rowunknown(result,'ownership'); iterate
    end
    if bank = 'a' then ignored = rowadd(result,'arguments',operation,'argument.' || flow.storageindex(storage) || '.' || key,instruction.opid(),0)
    else if bank = 'g' then ignored = rowadd(result,'globals',operation,'global.' || flow.revision() || '.' || flow.storageindex(storage) || '.' || key,instruction.opid(),0)
    /* Without call-site no-alias premises, mutation through a borrowed or
     * global storage can also be visible through another incoming alias. */
    if (operation = 'write' | operation = 'release') & (bank = 'a' | bank = 'g') then do
      ignored = rowunknown(result,'arguments'); ignored = rowunknown(result,'globals')
    end
    end
    return
  eventrow: method = .void
    arg expose result = .row, instruction = .lltargettransfer..instruction, action = .lltargettransfer..action, profile = .lltargettransfer..profile
    domain = .lltargettransfer..domain; refview = .lltargettransfer..refview
    ignored = .int; i = .int
    kind = action.kind(); family = 'components'; key = '*'; whole = action.domain() = 0
    if kind = 'callback' then do
      /* One ABI aggregate below also includes non-action departure edges. */
      if abiaction(action) then return
      if callbackmay(instruction.opid(),action.ordinal()) then call abiunknown(result)
      return
    end
    if action.domain() > 0 then do
      domain = profile.domain(action.domain()); key = domain.key()
      whole = domain.kind() = 'whole'
      if domain.kind() = 'context' then family = 'numeric'
      else if domain.kind() = 'flag' then family = 'flags'
    end
    observedfamily = family
    select kind
      when 'read' then operation = 'read'
      when 'observe' then do; family = 'observations'; operation = 'read'; end
      when 'transport' then operation = 'write'
      when 'write' then operation = 'write'
      when 'clear' then operation = 'write'
      when 'derive' then operation = 'write'
      when 'capture' then operation = 'read'
      when 'callcapture' then do; family = 'calls'; operation = 'capture'; end
      when 'select' then do; family = 'values'; operation = 'selection'; end
      when 'status' then do; family = 'flags'; operation = 'write'; end
      when 'resize' then do; family = 'ownership'; operation = 'release'; end
      when 'external' then do; family = 'effects'; operation = 'external'; key = action.detail(); end
      when 'flagwrite' then do; family = 'flags'; operation = 'write'; end
      when 'context' then do; family = 'numeric'; operation = 'write'; end
      when 'policy' then do; family = 'signals'; operation = 'policy'; key = action.detail(); end
      when 'raise' then do
        family = 'signals'; operation = 'raise'; name = action.literal()
        if action.sourcekind() = 'literal' & name.kind() = 'S' then key = name.text()
        else do; key = '*'; ignored = rowunknown(result,'signals'); end
      end
      when 'edge' then do; family = 'control'; operation = action.detail(); end
      when 'link' then do; family = 'bindings'; operation = 'change'; end
      when 'unlink' then do; family = 'bindings'; operation = 'change'; end
      when 'swap' then do; family = 'bindings'; operation = 'change'; end
      when 'lifetime' then do; family = 'ownership'; operation = 'release'; end
      when 'call' then do; family = 'calls'; operation = 'call'; key = action.detail(); end
      when 'return' then do; family = 'return'; operation = 'return'; end
      when 'unknown' then do; ignored = rowunknown(result,'*'); return; end
      otherwise do; ignored = rowunknown(result,'effects'); return; end
    end
    definite = action.certainty() = 'must' & action.path() <> 'failure'
    if definite & action.path() = 'normal' then do
      flow = dereference _flow; cfg_ref = flow.cfg(); cfg = dereference cfg_ref
      do e = 1 to cfg.outedges(instruction.opid())
        edge = cfg.outedge(instruction.opid(),e)
        if cfg.edgefeasible(edge.id()) = 0 then iterate
        if edge.role() <> 'normal' & edge.role() <> 'table' & edge.phase() <> 'none' & edge.targetblock() > 0 then definite = 0
      end
    end
    ignored = rowadd(result,family,operation,key,instruction.opid(),definite)
    if kind = 'observe' then ignored = rowadd(result,observedfamily,'read',key,instruction.opid(),definite)
    if whole & wordpos(kind,'read observe transport write clear derive') > 0 then do
      ignored = rowadd(result,'flags',operation,'*',instruction.opid(),definite)
      if kind = 'transport' & action.sourcekind() = 'reference' then ignored = rowadd(result,'flags','read','*',instruction.opid(),0)
    end
    if action.certainty() = 'unknown' then ignored = rowunknown(result,family)
    call symboliceffect(result,instruction,action.subject(),operation,key,profile,action.ordinal())
    if action.sourcekind() = 'reference' & wordpos(kind,'transport derive write flagwrite capture status resize') > 0 then do
      ignored = rowadd(result,family,'read',key,instruction.opid(),0)
      call symboliceffect(result,instruction,action.sourceid(),'read',key,profile,action.ordinal())
    end
    return
  /** Cold exit metadata is executable only on its edge, not at the
   * declaration. Summaries expose those writes and saved-base reads through
   * the same component/context families as ordinary instruction effects. */
  coldeffects: method = .void
    arg expose result = .row, edge = .lltargetcfg..edge, profile = .lltargettransfer..profile
    catalog = .llrxascatalog..catalog(); ignored = .int; i = .int; d = .int
    if edge.regioncomplete() = 0 then do
      /* Unknown signal control cannot invent cleanup in a procedure with no
       * active executable region. A possible crossed region keeps its duties
       * unknown; ordinary effect families remain independently precise. */
      flow = dereference _flow; owner = flow.owner(); source = dereference owner
      if source.regionat(edge.sourceop()) <> 0 then do
        ignored = rowunknown(result,'numeric'); ignored = rowunknown(result,'bindings'); ignored = rowunknown(result,'ownership')
      end
      return
    end
    do i = 1 to edge.coldactions()
      if spend(profile.domains() + 1) = 0 then return
      action = edge.coldaction(i); kind = action.action()
      bit = wordpos(kind,'digits fuzz form case standard')
      if bit > 0 then do
        code = catalog.find(word('getnumdgts getnumfuz getnumfrm getnumcas getnumstd',bit),'R')
        represented = 0
        do d = 1 to profile.domains()
          domain = profile.domain(d)
          if domain.kind() = 'context' & domain.nativebit() = catalog.contextreadmask(code) then do
            ignored = rowadd(result,'numeric','write',domain.key(),edge.sourceop(),0); represented = 1
          end
          saved = action.operand(6)
          if saved.kind() = 'R' & domain.kind() = 'component' & domain.nativebit() = catalog.componentmask('I') then ignored = rowadd(result,'components','read',domain.key(),edge.sourceop(),0)
        end
        if represented = 0 then ignored = rowunknown(result,'numeric')
      end
      else if kind = 'endlife' then ignored = rowadd(result,'ownership','release','*',edge.sourceop(),0)
      else if wordpos(kind,'unlink swap link') > 0 then ignored = rowadd(result,'bindings','change','*',edge.sourceop(),0)
    end
    return
  run: method = .void
    if _status <> 'building' then return
    direct = .row; result = .row; child = .row
    action = .lltargettransfer..action; instruction = .lltargettransfer..instruction
    f = .int; i = .int; j = .int; n = .int; c = .int; e = .int; ignored = .int; added = .int
    target = .int; changed = .int; familyordinal = .int; controlmask = .int
    do
      if _worklimit < 1 | _bytelimit < 1 then do; ignored = fail('limit','target.summary.budgets'); return; end
      if <refvalid>(_flow) = 0 then do; ignored = fail('invalid','target.summary.owner.expired'); return; end
      flow = dereference _flow
      if flow.status() <> 'ok' then do; ignored = fail(flow.status(),flow.message()); return; end
      _flowid = flow.identity(); source_ref = flow.owner(); source = dereference source_ref
      catalog = .llrxascatalog..catalog()
      profile_ref = flow.transfers(); profile = dereference profile_ref
      cfg_ref = flow.cfg(); cfg = dereference cfg_ref; index_ref = cfg.index(); index = dereference index_ref
      if reserve(index.functions() * 96) = 0 then return
      do f = 2 to index.functions()
        _direct[f] = .row() as .object; _returnpossible[f] = 0; _returnunknown[f] = 0
        _callfirst[f] = 0; _callcount[f] = 0; _retfirst[f] = 0; _retcount[f] = 0
        if cfg.normalcomplete(f) = 0 | cfg.exceptionalcomplete(f) = 0 | cfg.asynchronouscomplete(f) = 0 then _returnunknown[f] = 1
      end
      do i = 1 to source.records()
        if spend(1) = 0 then return
        record = source.record(i); f = record.procedureid()
        if f < 2 | record.kind() = 'procedure' then iterate
        instruction = profile.instruction(record.id()); direct = _direct[f] as .row
        if cfg.projectedop(record.id()) = 0 then do; ignored = rowunknown(direct,'control'); _direct[f] = direct as .object; iterate; end
        if flow.reached(record.id()) = 0 then do; _direct[f] = direct as .object; iterate; end
        do familyordinal = 1 to 12
          family = word('effects references components flags numeric signals order control values observations ownership calls',familyordinal)
          if instruction.complete(family) = 0 then ignored = rowunknown(direct,family)
        end
        if record.kind() = 'instruction' then do
          if spend(1) = 0 then return
          if catalog.framecontrolstate(record.opcode()) <> 'known' then ignored = rowunknown(direct,'framecontrol')
          else do
            controlmask = catalog.framecontrolmask(record.opcode())
            if controlmask <> 0 then ignored = rowadd(direct,'framecontrol','may',controlmask as .string,record.id(),1)
          end
        end
        do j = 1 to instruction.actions()
          if spend(instruction.references() + 1) = 0 | reserve(128) = 0 then return
          action = instruction.action(j); call eventrow(direct,instruction,action,profile)
          if _status <> 'building' then return
          if action.kind() = 'call' then do
            n = _callfunction[0] + 1; _callfunction[n] = f; _calloperation[n] = record.id(); _calltarget[n] = boundchild(instruction,action)
            if _callcount[f] = 0 then _callfirst[f] = n
            _callcount[f] = _callcount[f] + 1
            if _calltarget[n] = 0 then do; ignored = rowunknown(direct,'calls'); _returnunknown[f] = 1; end
          end
          if action.kind() = 'return' then do
            n = _retfunction[0] + 1; _retfunction[n] = f; _retoperation[n] = record.id(); _retaction[n] = action.id()
            if _retcount[f] = 0 then _retfirst[f] = n
            _retcount[f] = _retcount[f] + 1
          end
        end
        do e = 1 to cfg.outedges(record.id())
          if spend(e + 1) = 0 then return
          edge = cfg.outedge(record.id(),e)
          if cfg.edgefeasible(edge.id()) = 0 then iterate
          call coldeffects(direct,edge,profile)
          if _status <> 'building' then return
        end
        if abimay(record.id()) then do
          if reserve(512) = 0 then return
          call abiunknown(direct)
        end
        if _status <> 'building' then return
        if direct.isunknown('control') | direct.isunknown('signals') then _returnunknown[f] = 1
        _direct[f] = direct as .object
      end
      do f = 2 to index.functions()
        direct = _direct[f] as .row; _transitive[f] = direct.copy(reference self) as .object
        if _status <> 'building' then return
      end
      changed = 1
      do while changed
        changed = 0
        do c = 1 to _callfunction[0]
          if spend(1) = 0 then return
          target = _calltarget[c]; f = _callfunction[c]
          if target > 0 then do
            if _returnunknown[target] & _returnunknown[f] = 0 then do; _returnunknown[f] = 1; changed = 1; end
          end
        end
      end
      changed = 1
      do while changed & _status = 'building'
        changed = 0
        do f = 2 to index.functions()
          prior = _transitive[f] as .row; result = prior.copy(reference self)
          if _status <> 'building' then return
          do c = _callfirst[f] to _callfirst[f] + _callcount[f] - 1
            if spend(1) = 0 then return
            target = _calltarget[c]
            if target = 0 then do
              added = rowunknown(result,'*'); changed = changed | added
              iterate
            end
            prior = _transitive[target] as .row; child = prior.copy(reference self)
            if _status <> 'building' then return
            do n = 1 to child.count()
              if spend(1) = 0 then return
              /* Callee argument symbols need a call-site binding before they
               * can be renamed to the caller's formals or global aliases. */
              if child.family(n) = 'arguments' then do
                added = rowunknown(result,'arguments'); changed = changed | added
                iterate
              end
              added = rowadd(result,child.family(n),child.kind(n),child.domain(n),0,0)
              changed = changed | added
            end
            do n = 1 to child.unknowns()
              added = rowunknown(result,child.unknownat(n)); changed = changed | added
            end
            if _status <> 'building' then return
          end
          _transitive[f] = result as .object
        end
      end
      /* Least fixed point of finite normal-return paths. A recursive call
       * with no returning base case cannot justify its own continuation. */
      changed = 1
      do while changed & _status = 'building'
        changed = 0
        do f = 2 to index.functions()
          if _returnpossible[f] then iterate
          if spend(index.blocks() + cfg.edges() + _callfunction[0] + 1) = 0 then return
          if finitepath(f,cfg,index) then do; _returnpossible[f] = 1; changed = 1; end
        end
      end
      _status = 'ok'
      return
      on signal as problem
        if _status = 'building' then ignored = fail('invalid','target.summary.' || problem.name() || ': ' || problem.message())
    end
    return
  finitepath: method = .int
    arg functionid = .int, cfg = .lltargetcfg..graph, index = .llirgraph..index
    reachable = .int[]; pending = .int[]; head = 1; b = .int
    if index.blocks() > (_bytelimit - _bytes) / 16 then do; ignored = fail('limit','target.summary.path.bytes'); return 0; end
    do b = 1 to index.blocks(); reachable[b] = 0; end
    entry = index.functionentry(functionid); reachable[entry] = 1; pending[1] = entry
    do while head <= pending[0]
      if spend(1) = 0 then return 0
      b = pending[head]; head = head + 1
      do r = _retfirst[functionid] to _retfirst[functionid] + _retcount[functionid] - 1
        if spend(1) = 0 then return 0
        if cfg.projectedblock(_retoperation[r]) = b then return 1
      end
      do e = 1 to cfg.edges()
        if spend(1) = 0 then return 0
        edge = cfg.edge(e)
        if cfg.edgefeasible(edge.id()) = 0 then iterate
        if edge.sourceblock() <> b | edge.targetblock() = 0 then iterate
        blocked = 0
        if edge.role() = 'normal' | edge.role() = 'table' | edge.phase() = 'none' then do c = _callfirst[functionid] to _callfirst[functionid] + _callcount[functionid] - 1
          if spend(1) = 0 then return 0
          if _calloperation[c] <> edge.sourceop() then iterate
          target = _calltarget[c]
          if target > 0 then blocked = _returnpossible[target] = 0 & _returnunknown[target] = 0
        end
        if blocked then iterate
        next = edge.targetblock()
        if reachable[next] = 0 then do; reachable[next] = 1; pending[pending[0] + 1] = next; end
      end
    end
    return 0
  status: method = .string
    call run()
    if _status = 'ok' & valid() = 0 then return 'invalid'
    return _status
  message: method = .string
    call run()
    if _status = 'ok' & valid() = 0 then return 'target.summary.owner.expired.or.replaced'
    return _message
  reason: method = .string
    return message()
  valid: method = .int
    if _status <> 'ok' | <refvalid>(_flow) = 0 then return 0
    flow = dereference _flow; return flow.valid() & flow.identity() = _flowid
  identity: method = .int
    return _identity
  flow: method = reference .lltargetflow..analysis
    return _flow
  usedwork: method = .int
    return _work + _sitework + _querywork
  usedbytes: method = .int
    return _bytes + _sitebytes
  calllayout: method = .lltargetsummary..layoutfact
    arg sourceop = .int
    if sitebegin(sourceop) = 0 then return .layoutfact(.siteproof(reference self,'limit',_sitefailure))
    if sourceop <= _layoutpresent[0] then do; if _layoutpresent[sourceop] then return _layoutfacts[sourceop]; end
    flow = dereference _flow; owner = flow.owner(); source = dereference owner
    profile_ref = flow.transfers(); profile = dereference profile_ref; catalog = .llrxascatalog..catalog()
    item = source.at(sourceop); actuals = .lltargetflow..storagefact[]
    result = flow.storageat(sourceop,'',0); counter = flow.storageat(sourceop,'',0)
    state = 'proved'; reason = ''; countkind = 'unknown'; resultkind = 'absent'; count = -1
    bank = ''; first = -1; span = 0; phase = ''; countordinal = 0; resultordinal = 0
    value = .lltarget..operand; selected = .lltarget..operand; target = .lltargetflow..targetfact
    if item.kind() <> 'instruction' then return .layoutfact(.siteproof(reference self,'unknown','target.layout.not.instruction'))
      if catalog.callinvokes(item.opcode()) = 0 then return .layoutfact(.siteproof(reference self,'unknown','target.site.not.call'))
      count = flow.captureargumentcount(sourceop); countordinal = catalog.callcount(item.opcode())
      countkind = 'fixed'; phase = 'before-initializer'
      if countordinal > 0 then do
        countkind = 'captured'; phase = 'after-initializer'
        value = item.operand(countordinal); counter = flow.captureat(sourceop,value.bank(),value.index())
        if counter.active() = 0 then counter = flow.storageat(sourceop,value.bank(),value.index())
        value = item.operand(catalog.callwindow(item.opcode())); bank = value.bank(); first = value.index(); span = max(0,count + 1)
        target = flow.targetat(sourceop)
        if target.status() <> 'proved' then do; state = 'unknown'; if reason = '' then reason = 'target.layout.ingress.unproved'; end
        else do
          provider_ref = target.provider()
          if (provider_ref <refsame> owner) = 0 then do; state = 'unknown'; if reason = '' then reason = 'target.layout.initializer.capture.unproved'; end
        end
      end
      if catalog.callresult(item.opcode()) > 0 then resultkind = 'captured'
    if count < 0 then do; state = 'unknown'; if reason = '' then reason = 'target.layout.count.unproved'; countkind = 'unknown'; end
    if resultkind = 'captured' then do
      resultordinal = catalog.callresult(item.opcode())
      value = item.operand(resultordinal); result = flow.captureat(sourceop,value.bank(),value.index())
      if result.active() = 0 then result = flow.storageat(sourceop,value.bank(),value.index())
      if result.active() = 0 then do; state = 'unknown'; if reason = '' then reason = 'target.layout.result.binding.unproved'; end
    end
    if countkind = 'captured' then do
      if counter.active() = 0 then do; state = 'unknown'; if reason = '' then reason = 'target.layout.count.binding.unproved'; end
    end
    if sitespend(max(0,count) + max(0,sourceop - _layoutpresent[0]) + 1) = 0 | sitereserve(max(0,count) * 64 + max(0,sourceop - _layoutpresent[0]) * 24 + 192) = 0 then return .layoutfact(.siteproof(reference self,'limit',_sitefailure))
    do i = 1 to count
      actuals[i] = flow.captureargument(sourceop,i)
      selectedbinding = actuals[i]
      if selectedbinding.active() = 0 then do; state = 'unknown'; if reason = '' then reason = 'target.layout.actual.binding.unproved'; end
    end
    proof = .siteproof(reference self,state,reason)
    layout = .layoutfact(proof,countkind,count,resultkind,result,counter,actuals,bank,first,span,phase)
    _layoutfacts[sourceop] = layout; _layoutpresent[sourceop] = 1
    return layout
  discardability: method = .lltargetsummary..discardfact
    arg sourceop = .int
    i = .int; j = .int; d = .int; ordinal = .int; p = .int; overlap = .int; nativebit = .int; writesmask = .int; clearedmask = .int
    value = .lltargetflow..valuefact
    outputs = .int[]
    if sitebegin(sourceop) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
    if sourceop <= _discardpresent[0] then do; if _discardpresent[sourceop] then return _discardfacts[sourceop]; end
    flow = dereference _flow; owner = flow.owner(); source = dereference owner; item = source.at(sourceop)
    profile_ref = flow.transfers(); profile = dereference profile_ref; cfg_ref = flow.cfg(); cfg = dereference cfg_ref
    catalog = .llrxascatalog..catalog(); instruction = profile.instruction(sourceop)
    state = 'proved'; reason = ''; safe = 1; residual = 0; ownershiprequired = 0; ownershipproved = 1
    if item.kind() <> 'instruction' then do; state = 'unknown'; reason = 'target.discard.not.instruction'; safe = 0; end
    else do
      do i = 1 to 7
        family = word('effects references components observations ownership bindings order',i)
        if instruction.complete(family) = 0 then do; state = 'unknown'; reason = instruction.unknownreason(family); safe = 0; end
      end
      if catalog.flow(item.opcode()) <> 0 | catalog.callinvokes(item.opcode()) | catalog.selectionkind(item.opcode()) <> 0 then do; state = 'unknown'; reason = 'target.discard.control.or.selection'; safe = 0; end
      if catalog.signalstate(item.opcode()) <> 0 then do; state = 'unknown'; reason = 'target.discard.signal.unproved'; safe = 0; end
      residual = catalog.residualobservable(item.opcode())
      if catalog.opaqueeffects(item.opcode()) then do; state = 'unknown'; reason = 'target.discard.external.observable'; safe = 0; end
    end
    do i = 1 to instruction.actions()
      if sitespend(instruction.references() + 1) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
      action = instruction.action(i); kind = action.kind()
      if kind = 'callback' then do
        /* Native ABI rows are aggregated once using their intrinsic slice. */
        if abiaction(action) then iterate
        if callbackmay(sourceop,action.ordinal(),1) = 0 then iterate
        if _sitefailure <> '' then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
        state = 'unknown'; reason = 'target.discard.callback.unproved'; safe = 0; iterate
      end
      if wordpos(kind,'read observe write clear transport derive flagwrite capture status') = 0 then do; state = 'unknown'; reason = 'target.discard.residual.' || kind; safe = 0; end
      if action.subject() > 0 & wordpos(kind,'write clear transport derive') > 0 then do
        do d = 1 to profile.domains()
          if sitespend(1) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
          domain = profile.domain(d)
          if domain.kind() <> 'component' then iterate
          if domain.nativebit() <> catalog.componentmask('reference') & domain.nativebit() <> catalog.componentmask('native-payload') & domain.nativebit() <> catalog.componentmask('attribute-count') then iterate
          if action.domain() <> 0 & action.domain() <> d then iterate
          ref = profile.ref(action.subject()); nativebit = domain.nativebit()
          if ref.kind() = 'explicit' & ref.operandordinal() > 0 & catalog.bindingrecipe(item.opcode()) = '' then do
            /* A may-write envelope includes unrelated components. Only the
             * canonical precise write/clear resource masks impose old-payload
             * obligations; public attribute status is not a child tree. */
            writesmask = catalog.writecomponents(item.opcode(),ref.operandordinal())
            clearedmask = catalog.clearcomponents(item.opcode(),ref.operandordinal())
            assembler ior writesmask,writesmask,clearedmask
            assembler iand overlap,writesmask,nativebit
            if overlap = 0 then iterate
            ownershiprequired = ownershiprequired + 1
            if sitespend(flow.lookupcost() * 2) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
            value = flow.componentat(sourceop,ref.bank(),ref.index(),d)
            destination = flow.storageat(sourceop,ref.bank(),ref.index())
            do p = 1 to item.operands()
              if sitespend(1) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
              if p = ref.operandordinal() | catalog.writes(item.opcode(),p) = 0 then iterate
              other = item.operand(p)
              if other.kind() <> 'R' then iterate
              if sitespend(flow.lookupcost()) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
              otherbinding = flow.storageat(sourceop,other.bank(),other.index())
              if otherbinding.active() = 0 | otherbinding.active() = destination.active() then ownershipproved = 0
            end
          end
          else do
            ownershiprequired = ownershiprequired + 1
            value = flow.actioncomponent(sourceop,i,action.subject(),d)
          end
          if value.presence() <> 'absent' then ownershipproved = 0
        end
      end
    end
    if abiintrinsicmay(sourceop,1) then do; state = 'unknown'; reason = 'target.discard.abi.unproved'; safe = 0; end
    if _sitefailure <> '' then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
    if ownershipproved = 0 then do; state = 'unknown'; reason = 'target.discard.ownership.unproved'; safe = 0; end
    if residual & ownershiprequired = 0 & safe then do; state = 'unknown'; reason = 'target.discard.residual.unproved'; safe = 0; end
    access_ref = flow.projection(); access = dereference access_ref; projected = cfg.projectedop(sourceop)
    if access.status() <> 'ok' then return .discardfact(.siteproof(reference self,'limit',access.message()),0,outputs)
    if projected = 0 then do; state = 'unknown'; reason = 'target.discard.access.unavailable'; safe = 0; end
    else if access.known(projected) = 0 then do; state = 'unknown'; reason = 'target.discard.access.unproved'; safe = 0; end
    else do
      do i = 1 to access.accesses(projected)
        if access.accesskind(projected,i) = 4 then do; if addoutput(outputs,access.accessdomain(projected,i)) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs); end
      end
      do i = 1 to cfg.outedges(sourceop)
        edge = cfg.outedge(sourceop,i); ordinal = edge.successorordinal()
        if ordinal = 0 then iterate
        do j = 1 to access.edgeaccesses(projected,ordinal)
          if access.edgeaccesskind(projected,ordinal,j) = 4 then do; if addoutput(outputs,access.edgeaccessdomain(projected,ordinal,j)) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs); end
        end
      end
    end
    if sitespend(max(0,sourceop - _discardpresent[0]) + 1) = 0 | sitereserve(max(0,sourceop - _discardpresent[0]) * 24 + 128) = 0 then return .discardfact(.siteproof(reference self,'limit',_sitefailure),0,outputs)
    result = .discardfact(.siteproof(reference self,state,reason),safe,outputs)
    _discardfacts[sourceop] = result; _discardpresent[sourceop] = 1
    return result
  footprint: method = .lltargetsummary..footprintfact
    arg sourceop = .int
    roles = .rolefact[]; constraints = .constraintfact[]; members = .int[]
    result = .footprintfact; abiproofs = .lltargetflow..abicallbackfact[]
    i = .int; j = .int; k = .int; fixed = .int; found = .int; step = .int; number = .int
    if sitebegin(sourceop) = 0 then return .footprintfact(.siteproof(reference self,'limit',_sitefailure),roles,constraints)
    if sourceop <= _footprintpresent[0] then do; if _footprintpresent[sourceop] then return _footprintfacts[sourceop]; end
    flow = dereference _flow; owner = flow.owner(); source = dereference owner; item = source.at(sourceop)
    profile_ref = flow.transfers(); profile = dereference profile_ref; instruction = profile.instruction(sourceop)
    cfg_ref = flow.cfg(); cfg = dereference cfg_ref
    catalog = .llrxascatalog..catalog(); state = 'proved'; reason = ''; identity = 0
    binding = .lltargetflow..storagefact; view = .lltargettransfer..refview; action = .lltargettransfer..action
    value = .lltarget..operand; field = .lltarget..operand; layout = .layoutfact
    proof = .siteproof(reference self,'proved')
    do i = 1 to 3
      family = word('references bindings order',i)
      if instruction.complete(family) = 0 then do; state = 'unknown'; reason = instruction.unknownreason(family); end
    end
    if sitespend(item.registerrefs() * (instruction.references() + instruction.actions() + 1) + max(0,sourceop - _footprintpresent[0]) + 1) = 0 | sitereserve(item.registerrefs() * 192 + max(0,sourceop - _footprintpresent[0]) * 24 + 128) = 0 then return .footprintfact(.siteproof(reference self,'limit',_sitefailure),roles,constraints)
    do i = 1 to instruction.actions()
      if sitespend(1) = 0 then return .footprintfact(.siteproof(reference self,'limit',_sitefailure),roles,constraints)
      action = instruction.action(i)
      if action.kind() <> 'callback' then iterate
      if abiaction(action) then iterate
      possible = callbackmay(sourceop,i,1)
      if _sitefailure <> '' then return .footprintfact(.siteproof(reference self,'limit',_sitefailure),roles,constraints)
      if possible then do
        result = .footprintfact(.siteproof(reference self,'unknown','target.footprint.callback.unproved'),roles,constraints)
        _footprintfacts[sourceop] = result; _footprintpresent[sourceop] = 1
        return result
      end
    end
    abireason = abifootprint(sourceop,roles,constraints,abiproofs,proof)
    if abireason <> '' then do
      if _sitefailure <> '' then return .footprintfact(.siteproof(reference self,'limit',_sitefailure),roles,constraints)
      result = .footprintfact(.siteproof(reference self,'unknown',abireason),roles,constraints)
      _footprintfacts[sourceop] = result; _footprintpresent[sourceop] = 1
      return result
    end
    do i = 1 to item.registerrefs()
      value = item.registerref(i); kind = 'explicit'
      if item.kind() <> 'instruction' then kind = 'metadata'
      anchor = 'active'; fixed = 0; binding = flow.storageat(sourceop,value.bank(),value.index())
      do
        found = 0
        do j = 1 to instruction.references()
          view = instruction.ref(j)
          if view.bank() <> value.bank() | view.index() <> value.index() then iterate
          do k = 1 to instruction.actions()
            action = instruction.action(k)
            if wordpos(action.kind(),'link unlink swap') > 0 then fixed = 1
            if found then iterate
            used = action.subject() = view.id()
            if action.sourcekind() = 'reference' & action.sourceid() = view.id() then used = 1
            if used then do; binding = flow.actionstorage(sourceop,k,view.id()); anchor = view.anchor(); found = 1; end
          end
          leave
        end
      end
      if value.bank() <> 'r' then fixed = 1
      if binding.active() = 0 & fixed = 0 then do; state = 'unknown'; reason = 'target.footprint.binding.unproved'; end
      roles[roles[0] + 1] = .rolefact(proof,i,kind,value.bank(),value.index(),anchor,binding,fixed)
      if fixed then do
        members[1] = i; constraints[constraints[0] + 1] = .constraintfact(proof,'fixed',value.bank(),value.index(),1,members)
      end
    end
    if item.kind() = 'instruction' then do
      implicit = catalog.implicitrecipe(item.opcode())
      if left(implicit,6) = 'local:' then do
        number = substr(implicit,7) as .int
        binding = flow.storageat(sourceop,'r',number); empty = .int[]
        roles[roles[0] + 1] = .rolefact(proof,0,'implicit-fixed','r',number,'slot',binding,1)
        constraints[constraints[0] + 1] = .constraintfact(proof,'fixed','r',number,1,empty)
      end
      else if implicit <> '' & catalog.callinvokes(item.opcode()) = 0 then do
        /* A resolved addressed selector contributes its actual fixed slot. */
        addressed = 0
        do j = 1 to instruction.references()
          view = instruction.ref(j)
          if view.kind() <> 'address' then iterate
          addressed = 1; found = 0
          do k = 1 to instruction.actions()
            action = instruction.action(k)
            if action.subject() <> view.id() & (action.sourcekind() <> 'reference' | action.sourceid() <> view.id()) then iterate
            binding = flow.actionstorage(sourceop,k,view.id()); found = 1; leave
          end
          if found = 0 | binding.active() = 0 then do; state = 'unknown'; reason = 'target.footprint.address.unproved'; iterate; end
          bank = flow.storagebank(binding.active()); number = flow.storageindex(binding.active()); empty = .int[]
          roles[roles[0] + 1] = .rolefact(proof,0,'addressed',bank,number,view.targetanchor(),binding,1)
          constraints[constraints[0] + 1] = .constraintfact(proof,'fixed',bank,number,1,empty)
        end
        if addressed = 0 then do; state = 'unknown'; reason = 'target.footprint.implicit.unproved'; end
      end
      if catalog.callinvokes(item.opcode()) then do
        layout = calllayout(sourceop)
        if layout.status() <> 'proved' then do; state = layout.status(); reason = layout.reason(); end
        else if layout.windowspan() > 0 then do
          empty = .int[]
          constraints[constraints[0] + 1] = .constraintfact(proof,'window',layout.windowbank(),layout.windowfirst(),layout.windowspan(),empty)
        end
      end
      if catalog.unbounded(item.opcode()) then do
        target = flow.targetat(sourceop)
        if target.status() <> 'proved' then identity = 1
      end
      if identity then do
        body = source.body(item.procedureid()); empty = .int[]
        constraints[constraints[0] + 1] = .constraintfact(proof,'identity','r',0,body.locals(),empty)
      end
    end
    result = .footprintfact.checkpointed(.siteproof(reference self,state,reason),roles,constraints,abiproofs)
    _footprintfacts[sourceop] = result; _footprintpresent[sourceop] = 1
    return result
/** A component delta immediately before this exact callback may change only
   * storage outside its complete observed projection. A checked correspondence
   * can relate two unchanged activations, but is not a delta-history proof.
   * Earlier entry insertion needs separately checked prefix/dependency facts. */
  callbackpreservation: method = .lltargetsummary..preservationfact
    arg source = .lltargetflow..callbackfact, candidate = .lltargetflow..callbackfact, deltaBank = .string, deltaIndex = .int, deltaDomain = 0, ?correspondence = reference .lltargetremap..correspondence
    event = .lltargetremap..eventmap
    mappedentry = .int; i = .int
    mappingref = reference .lltargetremap..correspondence
    if ?correspondence then mappingref = correspondence
    if sitebegin(source.operation()) = 0 then return .preservationfact(.siteproof(reference self,'limit',_sitefailure),source,candidate,mappingref)
    if sitespend(16) = 0 | sitereserve(256) = 0 then return .preservationfact(.siteproof(reference self,'limit',_sitefailure),source,candidate,mappingref)
    if source.status() <> 'proved' then return .preservationfact(.siteproof(reference self,source.status(),source.reason()),source,candidate,mappingref)
    if candidate.status() <> 'proved' then return .preservationfact(.siteproof(reference self,candidate.status(),candidate.reason()),source,candidate,mappingref)
    if source.phase() <> candidate.phase() | wordpos(source.phase(),'none before after') = 0 | source.path() <> candidate.path() then return .preservationfact(.siteproof(reference self,'unknown','target.callback.phase.unproved'),source,candidate,mappingref)
    if source.observation() = 'physical' | candidate.observation() = 'physical' then return .preservationfact(.siteproof(reference self,'unknown','target.callback.physical.observation.unproved'),source,candidate,mappingref)
    if source.observation() <> 'component' | candidate.observation() <> 'component' then return .preservationfact(.siteproof(reference self,'unknown','target.callback.observation.projection.unproved'),source,candidate,mappingref)
    sourceflow = source.points(); candidateflow = candidate.points()
    if (sourceflow <refsame> _flow) = 0 then return .preservationfact(.siteproof(reference self,'invalid','target.callback.preservation.flow.mismatch'),source,candidate,mappingref)
    flow = dereference sourceflow; resultflow = dereference candidateflow
    mapped = <refvalid>(mappingref)
    if ?correspondence & mapped = 0 then return .preservationfact(.siteproof(reference self,'invalid','target.callback.correspondence.owner.expired'),source,candidate,mappingref)
    if mapped then do
      checkedref = reference .lltargetremap..correspondence; checkedref = mappingref
      mapping = dereference checkedref
      if mapping.status() <> 'proved' then return .preservationfact(.siteproof(reference self,mapping.status(),mapping.reason()),source,candidate,mappingref)
      beforeowner = mapping.sourceowner(); afterowner = mapping.candidateowner()
      beforeprofile = mapping.sourceprofile(); afterprofile = mapping.candidateprofile()
      beforecfg = mapping.sourcecfg(); aftercfg = mapping.candidatecfg()
      actualowner = flow.owner(); resultowner = resultflow.owner()
      actualprofile = flow.transfers(); resultprofile = resultflow.transfers()
      actualcfg = flow.cfg(); resultcfg = resultflow.cfg()
      if (beforeowner <refsame> actualowner) = 0 | (afterowner <refsame> resultowner) = 0 | (beforeprofile <refsame> actualprofile) = 0 | (afterprofile <refsame> resultprofile) = 0 | (beforecfg <refsame> actualcfg) = 0 | (aftercfg <refsame> resultcfg) = 0 then return .preservationfact(.siteproof(reference self,'invalid','target.callback.correspondence.owner.mismatch'),source,candidate,mappingref)
      event = mapping.event(source.operation(),source.ordinal(),source.edge())
      if event.status() <> 'proved' then return .preservationfact(.siteproof(reference self,event.status(),event.reason()),source,candidate,mappingref)
      if event.candidateoperation() <> candidate.operation() | event.candidateordinal() <> candidate.ordinal() | event.candidateedge() <> candidate.edge() then return .preservationfact(.siteproof(reference self,'unknown','target.callback.event.correspondence.unproved'),source,candidate,mappingref)
      if event.sourcefunction() <> source.function() | event.candidatefunction() <> candidate.function() then return .preservationfact(.siteproof(reference self,'unknown','target.callback.activation.unproved'),source,candidate,mappingref)
      if mapping.mapsregister(deltaBank,deltaIndex,deltaBank,deltaIndex) = 0 then return .preservationfact(.siteproof(reference self,'unknown','target.callback.delta.mapping.unproved'),source,candidate,mappingref)
    end
    else do
      if (sourceflow <refsame> candidateflow) = 0 then return .preservationfact(.siteproof(reference self,'unknown','target.callback.correspondence.required'),source,candidate,mappingref)
      if source.function() <> candidate.function() then return .preservationfact(.siteproof(reference self,'unknown','target.callback.activation.unproved'),source,candidate,mappingref)
      if source.operation() <> candidate.operation() | source.ordinal() <> candidate.ordinal() | source.edge() <> candidate.edge() then return .preservationfact(.siteproof(reference self,'unknown','target.callback.event.correspondence.unproved'),source,candidate,mappingref)
    end
    if source.possible() <> candidate.possible() then return .preservationfact(.siteproof(reference self,'unknown','target.callback.presence.unproved'),source,candidate,mappingref)
    profile_ref = flow.transfers(); profile = dereference profile_ref
    if deltaIndex < 0 | wordpos(deltaBank,'r g a') = 0 | deltaDomain < 0 | deltaDomain > profile.domains() then return .preservationfact(.siteproof(reference self,'invalid','target.callback.delta.selector.invalid'),source,candidate,mappingref)
    if deltaDomain > 0 then do
      domain = profile.domain(deltaDomain)
      if wordpos(domain.kind(),'component flag') = 0 then return .preservationfact(.siteproof(reference self,'unknown','target.callback.delta.domain.unproved'),source,candidate,mappingref)
    end
    if sitespend(flow.lookupcost() + resultflow.lookupcost() + 4) = 0 then return .preservationfact(.siteproof(reference self,'limit',_sitefailure),source,candidate,mappingref)
    observed = source.observed(); changed = source.binding(deltaBank,deltaIndex); storage = observed.active()
    if source.anchor() = 'base' then storage = observed.base()
    else if source.anchor() = 'entry' then storage = observed.entry()
    if flow.valid() = 0 then return .preservationfact(.siteproof(reference self,flow.status(),flow.message()),source,candidate,mappingref)
    if storage = 0 | changed.active() = 0 | changed.slotidentity() = 0 then return .preservationfact(.siteproof(reference self,'unknown','target.callback.delta.binding.unproved'),source,candidate,mappingref)
    if flow.privatedistinct(source.function(),storage,changed.active()) = 0 then return .preservationfact(.siteproof(reference self,'unknown','target.callback.delta.alias.unproved'),source,candidate,mappingref)
    resultobserved = candidate.observed(); resultchanged = candidate.binding(deltaBank,deltaIndex); resultstorage = resultobserved.active()
    if candidate.anchor() = 'base' then resultstorage = resultobserved.base()
    else if candidate.anchor() = 'entry' then resultstorage = resultobserved.entry()
    if resultflow.valid() = 0 then return .preservationfact(.siteproof(reference self,resultflow.status(),resultflow.message()),source,candidate,mappingref)
    if resultstorage = 0 | resultchanged.active() = 0 | resultchanged.slotidentity() = 0 then return .preservationfact(.siteproof(reference self,'unknown','target.callback.delta.binding.unproved'),source,candidate,mappingref)
    if resultflow.privatedistinct(candidate.function(),resultstorage,resultchanged.active()) = 0 then return .preservationfact(.siteproof(reference self,'unknown','target.callback.delta.alias.unproved'),source,candidate,mappingref)
    return .preservationfact(.siteproof(reference self,'proved'),source,candidate,mappingref)
  restorationfailure: method = .lltargetsummary..restorationfact
    arg sourceop = .int, procedureid = .int, reason = .string, state = 'unknown'
    domains = .int[]; modes = .string[]; getters = .string[]; setters = .string[]
    literals = .lltarget..operand[]; saveordinals = .int[]; exits = .int[]
    return .restorationfact.bound(.siteproof(reference self,state,reason),sourceop,procedureid,domains,modes,getters,setters,literals,saveordinals,0,exits)
  /** A numeric delta is independent of call-removal permission. Retained
   * child frames isolate their own changes. Explicit unknown numeric effects
   * remain unknown; hooks conservatively include every represented numeric
   * field. Potential outward edges use the same fields in cold metadata, while
   * internal/resuming handlers retain the current view. Async timing does not
   * demand an instruction-by-instruction restoration proof. */
  contextrestoration: method = .lltargetsummary..restorationfact
    arg sourceop = .int
    domains = .int[]; modes = .string[]; getters = .string[]; setters = .string[]
    literals = .lltarget..operand[]; saveordinals = .int[]; exits = .int[]; coldexits = .int[]; noexits = .int[]
    i = .int; j = .int; k = .int; d = .int; ordinal = .int; field = .int; code = .int; saves = 0
    name = .string
    result = .restorationfact
    providerfunction = 0; item = .lltarget..record; domain = .lltargettransfer..domain
    if sitebegin(sourceop) = 0 then return restorationfailure(sourceop,0,_sitefailure,'limit')
    if sourceop <= _restorepresent[0] then do; if _restorepresent[sourceop] then return _restorefacts[sourceop]; end
    flow = dereference _flow; owner = flow.owner(); source = dereference owner
    profile_ref = flow.transfers(); profile = dereference profile_ref; cfg_ref = flow.cfg(); cfg = dereference cfg_ref
    catalog = .llrxascatalog..catalog(); called = source.at(sourceop)
    if called.kind() <> 'instruction' then return restorationfailure(sourceop,0,'target.site.not.call')
    if catalog.callinvokes(called.opcode()) = 0 then return restorationfailure(sourceop,0,'target.site.not.call')
    selected = flow.targetat(sourceop)
    if selected.status() <> 'proved' then return restorationfailure(sourceop,0,selected.reason())
    provider_ref = selected.provider(); providerfunction = selected.procedure()
    if (provider_ref <refsame> owner) = 0 then return restorationfailure(sourceop,providerfunction,'target.context.restore.provider.unproved')
    body = source.body(providerfunction)
    if sitespend(body.records() * 8 + max(0,sourceop - _restorepresent[0]) + 1) = 0 | sitereserve(body.records() * 24 + max(0,sourceop - _restorepresent[0]) * 24 + 192) = 0 then return restorationfailure(sourceop,providerfunction,_sitefailure,'limit')
    do i = 1 to body.records()
      item = body.record(i)
      /* Generic rewriting may retain dead returns. Enumerate their sites,
       * without using dead effects to weaken or strengthen the delta. */
      if item.kind() = 'instruction' then do
        if catalog.returnkind(item.opcode()) > 0 then exits[exits[0] + 1] = item.id()
      end
      if item.kind() = 'procedure' | flow.reached(item.id()) = 0 then iterate
      instruction = profile.instruction(item.id())
      if instruction.complete('numeric') = 0 then return restorationfailure(sourceop,providerfunction,'target.context.restore.effects.unproved')
      allfields = 0
      do j = 1 to instruction.actions()
        if sitespend(1) = 0 then return restorationfailure(sourceop,providerfunction,_sitefailure,'limit')
        action = instruction.action(j)
        if action.kind() = 'callback' & abiaction(action) = 0 then do
          if callbackmay(item.id(),j,1) then allfields = 1
          if _sitefailure <> '' then return restorationfailure(sourceop,providerfunction,_sitefailure,'limit')
        end
        if action.kind() <> 'context' then iterate
        d = action.domain()
        if d < 1 | d > profile.domains() then return restorationfailure(sourceop,providerfunction,'target.context.restore.domain.unrepresented')
        domain = profile.domain(d)
        if domain.kind() <> 'context' then return restorationfailure(sourceop,providerfunction,'target.context.restore.domain.unrepresented')
        if addoutput(domains,d) = 0 then return restorationfailure(sourceop,providerfunction,_sitefailure,'limit')
      end
      do j = 1 to cfg.outedges(item.id())
        if sitespend(j + 1) = 0 then return restorationfailure(sourceop,providerfunction,_sitefailure,'limit')
        edge = cfg.outedge(item.id(),j)
        if cfg.edgefeasible(edge.id()) = 0 then iterate
        if deliverymay(edge) then allfields = 1
        if edge.regioncomplete() = 0 & source.regionat(item.id()) <> 0 then return restorationfailure(sourceop,providerfunction,edge.regionreason())
        if edge.targetblock() = 0 & wordpos(edge.role(),'normal table terminal') = 0 then do
          if sitereserve(8) = 0 then return restorationfailure(sourceop,providerfunction,_sitefailure,'limit')
          coldexits[coldexits[0] + 1] = edge.id()
        end
        do k = 1 to edge.coldactions()
          cleanup = edge.coldaction(k); bit = wordpos(cleanup.action(),'digits fuzz form case standard')
          if bit = 0 then iterate
          name = word('getnumdgts getnumfuz getnumfrm getnumcas getnumstd',bit); code = catalog.find(name,'R')
          do d = 1 to profile.domains()
            if sitespend(1) = 0 then return restorationfailure(sourceop,providerfunction,_sitefailure,'limit')
            domain = profile.domain(d)
            if domain.kind() = 'context' & domain.nativebit() = catalog.contextreadmask(code) then do
              if addoutput(domains,d) = 0 then return restorationfailure(sourceop,providerfunction,_sitefailure,'limit')
            end
          end
        end
      end
      /* A complete numeric callback footprint needs every public field.
       * An absent domain is missing evidence, never an unchanged field. */
      if allfields then do field = 1 to 5
        code = catalog.find(word('getnumdgts getnumfuz getnumfrm getnumcas getnumstd',field),'R'); represented = 0
        do d = 1 to profile.domains()
          if sitespend(1) = 0 then return restorationfailure(sourceop,providerfunction,_sitefailure,'limit')
          domain = profile.domain(d)
          if domain.kind() = 'context' & domain.nativebit() = catalog.contextreadmask(code) then do
            represented = 1
            if addoutput(domains,d) = 0 then return restorationfailure(sourceop,providerfunction,_sitefailure,'limit')
          end
        end
        if represented = 0 then return restorationfailure(sourceop,providerfunction,'target.context.restore.domain.unrepresented')
      end
    end
    if domains[0] = 0 then do
      result = .restorationfact.bound(.siteproof(reference self,'proved'),sourceop,providerfunction,domains,modes,getters,setters,literals,saveordinals,0,noexits)
    end
    else do
      do i = 1 to domains[0]
        domain = profile.domain(domains[i]); getter = ''; setter = ''; getterop = -1; setterop = -1
        do j = 1 to 5
          if sitespend(1) = 0 then return restorationfailure(sourceop,providerfunction,_sitefailure,'limit')
          name = word('getnumdgts getnumfuz getnumfrm getnumcas getnumstd',j); code = catalog.find(name,'R')
          if code < 0 then iterate
          if domain.nativebit() > 0 & catalog.contextreadmask(code) = domain.nativebit() then do
            getter = name; getterop = code; setter = word('setnumdgts setnumfuz setnumfrm setnumcas setnumstd',j)
            setterop = catalog.find(setter,'R'); leave
          end
        end
        if getterop < 0 | setterop < 0 then return restorationfailure(sourceop,providerfunction,'target.context.restore.domain.unrepresented')
        if catalog.contextwritemask(setterop) <> domain.nativebit() | catalog.contextwritemask(getterop) <> 0 | catalog.valuewriter(getterop,1) <> 'field' then return restorationfailure(sourceop,providerfunction,'target.context.restore.lowering.unproved')
        if observablecallbacks(getterop) <> 0 then return restorationfailure(sourceop,providerfunction,'target.context.restore.getter.callback.unproved')
        do k = 1 to i - 1
          prior = profile.domain(domains[k])
          if prior.nativebit() = domain.nativebit() then return restorationfailure(sourceop,providerfunction,'target.context.restore.domain.ambiguous')
        end
        point = flow.componentat(sourceop,'context',0,domains[i]); literal = point.literal()
        modes[i] = 'saved'; saveordinals[i] = 0; literals[i] = .lltarget..operand()
        if point.known() & literal.kind() = 'I' then do; modes[i] = 'literal'; literals[i] = literal; end
        else do; saves = saves + 1; saveordinals[i] = saves; end
        if modes[i] = 'literal' then setterop = catalog.find(setter,'I')
        if setterop < 0 then return restorationfailure(sourceop,providerfunction,'target.context.restore.lowering.unproved')
        if catalog.contextwritemask(setterop) <> domain.nativebit() then return restorationfailure(sourceop,providerfunction,'target.context.restore.lowering.unproved')
        if observablecallbacks(setterop) <> 0 then return restorationfailure(sourceop,providerfunction,'target.context.restore.setter.callback.unproved')
        getters[i] = getter; setters[i] = setter
      end
      result = .restorationfact.bound(.siteproof(reference self,'proved'),sourceop,providerfunction,domains,modes,getters,setters,literals,saveordinals,saves,exits,coldexits)
    end
    _restorefacts[sourceop] = result; _restorepresent[sourceop] = 1
    return result
  procedure: method = .lltargetsummary..summary
    arg functionid = .int, mode = 'transitive'
    call run()
    if valid() = 0 | functionid < 2 | functionid > _direct[0] | wordpos(mode,'direct transitive') = 0 then assembler signal "ERROR","LL_TARGET_SUMMARY: invalid procedure query"
    return .summary(reference self,functionid,mode)
  effect: method = .lltargetsummary..effectfact
    arg functionid = .int, mode = .string, family = .string, kind = .string, domain = '*', depth = 64
    call run(); current = .row
    if valid() = 0 then return .effectfact(reference self,1,0,1)
    if mode = 'direct' then current = _direct[functionid] as .row
    else current = _transitive[functionid] as .row
    may = current.has(family,kind,domain); unknown = current.isunknown(family)
    if wordpos(family,'effects references components flags numeric signals order control values observations ownership calls arguments globals return bindings framecontrol') = 0 then unknown = 1
    if depth < 0 then assembler signal "ERROR","LL_TARGET_SUMMARY: negative must-query depth"
    if may = 0 & unknown = 0 then return .effectfact(reference self,0,0,0)
    if depth = 0 then return .effectfact(reference self,may,0,1,'target.summary.must.depth',1)
    /* Each recursive step receives its own active vector. Preflight their
     * worst permitted logical extent before the first vector is allocated. */
    levels = min(depth,max(1,_direct[0])) + 2
    if _direct[0] > (_bytelimit - _bytes - _sitebytes) / 8 / levels then return .effectfact(reference self,may,0,1,'target.summary.must.bytes',1)
    _querylimit = 0; _queryreason = ''
    if queryspend(_direct[0]) = 0 then return .effectfact(reference self,may,0,1,_queryreason,1)
    active = .int[]
    do i = 1 to _direct[0]; active[i] = 0; end
    must = mustproof(functionid,mode,family,kind,domain,active,0,depth)
    if _querylimit then return .effectfact(reference self,may,0,1,_queryreason,1)
    return .effectfact(reference self,may,must,unknown)
  /** Outward effects describe an actual retained call after NORMAL return.
   * Internal numeric/policy changes are isolated by that real frame. This
   * query cannot authorize deleting an inline restoration mechanism. */
  outwardeffect: method = .lltargetsummary..effectfact
    arg functionid = .int, mode = .string, family = .string, kind = .string, domain = '*'
    call run()
    if valid() = 0 then return .effectfact(reference self,1,0,1)
    if (family == 'numeric' & kind == 'write') | (family == 'signals' & kind == 'policy') then do
      if _returnpossible[functionid] = 0 then return .effectfact(reference self,1,0,1)
      return .effectfact(reference self,0,0,0)
    end
    return effect(functionid,mode,family,kind,domain)
  /** A bounded sufficient must proof: each applicable normal return is
   * dominated by a definite event, or by an exact child call with the same
   * guarantee. Active recursion cannot prove its own guarantee. */
  mustproof: method = .int
    arg functionid = .int, mode = .string, family = .string, kind = .string, domain = .string, active = .int[], depth = .int, maximum = .int
    direct = .row; edge = .lltargetcfg..edge
    sourceblock = .int
    if depth >= maximum then do; _querylimit = 1; _queryreason = 'target.summary.must.depth'; return 0; end
    if queryspend(active[0] + 1) = 0 then return 0
    if valid() = 0 | _returnpossible[functionid] = 0 | _returnunknown[functionid] then return 0
    if active[functionid] then return 0
    active[functionid] = 1
    flow = dereference _flow; cfg_ref = flow.cfg(); cfg = dereference cfg_ref; index_ref = cfg.index(); index = dereference index_ref
    if cfg.normalcomplete(functionid) = 0 | cfg.exceptionalcomplete(functionid) = 0 then return 0
    direct = _direct[functionid] as .row
    if direct.isunknown(family) then return 0
    returns = 0
    do r = _retfirst[functionid] to _retfirst[functionid] + _retcount[functionid] - 1
      if queryspend(1) = 0 then return 0
      returns = returns + 1; covered = 0; targetblock = cfg.projectedblock(_retoperation[r])
      do i = 1 to direct.count()
        if queryspend(1) = 0 then return 0
        if (direct.family(i) == family) = 0 | (direct.kind(i) == kind) = 0 | direct.definite(i) = 0 then iterate
        if (domain == '*') = 0 & (direct.domain(i) == domain) = 0 then iterate
        sourceblock = cfg.projectedblock(direct.operation(i))
        /* Same-operation subevent order needs a separate event-order proof. */
        if sourceblock <> targetblock & index.dominates(sourceblock,targetblock) then covered = 1
      end
      if mode = 'transitive' & covered = 0 then do c = _callfirst[functionid] to _callfirst[functionid] + _callcount[functionid] - 1
        if queryspend(1) = 0 then return 0
        if _calltarget[c] = 0 then iterate
        sourceblock = cfg.projectedblock(_calloperation[c])
        if sourceblock = targetblock | index.dominates(sourceblock,targetblock) = 0 then iterate
        safe = 1
        if queryspend(1) = 0 then return 0
        do e = 1 to cfg.outedges(_calloperation[c])
          /* Indexed edge lookup follows e linked rows. Charge its full scan. */
          if queryspend(e) = 0 then return 0
          edge = cfg.outedge(_calloperation[c],e)
          if cfg.edgefeasible(edge.id()) = 0 then iterate
          if edge.role() <> 'normal' & edge.role() <> 'table' & edge.phase() <> 'none' & edge.targetblock() > 0 then safe = 0
        end
        if safe then do
          if mustproof(_calltarget[c],'transitive',family,kind,domain,active,depth + 1,maximum) then covered = 1
        end
      end
      if covered = 0 then return 0
    end
    return returns > 0
  calls: method = .int
    arg functionid = .int
    if valid() = 0 | functionid < 2 | functionid > _callcount[0] then return 0
    return _callcount[functionid]
  calltarget: method = .int
    arg functionid = .int, ordinal = .int
    if valid() = 0 | functionid < 2 | functionid > _callcount[0] then return 0
    if ordinal < 1 | ordinal > _callcount[functionid] then return 0
    return _calltarget[_callfirst[functionid] + ordinal - 1]
  returns: method = .int
    arg functionid = .int
    if valid() = 0 | functionid < 2 | functionid > _retcount[0] then return 0
    return _retcount[functionid]
  returnoperation: method = .int
    arg functionid = .int, ordinal = .int
    if valid() = 0 | functionid < 2 | functionid > _retcount[0] then return 0
    if ordinal < 1 | ordinal > _retcount[functionid] then return 0
    return _retoperation[_retfirst[functionid] + ordinal - 1]
  returnpossible: method = .lltargetsummary..effectfact
    arg functionid = .int
    call run()
    return .effectfact(reference self,_returnpossible[functionid],0,_returnunknown[functionid])
  returnvalue: method = .lltargetsummary..returnfact
    arg functionid = .int, domainid = .int
    call run()
    literal = .lltarget..operand(); candidate = .lltarget..operand()
    action = .lltargettransfer..action; refview = .lltargettransfer..refview
    flow = dereference _flow; profile_ref = flow.transfers(); profile = dereference profile_ref
    if valid() = 0 then return .returnfact(reference self,0,literal,'target.summary.owner.invalid')
    if _returnpossible[functionid] = 0 then return .returnfact(reference self,0,literal,'target.summary.no.finite.normal.return')
    if _returnunknown[functionid] then return .returnfact(reference self,0,literal,'target.summary.return.paths.unknown')
    count = 0
    _querylimit = 0; _queryreason = ''
    do i = _retfirst[functionid] to _retfirst[functionid] + _retcount[functionid] - 1
      if queryspend(1) = 0 then return .returnfact(reference self,0,literal,_queryreason,1)
      count = count + 1; action = profile.action(_retaction[i]); instruction = profile.instruction(_retoperation[i])
      candidate = .lltarget..operand()
      if action.domain() <> domainid then return .returnfact(reference self,0,literal,'target.summary.return.component.unknown')
      if action.sourcekind() = 'literal' then candidate = action.literal()
      else do j = 1 to instruction.references()
        if queryspend(1) = 0 then return .returnfact(reference self,0,literal,_queryreason,1)
        refview = instruction.ref(j)
        if refview.id() <> action.subject() & refview.id() <> action.sourceid() then iterate
        fact = flow.componentat(_retoperation[i],refview.bank(),refview.index(),domainid)
        if fact.known() then candidate = fact.literal()
      end
      if candidate.kind() = '' then return .returnfact(reference self,0,literal,'target.summary.return.value.unknown')
      if queryspend(binlength(candidate.bytes()) + binlength(literal.bytes()) + 1) = 0 then return .returnfact(reference self,0,literal,_queryreason,1)
      if count = 1 then literal = candidate
      else if literal.kind() <> candidate.kind() | literal.index() <> candidate.index() | bincompare(literal.bytes(),candidate.bytes()) <> 0 then return .returnfact(reference self,0,literal,'target.summary.return.values.conflict')
    end
    if count = 0 then return .returnfact(reference self,0,literal,'target.summary.no.normal.return')
    return .returnfact(reference self,1,literal,'')

analyse: procedure = .lltargetsummary..analysis
  arg flow = reference .lltargetflow..analysis, work = 1000000, bytes = 67108864
  return .analysis(flow,work,bytes)
