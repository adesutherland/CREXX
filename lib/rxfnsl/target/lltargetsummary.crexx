/* cREXX License (MIT). Inferred procedure facts over shared target evidence. */
options levelb
namespace lltargetsummary expose analysis analyse summary effectfact returnfact discardfact footprintfact rolefact constraintfact layoutfact scopefreefact restorationfact activationfact directmappingfact preservationfact diagnosticclone diagnosticlimits directequivalencefact expansionplanfact expansionequivalencefact framecontrolhistoryfact
import rxfnsb
import llir
import llirgraph
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetflow
import lltargetbodyview
import lltargetremap
import llrxascatalog
import lltargetrecipe

boot: initialiser expose serial
  serial = 0
  return
nextidentity: procedure = .int expose serial
  if serial = 9223372036854775807 then assembler signal "ERROR","LL_TARGET_SUMMARY: identities exhausted"
  serial = serial + 1
  return serial

/** The enforced decimal ABI makes value-only synchronization nonobserving.
 * Other callback bits remain obligations of the existing storage/ABI owners. */
observablecallbacks: procedure = .int
  arg opcode = .int
  overlap = .int
  catalog = .llrxascatalog..catalog(); mask = catalog.callbackobligations(opcode)
  if catalog.contextsynccontract() = 'value-only-nonreentrant.v1' then do
    bit = catalog.callbackmask('plugin-sync'); assembler iand overlap,mask,bit; mask = mask - overlap
  end
  return mask

/** Sparse conservative effect set. Missing families remain explicit unknowns;
 * an unknown signal set does not erase an independently complete numeric set. */
row: class
  _family = .string[]
  _kind = .string[]
  _domain = .string[]
  _operation = .int[]
  _definite = .int[]
  _unknown = .string[]
  *: factory
    return
  count: method = .int
    return _family[0]
  family: method = .string
    arg ordinal = .int
    return _family[ordinal]
  kind: method = .string
    arg ordinal = .int
    return _kind[ordinal]
  domain: method = .string
    arg ordinal = .int
    return _domain[ordinal]
  operation: method = .int
    arg ordinal = .int
    return _operation[ordinal]
  definite: method = .int
    arg ordinal = .int
    return _definite[ordinal]
  add: method = .int
    arg family = .string, kind = .string, domain = .string, operation = 0, definite = 0
    i = .int
    do i = 1 to _family[0]
      if _family[i] = family & _kind[i] = kind & _domain[i] = domain & _operation[i] = operation & _definite[i] = definite then return 0
    end
    call append(family,kind,domain,operation,definite)
    return 1
  append: method = .void
    arg family = .string, kind = .string, domain = .string, operation = .int, definite = .int
    i = _family[0] + 1; _family[i] = family; _kind[i] = kind; _domain[i] = domain; _operation[i] = operation; _definite[i] = definite
    return
  unknown: method = .int
    arg family = .string
    i = .int
    do i = 1 to _unknown[0]; if _unknown[i] = family then return 0; end
    _unknown[_unknown[0] + 1] = family
    return 1
  isunknown: method = .int
    arg family = .string
    do i = 1 to _unknown[0]; if _unknown[i] = family | _unknown[i] = '*' then return 1; end
    return 0
  unknowns: method = .int
    return _unknown[0]
  unknownat: method = .string
    arg ordinal = .int
    return _unknown[ordinal]
  has: method = .int
    arg family = .string, kind = .string, domain = '*'
    do i = 1 to _family[0]
      if _family[i] = family & _kind[i] = kind & (domain = '*' | _domain[i] = domain | _domain[i] = '*') then return 1
    end
    return 0
  bytes: method = .int
    i = .int
    result = 64 + _family[0] * 80 + _unknown[0] * 16
    do i = 1 to _family[0]; result = result + length(_family[i]) + length(_kind[i]) + length(_domain[i]); end
    do i = 1 to _unknown[0]; result = result + length(_unknown[i]); end
    return result
  copy: method = .lltargetsummary..row
    i = .int; ignored = .int
    result = .row()
    do i = 1 to _family[0]
      call result.append(_family[i],_kind[i],_domain[i],_operation[i],_definite[i])
    end
    do i = 1 to _unknown[0]; ignored = result.unknown(_unknown[i]); end
    return result

effectfact: class
  _owner = reference .lltargetsummary..analysis
  _identity = .int
  _may = .int
  _must = .int
  _unknown = .int
  _reason = .string
  _limited = .int
  *: factory
    arg owner = reference .analysis, may = .int, must = .int, unknown = .int, reason = '', limited = 0
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _may = may; _must = must; _unknown = unknown
    _reason = reason; _limited = limited
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner; return owner.valid() & owner.identity() = _identity
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _limited then return 'limit'
    if _unknown then return 'unknown'
    return 'proved'
  reason: method = .string
    if valid() = 0 then return 'target.summary.owner.expired.or.replaced'
    if _reason <> '' then return _reason
    if _unknown then return 'target.summary.effect.incomplete'
    return ''
  may: method = .int
    if valid() = 0 then return 1
    return _may | _unknown
  must: method = .int
    return valid() & _must
  unknown: method = .int
    return valid() = 0 | _unknown

returnfact: class
  _owner = reference .lltargetsummary..analysis
  _identity = .int
  _known = .int
  _literal = .lltarget..operand
  _reason = .string
  *: factory
    arg owner = reference .analysis, known = .int, literal = .lltarget..operand, reason = .string
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _known = known; _literal = literal; _reason = reason
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    owner = dereference _owner; return owner.valid() & owner.identity() = _identity
  status: method = .string
    if valid() = 0 then return 'invalid'
    if _known then return 'proved'
    return 'unknown'
  reason: method = .string
    if valid() = 0 then return 'target.summary.owner.expired.or.replaced'
    return _reason
  known: method = .int
    return valid() & _known
  literal: method = .lltarget..operand
    if known() then return _literal
    return .lltarget..operand()

/** Shared immutable site-facet stamp. Enumeration is unavailable when the
 * facet is incomplete, rather than presenting an unknown set as empty. */
siteproof: class
  _owner = reference .lltargetsummary..analysis
  _identity = .int
  _status = .string
  _reason = .string
  _bodyview = .lltargetbodyview..view
  _hasbodyview = .int
  *: factory
    arg owner = reference .analysis, status = .string, reason = '', ?bodyview = .lltargetbodyview..view
    _owner = owner; parent = dereference owner; _identity = parent.identity()
    _status = status; _reason = reason
    _hasbodyview = ?bodyview
    if ?bodyview then _bodyview = bodyview
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    parent = dereference _owner
    if parent.valid() = 0 | parent.identity() <> _identity then return 0
    if _hasbodyview then return _bodyview.valid()
    return 1
  status: method = .string
    if <refvalid>(_owner) = 0 then return 'invalid'
    parent = dereference _owner
    if parent.identity() <> _identity then return 'invalid'
    if parent.status() = 'limit' then return 'limit'
    if valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    if status() = 'invalid' & valid() = 0 then return 'target.summary.owner.expired.or.replaced'
    if status() = 'limit' & _reason = '' then do; parent = dereference _owner; return parent.message(); end
    return _reason
  require: method = .void
    if status() <> 'proved' then assembler signal "ERROR","LL_TARGET_SITE: unavailable proof enumeration"
    return

discardfact: class
  _proof = .siteproof
  _safe = .int
  _outputs = .int[]
  *: factory
    arg proof = .siteproof, safe = .int, outputs = .int[]
    _proof = proof; _safe = safe; _outputs = outputs
    return
  valid: method = .int
    return _proof.valid()
  status: method = .string
    return _proof.status()
  reason: method = .string
    return _proof.reason()
  safeifdead: method = .int
    return valid() & status() = 'proved' & _safe
  outputs: method = .int
    call _proof.require(); return _outputs[0]
  outputdomain: method = .int
    arg ordinal = .int
    call _proof.require()
    if ordinal < 1 | ordinal > _outputs[0] then assembler signal "ERROR","LL_TARGET_SITE: output domain ordinal"
    return _outputs[ordinal]

rolefact: class
  _proof = .siteproof
  _ordinal = .int
  _kind = .string
  _bank = .string
  _index = .int
  _anchor = .string
  _binding = .lltargetflow..storagefact
  _resource = .lltargetflow..abiresource
  _hasresource = .int
  _fixed = .int
  *: factory
    arg proof = .siteproof, ordinal = .int, kind = .string, bank = .string, index = .int, anchor = .string, binding = .lltargetflow..storagefact, fixed = 0
    _proof = proof; _ordinal = ordinal; _kind = kind; _bank = bank; _index = index; _anchor = anchor; _binding = binding; _fixed = fixed
    return
  checkpoint: factory
    arg proof = .siteproof, kind = .string, bank = .string, index = .int, anchor = .string, resource = .lltargetflow..abiresource
    _proof = proof; _kind = kind; _bank = bank; _index = index; _anchor = anchor
    _resource = resource; _hasresource = 1; _fixed = 1
    points_ref = reference .lltargetflow..analysis; points_ref = resource.points()
    points = dereference points_ref
    _binding = points.unprovedstorage('target.footprint.abi.resource.checkpoint')
    return
  valid: method = .int
    if _proof.valid() = 0 | _binding.valid() = 0 then return 0
    if _hasresource then return _resource.valid()
    return 1
  status: method = .string
    if _proof.status() = 'limit' then return 'limit'
    if valid() = 0 then return 'invalid'
    return _proof.status()
  reason: method = .string
    if _proof.status() = 'limit' then return _proof.reason()
    if valid() = 0 then return 'target.footprint.resource.expired.or.replaced'
    return _proof.reason()
  require: method = .void
    if status() <> 'proved' then assembler signal "ERROR","LL_TARGET_SITE: unavailable footprint role"
    return
  ordinal: method = .int
    call require(); return _ordinal
  kind: method = .string
    call require(); return _kind
  bank: method = .string
    call require(); return _bank
  index: method = .int
    call require(); return _index
  anchor: method = .string
    call require(); return _anchor
  binding: method = .lltargetflow..storagefact
    call require(); return _binding
  fixed: method = .int
    call require(); return _fixed

  hasresource: method = .int
    return valid() & _hasresource
  resource: method = .lltargetflow..abiresource
    call require()
    if _hasresource = 0 then assembler signal "ERROR","LL_TARGET_SITE: role has no ABI resource checkpoint"
    return _resource

constraintfact: class
  _proof = .siteproof
  _kind = .string
  _bank = .string
  _first = .int
  _width = .int
  _members = .int[]
  *: factory
    arg proof = .siteproof, kind = .string, bank = .string, first = .int, width = .int, members = .int[]
    _proof = proof; _kind = kind; _bank = bank; _first = first; _width = width; _members = members
    return
  valid: method = .int
    return _proof.valid()
  kind: method = .string
    call _proof.require(); return _kind
  bank: method = .string
    call _proof.require(); return _bank
  first: method = .int
    call _proof.require(); return _first
  width: method = .int
    call _proof.require(); return _width
  roles: method = .int
    call _proof.require(); return _members[0]
  role: method = .int
    arg ordinal = .int
    call _proof.require()
    if ordinal < 1 | ordinal > _members[0] then assembler signal "ERROR","LL_TARGET_SITE: constraint member ordinal"
    return _members[ordinal]

footprintfact: class
  _proof = .siteproof
  _roles = .rolefact[]
  _constraints = .constraintfact[]
  _abi = .lltargetflow..abicallbackfact[]
  *: factory
    arg proof = .siteproof, roles = .rolefact[], constraints = .constraintfact[]
    _proof = proof; _roles = roles; _constraints = constraints
    return
  checkpointed: factory
    arg proof = .siteproof, roles = .rolefact[], constraints = .constraintfact[], abi = .lltargetflow..abicallbackfact[]
    _proof = proof; _roles = roles; _constraints = constraints; _abi = abi
    return
  valid: method = .int
    if _proof.valid() = 0 then return 0
    do i = 1 to _abi[0]; if _abi[i].valid() = 0 then return 0; end
    return 1
  status: method = .string
    if _proof.status() = 'limit' then return 'limit'
    if valid() = 0 then return 'invalid'
    return _proof.status()
  reason: method = .string
    if _proof.status() = 'limit' then return _proof.reason()
    if valid() = 0 then return 'target.footprint.abi.owner.expired.or.replaced'
    return _proof.reason()
  require: method = .void
    if status() <> 'proved' then assembler signal "ERROR","LL_TARGET_SITE: unavailable footprint enumeration"
    return
  roles: method = .int
    call require(); return _roles[0]
  role: method = .rolefact
    arg ordinal = .int
    call require()
    if ordinal < 1 | ordinal > _roles[0] then assembler signal "ERROR","LL_TARGET_SITE: footprint role ordinal"
    return _roles[ordinal]
  constraints: method = .int
    call require(); return _constraints[0]
  constraint: method = .constraintfact
    arg ordinal = .int
    call require()
    if ordinal < 1 | ordinal > _constraints[0] then assembler signal "ERROR","LL_TARGET_SITE: footprint constraint ordinal"
    return _constraints[ordinal]

layoutfact: class
  _proof = .siteproof
  _countkind = .string
  _count = .int
  _resultkind = .string
  _result = .lltargetflow..storagefact
  _counter = .lltargetflow..storagefact
  _actuals = .lltargetflow..storagefact[]
  _bank = .string
  _first = .int
  _span = .int
  _phase = .string
  *: factory
    arg proof = .siteproof, countkind = 'unknown', count = -1, resultkind = 'unknown', ?result = .lltargetflow..storagefact, ?counter = .lltargetflow..storagefact, ?actuals = .lltargetflow..storagefact[], bank = '', first = -1, span = 0, phase = ''
    _proof = proof; _countkind = countkind; _count = count; _resultkind = resultkind
    if ?result then _result = result
    if ?counter then _counter = counter
    if ?actuals then _actuals = actuals
    _bank = bank; _first = first; _span = span; _phase = phase
    return
  valid: method = .int
    return _proof.valid()
  status: method = .string
    return _proof.status()
  reason: method = .string
    return _proof.reason()
  countknown: method = .int
    return valid() & _countkind <> 'unknown' & _count >= 0
  countkind: method = .string
    if valid() = 0 then return 'unknown'
    return _countkind
  resultkind: method = .string
    if valid() = 0 then return 'unknown'
    return _resultkind
  count: method = .int
    if countknown() = 0 then return -1
    return _count
  result: method = .lltargetflow..storagefact
    call _proof.require()
    if _resultkind <> 'captured' then assembler signal "ERROR","LL_TARGET_SITE: layout result has no storage"
    return _result
  countstorage: method = .lltargetflow..storagefact
    call _proof.require()
    if _countkind <> 'captured' then assembler signal "ERROR","LL_TARGET_SITE: layout count has no storage"
    return _counter
  actual: method = .lltargetflow..storagefact
    arg ordinal = .int
    call _proof.require()
    if ordinal < 1 | ordinal > _actuals[0] then assembler signal "ERROR","LL_TARGET_SITE: layout actual ordinal"
    return _actuals[ordinal]
  windowbank: method = .string
    call _proof.require(); return _bank
  windowfirst: method = .int
    call _proof.require(); return _first
  windowspan: method = .int
    call _proof.require(); return _span
  capturephase: method = .string
    call _proof.require(); return _phase

activationfact: class
  _proof = .siteproof
  _allowed = .int
  _pending = .int
  _diagnosticpending = .int
  _retainedpending = .int
  _diagnostics = .diagnosticclone[]
  _dependencies = .siteproof[]
  _targets = .lltargetflow..targetfact[]
  _invocations = .lltargetflow..invocationfact[]
  _abi = .lltargetflow..abicallbackfact[]
  *: factory
    arg proof = .siteproof, allowed = .int
    _proof = proof; _allowed = allowed
    return
  dependent: factory
    arg proof = .siteproof, allowed = .int, dependencies = .activationfact[], targets = .lltargetflow..targetfact[]
    i = .int; j = .int
    _proof = proof; _allowed = allowed; _targets = targets
    do i = 1 to dependencies[0]
      do j = 1 to dependencies[i].proofs(); _dependencies[_dependencies[0] + 1] = dependencies[i].proof(j); end
      do j = 1 to dependencies[i].targets(); _targets[_targets[0] + 1] = dependencies[i].target(j); end
      do j = 1 to dependencies[i].contexts(); _invocations[_invocations[0] + 1] = dependencies[i].context(j); end
      do j = 1 to dependencies[i].abiproofs(); _abi[_abi[0] + 1] = dependencies[i].abiproof(j); end
      _pending = max(_pending,dependencies[i].pending())
      _diagnosticpending = max(_diagnosticpending,dependencies[i].diagnosticpending())
    end
    return
  deferred: factory
    arg proof = .siteproof, allowed = .int, dependencies = .activationfact[], targets = .lltargetflow..targetfact[], pending = .int, diagnosticpending = 0
    i = .int; j = .int
    _proof = proof; _allowed = allowed; _targets = targets; _pending = pending; _diagnosticpending = diagnosticpending
    do i = 1 to dependencies[0]
      do j = 1 to dependencies[i].proofs(); _dependencies[_dependencies[0] + 1] = dependencies[i].proof(j); end
      do j = 1 to dependencies[i].targets(); _targets[_targets[0] + 1] = dependencies[i].target(j); end
      do j = 1 to dependencies[i].contexts(); _invocations[_invocations[0] + 1] = dependencies[i].context(j); end
      do j = 1 to dependencies[i].abiproofs(); _abi[_abi[0] + 1] = dependencies[i].abiproof(j); end
      _pending = max(_pending,dependencies[i].pending())
      _diagnosticpending = max(_diagnosticpending,dependencies[i].diagnosticpending())
    end
    return
  contextual: factory
    arg proof = .siteproof, allowed = .int, dependencies = .activationfact[], targets = .lltargetflow..targetfact[], invocations = .lltargetflow..invocationfact[], abi = .lltargetflow..abicallbackfact[], diagnosticpending = 0, retainedpending = 0
    i = .int; j = .int
    _proof = proof; _allowed = allowed; _targets = targets; _invocations = invocations; _abi = abi; _diagnosticpending = diagnosticpending; _retainedpending = retainedpending
    do i = 1 to dependencies[0]
      do j = 1 to dependencies[i].proofs(); _dependencies[_dependencies[0] + 1] = dependencies[i].proof(j); end
      do j = 1 to dependencies[i].targets(); _targets[_targets[0] + 1] = dependencies[i].target(j); end
      do j = 1 to dependencies[i].contexts(); _invocations[_invocations[0] + 1] = dependencies[i].context(j); end
      do j = 1 to dependencies[i].abiproofs(); _abi[_abi[0] + 1] = dependencies[i].abiproof(j); end
      _diagnosticpending = max(_diagnosticpending,dependencies[i].diagnosticpending())
    end
    return
  diagnosed: factory
    arg proof = .siteproof, source = .activationfact, clone = .diagnosticclone
    i = .int
    _proof = proof; _allowed = source.semanticallowed(); _diagnostics[1] = clone
    do i = 1 to source.proofs(); _dependencies[_dependencies[0] + 1] = source.proof(i); end
    do i = 1 to source.targets(); _targets[_targets[0] + 1] = source.target(i); end
    do i = 1 to source.contexts(); _invocations[_invocations[0] + 1] = source.context(i); end
    do i = 1 to source.abiproofs(); _abi[_abi[0] + 1] = source.abiproof(i); end
    return
  valid: method = .int
    i = .int
    if _proof.valid() = 0 then return 0
    do i = 1 to _targets[0]; if _targets[i].valid() = 0 then return 0; end
    do i = 1 to _dependencies[0]; if _dependencies[i].valid() = 0 then return 0; end
    do i = 1 to _invocations[0]; if _invocations[i].valid() = 0 then return 0; end
    do i = 1 to _abi[0]; if _abi[i].valid() = 0 then return 0; end
    do i = 1 to _diagnostics[0]; if _diagnostics[i].valid() = 0 then return 0; end
    return 1
  status: method = .string
    if _proof.status() = 'limit' then return 'limit'
    if valid() = 0 then return 'invalid'
    if _pending > 0 & _proof.status() = 'proved' then return 'unknown'
    if _retainedpending > 0 & _proof.status() = 'proved' then return 'unknown'
    if _diagnosticpending > 0 & _proof.status() = 'proved' then return 'unknown'
    return _proof.status()
  reason: method = .string
    if _proof.status() = 'limit' then return _proof.reason()
    if valid() = 0 then return 'target.activation.dependency.expired.or.replaced'
    if _pending > 0 & _proof.status() = 'proved' then return 'target.activation.invocation.required'
    if _retainedpending > 0 & _proof.status() = 'proved' then return 'target.activation.retained.caller.certificate.required'
    if _diagnosticpending > 0 & _proof.status() = 'proved' then return 'target.activation.static.diagnostic.certificate.required'
    return _proof.reason()
  allowed: method = .int
    return semanticallowed() & _diagnosticpending = 0
  /** Planning permission does not discharge the static map obligation. */
  semanticallowed: method = .int
    return draftallowed() & _retainedpending = 0
  /** Draft permission never publishes a retained opaque caller boundary. */
  draftallowed: method = .int
    return genericallowed() & _pending = 0
  retainedpending: method = .int
    return _retainedpending
  diagnosticpending: method = .int
    return _diagnosticpending
  /** Generic remap/control proof is not permission to ignore pending ABI. */
  genericallowed: method = .int
    return valid() & _proof.status() = 'proved' & _allowed
  pending: method = .int
    return _pending
  proofs: method = .int
    return _dependencies[0] + 1
  proof: method = .siteproof
    arg ordinal = .int
    if ordinal = 1 then return _proof
    return _dependencies[ordinal - 1]
  targets: method = .int
    return _targets[0]
  target: method = .lltargetflow..targetfact
    arg ordinal = .int
    return _targets[ordinal]
  contexts: method = .int
    return _invocations[0]
  context: method = .lltargetflow..invocationfact
    arg ordinal = .int
    return _invocations[ordinal]
  abiproofs: method = .int
    return _abi[0]
  abiproof: method = .lltargetflow..abicallbackfact
    arg ordinal = .int
    return _abi[ordinal]

/** Conservative preconstruction envelope owned by the diagnostic checker.
 * Counts are upper bounds, never proof assertions. Failure to cover a hostile
 * or larger candidate remains an ordinary checked resource refusal. */
diagnosticlimits: class
  _work = .int
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  _status = .string
  _prepared = .int
  _records = .int
  _candidaterecords = .int
  _frames = .int
  _candidateframes = .int
  _payload = .int
  _operands = .int
  *: factory
    arg records = .int, candidaterecords = .int, frames = .int, candidateframes = .int, payload = .int, operands = .int, worklimit = .int, bytelimit = .int
    _worklimit = worklimit; _bytelimit = bytelimit; _status = 'pending'
    _records = records; _candidaterecords = candidaterecords; _frames = frames; _candidateframes = candidateframes
    _payload = payload; _operands = operands
    return
  prepare: method = .void
    if _prepared then return
    _prepared = 1; _status = 'proved'
    records = _records; candidaterecords = _candidaterecords; frames = _frames; candidateframes = _candidateframes
    payload = _payload; operands = _operands; worklimit = _worklimit; bytelimit = _bytelimit
    if min(records,candidaterecords,frames,candidateframes,payload,operands,worklimit,bytelimit) < 0 then do; _status = 'limit'; return; end
    if max(records,candidaterecords,frames,candidateframes,payload,operands) > (9223372036854775807 <idiv> 16) - 160 then do; _status = 'limit'; return; end
    call addwork(records + candidaterecords + 1,8)
    call addwork(operands,operands * 2)
    call addwork(operands + frames + 1,(records + candidaterecords) * 3 + 32)
    /* Existing static ancestors cause anchor scans. A new root alone does
     * not scan a source anchor for every copied instruction. */
    call addwork(product(frames + 1,frames + 1),records * 8 + 8)
    call addwork(frames + 1,(records + candidaterecords) * 4 + payload * 6 + 64)
    call addwork(records * 8 + frames + 8,payload * 2 + records + frames * 2 + 128)
    call addwork(records + 1,records + candidaterecords + payload * 4 + 64)
    call addwork(candidaterecords,(candidateframes + 1) * 2)
    call addwork(records,64)
    /* The retained-caller composition rereads unchanged records and their
     * source projections. Reserve it in the same final-check envelope. */
    call addwork(records + candidaterecords + operands + 1,payload * 12 + 160)
    call addbytes(candidaterecords * 3 + records * 3 + 32,64)
    call addbytes(operands,payload * 2 + 224)
    call addbytes(1,512)
    call addbytes(records + candidaterecords + 1,payload * 4 + 128)
    return
  product: method = .int
