/* cREXX License (MIT). Checked target transport cleanup; independent of expansion. */
options levelb
namespace llcleanup expose transport storage
import rxfnsb
import llir
import llirgraph
import lltarget
import lltargetfacts
import llinline
import llrxascatalog
import llrxas

/** A typed immutable rewrite row; arrays themselves are never boxed. */
plan: class
  _fields = .object[]
  _mnemonic = .string
  _window = .int[]
  _windowbase = .int
  *: factory
    arg fields = .object[], mnemonic = '', ?window = .int[], windowbase = -1
    _fields = fields; _mnemonic = mnemonic
    if ?window then _window = window
    _windowbase = windowbase
    return
  operand: method = .lltarget..operand
    arg ordinal = .int
    return _fields[ordinal] as .lltarget..operand
  operands: method = .int
    return _fields[0]
  mnemonic: method = .string
    return _mnemonic
  windowcells: method = .int
    return _window[0]
  windowbase: method = .int
    return _windowbase
  windowstorage: method = .int
    arg ordinal = .int
    return _window[ordinal]
  fields: method = .object[]
    arg body = .lltarget..bodydraft
    values = .object[]; value = .lltarget..operand
    do i = 1 to _fields[0]
      value = _fields[i] as .lltarget..operand
      if value.kind() = 'R' then value = body.reg(value.bank(),value.index())
      values[i] = value as .object
    end
    return values

/** Locate the actual storage in the mapping being emitted. Equal values are
 * insufficient; prefer the original spelling when it still denotes it. */
location: procedure = .int
  arg mapping_ref = reference .int[], storage = .int, preferred = -1
  mapping = dereference mapping_ref
  if preferred >= 0 & preferred < mapping[0] then do
    if mapping[preferred + 1] = storage then return preferred
  end
  do i = 1 to mapping[0]
    if mapping[i] = storage then return i - 1
  end
  assembler signal "ERROR","LL_TARGET_TRANSPORT: required owned storage is unavailable"
  return -1

/** Binary LOAD can raise FAILURE even when its result is dead. Keep that
 * operation executable; other admitted NULL/LOAD forms retain their policy. */
deaddefinitioncandidate: procedure = .int
  arg item = .lltarget..record
  value = .lltarget..operand
  if item.mnemonic() = 'null' then return 1
  if item.mnemonic() <> 'load' then return 0
  value = item.operand(2)
  return value.kind() <> 'B'

/** Inclusive local scan costs for domainafter's remaining block suffix.
 * Return -2 for scratch bytes, -1 for work, or 1 after a complete setup.
 * Operation IDs are module-wide, so preflight their full array extent. */
querycosts: procedure = .int
  arg index_ref = reference .llirgraph..index, access_ref = reference .llirgraph..access, functionId = .int, expose work = .int, expose plannedbytes = .int, bytes = .int, expose prefixes = .int[], expose blocktotals = .int[]
  i = .int; op = .int; b = .int; amount = .int; operations = .int; blocks = .int
  graph = dereference index_ref; access = dereference access_ref
  operations = graph.operations(); blocks = graph.blocks()
  if plannedbytes > bytes | bytes - plannedbytes < 64 then return -2
  plannedbytes = plannedbytes + 64
  if operations > (bytes - plannedbytes) / 8 then return -2
  plannedbytes = plannedbytes + operations * 8
  if blocks > (bytes - plannedbytes) / 8 then return -2
  plannedbytes = plannedbytes + blocks * 8
  if operations > work then return -1
  work = work - operations
  if blocks > work then return -1
  work = work - blocks
  assembler setattrs prefixes,0
  assembler setattrs blocktotals,0
  if operations > 0 then prefixes[operations] = 0
  if blocks > 0 then blocktotals[blocks] = 0
  do i = 1 to graph.functionoperations(functionId)
    op = graph.functionoperation(functionId,i); amount = access.accesses(op)
    if amount >= work then return -1
    amount = amount + 1; work = work - amount; b = graph.opblock(op)
    blocktotals[b] = blocktotals[b] + amount; prefixes[op] = blocktotals[b]
  end
  return 1

/** The current cleanup plans walk source order, not mutually exclusive paths.
 * Return -1 for exhaustion, 2 for incomplete/observed tails, 1 for branches,
 * or 0 for linear. The graph path establishes its own semantic proof.
 * The target owner derives completeness; the catalogue owns flow classes. */
cfgpending: procedure = .int
  arg owner = reference .lltarget..module, procedureId = .int, expose work = .int
  item = .lltarget..record; i = .int; flow = .int
  source = dereference owner
  if work < 2 then return -1
  work = work - 2
  if source.normalcfgcomplete(procedureId) = 0 then return 2
  if source.endobservations(procedureId) then return 2
  catalog = .llrxascatalog..catalog()
  do i = 1 to source.records()
    if work < 4 then return -1
    work = work - 4
    item = source.record(i)
    if item.procedureid() <> procedureId | item.kind() <> 'instruction' then iterate
    flow = catalog.flow(item.opcode())
    if flow = 1 | flow = 2 then return 1
  end
  return 0

transport: procedure = .llinline..change
  arg owner = reference .lltarget..module, procedureId = .int, profile = 'unknown', work = 1000000, entries = 1000000, bytes = 67108864, frame = 65536, cells = 1000000
  i = .int; j = .int; id = .int; ignored = .int; highest = .int; usedcells = .int
  k = .int; a = .int; b = .int; physical = .int; temporary = .int; locals = .int; cost = .int; extent = .int
  integer = .int; whole = .int; observed = .int; discard = .int; keptmapping = .int; ordinal = .int
  plannedbytes = .int; querybound = .int; pending = .int
  prefixes = .int[]; blocktotals = .int[]
  fields = .object[]; replacements = .object[]
  value = .lltarget..operand; left = .lltarget..operand; right = .lltarget..operand
  field = .lltarget..operand; replacement = .lltarget..operand; number = .lltarget..operand
  planned = .plan
  input = .lltarget..record; targetbody = .lltarget..bodydraft
  sources = .object[]; origins = .object[]; maps = .int[]; callers = .int[]; empty = .int[]
  if <refvalid>(owner) = 0 then return .llinline..change('invalid','owner.expired')
  source = dereference owner
  if source.valid() = 0 then return .llinline..change('invalid',source.error(),source,empty)
  if source.globals() > 0 then return .llinline..change('keep','transport.global.storage.pending',source,empty)
  do
    pending = cfgpending(owner,procedureId,work)
    if pending < 0 then return .llinline..change('limit','transport.cfg.work',source,empty)
    if pending = 2 then return .llinline..change('keep','transport.cfg.pending',source,empty)
    if pending = 1 then return graphtransport(owner,procedureId,profile,work,entries,bytes,frame,cells)
    facts = lltargetfacts..analyse(owner,procedureId,profile,work,bytes)
    if facts.status() <> 'ok' then return .llinline..change(facts.status(),facts.reason(),source,empty)
    work = facts.remaining()
    /* A linear caller can also need the graph owner's fresh counted window.
     * Dispatch only a reached exact >4 ordinary CALL, charging this scan and
     * both analyses; the graph path establishes its own restoration proof. */
    do i = 1 to facts.calls()
      if work < 8 then return .llinline..change('limit','transport.work',source,empty)
      work = work - 8; id = facts.callid(i); input = source.at(id)
      if facts.bodyid(id) > 0 & input.mnemonic() = 'call' & input.operands() = 3 & facts.arguments(id) > 4 then return graphtransport(owner,procedureId,profile,work,entries,bytes,frame,cells)
    end
    graph_ref = facts.index(); index = dereference graph_ref; access_ref = facts.access()
    live = index.accessliveness(access_ref,work,bytes)
    if live.status() <> 'ok' then return .llinline..change(live.status(),live.message(),source,empty)
    if live.complete(procedureId) = 0 then return .llinline..change('keep','transport.observation.unproved',source,empty)
    work = work - live.usedwork()
    source_graph = source.ir(); source_ir = dereference source_graph; source_store = dereference source_ir.storage()
    plannedbytes = source_store.bytes()
    pending = querycosts(graph_ref,access_ref,procedureId,work,plannedbytes,bytes,prefixes,blocktotals)
    if pending = -2 then return .llinline..change('limit','transport.plan.bytes',source,empty)
    if pending < 0 then return .llinline..change('limit','transport.work',source,empty)
    caller = source.body(procedureId); mapping = .int[]
    if caller.locals() > work then return .llinline..change('limit','transport.work',source,empty)
    work = work - caller.locals()
    do i = 1 to caller.locals(); mapping[i] = i; end
    plans = .object[]; removed = .int[]; changed = 0; highest = -1
    catalog = .llrxascatalog..catalog()
    do i = 1 to source.records()
      input = source.record(i)
      if input.procedureid() <> procedureId | input.kind() = 'procedure' then iterate
      work = work - 1 - input.registerrefs()
      if work < 0 then return .llinline..change('limit','transport.work',source,empty)
      discard = 0; keptmapping = 0
      if facts.mapping(input.id()) then do
        if facts.blocked(input.id()) = 0 then discard = 1
        else keptmapping = 1
      end
      if input.kind() = 'instruction' & discard = 0 then do
        name = input.mnemonic()
        if name = 'endlife' then do
          id = facts.storage(input.id(),1)
          if facts.plainbefore(input.id(),1) then discard = 1
        end
        else if deaddefinitioncandidate(input) then do
          id = facts.storage(input.id(),1); integer = facts.integerdomain(id); whole = facts.wholedomain(id)
          observed = 0; querybound = blocktotals[index.opblock(input.id())] - prefixes[input.id()]
          if integer > 0 then do
            if querybound > work then return .llinline..change('limit','transport.work',source,empty)
            work = work - querybound; observed = live.domainafter(input.id(),integer)
          end
          if whole > 0 then do
            if querybound > work then return .llinline..change('limit','transport.work',source,empty)
            work = work - querybound; observed = observed | live.domainafter(input.id(),whole)
          end
          if observed = 0 & facts.plainbefore(input.id(),1) then discard = 1
        end
        else if input.operands() = 2 & catalog.samecopyisnoop(input.opcode()) then do
          if facts.storage(input.id(),1) = facts.storage(input.id(),2) then discard = 1
        end
      end
      if discard then do; removed[input.id()] = 1; changed = 1; iterate; end
      call objectarraydrop replacements
      do j = 1 to input.registerrefs()
        value = input.registerref(j)
        if value.bank() <> 'r' then return .llinline..change('keep','transport.external.storage.unproved',source,empty)
        if keptmapping then physical = value.index()
        else if input.kind() = 'instruction' & input.mnemonic() = 'call' & input.operands() = 3 then physical = value.index()
        else physical = location(reference mapping,facts.storage(input.id(),j),value.index())
        replacements[j] = .lltarget..operand.bound(0,0,0,'r',physical) as .object
        highest = max(highest,physical)
        if physical <> value.index() then changed = 1
      end
      if input.operands() > (bytes - plannedbytes) / 64 then return .llinline..change('limit','transport.plan.bytes',source,empty)
      plannedbytes = plannedbytes + input.operands() * 64
      fields = lltarget..remapregisters(input,replacements); plans[input.id()] = .plan(fields) as .object
      if keptmapping then do
        left = input.operand(1); a = left.index() + 1
        if input.mnemonic() = 'unlink' then mapping[a] = a
        else do
          right = input.operand(2); b = right.index() + 1
          if input.mnemonic() = 'link' then mapping[a] = mapping[b]
          else do; temporary = mapping[a]; mapping[a] = mapping[b]; mapping[b] = temporary; end
        end
      end
      /* A retained counted call observes every physical slot of its implicit
       * window, not only the counter/result operands. The adapter pins the
       * surrounding permutation and we verify that exact storage projection. */
      if input.kind() = 'instruction' & input.mnemonic() = 'call' & input.operands() = 3 then do
        do j = 1 to facts.arguments(input.id())
          physical = facts.argument(input.id(),j)
          if mapping[physical + 1] <> facts.argumentstorage(input.id(),j) then return .llinline..change('keep','transport.retained.window.binding.unproved',source,empty)
          highest = max(highest,physical)
        end
      end
    end
    locals = highest + 1
    if locals <> caller.locals() then changed = 1
    if changed = 0 then return .llinline..change('keep','transport.no.change',source,empty)
    if locals > frame then return .llinline..change('limit','transport.frame',source,empty)
    result = .lltarget..draft(source.name(),source.artifact(),source.globals(),entries,bytes,work)
    bodies = .object[]; source_graph = source.ir()
    do i = 1 to source.records()
      input = source.record(i)
      at = llinline..copyorigin(source_graph,input.origin(),reference result,reference sources,reference origins)
      if input.kind() = 'procedure' then do
        oldbody = source.body(input.procedureid()); extent = oldbody.locals()
        if input.procedureid() = procedureId then extent = locals
        targetbody = result.procedure(oldbody.name(),extent,at,oldbody.expose())
        bodies[input.procedureid()] = targetbody as .object; maps[input.id()] = targetbody.headerid()
        if input.procedureid() = procedureId then callers[1] = targetbody.functionid()
        iterate
      end
      if removed[input.id()] then do; maps[input.id()] = 0; iterate; end
      if input.procedureid() = 0 then do
        call objectarraydrop fields
        do j = 1 to input.operands(); fields[j] = input.operand(j) as .object; end
        maps[input.id()] = result.record(input.kind(),fields,at); iterate
      end
      targetbody = bodies[input.procedureid()] as .lltarget..bodydraft
      if input.procedureid() = procedureId then do
        planned = plans[input.id()] as .plan; call objectarraydrop replacements
        do j = 1 to input.registerrefs()
          value = input.registerref(j)
          /* The plan's typed fields include TRACE pairs. Re-enumerate their
           * selected indices without inventing a raw metadata text parser. */
          replacement = input.registerref(j)
          if input.kind() = '.traceevent' then do; number = planned.operand(6); physical = number.index(); end
          else do
            ordinal = 0
            do k = 1 to input.operands()
              field = input.operand(k)
              if field.kind() <> 'R' then iterate
              ordinal = ordinal + 1
              if ordinal = j then do; field = planned.operand(k); physical = field.index(); end
            end
          end
          replacements[j] = targetbody.reg('r',physical) as .object
        end
        fields = lltarget..remapregisters(input,replacements)
      end
      else fields = llinline..clonefields(input,targetbody)
      if input.kind() = 'instruction' then do
        cost = 1 + fields[0]
        if cost > cells - usedcells then return .llinline..change('limit','transport.code.cells',source,empty)
        usedcells = usedcells + cost; maps[input.id()] = targetbody.emit(input.mnemonic(),fields,at)
      end
      else maps[input.id()] = targetbody.record(input.kind(),fields,at)
    end
    target = result.finish()
    if target.valid() = 0 then return .llinline..change('invalid',target.error(),source,empty)
    return .llinline..change('changed','transport.storage.permutation',target,maps,callers)
  on signal as problem
    status = 'invalid'
    if pos('LL_RESOURCE_LIMIT',problem.message()) > 0 then status = 'limit'
    return .llinline..change(status,'LL_TARGET_TRANSPORT: ' || problem.name() || ': ' || problem.message(),source,empty)
  end
  return .llinline..change('invalid','transport.no.result',source,empty)

/** The acyclic path uses incoming StorageIds, never a lexical simulation of
 * runtime bindings. Plans and address groups borrow one frozen source epoch. */
graphtransport: procedure = .llinline..change
  arg owner = reference .lltarget..module, procedureId = .int, profile = .string, work = .int, entries = .int, bytes = .int, frame = .int, cells = .int
  i = .int; j = .int; id = .int; group = .int; nextmachine = .int; nextkept = .int
  highest = .int; physical = .int; integer = .int; whole = .int; observed = .int; discard = .int
  querybound = .int; plannedbytes = .int; width = .int; targetgroup = .int; choice = .int; changed = .int; oldlocals = .int
  fixedcount = .int; windowcount = .int; resultstorage = .int; actuals = .int[]; window = .int[]
  pending = .int; prefixes = .int[]; blocktotals = .int[]
  input = .lltarget..record; value = .lltarget..operand; field = .lltarget..operand
  row = .plan; fields = .object[]; replacements = .object[]; plans = .object[]
  groups = .int[]; protected = .int[]; removed = .int[]; arrivals = .int[]
  labelnames = .string[]; labelgroups = .int[]; empty = .int[]
  name = .string; targetname = .string; status = .string
  source = dereference owner
  do
    facts = lltargetfacts..analysegraph(owner,procedureId,profile,work,bytes)
    if facts.status() <> 'ok' then return .llinline..change(facts.status(),facts.reason(),source,empty)
    if facts.rootrestored() = 0 then return .llinline..change('keep','transport.cfg.restoration.unproved',source,empty)
    caller = source.body(procedureId); oldlocals = caller.locals(); catalog = .llrxascatalog..catalog()
    index_ref = facts.index(); index = dereference index_ref; access_ref = facts.access()
    live = index.accessliveness(access_ref,facts.remaining(),bytes)
    if live.status() <> 'ok' then return .llinline..change(live.status(),live.message(),source,empty)
    if live.complete(procedureId) = 0 then return .llinline..change('keep','transport.observation.unproved',source,empty)
    work = facts.remaining() - live.usedwork()
    graph_ref = source.ir(); graph = dereference graph_ref; store = dereference graph.storage()
    plannedbytes = store.bytes()
    if index.operations() > (bytes - plannedbytes) / 64 then return .llinline..change('limit','transport.plan.bytes',source,empty)
    plannedbytes = plannedbytes + index.operations() * 64
    pending = querycosts(index_ref,access_ref,procedureId,work,plannedbytes,bytes,prefixes,blocktotals)
    if pending = -2 then return .llinline..change('limit','transport.plan.bytes',source,empty)
    if pending < 0 then return .llinline..change('limit','transport.work',source,empty)
    /* One reverse indexed pass binds zero-width point records and labels to
     * their source machine group. No repeated addressid() suffix scans. */
    nextmachine = 0
    do i = source.records() to 1 by -1
      if work < 4 then return .llinline..change('limit','transport.address.work',source,empty)
      work = work - 4; input = source.record(i)
      if input.procedureid() <> procedureId | input.kind() = 'procedure' then iterate
      if input.kind() = 'instruction' then nextmachine = input.id()
      groups[input.id()] = nextmachine
      if nextmachine > 0 & wordpos(input.kind(),'.srcstep .traceevent') > 0 then protected[nextmachine] = 1
      if input.kind() = 'label' then do
        value = input.operand(1); width = value.length()
        if width + 1 > work then return .llinline..change('limit','transport.address.work',source,empty)
        if width > bytes - plannedbytes then return .llinline..change('limit','transport.plan.bytes',source,empty)
        work = work - width - 1; plannedbytes = plannedbytes + width
        j = labelnames[0] + 1; labelnames[j] = value.text(); labelgroups[j] = nextmachine
      end
    end
    changed = 0
    do i = 1 to source.records()
      if work < 1 then return .llinline..change('limit','transport.work',source,empty)
      work = work - 1; input = source.record(i)
      if input.procedureid() <> procedureId | input.kind() = 'procedure' then iterate
      group = groups[input.id()]
      if input.kind() = 'instruction' then do
        if facts.rootlive(input.id()) = 0 then do; removed[input.id()] = 1; changed = 1; iterate; end
      end
      else if wordpos(input.kind(),'.srcstep .traceevent') > 0 & group > 0 then do
        if facts.rootlive(group) = 0 then do; removed[input.id()] = 1; changed = 1; iterate; end
      end
      discard = 0; name = ''; fixedcount = 0; windowcount = 0
      assembler setattrs actuals,0
      assembler setattrs window,0
      if input.kind() = 'instruction' then do
        name = input.mnemonic()
        /* The exact root facts captured the count, result pointer and ordered
         * actual pointers before the call. Explicit fixed operands preserve
         * aliases without needing an adjacent physical argument window. */
        if name = 'call' & input.operands() = 3 then do
          if facts.bodyid(input.id()) > 0 then do
            fixedcount = facts.arguments(input.id())
            if fixedcount < 1 then fixedcount = 0
            if fixedcount > 0 then do
              value = input.operand(2)
              if value.kind() <> 'P' then return .llinline..change('keep','transport.implicit.storage.pending',source,empty)
              resultstorage = facts.storage(input.id(),1)
              if resultstorage < 1 | resultstorage > oldlocals then return .llinline..change('keep','transport.external.storage.unproved',source,empty)
              if fixedcount > work then return .llinline..change('limit','transport.work',source,empty)
              if fixedcount > (bytes - plannedbytes) / 8 then return .llinline..change('limit','transport.plan.bytes',source,empty)
              work = work - fixedcount; plannedbytes = plannedbytes + fixedcount * 8
              do j = 1 to fixedcount
                id = facts.argumentstorage(input.id(),j)
                if id < 1 | id > oldlocals then return .llinline..change('keep','transport.external.storage.unproved',source,empty)
                actuals[j] = id
              end
              if fixedcount > 4 then do
                windowcount = fixedcount; fixedcount = 0
                /* The fresh physical window cannot overwrite a source of a
                 * later LINK, even when result/count/actual storage aliases. */
                if oldlocals > frame | windowcount >= frame - oldlocals then return .llinline..change('limit','transport.frame',source,empty)
                if windowcount + 1 > work then return .llinline..change('limit','transport.work',source,empty)
                if windowcount + 1 > (bytes - plannedbytes) / 16 then return .llinline..change('limit','transport.plan.bytes',source,empty)
                work = work - windowcount - 1; plannedbytes = plannedbytes + (windowcount + 1) * 16
                id = facts.storage(input.id(),2)
                if id < 1 | id > oldlocals then return .llinline..change('keep','transport.external.storage.unproved',source,empty)
                window[1] = id
                do j = 1 to windowcount; window[j + 1] = actuals[j]; end
              end
            end
          end
        end
        /* Implicit encoded/indexed locations need their own remapping proof;
         * checked finite CALLs become explicit or get a fresh linked window. */
        if (catalog.field(input.opcode(),5) as .int) <> 0 & fixedcount = 0 & windowcount = 0 then return .llinline..change('keep','transport.implicit.storage.pending',source,empty)
        if facts.mapping(input.id()) then discard = 1
        else if name = 'endlife' then discard = facts.plainbefore(input.id(),1)
        else if deaddefinitioncandidate(input) then do
          id = facts.storage(input.id(),1); integer = facts.integerdomain(id); whole = facts.wholedomain(id); observed = 0
          querybound = blocktotals[index.opblock(input.id())] - prefixes[input.id()]
          if integer > 0 then do
            if querybound > work then return .llinline..change('limit','transport.work',source,empty)
            work = work - querybound; observed = live.domainafter(input.id(),integer)
          end
          if whole > 0 then do
            if querybound > work then return .llinline..change('limit','transport.work',source,empty)
            work = work - querybound; observed = observed | live.domainafter(input.id(),whole)
          end
          if observed = 0 & facts.plainbefore(input.id(),1) then discard = 1
        end
        else if input.operands() = 2 then do
          if catalog.samecopyisnoop(input.opcode()) then discard = facts.storage(input.id(),1) = facts.storage(input.id(),2)
        end
      end
      call objectarraydrop fields
      if discard then do
        changed = 1
        if protected[input.id()] = 0 then do; removed[input.id()] = 1; iterate; end
        /* A removed state operation with point observations retains its
         * executable address. Lexical META closure carriers also survive. */
        plans[input.id()] = .plan(fields,'cnop') as .object
        iterate
      end
      call objectarraydrop replacements
      if input.registerrefs() > work then return .llinline..change('limit','transport.work',source,empty)
      work = work - input.registerrefs()
      do j = 1 to input.registerrefs()
        value = input.registerref(j)
        if value.bank() <> 'r' then return .llinline..change('keep','transport.external.storage.unproved',source,empty)
        id = graphstorage(reference facts,input,j)
        if id < 1 | id > oldlocals then return .llinline..change('keep','transport.external.storage.unproved',source,empty)
        physical = id - 1
        replacements[j] = .lltarget..operand.bound(0,0,0,'r',physical) as .object
        if physical <> value.index() then changed = 1
      end
      width = input.operands()
      if fixedcount > 0 then width = fixedcount + 2
      if width > (bytes - plannedbytes) / 64 then return .llinline..change('limit','transport.plan.bytes',source,empty)
      plannedbytes = plannedbytes + width * 64
      if width > work then return .llinline..change('limit','transport.work',source,empty)
      work = work - width
      do j = 1 to input.operands()
        field = input.operand(j)
        /* Include materialization and retained value copies, without relying
         * on a VM copy-on-write implementation for operand payloads. */
        if field.length() > work / 3 then return .llinline..change('limit','transport.work',source,empty)
        if field.length() > (bytes - plannedbytes) / 3 then return .llinline..change('limit','transport.plan.bytes',source,empty)
        work = work - field.length() * 3; plannedbytes = plannedbytes + field.length() * 3
      end
      if fixedcount > 0 then do
        call objectarraydrop fields
        fields[1] = .lltarget..operand.bound(0,0,0,'r',resultstorage - 1) as .object
        fields[2] = input.operand(2) as .object
        do j = 1 to fixedcount
          fields[j + 2] = .lltarget..operand.bound(0,0,0,'r',actuals[j] - 1) as .object
        end
        name = 'call' || fixedcount; changed = 1
      end
      else if windowcount > 0 then do
        fields[1] = .lltarget..operand.bound(0,0,0,'r',resultstorage - 1) as .object
        fields[2] = input.operand(2) as .object
        fields[3] = .lltarget..operand.bound(0,0,0,'r',oldlocals) as .object
        changed = 1
      end
      else fields = lltarget..remapregisters(input,replacements)
      if input.kind() = 'instruction' then do
        if catalog.flow(input.opcode()) = 2 then do
          choice = facts.rootbranchchoice(input.id())
          if choice > 0 then do
            changed = 1
            if name = 'brtf' | choice = 1 then do
              value = input.operand(choice); call objectarraydrop fields
              fields[1] = value as .object; name = 'br'
            end
            else do
              if protected[input.id()] = 0 then do; removed[input.id()] = 1; iterate; end
              call objectarraydrop fields; name = 'cnop'
            end
          end
        end
      end
      plans[input.id()] = .plan(fields,name,window,oldlocals) as .object
    end
    /* Thread only a branch to the immediately following effective address.
     * Earlier-arm exits remain branches over the other lexical arms. */
    nextkept = 0; highest = -1
    do i = source.records() to 1 by -1
      if work < 1 then return .llinline..change('limit','transport.work',source,empty)
      work = work - 1; input = source.record(i)
      if input.procedureid() <> procedureId | input.kind() = 'procedure' then iterate
      if removed[input.id()] then do
        if input.kind() = 'instruction' then arrivals[input.id()] = nextkept
        iterate
      end
      row = plans[input.id()] as .plan
      if row.windowcells() > 0 then highest = max(highest,row.windowbase() + row.windowcells() - 1)
      if row.mnemonic() = 'br' & protected[input.id()] = 0 then do
        value = row.operand(1); targetname = value.text(); targetgroup = 0
        do j = 1 to labelnames[0]
          width = 1 + length(targetname) + length(labelnames[j])
          if width > work then return .llinline..change('limit','transport.address.work',source,empty)
          work = work - width
          if labelnames[j] == targetname then targetgroup = labelgroups[j]
        end
        if targetgroup > 0 then do
          /* Forward source groups are already indexed by this reverse pass.
           * An unresolved backward group cannot be the lexical fallthrough. */
          if arrivals[targetgroup] > 0 & arrivals[targetgroup] = nextkept then do
            removed[input.id()] = 1; arrivals[input.id()] = nextkept; changed = 1; iterate
          end
        end
      end
      if input.kind() = 'instruction' then do; nextkept = input.id(); arrivals[input.id()] = nextkept; end
      do j = 1 to row.operands()
        value = row.operand(j)
        if value.kind() = 'R' then highest = max(highest,value.index())
      end
      if input.kind() = '.traceevent' & input.registerrefs() > 0 then do
        value = row.operand(6); highest = max(highest,value.index())
      end
    end
    if highest + 1 <> oldlocals then changed = 1
    if changed = 0 then return .llinline..change('keep','transport.no.change',source,empty)
    if highest + 1 > frame then return .llinline..change('limit','transport.frame',source,empty)
    return graphemit(source,procedureId,reference plans,reference removed,reference groups,highest + 1,work,entries,bytes,cells)
  on signal as problem
    status = 'invalid'
    if pos('LL_RESOURCE_LIMIT',problem.message()) > 0 then status = 'limit'
    return .llinline..change(status,'LL_TARGET_TRANSPORT: ' || problem.name() || ': ' || problem.message(),source,empty)
  end
  return .llinline..change('invalid','transport.no.result',source,empty)

/** Scoped metadata can describe a live lexical interval even when its own
 * declaration block is unreachable. The facts owner seals that interval. */
graphstorage: procedure = .int
  arg facts_ref = reference .lltargetfacts..analysis, item = .lltarget..record, ordinal = .int
  facts = dereference facts_ref; id = .int; value = .lltarget..operand
  if item.kind() = '.meta' & item.operands() = 4 then do
    id = facts.scopestorage(item.id())
    if id > 0 then return id
  end
  if facts.rootlive(item.id()) then return facts.storage(item.id(),ordinal)
  value = item.registerref(ordinal)
  return value.index() + 1

/** Publish a complete graph plan through the same checked target builders. */
graphemit: procedure = .llinline..change
  arg source = .lltarget..module, procedureId = .int, plans_ref = reference .object[], removed_ref = reference .int[], groups_ref = reference .int[], locals = .int, work = .int, entries = .int, bytes = .int, cells = .int
  plans = dereference plans_ref; removed = dereference removed_ref; groups = dereference groups_ref
  sources = .object[]; origins = .object[]; bodies = .object[]; fields = .object[]; windowfields = .object[]
  maps = .int[]; callers = .int[]; empty = .int[]; pending = .int[]; row = .plan; pointrow = .plan
  input = .lltarget..record; point = .lltarget..record; targetbody = .lltarget..bodydraft
  i = .int; j = .int; extent = .int; usedcells = .int; cost = .int; width = .int; refs = .int; windowcells = .int; status = .string
  ignored = .int; pointat = .llir..origin
  message = .string
  result = .lltarget..draft(source.name(),source.artifact(),source.globals(),entries,bytes,work)
  if result.error() <> '' then do
    status = 'invalid'; if pos('LL_RESOURCE_LIMIT',result.error()) > 0 then status = 'limit'
    return .llinline..change(status,result.error(),source,empty)
  end
  do
  source_graph = source.ir()
  do i = 1 to source.records()
    input = source.record(i)
    if removed[input.id()] = 0 & input.procedureid() = procedureId & wordpos(input.kind(),'.srcstep .traceevent') > 0 then do
      if groups[input.id()] > 0 then do
        row = plans[groups[input.id()]] as .plan
        if row.windowcells() > 0 then do
          /* Labels retain entry before setup; point observations are emitted
           * after the non-signalling LINKs, immediately before their CALL. */
          if work < 1 then return .llinline..change('limit','transport.address.work',source,empty)
          work = work - 1; pending[pending[0] + 1] = input.id()
          iterate
        end
      end
    end
    width = input.operands(); refs = input.registerrefs()
    if removed[input.id()] = 0 & input.procedureid() = procedureId & input.kind() <> 'procedure' then do
      row = plans[input.id()] as .plan
      /* Only the finite CALL specialization grows a graph row. Its added
       * fields are explicit registers, so each adds an operand and a ref. */
      if row.operands() > width then do
        refs = refs + row.operands() - width; width = row.operands()
      end
    end
    if result.preflight(1 + width + refs,0) = 0 then return .llinline..change('limit',result.error(),source,empty)
    if removed[input.id()] then do; maps[input.id()] = 0; iterate; end
    at = llinline..copyorigin(source_graph,input.origin(),reference result,reference sources,reference origins)
    if result.error() <> '' then do
      status = 'invalid'; if pos('LL_RESOURCE_LIMIT',result.error()) > 0 then status = 'limit'
      return .llinline..change(status,result.error(),source,empty)
    end
    if input.kind() = 'procedure' then do
      oldbody = source.body(input.procedureid()); extent = oldbody.locals()
      if input.procedureid() = procedureId then extent = locals
      targetbody = result.procedure(oldbody.name(),extent,at,oldbody.expose())
      if result.error() <> '' then do
        status = 'invalid'; if pos('LL_RESOURCE_LIMIT',result.error()) > 0 then status = 'limit'
        return .llinline..change(status,result.error(),source,empty)
      end
      bodies[input.procedureid()] = targetbody as .object; maps[input.id()] = targetbody.headerid()
      if input.procedureid() = procedureId then callers[1] = targetbody.functionid()
      iterate
    end
    if input.procedureid() = 0 then do
      call objectarraydrop fields
      do j = 1 to input.operands(); fields[j] = input.operand(j) as .object; end
      maps[input.id()] = result.record(input.kind(),fields,at)
      if result.error() <> '' then do
        status = 'invalid'; if pos('LL_RESOURCE_LIMIT',result.error()) > 0 then status = 'limit'
        return .llinline..change(status,result.error(),source,empty)
      end
      iterate
    end
    targetbody = bodies[input.procedureid()] as .lltarget..bodydraft
    if input.procedureid() = procedureId then do; row = plans[input.id()] as .plan; fields = row.fields(targetbody); end
    else fields = llinline..clonefields(input,targetbody)
    if result.error() <> '' then do
      status = 'invalid'; if pos('LL_RESOURCE_LIMIT',result.error()) > 0 then status = 'limit'
      return .llinline..change(status,result.error(),source,empty)
    end
    if input.kind() = 'instruction' then do
      windowcells = 0
      if input.procedureid() = procedureId then windowcells = row.windowcells()
      do j = 1 to windowcells
        if result.preflight(5,0) = 0 then return .llinline..change('limit',result.error(),source,empty)
        if 3 > cells - usedcells then return .llinline..change('limit','transport.code.cells',source,empty)
        usedcells = usedcells + 3
        windowfields[1] = targetbody.reg('r',row.windowbase() + j - 1) as .object
        windowfields[2] = targetbody.reg('r',row.windowstorage(j) - 1) as .object
        ignored = targetbody.emit('link',windowfields,at)
        if result.error() <> '' then return graphfailure(result.error(),source)
      end
      do j = 1 to pending[0]
        point = source.at(pending[j]); pointrow = plans[point.id()] as .plan
        if result.preflight(1 + point.operands() + point.registerrefs(),0) = 0 then return .llinline..change('limit',result.error(),source,empty)
        pointat = llinline..copyorigin(source_graph,point.origin(),reference result,reference sources,reference origins)
        if result.error() <> '' then return graphfailure(result.error(),source)
        maps[point.id()] = targetbody.record(point.kind(),pointrow.fields(targetbody),pointat)
        if result.error() <> '' then return graphfailure(result.error(),source)
      end
      assembler setattrs pending,0
      cost = 1 + fields[0]
      if cost > cells - usedcells then return .llinline..change('limit','transport.code.cells',source,empty)
      usedcells = usedcells + cost
      if input.procedureid() = procedureId then maps[input.id()] = targetbody.emit(row.mnemonic(),fields,at)
      else maps[input.id()] = targetbody.emit(input.mnemonic(),fields,at)
      if result.error() <> '' then return graphfailure(result.error(),source)
      /* Borrowed values and untouched scratch bases have no lifetime writes.
       * Restore every fresh binding before the original normal successor. */
      do j = windowcells to 1 by -1
        if result.preflight(3,0) = 0 then return .llinline..change('limit',result.error(),source,empty)
        if 2 > cells - usedcells then return .llinline..change('limit','transport.code.cells',source,empty)
        usedcells = usedcells + 2
        call objectarraydrop windowfields
        windowfields[1] = targetbody.reg('r',row.windowbase() + j - 1) as .object
        ignored = targetbody.emit('unlink',windowfields,at)
        if result.error() <> '' then return graphfailure(result.error(),source)
      end
    end
    else maps[input.id()] = targetbody.record(input.kind(),fields,at)
    if result.error() <> '' then do
      status = 'invalid'; if pos('LL_RESOURCE_LIMIT',result.error()) > 0 then status = 'limit'
      return .llinline..change(status,result.error(),source,empty)
    end
  end
  target = result.finish()
  if target.valid() = 0 then do
    status = 'invalid'; if pos('LL_RESOURCE_LIMIT',target.error()) > 0 then status = 'limit'
    return .llinline..change(status,target.error(),source,empty)
  end
  return .llinline..change('changed','transport.cfg.storage',target,maps,callers)
  on signal as problem
    /* A nested builder can fail while creating its returned handle. Prefer
     * its stored diagnostic over the consequential invalid-handle signal. */
    message = result.error()
    if message = '' then message = problem.name() || ': ' || problem.message()
    status = 'invalid'; if pos('LL_RESOURCE_LIMIT',message) > 0 then status = 'limit'
    return .llinline..change(status,'LL_TARGET_TRANSPORT: ' || message,source,empty)
  end
  return .llinline..change('invalid','transport.no.result',source,empty)

/** Preserve the original owner for every failed added builder operation. */
graphfailure: procedure = .llinline..change
  arg message = .string, source = .lltarget..module
  empty = .int[]; status = 'invalid'
  if pos('LL_RESOURCE_LIMIT',message) > 0 then status = 'limit'
  return .llinline..change(status,message,source,empty)

/** Add one virtual cell to an ordered row set. The assignment owner accounts
 * the projection scan; the adapter reserves its five scratch vectors once. */
storageput: procedure = .void
  arg values_ref = reference .int[], virtual = .int, owner = .llrxas..assignment
  values = dereference values_ref
  do i = 1 to values[0]
    if owner.charge(1) = 0 then return
    if values[i] = virtual then return
  end
  if owner.charge(1) = 0 then return
  values[values[0] + 1] = virtual
  return

/** Project complete typed references to the shared assignment owner. Facts
 * prove machine state; this adapter supplies scope and physical-window uses. */
storage: procedure = .llinline..change
  arg owner = reference .lltarget..module, procedureId = .int, profile = 'unknown', work = 1000000, entries = 1000000, bytes = 67108864, frame = 65536, cells = 1000000
  source = .lltarget..module; body = .lltarget..body; item = .lltarget..record
  value = .lltarget..operand; name = .lltarget..operand; reference_value = .lltarget..operand
  facts = .lltargetfacts..analysis
  assignment = .llrxas..assignment; allocated = .llrxas..assignmentresult
  ids = .int[]; empty = .int[]; refs = .int[]; reads = .int[]; writes = .int[]; kills = .int[]; observations = .int[]
  mapping = .int[]; active = .int[]; aliases = .int[]; names = .string[]; namesizes = .int[]; resets = .object[]
  i = .int; j = .int; v = .int; id = .int; integer = .int; whole = .int
  read = .int; write = .int; kill = .int; observed = .int; implicit = .int; identity = .int; changed = .int
  scoped = .int; boundcall = .int; plainend = .int; idbytes = .int; querycost = .int; pending = .int; graphmode = .int
  if <refvalid>(owner) = 0 then return .llinline..change('invalid','owner.expired')
  source = dereference owner
  if source.valid() = 0 then return .llinline..change('invalid',source.error(),source,empty)
  if entries < 1 | bytes < 1 | work < 1 | frame < 0 | cells < 0 then return .llinline..change('limit','storage.allowances',source,empty)
  if source.globals() > 0 then return .llinline..change('keep','storage.global.storage.pending',source,empty)
  do
    pending = cfgpending(owner,procedureId,work)
    if pending < 0 then return .llinline..change('limit','storage.cfg.work',source,empty)
    if pending = 2 then return .llinline..change('keep','storage.cfg.pending',source,empty)
    graphmode = pending = 1
    if graphmode then facts = lltargetfacts..analysegraph(owner,procedureId,profile,work,bytes)
    else facts = lltargetfacts..analyse(owner,procedureId,profile,work,bytes)
    if facts.status() <> 'ok' then return .llinline..change(facts.status(),facts.reason(),source,empty)
    access = .llirgraph..access
    access_ref = facts.access()
    access = dereference access_ref
    body = source.body(procedureId)
    if access.complete(procedureId) = 0 then return .llinline..change('keep','storage.observation.unproved',source,empty)
    work = facts.remaining()
    if source.records() > work then return .llinline..change('limit','storage.projection',source,empty)
    work = work - source.records()
    do i = 1 to source.records()
      item = source.record(i)
      if item.procedureid() = procedureId & item.kind() <> 'procedure' then do
        if ids[0] >= bytes / 8 then return .llinline..change('limit','storage.projection.bytes',source,empty)
        ids[ids[0] + 1] = item.id()
      end
    end
    /* IDs are already owned adapter scratch. Their exact checked extent is
     * removed before the kernel can copy IDs or allocate its own cell rows. */
    idbytes = ids[0] * 8
    if idbytes >= bytes then return .llinline..change('limit','storage.projection.bytes',source,empty)
    assignment = .llrxas..assignment(body.locals(),reference ids,frame,work,bytes - idbytes)
    if assignment.reserve(body.locals(),48) = 0 then return .llinline..change('limit',assignment.error(),source,empty)
    do v = 0 to body.locals() - 1
      if assignment.charge(1) = 0 then return .llinline..change('limit',assignment.error(),source,empty)
      call assignment.retain(v,0)
      if graphmode = 0 then do
        if facts.reusecandidate(v) then call assignment.candidate(v)
      end
    end
    catalog = .llrxascatalog..catalog(); identity = 0
    do i = 1 to ids[0]
      item = source.at(ids[i]); refs = empty; reads = empty; writes = empty; kills = empty; observations = empty; scoped = 0
      if assignment.charge(1 + item.operands() + item.registerrefs()) = 0 then return .llinline..change('limit',assignment.error(),source,empty)
      /* A META_REG remains observable through its matching clear, rather
       * than becoming a single point use at its declaration address. */
      do j = 1 to active[0]
        if assignment.charge(1) = 0 then return .llinline..change('limit',assignment.error(),source,empty)
        if active[j] = 0 then iterate
        scoped = 1
        call storageput(reference refs,active[j] - 1,assignment)
        call storageput(reference observations,active[j] - 1,assignment)
      end
      /* Metadata names a live slot. With rebinding, conservatively observe
       * all reached alias bases as well; these are never scalar candidates. */
      if scoped then do j = 1 to aliases[0]
        call storageput(reference refs,aliases[j],assignment)
        call storageput(reference observations,aliases[j],assignment)
      end
      do j = 1 to item.registerrefs()
        value = item.registerref(j)
        if value.bank() <> 'r' then return .llinline..change('keep','storage.external.reference.unproved',source,empty)
        call storageput(reference refs,value.index(),assignment)
        if graphmode then id = graphstorage(reference facts,item,j)
        else id = facts.storage(item.id(),j)
        if id > 0 & id <= body.locals() then call storageput(reference refs,id - 1,assignment)
        if facts.mapping(item.id()) then do
          call storageput(reference aliases,value.index(),assignment)
          if id > 0 & id <= body.locals() then call storageput(reference aliases,id - 1,assignment)
          if scoped then do
            call storageput(reference observations,value.index(),assignment)
            if id > 0 & id <= body.locals() then call storageput(reference observations,id - 1,assignment)
          end
        end
      end
      if item.kind() = 'instruction' then do
        implicit = catalog.field(item.opcode(),5) as .int
        boundcall = 0
        if wordpos(item.mnemonic(),'call call1 call2 call3 call4') > 0 then boundcall = facts.bodyid(item.id()) > 0
        if implicit = 1 | implicit = 2 | implicit = 6 then identity = 1
        if catalog.unbounded(item.opcode()) & boundcall = 0 then identity = 1
        if implicit >= 3 & implicit <= 5 then do
          v = implicit - 3; call assignment.fixed(v); call storageput(reference refs,v,assignment)
        end
        if item.mnemonic() = 'call' & item.operands() = 3 then do
          value = item.operand(3); call assignment.window(value.index(),facts.arguments(item.id()) + 1)
          do j = 0 to facts.arguments(item.id())
            call storageput(reference refs,value.index() + j,assignment)
            if j > 0 then do
              id = facts.argumentstorage(item.id(),j)
              if id > 0 & id <= body.locals() then call storageput(reference refs,id - 1,assignment)
            end
          end
        end
        if facts.mapping(item.id()) | wordpos(item.mnemonic(),'call call1 call2 call3 call4 endlife') > 0 then do j = 1 to item.registerrefs()
          if assignment.charge(1) = 0 then return .llinline..change('limit',assignment.error(),source,empty)
          value = item.registerref(j); plainend = 0
          if graphmode then id = graphstorage(reference facts,item,j)
          else id = facts.storage(item.id(),j)
          if graphmode = 0 & item.mnemonic() = 'endlife' & id > 0 & id <= body.locals() then do
            plainend = facts.reusecandidate(value.index()) & facts.reusecandidate(id - 1)
          end
          if plainend = 0 then do
            call assignment.pin(value.index())
            if id > 0 & id <= body.locals() then call assignment.pin(id - 1)
          end
        end
      end
      do j = 1 to refs[0]
        /* Each predicate scans the access row. Check before adding or
         * multiplying so a large implicit window cannot evade the budget. */
        querycost = access.accesses(item.id())
        if querycost >= assignment.remaining() / 7 then return .llinline..change('limit','storage.access.work',source,empty)
        if assignment.charge((querycost + 1) * 7) = 0 then return .llinline..change('limit',assignment.error(),source,empty)
        v = refs[j]; id = v + 1; integer = facts.integerdomain(id); whole = facts.wholedomain(id)
        read = 0; write = 0; kill = 0; observed = 0
        if integer > 0 then do
          read = access.reads(item.id(),integer); write = access.writes(item.id(),integer)
          /* This is a successful scalar definition, not a whole-cell kill.
           * Only reusecandidate plus a checked reset proves fresh entry. */
          kill = access.kills(item.id(),integer); observed = access.observes(item.id(),integer)
        end
        if whole > 0 then do
          read = read | access.reads(item.id(),whole); write = write | access.writes(item.id(),whole)
          observed = observed | access.observes(item.id(),whole)
        end
        if read then call storageput(reference reads,v,assignment)
        if write then call storageput(reference writes,v,assignment)
        if kill then call storageput(reference kills,v,assignment)
        if observed then call storageput(reference observations,v,assignment)
      end
      if item.kind() = '.meta' then do
        name = item.operand(1)
        if assignment.charge(name.length()) = 0 | assignment.reserve(name.length(),1) = 0 then return .llinline..change('limit',assignment.error(),source,empty)
        spelling = name.text()
        if item.operands() = 1 then do j = 1 to names[0]
          if assignment.charge(1 + name.length() + namesizes[j]) = 0 then return .llinline..change('limit',assignment.error(),source,empty)
          if names[j] == spelling then active[j] = 0
        end
        else if item.operands() = 4 then do
          reference_value = item.operand(4)
          if reference_value.kind() = 'R' then do
            if assignment.reserve(1,32) = 0 then return .llinline..change('limit',assignment.error(),source,empty)
            j = names[0] + 1; names[j] = spelling; namesizes[j] = name.length(); active[j] = reference_value.index() + 1
          end
        end
      end
      call assignment.row(i,reference refs,reference reads,reference writes,reference kills,reference observations,item.origin().id())
      if assignment.error() <> '' then do
        status = 'invalid'
        if pos('LL_RXAS_LIMIT',assignment.error()) > 0 then status = 'limit'
        return .llinline..change(status,assignment.error(),source,empty)
      end
    end
    mode = 'reuse'
    if graphmode then mode = 'dense'
    if identity then mode = 'identity'
    allocated = assignment.finish(mode)
    if allocated.valid() = 0 then do
      status = 'invalid'
      if pos('LL_RXAS_LIMIT',allocated.error()) > 0 then status = 'limit'
      return .llinline..change(status,allocated.error(),source,empty)
    end
    if assignment.charge(body.locals()) = 0 | assignment.reserve(body.locals(),8) = 0 then return .llinline..change('limit',assignment.error(),source,empty)
    if assignment.charge(allocated.resets()) = 0 | assignment.reserve(allocated.resets(),8) = 0 then return .llinline..change('limit',assignment.error(),source,empty)
    do v = 0 to body.locals() - 1; mapping[v + 1] = allocated.assigned(v); end
    do i = 1 to allocated.resets(); resets[i] = allocated.reset(i) as .object; end
    message = assignment.validate(reference mapping,allocated.locals(),reference resets)
    if message <> '' then do
      status = 'invalid'
      if pos('LL_RXAS_LIMIT',message) > 0 then status = 'limit'
      return .llinline..change(status,message,source,empty)
    end
    changed = allocated.locals() <> body.locals() | resets[0] > 0
    if assignment.charge(body.locals()) = 0 then return .llinline..change('limit',assignment.error(),source,empty)
    do v = 0 to body.locals() - 1
      if mapping[v + 1] <> v then changed = 1
    end
    if changed = 0 then return .llinline..change('keep','storage.no.change',source,empty)
    if assignment.remaining() < 1 then return .llinline..change('limit','storage.output.work',source,empty)
    return storageemit(source,procedureId,reference mapping,allocated.locals(),reference resets,assignment.remaining(),entries,bytes,cells)
  on signal as problem
    status = 'invalid'
    if pos('LL_RESOURCE_LIMIT',problem.message()) > 0 | pos('LL_RXAS_LIMIT',problem.message()) > 0 then status = 'limit'
    return .llinline..change(status,'LL_TARGET_STORAGE: ' || problem.name() || ': ' || problem.message(),source,empty)
  end
  return .llinline..change('invalid','storage.no.result',source,empty)

/** Emit only a checked physical assignment. Original records and inserted
 * resets use the existing target/provenance owners; a failure returns source. */
storageemit: procedure = .llinline..change
  arg source = .lltarget..module, procedureId = .int, mapping_ref = reference .int[], locals = .int, resets_ref = reference .object[], work = .int, entries = .int, bytes = .int, cells = .int
  input = .lltarget..record; oldbody = .lltarget..body; targetbody = .lltarget..bodydraft
  value = .lltarget..operand; request = .llrxas..typedreset
  result = .lltarget..draft; target = .lltarget..module; at = .llir..origin; status = .string; message = .string
  fields = .object[]; replacements = .object[]; bodies = .object[]
  sources = .object[]; origins = .object[]; maps = .int[]; callers = .int[]; empty = .int[]
  i = .int; j = .int; extent = .int; cost = .int; usedcells = .int; nextreset = .int; ignored = .int
  mapping = dereference mapping_ref; resets = dereference resets_ref
  result = .lltarget..draft(source.name(),source.artifact(),source.globals(),entries,bytes,work)
  if result.error() <> '' then do
    status = 'invalid'; if pos('LL_RESOURCE_LIMIT',result.error()) > 0 then status = 'limit'
    return .llinline..change(status,result.error(),source,empty)
  end
  do
  source_graph = source.ir(); nextreset = 1
  do i = 1 to source.records()
    input = source.record(i)
    if result.preflight(1 + input.operands() + input.registerrefs(),0) = 0 then return .llinline..change('limit',result.error(),source,empty)
    at = llinline..copyorigin(source_graph,input.origin(),reference result,reference sources,reference origins)
    if result.error() <> '' then do
      status = 'invalid'; if pos('LL_RESOURCE_LIMIT',result.error()) > 0 then status = 'limit'
      return .llinline..change(status,result.error(),source,empty)
    end
    if input.kind() = 'procedure' then do
      oldbody = source.body(input.procedureid()); extent = oldbody.locals()
      if input.procedureid() = procedureId then extent = locals
      targetbody = result.procedure(oldbody.name(),extent,at,oldbody.expose())
      if result.error() <> '' then do
        status = 'invalid'; if pos('LL_RESOURCE_LIMIT',result.error()) > 0 then status = 'limit'
        return .llinline..change(status,result.error(),source,empty)
      end
      bodies[input.procedureid()] = targetbody as .object; maps[input.id()] = targetbody.headerid()
      if input.procedureid() = procedureId then callers[1] = targetbody.functionid()
      iterate
    end
    if input.procedureid() = 0 then do
      call objectarraydrop fields
      do j = 1 to input.operands(); fields[j] = input.operand(j) as .object; end
      maps[input.id()] = result.record(input.kind(),fields,at); iterate
    end
    targetbody = bodies[input.procedureid()] as .lltarget..bodydraft
    if input.procedureid() = procedureId then do
      do while nextreset <= resets[0]
        request = resets[nextreset] as .llrxas..typedreset
        if request.recordid() <> input.id() then leave
        if request.origin() <> input.origin().id() then return .llinline..change('invalid','storage.reset.origin',source,empty)
        if usedcells > cells - 2 then return .llinline..change('limit','storage.code.cells',source,empty)
        call objectarraydrop fields; fields[1] = targetbody.reg('r',request.physical()) as .object
        ignored = targetbody.emit('null',fields,at); usedcells = usedcells + 2; nextreset = nextreset + 1
      end
      call objectarraydrop replacements
      do j = 1 to input.registerrefs()
        value = input.registerref(j)
        if value.bank() <> 'r' then return .llinline..change('invalid','storage.reference.bank',source,empty)
        extent = mapping[value.index() + 1]
        if extent < 0 then return .llinline..change('invalid','storage.required.cell.absent',source,empty)
        replacements[j] = targetbody.reg('r',extent) as .object
      end
      fields = lltarget..remapregisters(input,replacements)
    end
    else fields = llinline..clonefields(input,targetbody)
    if input.kind() = 'instruction' then do
      cost = 1 + fields[0]
      if cost > cells - usedcells then return .llinline..change('limit','storage.code.cells',source,empty)
      usedcells = usedcells + cost; maps[input.id()] = targetbody.emit(input.mnemonic(),fields,at)
    end
    else maps[input.id()] = targetbody.record(input.kind(),fields,at)
    if result.error() <> '' then do
      status = 'invalid'
      if pos('LL_RESOURCE_LIMIT',result.error()) > 0 then status = 'limit'
      return .llinline..change(status,result.error(),source,empty)
    end
  end
  if nextreset <= resets[0] then return .llinline..change('invalid','storage.reset.record',source,empty)
  target = result.finish()
  if target.valid() = 0 then do
    status = 'invalid'
    if pos('LL_RESOURCE_LIMIT',target.error()) > 0 then status = 'limit'
    return .llinline..change(status,target.error(),source,empty)
  end
  return .llinline..change('changed','storage.checked.assignment',target,maps,callers)
  on signal as problem
    message = result.error()
    if message = '' then message = problem.name() || ': ' || problem.message()
    status = 'invalid'; if pos('LL_RESOURCE_LIMIT',message) > 0 then status = 'limit'
    return .llinline..change(status,'LL_TARGET_STORAGE: ' || message,source,empty)
  end
  return .llinline..change('invalid','storage.no.result',source,empty)
