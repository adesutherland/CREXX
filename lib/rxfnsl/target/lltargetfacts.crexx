    return 1
  /* Ordinary invoke accepts broader bodies. This continuation admits only
   * one retained fixed scalar leaf, before allocating any per-case state. */
  selectorleaf: method = .int
    arg item = .lltarget..record
    i = .int; childid = .int
    field = .lltarget..operand; record = .lltarget..record; row = .numbers
    module = dereference _owner
    if item.mnemonic() <> 'call1' | item.operands() <> 3 then return reject('argument.selector.tail.call.pending')
    field = item.operand(2)
    if field.kind() <> 'P' then return reject('argument.selector.tail.call.pending')
    if spend(module.procedures()) = 0 then return 0
    childid = module.procedureid(field.text())
    if childid = 0 then return reject('argument.selector.tail.call.pending')
    if _active[childid] then return reject('call.recursion.active')
    if linear(childid,'argument.selector.tail.call.pending') = 0 then return 0
    if reserve(_linearcount[childid],16) = 0 | spend(_linearcount[childid]) = 0 then return 0
    row = _linear[childid] as .numbers
    do i = 1 to row.size()
      if spend(1) = 0 then return 0
      record = module.at(row.at(i))
      if record.kind() <> 'instruction' then iterate
      /* Transfers below still prove component availability, context equality,
       * successful writes and recycler ownership for the current actual. */
      if wordpos(record.mnemonic(),'numsci ret cnop ichkrng null load copy icopy scopy bcopy move settp iadd isub imult') = 0 then return reject('argument.selector.tail.call.pending')
    end
    return 1
  /** A checked normal successor of ICHKRNG, immediately followed by one
   * register LINKARG and a scalar linear suffix. Return2 leaves the exact path
