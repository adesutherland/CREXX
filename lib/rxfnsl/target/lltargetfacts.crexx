    retid = row.singleton(ordinal)
    if retid = 0 then return -1
    return row.right(ordinal,_retordinal[retid],pair)
  argumentcasereturns: method = .int
    arg callid = .int, ordinal = .int
    if casekey(callid,ordinal) = 0 then return 0
    row_ref = reference _selections[callid]; row = dereference row_ref
    return row.returns(ordinal)
  argumentcasereturnsite: method = .int
    arg callid = .int, ordinal = .int, returned = .int
    if casekey(callid,ordinal) = 0 then return 0
    row_ref = reference _selections[callid]; row = dereference row_ref
    if returned < 1 | returned > row.returns(ordinal) then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: case return ordinal"; return 0
    end
    return row.site(ordinal,returned)
  casereturnkey: method = .int
    arg callid = .int, ordinal = .int, retid = .int
    if casekey(callid,ordinal) = 0 then return 0
    if recordkey(callid,retid) = 0 then return 0
