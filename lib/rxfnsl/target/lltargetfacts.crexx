        normal = snapshot state_ref; normalview = snapshot view_ref; normalhistory = snapshot history_ref
        state = handlerstate; view = beforeview; previous = handlerhistory
      end
      else if item.id() = _namedjoin then do
        if _ownerlane then do
          /* Validate the relation while each predecessor is still intact.
           * Keep the event successor, and the saved empty normal alternative,
           * through the authored guard; never tag an ordinary merged value. */
          if handlerpossible then do
            if ownerrelation(state,view,1) = 0 then return 0
          end
          if normalpossible then do
            if ownerrelation(normal,normalview,0) = 0 then return 0
          end
        end
        else if normalpossible & handlerpossible then do
          if spend(state.size() * 22 + view.slots() * 3) = 0 then return 0
          if joinpath(reference state,reference view,reference previous,normal,normalview,normalhistory) = 0 then return 0
        end
        else if normalpossible then do; state = normal; view = normalview; previous = normalhistory; end
      end
      else if _ownerlane & item.id() = _ownerclose then do
        if normalpossible & handlerpossible then do
          if spend(state.size() * 22 + view.slots() * 3) = 0 then return 0
          if joinpath(reference state,reference view,reference previous,normal,normalview,normalhistory) = 0 then do
            if _status = 'keep' then return reject('signal.owner.state.unproved')
            return 0
          end
        end
        else if normalpossible then do; state = normal; view = normalview; previous = normalhistory; end
      end
