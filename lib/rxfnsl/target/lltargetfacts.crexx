          _references[i] = .numbers(empty) as .object; _beforeplain[i] = .numbers(empty) as .object
        end
        else if item.procedureid() > 1 & item.kind() <> 'procedure' then iterate
      end
      call _access.put(i,empty,empty,empty,empty)
    end
    if _access.seal() = 0 then do; _status = _access.status(); _reason = _access.message(); return; end
    if spend(_access.usedwork()) = 0 then return
    /* Only this closed root's original cells have proved fresh entry state.
     * Recycled callee bases do not inherit it. Seal the reuse premises before
     * handing the remaining work allowance to a placement consumer. */
    if spend(body.locals()) = 0 | reserve(body.locals(),8) = 0 then return
    do i = 1 to body.locals(); _reuse[i] = 0; end
    if _graphmode = 0 & _access.complete(_function) & _globals[0] = 0 then do i = 1 to module.records()
      if spend(1) = 0 then return
      item = module.record(i)
      if item.procedureid() <> _function | item.kind() = 'procedure' then iterate
      if _runtime[item.id()] = 0 then iterate
      references = _references[item.id()] as .numbers
      barrier = 0; definition = 0
      if item.kind() = 'instruction' then do
        barrier = wordpos(item.mnemonic(),'link unlink swap call call1 call2 call3 call4 itos') > 0
        definition = wordpos(item.mnemonic(),'null load copy icopy move getandtp iadd isub imult') > 0
        if definition then destination = item.operand(1)
      end
      if barrier = 0 then plain = _beforeplain[item.id()] as .numbers
      if spend(item.registerrefs()) = 0 then return
      do j = 1 to item.registerrefs()
        value = item.registerref(j); slot = value.index() + 1; id = references.at(j)
        /* The current placement adapter addresses original slot domains. A
         * binding/permutation participant, alias target or reached mismatch
         * cannot use that projection to justify scalar sharing. */
        if barrier | slot <> id then do
          if slot >= 1 & slot <= body.locals() then _reuse[slot] = -1
          if id >= 1 & id <= body.locals() then _reuse[id] = -1
          iterate
        end
        if id < 1 | id > body.locals() then iterate
        /* Fresh scalar-only storage never acquired a reference identity,
         * payload or attribute tree. ENDLIFE therefore has nothing to release;
         * its ordinary reference still extends the required interval. */
        if plain.at(j) = 0 | _plain[id] = 0 then _reuse[id] = -1
        if _reuse[id] <> 0 then iterate
        _reuse[id] = -1
        if definition = 0 then iterate
        if destination.index() + 1 <> id then iterate
        integer = _domains[id]; whole = _whole[id]
        if integer = 0 | whole = 0 then iterate
        if spend(5 * (_access.accesses(item.id()) + 1)) = 0 then return
        if _access.kills(item.id(),integer) & _access.reads(item.id(),integer) = 0 & _access.reads(item.id(),whole) = 0 & _access.observes(item.id(),integer) = 0 & _access.observes(item.id(),whole) = 0 then _reuse[id] = 1
      end
      if item.kind() = 'instruction' & wordpos(item.mnemonic(),'call call1 call2 call3 call4') > 0 then do
        actuals = _argumentstorage[item.id()] as .numbers
        if spend(_counts[item.id()]) = 0 then return
        do j = 1 to _counts[item.id()]
          id = actuals.at(j)
          if id >= 1 & id <= body.locals() then _reuse[id] = -1
        end
        if item.mnemonic() = 'call' & item.operands() = 3 then do
          if spend(_counts[item.id()] + 1) = 0 then return
          do j = _first[item.id()] to _first[item.id()] + _counts[item.id()]
            _reuse[j] = -1
          end
        end
      end
    end
    _status = 'ok'
    return
    on signal as problem
      if _status = 'building' then do; _status = 'invalid'; _reason = 'target.facts.' || problem.name() || ': ' || problem.message(); end
    end
    return
  status: method = .string
    call run()
    if _status = 'ok' & valid() = 0 then return 'invalid'
    return _status
  valid: method = .int
    if _status <> 'ok' | <refvalid>(_owner) = 0 | <refvalid>(_store) = 0 then return 0
    module = dereference _owner; graph = dereference module.ir(); store_ref = graph.storage()
    return module.identity() = _revision & (store_ref <refsame> _store) & _index.valid() & _access.valid()
  require: method = .void
    call run()
    if valid() = 0 then assembler signal "ERROR","LL_TARGET_FACTS_OWNER: facts unavailable, expired or replaced"
    return
  reason: method = .string
    call run()
    if _status = 'ok' & valid() = 0 then return 'owner.expired.or.replaced'
    return _reason
  remaining: method = .int
    call run(); return _work
  /** Internal expander query over this exact source owner. The source model's
   * normal graph and public service signatures are unchanged. */
  handlercall: method = .int
    arg labelid = .int
    call require()
    if labelid = _namedhandler then return _namedcall
    return 0
  handleroutcome: method = .int
    arg callid = .int
    call require()
    /* Internal feasible-path mask: normal=1, handler=2, both=3. */
    if callid = _namedcall then return _namedoutcome
    return 0
  /** Internal exact-owner transport query. This proves the complete read-only
   * leaf mapping; it is not a producer-supplied effect/ownership assertion. */
  handlerdirect: method = .int
    arg callid = .int
    call require()
    return _namedcatchall & callid = _namedcall
  index: method = reference .llirgraph..index
    call require(); return reference _index
  access: method = reference .llirgraph..access
    call require(); return reference _access
  rootkey: method = .int
    arg recordid = .int
    call require()
    if valid() = 0 then return 0
    if _graphmode = 0 then do
      assembler signal "ERROR","LL_TARGET_FACTS_PROFILE: graph-root query requires analysegraph"; return 0
    end
    if recordid < 1 | recordid > _recordordinal[0] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original root record identity"; return 0
    end
    if _recordordinal[recordid] = 0 then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original root record identity"; return 0
    end
    if _index.blockfunction(_index.opblock(recordid)) <> _function then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: foreign root record"; return 0
    end
    return recordid
  /** Graph-root queries borrow sealed rows. Unvisited source records are
   * valid identities with no runtime access. META scope is lexical instead. */
  rootlive: method = .int
    arg recordid = .int
    if rootkey(recordid) = 0 then return 0
    return _runtime[recordid] <> 0
  rootbranchchoice: method = .int
    arg recordid = .int
    if rootkey(recordid) = 0 then return 0
    return _rootchoice[recordid]
  rootrestored: method = .int
    call require()
    if valid() = 0 then return 0
    if _graphmode = 0 then do
      assembler signal "ERROR","LL_TARGET_FACTS_PROFILE: graph-root query requires analysegraph"; return 0
    end
    return _rootrestored
  scopestorage: method = .int
    arg declarationid = .int
    if rootkey(declarationid) = 0 then return 0
    if declarationid > _scopeslot[0] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original scoped META_REG declaration"; return 0
    end
    if _scopeslot[declarationid] = 0 then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original scoped META_REG declaration"; return 0
    end
    return _scopestorage[declarationid]
  calls: method = .int
    call require(); return _calls[0]
  callid: method = .int
    arg ordinal = .int
    call require(); return _calls[ordinal]
  bodyid: method = .int
    arg callid = .int
    call require(); return _body[callid]
  arguments: method = .int
    arg callid = .int
    call require(); return _counts[callid]
  first: method = .int
    arg callid = .int
    call require(); return _first[callid]
  argument: method = .int
    arg callid = .int, ordinal = .int
    call require(); actuals = _actuals[callid] as .numbers; return actuals.at(ordinal)
  /** Root fixed actual spelling is distinct from captured physical storage.
   * Pass the returned bank and argument() index together to target.reg(). */
  argumentbank: method = .string
    arg callid = .int, ordinal = .int
    call require()
    if valid() = 0 then return ''
    if callid < 1 | callid > _body[0] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original root call identity"
      return ''
    end
    if _body[callid] = 0 | ordinal < 1 | ordinal > _counts[callid] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original root actual ordinal"
      return ''
    end
    if _globals[0] = 0 then return 'r'
    return substr(_argumentbanks[callid],ordinal,1)
  argumentstorage: method = .int
    arg callid = .int, ordinal = .int
    call require(); actuals = _argumentstorage[callid] as .numbers; return actuals.at(ordinal)
  proofid: method = .int
    arg callid = .int
    call require()
    if valid() = 0 then return 0
    if callid < 1 | callid > _body[0] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original root call identity"; return 0
    end
    if _body[callid] = 0 | _proofindex[callid] = 0 then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original root call identity"; return 0
    end
    return _proofindex[callid]
  recordkey: method = .int
    arg callid = .int, recordid = .int
    if proofid(callid) = 0 then return 0
    if recordid < 1 | recordid > _recordordinal[0] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original callee record identity"; return 0
    end
    if _recordordinal[recordid] = 0 then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original callee record identity"; return 0
    end
    if _index.blockfunction(_index.opblock(recordid)) <> _body[callid] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: foreign callee record"; return 0
    end
    return _recordordinal[recordid]
  returnkey: method = .int
    arg callid = .int, recordid = .int
    p = .int
    if recordkey(callid,recordid) = 0 then return 0
    if recordid > _retordinal[0] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original callee RET identity"; return 0
    end
    if _retordinal[recordid] = 0 then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original callee RET identity"; return 0
    end
    p = _proofindex[callid]; row_ref = reference _proofs[p]; row = dereference row_ref
    if row.action(_retordinal[recordid]) = '' then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: infeasible callee RET"; return 0
    end
    return _retordinal[recordid]
  /** All exit queries use exact original root-call/callee-record identities.
   * Queries borrow sealed rows and consume no handed-off construction work. */
  returns: method = .int
    arg callid = .int
    p = proofid(callid)
    if p = 0 then return 0
    row_ref = reference _proofs[p]; row = dereference row_ref
    return row.returns()
  returnsite: method = .int
    arg callid = .int, ordinal = .int
    p = proofid(callid)
    if p = 0 then return 0
    row_ref = reference _proofs[p]; row = dereference row_ref
    if ordinal < 1 | ordinal > row.returns() then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: return ordinal"; return 0
    end
    return row.site(ordinal)
  returnactionat: method = .string
    arg callid = .int, retid = .int
    ordinal = returnkey(callid,retid)
    if ordinal = 0 then return ''
    p = _proofindex[callid]; row_ref = reference _proofs[p]; row = dereference row_ref
    if row.action(ordinal) = 'cases' then return ''
    return row.action(ordinal)
  restores: method = .int
    arg callid = .int, retid = .int
    ordinal = returnkey(callid,retid)
    if ordinal = 0 then return 0
    p = _proofindex[callid]; row_ref = reference _proofs[p]; row = dereference row_ref
    return row.restores(ordinal)
  restoreleft: method = .int
    arg callid = .int, retid = .int, pair = .int
    ordinal = returnkey(callid,retid)
    if ordinal = 0 then return -1
    p = _proofindex[callid]; row_ref = reference _proofs[p]; row = dereference row_ref
    if pair < 1 | pair > row.restores(ordinal) then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: restore ordinal"; return -1
    end
    return row.left(ordinal,pair)
  restoreright: method = .int
    arg callid = .int, retid = .int, pair = .int
    ordinal = returnkey(callid,retid)
    if ordinal = 0 then return -1
    p = _proofindex[callid]; row_ref = reference _proofs[p]; row = dereference row_ref
    if pair < 1 | pair > row.restores(ordinal) then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: restore ordinal"; return -1
    end
    return row.right(ordinal,pair)
  recordlive: method = .int
    arg callid = .int, recordid = .int
    ordinal = recordkey(callid,recordid)
    if ordinal = 0 then return 0
    p = _proofindex[callid]; row_ref = reference _proofs[p]; row = dereference row_ref
    return row.live(ordinal)
  /** Borrow sealed original-address scope rows. These queries neither scan
   * source suffixes nor copy descriptors after facts publication. */
  scopereentry: method = .int
    arg callid = .int
    if proofid(callid) = 0 then return 0
    return _scopereentry[_body[callid]]
  scopeaddress: method = .int
    arg callid = .int, recordid = .int
    if recordkey(callid,recordid) = 0 then return 0
    return _scopeaddress[recordid]
  scopebindings: method = .int
    arg callid = .int, recordid = .int
    groupid = scopeaddress(callid,recordid)
    if groupid = 0 | scopereentry(callid) = 0 then return 0
    row_ref = reference _scopeincoming[groupid]; row = dereference row_ref
    return row.size()
  scopebinding: method = .int
    arg callid = .int, recordid = .int, ordinal = .int
    groupid = scopeaddress(callid,recordid)
    if groupid = 0 | scopereentry(callid) = 0 then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original inline scope group"; return 0
    end
    row_ref = reference _scopeincoming[groupid]; row = dereference row_ref
    return row.at(ordinal)
  branchchoice: method = .int
    arg callid = .int, recordid = .int
    ordinal = recordkey(callid,recordid)
    if ordinal = 0 then return 0
    p = _proofindex[callid]; row_ref = reference _proofs[p]; row = dereference row_ref
    return row.choice(ordinal)
  returned: method = .int
    arg callid = .int
    if returns(callid) <> 1 then do
      assembler signal "ERROR","LL_TARGET_FACTS_RETURN: use per-RET facts"; return 0
    end
    return _return[callid]
  /** The sealed call plan distinguishes active binding changes from values. */
  rebinding: method = .int
    arg callid = .int
    call require(); return _rebinding[callid]
  /** A retained nested counted window requires the original complete slot
   * order even when the outer frame contains no explicit binding change.
   * The root ledger and inverse SWAP list remain distinct from child frames. */
  orderedslots: method = .int
    arg callid = .int
    call require()
    if valid() = 0 then return 0
    if callid < 1 | callid > _body[0] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original root call identity"
      return 0
    end
    if _body[callid] = 0 then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original root call identity"
      return 0
    end
    return _ordered[callid] <> 0
  /** Exact active argument selected by one original outer-body LINKARG.
   * Zero denotes a0; -1 denotes a valid callee record without a rewrite.
   * Each root activation owns its row, so repeated bodies cannot overwrite
   * another site's selector. No lookup consumes handed-off work. */
  argumentcases: method = .int
    arg callid = .int
    if proofid(callid) = 0 then return 0
    if callid > _selectioncount[0] then return 0
    return _selectioncount[callid]
  casekey: method = .int
    arg callid = .int, ordinal = .int
    count = argumentcases(callid)
    if ordinal < 1 | ordinal > count then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: runtime selector case"; return 0
    end
    return 1
  argumentruntime: method = .int
    arg callid = .int
    if argumentcases(callid) = 0 then return 0
    row_ref = reference _selections[callid]; row = dereference row_ref
    return row.operation()
  argumentguard: method = .int
    arg callid = .int
    if argumentcases(callid) = 0 then return 0
    row_ref = reference _selections[callid]; row = dereference row_ref
    return row.guard()
  argumentraw: method = .int
    arg callid = .int, ordinal = .int
    if casekey(callid,ordinal) = 0 then return 0
    row_ref = reference _selections[callid]; row = dereference row_ref
    return row.raw(ordinal)
  argumentcase: method = .int
    arg callid = .int, ordinal = .int
    if casekey(callid,ordinal) = 0 then return 0
    row_ref = reference _selections[callid]; row = dereference row_ref
    return row.selected(ordinal)
  argumentcasestorage: method = .int
    arg callid = .int, ordinal = .int
    if casekey(callid,ordinal) = 0 then return 0
    row_ref = reference _selections[callid]; row = dereference row_ref
    return row.storage(ordinal)
  argumentcaselive: method = .int
    arg callid = .int, ordinal = .int, recordid = .int
