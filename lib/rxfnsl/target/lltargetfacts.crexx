            if rightid = 0 then return reject('profile.external.storage.pending')
            if state.defined(rightid) = 0 then return reject('predicate.operand.unproved')
            rightknown = state.known(rightid)
            if rightknown then rhs = state.value(rightid)
            call insert(reference reads,domain(rightid))
