              if boundjoin(handlerstate,beforeview,handlerhistory,state,view,previous) = 0 then return 0
            end
          end
          else do
            if spend(state.size() * 44 + view.slots() * 6) = 0 then return 0
            if joinpath(reference handlerstate,reference beforeview,reference handlerhistory,before,view,beforehistory) = 0 then return 0
            if normalpossible then do
