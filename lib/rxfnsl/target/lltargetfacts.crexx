      else do
        /* Infeasible normal/handler observations do not execute. Their rows
         * remain opaque in this deliberately incomplete access projection. */
        if item.id() > _namedcall & item.id() < _namedhandler & normalpossible = 0 then iterate
        if item.id() > _namedhandler & item.id() < _namedjoin & handlerpossible = 0 then iterate
        if _ownerlane & item.id() > _ownerguard & item.id() < _ownerclose & handlerpossible = 0 then iterate
        if _snapshotcopy > 0 & item.id() = _snapshotcopy then do
          field = item.operand(1); id = view.storage(field)
          source = item.operand(2); sourceid = view.storage(source)
          if id = 0 | id <> view.base(field) | sourceid = 0 | sourceid <> view.base(source) then return reject('signal.snapshot.mapping.pending')
          if state.zeroed(id) = 0 | state.runtimeevent(sourceid) = 0 then return reject('signal.snapshot.state.unproved')
          /* Only COPY's completed normal successor inherits the opaque shape.
           * The authored instruction still performs all allocation, native/
