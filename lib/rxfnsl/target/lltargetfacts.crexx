     * reachable end anchor still need a later control-flow proof. */
    do i = 1 to _index.functionoperations(functionId)
      if spend(1) = 0 then return 0
      recordid = _index.functionoperation(functionId,i)
      if _index.reachable(_index.opblock(recordid)) then iterate
      operation = graph.operation(recordid)
      if lltarget..isrecord(operation.name()) then do
        item = module.at(recordid)
