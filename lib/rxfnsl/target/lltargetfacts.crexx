/* cREXX License (MIT). RXAS scalar/storage transfers over shared L analyses. */
options levelb
namespace lltargetfacts expose analysis analyse analysegraph arithmetic
import rxfnsb
import llir
import llirgraph
import lltarget
import llrxascatalog

/** Typed numeric row retained as an object; primitive arrays are not boxed. */
numbers: class
  _values = .int[]
  *: factory
    arg values = .int[]
    _values = values
    return
  at: method = .int
    arg ordinal = .int
    if ordinal < 1 | ordinal > _values[0] then assembler signal "ERROR","LL_TARGET_FACTS_ID: numeric row ordinal"
    return _values[ordinal]
  size: method = .int
    return _values[0]

/** This helper proves the checked write succeeds before evaluating it. The VM
 * default OVERFLOW_UNDERFLOW response ignores a failed, unwritten destination;
 * integer equality alone cannot establish return availability or history. */
arithmetic: procedure = .int[]
  arg name = .string, left = .int, right = .int
  constant HIGHEST = 9223372036854775807
  constant LOWEST = -9223372036854775807 - 1
  result = .int[]; result[1] = 0; result[2] = 0
  select name
    when 'iadd' then do
      if right > 0 then do; if left > HIGHEST - right then return result; end
      else if right < 0 then do; if left < LOWEST - right then return result; end
      result[2] = left + right
    end
    when 'isub' then do
      if right < 0 then do; if left > HIGHEST + right then return result; end
      else if right > 0 then do; if left < LOWEST + right then return result; end
      result[2] = left - right
    end
    when 'imult' then do
      if left = 0 | right = 0 then result[2] = 0
      else do
        if left > 0 & right > 0 then do; if left > HIGHEST / right then return result; end
        else if left > 0 & right < 0 then do; if right < LOWEST / left then return result; end
        else if left < 0 & right > 0 then do; if left < LOWEST / right then return result; end
        else do; if left < HIGHEST / right then return result; end
        result[2] = left * right
      end
    end
    otherwise return result
  end
  result[1] = 1
  return result

/** Target transfer state, not a CFG/worklist or allocator. Distinct storage
 * identities never merge merely because their current integer values agree.
 * Only the closed scalar profile below establishes absence of hidden payloads. */
cells: class
  _defined = .int[]
  _known = .int[]
  _values = .int[]
  _plain = .int[]
  _bounded = .int[]
  _low = .int[]
  _high = .int[]
  _abiknown = .int[]
  _abibits = .int[]
  _abiindependent = .int[]
  _wholeknown = .int[]
  _zeroed = .int[]
  /* Availability certifies independent bytes. The second row additionally
   * covers the VM-private and normalization metadata copied by SCOPY. */
  _stringdefined = .int[]
  _stringindependent = .int[]
  _binarydefined = .int[]
  _binaryindependent = .int[]
  _ordinary = .int[]
  *: factory
    return
  add: method = .int
    arg defined = 0, known = 0, value = 0
    n = _defined[0] + 1
    _defined[n] = defined; _known[n] = known; _values[n] = value; _plain[n] = 1
    _wholeknown[n] = 1; _zeroed[n] = 0
    _bounded[n] = defined & known; _low[n] = value; _high[n] = value
    _abiknown[n] = 768; _abibits[n] = 0; _abiindependent[n] = 1
    _stringdefined[n] = 1; _stringindependent[n] = 1; _ordinary[n] = 1
    _binarydefined[n] = 1; _binaryindependent[n] = 1
    return n
  defined: method = .int
    arg id = .int
    return _defined[id]
  known: method = .int
    arg id = .int
    return _known[id]
  value: method = .int
    arg id = .int
    return _values[id]
  bounded: method = .int
    arg id = .int
    return _bounded[id]
  low: method = .int
    arg id = .int
    return _low[id]
  high: method = .int
    arg id = .int
    return _high[id]
  plain: method = .int
    arg id = .int
    return _plain[id]
  ordinary: method = .int
    arg id = .int
    return _ordinary[id]
  stringdefined: method = .int
    arg id = .int
    return _stringdefined[id]
  stringindependent: method = .int
    arg id = .int
    return _stringindependent[id]
  binarydefined: method = .int
    arg id = .int
    return _binarydefined[id]
  binaryindependent: method = .int
    arg id = .int
    return _binaryindependent[id]
  abiknown: method = .int
    arg id = .int
    return _abiknown[id]
  abibits: method = .int
    arg id = .int
    return _abibits[id]
  abiindependent: method = .int
    arg id = .int
    return _abiindependent[id]
  /* Refine a validated branch edge, not the runtime value. No integer,
   * payload, freshness or entry-independence fact changes with the test. */
  refineabi: method = .void
    arg id = .int, mask = .int, taken = .int
    known = .int; bits = .int; other = .int
    known = _abiknown[id]; bits = _abibits[id]
    if taken = 0 | mask <> 768 then do
      other = 768 - mask
      assembler iand known,known,other
      assembler iand bits,bits,other
      known = known + mask
      if taken then bits = bits + mask
      _abiknown[id] = known; _abibits[id] = bits
    end
    /* A true combined test is an OR, not two set bits. Only an already
     * known-clear member identifies which other member must be set. */
    else if bits = 0 & (known = 256 | known = 512) then do
      _abiknown[id] = 768; _abibits[id] = 768 - known
    end
    return
  size: method = .int
    return _defined[0]
  /* Whole-known means entry independence, not identical bits across paths.
   * Exact status knowledge is limited to the separately tracked ABI bits. */
  meet: method = .int
    arg other = .cells
    known = .int; different = .int; same = .int; otherknown = .int; otherbits = .int; bits = .int
    if size() <> other.size() then return 0
    do i = 1 to size()
      _defined[i] = _defined[i] & other.defined(i)
      _bounded[i] = _defined[i] & _bounded[i] & other.bounded(i)
      _known[i] = 0; _values[i] = 0
      if _bounded[i] then do
        if other.low(i) < _low[i] then _low[i] = other.low(i)
        if other.high(i) > _high[i] then _high[i] = other.high(i)
        if _low[i] = _high[i] then do; _known[i] = 1; _values[i] = _low[i]; end
      end
      else do; _low[i] = 0; _high[i] = 0; end
      _plain[i] = _plain[i] & other.plain(i)
      _ordinary[i] = _ordinary[i] & other.ordinary(i)
      _stringdefined[i] = _stringdefined[i] & other.stringdefined(i)
      _stringindependent[i] = _stringindependent[i] & other.stringindependent(i)
      _binarydefined[i] = _binarydefined[i] & other.binarydefined(i)
      _binaryindependent[i] = _binaryindependent[i] & other.binaryindependent(i)
      _wholeknown[i] = _wholeknown[i] & other.wholeknown(i)
      _zeroed[i] = _zeroed[i] & other.zeroed(i)
      otherknown = other.abiknown(i); otherbits = other.abibits(i); bits = _abibits[i]
      known = _abiknown[i]
      assembler iand known,known,otherknown
      assembler ixor different,bits,otherbits
      same = 768 - different
      assembler iand known,known,same
      assembler iand bits,bits,known
      _abiknown[i] = known; _abibits[i] = bits
      _abiindependent[i] = _abiindependent[i] & other.abiindependent(i)
    end
    return 1
  wholeknown: method = .int
    arg id = .int
    return _wholeknown[id]
  zeroed: method = .int
    arg id = .int
    return _zeroed[id]
  uncertain: method = .void
    arg id = .int
    /* The scalar profile proves no native/reference payload was created.
     * Recycled ordinary components/status still cannot be assumed fresh. */
    _defined[id] = 0; _known[id] = 0; _wholeknown[id] = 0; _zeroed[id] = 0
    _bounded[id] = 0; _low[id] = 0; _high[id] = 0
    _abiknown[id] = 0; _abibits[id] = 0; _abiindependent[id] = 0
    _stringdefined[id] = 0; _stringindependent[id] = 0
    _binarydefined[id] = 0; _binaryindependent[id] = 0
    return
  integer: method = .void
    arg id = .int, known = .int, value = 0
    _defined[id] = 1; _known[id] = known; _values[id] = value; _zeroed[id] = 0
    _bounded[id] = known; _low[id] = value; _high[id] = value
    return
  /* Successful arithmetic changes only its integer component. Bounds are
   * not a whole-cell equality, status, freshness or lifetime assertion. */
  interval: method = .void
    arg id = .int, low = .int, high = .int
    if low > high then do
      assembler signal "ERROR","LL_TARGET_FACTS_DIMENSIONS: inverted integer bounds"; return
    end
    _defined[id] = 1; _bounded[id] = 1; _low[id] = low; _high[id] = high; _zeroed[id] = 0
    _known[id] = low = high; _values[id] = 0
    if _known[id] then _values[id] = low
    return
  reset: method = .void
    arg id = .int
    _defined[id] = 1; _known[id] = 1; _values[id] = 0; _plain[id] = 1
    _wholeknown[id] = 1; _zeroed[id] = 1
    _bounded[id] = 1; _low[id] = 0; _high[id] = 0
    _abiknown[id] = 768; _abibits[id] = 0; _abiindependent[id] = 1
    _stringdefined[id] = 1; _stringindependent[id] = 1; _ordinary[id] = 1
    _binarydefined[id] = 1; _binaryindependent[id] = 1
    return
  copy: method = .void
    arg destination = .int, source = .int, whole = 1
    _defined[destination] = _defined[source]; _known[destination] = _known[source]; _values[destination] = _values[source]
    _bounded[destination] = _bounded[source]; _low[destination] = _low[source]; _high[destination] = _high[source]
    if whole then do
      _plain[destination] = _plain[source]
      _ordinary[destination] = _ordinary[source]
      _stringdefined[destination] = _stringdefined[source]
      _stringindependent[destination] = _stringindependent[source]
      _binarydefined[destination] = _binarydefined[source]
      _binaryindependent[destination] = _binaryindependent[source]
      _abiknown[destination] = _abiknown[source]; _abibits[destination] = _abibits[source]
      _abiindependent[destination] = _abiindependent[source]
      _wholeknown[destination] = _wholeknown[source]; _zeroed[destination] = _zeroed[source]
    end
    else _zeroed[destination] = 0
    return
  move: method = .void
    arg destination = .int, source = .int
    if destination = source then return
    call copy(destination,source)
    call reset(source)
    return
  status: method = .void
    arg id = .int, flags = .int
    publicbits = .int; abi = .int
    /* rxflags_public_write: public bits are 8..30, compiler ABI is 8..9.
     * Masking also performs the VM's uint32_t truncation for these bands.
     * A nonzero request in another band leaves the compiler band intact. */
    assembler iand publicbits,flags,2147483392
    assembler iand abi,flags,768
    if publicbits = 0 then do; _abiknown[id] = 768; _abibits[id] = 0; _abiindependent[id] = 1; end
    else if abi <> 0 then do; _abiknown[id] = 768; _abibits[id] = abi; _abiindependent[id] = 1; end
    _zeroed[id] = 0
    return
  statuscopy: method = .void
    arg destination = .int, source = .int
    /* ACOPY copies the native full status word. Only its ABI subfacts are
     * interpreted here; no integer/payload or whole-known proof follows from
     * ABI knowledge alone. Preserve the instruction for all other bands. */
    _abiknown[destination] = _abiknown[source]; _abibits[destination] = _abibits[source]
    _abiindependent[destination] = _abiindependent[source]
    _wholeknown[destination] = _wholeknown[destination] & _wholeknown[source]
    /* Bytes remain available, but ACOPY replaces the string's VM-private
     * and normalization certificates along with every other status band. */
    _stringindependent[destination] = _stringdefined[destination] & _stringindependent[source]
    _zeroed[destination] = 0
    return
  string: method = .void
    arg id = .int
    _plain[id] = 0; _zeroed[id] = 0
    _stringdefined[id] = 1; _stringindependent[id] = 1
    return
  copystring: method = .void
    arg destination = .int, source = .int
    if destination = source then return
    _stringdefined[destination] = _stringdefined[source]
    _stringindependent[destination] = _stringindependent[source]
    _plain[destination] = 0; _zeroed[destination] = 0
    _wholeknown[destination] = _wholeknown[destination] & _stringindependent[source]
    return
  binary: method = .void
    arg id = .int
    /* Only the normal successor of the retained LOAD establishes bytes.
     * Clearing VM-private flags preserves any existing certificate proof;
     * it cannot establish unknown integer, public status or string facts. */
    _binarydefined[id] = 1; _binaryindependent[id] = 1
    _plain[id] = 0; _zeroed[id] = 0
    return
  copybinary: method = .void
    arg destination = .int, source = .int
    if destination = source then return
    _binarydefined[destination] = _binarydefined[source]
    _binaryindependent[destination] = _binaryindependent[source]
    _plain[destination] = 0; _zeroed[destination] = 0
    _wholeknown[destination] = _wholeknown[destination] & _binaryindependent[source]
    return

frame: class
  _map = .int[]
  _base = .int[]
  _identity = .int[]
  _locals = .int
  _globals = .int
  _arguments = .int
  _context = .string
  *: factory
    arg owner = reference .cells, locals = .int, actuals = .int[], fresh = 0, context = '', ?owned = .int[], ?globals = .int[]
    i = .int; id = .int; at = .int
    state = dereference owner; _locals = locals; _arguments = actuals[0]; _context = context
    _globals = 0
    if ?globals then _globals = globals[0]
    do i = 1 to locals
      if ?owned then id = owned[i]
      else id = state.add(fresh,fresh,0)
      _map[i] = id; _base[i] = id; _identity[i] = i
    end
    do i = 1 to _globals
      at = locals + i; id = globals[i]
      _map[at] = id; _base[at] = id; _identity[at] = at
    end
    if ?owned then do
      id = owned[locals + 1]; call state.reset(id); call state.integer(id,1,actuals[0])
    end
    else id = state.add(1,1,actuals[0])
    at = locals + _globals + 1; _map[at] = id; _base[at] = id; _identity[at] = at
    do i = 1 to actuals[0]
      at = locals + _globals + 1 + i; _map[at] = actuals[i]; _base[at] = actuals[i]; _identity[at] = at
    end
    return
  position: method = .int
    arg value = .lltarget..operand
    if value.kind() <> 'R' then return 0
    if value.bank() = 'r' & value.index() < _locals then return value.index() + 1
    if value.bank() = 'g' & value.index() < _globals then return _locals + value.index() + 1
    if value.bank() = 'a' & value.index() <= _arguments then return _locals + _globals + value.index() + 1
    return 0
  slots: method = .int
    return _locals + _globals + _arguments + 1
  arguments: method = .int
    return _arguments
  argument: method = .lltarget..operand
    arg index = .int
    if index < 0 | index > _arguments then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: captured argument-bank index"
      return .lltarget..operand.integer(0)
    end
    return .lltarget..operand.bound(0,0,0,'a',index)
  slot: method = .lltarget..operand
    arg ordinal = .int
    if ordinal < 0 | ordinal >= slots() then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: physical frame slot ordinal"
      return .lltarget..operand.integer(0)
    end
    if ordinal < _locals then return .lltarget..operand.bound(0,0,0,'r',ordinal)
    if ordinal < _locals + _globals then return .lltarget..operand.bound(0,0,0,'g',ordinal - _locals)
    return .lltarget..operand.bound(0,0,0,'a',ordinal - _locals - _globals)
  storage: method = .int
    arg value = .lltarget..operand
    at = position(value)
    if at = 0 then return 0
    return _map[at]
  base: method = .int
    arg value = .lltarget..operand
    at = position(value)
    if at = 0 then return 0
    return _base[at]
  baseat: method = .int
    arg position = .int
    if position < 1 | position > _base[0] then assembler signal "ERROR","LL_TARGET_FACTS_ID: frame base ordinal"
    return _base[position]
  identityat: method = .int
    arg position = .int
    return _identity[position]
  compatible: method = .int
    arg other = .frame
    if slots() <> other.slots() | _arguments <> other.arguments() | _context <> other.context() then return 0
    do i = 1 to slots()
      if _base[i] <> other.baseat(i) | _identity[i] <> other.identityat(i) then return 0
      if _map[i] <> other.storage(slot(i - 1)) then return 0
    end
    return 1
  privateordinal: method = .int
    arg physical = .int
    if physical < _locals then return physical
    if physical < _locals + _globals then return -1
    return physical - _globals
  ownedbase: method = .int
    arg ordinal = .int
    if ordinal < 1 | ordinal > _locals + 1 then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: owned base ordinal"
      return 0
    end
    if ordinal <= _locals then return _base[ordinal]
    return _base[_locals + _globals + 1]
  globalcanonical: method = .int
    at = .int
    do i = 1 to _globals
      at = _locals + i
      if _map[at] <> _base[at] | _identity[at] <> at then return 0
    end
    return 1
  link: method = .void
    arg destination = .lltarget..operand, source = .lltarget..operand
    _map[position(destination)] = storage(source)
    return
  unlink: method = .void
    arg destination = .lltarget..operand
    at = position(destination); _map[at] = _base[at]
    return
  swap: method = .void
    arg left = .lltarget..operand, right = .lltarget..operand
    a = position(left); b = position(right)
    id = _map[a]; _map[a] = _map[b]; _map[b] = id
    id = _identity[a]; _identity[a] = _identity[b]; _identity[b] = id
    return
  canonical: method = .int
    do i = 1 to _identity[0]
      if _identity[i] <> i then return 0
    end
    return 1
  restored: method = .int
    do i = 1 to _identity[0]
      if _identity[i] <> i | _map[i] <> _base[i] then return 0
    end
    return 1
  context: method = .string
    return _context
  numeric: method = .void
    arg value = .string
    _context = value
    return

/** Transient owned normalization, never an authored proof or a graph owner.
 * Slots are zero-based physical ordinals in the current r/g/a frame;
 * storage IDs capture its active pointers before the selected call enters. */
callshape: class
  _body = .int
  _form = .string
  _count = .int
  _first = .int
  _result = .int
  _clear = .int
  _countstorage = .int
  _slots = .int[]
  _actuals = .int[]
  *: factory
    arg body = 0, form = '', count = 0, first = 0, result = 0, clear = 0, countstorage = 0, ?slots = .int[], ?actuals = .int[]
    _body = body; _form = form; _count = count; _first = first; _result = result; _clear = clear; _countstorage = countstorage
    if ?slots then _slots = slots
    if ?actuals then _actuals = actuals
    return
  valid: method = .int
    return _body > 0
  body: method = .int
    return _body
  form: method = .string
    return _form
  count: method = .int
    return _count
  first: method = .int
    return _first
  result: method = .int
    return _result
  clear: method = .int
    return _clear
  countstorage: method = .int
    return _countstorage
  slot: method = .int
    arg ordinal = .int
    return _slots[ordinal]
  storage: method = .int
    arg ordinal = .int
    return _actuals[ordinal]

/** Compact, internally authored per-call rows. Keys are callee source/RET
 * ordinals; no mutable state or caller-authored proof escapes the analysis. */
callproof: class
  _live = .int[]
  _choice = .int[]
  _sites = .int[]
  _action = .string[]
  _left = .numbers[]
  _right = .numbers[]
  _written = .int
  _writeinteger = .int
  _killinteger = .int
  _killwhole = .int
  *: factory
    arg records = .int, returns = .int
    i = .int
    do i = 1 to records; _live[i] = 0; _choice[i] = 0; end
    do i = 1 to returns; _action[i] = ''; end
    return
  live: method = .int
    arg ordinal = .int
    return _live[ordinal]
  visit: method = .void
    arg ordinal = .int, choice = 0
    _live[ordinal] = 1; _choice[ordinal] = choice
    return
  choice: method = .int
    arg ordinal = .int
    return _choice[ordinal]
  addreturn: method = .void
    arg ordinal = .int, site = .int, action = .string, left = .int[], right = .int[]
    if _sites[0] = 0 then do; _killinteger = 1; _killwhole = 1; end
    _sites[_sites[0] + 1] = site; _action[ordinal] = action
    _left[ordinal] = .numbers(left); _right[ordinal] = .numbers(right)
    _written = _written | (action <> 'none')
    _writeinteger = _writeinteger | (action = 'integer' | action = 'copy' | action = 'move')
    _killinteger = _killinteger & (action = 'integer' | action = 'copy' | action = 'move')
    _killwhole = _killwhole & (action = 'copy' | action = 'move')
    return
  returns: method = .int
    return _sites[0]
  site: method = .int
    arg ordinal = .int
    return _sites[ordinal]
  action: method = .string
    arg ordinal = .int
    return _action[ordinal]
  restores: method = .int
    arg ordinal = .int
    return _left[ordinal].size()
  left: method = .int
    arg ordinal = .int, pair = .int
    return _left[ordinal].at(pair)
  right: method = .int
    arg ordinal = .int, pair = .int
    return _right[ordinal].at(pair)
  written: method = .int
    return _written
  writeinteger: method = .int
    return _writeinteger
  killinteger: method = .int
    return _killinteger
  killwhole: method = .int
    return _killwhole

/** Conditional last-exit guarantees for procedure-owned bases. All bases of
 * an activation, including a0, are marked together. A never-activated path is
 * neutral at a meet: its first entry is fresh, not a recycled unreset value.
 * Owned StorageIds are immutable analysis data; these rows are path data. */
history: class
  _seen = .int[]
  _reset = .int[]
  *: factory
    return
  extend: method = .void
    arg cells = .int
    i = .int
    do i = _seen[0] + 1 to cells; _seen[i] = 0; _reset[i] = 0; end
    return
  size: method = .int
    return _seen[0]
  seen: method = .int
    arg id = .int
    return _seen[id]
  reset: method = .int
    arg id = .int
    return _reset[id]
  activated: method = .void
    arg id = .int
    _seen[id] = 1
    return
  exited: method = .void
    arg id = .int, reset = .int
    _reset[id] = reset
    return
  meet: method = .int
    arg other = .history
    i = .int
    if size() <> other.size() then return 0
    do i = 1 to size()
      if other.seen(i) = 0 then iterate
      if _seen[i] then _reset[i] = _reset[i] & other.reset(i)
      else do; _seen[i] = 1; _reset[i] = other.reset(i); end
    end
    return 1

/** Facts are bound to one exact frozen target owner and shared graph/access
 * projection. The projection supplies accesses to the existing L liveness
 * solver; this target owner supplies VM-specific transfer and storage facts. */
analysis: class
  _owner = reference .lltarget..module
  _store = reference .llir..arena
  _revision = .int
  _function = .int
  _index = .llirgraph..index
  _access = .llirgraph..access
  _status = .string
  _reason = .string
  _work = .int
  _references = .object[]
  _beforeplain = .object[]
  _domains = .int[]
  _whole = .int[]
  _plain = .int[]
  _reuse = .int[]
  _counts = .int[]
  _first = .int[]
  _body = .int[]
  _return = .int[]
  _actuals = .object[]
  _argumentstorage = .object[]
  _argumentbanks = .string[]
  _globals = .int[]
  _globalfirst = .int
  _context = .string[]
  _calls = .int[]
  _regions = .int[]
  _blocked = .int[]
  _mapping = .int[]
  _windowblocked = .int[]
  _profile = .string
  _active = .int[]
  _owned = .object[]
  _ownedready = .int[]
  _rebinding = .int[]
  _ordered = .int[]
  _selectorordinal = .int[]
  _selectorcount = .int[]
  _selectors = .object[]
  _lastselector = .int
  _returnaction = .string[]
  _swaps = .object[]
  _swapcount = .int[]
  _linear = .object[]
  _linearcount = .int[]
  _runtime = .int[]
  _recordordinal = .int[]
  _recordcount = .int[]
  _retordinal = .int[]
  _retcount = .int[]
  _dagbody = .int[]
  _proofindex = .int[]
  _proofs = .callproof[]
  _cycles = .llirgraph..cycles
  _cyclesready = .int
  _graphmode = .int
  _rootchoice = .int[]
  _rootrestored = .int
  _scopes = .numbers[]
  _scopeslot = .int[]
  _scopestorage = .int[]
  _bytelimit = .int
  _retained = .int
  *: factory
    arg owner = reference .lltarget..module, functionId = .int, profile = 'unknown', work = 1000000, bytes = 67108864, graphmode = 0
    _owner = owner; _function = functionId; _profile = profile; _work = work; _status = 'building'; _reason = ''; _bytelimit = bytes
    _graphmode = graphmode
    return
  spend: method = .int
    arg amount = .int
    if amount < 0 | amount > _work then do; _status = 'limit'; _reason = 'target.facts.work'; return 0; end
    _work = _work - amount
    return 1
  reserve: method = .int
    arg count = .int, width = .int
    if count < 0 | width < 1 then do; _status = 'invalid'; _reason = 'target.facts.dimensions'; return 0; end
    if count > (_bytelimit - _retained) / width then do; _status = 'limit'; _reason = 'target.facts.bytes'; return 0; end
    _retained = _retained + count * width
    return 1
  reject: method = .int
    arg reason = .string
    _status = 'keep'; _reason = reason
    return 0
  /* META scope is lexical address state, independent of whether the
   * declaration's own machine group executes. Resolve its storage later at
   * every feasible point in the scope, including its matching clear. */
  preparescopes: method = .int
    i = .int; j = .int; found = .int; closing = .int; opening = .int
    item = .lltarget..record; name = .lltarget..operand; value = .lltarget..operand
    names = .binary[]; sizes = .int[]; active = .int[]; values = .int[]; empty = .int[]
    module = dereference _owner
    do i = 1 to module.records()
      if spend(1) = 0 then return 0
      item = module.record(i)
      if item.procedureid() <> _function | item.kind() = 'procedure' then iterate
      closing = 0; opening = 0; found = 0
      if item.kind() = '.meta' then do
        name = item.operand(1)
        if spend(name.length()) = 0 then return 0
        do j = 1 to names[0]
          if spend(name.length() + sizes[j] + 1) = 0 then return 0
          if bincompare(names[j],name.bytes()) = 0 then found = j
        end
        closing = item.operands() = 1
        if item.operands() = 4 then do
          value = item.operand(4); opening = value.kind() = 'R'
          if opening then do
            if value.bank() <> 'r' then return reject('graph.external.storage.pending')
            if found = 0 then do
              if reserve(1,32) = 0 | reserve(name.length(),1) = 0 then return 0
              found = names[0] + 1; names[found] = name.bytes(); sizes[found] = name.length()
            end
            active[found] = item.id(); _scopeslot[item.id()] = value.index() + 1
          end
        end
        if opening = 0 & closing = 0 & found > 0 then active[found] = 0
      end
      if spend(active[0]) = 0 | reserve(active[0],16) = 0 | reserve(1,32) = 0 then return 0
      values = empty
      do j = 1 to active[0]
        if active[j] > 0 then values[values[0] + 1] = active[j]
      end
      _scopes[item.id()] = .numbers(values)
      if closing & found > 0 then active[found] = 0
    end
    return 1
  scopeobserve: method = .int
    arg item = .lltarget..record, expose view = .frame, state_ref = reference .cells, observations_ref = reference .int[]
    i = .int; declaration = .int; id = .int
    row_ref = reference _scopes[item.id()]; row = dereference row_ref
    state = dereference state_ref; observations = dereference observations_ref
    if spend(row.size()) = 0 | reserve(row.size(),8) = 0 then return 0
    do i = 1 to row.size()
      declaration = row.at(i)
      value = .lltarget..operand.bound(0,0,0,'r',_scopeslot[declaration] - 1)
      id = view.storage(value)
      if id = 0 then return reject('graph.external.storage.pending')
      if _scopestorage[declaration] = 0 then _scopestorage[declaration] = id
      else if _scopestorage[declaration] <> id then return reject('metadata.binding.change.pending')
      if state.wholeknown(id) = 0 then return reject('metadata.runtime.observer.unproved')
      if spend(observations[0] + 1) = 0 then return 0
      call insert(observations_ref,domain(id,1))
    end
    return 1
  /* Include transient and retained deep copies, not an assumed VM COW path. */
  pathallowance: method = .int
    arg cells = .int, slots = .int
    if reserve(cells,608) = 0 | reserve(slots,128) = 0 | reserve(1,320) = 0 then return 0
    if cells > _work / 76 then do; _status = 'limit'; _reason = 'target.facts.work'; return 0; end
    if spend(cells * 76) = 0 then return 0
    if slots > _work / 16 then do; _status = 'limit'; _reason = 'target.facts.work'; return 0; end
    return spend(slots * 16)
  joinpath: method = .int
    arg cells_ref = reference .cells, frame_ref = reference .frame, history_ref = reference .history, incoming = .cells, incomingframe = .frame, incominghistory = .history
    state = dereference cells_ref; view = dereference frame_ref; previous = dereference history_ref
    if view.compatible(incomingframe) = 0 then return reject('join.binding.unproved')
    if state.meet(incoming) = 0 then return reject('join.storage.unproved')
    if previous.meet(incominghistory) = 0 then return reject('join.history.unproved')
    return 1
  /* Reserve immutable child base identities before any enclosing path copy.
   * Resolving a target here is not activation or acceptance: only a reached
   * invoke proves its body, arguments, depth, signal and scalar contract. */
  preparechildren: method = .int
    arg bodyid = .int, state_ref = reference .cells, history_ref = reference .history, levels = .int
    i = .int; j = .int; id = .int; childid = .int; opid = .int
    item = .lltarget..record; target = .lltarget..operand; child = .lltarget..body
    owned = .int[]; empty = .int[]
    module = dereference _owner; state = dereference state_ref; previous = dereference history_ref
    if levels < 1 then return 1
    do i = 1 to _index.functionoperations(bodyid)
      if spend(1) = 0 then return 0
      opid = _index.functionoperation(bodyid,i)
      if _index.opcode(opid) <= 16 | _index.reachable(_index.opblock(opid)) = 0 then iterate
      item = module.at(opid)
      if item.kind() <> 'instruction' then iterate
      if wordpos(item.mnemonic(),'call call1 call2 call3 call4') = 0 then iterate
      if item.operands() = 1 then target = item.operand(1)
      else target = item.operand(2)
      if target.kind() <> 'P' then iterate
      if spend(module.procedures()) = 0 then return 0
      childid = module.procedureid(target.text())
      if childid = 0 | _active[childid] then iterate
      if _ownedready[childid] = 0 then do
        if spend(module.procedures()) = 0 then return 0
        child = module.body(childid)
        if child.locals() >= _work / 22 then do; _status = 'limit'; _reason = 'target.facts.work'; return 0; end
        if reserve(child.locals() + 1,208) = 0 | reserve(1,32) = 0 then return 0
        if spend((child.locals() + 1) * 22) = 0 then return 0
        owned = empty
        do j = 1 to child.locals() + 1
          id = state.add(); owned[j] = id
        end
        _owned[childid] = .numbers(owned) as .object
        _ownedready[childid] = 1
        call previous.extend(state.size())
      end
      if preparechildren(childid,state_ref,history_ref,levels - 1) = 0 then return 0
    end
    return 1
  /* Transfer into the pointer captured at call entry before deriving the
   * inverse reached permutation. A source r is owned only at its own base. */
  finishreturn: method = .int
    arg item = .lltarget..record, expose view = .frame, expose state = .cells, destination = .int, hasresult = .int, expose proof = .callproof
    i = .int; j = .int; id = .int; displaced = .int; a = .int; b = .int
    value = .lltarget..operand; action = .string; permutation = .int[]; positions = .int[]; left = .int[]; right = .int[]
    if reserve(view.slots(),64) = 0 | reserve(1,128) = 0 then return 0
    if view.slots() > _work / 16 then do; _status = 'limit'; _reason = 'target.facts.work'; return 0; end
    if spend(view.slots() * 16) = 0 then return 0
    action = 'none'
    if hasresult & item.operands() = 1 then do
      value = item.operand(1)
      if value.kind() = 'I' then do; action = 'integer'; call state.integer(destination,1,value.index()); end
      else if value.kind() = 'S' then do
        if state.ordinary(destination) = 0 then return reject('lifetime.hidden.payload.unproved')
        action = 'string'; call state.string(destination)
      end
      else do
        id = view.storage(value)
        if value.bank() = 'r' & id = view.base(value) then do; action = 'move'; call state.move(destination,id); end
        else do; action = 'copy'; call state.copy(destination,id); end
      end
    end
    do i = 1 to view.slots()
      id = view.identityat(i)
      if id < 1 | id > view.slots() then return reject('return.permutation.unproved')
      if positions[id] <> 0 then return reject('return.permutation.unproved')
      permutation[i] = id; positions[id] = i
    end
    do i = 1 to view.slots()
      if permutation[i] = i then iterate
      j = positions[i]; a = view.privateordinal(i - 1); b = view.privateordinal(j - 1)
      if a < 0 | b < 0 then return reject('global.callee.binding.pending')
      left[left[0] + 1] = a; right[right[0] + 1] = b
      displaced = permutation[i]; permutation[j] = displaced; positions[displaced] = j
      permutation[i] = i; positions[i] = i
    end
    call proof.addreturn(_retordinal[item.id()],item.id(),action,left,right)
    return 1
  /* One finite forward pass over the shared graph's DAG order. These rows
   * hold target transfer snapshots; edges and scheduling stay index-owned. */
  dag: method = .int
    arg bodyid = .int, expose entryframe = .frame, expose state = .cells, expose callhistory = .history, destination = .int, hasresult = .int, expose proof = .callproof, expose selectors = .int[], publish = 1, callid = 0, root = 0, depth = 0
    i = .int; b = .int; opid = .int; target = .int; edge = .int; choice = .int; returned = .int; exits = .int; id = .int; j = .int; retid = .int
    incoming = .cells[]; frames = .frame[]; histories = .history[]; present = .int[]
    path = .cells; edgepath = .cells; merged = .cells; view = .frame; item = .lltarget..record; value = .lltarget..operand
    previous = .history; mergedhistory = .history
    source_ref = reference .cells; view_ref = reference .frame; path_ref = reference .cells; pathview_ref = reference .frame
    history_ref = reference .history; pathhistory_ref = reference .history
    name = .string; flow = .int; mask = .int; known = .int; bits = .int; selected = .int
    refinementid = .int; refinementmask = .int
    module = dereference _owner; catalog = .llrxascatalog..catalog()
    if _cyclesready = 0 then do
      _cycles = _index.loops(_work,_bytelimit)
      if _cycles.status() <> 'ok' then do; _status = _cycles.status(); _reason = _cycles.message(); return 0; end
      if spend(_cycles.usedwork()) = 0 | reserve(_cycles.usedbytes(),1) = 0 then return 0
      _cyclesready = 1
    end
    do i = 1 to _index.functionblocks(bodyid)
      if spend(1) = 0 then return 0
      b = _index.functionblock(bodyid,i)
      if _index.reachable(b) then do
        if _cycles.cyclic(_cycles.component(b)) then do
          if root then return reject('root.cfg.cycle.pending')
          return reject('callee.cfg.cycle.pending')
        end
      end
    end
    /* Two invocation levels are already admitted from a root, one from an
     * outer callee. Preallocation follows only those finite static targets;
     * invoke still checks a reached recursion/depth/body before using a row. */
    if preparechildren(bodyid,reference state,reference callhistory,1 - depth + root) = 0 then return 0
    if reserve(_index.blocks(),40) = 0 | pathallowance(state.size(),entryframe.slots()) = 0 then return 0
    b = _index.functionentry(bodyid); source_ref = reference state; view_ref = reference entryframe
    history_ref = reference callhistory
    incoming[b] = snapshot source_ref; frames[b] = snapshot view_ref; histories[b] = snapshot history_ref; present[b] = 1; exits = 0
    do i = 1 to _index.rposize()
      if spend(1) = 0 then return 0
      b = _index.rpo(i)
      if _index.blockfunction(b) <> bodyid | present[b] = 0 then iterate
      if pathallowance(state.size(),entryframe.slots()) = 0 then return 0
      source_ref = reference incoming[b]; view_ref = reference frames[b]; history_ref = reference histories[b]
      path = snapshot source_ref; view = snapshot view_ref; previous = snapshot history_ref
      choice = 0; returned = 0; refinementid = 0; refinementmask = 0; opid = _index.firstop(b)
      do while opid > 0
        if spend(1) = 0 then return 0
        if _index.opcode(opid) <= 16 then do; opid = _index.nextop(opid); iterate; end
        item = module.at(opid); call proof.visit(_recordordinal[opid])
        if root then do
          _runtime[opid] = 1
          do j = 1 to item.registerrefs()
            if spend(1) = 0 then return 0
            value = item.registerref(j)
            if value.bank() <> 'r' then return reject('graph.external.storage.pending')
          end
        end
        if item.kind() = 'instruction' then do
          name = item.mnemonic(); flow = catalog.flow(item.opcode())
          if wordpos(name,'call call1 call2 call3 call4') > 0 then do
            if invoke(item,view,reference path,previous,root,callid,depth + (root = 0),0) = 0 then return 0
            opid = _index.nextop(opid); iterate
          end
          if flow = 1 | flow = 2 then do
            if name = 'br' then choice = 1
            else if name = 'brtpandt' then do
              value = item.operand(3); mask = value.index()
              if mask <> 256 & mask <> 512 & mask <> 768 then return reject('status.mask.unproved')
              value = item.operand(2)
              if value.bank() = 'a' then do
                if value.index() > view.arguments() then return reject('argument.slot.unproved')
              end
              id = view.storage(value)
              if id = 0 then return reject('argument.slot.unproved')
              if globalcell(id) & path.wholeknown(id) = 0 then return reject('global.definition.unproved')
              if path.abiindependent(id) = 0 then return reject('local.recycler.observation.unproved')
              if spend(4) = 0 then return 0
              known = path.abiknown(id); bits = path.abibits(id)
              assembler iand selected,bits,mask
              assembler iand known,known,mask
              if selected <> 0 then choice = 1
              else if known = mask then choice = 2
              if choice = 0 then do; refinementid = id; refinementmask = mask; end
            end
            else if wordpos(name,'brt brf brtf') > 0 then do
              value = item.operand(item.operands()); id = view.storage(value)
              if id = 0 | path.defined(id) = 0 then return reject('branch.condition.unproved')
              if globalcell(id) & path.wholeknown(id) = 0 then return reject('global.definition.unproved')
              if path.known(id) then do
                choice = 2
                if (name = 'brf' & path.value(id) = 0) | (name <> 'brf' & path.value(id) <> 0) then choice = 1
              end
            end
            else return reject('profile.callee.cfg.pending')
            call proof.visit(_recordordinal[opid],choice)
            if root then do
              _rootchoice[opid] = choice
              if step(item,view,reference path,0,1,1,0) = 0 then return 0
            end
          end
          else do
            if flow <> 0 & name <> 'ret' then do
              if root then return reject('graph.exit.pending')
              return reject('profile.callee.exit.pending')
            end
            if root then do
              if catalog.unbounded(item.opcode()) then return reject('graph.physical.observer.pending')
            end
            if step(item,view,reference path,root = 0,root,root | hasresult,0) = 0 then return 0
            if publish & name = 'linkarg' then selectors[_selectorordinal[opid]] = _lastselector
            if publish & wordpos(name,'link unlink swap linkarg') > 0 then _rebinding[callid] = 1
            if name = 'ret' then do
              if root then do
                if exits = 0 then _rootrestored = 1
                _rootrestored = _rootrestored & view.restored()
              end
              if finishreturn(item,view,path,destination,hasresult,proof) = 0 then return 0
              if pathallowance(state.size(),entryframe.slots()) = 0 then return 0
              if exits = 0 then do
                path_ref = reference path; pathhistory_ref = reference previous
                merged = snapshot path_ref; mergedhistory = snapshot pathhistory_ref
              end
              else do
                if merged.meet(path) = 0 then return reject('join.storage.unproved')
                if mergedhistory.meet(previous) = 0 then return reject('join.history.unproved')
              end
              exits = exits + 1; returned = 1
            end
          end
        end
        else if step(item,view,reference path,root = 0,root,root | hasresult,0) = 0 then return 0
        opid = _index.nextop(opid)
      end
      if returned then iterate
      if _index.successors(b) = 0 then return reject('return.missing')
      do edge = 1 to _index.successors(b)
        if spend(1) = 0 then return 0
        if choice > 0 & edge <> choice then iterate
        target = _index.successor(b,edge)
        if pathallowance(state.size(),entryframe.slots()) = 0 then return 0
        if refinementid > 0 then do
          /* This extra status-refined snapshot is distinct from both the
           * immutable predecessor and the ordinary stored incoming copy. */
          if reserve(state.size(),136) = 0 then return 0
          if state.size() > _work / 17 then do; _status = 'limit'; _reason = 'target.facts.work'; return 0; end
          if spend(state.size() * 17) = 0 | spend(1) = 0 then return 0
          path_ref = reference path; edgepath = snapshot path_ref
          call edgepath.refineabi(refinementid,refinementmask,edge = 1)
          source_ref = reference edgepath
        end
        else source_ref = reference path
        if present[target] = 0 then do
          pathview_ref = reference view; pathhistory_ref = reference previous
          incoming[target] = snapshot source_ref; frames[target] = snapshot pathview_ref; histories[target] = snapshot pathhistory_ref; present[target] = 1
        end
        else if refinementid > 0 then do
          if joinpath(reference incoming[target],reference frames[target],reference histories[target],edgepath,view,previous) = 0 then return 0
        end
        else if joinpath(reference incoming[target],reference frames[target],reference histories[target],path,view,previous) = 0 then return 0
      end
    end
    if exits = 0 then return reject('return.missing')
    /* Until the metadata owner proves path-local binding reconciliation,
     * common post-arm closure requires every live open/clear to precede each
     * feasible RET. Detached tails were never visited and cannot count. */
    if root = 0 then do i = 1 to _index.functionoperations(bodyid)
      if spend(1) = 0 then return 0
      opid = _index.functionoperation(bodyid,i)
      if _index.opcode(opid) <= 16 then iterate
      if proof.live(_recordordinal[opid]) = 0 then iterate
      item = module.at(opid)
      if item.kind() <> '.meta' then iterate
      if item.operands() <> 1 & item.operands() <> 4 then iterate
      do j = 1 to proof.returns()
        if spend(1) = 0 then return 0
        retid = proof.site(j)
        if _index.dominates(_index.opblock(opid),_index.opblock(retid)) = 0 then return reject('metadata.scope.cfg.pending')
        if _index.opblock(opid) = _index.opblock(retid) then do
          if _index.opposition(opid) >= _index.opposition(retid) then return reject('metadata.scope.cfg.pending')
        end
      end
    end
    state = merged; callhistory = mergedhistory
    return 1
  /* Cache only the operation order of an already indexed linear CFG. The
   * shared index owns edges/reachability; this is not a second graph. Core
   * entry thunks and detached metadata blocks need not make a scalar body
   * fail its old straight-line proof. */
  linear: method = .int
    arg functionId = .int, reason = .string
    block = .int; visited = .int; recordid = .int; returned = .int; i = .int
    records = .int[]; item = .lltarget..record; operation = .llir..opview
    if _linearcount[functionId] > 0 then return 1
    module = dereference _owner; graph = dereference module.ir(); catalog = .llrxascatalog..catalog()
    if module.normalcfgcomplete(functionId) = 0 then return reject(reason)
    /* Account for transient and retained row storage before materializing it. */
    if reserve(_index.functionoperations(functionId),16) = 0 | reserve(1,32) = 0 then return 0
    block = _index.functionentry(functionId); visited = 0; returned = 0
    do while block > 0
      if spend(1) = 0 then return 0
      if visited >= _index.functionblocks(functionId) then return reject(reason)
      visited = visited + 1; recordid = _index.firstop(block)
      do while recordid > 0
        if spend(1) = 0 then return 0
        operation = graph.operation(recordid)
        if lltarget..isrecord(operation.name()) then do
          item = module.at(recordid)
          if returned then return reject(reason)
          if item.kind() = 'instruction' then do
            if item.mnemonic() = 'ret' then returned = recordid
            else if catalog.flow(item.opcode()) <> 0 then return reject(reason)
          end
          records[records[0] + 1] = recordid
        end
        else if _index.opcode(recordid) > 16 then return reject(reason)
        recordid = _index.nextop(recordid)
      end
      if returned then do
        if _index.successors(block) <> 0 then return reject(reason)
        block = 0
      end
      else do
        if _index.successors(block) <> 1 then return reject(reason)
        block = _index.successor(block,1)
      end
    end
    if returned = 0 then return reject('return.missing')
    /* Ignore only detached zero-width tails. Unreachable instructions or a
     * reachable end anchor still need a later control-flow proof. */
    do i = 1 to _index.functionoperations(functionId)
      if spend(1) = 0 then return 0
      recordid = _index.functionoperation(functionId,i)
      if _index.reachable(_index.opblock(recordid)) then iterate
      operation = graph.operation(recordid)
      if lltarget..isrecord(operation.name()) then do
        item = module.at(recordid)
        /* addressid() searches the remaining source-operation table. Charge
         * its full suffix before asking whether this is an end anchor. */
        if spend(graph.operations() - recordid) = 0 then return 0
        if wordpos(item.kind(),'.srcstep .srcfile .srcline .meta .traceevent') = 0 | item.addressid() <> 0 then return reject(reason)
      end
      else if _index.opcode(recordid) > 16 then return reject(reason)
    end
    if spend(records[0]) = 0 then return 0
    do i = 1 to records[0]; _runtime[records[i]] = 1; end
    _linear[functionId] = .numbers(records) as .object; _linearcount[functionId] = records[0]
    return 1
  globalcell: method = .int
    arg id = .int
    if _globals[0] = 0 then return 0
    return id >= _globalfirst & id - _globalfirst < _globals[0]
  domain: method = .int
    arg id = .int, whole = 0
    if id = 0 then return 0
    if whole then do
      if _whole[id] = 0 then _whole[id] = _access.domain(_function,'rxas.storage.' || id || '.whole')
      return _whole[id]
    end
    if _domains[id] = 0 then _domains[id] = _access.domain(_function,'rxas.storage.' || id || '.integer')
    return _domains[id]
  bindingdomain: method = .int
    arg value = .lltarget..operand, kind = .string
    return _access.domain(_function,'rxas.slot.' || value.bank() || value.index() || '.' || kind)
  /* A set vector uses the existing ordered numeric array representation.
   * Projection.put rejects duplicates, so domain adapters deduplicate here. */
  insert: method = .void
    arg values_ref = reference .int[], id = .int
    values = dereference values_ref
    if id = 0 then return
    do i = 1 to values[0]
      if values[i] = id then return
    end
    values[values[0] + 1] = id
    return
  step: method = .int
    arg item = .lltarget..record, expose view = .frame, state_ref = reference .cells, private = 0, record = 1, returnwhole = 1, history = 1
    i = .int; j = .int; sourceid = .int; destination = .int; rightid = .int; id = .int
    opcode = .int; component = .int; cleared = .int; lhs = .int; rhs = .int
    integerwrite = .int; binaryload = .int; binaryequal = .int
    selected = .int; checked = .int[]; limits = .int[]
    leftlow = .int; lefthigh = .int; rightlow = .int; righthigh = .int; resultlow = .int; resulthigh = .int
    source = .lltarget..operand; bank = .lltarget..operand; reference_value = .lltarget..operand; option = .lltarget..operand
