  runtimeselection: method = .int
    arg guard = .lltarget..record, ordinal = .int, bodyid = .int, expose view = .frame, state_ref = reference .cells, expose previous = .history, destination = .int, hasresult = .int, expose proof = .callproof, publish = .int, callid = .int, outerCallId = .int, depth = .int, tracking = .int, graph = 0
    i = .int; j = .int; k = .int; retid = .int; next = .int; returned = .int; id = .int; selectorid = .int; raw = .int; selected = .int; low = .int; high = .int; offset = .int
    arm = .int; width = .int; bound = .int; childcalls = .int
    state_copy = reference .cells; view_copy = reference .frame; history_copy = reference .history; proof_copy = reference .callproof
    field = .lltarget..operand; selector = .lltarget..operand; target = .lltarget..operand; source = .lltarget..operand
    item = .lltarget..record; operation = .lltarget..record; terminal = .lltarget..record
    row = .numbers
    branchstate = .cells; merged = .cells; branchview = .frame; branchhistory = .history; mergedhistory = .history
    branchproof = .callproof; aggregate = .callproof; cases = .callproof[]; bindings = .int[]; limits = .int[]; checked = .int[]; returns = .int[]
    scopeobservations = .int[]; emptyscopeobservations = .int[]
    state = dereference state_ref; module = dereference _owner
    selector = guard.operand(1)
    if selector.kind() <> 'R' then return 2
    selectorid = view.storage(selector)
    if selectorid = 0 then return 2
    if state.known(selectorid) then return 2
    if graph then do
      row = selectorpath(guard,bodyid)
