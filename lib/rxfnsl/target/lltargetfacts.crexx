/* cREXX License (MIT). RXAS scalar/storage transfers over shared L analyses. */
options levelb
namespace lltargetfacts expose analysis analyse analysegraph arithmetic
import rxfnsb
import llir
import llirgraph
import lltarget
import llrxascatalog

/** Typed numeric row retained as an object; primitive arrays are not boxed. */
numbers: class
  _values = .int[]
  *: factory
    arg values = .int[]
    _values = values
    return
  at: method = .int
    arg ordinal = .int
    if ordinal < 1 | ordinal > _values[0] then assembler signal "ERROR","LL_TARGET_FACTS_ID: numeric row ordinal"
    return _values[ordinal]
  size: method = .int
    return _values[0]

/** This helper proves the checked write succeeds before evaluating it. The VM
 * default OVERFLOW_UNDERFLOW response ignores a failed, unwritten destination;
 * integer equality alone cannot establish return availability or history. */
arithmetic: procedure = .int[]
  arg name = .string, left = .int, right = .int
  constant HIGHEST = 9223372036854775807
  constant LOWEST = -9223372036854775807 - 1
  result = .int[]; result[1] = 0; result[2] = 0
  select name
    when 'iadd' then do
      if right > 0 then do; if left > HIGHEST - right then return result; end
      else if right < 0 then do; if left < LOWEST - right then return result; end
      result[2] = left + right
    end
    when 'isub' then do
      if right < 0 then do; if left > HIGHEST + right then return result; end
      else if right > 0 then do; if left < LOWEST + right then return result; end
      result[2] = left - right
    end
    when 'imult' then do
      if left = 0 | right = 0 then result[2] = 0
      else do
        if left > 0 & right > 0 then do; if left > HIGHEST / right then return result; end
        else if left > 0 & right < 0 then do; if right < LOWEST / left then return result; end
        else if left < 0 & right > 0 then do; if left < LOWEST / right then return result; end
        else do; if left < HIGHEST / right then return result; end
        result[2] = left * right
      end
    end
    otherwise return result
  end
  result[1] = 1
  return result

/** Target transfer state, not a CFG/worklist or allocator. Distinct storage
 * identities never merge merely because their current integer values agree.
 * Only the closed scalar profile below establishes absence of hidden payloads. */
cells: class
  _defined = .int[]
  _known = .int[]
  _values = .int[]
  _plain = .int[]
  _bounded = .int[]
  _low = .int[]
  _high = .int[]
  _abiknown = .int[]
  _abibits = .int[]
  _abiindependent = .int[]
  _wholeknown = .int[]
  _zeroed = .int[]
  /* Availability certifies independent bytes. The second row additionally
   * covers the VM-private and normalization metadata copied by SCOPY. */
  _stringdefined = .int[]
  _stringindependent = .int[]
  _binarydefined = .int[]
  _binaryindependent = .int[]
  _ordinary = .int[]
  _runtimeevent = .int[]
  *: factory
    return
  add: method = .int
    arg defined = 0, known = 0, value = 0
    n = _defined[0] + 1
    _defined[n] = defined; _known[n] = known; _values[n] = value; _plain[n] = 1
    _wholeknown[n] = 1; _zeroed[n] = 0
    _bounded[n] = defined & known; _low[n] = value; _high[n] = value
    _abiknown[n] = 768; _abibits[n] = 0; _abiindependent[n] = 1
    _stringdefined[n] = 1; _stringindependent[n] = 1; _ordinary[n] = 1
    _binarydefined[n] = 1; _binaryindependent[n] = 1
    _runtimeevent[n] = 0
    return n
  defined: method = .int
    arg id = .int
    return _defined[id]
  known: method = .int
    arg id = .int
    return _known[id]
  value: method = .int
    arg id = .int
    return _values[id]
  bounded: method = .int
    arg id = .int
    return _bounded[id]
  low: method = .int
    arg id = .int
    return _low[id]
  high: method = .int
    arg id = .int
    return _high[id]
  plain: method = .int
    arg id = .int
    return _plain[id]
  ordinary: method = .int
    arg id = .int
    return _ordinary[id]
  runtimeevent: method = .int
    arg id = .int
    return _runtimeevent[id]
  stringdefined: method = .int
    arg id = .int
    return _stringdefined[id]
  stringindependent: method = .int
    arg id = .int
    return _stringindependent[id]
  binarydefined: method = .int
    arg id = .int
    return _binarydefined[id]
  binaryindependent: method = .int
    arg id = .int
    return _binaryindependent[id]
  abiknown: method = .int
    arg id = .int
    return _abiknown[id]
  abibits: method = .int
    arg id = .int
    return _abibits[id]
  abiindependent: method = .int
    arg id = .int
    return _abiindependent[id]
  /* Refine a validated branch edge, not the runtime value. No integer,
   * payload, freshness or entry-independence fact changes with the test. */
  refineabi: method = .void
    arg id = .int, mask = .int, taken = .int
    known = .int; bits = .int; other = .int
    known = _abiknown[id]; bits = _abibits[id]
    if taken = 0 | mask <> 768 then do
      other = 768 - mask
      assembler iand known,known,other
      assembler iand bits,bits,other
      known = known + mask
      if taken then bits = bits + mask
      _abiknown[id] = known; _abibits[id] = bits
    end
    /* A true combined test is an OR, not two set bits. Only an already
     * known-clear member identifies which other member must be set. */
    else if bits = 0 & (known = 256 | known = 512) then do
      _abiknown[id] = 768; _abibits[id] = 768 - known
    end
    return
  size: method = .int
    return _defined[0]
  /* Whole-known means entry independence, not identical bits across paths.
   * Exact status knowledge is limited to the separately tracked ABI bits. */
  meet: method = .int
    arg other = .cells
    known = .int; different = .int; same = .int; otherknown = .int; otherbits = .int; bits = .int
    if size() <> other.size() then return 0
    do i = 1 to size()
      _defined[i] = _defined[i] & other.defined(i)
      _bounded[i] = _defined[i] & _bounded[i] & other.bounded(i)
      _known[i] = 0; _values[i] = 0
      if _bounded[i] then do
        if other.low(i) < _low[i] then _low[i] = other.low(i)
        if other.high(i) > _high[i] then _high[i] = other.high(i)
        if _low[i] = _high[i] then do; _known[i] = 1; _values[i] = _low[i]; end
      end
      else do; _low[i] = 0; _high[i] = 0; end
      _plain[i] = _plain[i] & other.plain(i)
      _ordinary[i] = _ordinary[i] & other.ordinary(i)
      _runtimeevent[i] = _runtimeevent[i] & other.runtimeevent(i)
      _stringdefined[i] = _stringdefined[i] & other.stringdefined(i)
      _stringindependent[i] = _stringindependent[i] & other.stringindependent(i)
      _binarydefined[i] = _binarydefined[i] & other.binarydefined(i)
      _binaryindependent[i] = _binaryindependent[i] & other.binaryindependent(i)
      _wholeknown[i] = _wholeknown[i] & other.wholeknown(i)
      _zeroed[i] = _zeroed[i] & other.zeroed(i)
      otherknown = other.abiknown(i); otherbits = other.abibits(i); bits = _abibits[i]
      known = _abiknown[i]
      assembler iand known,known,otherknown
      assembler ixor different,bits,otherbits
      same = 768 - different
      assembler iand known,known,same
      assembler iand bits,bits,known
      _abiknown[i] = known; _abibits[i] = bits
      _abiindependent[i] = _abiindependent[i] & other.abiindependent(i)
    end
    return 1
  wholeknown: method = .int
    arg id = .int
    return _wholeknown[id]
  zeroed: method = .int
    arg id = .int
    return _zeroed[id]
  uncertain: method = .void
    arg id = .int
    /* The scalar profile proves no native/reference payload was created.
     * Recycled ordinary components/status still cannot be assumed fresh. */
    _defined[id] = 0; _known[id] = 0; _wholeknown[id] = 0; _zeroed[id] = 0
    _bounded[id] = 0; _low[id] = 0; _high[id] = 0
    _abiknown[id] = 0; _abibits[id] = 0; _abiindependent[id] = 0
    _stringdefined[id] = 0; _stringindependent[id] = 0
    _binarydefined[id] = 0; _binaryindependent[id] = 0
    _runtimeevent[id] = 0
    return
  /** Whole VM overwrite at an executable SIGBRV predecessor. The wrapper
   * carries owned arbitrary payloads, never scalar or reusable-cell proof. */
  event: method = .void
    arg id = .int
    call uncertain(id)
    _plain[id] = 0; _ordinary[id] = 0; _runtimeevent[id] = 1
    return
  /** Raw code/name are freshly built ordinary fields; message copies only
   * bytes/metadata from an arbitrary payload's string view. Its integer,
   * public flags, ownership and string certificates are not inferred. */
  eventfield: method = .void
    arg id = .int, kind = .int
    if kind = 5 then do
      _stringdefined[id] = 1; _stringindependent[id] = 0
      _plain[id] = 0; _wholeknown[id] = 0; _zeroed[id] = 0
    end
    else do
      call reset(id)
      if kind = 1 then call integer(id,0)
      else call string(id)
    end
    return
  integer: method = .void
    arg id = .int, known = .int, value = 0
    _defined[id] = 1; _known[id] = known; _values[id] = value; _zeroed[id] = 0
    _bounded[id] = known; _low[id] = value; _high[id] = value
    return
  /* Successful arithmetic changes only its integer component. Bounds are
   * not a whole-cell equality, status, freshness or lifetime assertion. */
  interval: method = .void
    arg id = .int, low = .int, high = .int
    if low > high then do
      assembler signal "ERROR","LL_TARGET_FACTS_DIMENSIONS: inverted integer bounds"; return
    end
    _defined[id] = 1; _bounded[id] = 1; _low[id] = low; _high[id] = high; _zeroed[id] = 0
    _known[id] = low = high; _values[id] = 0
    if _known[id] then _values[id] = low
    return
  reset: method = .void
    arg id = .int
    _defined[id] = 1; _known[id] = 1; _values[id] = 0; _plain[id] = 1
    _wholeknown[id] = 1; _zeroed[id] = 1
    _bounded[id] = 1; _low[id] = 0; _high[id] = 0
    _abiknown[id] = 768; _abibits[id] = 0; _abiindependent[id] = 1
    _stringdefined[id] = 1; _stringindependent[id] = 1; _ordinary[id] = 1
    _binarydefined[id] = 1; _binaryindependent[id] = 1
    _runtimeevent[id] = 0
    return
  copy: method = .void
    arg destination = .int, source = .int, whole = 1
    _defined[destination] = _defined[source]; _known[destination] = _known[source]; _values[destination] = _values[source]
    _bounded[destination] = _bounded[source]; _low[destination] = _low[source]; _high[destination] = _high[source]
    if whole then do
      _plain[destination] = _plain[source]
      _ordinary[destination] = _ordinary[source]
      _runtimeevent[destination] = _runtimeevent[source]
      _stringdefined[destination] = _stringdefined[source]
      _stringindependent[destination] = _stringindependent[source]
      _binarydefined[destination] = _binarydefined[source]
      _binaryindependent[destination] = _binaryindependent[source]
      _abiknown[destination] = _abiknown[source]; _abibits[destination] = _abibits[source]
      _abiindependent[destination] = _abiindependent[source]
      _wholeknown[destination] = _wholeknown[source]; _zeroed[destination] = _zeroed[source]
    end
    else _zeroed[destination] = 0
    return
  move: method = .void
    arg destination = .int, source = .int
    if destination = source then return
    call copy(destination,source)
    call reset(source)
    return
  status: method = .void
    arg id = .int, flags = .int
    publicbits = .int; abi = .int
    /* rxflags_public_write: public bits are 8..30, compiler ABI is 8..9.
     * Masking also performs the VM's uint32_t truncation for these bands.
     * A nonzero request in another band leaves the compiler band intact. */
    assembler iand publicbits,flags,2147483392
    assembler iand abi,flags,768
    if publicbits = 0 then do; _abiknown[id] = 768; _abibits[id] = 0; _abiindependent[id] = 1; end
    else if abi <> 0 then do; _abiknown[id] = 768; _abibits[id] = abi; _abiindependent[id] = 1; end
    _zeroed[id] = 0
    return
  statuscopy: method = .void
    arg destination = .int, source = .int
    /* ACOPY copies the native full status word. Only its ABI subfacts are
     * interpreted here; no integer/payload or whole-known proof follows from
     * ABI knowledge alone. Preserve the instruction for all other bands. */
    _abiknown[destination] = _abiknown[source]; _abibits[destination] = _abibits[source]
    _abiindependent[destination] = _abiindependent[source]
    _wholeknown[destination] = _wholeknown[destination] & _wholeknown[source]
    /* Bytes remain available, but ACOPY replaces the string's VM-private
     * and normalization certificates along with every other status band. */
    _stringindependent[destination] = _stringdefined[destination] & _stringindependent[source]
    _zeroed[destination] = 0
    return
  string: method = .void
    arg id = .int
    _plain[id] = 0; _zeroed[id] = 0
    _stringdefined[id] = 1; _stringindependent[id] = 1
    return
  copystring: method = .void
    arg destination = .int, source = .int
    if destination = source then return
    _stringdefined[destination] = _stringdefined[source]
    _stringindependent[destination] = _stringindependent[source]
    _plain[destination] = 0; _zeroed[destination] = 0
    _wholeknown[destination] = _wholeknown[destination] & _stringindependent[source]
    return
  binary: method = .void
    arg id = .int
    /* Only the normal successor of the retained LOAD establishes bytes.
     * Clearing VM-private flags preserves any existing certificate proof;
     * it cannot establish unknown integer, public status or string facts. */
    _binarydefined[id] = 1; _binaryindependent[id] = 1
    _plain[id] = 0; _zeroed[id] = 0
    return
  copybinary: method = .void
    arg destination = .int, source = .int
    if destination = source then return
    _binarydefined[destination] = _binarydefined[source]
    _binaryindependent[destination] = _binaryindependent[source]
    _plain[destination] = 0; _zeroed[destination] = 0
    _wholeknown[destination] = _wholeknown[destination] & _binaryindependent[source]
    return

frame: class
  _map = .int[]
  _base = .int[]
  _identity = .int[]
  _locals = .int
  _globals = .int
  _arguments = .int
  _context = .string
  *: factory
    arg owner = reference .cells, locals = .int, actuals = .int[], fresh = 0, context = '', ?owned = .int[], ?globals = .int[]
    i = .int; id = .int; at = .int
    state = dereference owner; _locals = locals; _arguments = actuals[0]; _context = context
    _globals = 0
    if ?globals then _globals = globals[0]
    do i = 1 to locals
      if ?owned then id = owned[i]
      else id = state.add(fresh,fresh,0)
      _map[i] = id; _base[i] = id; _identity[i] = i
    end
    do i = 1 to _globals
      at = locals + i; id = globals[i]
      _map[at] = id; _base[at] = id; _identity[at] = at
    end
    if ?owned then do
      id = owned[locals + 1]; call state.reset(id); call state.integer(id,1,actuals[0])
    end
    else id = state.add(1,1,actuals[0])
    at = locals + _globals + 1; _map[at] = id; _base[at] = id; _identity[at] = at
    do i = 1 to actuals[0]
      at = locals + _globals + 1 + i; _map[at] = actuals[i]; _base[at] = actuals[i]; _identity[at] = at
    end
    return
  position: method = .int
    arg value = .lltarget..operand
    if value.kind() <> 'R' then return 0
    if value.bank() = 'r' & value.index() < _locals then return value.index() + 1
    if value.bank() = 'g' & value.index() < _globals then return _locals + value.index() + 1
    if value.bank() = 'a' & value.index() <= _arguments then return _locals + _globals + value.index() + 1
    return 0
  slots: method = .int
    return _locals + _globals + _arguments + 1
  arguments: method = .int
    return _arguments
  argument: method = .lltarget..operand
    arg index = .int
    if index < 0 | index > _arguments then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: captured argument-bank index"
      return .lltarget..operand.integer(0)
    end
    return .lltarget..operand.bound(0,0,0,'a',index)
  slot: method = .lltarget..operand
    arg ordinal = .int
    if ordinal < 0 | ordinal >= slots() then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: physical frame slot ordinal"
      return .lltarget..operand.integer(0)
    end
    if ordinal < _locals then return .lltarget..operand.bound(0,0,0,'r',ordinal)
    if ordinal < _locals + _globals then return .lltarget..operand.bound(0,0,0,'g',ordinal - _locals)
    return .lltarget..operand.bound(0,0,0,'a',ordinal - _locals - _globals)
  storage: method = .int
    arg value = .lltarget..operand
    at = position(value)
    if at = 0 then return 0
    return _map[at]
  base: method = .int
    arg value = .lltarget..operand
    at = position(value)
    if at = 0 then return 0
    return _base[at]
  baseat: method = .int
    arg position = .int
    if position < 1 | position > _base[0] then assembler signal "ERROR","LL_TARGET_FACTS_ID: frame base ordinal"
    return _base[position]
  identityat: method = .int
    arg position = .int
    return _identity[position]
  compatible: method = .int
    arg other = .frame
    if slots() <> other.slots() | _arguments <> other.arguments() | _context <> other.context() then return 0
    do i = 1 to slots()
      if _base[i] <> other.baseat(i) | _identity[i] <> other.identityat(i) then return 0
      if _map[i] <> other.storage(slot(i - 1)) then return 0
    end
    return 1
  privateordinal: method = .int
    arg physical = .int
    if physical < _locals then return physical
    if physical < _locals + _globals then return -1
    return physical - _globals
  ownedbase: method = .int
    arg ordinal = .int
    if ordinal < 1 | ordinal > _locals + 1 then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: owned base ordinal"
      return 0
    end
    if ordinal <= _locals then return _base[ordinal]
    return _base[_locals + _globals + 1]
  globalcanonical: method = .int
    at = .int
    do i = 1 to _globals
      at = _locals + i
      if _map[at] <> _base[at] | _identity[at] <> at then return 0
    end
    return 1
  link: method = .void
    arg destination = .lltarget..operand, source = .lltarget..operand
    _map[position(destination)] = storage(source)
    return
  unlink: method = .void
    arg destination = .lltarget..operand
    at = position(destination); _map[at] = _base[at]
    return
  swap: method = .void
    arg left = .lltarget..operand, right = .lltarget..operand
    a = position(left); b = position(right)
    id = _map[a]; _map[a] = _map[b]; _map[b] = id
    id = _identity[a]; _identity[a] = _identity[b]; _identity[b] = id
    return
  canonical: method = .int
    do i = 1 to _identity[0]
      if _identity[i] <> i then return 0
    end
    return 1
  restored: method = .int
    do i = 1 to _identity[0]
      if _identity[i] <> i | _map[i] <> _base[i] then return 0
    end
    return 1
  context: method = .string
    return _context
  numeric: method = .void
    arg value = .string
    _context = value
    return

/** Transient owned normalization, never an authored proof or a graph owner.
 * Slots are zero-based physical ordinals in the current r/g/a frame;
 * storage IDs capture its active pointers before the selected call enters. */
callshape: class
  _body = .int
  _form = .string
  _count = .int
  _first = .int
  _result = .int
  _clear = .int
  _countstorage = .int
  _slots = .int[]
  _actuals = .int[]
  *: factory
    arg body = 0, form = '', count = 0, first = 0, result = 0, clear = 0, countstorage = 0, ?slots = .int[], ?actuals = .int[]
    _body = body; _form = form; _count = count; _first = first; _result = result; _clear = clear; _countstorage = countstorage
    if ?slots then _slots = slots
    if ?actuals then _actuals = actuals
    return
  valid: method = .int
    return _body > 0
  body: method = .int
    return _body
  form: method = .string
    return _form
  count: method = .int
    return _count
  first: method = .int
    return _first
  result: method = .int
    return _result
  clear: method = .int
    return _clear
  countstorage: method = .int
    return _countstorage
  slot: method = .int
    arg ordinal = .int
    return _slots[ordinal]
  storage: method = .int
    arg ordinal = .int
    return _actuals[ordinal]

/** Compact, internally authored per-call rows. Keys are callee source/RET
 * ordinals; no mutable state or caller-authored proof escapes the analysis. */
callproof: class
  _live = .int[]
  _choice = .int[]
  _sites = .int[]
  _ordinals = .int[]
  _action = .string[]
  _left = .numbers[]
  _right = .numbers[]
  _restoreknown = .int[]
  _written = .int
  _writeinteger = .int
  _killinteger = .int
  _killwhole = .int
  *: factory
    arg records = .int, returns = .int
    i = .int
    do i = 1 to records; _live[i] = 0; _choice[i] = 0; end
    do i = 1 to returns; _action[i] = ''; end
    return
  live: method = .int
    arg ordinal = .int
    return _live[ordinal]
  visit: method = .void
    arg ordinal = .int, choice = 0
    _live[ordinal] = 1; _choice[ordinal] = choice
    return
  choice: method = .int
    arg ordinal = .int
    return _choice[ordinal]
  addreturn: method = .void
    arg ordinal = .int, site = .int, action = .string, left = .int[], right = .int[]
    if _sites[0] = 0 then do; _killinteger = 1; _killwhole = 1; end
    _sites[_sites[0] + 1] = site; _ordinals[_sites[0]] = ordinal; _action[ordinal] = action
    _left[ordinal] = .numbers(left); _right[ordinal] = .numbers(right)
    _restoreknown[ordinal] = 1
    _written = _written | (action <> 'none')
    _writeinteger = _writeinteger | (action = 'integer' | action = 'copy' | action = 'move')
    _killinteger = _killinteger & (action = 'integer' | action = 'copy' | action = 'move')
    _killwhole = _killwhole & (action = 'copy' | action = 'move')
    return
  /** Absorb a complete case once. Missing RETs are infeasible, never NONE. */
  caseexit: method = .int
    arg incoming_ref = reference .callproof
    incoming = dereference incoming_ref; i = .int; j = .int; ordinal = .int; site = .int
    first = .int; written = .int; integer = .int; killinteger = .int; killwhole = .int
    left = .int[]; right = .int[]; empty = .int[]
    if _live[0] <> incoming.records() then return 0
    if incoming.returns() = 0 then return 0
    first = _sites[0] = 0; written = _written; integer = _writeinteger
    killinteger = _killinteger; killwhole = _killwhole
    do i = 1 to _live[0]
      if incoming.live(i) = 0 then iterate
      if _live[i] & _choice[i] <> incoming.choice(i) then _choice[i] = 0
      else if _live[i] = 0 then _choice[i] = incoming.choice(i)
      _live[i] = 1
    end
    do i = 1 to incoming.returns()
      ordinal = incoming.ordinal(i); site = incoming.site(i)
      if ordinal < 1 | ordinal > _action[0] then return 0
      if _action[ordinal] = '' then do
        left = empty; right = empty
        do j = 1 to incoming.restores(ordinal)
          left[j] = incoming.left(ordinal,j); right[j] = incoming.right(ordinal,j)
        end
        call addreturn(ordinal,site,incoming.action(ordinal),left,right)
      end
      else do
        if _left[ordinal].size() <> incoming.restores(ordinal) then _restoreknown[ordinal] = 0
        else do j = 1 to incoming.restores(ordinal)
          if _left[ordinal].at(j) <> incoming.left(ordinal,j) | _right[ordinal].at(j) <> incoming.right(ordinal,j) then _restoreknown[ordinal] = 0
        end
        if _action[ordinal] <> incoming.action(ordinal) then _action[ordinal] = 'cases'
      end
    end
    if first then do
      _written = incoming.written(); _writeinteger = incoming.writeinteger()
      _killinteger = incoming.killinteger(); _killwhole = incoming.killwhole()
    end
    else do
      _written = written | incoming.written(); _writeinteger = integer | incoming.writeinteger()
      _killinteger = killinteger & incoming.killinteger(); _killwhole = killwhole & incoming.killwhole()
    end
    return 1
  orderreturns: method = .void
    i = .int; j = .int; site = .int; ordinal = .int
    do i = 2 to _sites[0]
      site = _sites[i]; ordinal = _ordinals[i]; j = i
      do while j > 1
        if _sites[j - 1] <= site then leave
        _sites[j] = _sites[j - 1]; _ordinals[j] = _ordinals[j - 1]; j = j - 1
      end
      _sites[j] = site; _ordinals[j] = ordinal
    end
    return
  records: method = .int
    return _live[0]
  returns: method = .int
    return _sites[0]
  site: method = .int
    arg ordinal = .int
    return _sites[ordinal]
  ordinal: method = .int
    arg ordinal = .int
    return _ordinals[ordinal]
  action: method = .string
    arg ordinal = .int
    return _action[ordinal]
  restores: method = .int
    arg ordinal = .int
    if _restoreknown[ordinal] = 0 then assembler signal "ERROR","LL_TARGET_FACTS_RETURN: case-aware restoration required"
    return _left[ordinal].size()
  left: method = .int
    arg ordinal = .int, pair = .int
    if _restoreknown[ordinal] = 0 then assembler signal "ERROR","LL_TARGET_FACTS_RETURN: case-aware restoration required"
    return _left[ordinal].at(pair)
  right: method = .int
    arg ordinal = .int, pair = .int
    if _restoreknown[ordinal] = 0 then assembler signal "ERROR","LL_TARGET_FACTS_RETURN: case-aware restoration required"
    return _right[ordinal].at(pair)
  written: method = .int
    return _written
  writeinteger: method = .int
    return _writeinteger
  killinteger: method = .int
    return _killinteger
  killwhole: method = .int
    return _killwhole

/** One activation's finite checked selector alternatives. Each arm owns its
 * original RET proof; no divergent active map is collapsed into a frame. */
selection: class
  _guard = .int
  _operation = .int
  _low = .int
  _offset = .int
  _bindings = .int[]
  _proofs = .callproof[]
  *: factory
    arg guard = .int, operation = .int, low = .int, offset = .int, bindings = .int[], proofs = .callproof[]
    _guard = guard; _operation = operation; _low = low; _offset = offset; _bindings = bindings; _proofs = proofs
    return
  guard: method = .int
    return _guard
  operation: method = .int
    return _operation
  returns: method = .int
    arg ordinal = .int
    proof_ref = reference _proofs[ordinal]; proof = dereference proof_ref
    return proof.returns()
  site: method = .int
    arg ordinal = .int, returned = .int
    proof_ref = reference _proofs[ordinal]; proof = dereference proof_ref
    return proof.site(returned)
  singleton: method = .int
    arg ordinal = .int
    proof_ref = reference _proofs[ordinal]; proof = dereference proof_ref
    if proof.returns() <> 1 then do
      assembler signal "ERROR","LL_TARGET_FACTS_RETURN: use case-and-RET facts"; return 0
    end
    return proof.site(1)
  count: method = .int
    return _bindings[0]
  raw: method = .int
    arg ordinal = .int
    return _low + (ordinal - 1)
  selected: method = .int
    arg ordinal = .int
    return raw(ordinal) + _offset
  storage: method = .int
    arg ordinal = .int
    return _bindings[ordinal]
  live: method = .int
    arg ordinal = .int, record = .int
    proof_ref = reference _proofs[ordinal]; proof = dereference proof_ref
    return proof.live(record)
  choice: method = .int
    arg ordinal = .int, record = .int
    proof_ref = reference _proofs[ordinal]; proof = dereference proof_ref
    return proof.choice(record)
  action: method = .string
    arg ordinal = .int, returned = .int
    proof_ref = reference _proofs[ordinal]; proof = dereference proof_ref
    return proof.action(returned)
  restores: method = .int
    arg ordinal = .int, returned = .int
    proof_ref = reference _proofs[ordinal]; proof = dereference proof_ref
    return proof.restores(returned)
  left: method = .int
    arg ordinal = .int, returned = .int, pair = .int
    proof_ref = reference _proofs[ordinal]; proof = dereference proof_ref
    return proof.left(returned,pair)
  right: method = .int
    arg ordinal = .int, returned = .int, pair = .int
    proof_ref = reference _proofs[ordinal]; proof = dereference proof_ref
    return proof.right(returned,pair)

/** Conditional last-exit guarantees for procedure-owned bases. All bases of
 * an activation, including a0, are marked together. A never-activated path is
 * neutral at a meet: its first entry is fresh, not a recycled unreset value.
 * Owned StorageIds are immutable analysis data; these rows are path data. */
history: class
  _seen = .int[]
  _reset = .int[]
  *: factory
    return
  extend: method = .void
    arg cells = .int
    i = .int
    do i = _seen[0] + 1 to cells; _seen[i] = 0; _reset[i] = 0; end
    return
  size: method = .int
    return _seen[0]
  seen: method = .int
    arg id = .int
    return _seen[id]
  reset: method = .int
    arg id = .int
    return _reset[id]
  activated: method = .void
    arg id = .int
    _seen[id] = 1
    return
  exited: method = .void
    arg id = .int, reset = .int
    _reset[id] = reset
    return
  meet: method = .int
    arg other = .history
    i = .int
    if size() <> other.size() then return 0
    do i = 1 to size()
      if other.seen(i) = 0 then iterate
      if _seen[i] then _reset[i] = _reset[i] & other.reset(i)
      else do; _seen[i] = 1; _reset[i] = other.reset(i); end
    end
    return 1

/** Facts are bound to one exact frozen target owner and shared graph/access
 * projection. The projection supplies accesses to the existing L liveness
 * solver; this target owner supplies VM-specific transfer and storage facts. */
analysis: class
  _owner = reference .lltarget..module
  _store = reference .llir..arena
  _revision = .int
  _function = .int
  _index = .llirgraph..index
  _access = .llirgraph..access
  _status = .string
  _reason = .string
  _work = .int
  _references = .object[]
  _beforeplain = .object[]
  _domains = .int[]
  _whole = .int[]
  _plain = .int[]
  _reuse = .int[]
  _counts = .int[]
  _first = .int[]
  _body = .int[]
  _return = .int[]
  _actuals = .object[]
  _argumentstorage = .object[]
  _argumentbanks = .string[]
  _globals = .int[]
  _globalfirst = .int
  _context = .string[]
  _calls = .int[]
  _regions = .int[]
  _blocked = .int[]
  _mapping = .int[]
  _windowblocked = .int[]
  _profile = .string
  _active = .int[]
  _owned = .object[]
  _ownedready = .int[]
  _rebinding = .int[]
  _ordered = .int[]
  _selectorordinal = .int[]
  _selectorcount = .int[]
  _selectors = .object[]
  _lastselector = .int
  _selectioncount = .int[]
  _selections = .selection[]
  _returnaction = .string[]
  _swaps = .object[]
  _swapcount = .int[]
  _linear = .object[]
  _linearcount = .int[]
  _runtime = .int[]
  _recordordinal = .int[]
  _recordcount = .int[]
  _retordinal = .int[]
  _retcount = .int[]
  _dagbody = .int[]
  _proofindex = .int[]
  _proofs = .callproof[]
  _cycles = .llirgraph..cycles
  _cyclesready = .int
  _graphmode = .int
  _rootchoice = .int[]
  _rootrestored = .int
  _scopes = .numbers[]
  _scopeslot = .int[]
  _scopestorage = .int[]
  _inlinescopesite = .int[]
  _inlinescopedeclaration = .int[]
  _inlinescopestorage = .int[]
  _scopechecked = .int[]
  _scopeindexed = .int[]
  _scopeselector = .int[]
  _scopereentry = .int[]
  _scopeaddress = .int[]
  _scopeincoming = .numbers[]
  _scopeobserved = .numbers[]
  _bytelimit = .int
  _retained = .int
  /* Analysis-private two-path overlay. Original source identities remain the
   * only target model; these rows never make its normal CFG complete. */
  _namedpush = .int
  _namedinstall = .int
  _namedcall = .int
  _namednormalpop = .int
  _namednormalbr = .int
  _namedhandler = .int
  _namedhandlerpop = .int
  _namedhandlerbr = .int
  _namedjoin = .int
  _namedcheck = .int
  _namedlow = .int
  _namedhigh = .int
  /* Feasible continuations: 1 normal, 2 handler, 3 both. */
  _namedoutcome = .int
  _namedactive = .int
  _namedcatchall = .int
  _namedbound = .int
  _boundevent = .int
  _boundraw = .int
  _boundfield = .int
  _boundoutputs = .int[]
  _boundphases = .int[]
  _boundkinds = .int[]
  _boundclear = .int
  _boundlastpop = .int
  _boundreset = .int[]
  _snapshotcopy = .int
  _snapshotowner = .int
  _snapshotclear = .int
  _snapshotcount = .int
  _snapshotmove = .int
  _snapshotlifetimes = .int[]
  /* Private correlation, validated against one frozen join/guard/closure.
   * It preserves predecessor snapshots, never recreates an event from a flag. */
  _ownerlane = .int
  _ownerguard = .int
  _ownerflag = .int
  _ownerflagreset = .int
  _ownerflaginit = .int
  _ownercommit = .int
  _ownerclose = .int
  _ownerfinalevent = .int
  *: factory
    arg owner = reference .lltarget..module, functionId = .int, profile = 'unknown', work = 1000000, bytes = 67108864, graphmode = 0
    _owner = owner; _function = functionId; _profile = profile; _work = work; _status = 'building'; _reason = ''; _bytelimit = bytes
    _graphmode = graphmode
    return
  spend: method = .int
    arg amount = .int
    if amount < 0 | amount > _work then do; _status = 'limit'; _reason = 'target.facts.work'; return 0; end
    _work = _work - amount
    return 1
  reserve: method = .int
    arg count = .int, width = .int
    if count < 0 | width < 1 then do; _status = 'invalid'; _reason = 'target.facts.dimensions'; return 0; end
    if count > (_bytelimit - _retained) / width then do; _status = 'limit'; _reason = 'target.facts.bytes'; return 0; end
    _retained = _retained + count * width
    return 1
  reject: method = .int
    arg reason = .string
    _status = 'keep'; _reason = reason
    return 0
  namedtag: method = .int
    arg name = .string
    /* Recognize the emitted explicit list, never an ANY proof annotation.
     * These are source spellings, not copied VM signal/opcode identities. */
    if _namedcatchall & wordpos(name,'FAILURE ERROR OVERFLOW_UNDERFLOW DIVISION_BY_ZERO CONVERSION_ERROR INVALID_ARGUMENTS OUT_OF_RANGE UNICODE_ERROR REFERENCE_INVALID OBJECT_NOT_INITIALIZED RXBIN_CORRUPTION UNKNOWN_INSTRUCTION FUNCTION_NOT_FOUND NOT_IMPLEMENTED INVALID_SIGNAL_CODE NOTREADY CANCEL QUIT TERM POSIX_INT POSIX_HUP POSIX_USR1 POSIX_USR2 POSIX_CHLD CHANNEL_ERROR TASK_FAILURE CLASSIC_SYNTAX CLASSIC_CONDITION OTHER') > 0 then return 1
    if name = 'OUT_OF_RANGE' | name = 'INVALID_ARGUMENTS' then return 1
    if name = 'FAILURE' then return reject('signal.activation.failure.pending')
    if wordpos(name,'KILL CANCEL QUIT TERM POSIX_INT POSIX_HUP POSIX_USR1 POSIX_USR2 POSIX_CHLD NOTREADY OTHER BREAKPOINT') > 0 then return reject('signal.asynchronous.tag.pending')
    if name = 'CHANNEL_ERROR' | name = 'TASK_FAILURE' then return reject('signal.event.delivery.pending')
    return reject('signal.named.tag.pending')
  /** Recognize one complete source-authored G-shaped scope. No user proof,
   * target-schema mutation or exceptional edge is added to the normal index. */
  namedshape: method = .int
    i = .int; j = .int; found = .int; policies = .int; labels = .int; calls = .int; pops = .int; branches = .int; returns = .int
    installs = .int; range = .int; lastpush = .int; firstinstall = .int; pushes = .int
    handler = .string; joined = .string; name = .string; policy = .string
    tags = .string[]; installed = .int[]; poptags = .string[]; popids = .int[]
    item = .lltarget..record; field = .lltarget..operand; target = .lltarget..operand
    module = dereference _owner; catalog = .llrxascatalog..catalog()
    do i = 1 to module.records()
      if spend(1) = 0 then return 0
      item = module.record(i)
      if item.procedureid() <> _function | item.kind() <> 'instruction' then iterate
      if left(item.mnemonic(),3) = 'sig' then policies = policies + 1
      if item.mnemonic() = 'sigpush' then pushes = pushes + 1
      if item.mnemonic() = 'sigbrv' then do
        _namedbound = 1; field = item.operand(2)
        if _boundevent = 0 & field.bank() = 'r' then _boundevent = field.index() + 1
      end
    end
    if policies = 0 then return 1
    _namedcatchall = pushes >= 29
    if _namedbound & _namedcatchall = 0 then return reject('signal.bound.handler.pending')
    if _graphmode then return reject('signal.exceptional.cfg.pending')
    if _profile <> 'closed-main-default-halt.v1' then return reject('signal.named.profile.pending')
    if module.globals() <> 0 then return reject('signal.global.storage.pending')
    if _namedbound then do
      if findsnapshot() = 0 then return 0
    end
    if reserve(14,16) = 0 then return 0
    do i = 1 to module.records()
      if spend(1) = 0 then return 0
      item = module.record(i)
      if item.kind() = '.meta' & item.operands() > 1 then do
        field = item.operand(2)
        if left(field.text(),1) = '.' & field.text() <> '.inline' then return reject('signal.startup.observer.pending')
      end
      if item.procedureid() <> _function | item.kind() = 'procedure' then iterate
      if item.kind() = 'label' then do; labels = labels + 1; iterate; end
      if item.kind() <> 'instruction' then iterate
      name = item.mnemonic(); policy = name
      if name = 'sigbrv' then policy = 'sigbr'
      select policy
        when 'sigpush' then do
          if installs > 0 then return reject('signal.named.push.order.pending')
          if calls > 0 | pops > 0 | branches > 0 then return reject('signal.nested.scope.pending')
          field = item.operand(1)
          if namedtag(field.text()) = 0 then return 0
          if spend(tags[0]) = 0 then return 0
          do j = 1 to tags[0]
            if tags[j] = field.text() then return reject('signal.named.push.duplicate.pending')
          end
          /* The complete catch-all is bounded at the emitter's 29 distinct
           * names; a smaller list retains the existing synchronous profile. */
          if reserve(1,64) = 0 | reserve(field.length(),1) = 0 then return 0
          j = tags[0] + 1; tags[j] = field.text(); installed[j] = 0
          if field.text() = 'OUT_OF_RANGE' then range = 1
          if _namedpush = 0 then _namedpush = item.id()
          lastpush = item.id()
        end
        when 'sigbr' then do
          if calls > 0 | pops > 0 | branches > 0 then return reject('signal.nested.scope.pending')
          target = item.operand(1)
          if _namedbound then do
            if name <> 'sigbrv' then return reject('signal.bound.handler.pending')
            field = item.operand(2)
            if field.kind() <> 'R' | field.bank() <> 'r' then return boundreject('mapping')
            if _boundevent > 0 & _boundevent <> field.index() + 1 then return boundreject('mapping')
            _boundevent = field.index() + 1; field = item.operand(3)
          end
          else field = item.operand(2)
          if namedtag(field.text()) = 0 then return 0
          found = 0
          if spend(tags[0]) = 0 then return 0
          do j = 1 to tags[0]
            if tags[j] = field.text() then found = j
          end
          if found = 0 then return reject('signal.named.install.mismatch.pending')
          if installed[found] then return reject('signal.named.install.duplicate.pending')
          if installs > 0 & target.text() <> handler then return reject('signal.handler.mismatch.pending')
          installed[found] = 1; installs = installs + 1
          if firstinstall = 0 then firstinstall = item.id()
          handler = target.text(); _namedinstall = item.id()
        end
        when 'sigpop' then do
          field = item.operand(1)
          if namedtag(field.text()) = 0 then return 0
          if reserve(1,24) = 0 | reserve(field.length(),1) = 0 then return 0
          pops = pops + 1
          poptags[pops] = field.text(); popids[pops] = item.id()
          if pops > 2 * tags[0] then return reject('signal.named.pop.count.pending')
        end
        when 'sigret' then return reject('signal.inherited.return.pending')
        when 'br' then do
          field = item.operand(1); branches = branches + 1
          if branches = 1 then do; _namednormalbr = item.id(); joined = field.text(); end
          else if branches = 2 & field.text() = joined then _namedhandlerbr = item.id()
          else return reject('signal.named.join.pending')
        end
        when 'brf' then do
          if _ownerlane = 0 | item.id() <> _ownerguard then return reject('signal.owner.guard.pending')
        end
        when 'call1' then do; calls = calls + 1; _namedcall = item.id(); end
        when 'ret' then returns = returns + 1
        otherwise do
          if _namedbound & wordpos(name,'linkattr1 unlink scopy') > 0 then iterate
          if _snapshotcopy > 0 & (name = 'endlife' | item.id() = _snapshotcopy) then iterate
          if _ownerlane & catalog.flow(item.opcode()) = 2 then return reject('signal.owner.guard.pending')
          if left(name,3) = 'sig' then return reject('signal.caller.policy.pending')
          if wordpos(name,'call call2 call3 call4 swapcall settpcall settpswapcall dcall') > 0 then return reject('signal.call.window.pending')
          if _namedbound & wordpos(name,'link swap swapn linkarg') > 0 then return boundreject('mapping')
          if _snapshotcopy > 0 & wordpos(name,'mkref deref linkref setref setattrs') > 0 then return reject('signal.snapshot.mapping.pending')
          if wordpos(name,'link unlink swap swapn linkarg') > 0 then return reject('signal.caller.binding.pending')
          if wordpos(name,'mkref deref linkref setref setobjtype setobjuninit setattrs linkattr1') > 0 then return reject('signal.storage.plain.unproved')
          if catalog.signalstate(item.opcode()) <> 0 then return reject('signal.caller.failure.pending')
          if wordpos(name,'null load copy icopy settp getandtp itos say numsci') = 0 then return reject('signal.caller.operation.pending')
        end
      end
    end
    if tags[0] = 0 then return reject('signal.named.push.missing.pending')
    if _namedcatchall & tags[0] <> 29 then return reject('signal.catchall.tags.pending')
    if range = 0 then return reject('signal.named.range.missing.pending')
    if installs <> tags[0] then return reject('signal.named.install.missing.pending')
    if pops <> 2 * tags[0] then return reject('signal.named.pop.count.pending')
    if spend(pops) = 0 then return 0
    do j = 1 to tags[0]
      if poptags[j] <> tags[tags[0] - j + 1] then return reject('signal.named.normal.pop.order.pending')
      if poptags[tags[0] + j] <> tags[tags[0] - j + 1] then return reject('signal.named.handler.pop.order.pending')
    end
    _namednormalpop = popids[1]; _namedhandlerpop = popids[tags[0] + 1]
    _boundlastpop = popids[pops]
    if _ownerlane then do
      if labels <> 3 then return reject('signal.owner.guard.pending')
    end
    else if labels <> 2 then return reject('signal.named.entry.pending')
    if calls <> 1 | branches <> 2 | returns <> 1 then return reject('signal.named.shape.pending')
    do i = 1 to module.records()
      if spend(1) = 0 then return 0
      item = module.record(i)
      if item.kind() <> 'label' then iterate
      field = item.operand(1)
      if field.text() = handler then do
        if item.procedureid() <> _function then return reject('signal.handler.owner.unproved')
        _namedhandler = item.id()
      end
      if field.text() = joined & item.procedureid() = _function then _namedjoin = item.id()
      if _ownerlane then do
        target = module.at(_ownerguard).operand(1)
        if field.text() = target.text() & item.procedureid() = _function then _ownerclose = item.id()
      end
    end
    if _namedhandler = 0 then return reject('signal.handler.target.unproved')
    if _namedjoin = 0 then return reject('signal.named.join.pending')
    if firstinstall <= lastpush | _namedcall <= _namedinstall | _namednormalpop <= _namedcall | _namednormalbr <= popids[tags[0]] | _namedhandler <= _namednormalbr | _namedhandlerpop <= _namedhandler | _namedhandlerbr <= popids[pops] | _namedjoin <= _namedhandlerbr then return reject('signal.named.order.pending')
    if _snapshotcopy > 0 then do
      if _snapshotcount <> 1 then return reject('signal.snapshot.consumer.pending')
      if _snapshotcopy <= _boundlastpop | _snapshotcopy >= _namedhandlerbr then return reject('signal.snapshot.phase.pending')
    end
    do i = 1 to module.records()
      if spend(1) = 0 then return 0
      item = module.record(i)
      if item.procedureid() <> _function | item.kind() <> 'instruction' then iterate
      if item.mnemonic() = 'ret' & item.id() < _namedjoin then return reject('signal.named.departure.pending')
      name = item.mnemonic()
      if item.id() > _namedpush & item.id() < _namedcall & name <> 'sigpush' & name <> 'sigbr' & name <> 'sigbrv' then return reject('signal.named.setup.pending')
      if item.id() > _namednormalpop & item.id() < popids[tags[0]] & name <> 'sigpop' then return reject('signal.named.normal.pop.interleaved.pending')
      if item.id() > _namednormalpop & item.id() < _namedhandler & name <> 'sigpop' & item.id() <> _namednormalbr then return reject('signal.named.departure.pending')
      if item.id() > _namedhandler & item.id() < _namedhandlerpop then return reject('signal.named.departure.pending')
      if item.id() > _namedhandlerpop & item.id() < popids[pops] & name <> 'sigpop' then return reject('signal.named.handler.pop.interleaved.pending')
      if item.id() > _namedhandlerbr & item.id() < _namedjoin then return reject('signal.named.departure.pending')
    end
    if _ownerlane then do
      if ownerlayout() = 0 then return 0
    end
    if _namedbound then return boundshape()
    return 1
  /** Discover an authored event transfer without granting it legality. Scope,
   * placement, reset, alias and closure checks still precede admission. */
  findsnapshot: method = .int
    module = dereference _owner; item = .lltarget..record; source = .lltarget..operand; target = .lltarget..operand
    i = .int; labels = .int; catalog = .llrxascatalog..catalog()
    do i = 1 to module.records()
      if spend(1) = 0 then return 0
      item = module.record(i)
      if item.procedureid() <> _function | item.kind() <> 'instruction' then iterate
      if wordpos(item.mnemonic(),'copy move') = 0 | item.operands() <> 2 then iterate
      source = item.operand(2)
      if source.kind() <> 'R' | source.bank() <> 'r' | source.index() + 1 <> _boundevent then iterate
      _snapshotcount = _snapshotcount + 1
      if _snapshotcopy = 0 then do
        _snapshotcopy = item.id(); target = item.operand(1)
        if target.kind() = 'R' & target.bank() = 'r' then _snapshotowner = target.index() + 1
      end
      if item.mnemonic() = 'move' then _snapshotmove = 1
    end
    if _snapshotcopy > 0 then do i = 1 to module.records()
      if spend(1) = 0 then return 0
      item = module.record(i)
      if item.procedureid() <> _function then iterate
      if item.kind() = 'label' then labels = labels + 1
      if item.kind() <> 'instruction' then iterate
      if catalog.flow(item.opcode()) <> 2 then iterate
      if _ownerguard > 0 then return reject('signal.owner.guard.pending')
      _ownerlane = 1; _ownerguard = item.id()
      if item.mnemonic() <> 'brf' | item.operands() <> 2 then return reject('signal.owner.guard.pending')
      target = item.operand(2)
      if target.kind() <> 'R' | target.bank() <> 'r' then return reject('signal.owner.mapping.pending')
      _ownerflag = target.index() + 1
    end
    if _snapshotcopy > 0 & labels > 2 & _ownerguard = 0 then return reject('signal.owner.guard.pending')
    return 1
  boundreject: method = .int
    arg kind = .string
    stem = 'signal.bound.'
    if _snapshotcopy > 0 then stem = 'signal.snapshot.'
    if _ownerlane then stem = 'signal.owner.'
    tail = '.pending'; if kind = 'state' then tail = '.unproved'
    return reject(stem || kind || tail)
