    if record = 0 then return 0
    row_ref = reference _selections[callid]; row = dereference row_ref
    return row.live(ordinal,record)
  argumentcasechoice: method = .int
    arg callid = .int, ordinal = .int, recordid = .int
    if casekey(callid,ordinal) = 0 then return 0
    record = recordkey(callid,recordid)
    if record = 0 then return 0
    row_ref = reference _selections[callid]; row = dereference row_ref
    return row.choice(ordinal,record)
  argumentcaseaction: method = .string
    arg callid = .int, ordinal = .int
    if casekey(callid,ordinal) = 0 then return ''
