        else if _namedbound & _boundphases[item.id()] > 0 then do
          owner = _boundevent; if _snapshotcopy > 0 then owner = _snapshotowner
          field = .lltarget..operand.bound(0,0,0,'r',owner - 1)
          if state.runtimeevent(view.storage(field)) = 0 then return boundreject('state')
          if _boundphases[item.id()] = 3 then do
            field = item.operand(1); id = view.storage(field)
