    retid = row.singleton(ordinal)
    if retid = 0 then return -1
    return row.left(ordinal,_retordinal[retid],pair)
  argumentcaseright: method = .int
    arg callid = .int, ordinal = .int, pair = .int
    if pair < 1 | pair > argumentcaserestores(callid,ordinal) then do
