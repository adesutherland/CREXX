            if state.ordinary(id) = 0 then return boundreject('state')
            call state.eventfield(id,_boundkinds[item.id()])
          end
          else if _boundphases[item.id()] = 6 | _boundphases[item.id()] = 7 then do
            field = item.operand(1); call state.reset(view.base(field))
          end
        end
        else if step(item,view,reference state) = 0 then do
          if _namedbound & _status = 'keep' & wordpos(_reason,'local.recycler.history.unproved local.recycler.observation.unproved') > 0 then return boundreject('state')
          return 0
        end
        if _namedcatchall & normalpossible & item.kind() = 'instruction' & item.id() > _namedcall & item.id() < _namednormalpop then do
          /* Every original normal instruction remains executable. An event
           * after an earlier write/observation must not rewind to call entry.
           * The unchanged pop prefixes write no cells/bindings; delivery there
