    arg callid = .int, recordid = .int
    if proofid(callid) = 0 then return 0
    if recordid < 1 | recordid > _recordordinal[0] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original callee record identity"; return 0
    end
    if _recordordinal[recordid] = 0 then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original callee record identity"; return 0
    end
    if _index.blockfunction(_index.opblock(recordid)) <> _body[callid] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: foreign callee record"; return 0
    end
    return _recordordinal[recordid]
  returnkey: method = .int
    arg callid = .int, recordid = .int
    p = .int
    if recordkey(callid,recordid) = 0 then return 0
    if recordid > _retordinal[0] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original callee RET identity"; return 0
    end
    if _retordinal[recordid] = 0 then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original callee RET identity"; return 0
    end
    p = _proofindex[callid]; row_ref = reference _proofs[p]; row = dereference row_ref
    if row.action(_retordinal[recordid]) = '' then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: infeasible callee RET"; return 0
    end
    return _retordinal[recordid]
  /** All exit queries use exact original root-call/callee-record identities.
   * Queries borrow sealed rows and consume no handed-off construction work. */
  returns: method = .int
    arg callid = .int
    p = proofid(callid)
    if p = 0 then return 0
    row_ref = reference _proofs[p]; row = dereference row_ref
    return row.returns()
  returnsite: method = .int
    arg callid = .int, ordinal = .int
    p = proofid(callid)
    if p = 0 then return 0
    row_ref = reference _proofs[p]; row = dereference row_ref
    if ordinal < 1 | ordinal > row.returns() then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: return ordinal"; return 0
    end
    return row.site(ordinal)
  returnactionat: method = .string
    arg callid = .int, retid = .int
    ordinal = returnkey(callid,retid)
    if ordinal = 0 then return ''
    p = _proofindex[callid]; row_ref = reference _proofs[p]; row = dereference row_ref
    return row.action(ordinal)
  restores: method = .int
    arg callid = .int, retid = .int
    ordinal = returnkey(callid,retid)
    if ordinal = 0 then return 0
    p = _proofindex[callid]; row_ref = reference _proofs[p]; row = dereference row_ref
    return row.restores(ordinal)
  restoreleft: method = .int
    arg callid = .int, retid = .int, pair = .int
    ordinal = returnkey(callid,retid)
    if ordinal = 0 then return -1
    p = _proofindex[callid]; row_ref = reference _proofs[p]; row = dereference row_ref
    if pair < 1 | pair > row.restores(ordinal) then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: restore ordinal"; return -1
    end
    return row.left(ordinal,pair)
  restoreright: method = .int
    arg callid = .int, retid = .int, pair = .int
    ordinal = returnkey(callid,retid)
    if ordinal = 0 then return -1
    p = _proofindex[callid]; row_ref = reference _proofs[p]; row = dereference row_ref
    if pair < 1 | pair > row.restores(ordinal) then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: restore ordinal"; return -1
    end
    return row.right(ordinal,pair)
  recordlive: method = .int
    arg callid = .int, recordid = .int
    ordinal = recordkey(callid,recordid)
    if ordinal = 0 then return 0
    p = _proofindex[callid]; row_ref = reference _proofs[p]; row = dereference row_ref
    return row.live(ordinal)
  branchchoice: method = .int
    arg callid = .int, recordid = .int
    ordinal = recordkey(callid,recordid)
    if ordinal = 0 then return 0
    p = _proofindex[callid]; row_ref = reference _proofs[p]; row = dereference row_ref
    return row.choice(ordinal)
  returned: method = .int
    arg callid = .int
    if returns(callid) <> 1 then do
      assembler signal "ERROR","LL_TARGET_FACTS_RETURN: use per-RET facts"; return 0
    end
    return _return[callid]
  /** The sealed call plan distinguishes active binding changes from values. */
  rebinding: method = .int
    arg callid = .int
    call require(); return _rebinding[callid]
  /** A retained nested counted window requires the original complete slot
   * order even when the outer frame contains no explicit binding change.
   * The root ledger and inverse SWAP list remain distinct from child frames. */
  orderedslots: method = .int
    arg callid = .int
    call require()
    if valid() = 0 then return 0
    if callid < 1 | callid > _body[0] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original root call identity"
      return 0
    end
    if _body[callid] = 0 then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original root call identity"
      return 0
    end
    return _ordered[callid] <> 0
  /** Exact active argument selected by one original outer-body LINKARG.
   * Zero denotes a0; -1 denotes a valid callee record without a rewrite.
   * Each root activation owns its row, so repeated bodies cannot overwrite
   * another site's selector. No lookup consumes handed-off work. */
  argumentselector: method = .int
    arg callid = .int, recordid = .int
    ordinal = .int; row = .numbers
    call require()
    if valid() = 0 then return -1
    if callid < 1 | callid > _body[0] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original root call identity"
      return -1
    end
    if _body[callid] = 0 then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original root call identity"
      return -1
    end
    if recordid < 1 | recordid > _index.operations() then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: callee record identity"
      return -1
    end
    if _index.blockfunction(_index.opblock(recordid)) <> _body[callid] | _index.opcode(recordid) <= 16 then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: foreign callee record"
      return -1
    end
    if recordid > _selectorordinal[0] then return -1
    ordinal = _selectorordinal[recordid]
    if ordinal = 0 then return -1
    row = _selectors[callid] as .numbers
    return row.at(ordinal)
  returnaction: method = .string
    arg callid = .int
    if returns(callid) <> 1 then do
      assembler signal "ERROR","LL_TARGET_FACTS_RETURN: use per-RET facts"; return ''
    end
    return _returnaction[callid]
  swaps: method = .int
    arg callid = .int
    if proofid(callid) = 0 then return 0
    if _dagbody[_body[callid]] then do
      assembler signal "ERROR","LL_TARGET_FACTS_RETURN: use per-RET restoration"; return 0
    end
    return _swapcount[callid]
  swap: method = .int
    arg callid = .int, ordinal = .int
    if proofid(callid) = 0 then return 0
    if _dagbody[_body[callid]] then do
      assembler signal "ERROR","LL_TARGET_FACTS_RETURN: use per-RET restoration"; return 0
    end
    records = _swaps[callid] as .numbers; return records.at(ordinal)
  context: method = .string
    arg callid = .int
    call require(); return _context[callid]
  storage: method = .int
    arg recordid = .int, ordinal = .int
    call require(); refs = _references[recordid] as .numbers; return refs.at(ordinal)
  integerdomain: method = .int
    arg storageid = .int
    call require(); return _domains[storageid]
  wholedomain: method = .int
    arg storageid = .int
    call require(); return _whole[storageid]
  plain: method = .int
    arg storageid = .int
    call require(); return _plain[storageid]
  /** Whether an original zero-based root cell can share plain scalar storage.
   * This sealed premise proves fresh entry and a successful first definition,
   * complete component/status accesses and no alias/base/lifetime obligation.
   * Integer kills remain component kills; a reused arrival still requires the
   * assignment owner's typed whole-entry NULL. Queries consume no work. */
  reusecandidate: method = .int
    arg virtual = .int
    call require()
    if valid() = 0 then return 0
    if virtual < 0 | virtual >= _reuse[0] then do
      assembler signal "ERROR","LL_TARGET_FACTS_ID: original root cell outside frame"
      return 0
    end
    return _reuse[virtual + 1] = 1
  plainbefore: method = .int
    arg recordid = .int, ordinal = .int
    call require(); plain = _beforeplain[recordid] as .numbers; return plain.at(ordinal)
  mapping: method = .int
    arg recordid = .int
    call require(); return _mapping[recordid]
  blocked: method = .int
    arg recordid = .int
    call require(); region = _regions[recordid]
    return _windowblocked[recordid] | (region > 0 & _blocked[region])

analyse: procedure = .lltargetfacts..analysis
  arg owner = reference .lltarget..module, functionId = .int, profile = 'unknown', work = 1000000, bytes = 67108864
  return .analysis(owner,functionId,profile,work,bytes)

/** Opt-in root CFG facts for cleanup of one exact frozen expanded owner.
 * The linear expansion analysis and its entry contract remain unchanged. */
analysegraph: procedure = .lltargetfacts..analysis
  arg owner = reference .lltarget..module, functionId = .int, profile = 'unknown', work = 1000000, bytes = 67108864
  return .analysis(owner,functionId,profile,work,bytes,1)
