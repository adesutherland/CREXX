/* cREXX License (MIT). RXAS scalar/storage transfers over shared L analyses. */
options levelb
namespace lltargetfacts expose analysis analyse arithmetic
import rxfnsb
import llir
import llirgraph
import lltarget
import llrxascatalog

/** Typed numeric row retained as an object; primitive arrays are not boxed. */
numbers: class
  _values = .int[]
  *: factory
    arg values = .int[]
    _values = values
    return
  at: method = .int
    arg ordinal = .int
    if ordinal < 1 | ordinal > _values[0] then assembler signal "ERROR","LL_TARGET_FACTS_ID: numeric row ordinal"
    return _values[ordinal]

/** This helper proves the checked write succeeds before evaluating it. The VM
 * default OVERFLOW_UNDERFLOW response ignores a failed, unwritten destination;
 * integer equality alone cannot establish return availability or history. */
arithmetic: procedure = .int[]
  arg name = .string, left = .int, right = .int
  constant HIGHEST = 9223372036854775807
  constant LOWEST = -9223372036854775807 - 1
  result = .int[]; result[1] = 0; result[2] = 0
  select name
    when 'iadd' then do
      if right > 0 then do; if left > HIGHEST - right then return result; end
      else if right < 0 then do; if left < LOWEST - right then return result; end
      result[2] = left + right
    end
    when 'isub' then do
      if right < 0 then do; if left > HIGHEST + right then return result; end
      else if right > 0 then do; if left < LOWEST + right then return result; end
      result[2] = left - right
    end
    when 'imult' then do
      if left = 0 | right = 0 then result[2] = 0
      else do
        if left > 0 & right > 0 then do; if left > HIGHEST / right then return result; end
        else if left > 0 & right < 0 then do; if right < LOWEST / left then return result; end
        else if left < 0 & right > 0 then do; if left < LOWEST / right then return result; end
        else do; if left < HIGHEST / right then return result; end
        result[2] = left * right
      end
    end
    otherwise return result
  end
  result[1] = 1
  return result

/** Target transfer state, not a CFG/worklist or allocator. Distinct storage
 * identities never merge merely because their current integer values agree.
 * Only the closed scalar profile below establishes absence of hidden payloads. */
cells: class
  _defined = .int[]
  _known = .int[]
  _values = .int[]
  _plain = .int[]
  _flags = .int[]
  _wholeknown = .int[]
  _zeroed = .int[]
  *: factory
    return
  add: method = .int
    arg defined = 0, known = 0, value = 0
    n = _defined[0] + 1
    _defined[n] = defined; _known[n] = known; _values[n] = value; _plain[n] = 1; _flags[n] = 0
    _wholeknown[n] = 1; _zeroed[n] = 0
    return n
  defined: method = .int
    arg id = .int
    return _defined[id]
  known: method = .int
    arg id = .int
    return _known[id]
  value: method = .int
    arg id = .int
    return _values[id]
  plain: method = .int
    arg id = .int
    return _plain[id]
  flags: method = .int
    arg id = .int
    return _flags[id]
  wholeknown: method = .int
    arg id = .int
    return _wholeknown[id]
  zeroed: method = .int
    arg id = .int
    return _zeroed[id]
  uncertain: method = .void
    arg id = .int
    /* The scalar profile proves no native/reference payload was created.
     * Recycled ordinary components/status still cannot be assumed fresh. */
    _defined[id] = 0; _known[id] = 0; _wholeknown[id] = 0; _zeroed[id] = 0
    return
  integer: method = .void
    arg id = .int, known = .int, value = 0
    _defined[id] = 1; _known[id] = known; _values[id] = value; _zeroed[id] = 0
    return
  reset: method = .void
    arg id = .int
    _defined[id] = 1; _known[id] = 1; _values[id] = 0; _plain[id] = 1; _flags[id] = 0
    _wholeknown[id] = 1; _zeroed[id] = 1
    return
  copy: method = .void
    arg destination = .int, source = .int, whole = 1
    _defined[destination] = _defined[source]; _known[destination] = _known[source]; _values[destination] = _values[source]
    if whole then do
      _plain[destination] = _plain[source]; _flags[destination] = _flags[source]
      _wholeknown[destination] = _wholeknown[source]; _zeroed[destination] = _zeroed[source]
    end
    else _zeroed[destination] = 0
    return
  move: method = .void
    arg destination = .int, source = .int
    if destination = source then return
    call copy(destination,source)
    call reset(source)
    return
  status: method = .void
    arg id = .int, flags = .int
    _flags[id] = flags; _zeroed[id] = 0
    return
  string: method = .void
    arg id = .int
    _plain[id] = 0; _zeroed[id] = 0
    return

frame: class
  _map = .int[]
  _base = .int[]
  _identity = .int[]
  _locals = .int
  _arguments = .int
  _context = .string
  *: factory
    arg owner = reference .cells, locals = .int, actuals = .int[], fresh = 0, context = '', ?owned = .int[]
    i = .int; id = .int; at = .int
    state = dereference owner; _locals = locals; _arguments = actuals[0]; _context = context
    do i = 1 to locals
      if ?owned then id = owned[i]
      else id = state.add(fresh,fresh,0)
      _map[i] = id; _base[i] = id; _identity[i] = i
    end
    if ?owned then do
      id = owned[locals + 1]; call state.reset(id); call state.integer(id,1,actuals[0])
    end
    else id = state.add(1,1,actuals[0])
    _map[locals + 1] = id; _base[locals + 1] = id; _identity[locals + 1] = locals + 1
    do i = 1 to actuals[0]
      at = locals + 1 + i; _map[at] = actuals[i]; _base[at] = actuals[i]; _identity[at] = at
    end
    return
  position: method = .int
    arg value = .lltarget..operand
    if value.kind() <> 'R' then return 0
    if value.bank() = 'r' & value.index() < _locals then return value.index() + 1
    if value.bank() = 'a' & value.index() <= _arguments then return _locals + value.index() + 1
    return 0
  storage: method = .int
    arg value = .lltarget..operand
    at = position(value)
    if at = 0 then return 0
    return _map[at]
  base: method = .int
    arg value = .lltarget..operand
    at = position(value)
    if at = 0 then return 0
    return _base[at]
  baseat: method = .int
    arg position = .int
    if position < 1 | position > _base[0] then assembler signal "ERROR","LL_TARGET_FACTS_ID: frame base ordinal"
    return _base[position]
  link: method = .void
    arg destination = .lltarget..operand, source = .lltarget..operand
    _map[position(destination)] = storage(source)
    return
  unlink: method = .void
    arg destination = .lltarget..operand
    at = position(destination); _map[at] = _base[at]
    return
  swap: method = .void
    arg left = .lltarget..operand, right = .lltarget..operand
    a = position(left); b = position(right)
    id = _map[a]; _map[a] = _map[b]; _map[b] = id
    id = _identity[a]; _identity[a] = _identity[b]; _identity[b] = id
    return
  canonical: method = .int
    do i = 1 to _identity[0]
      if _identity[i] <> i then return 0
    end
    return 1
  context: method = .string
    return _context
  numeric: method = .void
    arg value = .string
    _context = value
    return

/** Facts are bound to one exact frozen target owner and shared graph/access
 * projection. The projection supplies accesses to the existing L liveness
 * solver; this target owner supplies VM-specific transfer and storage facts. */
analysis: class
  _owner = reference .lltarget..module
  _store = reference .llir..arena
  _revision = .int
  _function = .int
  _index = .llirgraph..index
  _access = .llirgraph..access
  _status = .string
  _reason = .string
  _work = .int
  _references = .object[]
  _beforeplain = .object[]
  _domains = .int[]
  _whole = .int[]
  _plain = .int[]
  _reuse = .int[]
  _counts = .int[]
  _first = .int[]
  _body = .int[]
  _return = .int[]
  _actuals = .object[]
  _argumentstorage = .object[]
  _context = .string[]
  _calls = .int[]
  _regions = .int[]
  _blocked = .int[]
  _mapping = .int[]
  _windowblocked = .int[]
  _profile = .string
  _activations = .int[]
  _owned = .object[]
  _reset = .object[]
  _rebinding = .int[]
  _returnaction = .string[]
  _swaps = .object[]
  _swapcount = .int[]
  _bytelimit = .int
  _retained = .int
  *: factory
    arg owner = reference .lltarget..module, functionId = .int, profile = 'unknown', work = 1000000, bytes = 67108864
    _owner = owner; _function = functionId; _profile = profile; _work = work; _status = 'building'; _reason = ''; _bytelimit = bytes
    return
  spend: method = .int
    arg amount = .int
    if amount < 0 | amount > _work then do; _status = 'limit'; _reason = 'target.facts.work'; return 0; end
    _work = _work - amount
    return 1
  reserve: method = .int
    arg count = .int, width = .int
    if count < 0 | width < 1 then do; _status = 'invalid'; _reason = 'target.facts.dimensions'; return 0; end
    if count > (_bytelimit - _retained) / width then do; _status = 'limit'; _reason = 'target.facts.bytes'; return 0; end
    _retained = _retained + count * width
    return 1
  reject: method = .int
    arg reason = .string
    _status = 'keep'; _reason = reason
    return 0
  domain: method = .int
    arg id = .int, whole = 0
    if id = 0 then return 0
    if whole then do
      if _whole[id] = 0 then _whole[id] = _access.domain(_function,'rxas.storage.' || id || '.whole')
      return _whole[id]
    end
    if _domains[id] = 0 then _domains[id] = _access.domain(_function,'rxas.storage.' || id || '.integer')
    return _domains[id]
  bindingdomain: method = .int
    arg value = .lltarget..operand, kind = .string
    return _access.domain(_function,'rxas.slot.' || value.bank() || value.index() || '.' || kind)
  /* A set vector uses the existing ordered numeric array representation.
   * Projection.put rejects duplicates, so domain adapters deduplicate here. */
  insert: method = .void
    arg values_ref = reference .int[], id = .int
    values = dereference values_ref
    if id = 0 then return
    do i = 1 to values[0]
      if values[i] = id then return
    end
    values[values[0] + 1] = id
    return
  step: method = .int
    arg item = .lltarget..record, expose view = .frame, state_ref = reference .cells, private = 0, record = 1, returnwhole = 1
    i = .int; sourceid = .int; destination = .int; rightid = .int; id = .int
    opcode = .int; component = .int; cleared = .int; lhs = .int; rhs = .int
    source = .lltarget..operand; bank = .lltarget..operand; reference_value = .lltarget..operand; option = .lltarget..operand
    digits = .lltarget..operand; casetype = .lltarget..operand; standard = .lltarget..operand
    if _status <> 'building' then assembler signal "ERROR","LL_TARGET_FACTS_FROZEN: transfer state is sealed"
    left = .lltarget..operand; right = .lltarget..operand; value = .lltarget..operand
    state = dereference state_ref; reads = .int[]; observations = .int[]; writes = .int[]; kills = .int[]; references = .int[]; plain = .int[]
    if spend(1 + item.operands() + item.registerrefs()) = 0 then return 0
    if record then do
      if reserve(item.registerrefs(),16) = 0 | reserve(2,32) = 0 then return 0
    end
    at = item.origin()
    if at.kind() = 'recovered' then return reject('profile.provenance.recovered')
    do i = 1 to item.registerrefs()
      value = item.registerref(i); id = view.storage(value)
      if id = 0 then return reject('profile.external.storage.pending')
      if private = 0 & value.bank() <> 'r' then return reject('root.external.storage.unproved')
      references[i] = id; plain[i] = state.plain(id)
    end
    if record then do; _references[item.id()] = .numbers(references) as .object; _beforeplain[item.id()] = .numbers(plain) as .object; end
    if item.kind() <> 'instruction' then do
      if wordpos(item.kind(),'.srcstep .srcfile .srcline') > 0 then nop
      else if item.kind() = '.meta' then do
        if item.operands() > 1 then do
          option = item.operand(2)
          if left(option.text(),1) = '.' & option.text() <> '.inline' then return reject('metadata.runtime.observer.unproved')
        end
        do i = 1 to references[0]
          if state.wholeknown(references[i]) = 0 then return reject('local.recycler.observation.unproved')
          call insert(reference observations,domain(references[i],1))
        end
      end
      else if item.kind() = '.traceevent' then do
        source = item.operand(3); bank = item.operand(5); reference_value = item.operand(6)
        if source.text() = 'K' & reference_value.index() >= 0 then return reject('metadata.constant.reference.pending')
        if source.text() = 'R' & reference_value.index() >= 0 & references[0] <> 1 then return reject('metadata.register.reference.unproved')
        do i = 1 to references[0]
          if state.defined(references[i]) = 0 | state.wholeknown(references[i]) = 0 then return reject('local.recycler.observation.unproved')
          call insert(reference observations,domain(references[i],1))
        end
      end
      else return reject('profile.scalar.control.pending')
      if record then call _access.put(item.id(),reads,observations,writes,kills)
      return 1
    end
    catalog = .llrxascatalog..catalog(); opcode = item.opcode(); name = item.mnemonic()
    if catalog.policyeffect(opcode) <> 0 then return reject('signal.policy.unproved')
    /* Native canonical component/cleanup metadata supplies the use adapter;
     * transfer code below still proves write availability and plain ownership. */
    if wordpos(name,'link unlink swap endlife') = 0 then do i = 1 to item.operands()
        value = item.operand(i)
        if value.kind() <> 'R' then iterate
        id = view.storage(value)
        if catalog.reads(opcode,i) then call insert(reference reads,domain(id,catalog.readcomponents(opcode,i) <> 1))
        if catalog.writes(opcode,i) then do
          component = catalog.writecomponents(opcode,i); cleared = catalog.clearcomponents(opcode,i)
          if component % 2 = 1 | component = 0 then call insert(reference writes,domain(id))
          call insert(reference writes,domain(id,1))
          if cleared <> 0 then call insert(reference writes,domain(id,1))
        end
      end
    if name = 'numsci' then do
      digits = item.operand(1); casetype = item.operand(2); standard = item.operand(3)
      if digits.index() < 5 | casetype.index() < 1 | casetype.index() > 2 | standard.index() < 1 | standard.index() > 2 then return reject('context.numeric.arguments.unproved')
      setting = digits.index() || ',' || casetype.index() || ',' || standard.index()
      if private & setting <> view.context() then return reject('context.numeric.restore.unproved')
      call view.numeric(setting)
    end
    else if name = 'ret' then do
      if item.operands() = 1 then do
        value = item.operand(1)
        if value.kind() = 'R' then do
          id = view.storage(value)
          if id = 0 | state.defined(id) = 0 then return reject('local.recycler.history.unproved')
          if returnwhole & state.wholeknown(id) = 0 then return reject('local.recycler.history.unproved')
          call insert(reference reads,domain(id,1))
        end
        else if value.kind() <> 'I' then return reject('profile.return.component.pending')
      end
    end
    else if name = 'cnop' then nop
    else if wordpos(name,'link unlink swap') > 0 then do
      left = item.operand(1)
      if record then do
        call insert(reference writes,bindingdomain(left,'active')); call insert(reference kills,bindingdomain(left,'active'))
      end
      if name = 'unlink' then do
        if record then call insert(reference reads,bindingdomain(left,'base'))
        call view.unlink(left)
      end
      else do
        right = item.operand(2)
        if record then call insert(reference reads,bindingdomain(right,'active'))
        if name = 'link' then call view.link(left,right)
        else do
          if record then do
            call insert(reference reads,bindingdomain(left,'active'))
            call insert(reference writes,bindingdomain(right,'active')); call insert(reference kills,bindingdomain(right,'active'))
            call insert(reference reads,bindingdomain(left,'identity')); call insert(reference reads,bindingdomain(right,'identity'))
            call insert(reference writes,bindingdomain(left,'identity')); call insert(reference kills,bindingdomain(left,'identity'))
            call insert(reference writes,bindingdomain(right,'identity')); call insert(reference kills,bindingdomain(right,'identity'))
          end
          call view.swap(left,right)
        end
      end
      if record then _mapping[item.id()] = 1
    end
    else if wordpos(name,'null load copy icopy move settp getandtp endlife iadd isub imult itos say') > 0 then do
      if name = 'say' then do
        if private then return reject('profile.callee.external.effect.pending')
        value = item.operand(1)
        if value.kind() = 'R' then call insert(reference reads,domain(view.storage(value),1))
      end
      else do
        left = item.operand(1); destination = view.storage(left)
        if destination = 0 then return reject('profile.external.storage.pending')
        if name = 'null' then call state.reset(destination)
        else if name = 'endlife' then do
          if state.plain(destination) = 0 then return reject('lifetime.hidden.payload.unproved')
        end
        else if name = 'settp' then do
          value = item.operand(2); call state.status(destination,value.index())
        end
        else if name = 'getandtp' then do
          if private then return reject('profile.callee.status.observer.pending')
          right = item.operand(2); sourceid = view.storage(right)
          if sourceid = 0 | state.wholeknown(sourceid) = 0 then return reject('local.recycler.observation.unproved')
          call insert(reference reads,domain(sourceid,1))
          /* This non-signalling status observation always defines its integer
           * result. It does not reset destination status or other components. */
          call state.integer(destination,0)
        end
        else if name = 'load' then do
          value = item.operand(2)
          if value.kind() <> 'I' then return reject('profile.scalar.literal.pending')
          call state.integer(destination,1,value.index())
        end
        else if name = 'itos' then do
          if private then return reject('profile.callee.component.pending')
          if state.defined(destination) = 0 then return reject('local.recycler.history.unproved')
          call insert(reference reads,domain(destination))
          call state.string(destination)
        end
        else if wordpos(name,'copy icopy move') > 0 then do
          right = item.operand(2); sourceid = view.storage(right)
          if sourceid = 0 | state.defined(sourceid) = 0 then return reject('local.recycler.history.unproved')
          if name <> 'icopy' & state.wholeknown(sourceid) = 0 then return reject('local.recycler.history.unproved')
          if state.plain(sourceid) = 0 & private then return reject('argument.scalar.state.unproved')
          call insert(reference reads,domain(sourceid,name <> 'icopy'))
          if name = 'move' then call state.move(destination,sourceid)
          else call state.copy(destination,sourceid,name <> 'icopy')
        end
        else do
          left = item.operand(2); right = item.operand(3)
          if left.kind() = 'R' then do
            sourceid = view.storage(left)
            if sourceid = 0 | state.known(sourceid) = 0 then return reject('arithmetic.write.availability.unproved')
            lhs = state.value(sourceid); call insert(reference reads,domain(sourceid))
          end
          else lhs = left.index()
          if right.kind() = 'R' then do
            rightid = view.storage(right)
            if rightid = 0 | state.known(rightid) = 0 then return reject('arithmetic.write.availability.unproved')
            rhs = state.value(rightid); call insert(reference reads,domain(rightid))
          end
          else rhs = right.index()
          checked = arithmetic(name,lhs,rhs)
          if checked[1] = 0 then return reject('arithmetic.write.availability.unproved')
          call state.integer(destination,1,checked[2])
        end
        /* A whole-cell domain observes every numeric/status side component.
         * Definite scalar kills are narrower; whole copy/move/null kill both. */
        if name <> 'endlife' then do
          call insert(reference writes,domain(destination)); call insert(reference writes,domain(destination,1))
        end
        if wordpos(name,'null copy move') > 0 then do
          call insert(reference kills,domain(destination)); call insert(reference kills,domain(destination,1))
        end
        else if wordpos(name,'load icopy getandtp iadd isub imult') > 0 then call insert(reference kills,domain(destination))
        _plain[destination] = state.plain(destination)
      end
    end
    else return reject('profile.scalar.operation.pending')
    if record then call _access.put(item.id(),reads,observations,writes,kills)
    return 1
  invoke: method = .int
    arg item = .lltarget..record, expose view = .frame, state_ref = reference .cells
    i = .int; j = .int; ignored = .int; repeated = .int
    id = .int; destination = .int; bodyid = .int; recordid = .int; returned = .int; hasresult = .int
    callee = .lltarget..body; child = .frame; record = .lltarget..record
    value = .lltarget..operand; target = .lltarget..operand
    ownedrow = .numbers; resetrow = .numbers
    if _status <> 'building' then assembler signal "ERROR","LL_TARGET_FACTS_FROZEN: call state is sealed"
    module = dereference _owner; state = dereference state_ref; name = item.mnemonic(); count = 0; first = 0
    actuals = .int[]; positions = .int[]; references = .int[]; owned = .int[]; reset = .int[]; swaps = .int[]
    reads = .int[]; observations = .int[]; writes = .int[]; kills = .int[]
    if name = 'call' then do
      if item.operands() = 1 then target = item.operand(1)
      else target = item.operand(2)
      if item.operands() = 3 then do
        value = item.operand(3); id = view.storage(value)
        if value.bank() <> 'r' | id = 0 | state.known(id) = 0 then return reject('argument.count.unproved')
        count = state.value(id); first = value.index() + 1
        if count < 0 | count > module.body(_function).locals() - first then return reject('argument.window.unproved')
        call insert(reference reads,domain(id))
      end
    end
    else if wordpos(name,'call1 call2 call3 call4') > 0 then do
      count = wordpos(name,'call1 call2 call3 call4'); target = item.operand(2)
    end
    else return reject('call.form.pending')
    if target.kind() <> 'P' then return reject('call.target.unproved')
    bodyid = module.procedureid(target.text())
    if bodyid = 0 then return reject('body.unavailable')
    if reserve(count,64) = 0 then return 0
    do i = 1 to count
      if name = 'call' then do
        id = first + i - 1; value = .lltarget..operand.bound(0,0,0,'r',id)
      end
      else value = item.operand(i + 2)
      if value.bank() <> 'r' then return reject('argument.storage.unproved')
      id = view.storage(value)
      if id = 0 | state.defined(id) = 0 | state.plain(id) = 0 | state.wholeknown(id) = 0 then return reject('argument.scalar.state.unproved')
      actuals[i] = id; positions[i] = value.index(); call insert(reference reads,domain(id,1))
    end
    callee = module.body(bodyid)
    if _index.functionblocks(bodyid) <> 1 then return reject('profile.callee.cfg.pending')
    /* Native recycling reuses each procedure's owned bases, but relinks its
     * active map and resets slot identities. Keep those StorageIds stable.
     * Only a proved whole reset lets a later inline site assume fresh state;
     * mapping-only operands neither read nor overwrite the owned value. */
    repeated = _activations[bodyid] > 0; hasresult = item.operands() > 1; destination = 0
    if hasresult then do
      value = item.operand(1); destination = view.storage(value)
      if destination = 0 then return reject('result.storage.unproved')
      if name = 'call' & item.operands() = 2 then call state.reset(destination)
    end
    if count >= _work then do; _status = 'limit'; _reason = 'target.facts.work'; return 0; end
    if callee.locals() > _work - count - 1 then do; _status = 'limit'; _reason = 'target.facts.work'; return 0; end
    if spend(callee.locals() + count + 1) = 0 then return 0
    if reserve(callee.locals() + count + 1,24) = 0 | reserve(callee.locals() + 1,16) = 0 | reserve(4,32) = 0 then return 0
    if repeated then do
      ownedrow = _owned[bodyid] as .numbers; resetrow = _reset[bodyid] as .numbers
      do i = 1 to callee.locals() + 1
        owned[i] = ownedrow.at(i)
        if i <= callee.locals() then do
          if resetrow.at(i) = 0 then call state.uncertain(owned[i])
        end
      end
      child = .frame(state_ref,callee.locals(),actuals,0,view.context(),owned)
    end
    else do
      if reserve(callee.locals() + 1,80) = 0 then return 0
      child = .frame(state_ref,callee.locals(),actuals,0,view.context())
