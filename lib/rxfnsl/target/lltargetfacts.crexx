    end
    else row = _linear[bodyid] as .numbers
    do i = ordinal + 1 to row.size()
      if spend(1) = 0 then return 0
      item = module.at(row.at(i))
      if item.kind() <> 'instruction' then iterate
      next = i; leave
    end
    if next = 0 then return 2
    operation = module.at(row.at(next))
    if operation.mnemonic() <> 'linkarg' | operation.operands() <> 3 then return 2
    if _profile <> 'closed-main-default-halt.v1' & _profile <> 'closed-main-static-exact-default-halt.v1' then return reject('argument.selector.policy.unproved')
    if _namedhandler > 0 | _namedactive then return reject('argument.selector.policy.unproved')
    if publish = 0 then return reject('argument.selector.nested.pending')
    do i = 1 to ordinal - 1
      if spend(1) = 0 then return 0
      item = module.at(row.at(i))
      if item.kind() = 'instruction' & wordpos(item.mnemonic(),'call call1 call2 call3 call4') > 0 then return reject('argument.selector.nested.pending')
    end
    field = operation.operand(2)
    if view.storage(field) <> selectorid then return reject('argument.selector.guard.unproved')
    if state.defined(selectorid) = 0 then return reject('argument.selector.unproved')
    if _globals[0] > 0 then return reject('argument.selector.global.pending')
    do i = 2 to 3
      field = guard.operand(i)
      if field.kind() = 'I' then limits[i] = field.index()
      else do
        id = view.storage(field)
        if id = 0 then return reject('argument.range.unproved')
        if state.defined(id) = 0 | state.known(id) = 0 then return reject('argument.range.unproved')
        limits[i] = state.value(id)
      end
