           * destination write. Unknown integers still define a boolean. */
          if leftknown & rightknown then do
            select name
              when 'ieq' then selected = lhs = rhs
              when 'ine' then selected = lhs <> rhs
              when 'igt' then selected = lhs > rhs
              when 'ilt' then selected = lhs < rhs
              when 'igte' then selected = lhs >= rhs
              when 'ilte' then selected = lhs <= rhs
              otherwise return reject('profile.scalar.operation.pending')
            end
            call state.integer(destination,1,selected)
          end
          else call state.interval(destination,0,1)
        end
        else if wordpos(name,'req rne') > 0 then do
          /* Preserve the VM's locale/converter and padded-string semantics.
           * No string content is evaluated by the proof. All input premises
           * precede set_int, even when output and an input share storage. */
          if spend(8) = 0 then return 0
          if state.ordinary(destination) = 0 then return reject('argument.scalar.state.unproved')
          do i = 2 to 3
            value = item.operand(i)
            if value.kind() <> 'R' then iterate
            id = view.storage(value)
            if id = 0 then return reject('profile.external.storage.pending')
            if state.ordinary(id) = 0 then return reject('argument.scalar.state.unproved')
            if state.stringdefined(id) = 0 | state.stringindependent(id) = 0 then return reject('string.component.unproved')
            call insert(reference reads,domain(id,1))
          end
          call state.interval(destination,0,1)
        end
        else do
          left = item.operand(2); right = item.operand(3)
          /* Capture both incoming intervals before a possibly aliased
           * destination can change either operand's component facts. */
          if left.kind() = 'R' then do
            sourceid = view.storage(left)
            if sourceid = 0 | state.defined(sourceid) = 0 | state.bounded(sourceid) = 0 then return reject('arithmetic.write.availability.unproved')
            leftlow = state.low(sourceid); lefthigh = state.high(sourceid); call insert(reference reads,domain(sourceid))
          end
          else do; leftlow = left.index(); lefthigh = leftlow; end
          if right.kind() = 'R' then do
            rightid = view.storage(right)
            if rightid = 0 | state.defined(rightid) = 0 | state.bounded(rightid) = 0 then return reject('arithmetic.write.availability.unproved')
            rightlow = state.low(rightid); righthigh = state.high(rightid); call insert(reference reads,domain(rightid))
          end
          else do; rightlow = right.index(); righthigh = rightlow; end
          if spend(32) = 0 | reserve(4,16) = 0 then return 0
          if name = 'imult' then do
            do i = 1 to 2
              lhs = leftlow
              if i = 2 then lhs = lefthigh
              do j = 1 to 2
                rhs = rightlow
                if j = 2 then rhs = righthigh
                checked = arithmetic(name,lhs,rhs)
                if checked[1] = 0 then return reject('arithmetic.write.availability.unproved')
                if i = 1 & j = 1 then do; resultlow = checked[2]; resulthigh = checked[2]; end
                else do
                  if checked[2] < resultlow then resultlow = checked[2]
                  if checked[2] > resulthigh then resulthigh = checked[2]
                end
              end
            end
          end
          else do
            lhs = rightlow; rhs = righthigh
            if name = 'isub' then do; lhs = righthigh; rhs = rightlow; end
            checked = arithmetic(name,leftlow,lhs)
            if checked[1] = 0 then return reject('arithmetic.write.availability.unproved')
            resultlow = checked[2]
            checked = arithmetic(name,lefthigh,rhs)
            if checked[1] = 0 then return reject('arithmetic.write.availability.unproved')
            resulthigh = checked[2]
          end
          call state.interval(destination,resultlow,resulthigh)
        end
        /* String/binary accesses use the whole observation domain. Such a
         * component write cannot kill surviving status or other components. */
        if name <> 'endlife' then do
          if integerwrite then call insert(reference writes,domain(destination))
          call insert(reference writes,domain(destination,1))
        end
        if wordpos(name,'null copy move') > 0 then do
          call insert(reference kills,domain(destination)); call insert(reference kills,domain(destination,1))
        end
        else if integerwrite & wordpos(name,'load icopy getandtp bineq iadd isub imult ieq ine igt ilt igte ilte req rne') > 0 then call insert(reference kills,domain(destination))
        if history then _plain[destination] = state.plain(destination)
      end
    end
    else return reject('profile.scalar.operation.pending')
    if record then call _access.put(item.id(),reads,observations,writes,kills)
    return 1
  normalize: method = .callshape
    arg item = .lltarget..record, expose view = .frame, state_ref = reference .cells, private = 0
