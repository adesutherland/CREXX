      mask = mask <idiv> 2; ordinal = ordinal + 1
      if mask > 0 then bit = bit * 2
    end
    return
  canonical: method = .void
    j = .int; mask = .int; bit = .int; ordinal = .int; id = .int; refid = .int
    program = .bindingprogram; integerdomain = .int
    target = dereference _owner; catalog = .llrxascatalog..catalog(); value = .lltarget..operand
    do n = 1 to target.records()
      item = target.record(n); opid = item.id()
      if operation(opid) = 0 then return
