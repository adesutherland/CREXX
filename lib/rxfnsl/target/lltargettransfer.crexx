            do ordinal = 2 to j; refid = _rnext[refid]; end
            call domainevents(opid,'observe',refid,catalog.componentmask('whole'))
          end
        end
        _relocationknown[opid] = 1
        iterate
      end
      code = item.opcode(); phase = word('none before after partial unknown',catalog.signalphase(code) + 1)
      _relocationknown[opid] = 1
      scopedrecipe = catalog.recipeoperand(code) > 0 & catalog.scopecontinuation(code) > 0
      callsite = catalog.callinvokes(code); selectionkind = catalog.selectionkind(code); windowref = 0
      recipe = catalog.bindingrecipe(code)
