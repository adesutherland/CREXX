      if (catalog.signalproperties(code) <idiv> 8) % 2 | (catalog.signalproperties(code) <idiv> 32) % 2 then do; reason = 'target.call.provider.policy.unproved'; leave; end
      if catalog.callinvokes(code) then do
        child = localcalltarget(item.id())
        if child = 0 then do; reason = 'target.call.provider.binding.unproved'; leave; end
        if providerpolicy(child,depth + 1) = 0 then do; reason = 'target.call.provider.closure.unproved'; leave; end
        iterate
      end
      /* A complete public callback route can preserve this frame's handler
       * table while retaining every value/observer/host callback obligation.
       * Authored policy writes above remain an independent rejection. */
      if catalog.callbackpreservessignalpolicy(code) then iterate
      mask = catalog.callbackobligations(code)
      if catalog.contextsynccontract() = 'value-only-nonreentrant.v1' then do
        bit = catalog.callbackmask('plugin-sync'); assembler iand overlap,mask,bit; mask = mask - overlap
        if catalog.returnkind(code) > 0 then do
          bit = catalog.callbackmask('abi'); assembler iand overlap,mask,bit; mask = mask - overlap
          bit = catalog.callbackmask('departure'); assembler iand overlap,mask,bit; mask = mask - overlap
        end
      end
      assembler iand overlap,mask,resources
      if mask <> overlap then reason = 'target.call.provider.callback.unproved'
    end
    _callpolicystate[functionid] = 3; _callpolicyreason[functionid] = reason
    if reason = '' then do; _callpolicystate[functionid] = 2; return 1; end
    return 0
  canonical: method = .void
    call preparecallpolicy()
    if _status <> 'building' then return
    j = .int; mask = .int; bit = .int; ordinal = .int; id = .int; refid = .int; flagmask = .int
    resmask = .int; othermask = .int; allmask = .int
    program = .bindingprogram; integerdomain = .int; selectionkind = .int; windowref = .int
    hookcaptures = .int[]
    target = dereference _owner; catalog = .llrxascatalog..catalog(); value = .lltarget..operand
    do n = 1 to target.records()
      item = target.record(n); opid = item.id()
      if operation(opid) = 0 then return
      if item.kind() <> 'instruction' then do
        do j = 1 to item.operands()
          value = item.operand(j)
          if value.kind() = 'R' then ignored = addref(opid,j,'metadata')
        end
        if item.kind() = '.traceevent' & item.registerrefs() > 0 then do
          refid = addref(opid,0,'metadata'); type = item.operand(4); flags = item.operand(9)
          mask = catalog.componentmask(type.text())
          if flags.index() % 2 then mask = catalog.componentmask('whole')
          call domainevents(opid,'observe',refid,mask)
        end
        else if item.registerrefs() > 0 then do
          do j = 1 to _rcount[opid]
