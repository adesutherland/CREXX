/* cREXX License (MIT). Checked operational target transfers, never proofs. */
options levelb
namespace lltargettransfer expose profile profiledraft instruction refview action domain bindingprogram selectionbinding callcausefact
import rxfnsb
import llir
import lltarget
import llrxascatalog
import _rxlinkinline

boot: initialiser expose serial
  serial = 0
  return
nextidentity: procedure = .int expose serial
  if serial = 9223372036854775807 then assembler signal "ERROR","LL_TARGET_TRANSFER: identities exhausted"
  serial = serial + 1
  return serial
bad: procedure = .void
  arg message = .string
  assembler signal "ERROR",message
  return

/** Pure signature lookup also used during construction, before a receiver
 * exists. Letters describe typed operand fields, not opcode names. */
bindingform: procedure = .string
  arg kind = .string, arity = .int
  select
    when wordpos(kind,'link swap icopy reference parent') > 0 then return 'RR'
    when wordpos(kind,'unlink endlife clear captureint putint minattrscaptured') > 0 then return 'R'
    when kind = 'branch' then return 'L'
    when kind = 'linkindex' then return 'II'
    when kind = 'linkindexreg' then return 'IR'
    when kind = 'argument' then return 'RQ'
    when kind = 'argumentadd' then return 'RQI'
    when kind = 'capturedargument' then do
      if arity = 3 then return 'RQI'
      return 'RQ'
    end
    when wordpos(kind,'attribute attribute1') > 0 then return 'RRQ'
    when wordpos(kind,'linktoattribute linktoattribute1') > 0 then return 'QRR'
    when wordpos(kind,'unlinkattribute unlinkattribute1') > 0 then return 'QR'
    when wordpos(kind,'flags setint setattrs minattrs') > 0 then return 'RI'
    when kind = 'captureindex' then return 'QI'
    when kind = 'attribute1add' then return 'RRQI'
    when kind = 'attribute1captured' then return 'RR'
    when kind = 'qualifiedglobal' then return 'RSI'
    otherwise return '?'
  end
  return '?'

/** A domain names one published component/flag/context bit. Native bit values
 * are opaque selectors extracted from the catalogue, not a copied flag ABI.
 * Whole domains cover components and flags, never ambient context. */
domain: class
  _id = .int
  _kind = .string
  _key = .string
  _nativebit = .int
  *: factory
    arg id = .int, kind = .string, key = .string, nativebit = 0
    _id = id; _kind = kind; _key = key; _nativebit = nativebit
    return
  id: method = .int
    return _id
  kind: method = .string
    return _kind
  key: method = .string
    return _key
  nativebit: method = .int
    return _nativebit
  complete: method = .int
    return 1

/** Reference selectors preserve bank/slot identity and entry/base roles.
 * An implicit window with unknown extent remains one symbolic reference. */
refview: class
  _id = .int
  _op = .int
  _ordinal = .int
  _kind = .string
  _anchor = .string
  _extentknown = .int
  _extent = .int
  _value = .lltarget..operand
  _role = .string
  _roleordinal = .int
  _addresskind = .string
  _baseid = .int
  _selectorkind = .string
  _selectorid = .int
  _selectorvalue = .lltarget..operand
  _selectoroffset = .int
  _targetbank = .string
  _targetanchor = .string
  *: factory
    arg id = .int, opid = .int, ordinal = .int, kind = .string, anchor = .string, value = .lltarget..operand, extentknown = 1, extent = 1, role = '', roleordinal = 0, addresskind = '', baseid = 0, selectorkind = 'none', selectorid = 0, ?selectorvalue = .lltarget..operand, selectoroffset = 0, targetbank = '', targetanchor = 'active'
    _id = id; _op = opid; _ordinal = ordinal; _kind = kind; _anchor = anchor
    _value = value; _extentknown = extentknown; _extent = extent; _role = role; _roleordinal = roleordinal
    _addresskind = addresskind; _baseid = baseid; _selectorkind = selectorkind; _selectorid = selectorid
    if ?selectorvalue then _selectorvalue = selectorvalue
    _selectoroffset = selectoroffset; _targetbank = targetbank; _targetanchor = targetanchor
    return
  id: method = .int
    return _id
  opid: method = .int
    return _op
  kind: method = .string
    return _kind
  operandordinal: method = .int
    return _ordinal
  operand: method = .lltarget..operand
    return _value
  bank: method = .string
    return _value.bank()
  index: method = .int
    return _value.index()
  slot: method = .int
    return _value.slotid()
  function: method = .int
    return _value.procedureid()
  anchor: method = .string
    return _anchor
  extentknown: method = .int
    return _extentknown
  extent: method = .int
    return _extent
  /** Recipe role preserves active capture versus destination slot identity.
   * Snapshotting the destination's active and base bindings is not a read of
   * those backing values and remains the scoped storage transfer's duty. */
  role: method = .string
    return _role
  roleordinal: method = .int
    return _roleordinal
  addresskind: method = .string
    return _addresskind
  baseid: method = .int
    return _baseid
  selectorkind: method = .string
    return _selectorkind
  selectorid: method = .int
    return _selectorid
  selectorvalue: method = .lltarget..operand
    return _selectorvalue
  selectoroffset: method = .int
    return _selectoroffset
  targetbank: method = .string
    return _targetbank
  targetanchor: method = .string
    return _targetanchor
  unknownreason: method = .string
    if _kind = 'address' then return 'reference.address.requires.point.resolution'
    if _extentknown = 0 then return 'reference.window.extent.unknown'
    return ''

/** Ordered operational event. A read is a dependency, not necessarily a typed
 * observation; transport does not demand availability of unobserved payloads.
 * Must writes apply only on the indicated normal/failure event family. */
action: class
  _id = .int
  _op = .int
  _ordinal = .int
  _kind = .string
  _subject = .int
  _domain = .int
  _sourcekind = .string
  _source = .int
  _literal = .lltarget..operand
  _certainty = .string
  _when = .string
  _phase = .string
  _detail = .string
  _offset = .int
  _observation = .string
  _intrinsicfootprint = .int
  *: factory
    arg id = .int, opid = .int, ordinal = .int, kind = .string, subject = .int, domainid = .int, sourcekind = .string, sourceid = .int, literal = .lltarget..operand, certainty = .string, path = .string, phase = .string, detail = .string, offset = 0, observation = 'unknown', intrinsicfootprint = 0
    _id = id; _op = opid; _ordinal = ordinal; _kind = kind; _subject = subject; _domain = domainid
    _sourcekind = sourcekind; _source = sourceid; _literal = literal; _certainty = certainty
    _when = path; _phase = phase; _detail = detail; _offset = offset
    _observation = observation; _intrinsicfootprint = intrinsicfootprint
    return
  id: method = .int
    return _id
  opid: method = .int
    return _op
  ordinal: method = .int
    return _ordinal
  kind: method = .string
    return _kind
  subject: method = .int
    return _subject
  domain: method = .int
    return _domain
  sourcekind: method = .string
    return _sourcekind
  sourceid: method = .int
    return _source
  literal: method = .lltarget..operand
    return _literal
  value: method = .lltarget..operand
    return _literal
  certainty: method = .string
    return _certainty
  path: method = .string
    return _when
  phase: method = .string
    return _phase
  visibility: method = .string
    return _when
  detail: method = .string
    return _detail
  offset: method = .int
    return _offset
  /** Operational observation footprint, never an absence/preservation proof. */
  observation: method = .string
    return _observation
  /** Complete typed intrinsic Rexx-value footprint of an external action.
   * Host/reentry, signal and external observability obligations are separate.
   * Zero is unknown, never a proved empty intrinsic footprint. */
  intrinsicfootprint: method = .int
    return _intrinsicfootprint
  unknownreason: method = .string
    if _certainty = 'unknown' | _kind = 'unknown' then return _detail
    return ''

/** One canonical CALL cause at an exact frozen operation. These are checked
 * ingress observations, not permission to remove a callback or activation.
 * A disproved condition is distinct from an unknown propagated signal set. */
callcausefact: class
  _owner = reference .lltargettransfer..profile
  _identity = .int
  _operation = .int
  _ordinal = .int
  *: factory
    arg owner = reference .lltargettransfer..profile, operation = .int, ordinal = .int
    _owner = owner; _operation = operation; _ordinal = ordinal
    profile = dereference owner; _identity = profile.identity()
    return
  valid: method = .int
    if <refvalid>(_owner) = 0 then return 0
    profile = dereference _owner
    if profile.valid() = 0 | profile.identity() <> _identity then return 0
    targetref = profile.owner(); target = dereference targetref; graphref = target.ir(); graph = dereference graphref
    if _operation < 1 | _operation > graph.operations() then return 0
    item = target.at(_operation); catalog = .llrxascatalog..catalog()
    if item.valid() = 0 then return 0
    return item.kind() = 'instruction' & _ordinal > 0 & _ordinal <= catalog.callcauses(item.opcode())
  require: method = .void
    if valid() = 0 then call bad('LL_TARGET_OWNER: CALL cause expired, replaced or unavailable')
    return
  operation: method = .int
    return _operation
  ordinal: method = .int
    return _ordinal
  kind: method = .string
    call require(); profile = dereference _owner; instruction = profile.instruction(_operation); item = instruction.record()
    catalog = .llrxascatalog..catalog(); return catalog.callcausekind(item.opcode(),_ordinal)
  checkpoint: method = .string
    call require(); profile = dereference _owner; instruction = profile.instruction(_operation); item = instruction.record()
    catalog = .llrxascatalog..catalog(); return catalog.callcausecheckpoint(item.opcode(),_ordinal)
  condition: method = .string
    call require(); profile = dereference _owner; instruction = profile.instruction(_operation); item = instruction.record()
    catalog = .llrxascatalog..catalog(); return catalog.callcausecondition(item.opcode(),_ordinal)
  sourcekind: method = .int
    call require(); profile = dereference _owner; instruction = profile.instruction(_operation); item = instruction.record()
    catalog = .llrxascatalog..catalog(); return catalog.callcausesource(item.opcode(),_ordinal)
  callbacks: method = .int
    call require(); profile = dereference _owner; instruction = profile.instruction(_operation); item = instruction.record()
    catalog = .llrxascatalog..catalog(); return catalog.callcausecallbacks(item.opcode(),_ordinal)
  names: method = .string
    call require(); profile = dereference _owner; instruction = profile.instruction(_operation); item = instruction.record()
    catalog = .llrxascatalog..catalog(); return catalog.callcausenames(item.opcode(),_ordinal)
  possible: method = .int
    call require(); profile = dereference _owner; return profile.callcausepossible(_operation,_ordinal)
  status: method = .string
    if valid() = 0 then return 'invalid'
    if possible() = 0 then return 'proved'
    if sourcekind() = 1 & names() <> '' then return 'proved'
    return 'unknown'
  reason: method = .string
    if valid() = 0 then return 'target.call.cause.owner.expired.or.replaced'
    if status() = 'proved' then return ''
    return 'target.call.cause.' || kind() || '.unproved'
  /** Checkpoints preceding provider execution have not entered its frame.
   * Fused preparation may already have committed, hence partial, not before. */
  phase: method = .string
    call require(); profile = dereference _owner; instruction = profile.instruction(_operation); item = instruction.record()
    catalog = .llrxascatalog..catalog(); point = checkpoint()
    if point = 'target' & catalog.callprefix(item.opcode()) = '' then return 'before'
    if wordpos(point,'target initializer after-initializer frame-allocation') > 0 then return 'partial'
    return 'unknown'

instruction: class
  _profile = reference .lltargettransfer..profile
  _profileid = .int
  _op = .int
  *: factory
    arg owner = reference .lltargettransfer..profile, opid = .int
    _profile = owner; _op = opid
    view = dereference owner; _profileid = view.identity()
    return
  require: method = .void
    if <refvalid>(_profile) = 0 then do; call bad('LL_TARGET_OWNER: expired instruction profile'); return; end
    view = dereference _profile
    if view.valid() = 0 | view.identity() <> _profileid then call bad('LL_TARGET_OWNER: replaced instruction profile')
    return
  opid: method = .int
    return _op
  record: method = .lltarget..record
    call require()
    view = dereference _profile; target_ref = view.owner(); target = dereference target_ref
    return target.at(_op)
  function: method = .int
    item = record(); return item.procedureid()
  references: method = .int
    call require()
    view = dereference _profile; return view.references(_op)
  ref: method = .lltargettransfer..refview
    arg ordinal = .int
    call require()
    view = dereference _profile; return view.referenceat(_op,ordinal)
  actions: method = .int
    call require()
    view = dereference _profile; return view.actions(_op)
  action: method = .lltargettransfer..action
    arg ordinal = .int
    call require()
    view = dereference _profile; return view.actionat(_op,ordinal)
  complete: method = .int
    arg family = .string
    call require()
    view = dereference _profile; return view.complete(_op,family)
  unknownreason: method = .string
    arg family = .string
    call require()
    view = dereference _profile; return view.unknownreason(_op,family)

/** First pass over the canonical semantic recipe vocabulary. No reference or
 * action is published until every step, operand and capture dependency checks.
 * Unsupported vocabulary is distinct from malformed operational data. */
bindingprogram: class
  _status = .string
  _reason = .string
  _kind = .string[]
  _one = .int[]
  _two = .int[]
  _three = .int[]
  _four = .int[]
  _arity = .int[]
  _work = .int
  _bytes = .int
  *: factory
    arg item = .lltarget..record, text = .string, work = .int, allowempty = 0
    last = .int; step = .string; tokens = .string; kind = .string; arity = .int; signature = .string
    token = .string; ordinal = .int; value = .lltarget..operand; expected = .string; row = .int; j = .int
    stepone = .int; steptwo = .int; stepthree = .int; stepfour = .int
    _status = 'ok'; first = 1; valuecapture = 0; indexcapture = 0
    _work = length(text) * 4 + 1; _bytes = length(text) * 128 + 64
    if work < 1 | length(text) > work then do; _status = 'limit'; _reason = 'LL_RESOURCE_LIMIT: binding recipe validation'; return; end
    if text = '' then do
      if allowempty = 0 then do; _status = 'unsupported'; _reason = 'catalog.binding.recipe.missing'; end
      return
    end
    do while first <= length(text)
      last = pos(';',text,first); if last = 0 then last = length(text) + 1
      step = substr(text,first,last - first)
      if step = '' | left(step,1) = ':' | pos('::',step) > 0 | right(step,1) = ':' | verify(step,'abcdefghijklmnopqrstuvwxyz0123456789:') <> 0 then do
        _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: malformed step'; return
      end
      tokens = translate(step,' ',':'); kind = word(tokens,1); arity = words(tokens) - 1
      signature = bindingform(kind,arity)
      if signature = '?' then do; _status = 'unsupported'; _reason = 'catalog.binding.recipe.unsupported.' || kind; return; end
      if length(signature) <> arity then do; _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: step arity'; return; end
      stepone = 0; steptwo = 0; stepthree = 0; stepfour = 0
      do j = 1 to arity
        token = word(tokens,j + 1)
        if token = '' | length(token) > 10 | verify(token,'0123456789') <> 0 then do; _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: operand ordinal'; return; end
        ordinal = token as .int
        if ordinal < 1 | ordinal > item.operands() then do; _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: operand ordinal'; return; end
        value = item.operand(ordinal); expected = substr(signature,j,1)
        if (expected = 'Q' & value.kind() <> 'R' & value.kind() <> 'I') | (expected <> 'Q' & value.kind() <> expected) then do
          _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: operand kind'; return
        end
        if j = 1 then stepone = ordinal
        if j = 2 then steptwo = ordinal
        if j = 3 then stepthree = ordinal
        if j = 4 then stepfour = ordinal
      end
      if kind = 'putint' & valuecapture = 0 then do; _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: missing scalar capture'; return; end
      if wordpos(kind,'minattrscaptured attribute1captured') > 0 & indexcapture = 0 then do; _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: missing index capture'; return; end
      if kind = 'captureint' then valuecapture = 1
      if kind = 'captureindex' then indexcapture = 1
      row = _kind[0] + 1; _kind[row] = kind; _arity[row] = arity
      _one[row] = stepone; _two[row] = steptwo; _three[row] = stepthree; _four[row] = stepfour
      if last = length(text) then do; _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: trailing step separator'; return; end
      first = last + 1
    end
    return
  unavailable: factory
    arg state = .string, reason = .string
    _status = state; _reason = reason
    return
  usedwork: method = .int
    return _work
  usedbytes: method = .int
    return _bytes
  status: method = .string
    return _status
  reason: method = .string
    return _reason
  steps: method = .int
    return _kind[0]
  kind: method = .string
    arg row = .int
    return _kind[row]
  arity: method = .int
    arg row = .int
    return _arity[row]
  operand: method = .int
    arg row = .int, ordinal = .int
    select ordinal
      when 1 then return _one[row]
      when 2 then return _two[row]
      when 3 then return _three[row]
      when 4 then return _four[row]
      otherwise return 0
    end
    return 0

/** A native-enrolled owner tuple. Public construction never mints a proof:
 * every use rechecks the live context capability and actual owner revisions. */
selectionbinding: class
  _caller = reference .lltarget..module
  _provider = reference .lltarget..module
  _operation = .int
  _procedure = .int
  _typeoperation = .int
  _capability = .object
  _providerprofile = reference .lltargettransfer..profile
  *: factory
    arg caller = reference .lltarget..module, operation = .int, provider = reference .lltarget..module, procedureid = .int, ?capability = .object, typeoperation = 0, ?providerprofile = reference .lltargettransfer..profile
    _caller = caller; _operation = operation; _provider = provider; _procedure = procedureid
    if ?capability then _capability = capability
    _typeoperation = typeoperation
    if ?providerprofile then _providerprofile = providerprofile
    return
  valid: method = .int
    if <refvalid>(_caller) = 0 | <refvalid>(_provider) = 0 | _operation < 1 | _procedure < 2 then return 0
    do
      return _rxlinkinline..selectioncheck(_capability,_caller,_operation,_provider,_procedure,_typeoperation) = 1
    on signal
      /* Ordinary standalone VMs need not install the private RXVML routes.
       * An unavailable checker never upgrades caller-created object bytes. */
      return 0
    end
    return 0
  status: method = .string
    if valid() then return 'proved'
    return 'unknown'
  reason: method = .string
    if valid() then return ''
    return 'target.selection.authority.unavailable'
  provider: method = reference .lltarget..module
    return _provider
  procedure: method = .int
    return _procedure
  selection: method = .int
    return _operation
  typeoperation: method = .int
    return _typeoperation
  bindingidentity: method = .string
    if valid() = 0 then return ''
    caller = dereference _caller
    return 'native.owner.' || caller.identity() || '.operation.' || _operation || '.type.' || _typeoperation
  providerprofile: method = reference .lltargettransfer..profile
    return _providerprofile

/** Native enrollment is monotone in source/type identity. This yields bounded
 * ordinal lookup without a full-image scan; duplicate/conflicting keys fail. */
bindingbucket: class
  _bindings = .lltargettransfer..selectionbinding[]
  _lasttype = .int
  *: factory
    return
  append: method = .int
    arg proof = .lltargettransfer..selectionbinding
    if _bindings[0] > 0 & proof.typeoperation() <= _lasttype then return 0
    _lasttype = proof.typeoperation(); _bindings[_bindings[0] + 1] = proof
    return 1
  count: method = .int
    return _bindings[0]
  at: method = .lltargettransfer..selectionbinding
    arg ordinal = .int
    return _bindings[ordinal]

/** Immutable operational profile bound to one exact published target owner.
 * Canonical profiles never infer missing mnemonic semantics. Rich profiles
 * supply independent operational premises, not asserted analysis results. */
profile: class
  _owner = reference .lltarget..module
  _graph = reference .llir..module
  _identity = .int
  _revision = .int
  _catalog = .string
  _premise = .string
  _executionroot = .int
  _executioncontext = .string
  _executioncalls = .int
  _executionmembers = .int[]
  _executionreason = .string
  _initializerfree = .int
  _callpolicystate = .int[]
  _callpolicyreason = .string[]
  _nativebindings = .bindingbucket[]
  _nativepresent = .int[]
  _status = .string
  _message = .string
  _sealed = .int
  _prepared = .int
  _work = .int
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  _declared = .int[]
  _relocationknown = .int[]
  _boundaryobservations = .string[]
  _refs = .lltargettransfer..refview[]
  _acts = .lltargettransfer..action[]
  _domains = .lltargettransfer..domain[]
  _rfirst = .int[]
  _rlast = .int[]
  _rnext = .int[]
  _rcount = .int[]
  _afirst = .int[]
  _alast = .int[]
  _anext = .int[]
  _acount = .int[]
  _unknownop = .int[]
  _unknownfirst = .int[]
  _unknownnext = .int[]
  _unknownfamily = .string[]
  _unknownreason = .string[]
  *: factory
    arg owner = reference .lltarget..module, work = 1000000, bytes = 67108864
    _identity = nextidentity(); _owner = owner; _premise = 'canonical'
    _status = 'building'; _worklimit = work; _bytelimit = bytes
    return
  /** Caller-declared standalone execution context, bound to this exact main
   * owner. It is not inferred from RXAS and does not describe arbitrary linker
   * or foreign entries. Canonical instruction semantics remain unchanged. */
  closedmain: factory
    arg owner = reference .lltarget..module, rootfunction = .int, executioncontext = .string, work = 1000000, bytes = 67108864
    _identity = nextidentity(); _owner = owner; _premise = 'canonical'
    _executionroot = rootfunction; _executioncontext = executioncontext
    _status = 'building'; _worklimit = work; _bytelimit = bytes
    if wordpos(executioncontext,'closed-main-default-halt.v1 closed-main-static-exact-default-halt.v1') = 0 | rootfunction < 2 then do
      _status = 'invalid'; _message = 'LL_TARGET_CONTEXT: explicit closed-main default-HALT execution contract required'
    end
    return
  /** Stronger membership is checked from the exact declared invocation.
   * The VM's mixed fresh defaults are not an all-HALT premise. */
  closedcalls: factory
    arg owner = reference .lltarget..module, rootfunction = .int, executioncontext = .string, work = 1000000, bytes = 67108864
    _identity = nextidentity(); _owner = owner; _premise = 'canonical'
    _executionroot = rootfunction; _executioncontext = executioncontext; _executioncalls = 1
    _status = 'building'; _worklimit = work; _bytelimit = bytes
    if wordpos(executioncontext,'closed-main-default-halt.v1 closed-main-static-exact-default-halt.v1') = 0 | rootfunction < 2 then do
      _status = 'invalid'; _message = 'LL_TARGET_CONTEXT: explicit closed-main default-HALT execution contract required'
    end
    return
  premises: factory
    arg owner = reference .lltarget..module, premiseid = .string, work = 1000000, bytes = 67108864
    _identity = nextidentity(); _owner = owner; _premise = premiseid
    _status = 'building'; _worklimit = work; _bytelimit = bytes
    if premiseid = '' | premiseid = 'canonical' then do
      _status = 'invalid'; _message = 'LL_TARGET_TRANSFER: independent premise identity required'
    end
    return
  ensureprepared: method = .void
    if _prepared | _status <> 'building' then return
    _prepared = 1
    call prepare(_owner,_premise,_worklimit,_bytelimit)
    if _status = 'building' & _executioncontext <> '' then call checkcontext()
    if _status = 'building' & _executioncalls then call checkcalls()
    return
  /** Only a live host-enrolled token can add a binding before materialization.
   * Strings, procedure names and opaque-looking B objects are insufficient. */
  certifybinding: method = .int
    arg operation = .int, provider = reference .lltarget..module, procedureid = .int, capability = .object, ?providerprofile = reference .lltargettransfer..profile
    if ?providerprofile then return certifyselection(operation,provider,procedureid,capability,0,providerprofile)
    return certifyselection(operation,provider,procedureid,capability,0)
  certifyselection: method = .int
    arg operation = .int, provider = reference .lltarget..module, procedureid = .int, capability = .object, typeoperation = 0, ?providerprofile = reference .lltargettransfer..profile
    proof = .lltargettransfer..selectionbinding
    if _status <> 'building' | _prepared | _premise <> 'canonical' then return 0
    if <refvalid>(_owner) = 0 | <refvalid>(provider) = 0 then return 0
    target = dereference _owner; catalog = .llrxascatalog..catalog()
    item = target.at(operation)
    if item.kind() <> 'instruction' then return 0
    if typeoperation = 0 then do; if catalog.callkind(item.opcode()) <> 1 | catalog.callinvokes(item.opcode()) = 0 then return 0; end
    else if catalog.selectionkind(item.opcode()) <> 1 then return 0
    if ?providerprofile then proof = .selectionbinding(_owner,operation,provider,procedureid,capability,typeoperation,providerprofile)
    else proof = .selectionbinding(_owner,operation,provider,procedureid,capability,typeoperation)
    if proof.valid() = 0 then return 0
    growth = max(0,operation - _nativepresent[0])
    if reserve(growth * 24 + 192,growth + 1) = 0 then return 0
