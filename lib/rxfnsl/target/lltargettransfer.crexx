/* cREXX License (MIT). Checked operational target transfers, never proofs. */
options levelb
namespace lltargettransfer expose profile profiledraft instruction refview action domain
import rxfnsb
import llir
import lltarget
import llrxascatalog

boot: initialiser expose serial
  serial = 0
  return
nextidentity: procedure = .int expose serial
  if serial = 9223372036854775807 then assembler signal "ERROR","LL_TARGET_TRANSFER: identities exhausted"
  serial = serial + 1
  return serial
bad: procedure = .void
  arg message = .string
  assembler signal "ERROR",message
  return

/** Pure signature lookup also used during construction, before a receiver
 * exists. Letters describe typed operand fields, not opcode names. */
bindingform: procedure = .string
  arg kind = .string, arity = .int
  select
    when wordpos(kind,'link swap icopy reference parent') > 0 then return 'RR'
    when wordpos(kind,'unlink endlife clear captureint putint minattrscaptured') > 0 then return 'R'
    when kind = 'branch' then return 'L'
    when kind = 'linkindex' then return 'II'
    when kind = 'linkindexreg' then return 'IR'
    when kind = 'argument' then return 'RQ'
    when kind = 'argumentadd' then return 'RQI'
    when kind = 'capturedargument' then do
      if arity = 3 then return 'RQI'
      return 'RQ'
    end
    when wordpos(kind,'attribute attribute1') > 0 then return 'RRQ'
    when wordpos(kind,'linktoattribute linktoattribute1') > 0 then return 'QRR'
    when wordpos(kind,'unlinkattribute unlinkattribute1') > 0 then return 'QR'
    when wordpos(kind,'flags setint setattrs minattrs') > 0 then return 'RI'
    when kind = 'captureindex' then return 'QI'
    when kind = 'attribute1add' then return 'RRQI'
    when kind = 'attribute1captured' then return 'RR'
    when kind = 'qualifiedglobal' then return 'RSI'
    otherwise return '?'
  end
  return '?'

/** A domain names one published component/flag/context bit. Native bit values
 * are opaque selectors extracted from the catalogue, not a copied flag ABI.
 * Whole domains cover components and flags, never ambient context. */
domain: class
  _id = .int
  _kind = .string
  _key = .string
  _nativebit = .int
  *: factory
    arg id = .int, kind = .string, key = .string, nativebit = 0
    _id = id; _kind = kind; _key = key; _nativebit = nativebit
    return
  id: method = .int
    return _id
  kind: method = .string
    return _kind
  key: method = .string
    return _key
  nativebit: method = .int
    return _nativebit
  complete: method = .int
    return 1

/** Reference selectors preserve bank/slot identity and entry/base roles.
 * An implicit window with unknown extent remains one symbolic reference. */
refview: class
  _id = .int
  _op = .int
  _ordinal = .int
  _kind = .string
  _anchor = .string
  _extentknown = .int
  _extent = .int
  _value = .lltarget..operand
  _role = .string
  _roleordinal = .int
  _addresskind = .string
  _baseid = .int
  _selectorkind = .string
  _selectorid = .int
  _selectorvalue = .lltarget..operand
  _selectoroffset = .int
  _targetbank = .string
  _targetanchor = .string
  *: factory
    arg id = .int, opid = .int, ordinal = .int, kind = .string, anchor = .string, value = .lltarget..operand, extentknown = 1, extent = 1, role = '', roleordinal = 0, addresskind = '', baseid = 0, selectorkind = 'none', selectorid = 0, ?selectorvalue = .lltarget..operand, selectoroffset = 0, targetbank = '', targetanchor = 'active'
    _id = id; _op = opid; _ordinal = ordinal; _kind = kind; _anchor = anchor
    _value = value; _extentknown = extentknown; _extent = extent; _role = role; _roleordinal = roleordinal
    _addresskind = addresskind; _baseid = baseid; _selectorkind = selectorkind; _selectorid = selectorid
    if ?selectorvalue then _selectorvalue = selectorvalue
    _selectoroffset = selectoroffset; _targetbank = targetbank; _targetanchor = targetanchor
    return
  id: method = .int
    return _id
  opid: method = .int
    return _op
  kind: method = .string
    return _kind
  operandordinal: method = .int
    return _ordinal
  operand: method = .lltarget..operand
    return _value
  bank: method = .string
    return _value.bank()
  index: method = .int
    return _value.index()
  slot: method = .int
    return _value.slotid()
  function: method = .int
    return _value.procedureid()
  anchor: method = .string
    return _anchor
  extentknown: method = .int
    return _extentknown
  extent: method = .int
    return _extent
  /** Recipe role preserves active capture versus destination slot identity.
   * Snapshotting the destination's active and base bindings is not a read of
   * those backing values and remains the scoped storage transfer's duty. */
  role: method = .string
    return _role
  roleordinal: method = .int
    return _roleordinal
  addresskind: method = .string
    return _addresskind
  baseid: method = .int
    return _baseid
  selectorkind: method = .string
    return _selectorkind
  selectorid: method = .int
    return _selectorid
  selectorvalue: method = .lltarget..operand
    return _selectorvalue
  selectoroffset: method = .int
    return _selectoroffset
  targetbank: method = .string
    return _targetbank
  targetanchor: method = .string
    return _targetanchor
  unknownreason: method = .string
    if _kind = 'address' then return 'reference.address.requires.point.resolution'
    if _extentknown = 0 then return 'reference.window.extent.unknown'
    return ''

/** Ordered operational event. A read is a dependency, not necessarily a typed
 * observation; transport does not demand availability of unobserved payloads.
 * Must writes apply only on the indicated normal/failure event family. */
action: class
  _id = .int
  _op = .int
  _ordinal = .int
  _kind = .string
  _subject = .int
  _domain = .int
  _sourcekind = .string
  _source = .int
  _literal = .lltarget..operand
  _certainty = .string
  _when = .string
  _phase = .string
  _detail = .string
  _offset = .int
  *: factory
    arg id = .int, opid = .int, ordinal = .int, kind = .string, subject = .int, domainid = .int, sourcekind = .string, sourceid = .int, literal = .lltarget..operand, certainty = .string, path = .string, phase = .string, detail = .string, offset = 0
    _id = id; _op = opid; _ordinal = ordinal; _kind = kind; _subject = subject; _domain = domainid
    _sourcekind = sourcekind; _source = sourceid; _literal = literal; _certainty = certainty
    _when = path; _phase = phase; _detail = detail; _offset = offset
    return
  id: method = .int
    return _id
  opid: method = .int
    return _op
  ordinal: method = .int
    return _ordinal
  kind: method = .string
    return _kind
  subject: method = .int
    return _subject
  domain: method = .int
    return _domain
  sourcekind: method = .string
    return _sourcekind
  sourceid: method = .int
    return _source
  literal: method = .lltarget..operand
    return _literal
  value: method = .lltarget..operand
    return _literal
  certainty: method = .string
    return _certainty
  path: method = .string
    return _when
  phase: method = .string
    return _phase
  visibility: method = .string
    return _when
  detail: method = .string
    return _detail
  offset: method = .int
    return _offset
  unknownreason: method = .string
    if _certainty = 'unknown' | _kind = 'unknown' then return _detail
    return ''

instruction: class
  _profile = reference .lltargettransfer..profile
  _profileid = .int
  _op = .int
  *: factory
    arg owner = reference .lltargettransfer..profile, opid = .int
    _profile = owner; _op = opid
    view = dereference owner; _profileid = view.identity()
    return
  require: method = .void
    if <refvalid>(_profile) = 0 then do; call bad('LL_TARGET_OWNER: expired instruction profile'); return; end
    view = dereference _profile
    if view.valid() = 0 | view.identity() <> _profileid then call bad('LL_TARGET_OWNER: replaced instruction profile')
    return
  opid: method = .int
    return _op
  record: method = .lltarget..record
    call require()
    view = dereference _profile; target_ref = view.owner(); target = dereference target_ref
    return target.at(_op)
  function: method = .int
    item = record(); return item.procedureid()
  references: method = .int
    call require()
    view = dereference _profile; return view.references(_op)
  ref: method = .lltargettransfer..refview
    arg ordinal = .int
    call require()
    view = dereference _profile; return view.referenceat(_op,ordinal)
  actions: method = .int
    call require()
    view = dereference _profile; return view.actions(_op)
  action: method = .lltargettransfer..action
    arg ordinal = .int
    call require()
    view = dereference _profile; return view.actionat(_op,ordinal)
  complete: method = .int
    arg family = .string
    call require()
    view = dereference _profile; return view.complete(_op,family)
  unknownreason: method = .string
    arg family = .string
    call require()
    view = dereference _profile; return view.unknownreason(_op,family)

/** First pass over the canonical semantic recipe vocabulary. No reference or
 * action is published until every step, operand and capture dependency checks.
 * Unsupported vocabulary is distinct from malformed operational data. */
bindingprogram: class
  _status = .string
  _reason = .string
  _kind = .string[]
  _one = .int[]
  _two = .int[]
  _three = .int[]
  _four = .int[]
  _arity = .int[]
  *: factory
    arg item = .lltarget..record, text = .string, work = .int, allowempty = 0
    last = .int; step = .string; tokens = .string; kind = .string; arity = .int; signature = .string
    token = .string; ordinal = .int; value = .lltarget..operand; expected = .string; row = .int; j = .int
    stepone = .int; steptwo = .int; stepthree = .int; stepfour = .int
    _status = 'ok'; first = 1; valuecapture = 0; indexcapture = 0
    if work < 1 | length(text) > work then do; _status = 'limit'; _reason = 'LL_RESOURCE_LIMIT: binding recipe validation'; return; end
    if text = '' then do
      if allowempty = 0 then do; _status = 'unsupported'; _reason = 'catalog.binding.recipe.missing'; end
      return
    end
    do while first <= length(text)
      last = pos(';',text,first); if last = 0 then last = length(text) + 1
      step = substr(text,first,last - first)
      if step = '' | left(step,1) = ':' | pos('::',step) > 0 | right(step,1) = ':' | verify(step,'abcdefghijklmnopqrstuvwxyz0123456789:') <> 0 then do
        _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: malformed step'; return
      end
      tokens = translate(step,' ',':'); kind = word(tokens,1); arity = words(tokens) - 1
      signature = bindingform(kind,arity)
      if signature = '?' then do; _status = 'unsupported'; _reason = 'catalog.binding.recipe.unsupported.' || kind; return; end
      if length(signature) <> arity then do; _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: step arity'; return; end
      stepone = 0; steptwo = 0; stepthree = 0; stepfour = 0
      do j = 1 to arity
        token = word(tokens,j + 1)
        if token = '' | length(token) > 10 | verify(token,'0123456789') <> 0 then do; _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: operand ordinal'; return; end
        ordinal = token as .int
        if ordinal < 1 | ordinal > item.operands() then do; _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: operand ordinal'; return; end
        value = item.operand(ordinal); expected = substr(signature,j,1)
        if (expected = 'Q' & value.kind() <> 'R' & value.kind() <> 'I') | (expected <> 'Q' & value.kind() <> expected) then do
          _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: operand kind'; return
        end
        if j = 1 then stepone = ordinal
        if j = 2 then steptwo = ordinal
        if j = 3 then stepthree = ordinal
        if j = 4 then stepfour = ordinal
      end
      if kind = 'putint' & valuecapture = 0 then do; _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: missing scalar capture'; return; end
      if wordpos(kind,'minattrscaptured attribute1captured') > 0 & indexcapture = 0 then do; _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: missing index capture'; return; end
      if kind = 'captureint' then valuecapture = 1
      if kind = 'captureindex' then indexcapture = 1
      row = _kind[0] + 1; _kind[row] = kind; _arity[row] = arity
      _one[row] = stepone; _two[row] = steptwo; _three[row] = stepthree; _four[row] = stepfour
      if last = length(text) then do; _status = 'invalid'; _reason = 'LL_TARGET_RECIPE: trailing step separator'; return; end
      first = last + 1
    end
    return
  status: method = .string
    return _status
  reason: method = .string
    return _reason
  steps: method = .int
    return _kind[0]
  kind: method = .string
    arg row = .int
    return _kind[row]
  arity: method = .int
    arg row = .int
    return _arity[row]
  operand: method = .int
    arg row = .int, ordinal = .int
    select ordinal
      when 1 then return _one[row]
      when 2 then return _two[row]
      when 3 then return _three[row]
      when 4 then return _four[row]
      otherwise return 0
    end
    return 0

/** Immutable operational profile bound to one exact published target owner.
 * Canonical profiles never infer missing mnemonic semantics. Rich profiles
 * supply independent operational premises, not asserted analysis results. */
profile: class
  _owner = reference .lltarget..module
  _graph = reference .llir..module
  _identity = .int
  _revision = .int
  _catalog = .string
  _premise = .string
  _executionroot = .int
  _executioncontext = .string
  _executioncalls = .int
  _executionmembers = .int[]
  _executionreason = .string
  _status = .string
  _message = .string
  _sealed = .int
  _prepared = .int
  _work = .int
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  _declared = .int[]
  _relocationknown = .int[]
  _refs = .lltargettransfer..refview[]
  _acts = .lltargettransfer..action[]
  _domains = .lltargettransfer..domain[]
  _rfirst = .int[]
  _rlast = .int[]
  _rnext = .int[]
  _rcount = .int[]
  _afirst = .int[]
  _alast = .int[]
  _anext = .int[]
  _acount = .int[]
  _unknownop = .int[]
  _unknownfirst = .int[]
  _unknownnext = .int[]
  _unknownfamily = .string[]
  _unknownreason = .string[]
  *: factory
    arg owner = reference .lltarget..module, work = 1000000, bytes = 67108864
    _identity = nextidentity(); _owner = owner; _premise = 'canonical'
    _status = 'building'; _worklimit = work; _bytelimit = bytes
    return
  /** Caller-declared standalone execution context, bound to this exact main
   * owner. It is not inferred from RXAS and does not describe arbitrary linker
   * or foreign entries. Canonical instruction semantics remain unchanged. */
  closedmain: factory
    arg owner = reference .lltarget..module, rootfunction = .int, executioncontext = .string, work = 1000000, bytes = 67108864
    _identity = nextidentity(); _owner = owner; _premise = 'canonical'
    _executionroot = rootfunction; _executioncontext = executioncontext
    _status = 'building'; _worklimit = work; _bytelimit = bytes
    if wordpos(executioncontext,'closed-main-default-halt.v1 closed-main-static-exact-default-halt.v1') = 0 | rootfunction < 2 then do
      _status = 'invalid'; _message = 'LL_TARGET_CONTEXT: explicit closed-main default-HALT execution contract required'
    end
    return
  /** Stronger membership is checked from the exact declared invocation.
   * The VM's mixed fresh defaults are not an all-HALT premise. */
  closedcalls: factory
    arg owner = reference .lltarget..module, rootfunction = .int, executioncontext = .string, work = 1000000, bytes = 67108864
    _identity = nextidentity(); _owner = owner; _premise = 'canonical'
    _executionroot = rootfunction; _executioncontext = executioncontext; _executioncalls = 1
    _status = 'building'; _worklimit = work; _bytelimit = bytes
    if wordpos(executioncontext,'closed-main-default-halt.v1 closed-main-static-exact-default-halt.v1') = 0 | rootfunction < 2 then do
      _status = 'invalid'; _message = 'LL_TARGET_CONTEXT: explicit closed-main default-HALT execution contract required'
    end
    return
  premises: factory
    arg owner = reference .lltarget..module, premiseid = .string, work = 1000000, bytes = 67108864
    _identity = nextidentity(); _owner = owner; _premise = premiseid
    _status = 'building'; _worklimit = work; _bytelimit = bytes
    if premiseid = '' | premiseid = 'canonical' then do
      _status = 'invalid'; _message = 'LL_TARGET_TRANSFER: independent premise identity required'
    end
    return
  ensureprepared: method = .void
    if _prepared | _status <> 'building' then return
    _prepared = 1
    call prepare(_owner,_premise,_worklimit,_bytelimit)
    if _status = 'building' & _executioncontext <> '' then call checkcontext()
    if _status = 'building' & _executioncalls then call checkcalls()
    return
  run: method = .void
    if _status <> 'building' then return
    call ensureprepared()
    if _premise = 'canonical' & _status = 'building' then do
      call canonical(); ignored = seal()
    end
    return
  prepare: method = .void
    arg owner = reference .lltarget..module, premiseid = .string, work = .int, bytes = .int
    _owner = owner; _premise = premiseid
    if work < 1 | bytes < 1 then do; call reject('limit','LL_RESOURCE_LIMIT: target.transfer budgets'); return; end
    if <refvalid>(owner) = 0 then do; call reject('invalid','LL_TARGET_OWNER: expired transfer owner'); return; end
    target = dereference owner
    if target.valid() = 0 then do; call reject('invalid',target.error()); return; end
    _graph = target.ir(); graph = dereference _graph; _revision = graph.identity()
    catalog = .llrxascatalog..catalog(); _catalog = catalog.fingerprint()
    if reserve(graph.operations() * 72,graph.operations() + 1) = 0 then return
    do i = 1 to graph.operations()
      _declared[i] = 0; _rfirst[i] = 0; _rlast[i] = 0; _rcount[i] = 0
      _relocationknown[i] = 0
      _afirst[i] = 0; _alast[i] = 0; _acount[i] = 0
      _unknownfirst[i] = 0
    end
    return
  checkcontext: method = .void
    target = dereference _owner
    if target.procedureid('main') <> _executionroot then do
      call reject('invalid','LL_TARGET_CONTEXT: closed root is not exact main owner'); return
    end
    catalog = .llrxascatalog..catalog()
    do i = 1 to target.records()
      item = target.record(i)
      if reserve(item.operands() * 16 + 16,1) = 0 then return
      if item.kind() = '.meta' & item.operands() > 1 then do
        option = item.operand(2)
        /* Startup initializers execute outside the selected main body and may
         * change inherited policy. The standalone context cannot seal them. */
        if option.text() = '.initializer' then do
          call reject('unsupported','target.context.startup.initializer.unproved'); return
        end
        if left(option.text(),1) = '.' & option.text() <> '.inline' then do
          call reject('unsupported','target.context.runtime.observer.unproved'); return
        end
      end
    end
    return
  /** Membership is a call-closure check over canonical descriptors, not a
   * second instruction/CFG interpreter. A gap leaves every member canonical.
   * Incoming entries outside this closure are excluded only by the explicit
   * caller-declared closed invocation contract checked above. */
  checkcalls: method = .void
    target = dereference _owner; catalog = .llrxascatalog..catalog()
    item = .lltarget..record; called = .lltarget..operand; body = .lltarget..body
    pending = .int[]; seen = .int[]; indegree = .int[]; heads = .int[]; nextedge = .int[]; destinations = .int[]; ready = .int[]
    i = .int; fn = .int; destination = .int; edge = .int; code = .int
    if reserve(target.procedures() * 64 + 64,target.procedures() + 1) = 0 then return
    do i = 1 to target.procedures()
      body = target.procedure(i); fn = body.functionid()
      seen[fn] = 0; indegree[fn] = 0; heads[fn] = 0; _executionmembers[fn] = 0
    end
    pending[1] = _executionroot; seen[_executionroot] = 1; position = 1
    do while position <= pending[0]
      fn = pending[position]; position = position + 1; body = target.body(fn)
      do i = 1 to body.records()
        if reserve(0,1) = 0 then return
        item = body.record(i)
        if item.kind() <> 'instruction' then iterate
        code = item.opcode()
        if catalog.policyeffect(code) <> 0 then do; _executionreason = 'target.context.call.policy.unproved'; return; end
        if catalog.classification(code) <> 0 | lltarget..normalsuccessors(code) = -2 then do; _executionreason = 'target.context.call.effects.unproved'; return; end
        if catalog.callkind(code) = 0 then do
          if (catalog.semantics(code) <idiv> 2) % 2 then do; _executionreason = 'target.context.call.descriptor.unproved'; return; end
          iterate
        end
        if catalog.callkind(code) <> 1 then do; _executionreason = 'target.context.call.dynamic.unproved'; return; end
        called = item.operand(catalog.calltarget(code)); destination = target.procedureid(called.text())
        if destination = 0 then do; _executionreason = 'target.context.call.foreign.unproved'; return; end
        if reserve(32,1) = 0 then return
        edge = destinations[0] + 1; destinations[edge] = destination; nextedge[edge] = heads[fn]; heads[fn] = edge
        indegree[destination] = indegree[destination] + 1
        if seen[destination] = 0 then do; pending[pending[0] + 1] = destination; seen[destination] = 1; end
      end
    end
    do i = 1 to pending[0]
      fn = pending[i]
      if indegree[fn] = 0 then ready[ready[0] + 1] = fn
    end
    position = 1
    do while position <= ready[0]
      fn = ready[position]; position = position + 1; edge = heads[fn]
      do while edge > 0
        if reserve(0,1) = 0 then return
        destination = destinations[edge]; indegree[destination] = indegree[destination] - 1
        if indegree[destination] = 0 then ready[ready[0] + 1] = destination
        edge = nextedge[edge]
      end
    end
    if ready[0] <> pending[0] then do; _executionreason = 'target.context.call.recursion.unproved'; return; end
    do i = 1 to pending[0]
      fn = pending[i]; _executionmembers[fn] = 1
    end
    return
  reserve: method = .int
    arg bytes = .int, work = .int
    if _status <> 'building' then return 0
    if bytes < 0 | work < 0 | bytes > _bytelimit - _bytes | work > _worklimit - _work then do
      call reject('limit','LL_RESOURCE_LIMIT: target.transfer work/bytes'); return 0
    end
    _bytes = _bytes + bytes; _work = _work + work
    return 1
  reject: method = .void
    arg state = .string, message = .string
    if _status = 'building' then do; _status = state; _message = message; end
    return
  operation: method = .int
    arg opid = .int
    call ensureprepared()
    if _status <> 'building' then return 0
    graph = dereference _graph
    if opid < 1 | opid > graph.operations() then do; call reject('invalid','LL_TARGET_TRANSFER: operation identity'); return 0; end
    item = .lltarget..record(_graph,opid)
    if item.valid() = 0 then do; call reject('invalid','LL_TARGET_TRANSFER: operation is not a source record'); return 0; end
    if reserve(0,1) = 0 then return 0
    _declared[opid] = 1
    return 1
  adddomain: method = .int
    arg kind = .string, key = .string, nativebit = 0
    call ensureprepared()
    value = .lltargettransfer..domain
    if wordpos(kind,'component flag context whole') = 0 | key = '' | nativebit < 0 then do
      call reject('invalid','LL_TARGET_TRANSFER: domain shape'); return 0
    end
    do i = 1 to _domains[0]
      if reserve(0,1) = 0 then return 0
      value = _domains[i]
      if value.key() = key then do
        if value.kind() <> kind | value.nativebit() <> nativebit then call reject('invalid','LL_TARGET_TRANSFER: conflicting domain')
        return i
      end
    end
    if reserve(64 + length(kind) + length(key),1) = 0 then return 0
    id = _domains[0] + 1; _domains[id] = .lltargettransfer..domain(id,kind,key,nativebit)
    return id
  addref: method = .int
    arg opid = .int, ordinal = .int, kind = 'explicit', anchor = 'active', extentknown = 1, extent = 1
    if operation(opid) = 0 then return 0
    item = .lltarget..record(_graph,opid); value = .lltarget..operand
    if wordpos(kind,'explicit window metadata recipe label procedure source clause module') = 0 | wordpos(anchor,'active base entry slot symbolic') = 0 then do
      call reject('invalid','LL_TARGET_TRANSFER: reference kind/anchor'); return 0
    end
    if ordinal < 0 | (kind <> 'recipe' & ordinal > item.operands()) | wordpos(extentknown,'0 1') = 0 | extent < 0 then do
      call reject('invalid','LL_TARGET_TRANSFER: reference selector'); return 0
    end
    role = ''; roleordinal = 0
    if kind = 'recipe' then do
      recipeview = item.recipe()
      if ordinal < 1 | ordinal > recipeview.registers() then do; call reject('invalid','LL_TARGET_TRANSFER: recipe reference ordinal'); return 0; end
      value = item.reciperef(ordinal); role = recipeview.role(ordinal); roleordinal = recipeview.roleordinal(ordinal)
    end
    else if ordinal = 0 then do
      if kind <> 'metadata' | item.registerrefs() = 0 then do; call reject('invalid','LL_TARGET_TRANSFER: metadata selector'); return 0; end
      value = item.registerref(item.registerrefs())
    end
    else value = item.operand(ordinal)
    if wordpos(kind,'explicit window metadata recipe') > 0 & value.kind() <> 'R' then do
      call reject('invalid','LL_TARGET_TRANSFER: register selector expected'); return 0
    end
    if kind = 'label' & value.kind() <> 'L' then do; call reject('invalid','LL_TARGET_TRANSFER: label selector expected'); return 0; end
    if kind = 'procedure' & value.kind() <> 'P' then do; call reject('invalid','LL_TARGET_TRANSFER: procedure selector expected'); return 0; end
    if wordpos(kind,'source clause') > 0 & value.kind() <> 'I' then do; call reject('invalid','LL_TARGET_TRANSFER: source/clause identity expected'); return 0; end
    if reserve(112 + value.length(),1) = 0 then return 0
    id = _refs[0] + 1; _refs[id] = .lltargettransfer..refview(id,opid,ordinal,kind,anchor,value,extentknown,extent,role,roleordinal)
