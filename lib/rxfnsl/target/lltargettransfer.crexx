          mask = catalog.mayreadcomponents(code,j)
          if mask > 0 then call domainevents(opid,'read',refid,mask)
          /* The native may-read catalogue uses ALL for an unclassified
           * component read. Zero is an explicit status-only read. */
          if catalog.observationcomplete(code,j) then call domainevents(opid,'observe',refid,catalog.observedcomponents(code,j))
          else call unknown(opid,'observations','catalog.typed.observation.projection.unknown')
          flagmask = catalog.observedflags(code,j); maskoperand = catalog.observedflagmaskoperand(code)
          if maskoperand > 0 then do
            field = item.operand(maskoperand); selectedmask = field.index()
            assembler iand flagmask,flagmask,selectedmask
          end
          call domainevents(opid,'observe',refid,flagmask,'flag')
