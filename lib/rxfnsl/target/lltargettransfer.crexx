          call domainevents(opid,'clear',refid,catalog.clearcomponents(code,j))
          source = catalog.transportsource(code)
          if source > 0 then call domainevents(opid,'transport',refid,catalog.transportcomponents(code),'component','must','normal','none','reference',refs[source])
          else if catalog.literaloperand(code) > 0 then do
