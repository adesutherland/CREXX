        /* The native resolver owns its window dependencies. A factory match
         * callback may inspect complete actual values; method selection has
         * an explicit receiver instead. Flags remain individual domains. */
        call domainevents(opid,'read',windowref,catalog.selectionwindowcomponents(code))
        call domainevents(opid,'observe',windowref,catalog.selectionwindowcomponents(code))
        flagmask = catalog.mayreadflags(code,catalog.selectioncount(code))
        call domainevents(opid,'read',windowref,flagmask,'flag')
        call domainevents(opid,'observe',windowref,flagmask,'flag')
      end
      do j = 1 to item.operands()
        if binding then iterate
        refid = refs[j]
        if refid = 0 then iterate
        if catalog.writes(code,j) & binding = 0 then do
          /* An exact direct-write projection must not erase independent
           * components. The broader may-write inventory remains available
           * for unknown writers and alias/callback reasoning. Status bits
           * have their own domains even when a value component also changes. */
          if catalog.writecomplete(code,j) then do
            mask = catalog.writecomponents(code,j); bit = catalog.clearcomponents(code,j)
            assembler ior mask,mask,bit
            if mask > 0 then call domainevents(opid,'write',refid,mask,'component','may')
          end
          else if catalog.maywritecomponents(code,j) > 0 then ignored = event(opid,'write',refid,0,'none',0,.lltarget..operand(),'may')
          if catalog.maywriteflags(code,j) > 0 then ignored = event(opid,'status',refid,0,'none',0,.lltarget..operand(),'may','normal','none','catalog.status.write')
          call domainevents(opid,'clear',refid,catalog.clearcomponents(code,j))
          source = catalog.transportsource(code)
          if source > 0 & source <> j then call domainevents(opid,'transport',refid,catalog.transportcomponents(code),'component','must','normal','none','reference',refs[source])
          else if catalog.literaloperand(code) > 0 then do
            literal = item.operand(catalog.literaloperand(code))
            call domainevents(opid,'write',refid,catalog.literalcomponents(code),'component','must','normal','none','literal',0,literal)
          end
          else do
            mask = catalog.definitioncomponents(code,j)
            allmask = catalog.componentmask('all')
            if mask = allmask & catalog.clearcomponents(code,j) = allmask then do
              /* A complete value reset has no transported source. The clear
               * leaves resource payloads absent; its integer field is zero.
               * Other scalar fields remain defined but conservatively
               * unknown. A second whole unknown write would erase the reset
               * and invent a finalizer at the following setter. */
              resmask = catalog.componentmask('reference'); bit = catalog.componentmask('native-payload'); assembler ior resmask,resmask,bit
              bit = catalog.componentmask('attribute-count'); assembler ior resmask,resmask,bit
              othermask = mask - resmask - catalog.componentmask('I')
              if othermask > 0 then call domainevents(opid,'write',refid,othermask)
              call domainevents(opid,'write',refid,catalog.componentmask('I'),'component','must','normal','none','literal',0,.lltarget..operand.integer(0))
            end
            else if mask > 0 then call domainevents(opid,'write',refid,mask)
            else if catalog.writecomplete(code,j) = 0 & catalog.clearcomponents(code,j) <> catalog.componentmask('all') then call unknown(opid,'values','catalog.normal.definition.projection.unknown')
          end
        end
        if catalog.failurewrites(code,j) then call maskevents(opid,'write',refid,catalog.failurecomponents(code),'may','failure',phase)
      end
      if selectionkind > 0 then do
        integerdomain = adddomain('component','component.bit.0',catalog.componentmask('I'))
        descriptor = item.operand(catalog.selectiondescriptor(code))
        ignored = event(opid,'select',refs[catalog.selectionresult(code)],integerdomain,'literal',0,descriptor,'must','normal','none','catalog.selection')
      end
      if binding & scopedrecipe = 0 then do
        if bindingevents(opid,program,refs) = 0 then return
      end
      if (callsite | (catalog.semantics(code) <idiv> 2) % 2) & scopedrecipe = 0 then do
        if callsite then do
