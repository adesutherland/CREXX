      hookcaptures = callbackcaptures(opid,refs,binding)
      if scopedrecipe then do
        encoded = item.operand(catalog.recipeoperand(code))
        if reserve(encoded.length() * 2,encoded.length() + 1) = 0 then return
        recipeview = item.recipe()
        /* Count is an integer observation; actual/result capture transports
         * pointers and does not observe or define borrowed payloads. */
        integerdomain = adddomain('component','component.bit.0',catalog.componentmask('I'))
        do j = 1 to recipeview.registers()
          anchor = 'active'; role = recipeview.role(j)
          if wordpos(role,'a0-destination proxy-destination owned-destination') > 0 then anchor = 'slot'
          known = 1; extent = 1
          if role = 'window-capture' then do
            known = recipeview.countkind() = 'literal'; extent = 0
            if known then extent = recipeview.countvalue()
