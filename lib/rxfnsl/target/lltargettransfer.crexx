          end
          ignored = event(opid,'callcapture',0,0,'none',0,.lltarget..operand(),'must','all','after','catalog.call')
        end
        ignored = event(opid,'call',0,0,'none',0,.lltarget..operand(),'unknown','all','after','catalog.call.callee.unknown')
        call unknown(opid,'calls','catalog.call.callee.unknown')
      end
      if binding then call domainevents(opid,'read',0,catalog.contextreadmask(code),'context')
      call domainevents(opid,'context',0,catalog.contextwritemask(code),'context','may')
      if catalog.contextreadmask(code) <idiv> 512 % 2 | catalog.contextwritemask(code) <idiv> 512 % 2 then call unknown(opid,'numeric','catalog.numeric.dependency.unknown')
      if catalog.signalstate(code) = 2 then call unknown(opid,'signals','catalog.signal.contract.unknown')
      else if catalog.signalstate(code) <> 0 then do
        if catalog.signalsource(code) <> 1 then call unknown(opid,'signals','catalog.signal.names.unknown')
      end
      if (catalog.signalproperties(code) <idiv> 8) % 2 then do
        ignored = event(opid,'policy',0,0,'none',0,.lltarget..operand(),'may','all',phase,'catalog.policy.' || catalog.policyeffect(code))
      end
      if (catalog.signalproperties(code) <idiv> 32) % 2 then do
        /* Pending delivery is an observable ambient effect, not a handler
         * installation. Preserve its typed effect/name without creating a
         * structural policy action or inventing a Rexx-value observation. */
        pendingname = '*'
        if catalog.policysource(code) = 1 then pendingname = catalog.policyname(code)
        ignored = event(opid,'external',0,0,'literal',0,.lltarget..operand.string(pendingname as .binary),'may','all',phase,'catalog.signal.pending.' || catalog.policyeffect(code),0,'unknown',1)
      end
      if lltarget..normalsuccessors(code) = -2 then call unknown(opid,'control','catalog.normal.successors.unknown')
      if catalog.unbounded(code) then call unknown(opid,'ownership','catalog.indirect.ownership.unknown')
      if catalog.observations(code) <> 0 then do
        call unknown(opid,'observations','catalog.physical.observation.unknown')
