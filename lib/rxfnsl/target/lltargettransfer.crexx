      if referenced.procedureid() <> item.procedureid() then do; call reject('invalid','LL_TARGET_TRANSFER: foreign subject'); return 0; end
    end
    if sourcekind = 'reference' then do
      if sourceid = 0 | sourceid > _refs[0] then do; call reject('invalid','LL_TARGET_TRANSFER: missing source reference'); return 0; end
      ref = _refs[sourceid]; referenced = .lltarget..record(_graph,ref.opid())
      if referenced.procedureid() <> item.procedureid() then do; call reject('invalid','LL_TARGET_TRANSFER: foreign source'); return 0; end
      if kind = 'capture' & ref.opid() <> opid then do; call reject('invalid','LL_TARGET_TRANSFER: capture source must belong to same operation'); return 0; end
    end
    else if sourcekind = 'captured' then do
      if sourceid < 1 | sourceid > _acts[0] then do; call reject('invalid','LL_TARGET_TRANSFER: missing captured source'); return 0; end
      capture = _acts[sourceid]
