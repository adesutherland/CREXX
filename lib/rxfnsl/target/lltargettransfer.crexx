      call reject('invalid','LL_TARGET_TRANSFER: event reference/domain'); return 0
    end
    if wordpos(kind,'read observe transport write clear derive flagwrite link unlink swap lifetime resize status') > 0 & subject = 0 then do
      ambient = 0
