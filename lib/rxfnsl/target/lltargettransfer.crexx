    return id
  /** Addressing is operational data. Unknown selectors/aliases are resolved
   * by point flow, never by inventing a register or dropping the reference. */
  address: method = .int
    arg opid = .int, addresskind = .string, baseid = .int, selectorkind = .string, selectorid = .int, selectorvalue = .lltarget..operand, offset = 0, targetbank = '', targetanchor = 'active', ?qualifier = .lltarget..operand
    if operation(opid) = 0 then return 0
    if wordpos(addresskind,'localindex argument capturedargument reference attribute attribute1 qualifiedglobal parent') = 0 | wordpos(selectorkind,'none literal reference captured') = 0 | wordpos(targetanchor,'active base entry slot') = 0 then do
      call reject('invalid','LL_TARGET_TRANSFER: address selector tags'); return 0
    end
    if baseid < 0 | baseid > _refs[0] | selectorid < 0 then do; call reject('invalid','LL_TARGET_TRANSFER: address reference'); return 0; end
    if baseid > 0 then do
      base = _refs[baseid]
      if base.opid() <> opid then do; call reject('invalid','LL_TARGET_TRANSFER: foreign address base'); return 0; end
    end
    if selectorkind = 'reference' then do
      if selectorid < 1 | selectorid > _refs[0] then do; call reject('invalid','LL_TARGET_TRANSFER: address selector reference'); return 0; end
      selected = _refs[selectorid]
      if selected.opid() <> opid then do; call reject('invalid','LL_TARGET_TRANSFER: foreign address selector'); return 0; end
    end
    else if selectorkind = 'captured' then do
      if selectorid < 1 | selectorid > _acts[0] then do; call reject('invalid','LL_TARGET_TRANSFER: address capture'); return 0; end
      captured = _acts[selectorid]
      if captured.opid() <> opid | captured.kind() <> 'capture' then do; call reject('invalid','LL_TARGET_TRANSFER: foreign address capture'); return 0; end
    end
    else if selectorid <> 0 then do; call reject('invalid','LL_TARGET_TRANSFER: unexpected address selector identity'); return 0; end
    if (selectorkind = 'literal' & selectorvalue.kind() <> 'I') | (selectorkind <> 'literal' & selectorvalue.kind() <> '') then do
      call reject('invalid','LL_TARGET_TRANSFER: typed address literal'); return 0
    end
    if ?qualifier = 0 then qualifier = .lltarget..operand()
    if reserve(192 + qualifier.length(),1) = 0 then return 0
    id = _refs[0] + 1
    _refs[id] = .lltargettransfer..refview(id,opid,0,'address','symbolic',qualifier,1,1,'',0,addresskind,baseid,selectorkind,selectorid,selectorvalue,offset,targetbank,targetanchor)
    _rnext[id] = 0
    if _rlast[opid] > 0 then _rnext[_rlast[opid]] = id
    else _rfirst[opid] = id
    _rlast[opid] = id; _rcount[opid] = _rcount[opid] + 1
    return id
  event: method = .int
    arg opid = .int, kind = .string, subject = .int, domainid = .int, sourcekind = 'none', sourceid = 0, ?literal = .lltarget..operand, certainty = 'must', path = 'normal', phase = 'none', detail = '', offset = 0
    ref = .lltargettransfer..refview; referenced = .lltarget..record; described = .lltargettransfer..domain
    if operation(opid) = 0 then return 0
    if wordpos(kind,'read observe transport write clear derive flagwrite link unlink swap context policy call callcapture capture resize status return lifetime scope-enter edge raise unknown') = 0 | wordpos(sourcekind,'none reference captured literal unknown') = 0 | wordpos(certainty,'must may unknown') = 0 | wordpos(path,'normal failure all') = 0 | wordpos(phase,'none before partial after unknown') = 0 then do
      call reject('invalid','LL_TARGET_TRANSFER: event tags'); return 0
