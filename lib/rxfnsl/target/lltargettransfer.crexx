          refid = addref(opid,j,'recipe',anchor,known,extent)
          if role = 'count-capture' then ignored = event(opid,'observe',refid,integerdomain)
        end
        ignored = event(opid,'scope-enter',0,0,'none',0,.lltarget..operand(),'must','normal','after','recipe.capture.owned.commit')
        call unknown(opid,'values','scope.entry.value.projection.unknown')
        call unknown(opid,'failure','scope.entry.failure.phase.unknown')
      end
      if catalog.implicit(code) <> 0 & scopedrecipe = 0 then do
        /* Invocation and selection both describe a physical argument window;
         * only invocation creates a callee activation. Unknown is not empty. */
        window = catalog.callwindow(code)
        if selectionkind > 0 then window = catalog.selectionwindow(code)
        if (callsite | selectionkind > 0) & window > 0 & window <= item.operands() & catalog.implicitrecipe(code) = ('windowafter:' || window) then windowref = addref(opid,window,'window','symbolic',0,0)
        else if binding = 0 then call unknown(opid,'references','catalog.implicit.reference.selector.unknown')
      end
      /* Ordinary inputs are observed in the incoming state. Destination
       * writes must not precede another operand's observation, including
