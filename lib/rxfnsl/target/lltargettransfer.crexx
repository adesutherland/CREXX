    end
    else if literal.kind() <> '' then do; call reject('invalid','LL_TARGET_TRANSFER: unexpected literal'); return 0; end
    if reserve(160 + literal.length() + length(detail),1) = 0 then return 0
    id = _acts[0] + 1; ordinal = _acount[opid] + 1
    _acts[id] = .lltargettransfer..action(id,opid,ordinal,kind,subject,domainid,sourcekind,sourceid,literal,certainty,path,phase,detail,offset)
    _anext[id] = 0
    if _alast[opid] > 0 then _anext[_alast[opid]] = id
    else _afirst[opid] = id
    _alast[opid] = id; _acount[opid] = ordinal
    return id
  unknown: method = .void
    arg opid = .int, family = .string, reason = .string
    if _status <> 'building' then return
    if wordpos(family,'references components flags numeric signals order control values observations ownership effects bindings failure calls relocation') = 0 | reason = '' then do
