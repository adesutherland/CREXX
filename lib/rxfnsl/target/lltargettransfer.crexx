          countordinal = catalog.callcount(code)
          if countordinal > 0 then do
            integerdomain = adddomain('component','component.bit.0',catalog.componentmask('I'))
            ignored = event(opid,'observe',refs[countordinal],integerdomain,'none',0,.lltarget..operand(),'must','all','after')
          end
