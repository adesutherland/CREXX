    end
    if reserve(0,1) = 0 then return 0
    if observation = 'none' then _relocationknown[opid] = 1
    else call unknown(opid,'relocation','transfer.relocation.observer.' || observation)
    return _status = 'building'
  maskevents: method = .void
    arg opid = .int, kind = .string, refid = .int, mask = .int, certainty = .string, path = .string, phase = .string
