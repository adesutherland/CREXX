       * incoming conditions and callback observations explicit; only the
       * flow owner's licensed normal postwrite may restore computed cells. */
      call callbackevents(opid,hookcaptures)
    end
    return
  deferredlocalcall: method = .int
    arg opid = .int
    target = dereference _owner; item = target.at(opid); catalog = .llrxascatalog..catalog()
    if item.kind() <> 'instruction' then return 0
    code = item.opcode()
    /* A known direct local provider owns the same recycled-frame ingress for
     * fixed and counted calls. The count value is captured separately; no
     * fixed-arity premise is needed to classify that old-frame callback. */
    return catalog.callinvokes(code) & catalog.callcausestate(code) = 'known' & catalog.callprefix(code) = '' & localcalltarget(opid) > 0 & catalog.contextsynccontract() = 'value-only-nonreentrant.v1'
  callframedeferred: method = .int
    arg opid = .int
    call require(); return deferredlocalcall(opid)
  /** Equivalence classification, never callback absence or a value fact.
   * The native known-frame contract seals this one reused original-a0 reset;
   * explicit preparation and current-execution payload hooks are separate.
   * Raw callback actions, possible() results and havoc remain unchanged. */
  recyclercleanup: method = .int
    arg opid = .int, ordinal = .int, surface = .string
    call require()
    if _premise <> 'canonical' then return 0
    target = dereference _owner; item = target.at(opid); catalog = .llrxascatalog..catalog()
    if item.kind() <> 'instruction' | ordinal < 1 then return 0
    code = item.opcode()
    if catalog.callframestate(code) <> 'known' then return 0
    if catalog.callframefreshmode(code) <> 'value-init' | catalog.callframeclearrole(code) <> 'a0-original-backing' | catalog.callframeclearextent(code) <> 'active-tree' | catalog.callframeclearwhen(code) <> 'reused-frame' | catalog.callframelocalmode(code) <> 'relink-original' | catalog.callframecountrole(code) <> 'a0-original-backing' then return 0
    if surface = 'cause' then do
      if ordinal > catalog.callcauses(code) then return 0
      return catalog.callcausekind(code,ordinal) = 'frame-callback' & catalog.callcausecondition(code,ordinal) = 'bytecode-frame-hook' & catalog.callcausecheckpoint(code,ordinal) = 'frame-preparation'
    end
    if surface <> 'callback' | deferredlocalcall(opid) = 0 then return 0
    view = instruction(opid)
    if ordinal > view.actions() then return 0
    action = view.action(ordinal)
    return action.kind() = 'callback' & action.detail() = 'catalog.callback.call-frame' & action.subject() = 0 & action.domain() = 0 & action.sourcekind() = 'none'
  bindingprogram: method = .lltargettransfer..bindingprogram
    arg opid = .int, mode = 'binding', work = 1000000, bytes = 67108864
    call require(); source = dereference _owner; item = source.at(opid); catalog = .llrxascatalog..catalog()
    if item.valid() = 0 then return .bindingprogram.unavailable('invalid','target.binding.program.source.invalid')
    if item.kind() <> 'instruction' then return .bindingprogram.unavailable('invalid','target.binding.program.source.invalid')
    if mode = 'preparation' then text = catalog.callprefix(item.opcode())
    else if mode = 'binding' then text = catalog.bindingrecipe(item.opcode())
    else return .bindingprogram.unavailable('invalid','target.binding.program.mode.invalid')
    if length(text) * 4 + 1 > work | length(text) * 128 + 64 > bytes then return .bindingprogram.unavailable('limit','target.binding.program.work.or.bytes')
    /* This read-only query cannot use the building-only reserve path. Its
     * caller consumes the same checked decoder envelope exactly once. */
    return .bindingprogram(item,text,length(text) + 1,1)
  callbackcaptures: method = .int[]
    arg opid = .int, refs = .int[], binding = .int
    captures = .int[]; refid = .int; mask = .int; bit = .int; ordinal = .int; domainid = .int; captured = .int
    item = .lltarget..record(_graph,opid); code = item.opcode(); catalog = .llrxascatalog..catalog()
    /* A typed logical entry executes its recipe's preparation and hidden ABI
     * checkpoints in the shared scope executor. Its conservative ordinary
     * result mask is not another value write at this incoming active cell.
     * callbackevents still publishes the ABI obligation; no hook is waived. */
    if catalog.recipeoperand(code) > 0 & catalog.scopecontinuation(code) > 0 then return captures
    if deferredlocalcall(opid) then return captures
    unconditional = 0
    do j = 1 to item.operands()
      refid = refs[j]
      if refid = 0 then iterate
      mask = catalog.callbackinputs(code,j); outputs = catalog.callbackoutputs(code,j)
      assembler ior mask,mask,outputs
      if catalog.callbackcapacity(code,j) then unconditional = 1
      if mask = 0 then iterate
      /* Compound binding checkpoints and implicit owned storage are not the
       * operation's incoming active cell. Unknown is not an absence proof. */
      if binding then do; unconditional = 1; iterate; end
      bit = 1; ordinal = 0
      do while mask > 0
        if reserve(0,1) = 0 then return captures
        if mask % 2 then do
          domainid = adddomain('component','component.bit.' || ordinal,bit)
          captured = event(opid,'capture',0,domainid,'reference',refid,.lltarget..operand(),'must','all','before','catalog.callback.condition')
          if reserve(8,1) = 0 then return captures
          captures[captures[0] + 1] = captured
        end
        mask = mask <idiv> 2; ordinal = ordinal + 1
        if mask > 0 then bit = bit * 2
      end
    end
    if unconditional then do
      if reserve(8,1) = 0 then return captures
      captures[captures[0] + 1] = 0
    end
    return captures
  callbackevents: method = .void
    arg opid = .int, captures = .int[]
    capture = .lltargettransfer..action; domain = .lltargettransfer..domain; ignored = .int
    catalog = .llrxascatalog..catalog(); item = .lltarget..record(_graph,opid); code = item.opcode()
    covered = 0; mask = .int; bit = .int; overlap = .int
    if deferredlocalcall(opid) then do
      /* The call action owns provider execution and its exact summary. Entry
       * resource clearing stays a separate conditional callback observation. */
      ignored = event(opid,'callback',0,0,'none',0,.lltarget..operand(),'may','all','unknown','catalog.callback.call-frame')
      covered = catalog.callbackmask('input'); bit = catalog.callbackmask('output'); assembler ior covered,covered,bit
      bit = catalog.callbackmask('capacity'); assembler ior covered,covered,bit
      bit = catalog.callbackmask('invocation'); assembler ior covered,covered,bit
      bit = catalog.callbackmask('plugin-sync'); assembler ior covered,covered,bit
    end
    resources = catalog.callbackmask('input'); bit = catalog.callbackmask('output')
    assembler ior resources,resources,bit
    do i = 1 to captures[0]
      mask = resources
      if captures[i] = 0 then do
        ignored = event(opid,'callback',0,0,'none',0,.lltarget..operand(),'may','all','unknown','catalog.callback.capacity-or-checkpoint')
        bit = catalog.callbackmask('capacity'); assembler ior mask,mask,bit
      end
      else do
        capture = _acts[captures[i]]; domain = _domains[capture.domain()]
        detail = 'catalog.callback.payload'
        if domain.nativebit() = catalog.componentmask('attribute-count') then detail = 'catalog.callback.active-tree'
        ignored = event(opid,'callback',capture.sourceid(),capture.domain(),'captured',capture.id(),.lltarget..operand(),'may','all','unknown',detail)
      end
      assembler ior covered,covered,mask
    end
    if catalog.selectioncallbacks(code) then do
      ignored = event(opid,'callback',0,0,'none',0,.lltarget..operand(),'may','all','unknown','catalog.callback.selection')
      bit = catalog.callbackmask('selection'); assembler ior covered,covered,bit
    end
    if catalog.hostcallbacks(code) then do
      ignored = event(opid,'callback',0,0,'none',0,.lltarget..operand(),'may','all','unknown','catalog.callback.host')
      bit = catalog.callbackmask('host'); assembler ior covered,covered,bit
    end
    if catalog.contextsynccallbacks(code) then do
      if catalog.contextsynccontract() <> 'value-only-nonreentrant.v1' then ignored = event(opid,'callback',0,0,'none',0,.lltarget..operand(),'may','all','unknown','catalog.callback.plugin-sync')
      bit = catalog.callbackmask('plugin-sync'); assembler ior covered,covered,bit
    end
    if catalog.abicallbacks(code) then do
      ignored = event(opid,'callback',0,0,'none',0,.lltarget..operand(),'may','all','unknown','catalog.callback.abi')
      bit = catalog.callbackmask('abi'); assembler ior covered,covered,bit
    end
    if catalog.departurecallbacks(code) then do
      ignored = event(opid,'callback',0,0,'none',0,.lltarget..operand(),'may','all','unknown','catalog.callback.departure')
      bit = catalog.callbackmask('departure'); assembler ior covered,covered,bit
    end
    /* Every whole-op route must have an executor event. Invocation and
     * unknown inventory can remain even when explicit operand resources are
     * empty; neither may borrow a different route's conditional capture. */
    obligations = catalog.callbackobligations(code)
    assembler iand overlap,obligations,covered
    remaining = obligations - overlap
    if remaining <> 0 then ignored = event(opid,'callback',0,0,'none',0,.lltarget..operand(),'may','all','unknown','catalog.callback.residual.' || remaining)
    return
  domainevents: method = .void
    arg opid = .int, kind = .string, refid = .int, mask = .int, domainkind = 'component', certainty = 'must', path = 'normal', phase = 'none', sourcekind = 'none', sourceid = 0, ?literal = .lltarget..operand
    bit = 1; ordinal = 0; value = .lltarget..operand()
    if ?literal then value = literal
    do while mask > 0
      if reserve(0,1) = 0 then return
      if mask % 2 then do
        domainid = adddomain(domainkind,domainkind || '.bit.' || ordinal,bit)
        ignored = event(opid,kind,refid,domainid,sourcekind,sourceid,value,certainty,path,phase)
      end
      mask = mask <idiv> 2; ordinal = ordinal + 1
      if mask > 0 then bit = bit * 2
    end
    return
  checkedprogram: method = .bindingprogram
    arg opid = .int, recipe = .string, allowempty = 0
    item = .lltarget..record(_graph,opid)
    if reserve(length(recipe) * 128 + 64,length(recipe) * 4 + 1) = 0 then return .bindingprogram(item,'',0)
    program = .bindingprogram(item,recipe,length(recipe) + 1,allowempty)
    if program.status() = 'invalid' | program.status() = 'limit' then call reject(program.status(),program.reason())
    return program
  unknownbinding: method = .void
    arg opid = .int, reason = .string
    do family = 1 to 8
      call unknown(opid,word('bindings order components flags values ownership references observations',family),reason)
    end
    ignored = event(opid,'unknown',0,0,'none',0,.lltarget..operand(),'unknown','all','unknown',reason)
    return
  /** The independent draft uses this same two-pass decoder. */
  binding: method = .int
    arg opid = .int, recipe = .string
    if operation(opid) = 0 then return 0
    program = checkedprogram(opid,recipe)
    if _status <> 'building' then return 0
    if program.status() <> 'ok' then do; call unknownbinding(opid,program.reason()); return 0; end
    item = .lltarget..record(_graph,opid); refs = .int[]
    do i = 1 to item.operands()
      value = item.operand(i); refs[i] = 0
      if value.kind() = 'R' then refs[i] = addref(opid,i)
    end
    return bindingevents(opid,program,refs)
  selectedaddress: method = .int
    arg opid = .int, kind = .string, base = .int, ordinal = .int, refs = .int[], capture = 0, offset = 0, bank = '', anchor = 'active', ?qualifier = .lltarget..operand
    item = .lltarget..record(_graph,opid); literal = .lltarget..operand(); selected = 0; selection = 'none'
    if capture > 0 then do; selection = 'captured'; selected = capture; end
    else if ordinal > 0 then do
      value = item.operand(ordinal)
      if value.kind() = 'R' then do; selection = 'reference'; selected = refs[ordinal]; end
      else do; selection = 'literal'; literal = value; end
    end
    if ?qualifier = 0 then qualifier = .lltarget..operand()
    return address(opid,kind,base,selection,selected,literal,offset,bank,anchor,qualifier)
  sourceevent: method = .int
    arg opid = .int, kind = .string, subject = .int, domainid = .int, ordinal = .int, refs = .int[], offset = 0, detail = ''
    item = .lltarget..record(_graph,opid); value = item.operand(ordinal)
    if value.kind() = 'R' then return event(opid,kind,subject,domainid,'reference',refs[ordinal],.lltarget..operand(),'must','all','after',detail,offset)
    return event(opid,kind,subject,domainid,'literal',0,value,'must','all','after',detail,offset)
  /** The semantic clear verb executes value_zero on this ordered active
   * pointee. Its callback condition covers the top reference/native payload
   * and active children, never retained inactive capacity. Three consecutive
   * captures form one immutable pre-clear checkpoint; the callback names the
   * first capture. This describes a possible hook, not its absence or what a
   * hook may observe. Later call/result obligations retain their own barrier. */
  clearcheckpoint: method = .int
    arg opid = .int, subject = .int
    catalog = .llrxascatalog..catalog(); first = 0; captured = .int; domainid = .int
    ordinal = .int; shifted = .int
    do i = 1 to 3
      name = word('reference native-payload attribute-count',i)
      bit = catalog.componentmask(name)
      if bit < 1 then do; call reject('invalid','LL_TARGET_TRANSFER: clear resource domain'); return 0; end
      ordinal = 0; shifted = bit
      do while shifted > 1
        if reserve(0,1) = 0 then return 0
        shifted = shifted <idiv> 2; ordinal = ordinal + 1
      end
      domainid = adddomain('component','component.bit.' || ordinal,bit)
      captured = event(opid,'capture',0,domainid,'reference',subject,.lltarget..operand(),'must','all','unknown','catalog.callback.clear.' || name)
      if captured = 0 then return 0
      if first = 0 then first = captured
    end
    return event(opid,'callback',subject,0,'captured',first,.lltarget..operand(),'may','all','unknown','catalog.callback.clear.active-tree')
  /** Second pass: semantic verbs, never a mnemonic admission list. Every
   * selector is materialized at its ordered point; captured values name an
   * immutable earlier action, rather than resolving a restored register. */
  bindingevents: method = .int
    arg opid = .int, program = .bindingprogram, refs = .int[]
    value = .lltarget..operand; qualifier = .lltarget..operand; addresskind = .string; anchor = .string
    capture = .int; captured = .int; ignored = .int
    item = .lltarget..record(_graph,opid); catalog = .llrxascatalog..catalog()
    integer = adddomain('component','component.bit.0',catalog.componentmask('I'))
    valuecapture = 0; indexcapture = 0; literal = .lltarget..operand
    do step = 1 to program.steps()
      if _status <> 'building' then return 0
      kind = program.kind(step); a = program.operand(step,1); b = program.operand(step,2)
      c = program.operand(step,3); d = program.operand(step,4)
      subject = refs[a]; source = 0; detail = ''; offset = 0
      select
        when kind = 'branch' then iterate
        when kind = 'link' | kind = 'swap' then ignored = event(opid,kind,subject,0,'reference',refs[b],.lltarget..operand(),'must','all','after')
        when kind = 'unlink' then ignored = event(opid,'unlink',subject,0,'none',0,.lltarget..operand(),'must','all','after')
        when kind = 'endlife' then ignored = event(opid,'lifetime',subject,0,'none',0,.lltarget..operand(),'must','all','after','end')
        when kind = 'icopy' then ignored = event(opid,'transport',subject,integer,'reference',refs[b],.lltarget..operand(),'must','all','after')
        when kind = 'setint' then do
          writer = catalog.valuewriter(item.opcode(),a)
          if writer = 'setter' then do
            call domainevents(opid,'clear',subject,catalog.clearcomponents(item.opcode(),a),'component','must','all','after')
            ignored = event(opid,'status',subject,0,'unknown',0,.lltarget..operand(),'unknown','all','after','setter.integer.flags')
          end
          else if writer <> 'field' then call unknown(opid,'effects','catalog.writer.kind.unknown')
          ignored = sourceevent(opid,'write',subject,integer,b,refs,0,'setter.integer')
        end
        when kind = 'clear' then do
          if clearcheckpoint(opid,subject) = 0 then return 0
          ignored = event(opid,'clear',subject,0,'none',0,.lltarget..operand(),'must','all','after','value.reset')
        end
        when kind = 'flags' then ignored = sourceevent(opid,'status',subject,0,b,refs,0,'public-write')
        when kind = 'captureint' | kind = 'captureindex' then do
          if kind = 'captureindex' then do
            value = item.operand(b); offset = value.index()
            value = item.operand(a)
            if value.kind() = 'R' then ignored = event(opid,'observe',refs[a],integer,'none',0,.lltarget..operand(),'must','all','after')
          end
          captured = sourceevent(opid,'capture',0,integer,a,refs,offset,kind)
          if kind = 'captureint' then valuecapture = captured
          else indexcapture = captured
        end
        when kind = 'putint' then ignored = event(opid,'transport',subject,integer,'captured',valuecapture,.lltarget..operand(),'must','all','after')
        when kind = 'setattrs' | kind = 'minattrs' then do
          detail = 'set'; if kind = 'minattrs' then detail = 'min'
          ignored = sourceevent(opid,'resize',subject,0,b,refs,0,detail)
        end
        when kind = 'minattrscaptured' then ignored = event(opid,'resize',subject,0,'captured',indexcapture,.lltarget..operand(),'must','all','after','min')
        when kind = 'linkindex' | kind = 'linkindexreg' then do
          subject = selectedaddress(opid,'localindex',0,a,refs,0,0,'packed')
          source = refs[b]
          if kind = 'linkindex' then source = selectedaddress(opid,'localindex',0,b,refs,0,0,'packed')
          ignored = event(opid,'link',subject,0,'reference',source,.lltarget..operand(),'must','all','after')
        end
        when kind = 'argument' | kind = 'argumentadd' | kind = 'capturedargument' then do
          if c > 0 then do; value = item.operand(c); offset = value.index(); end
          addresskind = 'argument'; anchor = 'active'
          if kind = 'capturedargument' then do; addresskind = 'capturedargument'; anchor = 'entry'; end
          value = item.operand(b)
          if value.kind() = 'R' then ignored = event(opid,'observe',refs[b],integer,'none',0,.lltarget..operand(),'must','all','after')
          source = selectedaddress(opid,addresskind,0,b,refs,0,offset,'a',anchor)
          ignored = event(opid,'link',subject,0,'reference',source,.lltarget..operand(),'must','all','after')
        end
        when kind = 'reference' then do
          source = selectedaddress(opid,'reference',refs[b],0,refs)
          ignored = event(opid,'link',subject,0,'reference',source,.lltarget..operand(),'must','all','after')
        end
        when kind = 'attribute' | kind = 'attribute1' | kind = 'attribute1add' | kind = 'attribute1captured' then do
          capture = 0; addresskind = kind
          if kind = 'attribute1add' then do; addresskind = 'attribute1'; value = item.operand(d); offset = value.index(); end
          if kind = 'attribute1captured' then do; addresskind = 'attribute1'; capture = indexcapture; end
          if c > 0 then do
            value = item.operand(c)
            if value.kind() = 'R' then ignored = event(opid,'observe',refs[c],integer,'none',0,.lltarget..operand(),'must','all','after')
          end
          source = selectedaddress(opid,addresskind,refs[b],c,refs,capture,offset)
          ignored = event(opid,'link',subject,0,'reference',source,.lltarget..operand(),'must','all','after')
        end
        when kind = 'linktoattribute' | kind = 'linktoattribute1' | kind = 'unlinkattribute' | kind = 'unlinkattribute1' then do
          addresskind = 'attribute'; if right(kind,1) = '1' then addresskind = 'attribute1'
          value = item.operand(a)
          if value.kind() = 'R' then ignored = event(opid,'observe',refs[a],integer,'none',0,.lltarget..operand(),'must','all','after')
          subject = selectedaddress(opid,addresskind,refs[b],a,refs)
          if c > 0 then ignored = event(opid,'link',subject,0,'reference',refs[c],.lltarget..operand(),'must','all','after')
          else ignored = event(opid,'unlink',subject,0,'none',0,.lltarget..operand(),'must','all','after')
        end
        when kind = 'parent' then do
          ignored = event(opid,'observe',refs[b],integer,'none',0,.lltarget..operand(),'must','all','after')
          source = selectedaddress(opid,'parent',0,b,refs,0,0,'packed')
          ignored = event(opid,'link',subject,0,'reference',source,.lltarget..operand(),'must','all','after')
        end
        when kind = 'qualifiedglobal' then do
          qualifier = item.operand(b)
          source = selectedaddress(opid,'qualifiedglobal',0,c,refs,0,0,'g','base',qualifier)
          ignored = event(opid,'link',subject,0,'reference',source,.lltarget..operand(),'must','all','after','active-base')
        end
      end
    end
    return _status = 'building'
  seal: method = .int
    call ensureprepared()
    if _sealed then return _status = 'ok'
    if _status <> 'building' then return 0
    _sealed = 1; _status = 'ok'
    return 1
  sealed: method = .int
    return _sealed
  status: method = .string
    call run()
    if _status = 'ok' & valid() = 0 then return 'invalid'
    return _status
  message: method = .string
    if _status = 'ok' & valid() = 0 then return 'LL_TARGET_OWNER: stale transfer owner'
    return _message
  valid: method = .int
    call run()
    if _sealed = 0 | _status <> 'ok' | <refvalid>(_owner) = 0 | <refvalid>(_graph) = 0 then return 0
    target = dereference _owner; graph = dereference _graph; catalog = .llrxascatalog..catalog()
    if target.valid() = 0 | graph.error() <> '' | graph.identity() <> _revision | catalog.fingerprint() <> _catalog then return 0
    other = target.ir(); return other <refsame> _graph
  matches: method = .int
    arg owner = reference .lltarget..module
    return valid() & (_owner <refsame> owner)
  require: method = .void
    if valid() = 0 then call bad('LL_TARGET_OWNER: transfer expired, incomplete or replaced')
    return
  identity: method = .int
    return _identity
  revision: method = .int
    return _revision
  catalog: method = .string
    return _catalog
  premise: method = .string
    return _premise
  executionroot: method = .int
    call require(); return _executionroot
  executioncontext: method = .string
    call require(); return _executioncontext
  defaulthalt: method = .int
    arg functionid = .int
    call require()
    if _executioncontext = '' then return 0
    /* This is the checked root-entry premise, not whole-body policy or a
     * native marked-main default. Later effects remain point-local CFG rows. */
    if functionid = _executionroot then return 1
    if _executioncalls = 0 then return 0
    if functionid < 2 | functionid > _executionmembers[0] then return 0
    return _executionmembers[functionid]
  executionreason: method = .string
    call require(); return _executionreason
  owner: method = reference .lltarget..module
    call require(); return _owner
  usedwork: method = .int
    return _work
  usedbytes: method = .int
    return _bytes
  instruction: method = .lltargettransfer..instruction
    arg opid = .int
    call require(); item = .lltarget..record(_graph,opid)
    if item.valid() = 0 then call bad('LL_TARGET_TRANSFER: not a source operation')
    return .lltargettransfer..instruction(reference self,opid)
  /** A same-module bytecode procedure is already entered in its module.
   * This does not select foreign providers or certify decimal/plugin hooks. */
  calllocaltarget: method = .int
    arg opid = .int
    call require(); return localcalltarget(opid)
  /** Structural startup fact over the original checked module. Preparation
   * is sufficient; following a peer's complete effects here would recurse
   * while mutually selected profiles are being materialized. This does not
   * select a provider or establish any inherited signal/numeric policy. */
  initializerfree: method = .int
    arg ?owner = reference .lltarget..module
    call ensureprepared()
    if _status <> 'building' & _status <> 'ok' then return 0
    if <refvalid>(_owner) = 0 | <refvalid>(_graph) = 0 then return 0
    if ?owner then do; if (_owner <refsame> owner) = 0 then return 0; end
    source = dereference _owner; graph = dereference _graph
    if source.valid() = 0 | graph.identity() <> _revision then return 0
    actual = source.ir()
    return (actual <refsame> _graph) & _initializerfree
  /** Exact bytecode target selection is separate from initializer ingress.
   * Only the native-enrolled tuple can supply a foreign executable body. */
  callexacttarget: method = .int
    arg opid = .int
    if calllocaltarget(opid) > 0 then return 1
    selected = invocationtarget(opid)
    return selected.valid() & selected.typeoperation() = 0
  /** A no-initializer provider has no user-code startup work. This structural
   * fact is not an arbitrary runtime READY or initializer-lineage assertion. */
  callinitializerfree: method = .int
    arg opid = .int
    if calllocaltarget(opid) > 0 then return 1
    selected = invocationtarget(opid)
    if selected.valid() = 0 | selected.typeoperation() <> 0 then return 0
    provider = selected.provider()
    if provider <refsame> _owner then return 1
    profileref = selected.providerprofile()
    if <refvalid>(profileref) = 0 then return 0
    profile = dereference profileref
    return profile.initializerfree(provider)
  callinitializeringress: method = .int
    arg opid = .int
    if calllocaltarget(opid) > 0 then return 1
    selected = invocationtarget(opid)
    if selected.valid() = 0 | selected.typeoperation() <> 0 then return 0
    provider = selected.provider()
    /* A foreign structural no-initializer fact remains separately available
     * through callinitializerfree. Runtime readiness/lineage still needs its
     * own checked entry contract before this ingress cause can disappear. */
    return provider <refsame> _owner
  callcausepossible: method = .int
    arg opid = .int, ordinal = .int
    call require(); target = dereference _owner; item = target.at(opid); catalog = .llrxascatalog..catalog()
    condition = catalog.callcausecondition(item.opcode(),ordinal)
    if catalog.callcausecallbacks(item.opcode(),ordinal) = catalog.callbackmask('plugin-sync') & catalog.contextsynccontract() = 'value-only-nonreentrant.v1' then return 0
    if wordpos(condition,'target-unresolved fixed-target-native') > 0 then do
      if callexacttarget(opid) then return 0
    end
    if condition = 'bytecode-initializer-needed' then do
      if callinitializeringress(opid) then return 0
    end
    /* frame_f synchronizes an inherited dynamic decimal provider even with
     * pristine backing. Do not replace that route with resource cleanliness. */
    return 1
  callcause: method = .lltargettransfer..callcausefact
    arg opid = .int, ordinal = .int
    call require(); return .callcausefact(reference self,opid,ordinal)
  /** Effective callback inventory retains every non-value-only route. */
  callbackobligations: method = .int
    arg opid = .int
    overlap = .int
    call require(); target = dereference _owner; item = target.at(opid); catalog = .llrxascatalog..catalog()
    if item.kind() <> 'instruction' then return 0
    mask = catalog.callbackobligations(item.opcode())
    if catalog.contextsynccontract() = 'value-only-nonreentrant.v1' then do
      bit = catalog.callbackmask('plugin-sync'); assembler iand overlap,mask,bit; mask = mask - overlap
    end
    return mask
  callbackpolicyunknown: method = .int
    arg opid = .int
    overlap = .int; mask = .int
    call require(); target = dereference _owner; item = target.at(opid); catalog = .llrxascatalog..catalog()
    if item.kind() <> 'instruction' then return 0
    code = item.opcode(); resources = catalog.callbackmask('input'); bit = catalog.callbackmask('output'); assembler ior resources,resources,bit
    bit = catalog.callbackmask('capacity'); assembler ior resources,resources,bit
    if catalog.callbackpreservessignalpolicy(code) then return 0
    if catalog.callinvokes(code) = 0 | catalog.callcausestate(code) <> 'known' then do
      mask = callbackobligations(opid)
      /* Physical return's remaining COPY/clear/retire work is resource
       * implementation. Its decimal synchronization is independently bound
       * by v3; this proves policy preservation, never callback absence. */
      if catalog.returnkind(code) > 0 & catalog.contextsynccontract() = 'value-only-nonreentrant.v1' then do
        bit = catalog.callbackmask('abi'); assembler iand overlap,mask,bit; mask = mask - overlap
        bit = catalog.callbackmask('departure'); assembler iand overlap,mask,bit; mask = mask - overlap
      end
      assembler iand overlap,mask,resources; return mask <> overlap
    end
    do ordinal = 1 to catalog.callcauses(code)
      cause = callcause(opid,ordinal)
      if cause.possible() = 0 then iterate
      mask = catalog.callcausecallbacks(code,ordinal)
      if mask = catalog.callbackmask('invocation') then do
        child = localcalltarget(opid)
        if child < 2 then return 1
        if child > _callpolicystate[0] then return 1
        if _callpolicystate[child] <> 2 then return 1
        iterate
      end
      assembler iand overlap,mask,resources
      if mask <> overlap then return 1
      if mask = 0 & cause.status() <> 'proved' then return 1
    end
    return 0
  callcausescomplete: method = .int
    arg opid = .int
    call require(); target = dereference _owner; item = target.at(opid); catalog = .llrxascatalog..catalog()
    if item.kind() <> 'instruction' then return 0
    if catalog.callcausestate(item.opcode()) <> 'known' then return 0
    do ordinal = 1 to catalog.callcauses(item.opcode())
      cause = callcause(opid,ordinal)
      if cause.status() <> 'proved' then return 0
    end
    return 1
  callcausereason: method = .string
    arg opid = .int
    call require(); target = dereference _owner; item = target.at(opid); catalog = .llrxascatalog..catalog()
    if item.kind() <> 'instruction' then return 'target.site.not.call'
    if catalog.callcausestate(item.opcode()) <> 'known' then return 'target.call.causes.unavailable'
    do ordinal = 1 to catalog.callcauses(item.opcode())
      cause = callcause(opid,ordinal)
      if cause.status() <> 'proved' then return cause.reason()
    end
    return ''
  unknownreason: method = .string
    arg opid = .int, family = .string
    call require()
    if wordpos(family,'references components flags numeric signals order control values observations ownership effects bindings failure calls relocation') = 0 then return 'transfer.family.unknown'
    if opid < 1 | opid > _declared[0] then return 'transfer.operation.unavailable'
    if _declared[opid] = 0 then return 'transfer.operation.undeclared'
    i = _unknownfirst[opid]
    do while i > 0
      if _unknownop[i] = opid & _unknownfamily[i] = family then return _unknownreason[i]
      if _unknownop[i] = opid & _unknownfamily[i] = 'effects' then return _unknownreason[i]
      if _unknownop[i] = opid & family = 'bindings' & _unknownfamily[i] = 'order' then return _unknownreason[i]
      if _unknownop[i] = opid & family = 'failure' & _unknownfamily[i] = 'signals' then return _unknownreason[i]
      i = _unknownnext[i]
    end
    if family = 'relocation' & _relocationknown[opid] = 0 then return 'transfer.relocation.undeclared'
    return ''
  complete: method = .int
    arg opid = .int, family = .string
    return unknownreason(opid,family) = ''
  domains: method = .int
    call require(); return _domains[0]
  domain: method = .lltargettransfer..domain
    arg id = .int
    call require()
    if id < 1 | id > _domains[0] then call bad('LL_TARGET_TRANSFER: domain ordinal')
    return _domains[id]
  references: method = .int
    arg opid = .int
    call checkop(opid); return _rcount[opid]
  checkop: method = .void
    arg opid = .int
    call require()
    if opid < 1 | opid > _declared[0] then call bad('LL_TARGET_TRANSFER: source operation ordinal')
    return
  ref: method = .lltargettransfer..refview
    arg id = .int
    call require()
    if id < 1 | id > _refs[0] then call bad('LL_TARGET_TRANSFER: reference ordinal')
    return _refs[id]
  referenceat: method = .lltargettransfer..refview
    arg opid = .int, ordinal = .int
    call checkop(opid)
    if ordinal < 1 | ordinal > _rcount[opid] then call bad('LL_TARGET_TRANSFER: instruction reference ordinal')
    id = _rfirst[opid]
    do i = 2 to ordinal; id = _rnext[id]; end
    return _refs[id]
  actions: method = .int
    arg opid = .int
    call checkop(opid); return _acount[opid]
  action: method = .lltargettransfer..action
    arg id = .int
    call require()
    if id < 1 | id > _acts[0] then call bad('LL_TARGET_TRANSFER: action ordinal')
    return _acts[id]
  actionat: method = .lltargettransfer..action
    arg opid = .int, ordinal = .int
    call checkop(opid)
    if ordinal < 1 | ordinal > _acount[opid] then call bad('LL_TARGET_TRANSFER: instruction action ordinal')
    id = _afirst[opid]
    do i = 2 to ordinal; id = _anext[id]; end
    return _acts[id]

/** Construction accepts operational events, never claimed values, purity,
 * restoration or summary conclusions. Unmentioned operations stay unknown. */
profiledraft: class
  _profile = .lltargettransfer..profile
  *: factory
    arg owner = reference .lltarget..module, premiseid = .string, work = 1000000, bytes = 67108864
    _profile = .lltargettransfer..profile.premises(owner,premiseid,work,bytes)
    return
  operation: method = .int
    arg opid = .int
    return _profile.operation(opid)
  /** Declare the complete activation-relative observation set for one source
   * operation. 'none' is an empty operational set, never an inline proof. */
  relocation: method = .int
    arg opid = .int, observation = 'none'
    return _profile.relocation(opid,observation)
  /** Describe the complete physical cleanup observation set for a procedure.
   * Omission remains unknown. This never asserts a preserved/absent hook. */
  boundary: method = .int
    arg functionid = .int, observation = .string
    return _profile.boundary(functionid,observation)
  domain: method = .int
    arg kind = .string, key = .string, nativebit = 0
    return _profile.adddomain(kind,key,nativebit)
  ref: method = .int
    arg opid = .int, ordinal = .int, kind = 'explicit', anchor = 'active', extentknown = 1, extent = 1
    return _profile.addref(opid,ordinal,kind,anchor,extentknown,extent)
  event: method = .int
    arg opid = .int, kind = .string, subject = .int, domainid = .int, sourcekind = 'none', sourceid = 0, ?literal = .lltarget..operand, certainty = 'must', path = 'normal', phase = 'none', detail = '', offset = 0, observation = 'unknown', intrinsicfootprint = 0
    if ?literal = 0 then literal = .lltarget..operand()
    return _profile.event(opid,kind,subject,domainid,sourcekind,sourceid,literal,certainty,path,phase,detail,offset,observation,intrinsicfootprint)
  /** Interpret independently supplied operational recipe text with the same
   * checked decoder used by the canonical catalogue adapter. */
  binding: method = .int
    arg opid = .int, recipe = .string
    return _profile.binding(opid,recipe)
  unknown: method = .void
    arg opid = .int, family = .string, reason = .string
    call _profile.unknown(opid,family,reason)
    return
  status: method = .string
    return _profile.status()
  message: method = .string
    return _profile.message()
  finish: method = .lltargettransfer..profile
    ignored = _profile.seal(); return _profile
