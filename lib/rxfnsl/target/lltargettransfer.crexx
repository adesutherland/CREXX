      /* Validate the entire sequence before even materializing its refs. */
      if binding & scopedrecipe = 0 then do
        program = checkedprogram(opid,recipe,callsite)
        if _status <> 'building' then return
        if program.status() <> 'ok' then do
          call unknownbinding(opid,program.reason()); iterate
        end
      end
      if catalog.classification(code) <> 0 & scopedrecipe = 0 then call unknown(opid,'effects','catalog.effects.unknown')
      if catalog.opaqueeffects(code) then ignored = event(opid,'external',0,0,'none',0,.lltarget..operand(),'may','all','none','catalog.opaque',0,'unknown',catalog.intrinsicfootprint(code))
      if (catalog.semantics(code) <idiv> 8) % 2 then ignored = event(opid,'return',0,0)
      refs = .int[]
      do j = 1 to item.operands()
        value = item.operand(j); refid = 0
        if value.kind() = 'R' then refid = addref(opid,j)
        else if value.kind() = 'L' then ignored = addref(opid,j,'label','symbolic')
        else if value.kind() = 'P' then ignored = addref(opid,j,'procedure','symbolic')
        refs[j] = refid
