/* cREXX License (MIT). Diagnosed dirty owned-local entry-state normalization. */
options levelb
namespace lltargetnormalize expose warning change normalize entrycandidate entrycandidates explicit conditionalcertificate entrycertificate sitecertificate
import rxfnsb
import llir
import lltarget
import lltargettransfer
import lltargetcfg
import lltargetflow
import lltargetremap
import lltargetsummary
import llrxascatalog

/** An owned warning snapshot, located at the first original observation.
 * The byte column follows the target's byte-offset source convention. */
warning: class
  _procedure = .string
  _local = .int
  _component = .string
  _operation = .int
  _origin = .llir..origin
  _filename = .string
  _first = .int
  _last = .int
  _line = .int
  _column = .int
  *: factory
    arg routineName = .string, ownedIndex = .int, component = .string, operation = .int, at = .llir..origin
    _procedure = routineName; _local = ownedIndex; _component = component; _operation = operation; _origin = at
    _filename = at.filename(); _first = at.first(); _last = at.last(); _line = 1; _column = 1
    source = at.sourcebytes()
    do i = 0 to _first - 1
      if <at..u8>(i) source = 10 then do; _line = _line + 1; _column = 1; end
      else _column = _column + 1
    end
    return
  code: method = .string
    return 'LL_RXAS_ENTRY_READ'
  procedure: method = .string
    return _procedure
  local: method = .int
    return _local
  component: method = .string
    return _component
  operation: method = .int
    return _operation
  origin: method = .llir..origin
    return _origin
  filename: method = .string
    return _filename
  first: method = .int
    return _first
  last: method = .int
    return _last
  line: method = .int
    return _line
  column: method = .int
    return _column
  message: method = .string
    return 'dirty owned local r' || _local || ' component ' || _component || ' may be observed before definition in ' || _procedure
  diagnostic: method = .string
    return _filename || ':' || _line || ':' || _column || ': ' || code() || ': ' || message()

/** Locals begin dirty; stale physical payloads are not semantic definitions.
 * Defined-but-unknown values and borrowed dirty arguments remain distinct.
 * Normalize only flow-proved dirty entry-dependent observations. A whole-cell NULL
 * deliberately defines the existing VM reset state and can release/finalize
 * recycled payloads. It is never inserted for an otherwise valid local.
 * Missing observation/origin/binding facts, unsafe alternate/async entry or a
 * failed stage retain the exact input. Policy correlation may remain unknown
 * when complete possible local paths support the independent may-read proof;
 * no signal, value or binding uncertainty is promoted to a known fact.
 * Warnings and output publish together after validation.
 * @param owner Exact checked source module.
 * @param flow Exact live point/edge proof owner for that module.
 * @param work Whole-request elementary work allowance.
 * @param bytes Whole-request logical retained bytes.
 */
change: class
  _owner = reference .lltarget..module
  _flow = reference .lltargetflow..analysis
  _status = .string
  _message = .string
  _worklimit = .int
  _bytelimit = .int
  _work = .int
  _bytes = .int
  _hasresult = .int
  _result = .lltarget..module
  _mapping = .int[]
  _warnings = .warning[]
  _complete = .int[]
  _sourcecomplete = .int[]
  _entrypresent = .int[]
  _entryviews = .lltargetflow..entrycoveragefact[]
  _unknownreason = .string[]
  _certificate = .int
  _entrymode = .int
  _entryfunction = .int
  _entryfunctions = .int[]
  _modified = .int[]
  _entrysourceid = .int
  _coverage = .lltargetflow..entrycoveragefact
  _coverages = .lltargetflow..entrycoveragefact[]
  _stagedresult = .lltarget..module
  _stagedmapping = .int[]
  _stagedwarnings = .warning[]
  _stagedcomplete = .int[]
  _stagedreasons = .string[]
  _remapwork = .int
  _remapbytes = .int
  *: factory
    arg owner = reference .lltarget..module, flow = reference .lltargetflow..analysis, work = 1000000, bytes = 67108864
    _owner = owner; _flow = flow; _worklimit = work; _bytelimit = bytes; _status = 'building'
    return
  /** Construct one procedure's private entry-clear proposal. The ordinary
   * result/map/warnings retain the input until commit validates its theorem. */
  entrycandidate: factory
    arg owner = reference .lltarget..module, flow = reference .lltargetflow..analysis, functionid = .int, work = 1000000, bytes = 67108864
    _owner = owner; _flow = flow; _worklimit = work; _bytelimit = bytes; _status = 'building'
    _entrymode = 1; _entryfunction = functionid
    _entryfunctions[1] = functionid
    if <refvalid>(owner) then do
      source = .lltarget..module; source = dereference owner
      _result = source; _hasresult = 1; _entrysourceid = source.identity()
    end
    return
  /** Batch proposals use one final candidate, with no intermediate owner. */
  entrycandidates: factory
    arg owner = reference .lltarget..module, flow = reference .lltargetflow..analysis, functions = .int[], work = 1000000, bytes = 67108864
    _owner = owner; _flow = flow; _worklimit = work; _bytelimit = bytes; _status = 'building'
    _entrymode = 1; _entryfunctions = functions
    if <refvalid>(owner) then do
      source = .lltarget..module; source = dereference owner
      _result = source; _hasresult = 1; _entrysourceid = source.identity()
    end
    return
  resolved: factory
    arg status = .string, message = .string, ?result = .lltarget..module, ?mapping = .int[], ?warnings = .lltargetnormalize..warning[], ?proof = .lltargetnormalize..change
    _status = status; _message = message; _hasresult = ?result
    if ?result then _result = result
    if ?mapping then _mapping = mapping
    if ?warnings then _warnings = warnings
    if ?proof & ?result then do
      if result.valid() then do
        original = proof.result(); body = .lltarget..body
        if original.identity() = result.identity() then do
          _certificate = result.identity()
          do i = 1 to result.procedures()
            body = result.procedure(i); fn = body.functionid()
            _complete[fn] = proof.complete(fn); _unknownreason[fn] = proof.unknownreason(fn)
          end
        end
      end
    end
    return
  fail: method = .void
    arg status = .string, message = .string
    _status = status; _message = message
    return
  spend: method = .int
    arg amount = .int
    if amount < 0 | amount > _worklimit - _work then do; call fail('limit','normalization.work.exhausted'); return 0; end
    _work = _work + amount; return 1
  reserve: method = .int
    arg amount = .int
    if amount < 0 | amount > _bytelimit - _bytes then do; call fail('limit','normalization.bytes.exhausted'); return 0; end
    _bytes = _bytes + amount; return 1
  /** Dirty-return dependencies name the original owning procedures. Discharge
   * is a separate fixed point from extraction readiness; joins never invent
   * a cleared provider merely because the caller has no local dirty row. */
  entrymask: method = .int
    arg expose flags = .int[], expose reasons = .string[], modified = .int[]
    discharged = .int[]; f = .int; i = .int; dependency = .int; found = .int; changed = 1
    view = .lltargetflow..entrycoveragefact
    if spend(_entrypresent[0] + 1) = 0 | reserve((_entrypresent[0] + 1) * 24) = 0 then return 0
    do f = 1 to _entrypresent[0]
      discharged[f] = 0
      if _entrypresent[f] = 0 then iterate
      view = _entryviews[f]; found = 0
      if spend(modified[0] + 1) = 0 then return 0
      do i = 1 to modified[0]; if modified[i] = f then found = 1; end
      discharged[f] = view.complete() & (view.demands() = 0 | found)
    end
    do while changed
      changed = 0
      do f = 1 to _entrypresent[0]
        if spend(1) = 0 then return 0
        if discharged[f] = 0 then iterate
        view = _entryviews[f]
        do i = 1 to view.dependencies()
          if spend(1) = 0 then return 0
          dependency = view.dependency(i)
          if dependency < 1 | dependency > discharged[0] then do; call fail('invalid','normalization.entry.dependency.owner'); return 0; end
          if discharged[dependency] = 0 then do; discharged[f] = 0; changed = 1; leave; end
        end
      end
    end
    do f = 1 to _entrypresent[0]
      if spend(1) = 0 then return 0
      if _entrypresent[f] = 0 then iterate
      flags[f] = _sourcecomplete[f] & discharged[f]
      reasons[f] = _unknownreason[f]
      if _sourcecomplete[f] & discharged[f] = 0 then reasons[f] = 'normalization.entry.dependency.not.discharged'
      if flags[f] then reasons[f] = ''
    end
    return 1
  run: method = .void
    if _status <> 'building' then return
    owner = _owner; flowref = _flow
    item = .lltarget..record; body = .lltarget..body
    witness = .lltargetflow..entryread; previous = .lltargetflow..entryread; selected = .lltargetflow..entryread[]
    staged = .warning[]; functions = .int[]; locals = .int[]; observations = .int[]; anchors = .int[]; stagedmap = .int[]; operands = .object[]
    live = .int[]; demands = .lltargetflow..entryread[]; nomodifications = .int[]
    operand = .lltarget..operand; remap = .lltargetremap..change; origin = .llir..origin
    profile_ref = reference .lltargettransfer..profile
    i = .int; j = .int; found = .int; fn = .int; ownedIndex = .int; next = .int; slot = .int
    a = .int; b = .int; value = .int; first = .int; mapped = .int; flowid = .int; total = .int; requested = .int
    do
      source = .lltarget..module; proof = .lltargetflow..analysis
      if _worklimit < 1 | _bytelimit < 1 then do; call fail('limit','normalization.budgets.must.be.positive'); return; end
      if <refvalid>(owner) = 0 then do; call fail('invalid','normalization.owner.expired'); return; end
      source = dereference owner
      if _entrymode & source.identity() <> _entrysourceid then do; call fail('invalid','normalization.entry.source.replaced'); return; end
      _result = source; _hasresult = 1
      if source.valid() = 0 then do; call fail('invalid',source.error()); return; end
      if <refvalid>(flowref) = 0 then do; call fail('invalid','normalization.flow.expired'); return; end
      proof = dereference flowref
      if proof.status() <> 'ok' then do; call fail(proof.status(),proof.message()); return; end
      if proof.matches(owner) = 0 then do; call fail('invalid','normalization.flow.foreign'); return; end
      flowid = proof.identity()
      /* Certify owned-local normalization per procedure. An unrelated
       * incomplete body cannot veto normalization of a proved caller/site.
       * Flow still owns every observed domain and entry origin over the CFG's
       * conservative local paths; exact policy correlation is not this proof.
       * No owned locals means there is no owned entry cell to clear; borrowed
       * argument observations remain the caller-point proof's obligation. */
      do i = 1 to source.procedures()
        if spend(1) = 0 then return
        body = source.procedure(i); fn = body.functionid()
        live[fn] = 1
        if fn = _entryfunction then requested = 1
        _complete[fn] = body.locals() = 0 | proof.complete(fn,'entry-normalization')
        if _complete[fn] = 0 then _unknownreason[fn] = proof.unknownreason(fn,'entry-normalization')
        else _unknownreason[fn] = ''
        if _entrymode then do
          if reserve(72 + length(_unknownreason[fn])) = 0 then return
          _sourcecomplete[fn] = _complete[fn]; coverage = proof.entrycoverage(fn)
          if coverage.status() = 'invalid' | coverage.status() = 'limit' then do; call fail(coverage.status(),coverage.reason()); return; end
          _entryviews[fn] = coverage
        end
      end
      if _entrymode then do
        _entrypresent = live
        if entrymask(_complete,_unknownreason,nomodifications) = 0 then return
      end
      _certificate = source.identity()
      total = proof.entryobservations()
      if _entrymode then do
        if _entryfunctions[0] = 0 then do; call fail('invalid','normalization.entry.functions.required'); return; end
        do i = 1 to _entryfunctions[0]
          if spend(i + 1) = 0 | reserve(96) = 0 then return
          fn = _entryfunctions[i]
          if fn < 2 | fn > live[0] then do; call fail('invalid','normalization.entry.function.invalid'); return; end
          if live[fn] = 0 then do; call fail('invalid','normalization.entry.function.invalid'); return; end
          do j = 1 to i - 1
            if _entryfunctions[j] = fn then do; call fail('invalid','normalization.entry.function.duplicate'); return; end
          end
          _coverages[i] = proof.entrycoverage(fn); _coverage = _coverages[i]
          if _coverage.status() = 'limit' | _coverage.status() = 'invalid' then do; call fail(_coverage.status(),_coverage.reason()); return; end
          if _coverage.complete() = 0 then do; call fail('unknown','normalization.entry.source.coverage: ' || _coverage.reason()); return; end
          if spend(_coverage.demands()) = 0 | reserve(_coverage.demands() * 160) = 0 then return
          do j = 1 to _coverage.demands(); demands[demands[0] + 1] = _coverage.demand(j); end
        end
        total = demands[0]
      end
      do i = 1 to total
        cost = 1; if _entrymode then cost = cost + source.procedures()
        if spend(cost) = 0 then return
        if _entrymode then witness = demands[i]
        else witness = proof.entryobservation(i)
        if witness.valid() = 0 then do; call fail('invalid','normalization.witness.expired'); return; end
        fn = witness.function(); ownedIndex = witness.ownedindex(); body = source.body(fn); item = source.at(witness.operation())
        if _entrymode = 0 then do; if _complete[fn] = 0 then iterate; end
        else do
          requested = 0
          if spend(_entryfunctions[0]) = 0 then return
          do j = 1 to _entryfunctions[0]; if _entryfunctions[j] = fn then requested = 1; end
          if requested = 0 then do; call fail('invalid','normalization.entry.demand.function'); return; end
        end
        if witness.bank() <> 'r' | ownedIndex < 0 | ownedIndex >= body.locals() | item.procedureid() <> fn then do
          call fail('invalid','normalization.witness.not.owned.base'); return
        end
        found = 0
        do j = 1 to selected[0]
          if spend(1) = 0 then return
          previous = selected[j]
          if previous.function() = fn & previous.ownedindex() = ownedIndex & previous.domainkey() = witness.domainkey() then do; found = j; leave; end
        end
        if found > 0 then do
          previous = selected[found]
          if witness.operation() < previous.operation() then selected[found] = witness
        end
        else do
          if reserve(160) = 0 then return
          selected[selected[0] + 1] = witness
        end
      end
      if selected[0] = 0 then do; call fail('keep','normalization.no.entry.read'); return; end
      /* One prelude clear per owned base; first observation supplies origin. */
      do i = 1 to selected[0]
        if _entrymode then do; if spend(1) = 0 then return; end
        witness = selected[i]; fn = witness.function(); ownedIndex = witness.ownedindex(); found = 0
        do j = 1 to functions[0]
          if spend(1) = 0 then return
          if functions[j] = fn & locals[j] = ownedIndex then do; found = j; leave; end
        end
        if found = 0 then do
          if reserve(32) = 0 then return
          next = functions[0] + 1; functions[next] = fn; locals[next] = ownedIndex; observations[next] = witness.operation()
        end
        else if witness.operation() < observations[found] then observations[found] = witness.operation()
      end
      /* Stable procedure/local order also fixes multiple insertions at anchor. */
      do a = 2 to functions[0]
        if _entrymode then do; if spend(1) = 0 then return; end
        b = a
        do while b > 1
          if spend(1) = 0 then return
          if functions[b - 1] < functions[b] then leave
          if functions[b - 1] = functions[b] & locals[b - 1] <= locals[b] then leave
          value = functions[b - 1]; functions[b - 1] = functions[b]; functions[b] = value
          value = locals[b - 1]; locals[b - 1] = locals[b]; locals[b] = value
          value = observations[b - 1]; observations[b - 1] = observations[b]; observations[b] = value
          b = b - 1
        end
      end
      if _entrymode then do i = 1 to functions[0]
        if spend(1) = 0 | reserve(8) = 0 then return
        if i = 1 then _modified[1] = functions[i]
        else if functions[i] <> functions[i - 1] then _modified[_modified[0] + 1] = functions[i]
      end
      if _entrymode then do; if entrymask(_stagedcomplete,_stagedreasons,_modified) = 0 then return; end
      graphref = source.ir(); graph = dereference graphref; storeref = graph.storage(); store = dereference storeref
      do i = 1 to selected[0]
        witness = selected[i]; origin = witness.origin(); bits = origin.filename() as .binary; key = witness.domainkey() as .binary
        if reserve(160 + <blen>(bits) + <blen>(key)) = 0 then return
        if spend(origin.first() + 1) = 0 then return
      end
      do i = 1 to functions[0]
        if _entrymode then do; if spend(source.procedures() + graph.operations() * 2 + 1) = 0 then return; end
        body = source.body(functions[i])
        if body.records() < 1 then do; call fail('invalid','normalization.missing.entry.record'); return; end
        item = body.record(1); anchors[i] = item.id(); slot = 0
        do j = 1 to store.count(5)
          if spend(1) = 0 then return
          if store.get(5,j,1) = functions[i] & store.text(store.get(5,j,3)) = ('r' || locals[i]) then do; slot = j; leave; end
        end
        if slot = 0 then do; call fail('invalid','normalization.owned.slot.missing'); return; end
        operand = .lltarget..operand.bound(store.identity(),functions[i],slot,'r',locals[i])
        operands[i] = operand as .object
      end
      if reserve(graph.operations() * 8) = 0 then return
      if spend(source.records()) = 0 then return
      /* The remapper has a private bounded envelope but no actual counters.
       * Reserve it in full after precharging publication/mapping work. Proof
       * rebuilding and its retained owners have a separate caller allowance. */
      if _entrymode then do
        if spend(selected[0] * (source.procedures() + 1) + source.records() + source.procedures() * (source.procedures() + 1) + functions[0] + 1) = 0 then return
      end
      profile_ref = proof.operationalprofile()
      _remapwork = _worklimit - _work; _remapbytes = _bytelimit - _bytes
      remap = .lltargetremap..change(owner,_remapwork,_remapbytes)
      ignored = remap.useprofile(profile_ref)
      do i = 1 to functions[0]
        operand = operands[i] as .lltarget..operand
        ignored = remap.insertnullbefore(anchors[i],operand,observations[i])
      end
      call remap.run()
      if remap.status() <> 'changed' then do; call fail(remap.status(),remap.message()); return; end
      if proof.matches(owner) = 0 | proof.identity() <> flowid then do; call fail('invalid','normalization.proof.changed'); return; end
      if _entrymode then do
        do i = 1 to _coverages[0]
          if _coverages[i].valid() = 0 | _coverages[i].complete() = 0 then do; call fail('invalid','normalization.entry.coverage.changed'); return; end
        end
      end
      candidate = remap.result()
      do i = 1 to selected[0]
        witness = selected[i]; body = source.body(witness.function()); mapped = remap.operation(witness.operation()); item = candidate.at(mapped)
        staged[i] = .warning(body.name(),witness.ownedindex(),witness.domainkey(),mapped,item.origin())
      end
      do i = 1 to source.records(); item = source.record(i); stagedmap[item.id()] = remap.operation(item.id()); end
      /* Function identities are allocated independently of inserted records.
       * Resolve by source name when publishing rather than assuming that. */
      certified = .int[]; reasons = .string[]
      do i = 1 to source.procedures()
        body = source.procedure(i); fn = candidate.procedureid(body.name())
        if fn = 0 then do; call fail('invalid','normalization.procedure.mapping'); return; end
        certified[fn] = _complete[body.functionid()]; reasons[fn] = _unknownreason[body.functionid()]
        if _entrymode then do
          certified[fn] = _stagedcomplete[body.functionid()]; reasons[fn] = _stagedreasons[body.functionid()]
        end
      end
      if _entrymode then do
        _stagedresult = candidate; _stagedmapping = stagedmap; _stagedwarnings = staged
        _stagedcomplete = certified; _stagedreasons = reasons
        _status = 'tentative'; _message = 'normalization.entry.candidate.requires.proof'
      end
      else do
        _result = candidate; _mapping = stagedmap; _warnings = staged
        _complete = certified; _unknownreason = reasons; _certificate = candidate.identity()
        _status = 'changed'; _message = 'normalization.entry.reads.cleared'
      end
    on signal as problem
      call fail('invalid','normalization.failed: ' || problem.name() || ': ' || problem.message())
    end
    return
  status: method = .string
    call run(); return _status
  message: method = .string
    call run(); return _message
  reason: method = .string
    return message()
  result: method = .lltarget..module
    call run()
    if _hasresult = 0 then assembler signal "ERROR","LL_TARGET_NORMALIZE: input owner expired"
    return _result
  /** Explicit tentative read for rebuilding exact candidate proof owners.
   * Ordinary result(), operation() and warnings() still expose the input. */
  candidate: method = .lltarget..module
    call run()
    if _entrymode = 0 | _status <> 'tentative' then assembler signal "ERROR","LL_TARGET_NORMALIZE: no tentative entry candidate"
    return _stagedresult
  candidateoperation: method = .int
    arg old = .int
    call run()
    if _entrymode = 0 | _status <> 'tentative' then assembler signal "ERROR","LL_TARGET_NORMALIZE: no tentative entry mapping"
    if old < 1 | old > _stagedmapping[0] then assembler signal "ERROR","LL_TARGET_NORMALIZE: tentative source operation ordinal"
    return _stagedmapping[old]
  /** Commit only the single procedure whose complete source demand vector
   * licensed every staged clear. Failure publishes no map, warning or clear. */
  commit: method = .int
    arg certificate = .lltargetnormalize..entrycertificate
    certificates = .lltargetnormalize..entrycertificate[]; certificates[1] = certificate
    return commitall(certificates)
  commitall: method = .int
    arg certificates = .lltargetnormalize..entrycertificate[]
    i = .int; j = .int
    call run()
    if _entrymode = 0 | _status <> 'tentative' then return 0
    if <refvalid>(_owner) = 0 | <refvalid>(_flow) = 0 then do; call fail('invalid','normalization.entry.owner.expired'); return 0; end
    source = dereference _owner; flow = dereference _flow
    if flow.status() = 'limit' then do; call fail('limit','normalization.entry.proof.allowance'); return 0; end
    if source.valid() = 0 | source.identity() <> _entrysourceid | flow.matches(_owner) = 0 then do; call fail('invalid','normalization.entry.owner.changed'); return 0; end
    do i = 1 to _coverages[0]
      if _coverages[i].status() = 'limit' then do; call fail('limit','normalization.entry.proof.allowance'); return 0; end
      if _coverages[i].valid() = 0 | _coverages[i].complete() = 0 then do; call fail('invalid','normalization.entry.owner.changed'); return 0; end
    end
    if certificates[0] <> _modified[0] then do; call fail('invalid','normalization.entry.certificate.set.mismatch'); return 0; end
    do i = 1 to _modified[0]
      found = 0
      do j = 1 to certificates[0]
        if certificates[j].status() <> 'proved' then do; call fail(certificates[j].status(),certificates[j].reason()); return 0; end
        if certificates[j].function() <> _modified[i] then iterate
        found = found + 1
        if certificates[j].matchessource(_flow,_modified[i]) = 0 then do; call fail('invalid','normalization.entry.certificate.source.mismatch'); return 0; end
        body = source.body(_modified[i]); resultfn = _stagedresult.procedureid(body.name())
        if certificates[j].matchesresult(reference _stagedresult,resultfn) = 0 then do; call fail('invalid','normalization.entry.certificate.result.mismatch'); return 0; end
      end
      if found <> 1 then do; call fail('invalid','normalization.entry.certificate.set.mismatch'); return 0; end
    end
    _result = _stagedresult; _mapping = _stagedmapping; _warnings = _stagedwarnings
    _complete = _stagedcomplete; _unknownreason = _stagedreasons; _certificate = _result.identity()
    _status = 'changed'; _message = 'normalization.entry.candidate.committed'
    return 1
  modified: method = .int
    call run(); return _modified[0]
  modifiedfunction: method = .int
    arg ordinal = .int
    call run()
    if ordinal < 1 | ordinal > _modified[0] then assembler signal "ERROR","LL_TARGET_NORMALIZE: modified procedure ordinal"
    return _modified[ordinal]
  /** Charged construction envelope, including the lower remapper's complete
   * reserved quota. External candidate analyses/certificates are not included. */
  reservedwork: method = .int
    call run(); return _work + _remapwork
  reservedbytes: method = .int
    call run(); return _bytes + _remapbytes
  complete: method = .int
    arg functionid = .int
    call run()
    if _hasresult = 0 | wordpos(_status,'changed keep') = 0 then return 0
    if _result.valid() = 0 | _certificate <> _result.identity() then return 0
    if functionid < 2 | functionid > _complete[0] then return 0
    return _complete[functionid]
  unknownreason: method = .string
    arg functionid = .int
    if complete(functionid) then return ''
    if _hasresult = 0 | _result.valid() = 0 | _certificate <> _result.identity() then return 'normalization.certificate.unavailable'
    if functionid < 2 | functionid > _unknownreason[0] then return 'normalization.procedure.unproved'
    if _unknownreason[functionid] = '' then return 'normalization.procedure.unproved'
    return _unknownreason[functionid]
  operation: method = .int
    arg old = .int
    call run()
    if _status <> 'changed' then return old
    return _mapping[old]
  warnings: method = .int
    call run(); return _warnings[0]
  warning: method = .lltargetnormalize..warning
    arg ordinal = .int
    call run()
    if ordinal < 1 | ordinal > _warnings[0] then assembler signal "ERROR","LL_TARGET_NORMALIZE: warning ordinal"
    return _warnings[ordinal]
  /** This separately named result certifies callback observation preservation
   * for a checked transaction. It never changes complete(functionid), clears
   * callback havoc or grants another candidate the current result's proof. */
  conditional: method = .lltargetnormalize..conditionalcertificate
    arg sourceflow = reference .lltargetflow..analysis, candidateflow = reference .lltargetflow..analysis, summaries = reference .lltargetsummary..analysis, correspondence = reference .lltargetremap..correspondence, functionid = .int, work = 1000000, bytes = 67108864
    current = result()
    if _entrymode & _status = 'tentative' then current = candidate()
    return .conditionalcertificate(sourceflow,candidateflow,summaries,correspondence,functionid,work,bytes,current.identity())
  entryproof: method = .lltargetnormalize..entrycertificate
    arg sourceflow = reference .lltargetflow..analysis, candidateflow = reference .lltargetflow..analysis, correspondence = reference .lltargetremap..correspondence, callbacks = reference .lltargetnormalize..conditionalcertificate, functionid = .int, work = 1000000, bytes = 67108864
    current = result()
    if _entrymode & _status = 'tentative' then current = candidate()
    return .entrycertificate(sourceflow,candidateflow,correspondence,callbacks,functionid,work,bytes,current.identity())
  /** An unchanged procedure with exhaustive zero-dirty coverage needs no
