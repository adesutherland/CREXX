    end
    return
  valid: method = .int
    call run()
    if _status <> 'proved' | ownersvalid() = 0 then return 0
    do i = 1 to _proofs[0]; if _proofs[i].valid() = 0 then return 0; end
    return 1
  status: method = .string
    call run()
    if _status = 'proved' & valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    if status() = 'invalid' & _reason = '' then return 'normalization.preservation.owner.expired.or.replaced'
    return _reason
  preserved: method = .int
    return status() = 'proved' & valid()
  obligations: method = .int
    call run(); return _proofs[0]
  function: method = .int
    return _function
  matches: method = .int
    arg sourceflow = reference .lltargetflow..analysis, candidateflow = reference .lltargetflow..analysis, correspondence = reference .lltargetremap..correspondence, functionid = .int
    return valid() & (_sourceflow <refsame> sourceflow) & (_candidateflow <refsame> candidateflow) & (_correspondence <refsame> correspondence) & _function = functionid
  usedwork: method = .int
    return _limit - _remaining

/** Complete entry-demand coverage and callback preservation are independent
 * obligations for changed procedures. The separately named identity factory
 * instead requires zero dirty source demand and no own-procedure change.
 * Neither an empty witness vector nor preserved() alone certifies a rewrite.
 * Both modes leave unconditional change.complete(functionid) untouched. */
entrycertificate: class
  _sourceflow = reference .lltargetflow..analysis
  _candidateflow = reference .lltargetflow..analysis
  _correspondence = reference .lltargetremap..correspondence
  _callbacks = reference .lltargetnormalize..conditionalcertificate
  _sourcecoverage = .lltargetflow..entrycoveragefact
  _candidatecoverage = .lltargetflow..entrycoveragefact
  _dependencycoverage = .lltargetflow..entrycoveragefact[]
  _sourceid = .int
  _candidateid = .int
  _resultid = .int
  _function = .int
  _resultfunction = .int
  _functionname = .string
  _identitymode = .int
  _status = .string
  _reason = .string
  _limit = .int
  _remaining = .int
  _bytes = .int
  _bytelimit = .int
  *: factory
    arg sourceflow = reference .lltargetflow..analysis, candidateflow = reference .lltargetflow..analysis, correspondence = reference .lltargetremap..correspondence, callbacks = reference .lltargetnormalize..conditionalcertificate, functionid = .int, work = 1000000, bytes = 67108864, resultidentity = 0
    _sourceflow = sourceflow; _candidateflow = candidateflow; _correspondence = correspondence; _callbacks = callbacks
    _function = functionid; _limit = work; _remaining = work; _bytes = bytes; _bytelimit = bytes; _resultid = resultidentity; _status = 'building'
    return
  /** Separately named identity theorem: no dirty source demand and no change
   * in this procedure. Other procedures may contain checked entry clears;
   * their publication still requires their own transaction certificates. */
  identity: factory
    arg sourceflow = reference .lltargetflow..analysis, candidateflow = reference .lltargetflow..analysis, correspondence = reference .lltargetremap..correspondence, functionid = .int, work = 1000000, bytes = 67108864, resultidentity = 0
    _sourceflow = sourceflow; _candidateflow = candidateflow; _correspondence = correspondence; _identitymode = 1
    _function = functionid; _limit = work; _remaining = work; _bytes = bytes; _bytelimit = bytes; _resultid = resultidentity; _status = 'building'
    return
  fail: method = .int
    arg status = .string, reason = .string
    _status = status; _reason = reason; return 0
  spend: method = .int
    arg work = 1, bytes = 0
    if work < 0 | bytes < 0 | work > _remaining | bytes > _bytes then return fail('limit','normalization.entry.coverage.allowance')
    _remaining = _remaining - work; _bytes = _bytes - bytes; return 1
  ownersvalid: method = .int
    if <refvalid>(_sourceflow) = 0 | <refvalid>(_candidateflow) = 0 | <refvalid>(_correspondence) = 0 then return 0
    source = dereference _sourceflow; candidate = dereference _candidateflow; mapping = dereference _correspondence
    if source.valid() = 0 | candidate.valid() = 0 | mapping.valid() = 0 then return 0
    if _identitymode = 0 then do
      if <refvalid>(_callbacks) = 0 then return 0
      callbacks = dereference _callbacks
      if callbacks.valid() = 0 | callbacks.matches(_sourceflow,_candidateflow,_correspondence,_function) = 0 then return 0
    end
    if source.identity() <> _sourceid | candidate.identity() <> _candidateid then return 0
    sourceowner = source.owner(); candidateowner = candidate.owner(); expectedsource = mapping.sourceowner(); expectedcandidate = mapping.candidateowner()
    sourceprofile = source.transfers(); candidateprofile = candidate.transfers(); expectedprofile = mapping.sourceprofile(); expectedresultprofile = mapping.candidateprofile()
    sourcecfg = source.cfg(); candidatecfg = candidate.cfg(); expectedcfg = mapping.sourcecfg(); expectedresultcfg = mapping.candidatecfg()
    return (sourceowner <refsame> expectedsource) & (candidateowner <refsame> expectedcandidate) & (sourceprofile <refsame> expectedprofile) & (candidateprofile <refsame> expectedresultprofile) & (sourcecfg <refsame> expectedcfg) & (candidatecfg <refsame> expectedresultcfg)
  run: method = .void
    if _status <> 'building' then return
    i = .int; j = .int; fn = .int; resultfn = .int; ignored = .int; found = .int; index = .int; head = .int; dependency = .int
    cleared = .int[]; licensed = .int[]; body = .lltarget..body; item = .lltarget..record
    pending = .int[]; seen = .int[]
    do
      if _limit < 1 | _bytes < 1 then do; ignored = fail('limit','normalization.entry.coverage.allowance'); return; end
      if <refvalid>(_sourceflow) = 0 | <refvalid>(_candidateflow) = 0 | <refvalid>(_correspondence) = 0 then do; ignored = fail('invalid','normalization.entry.coverage.owner.expired'); return; end
      sourceflow = dereference _sourceflow; candidateflow = dereference _candidateflow; mapping = dereference _correspondence
      if sourceflow.status() = 'limit' | candidateflow.status() = 'limit' | mapping.status() = 'limit' then do; ignored = fail('limit','normalization.entry.coverage.analysis.allowance'); return; end
      if sourceflow.status() <> 'ok' | candidateflow.status() <> 'ok' then do; ignored = fail('invalid','normalization.entry.coverage.analysis.unavailable'); return; end
      if mapping.status() <> 'proved' then do; ignored = fail(mapping.status(),mapping.reason()); return; end
      if _identitymode = 0 then do
        if <refvalid>(_callbacks) = 0 then do; ignored = fail('invalid','normalization.entry.coverage.owner.expired'); return; end
        callbacks = dereference _callbacks
        if callbacks.status() <> 'proved' then do; ignored = fail(callbacks.status(),callbacks.reason()); return; end
      end
      else if _resultid = 0 then do; ignored = fail('invalid','normalization.entry.identity.result.required'); return; end
      _sourceid = sourceflow.identity(); _candidateid = candidateflow.identity()
      if ownersvalid() = 0 then do; ignored = fail('invalid','normalization.entry.coverage.owner.mismatch'); return; end
      owner_ref = mapping.sourceowner(); result_ref = mapping.candidateowner(); source = dereference owner_ref; candidate = dereference result_ref
      if _resultid <> 0 & candidate.identity() <> _resultid then do; ignored = fail('invalid','normalization.entry.coverage.result.mismatch'); return; end
      found = 0
      do i = 1 to source.procedures()
        if spend() = 0 then return
        body = source.procedure(i)
        if body.functionid() = _function then do; found = 1; leave; end
      end
      if found = 0 then do; ignored = fail('invalid','normalization.entry.coverage.function.invalid'); return; end
      if spend(candidate.procedures() + 1) = 0 then return
      resultfn = candidate.procedureid(body.name())
      if resultfn = 0 then do; ignored = fail('invalid','normalization.entry.coverage.function.mapping'); return; end
      _resultfunction = resultfn; _functionname = body.name()
      _sourcecoverage = sourceflow.entrycoverage(_function); _candidatecoverage = candidateflow.entrycoverage(resultfn)
      if _sourcecoverage.status() = 'limit' | _candidatecoverage.status() = 'limit' then do; ignored = fail('limit','normalization.entry.coverage.demand.allowance'); return; end
      if _sourcecoverage.status() = 'invalid' | _candidatecoverage.status() = 'invalid' then do; ignored = fail('invalid','normalization.entry.coverage.demand.owner'); return; end
      if _sourcecoverage.complete() = 0 then do; ignored = fail('unknown','normalization.entry.source.coverage: ' || _sourcecoverage.reason()); return; end
      if _identitymode then do
        if _sourcecoverage.demands() > 0 | _sourcecoverage.unresolved() > 0 then do; ignored = fail('unknown','normalization.entry.identity.source.dirty'); return; end
      end
      if spend(body.locals() + _sourcecoverage.demands() + mapping.insertions() + 1,body.locals() * 16 + 64) = 0 then return
      do i = 0 to body.locals() - 1; cleared[i + 1] = 0; licensed[i + 1] = 0; end
      do i = 1 to _sourcecoverage.demands()
        demand = _sourcecoverage.demand(i); index = demand.ownedindex()
        if demand.valid() = 0 | demand.function() <> _function | demand.bank() <> 'r' | index < 0 | index >= body.locals() then do; ignored = fail('invalid','normalization.entry.source.demand.owner'); return; end
        licensed[index + 1] = 1
      end
      do i = 1 to mapping.insertions()
        if spend(candidate.procedures()) = 0 then return
        item = candidate.at(mapping.insertion(i)); insertedbody = candidate.body(item.procedureid())
        if insertedbody.name() <> body.name() then iterate
        if _identitymode then do; ignored = fail('unknown','normalization.entry.identity.procedure.changed'); return; end
        value = item.operand(1); index = value.index()
        if value.kind() <> 'R' | value.bank() <> 'r' | index < 0 | index >= body.locals() then do; ignored = fail('invalid','normalization.entry.clear.owner'); return; end
        if licensed[index + 1] = 0 then do; ignored = fail('unknown','normalization.entry.clear.unlicensed'); return; end
        if cleared[index + 1] then do; ignored = fail('unknown','normalization.entry.clear.duplicate'); return; end
        cleared[index + 1] = 1
      end
      do i = 1 to licensed[0]
        if spend() = 0 then return
        if licensed[i] & cleared[i] = 0 then do; ignored = fail('unknown','normalization.entry.clear.missing'); return; end
      end
      if _candidatecoverage.complete() = 0 then do; ignored = fail('unknown','normalization.entry.candidate.coverage: ' || _candidatecoverage.reason()); return; end
      if _candidatecoverage.demands() > 0 | _candidatecoverage.unresolved() > 0 then do; ignored = fail('unknown','normalization.entry.candidate.dirty'); return; end
      /* A caller with no own dirty rows can still return/read an original
       * dirty provider payload. Every candidate owner in that dependency
       * closure must be completely extracted and independently discharged. */
      if spend(candidate.procedures() + 2,(candidate.procedures() + 2) * 8) = 0 then return
      do i = 1 to candidate.procedures() + 1; seen[i] = 0; end
      pending[1] = resultfn; seen[resultfn] = 1; _dependencycoverage[1] = _candidatecoverage; head = 1
      do while head <= pending[0]
        if spend(1) = 0 then return
        view = _dependencycoverage[head]; head = head + 1
        do i = 1 to view.dependencies()
          if spend(candidate.procedures() + candidateflow.lookupcost() + 1,320) = 0 then return
          dependency = view.dependency(i)
          if dependency <= seen[0] then do; if seen[dependency] then iterate; end
          required = candidateflow.entrycoverage(dependency)
          if required.status() = 'limit' | required.status() = 'invalid' then do; ignored = fail(required.status(),required.reason()); return; end
          if required.complete() = 0 | required.demands() > 0 | required.unresolved() > 0 then do; ignored = fail('unknown','normalization.entry.candidate.dependency.not.discharged'); return; end
          seen[dependency] = 1; pending[pending[0] + 1] = dependency
          _dependencycoverage[_dependencycoverage[0] + 1] = required
        end
      end
      if ownersvalid() = 0 then do; ignored = fail('invalid','normalization.entry.coverage.owner.replaced'); return; end
      _status = 'proved'; _reason = ''
    on signal as problem
      ignored = fail('invalid','normalization.entry.coverage.failed: ' || problem.name() || ': ' || problem.message())
    end
    return
  valid: method = .int
    call run()
    if _status <> 'proved' | ownersvalid() = 0 then return 0
    if _identitymode then do
      if _sourcecoverage.demands() > 0 | _sourcecoverage.unresolved() > 0 then return 0
    end
    do i = 1 to _dependencycoverage[0]
      if _dependencycoverage[i].valid() = 0 | _dependencycoverage[i].complete() = 0 | _dependencycoverage[i].demands() > 0 | _dependencycoverage[i].unresolved() > 0 then return 0
    end
    return _sourcecoverage.valid() & _candidatecoverage.valid() & _sourcecoverage.complete() & _candidatecoverage.complete() & _candidatecoverage.demands() = 0 & _candidatecoverage.unresolved() = 0
  status: method = .string
    call run()
    if _status = 'proved' & valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    if status() = 'invalid' & _reason = '' then return 'normalization.entry.coverage.owner.expired.or.replaced'
    return _reason
  covered: method = .int
    return status() = 'proved' & valid()
  function: method = .int
    return _function
  /** Revalidate the complete theorem and its exact source analysis/function.
   * The owner/profile/CFG/correspondence references are never reconstructed. */
  matchessource: method = .int
    arg points = reference .lltargetflow..analysis, functionid = .int
    return covered() & (_sourceflow <refsame> points) & _function = functionid
  /** Match a published immutable result and its name-mapped function. A
   * constructor without the transaction's nonzero result stamp grants none. */
  matchesresult: method = .int
    arg owner = reference .lltarget..module, functionid = .int
    if _resultid = 0 | <refvalid>(owner) = 0 then return 0
    if covered() = 0 then return 0
    source = dereference owner; points = dereference _candidateflow
    actual_ref = points.owner(); actual = dereference actual_ref
    if source.valid() = 0 | source.identity() <> _resultid | actual.identity() <> _resultid | functionid <> _resultfunction then return 0
    return source.procedureid(_functionname) = functionid & actual.procedureid(_functionname) = functionid
  usedwork: method = .int
    return _limit - _remaining
  usedbytes: method = .int
    return _bytelimit - _bytes

/** A normalization receipt for one unchanged caller site. This certifies
 * neither the rest of the caller nor a provider body. Unknown later local
 * ingress is retained by the shared CFG/flow query, not discarded here. */
sitecertificate: class
  _sourceflow = reference .lltargetflow..analysis
  _candidateflow = reference .lltargetflow..analysis
  _correspondence = reference .lltargetremap..correspondence
  _sourceid = .int
  _candidateid = .int
  _sourceop = .int
  _candidateop = .int
  _resultid = .int
  _sourcecoverage = .lltargetflow..entrycoveragefact
  _candidatecoverage = .lltargetflow..entrycoveragefact
  _dependencies = .lltargetflow..entrycoveragefact[]
  _status = .string
  _reason = .string
  _work = .int
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  *: factory
    arg sourceflow = reference .lltargetflow..analysis, candidateflow = reference .lltargetflow..analysis, correspondence = reference .lltargetremap..correspondence, sourceop = .int, candidateop = .int, resultidentity = .int, work = 1000000, bytes = 67108864
    _sourceflow = sourceflow; _candidateflow = candidateflow; _correspondence = correspondence
    _sourceop = sourceop; _candidateop = candidateop; _resultid = resultidentity
    _worklimit = work; _bytelimit = bytes; _status = 'building'
    return
  unavailable: factory
    arg state = .string, reason = .string
    _status = state; _reason = reason
    return
  fail: method = .int
    arg state = .string, reason = .string
    if _status = 'building' then do; _status = state; _reason = reason; end
    return 0
  spend: method = .int
    arg work = 1, bytes = 0
    if work < 0 | bytes < 0 | work > _worklimit - _work | bytes > _bytelimit - _bytes then return fail('limit','normalization.site.work.or.bytes')
    _work = _work + work; _bytes = _bytes + bytes; return 1
  ownersvalid: method = .int
    if <refvalid>(_sourceflow) = 0 | <refvalid>(_candidateflow) = 0 | <refvalid>(_correspondence) = 0 then return 0
    source = dereference _sourceflow; candidate = dereference _candidateflow; mapping = dereference _correspondence
    if source.valid() = 0 | candidate.valid() = 0 | mapping.valid() = 0 then return 0
    if source.identity() <> _sourceid | candidate.identity() <> _candidateid then return 0
    a = source.owner(); b = candidate.owner(); expecteda = mapping.sourceowner(); expectedb = mapping.candidateowner()
    p = source.transfers(); q = candidate.transfers(); expectedp = mapping.sourceprofile(); expectedq = mapping.candidateprofile()
    c = source.cfg(); d = candidate.cfg(); expectedc = mapping.sourcecfg(); expectedd = mapping.candidatecfg()
    return (a <refsame> expecteda) & (b <refsame> expectedb) & (p <refsame> expectedp) & (q <refsame> expectedq) & (c <refsame> expectedc) & (d <refsame> expectedd)
  run: method = .void
    i = .int; j = .int; ignored = .int; functionid = .int; head = .int; dependency = .int
    pending = .int[]; seen = .int[]; body = .lltarget..body
    if _status <> 'building' then return
    if <refvalid>(_sourceflow) = 0 | <refvalid>(_candidateflow) = 0 | <refvalid>(_correspondence) = 0 then do; ignored = fail('invalid','normalization.site.owner.expired'); return; end
    sourceflow = dereference _sourceflow; candidateflow = dereference _candidateflow; mapping = dereference _correspondence
    if sourceflow.status() <> 'ok' | candidateflow.status() <> 'ok' then do; ignored = fail('invalid','normalization.site.flow.unavailable'); return; end
    if mapping.status() <> 'proved' then do; ignored = fail(mapping.status(),mapping.reason()); return; end
    _sourceid = sourceflow.identity(); _candidateid = candidateflow.identity()
    if ownersvalid() = 0 then do; ignored = fail('invalid','normalization.site.owner.mismatch'); return; end
    sourceref = sourceflow.owner(); candidateref = candidateflow.owner(); source = dereference sourceref; candidate = dereference candidateref
    if _resultid = 0 | candidate.identity() <> _resultid then do; ignored = fail('invalid','normalization.site.result.mismatch'); return; end
    graphref = source.ir(); graph = dereference graphref
    if _sourceop < 1 | _sourceop > graph.operations() then do; ignored = fail('invalid','normalization.site.operation.invalid'); return; end
    if mapping.operation(_sourceop) <> _candidateop then do; ignored = fail('invalid','normalization.site.operation.mapping'); return; end
    original = source.at(_sourceop); selected = candidate.at(_candidateop); body = source.body(original.procedureid())
    if candidate.procedureid(body.name()) <> selected.procedureid() then do; ignored = fail('invalid','normalization.site.function.mapping'); return; end
    do i = 1 to mapping.insertions()
      if spend(1) = 0 then return
      item = candidate.at(mapping.insertion(i))
      if item.procedureid() = selected.procedureid() then do; ignored = fail('unknown','normalization.site.caller.changed'); return; end
    end
    beforework = sourceflow.usedwork(); beforebytes = sourceflow.usedbytes()
    _sourcecoverage = sourceflow.entrycoverageat(_sourceop,_worklimit - _work,_bytelimit - _bytes)
    if spend(max(0,sourceflow.usedwork() - beforework),max(0,sourceflow.usedbytes() - beforebytes)) = 0 then return
    if _sourcecoverage.complete() = 0 then do; ignored = fail(_sourcecoverage.status(),_sourcecoverage.reason()); return; end
    if _sourcecoverage.operation() <> _sourceop then do; ignored = fail('invalid','normalization.site.source.operation.mismatch'); return; end
    if _sourcecoverage.demands() <> 0 | _sourcecoverage.unresolved() <> 0 then do; ignored = fail('unknown','normalization.site.source.dirty'); return; end
    beforework = candidateflow.usedwork(); beforebytes = candidateflow.usedbytes()
    _candidatecoverage = candidateflow.entrycoverageat(_candidateop,_worklimit - _work,_bytelimit - _bytes)
    if spend(max(0,candidateflow.usedwork() - beforework),max(0,candidateflow.usedbytes() - beforebytes)) = 0 then return
    if _candidatecoverage.complete() = 0 then do; ignored = fail(_candidatecoverage.status(),_candidatecoverage.reason()); return; end
    if _candidatecoverage.operation() <> _candidateop then do; ignored = fail('invalid','normalization.site.candidate.operation.mismatch'); return; end
    if _candidatecoverage.demands() <> 0 | _candidatecoverage.unresolved() <> 0 then do; ignored = fail('unknown','normalization.site.candidate.dirty'); return; end
    if spend(candidate.procedures() * 2 + 1,(candidate.procedures() + 2) * 16) = 0 then return
    do i = 1 to candidate.procedures() + 1; seen[i] = 0; end
    do i = 1 to _sourcecoverage.dependencies()
      body = source.body(_sourcecoverage.dependency(i)); functionid = candidate.procedureid(body.name())
      if functionid < 2 then do; ignored = fail('invalid','normalization.site.dependency.mapping'); return; end
      if seen[functionid] = 0 then do; seen[functionid] = 1; pending[pending[0] + 1] = functionid; end
    end
    do i = 1 to _candidatecoverage.dependencies()
      functionid = _candidatecoverage.dependency(i)
      if functionid < 2 | functionid > seen[0] then do; ignored = fail('invalid','normalization.site.dependency.owner'); return; end
      if seen[functionid] = 0 then do; seen[functionid] = 1; pending[pending[0] + 1] = functionid; end
    end
    head = 1
    do while head <= pending[0]
      if spend(1,256) = 0 then return
      functionid = pending[head]; head = head + 1
      beforework = candidateflow.usedwork(); beforebytes = candidateflow.usedbytes(); required = candidateflow.entrycoverage(functionid)
      if spend(max(0,candidateflow.usedwork() - beforework),max(0,candidateflow.usedbytes() - beforebytes)) = 0 then return
      if required.complete() = 0 | required.demands() <> 0 | required.unresolved() <> 0 then do; ignored = fail('unknown','normalization.site.dependency.not.discharged'); return; end
      _dependencies[_dependencies[0] + 1] = required
      do i = 1 to required.dependencies()
        if spend(1) = 0 then return
        dependency = required.dependency(i)
        if dependency < 2 | dependency > seen[0] then do; ignored = fail('invalid','normalization.site.dependency.owner'); return; end
        if seen[dependency] = 0 then do; seen[dependency] = 1; pending[pending[0] + 1] = dependency; end
      end
    end
    if ownersvalid() = 0 then do; ignored = fail('invalid','normalization.site.owner.replaced'); return; end
    _status = 'proved'
    return
  valid: method = .int
    call run()
    if _status <> 'proved' | ownersvalid() = 0 then return 0
    if _sourcecoverage.valid() = 0 | _candidatecoverage.valid() = 0 then return 0
    do i = 1 to _dependencies[0]; if _dependencies[i].valid() = 0 then return 0; end
    return 1
  status: method = .string
    call run()
    if _status = 'proved' & valid() = 0 then return 'invalid'
    return _status
  reason: method = .string
    if status() = 'invalid' & _reason = '' then return 'normalization.site.owner.expired.or.replaced'
    return _reason
  covered: method = .int
    return valid()
  matchessource: method = .int
    arg points = reference .lltargetflow..analysis, operation = .int
    return covered() & (_sourceflow <refsame> points) & _sourceop = operation
  matchesresult: method = .int
    arg owner = reference .lltarget..module, operation = .int
    if covered() = 0 | <refvalid>(owner) = 0 then return 0
    candidate = dereference owner; flow = dereference _candidateflow; expectedref = flow.owner(); expected = dereference expectedref
    return candidate.valid() & candidate.identity() = _resultid & expected.identity() = _resultid & operation = _candidateop
  usedwork: method = .int
    return _work
  usedbytes: method = .int
    return _bytes

normalize: procedure = .lltargetnormalize..change
  arg owner = reference .lltarget..module, flow = reference .lltargetflow..analysis, work = 1000000, bytes = 67108864
  return .change(owner,flow,work,bytes)

/** Build one private whole-cell entry-clear proposal from exhaustive source
 * demand coverage. candidate()/candidateoperation() expose only proof inputs;
 * result/map/warnings retain the original until commit(entrycertificate).
 * The construction allowance excludes the caller-owned candidate analyses,
 * correspondence and certificates, which need their own reserved envelope.
 * @param owner Exact source module, retained through proof and commit.
 * @param flow Exact source point/edge analysis and operational premise.
 * @param functionid Only procedure whose dirty owned demands may be cleared.
 * @param work Whole candidate-construction work allowance.
 * @param bytes Whole candidate-construction logical byte allowance.
 * @return Tentative change, unchanged input on an unknown or failed stage.
 */
entrycandidate: procedure = .lltargetnormalize..change
  arg owner = reference .lltarget..module, flow = reference .lltargetflow..analysis, functionid = .int, work = 1000000, bytes = 67108864
  return .change.entrycandidate(owner,flow,functionid,work,bytes)

/** One final candidate for distinct requested procedures. Every source
 * coverage must be complete; commitall requires the exact modified-fn set. */
entrycandidates: procedure = .lltargetnormalize..change
  arg owner = reference .lltarget..module, flow = reference .lltargetflow..analysis, functions = .int[], work = 1000000, bytes = 67108864
  return .change.entrycandidates(owner,flow,functions,work,bytes)

/** Canonical explicit counterparts are part of the native opcode contract.
 * Decode packed indices against the original layout before any caller grows.
 * Remaining implicit references require a typed transfer selector; captured
 * arguments and qualified globals also require their original logical scope.
 * A later wrapper cannot supply an owner missing from the authored body.
 * No inliner or cleanup client needs its own implicit-opcode cases. */
explicit: procedure = .lltargetnormalize..change
  arg owner = reference .lltarget..module, work = 1000000, bytes = 67108864
  item = .lltarget..record; body = .lltarget..body; target = .lltarget..bodydraft
  value = .lltarget..operand; fields = .object[]; replacements = .object[]
  bodies = .object[]; origins = .object[]; sources = .object[]; mapping = .int[]; empty = .int[]
  profile = .lltargettransfer..profile; cfg = .lltargetcfg..graph
  instruction = .lltargettransfer..instruction; ref = .lltargettransfer..refview
  i = .int; j = .int; found = .int; packed = .int; variant = .int
  residual = .int; represented = .int; scoped = .int
  if <refvalid>(owner) = 0 then return .change.resolved('invalid','normalization.owner.expired')
  source = dereference owner
  if source.valid() = 0 then return .change.resolved('invalid',source.error(),source)
  if work < 1 | bytes < 1 then return .change.resolved('limit','normalization.budgets.must.be.positive',source)
  catalog = .llrxascatalog..catalog()
  do
    do i = 1 to source.records()
      work = work - 1
      if work < 1 then return .change.resolved('limit','normalization.explicit.work',source)
      item = source.record(i)
      if item.kind() <> 'instruction' then iterate
      if catalog.explicitvariant(item.opcode()) >= 0 then found = 1
      else if catalog.implicit(item.opcode()) <> 0 then residual = 1
    end
    if residual then do
      profile = .lltargettransfer..profile(owner,work,bytes)
      if profile.status() <> 'ok' then return .change.resolved(profile.status(),'normalization.explicit.transfer: ' || profile.message(),source)
      work = work - profile.usedwork(); bytes = bytes - profile.usedbytes()
      do i = 1 to source.records()
        work = work - 1
        if work < 1 | bytes < 1 then return .change.resolved('limit','normalization.explicit.work.or.bytes',source)
        item = source.record(i)
        if item.kind() <> 'instruction' then iterate
        if catalog.implicit(item.opcode()) = 0 | catalog.explicitvariant(item.opcode()) >= 0 then iterate
        instruction = profile.instruction(item.id()); represented = 0
        do j = 1 to instruction.references()
          work = work - 1
          if work < 1 then return .change.resolved('limit','normalization.explicit.work',source)
          ref = instruction.ref(j)
          if ref.kind() = 'window' | ref.kind() = 'recipe' then represented = 1
          else if ref.kind() = 'address' then do
            if wordpos(ref.addresskind(),'localindex argument capturedargument reference attribute attribute1 qualifiedglobal parent') = 0 then return .change.resolved('invalid','normalization.implicit.address.unrepresented.' || ref.addresskind(),source)
            represented = 1
            if wordpos(ref.addresskind(),'capturedargument qualifiedglobal') = 0 then iterate
            if scoped = 0 then do
              cfg = .lltargetcfg..graph(owner,reference profile,work,bytes)
              if cfg.status() <> 'ok' then return .change.resolved(cfg.status(),'normalization.explicit.cfg: ' || cfg.message(),source)
              work = work - cfg.usedwork(); bytes = bytes - cfg.usedbytes(); scoped = 1
              if work < 1 | bytes < 1 then return .change.resolved('limit','normalization.explicit.work.or.bytes',source)
            end
            if cfg.scopeowner(item.id()) = 0 then return .change.resolved('invalid','normalization.scope.owner.required.' || ref.addresskind(),source)
          end
        end
        if represented = 0 then return .change.resolved('invalid','normalization.implicit.reference.unrepresented: ' || instruction.unknownreason('references'),source)
      end
    end
    if found = 0 then return .change.resolved('keep','normalization.no.implicit.operand',source)
    draft = .lltarget..draft(source.name(),source.artifact(),source.globals(),1000000,bytes,work); graph_ref = source.ir()
    do i = 1 to source.records()
      item = source.record(i)
      if draft.preflight(1 + item.operands(),0) = 0 then return .change.resolved('limit',draft.error(),source)
      at = lltargetremap..copyorigin(graph_ref,item.origin(),reference draft,reference sources,reference origins)
      if item.kind() = 'procedure' then do
        body = source.body(item.procedureid()); target = draft.procedure(body.name(),body.locals(),at,body.expose(),body.entrykind())
        bodies[item.procedureid()] = target as .object; mapping[item.id()] = target.headerid(); iterate
      end
      if item.procedureid() = 0 then do
        call objectarraydrop fields
        do j = 1 to item.operands(); fields[j] = item.operand(j) as .object; end
        mapping[item.id()] = draft.record(item.kind(),fields,at); iterate
      end
      target = bodies[item.procedureid()] as .lltarget..bodydraft; body = source.body(item.procedureid()); variant = -1
      if item.kind() = 'instruction' then variant = catalog.explicitvariant(item.opcode())
      call objectarraydrop fields
      if variant >= 0 then do
        selectors = translate(catalog.implicitrecipe(item.opcode()),' ', ';')
        if words(selectors) = 0 then return .change.resolved('invalid','normalization.explicit.selector.unrepresented',source)
        do j = 1 to words(selectors)
          selector = translate(word(selectors,j),' ', ':')
          if words(selector) <> 2 | wordpos(word(selector,1),'localindex local') = 0 then return .change.resolved('invalid','normalization.explicit.selector.unrepresented',source)
          packed = word(selector,2) as .int
          if word(selector,1) = 'localindex' then do; value = item.operand(packed); packed = value.index(); end
          if packed < 0 then return .change.resolved('invalid','normalization.packed.index.negative',source)
          bank = 'r'; index = packed
          if packed >= body.locals() + source.globals() then do; bank = 'a'; index = packed - body.locals() - source.globals(); end
          else if packed >= body.locals() then do; bank = 'g'; index = packed - body.locals(); end
          fields[fields[0] + 1] = target.reg(bank,index) as .object
        end
        do j = 1 to item.operands()
          value = item.operand(j)
          if value.kind() = 'R' then fields[fields[0] + 1] = target.reg(value.bank(),value.index()) as .object
        end
        mapping[item.id()] = target.emit(catalog.mnemonic(variant),fields,at)
      end
      else do
        call objectarraydrop replacements
        do j = 1 to item.registerrefs()
          value = item.registerref(j); replacements[j] = target.reg(value.bank(),value.index()) as .object
        end
        fields = lltarget..remapregisters(item,replacements)
        if item.kind() = 'instruction' then mapping[item.id()] = target.emit(item.mnemonic(),fields,at)
        else mapping[item.id()] = target.record(item.kind(),fields,at)
      end
    end
    if draft.error() <> '' then return .change.resolved('invalid',draft.error(),source)
    result = draft.finish()
    if result.valid() = 0 then return .change.resolved('invalid',result.error(),source)
    return .change.resolved('changed','normalization.explicit.operands',result,mapping)
  on signal as problem
    status = 'invalid'
    if pos('LL_RESOURCE_LIMIT',problem.message()) > 0 then status = 'limit'
    return .change.resolved(status,'normalization.explicit.failed: ' || problem.name() || ': ' || problem.message(),source)
  end
  return .change.resolved('invalid','normalization.explicit.no.result',source)
