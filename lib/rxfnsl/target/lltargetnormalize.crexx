  identityproof: method = .lltargetnormalize..entrycertificate
    arg sourceflow = reference .lltargetflow..analysis, candidateflow = reference .lltargetflow..analysis, correspondence = reference .lltargetremap..correspondence, functionid = .int, work = 1000000, bytes = 67108864
    current = result()
    if _entrymode & _status = 'tentative' then current = candidate()
    return .entrycertificate.identity(sourceflow,candidateflow,correspondence,functionid,work,bytes,current.identity())

/** Conditional callback preservation for the checked same-activation entry
 * clear transaction. The source and candidate remain owned by the request;
 * expiration/replacement invalidates this certificate. Intervening uses are
 * checked over the shared reverse CFG, never by assuming root freshness or
 * recomputing values. An unresolved dependency remains a named proof gap.
 * This is not exhaustive owned-entry demand coverage: preservation can hold
 * with no insertion or with later callback rebinding still unknown. It must
 * never replace complete(functionid) without a separate coverage theorem. */
conditionalcertificate: class
  _sourceflow = reference .lltargetflow..analysis
  _candidateflow = reference .lltargetflow..analysis
  _summaries = reference .lltargetsummary..analysis
  _correspondence = reference .lltargetremap..correspondence
  _sourceid = .int
  _candidateid = .int
  _summaryid = .int
  _resultid = .int
  _function = .int
  _status = .string
  _reason = .string
  _proofs = .lltargetsummary..preservationfact[]
  _limit = .int
  _remaining = .int
  _bytes = .int
  *: factory
    arg sourceflow = reference .lltargetflow..analysis, candidateflow = reference .lltargetflow..analysis, summaries = reference .lltargetsummary..analysis, correspondence = reference .lltargetremap..correspondence, functionid = .int, work = 1000000, bytes = 67108864, resultidentity = 0
    _sourceflow = sourceflow; _candidateflow = candidateflow; _summaries = summaries; _correspondence = correspondence
    _function = functionid; _limit = work; _remaining = work; _bytes = bytes; _resultid = resultidentity; _status = 'building'
    return
  fail: method = .int
    arg status = .string, reason = .string
    _status = status; _reason = reason; return 0
  spend: method = .int
    arg work = 1, bytes = 0
    if work < 0 | bytes < 0 | work > _remaining | bytes > _bytes then return fail('limit','normalization.preservation.allowance')
    _remaining = _remaining - work; _bytes = _bytes - bytes; return 1
  ownersvalid: method = .int
    if <refvalid>(_sourceflow) = 0 | <refvalid>(_candidateflow) = 0 | <refvalid>(_summaries) = 0 | <refvalid>(_correspondence) = 0 then return 0
    source = dereference _sourceflow; candidate = dereference _candidateflow; summaries = dereference _summaries; mapping = dereference _correspondence
    if source.valid() = 0 | candidate.valid() = 0 | summaries.valid() = 0 | mapping.valid() = 0 then return 0
    if source.identity() <> _sourceid | candidate.identity() <> _candidateid | summaries.identity() <> _summaryid then return 0
    before = mapping.sourceowner(); after = mapping.candidateowner(); actual = source.owner(); resultowner = candidate.owner(); shared = summaries.flow()
    leftprofile = source.transfers(); rightprofile = candidate.transfers(); expectedleft = mapping.sourceprofile(); expectedright = mapping.candidateprofile()
    leftcfg = source.cfg(); rightcfg = candidate.cfg(); expectedcfg = mapping.sourcecfg(); expectedresultcfg = mapping.candidatecfg()
    return (before <refsame> actual) & (after <refsame> resultowner) & (shared <refsame> _sourceflow) & (leftprofile <refsame> expectedleft) & (rightprofile <refsame> expectedright) & (leftcfg <refsame> expectedcfg) & (rightcfg <refsame> expectedresultcfg)
  intersects: method = .int
    arg instruction = .lltargettransfer..instruction, ordinal = .int, referenceid = .int, cells = .int[]
    ignored = .int
    if referenceid = 0 then return 0
    sourceflow = dereference _sourceflow; profile_ref = sourceflow.transfers(); profile = dereference profile_ref
    view = profile.ref(referenceid); value = view.operand()
    if view.kind() = 'address' | view.kind() = 'window' | view.extentknown() = 0 | view.extent() <> 1 then do; ignored = fail('unknown','normalization.preservation.prefix.extent.unproved'); return -1; end
    if value.kind() <> 'R' then return 0
    if spend(sourceflow.lookupcost() * (cells[0] + 1) + cells[0] + 1) = 0 then return -1
    accessed = sourceflow.actionstorage(instruction.opid(),ordinal,referenceid); storage = accessed.active()
    if view.anchor() = 'base' then storage = accessed.base()
    else if view.anchor() = 'entry' then storage = accessed.entry()
    else if view.anchor() = 'slot' then return 0
    if storage = 0 then do; ignored = fail('unknown','normalization.preservation.prefix.binding.unproved'); return -1; end
    do i = 1 to cells[0]
      changed = sourceflow.storageat(instruction.opid(),'r',cells[i])
      if changed.active() = 0 | changed.active() <> changed.base() | changed.base() <> changed.entry() then do; ignored = fail('unknown','normalization.preservation.delta.binding.unproved'); return -1; end
      if storage = changed.active() then return 1
      if sourceflow.privatedistinct(_function,changed.active(),storage) = 0 then do; ignored = fail('unknown','normalization.preservation.prefix.alias.unproved'); return -1; end
    end
    return 0
  output: method = .int
    arg expose cells = .int[], instruction = .lltargettransfer..instruction, ordinal = .int, referenceid = .int
    if referenceid = 0 then return fail('unknown','normalization.preservation.output.unrepresented')
    sourceflow = dereference _sourceflow; profile_ref = sourceflow.transfers(); profile = dereference profile_ref
    view = profile.ref(referenceid); value = view.operand(); owner_ref = sourceflow.owner(); source = dereference owner_ref
    if spend(source.procedures() + 1) = 0 then return 0
    body = source.body(_function)
    if value.kind() <> 'R' | value.bank() <> 'r' | value.index() < 0 | value.index() >= body.locals() | view.kind() = 'address' | view.kind() = 'window' | view.extentknown() = 0 | view.extent() <> 1 | view.anchor() <> 'active' then return fail('unknown','normalization.preservation.output.escape.unproved')
    if spend(sourceflow.lookupcost() + cells[0] + 1) = 0 then return 0
    binding = sourceflow.actionstorage(instruction.opid(),ordinal,referenceid)
    if binding.active() = 0 | binding.active() <> binding.base() | binding.base() <> binding.entry() then return fail('unknown','normalization.preservation.output.binding.unproved')
    do i = 1 to cells[0]; if cells[i] = value.index() then return 1; end
    if spend(1,32) = 0 then return 0
    cells[cells[0] + 1] = value.index(); return 1
  /** Monotone whole-cell MAY-taint through the shared reverse-CFG ancestors.
   * Joins union and backedges revisit; no possible write kills taint. The
   * instruction-local dependency bit includes reads/observations/captures,
   * including arithmetic whose canonical output has no sourceid. */
  closure: method = .int[]
    arg operation = .int, ordinal = .int, delta = .int
    sourceflow = dereference _sourceflow
    cfg_ref = sourceflow.cfg(); cfg = dereference cfg_ref; index_ref = cfg.index(); index = dereference index_ref
    profile_ref = sourceflow.transfers(); profile = dereference profile_ref; owner_ref = sourceflow.owner(); source = dereference owner_ref
    pending = .int[]; marked = .int[]; cells = .int[]; empty = .int[]; head = 1; targetblock = cfg.projectedblock(operation)
    i = .int; j = .int; e = .int; f = .int; block = .int; last = .int; previoussize = -1; tainted = .int; restricted = .int; hit = .int; normals = .int; ignored = .int
    action = .lltargettransfer..action; edge = .lltargetcfg..edge
    if targetblock < 1 | targetblock > index.blocks() then do; ignored = fail('unknown','normalization.preservation.prefix.block.unproved'); return empty; end
    if spend(index.blocks() + 1,index.blocks() * 16 + 64) = 0 then return empty
    do i = 1 to index.blocks(); marked[i] = 0; end
    pending[1] = targetblock; marked[targetblock] = 1; cells[1] = delta
    do while head <= pending[0]
      block = pending[head]; head = head + 1
      do i = 1 to index.predecessors(block)
        if spend() = 0 then return empty
        previous = index.predecessor(block,i)
        if marked[previous] then iterate
        marked[previous] = 1; pending[pending[0] + 1] = previous
      end
    end
    cyclic = 0
    do i = 1 to index.successors(targetblock)
      if spend() = 0 then return empty
      block = index.successor(targetblock,i); if marked[block] then cyclic = 1
    end
    do while previoussize <> cells[0]
      previoussize = cells[0]
      do i = 1 to source.records()
        if spend() = 0 then return empty
        item = source.record(i)
        if item.procedureid() <> _function | item.kind() = 'procedure' then iterate
        instruction = profile.instruction(item.id())
        block = cfg.projectedblock(item.id())
        if block < 1 then do
          if instruction.actions() > 0 then do; ignored = fail('unknown','normalization.preservation.prefix.block.unproved'); return empty; end
          iterate
        end
        if marked[block] = 0 then iterate
        /* Missing value precision is harmless here; missing dependencies,
         * effects, observations, aliases or paths can hide a tainted input. */
        do f = 1 to 14
          if spend() = 0 then return empty
          family = word('references order effects components flags bindings observations ownership numeric signals control failure calls relocation',f)
          if instruction.complete(family) = 0 then do; ignored = fail('unknown','normalization.preservation.prefix.' || family || '.unproved'); return empty; end
        end
        last = instruction.actions(); if item.id() = operation & cyclic = 0 then last = ordinal - 1
        tainted = 0; restricted = 0
        do j = 1 to last
          if spend() = 0 then return empty
          action = instruction.action(j)
          if action.kind() = 'unknown' | ((action.kind() = 'external' | action.kind() = 'call' | action.kind() = 'return') & action.subject() = 0 & action.sourcekind() <> 'reference') then do; ignored = fail('unknown','normalization.preservation.prefix.hidden.effect.unproved'); return empty; end
          if action.kind() = 'callback' then iterate
          if wordpos(action.kind(),'read observe capture write clear transport derive flagwrite status') = 0 then restricted = 1
          if wordpos(action.kind(),'read observe capture write clear transport derive flagwrite status') = 0 & action.subject() > 0 then do
            hit = intersects(instruction,j,action.subject(),cells)
            if hit < 0 then return empty
            tainted = tainted | hit
          end
          if wordpos(action.kind(),'read observe capture external') > 0 then do
            hit = intersects(instruction,j,action.subject(),cells)
            if hit < 0 then return empty
            tainted = tainted | hit
          end
          if action.sourcekind() = 'reference' then do
            hit = intersects(instruction,j,action.sourceid(),cells)
            if hit < 0 then return empty
            tainted = tainted | hit
          end
          if tainted & wordpos(action.kind(),'write clear transport derive flagwrite status') > 0 then do
            if output(cells,instruction,j,action.subject()) = 0 then return empty
          end
        end
        if tainted then do
          /* An external/return/context action may precede its operand reads.
           * Remember restrictions for the entire instruction, not just suffix. */
          if restricted then do; ignored = fail('unknown','normalization.preservation.tainted.effect.unproved'); return empty; end
          normals = 0
          do e = 1 to cfg.outedges(item.id())
            if spend() = 0 then return empty
            edge = cfg.outedge(item.id(),e)
            if edge.asynchronous() then do; ignored = fail('unknown','normalization.preservation.tainted.asynchronous.unproved'); return empty; end
            if edge.role() <> 'normal' | edge.complete() = 0 | edge.phase() <> 'none' | edge.exposure() <> 'local' | edge.targetop() = 0 | edge.scopeexits() > 0 | edge.scopeenters() > 0 then do; ignored = fail('unknown','normalization.preservation.tainted.control.unproved'); return empty; end
            normals = normals + 1
          end
          if normals <> 1 then do; ignored = fail('unknown','normalization.preservation.tainted.control.unproved'); return empty; end
        end
      end
    end
    return cells
  run: method = .void
    if _status <> 'building' then return
    i = .int; j = .int; k = .int; d = .int; ignored = .int; edgeid = .int; affectedindex = .int
    item = .lltarget..record; action = .lltargettransfer..action; deltas = .int[]
    body = .lltarget..body; instruction = .lltargettransfer..instruction; edge = .lltargetcfg..edge
    do
      if _limit < 1 | _bytes < 1 then do; ignored = fail('limit','normalization.preservation.allowance'); return; end
      if <refvalid>(_sourceflow) = 0 | <refvalid>(_candidateflow) = 0 | <refvalid>(_summaries) = 0 | <refvalid>(_correspondence) = 0 then do; ignored = fail('invalid','normalization.preservation.owner.expired'); return; end
      sourceflow = dereference _sourceflow; candidateflow = dereference _candidateflow; summaries = dereference _summaries; mapping = dereference _correspondence
      if sourceflow.status() = 'limit' | candidateflow.status() = 'limit' | summaries.status() = 'limit' then do; ignored = fail('limit','normalization.preservation.analysis.allowance'); return; end
      if sourceflow.status() <> 'ok' | candidateflow.status() <> 'ok' | summaries.status() <> 'ok' then do; ignored = fail('invalid','normalization.preservation.analysis.unavailable'); return; end
      if mapping.status() <> 'proved' then do; ignored = fail(mapping.status(),mapping.reason()); return; end
      _sourceid = sourceflow.identity(); _candidateid = candidateflow.identity(); _summaryid = summaries.identity()
      if ownersvalid() = 0 then do; ignored = fail('invalid','normalization.preservation.owner.mismatch'); return; end
      source_ref = mapping.sourceowner(); candidate_ref = mapping.candidateowner(); source = dereference source_ref; candidate = dereference candidate_ref
      if _resultid <> 0 & candidate.identity() <> _resultid then do; ignored = fail('invalid','normalization.preservation.result.mismatch'); return; end
      found = 0
      do i = 1 to source.procedures()
        if spend() = 0 then return
        body = source.procedure(i)
        if body.functionid() = _function then do; found = 1; leave; end
      end
      if found = 0 then do; ignored = fail('invalid','normalization.preservation.function.invalid'); return; end
      before_ref = mapping.sourceprofile(); after_ref = mapping.candidateprofile(); before = dereference before_ref; after = dereference after_ref
      resultcfg_ref = mapping.candidatecfg(); resultcfg = dereference resultcfg_ref; sourcecfg_ref = mapping.sourcecfg(); sourcecfg = dereference sourcecfg_ref
      do i = 1 to mapping.insertions()
        if spend(candidate.procedures() + 1,32) = 0 then return
        item = candidate.at(mapping.insertion(i)); resultbody = candidate.body(item.procedureid())
        if resultbody.name() <> body.name() then iterate
        value = item.operand(1); deltas[deltas[0] + 1] = value.index(); instruction = after.instruction(item.id()); clears = 0
        do j = 1 to 14
          if spend() = 0 then return
          family = word('references order effects components flags bindings observations ownership numeric signals control failure calls relocation',j)
          if instruction.complete(family) = 0 then do; ignored = fail('unknown','normalization.preservation.inserted.' || family || '.unproved'); return; end
        end
        do j = 1 to instruction.actions()
          if spend() = 0 then return
          action = instruction.action(j)
          if action.kind() = 'clear' & action.domain() = 0 & action.certainty() = 'must' then do
            ref = after.ref(action.subject())
            if ref.bank() <> 'r' | ref.index() <> value.index() then do; ignored = fail('unknown','normalization.preservation.inserted.write.unproved'); return; end
            clears = clears + 1; iterate
          end
          if action.kind() = 'capture' then iterate
          if action.kind() <> 'callback' then do; ignored = fail('unknown','normalization.preservation.inserted.effect.unproved'); return; end
          do k = 0 to resultcfg.outedges(item.id())
            edgeid = 0
            if k > 0 then do; edge = resultcfg.outedge(item.id(),k); edgeid = edge.id(); end
            if spend(candidateflow.lookupcost() + 1) = 0 then return
            if candidateflow.callbackpossibleat(item.id(),j,edgeid) then do; ignored = fail('unknown','normalization.preservation.inserted.callback.unproved'); return; end
          end
        end
        if clears <> 1 then do; ignored = fail('unknown','normalization.preservation.inserted.clear.unproved'); return; end
      end
      do i = 1 to source.records()
        if spend() = 0 then return
        item = source.record(i)
        if item.procedureid() <> _function | item.kind() = 'procedure' then iterate
        instruction = before.instruction(item.id())
        do j = 1 to instruction.actions()
          if spend() = 0 then return
          action = instruction.action(j)
          if action.kind() <> 'callback' then iterate
          do k = 0 to sourcecfg.outedges(item.id())
            if spend(sourceflow.lookupcost() + candidateflow.lookupcost() + 1) = 0 then return
            edgeid = 0
            if k > 0 then do; edge = sourcecfg.outedge(item.id(),k); edgeid = edge.id(); end
            event = mapping.event(item.id(),j,edgeid)
            if event.status() <> 'proved' then do; ignored = fail(event.status(),event.reason()); return; end
            point = sourceflow.callbackat(item.id(),j,edgeid)
            if point.status() <> 'proved' then do; ignored = fail(point.status(),point.reason()); return; end
            candidatepoint = candidateflow.callbackat(event.candidateoperation(),event.candidateordinal(),event.candidateedge())
