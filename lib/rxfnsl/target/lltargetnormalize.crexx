/* cREXX License (MIT). Diagnosed dirty owned-local entry-state normalization. */
options levelb
namespace lltargetnormalize expose warning change normalize explicit
import rxfnsb
import llir
import lltarget
import lltargettransfer
import lltargetflow
import lltargetremap
import llrxascatalog

/** An owned warning snapshot, located at the first original observation.
 * The byte column follows the target's byte-offset source convention. */
warning: class
  _procedure = .string
  _local = .int
  _component = .string
  _operation = .int
  _origin = .llir..origin
  _filename = .string
  _first = .int
  _last = .int
  _line = .int
  _column = .int
  *: factory
    arg routineName = .string, ownedIndex = .int, component = .string, operation = .int, at = .llir..origin
    _procedure = routineName; _local = ownedIndex; _component = component; _operation = operation; _origin = at
    _filename = at.filename(); _first = at.first(); _last = at.last(); _line = 1; _column = 1
    source = at.sourcebytes()
    do i = 0 to _first - 1
      if <at..u8>(i) source = 10 then do; _line = _line + 1; _column = 1; end
      else _column = _column + 1
    end
    return
  code: method = .string
    return 'LL_RXAS_ENTRY_READ'
  procedure: method = .string
    return _procedure
  local: method = .int
    return _local
  component: method = .string
    return _component
  operation: method = .int
    return _operation
  origin: method = .llir..origin
    return _origin
  filename: method = .string
    return _filename
  first: method = .int
    return _first
  last: method = .int
    return _last
  line: method = .int
    return _line
  column: method = .int
    return _column
  message: method = .string
    return 'dirty owned local r' || _local || ' component ' || _component || ' may be observed before definition in ' || _procedure
  diagnostic: method = .string
    return _filename || ':' || _line || ':' || _column || ': ' || code() || ': ' || message()

/** Locals begin dirty; stale physical payloads are not semantic definitions.
 * Defined-but-unknown values and borrowed dirty arguments remain distinct.
 * Normalize only flow-proved dirty entry-dependent observations. A whole-cell NULL
 * deliberately defines the existing VM reset state and can release/finalize
 * recycled payloads. It is never inserted for an otherwise valid local.
 * Missing observation/origin/binding facts, unsafe alternate/async entry or a
 * failed stage retain the exact input. Policy correlation may remain unknown
 * when complete possible local paths support the independent may-read proof;
 * no signal, value or binding uncertainty is promoted to a known fact.
 * Warnings and output publish together after validation.
 * @param owner Exact checked source module.
 * @param flow Exact live point/edge proof owner for that module.
 * @param work Whole-request elementary work allowance.
 * @param bytes Whole-request logical retained bytes.
 */
change: class
  _owner = reference .lltarget..module
  _flow = reference .lltargetflow..analysis
  _status = .string
  _message = .string
  _worklimit = .int
  _bytelimit = .int
  _work = .int
  _bytes = .int
  _hasresult = .int
  _result = .lltarget..module
  _mapping = .int[]
  _warnings = .warning[]
  _complete = .int[]
  _unknownreason = .string[]
  _certificate = .int
  *: factory
    arg owner = reference .lltarget..module, flow = reference .lltargetflow..analysis, work = 1000000, bytes = 67108864
    _owner = owner; _flow = flow; _worklimit = work; _bytelimit = bytes; _status = 'building'
    return
  resolved: factory
    arg status = .string, message = .string, ?result = .lltarget..module, ?mapping = .int[], ?warnings = .lltargetnormalize..warning[], ?proof = .lltargetnormalize..change
    _status = status; _message = message; _hasresult = ?result
    if ?result then _result = result
    if ?mapping then _mapping = mapping
    if ?warnings then _warnings = warnings
    if ?proof & ?result then do
      if result.valid() then do
        original = proof.result(); body = .lltarget..body
        if original.identity() = result.identity() then do
          _certificate = result.identity()
          do i = 1 to result.procedures()
            body = result.procedure(i); fn = body.functionid()
            _complete[fn] = proof.complete(fn); _unknownreason[fn] = proof.unknownreason(fn)
          end
        end
      end
    end
    return
  fail: method = .void
    arg status = .string, message = .string
    _status = status; _message = message
    return
  spend: method = .int
    arg amount = .int
    if amount < 0 | amount > _worklimit - _work then do; call fail('limit','normalization.work.exhausted'); return 0; end
    _work = _work + amount; return 1
  reserve: method = .int
    arg amount = .int
    if amount < 0 | amount > _bytelimit - _bytes then do; call fail('limit','normalization.bytes.exhausted'); return 0; end
    _bytes = _bytes + amount; return 1
  run: method = .void
    if _status <> 'building' then return
    owner = _owner; flowref = _flow
    item = .lltarget..record; body = .lltarget..body
    witness = .lltargetflow..entryread; previous = .lltargetflow..entryread; selected = .lltargetflow..entryread[]
    staged = .warning[]; functions = .int[]; locals = .int[]; observations = .int[]; anchors = .int[]; stagedmap = .int[]; operands = .object[]
    operand = .lltarget..operand; remap = .lltargetremap..change; origin = .llir..origin
    profile_ref = reference .lltargettransfer..profile
    i = .int; j = .int; found = .int; fn = .int; ownedIndex = .int; next = .int; slot = .int
    a = .int; b = .int; value = .int; first = .int; mapped = .int; flowid = .int
    do
      source = .lltarget..module; proof = .lltargetflow..analysis
      if _worklimit < 1 | _bytelimit < 1 then do; call fail('limit','normalization.budgets.must.be.positive'); return; end
      if <refvalid>(owner) = 0 then do; call fail('invalid','normalization.owner.expired'); return; end
      source = dereference owner; _result = source; _hasresult = 1
      if source.valid() = 0 then do; call fail('invalid',source.error()); return; end
      if <refvalid>(flowref) = 0 then do; call fail('invalid','normalization.flow.expired'); return; end
      proof = dereference flowref
      if proof.status() <> 'ok' then do; call fail(proof.status(),proof.message()); return; end
      if proof.matches(owner) = 0 then do; call fail('invalid','normalization.flow.foreign'); return; end
      flowid = proof.identity()
      /* Certify owned-local normalization per procedure. An unrelated
       * incomplete body cannot veto normalization of a proved caller/site.
       * Flow still owns every observed domain and entry origin over the CFG's
       * conservative local paths; exact policy correlation is not this proof.
       * No owned locals means there is no owned entry cell to clear; borrowed
       * argument observations remain the caller-point proof's obligation. */
      do i = 1 to source.procedures()
        if spend(1) = 0 then return
        body = source.procedure(i); fn = body.functionid()
        _complete[fn] = body.locals() = 0 | proof.complete(fn,'entry-normalization')
        if _complete[fn] = 0 then _unknownreason[fn] = proof.unknownreason(fn,'entry-normalization')
        else _unknownreason[fn] = ''
      end
      _certificate = source.identity()
      do i = 1 to proof.entryobservations()
        if spend(1) = 0 then return
        witness = proof.entryobservation(i)
        if witness.valid() = 0 then do; call fail('invalid','normalization.witness.expired'); return; end
        fn = witness.function(); ownedIndex = witness.ownedindex(); body = source.body(fn); item = source.at(witness.operation())
        if _complete[fn] = 0 then iterate
        if witness.bank() <> 'r' | ownedIndex < 0 | ownedIndex >= body.locals() | item.procedureid() <> fn then do
          call fail('invalid','normalization.witness.not.owned.base'); return
        end
        found = 0
        do j = 1 to selected[0]
          if spend(1) = 0 then return
          previous = selected[j]
          if previous.function() = fn & previous.ownedindex() = ownedIndex & previous.domainkey() = witness.domainkey() then do; found = j; leave; end
        end
        if found > 0 then do
          previous = selected[found]
          if witness.operation() < previous.operation() then selected[found] = witness
        end
        else do
          if reserve(160) = 0 then return
          selected[selected[0] + 1] = witness
        end
      end
      if selected[0] = 0 then do; call fail('keep','normalization.no.entry.read'); return; end
      /* One prelude clear per owned base; first observation supplies origin. */
      do i = 1 to selected[0]
        witness = selected[i]; fn = witness.function(); ownedIndex = witness.ownedindex(); found = 0
        do j = 1 to functions[0]
          if spend(1) = 0 then return
          if functions[j] = fn & locals[j] = ownedIndex then do; found = j; leave; end
        end
        if found = 0 then do
          if reserve(32) = 0 then return
          next = functions[0] + 1; functions[next] = fn; locals[next] = ownedIndex; observations[next] = witness.operation()
        end
        else if witness.operation() < observations[found] then observations[found] = witness.operation()
      end
      /* Stable procedure/local order also fixes multiple insertions at anchor. */
      do a = 2 to functions[0]
        b = a
        do while b > 1
          if spend(1) = 0 then return
          if functions[b - 1] < functions[b] then leave
          if functions[b - 1] = functions[b] & locals[b - 1] <= locals[b] then leave
          value = functions[b - 1]; functions[b - 1] = functions[b]; functions[b] = value
          value = locals[b - 1]; locals[b - 1] = locals[b]; locals[b] = value
          value = observations[b - 1]; observations[b - 1] = observations[b]; observations[b] = value
          b = b - 1
        end
      end
      graphref = source.ir(); graph = dereference graphref; storeref = graph.storage(); store = dereference storeref
      do i = 1 to selected[0]
        witness = selected[i]; origin = witness.origin(); bits = origin.filename() as .binary; key = witness.domainkey() as .binary
        if reserve(160 + <blen>(bits) + <blen>(key)) = 0 then return
        if spend(origin.first() + 1) = 0 then return
      end
      do i = 1 to functions[0]
        body = source.body(functions[i])
        if body.records() < 1 then do; call fail('invalid','normalization.missing.entry.record'); return; end
        item = body.record(1); anchors[i] = item.id(); slot = 0
        do j = 1 to store.count(5)
          if spend(1) = 0 then return
          if store.get(5,j,1) = functions[i] & store.text(store.get(5,j,3)) = ('r' || locals[i]) then do; slot = j; leave; end
        end
        if slot = 0 then do; call fail('invalid','normalization.owned.slot.missing'); return; end
        operand = .lltarget..operand.bound(store.identity(),functions[i],slot,'r',locals[i])
        operands[i] = operand as .object
      end
      if reserve(graph.operations() * 8) = 0 then return
      if spend(source.records()) = 0 then return
      profile_ref = proof.operationalprofile()
      remap = .lltargetremap..change(owner,_worklimit - _work,_bytelimit - _bytes)
      ignored = remap.useprofile(profile_ref)
      do i = 1 to functions[0]
        operand = operands[i] as .lltarget..operand
        ignored = remap.insertnullbefore(anchors[i],operand,observations[i])
      end
      call remap.run()
      if remap.status() <> 'changed' then do; call fail(remap.status(),remap.message()); return; end
      if proof.matches(owner) = 0 | proof.identity() <> flowid then do; call fail('invalid','normalization.proof.changed'); return; end
      candidate = remap.result()
      do i = 1 to selected[0]
        witness = selected[i]; body = source.body(witness.function()); mapped = remap.operation(witness.operation()); item = candidate.at(mapped)
        staged[i] = .warning(body.name(),witness.ownedindex(),witness.domainkey(),mapped,item.origin())
      end
      do i = 1 to source.records(); item = source.record(i); stagedmap[item.id()] = remap.operation(item.id()); end
      _result = candidate; _mapping = stagedmap; _warnings = staged; _status = 'changed'; _message = 'normalization.entry.reads.cleared'
      /* Function identities are allocated independently of inserted records.
       * Resolve by source name when publishing rather than assuming that. */
      certified = .int[]; reasons = .string[]
      do i = 1 to source.procedures()
        body = source.procedure(i); fn = candidate.procedureid(body.name())
        if fn = 0 then do; call fail('invalid','normalization.procedure.mapping'); return; end
        certified[fn] = _complete[body.functionid()]; reasons[fn] = _unknownreason[body.functionid()]
      end
      _complete = certified; _unknownreason = reasons; _certificate = candidate.identity()
    on signal as problem
      call fail('invalid','normalization.failed: ' || problem.name() || ': ' || problem.message())
    end
    return
  status: method = .string
    call run(); return _status
  message: method = .string
    call run(); return _message
  reason: method = .string
    return message()
  result: method = .lltarget..module
    call run()
    if _hasresult = 0 then assembler signal "ERROR","LL_TARGET_NORMALIZE: input owner expired"
    return _result
  complete: method = .int
    arg functionid = .int
    call run()
    if _hasresult = 0 | wordpos(_status,'changed keep') = 0 then return 0
    if _result.valid() = 0 | _certificate <> _result.identity() then return 0
    if functionid < 2 | functionid > _complete[0] then return 0
    return _complete[functionid]
  unknownreason: method = .string
    arg functionid = .int
    if complete(functionid) then return ''
    if _hasresult = 0 | _result.valid() = 0 | _certificate <> _result.identity() then return 'normalization.certificate.unavailable'
    if functionid < 2 | functionid > _unknownreason[0] then return 'normalization.procedure.unproved'
    if _unknownreason[functionid] = '' then return 'normalization.procedure.unproved'
    return _unknownreason[functionid]
  operation: method = .int
    arg old = .int
    call run()
    if _status <> 'changed' then return old
    return _mapping[old]
  warnings: method = .int
    call run(); return _warnings[0]
  warning: method = .lltargetnormalize..warning
    arg ordinal = .int
    call run()
    if ordinal < 1 | ordinal > _warnings[0] then assembler signal "ERROR","LL_TARGET_NORMALIZE: warning ordinal"
    return _warnings[ordinal]

normalize: procedure = .lltargetnormalize..change
  arg owner = reference .lltarget..module, flow = reference .lltargetflow..analysis, work = 1000000, bytes = 67108864
  return .change(owner,flow,work,bytes)

/** Canonical explicit counterparts are part of the native opcode contract.
 * Decode packed indices against the original layout before any caller grows;
 * no inliner or cleanup client needs its own implicit-opcode cases. */
explicit: procedure = .lltargetnormalize..change
  arg owner = reference .lltarget..module, work = 1000000, bytes = 67108864
  item = .lltarget..record; body = .lltarget..body; target = .lltarget..bodydraft
  value = .lltarget..operand; fields = .object[]; replacements = .object[]
  bodies = .object[]; origins = .object[]; sources = .object[]; mapping = .int[]; empty = .int[]
  i = .int; j = .int; found = .int; packed = .int; variant = .int
  if <refvalid>(owner) = 0 then return .change.resolved('invalid','normalization.owner.expired')
  source = dereference owner
  if source.valid() = 0 then return .change.resolved('invalid',source.error(),source)
  if work < 1 | bytes < 1 then return .change.resolved('limit','normalization.budgets.must.be.positive',source)
  catalog = .llrxascatalog..catalog()
  do i = 1 to source.records()
    work = work - 1
    if work < 1 then return .change.resolved('limit','normalization.explicit.work',source)
    item = source.record(i)
    if item.kind() = 'instruction' & catalog.explicitvariant(item.opcode()) >= 0 then found = 1
  end
  if found = 0 then return .change.resolved('keep','normalization.no.implicit.operand',source)
  do
    draft = .lltarget..draft(source.name(),source.artifact(),source.globals(),1000000,bytes,work); graph_ref = source.ir()
    do i = 1 to source.records()
      item = source.record(i)
      if draft.preflight(1 + item.operands(),0) = 0 then return .change.resolved('limit',draft.error(),source)
      at = lltargetremap..copyorigin(graph_ref,item.origin(),reference draft,reference sources,reference origins)
      if item.kind() = 'procedure' then do
        body = source.body(item.procedureid()); target = draft.procedure(body.name(),body.locals(),at,body.expose())
        bodies[item.procedureid()] = target as .object; mapping[item.id()] = target.headerid(); iterate
      end
      if item.procedureid() = 0 then do
        call objectarraydrop fields
        do j = 1 to item.operands(); fields[j] = item.operand(j) as .object; end
        mapping[item.id()] = draft.record(item.kind(),fields,at); iterate
      end
      target = bodies[item.procedureid()] as .lltarget..bodydraft; body = source.body(item.procedureid()); variant = -1
      if item.kind() = 'instruction' then variant = catalog.explicitvariant(item.opcode())
      call objectarraydrop fields
      if variant >= 0 then do
        selectors = translate(catalog.implicitrecipe(item.opcode()),' ', ';')
        do j = 1 to words(selectors)
          selector = translate(word(selectors,j),' ', ':'); packed = word(selector,2) as .int
          if word(selector,1) = 'localindex' then do; value = item.operand(packed); packed = value.index(); end
          if packed < 0 then return .change.resolved('invalid','normalization.packed.index.negative',source)
          bank = 'r'; index = packed
          if packed >= body.locals() + source.globals() then do; bank = 'a'; index = packed - body.locals() - source.globals(); end
          else if packed >= body.locals() then do; bank = 'g'; index = packed - body.locals(); end
          fields[fields[0] + 1] = target.reg(bank,index) as .object
        end
        do j = 1 to item.operands()
          value = item.operand(j)
          if value.kind() = 'R' then fields[fields[0] + 1] = target.reg(value.bank(),value.index()) as .object
        end
        mapping[item.id()] = target.emit(catalog.mnemonic(variant),fields,at)
      end
      else do
        call objectarraydrop replacements
        do j = 1 to item.registerrefs()
          value = item.registerref(j); replacements[j] = target.reg(value.bank(),value.index()) as .object
        end
        fields = lltarget..remapregisters(item,replacements)
        if item.kind() = 'instruction' then mapping[item.id()] = target.emit(item.mnemonic(),fields,at)
        else mapping[item.id()] = target.record(item.kind(),fields,at)
      end
    end
    if draft.error() <> '' then return .change.resolved('invalid',draft.error(),source)
    result = draft.finish()
    if result.valid() = 0 then return .change.resolved('invalid',result.error(),source)
    return .change.resolved('changed','normalization.explicit.operands',result,mapping)
  on signal as problem
    status = 'invalid'
    if pos('LL_RESOURCE_LIMIT',problem.message()) > 0 then status = 'limit'
    return .change.resolved(status,'normalization.explicit.failed: ' || problem.name() || ': ' || problem.message(),source)
  end
  return .change.resolved('invalid','normalization.explicit.no.result',source)
