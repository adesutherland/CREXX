/* cREXX License (MIT). Typed target remapping and atomic insertion. */
options levelb
namespace lltargetremap expose mapping recordchange change copyorigin modulemap modulebinding globalref mappedrecord correspondence eventmap expansioninstance expansioncorrespondence expansionlimits identityreceipt
import rxfnsb
import llir
import lltarget
import lltargettransfer
import lltargetcfg
import llrxascatalog

boot: initialiser expose correspondence_serial
  correspondence_serial = 0
  return
nextcorrespondence: procedure = .int expose correspondence_serial
  if correspondence_serial = 9223372036854775807 then assembler signal "ERROR","LL_TARGET_REMAP: correspondence identities exhausted"
  correspondence_serial = correspondence_serial + 1
  return correspondence_serial

/** The structural checker has no flow/ABI solver. Reserve its own envelope
 * from frozen source sizes and checked emission bounds, rather than another
 * complete semantic/diagnostic theorem quota. The checker still enforces its
 * own counters; these bounds grant no correspondence or publication fact. */
expansionlimits: class
  _owner = reference .lltarget..module
  _identity = .int
  _candidates = .int
  _instances = .int
  _slots = .int
  _rows = .int
  _identities = .int
  _worklimit = .int
  _bytelimit = .int
  _work = .int
  _bytes = .int
  _scan = .int
  _prepared = .int
  _status = .string
  _reason = .string
  *: factory
    arg owner = reference .lltarget..module, candidates = .int, instances = .int, slots = .int, rows = .int, identities = .int, work = .int, bytes = .int
    _owner = owner; _candidates = candidates; _instances = instances; _slots = slots; _rows = rows; _identities = identities
    _worklimit = work; _bytelimit = bytes; _status = 'pending'
    return
  fail: method = .int
    arg reason = .string
    _status = 'limit'; _reason = reason; return 0
  addwork: method = .int
    arg left = .int, right = 1
    if left < 0 | right < 0 then return fail('expansion.envelope.work')
    if right > 0 then do; if left > (_worklimit - _scan - _work) <idiv> right then return fail('expansion.envelope.work'); end
    _work = _work + left * right; return 1
  addbytes: method = .int
    arg left = .int, right = 1
    if left < 0 | right < 0 then return fail('expansion.envelope.bytes')
    if right > 0 then do; if left > (_bytelimit - 256 - _bytes) <idiv> right then return fail('expansion.envelope.bytes'); end
    _bytes = _bytes + left * right; return 1
  scan: method = .int
    arg amount = .int
    if amount < 0 | amount > _worklimit - _scan then return fail('expansion.envelope.scan')
    _scan = _scan + amount; return 1
  prepare: method = .void
    ignored = .int; i = .int; j = .int; signature = .int; operandbytes = .int; originbytes = .int; maxfile = .int; maxline = .int; maxstep = .int
    if _prepared then return
    _prepared = 1; _status = 'proved'
    if <refvalid>(_owner) = 0 then do; _status = 'invalid'; _reason = 'expansion.envelope.owner.expired'; return; end
    source = dereference _owner
    if source.valid() = 0 then do; _status = 'invalid'; _reason = 'expansion.envelope.owner.invalid'; return; end
    _identity = source.identity(); graphref = source.ir(); graph = dereference graphref
    n = source.records(); c = _candidates; instances = _instances; slots = _slots; rows = _rows; ids = _identities
    if min(n,c,instances,slots,rows,ids,_worklimit,_bytelimit) < 0 | max(n,c,instances,slots,rows,ids,_worklimit,_bytelimit) > (9223372036854775807 <idiv> 64) - 256 then do; ignored = fail('expansion.envelope.extent'); return; end
    do i = 1 to n
      item = source.record(i); at = item.origin(); bytes = at.sourcebytes(); cost = length(at.filename()) + <blen>(bytes) + 1
      if scan(cost + 1) = 0 then return
      originbytes = max(originbytes,cost); signature = 0
      do j = 1 to item.operands()
        value = item.operand(j)
        if scan(value.length() + 1) = 0 then return
        operandbytes = operandbytes + value.length() + 1
        if value.kind() = 'I' then signature = signature + 24
        else signature = signature + value.length() * 2 + 4
      end
      if item.kind() = '.srcfile' then maxfile = max(maxfile,signature)
      else if item.kind() = '.srcline' then maxline = max(maxline,signature)
      else if item.kind() = '.srcstep' then maxstep = max(maxstep,signature)
    end
    active = maxfile + maxline + maxstep + 2
    if max(active,operandbytes,originbytes) > (9223372036854775807 <idiv> 64) - 256 then do; ignored = fail('expansion.envelope.payload'); return; end
    /* Sparse table scans; bounded slot/identity alias checks; record cuts;
     * exact provenance/operand comparisons; active source signatures. */
    if addwork(n + c + rows + instances + 1,32) = 0 then return
    if addwork(slots + 1,(slots + 1) * 8) = 0 | addwork(ids + 1,(ids + 1) * 8) = 0 then return
    if addwork(instances + 1,(instances + 1) * 4) = 0 | addwork(instances,n * 8 + 8) = 0 then return
    if addwork(n + rows + 1,originbytes * 8 + 64) = 0 then return
    if addwork(instances + 1,operandbytes * 8 + 64) = 0 then return
    if addwork(n + c + 1,(active + 16) * 4) = 0 then return
    if addbytes(graph.operations() + c + 1,64) = 0 then return
    if addbytes(instances,graph.operations() * 16 + 256) = 0 then return
    if addbytes(slots,512) = 0 | addbytes(rows + ids + instances + 1,128) = 0 then return
    if addbytes(n + c + 1,active + 64) = 0 then return
    return
  status: method = .string
    call prepare()
    if <refvalid>(_owner) = 0 then return 'invalid'
    source = dereference _owner
    if source.valid() = 0 | (_identity > 0 & source.identity() <> _identity) then return 'invalid'
    return _status
  reason: method = .string
    if status() = 'invalid' then return 'expansion.envelope.owner.expired.or.replaced'
    return _reason
  work: method = .int
    call prepare(); return _work
  bytes: method = .int
    call prepare(); return _bytes
  usedwork: method = .int
    call prepare(); return _scan
  usedbytes: method = .int
    return 256

/** One immutable-after-sealing clone manifest. Entries are locators, never
 * semantic authority: the correspondence and final proof read both models. */
expansioninstance: class
  _call = .int
  _provider = reference .lltarget..module
  _providerid = .int
  _procedure = .int
  _frame = .int
  _sources = .int[]
  _candidates = .int[]
  _counts = .int[]
  _continuation = .string
  _originals = .lltarget..operand[]
  _replacements = .lltarget..operand[]
  _roles = .string[]
  _bases = .lltarget..operand[]
  _rrows = .int[]
  _arows = .int[]
  _grows = .int[]
  _additions = .lltarget..operand[]
  _additionroles = .string[]
  _recordsource = .int[]
  _recordcandidate = .int[]
  _namespace = .string
  _steps = .int[]
  _clauses = .int[]
  _frames = .int[]
  _sealed = .int
  _error = .string
  _work = .int
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  *: factory
    arg callid = .int, provider = reference .lltarget..module, procedureid = .int, frameid = .int, sourceops = .int[], candidateops = .int[], counts = .int[], continuationLabel = .string, work = 1000000, bytes = 67108864
    _worklimit = work; _bytelimit = bytes
    if sourceops[0] > work <idiv> 3 | sourceops[0] > bytes <idiv> 24 then do; _error = 'LL_RESOURCE_LIMIT: expansion.manifest.rows'; return; end
    /* A factory has no source-level self receiver. Charge its initial rows
     * directly; later mutations use the same reserve method. */
    _work = sourceops[0] * 3 + 1; _bytes = sourceops[0] * 24
    if _work > work | length(continuationLabel) > bytes - _bytes - 128 then do; _error = 'LL_RESOURCE_LIMIT: expansion.manifest.rows'; return; end
    _bytes = _bytes + length(continuationLabel) + 128
    _call = callid; _provider = provider; _procedure = procedureid; _frame = frameid
    _sources = sourceops; _candidates = candidateops; _counts = counts; _continuation = continuationLabel
    if <refvalid>(provider) = 0 then do; _error = 'expansion.instance.provider.expired'; return; end
    source = dereference provider
    if initialized(source) = 0 then do; _error = 'expansion.instance.provider.uninitialized'; return; end
    if source.valid() = 0 then do; _error = 'expansion.instance.provider.invalid'; return; end
    _providerid = source.identity()
    return
  reject: method = .int
    arg reason = .string
    if _error = '' then _error = reason
    return 0
  reserve: method = .int
    arg work = .int, bytes = .int
    if work < 0 | bytes < 0 | work > _worklimit - _work | bytes > _bytelimit - _bytes then return reject('LL_RESOURCE_LIMIT: expansion.manifest')
    _work = _work + work; _bytes = _bytes + bytes
    return 1
  mappingid: method = .int
    arg original = .lltarget..operand
    if original.kind() <> 'R' | original.index() < 0 then return 0
    if original.index() >= _bytelimit <idiv> 8 then return 0
    index = original.index() + 1
    select original.bank()
      when 'r' then do; if index > _rrows[0] then return 0; return _rrows[index]; end
      when 'a' then do; if index > _arows[0] then return 0; return _arows[index]; end
      when 'g' then do; if index > _grows[0] then return 0; return _grows[index]; end
      otherwise do; return 0; end
    end
    return 0
  bind: method = .int
    arg original = .lltarget..operand, replacement = .lltarget..operand, role = .string
    if _sealed then return 0
    if original.kind() <> 'R' | replacement.kind() <> 'R' | original.index() < 0 | replacement.index() < 0 then return reject('expansion.mapping.register.invalid')
    if wordpos(role,'private argument proxy global count') = 0 then return reject('expansion.mapping.role.invalid')
    row = mappingid(original)
    if row > 0 then do
      prior = _replacements[row]
      if prior.bank() <> replacement.bank() | prior.index() <> replacement.index() | _roles[row] <> role then return reject('expansion.mapping.duplicate')
      return 1
    end
    if original.index() >= _bytelimit <idiv> 8 then return reject('LL_RESOURCE_LIMIT: expansion.mapping.index')
    growth = original.index() + 1
    select original.bank()
      when 'r' then growth = max(0,growth - _rrows[0])
      when 'a' then growth = max(0,growth - _arows[0])
      when 'g' then growth = max(0,growth - _grows[0])
      otherwise do; return reject('expansion.mapping.bank.invalid'); end
    end
    if reserve(growth + 1,growth * 8 + 256 + length(role)) = 0 then return 0
    row = _originals[0] + 1; _originals[row] = original; _replacements[row] = replacement; _roles[row] = role
    /* Typed object-array holes are unconstructed values, not operand().
     * Every map row needs a constructed empty base before optional binding. */
    _bases[row] = .lltarget..operand()
    index = original.index() + 1
    select original.bank()
      when 'r' then _rrows[index] = row
      when 'a' then _arows[index] = row
      when 'g' then _grows[index] = row
      otherwise do; return reject('expansion.mapping.bank.invalid'); end
    end
    return 1
  added: method = .int
    arg candidate = .lltarget..operand, role = .string
    if _sealed then return 0
    if candidate.kind() <> 'R' | candidate.bank() <> 'r' | candidate.index() < 0 then return reject('expansion.addition.register.invalid')
    if wordpos(role,'save return-temp base-proxy window result-temp binding-temp') = 0 then return reject('expansion.addition.role.invalid')
    if reserve(_additions[0] + 1,128 + length(role)) = 0 then return 0
    do i = 1 to _additions[0]
      prior = _additions[i]
      if prior.index() = candidate.index() then do
        if _additionroles[i] = role then return 1
        return reject('expansion.addition.duplicate')
      end
    end
    row = _additions[0] + 1; _additions[row] = candidate; _additionroles[row] = role
    return 1
  bindbase: method = .int
    arg original = .lltarget..operand, replacement = .lltarget..operand
    if _sealed then return 0
    row = mappingid(original)
    if row = 0 | replacement.kind() <> 'R' then return reject('expansion.mapping.base.invalid')
    if row <= _bases[0] then do
      prior = _bases[row]
      if prior.kind() = 'R' then do
        if prior.bank() = replacement.bank() & prior.index() = replacement.index() then return 1
        return reject('expansion.mapping.base.duplicate')
      end
    end
    if reserve(1,64) = 0 then return 0
    _bases[row] = replacement
    return 1
  bindrecord: method = .int
    arg original = .int, replacement = .int
    if _sealed then return 0
    if original < 0 | replacement < 1 then return reject('expansion.record.locator.invalid')
    if reserve(1,16) = 0 then return 0
    row = _recordsource[0] + 1; _recordsource[row] = original; _recordcandidate[row] = replacement
    return 1
  metadata: method = .int
    arg scope = .string, steps = .int[], clauses = .int[], frames = .int[]
    if _sealed then return 0
    if steps[0] > _worklimit | clauses[0] > _worklimit - steps[0] | frames[0] > _worklimit - steps[0] - clauses[0] then return reject('LL_RESOURCE_LIMIT: expansion.metadata.maps')
    if steps[0] > _bytelimit <idiv> 8 | clauses[0] > _bytelimit <idiv> 8 - steps[0] | frames[0] > _bytelimit <idiv> 8 - steps[0] - clauses[0] then return reject('LL_RESOURCE_LIMIT: expansion.metadata.maps')
    if reserve(steps[0] + clauses[0] + frames[0] + 1,(steps[0] + clauses[0] + frames[0]) * 8 + length(scope)) = 0 then return 0
    _namespace = scope; _steps = steps; _clauses = clauses; _frames = frames
    return 1
  records: method = .int
    return _recordsource[0]
  recordsource: method = .int
    arg ordinal = .int
    return _recordsource[ordinal]
  recordcandidate: method = .int
    arg ordinal = .int
    return _recordcandidate[ordinal]
  metascope: method = .string
    return _namespace
  identitymap: method = .int[]
    arg kind = .string
    empty = .int[]
    select kind
      when 'step' then return _steps
      when 'clause' then return _clauses
      when 'frame' then return _frames
      otherwise do; return empty; end
    end
    return empty
  base: method = .lltarget..operand
    arg original = .lltarget..operand
    row = mappingid(original)
    if row = 0 | row > _bases[0] then return .lltarget..operand()
    return _bases[row]
  seal: method = .int
    _sealed = 1
    return valid()
  valid: method = .int
    if _error <> '' | <refvalid>(_provider) = 0 | _providerid = 0 then return 0
    source = dereference _provider
    if initialized(source) = 0 then return 0
    return source.valid() & source.identity() = _providerid & _procedure >= 2 & _call > 0 & _frame > 0 & _sources[0] = _candidates[0] & _sources[0] = _counts[0] & _continuation <> ''
  reason: method = .string
    if _error <> '' then return _error
    if valid() = 0 then return 'expansion.instance.owner.or.shape.invalid'
    return ''
  callid: method = .int
    return _call
  provider: method = reference .lltarget..module
    return _provider
  procedure: method = .int
    return _procedure
  frame: method = .int
    return _frame
  rows: method = .int
    return _sources[0]
  source: method = .int
    arg ordinal = .int
    return _sources[ordinal]
  candidate: method = .int
    arg ordinal = .int
    return _candidates[ordinal]
  count: method = .int
    arg ordinal = .int
    return _counts[ordinal]
  continuation: method = .string
    return _continuation
  mappings: method = .int
    return _originals[0]
  original: method = .lltarget..operand
    arg ordinal = .int
    return _originals[ordinal]
  replacement: method = .lltarget..operand
    arg ordinal = .int
    return _replacements[ordinal]
  mappingrole: method = .string
    arg ordinal = .int
    return _roles[ordinal]
  mapped: method = .lltarget..operand
    arg original = .lltarget..operand
    row = mappingid(original)
    if row = 0 then return .lltarget..operand()
    return _replacements[row]
  additions: method = .int
    return _additions[0]
  addition: method = .lltarget..operand
    arg ordinal = .int
    return _additions[ordinal]
  additionrole: method = .string
    arg ordinal = .int
    return _additionroles[ordinal]
  usedwork: method = .int
    return _work
  usedbytes: method = .int
    return _bytes

/** Checked structural source-to-final-clone correspondence. CALL/RET and
 * generated row semantics remain obligations of the relational proof owner. */
expansioncorrespondence: class
  _identity = .int
  _source = reference .lltarget..module
  _candidate = reference .lltarget..module
  _sourceid = .int
  _candidateid = .int
  _catalog = .string
  _operations = .int[]
  _instances = .expansioninstance[]
  _calls = .int[]
  _covered = .int[]
  _instanceowners = .int[]
  _next = .int[]
  _starts = .int[]
  _ends = .int[]
  _functions = .int[]
  _matched = .int[]
  _sourcesteps = .string[]
  _candidatesteps = .string[]
  _occupiedfunctions = .int[]
  _occupiedslots = .int[]
  _phase = .string
  _checking = .int
  _status = .string
  _reason = .string
  _work = .int
  _bytes = .int
  _limit = .int
  _bytelimit = .int
  *: factory
    arg source = reference .lltarget..module, candidate = reference .lltarget..module, callerOperations = .int[], instances = .object[], work = 1000000, bytes = 67108864
    _identity = nextcorrespondence()
    _source = source; _candidate = candidate; _operations = callerOperations
    _limit = work; _bytelimit = bytes; _status = 'building'; _phase = 'setup'
    if instances[0] > work | instances[0] > bytes <idiv> 32 then do; _status = 'limit'; _reason = 'expansion.instance.table.allowance'; return; end
    do i = 1 to instances[0]
      if instances[i] is .expansioninstance then _instances[i] = instances[i] as .expansioninstance
      else do; _status = 'invalid'; _reason = 'expansion.instance.type.invalid'; return; end
    end
    return
  fail: method = .int
    arg state = .string, reason = .string
    if _status = 'building' then do; _status = state; _reason = reason; end
    return 0
  spend: method = .int
    arg work = 1, bytes = 0
    if work < 0 | bytes < 0 then return fail('limit','expansion.correspondence.charge.invalid')
    if work > _limit - _work then return fail('limit','expansion.correspondence.work [phase=' || _phase || ';instance=' || _checking || ';used=' || _work || ';attempt=' || work || ';cap=' || _limit || ';bytes=' || _bytes || ':' || _bytelimit || ']')
    if bytes > _bytelimit - _bytes then return fail('limit','expansion.correspondence.bytes [phase=' || _phase || ';instance=' || _checking || ';used=' || _bytes || ';attempt=' || bytes || ';cap=' || _bytelimit || ';work=' || _work || ':' || _limit || ']')
    _work = _work + work; _bytes = _bytes + bytes; return 1
  sameoperand: method = .int
    arg left = .lltarget..operand, right = .lltarget..operand
    if left.kind() <> right.kind() then return 0
    if left.kind() = 'R' then return left.bank() = right.bank() & left.index() = right.index()
    if left.kind() = 'I' then return left.index() = right.index()
    if spend(left.length() + right.length() + 1) = 0 then return 0
    return bin2x(left.bytes()) == bin2x(right.bytes())
  sameorigin: method = .int
    arg left = .llir..origin, right = .llir..origin
    a = left.sourcebytes(); b = right.sourcebytes()
    if spend(length(left.filename()) + length(right.filename()) + <blen>(a) + <blen>(b) + 1) = 0 then return 0
    return (left.filename() == right.filename()) & left.first() = right.first() & left.last() = right.last() & (bin2x(a) == bin2x(b))
  steps: method = .int
    arg owner = .lltarget..module, candidate = .int
    value = .lltarget..operand; i = .int; j = .int
    active = '||'; legacyfile = ''; legacyline = ''; step = ''; functionid = 0
    do i = 1 to owner.records()
      if spend(1) = 0 then return 0
      item = owner.record(i)
      if item.procedureid() <> functionid then do
        functionid = item.procedureid(); active = '||'; legacyfile = ''; legacyline = ''; step = ''
      end
      if item.kind() = '.srcfile' | item.kind() = '.srcline' | item.kind() = '.srcstep' then do
        signature = ''; unavailable = 1
        do j = 1 to item.operands()
          value = item.operand(j)
          if spend(value.length() + 1) = 0 then return 0
          if item.kind() = '.srcstep' & j = 1 then iterate
          if value.kind() = 'I' then do
            signature = signature || 'I:' || value.index() || ';'
            if value.index() <> 0 then unavailable = 0
          end
          else do
            signature = signature || value.kind() || ':' || bin2x(value.bytes()) || ';'
            if value.length() <> 0 then unavailable = 0
          end
        end
        if item.kind() = '.srcfile' then legacyfile = signature
        else if item.kind() = '.srcline' then legacyline = signature
        else do
          value = item.operand(1); step = signature
          if value.index() = 0 then do
            if unavailable = 0 then return fail('unknown','expansion.source.unavailable.payload')
            step = ''
          end
        end
        active = legacyfile || '|' || legacyline || '|' || step
      end
      if item.kind() = 'instruction' then do
        if spend(length(active) + 1,length(active)) = 0 then return 0
        if candidate then _candidatesteps[item.id()] = active
        else _sourcesteps[item.id()] = active
      end
    end
    return 1
  samerecord: method = .int
    arg left = .lltarget..record, right = .lltarget..record
    if left.kind() <> right.kind() | left.operands() <> right.operands() then return 0
    if left.kind() = 'instruction' then do
      if left.opcode() <> right.opcode() then return 0
      if (_sourcesteps[left.id()] == _candidatesteps[right.id()]) = 0 then return 0
    end
    if sameorigin(left.origin(),right.origin()) = 0 then return 0
    do j = 1 to left.operands()
      if spend(1) = 0 | sameoperand(left.operand(j),right.operand(j)) = 0 then return 0
    end
    return 1
  diagnostics: method = .int
    arg item = .lltarget..record
    return wordpos(item.kind(),'.srcfile .srcline .srcstep .inlineframe .inlinemap') > 0
  claimslot: method = .int
    arg functionid = .int, slot = .int
    do i = 1 to _occupiedslots[0]
      if spend(1) = 0 then return 0
      if _occupiedfunctions[i] = functionid & _occupiedslots[i] = slot then return fail('invalid','expansion.mapping.fresh.slot.alias')
    end
    if spend(1,16) = 0 then return 0
    row = _occupiedslots[0] + 1; _occupiedfunctions[row] = functionid; _occupiedslots[row] = slot
    return 1
  slotshape: method = .int
    arg instance = .expansioninstance, provider = .lltarget..module, body = .lltarget..body, caller = .lltarget..body, receiver = .lltarget..body, candidate = .lltarget..module
    i = .int; j = .int; found = .int; role = .string; original = .lltarget..operand; replacement = .lltarget..operand; base = .lltarget..operand; addition = .lltarget..operand; baseseen = .int[]
    if instance.additions() > (_bytelimit - _bytes) <idiv> 8 then return fail('limit','expansion.addition.table.allowance')
    if spend(instance.additions(),instance.additions() * 8) = 0 then return 0
    do i = 1 to instance.additions(); baseseen[i] = 0; end
    do i = 1 to instance.mappings()
      if spend(1) = 0 then return 0
      original = instance.original(i); replacement = instance.replacement(i); role = instance.mappingrole(i)
      if original.kind() <> 'R' | replacement.kind() <> 'R' | original.owner() <> provider.identity() | original.procedureid() <> body.functionid() | replacement.owner() <> candidate.identity() | replacement.procedureid() <> receiver.functionid() then return fail('invalid','expansion.mapping.owner.mismatch')
      select
        when role = 'private' then do; if original.bank() <> 'r' | original.index() < 0 | original.index() >= body.locals() then return fail('invalid','expansion.mapping.role.source'); end
        when role = 'count' then do; if original.bank() <> 'a' | original.index() <> 0 then return fail('invalid','expansion.mapping.role.source'); end
        when role = 'proxy' | role = 'argument' then do; if original.bank() <> 'a' | original.index() < 1 then return fail('invalid','expansion.mapping.role.source'); end
        when role = 'global' then do; if original.bank() <> 'g' | original.index() < 0 | original.index() >= provider.globals() then return fail('invalid','expansion.mapping.role.source'); end
        otherwise do; return fail('invalid','expansion.mapping.role.source'); end
      end
      if role = 'argument' then do
        if replacement.index() < 0 | wordpos(replacement.bank(),'r g a') = 0 then return fail('invalid','expansion.mapping.argument.coordinate')
        if replacement.bank() = 'r' & replacement.index() >= caller.locals() then return fail('invalid','expansion.mapping.argument.coordinate')
        if replacement.bank() = 'g' & replacement.index() >= candidate.globals() then return fail('invalid','expansion.mapping.argument.coordinate')
