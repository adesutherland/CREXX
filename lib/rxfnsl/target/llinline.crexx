  manifest: method = .lltargetremap..expansioninstance
    arg target = .lltarget..bodydraft, frameid = .int, sourceops = .int[], candidateops = .int[], counts = .int[], continuation = .string, providerowner = reference .lltarget..module
    expected = _request.provider()
