/** Work is one request allowance, explicitly partitioned between preparation,
 * the existing proof/expander, and final publication. Unused stage quota is
 * not borrowed. Each owned stage has its entries/bytes/cells cap; at most three
 * new owners coexist, so their aggregate is bounded by three such caps. */
expandimports: procedure = .llinline..change
  arg bindings = .object[], work = .int, entries = .int, bytes = .int, frame = .int, cells = .int
  request = .binding; checked = .decision; prepared = .importprojection
  input = .lltarget..record; value = .lltarget..operand; body = .lltarget..body
  targetbody = .lltarget..bodydraft; cache = .importorigins()
  empty = .int[]; sites = .int[]; decisions = .object[]; callers = .int[]; mapping = .int[]; published = .int[]; functions = .int[]
  fields = .object[]; bodies = .object[]; i = .int; j = .int; old = .int; projectedid = .int; stage = .int
  draft = .lltarget..draft
  if bindings[0] = 0 then return .change('keep','binding.empty')
  if bindings[1] is .binding then request = bindings[1] as .binding
  else return .change('invalid','binding.type')
  if request.valid() = 0 then return .change('invalid','binding.expired')
  source = dereference request.caller()
  if work < 3 | entries < 1 | bytes < 1 | frame < 0 | cells < 1 then return .change('limit','import.allowances',source,empty)
  stage = work / 3
  do
    prepared = .importprojection(bindings,stage,entries,bytes)
    call prepared.prepare()
    if prepared.status() <> 'ok' then return importrefusal(bindings,prepared.status(),prepared.reason(),source)
    projected = prepared.bindings()
    changed = expandlocalmany(projected,'closed-main-default-halt.v1',stage,entries,bytes,frame,cells)
    do i = 1 to bindings[0]
      request = bindings[i] as .binding; old = request.callid(); projectedid = prepared.operation(old)
      sites[i] = old
      if changed.sites() = 0 then decisions[i] = .decision(changed.status(),changed.reason()) as .object
      else decisions[i] = .decision(changed.statusat(projectedid),changed.reasonat(projectedid)) as .object
    end
    if changed.status() <> 'changed' then return .change(changed.status(),changed.reason(),source,empty,callers,sites,decisions)
    expanded = changed.result(); graph_ref = expanded.ir(); graph = dereference graph_ref
    held = .int
    if graph.operations() > bytes / 64 then return .change('limit','import.publication.bytes',source,empty)
    held = graph.operations() * 64; store = dereference graph.storage()
    if graph.functions() > (bytes - held) / 512 then return .change('limit','import.publication.bytes',source,empty)
    held = held + graph.functions() * 512
    if store.count(8) + store.count(9) > (bytes - held) / 128 then return .change('limit','import.publication.bytes',source,empty)
    held = held + (store.count(8) + store.count(9)) * 128
    if held >= bytes then return .change('limit','import.publication.bytes',source,empty)
    draft = .lltarget..draft(source.name(),source.artifact(),source.globals(),entries,bytes - held,work - stage * 2)
    code = .emitter(cells); skip = 0
    do i = 1 to expanded.records()
      input = expanded.record(i)
      if draft.preflight(1 + input.operands() + input.registerrefs(),0) = 0 then return importfailure(draft.error(),source)
      if input.kind() = 'procedure' then do
        if draft.preflight(expanded.procedures(),0) = 0 then return importfailure(draft.error(),source)
        body = expanded.body(input.procedureid()); skip = prepared.surrogate(body.name(),reference draft)
        if skip then iterate
      end
      else if input.procedureid() > 0 & skip then iterate
      at = cache.copy(graph_ref,input.origin(),reference draft)
      if draft.error() <> '' then return importfailure(draft.error(),source)
      if input.kind() = 'procedure' then do
        targetbody = draft.procedure(body.name(),body.locals(),at,body.expose())
        if draft.error() <> '' then return importfailure(draft.error(),source)
        bodies[input.procedureid()] = targetbody as .object; functions[input.procedureid()] = targetbody.functionid()
        published[input.id()] = targetbody.headerid(); iterate
      end
      if input.procedureid() = 0 then do
        call objectarraydrop fields
        do j = 1 to input.operands(); fields[j] = input.operand(j) as .object; end
        fields = prepared.publicfields(input,fields,reference draft)
        if prepared.status() <> 'ok' then return .change(prepared.status(),prepared.reason(),source,empty)
        published[input.id()] = draft.record(input.kind(),fields,at); iterate
      end
      targetbody = bodies[input.procedureid()] as .lltarget..bodydraft; fields = clonefields(input,targetbody)
      fields = prepared.publicfields(input,fields,reference draft)
      if prepared.status() <> 'ok' then return .change(prepared.status(),prepared.reason(),source,empty)
      if input.kind() = 'instruction' then published[input.id()] = code.emit(targetbody,input.mnemonic(),fields,at)
      else published[input.id()] = targetbody.record(input.kind(),fields,at)
    end
    if draft.error() <> '' then return importfailure(draft.error(),source)
    if code.error() <> '' then return .change('limit',code.error(),source,empty)
    if draft.preflight(source.records() + changed.callers(),0) = 0 then return importfailure(draft.error(),source)
    target = draft.finish()
    if target.valid() = 0 then return importfailure(target.error(),source)
    do i = 1 to source.records()
      input = source.record(i); old = changed.operation(prepared.operation(input.id()))
      if old > 0 then mapping[input.id()] = published[old]
      else mapping[input.id()] = 0
    end
    do i = 1 to changed.callers(); callers[i] = functions[changed.caller(i)]; end
    return .change('changed','closed.root.imported.scalar',target,mapping,callers,sites,decisions)
  on signal as problem
    if initialized(draft) then do
      if draft.error() <> '' then return importfailure(draft.error(),source)
    end
    status = 'invalid'
    if pos('LL_RESOURCE_LIMIT',problem.message()) > 0 then status = 'limit'
    return .change(status,'LL_IMPORT: ' || problem.name() || ': ' || problem.message(),source,empty)
  end
  return .change('invalid','import.no.result',source,empty)

importfailure: procedure = .llinline..change
  arg reason = .string, source = .lltarget..module
  status = 'invalid'; empty = .int[]
  if pos('LL_RESOURCE_LIMIT',reason) > 0 then status = 'limit'
  return .change(status,reason,source,empty)

/** Direct references recognize the common immutable provider-array case.
 * Frozen wrapper copies retain llir.nextidentity's globally unique arena ID;
 * their borrowed storage-wrapper addresses need not compare equal. Binding
 * validity has already checked each captured owner and arena for freshness. */
sameimportowner: procedure = .int
  arg first = reference .lltarget..module, second = reference .lltarget..module
  if first <refsame> second then return 1
  left = dereference first; right = dereference second
  return left.identity() = right.identity()

/** A preparation refusal still identifies original sites for CLI diagnostics.
 * Reading a binding's integer call ID does not dereference an expired owner. */
importrefusal: procedure = .llinline..change
  arg bindings = .object[], status = .string, reason = .string, source = .lltarget..module
  sites = .int[]; callers = .int[]; empty = .int[]; decisions = .object[]; request = .binding
  do i = 1 to bindings[0]
    if bindings[i] is .binding then do
      request = bindings[i] as .binding; sites[sites[0] + 1] = request.callid()
      decisions[decisions[0] + 1] = .decision(status,reason) as .object
    end
  end
  return .change(status,reason,source,empty,callers,sites,decisions)

inspectimports: procedure = .llinline..decision
  arg request = .binding, work = .int
  bindings = .object[]; bindings[1] = request as .object
  stage = .int; selected = .binding
  if work < 3 then return .decision('limit','import.work')
  stage = work / 3
  do
    prepared = .importprojection(bindings,stage,1000000,67108864)
    call prepared.prepare()
    if prepared.status() <> 'ok' then return .decision(prepared.status(),prepared.reason())
    projected = prepared.bindings(); selected = projected[1] as .binding
    return inspect(selected,'closed-main-default-halt.v1',stage)
  on signal as problem
    status = 'invalid'
    if pos('LL_RESOURCE_LIMIT',problem.message()) > 0 then status = 'limit'
    return .decision(status,'LL_IMPORT: ' || problem.name() || ': ' || problem.message())
  end
  return .decision('invalid','import.no.inspection')
