          if spend(1) = 0 then return 0
          value = item.operand(j)
          if value.kind() <> 'P' then iterate
          if j <> field then return fail('keep','import.child.reference.pending')
          if spend(source.procedures()) = 0 then return 0
          bodyid = source.procedureid(value.text())
          if bodyid = 0 then return fail('keep','import.child.body.pending')
          if bodyid = body.functionid() then return fail('keep','call.recursion.active')
          if parent > 0 then do
