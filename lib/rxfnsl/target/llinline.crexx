  status: method = .string
    ignored = .int; quota = .int; bytequota = .int
    call prepare()
    if _owned & _status = 'prepared' & _ownprepared = 0 then do
      _ownprepared = 1; _owncandidate = candidate()
      originalirref = _canonical.ir(); candidateirref = _owncandidate.ir()
      originalir = dereference originalirref; candidateir = dereference candidateirref
      originalstorage = originalir.storage(); candidatestorage = candidateir.storage()
      originalarena = dereference originalstorage; candidatearena = dereference candidatestorage
      if _owncandidate.valid() & _canonical.valid() & _owncandidate.identity() = _canonical.identity() & originalarena.sealed() & candidatearena.sealed() & originalarena.error() = '' & candidatearena.error() = '' & originalarena.identity() = candidatearena.identity() & _profile0.matches(_source) & _profile0.executioncontext() = _execution then do
        /* This is the exact same frozen owner and execution profile, not a
         * transfer of source facts to a rewritten candidate. */
        ignored = finish(_source,_points)
        if _status = 'ok' & valid() = 0 then return 'invalid'
