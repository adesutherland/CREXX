/* cREXX License (MIT). Atomic checked RXAS expansion; cleanup is independent. */
options levelb
namespace llinline expose binding bind decision inspect change expand expandmany copyorigin clonefields
import rxfnsb
import llir
import lltarget
import lltargetfacts
import llrxascatalog

binding: class
  _caller = reference .lltarget..module
  _provider = reference .lltarget..module
  _callerid = .int
  _providerid = .int
  _callerstore = reference .llir..arena
  _providerstore = reference .llir..arena
  _call = .int
  _body = .int
  *: factory
    arg caller = reference .lltarget..module, callId = .int, provider = reference .lltarget..module, procedureId = .int
    _caller = caller; _provider = provider; _call = callId; _body = procedureId
    if <refvalid>(caller) = 0 | <refvalid>(provider) = 0 then return
    source = dereference caller; target = dereference provider
    _callerid = source.identity(); _providerid = target.identity()
    graph = dereference source.ir(); _callerstore = graph.storage()
    graph = dereference target.ir(); _providerstore = graph.storage()
    return
  valid: method = .int
    if <refvalid>(_caller) = 0 | <refvalid>(_provider) = 0 | <refvalid>(_callerstore) = 0 | <refvalid>(_providerstore) = 0 then return 0
    source = dereference _caller; target = dereference _provider
    graph = dereference source.ir(); source_store = graph.storage()
    graph = dereference target.ir(); target_store = graph.storage()
    if (source_store <refsame> _callerstore) = 0 | (target_store <refsame> _providerstore) = 0 then return 0
    return source.valid() & target.valid() & source.identity() = _callerid & target.identity() = _providerid
  caller: method = reference .lltarget..module
    return _caller
  provider: method = reference .lltarget..module
    return _provider
  callid: method = .int
    return _call
  bodyid: method = .int
    return _body

bind: procedure = .llinline..binding
  arg caller = reference .lltarget..module, callId = .int, provider = reference .lltarget..module, procedureId = .int
  return .binding(caller,callId,provider,procedureId)

decision: class
  _status = .string
  _reason = .string
  _count = .int
  _first = .int
  _return = .int
  _remaining = .int
  *: factory
    arg status = .string, reason = .string, count = 0, first = 0, returned = 0, remaining = 0
    _status = status; _reason = reason; _count = count; _first = first; _return = returned; _remaining = remaining
    return
  status: method = .string
    return _status
  reason: method = .string
    return _reason
  arguments: method = .int
    return _count
  first: method = .int
    return _first
  returned: method = .int
    return _return
  remaining: method = .int
    return _remaining

/** The profile requires fresh standalone main entry without embedding/reentry
 * or externally installed handlers. Static target facts check the complete
 * root and callees; the profile does not pretend all signals halt. */
inspect: procedure = .llinline..decision
  arg request = .llinline..binding, profile = 'unknown', work = 1000000
  if request.valid() = 0 then return .decision('invalid','binding.expired')
  source = dereference request.caller(); caller_ref = request.caller(); provider_ref = request.provider()
  if profile = 'closed-main-static-exact-default-halt.v1' then return inspectimports(request,work)
  if (caller_ref <refsame> provider_ref) = 0 then return .decision('keep','profile.imported.body.pending')
  selected = source.at(request.callid())
  if selected.valid() = 0 then return .decision('invalid','call.identity')
  if selected.kind() <> 'instruction' then return .decision('invalid','call.not.instruction')
  if wordpos(selected.mnemonic(),'call call1 call2 call3 call4') = 0 then return .decision('keep','call.form.pending')
  facts = lltargetfacts..analyse(caller_ref,selected.procedureid(),profile,work)
  if facts.status() <> 'ok' then return .decision(facts.status(),facts.reason())
  if facts.bodyid(request.callid()) = 0 then return .decision('keep','call.form.pending')
  if facts.bodyid(request.callid()) <> request.bodyid() then return .decision('invalid','binding.target.mismatch')
  returnindex = -1
  if facts.returns(request.callid()) = 1 then do
    returned = source.at(facts.returnsite(request.callid(),1))
    if returned.operands() = 1 then do
      value = returned.operand(1)
      if value.kind() = 'R' & value.bank() = 'a' then returnindex = value.index()
    end
  end
  return .decision('legal','closed.root.scalar',facts.arguments(request.callid()),facts.first(request.callid()),returnindex,facts.remaining())

/** One owned publication plus complete original-record and site decisions.
 * A failed batch publishes the unchanged caller; expired input has no result. */
change: class
  _status = .string
  _reason = .string
  _result = .lltarget..module
  _mapping = .int[]
  _callers = .int[]
  _sites = .int[]
  _decisions = .object[]
  _hasresult = .int
  *: factory
    arg status = .string, reason = .string, ?result = .lltarget..module, ?mapping = .int[], ?callers = .int[], ?sites = .int[], ?decisions = .object[]
    _status = status; _reason = reason; _hasresult = ?result
    if ?result then _result = result
    if ?mapping then _mapping = mapping
    if ?callers then _callers = callers
    if ?sites then _sites = sites
    if ?decisions then _decisions = decisions
    return
  status: method = .string
    return _status
  reason: method = .string
    return _reason
  result: method = .lltarget..module
    if _hasresult = 0 then assembler signal "ERROR","LL_INLINE_RESULT: expired input has no result owner"
    return _result
  operation: method = .int
    arg oldId = .int
    if _status <> 'changed' then return oldId
    return _mapping[oldId]
  callers: method = .int
    return _callers[0]
  caller: method = .int
    arg ordinal = .int
    return _callers[ordinal]
  sites: method = .int
    return _sites[0]
  site: method = .int
    arg ordinal = .int
    return _sites[ordinal]
  statusat: method = .string
    arg callid = .int
    do i = 1 to _sites[0]
      if _sites[i] = callid then do; checked = _decisions[i] as .decision; return checked.status(); end
    end
    return 'invalid'
  reasonat: method = .string
    arg callid = .int
    do i = 1 to _sites[0]
      if _sites[i] = callid then do; checked = _decisions[i] as .decision; return checked.reason(); end
    end
    return 'binding.site.unavailable'

/** Copy all L contributors in topological order. Sources/origins are
 * cached by their existing owner IDs; no returned handle borrows a local arena. */
copyorigin: procedure = .llir..origin
  arg owner = reference .llir..module, old = .llir..origin, target = reference .lltarget..draft, source_ref = reference .object[], origin_ref = reference .object[]
  i = .int; j = .int; fileid = .int; parentid = .int
  file = .llir..sourcefile; at = .llir..origin; parent = .llir..origin; copied = .llir..origin
  parents = .object[]
  sources = dereference source_ref; origins = dereference origin_ref; draft = dereference target
  graph = dereference owner; store_ref = graph.storage(); store = dereference store_ref
  do i = origins[0] + 1 to old.id()
    if draft.preflight(1,0) = 0 then return draft.synthetic('failed provenance')
    at = .llir..origin(store_ref,i); fileid = store.get(9,i,1)
    if fileid > sources[0] then do; file = draft.source(at.filename(),at.sourcebytes()); sources[fileid] = file as .object; end
    else if sources[fileid] is .llir..sourcefile then file = sources[fileid] as .llir..sourcefile
    else do; file = draft.source(at.filename(),at.sourcebytes()); sources[fileid] = file as .object; end
    if draft.preflight(at.parents(),0) = 0 then return draft.synthetic('failed provenance')
    call objectarraydrop parents
    do j = 1 to at.parents()
      parent = at.parent(j); parentid = parent.id(); parents[j] = origins[parentid]
    end
    copied = draft.contributingorigin(file,at.first(),at.last(),at.kind(),parents)
    origins[i] = copied as .object
  end
  return origins[old.id()] as .llir..origin

clonefields: procedure = .object[]
  arg input = .lltarget..record, target = .lltarget..bodydraft
  replacements = .object[]; value = .lltarget..operand
  do i = 1 to input.registerrefs()
    value = input.registerref(i); replacements[i] = target.reg(value.bank(),value.index()) as .object
  end
  return lltarget..remapregisters(input,replacements)

/** Exact encoded instruction cells are counted while constructing the private
 * draft; exceeding the cap discards that draft before any result publication. */
emitter: class
  _limit = .int
  _used = .int
  _error = .string
  *: factory
    arg limit = .int
    _limit = limit
    return
  emit: method = .int
    arg target = .lltarget..bodydraft, mnemonic = .string, fields = .object[], at = .llir..origin
    cost = 1 + fields[0]
    if _error <> '' then return 0
    if cost > _limit - _used then do; _error = 'inline.code.cells'; return 0; end
    _used = _used + cost
    return target.emit(mnemonic,fields,at)
  one: method = .int
    arg target = .lltarget..bodydraft, mnemonic = .string, first = .lltarget..operand, at = .llir..origin
    fields = .object[]; fields[1] = first as .object
    return emit(target,mnemonic,fields,at)
  two: method = .int
    arg target = .lltarget..bodydraft, mnemonic = .string, first = .lltarget..operand, second = .lltarget..operand, at = .llir..origin
    fields = .object[]; fields[1] = first as .object; fields[2] = second as .object
    return emit(target,mnemonic,fields,at)
  error: method = .string
    return _error

freshidentity: procedure = .void
  arg expose pairs = .int[], old = .int, expose highest = .int
  if old <= 0 then return
  do i = 1 to pairs[0] by 2
    if pairs[i] = old then return
  end
  if highest >= 4294967295 then assembler signal "ERROR","LL_RESOURCE_LIMIT: source/clause identity extent"
  highest = highest + 1; n = pairs[0]; pairs[n + 1] = old; pairs[n + 2] = highest
  return

/** Request-local metadata names use the target draft's work/byte preflight.
 * Owned rows are charged before growth; no factory-local handle escapes. */
metascopes: class
  _owner = reference .lltarget..draft
  _names = .binary[]
  _sourcefn = .int[]
  _sourcerecord = .int[]
  _sourcearity = .int[]
  _sourcekind = .int[]
  _sourcecount = .int
  _suffixes = .string[]
  _branched = .int[]
  _dag = .int[]
  _continuations = .string[]
  _labelsites = .int[]
  _oldlabels = .binary[]
  _newlabels = .string[]
  _serial = .int
  _catalog = .llrxascatalog..catalog
  _bindings = .binary[]
  _active = .int[]
  _start = .int
  _held = .int
  *: factory
    arg owner = reference .lltarget..draft
    _owner = owner; _catalog = .llrxascatalog..catalog()
    return
  claim: method = .int
    arg work = .int, bytes = 0
    draft = dereference _owner
    if bytes < 0 | bytes > 2147483647 - _held then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline metadata name bytes"
    if draft.preflight(work,_held + bytes) = 0 then return 0
    _held = _held + bytes
    return 1
  remember: method = .void
    arg name = .binary
    if claim(<blen>(name) + 1,<blen>(name) + 24) = 0 then return
    _names[_names[0] + 1] = name
    return
  seed: method = .void
    arg item = .lltarget..record
    if item.kind() = 'instruction' then do
      flow = _catalog.flow(item.opcode())
      if flow = 1 | flow = 2 then call markbranch(item.procedureid())
      return
    end
    if item.kind() = 'label' then call markbranch(item.procedureid())
    if item.kind() <> '.meta' & item.kind() <> 'label' & item.kind() <> '.const' then return
    name = item.operand(1)
    if claim(1,32) = 0 then return
    call remember(name.bytes())
    _sourcecount = _names[0]
    _sourcefn[_sourcecount] = item.procedureid(); _sourcerecord[_sourcecount] = item.id()
    _sourcearity[_sourcecount] = 0
    _sourcekind[_sourcecount] = item.kind() = 'label'
    if item.kind() = '.meta' then _sourcearity[_sourcecount] = item.operands()
    return
  markbranch: method = .void
    arg functionid = .int
    growth = max(0,functionid - _branched[0])
    if growth > 2147483647 / 8 then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline branch index"
    if claim(1,growth * 8) = 0 then return
    _branched[functionid] = 1
    return
  guard: method = .int
    arg work = .int, bytes = 0
    draft = dereference _owner
    if bytes < 0 | bytes > 2147483647 - _held then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline metadata temporary bytes"
    return draft.preflight(work,_held + bytes)
  contains: method = .int
    arg name = .binary
    width = <blen>(name) + 1
    if _names[0] > 2147483647 / width then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline metadata name work"
    if claim(_names[0] * width,0) = 0 then return 1
    do i = 1 to _names[0]
      if bincompare(_names[i],name) = 0 then return 1
    end
    return 0
  prepare: method = .void
    arg functionid = .int, site = .int, slot = .int, facts_ref = reference .lltargetfacts..analysis
    i = .int; attempt = .int; collision = .int; width = .int
    suffix = .string
    draft = dereference _owner; facts = dereference facts_ref; attempt = 0
    _dag[slot] = (_branched[functionid] <> 0) | (facts.returns(site) > 1)
    do forever
      if claim(1,0) = 0 then return
      suffix = '.$inline.' || site
      if attempt > 0 then suffix = suffix || '.' || attempt
      collision = 0
      do i = 1 to _sourcecount
        if claim(1,0) = 0 then return
        if _sourcefn[i] <> functionid then iterate
        if _sourcearity[i] <> 1 & _sourcearity[i] <> 4 then iterate
        if facts.recordlive(site,_sourcerecord[i]) = 0 then iterate
        width = <blen>(_names[i]) + length(suffix)
        if guard(width + 1,width * 3) = 0 then return
        if contains(_names[i] || (suffix as .binary)) then collision = 1
      end
      if draft.error() <> '' then return
      if collision = 0 then leave
      attempt = attempt + 1
    end
    if claim(1,32 + length(suffix)) = 0 then return
    _suffixes[slot] = suffix
    do i = 1 to _sourcecount
      if claim(1,0) = 0 then return
      if _sourcefn[i] <> functionid then iterate
      if _sourcearity[i] <> 1 & _sourcearity[i] <> 4 then iterate
      if facts.recordlive(site,_sourcerecord[i]) = 0 then iterate
      width = <blen>(_names[i]) + length(suffix)
      if guard(width + 1,width * 3) = 0 then return
      call remember(_names[i] || (suffix as .binary))
    end
    if _dag[slot] then do
      _continuations[slot] = newlabel(site,''x as .binary)
      do i = 1 to _sourcecount
        if claim(1,0) = 0 then return
        if _sourcefn[i] <> functionid | _sourcekind[i] = 0 then iterate
        if facts.recordlive(site,_sourcerecord[i]) = 0 then iterate
        ignored = newlabel(site,_names[i])
      end
    end
    return
  newlabel: method = .string
    arg site = .int, old = .binary
    candidate = .string
    do forever
      if guard(1,192) = 0 then return ''
      if _serial >= 2147483647 then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline label identity extent"
      _serial = _serial + 1; candidate = '_inline.' || site || '.' || _serial
      if contains(candidate as .binary) = 0 then leave
      draft = dereference _owner
      if draft.error() <> '' then return ''
    end
    if claim(<blen>(old) + length(candidate) + 1,<blen>(old) + length(candidate) + 48) = 0 then return ''
    at = _labelsites[0] + 1; _labelsites[at] = site; _oldlabels[at] = old; _newlabels[at] = candidate
    call remember(candidate as .binary)
    return candidate
  label: method = .string
    arg site = .int, old = .binary
    width = <blen>(old) + 1
    if _labelsites[0] > 2147483647 / width then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline label lookup"
    if claim(_labelsites[0] * width,0) = 0 then return ''
    do i = 1 to _labelsites[0]
      if _labelsites[i] <> site then iterate
      if bincompare(_oldlabels[i],old) = 0 then return _newlabels[i]
    end
    assembler signal "ERROR","LL_INLINE_LABEL: missing live label mapping"
    return ''
  dag: method = .int
    arg slot = .int
    return _dag[slot]
  continuation: method = .string
    arg slot = .int
    return _continuations[slot]
  begin: method = .string
    arg site = .int
    _start = _bindings[0] + 1
    return _suffixes[site]
  observe: method = .void
    arg fields = .object[]
    i = .int; found = .int; opened = .int; name = .lltarget..operand
    if fields[0] <> 1 & fields[0] <> 4 then return
    name = fields[1] as .lltarget..operand; opened = fields[0] = 4; found = 0
    width = name.length() + 1; count = _bindings[0] - _start + 1
    if count > 2147483647 / width then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline metadata binding work"
    if claim(count * width,0) = 0 then return
    do i = _start to _bindings[0]
      if bincompare(_bindings[i],name.bytes()) = 0 then found = i
    end
    if found = 0 & opened then do
      if claim(name.length() + 1,name.length() + 32) = 0 then return
      found = _bindings[0] + 1; _bindings[found] = name.bytes()
    end
    if found > 0 then _active[found] = opened
    return
  hasbindings: method = .int
    if claim(_bindings[0] - _start + 1,0) = 0 then return 0
    do i = _start to _bindings[0]
      if _active[i] then return 1
    end
    return 0
  closings: method = .int
    return _bindings[0] - _start + 1
  active: method = .int
    arg ordinal = .int
    return _active[_start + ordinal - 1]
  name: method = .binary
    arg ordinal = .int
    return _bindings[_start + ordinal - 1]
/** Original encoded-slot ordinal, independent of active storage/permutation. */
slotordinal: procedure = .int
  arg value = .lltarget..operand, locals = .int, arguments = .int
  if value.bank() = 'r' & value.index() < locals then return value.index()
  if value.bank() = 'a' & value.index() <= arguments then return locals + value.index()
  assembler signal "ERROR","LL_INLINE: register outside proved callee slots"
  return -1

mappedslot: procedure = .lltarget..operand
  arg body = .lltarget..bodydraft, value = .lltarget..operand, base = .int, locals = .int, arguments = .int, ordered = .int
  /* The admitted same-module profile proves canonical global bindings. These
   * cells retain their module owner; they are outside both private r regions. */
  if value.bank() = 'g' then return body.reg('g',value.index())
  if ordered then return body.reg('r',base + locals + arguments + 3 + slotordinal(value,locals,arguments))
  if value.bank() = 'r' then return body.reg('r',base + arguments + 3 + value.index())
  if value.index() = 0 then return body.reg('r',base + arguments + 1)
  return body.reg('r',base + value.index())

expand: procedure = .llinline..change
  arg request = .llinline..binding, profile = 'unknown', work = 1000000, entries = 1000000, bytes = 67108864, frame = 65536, cells = 1000000
  bindings = .object[]; bindings[1] = request as .object
  return expandmany(bindings,profile,work,entries,bytes,frame,cells)

expandmany: procedure = .llinline..change
  arg bindings = .object[], profile = 'unknown', work = 1000000, entries = 1000000, bytes = 67108864, frame = 65536, cells = 1000000
  if profile = 'closed-main-static-exact-default-halt.v1' then return expandimports(bindings,work,entries,bytes,frame,cells)
  return expandlocalmany(bindings,profile,work,entries,bytes,frame,cells)

/** The sole expansion algorithm. Imported bodies enter it only after checked
 * private projection; no projected definition can reach public output. */
expandlocalmany: procedure = .llinline..change
  arg bindings = .object[], profile = 'unknown', work = 1000000, entries = 1000000, bytes = 67108864, frame = 65536, cells = 1000000
  i = .int; j = .int; k = .int; a = .int; ignored = .int; count = .int; required = .int
  locals = .int; base = .int; higheststep = .int; highestclause = .int
  extent = .int; fileid = .int; hasresult = .int; ordered = .int; slots = .int; activebase = .int; position = .int
  dag = .int; choice = .int; flow = .int; pairleft = .int; pairright = .int; abrupt = .int
  catalog = .llrxascatalog..catalog
  scope = .string; status = .string; scopes = .metascopes
  request = .binding; selected = .lltarget..record; input = .lltarget..record; childrecord = .lltarget..record; swaprecord = .lltarget..record
  field = .lltarget..operand; oldresult = .lltarget..operand; value = .lltarget..operand
  resultcell = .lltarget..operand; countcell = .lltarget..operand; tempcell = .lltarget..operand
  destination = .lltarget..operand; anchor = .lltarget..operand; actual = .lltarget..operand; mapped = .lltarget..operand
  callee = .lltarget..body; oldbody = .lltarget..body; caller = .lltarget..body
  at = .llir..origin; childat = .llir..origin; file = .llir..sourcefile
  ignoredorigin = .llir..origin
  targetbody = .lltarget..bodydraft; fields = .object[]; replacements = .object[]
  empty = .int[]; callers = .int[]; sites = .int[]; decisions = .object[]; maps = .int[]
  steps = .int[]; clauses = .int[]
  contributors = .object[]
  if bindings[0] = 0 then return .change('keep','binding.empty')
  if bindings[1] is .binding then request = bindings[1] as .binding
  else return .change('invalid','binding.type')
  if request.valid() = 0 then return .change('invalid','binding.expired')
  owner = request.caller(); source = dereference owner; selected = source.at(request.callid())
  if selected.valid() = 0 then return .change('invalid','call.identity',source,empty)
  functionid = source.procedureid('main')
  if functionid > 0 then caller = source.body(functionid)
  if work < 1 | entries < 1 | bytes < 1 | frame < 0 | cells < 1 then return .change('limit','inline.allowances',source,empty)
  accepted = .int[]; offsets = .int[]; selectedcount = 0
  do i = 1 to bindings[0]
    if bindings[i] is .binding then request = bindings[i] as .binding
    else return .change('invalid','binding.type',source,empty)
    if request.valid() = 0 then return .change('invalid','binding.expired',source,empty)
    caller_ref = request.caller(); provider_ref = request.provider()
    if (caller_ref <refsame> owner) = 0 then return .change('invalid','binding.foreign.caller',source,empty)
    do j = 1 to sites[0]
      if sites[j] = request.callid() then return .change('invalid','binding.duplicate.site',source,empty)
    end
    sites[i] = request.callid()
    selected = source.at(request.callid())
    if selected.valid() = 0 then return .change('invalid','call.identity',source,empty)
    if selected.kind() <> 'instruction' then return .change('invalid','call.not.instruction',source,empty)
    if functionid = 0 | selected.procedureid() <> functionid then decisions[i] = .decision('keep','signal.root.context.unproved') as .object
    else if wordpos(selected.mnemonic(),'call call1 call2 call3 call4') = 0 then decisions[i] = .decision('keep','call.form.pending') as .object
    else if (provider_ref <refsame> owner) = 0 then decisions[i] = .decision('keep','profile.imported.body.pending') as .object
    else do; accepted[request.callid()] = i; selectedcount = selectedcount + 1; end
  end
  if selectedcount = 0 then do
    checked = decisions[1] as .decision
    return .change('keep',checked.reason(),source,empty,callers,sites,decisions)
  end
  facts = lltargetfacts..analyse(owner,functionid,profile,work,bytes)
  if facts.status() <> 'ok' then do
    do i = 1 to sites[0]
      if accepted[sites[i]] > 0 then decisions[i] = .decision(facts.status(),facts.reason()) as .object
    end
    return .change(facts.status(),facts.reason(),source,empty,callers,sites,decisions)
  end
  work = facts.remaining(); locals = caller.locals()
  do i = 1 to bindings[0]
    request = bindings[i] as .binding
    if accepted[request.callid()] = 0 then iterate
    selected = source.at(request.callid())
    if selected.procedureid() <> functionid then return .change('invalid','binding.foreign.procedure',source,empty)
    if facts.bodyid(request.callid()) <> request.bodyid() then return .change('invalid','binding.target.mismatch',source,empty)
    callee = source.body(request.bodyid()); count = facts.arguments(request.callid())
    if facts.rebinding(request.callid()) | facts.orderedslots(request.callid()) then do
      if frame < 2 | count >= frame then return .change('limit','inline.frame',source,empty)
      if callee.locals() > frame - count - 1 then return .change('limit','inline.frame',source,empty)
      slots = callee.locals() + count + 1
      if slots > (frame - 2) / 2 then return .change('limit','inline.frame',source,empty)
      required = slots * 2 + 2
    end
    else do
      required = count + 3
      if required > frame then return .change('limit','inline.frame',source,empty)
      if callee.locals() > frame - required then return .change('limit','inline.frame',source,empty)
      required = required + callee.locals()
    end
    if required > frame - locals then return .change('limit','inline.frame',source,empty)
    offsets[request.callid()] = locals; locals = locals + required
    decisions[i] = .decision('changed','closed.root.scalar',count,facts.first(request.callid())) as .object
  end
  do i = 1 to source.records()
    input = source.record(i)
    if input.kind() = '.srcstep' then do
      value = input.operand(1); higheststep = max(higheststep,value.index())
      value = input.operand(2); highestclause = max(highestclause,value.index())
    end
    else if input.kind() = '.traceevent' then do
      value = input.operand(7); higheststep = max(higheststep,value.index())
      value = input.operand(8); highestclause = max(highestclause,value.index())
    end
  end
  do
    result = .lltarget..draft(source.name(),source.artifact(),source.globals(),entries,bytes,work)
    if result.error() <> '' then do
      status = 'invalid'
      if pos('LL_RESOURCE_LIMIT',result.error()) > 0 then status = 'limit'
      return .change(status,result.error(),source,empty)
    end
    code = .emitter(cells); catalog = .llrxascatalog..catalog()
    bodies = .object[]; sources = .object[]; origins = .object[]
    graph_ref = source.ir(); generated = result.synthetic('inline scalar transport')
    scopes = .metascopes(reference result)
    if sites[0] > 2147483647 / 32 then return .change('limit','inline.metadata.names',source,empty)
    if scopes.claim(1,sites[0] * 32) = 0 then return .change('limit',result.error(),source,empty)
    /* Reserve every authored metadata name. The label/constant names remain
     * reserved too; no authored or generated name is mistaken for a clear. */
    do i = 1 to source.records()
      if scopes.claim(1,0) = 0 then return .change('limit',result.error(),source,empty)
      input = source.record(i)
      call scopes.seed(input)
    end
    do i = 1 to sites[0]
      if accepted[sites[i]] = 0 then iterate
      call scopes.prepare(facts.bodyid(sites[i]),sites[i],accepted[sites[i]],reference facts)
      if result.error() <> '' then return .change('limit',result.error(),source,empty)
    end
    do i = 1 to source.records()
      if scopes.guard(1) = 0 then return .change('limit',result.error(),source,empty)
      input = source.record(i); at = copyorigin(graph_ref,input.origin(),reference result,reference sources,reference origins)
      if input.kind() = 'procedure' then do
        oldbody = source.body(input.procedureid()); extent = oldbody.locals()
        if input.procedureid() = functionid then extent = locals
        targetbody = result.procedure(oldbody.name(),extent,at,oldbody.expose())
        bodies[input.procedureid()] = targetbody as .object; maps[input.id()] = targetbody.headerid()
        if input.procedureid() = functionid then callers[1] = targetbody.functionid()
        iterate
      end
      if input.procedureid() = 0 then do
        call objectarraydrop fields
        do j = 1 to input.operands(); fields[j] = input.operand(j) as .object; end
        maps[input.id()] = result.record(input.kind(),fields,at); iterate
      end
      targetbody = bodies[input.procedureid()] as .lltarget..bodydraft
      if accepted[input.id()] = 0 then do
        fields = clonefields(input,targetbody)
        if input.kind() = 'instruction' then maps[input.id()] = code.emit(targetbody,input.mnemonic(),fields,at)
        else maps[input.id()] = targetbody.record(input.kind(),fields,at)
        if input.kind() = 'label' then do
          abrupt = facts.handlercall(input.id())
          if abrupt > 0 then do
            if accepted[abrupt] = 0 then return .change('invalid','inline.signal.site.unselected',source,empty)
            /* This sole zero-local CALL1 owns four disjoint fresh cells.
             * UNLINK is safe before, during and after its setup; it never
             * clears or expires the borrowed result/actual. The caller's
             * original SIGPOP remains the next original instruction. */
            base = offsets[abrupt]
            anchor = targetbody.reg('r',base + 1); ignored = code.one(targetbody,'unlink',anchor,at)
            anchor = targetbody.reg('r',base); ignored = code.one(targetbody,'unlink',anchor,at)
            anchor = targetbody.reg('r',base + 2); ignored = code.one(targetbody,'endlife',anchor,at)
            anchor = targetbody.reg('r',base + 3); ignored = code.one(targetbody,'endlife',anchor,at)
            if scopes.hasbindings() then do k = 1 to scopes.closings()
              if scopes.active(k) = 0 then iterate
              call objectarraydrop fields
              fields[1] = .lltarget..operand.string(scopes.name(k)) as .object
              ignored = targetbody.record('.meta',fields,at)
            end
          end
        end
        iterate
      end
      callee = source.body(facts.bodyid(input.id())); count = facts.arguments(input.id()); base = offsets[input.id()]
      scope = scopes.begin(accepted[input.id()])
      dag = scopes.dag(accepted[input.id()])
      /* Retained counted children observe adjacency across r/a bank borders,
       * even when the outer body never explicitly rebinds a slot. */
      ordered = facts.rebinding(input.id()) | facts.orderedslots(input.id())
      resultcell = targetbody.reg('r',base); hasresult = input.operands() > 1
      slots = callee.locals() + count + 1; activebase = base + slots + 2
      if ordered then do
        countcell = targetbody.reg('r',activebase + callee.locals()); tempcell = targetbody.reg('r',base + 1)
      end
      else do
        countcell = targetbody.reg('r',base + count + 1); tempcell = targetbody.reg('r',base + count + 2)
      end
      if hasresult then do
        oldresult = input.operand(1); destination = targetbody.reg(oldresult.bank(),oldresult.index())
        if input.mnemonic() = 'call' & input.operands() = 2 then ignored = code.one(targetbody,'null',destination,at)
        ignored = code.two(targetbody,'link',resultcell,destination,at)
      end
      ignored = code.one(targetbody,'null',countcell,at)
      ignored = code.two(targetbody,'load',countcell,.lltarget..operand.integer(count),at)
      if ordered then do a = 0 to slots - 1
        anchor = targetbody.reg('r',base + 2 + a); mapped = targetbody.reg('r',activebase + a)
        if a <= callee.locals() then ignored = code.two(targetbody,'link',anchor,mapped,at)
        else do
          actual = targetbody.reg(facts.argumentbank(input.id(),a - callee.locals()),facts.argument(input.id(),a - callee.locals()))
          ignored = code.two(targetbody,'link',anchor,actual,at)
          ignored = code.two(targetbody,'link',mapped,anchor,at)
        end
      end
      else do a = 1 to count
        anchor = targetbody.reg('r',base + a)
        actual = targetbody.reg(facts.argumentbank(input.id(),a),facts.argument(input.id(),a))
        ignored = code.two(targetbody,'link',anchor,actual,at)
      end
      steps = empty; clauses = empty
      do j = 1 to source.records()
        if scopes.guard(1) = 0 then return .change('limit',result.error(),source,empty)
        childrecord = source.record(j)
        if childrecord.procedureid() <> callee.functionid() | childrecord.kind() = 'procedure' then iterate
        if facts.recordlive(input.id(),childrecord.id()) = 0 then iterate
        if childrecord.kind() = '.srcstep' then do
          value = childrecord.operand(1); call freshidentity(steps,value.index(),higheststep)
          value = childrecord.operand(2); call freshidentity(clauses,value.index(),highestclause)
        end
        else if childrecord.kind() = '.traceevent' then do
          value = childrecord.operand(7); call freshidentity(steps,value.index(),higheststep)
          value = childrecord.operand(8); call freshidentity(clauses,value.index(),highestclause)
        end
      end
      do j = 1 to source.records()
        if scopes.guard(1) = 0 then return .change('limit',result.error(),source,empty)
        childrecord = source.record(j)
        if childrecord.procedureid() <> callee.functionid() | childrecord.kind() = 'procedure' then iterate
        if facts.recordlive(input.id(),childrecord.id()) = 0 then iterate
        if childrecord.kind() = '.meta' & (childrecord.operands() = 3 | childrecord.operands() = 5) then iterate
        if childrecord.kind() = 'instruction' & childrecord.mnemonic() = 'numsci' then iterate
        oldat = childrecord.origin()
        ignoredorigin = copyorigin(graph_ref,oldat,reference result,reference sources,reference origins)
        graph = dereference graph_ref; store = dereference graph.storage(); fileid = store.get(9,oldat.id(),1)
        file = sources[fileid] as .llir..sourcefile
        call objectarraydrop contributors
        contributors[1] = ignoredorigin as .object; contributors[2] = at as .object
        childat = result.contributingorigin(file,oldat.first(),oldat.last(),'composite',contributors)
        call objectarraydrop replacements
        do k = 1 to childrecord.registerrefs()
          field = childrecord.registerref(k)
          value = mappedslot(targetbody,field,base,callee.locals(),count,ordered)
          replacements[k] = value as .object
        end
        fields = lltarget..remapregisters(childrecord,replacements)
        fields = lltarget..remapmetadata(childrecord,fields,scope,steps,clauses)
        if childrecord.kind() = 'label' then do
          value = childrecord.operand(1)
          fields[1] = .lltarget..operand.symbol(scopes.label(input.id(),value.bytes())) as .object
        end
        if childrecord.kind() <> 'instruction' then do
          ignored = targetbody.record(childrecord.kind(),fields,childat)
          if childrecord.kind() = '.meta' then call scopes.observe(fields)
        end
        else if catalog.flow(childrecord.opcode()) = 1 | catalog.flow(childrecord.opcode()) = 2 then do
          flow = catalog.flow(childrecord.opcode()); choice = facts.branchchoice(input.id(),childrecord.id())
          if flow = 2 & choice > 0 then do
            if childrecord.mnemonic() = 'brtf' | choice = 1 then do
              value = childrecord.operand(choice)
              ignored = code.one(targetbody,'br',.lltarget..operand.symbol(scopes.label(input.id(),value.bytes())),childat)
            end
            else do
              /* A selected fallthrough keeps an executable source address for
               * attached source/TRACE records without retaining a dead edge. */
              call objectarraydrop fields
              ignored = code.emit(targetbody,'cnop',fields,childat)
            end
          end
          else do
            do k = 1 to childrecord.operands()
              if catalog.branch(childrecord.opcode(),k) = 0 then iterate
              value = childrecord.operand(k)
              fields[k] = .lltarget..operand.symbol(scopes.label(input.id(),value.bytes())) as .object
            end
            ignored = code.emit(targetbody,childrecord.mnemonic(),fields,childat)
          end
        end
        else if childrecord.mnemonic() = 'linkarg' then do
          /* The source slot is the current active argument, including prior
           * LINK/SWAP effects. Its immutable entry anchor has other semantics.
           * The site-specific proof captured the index before rebinding the
           * destination, including when that slot held the selector itself. */
          position = facts.argumentselector(input.id(),childrecord.id())
          field = .lltarget..operand.bound(0,0,0,'a',position)
          value = mappedslot(targetbody,field,base,callee.locals(),count,ordered)
          destination = fields[1] as .lltarget..operand
          ignored = code.two(targetbody,'link',destination,value,childat)
        end
        else if ordered & childrecord.mnemonic() = 'unlink' then do
          field = childrecord.operand(1); position = slotordinal(field,callee.locals(),count)
          mapped = fields[1] as .lltarget..operand; anchor = targetbody.reg('r',base + 2 + position)
          ignored = code.two(targetbody,'link',mapped,anchor,childat)
        end
        else if childrecord.mnemonic() <> 'ret' then ignored = code.emit(targetbody,childrecord.mnemonic(),fields,childat)
        else do
          if hasresult & childrecord.operands() = 1 then do
            value = childrecord.operand(1)
            if value.kind() = 'I' then do
              ignored = code.two(targetbody,'load',tempcell,value,childat)
              ignored = code.two(targetbody,'icopy',resultcell,tempcell,childat)
            end
            else if value.kind() = 'S' then ignored = code.two(targetbody,'load',resultcell,value,childat)
            else do
              mapped = fields[1] as .lltarget..operand
              if facts.returnactionat(input.id(),childrecord.id()) = 'move' then ignored = code.two(targetbody,'move',resultcell,mapped,childat)
              else ignored = code.two(targetbody,'copy',resultcell,mapped,childat)
            end
          end
          if ordered then do
            if dag then do k = 1 to facts.restores(input.id(),childrecord.id())
              pairleft = facts.restoreleft(input.id(),childrecord.id(),k)
              pairright = facts.restoreright(input.id(),childrecord.id(),k)
              if pairleft < 0 | pairleft >= slots | pairright < 0 | pairright >= slots then assembler signal "ERROR","LL_INLINE: invalid per-RET slot restoration"
              destination = targetbody.reg('r',activebase + pairleft); mapped = targetbody.reg('r',activebase + pairright)
              ignored = code.two(targetbody,'swap',destination,mapped,childat)
            end
            else do
              /* Preserve the qualified linear reversal, including swaps
               * around retained children that restore the same identity. */
              do k = facts.swaps(input.id()) to 1 by -1
                swaprecord = source.at(facts.swap(input.id(),k))
                field = swaprecord.operand(1); destination = mappedslot(targetbody,field,base,callee.locals(),count,1)
                field = swaprecord.operand(2); mapped = mappedslot(targetbody,field,base,callee.locals(),count,1)
                ignored = code.two(targetbody,'swap',destination,mapped,childat)
              end
            end
            /* Restore every active binding before expiring owned bases.
             * Argument entry anchors never become owned argument storage. */
            do a = 0 to slots - 1
              mapped = targetbody.reg('r',activebase + a); ignored = code.one(targetbody,'unlink',mapped,childat)
            end
            do a = 0 to slots - 1
              anchor = targetbody.reg('r',base + 2 + a); ignored = code.one(targetbody,'unlink',anchor,childat)
            end
          end
          else do a = 1 to count
            anchor = targetbody.reg('r',base + a); ignored = code.one(targetbody,'unlink',anchor,childat)
          end
          if hasresult then ignored = code.one(targetbody,'unlink',resultcell,childat)
          ignored = code.one(targetbody,'endlife',countcell,childat)
          ignored = code.one(targetbody,'endlife',tempcell,childat)
          do a = 0 to callee.locals() - 1
            if ordered then anchor = targetbody.reg('r',activebase + a)
            else anchor = targetbody.reg('r',base + count + 3 + a)
            ignored = code.one(targetbody,'endlife',anchor,childat)
          end
          if dag then do
            ignored = code.one(targetbody,'br',.lltarget..operand.symbol(scopes.continuation(accepted[input.id()])),childat)
            iterate
          end
          if scopes.hasbindings() then do
            do k = 1 to scopes.closings()
              if scopes.active(k) = 0 then iterate
              call objectarraydrop fields
              fields[1] = .lltarget..operand.string(scopes.name(k)) as .object
              ignored = targetbody.record('.meta',fields,childat)
            end
            /* The sole-RET linear profile needs one executable address after
             * the clears, not a control edge. Current L cleanup preserves
             * CNOP; assembly with optimization disabled retains its cell. */
            call objectarraydrop fields
            ignored = code.emit(targetbody,'cnop',fields,childat)
          end
          /* Do not turn unreachable callee end metadata into observations
           * at the reachable caller continuation. The original body is kept. */
          leave
        end
      end
      if dag then do
        call objectarraydrop fields
        fields[1] = .lltarget..operand.symbol(scopes.continuation(accepted[input.id()])) as .object
        ignored = targetbody.record('label',fields,at)
        if scopes.hasbindings() then do
          do k = 1 to scopes.closings()
            if scopes.active(k) = 0 then iterate
            call objectarraydrop fields
            fields[1] = .lltarget..operand.string(scopes.name(k)) as .object
            ignored = targetbody.record('.meta',fields,at)
          end
          call objectarraydrop fields
          ignored = code.emit(targetbody,'cnop',fields,at)
        end
      end
      maps[input.id()] = 0
    end
    if scopes.guard(1) = 0 then return .change('limit',result.error(),source,empty)
    if code.error() <> '' then return .change('limit',code.error(),source,empty)
    target = result.finish()
    if target.valid() = 0 then do
      status = 'invalid'
      if pos('LL_RESOURCE_LIMIT',target.error()) > 0 then status = 'limit'
      return .change(status,target.error(),source,empty)
    end
    return .change('changed','closed.root.scalar',target,maps,callers,sites,decisions)
  on signal as problem
    status = 'invalid'
    if pos('LL_RESOURCE_LIMIT',problem.message()) > 0 then status = 'limit'
    return .change(status,'LL_INLINE: ' || problem.name() || ': ' || problem.message(),source,empty)
  end
  return .change('invalid','inline.no.result',source,empty)

/** One cache per exact input owner. Numeric source/origin and observation IDs
 * from two modules never share a lookup table. */
importorigins: class
  _sources = .object[]
  _origins = .object[]
  _steps = .int[]
  _clauses = .int[]
  *: factory
    return
  copy: method = .llir..origin
    arg owner = reference .llir..module, at = .llir..origin, target = reference .lltarget..draft
    return copyorigin(owner,at,target,reference _sources,reference _origins)
  prepare: method = .void
    arg item = .lltarget..record, expose higheststep = .int, expose highestclause = .int
    value = .lltarget..operand
    if item.kind() = '.srcstep' then do
      value = item.operand(1); call freshidentity(_steps,value.index(),higheststep)
      value = item.operand(2); call freshidentity(_clauses,value.index(),highestclause)
    end
    else if item.kind() = '.traceevent' then do
      value = item.operand(7); call freshidentity(_steps,value.index(),higheststep)
      value = item.operand(8); call freshidentity(_clauses,value.index(),highestclause)
    end
    return
  steps: method = .int
    return _steps[0] / 2
  clauses: method = .int
    return _clauses[0] / 2
  metadata: method = .object[]
    arg item = .lltarget..record, fields = .object[]
    return lltarget..remapmetadata(item,fields,'',_steps,_clauses)

/** Request-local checked projection, not an executable merged module. The
 * public static-exact profile declares the exact sources used for delivery;
 * this class checks all facts expressible by the current target schema. */
importprojection: class
  _owner = reference .lltarget..module
  _input = .object[]
  _providers = .object[]
  _caches = .object[]
  _pairprovider = .int[]
  _pairbody = .int[]
  _pairheader = .int[]
  _pairname = .string[]
  _pairfunction = .int[]
  _pairalias = .string[]
  _nestedparent = .int[]
  _nestedoperation = .int[]
  _nestedpair = .int[]
  _labelpair = .int[]
  _labelold = .binary[]
  _labelnew = .string[]
  _callpair = .int[]
  _operations = .int[]
  _functions = .int[]
  _reserved = .string[]
  _importnames = .string[]
  _importexports = .string[]
  _exportnames = .string[]
  _exportproviders = .int[]
  _module = .lltarget..module
  _status = .string
  _reason = .string
  _work = .int
  _bytes = .int
  _entries = .int
  _held = .int
  _serial = .int
  _namebytes = .int
  *: factory
    arg bindings = .object[], work = .int, entries = .int, bytes = .int
    _input = bindings; _work = work; _entries = entries; _bytes = bytes; _status = 'building'
    return
  prepare: method = .void
    bindings = _input; work = _work; entries = _entries; bytes = _bytes
    request = .binding; previous = .binding; candidate = .binding
    selected = .lltarget..record; item = .lltarget..record
    value = .lltarget..operand
    body = .lltarget..body; cache = .importorigins; targetbody = .lltarget..bodydraft
    provider = .lltarget..module; at = .llir..origin
    draft = .lltarget..draft; message = .string; status = .string
    fields = .object[]; sourcecache = .importorigins()
    providerindex = .int; pair = .int; found = .int; called = .string
    i = .int; j = .int; k = .int; roots = .int; higheststep = .int; highestclause = .int; ignored = .int
    renamed = .string; catalog = .llrxascatalog..catalog()
    do
    if bindings[0] = 0 then do; ignored = fail('keep','binding.empty'); return; end
    if bindings[1] is .binding then request = bindings[1] as .binding
    else do; ignored = fail('invalid','binding.type'); return; end
    if request.valid() = 0 then do; ignored = fail('invalid','binding.expired'); return; end
    _owner = request.caller(); source = dereference _owner
    if work < 1 | entries < 1 | bytes < 1 then do; ignored = fail('limit','import.allowances'); return; end
    /* Sparse original IDs can be large before the first selected site. Charge
     * their complete containing tables before any indexed write grows them. */
    graph = dereference source.ir()
    if reserve(graph.operations(),24) = 0 | reserve(graph.functions(),512) = 0 | origincapacity(_owner) = 0 then return
    if scanmodule(_owner,0) = 0 then return
    do i = 1 to bindings[0]
      if spend(1) = 0 | reserve(1,512) = 0 then return
      if bindings[i] is .binding then request = bindings[i] as .binding
      else do; ignored = fail('invalid','binding.type'); return; end
      if request.valid() = 0 then do; ignored = fail('invalid','binding.expired'); return; end
      caller_ref = request.caller(); provider_ref = request.provider()
      if (caller_ref <refsame> _owner) = 0 then do; ignored = fail('invalid','binding.foreign.caller'); return; end
      do j = 1 to i - 1
        if spend(1) = 0 then return
        previous = bindings[j] as .binding
        if previous.callid() = request.callid() then do; ignored = fail('invalid','binding.duplicate.site'); return; end
      end
      selected = source.at(request.callid())
      if selected.valid() = 0 then do; ignored = fail('invalid','call.identity'); return; end
      if selected.kind() <> 'instruction' then do; ignored = fail('invalid','call.not.instruction'); return; end
      if (provider_ref <refsame> _owner) then iterate
      if selected.procedureid() <> source.procedureid('main') then do; ignored = fail('keep','signal.root.context.unproved'); return; end
      if wordpos(selected.mnemonic(),'call call1 call2 call3 call4') = 0 then do; ignored = fail('keep','call.form.pending'); return; end
      if selected.operands() = 1 then value = selected.operand(1)
      else value = selected.operand(2)
      if value.kind() <> 'P' then do; ignored = fail('invalid','binding.target.mismatch'); return; end
      called = value.text(); found = 0
      do j = 1 to _importnames[0]
        if spend(length(called) + 1) = 0 then return
        if _importnames[j] == called then found = j
      end
      if found = 0 then do; ignored = fail('invalid','binding.import.missing'); return; end
      provider_entry = dereference provider_ref; provider = provider_entry; providerindex = 0
      do j = 1 to _providers[0]
        if spend(1) = 0 then return
        candidate = _providers[j] as .binding
        if sameimportowner(candidate.provider(),provider_ref) then providerindex = j
      end
      if providerindex = 0 then do
        if scanmodule(provider_ref,1) = 0 | reserve(1,128) = 0 then return
        providerindex = _providers[0] + 1; _providers[providerindex] = request as .object
        _caches[providerindex] = .importorigins() as .object
      end
      pair = 0
      do j = 1 to provider.procedures()
        if spend(1) = 0 then return
        body = provider.procedure(j)
        if body.functionid() = request.bodyid() then pair = j
      end
      if pair = 0 then do; ignored = fail('invalid','binding.body.identity'); return; end
      body = provider.procedure(pair)
      if body.expose() = '' | body.expose() <> _importexports[found] then do; ignored = fail('invalid','binding.target.mismatch'); return; end
      pair = intern(providerindex,body)
      if pair = 0 then return
      _callpair[request.callid()] = pair
    end
    /* Imports remain dependencies even when all their executable uses vanish. */
    do i = 1 to _importexports[0]
      found = 0
      do j = 1 to _exportnames[0]
        if spend(length(_importexports[i]) + 1) = 0 then return
        if _exportproviders[j] > 0 & _exportnames[j] == _importexports[i] then found = found + 1
      end
      if found <> 1 then do; ignored = fail('keep','binding.import.unresolved'); return; end
    end
    /* Selected roots are interned before this bounded closure. A child uses
     * the same pair if also selected directly; it never gains a fresh frame
     * history merely because it is reached through a different outer site. */
    roots = _pairbody[0]
    do i = 1 to roots
      if checkedbody(i,1) = 0 then return
    end
    do i = 1 to _providers[0]
      request = _providers[i] as .binding
      if origincapacity(request.provider()) = 0 then return
    end
    do i = 1 to source.records()
      if spend(1) = 0 then return
      item = source.record(i)
      if item.kind() = '.srcstep' then do
        value = item.operand(1); higheststep = max(higheststep,value.index())
        value = item.operand(2); highestclause = max(highestclause,value.index())
      end
      else if item.kind() = '.traceevent' then do
        value = item.operand(7); higheststep = max(higheststep,value.index())
        value = item.operand(8); highestclause = max(highestclause,value.index())
      end
    end
    do i = 1 to _pairbody[0]
      request = _providers[_pairprovider[i]] as .binding
      provider_metadata = dereference request.provider(); provider = provider_metadata
      cache = _caches[_pairprovider[i]] as .importorigins; body = provider.body(_pairbody[i])
      do j = 1 to provider.records()
        if spend(1) = 0 then return
        item = provider.record(j)
        if item.procedureid() <> body.functionid() | item.kind() = 'procedure' then iterate
        /* The private projection shares one module-wide label/constant
         * namespace. Reserve every declaration before replay, including
         * forward, alias and unreachable labels, for this exact body pair. */
        if item.kind() = 'label' then do
          value = item.operand(1)
          if preparelabel(i,value.bytes()) = 0 then return
        end
        if item.kind() = '.srcstep' | item.kind() = '.traceevent' then do
          /* freshidentity scans each existing pair before insertion. Charge
           * both lookup lengths before either request-local map can grow. */
          if spend(cache.steps() + 1) = 0 then return
          if spend(cache.clauses() + 1) = 0 then return
        end
        if reserve(1,32) = 0 then return
        call cache.prepare(item,higheststep,highestclause)
      end
      _caches[_pairprovider[i]] = cache as .object
    end
    if _work < 1 | _held >= bytes then do; ignored = fail('limit','import.allowances'); return; end
    draft = .lltarget..draft(source.name(),source.artifact(),0,entries,bytes - _held,_work)
    graph_ref = source.ir(); bodies = .object[]
    do i = 1 to source.records()
      item = source.record(i)
      if draft.preflight(1 + item.operands() + item.registerrefs(),0) = 0 then do; ignored = failedmodel(draft.error()); return; end
      at = sourcecache.copy(graph_ref,item.origin(),reference draft)
      if draft.error() <> '' then do; ignored = failedmodel(draft.error()); return; end
      if item.kind() = 'procedure' then do
        if draft.preflight(source.procedures(),0) = 0 then do; ignored = failedmodel(draft.error()); return; end
        body = source.body(item.procedureid()); targetbody = draft.procedure(body.name(),body.locals(),at,body.expose())
        if draft.error() <> '' then do; ignored = failedmodel(draft.error()); return; end
        bodies[item.procedureid()] = targetbody as .object; _functions[item.procedureid()] = targetbody.functionid()
        _operations[item.id()] = targetbody.headerid(); iterate
      end
      if item.procedureid() = 0 then do
        call objectarraydrop fields
        do j = 1 to item.operands(); fields[j] = item.operand(j) as .object; end
        _operations[item.id()] = draft.record(item.kind(),fields,at); iterate
      end
      targetbody = bodies[item.procedureid()] as .lltarget..bodydraft
      fields = clonefields(item,targetbody); pair = _callpair[item.id()]
      if pair > 0 then do
        j = 2; if item.operands() = 1 then j = 1
        fields[j] = .lltarget..operand.procedure(_pairname[pair]) as .object
      end
      if item.kind() = 'instruction' then _operations[item.id()] = targetbody.emit(item.mnemonic(),fields,at)
      else _operations[item.id()] = targetbody.record(item.kind(),fields,at)
    end
    do i = 1 to _pairbody[0]
      request = _providers[_pairprovider[i]] as .binding
      provider_body = dereference request.provider(); provider = provider_body
      cache = _caches[_pairprovider[i]] as .importorigins; body = provider.body(_pairbody[i]); graph_ref = provider.ir()
      item = provider.at(_pairheader[i]); at = cache.copy(graph_ref,item.origin(),reference draft)
      if draft.error() <> '' then do; ignored = failedmodel(draft.error()); return; end
      /* Every alias/site of this exact body keeps one original private-frame
       * width and recycler identity for the existing scalar facts owner. */
      targetbody = draft.procedure(_pairname[i],body.locals(),at)
      if draft.error() <> '' then do; ignored = failedmodel(draft.error()); return; end
      _pairfunction[i] = targetbody.functionid()
      do j = 1 to provider.records()
        if draft.preflight(1,0) = 0 then do; ignored = failedmodel(draft.error()); return; end
        item = provider.record(j)
        if item.procedureid() <> body.functionid() | item.kind() = 'procedure' then iterate
        if draft.preflight(1 + item.operands() + item.registerrefs(),0) = 0 then do; ignored = failedmodel(draft.error()); return; end
        at = cache.copy(graph_ref,item.origin(),reference draft)
        fields = clonefields(item,targetbody); fields = cache.metadata(item,fields)
        if item.kind() = '.meta' & item.operands() = 5 then fields[4] = .lltarget..operand.procedure(_pairname[i]) as .object
        if item.kind() = 'label' then do
          value = item.operand(1); renamed = projectlabel(i,value.bytes(),reference draft)
          if _status <> 'building' then return
          if draft.error() <> '' then do; ignored = failedmodel(draft.error()); return; end
          fields[1] = .lltarget..operand.symbol(renamed) as .object
        end
        else if item.kind() = 'instruction' then do
          do k = 1 to item.operands()
            if catalog.branch(item.opcode(),k) = 0 then iterate
            value = item.operand(k); renamed = projectlabel(i,value.bytes(),reference draft)
            if _status <> 'building' then return
            if draft.error() <> '' then do; ignored = failedmodel(draft.error()); return; end
            fields[k] = .lltarget..operand.symbol(renamed) as .object
          end
          if wordpos(item.mnemonic(),'call call1 call2 call3 call4') > 0 then do
            pair = projectedchild(i,item.id(),reference draft)
            if _status <> 'building' then return
            if draft.error() <> '' then do; ignored = failedmodel(draft.error()); return; end
            if pair = 0 then do; ignored = fail('invalid','import.child.mapping'); return; end
            k = 2; if item.operands() = 1 then k = 1
            fields[k] = .lltarget..operand.procedure(_pairname[pair]) as .object
          end
        end
        if item.kind() = 'instruction' then ignored = targetbody.emit(item.mnemonic(),fields,at)
        else ignored = targetbody.record(item.kind(),fields,at)
      end
      _caches[_pairprovider[i]] = cache as .object
    end
    _module = draft.finish()
    if _module.valid() = 0 then do; ignored = failedmodel(_module.error()); return; end
    _status = 'ok'
    return
    on signal as problem
      if initialized(draft) then do
        message = draft.error()
        if message <> '' then do; ignored = failedmodel(message); return; end
      end
      status = 'invalid'
      if pos('LL_RESOURCE_LIMIT',problem.message()) > 0 then status = 'limit'
      ignored = fail(status,'LL_IMPORT: ' || problem.name() || ': ' || problem.message())
    end
    return
  fail: method = .int
    arg status = .string, reason = .string
    _status = status; _reason = reason
    return 0
  spend: method = .int
    arg amount = .int
    if amount < 0 | amount > _work then return fail('limit','import.work')
    _work = _work - amount
    return 1
  reserve: method = .int
    arg count = .int, width = .int
    if count < 0 | width < 1 | count > (_bytes - _held) / width then return fail('limit','import.bytes')
    _held = _held + count * width
    return 1
  failedmodel: method = .int
    arg reason = .string
    status = 'invalid'
    if pos('LL_RESOURCE_LIMIT',reason) > 0 then status = 'limit'
    return fail(status,reason)
  origincapacity: method = .int
    arg owner = reference .lltarget..module
    source = dereference owner; graph = dereference source.ir(); store = dereference graph.storage()
    return reserve(store.count(8) + store.count(9),128)
  remember: method = .int
    arg name = .string
    if spend(length(name) + 1) = 0 | reserve(length(name) + 32,1) = 0 then return 0
    _reserved[_reserved[0] + 1] = name
    return 1
  newname: method = .string
    arg prefix = '_import.body.'
    i = .int; collision = .int; ignored = .int; name = .string
    do forever
      if _serial >= 2147483647 then do; ignored = fail('limit','import.names'); return ''; end
      _serial = _serial + 1; name = prefix || _serial; collision = 0
      do i = 1 to _reserved[0]
