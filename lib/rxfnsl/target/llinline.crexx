/** Preserve complete site diagnostics when a shared resource envelope refuses
 * a batch whose individual draft plans were otherwise constructible. */
batchrefusal: procedure = .llinline..change
  arg state = .string, reason = .string, source = .lltarget..module, sites = .int[], decisions = .object[]
  empty = .int[]
  do i = 1 to decisions[0]
    if decisions[i] is .decision then do
      decision = decisions[i] as .decision
      if wordpos(decision.status(),'changed legal') > 0 then decisions[i] = .decision('keep',reason) as .object
    end
  end
  return .change(state,reason,source,empty,empty,sites,decisions)

