    item = .lltarget..record; value = .lltarget..operand; child = .lltarget..body
    i = .int; j = .int; returns = .int; field = .int; bodyid = .int; childpair = .int; alias = .string
    do i = 1 to source.records()
      if spend(1) = 0 then return 0
      item = source.record(i)
      if item.procedureid() <> body.functionid() then iterate
      if item.kind() = 'procedure' then iterate
      if item.kind() = 'instruction' then do
        /* The checked target CFG and shared scalar facts own control
