  status: method = .string
    return _status
  reason: method = .string
    return _reason
  operation: method = .int
    arg original = .int
    return _operations[original]
  bindings: method = .object[]
    request = .binding; result = .object[]; i = .int; body = .int
    do i = 1 to _input[0]
      request = _input[i] as .binding
      if _callpair[request.callid()] > 0 then body = _pairfunction[_callpair[request.callid()]]
      else body = _functions[request.bodyid()]
      result[i] = .binding(reference _module,_operations[request.callid()],reference _module,body) as .object
    end
    return result
  surrogate: method = .int
    arg name = .string, target = reference .lltarget..draft
    draft = dereference target
