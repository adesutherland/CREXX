        when verb = 'attribute1' then ignored = code.three(target,'linkattr1',first,second,third,at)
        when verb = 'linktoattribute' then ignored = code.three(target,'linktoattr',first,second,third,at)
        when verb = 'linktoattribute1' then ignored = code.three(target,'linktoattr1',first,second,third,at)
