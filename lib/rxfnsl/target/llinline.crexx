/* cREXX License (MIT). Atomic checked RXAS expansion; cleanup is independent. */
options levelb
namespace llinline expose binding bind decision inspect change expand expandmany copyorigin clonefields
import rxfnsb
import llir
import lltarget
import lltargetremap
import lltargetfacts
import llrxascatalog

binding: class
  _caller = reference .lltarget..module
  _provider = reference .lltarget..module
  _callerid = .int
  _providerid = .int
  _callerstore = reference .llir..arena
  _providerstore = reference .llir..arena
  _call = .int
  _body = .int
  *: factory
    arg caller = reference .lltarget..module, callId = .int, provider = reference .lltarget..module, procedureId = .int
    _caller = caller; _provider = provider; _call = callId; _body = procedureId
    if <refvalid>(caller) = 0 | <refvalid>(provider) = 0 then return
    source = dereference caller; target = dereference provider
    _callerid = source.identity(); _providerid = target.identity()
    graph = dereference source.ir(); _callerstore = graph.storage()
    graph = dereference target.ir(); _providerstore = graph.storage()
    return
  valid: method = .int
    if <refvalid>(_caller) = 0 | <refvalid>(_provider) = 0 | <refvalid>(_callerstore) = 0 | <refvalid>(_providerstore) = 0 then return 0
    source = dereference _caller; target = dereference _provider
    graph = dereference source.ir(); source_store = graph.storage()
    graph = dereference target.ir(); target_store = graph.storage()
    if (source_store <refsame> _callerstore) = 0 | (target_store <refsame> _providerstore) = 0 then return 0
    return source.valid() & target.valid() & source.identity() = _callerid & target.identity() = _providerid
  caller: method = reference .lltarget..module
    return _caller
  provider: method = reference .lltarget..module
    return _provider
  callid: method = .int
    return _call
  bodyid: method = .int
    return _body

bind: procedure = .llinline..binding
  arg caller = reference .lltarget..module, callId = .int, provider = reference .lltarget..module, procedureId = .int
  return .binding(caller,callId,provider,procedureId)

decision: class
  _status = .string
  _reason = .string
  _count = .int
  _first = .int
  _return = .int
  _remaining = .int
  *: factory
    arg status = .string, reason = .string, count = 0, first = 0, returned = 0, remaining = 0
    _status = status; _reason = reason; _count = count; _first = first; _return = returned; _remaining = remaining
    return
  status: method = .string
    return _status
  reason: method = .string
    return _reason
  arguments: method = .int
    return _count
  first: method = .int
    return _first
  returned: method = .int
    return _return
  remaining: method = .int
    return _remaining

/** The profile requires fresh standalone main entry without embedding/reentry
 * or externally installed handlers. Static target facts check the complete
 * root and callees; the profile does not pretend all signals halt. */
inspect: procedure = .llinline..decision
  arg request = .llinline..binding, profile = 'unknown', work = 1000000
  if request.valid() = 0 then return .decision('invalid','binding.expired')
  source = dereference request.caller(); selected = source.at(request.callid())
  if fusedform(selected) > 0 then return inspectfused(request,profile,work)
  if profile = 'closed-main-static-exact-default-halt.v1' then return inspectimports(request,work)
  return inspectlocal(request,profile,work)

/** Private projection has already checked foreign binding and public storage.
 * Keep its selected profile for the single shared facts/expansion algorithm. */
inspectlocal: procedure = .llinline..decision
  arg request = .llinline..binding, profile = .string, work = .int
  source = dereference request.caller(); caller_ref = request.caller(); provider_ref = request.provider()
  if (caller_ref <refsame> provider_ref) = 0 then return .decision('keep','profile.imported.body.pending')
  selected = source.at(request.callid())
  if selected.valid() = 0 then return .decision('invalid','call.identity')
  if selected.kind() <> 'instruction' then return .decision('invalid','call.not.instruction')
  if wordpos(selected.mnemonic(),'call call1 call2 call3 call4') = 0 then return .decision('keep','call.form.pending')
  facts = lltargetfacts..analyse(caller_ref,selected.procedureid(),profile,work)
  if facts.status() <> 'ok' then return .decision(facts.status(),facts.reason())
  if facts.bodyid(request.callid()) = 0 then return .decision('keep','call.form.pending')
  if facts.bodyid(request.callid()) <> request.bodyid() then return .decision('invalid','binding.target.mismatch')
  returnindex = -1
  if facts.returns(request.callid()) = 1 then do
    returned = source.at(facts.returnsite(request.callid(),1))
    if returned.operands() = 1 then do
      value = returned.operand(1)
      if value.kind() = 'R' & value.bank() = 'a' then returnindex = value.index()
    end
  end
  return .decision('legal','closed.root.scalar',facts.arguments(request.callid()),facts.first(request.callid()),returnindex,facts.remaining())

/** One owned publication plus complete original-record and site decisions.
 * A failed batch publishes the unchanged caller; expired input has no result. */
change: class
  _status = .string
  _reason = .string
  _result = .lltarget..module
  _mapping = .int[]
  _callers = .int[]
  _sites = .int[]
  _decisions = .object[]
  _hasresult = .int
  *: factory
    arg status = .string, reason = .string, ?result = .lltarget..module, ?mapping = .int[], ?callers = .int[], ?sites = .int[], ?decisions = .object[]
    _status = status; _reason = reason; _hasresult = ?result
    if ?result then _result = result
    if ?mapping then _mapping = mapping
    if ?callers then _callers = callers
    if ?sites then _sites = sites
    if ?decisions then _decisions = decisions
    return
  status: method = .string
    return _status
  reason: method = .string
    return _reason
  result: method = .lltarget..module
    if _hasresult = 0 then assembler signal "ERROR","LL_INLINE_RESULT: expired input has no result owner"
    return _result
  operation: method = .int
    arg oldId = .int
    if _status <> 'changed' then return oldId
    return _mapping[oldId]
  callers: method = .int
    return _callers[0]
  caller: method = .int
    arg ordinal = .int
    return _callers[ordinal]
  sites: method = .int
    return _sites[0]
  site: method = .int
    arg ordinal = .int
    return _sites[ordinal]
  statusat: method = .string
    arg callid = .int
    do i = 1 to _sites[0]
      if _sites[i] = callid then do; checked = _decisions[i] as .decision; return checked.status(); end
    end
    return 'invalid'
  reasonat: method = .string
    arg callid = .int
    do i = 1 to _sites[0]
      if _sites[i] = callid then do; checked = _decisions[i] as .decision; return checked.reason(); end
    end
    return 'binding.site.unavailable'

/** Compatibility surface; target provenance copying has one shared owner. */
copyorigin: procedure = .llir..origin
  arg owner = reference .llir..module, old = .llir..origin, target = reference .lltarget..draft, source_ref = reference .object[], origin_ref = reference .object[]
  return lltargetremap..copyorigin(owner,old,target,source_ref,origin_ref)

clonefields: procedure = .object[]
  arg input = .lltarget..record, target = .lltarget..bodydraft
  replacements = .object[]; value = .lltarget..operand
  do i = 1 to input.registerrefs()
    value = input.registerref(i); replacements[i] = target.reg(value.bank(),value.index()) as .object
  end
  return lltarget..remapregisters(input,replacements)

/** Exact encoded instruction cells are counted while constructing the private
 * draft; exceeding the cap discards that draft before any result publication. */
emitter: class
  _limit = .int
  _used = .int
  _error = .string
  *: factory
    arg limit = .int
    _limit = limit
    return
  emit: method = .int
    arg target = .lltarget..bodydraft, mnemonic = .string, fields = .object[], at = .llir..origin
    cost = 1 + fields[0]
    if _error <> '' then return 0
    if cost > _limit - _used then do; _error = 'inline.code.cells'; return 0; end
    _used = _used + cost
    return target.emit(mnemonic,fields,at)
  one: method = .int
    arg target = .lltarget..bodydraft, mnemonic = .string, first = .lltarget..operand, at = .llir..origin
    fields = .object[]; fields[1] = first as .object
    return emit(target,mnemonic,fields,at)
  two: method = .int
    arg target = .lltarget..bodydraft, mnemonic = .string, first = .lltarget..operand, second = .lltarget..operand, at = .llir..origin
    fields = .object[]; fields[1] = first as .object; fields[2] = second as .object
    return emit(target,mnemonic,fields,at)
  error: method = .string
    return _error

freshidentity: procedure = .void
  arg expose pairs = .int[], old = .int, expose highest = .int
  if old <= 0 then return
  do i = 1 to pairs[0] by 2
    if pairs[i] = old then return
  end
  if highest >= 4294967295 then assembler signal "ERROR","LL_RESOURCE_LIMIT: source/clause identity extent"
  highest = highest + 1; n = pairs[0]; pairs[n + 1] = old; pairs[n + 2] = highest
  return

/** Request-local metadata names use the target draft's work/byte preflight.
 * Owned rows are charged before growth; no factory-local handle escapes. */
metascopes: class
  _owner = reference .lltarget..draft
  _names = .binary[]
  _sourcefn = .int[]
  _sourcerecord = .int[]
  _sourcearity = .int[]
  _sourcekind = .int[]
  _sourcecount = .int
  _suffixes = .string[]
  _branched = .int[]
  _dag = .int[]
  _continuations = .string[]
  _labelsites = .int[]
  _labelarms = .int[]
  _oldlabels = .binary[]
  _newlabels = .string[]
  _serial = .int
  _catalog = .llrxascatalog..catalog
  _bindings = .binary[]
  _active = .int[]
  _opening = .lltarget..operand[]
  _openorigin = .llir..origin[]
  _entryactive = .int[]
  _entryfields = .lltarget..operand[]
  _entryorigin = .llir..origin[]
  _entrycount = .int
  _start = .int
  _held = .int
  *: factory
    arg owner = reference .lltarget..draft
    _owner = owner; _catalog = .llrxascatalog..catalog()
    return
  claim: method = .int
    arg work = .int, bytes = 0
    draft = dereference _owner
    if bytes < 0 | bytes > 2147483647 - _held then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline metadata name bytes"
    if draft.preflight(work,_held + bytes) = 0 then return 0
    _held = _held + bytes
    return 1
  remember: method = .void
    arg name = .binary
    if claim(<blen>(name) + 1,<blen>(name) + 24) = 0 then return
    _names[_names[0] + 1] = name
    return
  seed: method = .void
    arg item = .lltarget..record
    if item.kind() = 'instruction' then do
      flow = _catalog.flow(item.opcode())
      if flow = 1 | flow = 2 then call markbranch(item.procedureid())
      return
    end
    if item.kind() = 'label' then call markbranch(item.procedureid())
    if item.kind() <> '.meta' & item.kind() <> 'label' & item.kind() <> '.const' then return
    name = item.operand(1)
    if claim(1,32) = 0 then return
    call remember(name.bytes())
    _sourcecount = _names[0]
    _sourcefn[_sourcecount] = item.procedureid(); _sourcerecord[_sourcecount] = item.id()
    _sourcearity[_sourcecount] = 0
    _sourcekind[_sourcecount] = item.kind() = 'label'
    if item.kind() = '.meta' then _sourcearity[_sourcecount] = item.operands()
    return
  markbranch: method = .void
    arg functionid = .int
    growth = max(0,functionid - _branched[0])
    if growth > 2147483647 / 8 then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline branch index"
    if claim(1,growth * 8) = 0 then return
    _branched[functionid] = 1
    return
  guard: method = .int
    arg work = .int, bytes = 0
    draft = dereference _owner
    if bytes < 0 | bytes > 2147483647 - _held then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline metadata temporary bytes"
    return draft.preflight(work,_held + bytes)
  /** Account transient remap/constructor rows before borrowing the original
   * payload into them. Record storage itself stays with the frozen source. */
  recordcopies: method = .int
    arg item = .lltarget..record, copies = .int
    i = .int; count = .int; width = .int; value = .lltarget..operand
    count = item.operands()
    if copies < 1 | count > (2147483647 - 64) / 80 / copies then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline group operand copies"
    if claim(count * copies + 1,count * copies * 80 + 64) = 0 then return 0
    do i = 1 to count
      value = item.operand(i); width = value.length()
      if width > 2147483647 / 2 / copies then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline group payload copies"
      if claim(width * copies + 1,width * copies * 2) = 0 then return 0
    end
    return 1
  fieldcopies: method = .int
    arg expose fields = .object[], copies = .int
    i = .int; count = .int; width = .int; value = .lltarget..operand
    count = fields[0]
    if copies < 1 | count > (2147483647 - 64) / 80 / copies then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline source checkpoint copies"
    if claim(count * copies + 1,count * copies * 80 + 64) = 0 then return 0
    do i = 1 to count
      value = fields[i] as .lltarget..operand; width = value.length()
      if width > 2147483647 / 2 / copies then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline source checkpoint bytes"
      if claim(width * copies + 1,width * copies * 2) = 0 then return 0
    end
    return 1
  contains: method = .int
    arg name = .binary
    width = <blen>(name) + 1
    if _names[0] > 2147483647 / width then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline metadata name work"
    if claim(_names[0] * width,0) = 0 then return 1
    do i = 1 to _names[0]
      if bincompare(_names[i],name) = 0 then return 1
    end
    return 0
  prepare: method = .void
    arg functionid = .int, site = .int, slot = .int, facts_ref = reference .lltargetfacts..analysis
    i = .int; attempt = .int; collision = .int; width = .int; arm = .int; selectedgroup = .int; grouped = .int
    suffix = .string
    draft = dereference _owner; facts = dereference facts_ref; attempt = 0
    selectedgroup = facts.argumentruntime(site)
    _dag[slot] = (_branched[functionid] <> 0) | (facts.returns(site) > 1) | (facts.argumentcases(site) > 0)
    do forever
      if claim(1,0) = 0 then return
      suffix = '.$inline.' || site
      if attempt > 0 then suffix = suffix || '.' || attempt
      collision = 0
      do i = 1 to _sourcecount
        if claim(1,0) = 0 then return
        if _sourcefn[i] <> functionid then iterate
        if _sourcearity[i] <> 1 & _sourcearity[i] <> 4 then iterate
        grouped = 0
        if selectedgroup > 0 then grouped = facts.scopeaddress(site,_sourcerecord[i]) = selectedgroup
        if facts.recordlive(site,_sourcerecord[i]) = 0 & facts.scopereentry(site) = 0 & grouped = 0 then iterate
        width = <blen>(_names[i]) + length(suffix)
        if guard(width + 1,width * 3) = 0 then return
        if contains(_names[i] || (suffix as .binary)) then collision = 1
      end
      if draft.error() <> '' then return
      if collision = 0 then leave
      attempt = attempt + 1
    end
    if claim(1,32 + length(suffix)) = 0 then return
    _suffixes[slot] = suffix
    do i = 1 to _sourcecount
      if claim(1,0) = 0 then return
      if _sourcefn[i] <> functionid then iterate
      if _sourcearity[i] <> 1 & _sourcearity[i] <> 4 then iterate
      grouped = 0
      if selectedgroup > 0 then grouped = facts.scopeaddress(site,_sourcerecord[i]) = selectedgroup
      if facts.recordlive(site,_sourcerecord[i]) = 0 & facts.scopereentry(site) = 0 & grouped = 0 then iterate
      width = <blen>(_names[i]) + length(suffix)
      if guard(width + 1,width * 3) = 0 then return
      call remember(_names[i] || (suffix as .binary))
    end
    if _dag[slot] then do
      _continuations[slot] = newlabel(site,''x as .binary)
      do i = 1 to _sourcecount
        if claim(1,0) = 0 then return
        if _sourcefn[i] <> functionid | _sourcekind[i] = 0 then iterate
        grouped = 0
        if selectedgroup > 0 then grouped = facts.scopeaddress(site,_sourcerecord[i]) = selectedgroup
        if facts.recordlive(site,_sourcerecord[i]) = 0 & grouped = 0 then iterate
        ignored = newlabel(site,_names[i])
        do arm = 1 to facts.argumentcases(site)
          if claim(1,0) = 0 then return
          if grouped | facts.argumentcaselive(site,arm,_sourcerecord[i]) then ignored = newlabel(site,_names[i],arm)
        end
      end
    end
    return
  newlabel: method = .string
    arg site = .int, old = .binary, arm = 0
    candidate = .string
    do forever
      if guard(1,192) = 0 then return ''
      if _serial >= 2147483647 then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline label identity extent"
      _serial = _serial + 1; candidate = '_inline.' || site || '.' || _serial
      if contains(candidate as .binary) = 0 then leave
      draft = dereference _owner
      if draft.error() <> '' then return ''
    end
    if claim(<blen>(old) + length(candidate) + 1,<blen>(old) + length(candidate) + 56) = 0 then return ''
    at = _labelsites[0] + 1; _labelsites[at] = site; _labelarms[at] = arm; _oldlabels[at] = old; _newlabels[at] = candidate
    call remember(candidate as .binary)
    return candidate
  label: method = .string
    arg site = .int, old = .binary, arm = 0
    width = <blen>(old) + 1
    if _labelsites[0] > 2147483647 / width then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline label lookup"
    if claim(_labelsites[0] * width,0) = 0 then return ''
    do i = 1 to _labelsites[0]
      if _labelsites[i] <> site then iterate
      if _labelarms[i] <> arm then iterate
      if bincompare(_oldlabels[i],old) = 0 then return _newlabels[i]
    end
    assembler signal "ERROR","LL_INLINE_LABEL: missing live label mapping"
    return ''
  dag: method = .int
    arg slot = .int
    return _dag[slot]
  continuation: method = .string
    arg slot = .int
    return _continuations[slot]
  begin: method = .string
    arg site = .int
    _start = _bindings[0] + 1
    return _suffixes[site]
  observe: method = .void
    arg fields = .object[], at = .llir..origin
    i = .int; k = .int; found = .int; opened = .int; held = .int; width = .int; name = .lltarget..operand; value = .lltarget..operand
    if fields[0] <> 1 & fields[0] <> 4 then return
    name = fields[1] as .lltarget..operand; opened = fields[0] = 4; found = 0
    width = name.length() + 1; count = _bindings[0] - _start + 1
    if count > 2147483647 / width then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline metadata binding work"
    if claim(count * width,0) = 0 then return
    do i = _start to _bindings[0]
      if bincompare(_bindings[i],name.bytes()) = 0 then found = i
    end
    if found = 0 & opened then do
      if claim(name.length() + 1,name.length() + 32) = 0 then return
      found = _bindings[0] + 1; _bindings[found] = name.bytes()
    end
    if found > 0 then do
      _active[found] = opened
      if opened then do
        held = 320
        do k = 1 to 4
          value = fields[k] as .lltarget..operand
          if value.length() > (2147483647 - held) / 2 then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline metadata opening bytes"
          held = held + value.length() * 2
        end
        if claim(held + 4,held) = 0 then return
        do k = 1 to 4; _opening[(found - 1) * 4 + k] = fields[k] as .lltarget..operand; end
        _openorigin[found] = at
      end
    end
    return
  checkpoint: method = .void
    i = .int; k = .int; held = .int; width = .int
    _entrycount = _bindings[0] - _start + 1
    if _entrycount > 2147483647 / 400 then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline metadata checkpoint"
    if claim(_entrycount * 8,_entrycount * 400) = 0 then return
    do i = 1 to _entrycount
      _entryactive[i] = _active[_start + i - 1]
      if _entryactive[i] = 0 then iterate
      held = 0
      do k = 1 to 4
        width = _opening[(_start + i - 2) * 4 + k].length()
        if width > (2147483647 - held) / 2 then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline metadata checkpoint bytes"
        held = held + width * 2
      end
      if claim(held + 4,held) = 0 then return
      do k = 1 to 4; _entryfields[(i - 1) * 4 + k] = _opening[(_start + i - 2) * 4 + k]; end
      _entryorigin[i] = _openorigin[_start + i - 1]
    end
    return
  /** Legacy linear admission has an exact emitted incoming checkpoint too.
   * Restore it through the same delta owner, before any authored group row. */
  resume: method = .void
    arg body = .lltarget..bodydraft, expose code = .emitter, at = .llir..origin
    i = .int; k = .int; count = .int; held = .int; width = .int
    fields = .object[]; origins = .llir..origin[]
    do i = 1 to _entrycount
      if claim(1,0) = 0 then return
      if _entryactive[i] = 0 then iterate
      if claim(8,384) = 0 then return
      held = 0
      do k = 1 to 4
        width = _entryfields[(i - 1) * 4 + k].length()
        if width > (2147483647 - held) / 2 then assembler signal "ERROR","LL_RESOURCE_LIMIT: inline metadata resume bytes"
        held = held + width * 2
      end
      if claim(held + 4,held) = 0 then return
      count = count + 1
      do k = 1 to 4; fields[(count - 1) * 4 + k] = _entryfields[(i - 1) * 4 + k] as .object; end
      origins[count] = _entryorigin[i]
    end
    call reconcile(body,code,fields,origins,at)
    return
  /** Reconcile already-proved mapped descriptors, without interpreting source
   * scopes again. One distinct carrier precedes the untouched authored group. */
  reconcile: method = .void
    arg body = .lltarget..bodydraft, expose code = .emitter, desired = .object[], origins = .llir..origin[], at = .llir..origin
    i = .int; j = .int; k = .int; found = .int; changed = .int; equal = .int; ignored = .int
    name = .lltarget..operand; value = .lltarget..operand; old = .lltarget..operand; fields = .object[]
    do i = _start to _bindings[0]
      if claim(1,0) = 0 then return
      if _active[i] = 0 then iterate
      found = 0
      do j = 1 to origins[0]
        name = desired[(j - 1) * 4 + 1] as .lltarget..operand
        if claim(name.length() + <blen>(_bindings[i]) + 1,0) = 0 then return
        if bincompare(name.bytes(),_bindings[i]) = 0 then found = 1
      end
      if found then iterate
      if claim(<blen>(_bindings[i]) + 1,<blen>(_bindings[i]) + 64) = 0 then return
      call objectarraydrop fields
      fields[1] = .lltarget..operand.string(_bindings[i]) as .object
      ignored = body.record('.meta',fields,at); call observe(fields,at); changed = 1
    end
    do j = 1 to origins[0]
      name = desired[(j - 1) * 4 + 1] as .lltarget..operand; found = 0; equal = 0
      do i = _start to _bindings[0]
        if claim(name.length() + <blen>(_bindings[i]) + 1,0) = 0 then return
        if _active[i] & bincompare(name.bytes(),_bindings[i]) = 0 then found = i
      end
      if found > 0 then do
        equal = 1
        do k = 1 to 4
          value = desired[(j - 1) * 4 + k] as .lltarget..operand; old = _opening[(found - 1) * 4 + k]
          if claim(value.length() + old.length() + 1,0) = 0 then return
          if value.kind() <> old.kind() | value.bank() <> old.bank() | value.index() <> old.index() then equal = 0
          if bincompare(value.bytes(),old.bytes()) <> 0 then equal = 0
        end
      end
      if equal then iterate
      if claim(8,320) = 0 then return
      call objectarraydrop fields
      do k = 1 to 4
        value = desired[(j - 1) * 4 + k] as .lltarget..operand
        if claim(value.length() + 1,value.length() * 2) = 0 then return
        fields[k] = value as .object
      end
      ignored = body.record('.meta',fields,origins[j]); call observe(fields,origins[j]); changed = 1
    end
    if changed then do
      if claim(1,64) = 0 then return
      call objectarraydrop fields
      ignored = code.emit(body,'cnop',fields,at)
    end
    return
  hasbindings: method = .int
    if claim(_bindings[0] - _start + 1,0) = 0 then return 0
    do i = _start to _bindings[0]
      if _active[i] then return 1
    end
    return 0
  closings: method = .int
    return _bindings[0] - _start + 1
  active: method = .int
    arg ordinal = .int
    return _active[_start + ordinal - 1]
  name: method = .binary
    arg ordinal = .int
    return _bindings[_start + ordinal - 1]
/** Original encoded-slot ordinal, independent of active storage/permutation. */
slotordinal: procedure = .int
  arg value = .lltarget..operand, locals = .int, arguments = .int
  if value.bank() = 'r' & value.index() < locals then return value.index()
  if value.bank() = 'a' & value.index() <= arguments then return locals + value.index()
  assembler signal "ERROR","LL_INLINE: register outside proved callee slots"
  return -1

mappedslot: procedure = .lltarget..operand
  arg body = .lltarget..bodydraft, value = .lltarget..operand, base = .int, locals = .int, arguments = .int, ordered = .int
  /* The admitted same-module profile proves canonical global bindings. These
   * cells retain their module owner; they are outside both private r regions. */
  if value.bank() = 'g' then return body.reg('g',value.index())
  if ordered then return body.reg('r',base + locals + arguments + 3 + slotordinal(value,locals,arguments))
  if value.bank() = 'r' then return body.reg('r',base + arguments + 3 + value.index())
  if value.index() = 0 then return body.reg('r',base + arguments + 1)
  return body.reg('r',base + value.index())

expand: procedure = .llinline..change
  arg request = .llinline..binding, profile = 'unknown', work = 1000000, entries = 1000000, bytes = 67108864, frame = 65536, cells = 1000000
  bindings = .object[]; bindings[1] = request as .object
  return expandmany(bindings,profile,work,entries,bytes,frame,cells)

expandmany: procedure = .llinline..change
  arg bindings = .object[], profile = 'unknown', work = 1000000, entries = 1000000, bytes = 67108864, frame = 65536, cells = 1000000
  request = .binding; selected = .lltarget..record
  do i = 1 to bindings[0]
    if bindings[i] is .binding then do
      request = bindings[i] as .binding
      if request.valid() then do
        source = dereference request.caller(); selected = source.at(request.callid())
        if fusedform(selected) > 0 then return expandfusedmany(bindings,profile,work,entries,bytes,frame,cells)
      end
    end
  end
  if profile = 'closed-main-static-exact-default-halt.v1' then return expandimports(bindings,work,entries,bytes,frame,cells)
  return expandlocalmany(bindings,profile,work,entries,bytes,frame,cells)

/** Canonical signatures, not a mnemonic-only interpretation of opaque calls. */
fusedform: procedure = .int
  arg item = .lltarget..record
  if item.valid() = 0 then return 0
  if item.kind() <> 'instruction' then return 0
  catalog = .llrxascatalog..catalog(); opcode = item.opcode()
  if opcode = catalog.find('swapcall','RPRRR') then return 1
  if opcode = catalog.find('settpswapcall','RPRRIR') then return 2
  if opcode = catalog.find('settpcall','RPRRI') then return 3
  return 0

/** One request owns all stages. Work quarters cover discovery/tables/maps,
 * projection construction/validation, ordinary proof/expansion and translation.
 * Entries/bytes are partitioned among tables, projection and expanded owner;
 * encoded cells between the two code owners. Unused quotas are not borrowed. */
fusedprojection: class
  _input = .object[]
  _owner = reference .lltarget..module
  _module = .lltarget..module
  _operations = .int[]
  _functions = .int[]
  _kinds = .int[]
  _sites = .int[]
  _fused = .int[]
  _same = .int[]
  _decisions = .object[]
  _work = .int
  _tableentries = .int
  _tablebytes = .int
  _entries = .int
  _bytes = .int
  _cells = .int
  _stage = .int
  _status = .string
  _reason = .string
  _hasowner = .int
  _trigger = .int
  *: factory
    arg bindings = .object[], work = .int, entries = .int, bytes = .int, cells = .int
    _input = bindings; _stage = work / 4; _work = _stage
    _entries = entries / 3; _bytes = bytes / 3; _cells = cells / 2
    _tableentries = _entries; _tablebytes = _bytes; _status = 'building'
    return
  fail: method = .int
    arg status = .string, reason = .string
    _status = status; _reason = reason; return 0
  spend: method = .int
    arg count = .int
    if count < 0 | count > _work then return fail('limit','fused.work')
    _work = _work - count; return 1
  reserve: method = .int
    arg count = .int, width = .int
    if count < 0 | width < 1 | count > _tableentries then return fail('limit','fused.entries')
    if count > _tablebytes / width then return fail('limit','fused.bytes')
    _tableentries = _tableentries - count; _tablebytes = _tablebytes - count * width
    return 1
  modelerror: method = .int
    arg reason = .string
    status = 'invalid'
    if pos('LL_RESOURCE_LIMIT',reason) > 0 then status = 'limit'
    return fail(status,reason)
  prepare: method = .void
    bindings = _input; request = .binding; previous = .binding
    item = .lltarget..record; value = .lltarget..operand; body = .lltarget..body
    draft = .lltarget..draft; targetbody = .lltarget..bodydraft; at = .llir..origin
    fields = .object[]; prefix = .object[]; bodies = .object[]; sources = .object[]; origins = .object[]
    i = .int; j = .int; ignored = .int; kind = .int; firstkeep = .int; root = .int
    do
    if bindings[0] = 0 then do; ignored = fail('keep','binding.empty'); return; end
    if bindings[1] is .binding then request = bindings[1] as .binding
    else do; ignored = fail('invalid','binding.type'); return; end
    if request.valid() = 0 then do; ignored = fail('invalid','binding.expired'); return; end
    _owner = request.caller(); _hasowner = 1; source = dereference _owner; graph = dereference source.ir(); store = dereference graph.storage()
    if _stage < 1 | _entries < 1 | _bytes < 1 | _cells < 1 then do; ignored = fail('limit','fused.allowances'); return; end
    /* Sparse target record IDs belong to the arena's full operation domain. */
    if reserve(graph.operations() * 3,16) = 0 | reserve(graph.functions() * 2,64) = 0 then return
    if reserve(store.count(8) + store.count(9),128) = 0 | reserve(bindings[0] * 12,128) = 0 then return
    root = source.procedureid('main')
    do i = 1 to bindings[0]
      if spend(1 + i) = 0 then return
      if bindings[i] is .binding then request = bindings[i] as .binding
      else do; ignored = fail('invalid','binding.type'); return; end
      if request.valid() = 0 then do; ignored = fail('invalid','binding.expired'); return; end
      caller_ref = request.caller(); provider_ref = request.provider()
      if (caller_ref <refsame> _owner) = 0 then do; ignored = fail('invalid','binding.foreign.caller'); return; end
      do j = 1 to i - 1
        previous = bindings[j] as .binding
        if previous.callid() = request.callid() then do; ignored = fail('invalid','binding.duplicate.site'); return; end
      end
      item = source.at(request.callid())
      if item.valid() = 0 then do; ignored = fail('invalid','call.identity'); return; end
      if item.kind() <> 'instruction' then do; ignored = fail('invalid','call.not.instruction'); return; end
      _sites[i] = item.id(); kind = fusedform(item); _fused[i] = kind; _same[i] = caller_ref <refsame> provider_ref
      reason = ''
      if root = 0 | item.procedureid() <> root then reason = 'signal.root.context.unproved'
      else if kind = 0 & wordpos(item.mnemonic(),'call call1 call2 call3 call4') = 0 then reason = 'call.form.pending'
      else if _same[i] = 0 then reason = 'profile.imported.body.pending'
      else if kind > 0 then do
        value = item.operand(2); actualbody = source.procedureid(value.text())
        if actualbody = 0 then reason = 'body.unavailable'
        else if actualbody <> request.bodyid() then do; ignored = fail('invalid','binding.target.mismatch'); return; end
        else if source.globals() > 0 then reason = 'global.counted.call.pending'
      end
      if reason <> '' then do
        _decisions[i] = .decision('keep',reason) as .object
        if kind > 0 & firstkeep = 0 then firstkeep = i
      end
      else _decisions[i] = .decision('candidate','') as .object
      if kind > 0 then _kinds[item.id()] = kind
    end
    if firstkeep > 0 then do
      _trigger = firstkeep; checked = _decisions[firstkeep] as .decision; ignored = fail('keep',checked.reason()); return
    end
    /* Existing named/event handler lanes use this profile too. Do not acquire
     * them accidentally through the ordinary-call proof after defusion. */
    do i = 1 to source.records()
      if spend(1) = 0 then return
      item = source.record(i)
      if item.procedureid() = root & item.kind() = 'instruction' then do
        if left(item.mnemonic(),3) = 'sig' then do; ignored = fail('keep','signal.fused.scope.pending'); return; end
      end
    end
    draft = .lltarget..draft(source.name(),source.artifact(),source.globals(),_entries,_bytes,_stage)
    code = .emitter(_cells); graph_ref = source.ir()
    do i = 1 to source.records()
      item = source.record(i)
      if draft.preflight(1 + item.operands() + item.registerrefs(),0) = 0 then do; ignored = modelerror(draft.error()); return; end
      at = copyorigin(graph_ref,item.origin(),reference draft,reference sources,reference origins)
      if draft.error() <> '' then do; ignored = modelerror(draft.error()); return; end
      if item.kind() = 'procedure' then do
        if draft.preflight(source.procedures(),0) = 0 then do; ignored = modelerror(draft.error()); return; end
        body = source.body(item.procedureid()); targetbody = draft.procedure(body.name(),body.locals(),at,body.expose())
        bodies[item.procedureid()] = targetbody as .object; _functions[item.procedureid()] = targetbody.functionid()
        _operations[item.id()] = targetbody.headerid(); iterate
      end
      if item.procedureid() = 0 then do
        call objectarraydrop fields
        do j = 1 to item.operands(); fields[j] = item.operand(j) as .object; end
        _operations[item.id()] = draft.record(item.kind(),fields,at); iterate
      end
      targetbody = bodies[item.procedureid()] as .lltarget..bodydraft; fields = clonefields(item,targetbody); kind = _kinds[item.id()]
      if kind > 0 then do
        if kind > 1 then do
          call objectarraydrop prefix; prefix[1] = fields[4]; prefix[2] = fields[5]
          ignored = code.emit(targetbody,'settp',prefix,at)
        end
        if kind < 3 then do
          call objectarraydrop prefix; prefix[1] = fields[4]
          if kind = 1 then prefix[2] = fields[5]
          else prefix[2] = fields[6]
          ignored = code.emit(targetbody,'swap',prefix,at)
        end
        call objectarraydrop prefix
        do j = 1 to 3; prefix[j] = fields[j]; end
        _operations[item.id()] = code.emit(targetbody,'call',prefix,at)
      end
      else if item.kind() = 'instruction' then _operations[item.id()] = code.emit(targetbody,item.mnemonic(),fields,at)
      else _operations[item.id()] = targetbody.record(item.kind(),fields,at)
      if code.error() <> '' then do; ignored = fail('limit',code.error()); return; end
    end
    if draft.error() <> '' then do; ignored = modelerror(draft.error()); return; end
    _module = draft.finish()
    if _module.valid() = 0 then do; ignored = modelerror(_module.error()); return; end
    _status = 'ok'
    return
    on signal as problem
      status = 'invalid'
      if pos('LL_RESOURCE_LIMIT',problem.message()) > 0 then status = 'limit'
      ignored = fail(status,'LL_FUSED: ' || problem.name() || ': ' || problem.message())
    end
    return
  status: method = .string
    return _status
  reason: method = .string
    return _reason
  bindings: method = .object[]
    result = .object[]; request = .binding; provider = reference .lltarget..module
    do i = 1 to _input[0]
      request = _input[i] as .binding
      if _same[i] then result[i] = .binding(reference _module,_operations[request.callid()],reference _module,_functions[request.bodyid()]) as .object
      else do
        provider = request.provider()
        result[i] = .binding(reference _module,_operations[request.callid()],provider,request.bodyid()) as .object
      end
    end
    return result
  refusal: method = .llinline..change
    arg status = .string, reason = .string
    request = .binding; checked = .decision
    sites = .int[]; decisions = .object[]; empty = .int[]; callers = .int[]
    do i = 1 to _input[0]
      if _input[i] is .binding then do
        request = _input[i] as .binding; sites[sites[0] + 1] = request.callid()
        if i <= _decisions[0] then checked = _decisions[i] as .decision
        else checked = .decision('candidate','')
        if checked.status() <> 'keep' then do
          if status = 'keep' & _trigger > 0 then checked = .decision('keep','batch.fused.site.retained')
          else checked = .decision(status,reason)
        end
        decisions[decisions[0] + 1] = checked as .object
      end
    end
    if _hasowner = 0 then return .change(status,reason)
    source = dereference _owner
    return .change(status,reason,source,empty,callers,sites,decisions)
  translate: method = .llinline..change
    arg changed = .llinline..change, work = .int
    decisions = .object[]; mapping = .int[]; callers = .int[]; checked = .decision; request = .binding
    source = dereference _owner; i = .int; old = .int; refused = 0
    do i = 1 to _sites[0]
      if work < 1 then return refusal('limit','fused.translation.work')
      work = work - 1
      if changed.sites() = 0 then checked = .decision(changed.status(),changed.reason())
      else checked = .decision(changed.statusat(_operations[_sites[i]]),changed.reasonat(_operations[_sites[i]]))
      if changed.status() <> 'changed' & checked.status() = 'changed' then checked = .decision(changed.status(),changed.reason())
      if _fused[i] > 0 & checked.status() <> 'changed' & refused = 0 then refused = i
      _decisions[i] = checked as .object
    end
    if changed.status() <> 'changed' then do
      if changed.status() = 'keep' & refused > 0 then do
        checked = _decisions[refused] as .decision
        return refusal('keep',checked.reason())
      end
      return refusal(changed.status(),changed.reason())
    end
    if refused > 0 then do
      checked = _decisions[refused] as .decision
      do i = 1 to _decisions[0]
        previous = _decisions[i] as .decision
        if previous.status() = 'changed' then _decisions[i] = .decision('keep','batch.fused.site.retained') as .object
      end
      return refusal('keep',checked.reason())
    end
    do i = 1 to source.records()
      if work < 1 then return refusal('limit','fused.translation.work')
      work = work - 1; input = source.record(i); old = _operations[input.id()]
      if _kinds[input.id()] > 0 then mapping[input.id()] = 0
      else mapping[input.id()] = changed.operation(old)
    end
    do i = 1 to changed.callers(); callers[i] = changed.caller(i); end
    return .change('changed','closed.root.scalar',changed.result(),mapping,callers,_sites,_decisions)

expandfusedmany: procedure = .llinline..change
  arg bindings = .object[], profile = .string, work = .int, entries = .int, bytes = .int, frame = .int, cells = .int
  request = .binding
  if bindings[1] is .binding then request = bindings[1] as .binding
  else return .change('invalid','binding.type')
  if request.valid() = 0 then return .change('invalid','binding.expired')
  source = dereference request.caller()
  if work < 4 | entries < 3 | bytes < 3 | cells < 2 | frame < 0 then return importrefusal(bindings,'limit','fused.allowances',source)
  prepared = .fusedprojection(bindings,work,entries,bytes,cells)
  call prepared.prepare()
  if prepared.status() <> 'ok' then return prepared.refusal(prepared.status(),prepared.reason())
  if profile <> 'closed-main-default-halt.v1' then return prepared.refusal('keep','profile.signal.policy.unproved')
  projected = prepared.bindings()
  changed = expandlocalmany(projected,profile,work / 4,entries / 3,bytes / 3,frame,cells / 2)
  return prepared.translate(changed,work / 4)

inspectfused: procedure = .llinline..decision
  arg request = .binding, profile = .string, work = .int
  bindings = .object[]; bindings[1] = request as .object
  if work < 4 then return .decision('limit','fused.allowances')
  prepared = .fusedprojection(bindings,work,1000000,67108864,2000000)
  call prepared.prepare()
  if prepared.status() <> 'ok' then return .decision(prepared.status(),prepared.reason())
  if profile <> 'closed-main-default-halt.v1' then return .decision('keep','profile.signal.policy.unproved')
  projected = prepared.bindings(); selected = projected[1] as .binding
  return inspectlocal(selected,profile,work / 4)

/** The sole expansion algorithm. Imported bodies enter it only after checked
 * private projection; no projected definition can reach public output. */
expandlocalmany: procedure = .llinline..change
  arg bindings = .object[], profile = 'unknown', work = 1000000, entries = 1000000, bytes = 67108864, frame = 65536, cells = 1000000
  i = .int; j = .int; k = .int; a = .int; ignored = .int; count = .int; required = .int
  locals = .int; base = .int; higheststep = .int; highestclause = .int
  extent = .int; fileid = .int; hasresult = .int; ordered = .int; slots = .int; activebase = .int; position = .int
  dag = .int; choice = .int; flow = .int; pairleft = .int; pairright = .int; abrupt = .int; samepair = .int
  direct = .int; callerstep = .int
  runtime = .int; runtimearm = .int; runtimestart = .int; runtimeextent = .int; restores = .int
  runtimeid = .int; runtimefirst = .int; runtimegroup = .int; runtimegroupstep = .int
  lexical = .int; scopeaddress = .int; lastscopeaddress = .int; scopeid = .int; groupalive = .int
  desiredscopes = .object[]; desiredorigins = .llir..origin[]; emptyorigins = .llir..origin[]
  runtimeentryscopes = .object[]; runtimeentryorigins = .llir..origin[]
  scoperecord = .lltarget..record; scopeorigin = .llir..origin; carrierorigin = .llir..origin
  caseLabels = .string[]; compare = .lltarget..operand; selectorcopy = .lltarget..operand
  catalog = .llrxascatalog..catalog
  scope = .string; status = .string; action = .string; scopes = .metascopes
  request = .binding; selected = .lltarget..record; input = .lltarget..record; childrecord = .lltarget..record; swaprecord = .lltarget..record
  field = .lltarget..operand; oldresult = .lltarget..operand; value = .lltarget..operand
  resultcell = .lltarget..operand; countcell = .lltarget..operand; tempcell = .lltarget..operand
  destination = .lltarget..operand; anchor = .lltarget..operand; actual = .lltarget..operand; mapped = .lltarget..operand
  nextleft = .lltarget..operand; nextright = .lltarget..operand
  callee = .lltarget..body; oldbody = .lltarget..body; caller = .lltarget..body
  at = .llir..origin; childat = .llir..origin; runtimeorigin = .llir..origin; file = .llir..sourcefile
  ignoredorigin = .llir..origin
  targetbody = .lltarget..bodydraft; fields = .object[]; replacements = .object[]
  empty = .int[]; callers = .int[]; sites = .int[]; decisions = .object[]; maps = .int[]
  steps = .int[]; clauses = .int[]
  lastchildstep = .object[]; runtimestep = .object[]
  contributors = .object[]
  if bindings[0] = 0 then return .change('keep','binding.empty')
  if bindings[1] is .binding then request = bindings[1] as .binding
  else return .change('invalid','binding.type')
  if request.valid() = 0 then return .change('invalid','binding.expired')
  owner = request.caller(); source = dereference owner; selected = source.at(request.callid())
  if selected.valid() = 0 then return .change('invalid','call.identity',source,empty)
  functionid = source.procedureid('main')
  if functionid > 0 then caller = source.body(functionid)
  if work < 1 | entries < 1 | bytes < 1 | frame < 0 | cells < 1 then return .change('limit','inline.allowances',source,empty)
  accepted = .int[]; offsets = .int[]; compares = .int[]; selectedcount = 0
  do i = 1 to bindings[0]
    if bindings[i] is .binding then request = bindings[i] as .binding
    else return .change('invalid','binding.type',source,empty)
    if request.valid() = 0 then return .change('invalid','binding.expired',source,empty)
    caller_ref = request.caller(); provider_ref = request.provider()
    if (caller_ref <refsame> owner) = 0 then return .change('invalid','binding.foreign.caller',source,empty)
    do j = 1 to sites[0]
      if sites[j] = request.callid() then return .change('invalid','binding.duplicate.site',source,empty)
    end
    sites[i] = request.callid()
    selected = source.at(request.callid())
    if selected.valid() = 0 then return .change('invalid','call.identity',source,empty)
    if selected.kind() <> 'instruction' then return .change('invalid','call.not.instruction',source,empty)
    if functionid = 0 | selected.procedureid() <> functionid then decisions[i] = .decision('keep','signal.root.context.unproved') as .object
    else if wordpos(selected.mnemonic(),'call call1 call2 call3 call4') = 0 then decisions[i] = .decision('keep','call.form.pending') as .object
    else if (provider_ref <refsame> owner) = 0 then decisions[i] = .decision('keep','profile.imported.body.pending') as .object
    else do; accepted[request.callid()] = i; selectedcount = selectedcount + 1; end
  end
  if selectedcount = 0 then do
    checked = decisions[1] as .decision
    return .change('keep',checked.reason(),source,empty,callers,sites,decisions)
  end
  facts = lltargetfacts..analyse(owner,functionid,profile,work,bytes)
  if facts.status() <> 'ok' then do
    do i = 1 to sites[0]
      if accepted[sites[i]] > 0 then decisions[i] = .decision(facts.status(),facts.reason()) as .object
    end
    return .change(facts.status(),facts.reason(),source,empty,callers,sites,decisions)
  end
  work = facts.remaining(); locals = caller.locals()
  do i = 1 to bindings[0]
    request = bindings[i] as .binding
    if accepted[request.callid()] = 0 then iterate
    selected = source.at(request.callid())
    if selected.procedureid() <> functionid then return .change('invalid','binding.foreign.procedure',source,empty)
    if facts.bodyid(request.callid()) <> request.bodyid() then return .change('invalid','binding.target.mismatch',source,empty)
    callee = source.body(request.bodyid()); count = facts.arguments(request.callid())
    /* The checked caller-owned event/guarded-owner lanes also use this exact
     * read-only mapping. Their authored COPY/guard/NULL rows stay in place;
     * no fresh lifetime or handler machinery is introduced here. */
    if facts.handlerdirect(request.callid()) then required = 0
    else if facts.rebinding(request.callid()) | facts.orderedslots(request.callid()) then do
      if frame < 2 | count >= frame then return .change('limit','inline.frame',source,empty)
      if callee.locals() > frame - count - 1 then return .change('limit','inline.frame',source,empty)
      slots = callee.locals() + count + 1
      if slots > (frame - 2) / 2 then return .change('limit','inline.frame',source,empty)
      required = slots * 2 + 2
    end
    else do
      required = count + 3
      if required > frame then return .change('limit','inline.frame',source,empty)
      if callee.locals() > frame - required then return .change('limit','inline.frame',source,empty)
      required = required + callee.locals()
    end
    if facts.argumentcases(request.callid()) > 0 then do
      if required >= frame - locals then return .change('limit','inline.frame',source,empty)
      compares[request.callid()] = locals + required; required = required + 1
    end
    if required > frame - locals then return .change('limit','inline.frame',source,empty)
    offsets[request.callid()] = locals; locals = locals + required
    decisions[i] = .decision('changed','closed.root.scalar',count,facts.first(request.callid())) as .object
  end
  do i = 1 to source.records()
    input = source.record(i)
    if input.kind() = '.srcstep' then do
      value = input.operand(1); higheststep = max(higheststep,value.index())
      value = input.operand(2); highestclause = max(highestclause,value.index())
    end
    else if input.kind() = '.traceevent' then do
      value = input.operand(7); higheststep = max(higheststep,value.index())
      value = input.operand(8); highestclause = max(highestclause,value.index())
    end
  end
  do
    result = .lltarget..draft(source.name(),source.artifact(),source.globals(),entries,bytes,work)
    if result.error() <> '' then do
      status = 'invalid'
      if pos('LL_RESOURCE_LIMIT',result.error()) > 0 then status = 'limit'
      return .change(status,result.error(),source,empty)
    end
    code = .emitter(cells); catalog = .llrxascatalog..catalog()
    bodies = .object[]; sources = .object[]; origins = .object[]
    graph_ref = source.ir(); generated = result.synthetic('inline scalar transport')
    scopes = .metascopes(reference result)
    if sites[0] > 2147483647 / 32 then return .change('limit','inline.metadata.names',source,empty)
    if scopes.claim(1,sites[0] * 32) = 0 then return .change('limit',result.error(),source,empty)
    /* Reserve every authored metadata name. The label/constant names remain
     * reserved too; no authored or generated name is mistaken for a clear. */
    do i = 1 to source.records()
      if scopes.claim(1,0) = 0 then return .change('limit',result.error(),source,empty)
      input = source.record(i)
      call scopes.seed(input)
    end
    do i = 1 to sites[0]
      if accepted[sites[i]] = 0 then iterate
      call scopes.prepare(facts.bodyid(sites[i]),sites[i],accepted[sites[i]],reference facts)
      if result.error() <> '' then return .change('limit',result.error(),source,empty)
    end
    do i = 1 to source.records()
      if scopes.guard(1) = 0 then return .change('limit',result.error(),source,empty)
      input = source.record(i); at = copyorigin(graph_ref,input.origin(),reference result,reference sources,reference origins)
