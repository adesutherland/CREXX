/* cREXX License (MIT). Optional typed RXAS records and whole-cell assignment. */
options levelb
namespace llrxas expose program allocation assignment assignmentresult typedreset
import rxfnsb
import llrxascatalog

fail: procedure = .void
  arg message = .string
  assembler signal "ERROR",message
  return

/** Selected operands are classified before allocation. Original token spans
 * preserve quoted bytes and metadata; rendering substitutes location tokens only. */
instruction: class
  _mnemonic = .string
  _raw = .string
  _origin = .int
  _opcode = .int
  _parts = .string[]
  _starts = .int[]
  _lengths = .int[]
  _locals = .int[]
  _kinds = .string[]
  _error = .string
  _kind = .string
  *: factory
    arg mnemonic = .string, operands = .string, origin = .int
    _mnemonic = mnemonic; _raw = operands; _origin = origin; _opcode = -1
    _kind = 'instruction'
    return
  parse: method = .void
    arg catalog_ref = reference .llrxascatalog..catalog
    catalog = dereference catalog_ref; mnemonic = _mnemonic; operands = _raw
    if mnemonic = '' then do; _kind = 'metadata'; return; end
    if right(mnemonic,2) = '()' then do; _kind = 'header'; return; end
    if right(mnemonic,1) = ':' then do; _kind = 'label'; return; end
    if left(mnemonic,1) = '.' then do
      _kind = 'metadata'
      if mnemonic = '.traceevent' then _kind = 'trace'
      else if wordpos(mnemonic,'.meta .srcstep .srcfile .srcline .const') = 0 then _kind = 'opaque'
    end
    if _kind = 'metadata' | _kind = 'opaque' then return
    quoted = ''; escaped = 0; start = 1; i = .int; c = .string
    do i = 1 to length(operands) + 1
      c = substr(operands,i,1)
      if quoted <> '' then do
        if escaped then escaped = 0
        else if c = '\' then escaped = 1
        else if c = quoted then quoted = ''
        iterate
      end
      if c = '"' | c = "'" then do; quoted = c; iterate; end
      delimiter = c = ','
      if _kind = 'trace' then delimiter = c = ' ' | c = '09'x
      if delimiter | i > length(operands) then do
        if i > start then call token(start,i - start)
        else if _kind = 'instruction' & operands <> '' then _error = 'LL_RXAS_RECORD: empty operand'
        start = i + 1
      end
    end
    if quoted <> '' then _error = 'LL_RXAS_RECORD: unterminated quoted operand'
    if _kind = 'trace' then do
      if _parts[0] <> 11 then do; _error = 'LL_RXAS_RECORD: TRACE record arity'; return; end
      if _parts[3] = '"R"' & (_parts[5] = '"o"' | _parts[5] = '"r"' | _parts[5] = '"R"') then do
        raw = _parts[6]
        if datatype(raw,'W') = 0 then do; _error = 'LL_RXAS_RECORD: TRACE local location'; return; end
        _kinds[6] = 'local'; _locals[6] = raw as .int
      end
      return
    end
    signature = ''
    do i = 1 to _parts[0]
      signature = signature || _kinds[i]
    end
    _opcode = catalog.find(mnemonic,signature)
    if _opcode < 0 then _error = 'LL_RXAS_RECORD: unknown instruction/operand signature ' || mnemonic || '/' || signature
    return
  token: method = .void
    arg start = .int, size = .int
    do while size > 0 & substr(_raw,start,1) = ' '
      start = start + 1; size = size - 1
    end
    do while size > 0 & substr(_raw,start + size - 1,1) = ' '
      size = size - 1
    end
    if size = 0 then return
    text = substr(_raw,start,size); n = _parts[0] + 1
    _parts[n] = text; _starts[n] = start; _lengths[n] = size
    _locals[n] = -1; _kinds[n] = 'L'
    if _kind = 'trace' then return
    first = left(text,1); suffix = substr(text,2)
    select
      when (first = 'r' | first = 'a' | first = 'g') & datatype(suffix,'W') then do
        if suffix as .int < 0 then _error = 'LL_RXAS_RECORD: negative register'
        _kinds[n] = 'R'
        if first = 'r' then _locals[n] = suffix as .int
      end
      when first = '"' then _kinds[n] = 'S'
      when first = "'" then _kinds[n] = 'C'
      when right(text,2) = '()' then _kinds[n] = 'P'
      when left(text,2) = '0x' then _kinds[n] = 'B'
      when right(lower(text),1) = 'd' & datatype(left(text,length(text) - 1),'N') then _kinds[n] = 'D'
      when datatype(text,'N') & (pos('.',text) > 0 | pos('E',upper(text)) > 0) then _kinds[n] = 'F'
      when datatype(text,'W') then _kinds[n] = 'I'
      when datatype(text,'N') then _kinds[n] = 'F'
      otherwise nop
    end
    return
  error: method = .string
    return _error
  kind: method = .string
    return _kind
  mnemonic: method = .string
    return _mnemonic
  opcode: method = .int
    return _opcode
  origin: method = .int
    return _origin
  operands: method = .int
    return _parts[0]
  operand: method = .string
    arg index = .int
    return _parts[index]
  local: method = .int
    arg index = .int
    return _locals[index]
  render: method = .string
    arg mapping_ref = reference .int[], locals = .int
    mapping = dereference mapping_ref; text = .string; at = .int
    if _kind = 'header' then do
      at = pos('.locals=',_raw)
      if at = 0 then do; call fail('LL_RXAS_RECORD: function header has no locals'); return ''; end
      tail = at + 8
      do while tail <= length(_raw) & datatype(substr(_raw,tail,1),'W')
        tail = tail + 1
      end
      text = left(_raw,at + 7) || locals || substr(_raw,tail)
    end
    else do
      text = ''; at = 1
      do i = 1 to _parts[0]
        v = _locals[i]
        if v < 0 then iterate
        begin = _starts[i]; size = _lengths[i]
        text = text || substr(_raw,at,begin - at)
        if _kind <> 'trace' then text = text || 'r'
        text = text || mapping[v + 1]; at = begin + size
      end
      text = text || substr(_raw,at)
    end
    if text = '' then return _mnemonic
    return _mnemonic || ' ' || text

/** Immutable published result. Failed allocation has neither text nor mapping. */
allocation: class
  _texts = .string[]
  _origins = .int[]
  _mapping = .int[]
  _locals = .int
  _error = .string
  *: factory
    arg texts = .string[], origins = .int[], mapping = .int[], locals = .int, error = .string
    _error = error
    if error = '' then do
      _texts = texts; _origins = origins; _mapping = mapping; _locals = locals
    end
    return
  valid: method = .int
    return _error = ''
  error: method = .string
    return _error
  locals: method = .int
    return _locals
  records: method = .int
    return _texts[0]
  text: method = .string
    arg index = .int
    if _error <> '' then do; call fail(_error); return ''; end
    return _texts[index]
  origin: method = .int
    arg index = .int
    if _error <> '' then do; call fail(_error); return 0; end
    return _origins[index]
  assigned: method = .int
    arg virtual = .int
    if _error <> '' then do; call fail(_error); return -1; end
    return _mapping[virtual + 1]

/** A whole-cell reset immediately before the named source record. The origin
 * is opaque to this owner and is preserved for the consuming emitter. */
typedreset: class
  _virtual = .int
  _physical = .int
  _record = .int
  _origin = .int
  *: factory
    arg virtual = .int, physical = .int, recordId = .int, origin = 0
    _virtual = virtual; _physical = physical; _record = recordId; _origin = origin
    return
  virtual: method = .int
    return _virtual
  physical: method = .int
    return _physical
  recordid: method = .int
    return _record
  origin: method = .int
    return _origin

/** Owned publication; invalid results expose neither assignments nor resets. */
assignmentresult: class
  _mapping = .int[]
  _resets = .object[]
  _locals = .int
  _error = .string
  *: factory
    arg mapping = .int[], locals = .int, resets = .object[], error = ''
    _error = error
    if error = '' then do; _mapping = mapping; _locals = locals; _resets = resets; end
    return
  valid: method = .int
    return _error = ''
  error: method = .string
    return _error
  locals: method = .int
    return _locals
  assigned: method = .int
    arg virtual = .int
    if _error <> '' then do; call fail(_error); return -1; end
    if virtual < 0 | virtual >= _mapping[0] then do; call fail('LL_RXAS_ASSIGNMENT: virtual cell outside map'); return -1; end
    return _mapping[virtual + 1]
  resets: method = .int
    return _resets[0]
  reset: method = .llrxas..typedreset
    arg ordinal = .int
    if _error <> '' then call fail(_error)
    if ordinal < 1 | ordinal > _resets[0] then call fail('LL_RXAS_ASSIGNMENT: reset ordinal outside result')
    return _resets[ordinal] as .typedreset

/** Typed rows own numeric vectors after the assignment owner preflights them.
 * Kills describe definite definitions in the adapter's checked allocation
 * domain; they do not assert that a VM scalar opcode clears an entire value. */
assignmentrow: class
  _refs = .int[]
  _reads = .int[]
  _writes = .int[]
  _kills = .int[]
  _observations = .int[]
  _origin = .int
  *: factory
    arg refs = reference .int[], reads = reference .int[], writes = reference .int[], kills = reference .int[], observations = reference .int[], origin = .int
    references = dereference refs; readings = dereference reads; writings = dereference writes
    killings = dereference kills; observing = dereference observations
    _refs = references; _reads = readings; _writes = writings
    _kills = killings; _observations = observing; _origin = origin
    return
  refs: method = .int
    return _refs[0]
  ref: method = .int
    arg ordinal = .int
    return _refs[ordinal]
  cost: method = .int
    return _refs[0] + _reads[0] + _writes[0] + _kills[0] + _observations[0]
  kind: method = .int
    arg virtual = .int
    result = 0; i = .int
    do i = 1 to _reads[0]; if _reads[i] = virtual then result = result + 1; end
    do i = 1 to _writes[0]; if _writes[i] = virtual then result = result + 2; end
    do i = 1 to _kills[0]; if _kills[i] = virtual then result = result + 4; end
    do i = 1 to _observations[0]; if _observations[i] = virtual then result = result + 8; end
    return result
  origin: method = .int
    return _origin

/** Reconstructed intervals. Allocator and checker each build their own view. */
assignmentlife: class
  _first = .int[]
  _last = .int[]
  _initial = .int[]
  _order = .int[]
  *: factory
    return
  touch: method = .void
    arg virtual = .int, ordinal = .int, initial = .int
    v = virtual + 1
    if _first[v] = 0 then do
      _first[v] = ordinal; _initial[v] = initial; _order[_order[0] + 1] = virtual
    end
    _last[v] = ordinal
    return
  first: method = .int
    arg virtual = .int
    return _first[virtual + 1]
  last: method = .int
    arg virtual = .int
    return _last[virtual + 1]
  initial: method = .int
    arg virtual = .int
    return _initial[virtual + 1]
  size: method = .int
    return _order[0]
  at: method = .int
    arg ordinal = .int
    return _order[ordinal]

/** One bounded whole-cell assignment kernel. Inputs contain checked access
 * premises, not target/module handles. Candidate admission additionally proves
 * successful scalar initialization, equivalent zero entry and absence of
 * hidden status/lifetime/release observations. Pin preserves distinct storage;
 * fixed also preserves the authored physical index. Retain defaults true. */
assignment: class
  _virtual = .int
  _budget = .int
  _work = .int
  _bytes = .int
  _usedbytes = .int
  _physicalcapacity = .int
  _ids = .int[]
  _rows = .object[]
  _candidates = .int[]
  _pinned = .int[]
  _fixed = .int[]
  _required = .int[]
  _window = .int[]
  _edge = .int[]
  _boundaries = .int[]
  _protectfirst = .int[]
  _protectlast = .int[]
  _sealed = .int
  _mode = .string
  _error = .string
  *: factory
    arg virtualLocals = .int, recordIds = reference .int[], registerBudget = .int, work = 1000000, bytes = 67108864
    i = .int; increasing = .int
    if <refvalid>(recordIds) = 0 then do; _error = 'LL_RXAS_ASSIGNMENT: expired record IDs'; return; end
    ids = dereference recordIds
    _virtual = virtualLocals; _budget = registerBudget; _work = work; _bytes = bytes; _mode = 'reuse'
    if virtualLocals < 0 | registerBudget < 0 | work < 1 | bytes < 1 then do; _error = 'LL_RXAS_LIMIT: invalid assignment budgets'; return; end
    if virtualLocals > work | ids[0] > (work - virtualLocals) / 2 then do; _error = 'LL_RXAS_LIMIT: target.work budget'; return; end
    if virtualLocals > bytes / 64 then do; _error = 'LL_RXAS_LIMIT: assignment.bytes'; return; end
    _usedbytes = virtualLocals * 64
    if ids[0] > (bytes - _usedbytes) / 24 then do; _error = 'LL_RXAS_LIMIT: assignment.bytes'; return; end
    _usedbytes = _usedbytes + ids[0] * 24; _work = work - virtualLocals - ids[0] * 2
    increasing = 1
    do i = 1 to ids[0]
      if ids[i] < 1 then do; _error = 'LL_RXAS_ASSIGNMENT: positive record IDs required'; return; end
      if i > 1 then do; if ids[i] <= ids[i - 1] then increasing = 0; end
    end
    if increasing = 0 then do
      if ids[0] > _work / 20 then do; _error = 'LL_RXAS_LIMIT: target.work budget'; return; end
      if ids[0] > (_bytes - _usedbytes) / 32 then do; _error = 'LL_RXAS_LIMIT: assignment.bytes'; return; end
      _work = _work - ids[0] * 20; _usedbytes = _usedbytes + ids[0] * 32
      seen = .stem()
      do i = 1 to ids[0]
        key = ids[i] as .string
        if seen.get(key) <> '' then do; _error = 'LL_RXAS_ASSIGNMENT: duplicate record ID'; return; end
        call seen.set(key,'1')
      end
    end
    _ids = ids
    do i = 1 to virtualLocals; _required[i] = 1; end
    return
  charge: method = .int
    arg cost = .int
    if _error <> '' then return 0
    if cost < 0 | cost > _work then do; _error = 'LL_RXAS_LIMIT: target.work budget'; return 0; end
    _work = _work - cost; return 1
  reserve: method = .int
    arg count = .int, width = .int
    if _error <> '' then return 0
    if count < 0 | width < 1 | count > (_bytes - _usedbytes) / width then do; _error = 'LL_RXAS_LIMIT: assignment.bytes'; return 0; end
    _usedbytes = _usedbytes + count * width; return 1
  error: method = .string
    return _error
  remaining: method = .int
    return _work
  room: method = .int
    arg index = .int
    if _error <> '' then return 0
    if index < 0 | index >= _budget then do; _error = 'LL_RXAS_LIMIT: register budget'; return 0; end
    if index >= _physicalcapacity then do
      if charge(index + 1 - _physicalcapacity) = 0 then return 0
      if reserve(index + 1 - _physicalcapacity,24) = 0 then return 0
      _physicalcapacity = index + 1
    end
    return 1
  cell: method = .int
    arg virtual = .int
    if _error <> '' then return 0
    if _sealed then do; _error = 'LL_RXAS_STATE: assignment already sealed'; return 0; end
    if virtual < 0 | virtual >= _virtual then do; _error = 'LL_RXAS_ASSIGNMENT: cell outside virtual frame'; return 0; end
    return charge(1)
  candidate: method = .void
    arg virtual = .int, kind = 'integer'
    if cell(virtual) = 0 then return
    if kind <> 'integer' & kind <> 'boolean' then do; _error = 'LL_RXAS_ASSIGNMENT: plain scalar candidate required'; return; end
    _candidates[virtual + 1] = 1
    return
  pin: method = .void
    arg virtual = .int
    if cell(virtual) then _pinned[virtual + 1] = 1
    return
  fixed: method = .void
    arg virtual = .int
    if cell(virtual) then do; _fixed[virtual + 1] = 1; _pinned[virtual + 1] = 1; end
    return
  retain: method = .void
    arg virtual = .int, required = 1
    if cell(virtual) = 0 then return
    if required <> 0 & required <> 1 then do; _error = 'LL_RXAS_ASSIGNMENT: retain flag'; return; end
    _required[virtual + 1] = required
    return
  window: method = .void
    arg base = .int, count = .int
    if _error <> '' then return
    if _sealed then do; _error = 'LL_RXAS_STATE: assignment already sealed'; return; end
    if base < 0 | count < 1 | base > _virtual - count then do; _error = 'LL_RXAS_ASSIGNMENT: call window outside frame'; return; end
    if charge(count) = 0 then return
    do i = base + 1 to base + count
      _window[i] = 1
      if i < base + count then _edge[i] = 1
    end
    return
  boundary: method = .void
    arg ordinal = .int
    if _error <> '' then return
    if _sealed then do; _error = 'LL_RXAS_STATE: assignment already sealed'; return; end
    if ordinal < 1 | ordinal > _ids[0] then do; _error = 'LL_RXAS_ASSIGNMENT: boundary outside records'; return; end
    if charge(1) = 0 | reserve(1,8) = 0 then return
    _boundaries[_boundaries[0] + 1] = ordinal
    return
  protect: method = .void
    arg first = .int, last = .int
    if _error <> '' then return
    if _sealed then do; _error = 'LL_RXAS_STATE: assignment already sealed'; return; end
    if first < 1 | first > last | last > _ids[0] then do; _error = 'LL_RXAS_ASSIGNMENT: protected interval outside records'; return; end
    if charge(1) = 0 | reserve(1,16) = 0 then return
    n = _protectfirst[0] + 1; _protectfirst[n] = first; _protectlast[n] = last
    return
  checkvector: method = .int
    arg vector = reference .int[], allowed = reference .int[]
    values = dereference vector; within = dereference allowed; i = .int; j = .int; found = .int
    do i = 1 to values[0]
      if charge(1) = 0 then return 0
      if values[i] < 0 | values[i] >= _virtual then do; _error = 'LL_RXAS_ASSIGNMENT: vector cell outside frame'; return 0; end
      do j = 1 to i - 1
        if charge(1) = 0 then return 0
        if values[i] = values[j] then do; _error = 'LL_RXAS_ASSIGNMENT: duplicate vector member'; return 0; end
      end
      found = 0
      do j = 1 to within[0]
        if charge(1) = 0 then return 0
        if values[i] = within[j] then found = 1
      end
      if found = 0 then do; _error = 'LL_RXAS_ASSIGNMENT: access outside reference set'; return 0; end
    end
    return 1
  row: method = .void
    arg ordinal = .int, refs = reference .int[], reads = reference .int[], writes = reference .int[], kills = reference .int[], observations = reference .int[], origin = 0
    if _error <> '' then return
    if _sealed then do; _error = 'LL_RXAS_STATE: assignment already sealed'; return; end
    if ordinal < 1 | ordinal > _ids[0] then do; _error = 'LL_RXAS_ASSIGNMENT: row outside declared records'; return; end
    if _rows[ordinal] is .assignmentrow then do; _error = 'LL_RXAS_ASSIGNMENT: row already supplied'; return; end
    if <refvalid>(refs) = 0 | <refvalid>(reads) = 0 | <refvalid>(writes) = 0 | <refvalid>(kills) = 0 | <refvalid>(observations) = 0 then do
      _error = 'LL_RXAS_ASSIGNMENT: expired row vector'; return
    end
    rr = dereference refs; rd = dereference reads; wr = dereference writes; kl = dereference kills; ob = dereference observations
    if charge(1) = 0 | reserve(1,64) = 0 then return
    if reserve(rr[0],8) = 0 | reserve(rd[0],8) = 0 | reserve(wr[0],8) = 0 | reserve(kl[0],8) = 0 | reserve(ob[0],8) = 0 then return
    if checkvector(refs,refs) = 0 | checkvector(reads,refs) = 0 | checkvector(writes,refs) = 0 | checkvector(kills,writes) = 0 | checkvector(observations,refs) = 0 then return
    _rows[ordinal] = .assignmentrow(refs,reads,writes,kills,observations,origin) as .object
    return
  scan: method = .assignmentlife
    life = .assignmentlife(); item = .assignmentrow; i = .int; j = .int; v = .int; kind = .int
    if reserve(_virtual,32) = 0 then return life
    do i = 1 to _ids[0]
      if charge(1) = 0 then return life
      if (_rows[i] is .assignmentrow) = 0 then do; _error = 'LL_RXAS_ASSIGNMENT: missing declared row'; return life; end
      item = _rows[i] as .assignmentrow
      do j = 1 to item.refs()
        if charge(item.cost() + 1) = 0 then return life
        v = item.ref(j); kind = item.kind(v)
        call life.touch(v,i,kind % 2 = 0 & kind % 8 >= 4 & kind < 8)
      end
    end
    return life
  eligible: method = .int
    arg virtual = .int, life = .assignmentlife
    v = virtual + 1; i = .int
    if _mode <> 'reuse' | _candidates[v] = 0 | _pinned[v] | _fixed[v] | _window[v] | life.initial(virtual) = 0 then return 0
    do i = 1 to _boundaries[0]
      if charge(1) = 0 then return 0
      if life.first(virtual) < _boundaries[i] & _boundaries[i] <= life.last(virtual) then return 0
    end
    do i = 1 to _protectfirst[0]
      if charge(1) = 0 then return 0
      if life.first(virtual) <= _protectlast[i] & life.last(virtual) >= _protectfirst[i] then return 0
    end
    return 1
  validate: method = .string
    arg mapping_ref = reference .int[], locals = .int, resets_ref = reference .object[]
    if <refvalid>(mapping_ref) = 0 | <refvalid>(resets_ref) = 0 then return 'LL_RXAS_ASSIGNMENT: expired validation input'
    mapping = dereference mapping_ref; resets = dereference resets_ref
    i = .int; k = .int; v = .int; w = .int; assigned = .int; highest = .int; expected = .int; leftok = .int; rightok = .int
    item = .assignmentrow; request = .typedreset
    if _error <> '' then return _error
    if locals < 0 | locals > _budget then return 'LL_RXAS_LIMIT: register budget'
    if mapping[0] <> _virtual then return 'LL_RXAS_ASSIGNMENT: frame or map bound'
    life = scan()
    if _error <> '' then return _error
    if reserve(locals,16) = 0 | reserve(_virtual,8) = 0 then return _error
    if charge(locals) = 0 | charge(locals) = 0 then return _error
    members = .int[]; chain = .int[]; occupied = .int[]; highest = -1
    do v = 0 to _virtual - 1
      if charge(1) = 0 then return _error
      assigned = mapping[v + 1]
      required = life.first(v) > 0 | _required[v + 1] | _pinned[v + 1] | _fixed[v + 1] | _window[v + 1] | _mode = 'identity'
      if assigned = -1 & required = 0 then iterate
      if assigned < 0 | assigned >= locals then return 'LL_RXAS_ASSIGNMENT: physical cell outside frame'
      highest = max(highest,assigned)
      if (_fixed[v + 1] | _mode = 'identity') & assigned <> v then return 'LL_RXAS_ASSIGNMENT: fixed physical cell moved'
      if _edge[v + 1] then do
        if mapping[v + 2] <> assigned + 1 then return 'LL_RXAS_ASSIGNMENT: call window is not contiguous'
      end
      w = members[assigned + 1]
      do while w > 0
        if charge(1) = 0 then return _error
        leftok = eligible(v,life); rightok = eligible(w - 1,life)
        if _error <> '' then return _error
        if leftok = 0 | rightok = 0 then return 'LL_RXAS_ASSIGNMENT: distinct storage cells aliased'
        if life.first(v) <= life.last(w - 1) & life.first(w - 1) <= life.last(v) then return 'LL_RXAS_ASSIGNMENT: interfering scalar cells aliased'
        w = chain[w]
      end
      chain[v + 1] = members[assigned + 1]; members[assigned + 1] = v + 1
    end
    if highest + 1 <> locals then return 'LL_RXAS_ASSIGNMENT: frame or map bound'
    expected = 0
    do k = 1 to life.size()
      if charge(1) = 0 then return _error
      v = life.at(k); assigned = mapping[v + 1]
      leftok = eligible(v,life)
      if _error <> '' then return _error
      if leftok = 0 then iterate
      if occupied[assigned + 1] > 0 then do
        expected = expected + 1
        if expected > resets[0] then return 'LL_RXAS_ASSIGNMENT: missing reset before scalar arrival'
        if (resets[expected] is .typedreset) = 0 then return 'LL_RXAS_ASSIGNMENT: untyped reset'
        request = resets[expected] as .typedreset; i = life.first(v); item = _rows[i] as .assignmentrow
        if request.virtual() <> v | request.physical() <> assigned | request.recordid() <> _ids[i] | request.origin() <> item.origin() then return 'LL_RXAS_ASSIGNMENT: reset order, location or origin'
      end
      occupied[assigned + 1] = v + 1
    end
    if expected <> resets[0] then return 'LL_RXAS_ASSIGNMENT: unexpected reset'
    return _error
  finish: method = .llrxas..assignmentresult
    arg mode = 'reuse'
    mapping = .int[]; resets = .object[]; i = .int; k = .int; v = .int; w = .int
    physical = .int; found = .int; highest = .int; start = .int; last = .int; exact = .int; locals = .int; allowed = .int
    item = .assignmentrow
    if _sealed then return .assignmentresult(mapping,0,resets,'LL_RXAS_STATE: assignment already sealed')
    _sealed = 1; _mode = mode
    if _error = '' & wordpos(mode,'identity dense reuse') = 0 then _error = 'LL_RXAS_ASSIGNMENT: invalid assignment mode'
    if _error <> '' then return .assignmentresult(mapping,0,resets,_error)
    life = scan()
    if _error <> '' then return .assignmentresult(mapping,0,resets,_error)
    if reserve(_virtual,48) = 0 then return .assignmentresult(mapping,0,resets,_error)
    if charge(_virtual) = 0 then return .assignmentresult(mapping,0,resets,_error)
    members = .int[]; chain = .int[]; fixedat = .int[]; occupied = .int[]
    do v = 0 to _virtual - 1; mapping[v + 1] = -1; end
    if mode = 'identity' then do
      if _virtual > _budget then return .assignmentresult(mapping,0,resets,'LL_RXAS_LIMIT: register budget')
      if charge(_virtual) = 0 then return .assignmentresult(mapping,0,resets,_error)
      do v = 0 to _virtual - 1; mapping[v + 1] = v; end
    end
    else do
      /* Fixed members fix their entire overlapping contiguous window group. */
      v = 0
      do while v < _virtual
        if charge(1) = 0 then leave
        if _window[v + 1] then do
          start = v; last = v; exact = _fixed[v + 1]
          do while _edge[last + 1]
            if charge(1) = 0 then leave
            last = last + 1; exact = exact | _fixed[last + 1]
          end
          if exact then do i = start to last
            if room(i) = 0 then leave
            mapping[i + 1] = i; fixedat[i + 1] = 1
          end
          v = last + 1
        end
        else do
          if _fixed[v + 1] then do
            if room(v) = 0 then leave
            mapping[v + 1] = v; fixedat[v + 1] = 1
          end
          v = v + 1
        end
      end
      /* Place complete nonfixed groups before scalar placement can fragment them. */
      v = 0
      do while v < _virtual
        if charge(1) = 0 then leave
        if _window[v + 1] = 0 | mapping[v + 1] >= 0 then do; v = v + 1; iterate; end
        start = v; last = v
        do while _edge[last + 1]
          if charge(1) = 0 then leave
          last = last + 1
        end
        physical = 0; found = 0
        do until found
          found = 1
          do i = 0 to last - start
            if charge(1) = 0 then leave
            if physical + i >= _budget then do; _error = 'LL_RXAS_LIMIT: register budget'; leave; end
            if room(physical + i) = 0 then leave
            if fixedat[physical + i + 1] | members[physical + i + 1] > 0 then found = 0
          end
          if _error <> '' then leave
          if found = 0 then physical = physical + 1
        end
        if _error <> '' then leave
        do i = start to last; mapping[i + 1] = physical + i - start; fixedat[physical + i - start + 1] = 1; end
        v = last + 1
      end
      /* The existing deterministic first-fit over inclusive intervals. */
      do k = 1 to life.size()
        if charge(1) = 0 then leave
        v = life.at(k)
        allowed = eligible(v,life)
        if _error <> '' then leave
        if allowed = 0 then iterate
        physical = 0; found = 0
        do until found
          if charge(1) = 0 then leave
          if room(physical) = 0 then leave
          found = fixedat[physical + 1] = 0; w = members[physical + 1]
          do while w > 0 & found
            if charge(1) = 0 then leave
            if life.first(w - 1) <= life.last(v) & life.first(v) <= life.last(w - 1) then found = 0
            w = chain[w]
          end
          if _error <> '' then leave
          if found = 0 then physical = physical + 1
        end
        if _error <> '' then leave
        mapping[v + 1] = physical; chain[v + 1] = members[physical + 1]; members[physical + 1] = v + 1
      end
      /* All remaining required cells are distinct, with no authored-index pin. */
      do v = 0 to _virtual - 1
        if charge(1) = 0 then leave
        if mapping[v + 1] >= 0 | _window[v + 1] then iterate
        if life.first(v) = 0 & _required[v + 1] = 0 & _pinned[v + 1] = 0 then iterate
        physical = 0
        if room(physical) = 0 then leave
        do while fixedat[physical + 1] | members[physical + 1] > 0
          if charge(1) = 0 then leave
          physical = physical + 1
          if room(physical) = 0 then leave
        end
        if _error <> '' then leave
        mapping[v + 1] = physical; fixedat[physical + 1] = 1
      end
    end
    if _error <> '' then return .assignmentresult(mapping,0,resets,_error)
    if charge(_virtual) = 0 then return .assignmentresult(mapping,0,resets,_error)
    highest = -1
    do v = 0 to _virtual - 1; highest = max(highest,mapping[v + 1]); end
    locals = highest + 1
    do k = 1 to life.size()
      if charge(1) = 0 then return .assignmentresult(mapping,0,resets,_error)
      v = life.at(k)
      allowed = eligible(v,life)
      if _error <> '' then return .assignmentresult(mapping,0,resets,_error)
      if allowed = 0 then iterate
      physical = mapping[v + 1]
      if occupied[physical + 1] > 0 then do
        if reserve(1,96) = 0 then return .assignmentresult(mapping,0,resets,_error)
        i = life.first(v); item = _rows[i] as .assignmentrow
        resets[resets[0] + 1] = .typedreset(v,physical,_ids[i],item.origin()) as .object
      end
      occupied[physical + 1] = v + 1
    end
    message = validate(reference mapping,locals,reference resets)
    if message <> '' then return .assignmentresult(mapping,0,resets,message)
    return .assignmentresult(mapping,locals,resets,'')

/** Per-function bounded target. Pinned cells preserve unique storage identity;
 * fixed cells additionally preserve their authored physical index. Calls use a
 * contiguous pinned suffix. Unknown indirect/exceptional control uses the
 * conservative identity profile. No object release is moved by scalar reuse. */
program: class
  _virtual = .int
  _budget = .int
  _work = .int
  _error = .string
  _catalog = .llrxascatalog..catalog
  _records = .object[]
  _candidates = .int[]
  _pinned = .int[]
  _fixed = .int[]
  _suffix = .int
  _identity = .int
  _sealed = .int
  _prepared = .int
  _kernel = .assignment
  _resets = .object[]
  *: factory
    arg virtualLocals = .int, registerBudget = .int, workBudget = 1000000
    _virtual = virtualLocals; _budget = registerBudget; _work = workBudget
    _suffix = virtualLocals; _catalog = .llrxascatalog..catalog()
    if virtualLocals < 1 | registerBudget < 1 | workBudget < 1 then _error = 'LL_RXAS_LIMIT: positive target budgets required'
    if virtualLocals > workBudget then _error = 'LL_RXAS_LIMIT: target cells exceed work budget'
    _fixed[1] = 1
    return
  charge: method = .int
    arg cost = .int
    if _error <> '' then return 0
    if cost > _work then do; _error = 'LL_RXAS_LIMIT: target.work budget'; return 0; end
    _work = _work - cost; return 1
  error: method = .string
    return _error
  candidate: method = .void
    arg virtual = .int, kind = 'integer'
    if _sealed then do; _error = 'LL_RXAS_STATE: target already sealed'; return; end
    if virtual < 0 | virtual >= _virtual | (kind <> 'integer' & kind <> 'boolean') then do
      _error = 'LL_RXAS_RECORD: candidate requires a plain integer/boolean local'; return
    end
    _candidates[virtual + 1] = 1; _prepared = 0
    return
  pin: method = .void
    arg virtual = .int
    if _sealed then do; _error = 'LL_RXAS_STATE: target already sealed'; return; end
    if virtual < 0 | virtual >= _virtual then do; _error = 'LL_RXAS_RECORD: pin outside frame'; return; end
    _pinned[virtual + 1] = 1; _prepared = 0
    return
  fixed: method = .void
    arg virtual = .int
    call pin(virtual)
    if _error <> '' then return
    _fixed[virtual + 1] = 1
    return
  window: method = .void
    arg base = .int, count = .int
    if _sealed then do; _error = 'LL_RXAS_STATE: target already sealed'; return; end
    if base < 0 | count < 1 | base > _virtual - count then do
      _error = 'LL_RXAS_RECORD: call window outside frame'; return
    end
    /* Reserve the suffix, including intervening work cells, as one group. */
    _suffix = min(_suffix,base); _prepared = 0
    return
  recordline: method = .void
    arg text = .string, origin = 0
    text = strip(text)
    at = pos(' ',text)
    if at = 0 then call record(text,'',origin)
    else call record(left(text,at - 1),substr(text,at + 1),origin)
    return
  record: method = .void
    arg mnemonic = .string, operands = '', origin = 0
    if _sealed then do; _error = 'LL_RXAS_STATE: target already sealed'; return; end
    if charge(length(mnemonic) + length(operands) + 1) = 0 then return
    item = .instruction(mnemonic,operands,origin)
    call item.parse(reference _catalog)
    if item.error() <> '' then do; _error = item.error(); return; end
    n = _records[0] + 1; _records[n] = item as .object; _prepared = 0
    /* This legacy text view does not decode scoped .meta register bindings.
     * Retain identity rather than claiming their uses are absent. */
    if item.kind() = 'opaque' | mnemonic = '.meta' then _identity = 1
    if item.kind() = 'trace' then do
      if item.local(6) < 0 then _identity = 1
    end
    opcode = item.opcode()
    if opcode >= 0 then do
      implicit = _catalog.field(opcode,5) as .int
      /* Numeric addressing and policy changes may observe any frame cell. */
      if implicit = 1 | implicit = 2 | _catalog.field(opcode,26) <> '0' | _catalog.unbounded(opcode) then _identity = 1
      if implicit >= 3 & implicit <= 5 then call fixed(implicit - 3)
      if implicit = 6 then _identity = 1
      if implicit = 7 then do
        base = item.local(3)
        if base < 0 then _identity = 1
        else call window(base,_virtual - base)
      end
    end
    do i = 1 to item.operands()
      v = item.local(i)
      if v < 0 then iterate
      if v >= _virtual then do; _error = 'LL_RXAS_RECORD: local outside virtual frame'; return; end
      if item.kind() = 'trace' then call pin(v)
      if opcode >= 0 then do
        /* Cell identity, flags and failure-visible writes are never scalar kills. */
        if _catalog.field(opcode,4) <> '0' | _catalog.field(opcode,15) <> '0' then call pin(v)
        sem = _catalog.field(opcode,6) as .int
        if sem <> 0 & sem <> 8 then call pin(v)
        if _catalog.reads(opcode,i) then do
          if _catalog.readcomponents(opcode,i) <> 1 then call pin(v)
        end
        if _catalog.writes(opcode,i) then do
          component = _catalog.writecomponents(opcode,i)
          if component <> 1 & item.mnemonic() <> 'null' then call pin(v)
        end
      end
    end
    return
  /** Prepare the typed view once. Parsing, label lookup and conservative text
   * policy stay here; assignment and its checker live only in the kernel. */
  prepare: method = .void
    i = .int; j = .int; k = .int; v = .int; found = .int; bytebudget = .int
    label = .string; opcode = .int
    item = .instruction; other = .instruction
    if _prepared | _error <> '' then return
    ids = .int[]; labeltargets = .stem(); locations = .int[]
    loopstarts = .int[]; loopends = .int[]
    do i = 1 to _records[0]
      ids[i] = i; item = _records[i] as .instruction
      if item.kind() <> 'label' then iterate
      label = item.mnemonic()
      if charge(length(label) + 1) = 0 then return
      if labeltargets.get(label) = '' then do
        if charge(length(label) + 1) = 0 then return
        call labeltargets.set(label,i as .string)
      end
      locations[locations[0] + 1] = i
    end
    do i = 1 to _records[0]
      item = _records[i] as .instruction; opcode = item.opcode()
      if opcode < 0 then iterate
      do j = 1 to item.operands()
        if _catalog.branch(opcode,j) = 0 then iterate
        label = item.operand(j) || ':'
        if charge(length(label) + 1) = 0 then return
        targettext = labeltargets.get(label)
        if targettext = '' then do; _error = 'LL_RXAS_RECORD: unresolved branch target'; return; end
        target = targettext as .int
        if target <= i then do
          n = loopstarts[0] + 1; loopstarts[n] = target; loopends[n] = i
        end
      end
    end
    /* The text API predates a byte allowance: derive a conservative bound
     * from its existing work allowance rather than impose a new hidden cap. */
    if _work > 9007199254740991 then bytebudget = 9223372036854775807
    else bytebudget = max(67108864,_work * 1024)
    _kernel = .assignment(_virtual,reference ids,_budget,_work,bytebudget)
    do v = 0 to _virtual - 1
      if _candidates[v + 1] then call _kernel.candidate(v)
      if _pinned[v + 1] then call _kernel.pin(v)
      if _fixed[v + 1] then do
        call _kernel.fixed(v)
        if v >= _suffix then _identity = 1
      end
    end
    if _suffix < _virtual then call _kernel.window(_suffix,_virtual - _suffix)
    do i = 1 to locations[0]; call _kernel.boundary(locations[i]); end
    do i = 1 to loopstarts[0]; call _kernel.protect(loopstarts[i],loopends[i]); end
    empty = .int[]; refs = .int[]; reads = .int[]; writes = .int[]; kills = .int[]; observations = .int[]
    do i = 1 to _records[0]
      item = _records[i] as .instruction; opcode = item.opcode()
      refs = empty; reads = empty; writes = empty; kills = empty; observations = empty
      do j = 1 to item.operands()
        if _kernel.charge(1) = 0 then leave
        v = item.local(j)
        if v < 0 then iterate
        found = 0
        do k = 1 to refs[0]
          if _kernel.charge(1) = 0 then leave
          if refs[k] = v then found = 1
        end
        if _kernel.error() <> '' then leave
        if found then iterate
        if _kernel.reserve(1,40) = 0 then leave
        refs[refs[0] + 1] = v
        if item.kind() = 'trace' then observations[observations[0] + 1] = v
        /* Aggregate all appearances of one local, including source=target. */
        read = 0; write = 0; kill = 0
        do k = 1 to item.operands()
          if _kernel.charge(1) = 0 then leave
          if item.local(k) <> v | opcode < 0 then iterate
          read = read | _catalog.reads(opcode,k); write = write | _catalog.writes(opcode,k)
          kill = kill | _catalog.kills(opcode,k)
        end
        if _kernel.error() <> '' then leave
        if read then reads[reads[0] + 1] = v
        if write then writes[writes[0] + 1] = v
        if kill then kills[kills[0] + 1] = v
      end
      call _kernel.row(i,reference refs,reference reads,reference writes,reference kills,reference observations,item.origin())
      if _kernel.error() <> '' then leave
    end
    _work = _kernel.remaining(); _error = _kernel.error(); _prepared = 1
    return
  /** Independent checking delegates to the same typed source-row owner. It
   * reconstructs intervals and reset requirements, not allocator endpoints. */
  validate: method = .string
    arg mapping_ref = reference .int[], locals = .int
    call prepare()
    if _error <> '' then return _error
    message = _kernel.validate(mapping_ref,locals,reference _resets)
    _work = _kernel.remaining()
    return message
  finish: method = .llrxas..allocation
    arg reuse = 1
    texts = .string[]; origins = .int[]; mapping = .int[]
    i = .int; v = .int; n = .int; nextreset = .int
    item = .instruction; reset = .typedreset
    if _sealed then return .allocation(texts,origins,mapping,0,'LL_RXAS_STATE: target already sealed')
    _sealed = 1; call prepare()
    if _error <> '' then return .allocation(texts,origins,mapping,0,_error)
    mode = 'reuse'
    if reuse = 0 | _identity then mode = 'identity'
    assigned = _kernel.finish(mode); _work = _kernel.remaining()
    if assigned.valid() = 0 then return .allocation(texts,origins,mapping,0,assigned.error())
    do v = 0 to _virtual - 1; mapping[v + 1] = assigned.assigned(v); end
    do i = 1 to assigned.resets(); _resets[i] = assigned.reset(i) as .object; end
    nextreset = 1
    do i = 1 to _records[0]
      item = _records[i] as .instruction
      do while nextreset <= assigned.resets()
        reset = assigned.reset(nextreset)
        if reset.recordid() <> i then leave
        n = texts[0] + 1; texts[n] = 'null r' || reset.physical(); origins[n] = reset.origin()
        nextreset = nextreset + 1
      end
      n = texts[0] + 1; texts[n] = item.render(reference mapping,assigned.locals()); origins[n] = item.origin()
    end
    return .allocation(texts,origins,mapping,assigned.locals(),'')
