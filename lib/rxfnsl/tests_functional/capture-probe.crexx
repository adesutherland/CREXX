options levelb
import rxfnsb
import lllanguage
import lltree
import levell_settings

main: procedure = .int
  arg argv = .string[]
  request = .lllanguage..request(levell_settings..language(),readbinary(argv[1]))
  status = request.parse()
  if status <> 0 then do
    say request.error(); return status
  end
  tree = .lltree..view(request.tree(),request.root())
  if tree.error() <> '' then do
    say tree.error(); return 3
  end
  root = tree.root()
  node = .int
  itemname = 'item'; valuename = 'contents'
  if argv[0] >= 3 then do
    itemname = argv[2]; valuename = argv[3]
  end
  say 'FIELDS|' || tree.fieldcount(root,itemname) || '|' || tree.fieldcount(root,valuename)
  do i = 1 to tree.fieldcount(root,itemname)
    node = tree.field(root,upper(itemname),i)
    say 'ITEM|' || tree.text(node) || '|' || tree.start(node) || '|' || tree.finish(node)
  end
  node = tree.field(root,valuename)
  if node > 0 then say 'CONTENTS|' || tree.text(node) || '|' || tree.start(node) || '|' || tree.finish(node)
  if tree.field(root,'missing') <> 0 then return 4
  if tree.field(root,itemname,tree.fieldcount(root,itemname) + 1) <> 0 then return 4
  return 0
