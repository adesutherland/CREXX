foreach(required VM GENERATOR DATA OUTPUT)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required} for Level L Unicode property generation")
  endif()
endforeach()
file(STRINGS "${DATA}/SHA256SUMS" checksums)
foreach(record IN LISTS checksums)
  if(NOT record MATCHES "^([0-9a-f]+)  (.+)$")
    message(FATAL_ERROR "Malformed Level L Unicode checksum entry")
  endif()
  set(expected "${CMAKE_MATCH_1}")
  set(name "${CMAKE_MATCH_2}")
  file(SHA256 "${DATA}/${name}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Pinned Unicode data checksum mismatch: ${name}")
  endif()
endforeach()
execute_process(COMMAND "${VM}" "${GENERATOR}" -a "${DATA}" "${OUTPUT}.tmp" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  file(REMOVE "${OUTPUT}.tmp")
  message(FATAL_ERROR "Level B Unicode property compiler failed (${status})")
endif()
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
