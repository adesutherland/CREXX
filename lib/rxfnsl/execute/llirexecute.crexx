    _depth = 0; _cells = 0; _pending = 0; _pendingcells = 0; _pendingbytes = 0
    packet = payload; codebits = code as .binary; messagebits = message as .binary
    _bytes = _plan.usedbytes() + <blen>(packet) + <blen>(codebits) + <blen>(messagebits)
    /* Fixed diagnostics may report an exhausted or invalid budget. Caller
     * copies of published results have their own lifetime and are not charged
     * repeatedly to this session. Handler packets were reserved before use. */
    _status = status; _last = boundaryresult(status,message,code,payload,origin)
    return _last
  service: method = .object
    arg name = .string
    if ownerlive() = 0 then do; call bad('LL_IR_EXEC_OWNER: active session was copied or expired'); empty = .object; return empty; end
    return _plan.service(name)
