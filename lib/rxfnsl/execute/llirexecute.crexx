      end
      else do
        amount = _plan.bound(op); count = operation.results()
        if _plan.portkind(op) <> '' then count = count + amount <idiv> 32
        if count > _valuelimit - _cells | amount > _bytelimit - _bytes then return finish('limit','LL_RESOURCE_LIMIT: runtime output reservation exhausted')
        _pending = op; _pendingcells = count; _pendingbytes = amount; _cells = _cells + count; _bytes = _bytes + amount
        request = .llirexecute..request(operation,values,presence,amount)
        _epoch = _epoch + 1; _dispatch = _epoch
        fault = current.fault(); hasfault = current.hasfault()
        call request.authority(reference _anchor,_identity,reference _dispatch,_epoch,fault,hasfault)
        _busy = 1; answer = _plan.dispatch(op,request); _busy = 0; _dispatch = 0
        if _status <> 'running' then return _last
        summary = _plan.summary(op)
        message = packet(op,answer)
