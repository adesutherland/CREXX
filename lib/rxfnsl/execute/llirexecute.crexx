/* cREXX License (MIT). Optional, bounded execution of admitted semantic IR. */
options levelb
namespace llirexecute expose value typehandler encodedtype eventhandler request outcome handler lifecycle manifest registry plan token session result
import rxfnsb
import llir
import llirservices
import llirgraph
import llireffects

boot: initialiser expose serial
  serial = 0
  return
nextidentity: procedure = .int expose serial
  if serial = 9223372036854775807 then assembler signal "ERROR","LL_IR_EXEC_IDENTITY: identities exhausted"
  serial = serial + 1
  return serial
bad: procedure = .void
  arg message = .string
  assembler signal "ERROR",message
  return

/** Immutable runtime carrier. A payload is a strongly owned immutable box,
 * never a borrowed VM register or a serialized pointer. Its type service owns
 * validation and its logical retained-byte charge. */
value: class
  _type = .string
  _bits = .binary
  _payload = .object
  _haspayload = .int
  *: factory
    arg type = .string, bits = .binary, ?payload = .object
    _type = type; _bits = bits; _haspayload = ?payload
    if ?payload then _payload = payload
    return
  type: method = .string
    return _type
  bits: method = .binary
    return _bits
  haspayload: method = .int
    return _haspayload
  payload: method = .object
    return _payload

/** Trusted, pure value services. Materialization/check/charging must neither
 * perform target effects nor mutate a published carrier or its payload. */
typehandler: interface
  materialize: method = .llirexecute..value
    arg type = .string, bits = .binary
  check: method = .string
    arg item = .llirexecute..value
  bytes: method = .int
    arg item = .llirexecute..value

/** Ordinary exact encodings reuse the schema's existing codec algorithm. */
encodedtype: class implements .llirexecute..typehandler
  _codec = .llir..typecodec
  *: factory
    arg codec = .llir..typecodec
    _codec = codec
    return
  materialize: method = .llirexecute..value
    arg type = .string, bits = .binary
    return .llirexecute..value(type,bits)
  check: method = .string
    arg item = .llirexecute..value
    if item.haspayload() then return 'encoded values cannot contain a live payload'
    return _codec.check(item.bits())
  bytes: method = .int
    arg item = .llirexecute..value
    bits = item.bits()
    return <blen>(bits)

/** Trusted immutable validation and logical charging for opaque owned events.
 * A capsule's language-specific payload owner has its separate resource budget. */
eventhandler: interface
  check: method = .string
    arg event = .object
  bytes: method = .int
    arg event = .object

nativeevents: class implements .llirexecute..eventhandler
  *: factory
    return
  check: method = .string
    arg event = .object
    if initialized(event) = 0 then return 'event is uninitialized'
    if event is .runtime_signal then return ''
    return 'event is not an admitted native event'
  bytes: method = .int
    arg event = .object
    return 64

/** A synchronous operation request owns its values. Its opview is valid only
 * during dispatch; handlers must retain an origin/operation ID instead. */
request: class
  _operation = .llir..opview
  _values = .object[]
  _present = .int[]
  _budget = .int
  _owner = reference .int
  _identity = .int
  _dispatch = reference .int
  _epoch = .int
  _fault = .llirexecute..outcome
  _hasfault = .int
  *: factory
    arg operation = .llir..opview, values = .object[], present = .int[], budget = .int
    _operation = operation; _values = values; _present = present; _budget = budget; _hasfault = 0
    return
  operation: method = .llir..opview
    return _operation
  origin: method = .int
    at = .llir..origin
    at = _operation.origin()
    return at.id()
  size: method = .int
    return _values[0]
  at: method = .llirexecute..value
    arg i = .int
    return _values[i] as .llirexecute..value
  present: method = .int
    arg i = .int
    return _present[i]
  budget: method = .int
    return _budget
  authority: method = .void
    arg owner = reference .int, identity = .int, dispatch = reference .int, epoch = .int, fault = .llirexecute..outcome, hasfault = 0
    _owner = owner; _identity = identity; _dispatch = dispatch; _epoch = epoch; _fault = fault; _hasfault = hasfault
    return
  resolve: method = .object
    arg ordinal = .int
    if <refvalid>(_dispatch) = 0 then call bad('LL_IR_EXEC_LEASE: expired dispatch')
    active = dereference _dispatch
    if active <> _epoch | _epoch = 0 then call bad('LL_IR_EXEC_LEASE: binding is available only during dispatch')
    item = at(ordinal)
    if item.haspayload() = 0 then call bad('LL_IR_EXEC_LEASE: operand is not a binding lease')
    payload = item.payload()
    if (payload is .lease) = 0 then call bad('LL_IR_EXEC_LEASE: operand is not a binding lease')
    lease = payload as .lease
    if lease.matches(_owner,_identity,item.type()) = 0 then call bad('LL_IR_EXEC_LEASE: foreign or revoked binding')
    return lease.binding()
  hasfault: method = .int
    return _hasfault
  fault: method = .llirexecute..outcome
    return _fault

/** An operation completes, fails, or suspends. A failure carries exact opaque
 * payload bytes and an owned logical origin; it is not a folding result. */
outcome: class
  _status = .string
  _code = .string
  _message = .string
  _payload = .binary
  _origin = .int
  _values = .object[]
  _present = .int[]
  _event = .object
  _hasevent = .int
  _eventbytes = .int
  _controls = .object[]
  _controlpresent = .int[]
  *: factory
    arg status = 'normal', code = '', message = '', payload = ''x as .binary, origin = 0
    _status = status; _code = code; _message = message; _payload = payload; _origin = origin; _hasevent = 0; _eventbytes = 0
    return
  add: method = .void
    arg item = .llirexecute..value, present = 1
    i = _values[0] + 1; _values[i] = item as .object; _present[i] = present
    return
  addabsent: method = .void
    i = _values[0] + 1; empty = .object; _values[i] = empty; _present[i] = 0
    return
  addcontrol: method = .void
    arg item = .llirexecute..value, present = 1
    i = _controls[0] + 1; _controls[i] = item as .object; _controlpresent[i] = present
    return
  controls: method = .int
    return _controls[0]
  controlat: method = .llirexecute..value
    arg i = .int
    return _controls[i] as .llirexecute..value
  controlpresent: method = .int
    arg i = .int
    return _controlpresent[i]
  status: method = .string
    return _status
  code: method = .string
    return _code
  message: method = .string
    return _message
  payload: method = .binary
    return _payload
  origin: method = .int
    return _origin
  size: method = .int
    return _values[0]
  at: method = .llirexecute..value
    arg i = .int
    return _values[i] as .llirexecute..value
  present: method = .int
    arg i = .int
    return _present[i]
  setevent: method = .void
    arg event = .object, bytes = 64
    _event = event; _eventbytes = bytes; _hasevent = 1
    return
  hasevent: method = .int
    return _hasevent
  event: method = .object
    return _event
  eventbytes: method = .int
    return _eventbytes

/** One registered handler owns one mutable runtime service per session.
 * External work/state budgets are its separate contract. Cleanup is called
 * once on every terminal path, including cancellation and discard. */
handler: interface
  execute: method = .llirexecute..outcome
    arg request = .llirexecute..request
  cleanup: method = .void
    arg reason = .string

/** Optional frame ownership notifications. Services remain session-owned. */
lifecycle: interface
  frameenter: method = .void
    arg functionId = .int, depth = .int
  frameleave: method = .void
    arg functionId = .int, depth = .int, reason = .string

/* Only a session can mint a usable lease: its private anchor is checked on
 * admission and resolution. The binding owns its language-specific reference. */
lease: class
  _owner = reference .int
  _identity = .int
  _type = .string
  _binding = .object
  *: factory
    arg owner = reference .int, identity = .int, type = .string, binding = .object
    _owner = owner; _identity = identity; _type = type; _binding = binding
    return
  matches: method = .int
    arg owner = reference .int, identity = .int, type = .string
    if <refvalid>(_owner) = 0 | <refvalid>(owner) = 0 then return 0
    if (_owner <refsame> owner) = 0 then return 0
    active = dereference _owner
    return _identity = identity & active = identity & _type = type
  binding: method = .object
    return _binding

/** Execution metadata belongs to the exact live graph revision. It neither
 * registers callbacks nor accepts executable addresses. Optional declarations
 * are checked again by plan admission before any target effect. */
manifest: class
  _owner = reference .llir..module
  _revision = .int
  _sealed = .int
  _error = .string
  _protect = .int[]
  _gates = .int[]
  _guards = .int[]
  _branches = .int[]
  _when = .int[]
  _mapops = .int[]
  _formals = .int[]
  _inputs = .int[]
  _presence = .int[]
  _portops = .int[]
  _portkinds = .string[]
  *: factory
    arg owner = reference .llir..module
    _owner = owner; _sealed = 0; _error = ''
    if <refvalid>(owner) = 0 then do; _error = 'LL_IR_EXEC_MANIFEST: expired graph'; return; end
    graph = dereference owner; _revision = graph.identity()
    return
  mutable: method = .int
    if _sealed then do; _error = 'LL_IR_EXEC_MANIFEST: manifest is sealed'; return 0; end
    return _error = ''
  protect: method = .void
    arg op = .int
    if mutable() = 0 then return
    if op < 1 then do; _error = 'LL_IR_EXEC_MANIFEST: invalid protection'; return; end
    _protect[_protect[0] + 1] = op
    return
  port: method = .void
    arg op = .int, kind = .string
    i = .int
    if mutable() = 0 then return
    if op < 1 | (kind <> 'invoke' & kind <> 'transfer' & kind <> 'invoke transfer') then do; _error = 'LL_IR_EXEC_MANIFEST: invalid execution port'; return; end
    do i = 1 to _portops[0]
      if _portops[i] = op then do; _error = 'LL_IR_EXEC_MANIFEST: duplicate execution port'; return; end
    end
    i = _portops[0] + 1; _portops[i] = op; _portkinds[i] = kind
    return
  portkind: method = .string
    arg op = .int
    do i = 1 to _portops[0]; if _portops[i] = op then return _portkinds[i]; end
    return ''
  ports: method = .int
    return _portops[0]
  portop: method = .int
    arg i = .int
    return _portops[i]
  gate: method = .void
    arg valueId = .int, guardValueId = .int, branchOperation = .int, presentWhen = 1
    i = .int
    if mutable() = 0 then return
    if valueId < 1 | guardValueId < 1 | branchOperation < 1 | (presentWhen <> 0 & presentWhen <> 1) then do; _error = 'LL_IR_EXEC_MANIFEST: invalid result gate'; return; end
    do i = 1 to _gates[0]; if _gates[i] = valueId then do; _error = 'LL_IR_EXEC_MANIFEST: duplicate result gate'; return; end; end
    i = _gates[0] + 1; _gates[i] = valueId; _guards[i] = guardValueId; _branches[i] = branchOperation; _when[i] = presentWhen
    return
  callmap: method = .void
    arg op = .int, formal = .int, input = .int, presenceInput = 0
    i = .int
    if mutable() = 0 then return
    if op < 1 | formal < 1 | input < 0 | presenceInput < 0 | (input = 0 & presenceInput <> 0) then do; _error = 'LL_IR_EXEC_MANIFEST: invalid call mapping'; return; end
    do i = 1 to _mapops[0]; if _mapops[i] = op & _formals[i] = formal then do; _error = 'LL_IR_EXEC_MANIFEST: duplicate formal mapping'; return; end; end
    i = _mapops[0] + 1; _mapops[i] = op; _formals[i] = formal; _inputs[i] = input; _presence[i] = presenceInput
    return
  matches: method = .int
    arg owner = reference .llir..module
    if _error <> '' | <refvalid>(_owner) = 0 | <refvalid>(owner) = 0 then return 0
    if (_owner <refsame> owner) = 0 then return 0
    graph = dereference owner
    return graph.identity() = _revision
  seal: method = .void
    _sealed = 1
    return
  error: method = .string
    return _error
  protected: method = .int
    arg op = .int
    do i = 1 to _protect[0]; if _protect[i] = op then return 1; end
    return 0
  protections: method = .int
    return _protect[0]
  protection: method = .int
    arg i = .int
    return _protect[i]
  gates: method = .int
    return _gates[0]
  gated: method = .int
    arg valueId = .int
    do i = 1 to _gates[0]; if _gates[i] = valueId then return i; end
    return 0
  gatedvalue: method = .int
    arg i = .int
    return _gates[i]
  guard: method = .int
    arg i = .int
    return _guards[i]
  branch: method = .int
    arg i = .int
    return _branches[i]
  presentwhen: method = .int
    arg i = .int
    return _when[i]
  mappings: method = .int
    return _mapops[0]
  mapping: method = .int
    arg op = .int, formal = .int
    do i = 1 to _mapops[0]; if _mapops[i] = op & _formals[i] = formal then return i; end
    return 0
  mapop: method = .int
    arg i = .int
    return _mapops[i]
  formal: method = .int
    arg i = .int
    return _formals[i]
  input: method = .int
    arg i = .int
    return _inputs[i]
  presence: method = .int
    arg i = .int
    return _presence[i]
  usedbytes: method = .int
    return _protect[0] * 16 + _gates[0] * 64 + _mapops[0] * 64 + _portops[0] * 64 + 64

/** A sealed trusted capability registry. Named service ownership is separate
 * from operation bindings, so multiple operations share one authoritative
 * runtime pool/configuration rather than independent service copies. */
registry: class
  _sealed = .int
  _error = .string
  _manifest = .string
  _typenames = .string[]
  _types = .object[]
  _handlernames = .string[]
  _handlers = .object[]
  _opnames = .string[]
  _ophandlers = .string[]
  _opcalls = .int[]
  _effects = .object[]
  _bounds = .int[]
  _portnames = .string[]
  _portkinds = .string[]
  _lifecycles = .string[]
  _leases = .string[]
  _events = .object
  _notice = .llirexecute..outcome
  *: factory
    arg contract = .llir..contract
    _sealed = 0; _error = ''; _events = .nativeevents() as .object
    if initialized(contract) = 0 then do; _error = 'LL_IR_EXEC_REGISTRY: trusted contract is uninitialized'; return; end
    if contract.error() <> '' then do; _error = contract.error(); return; end
    data = dereference contract.data()
    if data.sealed() = 0 then do; _error = 'LL_IR_EXEC_REGISTRY: trusted contract is not frozen'; return; end
    _manifest = contract.manifest()
    return
  mutable: method = .int
    if _sealed then do; _error = 'LL_IR_EXEC_REGISTRY: registry is sealed'; return 0; end
    return _error = ''
  events: method = .void
    arg service = .object
    if mutable() = 0 then return
    if initialized(service) = 0 then do; _error = 'LL_IR_EXEC_EVENT: uninitialized event service'; return; end
    if service is .llirexecute..eventhandler then _events = service
    else _error = 'LL_IR_EXEC_EVENT: service has the wrong interface'
    return
  checkevent: method = .string
    arg answer = .llirexecute..outcome
    if answer.hasevent() = 0 then do
      if answer.eventbytes() <> 0 then return 'LL_IR_EXEC_EVENT: absent event has a charge'
      return ''
    end
    service = _events as .llirexecute..eventhandler; message = ''; amount = 0
    do
      message = service.check(answer.event())
      if message = '' then amount = service.bytes(answer.event())
    on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,cancel,quit,term,posix_int,channel_error,task_failure,other as problem
      message = problem.message()
    end
    if message <> '' then return 'LL_IR_EXEC_EVENT: ' || message
    if amount < 0 | amount <> answer.eventbytes() then return 'LL_IR_EXEC_EVENT: event charge disagrees with trusted service'
    return ''
  type: method = .void
    arg name = .string, service = .object
    if mutable() = 0 then return
    if name = '' | typeindex(name) > 0 | initialized(service) = 0 then do
      _error = 'LL_IR_EXEC_TYPE: invalid or duplicate runtime type'; return
    end
    if service is .llirexecute..typehandler then do
      i = _typenames[0] + 1; _typenames[i] = name; _types[i] = service
    end
    else _error = 'LL_IR_EXEC_TYPE: type service has the wrong interface'
    return
  handler: method = .void
    arg name = .string, service = .object
    if mutable() = 0 then return
    if name = '' | handlerindex(name) > 0 | initialized(service) = 0 then do
      _error = 'LL_IR_EXEC_HANDLER: invalid or duplicate runtime handler'; return
    end
    if service is .llirexecute..handler then do
      i = _handlernames[0] + 1; _handlernames[i] = name; _handlers[i] = service
    end
    else _error = 'LL_IR_EXEC_HANDLER: service has the wrong interface'
    return
  operation: method = .void
    arg name = .string, handlerName = .string, effects = .llireffects..summary, bytes = 4096
    if mutable() = 0 then return
    if name = '' | opindex(name) > 0 | handlerName = '' | bytes < 0 then do
      _error = 'LL_IR_EXEC_OPERATION: invalid or duplicate binding'; return
    end
    i = _opnames[0] + 1; _opnames[i] = name; _ophandlers[i] = handlerName; _opcalls[i] = 0
    _effects[i] = effects as .object; _bounds[i] = bytes
    return
  call: method = .void
    arg name = .string, functionId = .int, effects = .llireffects..summary
    if mutable() = 0 then return
    if name = '' | opindex(name) > 0 | functionId < 1 then do
      _error = 'LL_IR_EXEC_CALL: invalid or duplicate binding'; return
    end
    i = _opnames[0] + 1; _opnames[i] = name; _ophandlers[i] = ''; _opcalls[i] = functionId
    _effects[i] = effects as .object; _bounds[i] = 0
    return
  port: method = .void
    arg name = .string, kind = .string
    i = .int
    if mutable() = 0 then return
    if name = '' | (kind <> 'invoke' & kind <> 'transfer' & kind <> 'invoke transfer') then do; _error = 'LL_IR_EXEC_PORT: invalid port'; return; end
    do i = 1 to _portnames[0]
      if _portnames[i] = name then do
        if _portkinds[i] = kind | _portkinds[i] = 'invoke transfer' then do; _error = 'LL_IR_EXEC_PORT: duplicate port'; return; end
        _portkinds[i] = 'invoke transfer'; return
      end
    end
    i = _portnames[0] + 1; _portnames[i] = name; _portkinds[i] = kind
    return
  portkind: method = .string
    arg name = .string
    do i = 1 to _portnames[0]; if _portnames[i] = name then return _portkinds[i]; end
    return ''
  lifecycle: method = .void
    arg name = .string
    if mutable() = 0 then return
    do i = 1 to _lifecycles[0]; if _lifecycles[i] = name then do; _error = 'LL_IR_EXEC_FRAME: duplicate lifecycle service'; return; end; end
    _lifecycles[_lifecycles[0] + 1] = name
    return
  lease: method = .void
    arg type = .string
    if mutable() = 0 then return
    do i = 1 to _leases[0]; if _leases[i] = type then do; _error = 'LL_IR_EXEC_LEASE: duplicate lease type'; return; end; end
    _leases[_leases[0] + 1] = type
    return
  islease: method = .int
    arg type = .string
    do i = 1 to _leases[0]; if _leases[i] = type then return 1; end
    return 0
  notify: method = .string
    arg functionId = .int, depth = .int, reason = .string
    message = ''; service = .llirexecute..lifecycle; _notice = .llirexecute..outcome()
    do i = 1 to _lifecycles[0]
      binding = handlerindex(_lifecycles[i]); service = _handlers[binding] as .llirexecute..lifecycle
      do
        if reason = 'enter' then call service.frameenter(functionId,depth)
        else call service.frameleave(functionId,depth,reason)
      on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,cancel,quit,term,posix_int,channel_error,task_failure,other as problem
        if message = '' then do
          message = 'LL_IR_EXEC_FRAME: ' || problem.message()
          _notice = .llirexecute..outcome('failure',problem.name(),problem.message())
          original = problem as .runtime_signal
          call _notice.setevent(original as .object)
        end
      end
      _handlers[binding] = service as .object
    end
    return message
  notice: method = .llirexecute..outcome
    return _notice
  seal: method = .int
    i = .int
    _sealed = 1
    do i = 1 to _opnames[0]
      if _opcalls[i] = 0 & handlerindex(_ophandlers[i]) = 0 then _error = 'LL_IR_EXEC_HANDLER: operation has no registered handler'
    end
    do i = 1 to _portnames[0]
      if opindex(_portnames[i]) = 0 then _error = 'LL_IR_EXEC_PORT: port has no operation binding'
    end
    do i = 1 to _lifecycles[0]
      binding = handlerindex(_lifecycles[i])
      if binding = 0 then _error = 'LL_IR_EXEC_FRAME: lifecycle has no handler'
      else if (_handlers[binding] is .llirexecute..lifecycle) = 0 then _error = 'LL_IR_EXEC_FRAME: handler has no lifecycle interface'
    end
    return _error = ''
  error: method = .string
    return _error
  matches: method = .int
    arg contract = .llir..contract
    return _error = '' & _manifest == contract.manifest()
  typeindex: method = .int
    arg name = .string
    do i = 1 to _typenames[0]; if _typenames[i] == name then return i; end
    return 0
  handlerindex: method = .int
    arg name = .string
    do i = 1 to _handlernames[0]; if _handlernames[i] == name then return i; end
    return 0
  opindex: method = .int
    arg name = .string
    do i = 1 to _opnames[0]; if _opnames[i] == name then return i; end
    return 0
  typeservice: method = .object
    arg i = .int
    return _types[i]
  service: method = .object
    arg i = .int
    return _handlers[i]
  putservice: method = .void
    arg i = .int, service = .object
    _handlers[i] = service
    return
  handlers: method = .int
    return _handlers[0]
  effect: method = .llireffects..summary
    arg i = .int
    return _effects[i] as .llireffects..summary
  target: method = .int
    arg i = .int
    return _opcalls[i]
  binding: method = .int
    arg i = .int
    return handlerindex(_ophandlers[i])
  bound: method = .int
    arg i = .int
    return _bounds[i]
  usedbytes: method = .int
    total = 0; i = .int; bits = .binary; summary = .llireffects..summary
    bits = _manifest as .binary; total = total + <blen>(bits)
    do i = 1 to _typenames[0]
      bits = _typenames[i] as .binary; total = total + <blen>(bits) + 64
    end
    do i = 1 to _handlernames[0]
      bits = _handlernames[i] as .binary; total = total + <blen>(bits) + 64
    end
    do i = 1 to _opnames[0]
      bits = _opnames[i] as .binary; total = total + <blen>(bits) + 96
      bits = _ophandlers[i] as .binary; total = total + <blen>(bits)
      summary = _effects[i] as .llireffects..summary; total = total + summary.bytes()
    end
    do i = 1 to _portnames[0]; bits = _portnames[i] as .binary; total = total + <blen>(bits) + 48; end
    do i = 1 to _lifecycles[0]; bits = _lifecycles[i] as .binary; total = total + <blen>(bits) + 32; end
    do i = 1 to _leases[0]; bits = _leases[i] as .binary; total = total + <blen>(bits) + 32; end
    return total

/** Whole-module admission owns an immutable module and capability snapshot.
 * Graph/effect/definite-assignment services remain the algorithm owners. The
 * original owner is retained only for matches(), never for execution. Logical
 * budgets do not bound VM allocation overhead, RSS, or uncooperative handlers.
 * Work is a separate allowance for each shared preparation stage, rather than
 * an aggregate instruction counter. External service state is host owned. */
plan: class
  _source = reference .llir..module
  _revision = .int
  _graph = .llir..module
  _registry = .llirexecute..registry
  _status = .string
  _message = .string
  _valueindex = .int[]
  _slotindex = .int[]
  _fnvalues = .int[]
  _fnslots = .int[]
  _opcode = .int[]
  _aux = .int[]
  _next = .int[]
  _first = .int[]
  _calls = .int[]
  _handlers = .int[]
  _bounds = .int[]
  _summaries = .object[]
  _terminal = .int[]
  _constants = .object[]
  _types = .object[]
  _typenames = .string[]
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  _manifest = .llirexecute..manifest
  _cleanupfault = .llirexecute..outcome
  *: factory
    arg owner = reference .llir..module, registry = .llirexecute..registry, work = 1000000, bytes = 67108864, ?execution = .llirexecute..manifest
    _source = owner; _registry = registry; _status = 'invalid'; _message = ''; _bytes = 0
    if <refvalid>(owner) = 0 then do; _message = 'LL_IR_EXEC_OWNER: module expired'; return; end
    borrowed = .llir..module; borrowed = dereference owner
    _graph = borrowed; _revision = _graph.identity()
    if ?execution then do
      if execution.matches(owner) = 0 then do; _message = 'LL_IR_EXEC_MANIFEST: stale or foreign execution manifest'; return; end
      _manifest = execution; call _manifest.seal()
    end
    else do; _manifest = .llirexecute..manifest(owner); call _manifest.seal(); end
    if _graph.error() <> '' then do; _message = _graph.error(); return; end
    if work < 1 | bytes < 1 then do; _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: execution preparation budgets must be positive'; return; end
    if _registry.seal() = 0 then do; _message = _registry.error(); return; end
    _worklimit = work; _bytelimit = bytes; _status = 'building'
    return
  run: method = .void
    if _status <> 'building' then return
    _status = 'invalid'
    do
      call prepare(_worklimit,_bytelimit)
    on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,cancel,quit,term,posix_int,channel_error,task_failure,other as problem
      _status = 'invalid'; _message = 'LL_IR_EXEC_PREPARATION: ' || problem.message()
    end
    return
  prepare: method = .void
    arg work = .int, bytes = .int
    index = .llirgraph..index(reference _graph,work,bytes)
    if index.valid() = 0 then do; _status = index.status(); _message = index.message(); return; end
    store = dereference _graph.storage(); contract = dereference store.contract(); schema = dereference contract.data()
    if _registry.matches(contract) = 0 then do; _message = 'LL_IR_EXEC_VERSION: graph does not match the trusted runtime contract'; return; end
    f = .int; i = .int; op = .int; j = .int; v = .int; s = .int; t = .int; binding = .int; target = .int; count = .int
    operation = .llir..opview; input = .llir..valuehandle; item = .llirexecute..value
    summary = .llireffects..summary; fn = .llir..function; formaltype = .llir..typeid
    type = .llir..typeid; runtime = .llirexecute..typehandler; constantsize = .int; empty = .object
    admittedControl = .int[]
    /* Reserve maps, schema handles, source/IR and conservative local analysis
     * working storage before constructing runtime values. */
    _bytes = _graph.bytes()
    if _bytes > bytes then do; _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: owned IR exhausted'; return; end
    metadata = _registry.usedbytes()
    metadata = metadata + _manifest.usedbytes()
    if metadata > bytes - _bytes then do; _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: runtime registry metadata exhausted'; return; end
    _bytes = _bytes + metadata
    maps = index.values() * 16 + index.slots() * 16 + index.operations() * 96 + index.blocks() * 16 + index.functions() * 32 + schema.types() * 32
    if maps > bytes - _bytes | index.usedbytes() > bytes - _bytes - maps then do
      _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: execution plan storage exhausted'; return
    end
    _bytes = _bytes + maps
    do t = 1 to schema.types()
      _typenames[t] = schema.typename(t)
      _types[t] = empty
      if t = 1 then iterate
      binding = _registry.typeindex(_typenames[t])
      if t = 2 then _types[t] = .llirexecute..encodedtype(.llir..boolcodec()) as .object
      else if binding > 0 then _types[t] = _registry.typeservice(binding)
    end
    indexbytes = index.usedbytes()
    model = .llireffects..model(reference _graph,'execution',1,work,bytes - _bytes - indexbytes)
    if model.error() <> '' then do; _status = 'limit'; _message = model.error(); return; end
    do f = 1 to index.functions()
      fn = _graph.function(f); _fnvalues[f] = 0; _fnslots[f] = index.functionslots(f)
      type = fn.resulttype()
      if requiretype(type.id()) = 0 then return
      if _registry.islease(_typenames[type.id()]) then do; _message = 'LL_IR_EXEC_LEASE: function results cannot expose live bindings'; return; end
      do i = 1 to fn.arguments()
        type = fn.argumenttype(i)
        if requiretype(type.id()) = 0 then return
      end
      do i = 1 to index.functionslots(f)
        s = index.functionslot(f,i); _slotindex[s] = i
        if requiretype(store.get(5,s,2)) = 0 then return
      end
      do i = 1 to index.functionoperations(f)
        op = index.functionoperation(f,i); operation = _graph.operation(op)
        _opcode[op] = index.opcode(op); _aux[op] = store.get(3,op,12); _next[op] = index.nextop(op)
        _calls[op] = 0; _handlers[op] = 0; _bounds[op] = 0
        _terminal[op] = 0
        do j = 1 to operation.results()
          input = operation.result(j); v = input.id(); type = input.type()
          _fnvalues[f] = _fnvalues[f] + 1; _valueindex[v] = _fnvalues[f]
          if requiretype(type.id()) = 0 then return
        end
        if _opcode[op] = 10 & _manifest.protected(op) = 0 then do
          _message = 'LL_IR_EXEC_CONTROL: protection is not admitted by the executable manifest'; return
        end
        if _opcode[op] > 10 & _opcode[op] <= 16 then do
          _message = 'LL_IR_EXEC_CONTROL: unsupported core control ' || operation.name(); return
        end
        if _opcode[op] = 1 then do
          input = operation.result(); type = input.type(); t = type.id()
          if _registry.islease(_typenames[t]) then do; _message = 'LL_IR_EXEC_LEASE: constants cannot manufacture bindings'; return; end
          runtime = _types[t] as .llirexecute..typehandler
          item = runtime.materialize(_typenames[t],input.bytes())
          _message = checkvalue(item,t)
          if _message <> '' then return
          if bin2x(item.bits()) <> bin2x(input.bytes()) then do; _message = 'LL_IR_EXEC_TYPE: constant materializer changed exact bits'; return; end
          constantsize = valuebytes(item,t)
          if constantsize < 0 | constantsize > bytes - _bytes - indexbytes - model.usedbytes() then do
            _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: materialized constants exhausted'; return
          end
          _constants[op] = item as .object; _bytes = _bytes + constantsize
        end
        if _opcode[op] <= 16 then iterate
        binding = _registry.opindex(operation.name())
        if binding = 0 then do; _message = 'LL_IR_EXEC_CAPABILITY: no runtime binding for ' || operation.name(); return; end
        summary = _registry.effect(binding)
        if summary.complete() = 0 | summary.inputs() <> operation.inputs() | summary.results() <> operation.results() then do
          _message = 'LL_IR_EXEC_EFFECT: incomplete or mismatched runtime summary'; return
        end
        ports = _registry.portkind(operation.name())
        graphports = _manifest.portkind(op)
        if ports <> '' & graphports = '' then do; _message = 'LL_IR_EXEC_MANIFEST: operation port is undeclared'; return; end
        if wordpos('transfer',graphports) > 0 & wordpos('transfer',ports) = 0 then do; _message = 'LL_IR_EXEC_MANIFEST: transfer port lacks a trusted capability'; return; end
        if wordpos('invoke',graphports) > 0 & wordpos('invoke',ports) = 0 then do; _message = 'LL_IR_EXEC_MANIFEST: invocation port lacks a trusted capability'; return; end
        if summary.transfer() <> 'none' & wordpos('transfer',ports) = 0 then do; _message = 'LL_IR_EXEC_CONTROL: runtime transfer requires an admitted port'; return; end
        if wordpos('transfer',ports) > 0 & summary.transfer() <> 'possible' then do; _message = 'LL_IR_EXEC_CONTROL: transfer port lacks a transfer effect'; return; end
        if wordpos('invoke',ports) > 0 & summary.resume() <> 'possible' then do; _message = 'LL_IR_EXEC_CONTROL: invocation port lacks a resume effect'; return; end
        termination = schema.effectvalue(schema.opindex(operation.name()),3)
        if termination = 'transfer' | termination = 'diverges' then do
          if wordpos('transfer',graphports) = 0 then do; _message = 'LL_IR_EXEC_CONTROL: terminal operation requires an admitted transfer port'; return; end
          admittedControl[admittedControl[0] + 1] = op; _terminal[op] = 1
        end
        do j = 1 to summary.inputs()
          if summary.operandmode(j) <> 'value' then do
            input = operation.input(j); type = input.type()
            if summary.operandmode(j) <> 'borrow' | _registry.islease(_typenames[type.id()]) = 0 then do; _message = 'LL_IR_EXEC_VALUE: borrowing requires a checked binding lease'; return; end
          end
        end
        do j = 1 to summary.results()
          input = operation.result(j); type = input.type()
          if _registry.islease(_typenames[type.id()]) then do; _message = 'LL_IR_EXEC_LEASE: operations cannot publish binding leases'; return; end
          if summary.availability(j) <> 'normal' then do
            if summary.availability(j) <> 'conditional' | _manifest.gated(input.id()) = 0 then do; _message = 'LL_IR_EXEC_VALUE: conditional result requires an admitted gate'; return; end
          end
        end
        if summary.bytes() > bytes - _bytes - indexbytes - model.usedbytes() then do
          _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: runtime effect metadata exhausted'; return
        end
        call model.put(op,summary); _summaries[op] = summary as .object
        target = _registry.target(binding)
        if target > 0 then do
          if target > index.functions() then do; _message = 'LL_IR_EXEC_CALL: foreign function target'; return; end
          fn = _graph.function(target)
          mapped = _manifest.mapping(op,1) > 0
          if mapped = 0 & operation.inputs() > fn.arguments() then do; _message = 'LL_IR_EXEC_CALL: too many call arguments'; return; end
          do j = 1 to fn.arguments()
            source = j; flag = 0
            if mapped then do
              mapping = _manifest.mapping(op,j)
              if mapping = 0 then do; _message = 'LL_IR_EXEC_CALL: incomplete formal mapping'; return; end
              source = _manifest.input(mapping); flag = _manifest.presence(mapping)
            end
            else if j > operation.inputs() then source = 0
            if source > operation.inputs() | flag > operation.inputs() then do; _message = 'LL_IR_EXEC_CALL: foreign mapped operand'; return; end
            if source > 0 then do
              input = operation.input(source); type = input.type(); formaltype = fn.argumenttype(j)
              if type.id() <> formaltype.id() then do; _message = 'LL_IR_EXEC_CALL: argument type mismatch'; return; end
            end
            if source = 0 | flag > 0 then do
              if fn.optional(j) = 0 then do; _message = 'LL_IR_EXEC_CALL: mapping can omit a required argument'; return; end
            end
            if flag > 0 then do
              input = operation.input(flag); type = input.type()
              if type.id() <> 2 then do; _message = 'LL_IR_EXEC_CALL: presence input must be Boolean'; return; end
            end
          end
          type = fn.resulttype(); count = type.id() <> 1
          if operation.results() <> count then do; _message = 'LL_IR_EXEC_CALL: result arity mismatch'; return; end
          if count then do
            input = operation.result(); formaltype = input.type()
            if type.id() <> formaltype.id() then do; _message = 'LL_IR_EXEC_CALL: result type mismatch'; return; end
          end
          _calls[op] = target
        end
        else do; _handlers[op] = _registry.binding(binding); _bounds[op] = _registry.bound(binding); end
      end
    end
    do i = 1 to index.blocks(); _first[i] = index.firstop(i); end
    if _graph.blocks() > (bytes - _bytes - indexbytes - model.usedbytes()) <idiv> 32 then do
      _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: executable-manifest scratch exhausted'; return
    end
    if checkmanifest(index,work) = 0 then return
    if model.seal() = 0 then do; _message = model.error(); return; end
    /* Definite assignment owns its lattice algorithm. Admit its conservative
     * peak while index/model locals remain live; divide before multiplying
     * potentially large block/slot counts. */
    scratch = _graph.blocks() * 128 + store.count(7) * 32 + store.count(5) * 2
    available = bytes - _bytes - indexbytes - model.usedbytes()
    if scratch > available then do; _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: initialization analysis scratch exhausted'; return; end
    available = available - scratch
    if store.count(5) > 0 then do
      if _graph.blocks() > (available <idiv> 2) <idiv> store.count(5) then do
        _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: initialization analysis lattice exhausted'; return
      end
    end
    analysis = .llirservices..analysis
    analysis = llirservices..analyse(reference _graph,work,admittedControl)
    if analysis.status() <> 'ok' then do; _status = analysis.status(); _message = analysis.message(); return; end
    if analysis.issues() > 0 then do; _message = 'LL_IR_EXEC_INITIALIZATION: ' || analysis.diagnostic(1); return; end
    _status = 'ok'; _message = ''
    return
  checkmanifest: method = .int
    arg index = .llirgraph..index, work = .int
    i = .int; j = .int; op = .int
    operation = .llir..opview; input = .llir..valuehandle; type = .llir..typeid; summary = .llireffects..summary
    spent = _manifest.ports() + _manifest.protections() + _manifest.mappings() + _manifest.gates()
    if spent > work then do; _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: execution-manifest checking exhausted'; return 0; end
    do i = 1 to _manifest.ports()
      op = _manifest.portop(i)
      if op > index.operations() then do; _message = 'LL_IR_EXEC_MANIFEST: foreign execution port'; return 0; end
      if index.opcode(op) <= 16 then do; _message = 'LL_IR_EXEC_MANIFEST: port requires an extension operation'; return 0; end
    end
    do i = 1 to _manifest.protections()
      op = _manifest.protection(i)
      if op > index.operations() then do; _message = 'LL_IR_EXEC_MANIFEST: foreign protection operation'; return 0; end
      if index.opcode(op) <> 10 then do; _message = 'LL_IR_EXEC_MANIFEST: protection requires core.protect'; return 0; end
    end
    do i = 1 to _manifest.mappings()
      op = _manifest.mapop(i)
      if op > index.operations() then do; _message = 'LL_IR_EXEC_MANIFEST: foreign mapping operation'; return 0; end
      target = _calls[op]
      if target = 0 then do; _message = 'LL_IR_EXEC_MANIFEST: mapping requires an IR call'; return 0; end
      fn = _graph.function(target)
      if _manifest.formal(i) > fn.arguments() then do; _message = 'LL_IR_EXEC_MANIFEST: foreign formal mapping'; return 0; end
    end
    do i = 1 to _manifest.gates()
      value = _manifest.gatedvalue(i); guard = _manifest.guard(i); branch = _manifest.branch(i)
      if value > index.values() | guard > index.values() | branch > index.operations() then do; _message = 'LL_IR_EXEC_MANIFEST: foreign result gate'; return 0; end
      producer = index.definition(value); guardop = index.definition(guard)
      operation = _graph.operation(producer)
      if index.opcode(producer) <= 16 then do; _message = 'LL_IR_EXEC_MANIFEST: gate requires an extension result'; return 0; end
      summary = _summaries[producer] as .llireffects..summary; conditional = 0
      do j = 1 to operation.results()
        input = operation.result(j)
        if input.id() = value & summary.availability(j) = 'conditional' then conditional = 1
      end
      if conditional = 0 | index.opcode(branch) <> 6 then do; _message = 'LL_IR_EXEC_MANIFEST: invalid conditional gate producer or branch'; return 0; end
      operation = _graph.operation(branch); input = operation.input(1); type = input.type()
      if input.id() <> guard | type.id() <> 2 | index.opblock(producer) <> index.opblock(branch) | index.opblock(guardop) <> index.opblock(branch) then do; _message = 'LL_IR_EXEC_MANIFEST: result gate requires a local Boolean branch'; return 0; end
      if index.opposition(producer) >= index.opposition(branch) then do; _message = 'LL_IR_EXEC_MANIFEST: gate precedes its result'; return 0; end
      successor = 1 + _manifest.presentwhen(i); absentblock = operation.successor(successor)
      /* An absent result may be transported to a slot without accessing its
       * payload. Follow absence until a replacement store; shared return joins
       * remain admissible when every arriving path has replaced that absence. */
      do j = 1 to index.uses(value)
        spent = spent + 1
        if spent > work then do; _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: result-gate checking exhausted'; return 0; end
        use = index.use(value,j)
        if index.opcode(use) <> 4 then do; _message = 'LL_IR_EXEC_MANIFEST: conditional result requires slot transport'; return 0; end
        slot = index.opslot(use)
        pending = .int[]; seen = .int[]
        assembler setattrs pending,0
        assembler setattrs seen,0
        head = 1; tail = 1; pending[1] = absentblock; seen[absentblock] = 1
        do while head <= tail
          block = pending[head]; head = head + 1; position = index.firstop(block); replaced = 0
          do while position > 0
            spent = spent + 1
            if spent > work then do; _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: result-gate checking exhausted'; return 0; end
            if index.opslot(position) = slot then do
              if index.opcode(position) = 3 then do; _message = 'LL_IR_EXEC_MANIFEST: conditional slot load lacks its present gate'; return 0; end
              if index.opcode(position) = 4 then do
                written = _graph.operation(position); input = written.input(1)
                if input.id() <> value then do; replaced = 1; leave; end
              end
            end
            position = index.nextop(position)
          end
          if replaced then iterate
          do edge = 1 to index.successors(block)
            destination = index.successor(block,edge)
            if block = index.opblock(branch) & edge <> successor then iterate
            if seen[destination] then iterate
            tail = tail + 1; pending[tail] = destination; seen[destination] = 1
          end
        end
      end
    end
    return 1
  requiretype: method = .int
    arg t = .int
    if t = 1 then return 1
    if _registry.islease(_typenames[t]) then return 1
    if initialized(_types[t]) then return 1
    _message = 'LL_IR_EXEC_CAPABILITY: no runtime type for ' || _typenames[t]
    return 0
  valid: method = .int
    call run()
    return _status = 'ok'
  status: method = .string
    call run()
    return _status
  message: method = .string
    call run()
    return _message
  matches: method = .int
    arg owner = reference .llir..module
    if <refvalid>(_source) = 0 | <refvalid>(owner) = 0 then return 0
    if (_source <refsame> owner) = 0 then return 0
    graph = dereference owner
    return graph.identity() = _revision
  usedbytes: method = .int
    call run()
    return _bytes
  functions: method = .int
    return _graph.functions()
  function: method = .llir..function
    arg f = .int
    return _graph.function(f)
  operation: method = .llir..opview
    arg op = .int
    return _graph.operation(op)
  opcode: method = .int
    arg op = .int
    return _opcode[op]
  aux: method = .int
    arg op = .int
    return _aux[op]
  next: method = .int
    arg op = .int
    return _next[op]
  first: method = .int
    arg block = .int
    return _first[block]
  entry: method = .int
    arg f = .int
    store = dereference _graph.storage()
    return first(store.get(1,f,3))
  valueindex: method = .int
    arg v = .int
    return _valueindex[v]
  slotindex: method = .int
    arg s = .int
    return _slotindex[s]
  values: method = .int
    arg f = .int
    return _fnvalues[f]
  slots: method = .int
    arg f = .int
    return _fnslots[f]
  target: method = .int
    arg op = .int
    return _calls[op]
  bound: method = .int
    arg op = .int
    return _bounds[op]
  summary: method = .llireffects..summary
    arg op = .int
    return _summaries[op] as .llireffects..summary
  constant: method = .llirexecute..value
    arg op = .int
    return _constants[op] as .llirexecute..value
  typename: method = .string
    arg t = .int
    return _typenames[t]
  typeindex: method = .int
    arg name = .string
    do t = 1 to _typenames[0]; if _typenames[t] = name then return t; end
    return 0
  checkvalue: method = .string
    arg item = .llirexecute..value, t = .int
    if initialized(item) = 0 then return 'LL_IR_EXEC_TYPE: uninitialized runtime value'
    if item.type() <> _typenames[t] then return 'LL_IR_EXEC_TYPE: runtime value type mismatch'
    if _registry.islease(item.type()) then do
      bits = item.bits()
      if <blen>(bits) <> 0 | item.haspayload() = 0 then return 'LL_IR_EXEC_LEASE: malformed binding lease'
      payload = item.payload()
      if payload is .lease then return ''
      return 'LL_IR_EXEC_LEASE: malformed binding lease'
    end
    runtime = _types[t] as .llirexecute..typehandler
    message = .string
    do
      message = runtime.check(item)
    on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,cancel,quit,term,posix_int,channel_error,task_failure,other as problem
      message = problem.message()
    end
    if message <> '' then return 'LL_IR_EXEC_TYPE: ' || message
    return ''
  valuebytes: method = .int
    arg item = .llirexecute..value, t = .int
    if _registry.islease(item.type()) then return 64
    runtime = _types[t] as .llirexecute..typehandler
    amount = .int; amount = -1
    do
      amount = runtime.bytes(item)
    on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,cancel,quit,term,posix_int,channel_error,task_failure,other
      amount = -1
    end
    return amount
  dispatch: method = .llirexecute..outcome
    arg op = .int, request = .llirexecute..request
    binding = _handlers[op]; service = _registry.service(binding) as .llirexecute..handler
    answer = .llirexecute..outcome
    do
      answer = service.execute(request)
    on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,cancel,quit,term,posix_int,channel_error,task_failure,other as problem
      answer = .llirexecute..outcome('failure',problem.name(),problem.message(),''x as .binary,request.origin())
      original = problem as .runtime_signal
      call answer.setevent(original as .object)
    end
    /* Explicit writeback preserves one mutable service, including mutations
     * made before a handler reports or raises a failure. */
    call _registry.putservice(binding,service as .object)
    return answer
  portkind: method = .string
    arg op = .int
    return _manifest.portkind(op)
  terminalop: method = .int
    arg op = .int
    return _terminal[op]
  islease: method = .int
    arg type = .string
    return _registry.islease(type)
  execution: method = .llirexecute..manifest
    return _manifest
  checkevent: method = .string
    arg answer = .llirexecute..outcome
    return _registry.checkevent(answer)
  notify: method = .string
    arg functionId = .int, depth = .int, reason = .string
    return _registry.notify(functionId,depth,reason)
  cleanup: method = .string
    arg reason = .string
    message = .string; message = ''; _cleanupfault = .llirexecute..outcome()
    do i = 1 to _registry.handlers()
      service = _registry.service(i) as .llirexecute..handler
      do
        call service.cleanup(reason)
      on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,cancel,quit,term,posix_int,channel_error,task_failure,other as problem
        if message = '' then do
          message = 'LL_IR_EXEC_CLEANUP: ' || problem.message()
          _cleanupfault = .llirexecute..outcome('failure',problem.name(),problem.message())
          original = problem as .runtime_signal
          call _cleanupfault.setevent(original as .object)
        end
      end
      call _registry.putservice(i,service as .object)
    end
    return message
  cleanupfault: method = .llirexecute..outcome
    return _cleanupfault
  notice: method = .llirexecute..outcome
    return _registry.notice()
  service: method = .object
    arg name = .string
    i = _registry.handlerindex(name)
    if i = 0 then do; call bad('LL_IR_EXEC_HANDLER: unknown service'); empty = .object; return empty; end
    return _registry.service(i)

/** A continuation names the original session storage as well as its serial
 * and generation. Copying a token does not create a second right to resume. */
token: class
  _owner = reference .int
  _identity = .int
  _generation = .int
  *: factory
    arg owner = reference .int, identity = .int, generation = .int
    _owner = owner; _identity = identity; _generation = generation
    return
  identity: method = .int
    return _identity
  generation: method = .int
    return _generation
  matches: method = .int
    arg owner = reference .int, identity = .int, generation = .int
    if <refvalid>(_owner) = 0 | <refvalid>(owner) = 0 then return 0
    return (_owner <refsame> owner) & _identity = identity & _generation = generation

/** Published results own their values and exact failure packet. */
result: class
  _status = .string
  _message = .string
  _code = .string
  _payload = .binary
  _origin = .int
  _values = .object[]
  _present = .int[]
  _token = .llirexecute..token
  _steps = .int
  _depth = .int
  _bytes = .int
  _event = .object
  _hasevent = .int
  _operation = .int
  _controls = .object[]
  _controlpresent = .int[]
  *: factory
    arg status = .string, message = '', code = '', payload = ''x as .binary, origin = 0, steps = 0, depth = 0, bytes = 0
    _status = status; _message = message; _code = code; _payload = payload; _origin = origin
    _steps = steps; _depth = depth; _bytes = bytes; _hasevent = 0
    return
  add: method = .void
    arg item = .llirexecute..value, present = 1
    i = _values[0] + 1; _values[i] = item as .object; _present[i] = present
    return
  continuation: method = .void
    arg token = .llirexecute..token
    _token = token
    return
  setevent: method = .void
    arg event = .object
    _event = event; _hasevent = 1
    return
  hasevent: method = .int
    return _hasevent
  event: method = .object
    return _event
  setoperation: method = .void
    arg op = .int
    _operation = op
    return
  addcontrol: method = .void
    arg item = .llirexecute..value, present = 1
    i = _controls[0] + 1; _controls[i] = item as .object; _controlpresent[i] = present
    return
  controls: method = .int
    return _controls[0]
  controlat: method = .llirexecute..value
    arg i = .int
    return _controls[i] as .llirexecute..value
  controlpresent: method = .int
    arg i = .int
    return _controlpresent[i]
  operation: method = .int
    return _operation
  status: method = .string
    return _status
  message: method = .string
    return _message
  code: method = .string
    return _code
  payload: method = .binary
    return _payload
  origin: method = .int
    return _origin
  size: method = .int
    return _values[0]
  at: method = .llirexecute..value
    arg i = .int
    return _values[i] as .llirexecute..value
  present: method = .int
    arg i = .int
    return _present[i]
  token: method = .llirexecute..token
    return _token
  steps: method = .int
    return _steps
  depth: method = .int
    return _depth
  usedbytes: method = .int
    return _bytes
  setusedbytes: method = .void
    arg bytes = .int
    _bytes = bytes
    return

/* A frame owns compact function-local SSA/slot cells and argument presence.
 * Uninitialized slots are separate from an initialized empty value. */
frame: class
  _function = .int
  _pc = .int
  _caller = .int
  _values = .object[]
  _slots = .object[]
  _arguments = .object[]
  _present = .int[]
  _valuebytes = .int[]
  _slotbytes = .int[]
  _argumentbytes = .int
  _cells = .int
  _bytes = .int
  _valuestate = .int[]
  _slotstate = .int[]
  _protection = .int
  _fault = .llirexecute..outcome
  _hasfault = .int
  _faultbytes = .int
  _closed = .int
  *: factory
    arg function = .int, pc = .int, caller = .int, values = .int, slots = .int, arguments = .object[], present = .int[], argumentbytes = .int
    _function = function; _pc = pc; _caller = caller; _arguments = arguments; _present = present
    _cells = values + slots + arguments[0]; _argumentbytes = argumentbytes; _bytes = argumentbytes + _cells * 32
    i = .int; empty = .object
    _protection = 0; _faultbytes = 0; _closed = 0; _hasfault = 0
    do i = 1 to values; _values[i] = empty; _valuebytes[i] = 0; _valuestate[i] = 0; end
    do i = 1 to slots; _slots[i] = empty; _slotbytes[i] = 0; _slotstate[i] = 0; end
    return
  function: method = .int
    return _function
  pc: method = .int
    return _pc
  advance: method = .void
    arg pc = .int
    _pc = pc
    return
  caller: method = .int
    return _caller
  cells: method = .int
    return _cells
  bytes: method = .int
    return _bytes
  value: method = .llirexecute..value
    arg i = .int
    return _values[i] as .llirexecute..value
  hasvalue: method = .int
    arg i = .int
    return _valuestate[i] <> 0
  valuestate: method = .int
    arg i = .int
    return _valuestate[i]
  slot: method = .llirexecute..value
    arg i = .int
    return _slots[i] as .llirexecute..value
  hasslot: method = .int
    arg i = .int
    return _slotstate[i] <> 0
  slotstate: method = .int
    arg i = .int
    return _slotstate[i]
  protect: method = .void
    arg pc = .int
    _protection = pc
    return
  protection: method = .int
    return _protection
  setfault: method = .void
    arg fault = .llirexecute..outcome, bytes = .int
    _fault = fault; _bytes = _bytes - _faultbytes + bytes; _faultbytes = bytes; _hasfault = 1
    return
  hasfault: method = .int
    return _hasfault
  fault: method = .llirexecute..outcome
    return _fault
  closed: method = .int
    return _closed
  close: method = .void
    _closed = 1
    return
  argument: method = .llirexecute..value
    arg i = .int
    return _arguments[i] as .llirexecute..value
  present: method = .int
    arg i = .int
    return _present[i]
  valuebytes: method = .int
    arg i = .int
    return _valuebytes[i]
  slotbytes: method = .int
    arg i = .int
    return _slotbytes[i]
  putvalue: method = .void
    arg i = .int, item = .llirexecute..value, bytes = .int
    _bytes = _bytes - _valuebytes[i] + bytes; _valuebytes[i] = bytes; _values[i] = item as .object; _valuestate[i] = 1
    return
  putslot: method = .void
    arg i = .int, item = .llirexecute..value, bytes = .int
    _bytes = _bytes - _slotbytes[i] + bytes; _slotbytes[i] = bytes; _slots[i] = item as .object; _slotstate[i] = 1
    return
  absentvalue: method = .void
    arg i = .int
    empty = .object; _values[i] = empty; _bytes = _bytes - _valuebytes[i]; _valuebytes[i] = 0; _valuestate[i] = 2
    return
  absentslot: method = .void
    arg i = .int
    empty = .object; _slots[i] = empty; _bytes = _bytes - _slotbytes[i]; _slotbytes[i] = 0; _slotstate[i] = 2
    return

/** One run owns its graph/services, frames, PC and suspended output reservation.
 * Fuel counts coordinator dispatches. An active copy is rejected by exact
 * storage identity; ready copies can start independently with fresh serials. */
session: class
  _plan = .llirexecute..plan
  _status = .string
  _identity = .int
  _anchor = .int
  _self = reference .int
  _generation = .int
  _frames = .object[]
  _depth = .int
  _fuel = .int
  _framelimit = .int
  _valuelimit = .int
  _bytelimit = .int
  _steps = .int
  _cells = .int
  _bytes = .int
  _pending = .int
  _pendingcells = .int
  _pendingbytes = .int
  _activeop = .int
  _activeorigin = .int
  _cleaned = .int
  _busy = .int
  _dispatch = .int
  _epoch = .int
  _notice = .llirexecute..outcome
  _last = .llirexecute..result
  *: factory
    arg plan = .llirexecute..plan, fuel = 100000, frames = 64, values = 100000, bytes = 67108864
    _plan = plan; _status = 'ready'; _identity = 0; _anchor = 0; _generation = 0
    _depth = 0; _fuel = fuel; _framelimit = frames; _valuelimit = values; _bytelimit = bytes
    _steps = 0; _cells = 0; _bytes = _plan.usedbytes(); _pending = 0; _pendingcells = 0; _pendingbytes = 0; _activeop = 0; _activeorigin = 0; _cleaned = 0; _busy = 0; _dispatch = 0; _epoch = 0
    return
  ownerlive: method = .int
    if _status = 'ready' & _identity = 0 then return 1
    if <refvalid>(_self) = 0 then return 0
    here = reference _anchor
    return _self <refsame> here
  rejected: method = .llirexecute..result
    arg message = .string
    code = 'LL_IR_EXEC_REJECTED'; colon = pos(':',message)
    if colon > 1 then code = left(message,colon - 1)
    return .llirexecute..result('rejected',message,code,''x as .binary,0,_steps,_depth,_bytes)
  status: method = .string
    if ownerlive() = 0 then return 'rejected'
    return _status
  bind: method = .llirexecute..value
    arg type = .string, binding = .object
    if ownerlive() = 0 | _status <> 'ready' then call bad('LL_IR_EXEC_LEASE: bindings require the original ready session')
    if _plan.islease(type) = 0 | initialized(binding) = 0 then call bad('LL_IR_EXEC_LEASE: invalid binding type or owner')
    if _identity = 0 then do; _identity = nextidentity(); _anchor = _identity; _self = reference _anchor; end
    return .llirexecute..value(type,''x as .binary,.lease(reference _anchor,_identity,type,binding) as .object)
  start: method = .llirexecute..result
    arg fn = .int, values = .object[], present = .int[]
    if ownerlive() = 0 then return rejected('LL_IR_EXEC_OWNER: active session was copied or expired')
    if _status <> 'ready' then return rejected('LL_IR_EXEC_STATE: session has already started')
    if _plan.valid() = 0 then return rejected(_plan.message())
    if fn < 1 | fn > _plan.functions() then return rejected('LL_IR_EXEC_CALL: foreign function')
    message = arguments(fn,values,present)
    if message <> '' then return rejected(message)
    if _identity = 0 then do; _identity = nextidentity(); _anchor = _identity; _self = reference _anchor; end
    _status = 'running'
    if _fuel < 1 | _framelimit < 1 | _valuelimit < 1 | _bytelimit < _bytes then return finish('limit','LL_RESOURCE_LIMIT: invalid execution budgets')
    do
      if push(fn,0,values,present) = 0 then return finish('limit','LL_RESOURCE_LIMIT: initial frame exhausted')
    on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,cancel,quit,term,posix_int,channel_error,task_failure,other as problem
      failed = .llirexecute..outcome('failure',problem.name(),problem.message())
      original = problem as .runtime_signal
      call failed.setevent(original as .object)
      return abort(failed)
    end
    return run()
  arguments: method = .string
    arg f = .int, values = .object[], present = .int[]
    fn = .llir..function; fn = _plan.function(f)
    type = .llir..typeid; item = .llirexecute..value
    if values[0] > fn.arguments() | present[0] <> values[0] then return 'LL_IR_EXEC_CALL: argument/presence arity mismatch'
    do i = 1 to fn.arguments()
      has = 0
      if i <= present[0] then has = present[i]
      if has <> 0 & has <> 1 then return 'LL_IR_EXEC_CALL: invalid argument presence'
      if has = 0 then do
        if fn.optional(i) = 0 then return 'LL_IR_EXEC_CALL: required argument is absent'
        iterate
      end
      if initialized(values[i]) = 0 then return 'LL_IR_EXEC_CALL: present argument is uninitialized'
      if values[i] is .llirexecute..value then item = values[i] as .llirexecute..value
      else return 'LL_IR_EXEC_CALL: argument is not a runtime value'
      type = fn.argumenttype(i); message = _plan.checkvalue(item,type.id())
      if message <> '' then return message
      if _plan.islease(item.type()) then do
        payload = item.payload(); binding = payload as .lease
        if binding.matches(reference _anchor,_identity,item.type()) = 0 then return 'LL_IR_EXEC_LEASE: foreign or revoked binding'
      end
    end
    return ''
  push: method = .int
    arg f = .int, caller = .int, values = .object[], present = .int[]
    fn = .llir..function; fn = _plan.function(f)
    type = .llir..typeid; item = .llirexecute..value
    argvalues = .object[]; presence = .int[]; argbytes = 0; empty = .object
    cells = _plan.values(f) + _plan.slots(f) + fn.arguments()
    if _depth >= _framelimit | cells > _valuelimit - _cells then return 0
    if cells > (_bytelimit - _bytes) <idiv> 32 then return 0
    do i = 1 to fn.arguments()
      presence[i] = 0; argvalues[i] = empty
      if i <= present[0] then presence[i] = present[i]
      if presence[i] then do
        item = values[i] as .llirexecute..value; type = fn.argumenttype(i); amount = _plan.valuebytes(item,type.id())
        if amount < 0 | amount > _bytelimit - _bytes - cells * 32 - argbytes then return 0
        argbytes = argbytes + amount; argvalues[i] = item as .object
      end
    end
    next = .llirexecute..frame(f,_plan.entry(f),caller,_plan.values(f),_plan.slots(f),argvalues,presence,argbytes)
    _depth = _depth + 1; _frames[_depth] = next as .object; _cells = _cells + cells; _bytes = _bytes + next.bytes()
    message = notify(f,_depth,'enter')
    if message <> '' then do
      if _notice.hasevent() then call rxfnsb..signalrelay(_notice.event() as .runtime_signal)
      call bad(message)
    end
    return 1
  notify: method = .string
    arg functionId = .int, depth = .int, reason = .string
    _busy = 1; message = _plan.notify(functionId,depth,reason); _notice = _plan.notice(); _busy = 0
    return message
  leaveframe: method = .string
    arg depth = .int, reason = .string
    frame = _frames[depth] as .llirexecute..frame
    if frame.closed() then return ''
    call frame.close(); _frames[depth] = frame as .object
    return notify(frame.function(),depth,reason)
  run: method = .llirexecute..result
    do
      return execute()
    on signal failure,error,overflow_underflow,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,cancel,quit,term,posix_int,channel_error,task_failure,other as problem
      message = problem.message()
      if message = '' then message = 'LL_IR_EXEC_RUNTIME: ' || problem.name() || ' at operation ' || _activeop
      failure = .llirexecute..outcome('failure',problem.name(),message,''x as .binary,_activeorigin)
      original = problem as .runtime_signal
      call failure.setevent(original as .object)
      return abort(failure)
    end
    return rejected('LL_IR_EXEC_STATE: execution did not produce an outcome')
  execute: method = .llirexecute..result
    if ownerlive() = 0 then return rejected('LL_IR_EXEC_OWNER: active session was copied or expired')
    if _busy then return rejected('LL_IR_EXEC_STATE: reentrant dispatch is unsupported')
    if _status <> 'running' then do
      if _status = 'ready' then return rejected('LL_IR_EXEC_STATE: session has not started')
      return _last
    end
    current = .llirexecute..frame; operation = .llir..opview; input = .llir..valuehandle; type = .llir..typeid
    item = .llirexecute..value; answer = .llirexecute..outcome; reply = .llirexecute..result
    summary = .llireffects..summary; request = .llirexecute..request; continuation = .llirexecute..token
    execution = .llirexecute..manifest
    fault = .llirexecute..outcome; event = .object; has = .int
    op = .int; opcode = .int; i = .int; index = .int; nextpc = .int; targetblock = .int; destination = .int; amount = .int; old = .int
    message = .string; bits = .binary; target = .int; count = .int; at = .llir..origin
    do while _status = 'running'
      current = _frames[_depth] as .llirexecute..frame; op = current.pc()
      if op < 1 then do
        _activeop = 0; _activeorigin = 0
        return finish('failure','LL_IR_EXEC_PC: missing continuation')
      end
      _activeop = op; operation = _plan.operation(op)
      at = operation.origin(); _activeorigin = at.id()
      /* Fuel is checked against the next attempted operation, never the
       * previously completed one. No dispatch or step is spent by this lookup. */
      if _steps >= _fuel then return finish('limit','LL_RESOURCE_LIMIT: execution fuel exhausted')
      opcode = _plan.opcode(op); _steps = _steps + 1
      values = .object[]; presence = .int[]
      assembler setattrs values,0
      assembler setattrs presence,0
      do i = 1 to operation.inputs()
        input = operation.input(i); index = _plan.valueindex(input.id())
        if current.hasvalue(index) = 0 then return finish('failure','LL_IR_EXEC_VALUE: undefined SSA input')
        if current.valuestate(index) = 2 then do
          if opcode <> 4 then return finish('failure','LL_IR_EXEC_VALUE: conditional input is absent')
          empty = .object; values[i] = empty; presence[i] = 0
        end
        else do; item = current.value(index); values[i] = item as .object; presence[i] = 1; end
      end
      if opcode = 1 then do
        answer = .llirexecute..outcome(); item = _plan.constant(op); call answer.add(item)
        message = admit(op,answer,-1)
        if message <> '' then return finish('limit',message)
        call apply(op,answer)
      end
      else if opcode = 2 | opcode = 9 then do
        index = _plan.aux(op)
        if current.present(index) then item = current.argument(index)
        else item = values[1] as .llirexecute..value
        answer = .llirexecute..outcome(); call answer.add(item)
        message = admit(op,answer,-1)
        if message <> '' then return finish('limit',message)
        call apply(op,answer)
      end
      else if opcode = 8 then do
        index = _plan.aux(op); bits = '00'x as .binary
        if current.present(index) then bits = '01'x as .binary
        answer = .llirexecute..outcome(); call answer.add(.llirexecute..value('core.boolean',bits))
        message = admit(op,answer,-1)
        if message <> '' then return finish('limit',message)
        call apply(op,answer)
      end
      else if opcode = 3 then do
        index = _plan.slotindex(_plan.aux(op))
        if current.hasslot(index) = 0 then return finish('failure','LL_IR_EXEC_INITIALIZATION: slot is uninitialized')
        if current.slotstate(index) = 2 then return finish('failure','LL_IR_EXEC_VALUE: conditional slot is absent')
        item = current.slot(index)
        answer = .llirexecute..outcome(); call answer.add(item)
        message = admit(op,answer,-1)
        if message <> '' then return finish('limit',message)
        call apply(op,answer)
      end
      else if opcode = 4 then do
        index = _plan.slotindex(_plan.aux(op)); input = operation.input(1); type = input.type(); old = current.slotbytes(index)
        amount = 0
        if presence[1] then do; item = values[1] as .llirexecute..value; amount = _plan.valuebytes(item,type.id()); end
        if amount < 0 | amount > _bytelimit - _bytes + old then return finish('limit','LL_RESOURCE_LIMIT: slot value storage exhausted')
        if presence[1] then call current.putslot(index,item,amount)
        else call current.absentslot(index)
        nextpc = _plan.next(op); call current.advance(nextpc)
        _bytes = _bytes - old + amount; _frames[_depth] = current as .object
      end
      else if opcode = 5 | opcode = 6 then do
        destination = 1
        if opcode = 6 then do
          item = values[1] as .llirexecute..value; bits = item.bits()
          if item.type() <> 'core.boolean' | <blen>(bits) <> 1 then return finish('failure','LL_IR_EXEC_TYPE: branch requires an exact Boolean')
          if <at..u8>(0) bits > 1 then return finish('failure','LL_IR_EXEC_TYPE: branch Boolean must be zero or one')
          execution = _plan.execution()
          do gate = 1 to execution.gates()
            if execution.branch(gate) <> op then iterate
            valueindex = _plan.valueindex(execution.gatedvalue(gate))
            expected = <at..u8>(0) bits = execution.presentwhen(gate)
            if (current.valuestate(valueindex) = 1) <> expected then return finish('failure','LL_IR_EXEC_PROTOCOL: conditional result disagrees with its Boolean gate')
          end
          if <at..u8>(0) bits = 0 then destination = 2
        end
        targetblock = operation.successor(destination); nextpc = _plan.first(targetblock)
        call current.advance(nextpc); _frames[_depth] = current as .object
      end
      else if opcode = 10 then do
        targetblock = operation.successor(2); nextpc = _plan.first(targetblock)
        call current.protect(nextpc)
        targetblock = operation.successor(1); nextpc = _plan.first(targetblock)
        call current.advance(nextpc); _frames[_depth] = current as .object
      end
      else if opcode = 7 then do
        reply = returning(op,values)
        if reply.status() <> 'running' then return reply
      end
      else if _plan.target(op) > 0 then do
        target = _plan.target(op); execution = _plan.execution()
        if execution.mapping(op,1) > 0 then do
          fn = _plan.function(target); mappedvalues = .object[]; mappedpresent = .int[]; empty = .object
          assembler setattrs mappedvalues,0
          assembler setattrs mappedpresent,0
          do formal = 1 to fn.arguments()
            map = execution.mapping(op,formal); source = execution.input(map); flag = execution.presence(map)
            has = source > 0
            if flag > 0 then do
              item = values[flag] as .llirexecute..value; bits = item.bits(); has = <at..u8>(0) bits
            end
            mappedpresent[formal] = has; mappedvalues[formal] = empty
            if has then mappedvalues[formal] = values[source]
          end
          values = mappedvalues; presence = mappedpresent
        end
        message = arguments(target,values,presence)
        if message <> '' then return finish('failure',message)
