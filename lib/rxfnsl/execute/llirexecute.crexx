/* cREXX License (MIT). Optional, bounded execution of admitted semantic IR. */
options levelb
namespace llirexecute expose value typehandler encodedtype request outcome handler registry plan token session result
import rxfnsb
import llir
import llirservices
import llirgraph
import llireffects

boot: initialiser expose serial
  serial = 0
  return
nextidentity: procedure = .int expose serial
  if serial = 9223372036854775807 then assembler signal "ERROR","LL_IR_EXEC_IDENTITY: identities exhausted"
  serial = serial + 1
  return serial
bad: procedure = .void
  arg message = .string
  assembler signal "ERROR",message
  return

/** Immutable runtime carrier. A payload is a strongly owned immutable box,
 * never a borrowed VM register or a serialized pointer. Its type service owns
 * validation and its logical retained-byte charge. */
value: class
  _type = .string
  _bits = .binary
  _payload = .object
  _haspayload = .int
  *: factory
    arg type = .string, bits = .binary, ?payload = .object
    _type = type; _bits = bits; _haspayload = ?payload
    if ?payload then _payload = payload
    return
  type: method = .string
    return _type
  bits: method = .binary
    return _bits
  haspayload: method = .int
    return _haspayload
  payload: method = .object
    return _payload

/** Trusted, pure value services. Materialization/check/charging must neither
 * perform target effects nor mutate a published carrier or its payload. */
typehandler: interface
  materialize: method = .llirexecute..value
    arg type = .string, bits = .binary
  check: method = .string
    arg item = .llirexecute..value
  bytes: method = .int
    arg item = .llirexecute..value

/** Ordinary exact encodings reuse the schema's existing codec algorithm. */
encodedtype: class implements .llirexecute..typehandler
  _codec = .llir..typecodec
  *: factory
    arg codec = .llir..typecodec
    _codec = codec
    return
  materialize: method = .llirexecute..value
    arg type = .string, bits = .binary
    return .llirexecute..value(type,bits)
  check: method = .string
    arg item = .llirexecute..value
    if item.haspayload() then return 'encoded values cannot contain a live payload'
    return _codec.check(item.bits())
  bytes: method = .int
    arg item = .llirexecute..value
    bits = item.bits()
    return <blen>(bits)

/** A synchronous operation request owns its values. Its opview is valid only
 * during dispatch; handlers must retain an origin/operation ID instead. */
request: class
  _operation = .llir..opview
  _values = .object[]
  _present = .int[]
  _budget = .int
  *: factory
    arg operation = .llir..opview, values = .object[], present = .int[], budget = .int
    _operation = operation; _values = values; _present = present; _budget = budget
    return
  operation: method = .llir..opview
    return _operation
  origin: method = .int
    at = .llir..origin
    at = _operation.origin()
    return at.id()
  size: method = .int
    return _values[0]
  at: method = .llirexecute..value
    arg i = .int
    return _values[i] as .llirexecute..value
  present: method = .int
    arg i = .int
    return _present[i]
  budget: method = .int
    return _budget

/** An operation completes, fails, or suspends. A failure carries exact opaque
 * payload bytes and an owned logical origin; it is not a folding result. */
outcome: class
  _status = .string
  _code = .string
  _message = .string
  _payload = .binary
  _origin = .int
  _values = .object[]
  _present = .int[]
  *: factory
    arg status = 'normal', code = '', message = '', payload = ''x as .binary, origin = 0
    _status = status; _code = code; _message = message; _payload = payload; _origin = origin
    return
  add: method = .void
    arg item = .llirexecute..value, present = 1
    i = _values[0] + 1; _values[i] = item as .object; _present[i] = present
    return
  status: method = .string
    return _status
  code: method = .string
    return _code
  message: method = .string
    return _message
  payload: method = .binary
    return _payload
  origin: method = .int
    return _origin
  size: method = .int
    return _values[0]
  at: method = .llirexecute..value
    arg i = .int
    return _values[i] as .llirexecute..value
  present: method = .int
    arg i = .int
    return _present[i]

/** One registered handler owns one mutable runtime service per session.
 * External work/state budgets are its separate contract. Cleanup is called
 * once on every terminal path, including cancellation and discard. */
handler: interface
  execute: method = .llirexecute..outcome
    arg request = .llirexecute..request
  cleanup: method = .void
    arg reason = .string

/** A sealed trusted capability registry. Named service ownership is separate
 * from operation bindings, so multiple operations share one authoritative
 * runtime pool/configuration rather than independent service copies. */
registry: class
  _sealed = .int
  _error = .string
  _manifest = .string
  _typenames = .string[]
  _types = .object[]
  _handlernames = .string[]
  _handlers = .object[]
  _opnames = .string[]
  _ophandlers = .string[]
  _opcalls = .int[]
  _effects = .object[]
  _bounds = .int[]
  *: factory
    arg contract = .llir..contract
    _sealed = 0; _error = ''
    if initialized(contract) = 0 then do; _error = 'LL_IR_EXEC_REGISTRY: trusted contract is uninitialized'; return; end
    if contract.error() <> '' then do; _error = contract.error(); return; end
    data = dereference contract.data()
    if data.sealed() = 0 then do; _error = 'LL_IR_EXEC_REGISTRY: trusted contract is not frozen'; return; end
    _manifest = contract.manifest()
    return
  mutable: method = .int
    if _sealed then do; _error = 'LL_IR_EXEC_REGISTRY: registry is sealed'; return 0; end
    return _error = ''
  type: method = .void
    arg name = .string, service = .object
    if mutable() = 0 then return
    if name = '' | typeindex(name) > 0 | initialized(service) = 0 then do
      _error = 'LL_IR_EXEC_TYPE: invalid or duplicate runtime type'; return
    end
    if service is .llirexecute..typehandler then do
      i = _typenames[0] + 1; _typenames[i] = name; _types[i] = service
    end
    else _error = 'LL_IR_EXEC_TYPE: type service has the wrong interface'
    return
  handler: method = .void
    arg name = .string, service = .object
    if mutable() = 0 then return
    if name = '' | handlerindex(name) > 0 | initialized(service) = 0 then do
      _error = 'LL_IR_EXEC_HANDLER: invalid or duplicate runtime handler'; return
    end
    if service is .llirexecute..handler then do
      i = _handlernames[0] + 1; _handlernames[i] = name; _handlers[i] = service
    end
    else _error = 'LL_IR_EXEC_HANDLER: service has the wrong interface'
    return
  operation: method = .void
    arg name = .string, handlerName = .string, effects = .llireffects..summary, bytes = 4096
    if mutable() = 0 then return
    if name = '' | opindex(name) > 0 | handlerName = '' | bytes < 0 then do
      _error = 'LL_IR_EXEC_OPERATION: invalid or duplicate binding'; return
    end
    i = _opnames[0] + 1; _opnames[i] = name; _ophandlers[i] = handlerName; _opcalls[i] = 0
    _effects[i] = effects as .object; _bounds[i] = bytes
    return
  call: method = .void
    arg name = .string, functionId = .int, effects = .llireffects..summary
    if mutable() = 0 then return
    if name = '' | opindex(name) > 0 | functionId < 1 then do
      _error = 'LL_IR_EXEC_CALL: invalid or duplicate binding'; return
    end
    i = _opnames[0] + 1; _opnames[i] = name; _ophandlers[i] = ''; _opcalls[i] = functionId
    _effects[i] = effects as .object; _bounds[i] = 0
    return
  seal: method = .int
    _sealed = 1
    do i = 1 to _opnames[0]
      if _opcalls[i] = 0 & handlerindex(_ophandlers[i]) = 0 then _error = 'LL_IR_EXEC_HANDLER: operation has no registered handler'
    end
    return _error = ''
  error: method = .string
    return _error
  matches: method = .int
    arg contract = .llir..contract
    return _error = '' & _manifest == contract.manifest()
  typeindex: method = .int
    arg name = .string
    do i = 1 to _typenames[0]; if _typenames[i] == name then return i; end
    return 0
  handlerindex: method = .int
    arg name = .string
    do i = 1 to _handlernames[0]; if _handlernames[i] == name then return i; end
    return 0
  opindex: method = .int
    arg name = .string
    do i = 1 to _opnames[0]; if _opnames[i] == name then return i; end
    return 0
  typeservice: method = .object
    arg i = .int
    return _types[i]
  service: method = .object
    arg i = .int
    return _handlers[i]
  putservice: method = .void
    arg i = .int, service = .object
    _handlers[i] = service
    return
  handlers: method = .int
    return _handlers[0]
  effect: method = .llireffects..summary
    arg i = .int
    return _effects[i] as .llireffects..summary
  target: method = .int
    arg i = .int
    return _opcalls[i]
  binding: method = .int
    arg i = .int
    return handlerindex(_ophandlers[i])
  bound: method = .int
    arg i = .int
    return _bounds[i]
  usedbytes: method = .int
    total = 0; i = .int; bits = .binary; summary = .llireffects..summary
    bits = _manifest as .binary; total = total + <blen>(bits)
    do i = 1 to _typenames[0]
      bits = _typenames[i] as .binary; total = total + <blen>(bits) + 64
    end
    do i = 1 to _handlernames[0]
      bits = _handlernames[i] as .binary; total = total + <blen>(bits) + 64
    end
    do i = 1 to _opnames[0]
      bits = _opnames[i] as .binary; total = total + <blen>(bits) + 96
      bits = _ophandlers[i] as .binary; total = total + <blen>(bits)
      summary = _effects[i] as .llireffects..summary; total = total + summary.bytes()
    end
    return total

/** Whole-module admission owns an immutable module and capability snapshot.
 * Graph/effect/definite-assignment services remain the algorithm owners. The
 * original owner is retained only for matches(), never for execution. Logical
 * budgets do not bound VM allocation overhead, RSS, or uncooperative handlers.
 * Work is a separate allowance for each shared preparation stage, rather than
 * an aggregate instruction counter. External service state is host owned. */
plan: class
  _source = reference .llir..module
  _revision = .int
  _graph = .llir..module
  _registry = .llirexecute..registry
  _status = .string
  _message = .string
  _valueindex = .int[]
  _slotindex = .int[]
  _fnvalues = .int[]
  _fnslots = .int[]
  _opcode = .int[]
  _aux = .int[]
  _next = .int[]
  _first = .int[]
  _calls = .int[]
  _handlers = .int[]
  _bounds = .int[]
  _summaries = .object[]
  _constants = .object[]
  _types = .object[]
  _typenames = .string[]
  _bytes = .int
  _worklimit = .int
  _bytelimit = .int
  *: factory
    arg owner = reference .llir..module, registry = .llirexecute..registry, work = 1000000, bytes = 67108864
    _source = owner; _registry = registry; _status = 'invalid'; _message = ''; _bytes = 0
    if <refvalid>(owner) = 0 then do; _message = 'LL_IR_EXEC_OWNER: module expired'; return; end
    borrowed = .llir..module; borrowed = dereference owner
    _graph = borrowed; _revision = _graph.identity()
    if _graph.error() <> '' then do; _message = _graph.error(); return; end
    if work < 1 | bytes < 1 then do; _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: execution preparation budgets must be positive'; return; end
    if _registry.seal() = 0 then do; _message = _registry.error(); return; end
    _worklimit = work; _bytelimit = bytes; _status = 'building'
    return
  run: method = .void
    if _status <> 'building' then return
    _status = 'invalid'
    do
      call prepare(_worklimit,_bytelimit)
    on signal as problem
      _status = 'invalid'; _message = 'LL_IR_EXEC_PREPARATION: ' || problem.message()
    end
    return
  prepare: method = .void
    arg work = .int, bytes = .int
    index = .llirgraph..index(reference _graph,work,bytes)
    if index.valid() = 0 then do; _status = index.status(); _message = index.message(); return; end
    store = dereference _graph.storage(); contract = dereference store.contract(); schema = dereference contract.data()
    if _registry.matches(contract) = 0 then do; _message = 'LL_IR_EXEC_VERSION: graph does not match the trusted runtime contract'; return; end
    f = .int; i = .int; op = .int; j = .int; v = .int; s = .int; t = .int; binding = .int; target = .int; count = .int
    operation = .llir..opview; input = .llir..valuehandle; item = .llirexecute..value
    summary = .llireffects..summary; fn = .llir..function; formaltype = .llir..typeid
    type = .llir..typeid; runtime = .llirexecute..typehandler; constantsize = .int; empty = .object
    /* Reserve maps, schema handles, source/IR and conservative local analysis
     * working storage before constructing runtime values. */
    _bytes = _graph.bytes()
    if _bytes > bytes then do; _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: owned IR exhausted'; return; end
    metadata = _registry.usedbytes()
    if metadata > bytes - _bytes then do; _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: runtime registry metadata exhausted'; return; end
    _bytes = _bytes + metadata
    maps = index.values() * 16 + index.slots() * 16 + index.operations() * 96 + index.blocks() * 16 + index.functions() * 32 + schema.types() * 32
    if maps > bytes - _bytes | index.usedbytes() > bytes - _bytes - maps then do
      _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: execution plan storage exhausted'; return
    end
    _bytes = _bytes + maps
    do t = 1 to schema.types()
      _typenames[t] = schema.typename(t)
      _types[t] = empty
      if t = 1 then iterate
      binding = _registry.typeindex(_typenames[t])
      if t = 2 then _types[t] = .llirexecute..encodedtype(.llir..boolcodec()) as .object
      else if binding > 0 then _types[t] = _registry.typeservice(binding)
    end
    indexbytes = index.usedbytes()
    model = .llireffects..model(reference _graph,'execution',1,work,bytes - _bytes - indexbytes)
    if model.error() <> '' then do; _status = 'limit'; _message = model.error(); return; end
    do f = 1 to index.functions()
      fn = _graph.function(f); _fnvalues[f] = 0; _fnslots[f] = index.functionslots(f)
      type = fn.resulttype()
      if requiretype(type.id()) = 0 then return
      do i = 1 to fn.arguments()
        type = fn.argumenttype(i)
        if requiretype(type.id()) = 0 then return
      end
      do i = 1 to index.functionslots(f)
        s = index.functionslot(f,i); _slotindex[s] = i
        if requiretype(store.get(5,s,2)) = 0 then return
      end
      do i = 1 to index.functionoperations(f)
        op = index.functionoperation(f,i); operation = _graph.operation(op)
        _opcode[op] = index.opcode(op); _aux[op] = store.get(3,op,12); _next[op] = index.nextop(op)
        _calls[op] = 0; _handlers[op] = 0; _bounds[op] = 0
        do j = 1 to operation.results()
          input = operation.result(j); v = input.id(); type = input.type()
          _fnvalues[f] = _fnvalues[f] + 1; _valueindex[v] = _fnvalues[f]
          if requiretype(type.id()) = 0 then return
        end
        if _opcode[op] = 10 | (_opcode[op] > 10 & _opcode[op] <= 16) then do
          _message = 'LL_IR_EXEC_CONTROL: unsupported core control ' || operation.name(); return
        end
        if _opcode[op] = 1 then do
          input = operation.result(); type = input.type(); t = type.id(); runtime = _types[t] as .llirexecute..typehandler
          item = runtime.materialize(_typenames[t],input.bytes())
          _message = checkvalue(item,t)
          if _message <> '' then return
          if bin2x(item.bits()) <> bin2x(input.bytes()) then do; _message = 'LL_IR_EXEC_TYPE: constant materializer changed exact bits'; return; end
          constantsize = valuebytes(item,t)
          if constantsize < 0 | constantsize > bytes - _bytes - indexbytes - model.usedbytes() then do
            _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: materialized constants exhausted'; return
          end
          _constants[op] = item as .object; _bytes = _bytes + constantsize
        end
        if _opcode[op] <= 16 then iterate
        binding = _registry.opindex(operation.name())
        if binding = 0 then do; _message = 'LL_IR_EXEC_CAPABILITY: no runtime binding for ' || operation.name(); return; end
        summary = _registry.effect(binding)
        if summary.complete() = 0 | summary.inputs() <> operation.inputs() | summary.results() <> operation.results() then do
          _message = 'LL_IR_EXEC_EFFECT: incomplete or mismatched runtime summary'; return
        end
        if summary.transfer() <> 'none' then do; _message = 'LL_IR_EXEC_CONTROL: runtime transfer is unsupported'; return; end
        do j = 1 to summary.inputs()
          if summary.operandmode(j) <> 'value' then do; _message = 'LL_IR_EXEC_VALUE: borrowing or escaping operands are unsupported'; return; end
        end
        do j = 1 to summary.results()
          if summary.availability(j) <> 'normal' then do; _message = 'LL_IR_EXEC_VALUE: conditional results are unsupported'; return; end
        end
        if summary.bytes() > bytes - _bytes - indexbytes - model.usedbytes() then do
          _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: runtime effect metadata exhausted'; return
        end
        call model.put(op,summary); _summaries[op] = summary as .object
        target = _registry.target(binding)
        if target > 0 then do
          if target > index.functions() then do; _message = 'LL_IR_EXEC_CALL: foreign function target'; return; end
          fn = _graph.function(target)
          if operation.inputs() > fn.arguments() then do; _message = 'LL_IR_EXEC_CALL: too many call arguments'; return; end
          do j = 1 to fn.arguments()
            if j <= operation.inputs() then do
              input = operation.input(j); type = input.type(); formaltype = fn.argumenttype(j)
              if type.id() <> formaltype.id() then do; _message = 'LL_IR_EXEC_CALL: argument type mismatch'; return; end
            end
            else if fn.optional(j) = 0 then do; _message = 'LL_IR_EXEC_CALL: missing required argument'; return; end
          end
          type = fn.resulttype(); count = type.id() <> 1
          if operation.results() <> count then do; _message = 'LL_IR_EXEC_CALL: result arity mismatch'; return; end
          if count then do
            input = operation.result(); formaltype = input.type()
            if type.id() <> formaltype.id() then do; _message = 'LL_IR_EXEC_CALL: result type mismatch'; return; end
          end
          _calls[op] = target
        end
        else do; _handlers[op] = _registry.binding(binding); _bounds[op] = _registry.bound(binding); end
      end
    end
    do i = 1 to index.blocks(); _first[i] = index.firstop(i); end
    if model.seal() = 0 then do; _message = model.error(); return; end
    /* Definite assignment owns its lattice algorithm. Admit its conservative
     * peak while index/model locals remain live; divide before multiplying
     * potentially large block/slot counts. */
    scratch = _graph.blocks() * 128 + store.count(7) * 32 + store.count(5) * 2
    available = bytes - _bytes - indexbytes - model.usedbytes()
    if scratch > available then do; _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: initialization analysis scratch exhausted'; return; end
    available = available - scratch
    if store.count(5) > 0 then do
      if _graph.blocks() > (available <idiv> 2) <idiv> store.count(5) then do
        _status = 'limit'; _message = 'LL_RESOURCE_LIMIT: initialization analysis lattice exhausted'; return
      end
    end
    analysis = .llirservices..analysis
    analysis = llirservices..analyse(reference _graph,work)
    if analysis.status() <> 'ok' then do; _status = analysis.status(); _message = analysis.message(); return; end
    if analysis.issues() > 0 then do; _message = 'LL_IR_EXEC_INITIALIZATION: ' || analysis.diagnostic(1); return; end
    _status = 'ok'; _message = ''
    return
  requiretype: method = .int
    arg t = .int
    if t = 1 then return 1
    if initialized(_types[t]) then return 1
    _message = 'LL_IR_EXEC_CAPABILITY: no runtime type for ' || _typenames[t]
    return 0
  valid: method = .int
    call run()
    return _status = 'ok'
  status: method = .string
    call run()
    return _status
  message: method = .string
    call run()
    return _message
  matches: method = .int
    arg owner = reference .llir..module
    if <refvalid>(_source) = 0 | <refvalid>(owner) = 0 then return 0
    if (_source <refsame> owner) = 0 then return 0
    graph = dereference owner
    return graph.identity() = _revision
  usedbytes: method = .int
    call run()
    return _bytes
  functions: method = .int
    return _graph.functions()
  function: method = .llir..function
    arg f = .int
    return _graph.function(f)
  operation: method = .llir..opview
    arg op = .int
    return _graph.operation(op)
  opcode: method = .int
    arg op = .int
    return _opcode[op]
  aux: method = .int
    arg op = .int
    return _aux[op]
  next: method = .int
    arg op = .int
    return _next[op]
  first: method = .int
    arg block = .int
    return _first[block]
  entry: method = .int
    arg f = .int
    store = dereference _graph.storage()
    return first(store.get(1,f,3))
  valueindex: method = .int
    arg v = .int
    return _valueindex[v]
  slotindex: method = .int
    arg s = .int
    return _slotindex[s]
  values: method = .int
    arg f = .int
    return _fnvalues[f]
  slots: method = .int
    arg f = .int
    return _fnslots[f]
  target: method = .int
    arg op = .int
    return _calls[op]
  bound: method = .int
    arg op = .int
    return _bounds[op]
  summary: method = .llireffects..summary
    arg op = .int
    return _summaries[op] as .llireffects..summary
  constant: method = .llirexecute..value
    arg op = .int
    return _constants[op] as .llirexecute..value
  typename: method = .string
    arg t = .int
    return _typenames[t]
  checkvalue: method = .string
    arg item = .llirexecute..value, t = .int
    if initialized(item) = 0 then return 'LL_IR_EXEC_TYPE: uninitialized runtime value'
    if item.type() <> _typenames[t] then return 'LL_IR_EXEC_TYPE: runtime value type mismatch'
    runtime = _types[t] as .llirexecute..typehandler
    message = .string
    do
      message = runtime.check(item)
    on signal as problem
      message = problem.message()
    end
    if message <> '' then return 'LL_IR_EXEC_TYPE: ' || message
    return ''
  valuebytes: method = .int
    arg item = .llirexecute..value, t = .int
    runtime = _types[t] as .llirexecute..typehandler
    amount = .int; amount = -1
    do
      amount = runtime.bytes(item)
    on signal
      amount = -1
    end
    return amount
  dispatch: method = .llirexecute..outcome
    arg op = .int, request = .llirexecute..request
    binding = _handlers[op]; service = _registry.service(binding) as .llirexecute..handler
    answer = .llirexecute..outcome
    do
      answer = service.execute(request)
    on signal as problem
      answer = .llirexecute..outcome('failure',problem.name(),problem.message(),''x as .binary,request.origin())
    end
    /* Explicit writeback preserves one mutable service, including mutations
     * made before a handler reports or raises a failure. */
    call _registry.putservice(binding,service as .object)
    return answer
  cleanup: method = .string
    arg reason = .string
    message = .string; message = ''
    do i = 1 to _registry.handlers()
      service = _registry.service(i) as .llirexecute..handler
      do
        call service.cleanup(reason)
      on signal as problem
        if message = '' then message = 'LL_IR_EXEC_CLEANUP: ' || problem.message()
      end
      call _registry.putservice(i,service as .object)
    end
    return message
  service: method = .object
    arg name = .string
    i = _registry.handlerindex(name)
    if i = 0 then do; call bad('LL_IR_EXEC_HANDLER: unknown service'); empty = .object; return empty; end
    return _registry.service(i)

/** A continuation names the original session storage as well as its serial
 * and generation. Copying a token does not create a second right to resume. */
token: class
  _owner = reference .int
  _identity = .int
  _generation = .int
  *: factory
    arg owner = reference .int, identity = .int, generation = .int
    _owner = owner; _identity = identity; _generation = generation
    return
  identity: method = .int
    return _identity
  generation: method = .int
    return _generation
  matches: method = .int
    arg owner = reference .int, identity = .int, generation = .int
