        if answer.status() = 'suspend' then do
          if summary.resume() <> 'possible' | answer.size() <> 0 then return finish('failure','LL_IR_EXEC_PROTOCOL: undeclared or malformed suspension')
          _status = 'suspended'; _generation = _generation + 1
          at = operation.origin()
          _last = boundaryresult('suspended',answer.message(),answer.code(),answer.payload(),at.id())
          call _last.setoperation(op)
          if answer.hasevent() then do; event = answer.event(); call _last.setevent(event); end
          do i = 1 to answer.controls()
            item = answer.controlat(i); has = answer.controlpresent(i)
            call _last.addcontrol(item,has)
          end
          continuation = .llirexecute..token(reference _anchor,_identity,_generation)
          call _last.continuation(continuation)
          return _last
        end
        if answer.status() = 'transfer' then do
          if wordpos('transfer',_plan.portkind(op)) = 0 | summary.transfer() <> 'possible' | answer.size() <> 0 then return finish('failure','LL_IR_EXEC_PROTOCOL: undeclared or malformed transfer')
          return terminal(answer,'transferred',op)
        end
        if answer.status() = 'failure' then do
          if summary.failure() <> 'possible' | answer.size() <> 0 then return finish('failure','LL_IR_EXEC_PROTOCOL: undeclared or malformed runtime failure')
          reply = failed(answer,op)
          if reply.status() <> 'running' then return reply
          iterate
        end
        message = admit(op,answer,_pendingbytes)
        if message <> '' then return finish('failure',message)
        call releasepending(); call apply(op,answer)
      end
    end
    return _last
  admit: method = .string
    arg op = .int, answer = .llirexecute..outcome, reservation = .int
    if answer.status() <> 'normal' then return 'LL_IR_EXEC_PROTOCOL: expected a normal runtime result'
    if _plan.terminalop(op) then return 'LL_IR_EXEC_PROTOCOL: terminal operation attempted ordinary continuation'
    operation = .llir..opview; operation = _plan.operation(op)
    input = .llir..valuehandle; type = .llir..typeid; item = .llirexecute..value
    current = _frames[_depth] as .llirexecute..frame; total = 0; old = 0
    if answer.size() <> operation.results() then return 'LL_IR_EXEC_PROTOCOL: runtime result arity mismatch'
    do i = 1 to answer.size()
      input = operation.result(i); type = input.type()
      if answer.present(i) = 0 then do
        if _plan.opcode(op) <= 16 then return 'LL_IR_EXEC_PROTOCOL: core result is absent'
        summary = _plan.summary(op)
        if summary.availability(i) <> 'conditional' then return 'LL_IR_EXEC_PROTOCOL: required runtime result is absent'
        old = old + current.valuebytes(_plan.valueindex(input.id()))
        iterate
      end
      if answer.present(i) <> 1 then return 'LL_IR_EXEC_PROTOCOL: invalid result presence'
      item = answer.at(i)
      message = _plan.checkvalue(item,type.id())
      if message <> '' then return message
      amount = _plan.valuebytes(item,type.id())
      if amount < 0 | amount > _bytelimit - total then return 'LL_RESOURCE_LIMIT: invalid runtime value size'
      total = total + amount; old = old + current.valuebytes(_plan.valueindex(input.id()))
    end
    if reservation >= 0 & total > reservation then return 'LL_IR_EXEC_PROTOCOL: handler exceeded its output bound'
    available = _bytelimit - _bytes + old
    if reservation > 0 then available = available + reservation
    if total > available then return 'LL_RESOURCE_LIMIT: runtime values exhausted'
    return ''
  packet: method = .string
    arg op = .int, answer = .llirexecute..outcome
    if initialized(answer) = 0 then return 'LL_IR_EXEC_PROTOCOL: uninitialized operation outcome'
    message = _plan.checkevent(answer)
    if message <> '' then return message
    operation = .llir..opview; operation = _plan.operation(op); at = .llir..origin; at = operation.origin()
    if answer.origin() <> 0 & answer.origin() <> at.id() then return 'LL_IR_EXEC_ORIGIN: foreign operation origin'
    bits = answer.payload(); codebits = answer.code() as .binary; messagebits = answer.message() as .binary
    size = <blen>(bits)
    if size > _pendingbytes then return 'LL_IR_EXEC_PROTOCOL: control packet exceeded its bound'
    if <blen>(codebits) > _pendingbytes - size then return 'LL_IR_EXEC_PROTOCOL: control packet exceeded its bound'
    size = size + <blen>(codebits)
    if <blen>(messagebits) > _pendingbytes - size then return 'LL_IR_EXEC_PROTOCOL: control packet exceeded its bound'
    if answer.eventbytes() < 0 | answer.eventbytes() > _pendingbytes - size - <blen>(messagebits) then return 'LL_IR_EXEC_PROTOCOL: event exceeded its bound'
    if answer.status() = 'normal' & (size + <blen>(messagebits) > 0 | answer.hasevent() | answer.controls() > 0) then return 'LL_IR_EXEC_PROTOCOL: normal outcome contains a control packet'
    controlamount = controlbytes(answer)
    if controlamount < 0 then return 'LL_IR_EXEC_PROTOCOL: invalid control carrier or escaped binding lease'
    if controlamount > _pendingbytes - size - <blen>(messagebits) - answer.eventbytes() then return 'LL_IR_EXEC_PROTOCOL: control values exceeded their bound'
    return ''
  controlbytes: method = .int
    arg answer = .llirexecute..outcome
    total = 0
    do i = 1 to answer.controls()
      if answer.controlpresent(i) <> 1 then return -1
      item = answer.controlat(i); type = _plan.typeindex(item.type())
      if type < 1 | _plan.islease(item.type()) then return -1
      if _plan.checkvalue(item,type) <> '' then return -1
      amount = _plan.valuebytes(item,type)
      if amount < 0 | amount > _bytelimit - total - 32 then return -1
      total = total + amount + 32
    end
    return total
  apply: method = .void
    arg op = .int, answer = .llirexecute..outcome
    operation = .llir..opview; operation = _plan.operation(op)
    input = .llir..valuehandle; type = .llir..typeid; item = .llirexecute..value
    current = _frames[_depth] as .llirexecute..frame
    do i = 1 to answer.size()
      input = operation.result(i); type = input.type(); index = _plan.valueindex(input.id()); old = current.valuebytes(index)
      amount = 0
      if answer.present(i) then do
        item = answer.at(i); amount = _plan.valuebytes(item,type.id()); call current.putvalue(index,item,amount)
      end
      else call current.absentvalue(index)
      _bytes = _bytes - old + amount
    end
    nextpc = _plan.next(op); call current.advance(nextpc); _frames[_depth] = current as .object
    return
  returning: method = .llirexecute..result
    arg op = .int, values = .object[]
    current = _frames[_depth] as .llirexecute..frame; caller = current.caller()
    item = .llirexecute..value; answer = .llirexecute..outcome
    resultbytes = .int; resultbytes = 0
    fn = .llir..function; type = .llir..typeid
    if _depth = 1 then do
      if values[0] = 1 then do
        item = values[1] as .llirexecute..value; fn = _plan.function(current.function()); type = fn.resulttype()
        resultbytes = _plan.valuebytes(item,type.id())
        if resultbytes < 0 then return finish('failure','LL_IR_EXEC_TYPE: invalid final result charge')
      end
      reply = finish('done','')
      if reply.status() = 'done' & values[0] = 1 then do
        _bytes = _bytes + resultbytes + 32
        reply = boundaryresult('done','','',''x as .binary,0)
        call reply.add(item)
      end
      _last = reply
      return reply
    end
    /* Validate the caller's result contract before changing either frame.
     * The returned carrier is already charged in the child, so transferring
     * it after this check cannot exceed the retained-byte budget. */
    answer = .llirexecute..outcome()
    if values[0] = 1 then call answer.add(values[1] as .llirexecute..value)
    operation = .llir..opview; operation = _plan.operation(caller)
    input = .llir..valuehandle
    if answer.size() <> operation.results() then return finish('failure','LL_IR_EXEC_CALL: return arity mismatch')
    do i = 1 to answer.size()
      item = answer.at(i); input = operation.result(i); type = input.type()
      message = _plan.checkvalue(item,type.id())
      if message <> '' then return finish('failure',message)
      if _plan.valuebytes(item,type.id()) < 0 then return finish('failure','LL_IR_EXEC_TYPE: negative return size')
    end
    empty = .object
    cleanup = leaveframe(_depth,'return')
    if cleanup <> '' then return terminal(_notice,'failure',op)
    _bytes = _bytes - current.bytes(); _cells = _cells - current.cells(); _frames[_depth] = empty; _depth = _depth - 1
    call apply(caller,answer)
    return .llirexecute..result('running')
  releasepending: method = .void
    _cells = _cells - _pendingcells; _bytes = _bytes - _pendingbytes
    _pending = 0; _pendingcells = 0; _pendingbytes = 0
    return
  failed: method = .llirexecute..result
    arg answer = .llirexecute..outcome, op = .int
    origin = answer.origin()
    if origin = 0 then do
      operation = .llir..opview; operation = _plan.operation(op); at = .llir..origin; at = operation.origin(); origin = at.id()
      /* Exceptional entry receives the same effective origin as a terminal
       * failure. Copy the owned packet without reducing its event capsule. */
      status = answer.status(); code = answer.code(); message = answer.message(); payload = answer.payload()
      normalized = .llirexecute..outcome(status,code,message,payload,origin)
      if answer.hasevent() then do
        event = answer.event(); amount = answer.eventbytes(); call normalized.setevent(event,amount)
      end
      do i = 1 to answer.controls()
        item = answer.controlat(i); present = answer.controlpresent(i); call normalized.addcontrol(item,present)
      end
      answer = normalized
    end
    /* Protection belongs to the invocation that declared it. A child fault
     * unwinds only crossed frames; the exceptional path cannot catch itself. */
    do depth = _depth to 1 by -1
      protected = _frames[depth] as .llirexecute..frame
      if protected.protection() = 0 then iterate
      do while _depth > depth
        child = _frames[_depth] as .llirexecute..frame
        cleanup = leaveframe(_depth,'unwind')
        _bytes = _bytes - child.bytes(); _cells = _cells - child.cells()
        empty = .object; _frames[_depth] = empty; _depth = _depth - 1
      end
      bits = answer.payload(); codebits = answer.code() as .binary; messagebits = answer.message() as .binary
      faultbytes = <blen>(bits) + <blen>(codebits) + <blen>(messagebits) + answer.eventbytes()
      call releasepending()
      oldbytes = protected.bytes()
      nextpc = protected.protection()
      call protected.advance(nextpc); call protected.protect(0); call protected.setfault(answer,faultbytes)
      if protected.bytes() - oldbytes > _bytelimit - _bytes then return terminal(answer,'failure',op)
      _bytes = _bytes + protected.bytes() - oldbytes
      _frames[depth] = protected as .object; _status = 'running'
      return .llirexecute..result('running')
    end
    return terminal(answer,'failure',op)
  terminal: method = .llirexecute..result
    arg answer = .llirexecute..outcome, status = .string, op = .int
    origin = answer.origin()
    if origin = 0 & op > 0 then do; operation = _plan.operation(op); at = operation.origin(); origin = at.id(); end
    reply = finish(status,answer.message(),answer.code(),answer.payload(),origin)
    _bytes = _bytes + answer.eventbytes()
    amount = controlbytes(answer)
    if amount > 0 then _bytes = _bytes + amount
    call reply.setusedbytes(_bytes)
    call reply.setoperation(op)
    if answer.hasevent() then do; event = answer.event(); call reply.setevent(event); end
    do i = 1 to answer.controls()
      item = answer.controlat(i); has = answer.controlpresent(i)
      call reply.addcontrol(item,has)
    end
    _last = reply
    return reply
  abort: method = .llirexecute..result
    arg answer = .llirexecute..outcome
    if ownerlive() = 0 then return rejected('LL_IR_EXEC_OWNER: active session was copied or expired')
    if _status <> 'running' & _status <> 'suspended' then return _last
    if initialized(answer) = 0 then return rejected('LL_IR_EXEC_PROTOCOL: uninitialized abort event')
    if answer.status() <> 'failure' | answer.size() <> 0 then return rejected('LL_IR_EXEC_PROTOCOL: abort requires an owned failure')
    message = _plan.checkevent(answer)
    if message <> '' then return rejected(message)
    /* A native event may bypass the ordinary callback epilogue. Revocation
     * precedes every cleanup callback, even when _busy was left set. */
    _busy = 0; _dispatch = 0; _generation = _generation + 1
    return terminal(answer,'failure',_activeop)
  resume: method = .llirexecute..result
    arg token = .llirexecute..token, outcome = .llirexecute..outcome
    if ownerlive() = 0 then return rejected('LL_IR_EXEC_OWNER: active session was copied or expired')
    if _status <> 'suspended' then return rejected('LL_IR_EXEC_STATE: session is not suspended')
    if initialized(token) = 0 then return rejected('LL_IR_EXEC_TOKEN: uninitialized continuation')
    if token.matches(reference _anchor,_identity,_generation) = 0 then return rejected('LL_IR_EXEC_TOKEN: foreign or consumed continuation')
    message = packet(_pending,outcome)
    if message <> '' then return rejected(message)
    if outcome.status() = 'failure' then do
      summary = _plan.summary(_pending)
      if summary.failure() <> 'possible' | outcome.size() <> 0 then return rejected('LL_IR_EXEC_PROTOCOL: invalid resumed failure')
      _generation = _generation + 1
      reply = failed(outcome,_pending)
      if reply.status() = 'running' then return run()
      return reply
    end
    message = admit(_pending,outcome,_pendingbytes)
    if message <> '' then return rejected(message)
    op = _pending; _generation = _generation + 1; call releasepending(); call apply(op,outcome)
    _status = 'running'
    return run()
  discard: method = .llirexecute..result
    arg token = .llirexecute..token
    if ownerlive() = 0 then return rejected('LL_IR_EXEC_OWNER: active session was copied or expired')
    if _status <> 'suspended' then return rejected('LL_IR_EXEC_STATE: session is not suspended')
    if initialized(token) = 0 then return rejected('LL_IR_EXEC_TOKEN: uninitialized continuation')
    if token.matches(reference _anchor,_identity,_generation) = 0 then return rejected('LL_IR_EXEC_TOKEN: foreign or consumed continuation')
    _generation = _generation + 1
    return finish('discarded','')
  cancel: method = .llirexecute..result
    if ownerlive() = 0 then return rejected('LL_IR_EXEC_OWNER: active session was copied or expired')
    if _busy then return rejected('LL_IR_EXEC_STATE: reentrant dispatch is unsupported')
    if _status = 'ready' then do
      _identity = nextidentity(); _anchor = _identity; _self = reference _anchor
      return finish('cancelled','')
    end
    if _status <> 'running' & _status <> 'suspended' then return _last
    _generation = _generation + 1
    return finish('cancelled','')
  boundaryresult: method = .llirexecute..result
    arg status = .string, message = .string, code = .string, payload = .binary, origin = .int
    return .llirexecute..result(status,message,code,payload,origin,_steps,_depth,_bytes)
  finish: method = .llirexecute..result
    arg status = .string, message = .string, code = '', payload = ''x as .binary, origin = 0
    diagnosticop = 0
    if status = 'failure' | status = 'limit' then do
      diagnosticop = _activeop
      if origin = 0 then origin = _activeorigin
    end
    if code = '' then do
      colon = pos(':',message)
      if colon > 1 then code = left(message,colon - 1)
    end
    /* Revoke entry before cleanup. A reentrant observer cannot obtain a
     * successful result until every frame and terminal notification completed. */
    _status = 'closing'; _generation = _generation + 1; _busy = 0; _dispatch = 0
    _last = boundaryresult('rejected','LL_IR_EXEC_STATE: session is closing','LL_IR_EXEC_STATE',''x as .binary,0)
    cleanupfault = .llirexecute..outcome()
    do while _depth > 0
      frame = _frames[_depth] as .llirexecute..frame
      reason = status
      if status = 'done' then reason = 'return'
      framecleanup = leaveframe(_depth,reason)
      if framecleanup <> '' & status <> 'failure' then do; status = 'failure'; message = framecleanup; code = 'LL_IR_EXEC_FRAME'; cleanupfault = _notice; end
      _depth = _depth - 1
    end
    if _cleaned = 0 then do
      _cleaned = 1; cleanup = _plan.cleanup(status)
      if cleanup <> '' & status <> 'failure' then do; status = 'failure'; message = cleanup; code = 'LL_IR_EXEC_CLEANUP'; cleanupfault = _plan.cleanupfault(); end
    end
    call objectarraydrop _frames
    _depth = 0; _cells = 0; _pending = 0; _pendingcells = 0; _pendingbytes = 0
    packet = payload; codebits = code as .binary; messagebits = message as .binary
    _bytes = _plan.usedbytes() + <blen>(packet) + <blen>(codebits) + <blen>(messagebits)
    /* Fixed diagnostics may report an exhausted or invalid budget. Caller
     * copies of published results have their own lifetime and are not charged
     * repeatedly to this session. Handler packets were reserved before use. */
    _bytes = _bytes + cleanupfault.eventbytes()
    _status = status; _last = boundaryresult(status,message,code,payload,origin)
    if diagnosticop > 0 then call _last.setoperation(diagnosticop)
    if cleanupfault.hasevent() then do; event = cleanupfault.event(); call _last.setevent(event); end
    _anchor = 0
    return _last
  service: method = .object
    arg name = .string
    if ownerlive() = 0 then do; call bad('LL_IR_EXEC_OWNER: active session was copied or expired'); empty = .object; return empty; end
    return _plan.service(name)
