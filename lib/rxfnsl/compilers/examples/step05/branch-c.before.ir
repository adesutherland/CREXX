function $MAIN -> crexx.c.result
  entry.1:
    %1 = crexx.c.pool.new @origin:2
    core.store %1 slot:$pool @origin:2
    %2 = core.argument argument:1 @origin:2
    core.store %2 slot:$arguments @origin:2
    %3 = core.argument argument:2 @origin:2
    core.store %3 slot:$numeric @origin:2
    %4 = core.constant 31 : crexx.c.value @origin:11
    %5 = crexx.c.truth %4 @origin:4
    core.branch %5 -> if.yes.2 -> if.no.3 @origin:4
  if.yes.2:
    %6 = core.constant 796573 : crexx.c.value @origin:19
    crexx.c.say %6 @origin:12
    core.jump -> if.join.4 @origin:4
  if.no.3:
    %7 = core.constant 6E6F : crexx.c.value @origin:27
    crexx.c.say %7 @origin:20
    core.jump -> if.join.4 @origin:4
  if.join.4:
    %8 = crexx.c.return.absent @origin:2
    core.return %8 @origin:2
