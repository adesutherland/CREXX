function $MAIN -> crexx.g.int64
  entry.1:
    %1 = core.constant 1 : crexx.g.int64 @origin:12
    %2 = crexx.g.convert.int64.boolean %1 @origin:4
    %3 = crexx.g.truth %2 @origin:4
    core.branch %3 -> if.yes.2 -> if.no.3 @origin:4
  if.yes.2:
    %4 = core.constant yes : crexx.g.text @origin:21
    crexx.g.say %4 @origin:13
    core.jump -> if.join.4 @origin:4
  if.no.3:
    %5 = core.constant no : crexx.g.text @origin:30
    crexx.g.say %5 @origin:22
    core.jump -> if.join.4 @origin:4
  if.join.4:
    %6 = core.constant 0 : crexx.g.int64 @origin:2
    core.return %6 @origin:2
