function $MAIN -> crexx.c.result
  entry.1:
    %1 = crexx.c.pool.new @origin:2
    core.store %1 slot:$pool @origin:2
    %2 = core.argument argument:1 @origin:2
    core.store %2 slot:$arguments @origin:2
    %3 = core.argument argument:2 @origin:2
    core.store %3 slot:$numeric @origin:2
    %4 = core.constant 3031 : crexx.c.value @origin:11
    crexx.c.say %4 @origin:4
    %5 = core.constant 31 : crexx.c.value @origin:19
    %6 = crexx.c.truth %5 @origin:12
    core.branch %6 -> if.yes.2 -> if.no.3 @origin:12
  if.yes.2:
    %7 = core.constant 6F6B : crexx.c.value @origin:27
    crexx.c.say %7 @origin:20
    core.jump -> if.join.4 @origin:12
  if.no.3:
    %8 = core.constant 31 : crexx.c.value @origin:35
    core.store %8 slot:$tmp.1 @origin:34
    %9 = core.constant 30 : crexx.c.value @origin:36
    %10 = core.load slot:$tmp.1 @origin:34
    %11 = core.load slot:$numeric @origin:34
    %12 = crexx.c.div %10 %9 %11 @origin:34
    crexx.c.say %12 @origin:28
    core.jump -> if.join.4 @origin:12
  if.join.4:
    %13 = crexx.c.return.absent @origin:2
    core.return %13 @origin:2

