  binary: method = .llir..valuehandle
    arg left = .llir..valuehandle, operator = .string, rightnode = .llast..node, origin = .llir..origin, expected = ''
    saved = temporary(left.type()); call _block.store(saved,left,origin)
    target = ''; if _level = 'g' then do
