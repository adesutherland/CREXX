options levelc
/* A nested /* lexical */ comment, eager operands and a loop return. */
say 0 & (1 | mark())
say 1 | (0 & mark())
say once()
numeric digits setting(4)
numeric fuzz setting(1)
say digits()
say 1.234 = 1.233
numeric fuzz
say 1.234 = 1.233
numeric digits
say digits()
exit 0
mark: procedure
 say 'rhs'
 return 1
once: procedure
 i = 0
 do while i < 1
  i = i + 1
  return i
 end
 return 0
setting: procedure
 arg n
 say 'setting' n
 return n
