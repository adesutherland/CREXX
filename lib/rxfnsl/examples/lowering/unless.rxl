/* A small rules language. Each statement ends with a semicolon. */
namespace unlesslang
identifier: token
number: token
kw.unless: token
kw.do: token
kw.end: token
kw.say: token
equals: token
semi: token
scan: lexer input utf8
  letter: charset = 'A' to 'Z' | 'a' to 'z' | '_'
  part: charset = letter | '0' to '9'
  digit: charset = '0' to '9'
  space: charset = ' ' | U+0009 | U+000A | U+000D
  if.word: rule = 'unless' then emit kw.unless
  then.word: rule = 'do' then emit kw.do
  end.word: rule = 'end' then emit kw.end
  say.word: rule = 'say' then emit kw.say
  name.word: rule = letter part* then emit identifier
  number.word: rule = digit+ then emit number
  equals.word: rule = '=' then emit equals
  semi.word: rule = ';' then emit semi
  spaces: rule = space+ then skip
parse: parser semantics contextfree input tokens start program backend ll1
program: rule = (statement as item)*
  then tree Program(items = item*)
block: rule = (statement as item)*
  then tree Block(items = item*)
statement: rule = assignment | conditional | output
assignment: rule = identifier as name equals expression as value semi
  then tree Assignment(name = text(name), value = value)
conditional: rule = kw.unless expression as condition kw.do block as body kw.end semi
  then tree Unless(condition = condition, body = body)
output: rule = kw.say expression as value semi
  then tree Say(value = value)
expression: rule = variable | literal
variable: rule = identifier as spelling
  then tree Name(spelling = text(spelling))
literal: rule = number as spelling
  then tree Number(spelling = text(spelling))
