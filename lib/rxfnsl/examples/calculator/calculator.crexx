/* cREXX License (MIT). Complete Level L calculator: selected tree to value. */
options levelb
import rxfnsb
import lllanguage
import llsource
import llast
import levell_calculator

/** Parse the whole file before evaluating. Decimal arithmetic belongs to this
 * example, not the grammar or parser. A postorder walk evaluates children first;
 * it does not reparse source or use an additional recursive evaluator stack.
 * @param argv One input filename.
 * @return 0 on success; a parser status or 3 for an application/value failure.
 */
main: procedure = .int
  arg argv = .string[]
  if argv[0] <> 1 then do
    say 'usage: calculator expression.calc'; return 3
  end
  source = .binary
  do
    source = readbinary(argv[1])
  on signal
    say 'CALC_IO: cannot read ' || argv[1]; return 3
  end
  language = levell_calculator..language()
  request = .lllanguage..request(language,source)
  status = request.parse()
  if status <> 0 then do
    say argv[1] || ': ' || llsource..diagnostic(source,request.offset(),'CALC_PARSE',request.error())
    return status
  end
  tree = request.ast()
  if tree.error() <> '' then do
    say 'CALC_TREE: ' || tree.error(); return 3
  end
  walk = tree.walk('children first')
  values = .decimal[]
  node = .llast..node
  a = .decimal; b = .decimal; value = .decimal
  do
    do while walk.next()
      node = walk.node()
      select node.kind()
        when 'Number' then value = node.text('spelling') as .decimal
        when 'Negate' then value = -values[node.child('value').id()]
        otherwise do
          a = values[node.child('left').id()]
          b = values[node.child('right').id()]
          select node.kind()
            when 'Add' then value = a + b
            when 'Subtract' then value = a - b
            when 'Multiply' then value = a * b
            when 'Divide' then do
              if b = 0 then do
                say argv[1] || ': ' || llsource..diagnostic(source,node.child('right').start(),'CALC_DIVIDE_BY_ZERO','The denominator evaluates to zero.')
                return 3
              end
              value = a / b
            end
            otherwise do
              say 'CALC_TREE: unexpected kind ' || node.kind(); return 3
            end
          end
        end
      end
      values[node.id()] = value
    end
  on signal
    say argv[1] || ': ' || llsource..diagnostic(source,node.start(),'CALC_VALUE','Decimal conversion or arithmetic failed.')
    return 3
  end
  if walk.error() <> '' then do
    say 'CALC_TREE: ' || walk.error(); return 3
  end
  say 'RESULT|' || values[tree.root().id()]
  return 0
