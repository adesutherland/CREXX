options levelb comments_dash numeric_classic
namespace rexxclassicbifmax expose rexxclassicbif_max
import rexxclassicbifs
import rexxvalue

/**
 * Return the greatest Classic numeric argument.
 *
 * @bif MAX
 * @signature MAX(number, ...)
 * @checkargs rNUM...
 * @sandbox pure
 * @return first greatest normalized argument as a RexxValue
 */
rexxclassicbif_max: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_variadic(context_ref, "NUM", 1) = 0 then return .RexxValue("")

  best_text = context.argumentText(1)
  best_value = "0" as .decimal
  candidate_value = "0" as .decimal
  best_value = context.argument(1).asDecimal()
  do i = 2 to context.argumentCount()
    candidate_value = context.argument(i).asDecimal()
    if candidate_value > best_value then do
      best_text = context.argumentText(i)
      best_value = candidate_value
    end
  end
  return .RexxValue(best_text)
