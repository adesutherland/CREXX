options levelb comments_dash numeric_classic
namespace rexxvalue expose RexxValue rexxvalue_numeric_mode rexxvalue_set_numeric_mode rexxvalue_numeric_digits rexxvalue_set_numeric_digits rexxvalue_numeric_fuzz rexxvalue_set_numeric_fuzz rexxvalue_select_missing
import rxfnsb

-- RexxValue cache flags live in the VM value status word.
rexxvalue_constants: procedure expose RV_FLAG_STRING RV_FLAG_INT RV_FLAG_FLOAT RV_FLAG_DECIMAL RV_FLAG_BINARY RV_FLAG_TEXT RV_FLAGS_STRING_TEXT RV_FLAGS_STRING_BINARY_TEXT RV_NUMERIC_DECIMAL RV_NUMERIC_FLOAT RV_NUMERIC_DEFAULT_DIGITS RV_NUMERIC_DEFAULT_FUZZ
  constant RV_FLAG_STRING = 0x00010000   -- 65536: string view current
  constant RV_FLAG_INT = 0x00020000      -- 131072: int view current
  constant RV_FLAG_FLOAT = 0x00040000    -- 262144: float view current
  constant RV_FLAG_DECIMAL = 0x00080000  -- 524288: decimal view current
  constant RV_FLAG_BINARY = 0x00100000   -- 1048576: binary view current
  constant RV_FLAG_TEXT = 0x00200000     -- 2097152: binary contents are valid text

  constant RV_FLAGS_STRING_TEXT = RV_FLAG_STRING + RV_FLAG_TEXT
  constant RV_FLAGS_STRING_BINARY_TEXT = RV_FLAG_STRING + RV_FLAG_BINARY + RV_FLAG_TEXT

  constant RV_NUMERIC_DECIMAL = 0
  constant RV_NUMERIC_FLOAT = 1
  constant RV_NUMERIC_DEFAULT_DIGITS = 18
  constant RV_NUMERIC_DEFAULT_FUZZ = 0
  return

rexxvalue_numeric_mode: procedure = .int expose _rv_numeric_mode _rv_numeric_digits _rv_numeric_fuzz _rv_numeric_ready
  call ensure_rexxvalue_numeric_context
  return _rv_numeric_mode

rexxvalue_set_numeric_mode: procedure = .int expose _rv_numeric_mode _rv_numeric_digits _rv_numeric_fuzz _rv_numeric_ready
  arg mode = .int
  call ensure_rexxvalue_numeric_context
  if mode = RV_NUMERIC_FLOAT then _rv_numeric_mode = RV_NUMERIC_FLOAT
  else _rv_numeric_mode = RV_NUMERIC_DECIMAL
  return _rv_numeric_mode

rexxvalue_numeric_digits: procedure = .int expose _rv_numeric_mode _rv_numeric_digits _rv_numeric_fuzz _rv_numeric_ready
  call ensure_rexxvalue_numeric_context
  return _rv_numeric_digits

rexxvalue_set_numeric_digits: procedure = .int expose _rv_numeric_mode _rv_numeric_digits _rv_numeric_fuzz _rv_numeric_ready
  arg digits = .int
  call ensure_rexxvalue_numeric_context
  if digits <= _rv_numeric_fuzz then return -1
  _rv_numeric_digits = digits
  return _rv_numeric_digits

rexxvalue_numeric_fuzz: procedure = .int expose _rv_numeric_mode _rv_numeric_digits _rv_numeric_fuzz _rv_numeric_ready
  call ensure_rexxvalue_numeric_context
  return _rv_numeric_fuzz

rexxvalue_set_numeric_fuzz: procedure = .int expose _rv_numeric_mode _rv_numeric_digits _rv_numeric_fuzz _rv_numeric_ready
  arg fuzz = .int
  call ensure_rexxvalue_numeric_context
  if fuzz < 0 then return -1
  if fuzz >= _rv_numeric_digits then return -1
  _rv_numeric_fuzz = fuzz
  return _rv_numeric_fuzz

ensure_rexxvalue_numeric_context: procedure expose _rv_numeric_mode _rv_numeric_digits _rv_numeric_fuzz _rv_numeric_ready
  if _rv_numeric_ready = 1 then return
  _rv_numeric_mode = RV_NUMERIC_DECIMAL
  _rv_numeric_digits = RV_NUMERIC_DEFAULT_DIGITS
  _rv_numeric_fuzz = RV_NUMERIC_DEFAULT_FUZZ
  _rv_numeric_ready = 1
  return

/**
 * Classic Rexx scalar value proof.
 *
 * All typed views below are mapped to register.0: the containing VM value
 * itself. The cache flags live in that same value's status word.
 */
RexxValue: class
  string_value = .string with register.0.string
  int_value = .int with register.0.int
  float_value = .float with register.0.float
  decimal_value = .decimal with register.0.decimal
  binary_value = .binary with register.0.binary
  cache_flags = .int with register.0.flags.library

  *: factory
    arg value = .string
    temp = .string
    temp = value
    string_value = temp
    cache_flags = RV_FLAGS_STRING_TEXT
    return

  fromInt: factory
    arg value = .int
    temp = 0
    temp = value
    int_value = temp
    cache_flags = RV_FLAG_INT
    return

  fromFloat: factory
    arg value = .float
    temp = 0 as .float
    temp = value
    float_value = temp
    cache_flags = RV_FLAG_FLOAT
    return

  fromDecimal: factory
    arg value = .decimal
    temp = "0" as .decimal
    temp = value
    decimal_value = temp
    cache_flags = RV_FLAG_DECIMAL
    return

  fromBinary: factory
    arg value = .binary
    temp = .binary
    temp = value
    binary_value = temp
    cache_flags = RV_FLAG_BINARY
    return

  fromBinaryText: factory
    arg value = .binary
    bytes = .binary
    text = .string
    bytes = value
    text = bytes as .string            -- validates the bytes as Level B text
    binary_value = bytes
    string_value = text
    cache_flags = RV_FLAGS_STRING_BINARY_TEXT
    return

  setString: method = .void
    arg value = .string
    temp = .string
    temp = value
    string_value = temp
    cache_flags = RV_FLAGS_STRING_TEXT
    return

  setInt: method = .void
    arg value = .int
    temp = 0
    temp = value
    int_value = temp
    cache_flags = RV_FLAG_INT
    return

  setFloat: method = .void
    arg value = .float
    temp = 0 as .float
    temp = value
    float_value = temp
    cache_flags = RV_FLAG_FLOAT
    return

  setDecimal: method = .void
    arg value = .decimal
    temp = "0" as .decimal
    temp = value
    decimal_value = temp
    cache_flags = RV_FLAG_DECIMAL
    return

  setBinary: method = .void
    arg value = .binary
    temp = .binary
    temp = value
    binary_value = temp
    cache_flags = RV_FLAG_BINARY
    return

  setBinaryText: method = .void
    arg value = .binary
    bytes = .binary
    text = .string
    bytes = value
    text = bytes as .string
    binary_value = bytes
    string_value = text
    cache_flags = RV_FLAGS_STRING_BINARY_TEXT
    return

  cacheFlags: method = .int
    return cache_flags

  hasString: method = .boolean
    flags = cache_flags
    if (flags <has> RV_FLAG_STRING) then return 1
    return 0

  hasInt: method = .boolean
    flags = cache_flags
    if (flags <has> RV_FLAG_INT) then return 1
    return 0

  hasFloat: method = .boolean
    flags = cache_flags
    if (flags <has> RV_FLAG_FLOAT) then return 1
    return 0

  hasDecimal: method = .boolean
    flags = cache_flags
    if (flags <has> RV_FLAG_DECIMAL) then return 1
    return 0

  hasBinary: method = .boolean
    flags = cache_flags
    if (flags <has> RV_FLAG_BINARY) then return 1
    return 0

  hasText: method = .boolean
    flags = cache_flags
    if (flags <has> RV_FLAG_TEXT) then return 1
    return 0

  asString: method = .string
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg ?classic = 0
    temp = .string
    flags = cache_flags
    if (flags <has> RV_FLAG_STRING) then return string_value
    if (flags <has> RV_FLAG_DECIMAL) then do
      if \classic then do
        numeric_digits = rexxvalue_numeric_digits()
        numeric_fuzz = rexxvalue_numeric_fuzz()
        assembler setnumdgts numeric_digits
        assembler setnumfuz numeric_fuzz
      end
      temp = decimal_value as .string
      if classic then do
        digits_setting = .int
        form_setting = .int
        assembler getnumdgts digits_setting
        assembler getnumfrm form_setting
        temp = _rv_classic_decimal_text(temp, digits_setting, form_setting)
      end
      string_value = temp
      new_flags = flags <set> RV_FLAG_STRING
      if (flags <has> RV_FLAG_TEXT) = 0 then new_flags = new_flags <set> RV_FLAG_TEXT
      cache_flags = new_flags
      return temp
    end
    if (flags <has> RV_FLAG_INT) then do
      temp = int_value as .string
      string_value = temp
      new_flags = .int
      new_flags = flags <set> RV_FLAG_STRING
      if (flags <has> RV_FLAG_TEXT) = 0 then new_flags = new_flags <set> RV_FLAG_TEXT
      cache_flags = new_flags
      return temp
    end
    if (flags <has> RV_FLAG_FLOAT) then do
      temp = float_value as .string
      string_value = temp
      new_flags = .int
      new_flags = flags <set> RV_FLAG_STRING
      if (flags <has> RV_FLAG_TEXT) = 0 then new_flags = new_flags <set> RV_FLAG_TEXT
      cache_flags = new_flags
      return temp
    end
    if (flags <has> RV_FLAG_BINARY) then do
      temp = binary_value as .string
      string_value = temp
      new_flags = .int
      new_flags = flags <set> RV_FLAG_STRING
      if (flags <has> RV_FLAG_TEXT) = 0 then new_flags = new_flags <set> RV_FLAG_TEXT
      cache_flags = new_flags
      return temp
    end
    return ""

  /**
   * Split two Classic blank-delimited words and retain the remaining tail.
   * @return Three values: first word, second word, and unparsed tail
   */
  parseThreeWords: method = .RexxValue[]
    source = asString()
    first = .string
    second = .string
    tail = .string
    assembler parsewords3 first,second,tail,source
    fields = .RexxValue[]
    fields[1] = .RexxValue(first)
    fields[2] = .RexxValue(second)
    fields[3] = .RexxValue(tail)
    return fields

  /**
   * Split three Classic blank-delimited words and retain the remaining tail.
   * @return Four values: first, second, third, and unparsed tail
   */
  parseFourWords: method = .RexxValue[]
    source = asString()
    first = .string
    second = .string
    tail = .string
    assembler parsewords3 first,second,tail,source
    remaining = .RexxValue(tail)
    last_fields = remaining.parseWordAndRest()
    fields = .RexxValue[]
    fields[1] = .RexxValue(first)
    fields[2] = .RexxValue(second)
    fields[3] = last_fields[1]
    fields[4] = last_fields[2]
    return fields

  /**
   * Split three Classic blank-delimited words, dropping the remaining source.
   * @return Three values: first, second, and third word
   */
  parseThreeWordsDrop: method = .RexxValue[]
    source = asString()
    first = .string
    second = .string
    third = .string
    assembler parsewords3d first,second,third,source
    fields = .RexxValue[]
    fields[1] = .RexxValue(first)
    fields[2] = .RexxValue(second)
    fields[3] = .RexxValue(third)
    return fields

  /**
   * Split one Classic blank-delimited word and retain the unparsed remainder.
   * @return Two values: first word and source after one following separator
   */
  parseWordAndRest: method = .RexxValue[]
    source = asString()
    first = .string
    unused_second = .string
    unused_tail = .string
    assembler parsewords3 first,unused_second,unused_tail,source
    rest = .string
    if length(first) > 0 then do
      rest_start = .int
      rest_start = pos(first,source) + length(first) + 1
      rest = substr(source,rest_start)
    end
    fields = .RexxValue[]
    fields[1] = .RexxValue(first)
    fields[2] = .RexxValue(rest)
    return fields

  /**
   * Split an implicit-word Classic template of any positive item count.
   * Earlier items receive words; the final item receives the unparsed tail.
   * @param item_count Number of scalar or dot template items
   * @return One captured value per template item
   */
  parseWordTemplate: method = .RexxValue[]
    arg item_count = .int
    fields = .RexxValue[]
    if item_count < 1 then return fields
    remaining = .RexxValue(asString())
    if item_count > 1 then do index = .int(1) to item_count - 1
      pair = remaining.parseWordAndRest()
      fields[index] = pair[1]
      remaining = pair[2]
    end
    fields[item_count] = remaining
    return fields

  asInt: method = .int
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg ?classic = 0
    temp = 0
    flags = cache_flags
    if classic & (flags <has> RV_FLAG_STRING) then do
      number = _rv_classic_number_text(string_value) as .decimal
      return number as .int
    end
    if (flags <has> RV_FLAG_INT) then return int_value
    if (flags <has> RV_FLAG_DECIMAL) then do
      if \classic then do
        numeric_digits = rexxvalue_numeric_digits()
        numeric_fuzz = rexxvalue_numeric_fuzz()
        assembler setnumdgts numeric_digits
        assembler setnumfuz numeric_fuzz
      end
      temp = decimal_value as .int
    end
    else if (flags <has> RV_FLAG_FLOAT) then
      temp = float_value as .int
    else if (flags <has> RV_FLAG_STRING) then
      temp = string_value as .int
    else if (flags <has> RV_FLAG_BINARY) then do
      text = .string
      text = binary_value as .string
      string_value = text
      new_flags = flags <set> RV_FLAG_STRING
      if (flags <has> RV_FLAG_TEXT) = 0 then new_flags = new_flags <set> RV_FLAG_TEXT
      cache_flags = new_flags
      temp = text as .int
    end
    else
      temp = string_value as .int
    int_value = temp
    cache_flags = cache_flags <set> RV_FLAG_INT
    return temp

  asFloat: method = .float
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg ?classic = 0
    temp = 0 as .float
    flags = cache_flags
    if (flags <has> RV_FLAG_FLOAT) then return float_value
    if (flags <has> RV_FLAG_DECIMAL) then do
      if \classic then do
        numeric_digits = rexxvalue_numeric_digits()
        numeric_fuzz = rexxvalue_numeric_fuzz()
        assembler setnumdgts numeric_digits
        assembler setnumfuz numeric_fuzz
      end
      temp = decimal_value as .float
    end
    else if (flags <has> RV_FLAG_INT) then
      temp = int_value as .float
    else if (flags <has> RV_FLAG_STRING) then
      temp = string_value as .float
    else if (flags <has> RV_FLAG_BINARY) then do
      text = .string
      text = binary_value as .string
      string_value = text
      new_flags = flags <set> RV_FLAG_STRING
      if (flags <has> RV_FLAG_TEXT) = 0 then new_flags = new_flags <set> RV_FLAG_TEXT
      cache_flags = new_flags
      temp = text as .float
    end
    else
      temp = string_value as .float
    float_value = temp
    cache_flags = cache_flags <set> RV_FLAG_FLOAT
    return temp

  asDecimal: method = .decimal
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg ?classic = 0
    temp = "0" as .decimal
    flags = cache_flags
    -- Classic strings are reparsed under the active precision at each use.
    if classic & (flags <has> RV_FLAG_STRING) then
      return _rv_classic_number_text(string_value) as .decimal
    if (flags <has> RV_FLAG_DECIMAL) then return decimal_value
    if \classic then do
      numeric_digits = rexxvalue_numeric_digits()
      numeric_fuzz = rexxvalue_numeric_fuzz()
      assembler setnumdgts numeric_digits
      assembler setnumfuz numeric_fuzz
    end
    if (flags <has> RV_FLAG_INT) then
      temp = int_value as .decimal
    else if (flags <has> RV_FLAG_FLOAT) then
      temp = float_value as .decimal
    else if (flags <has> RV_FLAG_STRING) then
      temp = string_value as .decimal
    else if (flags <has> RV_FLAG_BINARY) then do
      text = .string
      text = binary_value as .string
      string_value = text
      new_flags = flags <set> RV_FLAG_STRING
      if (flags <has> RV_FLAG_TEXT) = 0 then new_flags = new_flags <set> RV_FLAG_TEXT
      cache_flags = new_flags
      temp = text as .decimal
    end
    else
      temp = string_value as .decimal
    decimal_value = temp
    cache_flags = cache_flags <set> RV_FLAG_DECIMAL
    return temp

  asBinary: method = .binary
    temp = .binary
    flags = cache_flags
    if (flags <has> RV_FLAG_BINARY) then return binary_value
    if (flags <has> RV_FLAG_STRING) then
      temp = string_value as .binary
    else if (flags <has> RV_FLAG_DECIMAL) then do
      numeric_digits = rexxvalue_numeric_digits()
      numeric_fuzz = rexxvalue_numeric_fuzz()
      assembler setnumdgts numeric_digits
      assembler setnumfuz numeric_fuzz
      text = decimal_value as .string
      string_value = text
      new_flags = flags <set> RV_FLAG_STRING
      if (flags <has> RV_FLAG_TEXT) = 0 then new_flags = new_flags <set> RV_FLAG_TEXT
      cache_flags = new_flags
      temp = text as .binary
    end
    else if (flags <has> RV_FLAG_INT) then do
      text = .string
      text = int_value as .string
      string_value = text
      new_flags = .int
      new_flags = flags <set> RV_FLAG_STRING
      if (flags <has> RV_FLAG_TEXT) = 0 then new_flags = new_flags <set> RV_FLAG_TEXT
      cache_flags = new_flags
      temp = text as .binary
    end
    else if (flags <has> RV_FLAG_FLOAT) then do
      text = .string
      text = float_value as .string
      string_value = text
      new_flags = .int
      new_flags = flags <set> RV_FLAG_STRING
      if (flags <has> RV_FLAG_TEXT) = 0 then new_flags = new_flags <set> RV_FLAG_TEXT
      cache_flags = new_flags
      temp = text as .binary
    end
    else
      temp = "" as .binary
    binary_value = temp
    cache_flags = cache_flags <set> RV_FLAG_BINARY
    return temp

  validateText: method = .boolean
    flags = cache_flags
    if (flags <has> RV_FLAG_TEXT) then return 1
    if (flags <has> RV_FLAG_BINARY) then do
      text = .string
      text = binary_value as .string
      string_value = text
      new_flags = flags <set> RV_FLAG_TEXT
      if (flags <has> RV_FLAG_STRING) = 0 then new_flags = new_flags <set> RV_FLAG_STRING
      cache_flags = new_flags
      return 1
    end
    text = .string
    text = asString()
    return 1

  binaryLength: method = .int
    len = 0
    bytes = .binary
    bytes = asBinary()
    assembler blen len,bytes
    return len

  copyFrom: method = .void
    arg other = .RexxValue
    if other.hasBinary() & \other.hasText() then do
      call setBinary(other.asBinary())
      return
    end
    call setString(other.asString())
    return

  concat: method = .RexxValue
    arg other = .RexxValue
    return .RexxValue(asString() || other.asString())

  spaceConcat: method = .RexxValue
    arg other = .RexxValue
    return .RexxValue(asString() || " " || other.asString())

  /** Materialize a Classic arithmetic result at the operation's precision. */
  _decimalResult: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg value = .decimal, ?classic = 0
    result = .RexxValue.fromDecimal(value)
    if classic then displayed = result.asString(1)
    return result

  /** Keep the fractional scale of Classic addition and multiplication. */
  _classicScaledResult: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg result = .RexxValue, scale = .int
    if scale <= 0 | result.asDecimal(1) = 0 then return result
    result_text = result.asString(1)
    if pos("E", upper(result_text)) > 0 then return result
    digits_setting = .int
    assembler getnumdgts digits_setting
    limit = _rv_control_result_scale(result_text, digits_setting)
    if limit < scale then scale = limit
    if scale <= 0 then return result
    return .RexxValue(format(result.asDecimal(1), , scale))

  /** Return the original operand only when NUMERIC DIGITS would discard data. */
  lostDigitsDescription: method = .string
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    original = asString(1)
    if \_rv_is_number_text(original) then return ""
    text = _rv_classic_number_text(original)
    if left(text, 1) = "+" | left(text, 1) = "-" then text = substr(text, 2)
    exponent_at = pos("E", upper(text))
    if exponent_at > 0 then text = left(text, exponent_at - 1)
    digits_setting = .int
    assembler getnumdgts digits_setting
    significant = 0
    started = 0
    do index = 1 to length(text)
      digit = substr(text, index, 1)
      if digit = "." then iterate
      if digit <> "0" then started = 1
      if started then do
        significant = significant + 1
        if significant > digits_setting & digit <> "0" then return original
      end
    end
    return ""

  /** Normalize ABS text without rounding significant digits a second time. */
  classicAbsolute: method = .RexxValue
    numeric form inherited
    arg normalized = .string
    text = strip(normalized)
    if left(text, 1) = "+" | left(text, 1) = "-" then text = substr(text, 2)
    exponent_at = pos("E", upper(text))
    if exponent_at > 0 then mantissa = left(text, exponent_at - 1)
    else mantissa = text
    significant = 0
    started = 0
    do index = 1 to length(mantissa)
      digit = substr(mantissa, index, 1)
      if digit = "." then iterate
      if digit <> "0" then started = 1
      if started then significant = significant + 1
    end
    if significant = 0 then return .RexxValue("0")
    form_setting = .int
    assembler getnumfrm form_setting
    return .RexxValue(_rv_classic_decimal_text(text, significant, form_setting))

  add: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg other = .RexxValue, ?classic = 0
    if \classic & rexxvalue_numeric_mode() = RV_NUMERIC_FLOAT then do
      float_result = 0 as .float
      float_result = asFloat() + other.asFloat()
      return .RexxValue.fromFloat(float_result)
    end
    result = "0" as .decimal
    scale = .int
    if \classic then do
      numeric_digits = rexxvalue_numeric_digits()
      numeric_fuzz = rexxvalue_numeric_fuzz()
      assembler setnumdgts numeric_digits
      assembler setnumfuz numeric_fuzz
    end
    if classic then do
      left_scale = _rv_control_fraction_scale(asString(1))
      right_scale = _rv_control_fraction_scale(other.asString(1))
      scale = left_scale
      if right_scale > scale then scale = right_scale
    end
    result = asDecimal(classic) + other.asDecimal(classic)
    value = _decimalResult(result, classic)
    if classic then return _classicScaledResult(value, scale)
    return value

  subtract: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg other = .RexxValue, ?classic = 0
    if \classic & rexxvalue_numeric_mode() = RV_NUMERIC_FLOAT then do
      float_result = 0 as .float
      float_result = asFloat() - other.asFloat()
      return .RexxValue.fromFloat(float_result)
    end
    result = "0" as .decimal
    scale = .int
    if \classic then do
      numeric_digits = rexxvalue_numeric_digits()
      numeric_fuzz = rexxvalue_numeric_fuzz()
      assembler setnumdgts numeric_digits
      assembler setnumfuz numeric_fuzz
    end
    if classic then do
      left_scale = _rv_control_fraction_scale(asString(1))
      right_scale = _rv_control_fraction_scale(other.asString(1))
      scale = left_scale
      if right_scale > scale then scale = right_scale
    end
    result = asDecimal(classic) - other.asDecimal(classic)
    value = _decimalResult(result, classic)
    if classic then return _classicScaledResult(value, scale)
    return value

  multiply: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg other = .RexxValue, ?classic = 0
    if \classic & rexxvalue_numeric_mode() = RV_NUMERIC_FLOAT then do
      float_result = 0 as .float
      float_result = asFloat() * other.asFloat()
      return .RexxValue.fromFloat(float_result)
    end
    result = "0" as .decimal
    scale = .int
    if \classic then do
      numeric_digits = rexxvalue_numeric_digits()
      numeric_fuzz = rexxvalue_numeric_fuzz()
      assembler setnumdgts numeric_digits
      assembler setnumfuz numeric_fuzz
    end
    if classic then scale = _rv_control_fraction_scale(asString(1)) +,
                            _rv_control_fraction_scale(other.asString(1))
    result = asDecimal(classic) * other.asDecimal(classic)
    value = _decimalResult(result, classic)
    if classic then return _classicScaledResult(value, scale)
    return value

  divide: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg other = .RexxValue, ?classic = 0
    if \classic & rexxvalue_numeric_mode() = RV_NUMERIC_FLOAT then do
      float_result = 0 as .float
      float_result = asFloat() / other.asFloat()
      return .RexxValue.fromFloat(float_result)
    end
    result = "0" as .decimal
    if \classic then do
      numeric_digits = rexxvalue_numeric_digits()
      numeric_fuzz = rexxvalue_numeric_fuzz()
      assembler setnumdgts numeric_digits
      assembler setnumfuz numeric_fuzz
    end
    result = asDecimal(classic) / other.asDecimal(classic)
    return _decimalResult(result, classic)

  integerDivide: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg other = .RexxValue, ?classic = 0
    if \classic & rexxvalue_numeric_mode() = RV_NUMERIC_FLOAT then do
      float_result = 0 as .float
      int_result = 0
      float_result = asFloat() / other.asFloat()
      int_result = float_result as .int
      return .RexxValue.fromFloat(int_result as .float)
    end
    result = "0" as .decimal
    if \classic then do
      numeric_digits = rexxvalue_numeric_digits()
      numeric_fuzz = rexxvalue_numeric_fuzz()
      assembler setnumdgts numeric_digits
      assembler setnumfuz numeric_fuzz
    end
    if classic then do
      left_decimal = _rv_integer_decimal(self)
      right_decimal = _rv_integer_decimal(other)
      result = left_decimal % right_decimal
    end
    else result = asDecimal(classic) % other.asDecimal(classic)
    return _decimalResult(result, classic)

  remainder: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg other = .RexxValue, ?classic = 0
    if \classic & rexxvalue_numeric_mode() = RV_NUMERIC_FLOAT then do
      left_float = 0 as .float
      right_float = 0 as .float
      quotient = 0
      float_result = 0 as .float
      left_float = asFloat()
      right_float = other.asFloat()
      quotient = (left_float / right_float) as .int
      float_result = left_float - (right_float * (quotient as .float))
      return .RexxValue.fromFloat(float_result)
    end
    left_dec = "0" as .decimal
    right_dec = "0" as .decimal
    result = "0" as .decimal
    quotient = .int
    quotient = 0
    if \classic then do
      numeric_digits = rexxvalue_numeric_digits()
      numeric_fuzz = rexxvalue_numeric_fuzz()
      assembler setnumdgts numeric_digits
      assembler setnumfuz numeric_fuzz
    end
    if classic then do
      left_decimal = _rv_integer_decimal(self)
      right_decimal = _rv_integer_decimal(other)
      result = left_decimal // right_decimal
    end
    else result = asDecimal(classic) // other.asDecimal(classic)
    return _decimalResult(result, classic)

  power: method = .RexxValue
