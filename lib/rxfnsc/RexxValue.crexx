      assembler setnumfuz numeric_fuzz
    end
    result = asDecimal(classic)
    return _decimalResult(result, classic)

  logicalValue: method = .boolean
    return _rv_logical_text(asString())

  logicalIfValue: method = .boolean
    text = asString()
    if text == "0" then return 0
    if text == "1" then return 1
    message = "RXC-LC-34.1: IF condition must be exactly 0 or 1; found " || text
    assembler signal "ERROR", message
    return 0

  logicalWhenValue: method = .boolean
    text = asString()
    if text == "0" then return 0
    if text == "1" then return 1
    message = "RXC-LC-34.2: WHEN condition must be exactly 0 or 1; found " || text
    assembler signal "ERROR", message
    return 0

  logicalWhileValue: method = .boolean
    text = asString()
    if text == "0" then return 0
    if text == "1" then return 1
    message = "RXC-LC-34.3: WHILE condition must be exactly 0 or 1; found " || text
    assembler signal "ERROR", message
    return 0

  logicalUntilValue: method = .boolean
    text = asString()
    if text == "0" then return 0
    if text == "1" then return 1
    message = "RXC-LC-34.4: UNTIL condition must be exactly 0 or 1; found " || text
    assembler signal "ERROR", message
    return 0

  /** Validate and capture a Classic DO TO endpoint at loop setup. */
  controlToValue: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    text = asString(1)
    if datatype(text, "N") <> "1" then do
      message = "RXC-LC-41.4: DO TO value must be numeric; found " || text
      assembler signal "ERROR", message
    end
    return .RexxValue(text)

  /** Validate and capture a Classic DO BY step at loop setup. */
  controlByValue: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    text = asString(1)
    if datatype(text, "N") <> "1" then do
      message = "RXC-LC-41.5: DO BY value must be numeric; found " || text
      assembler signal "ERROR", message
    end
    return .RexxValue(text)

  /** Validate a captured Classic DO control start before the visible pool set. */
  controlStartValue: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    text = asString(1)
    if datatype(text, "N") <> "1" then do
      message = "RXC-LC-41.6: DO control start value must be numeric; found " || text
      assembler signal "ERROR", message
    end
    return .RexxValue(text)

  /** Classic DO arithmetic keeps significant fractional zeroes through a step. */
  controlNumericAdd: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg other = .RexxValue, ?classic = 0
    if classic then return add(other, 1)
    left_scale = _rv_control_fraction_scale(asString())
    right_scale = _rv_control_fraction_scale(other.asString())
    scale = left_scale
    if right_scale > scale then scale = right_scale
    result = add(other)
    if rexxvalue_numeric_mode() = RV_NUMERIC_FLOAT | scale = 0 then return result
    if result.asDecimal() = 0 then return result
    result_text = result.asString()
    scale_limit = _rv_control_result_scale(result_text, rexxvalue_numeric_digits())
    if scale_limit < scale then scale = scale_limit
    if scale <= 0 then return result
    numeric_digits = rexxvalue_numeric_digits()
    numeric_fuzz = rexxvalue_numeric_fuzz()
    assembler setnumdgts numeric_digits
    assembler setnumfuz numeric_fuzz
    return .RexxValue(format(result.asDecimal(), , scale))

  /** Select the TO comparison from the sign of a Classic DO BY value. */
  controlToContinueBy: method = .boolean
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg limit = .RexxValue, step = .RexxValue
    text = asString(1)
    if datatype(text, "N") <> "1" then do
      control_message = "RXC-LC-41.6: DO control variable must be numeric; found " || text
      assembler signal "ERROR", control_message
    end
    limit_text = limit.asString(1)
    if datatype(limit_text, "N") <> "1" then do
      limit_message = "RXC-LC-41.4: DO TO value must be numeric; found " || limit_text
      assembler signal "ERROR", limit_message
    end
    step_text = step.asString(1)
    if datatype(step_text, "N") <> "1" then do
      by_message = "RXC-LC-41.5: DO BY value must be numeric; found " || step_text
      assembler signal "ERROR", by_message
    end
    if step.asDecimal(1) < 0 then do
      lower_comparison = compareGreaterOrEqual(limit, 1)
      return lower_comparison.logicalValue()
    end
    upper_comparison = compareLessOrEqual(limit, 1)
    return upper_comparison.logicalValue()

  /** Advance a Classic DO control variable by its fixed BY value. */
  controlStepBy: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg step = .RexxValue
    text = asString(1)
    if datatype(text, "N") <> "1" then do
      step_message = "RXC-LC-41.6: DO control variable must be numeric; found " || text
      assembler signal "ERROR", step_message
    end
    step_text = step.asString(1)
    if datatype(step_text, "N") <> "1" then do
      advance_message = "RXC-LC-41.5: DO BY value must be numeric; found " || step_text
      assembler signal "ERROR", advance_message
    end
    return controlNumericAdd(step, 1)

  logicalResult: method = .RexxValue
    return _rv_bool_value(_rv_logical_text(asString()))

  logicalNot: method = .RexxValue
    return _rv_bool_value(\_rv_logical_text(asString()))

  logicalAnd: method = .RexxValue
    arg other = .RexxValue
    left_bool = _rv_logical_left_text(asString(), "&")
    right_bool = _rv_logical_right_text(other.asString(), "&")
    return _rv_bool_value(left_bool & right_bool)

  logicalOr: method = .RexxValue
    arg other = .RexxValue
    left_bool = _rv_logical_left_text(asString(), "|")
    right_bool = _rv_logical_right_text(other.asString(), "|")
    return _rv_bool_value(left_bool | right_bool)

  logicalXor: method = .RexxValue
    arg other = .RexxValue
    left_bool = _rv_logical_text(asString())
    right_bool = _rv_logical_text(other.asString())
    return _rv_bool_value((left_bool & \right_bool) | (\left_bool & right_bool))

  compareEqual: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg other = .RexxValue, ?classic = 0
    return _rv_bool_value(_rv_compare_standard(self, other, classic) = 0)

  compareNotEqual: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg other = .RexxValue, ?classic = 0
    return _rv_bool_value(_rv_compare_standard(self, other, classic) <> 0)

  compareGreaterThan: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg other = .RexxValue, ?classic = 0
    return _rv_bool_value(_rv_compare_standard(self, other, classic) > 0)

  compareLessThan: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg other = .RexxValue, ?classic = 0
    return _rv_bool_value(_rv_compare_standard(self, other, classic) < 0)

  compareGreaterOrEqual: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg other = .RexxValue, ?classic = 0
    return _rv_bool_value(_rv_compare_standard(self, other, classic) >= 0)

  compareLessOrEqual: method = .RexxValue
    numeric digits inherited
    numeric fuzz inherited
    numeric form inherited
    arg other = .RexxValue, ?classic = 0
    return _rv_bool_value(_rv_compare_standard(self, other, classic) <= 0)

  strictCompareEqual: method = .RexxValue
    arg other = .RexxValue
    return _rv_bool_value(_rv_compare_strict_text(asString(), other.asString()) = 0)

  strictCompareNotEqual: method = .RexxValue
    arg other = .RexxValue
    return _rv_bool_value(_rv_compare_strict_text(asString(), other.asString()) <> 0)

  strictCompareGreaterThan: method = .RexxValue
    arg other = .RexxValue
    return _rv_bool_value(_rv_compare_strict_text(asString(), other.asString()) > 0)

  strictCompareLessThan: method = .RexxValue
    arg other = .RexxValue
    return _rv_bool_value(_rv_compare_strict_text(asString(), other.asString()) < 0)

  strictCompareGreaterOrEqual: method = .RexxValue
    arg other = .RexxValue
    return _rv_bool_value(_rv_compare_strict_text(asString(), other.asString()) >= 0)

  strictCompareLessOrEqual: method = .RexxValue
    arg other = .RexxValue
    return _rv_bool_value(_rv_compare_strict_text(asString(), other.asString()) <= 0)

  equals: method = .boolean
    arg other = .RexxValue
    if asString() = other.asString() then return 1
    return 0

  compare: method = .int
    arg other = .RexxValue
    left = asString()
    right = other.asString()
    if left = right then return 0
    if left < right then return -1
    return 1

_rv_bool_value: procedure = .RexxValue
  arg value = .boolean
  if value then return .RexxValue.fromInt(1)
  return .RexxValue.fromInt(0)

rexxvalue_select_missing: procedure = .void
  arg line = .string
  message = "RXC-LC-7.3: All WHEN expressions of SELECT on line " || line || " are false; OTHERWISE expected"
  assembler signal "ERROR", message
  return

_rv_logical_text: procedure = .boolean
  arg text = .string
  if text == "0" then return 0
  if text == "1" then return 1
  message = "RXC-LC-34: Logical value must be exactly 0 or 1; found " || text
  assembler signal "ERROR", message
  return 0

_rv_logical_left_text: procedure = .boolean
  arg text = .string, op_name = .string
  if text == "0" then return 0
  if text == "1" then return 1
  message = "RXC-LC-34.5: Left operand of logical " || op_name || " must be exactly 0 or 1; found " || text
  assembler signal "ERROR", message
  return 0

_rv_logical_right_text: procedure = .boolean
  arg text = .string, op_name = .string
  if text == "0" then return 0
  if text == "1" then return 1
  message = "RXC-LC-34.6: Right operand of logical " || op_name || " must be exactly 0 or 1; found " || text
  assembler signal "ERROR", message
  return 0

/** Preserve an integer-operation operand until the VM applies its guard digits. */
_rv_integer_decimal: procedure = .decimal
  numeric digits inherited
  numeric form inherited
  arg value = .RexxValue
  text = _rv_classic_number_text(value.asString(1))
  precision = .int
  assembler getnumdgts precision
  if length(text) > precision then precision = length(text)
  assembler setnumdgts precision
  return text as .decimal

/** Canonical ASCII numeric spelling without changing the original string view. */
_rv_classic_number_text: procedure = .string
  arg value = .string
  text = strip(value)
  if left(text,1) == "+" | left(text,1) == "-" then
    text = left(text,1) || strip(substr(text,2))
  return text

_rv_is_number_text: procedure = .boolean
  arg value = .string, ?classic = 1
  text = strip(value)
  if classic then text = _rv_classic_number_text(value)
  if length(text) = 0 then return 0
  posn = 1
  saw_digit = 0
  saw_dot = 0

  if substr(text, posn, 1) = "+" | substr(text, posn, 1) = "-" then do
    posn = posn + 1
    if posn > length(text) then return 0
  end

  do while posn <= length(text)
    ch = substr(text, posn, 1)
    if pos(ch, "0123456789") > 0 then saw_digit = 1
    else if ch = "." then do
      if saw_dot then return 0
      saw_dot = 1
    end
    else leave
    posn = posn + 1
  end

  if saw_digit = 0 then return 0
  if posn > length(text) then return 1
  if translate(substr(text, posn, 1)) <> "E" then return 0

  posn = posn + 1
  if posn > length(text) then return 0
  if substr(text, posn, 1) = "+" | substr(text, posn, 1) = "-" then posn = posn + 1
  if posn > length(text) then return 0

  do i = posn to length(text)
    if pos(substr(text, i, 1), "0123456789") = 0 then return 0
  end
  return 1

/** Apply Classic exponent thresholds to a rounded decimal's text view. */
_rv_classic_decimal_text: procedure = .string
  arg rendered = .string, precision = .int, form = .int
  text = strip(rendered)
  if \_rv_is_number_text(text) then return rendered
  sign = ""
  if left(text, 1) = "-" | left(text, 1) = "+" then do
    if left(text, 1) = "-" then sign = "-"
    text = substr(text, 2)
  end
  exponent = 0
  exponent_at = pos("E", upper(text))
  if exponent_at > 0 then do
    exponent = substr(text, exponent_at + 1) as .int
    text = left(text, exponent_at - 1)
  end
  point_at = pos(".", text)
  if point_at = 0 then digits_before = length(text)
  else digits_before = point_at - 1
  if point_at = 0 then all_digits = text
  else all_digits = left(text, point_at - 1) || substr(text, point_at + 1)
  first = 0
  do index = 1 to length(all_digits)
    if substr(all_digits, index, 1) <> "0" then do
      first = index
      leave
    end
  end
  if first = 0 then return rendered
  adjusted = digits_before + exponent - first
  significant = substr(all_digits, first)
  do while length(significant) > precision & right(significant, 1) = "0"
    significant = left(significant, length(significant) - 1)
  end
  use_exponent = adjusted >= precision | adjusted < -6
  if use_exponent then do
    if length(significant) < precision then
      significant = significant || copies("0", precision - length(significant))
    exponent_out = adjusted
    coefficient_before = 1
    if form = 2 then do
      do while exponent_out // 3 <> 0
        exponent_out = exponent_out - 1
      end
      coefficient_before = adjusted - exponent_out + 1
    end
    if length(significant) < coefficient_before then
      significant = significant || copies("0", coefficient_before - length(significant))
    coefficient = left(significant, coefficient_before)
    if length(significant) > coefficient_before then
      coefficient = coefficient || "." || substr(significant, coefficient_before + 1)
    if exponent_out >= 0 then return sign || coefficient || "E+" || exponent_out
    return sign || coefficient || "E" || exponent_out
  end
  point = adjusted + 1
  if point <= 0 then return sign || "0." || copies("0", 0 - point) || significant
  if point >= length(significant) then
    return sign || significant || copies("0", point - length(significant))
  return sign || left(significant, point) || "." || substr(significant, point + 1)

_rv_compare_standard: procedure = .int
  numeric digits inherited
  numeric fuzz inherited
  numeric form inherited
  arg left = .RexxValue, right = .RexxValue, classic = .int
  left_text = left.asString(classic)
  right_text = right.asString(classic)
  if _rv_is_number_text(left_text, classic) & _rv_is_number_text(right_text, classic) then do
    if \classic then do
      numeric_digits = rexxvalue_numeric_digits()
      numeric_fuzz = rexxvalue_numeric_fuzz()
      assembler setnumdgts numeric_digits
      assembler setnumfuz numeric_fuzz
    end
    left_dec = left.asDecimal(classic)
    right_dec = right.asDecimal(classic)
    if left_dec = right_dec then return 0
    if left_dec < right_dec then return -1
    return 1
  end
  return _rv_compare_loose_text(left_text, right_text)

_rv_compare_loose_text: procedure = .int
  arg left = .string, right = .string
  left_text = strip(left)
  right_text = strip(right)
  if length(left_text) < length(right_text) then
    left_text = left_text || copies(" ", length(right_text) - length(left_text))
  else if length(right_text) < length(left_text) then
    right_text = right_text || copies(" ", length(left_text) - length(right_text))
  if left_text = right_text then return 0
  if left_text < right_text then return -1
  return 1

_rv_compare_strict_text: procedure = .int
  arg left = .string, right = .string
  if left == right then return 0
  if left << right then return -1
  return 1

/** Fractional places contributed by a numeric operand after its exponent. */
_rv_control_fraction_scale: procedure = .int
  arg value = .string
  text = strip(value)
  exponent = 0
  exponent_at = pos("E", upper(text))
  if exponent_at > 0 then do
    exponent = substr(text, exponent_at + 1) as .int
    text = left(text, exponent_at - 1)
  end
  decimal_at = pos(".", text)
  if decimal_at = 0 then return 0
  scale = length(text) - decimal_at - exponent
  if scale < 0 then return 0
  return scale

/** Maximum fixed fractional places allowed by the current precision. */
_rv_control_result_scale: procedure = .int
  arg value = .string, precision = .int
  text = strip(value)
  exponent = 0
  exponent_at = pos("E", upper(text))
  if exponent_at > 0 then do
    exponent = substr(text, exponent_at + 1) as .int
    text = left(text, exponent_at - 1)
  end
  if left(text, 1) = "-" | left(text, 1) = "+" then text = substr(text, 2)
  decimal_at = pos(".", text)
  if decimal_at = 0 then decimal_at = length(text) + 1
  digits_before = decimal_at - 1
  if decimal_at <= length(text) then
    digits = left(text, decimal_at - 1) || substr(text, decimal_at + 1)
  else digits = text
  first_significant = 0
  do index = 1 to length(digits)
    if substr(digits, index, 1) <> "0" then do
      first_significant = index
      leave
    end
  end
  if first_significant = 0 then return 0
  magnitude = digits_before - first_significant + exponent
  return precision - magnitude - 1
