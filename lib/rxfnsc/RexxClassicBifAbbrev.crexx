options levelb comments_dash numeric_classic
namespace rexxclassicbifabbrev expose rexxclassicbif_abbrev
import rexxclassicbifs
import rexxclassiccharacterops
import rexxvalue

/**
 * Test a Classic case-sensitive leading abbreviation.
 *
 * @bif ABBREV
 * @signature ABBREV(string, abbrev [,length])
 * @checkargs rANY rANY oWHOLE>=0
 * @sandbox pure
 * @return RexxValue containing `1` when accepted, otherwise `0`
 */
rexxclassicbif_abbrev: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY rANY oWHOLE>=0") = 0 then return .RexxValue("")

  string_value = context.argument(1)
  candidate_value = context.argument(2)
  config = context.characterConfig()
  string_length = .int
  candidate_length = .int
  minimum = .int

  string_length = rexxclassic_value_length(string_value,config)
  candidate_length = rexxclassic_value_length(candidate_value,config)
  minimum = candidate_length
  if context.argumentExists(3) then minimum = context.argumentText(3) + 0
  if candidate_length < minimum | string_length < candidate_length then return .RexxValue("0")
  if \rexxclassic_value_prefix_equal(string_value,candidate_value,candidate_length,config) then return .RexxValue("0")
  return .RexxValue("1")
