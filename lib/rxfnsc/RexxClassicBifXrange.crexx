options levelb comments_dash numeric_classic
namespace rexxclassicbifxrange expose rexxclassicbif_xrange
import rexxclassicbifs
import rexxvalue

/** Return the inclusive configured BYTE range, wrapping after 0xFF. */
rexxclassicbif_xrange: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "oPAD oPAD") = 0 then return .RexxValue("")

  config = context.characterConfig()
  if config.isUtf8Profile() then do
    call rexxclassicbif_set_error(context_ref, "40.1", 0, "", "")
    return .RexxValue("")
  end

  start_byte = 0
  end_byte = 255
  offset = 0
  if context.argumentExists(1) then do
    start_bytes = context.argument(1).asBinary()
    assembler getbyte start_byte,start_bytes,offset
  end
  if context.argumentExists(2) then do
    end_bytes = context.argument(2).asBinary()
    assembler getbyte end_byte,end_bytes,offset
  end

  if end_byte >= start_byte then result_length = end_byte - start_byte + 1
  else result_length = 256 - start_byte + end_byte + 1
  result = .binary
  assembler bresize result,result_length
  current = start_byte
  do index = 0 to result_length - 1
    assembler setbyte result,index,current
    if current = 255 then current = 0
    else current = current + 1
  end
  return .RexxValue.fromBinary(result)
