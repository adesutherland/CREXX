options levelb comments_dash numeric_classic
namespace rexxclassicbifc2d expose rexxclassicbif_c2d
import rexxclassicbifs
import rexxclassicbifx2d
import rexxclassicencoding
import rexxvalue

/** Convert exact configured character bytes to a Classic whole number. */
rexxclassicbif_c2d: procedure = .RexxValue
  numeric digits inherited
  numeric form inherited
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY oWHOLE>=0") = 0 then return .RexxValue("")

  bytes = context.argument(1).asBinary()
  byte_length = .int
  assembler blen byte_length,bytes
  if byte_length = 0 then return .RexxValue("0")

  selected_bytes = byte_length
  skipped_bytes = 0
  negative = 0
  if context.argumentExists(2) then do
    selected_bytes = rexxclassic_bounded_digit_length(context.argumentText(2), byte_length + 1)
    if selected_bytes = 0 then return .RexxValue("0")
    if selected_bytes <= byte_length then do
      skipped_bytes = byte_length - selected_bytes
      sign_byte = .int
      assembler getbyte sign_byte,bytes,skipped_bytes
      negative = sign_byte >= 128
    end
    else selected_bytes = byte_length
  end

  hexadecimal = rexxclassic_bytes_to_hex(bytes)
  hexadecimal_length = byte_length * 2
  skip_digits = skipped_bytes * 2
  result = rexxclassic_hex_to_decimal(hexadecimal, hexadecimal_length, skip_digits, negative)

  result_digits = .int
  assembler strlen result_digits,result
  if negative then result_digits = result_digits - 1
  numeric_digits = .int
  assembler getnumdgts numeric_digits
  if result_digits > numeric_digits then do
    call rexxclassicbif_set_error(context_ref, "40.35", 1, "", "")
    return .RexxValue("")
  end
  return .RexxValue(result)
