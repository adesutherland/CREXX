options levelb comments_dash numeric_classic
namespace rexxclassicbifvalue expose rexxclassicbif_value
import rexxclassicbifs
import rexxpool
import rexxvalue

/**
 * Query or assign one Classic variable in the caller activation pool.
 *
 * @bif VALUE
 * @signature VALUE(name [,newvalue [,pool]])
 * @checkargs internal: rSYM oANY oANY; external: rANY oANY oANY
 * @sandbox reads or updates only the caller pool; external pools are parked
 * @return value in effect before any assignment
 */
rexxclassicbif_value: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()

  if context.argumentExists(3) then do
    if rexxclassicbif_check_args(context_ref, "rANY oANY oANY") = 0 then return .RexxValue("")
    /* No configuration-backed external-pool service exists in the repository. */
    call rexxclassicbif_set_error(context_ref, "40.37", 3, context.argumentText(3), "")
    return .RexxValue("")
  end

  if rexxclassicbif_check_args(context_ref, "rSYM oANY oANY") = 0 then return .RexxValue("")

  pool_ref = reference .RexxVariablePool
  pool_ref = context.callerPool()
  pool = dereference pool_ref
  name = context.argumentText(1)
  previous = pool.symbolValue(name)
  if context.argumentExists(2) then call pool.setSymbolValue(name, context.argument(2))
  return previous
