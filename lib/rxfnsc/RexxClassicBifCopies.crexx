options levelb comments_dash numeric_classic
namespace rexxclassicbifcopies expose rexxclassicbif_copies
import rexxclassicbifs
import rexxvalue

/**
 * Repeat one Classic string a non-negative whole-number count.
 *
 * @bif COPIES
 * @signature COPIES(string, count)
 * @checkargs rANY rWHOLE>=0
 * @sandbox pure
 * @return repeated string as a RexxValue
 */
rexxclassicbif_copies: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY rWHOLE>=0") = 0 then return .RexxValue("")

  string = context.argumentText(1)
  count = .int
  count = context.argumentText(2) + 0
  string_length = .int
  remaining = .int
  bit = .int
  chunk = ""
  result = ""

  if count = 0 then return .RexxValue(result)
  if count = 1 then return .RexxValue(string)
  assembler strlen string_length,string
  if string_length = 0 then return .RexxValue(result)

  remaining = count
  assembler scopy chunk,string
  do while remaining > 0
    assembler imod bit,remaining,2
    if bit <> 0 then assembler append result,chunk
    assembler idiv remaining,remaining,2
    if remaining > 0 then assembler append chunk,chunk
  end
  return .RexxValue(result)
