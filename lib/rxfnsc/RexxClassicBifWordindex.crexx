options levelb comments_dash numeric_classic
namespace rexxclassicbifwordindex expose rexxclassicbif_wordindex
import rexxclassicbifs
import rexxclassiccharacterscan
import rexxvalue

/**
 * Return the Classic character position of one word.
 *
 * @bif WORDINDEX
 * @signature WORDINDEX(string, n)
 * @checkargs rANY rWHOLE>0
 * @sandbox pure
 * @return one-based word start, or zero, as a RexxValue
 */
rexxclassicbif_wordindex: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY rWHOLE>0") = 0 then return .RexxValue("")

  wordnum = .int
  wordnum = context.argumentText(2) + 0
  config = context.characterConfig()

  if config.isByteProfile() then do
    bytes = .binary
    other_blanks = .binary
    bytes = context.argument(1).asBinary()
    other_blanks = config.byteOtherBlanks()
    byte_length = .int
    assembler blen byte_length,bytes
    if byte_length = 0 then return .RexxValue("0")
    scan = 0
    current_word = 0
    word_start = 0
    do while scan < byte_length
      word_start = rexxclassic_find_byte_nonblank(bytes, scan, other_blanks)
      if word_start < 0 then return .RexxValue("0")
      current_word = current_word + 1
      if current_word = wordnum then return .RexxValue((word_start + 1) || "")
      scan = rexxclassic_find_byte_blank(bytes, word_start, other_blanks)
      if scan < 0 then return .RexxValue("0")
    end
    return .RexxValue("0")
  end

  string = context.argumentText(1)
  text_other_blanks = config.textOtherBlanks()
  string_length = .int
  assembler strlen string_length,string
  if string_length = 0 then return .RexxValue("0")

  scan = .int
  scan = 0
  current_word = .int
  current_word = 0
  word_start = .int
  word_start = 0
  do while scan < string_length
    word_start = rexxclassic_find_text_nonblank(string, scan, text_other_blanks)
    if word_start < 0 then return .RexxValue("0")
    current_word = current_word + 1
    if current_word = wordnum then return .RexxValue((word_start + 1) || "")
    scan = rexxclassic_find_text_blank(string, word_start, text_other_blanks)
    if scan < 0 then return .RexxValue("0")
  end
  return .RexxValue("0")
