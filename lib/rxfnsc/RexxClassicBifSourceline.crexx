options levelb comments_dash numeric_classic
namespace rexxclassicbifsourceline expose rexxclassicbif_sourceline
import rexxclassicbifs
import rexxvalue

/**
 * Read the retained source of the executing Classic compilation unit.
 * @bif SOURCELINE
 * @signature SOURCELINE([n])
 * @checkargs oWHOLE>0
 * @param context_ref BIF operands and diagnostic context
 * @return original physical line or available line count
 * @error 40.34 requested line exceeds available source
 * @sandbox source data supplied by the caller; no file I/O
 */
rexxclassicbif_sourceline: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref,"oWHOLE>0") = 0 then return .RexxValue("")
  config = context.characterConfig()
  count = config.sourceLineCount()
  if \context.argumentExists(1) then return .RexxValue(count || "")
  requested = context.argumentText(1)
  if requested + 0 > count then do
    call context.setError("RXC-LC-40.34",'RXC-LC-40.34 bif="SOURCELINE" value="' || requested || '" sourceline()="' || count || '"')
    return .RexxValue("")
  end
  index = .int
  index = requested + 0
  return .RexxValue(config.sourceLine(index))
