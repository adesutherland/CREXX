options levelb comments_dash numeric_classic
namespace rexxactivation expose RexxActivationArguments
import rexxvalue
import rexxclassicstate
import rexxclassicdatatype
import rexxclassicconfig
import rexxpool
import rxfnsb
import rexxclassichostprotocol

/**
 * Positional arguments and optional result state for one Classic activation.
 * An omitted position occupies a slot but is not present to ARG existence
 * queries. A missing position returns an empty value without extending the
 * frame. Repeated ARG instructions read the same captured values. The
 * separate return-presence flag distinguishes bare RETURN from an explicit
 * empty-string result without changing RexxValue's value contract. A fresh
 * internal call also records whether PROCEDURE may be the first instruction
 * processed in that invocation and whether the entry was a function call.
 * A different first instruction consumes PROCEDURE eligibility; result
 * presence remains separate from the function-call kind.
 */
RexxActivationArguments: class
  values = .RexxValue[]
  presence = .int[]
  slot_count = .int
  supplied_count = .int
  returned_value = .RexxValue
  return_present = .boolean
  procedure_eligible = .boolean
  function_call = .boolean
  address_state = .RexxAddressState
  trace_state = .RexxTraceState
  date_time_state = .RexxDateTimeState
  date_time_ready = .boolean
  numeric_digits = .int
  numeric_fuzz = .int
  numeric_form = .int
  signal_policy = .int[]
  parent_activation_ref = reference .RexxActivationArguments
  has_parent_activation = .boolean
  caller_pool_ref = reference .RexxVariablePool
  has_caller_pool = .boolean
  program_root_ref = reference .RexxActivationArguments
  has_program_root = .boolean
  program_exit_requested = .boolean
  delayed_condition = .int
  pending_condition = .int
  pending_description = .string
  pending_line = .int
  dispatch_condition = .int
  dispatch_description = .string
  dispatch_line = .int
  call_dispatch_error = .string
  current_condition = .int
  condition_description = .string
  condition_extra = .string
  condition_instruction = .string
  /* Physical fields sort by name: these late-sorting private names preserve
   * existing ordinals. Appending declarations alone does not preserve layout. */
  zz_entry_condition = .int
  zz_suppression_condition = .int
  zz_zz_host_mode = .string
  zz_zz_host_clock = .RexxClassicHostClock
  zz_zz_host_clock_trap = .RexxClassicHostClock
  zz_zz_host_zcompletion_generation = .int
  zz_zz_host_zcompletion_live = .boolean
  zz_zz_host_zcompletion_parent_generation = .int
  zz_zz_host_zcompletion_pending = .boolean
  zz_zz_host_zcompletion_root = reference .RexxActivationArguments
  zz_zz_host_zcompletion_signal = .runtime_signal

  zz_zz_zdynamic_policy = .object[]

  *: factory
    slot_count = 0
    supplied_count = 0
    returned_value = .RexxValue("")
    return_present = 0
    procedure_eligible = 0
    function_call = 0
    address_state = .RexxAddressState()
    trace_state = .RexxTraceState()
    date_time_state = .RexxDateTimeState()
    date_time_ready = 0
    numeric_digits = 9
    numeric_fuzz = 0
    numeric_form = 1
    has_parent_activation = 0
    has_caller_pool = 0
    has_program_root = 0
    program_exit_requested = 0
    delayed_condition = 0
    pending_condition = 0
    pending_description = ""
    pending_line = 0
    dispatch_condition = 0
    dispatch_description = ""
    dispatch_line = 0
    call_dispatch_error = ""
    current_condition = 0
    condition_description = ""
    condition_extra = ""
    condition_instruction = ""
    zz_entry_condition = 0
    zz_suppression_condition = 0
    zz_zz_host_mode = ""
    absent_clock = .RexxClassicHostClock
    zz_zz_host_clock = absent_clock
    zz_zz_host_clock_trap = absent_clock
    zz_zz_host_zcompletion_generation = 0
    zz_zz_host_zcompletion_live = 0
    zz_zz_host_zcompletion_parent_generation = 0
    zz_zz_host_zcompletion_pending = 0
    absent_completion_root = reference .RexxActivationArguments
    zz_zz_host_zcompletion_root = absent_completion_root
    absent_completion_signal = .runtime_signal
    zz_zz_host_zcompletion_signal = absent_completion_signal
    do index = 1 to 7
      signal_policy[index] = 0
      absent_dynamic_policy = .object
      zz_zz_zdynamic_policy[index] = absent_dynamic_policy
    end
    return

  /**
   * Copy the caller's Classic condition policy and last trapped condition
   * into a new invocation. Local changes are restored when it returns.
   * Internal children inherit validated delayed suppression, but never the
   * one-shot marker identifying an explicitly delivered external handler.
   * @param parent_ref the caller activation
   */
  inheritSignalPolicy: method = .void
    arg parent_ref = reference .RexxActivationArguments
    parent = dereference parent_ref
    parent_activation_ref = parent_ref
    has_parent_activation = 1
    program_root_ref = parent.programRoot()
    has_program_root = 1
    completion_root = parent.hostCompletionRoot()
    zz_zz_host_zcompletion_root = completion_root
    zz_zz_host_zcompletion_parent_generation = 0
    if <refvalid>(completion_root) then do
      completion = dereference completion_root
      completion_generation = completion.hostCompletionGeneration()
      zz_zz_host_zcompletion_parent_generation = completion_generation
    end
    do index = 1 to 7
      signal_policy[index] = parent.signalPolicy(index)
      zz_zz_zdynamic_policy[index] = parent.dynamicPolicy(index)
    end
    current_condition = parent.currentConditionId()
    condition_description = parent.currentConditionDescription()
    condition_extra = parent.currentConditionExtra()
    condition_instruction = parent.currentConditionInstruction()
    delayed_condition = parent.delayedConditionId()
    zz_entry_condition = 0
    zz_suppression_condition = parent.delayedSuppressionConditionId()
    state = .RexxAddressState
    assembler link state, address_state
    call state.copyFrom(parent.addressState())
    trace_state = .RexxTraceState()
    call trace_state.copyFrom(parent.traceState())
    numeric_digits = parent.numericDigits()
    numeric_fuzz = parent.numericFuzz()
    numeric_form = parent.numericForm()
    return

  /** Configure a host-owned root without borrowing a foreign handler table. */
  beginHostProgram: method = .void
    arg mode = .string
    if mode <> "COMMAND" & mode <> "FUNCTION" & mode <> "SUBROUTINE" then do
      assembler signal "INVALID_ARGUMENTS","Invalid Classic host invocation mode"
      return
    end
    zz_zz_host_mode = mode
    function_call = mode = "FUNCTION"
    procedure_eligible = 0
    return

  /** Optional coherent wall-clock source; absence retains the VM producers. */
  setClock: method = .void
    arg provider = .RexxClassicHostClock, trap = 0
    if trap then zz_zz_host_clock_trap = provider
    else zz_zz_host_clock = provider
    return

  clock: method = .RexxClassicHostClock
    return zz_zz_host_clock

  /** Internal activations use the root's single configured producer owner. */
  sampleHostClock: method = .RexxClassicHostClockSample
    if initialized(zz_zz_host_clock_trap) then do
      sample = zz_zz_host_clock_trap.sample()
      if sample.present() then return sample
    end
    if initialized(zz_zz_host_clock) then return zz_zz_host_clock.sample()
    return .RexxClassicHostClockSample.fallthrough()

  /** Begin a clause lazily; ordinary clauses need no platform clock calls. */
  beginClauseTime: method = .void
    date_time_ready = 0
    return

  /** Freeze this invocation's sample independently of nested internal calls. */
  ensureClauseTime: method = .void
    if \date_time_ready then do
      state = .RexxDateTimeState
      assembler link state,date_time_state
      sampled = 0
      root = dereference programRoot()
      sample = root.sampleHostClock()
      if sample.present() then do
        call state.injectClause(sample.baseDay(),sample.localMicroseconds(),sample.utcMicroseconds(),sample.offsetMicroseconds())
        sampled = 1
      end
      if \sampled then call state.beginClause()
      date_time_ready = 1
    end
    return

  clauseBaseDay: method = .int
    return date_time_state.baseDay()

  clauseLocalMicroseconds: method = .int
    return date_time_state.localMicroseconds()

  clauseUtcMicroseconds: method = .int
    return date_time_state.utcMicroseconds()

  clauseOffsetMicroseconds: method = .int
    return date_time_state.offsetMicroseconds()

  /** Internal invocations share the program's elapsed/reset origin. */
  clauseElapsedMicroseconds: method = .int
    arg reset = .boolean
    root = dereference programRoot()
    return root.elapsedAt(clauseUtcMicroseconds(),reset)

  /** Apply one frozen invocation sample to the program elapsed clock. */
  elapsedAt: method = .int
    arg now = .int, reset = .boolean
    state = .RexxDateTimeState
    assembler link state,date_time_state
    return state.elapsedAt(now,reset)

  /** The TRACE state owned by this invocation. */
  traceState: method = .RexxTraceState
    return trace_state

  /** Return the current TRACE setting, including active prefixes. */
  traceSetting: method = .string
    return trace_state.current()

  /** Apply one validated TRACE option to this invocation. */
  setTraceOption: method = .boolean
    arg option = .string
    return trace_state.apply(option)

  traceInhibiting: method = .boolean
    return trace_state.isInhibiting()

  traceInteractive: method = .boolean
    return trace_state.isInteractive()

  /** Current invocation-local Classic significant-digit setting. */
  numericDigits: method = .int
    return numeric_digits

  /** Current invocation-local Classic comparison fuzz setting. */
  numericFuzz: method = .int
    return numeric_fuzz

  /** Current invocation-local Classic form: 1 scientific, 2 engineering. */
  numericForm: method = .int
    return numeric_form

  /** Validate DIGITS and change only this invocation after a successful check. */
  setNumericDigits: method = .string
    arg value = .RexxValue, config_ref = reference .RexxClassicConfig
    config = dereference config_ref
    text = value.asString()
    if \rexxclassic_datatype_test(value, "W", config) then
      return "RXC-LC-26.5: NUMERIC DIGITS must be a positive whole number; found " || text
    state = 0
    normalized = rexxclassic_datatype_normalize_number(value, config, state)
    candidate = boundedNumericWhole(normalized)
    if candidate <= 0 then
      return "RXC-LC-26.5: NUMERIC DIGITS must be a positive whole number; found " || text
    if candidate <= numeric_fuzz then
      return "RXC-LC-33.1: NUMERIC DIGITS must exceed NUMERIC FUZZ; found " || text
    if candidate > 999 then
      return "RXC-LC-33.2: NUMERIC DIGITS must not exceed 999; found " || text
    numeric_digits = candidate
    return ""

  /** Validate FUZZ against the active DIGITS before changing this invocation. */
  setNumericFuzz: method = .string
    arg value = .RexxValue, config_ref = reference .RexxClassicConfig
    config = dereference config_ref
    text = value.asString()
    if \rexxclassic_datatype_test(value, "W", config) then
      return "RXC-LC-26.6: NUMERIC FUZZ must be a non-negative whole number; found " || text
    state = 0
    normalized = rexxclassic_datatype_normalize_number(value, config, state)
    candidate = boundedNumericWhole(normalized)
    if candidate < 0 then
      return "RXC-LC-26.6: NUMERIC FUZZ must be a non-negative whole number; found " || text
    if candidate >= numeric_digits then
      return "RXC-LC-33.1: NUMERIC DIGITS must exceed NUMERIC FUZZ; found " || text
    numeric_fuzz = candidate
    return ""

  /**
   * Read an already validated whole spelling without narrowing an unbounded
   * source value to a native integer. Values beyond 999 saturate at 1000.
   */
  boundedNumericWhole: method = .int
    arg normalized = .string
    text_length = .int
    codepoint = .int
    assembler strlen text_length,normalized
    index = 0
    negative = 0
    assembler strchar codepoint,normalized,index
    if codepoint = 43 | codepoint = 45 then do
      negative = codepoint = 45
      index = index + 1
    end
    mantissa_start = index
    digit_count = 0
    fractional_digits = 0
    first_nonzero = 0
    saw_point = 0
    do while index < text_length
      assembler strchar codepoint,normalized,index
      if codepoint = 46 then do
        saw_point = 1
        index = index + 1
        iterate
      end
      if codepoint = 69 | codepoint = 101 then leave
      digit_count = digit_count + 1
      if saw_point then fractional_digits = fractional_digits + 1
      if first_nonzero = 0 & codepoint <> 48 then first_nonzero = digit_count
      index = index + 1
    end
    if first_nonzero = 0 then return 0
    mantissa_end = index
    exponent = 0
    negative_exponent = 0
    if index < text_length then do
      index = index + 1
      assembler strchar codepoint,normalized,index
      if codepoint = 43 | codepoint = 45 then do
        negative_exponent = codepoint = 45
        index = index + 1
      end
      exponent_cap = text_length + 4
      do while index < text_length
        assembler strchar codepoint,normalized,index
        if exponent < exponent_cap then do
          exponent = exponent * 10 + codepoint - 48
          if exponent > exponent_cap then exponent = exponent_cap
        end
        index = index + 1
      end
    end
    if negative_exponent then exponent = 0 - exponent
    decimal_position = digit_count - fractional_digits + exponent
    significant_length = decimal_position - first_nonzero + 1
    if significant_length > 3 then do
      if negative then return -1000
      return 1000
    end
    result = 0
    digit_index = 0
    do mantissa_index = .int(mantissa_start) to mantissa_end - 1
      assembler strchar codepoint,normalized,mantissa_index
      if codepoint = 46 then iterate
      digit_index = digit_index + 1
      if digit_index >= first_nonzero & digit_index <= decimal_position then
        result = result * 10 + codepoint - 48
    end
    do while digit_index < decimal_position
      result = result * 10
      digit_index = digit_index + 1
    end
    if negative then return 0 - result
    return result

  /** FORM VALUE uses only the first translated character of its value.
   * @param value proposed form text
   * @return Empty on success, or RXC-LC-33.3 without changing numeric state. */
  setNumericForm: method = .string
    arg value = .RexxValue
    text = value.asString()
    first = upper(left(text, 1))
    if first = "S" then numeric_form = 1
    else if first = "E" then numeric_form = 2
    else return "RXC-LC-33.3: NUMERIC FORM must start with E or S; found " || text
    return ""

  /** Keep command status shared across signed external Classic calls. */
  captureCallerPool: method = .void
    arg pool_ref = reference .RexxVariablePool
    caller_pool_ref = pool_ref
    has_caller_pool = 1
    return

  applyCommandStatusToPool: method = .void
    arg pool_ref = reference .RexxVariablePool
    if \has_caller_pool then return
    pool = dereference pool_ref
    call pool.inheritCommandStatus(caller_pool_ref)
    return

  /** The current invocation's independent Classic ADDRESS setting. */
  addressState: method = .RexxAddressState
    return address_state

  setAddressEnvironment: method = .void
    arg name = .string
    state = .RexxAddressState
    assembler link state, address_state
    call state.setEnvironment(name)
    return

  swapAddressEnvironment: method = .void
    state = .RexxAddressState
    assembler link state, address_state
    call state.swapEnvironment()
    return

  setAddressConnection: method = .void
    arg option = .string, position = .string, type = .string, resource = .string
    state = .RexxAddressState
    assembler link state, address_state
    call state.setConnection(option, position, type, resource)
    return

  addressEnvironment: method = .string
    return address_state.environment()

  addressConnection: method = .string
    arg option = .string
    return address_state.connection(option)

  /**
   * The root of this compiled Classic program, shared by its internal calls.
   * External signed CALL starts a distinct root while retaining the caller
   * reference for condition-policy inheritance.
   */
  programRoot: method = reference .RexxActivationArguments
    if has_program_root then return program_root_ref
    return reference self

  /** Bind one explicitly Scope-owned terminal-failure boundary on this root.
   * A finite generation prevents an old child from acquiring a later binding.
   * @signal REFERENCE_INVALID A live boundary already owns this activation.
   * @signal CLASSIC_SYNTAX Resource error 5.1 if its generation is exhausted.
   */
  beginHostCompletion: method = .void
    current = hostCompletionRoot()
    if <refvalid>(current) then do
      assembler signal "REFERENCE_INVALID","Classic host completion is already bound"
      return
    end
    if zz_zz_host_zcompletion_generation >= 9223372036854775807 then do
      assembler signal "CLASSIC_SYNTAX","RXC-LC-5.1: Classic host completion generation is exhausted"
      return
    end
    zz_zz_host_zcompletion_generation = zz_zz_host_zcompletion_generation + 1
    absent_root = reference .RexxActivationArguments
    zz_zz_host_zcompletion_root = absent_root
    zz_zz_host_zcompletion_parent_generation = 0
    absent_signal = .runtime_signal
    zz_zz_host_zcompletion_signal = absent_signal
    zz_zz_host_zcompletion_pending = 0
    program_exit_requested = 0
    call clearReturnValue()
    zz_zz_host_zcompletion_live = 1
    return

  /** Idempotently revoke this root; retained children cannot regain access.
   * On a fresh activation with only an inherited completion association, this
   * clears that association without revoking its parent. A source coordinator
   * uses this preparation before the child's distinct HostScope enters; Scope
   * remains the owner of live completion binding and revocation.
   */
  endHostCompletion: method = .void
    zz_zz_host_zcompletion_live = 0
    zz_zz_host_zcompletion_pending = 0
    absent_root = reference .RexxActivationArguments
    zz_zz_host_zcompletion_root = absent_root
    zz_zz_host_zcompletion_parent_generation = 0
    absent_signal = .runtime_signal
    zz_zz_host_zcompletion_signal = absent_signal
    return

  /** Internal generation witness; zero means this receiver is not a live owner. */
  hostCompletionGeneration: method = .int
    if zz_zz_host_zcompletion_live then return zz_zz_host_zcompletion_generation
    return 0

  /** @return the checked direct live host owner, or an empty reference. */
  hostCompletionRoot: method = reference .RexxActivationArguments
    if zz_zz_host_zcompletion_live then return reference self
    owner_ref = zz_zz_host_zcompletion_root
    if <refvalid>(owner_ref) then do
      owner = dereference owner_ref
      generation = owner.hostCompletionGeneration()
      if generation > 0 & generation = zz_zz_host_zcompletion_parent_generation then return owner_ref
    end
    absent_root = reference .RexxActivationArguments
    return absent_root

  /**
   * Retain the first exact escaping event at the live explicit host boundary.
   * @param problem Original typed event, including its payload and origin.
   * @return true when accepted, including an already-pending first failure;
   * false without a live boundary, leaving the caller's HALT policy unchanged.
   */
  requestProgramFailure: method = .boolean
    arg problem = .runtime_signal
    if zz_zz_host_zcompletion_live then do
      if \zz_zz_host_zcompletion_pending then do
        zz_zz_host_zcompletion_signal = problem
        zz_zz_host_zcompletion_pending = 1
        call clearReturnValue()
      end
      return 1
    end
    owner_ref = hostCompletionRoot()
    if <refvalid>(owner_ref) = 0 then return 0
    owner = dereference owner_ref
    return owner.requestProgramFailure(problem)

  /** @return true only while this activation's checked owner retains a failure. */
  hostFailurePending: method = .boolean
    if zz_zz_host_zcompletion_live then return zz_zz_host_zcompletion_pending
    owner_ref = hostCompletionRoot()
    if <refvalid>(owner_ref) = 0 then return 0
    owner = dereference owner_ref
    return owner.hostFailurePending()

  /** @return an owned copy of the original event from the live boundary.
   * @signal REFERENCE_INVALID No matching live owner has a pending failure.
   */
  hostFailure: method = .runtime_signal
    if zz_zz_host_zcompletion_live & zz_zz_host_zcompletion_pending then return zz_zz_host_zcompletion_signal
    owner_ref = hostCompletionRoot()
    if <refvalid>(owner_ref) then do
      own_ref = reference self
      if \(owner_ref <refsame> own_ref) then do
        owner = dereference owner_ref
        return owner.hostFailure()
      end
    end
    assembler signal "REFERENCE_INVALID","Classic host completion has no live failure"
    absent_signal = .runtime_signal
    return absent_signal

  /**
   * Start a separate external Level C program on this fresh activation.
   * New delayed suppression does not cross an ordinary external boundary.
   * Preserve an explicit CALL-entry marker for condition-scope normalization.
   */
  beginExternalProgram: method = .void
    has_program_root = 0
    program_exit_requested = 0
    zz_suppression_condition = 0
    call clearReturnValue()
    return

  /**
   * Begin a provider-owned condition scope without retaining foreign handlers.
   * A valid one-shot CALL entry keeps its delivered C/D/E/I and DELAY state;
   * ordinary or stale entries start with no current condition. All policy,
   * pending and dispatch state is cleared in either case. Numeric, ADDRESS,
   * TRACE, arguments, completion and activation relationships are unchanged.
   */
  beginExternalConditionScope: method = .void
    delivery = 0
    if zz_entry_condition >= 2 & zz_entry_condition <= 5 &,
       zz_entry_condition = current_condition & zz_entry_condition = delayed_condition &,
       condition_instruction == "CALL" then delivery = zz_entry_condition
    zz_entry_condition = 0
    absent_dynamic_policy = .object
    do index = 1 to 7
      signal_policy[index] = 0
      zz_zz_zdynamic_policy[index] = absent_dynamic_policy
    end
    pending_condition = 0
    pending_description = ""
    pending_line = 0
    dispatch_condition = 0
    dispatch_description = ""
    dispatch_line = 0
    call_dispatch_error = ""
    zz_suppression_condition = delivery
    if delivery = 0 then do
      current_condition = 0
      condition_description = ""
      condition_extra = ""
      condition_instruction = ""
      delayed_condition = 0
    end
    return

  /**
   * Return the entry mode of this compiled Classic programme. Internal
   * routines inherit the programme root's mode; a signed external call
   * starts a new programme root on its existing activation frame.
   */
  programSourceMode: method = .string
    root = dereference programRoot()
    if root.hostMode() <> "" then return root.hostMode()
    if root.hasProgramCaller() then do
      if root.isFunctionCall() then return "FUNCTION"
      return "SUBROUTINE"
    end
    return "COMMAND"

  /** Explicit root mode supplied by the host request, empty for legacy roots. */
  hostMode: method = .string
    return zz_zz_host_mode

  /** @return true when this activation was created by a caller */
  hasProgramCaller: method = .boolean
    return has_parent_activation

  /**
   * Record one program-wide EXIT result at this program's activation root.
   * @param value full Unicode or binary-capable Classic scalar
   * @param present true when the EXIT has an expression
   */
  requestProgramExit: method = .void
    arg value = .RexxValue, present = .boolean
    root = dereference programRoot()
    call root.recordProgramExit(value, present)
    return

  /** @return whether normal EXIT or this activation's checked host failure requests unwinding */
  programExitRequested: method = .boolean
    if hostFailurePending() then return 1
    return ordinaryProgramExitRequested()

  /** Internal normal-EXIT traversal; never refreshes a host generation witness. */
  ordinaryProgramExitRequested: method = .boolean
    if has_program_root then do
      root = dereference program_root_ref
      return root.ordinaryProgramExitRequested()
    end
    return program_exit_requested

  /** Store the program result once at the program boundary. */
  recordProgramExit: method = .void
    arg value = .RexxValue, present = .boolean
    program_exit_requested = 1
    if present then call setReturnValue(value)
    else call clearReturnValue()
    return

  /** Record the condition currently visible to CONDITION(). */
  recordCondition: method = .void
    arg condition = .int, description = .string, extra = .string, instruction = .string
    if condition < 1 | condition > 7 then return
    current_condition = condition
    condition_description = description
    condition_extra = extra
    condition_instruction = instruction
    return

  /** @return Classic ID of the last trapped condition, or zero. */
  currentConditionId: method = .int
    return current_condition

  /** @return Classic name of the last trapped condition, or null. */
  currentConditionName: method = .string
    if current_condition = 1 then return "SYNTAX"
    if current_condition = 2 then return "ERROR"
    if current_condition = 3 then return "FAILURE"
    if current_condition = 4 then return "HALT"
    if current_condition = 5 then return "NOTREADY"
    if current_condition = 6 then return "NOVALUE"
    if current_condition = 7 then return "LOSTDIGITS"
    return ""

  /** @return description of the last trapped condition. */
  currentConditionDescription: method = .string
    return condition_description

  /** @return extra data of the last trapped condition. */
  currentConditionExtra: method = .string
    return condition_extra

  /** @return instruction that trapped the last condition. */
  currentConditionInstruction: method = .string
    return condition_instruction

  /** @return the condition currently delayed by a CALL trap, or zero */
  delayedConditionId: method = .int
    return delayed_condition

  /**
   * @return the suppressed CALL condition, 2..5, only while its delay is active
   * A later trapped condition may change CONDITION data without ending delay.
   */
  delayedSuppressionConditionId: method = .int
    if zz_suppression_condition < 2 | zz_suppression_condition > 5 then return 0
    if zz_suppression_condition <> delayed_condition then return 0
    return zz_suppression_condition

  /**
   * Mark the called handler's temporary condition without changing its caller.
   * Valid IDs arm one explicit-entry marker; invalid IDs remain no-ops.
   * @param condition Classic CALL condition ID 2..5
   * @param description delivered condition description
   */
  beginCallTrap: method = .void
    arg condition = .int, description = .string
    if condition < 2 | condition > 5 then return
    zz_suppression_condition = 0
    zz_entry_condition = condition
    delayed_condition = condition
    call recordCondition(condition, description, "", "CALL")
    return

  /**
   * Select the ON clause active for one Classic condition in this invocation.
   * Zero disables the condition after OFF or one-shot delivery.
   * @param condition one-based Classic condition code
   * @param handler one-based ON clause identity, or zero
   */
  setSignalPolicy: method = .void
    arg condition = .int, handler = .int
    if condition < 1 | condition > 7 then return
    absent_dynamic_policy = .object
    zz_zz_zdynamic_policy[condition] = absent_dynamic_policy
    signal_policy[condition] = handler
    if delayed_condition = condition then delayed_condition = 0
    if zz_entry_condition = condition then zz_entry_condition = 0
    if zz_suppression_condition = condition then zz_suppression_condition = 0
    return

  /** Select a delayed CALL trap; negative policy distinguishes its mode. */
  setCallPolicy: method = .void
    arg condition = .int, handler = .int
    if condition < 2 | condition > 5 | handler < 1 then return
    absent_dynamic_policy = .object
    zz_zz_zdynamic_policy[condition] = absent_dynamic_policy
    signal_policy[condition] = -handler
    if delayed_condition = condition then delayed_condition = 0
    if zz_entry_condition = condition then zz_entry_condition = 0
    if zz_suppression_condition = condition then zz_suppression_condition = 0
    return

  /** Install a checked persistent definition before changing the policy word.
   * The reserved ordinal is meaningful only with this sidecar. Static ON/OFF
   * setters release it; the immutable definition can outlive its group plan.
   * @param condition one-based Classic condition identity
   * @param definition immutable RexxClassicHandlerDefinition object
   * @signal INVALID_ARGUMENTS invalid type, mode or condition
   */
  setDynamicPolicy: method = .void
    arg condition = .int, definition = .object
    if condition < 1 | condition > 7 | \(definition is .RexxClassicHandlerDefinition) then do
      assembler signal "INVALID_ARGUMENTS","Invalid Classic dynamic handler policy"
      return
    end
    policy = definition as .RexxClassicHandlerDefinition
    if \policy.valid() | (policy.kind() = 'CALL' & (condition < 2 | condition > 5)) then do
      assembler signal "INVALID_ARGUMENTS","Invalid Classic dynamic handler policy mode"
      return
    end
    zz_zz_zdynamic_policy[condition] = definition
    signal_policy[condition] = 2147483647
    if policy.kind() = 'CALL' then signal_policy[condition] = -2147483647
    if delayed_condition = condition then delayed_condition = 0
    if zz_entry_condition = condition then zz_entry_condition = 0
    if zz_suppression_condition = condition then zz_suppression_condition = 0
    return

  /** Return an immutable checked definition or typed absence. A reserved policy
   * without its definition is always malformed rather than a static ordinal.
   */
  dynamicPolicy: method = .object
    arg condition = .int
    absent = .object
    if condition < 1 | condition > 7 then return absent
    definition = zz_zz_zdynamic_policy[condition]
    if signal_policy[condition] <> 2147483647 & signal_policy[condition] <> -2147483647 then return absent
    if \(definition is .RexxClassicHandlerDefinition) then do
      assembler signal "INVALID_ARGUMENTS","Classic dynamic handler sentinel has no checked definition"
      return absent
    end
    policy = definition as .RexxClassicHandlerDefinition
    if \policy.valid() then do
      assembler signal "INVALID_ARGUMENTS","Classic dynamic handler definition is invalid"
      return absent
    end
    return definition

  /** @return the selected CALL handler identity, or zero in another mode */
  callPolicy: method = .int
    arg condition = .int
    if condition < 2 | condition > 5 then return 0
    if signal_policy[condition] >= 0 then return 0
    return -signal_policy[condition]

  /**
   * Queue a source-identified condition for clause-end CALL delivery.
   * A second ERROR, FAILURE or NOTREADY in its own handler is suppressed.
   * A normalized external handler can suppress its delayed event with no
   * dispatchable policy. HALT retains the existing parent buffer path.
   * @return true when queued or buffered; false also includes suppression
   */
  queueCallCondition: method = .boolean
    arg condition = .int, description = .string, line = .int
    if condition < 2 | condition > 5 then return 0
    scope_ref = reference self
    scope_owner = dereference scope_ref
    if callPolicy(condition) = 0 & scope_owner.delayedSuppressionConditionId() <> condition then return 0
    if delayed_condition = condition then do
      if condition = 4 & has_parent_activation then do
        parent = dereference parent_activation_ref
        return parent.bufferHaltOutsideDelay(description, line)
      end
      return 0
    end
    if pending_condition <> 0 then return 0
    pending_condition = condition
    pending_description = description
    pending_line = line
    return 1

  /** Retain one extra HALT on the interrupted activation while its trap runs. */
  bufferHaltOutsideDelay: method = .boolean
    arg description = .string, line = .int
    if delayed_condition = 4 & has_parent_activation then do
      parent = dereference parent_activation_ref
      return parent.bufferHaltOutsideDelay(description, line)
    end
    if callPolicy(4) = 0 | pending_condition <> 0 then return 0
    pending_condition = 4
    pending_description = description
    pending_line = line
    return 1

  /** @return true when a deferred event remains after a handler returns */
  hasPendingCallCondition: method = .boolean
    return pending_condition <> 0

  /** Inspect pending identity without consuming its shared dispatch packet.
   * Dynamic-aware compiled callers use this to retain the existing static
   * handler path when no persistent dynamic definition is selected.
   */
  pendingConditionId: method = .int
    return pending_condition

  /**
   * Move a queued event into stable dispatch fields at a clause boundary.
   * @return the handler identity selected by the current CALL policy
   */
  takeCallCondition: method = .int
    if pending_condition = 0 then return 0
    dispatch_condition = pending_condition
    dispatch_description = pending_description
    dispatch_line = pending_line
    pending_condition = 0
    pending_description = ""
    pending_line = 0
    return callPolicy(dispatch_condition)

  /** @return the condition selected by the last clause checkpoint */
  dispatchedConditionId: method = .int
    return dispatch_condition

  /** @return the description selected by the last clause checkpoint */
  dispatchedConditionDescription: method = .string
    return dispatch_description

  /** @return the causing source line selected by the last clause checkpoint */
  dispatchedConditionLine: method = .int
    return dispatch_line

  /**
   * Retain a delayed CALL resolution error until the authored clause
   * checkpoint can raise it with that clause's source location.
   * @param detail complete Classic diagnostic detail
   */
  recordCallDispatchError: method = .void
    arg detail = .string
    call_dispatch_error = detail
    return

  /** @return the pending delayed CALL error, consuming it once */
  takeCallDispatchError: method = .string
    detail = call_dispatch_error
    call_dispatch_error = ""
    return detail

  /**
   * Read the selected ON clause for one Classic condition.
   * @param condition one-based Classic condition code
   * @return the ON clause identity, or zero when disabled
   */
  signalPolicy: method = .int
    arg condition = .int
    if condition < 1 | condition > 7 then return 0
    return signal_policy[condition]

  /**
   * Append one evaluated argument position.
   * @param value captured argument value
   * @param exists 1 for an explicitly supplied value, 0 for an omission
   */
  append: method = .void
    arg value = .RexxValue, exists = .boolean
    slot_count = slot_count + 1
    values[slot_count] = value
    presence[slot_count] = exists
    if exists then supplied_count = slot_count
    return

  /**
   * Append one main-entry argument without changing its Unicode text.
   * @param text exact valid Unicode argument text supplied by the host
   */
  appendText: method = .void
    arg text = .string
    call append(.RexxValue(text), 1)
    return

  /** @return highest explicitly supplied position, excluding trailing omissions */
  argumentCount: method = .int
    return supplied_count

  /** Raw positional extent, including trailing omissions, for host transport. */
  rawArgumentCount: method = .int
    return slot_count

  /**
   * Test whether a positional slot was explicitly supplied.
   * @param index one-based position
   * @return true only for a supplied position
   */
  argumentExists: method = .boolean
    arg index = .int
    if index < 1 | index > slot_count then return 0
    return presence[index] <> 0

  /**
   * Read one captured argument without modifying the frame.
   * @param index one-based position
   * @return the captured value, or an empty value for an omission or missing slot
   */
  argument: method = .RexxValue
    arg index = .int
    if index < 1 | index > slot_count then return .RexxValue("")
    if presence[index] = 0 then return .RexxValue("")
    return values[index]

  /**
   * Record an explicit Classic RETURN result in this invocation.
   * @param value the returned scalar value
   */
  setReturnValue: method = .void
    arg value = .RexxValue
    returned_value = value
    return_present = 1
    return

  /** Clear the optional result for a bare RETURN or fresh dispatch. */
  clearReturnValue: method = .void
    returned_value = .RexxValue("")
    return_present = 0
    return

  /** @return true only when this invocation explicitly returned a value */
  hasReturnValue: method = .boolean
    return return_present

  /** @return the result value, or an empty value when none was supplied */
  returnValue: method = .RexxValue
    return returned_value

  /**
   * Map an outermost Classic result to the current integer main-entry status.
   * The activation retains the complete value until this host boundary.
   * @return an integer status, or zero when no representable whole-number status is available
   */
  programReturnCode: method = .int
    numeric digits 20
    if return_present = 0 then return 0
    text = returned_value.asString()
    if datatype(text, "W") <> "1" then return 0
    number = text as .decimal
    maximum = "9223372036854775807" as .decimal
    minimum = "-9223372036854775808" as .decimal
    if number > maximum | number < minimum then return 0
    return number as .int

  /** Mark this internal CALL/function activation before label entry. */
  beginInternalCall: method = .void
    procedure_eligible = 1
    function_call = 0
    return

  /** Mark this activation as an internal function call. */
  beginInternalFunction: method = .void
    procedure_eligible = 1
    function_call = 1
    return

  /** @return true only when this activation was entered as a function */
  isFunctionCall: method = .boolean
    return function_call

  /** Consume the PROCEDURE right when another instruction executes first. */
  consumeFirstInstruction: method = .void
    procedure_eligible = 0
    return

  /**
   * Enter PROCEDURE only as the first instruction of an internal call.
   * @signal CLASSIC_SYNTAX Error 17.1 for main or later execution
   */
  enterProcedure: method = .void
    if \procedure_eligible then do
      assembler signal "CLASSIC_SYNTAX", "RXC-LC-17.1: PROCEDURE is valid only as the first instruction of an internal call"
    end
    procedure_eligible = 0
    return

  /** @return whether a fresh internal call may execute PROCEDURE next */
  procedureEligible: method = .boolean
    return procedure_eligible
