options levelb comments_dash numeric_classic
namespace rexxclassicbifrandom expose rexxclassicbif_random
import rexxclassicbifs
import rexxclassicconfig
import rexxvalue

/**
 * Classic Rexx RANDOM built-in function.
 *
 * @bif RANDOM
 * @signature RANDOM([max]) or RANDOM([min [,max [,seed]]])
 * @checkargs oWHOLE>=0 oWHOLE>=0 oWHOLE>=0
 * @return pseudo-random whole number in the selected inclusive range
 * @error 40.31 one-argument maximum exceeds 100000
 * @error 40.32 selected range width exceeds 100000
 * @error 40.33 minimum exceeds maximum
 */
rexxclassicbif_random: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  minimum = .int
  maximum = .int
  seed = .int
  single_maximum = .boolean
  config = .RexxClassicConfig
  config_ref = reference .RexxClassicConfig

  call context.clearError()
  if rexxclassicbif_check_args(context_ref,"oWHOLE>=0 oWHOLE>=0 oWHOLE>=0") = 0 then
    return .RexxValue("")

  minimum = 0
  maximum = 999
  single_maximum = context.argumentExists(1) &,
                   \context.argumentExists(2) &,
                   \context.argumentExists(3)
  if single_maximum then do
    maximum = context.argumentText(1) + 0
    if maximum > 100000 then do
      call rexxclassicbif_set_error(context_ref,"40.31",1,context.argumentText(1),"")
      return .RexxValue("")
    end
  end
  else do
    if context.argumentExists(1) then minimum = context.argumentText(1) + 0
    if context.argumentExists(2) then maximum = context.argumentText(2) + 0
  end

  if minimum > maximum then do
    call rexxclassicbif_set_error(context_ref,"40.33",1,minimum || "",maximum || "")
    return .RexxValue("")
  end
  if maximum - minimum > 100000 then do
    call rexxclassicbif_set_error(context_ref,"40.32",1,minimum || "",maximum || "")
    return .RexxValue("")
  end

  config_ref = context.configReference()
  config = dereference config_ref
  if context.argumentExists(3) then do
    seed = context.argumentText(3) + 0
    call config.seedRandom(seed)
  end
  return .RexxValue.fromInt(minimum + config.nextRandom(maximum - minimum + 1))
