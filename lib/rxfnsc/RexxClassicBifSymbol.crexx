options levelb comments_dash numeric_classic
namespace rexxclassicbifsymbol expose rexxclassicbif_symbol
import rexxclassicbifs
import rexxclassicdatatype
import rexxpool
import rexxvalue

/**
 * Classify one Classic REXX symbol against the caller variable pool.
 *
 * @bif SYMBOL
 * @signature SYMBOL(name)
 * @checkargs rANY plus Classic symbol recognition
 * @sandbox reads only the caller activation variable pool
 * @return `BAD`, `LIT`, or `VAR`
 */
rexxclassicbif_symbol: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY") = 0 then return .RexxValue("")

  value = context.argument(1)
  text = context.argumentText(1)
  config = context.characterConfig()
  symbol_kind = rexxclassic_datatype_symbol_kind(value,config)
  if symbol_kind = 0 then return .RexxValue("BAD")
  if symbol_kind = 2 then return .RexxValue("LIT")

  pool_ref = reference .RexxVariablePool
  pool_ref = context.callerPool()
  pool = dereference pool_ref
  if pool.symbolHasValue(text) then return .RexxValue("VAR")
  return .RexxValue("LIT")
