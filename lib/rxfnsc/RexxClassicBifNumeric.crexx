options levelb comments_dash numeric_classic
namespace rexxclassicbifnumeric expose rexxclassicbif_digits rexxclassicbif_form rexxclassicbif_fuzz
import rexxclassicbifs
import rexxvalue

/**
 * Return the immediate caller's current NUMERIC DIGITS setting.
 *
 * @bif DIGITS
 * @signature DIGITS()
 * @checkargs
 * @sandbox pure
 * @return significant-digit count as a RexxValue integer
 */
rexxclassicbif_digits: procedure = .RexxValue
  numeric digits inherited
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "") = 0 then return .RexxValue("")
  value = .int
  assembler getnumdgts value
  return .RexxValue.fromInt(value)

/**
 * Return the immediate caller's current NUMERIC FORM setting.
 *
 * @bif FORM
 * @signature FORM()
 * @checkargs
 * @sandbox pure
 * @return `SCIENTIFIC`, `ENGINEERING`, or `UNKNOWN` as a RexxValue
 */
rexxclassicbif_form: procedure = .RexxValue
  numeric form inherited
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "") = 0 then return .RexxValue("")
  value = .int
  assembler getnumfrm value
  if value = 1 then return .RexxValue("SCIENTIFIC")
  if value = 2 then return .RexxValue("ENGINEERING")
  return .RexxValue("UNKNOWN")

/**
 * Return the immediate caller's current NUMERIC FUZZ setting.
 *
 * @bif FUZZ
 * @signature FUZZ()
 * @checkargs
 * @sandbox pure
 * @return ignored-digit count as a RexxValue integer
 */
rexxclassicbif_fuzz: procedure = .RexxValue
  numeric fuzz inherited
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "") = 0 then return .RexxValue("")
  value = .int
  assembler getnumfuz value
  return .RexxValue.fromInt(value)
