options levelb comments_dash numeric_classic
namespace rexxclassicbifdelstr expose rexxclassicbif_delstr
import rexxclassicbifs
import rexxvalue

/**
 * Delete a Classic character range.
 *
 * @bif DELSTR
 * @signature DELSTR(string, start [,length])
 * @checkargs rANY rWHOLE>0 oWHOLE>=0
 * @sandbox pure
 * @return changed string as a RexxValue
 */
rexxclassicbif_delstr: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY rWHOLE>0 oWHOLE>=0") = 0 then return .RexxValue("")

  string = context.argumentText(1)
  start = .int
  start = context.argumentText(2) + 0
  length_supplied = context.argumentExists(3)
  delete_length = 0
  if length_supplied then delete_length = context.argumentText(3) + 0
  string_length = .int
  prefix_length = .int
  available = .int
  tail_start = .int
  tail_length = .int
  cursor = 0
  tail = ""
  result = ""

  assembler strlen string_length,string
  if start > string_length then return .RexxValue(string)
  if length_supplied & delete_length = 0 then return .RexxValue(string)

  prefix_length = start - 1
  available = string_length - prefix_length
  if \length_supplied then delete_length = available
  if delete_length >= available then do
    if prefix_length = 0 then return .RexxValue("")
    assembler setstrpos string,cursor
    assembler substring result,string,prefix_length
    return .RexxValue(result)
  end

  if prefix_length > 0 then do
    assembler setstrpos string,cursor
    assembler substring result,string,prefix_length
  end
  tail_start = prefix_length + delete_length
  tail_length = string_length - tail_start
  assembler setstrpos string,tail_start
  assembler substring tail,string,tail_length
  assembler append result,tail
  return .RexxValue(result)
