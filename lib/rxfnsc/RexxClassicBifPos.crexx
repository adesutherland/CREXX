options levelb comments_dash numeric_classic
namespace rexxclassicbifpos expose rexxclassicbif_pos
import rexxclassicbifs
import rexxclassiccharacterops
import rexxvalue

/**
 * Locate text in a Classic string.
 *
 * @bif POS
 * @signature POS(needle, haystack [,start])
 * @checkargs rANY rANY oWHOLE>0
 * @sandbox pure
 * @return first matching character position as a RexxValue, or zero
 */
rexxclassicbif_pos: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY rANY oWHOLE>0") = 0 then return .RexxValue("")

  start = 1
  if context.argumentExists(3) then start = context.argumentText(3) + 0
  config = context.characterConfig()
  found_position = rexxclassic_value_find(context.argument(1),context.argument(2),start,config)
  return .RexxValue(found_position || "")
