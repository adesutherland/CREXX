options levelb comments_dash numeric_classic
namespace rexxclassicbifx2d expose rexxclassicbif_x2d
import rexxclassicbifs
import rexxvalue

/**
 * Convert Classic hexadecimal text to a decimal whole number.
 *
 * @bif X2D
 * @signature X2D(hexadecimal [,length])
 * @checkargs rHEX oWHOLE>=0
 * @sandbox pure
 * @return exact decimal whole-number text as a RexxValue
 */
rexxclassicbif_x2d: procedure = .RexxValue
  numeric digits inherited
  numeric form inherited
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rHEX oWHOLE>=0") = 0 then return .RexxValue("")

  hexadecimal = context.argumentText(1)
  hexadecimal_length = .int
  hexadecimal_digits = 0
  codepoint = .int
  blank_character = 32
  assembler strlen hexadecimal_length,hexadecimal
  do index = 0 to hexadecimal_length - 1
    assembler strchar codepoint,hexadecimal,index
    if codepoint <> blank_character then hexadecimal_digits = hexadecimal_digits + 1
  end
  if hexadecimal_digits = 0 then return .RexxValue("0")

  selected_digits = hexadecimal_digits
  skip_digits = 0
  negative = 0
  if context.argumentExists(2) then do
    length_text = context.argumentText(2)
    signed_length = _x2d_bounded_length(length_text, hexadecimal_digits + 1)
    if signed_length = 0 then return .RexxValue("0")
    if signed_length < selected_digits then selected_digits = signed_length
    skip_digits = hexadecimal_digits - selected_digits
    if signed_length <= hexadecimal_digits then
      negative = _x2d_sign_bit(hexadecimal, hexadecimal_length, skip_digits)
  end

  result = _x2d_hex_to_decimal(hexadecimal, hexadecimal_length, skip_digits, negative)
  magnitude_digits = .int
  assembler strlen magnitude_digits,result
  if negative then magnitude_digits = magnitude_digits - 1

  numeric_digits = .int
  assembler getnumdgts numeric_digits
  if magnitude_digits > numeric_digits then do
    call rexxclassicbif_set_error(context_ref, "40.35", 1, context.argumentText(1), "")
    return .RexxValue("")
  end
  return .RexxValue(result)

/* Return the high bit of the selected rightmost hexadecimal field. */
_x2d_sign_bit: procedure = .int
  arg hexadecimal = .string, hexadecimal_length = .int, skip_digits = .int
  codepoint = .int
  blank_character = 32
  digit_index = 0
  do index = 0 to hexadecimal_length - 1
    assembler strchar codepoint,hexadecimal,index
    if codepoint = blank_character then iterate
    if digit_index = skip_digits then do
      if codepoint <= 57 then return codepoint >= 56
      return 1
    end
    digit_index = digit_index + 1
  end
  return 0

/* Parse a validated non-negative whole length, capped before native narrowing. */
_x2d_bounded_length: procedure = .int
  arg length_text = .string, cap = .int
  text_length = .int
  cap_length = .int
  codepoint = .int
  cap_codepoint = .int
  start = 0
  cap_text = ""
  cap_text = cap
  assembler strlen text_length,length_text
  assembler strlen cap_length,cap_text
  if text_length > 0 then do
    assembler strchar codepoint,length_text,start
    if codepoint = 43 then start = 1
  end
  do while start < text_length
    assembler strchar codepoint,length_text,start
    if codepoint <> 48 then leave
    start = start + 1
  end
  significant_length = text_length - start
  if significant_length = 0 then return 0
  if significant_length > cap_length then return cap
  if significant_length = cap_length then do
    do offset = 0 to significant_length - 1
      index = start + offset
      assembler strchar codepoint,length_text,index
      assembler strchar cap_codepoint,cap_text,offset
      if codepoint > cap_codepoint then return cap
      if codepoint < cap_codepoint then leave
    end
  end
  result = 0
  do index = start to text_length - 1
    assembler strchar codepoint,length_text,index
    result = result * 10 + codepoint - 48
  end
  return result

/* Convert the selected field through mutable little-endian base-1e9 limbs. */
_x2d_hex_to_decimal: procedure = .string
  arg hexadecimal = .string, hexadecimal_length = .int, skip_digits = .int, negative = .int
  limbs = .int[]
  limb_count = 1
  limbs[1] = 0
  codepoint = .int
  nibble = .int
  carry = .int
  combined = .int
  quotient = .int
  remainder = .int
  digit_index = 0
  blank_character = 32
  zero_character = 48

  do index = 0 to hexadecimal_length - 1
    assembler strchar codepoint,hexadecimal,index
    if codepoint = blank_character then iterate
    if digit_index < skip_digits then do
      digit_index = digit_index + 1
      iterate
    end
    if codepoint <= 57 then nibble = codepoint - 48
    else if codepoint <= 70 then nibble = codepoint - 55
    else nibble = codepoint - 87
    if negative then nibble = 15 - nibble

    carry = nibble
    do limb_index = 1 to limb_count
      combined = limbs[limb_index] * 16 + carry
      assembler idiv quotient,combined,1000000000
      assembler imod remainder,combined,1000000000
      limbs[limb_index] = remainder
      carry = quotient
    end
    if carry > 0 then do
      limb_count = limb_count + 1
      limbs[limb_count] = carry
    end
    digit_index = digit_index + 1
  end

  if negative then do
    carry = 1
    limb_index = 1
    do while carry > 0 & limb_index <= limb_count
      combined = limbs[limb_index] + carry
      if combined >= 1000000000 then do
        limbs[limb_index] = combined - 1000000000
        carry = 1
      end
      else do
        limbs[limb_index] = combined
        carry = 0
      end
      limb_index = limb_index + 1
    end
    if carry > 0 then do
      limb_count = limb_count + 1
      limbs[limb_count] = carry
    end
  end

  result = ""
  result = limbs[limb_count]
  do limb_index = limb_count - 1 to 1 by -1
    segment = ""
    segment = limbs[limb_index]
    segment_length = .int
    padding_count = .int
    assembler strlen segment_length,segment
    padding_count = 9 - segment_length
    if padding_count > 0 then assembler padstr result,zero_character,padding_count
    assembler append result,segment
  end
  if negative then result = "-" || result
  return result
