options levelb comments_dash numeric_classic
namespace rexxclassicbifreverse expose rexxclassicbif_reverse
import rexxclassicbifs
import rexxclassiccharacterops
import rexxvalue

/**
 * Reverse a Classic value by configured BYTE or UTF8 character units.
 *
 * @bif REVERSE
 * @signature REVERSE(string)
 * @checkargs rANY
 * @sandbox pure
 * @return reversed string as a RexxValue
 */
rexxclassicbif_reverse: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY") = 0 then return .RexxValue("")

  config = context.characterConfig()
  if config.isByteProfile() then do
    bytes = context.argument(1).asBinary()
    result_bytes = rexxclassic_reverse_bytes(bytes)
    return .RexxValue.fromBinary(result_bytes)
  end
  text = context.argumentText(1)
  result_text = rexxclassic_reverse_text(text)
  return .RexxValue(result_text)
