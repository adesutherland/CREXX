options levelb comments_dash numeric_classic
namespace rexxclassicbifwordlength expose rexxclassicbif_wordlength
import rexxclassicbifs
import rexxvalue

/**
 * Return the Classic character length of one word.
 *
 * @bif WORDLENGTH
 * @signature WORDLENGTH(string, n)
 * @checkargs rANY rWHOLE>0
 * @sandbox pure
 * @return word character length, or zero, as a RexxValue
 */
rexxclassicbif_wordlength: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY rWHOLE>0") = 0 then return .RexxValue("")

  string = context.argumentText(1)
  wordnum = .int
  wordnum = context.argumentText(2) + 0
  string_length = .int
  assembler strlen string_length,string
  if string_length = 0 then return .RexxValue("0")

  scan = 0
  current_word = 0
  word_start = 0
  word_end = 0
  do while scan < string_length
    assembler fndnblnk word_start,string,scan
    if word_start < 0 then return .RexxValue("0")
    current_word = current_word + 1
    assembler fndblnk word_end,string,word_start
    if current_word = wordnum then do
      if word_end < 0 then word_end = string_length
      return .RexxValue((word_end - word_start) || "")
    end
    if word_end < 0 then return .RexxValue("0")
    scan = word_end
  end
  return .RexxValue("0")
