options levelb comments_dash numeric_classic
namespace rexxclassicbifdatatype expose rexxclassicbif_datatype
import rexxclassicbifs
import rexxclassicdatatype
import rexxvalue

/**
 * Classify a value or test one strict Classic DATATYPE option.
 *
 * @bif DATATYPE
 * @signature DATATYPE(string [,type])
 * @checkargs rANY oABLMNSUWX
 * @sandbox pure
 * @return NUM or CHAR without type, otherwise 1 or 0
 */
rexxclassicbif_datatype: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref,"rANY oABLMNSUWX") = 0 then return .RexxValue("")
  value = context.argument(1)
  config = context.characterConfig()
  if \context.argumentExists(2) then
    return .RexxValue(rexxclassic_datatype_classify(value,config))
  option = context.argumentText(2)
  if rexxclassic_datatype_test(value,option,config) then return .RexxValue("1")
  return .RexxValue("0")
