options levelb comments_dash numeric_classic
namespace rexxclassicbifb2x expose rexxclassicbif_b2x
import rexxclassicbifs
import rexxvalue

/**
 * Convert one Classic binary-string argument to hexadecimal.
 *
 * @bif B2X
 * @signature B2X(binary)
 * @checkargs rBIN
 * @sandbox pure
 * @return uppercase hexadecimal text as a RexxValue
 */
rexxclassicbif_b2x: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rBIN") = 0 then return .RexxValue("")

  binary = context.argumentText(1)
  table = "0123456789ABCDEF"
  result = ""
  binary_length = .int
  bit_count = 0
  group_size = .int
  group_count = 0
  value = 0
  codepoint = .int
  hexadecimal = .int
  blank_character = 32
  zero_character = 48

  assembler strlen binary_length,binary
  if binary_length = 0 then return .RexxValue(result)

  do i = 0 to binary_length - 1
    assembler strchar codepoint,binary,i
    if codepoint <> blank_character then bit_count = bit_count + 1
  end
  group_size = bit_count // 4
  if group_size = 0 then group_size = 4

  do i = 0 to binary_length - 1
    assembler strchar codepoint,binary,i
    if codepoint = blank_character then iterate
    value = value * 2 + codepoint - zero_character
    group_count = group_count + 1
    if group_count = group_size then do
      assembler strchar hexadecimal,table,value
      assembler appendchar result,hexadecimal
      group_size = 4
      group_count = 0
      value = 0
    end
  end
  return .RexxValue(result)
