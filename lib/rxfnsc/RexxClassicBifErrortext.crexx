options levelb comments_dash numeric_classic
namespace rexxclassicbiferrortext expose rexxclassicbif_errortext
import rexxclassicbifs
import rexxclassicdiagnostic
import rexxvalue

/**
 * Return an unexpanded message from the shared standard diagnostic catalog.
 * @bif ERRORTEXT
 * @signature ERRORTEXT(code [,option])
 * @checkargs r0_90 oSN
 * @param context_ref BIF operands and diagnostic context
 * @return template with Classic place-markers; empty for an undefined code
 * @error 40.17 code is outside the Classic message range
 * @sandbox catalog only; N falls back to the shipped English catalog
 */
rexxclassicbif_errortext: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref,"r0_90 oSN") = 0 then return .RexxValue("")
  code = context.argumentText(1)
  if code = "0" then return .RexxValue("")
  text = rexxclassicdiagnostic_template("RXC-LC-" || code)
  text = changestr("{",text,"<")
  text = changestr("}",text,">")
  return .RexxValue(text)
