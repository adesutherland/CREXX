options levelb comments_dash numeric_classic
namespace rexxclassicencoding expose rexxclassic_bytes_to_hex rexxclassic_hex_to_bytes rexxclassic_bytes_are_utf8 rexxclassic_value_from_bytes
import rexxclassicconfig
import rexxvalue

/** Convert exact octets to two uppercase hexadecimal digits per byte. */
rexxclassic_bytes_to_hex: procedure = .string
  arg bytes = .binary
  table = "0123456789ABCDEF"
  result = ""
  byte_length = .int
  byte = .int
  high = .int
  low = .int
  codepoint = .int
  assembler blen byte_length,bytes
  do index = 0 to byte_length - 1
    assembler getbyte byte,bytes,index
    assembler idiv high,byte,16
    assembler imod low,byte,16
    assembler strchar codepoint,table,high
    assembler appendchar result,codepoint
    assembler strchar codepoint,table,low
    assembler appendchar result,codepoint
  end
  return result

/** Decode CheckArgs-validated hexadecimal text to exact octets. */
rexxclassic_hex_to_bytes: procedure = .binary
  arg hexadecimal = .string
  text_length = .int
  digit_count = 0
  output_length = .int
  codepoint = .int
  nibble = .int
  high_nibble = -1
  byte = .int
  output_index = 0
  result = .binary
  assembler strlen text_length,hexadecimal
  do index = 0 to text_length - 1
    assembler strchar codepoint,hexadecimal,index
    if codepoint <> 32 then digit_count = digit_count + 1
  end
  if digit_count = 0 then return result
  output_length = (digit_count + 1) % 2
  assembler bresize result,output_length
  assembler imod nibble,digit_count,2
  if nibble <> 0 then high_nibble = 0
  do index = .int(0) to text_length - 1
    assembler strchar codepoint,hexadecimal,index
    if codepoint = 32 then iterate
    if codepoint <= 57 then nibble = codepoint - 48
    else if codepoint <= 70 then nibble = codepoint - 55
    else nibble = codepoint - 87
    if high_nibble < 0 then high_nibble = nibble
    else do
      byte = high_nibble * 16 + nibble
      assembler setbyte result,output_index,byte
      output_index = output_index + 1
      high_nibble = -1
    end
  end
  return result

/** Validate exact octets as canonical UTF-8 without raising a signal. */
rexxclassic_bytes_are_utf8: procedure = .boolean
  arg bytes = .binary
  byte_length = .int
  first = .int
  second = .int
  third = .int
  fourth = .int
  assembler blen byte_length,bytes
  index = 0
  do while index < byte_length
    assembler getbyte first,bytes,index
    if first <= 127 then do
      index = index + 1
      iterate
    end

    if first >= 194 & first <= 223 then do
      if index + 1 >= byte_length then return 0
      next_index = index + 1
      assembler getbyte second,bytes,next_index
      if second < 128 | second > 191 then return 0
      index = index + 2
      iterate
    end

    if first >= 224 & first <= 239 then do
      if index + 2 >= byte_length then return 0
      next_index = .int
      next_index = index + 1
      assembler getbyte second,bytes,next_index
      next_index = index + 2
      assembler getbyte third,bytes,next_index
      if third < 128 | third > 191 then return 0
      if first = 224 then do
        if second < 160 | second > 191 then return 0
      end
      else if first = 237 then do
        if second < 128 | second > 159 then return 0
      end
      else if second < 128 | second > 191 then return 0
      index = index + 3
      iterate
    end

    if first >= 240 & first <= 244 then do
      if index + 3 >= byte_length then return 0
      next_index = .int
      next_index = index + 1
      assembler getbyte second,bytes,next_index
      next_index = index + 2
      assembler getbyte third,bytes,next_index
      next_index = index + 3
      assembler getbyte fourth,bytes,next_index
      if third < 128 | third > 191 | fourth < 128 | fourth > 191 then return 0
      if first = 240 then do
        if second < 144 | second > 191 then return 0
      end
      else if first = 244 then do
        if second < 128 | second > 143 then return 0
      end
      else if second < 128 | second > 191 then return 0
      index = index + 4
      iterate
    end
    return 0
  end
  return 1

/** Construct the configured Level C value for exact output octets. */
rexxclassic_value_from_bytes: procedure = .RexxValue
  arg bytes = .binary, config = .RexxClassicConfig
  if config.isUtf8Profile() & rexxclassic_bytes_are_utf8(bytes) then
    return .RexxValue.fromBinaryText(bytes)
  return .RexxValue.fromBinary(bytes)
