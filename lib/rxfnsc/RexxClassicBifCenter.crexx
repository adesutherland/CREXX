options levelb comments_dash numeric_classic
namespace rexxclassicbifcenter expose rexxclassicbif_center rexxclassicbif_centre
import rexxclassicbifs
import rexxvalue

/**
 * Center or centrally truncate one Classic string.
 *
 * @bif CENTER
 * @signature CENTER(string, length [,pad])
 * @checkargs rANY rWHOLE>=0 oPAD
 * @sandbox pure
 * @return exact-width centered string as a RexxValue
 */
rexxclassicbif_center: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY rWHOLE>=0 oPAD") = 0 then return .RexxValue("")

  string = context.argumentText(1)
  width = .int
  width = context.argumentText(2) + 0
  pad = " "
  if context.argumentExists(3) then pad = context.argumentText(3)

  string_length = .int
  difference = .int
  half = .int
  start = .int
  pad_character = .int
  pad_index = 0
  padding = ""
  result = ""

  assembler strlen string_length,string
  if width = string_length then return .RexxValue(string)

  if width < string_length then do
    difference = string_length - width
    start = difference
    assembler idiv start,start,2
    assembler SETSTRPOS string,start
    assembler substring result,string,width
    return .RexxValue(result)
  end

  difference = width - string_length
  half = difference
  assembler idiv half,half,2
  assembler strchar pad_character,pad,pad_index
  assembler padstr padding,pad_character,half
  assembler scopy result,padding
  assembler append result,string
  assembler append result,padding
  if difference - half > half then assembler appendchar result,pad_character
  return .RexxValue(result)

/**
 * British-spelling direct alias for the Classic CENTER BIF.
 *
 * @bif CENTRE
 * @signature CENTRE(string, length [,pad])
 * @checkargs rANY rWHOLE>=0 oPAD
 * @sandbox pure
 * @return the exact-width result from the shared CENTER implementation
 */
rexxclassicbif_centre: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  return rexxclassicbif_center(context_ref)
