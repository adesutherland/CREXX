options levelb comments_dash numeric_classic
namespace rexxclassicconfig expose RexxClassicConfig RexxExternalValuePool RexxExternalValueResult RexxInMemoryExternalValuePool
import rxfnsb
import rexxvalue
import rexxclassicstream
import rexxclassichostprotocol
import _rxsysb

/** Result of one external VALUE pool lookup. */
RexxExternalValueResult: class
  result_found = .boolean
  result_value = .RexxValue

  *: factory
    arg found = .boolean, value = .RexxValue
    result_found = found
    result_value = value
    return

  found: method = .boolean
    return result_found

  value: method = .RexxValue
    return result_value

/** Host/configuration adapter used by the external form of VALUE. */
RexxExternalValuePool: interface
  get: method = .RexxExternalValueResult
    arg subject = .string

  set: method = .boolean
    arg subject = .string, value = .RexxValue

/** Exact-subject in-memory adapter for harnesses and embedded evaluators. */
RexxInMemoryExternalValuePool: class implements .RexxExternalValuePool
  subjects = .string[]
  values = .RexxValue[]
  subject_count = .int

  *: factory
    subject_count = 0
    return

  /** Seed or replace a subject; ordinary VALUE assignment cannot create it. */
  put: method = .void
    arg subject = .string, value = .RexxValue
    slot = find(subject)
    if slot = 0 then do
      subject_count = subject_count + 1
      slot = subject_count
      subjects[slot] = subject
    end
    values[slot] = value
    return

  get: method = .RexxExternalValueResult
    arg subject = .string
    slot = find(subject)
    if slot = 0 then return .RexxExternalValueResult(0,.RexxValue(""))
    return .RexxExternalValueResult(1,values[slot])

  set: method = .boolean
    arg subject = .string, value = .RexxValue
    slot = find(subject)
    if slot = 0 then return 0
    values[slot] = value
    return 1

  contains: method = .boolean
    arg subject = .string
    return find(subject) > 0

  find: method = .int
    arg subject = .string
    do i = 1 to subject_count
      if subjects[i] == subject then return i
    end
    return 0

/**
 * Coded-character configuration shared by direct Classic BIF consumers.
 *
 * Direct consumers default to BYTE for existing binary calls. The compiled
 * Level C setup selects UTF8 text, whose byte-valued BIFs use Latin-1
 * ordinals. RexxValue flags still describe the held representation.
 *
 * @docType runtime-class
 * @unicodeVersion 17.0.0
 */
RexxClassicConfig: class
  profile_name = .string
  byte_other_blanks = .binary
  text_other_blanks = .string
  byte_extra_lowercase = .binary
  byte_extra_uppercase = .binary
  byte_extra_digits = .binary
  text_extra_lowercase = .string
  text_extra_uppercase = .string
  text_extra_digits = .string
  exponent_digit_limit = .int
  random_state = .RexxRandomState
  external_pool_names = .string[]
  external_pools = .RexxExternalValuePool[]
  external_pool_count = .int
  source_lines = .string[]
  source_line_count = .int
  stream_names = .string[]
  stream_directions = .int[]
  streams = .RexxClassicStream[]
  stream_count = .int
  default_stream_direction = .int
  zz_host_names = .string[]
  zz_host_hooks = .RexxClassicHostHook[]
  zz_host_traps = .RexxClassicHostHook[]
  zz_host_count = .int
  zz_host_access = .RexxClassicHostAccess
  zz_host_context = .object
  zz_host_queue = .string
  zz_host_owned_streams = .RexxClassicStream[]
  zz_host_owned_count = .int
  zz_host_source = .string

  *: factory
    arg requested_profile = "BYTE"
    profile_name = "BYTE"
    byte_other_blanks = "" as .binary
    text_other_blanks = ""
    byte_extra_lowercase = "" as .binary
    byte_extra_uppercase = "" as .binary
    byte_extra_digits = "" as .binary
    text_extra_lowercase = ""
    text_extra_uppercase = ""
    text_extra_digits = ""
    exponent_digit_limit = 9
    random_state = .RexxRandomState()
    external_pool_count = 0
    source_line_count = 0
    stream_count = 0
    default_stream_direction = 1
    zz_host_count = 0
    zz_host_queue = ""
    zz_host_owned_count = 0
    zz_host_source = ""
    disabled_access = .RexxClassicHostAccess
    zz_host_access = disabled_access
    empty_context = .object
    zz_host_context = empty_context
    if requested_profile == "BYTE" | requested_profile == "UTF8" then
      profile_name = requested_profile
    else assembler signal "INVALID_ARGUMENTS", "Character profile must be BYTE or UTF8"
    return

  /** Register/replace an execution-owned configuration hook or its trap.
   * An uninitialized hook removes the selected registration. Traps run first;
   * absent/empty trap results fall through, configuration empty results do not.
   * @param operation stable uppercase service identity such as SAY or LINEIN
   * @param hook explicit host provider, with no implicit typed-call pool grant
   * @param trap true selects the override registration
   */
  registerHostHook: method = .void
    arg operation = .string, hook = .RexxClassicHostHook, trap = 0
    disabled_hook = .RexxClassicHostHook
    operation = upper(operation)
    if operation = "" then do
      assembler signal "INVALID_ARGUMENTS","Classic host hook identity is empty"
      return
    end
    slot = hostHookSlot(operation)
    if slot = 0 then do
      zz_host_count = zz_host_count + 1
      slot = zz_host_count
      zz_host_names[slot] = operation
      zz_host_traps[slot] = disabled_hook
      zz_host_hooks[slot] = disabled_hook
    end
    if trap then zz_host_traps[slot] = hook
    else zz_host_hooks[slot] = hook
    return

  hostHookSlot: method = .int
    arg operation = .string
    do index = 1 to zz_host_count
      if zz_host_names[index] == operation then return index
    end
    return 0

  /** Internal invocation binding. The provider borrows a wrapper-owned scope. */
  bindHostAccess: method = .void
    arg access = .RexxClassicHostAccess
    zz_host_access = access
    return

  clearHostAccess: method = .void
    disabled = .RexxClassicHostAccess
    zz_host_access = disabled
    current = .object
    zz_host_context = current
    return

  /** Refresh the canonical caller after PROCEDURE without granting capability. */
  bindHostContext: method = .void
    arg current = .object
    if initialized(zz_host_access) then zz_host_context = zz_host_access.contextSnapshot(current)
    return

  openHostCallback: method = .RexxClassicHostPool
    arg operation = "", routine = "", function = 0
    if initialized(zz_host_access) then do
      if initialized(zz_host_context) then return zz_host_access.open(operation,routine,function,zz_host_context)
      return zz_host_access.open(operation,routine,function)
    end
    return .RexxClassicHostDisabledPool()

  closeHostCallback: method = .void
    arg window = .RexxClassicHostPool
    if window.token() = 0 then return
    if initialized(zz_host_access) then call zz_host_access.close(window)
    return

  /** One dispatcher owns trap/config replacement and exact callback lifetime. */
  invokeHost: method = .RexxClassicHostHookResult
    arg operation = .string, values = .RexxValue[], presence = .int[], routine = "", function = 0
    operation = upper(operation)
    slot = hostHookSlot(operation)
    response = .RexxClassicHostHookResult()
    if slot = 0 then return response
    previous_context = zz_host_context
    window = openHostCallback(operation,routine,function)
    hook = .RexxClassicHostHook
    selected = 0
    do
      if slot <= zz_host_traps[0] then do
        assembler linkattr1 hook,zz_host_traps,slot
        if initialized(hook) then do
          response = hook.invoke(operation,values,presence,window)
          if response.hasCondition() | response.hasCommand() then selected = 1
          if response.handled() & response.hasValue() then do
            returned = response.value()
            if length(returned.asString()) > 0 then selected = 1
          end
        end
        assembler unlink hook
      end
      if \selected then do
        response = .RexxClassicHostHookResult()
        if slot <= zz_host_hooks[0] then do
          assembler linkattr1 hook,zz_host_hooks,slot
          if initialized(hook) then response = hook.invoke(operation,values,presence,window)
          assembler unlink hook
        end
      end
    on signal failure,error,division_by_zero,conversion_error,invalid_arguments,out_of_range,unicode_error,reference_invalid,object_not_initialized,rxbin_corruption,unknown_instruction,function_not_found,not_implemented,invalid_signal_code,notready,quit,term,posix_int,channel_error,task_failure,cancel,classic_syntax,classic_condition,other as problem
      zz_host_context = previous_context
      call closeHostCallback(window)
      call rxfnsb..signalrelay(problem)
      return .RexxClassicHostHookResult()
    end
    zz_host_context = previous_context
    call closeHostCallback(window)
    return response

  /**
   * Explicit configured fallback after compiler local/BIF/selected-provider
   * resolution. Actual arrays remain unchanged; ROUTINE and INVOCATION facts
   * belong to the temporary window. No source, PATH or loader search occurs.
   * A handled absent result differs from an unhandled lookup. Typed hook
   * failures are relayed with their original payload and origin.
   */
  externalRoutine: method = .RexxClassicHostHookResult
    arg name = .string, function = .boolean, values = .RexxValue[], presence = .int[]
    response = invokeHost("EXTERNALROUTINE",values,presence,name,function as .int)
    call checkHostResponse(response)
    if response.hasCommand() then
      assembler signal "INVALID_ARGUMENTS","An external routine hook cannot return a command response"
    return response

  checkHostResponse: method = .void
    arg response = .RexxClassicHostHookResult
    if response.hasCondition() then call rxfnsb..signalrelay(response.condition())
    return

  bindHostQueue: method = .void
    arg name = .string
    zz_host_queue = name
    return

  setHostSource: method = .void
    arg source = .string
    zz_host_source = source
    return

  /** Select the configured queue only for the duration of one shared operation. */
  hostQueueEnter: method = .string
    previous = ""
    if length(zz_host_queue) > 0 then do
      previous = rxqueue("QUERY")
      result = rxqueue("SET",zz_host_queue)
      if result <> "0" then assembler signal "CLASSIC_SYNTAX","RXC-LC-48.1: Configured Classic queue is unavailable"
    end
    return previous

  hostQueueLeave: method = .void
    arg previous = .string
    if length(previous) > 0 then result = rxqueue("SET",previous)
    return

  /** Open a host-selected default stream through the existing codec/transport. */
  configureDefaultStream: method = .void
    arg direction = .int, name = .string, encoding = .string, replacing = .int
    if direction < 1 | direction > 3 then do
      assembler signal "INVALID_ARGUMENTS","Invalid Classic default stream direction"
      return
    end
    /* An empty error name means the inherited stderr path. The existing
     * empty-name transport selects only stdin/stdout; never alias it to stderr. */
    if direction = 3 & length(name) = 0 then return
    if length(encoding) > 0 then do
      encoding = rexxclassic_stream_encoding(encoding)
      if encoding = "UNSUPPORTED" then do
        assembler signal "INVALID_ARGUMENTS","Unsupported Classic default stream encoding"
        return
      end
    end
    mode = "WRITE"
    if direction = 1 then mode = "READ"
    stream = .RexxClassicStream(name,mode,encoding,replacing)
    if \stream.ready() then do
      assembler signal "NOTREADY","Configured Classic default stream is unavailable"
      return
    end
    call storeStream("",direction,stream)
    zz_host_owned_count = zz_host_owned_count + 1
    zz_host_owned_streams[zz_host_owned_count] = stream
    return

  /** A supplied configuration lends its existing handles to a fresh root. */
  resetHostOwnership: method = .void
    zz_host_owned_count = 0
    return

  closeHostStreams: method = .int
    failed = 0
    do index = 1 to zz_host_owned_count
      stream = .RexxClassicStream
      assembler linkattr1 stream,zz_host_owned_streams,index
      if \stream.closed() then do
        status = stream.close()
        if status <> 0 then failed = 1
      end
      assembler unlink stream
    end
    zz_host_owned_count = 0
    return failed

  /** SAY remains text with exactly one newline, through the selected output. */
  sayText: method = .void
    arg text = .string
    values = .RexxValue[]
    presence = .int[]
    values[1] = .RexxValue(text)
    presence[1] = 1
    response = invokeHost("SAY",values,presence)
    call checkHostResponse(response)
    if response.handled() then return
    slot = streamSlot("",2)
    if slot > 0 then do
      stream = .RexxClassicStream
      assembler linkattr1 stream,streams,slot
      status = stream.writeLine(text,-1)
      if status <> 0 then assembler signal "NOTREADY","Classic configured output failed"
      assembler unlink stream
      return
    end
    say text
    return

  /** Locate execution-owned stream state. Empty input/output are independent. */
  streamSlot: method = .int
    arg name = .string, direction = .int
    if name <> "" then direction = 0
    do index = 1 to stream_count
      if stream_names[index] == name & stream_directions[index] = direction then return index
    end
    return 0

  stream: method = .RexxClassicStream
    arg slot = .int
    return streams[slot]

  /** Borrow a configured default as raw process bytes; absent means inherited. */
  processEndpoint: method = .addressredirect
    arg direction = .int
    slot = streamSlot("",direction)
    if slot = 0 then return .addressredirect.none()
    provider = .ClassicProcessBytes(reference self,slot)
    if direction = 1 then return .addressredirect.input_stream(provider)
    return .addressredirect.output_stream(provider)

  processInput: method = .binary
    arg slot = .int
    stream = .RexxClassicStream
    assembler linkattr1 stream,streams,slot
    return stream.processInput()

  processOutput: method = .void
    arg slot = .int, bytes = .binary
    stream = .RexxClassicStream
    assembler linkattr1 stream,streams,slot
    call stream.processOutput(bytes)
    return

  /** STREAM on the empty name addresses the last explicitly opened direction. */
  streamCommandDirection: method = .int
    return default_stream_direction

  setStreamCommandDirection: method = .void
    arg direction = .int
    default_stream_direction = direction
    return

  storeStream: method = .void
    arg name = .string, direction = .int, stream = .RexxClassicStream
    if name <> "" then direction = 0
    slot = streamSlot(name,direction)
    if slot = 0 then do
      stream_count = stream_count + 1
      slot = stream_count
      stream_names[slot] = name
      stream_directions[slot] = direction
    end
    streams[slot] = stream
    return

  useByteProfile: method = .void
    profile_name = "BYTE"
    return

  useUtf8Profile: method = .void
    profile_name = "UTF8"
    return

  setProfile: method = .void
    arg profile = .string
    if profile == "BYTE" then do
      profile_name = "BYTE"
      return
    end
    if profile == "UTF8" then do
      profile_name = "UTF8"
      return
    end
    assembler signal "INVALID_ARGUMENTS", "Level C character profile must be BYTE or UTF8"

  profile: method = .string
    return profile_name

  /**
   * Accept one evaluated Classic OPTIONS value.
   *
   * Source language, comment and numeric switches are consumed before parsing.
   * BYTE and UTF8 currently define no runtime option words; all supplied
   * words, including host-specific DBCS words, are therefore ignored without
   * decoding or scanning. Keep this processor boundary so a future recognized
   * word has one owner.
   * @param words Evaluated OPTIONS result with its exact byte length
   */
  applyOptions: method = .void
    arg words = .RexxValue
    return

  /** Consume one text value from the selected data queue or default input. */
  pullText: method = .string
    values = .RexxValue[]
    presence = .int[]
    response = invokeHost("PULL",values,presence)
    call checkHostResponse(response)
    if response.handled() then return response.value().asString()
    previous = hostQueueEnter()
    count = queued()
    text = ""
    if count > 0 then text = pull()
    call hostQueueLeave(previous)
    if count > 0 then return text
    return lineinText()

  /** Read one line directly from default input, bypassing queued entries. */
  lineinText: method = .string
    values = .RexxValue[]
    presence = .int[]
    response = invokeHost("LINEIN",values,presence)
    call checkHostResponse(response)
    if response.handled() then return response.value().asString()
    slot = streamSlot("",1)
    if slot > 0 then do
      stream = .RexxClassicStream
      assembler linkattr1 stream,streams,slot
      text = stream.readLine(-1,1)
      error = stream.error()
      eof = stream.readEof()
      assembler unlink stream
      if error <> "" & \eof then assembler signal "NOTREADY",error
      return text
    end
    return linein()

  /** Replace the invocation's retained source without changing other services.
   * The configuration owns its vector; a detached host configuration leaves
   * the request template unchanged. Existing internal calls share this owner.
   */
  clearSourceLines: method = .void
    empty_lines = .string[]
    source_lines = empty_lines
    source_line_count = 0
    return

  /** Retain one original source line supplied by the compiler, without its EOL. */
  appendSourceLine: method = .void
    arg text = .string
    source_line_count = source_line_count + 1
    source_lines[source_line_count] = text
    return

  /** @return available source lines; zero when source is unavailable. */
  sourceLineCount: method = .int
    return source_line_count

  /** @return an original source line; BIF validation owns the index bounds. */
  sourceLine: method = .string
    arg index = .int
    if index < 1 | index > source_line_count then return ""
    return source_lines[index]

  /** Describe the running VM for PARSE VERSION. */
  versionText: method = .string
    return version()

  /**
   * Replace SOURCEINFO's default entry mode with the Classic programme root
   * mode while preserving the metadata-derived source path, including spaces.
   * @param info direct caller SOURCEINFO result
   * @param mode COMMAND, FUNCTION or SUBROUTINE from the activation root
   */
  sourceText: method = .string
    arg info = .string, mode = .string
    system_name = word(info, 1)
    /* SOURCEINFO emits "SYSTEM COMMAND filename"; preserve filename blanks. */
    source_name = substr(info, length(system_name) + 10)
    if length(zz_host_source) > 0 then source_name = zz_host_source
    return system_name || " " || mode || " " || source_name

  /** Insert one text value at the front of the selected data queue. */
  pushText: method = .void
    arg text = .string
    values = .RexxValue[]
    presence = .int[]
    values[1] = .RexxValue(text)
    presence[1] = 1
    response = invokeHost("PUSH",values,presence)
    call checkHostResponse(response)
    if response.handled() then return
    previous = hostQueueEnter()
    call push text
    call hostQueueLeave(previous)
    return

  /** Append one text value to the selected data queue. */
  queueText: method = .void
    arg text = .string
    values = .RexxValue[]
    presence = .int[]
    values[1] = .RexxValue(text)
    presence[1] = 1
    response = invokeHost("QUEUE",values,presence)
    call checkHostResponse(response)
    if response.handled() then return
    previous = hostQueueEnter()
    call queue text
    call hostQueueLeave(previous)
    return

  /** Count entries in the selected execution-local queue without consuming input. */
  queuedCount: method = .int
    values = .RexxValue[]
    presence = .int[]
    response = invokeHost("QUEUED",values,presence)
    call checkHostResponse(response)
    if response.handled() then return response.value().asInt()
    previous = hostQueueEnter()
    count = queued()
    call hostQueueLeave(previous)
    return count

  isByteProfile: method = .boolean
    return profile_name == "BYTE"

  isUtf8Profile: method = .boolean
    return profile_name == "UTF8"

  setByteOtherBlanks: method = .void
    arg blanks = .binary
    byte_other_blanks = blanks
    return

  byteOtherBlanks: method = .binary
    return byte_other_blanks

  setTextOtherBlanks: method = .void
    arg blanks = .string
    text_other_blanks = blanks
    return

  textOtherBlanks: method = .string
    return text_other_blanks

  /** Set paired BYTE-profile extra lowercase and uppercase characters. */
  setByteDatatypeLetters: method = .void
    arg lowercase = .binary, uppercase = .binary
    lower_length = .int
    upper_length = .int
    assembler blen lower_length,lowercase
    assembler blen upper_length,uppercase
    if lower_length <> upper_length then
      assembler signal "INVALID_ARGUMENTS", "Level C BYTE extra letter tables must have equal lengths"
    byte_extra_lowercase = lowercase
    byte_extra_uppercase = uppercase
    return

  byteDatatypeLowercase: method = .binary
    return byte_extra_lowercase

  byteDatatypeUppercase: method = .binary
    return byte_extra_uppercase

  /** Set BYTE-profile extra digit families in consecutive 0-through-9 order. */
  setByteDatatypeDigits: method = .void
    arg digits = .binary
    digit_length = .int
    assembler blen digit_length,digits
    if digit_length // 10 <> 0 then
      assembler signal "INVALID_ARGUMENTS", "Level C BYTE extra digit table length must be a multiple of 10"
    byte_extra_digits = digits
    return

  byteDatatypeDigits: method = .binary
    return byte_extra_digits

  /** Set paired UTF8-profile extra lowercase and uppercase codepoints. */
  setTextDatatypeLetters: method = .void
    arg lowercase = .string, uppercase = .string
    lower_length = .int
    upper_length = .int
    assembler strlen lower_length,lowercase
    assembler strlen upper_length,uppercase
    if lower_length <> upper_length then
      assembler signal "INVALID_ARGUMENTS", "Level C UTF8 extra letter tables must have equal lengths"
    text_extra_lowercase = lowercase
    text_extra_uppercase = uppercase
    return

  textDatatypeLowercase: method = .string
    return text_extra_lowercase

  textDatatypeUppercase: method = .string
    return text_extra_uppercase

  /** Set UTF8-profile extra digit families in consecutive 0-through-9 order. */
  setTextDatatypeDigits: method = .void
    arg digits = .string
    digit_length = .int
    assembler strlen digit_length,digits
    if digit_length // 10 <> 0 then
      assembler signal "INVALID_ARGUMENTS", "Level C UTF8 extra digit table length must be a multiple of 10"
    text_extra_digits = digits
    return

  textDatatypeDigits: method = .string
    return text_extra_digits

  /** Set the maximum accepted exponent digit count for Classic numbers. */
  setExponentDigitLimit: method = .void
    arg limit = .int
    if limit < 1 then
      assembler signal "INVALID_ARGUMENTS", "Level C exponent digit limit must be positive"
    exponent_digit_limit = limit
    return

  exponentDigitLimit: method = .int
    return exponent_digit_limit

  unicodeVersion: method = .string
    return "17.0.0"

  /** Reset the configuration-scoped RANDOM service. */
  seedRandom: method = .void
    arg seed = .int
    values = .RexxValue[]
    presence = .int[]
    values[1] = .RexxValue.fromInt(seed)
    presence[1] = 1
    response = invokeHost("RANDOMSEED",values,presence)
    call checkHostResponse(response)
    if response.handled() then return
    call random_state.seed(seed)
    return

  /** Return an unbiased configuration-scoped value from 0 through span-1. */
  nextRandom: method = .int
    arg span = .int
    values = .RexxValue[]
    presence = .int[]
    values[1] = .RexxValue.fromInt(span)
    presence[1] = 1
    response = invokeHost("RANDOM",values,presence)
    call checkHostResponse(response)
    if response.handled() then do
      value = response.value().asInt()
      if value < 0 | value >= span then assembler signal "INVALID_ARGUMENTS","Configured Classic random result is outside its bound"
      return value
    end
    return random_state.bounded(span)

  /** Register or replace one case-insensitive external VALUE pool name. */
  registerExternalPool: method = .void
    arg name = .string, pool = .RexxExternalValuePool
    normalized = normalizeExternalPoolName(name)
    if normalized = "" then
      assembler signal "INVALID_ARGUMENTS", "external VALUE pool name must not be blank"
    slot = findExternalPool(normalized)
    if slot = 0 then do
      external_pool_count = external_pool_count + 1
      slot = external_pool_count
      external_pool_names[slot] = normalized
    end
    /* The registry owns the adapter copy; accessors link to it before calls. */
    external_pools[slot] = pool
    return

  hasExternalPool: method = .boolean
    arg name = .string
    normalized = normalizeExternalPoolName(name)
    if normalized = "" then return 0
    return findExternalPool(normalized) > 0

  externalPool: method = .RexxExternalValuePool
    arg name = .string
    normalized = normalizeExternalPoolName(name)
    slot = findExternalPool(normalized)
    pool = .RexxExternalValuePool
    if slot > 0 then do
      assembler linkattr1 pool,external_pools,slot
      return pool
    end
    return pool

  externalValueGet: method = .RexxExternalValueResult
    arg pool_name = .string, subject = .string
    slot = findExternalPool(normalizeExternalPoolName(pool_name))
    if slot = 0 then return .RexxExternalValueResult(0,.RexxValue(""))
    pool = .RexxExternalValuePool
    assembler linkattr1 pool,external_pools,slot
    return pool.get(subject)

  externalValueSet: method = .boolean
    arg pool_name = .string, subject = .string, value = .RexxValue
    slot = findExternalPool(normalizeExternalPoolName(pool_name))
    if slot = 0 then return 0
    pool = .RexxExternalValuePool
    assembler linkattr1 pool,external_pools,slot
    return pool.set(subject,value)

  normalizeExternalPoolName: method = .string
    arg name = .string
    return upper(strip(name))

  findExternalPool: method = .int
    arg normalized = .string
    do i = 1 to external_pool_count
      if external_pool_names[i] == normalized then return i
    end
    return 0

/** Synchronous raw endpoint; the execution configuration retains stream owners. */
ClassicProcessBytes: class implements .addressbytestream
  process_config = reference .RexxClassicConfig
  process_slot = .int
  *: factory
    arg config = reference .RexxClassicConfig, slot = .int
    process_config = config
    process_slot = slot
    return
  input_snapshot: method = .binary
    config_ref = process_config
    config = dereference config_ref
    return config.processInput(process_slot)
  append_bytes: method = .void
    arg bytes = .binary
    config_ref = process_config
    config = dereference config_ref
    call config.processOutput(process_slot,bytes)
    return
  finish: method = .void
    /* transport.write flushes; Scope alone closes its owned handles. */
    return
