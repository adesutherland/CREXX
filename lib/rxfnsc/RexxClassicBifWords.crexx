options levelb comments_dash numeric_classic
namespace rexxclassicbifwords expose rexxclassicbif_words
import rexxclassicbifs
import rexxvalue

/**
 * Count Classic whitespace-delimited words.
 *
 * @bif WORDS
 * @signature WORDS(string)
 * @checkargs rANY
 * @sandbox pure
 * @return word count as a RexxValue
 */
rexxclassicbif_words: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY") = 0 then return .RexxValue("")

  string = context.argumentText(1)
  string_length = .int
  assembler strlen string_length,string
  scan = 0
  count = 0
  do while scan < string_length
    assembler fndnblnk scan,string,scan
    if scan < 0 then leave
    count = count + 1
    assembler fndblnk scan,string,scan
    if scan < 0 then leave
  end
  return .RexxValue(count || "")
