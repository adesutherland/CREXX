options levelb comments_dash numeric_classic
namespace rexxclassicbifarg expose rexxclassicbif_arg
import rexxclassicbifs
import rexxactivation
import rexxvalue

/**
 * Read the active Classic program or routine's unchanged argument frame.
 *
 * @bif ARG
 * @signature ARG([n [,option]])
 * @checkargs oWHOLE>0 oEO
 * @param context_ref BIF operands and diagnostic context
 * @param activation_ref active program or internal routine arguments
 * @return count, exact argument value, or E/O existence result
 * @sandbox activation-local
 */
rexxclassicbif_arg: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext, activation_ref = reference .RexxActivationArguments
  context = dereference context_ref
  activation = dereference activation_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "oWHOLE>0 oEO") = 0 then return .RexxValue("")

  if \context.argumentExists(1) then do
    if context.argumentExists(2) then do
      call rexxclassicbif_set_error(context_ref,"40.5",1,"","")
      return .RexxValue("")
    end
    return .RexxValue(activation.argumentCount() || "")
  end

  index = .int
  index = (context.argumentText(1) as .int)
  if \context.argumentExists(2) then return activation.argument(index)
  option = context.argumentText(2)
  if option = "E" then do
    if activation.argumentExists(index) then return .RexxValue("1")
    return .RexxValue("0")
  end
  if activation.argumentExists(index) then return .RexxValue("0")
  return .RexxValue("1")
