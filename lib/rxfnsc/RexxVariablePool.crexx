options levelb comments_dash numeric_classic
namespace rexxpool expose RexxVariablePool
import rexxvalue
import rexxstem
import rexxclassicstate
import rexxclassicconfig
import rexxclassicdatatype
import rexxclassiccharacterscan
import rxfnsb
import data
-- import data_StringHashMap

rexxpool_constants: procedure expose RVP_BINDING_DROPPED RVP_BINDING_VALUE RVP_BINDING_STEM RVP_BINDING_ALIAS_VALUE RVP_BINDING_ALIAS_STEM
  constant RVP_BINDING_DROPPED = 0
  constant RVP_BINDING_VALUE = 1
  constant RVP_BINDING_STEM = 2
  constant RVP_BINDING_ALIAS_VALUE = 3
  constant RVP_BINDING_ALIAS_STEM = 4
  return

/** Walk validated words in a captured Classic indirect variable list. */
RexxVariableListCursor: class
  source = .string
  blanks = .string
  config_ref = reference .RexxClassicConfig
  position = .int

  *: factory
    arg list = .string, config = reference .RexxClassicConfig
    source = list
    config_ref = config
    current = dereference config_ref
    blanks = current.textOtherBlanks()
    position = 0
    return

  nextName: method = .string
    current = dereference config_ref
    do while position < length(source)
      word_start = rexxclassic_find_text_nonblank(source, position, blanks)
      if word_start < 0 then do
        position = length(source)
        leave
      end
      word_end = rexxclassic_find_text_blank(source, word_start, blanks)
      if word_end < 0 then word_end = length(source)
      name = substr(source, word_start + 1, word_end - word_start)
      position = word_end
      if rexxclassic_datatype_symbol_kind(.RexxValue(name), current) = 1 then return name
    end
    return ""

RexxPoolAlias: class
  parent_ref = reference .RexxVariablePool
  parent_name = .string
  exact_compound = .boolean

  *: factory
    arg parent = reference .RexxVariablePool, name = .string, compound = 0
    parent_ref = parent
    parent_name = name
    exact_compound = compound
    return

  parent: method = .RexxVariablePool
    pool = dereference parent_ref
    return pool

  name: method = .string
    return parent_name

  isDropped: method = .boolean
    pool = dereference parent_ref
    if exact_compound then return \pool.resolvedHasValue(parent_name)
    return pool.isDropped(parent_name)

  value: method = .RexxValue
    pool = dereference parent_ref
    if exact_compound then return pool.resolvedValue(parent_name)
    return pool.value(parent_name)

  setValue: method = .void
    arg item = .RexxValue
    pool = dereference parent_ref
    if exact_compound then do
      call pool.resolvedSetValue(parent_name, item)
      return
    end
    call pool.setValue(parent_name, item)
    return

  stem: method = .RexxStem
    pool = dereference parent_ref
    return pool.stem(parent_name)

  setStem: method = .void
    arg item = .RexxStem
    pool = dereference parent_ref
    call pool.setStem(parent_name, item)
    return

  setStemValue: method = .void
    arg tail = .string, item = .RexxValue
    pool = dereference parent_ref
    call pool.setStemValue(parent_name, tail, item)
    return

  drop: method = .void
    pool = dereference parent_ref
    if exact_compound then do
      call pool.resolvedDrop(parent_name)
      return
    end
    call pool.drop(parent_name)
    return

RexxVariablePool: class
  slots = .StringHashMap
  kinds = .int[]
  values = .RexxValue[]
  stems = .RexxStem[]
  aliases = .RexxPoolAlias[]
  compound_alias_slots = .StringHashMap
  compound_aliases = .RexxPoolAlias[]
  compound_alias_count = .int
  next_slot = .int
  address_state = .RexxAddressState
  trace_state = .RexxTraceState
  date_time_state = .RexxDateTimeState
  date_time_ready = .boolean

  *: factory
    slots = .StringHashMap()
    compound_alias_slots = .StringHashMap()
    compound_alias_count = 0
    next_slot = 0
    address_state = .RexxAddressState()
    trace_state = .RexxTraceState()
    date_time_state = .RexxDateTimeState()
    date_time_ready = 0
    next_slot = 1
    ignored = slots.put(".RC", "1")
    kinds[1] = RVP_BINDING_VALUE
    values[1] = .RexxValue("0")
    next_slot = 2
    ignored = slots.put(".RS", "2")
    kinds[2] = RVP_BINDING_VALUE
    values[2] = .RexxValue("0")
    return

  /** Reserved program state stays visible through PROCEDURE's private pool. */
  inheritCommandStatus: method = .void
    arg parent = reference .RexxVariablePool
    call exposeValue(".RC", parent, ".RC")
    call exposeValue(".RS", parent, ".RS")
    call exposeValue(".MN", parent, ".MN")
    call exposeValue(".SIGL", parent, ".SIGL")
    call exposeValue(".RESULT", parent, ".RESULT")
    return

  /** Record the causing clause in ordinary and reserved SIGNAL state. */
  setSignalLine: method = .void
    arg clause_line = .int
    call setSymbolValue("SIGL", .RexxValue.fromInt(clause_line))
    call setSymbolValue(".SIGL", .RexxValue.fromInt(clause_line))
    return

  setAddressEnvironment: method = .void
    arg name = .string
    state = .RexxAddressState
    assembler link state, address_state
    call state.setEnvironment(name)
    return

  addressEnvironment: method = .string
    return address_state.environment()

  addressState: method = .RexxAddressState
    return address_state

  swapAddressEnvironment: method = .void
    state = .RexxAddressState
    assembler link state, address_state
    call state.swapEnvironment()
    return

  setAddressConnection: method = .void
    arg option = .string, position = .string, type = .string, resource = .string
    state = .RexxAddressState
    assembler link state, address_state
    call state.setConnection(option, position, type, resource)
    return

  addressConnection: method = .string
    arg option = .string
    return address_state.connection(option)

  addressPosition: method = .string
    arg option = .string
    return address_state.position(option)

  addressType: method = .string
    arg option = .string
    return address_state.type(option)

  addressResource: method = .string
    arg option = .string
    return address_state.resource(option)

  inheritAddressState: method = .void
    arg parent = reference .RexxVariablePool
    parent_pool = dereference parent
    state = .RexxAddressState
    assembler link state, address_state
    call state.copyFrom(parent_pool.addressState())
    return

  /** Return the current activation's Classic TRACE setting. */
  traceSetting: method = .string
    return trace_state.current()

  /** Apply one validated Classic TRACE BIF option to this activation. */
  setTraceOption: method = .boolean
    arg option = .string
    state = .RexxTraceState
    assembler link state, trace_state
    return state.apply(option)

  /** Copy Classic TRACE state when creating a child activation pool. */
  inheritTraceState: method = .void
    arg parent = reference .RexxVariablePool
    parent_pool = dereference parent
    state = .RexxTraceState()
    call state.apply(parent_pool.traceSetting())
    trace_state = state
    return

  /** Freeze a fresh platform clock sample for a new Classic clause. */
  beginClauseTime: method = .void
    state = .RexxDateTimeState
    assembler link state,date_time_state
    call state.beginClause()
    date_time_ready = 1
    return

  /** Ensure direct BIF calls share one frozen clause clock. */
  ensureClauseTime: method = .void
    if \date_time_ready then do
      state = .RexxDateTimeState
      assembler link state,date_time_state
      call state.beginClause()
      date_time_ready = 1
    end
    return

  /** Install deterministic DATE/TIME state for a direct Level C harness. */
  injectClauseTime: method = .void
    arg base_day = .int, local_microseconds = .int, utc_microseconds = .int, offset_microseconds = .int
    state = .RexxDateTimeState
    assembler link state,date_time_state
    call state.injectClause(base_day,local_microseconds,utc_microseconds,offset_microseconds)
    date_time_ready = 1
    return

  clauseTimeFrozen: method = .boolean
    return date_time_ready

  clauseBaseDay: method = .int
    return date_time_state.baseDay()

  clauseLocalMicroseconds: method = .int
    return date_time_state.localMicroseconds()

  clauseUtcMicroseconds: method = .int
    return date_time_state.utcMicroseconds()

  clauseOffsetMicroseconds: method = .int
    return date_time_state.offsetMicroseconds()

  clauseElapsedMicroseconds: method = .int
    arg reset = .boolean
    state = .RexxDateTimeState
    assembler link state,date_time_state
    return state.elapsedMicroseconds(reset)

  normalizeName: method = .string
    arg name = .string
    return upper(strip(name))

  normalizeStemName: method = .string
    arg name = .string
    normalized = normalizeName(name)
    if right(normalized, 1) <> "." then normalized = normalized || "."
    return normalized

  slotFor: method = .int
    arg normalized = .string
    return slots.get(normalized) as .int

  createSlot: method = .int
    arg normalized = .string
    next_slot = next_slot + 1
    rc = slots.put(normalized, next_slot as .string)
    return next_slot

  /** Look up one already expanded, case-preserved compound alias. */
  hasCompoundAlias: method = .boolean
    arg resolved = .string
    return compound_alias_slots.containsKey(resolved)

  compoundAlias: method = .RexxPoolAlias
    arg resolved = .string
    slot = compound_alias_slots.get(resolved) as .int
    return compound_aliases[slot]

  /** Apply a whole-stem assignment or DROP to its exposed tails. */
  updateExposedStemTails: method = .void
    arg stem_name = .string, item = .RexxValue, is_drop = .boolean
    keys = compound_alias_slots.keyArray()
    do i = 1 to compound_alias_count
      resolved = keys[i]
      if left(resolved, length(stem_name)) == stem_name then do
        alias = compoundAlias(resolved)
        if is_drop then call alias.drop()
        else call alias.setValue(item)
      end
    end
    return

  hasBinding: method = .boolean
    arg name = .string
    normalized = normalizeName(name)
    if \slots.containsKey(normalized) then return 0
    slot = slotFor(normalized)
    if kinds[slot] = RVP_BINDING_DROPPED then return 0
    if kinds[slot] = RVP_BINDING_ALIAS_VALUE | kinds[slot] = RVP_BINDING_ALIAS_STEM then do
      alias = aliases[slot]
      return \alias.isDropped()
    end
    return 1

  /**
   * Expand a validated Classic variable symbol against this pool.
   *
   * Compound tail components that do not start with a digit are substituted
   * from this pool. Missing components retain their uppercase spelling. The
   * operation never creates a binding and does not raise NOVALUE.
   *
   * @param name validated Classic variable-symbol spelling
   * @return normalized scalar/stem name or expanded compound name
   */
  resolveSymbolName: method = .string
    arg name = .string
    normalized = normalizeName(name)
    normalized_length = length(normalized)
    stem_end = pos(".", normalized)

    if stem_end = 0 | stem_end = 1 | stem_end = normalized_length then
      return normalized

    stem_name = substr(normalized, 1, stem_end)
    tail_text = substr(normalized, stem_end + 1)
    tail_length = length(tail_text)
    derived_tail = ""
    component_start = 1

    do i = 1 to tail_length + 1
      if i > tail_length | substr(tail_text, i, 1) = "." then do
        component = substr(tail_text, component_start, i - component_start)
        if component \= "" then do
          if pos(left(component, 1), "0123456789") = 0 then do
            if hasBinding(component) then component = value(component).asString()
          end
        end

        if component_start > 1 then derived_tail = derived_tail || "."
        derived_tail = derived_tail || component
        component_start = i + 1
      end
    end

    return stem_name || derived_tail

  /**
   * Return a Classic symbol value without creating a missing binding.
   *
   * Uninitialized scalars return their normalized name. Uninitialized
   * compound variables return their fully expanded name unless their stem has
   * an assigned default value.
   *
   * @param name validated Classic variable-symbol spelling
   * @return current scalar, stem-default, or compound value
   */
  symbolValue: method = .RexxValue
    arg name = .string
    return resolvedValue(resolveSymbolName(name))

  /** Read a name whose compound tail has already been substituted. */
  resolvedValue: method = .RexxValue
    arg resolved = .string
    item_stem = .RexxStem
    alias = .RexxPoolAlias
    resolved_length = length(resolved)
    stem_end = pos(".", resolved)

    if stem_end = 0 | stem_end = 1 then do
      if hasBinding(resolved) then return value(resolved)
      return .RexxValue(resolved)
    end

    if stem_end = resolved_length then do
      if \hasBinding(resolved) then return .RexxValue(resolved)
      slot = slotFor(resolved)
      if kinds[slot] = RVP_BINDING_VALUE | kinds[slot] = RVP_BINDING_ALIAS_VALUE then
        return value(resolved)
      if kinds[slot] = RVP_BINDING_STEM then item_stem = stems[slot]
      else if kinds[slot] = RVP_BINDING_ALIAS_STEM then do
        alias = aliases[slot]
        item_stem = alias.stem()
      end
      else return .RexxValue(resolved)
      if item_stem.hasDefault() then return item_stem.defaultValue()
      return .RexxValue(resolved)
    end

    if hasCompoundAlias(resolved) then do
      alias = compoundAlias(resolved)
      return alias.value()
    end

    if hasBinding(resolved) then do
      slot = .int
      slot = slotFor(resolved)
      if kinds[slot] = RVP_BINDING_VALUE | kinds[slot] = RVP_BINDING_ALIAS_VALUE then
        return value(resolved)
    end

    stem_name = substr(resolved, 1, stem_end)
    derived_tail = substr(resolved, stem_end + 1)
    if \hasBinding(stem_name) then return .RexxValue(resolved)

    slot = .int
    slot = slotFor(stem_name)
    if kinds[slot] = RVP_BINDING_STEM then do
      item_stem = stems[slot]
    end
    else if kinds[slot] = RVP_BINDING_ALIAS_STEM then do
      alias = aliases[slot]
      item_stem = alias.stem()
    end
    else return .RexxValue(resolved)

    if item_stem.containsTail(derived_tail) then return item_stem.value(derived_tail)
    if item_stem.isDroppedTail(derived_tail) then return .RexxValue(resolved)
    if item_stem.hasDefault() then return item_stem.defaultValue()
    return .RexxValue(resolved)

  /** Assign one Classic scalar, stem default, or expanded compound name. */
  setSymbolValue: method = .void
    arg name = .string, item = .RexxValue
    call resolvedSetValue(resolveSymbolName(name), item)
    return

  /**
   * Apply one ordinary Classic CALL result to both visible result names.
   * A bare RETURN or other value-less completion removes any prior values.
   * Condition-handler calls skip this method because their result is ignored.
   * @param present whether the invoked routine returned a value
   * @param item the returned Unicode scalar, including an explicit empty value
   */
  applyCallResult: method = .void
    arg present = .boolean, item = .RexxValue
    if present then do
      call setSymbolValue("RESULT", item)
      call setSymbolValue(".RESULT", item)
    end
    else do
      call dropSymbol("RESULT")
      call dropSymbol(".RESULT")
    end
    return

  /** Set the visible SIGL from a source line retained by delayed CALL. */
  setCallTrapSigl: method = .void
    arg line = .int
    call setSymbolValue("SIGL", .RexxValue.fromInt(line))
    return

  /** Assign a name whose compound tail has already been substituted. */
  resolvedSetValue: method = .void
    arg resolved = .string, item = .RexxValue
    item_stem = .RexxStem
    resolved_length = length(resolved)
    stem_end = pos(".", resolved)
    if stem_end = 0 | stem_end = 1 then do
      call setValue(resolved, item)
      return
    end
    if stem_end = resolved_length then do
      item_stem = stem(resolved)
      call item_stem.setDefault(item)
      call setStem(resolved, item_stem)
      call updateExposedStemTails(resolved, item, 0)
      return
    end
    stem_name = substr(resolved, 1, stem_end)
    derived_tail = substr(resolved, stem_end + 1)
    call setStemValue(stem_name, derived_tail, item)
    return

  /**
   * Test whether a Classic variable symbol resolves to a non-dropped value.
   *
   * @param name validated Classic variable-symbol spelling
   * @return 1 when the resolved scalar, stem, or compound tail has a value
   */
  symbolHasValue: method = .boolean
    arg name = .string
    return resolvedHasValue(resolveSymbolName(name))

  /** Test a name whose compound tail has already been substituted. */
  resolvedHasValue: method = .boolean
    arg resolved = .string
    item_stem = .RexxStem
    alias = .RexxPoolAlias
    resolved_length = length(resolved)
    stem_end = pos(".", resolved)

    if stem_end = 0 | stem_end = 1 | stem_end = resolved_length then return hasBinding(resolved)
    if hasCompoundAlias(resolved) then do
      alias = compoundAlias(resolved)
      return \alias.isDropped()
    end
    if hasBinding(resolved) then return 1

    stem_name = substr(resolved, 1, stem_end)
    derived_tail = substr(resolved, stem_end + 1)
    if \hasBinding(stem_name) then return 0

    slot = slotFor(stem_name)
    if kinds[slot] = RVP_BINDING_STEM then item_stem = stems[slot]
    else if kinds[slot] = RVP_BINDING_ALIAS_STEM then do
      alias = aliases[slot]
      item_stem = alias.stem()
    end
    else return 0
    if item_stem.isDroppedTail(derived_tail) then return 0
    return item_stem.containsTail(derived_tail) | item_stem.hasDefault()

  bindingKind: method = .int
    arg name = .string
    normalized = normalizeName(name)
    if \slots.containsKey(normalized) then return RVP_BINDING_DROPPED
    slot = slotFor(normalized)
    return kinds[slot]

  value: method = .RexxValue
    arg name = .string
    normalized = normalizeName(name)
    if slots.containsKey(normalized) then do
      slot = slotFor(normalized)
      if kinds[slot] = RVP_BINDING_VALUE then return values[slot]
      if kinds[slot] = RVP_BINDING_ALIAS_VALUE then do
        alias = aliases[slot]
        return alias.value()
      end
    end
    item = .RexxValue("")
    call setValue(normalized, item)
    return item

  setValue: method = .void
    arg name = .string, item = .RexxValue
    normalized = normalizeName(name)
    slot = .int
    if slots.containsKey(normalized) then do
      slot = slotFor(normalized)
      if kinds[slot] = RVP_BINDING_ALIAS_VALUE then do
        alias = aliases[slot]
        call alias.setValue(item)
        return
      end
    end
    else do
      slot = createSlot(normalized)
    end
    if slot < 1 then slot = createSlot(normalized)
    kinds[slot] = RVP_BINDING_VALUE
    values[slot] = item
    return

  setString: method = .void
    arg name = .string, text = .string
    item = .RexxValue(text)
    call setValue(name, item)
    return

  stem: method = .RexxStem
    arg name = .string
    normalized = normalizeStemName(name)
    if slots.containsKey(normalized) then do
      slot = slotFor(normalized)
      if kinds[slot] = RVP_BINDING_STEM then return stems[slot]
      if kinds[slot] = RVP_BINDING_ALIAS_STEM then do
        alias = aliases[slot]
        return alias.stem()
      end
    end
    item = .RexxStem()
    call setStem(normalized, item)
    return item

  setStem: method = .void
    arg name = .string, item = .RexxStem
    normalized = normalizeStemName(name)
    slot = .int
    if slots.containsKey(normalized) then do
      slot = slotFor(normalized)
      if kinds[slot] = RVP_BINDING_ALIAS_STEM then do
        alias = aliases[slot]
        call alias.setStem(item)
        return
      end
    end
    else do
      slot = createSlot(normalized)
    end
    if slot < 1 then slot = createSlot(normalized)
    kinds[slot] = RVP_BINDING_STEM
    stems[slot] = item
    return

  stemValue: method = .RexxValue
    arg name = .string, tail = .string
    item_stem = stem(name)
    return item_stem.value(tail)

  /** Read a Classic compound tail without creating an unset binding. */
  stemSymbolValue: method = .RexxValue
    arg name = .string, tail = .string
    normalized = normalizeStemName(name)
    alias = .RexxPoolAlias
    if hasCompoundAlias(normalized || tail) then do
      alias = compoundAlias(normalized || tail)
      return alias.value()
    end
    item_stem = .RexxStem
    if \hasBinding(normalized) then return .RexxValue(normalized || tail)
    slot = slotFor(normalized)
    if kinds[slot] = RVP_BINDING_STEM then item_stem = stems[slot]
    else if kinds[slot] = RVP_BINDING_ALIAS_STEM then do
      alias = aliases[slot]
      item_stem = alias.stem()
    end
    else return .RexxValue(normalized || tail)
    if item_stem.containsTail(tail) then return item_stem.value(tail)
    if item_stem.isDroppedTail(tail) then return .RexxValue(normalized || tail)
    if item_stem.hasDefault() then return item_stem.defaultValue()
    return .RexxValue(normalized || tail)

  setStemValue: method = .void
    arg name = .string, tail = .string, item = .RexxValue
    normalized = normalizeStemName(name)
    alias = .RexxPoolAlias
    if hasCompoundAlias(normalized || tail) then do
      alias = compoundAlias(normalized || tail)
      call alias.setValue(item)
      return
    end
    slot = .int
    item_stem = .RexxStem()
    if slots.containsKey(normalized) then do
      slot = slotFor(normalized)
      if kinds[slot] = RVP_BINDING_ALIAS_STEM then do
        alias = aliases[slot]
        call alias.setStemValue(tail, item)
        return
      end
      if kinds[slot] = RVP_BINDING_STEM then item_stem = stems[slot]
    end
    else do
      slot = createSlot(normalized)
    end
    if slot < 1 then slot = createSlot(normalized)
    call item_stem.setValue(tail, item)
    kinds[slot] = RVP_BINDING_STEM
    stems[slot] = item_stem
    return

  setStemString: method = .void
    arg name = .string, tail = .string, text = .string
    item = .RexxValue(text)
    call setStemValue(name, tail, item)
    return

  exposeValue: method = .void
    arg name = .string, parent = reference .RexxVariablePool, parent_name = .string
    normalized = normalizeName(name)
    if parent_name = "" then parent_name = normalized
    else parent_name = normalizeName(parent_name)
    slot = .int
    if slots.containsKey(normalized) then do
      slot = slotFor(normalized)
    end
    else do
      slot = createSlot(normalized)
    end
    if slot < 1 then slot = createSlot(normalized)
    kinds[slot] = RVP_BINDING_ALIAS_VALUE
    aliases[slot] = .RexxPoolAlias(parent, parent_name)
    return

  exposeStem: method = .void
    arg name = .string, parent = reference .RexxVariablePool, parent_name = .string
    normalized = normalizeStemName(name)
    if parent_name = "" then parent_name = normalized
    else parent_name = normalizeStemName(parent_name)
    slot = .int
    if slots.containsKey(normalized) then do
      slot = slotFor(normalized)
    end
    else do
      slot = createSlot(normalized)
    end
    if slot < 1 then slot = createSlot(normalized)
    kinds[slot] = RVP_BINDING_ALIAS_STEM
    aliases[slot] = .RexxPoolAlias(parent, parent_name)
    return

  /** Expose one validated Classic symbol at its source-list position. */
  exposeSymbol: method = .void
    arg name = .string, parent = reference .RexxVariablePool
    resolved = resolveSymbolName(name)
    stem_end = pos(".", resolved)
    slot = .int
    if stem_end = 0 | stem_end = 1 then do
      call exposeValue(resolved, parent, resolved)
      return
    end
    if stem_end = length(resolved) then do
      call exposeStem(resolved, parent, resolved)
      return
    end
    if compound_alias_slots.containsKey(resolved) then do
      slot = compound_alias_slots.get(resolved) as .int
    end
    else do
      compound_alias_count = compound_alias_count + 1
      slot = compound_alias_count
      rc = compound_alias_slots.put(resolved, slot as .string)
    end
    compound_aliases[slot] = .RexxPoolAlias(parent, resolved, 1)
    return

  /** Expose an indirect list reference, then its validated words in order. */
  exposeIndirect: method = .void
    arg name = .string, parent = reference .RexxVariablePool, config_ref = reference .RexxClassicConfig
    call exposeSymbol(name, parent)
    list = symbolValue(name).asString()
    cursor = .RexxVariableListCursor(list, config_ref)
    do forever
      word = cursor.nextName()
      if word = "" then leave
      call exposeSymbol(word, parent)
    end
    return

  drop: method = .void
    arg name = .string
    normalized = normalizeName(name)
    if slots.containsKey(normalized) then do
      slot = slotFor(normalized)
      if kinds[slot] = RVP_BINDING_ALIAS_VALUE | kinds[slot] = RVP_BINDING_ALIAS_STEM then do
        alias = aliases[slot]
        call alias.drop()
        return
      end
      kinds[slot] = RVP_BINDING_DROPPED
      return
    end
    slot = .int
    slot = createSlot(normalized)
    kinds[slot] = RVP_BINDING_DROPPED
    return

  dropStem: method = .void
    arg name = .string
    normalized = normalizeStemName(name)
    call drop(normalized)
    call updateExposedStemTails(normalized, .RexxValue(""), 1)
    return

  /** Drop one case-preserved compound tail through a local or exposed stem. */
  dropStemTail: method = .void
    arg name = .string, tail = .string
    normalized = normalizeStemName(name)
    if hasCompoundAlias(normalized || tail) then do
      alias = compoundAlias(normalized || tail)
      call alias.drop()
      return
    end
    item_stem = .RexxStem
    alias = .RexxPoolAlias
    if \hasBinding(normalized) then return
    slot = slotFor(normalized)
    if kinds[slot] = RVP_BINDING_STEM then item_stem = stems[slot]
    else if kinds[slot] = RVP_BINDING_ALIAS_STEM then do
      alias = aliases[slot]
      item_stem = alias.stem()
    end
    else return
    call item_stem.dropTail(tail)
    if kinds[slot] = RVP_BINDING_STEM then stems[slot] = item_stem
    else call alias.setStem(item_stem)
    return

  /**
   * Drop one validated Classic variable symbol through the visible pool.
   *
   * Compound tail substitution happens before choosing the binding to drop.
   * A stem name drops its default and all tails; a compound name drops only
   * its expanded, case-preserved tail. Exposed aliases are handled by the
   * existing pool drop operations.
   *
   * @param name validated Classic variable-symbol spelling
   */
  dropSymbol: method = .void
    arg name = .string
    call resolvedDrop(resolveSymbolName(name))
    return

  /** Drop a name whose compound tail has already been substituted. */
  resolvedDrop: method = .void
    arg resolved = .string
    stem_end = pos(".", resolved)
    if stem_end = 0 | stem_end = 1 then do
      call drop(resolved)
      return
    end
    if stem_end = length(resolved) then do
      call dropStem(resolved)
      return
    end
    call dropStemTail(substr(resolved, 1, stem_end), substr(resolved, stem_end + 1))
    return

  /**
   * Interpret one captured indirect DROP subsidiary list in source order.
   *
   * Words use the activation's Unicode blanks and configured extra blanks.
   * Each word is checked with the same Classic configuration's symbol
   * classifier. Regina ignores invalid words and continues with subsequent
   * valid names.
   *
   * @param list captured value of the parenthesized variable reference
   * @param config_ref reference to the current Classic activation configuration
   */
  dropIndirectList: method = .void
    arg list = .string, config_ref = reference .RexxClassicConfig
    cursor = .RexxVariableListCursor(list, config_ref)
    do forever
      name = cursor.nextName()
      if name = "" then leave
      call dropSymbol(name)
    end
    return

  isDropped: method = .boolean
    arg name = .string
    normalized = normalizeName(name)
    if \slots.containsKey(normalized) then return 1
    slot = slotFor(normalized)
    if kinds[slot] = RVP_BINDING_ALIAS_VALUE | kinds[slot] = RVP_BINDING_ALIAS_STEM then do
      alias = aliases[slot]
      return alias.isDropped()
    end
    return kinds[slot] = RVP_BINDING_DROPPED

  free: method = .int
    return slots.free()
