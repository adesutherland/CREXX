options levelb comments_dash numeric_classic
namespace rexxclassicstate expose RexxAddressState RexxTraceState RexxDateTimeState
import rxfnsb

/**
 * Per-activation Classic ADDRESS state used by state-query BIFs.
 *
 * Connection descriptions follow ANSI X3J18 section 9.5.1 and are returned as
 * position, type, and resource separated by single blanks. The default NORMAL
 * resource is null, so the default connection descriptions retain a trailing
 * blank.
 */
RexxAddressState: class
  environment_name = .string
  alternate_environment_name = .string
  input_position = .string
  input_type = .string
  input_resource = .string
  alternate_input_position = .string
  alternate_input_type = .string
  alternate_input_resource = .string
  output_position = .string
  output_type = .string
  output_resource = .string
  alternate_output_position = .string
  alternate_output_type = .string
  alternate_output_resource = .string
  error_position = .string
  error_type = .string
  error_resource = .string
  alternate_error_position = .string
  alternate_error_type = .string
  alternate_error_resource = .string

  *: factory
    environment_name = "CREXX"
    input_position = "INPUT"
    input_type = "NORMAL"
    input_resource = ""
    output_position = "REPLACE"
    output_type = "NORMAL"
    output_resource = ""
    error_position = "REPLACE"
    error_type = "NORMAL"
    error_resource = ""
    alternate_environment_name = environment_name
    alternate_input_position = input_position
    alternate_input_type = input_type
    alternate_input_resource = input_resource
    alternate_output_position = output_position
    alternate_output_type = output_type
    alternate_output_resource = output_resource
    alternate_error_position = error_position
    alternate_error_type = error_type
    alternate_error_resource = error_resource
    return

  /** Copy both saved ADDRESS settings into a child Classic invocation. */
  copyFrom: method = .void
    arg parent = .RexxAddressState
    environment_name = parent.environment()
    alternate_environment_name = parent.alternateEnvironment()
    input_position = parent.position("I")
    input_type = parent.type("I")
    input_resource = parent.resource("I")
    output_position = parent.position("O")
    output_type = parent.type("O")
    output_resource = parent.resource("O")
    error_position = parent.position("E")
    error_type = parent.type("E")
    error_resource = parent.resource("E")
    alternate_input_position = parent.alternatePosition("I")
    alternate_input_type = parent.alternateType("I")
    alternate_input_resource = parent.alternateResource("I")
    alternate_output_position = parent.alternatePosition("O")
    alternate_output_type = parent.alternateType("O")
    alternate_output_resource = parent.alternateResource("O")
    alternate_error_position = parent.alternatePosition("E")
    alternate_error_type = parent.alternateType("E")
    alternate_error_resource = parent.alternateResource("E")
    return

  /** A lasting selection saves the old setting and starts normal connections. */
  setEnvironment: method = .void
    arg name = .string
    alternate_environment_name = environment_name
    alternate_input_position = input_position
    alternate_input_type = input_type
    alternate_input_resource = input_resource
    alternate_output_position = output_position
    alternate_output_type = output_type
    alternate_output_resource = output_resource
    alternate_error_position = error_position
    alternate_error_type = error_type
    alternate_error_resource = error_resource
    environment_name = upper(strip(name))
    input_position = "INPUT"
    input_type = "NORMAL"
    input_resource = ""
    output_position = "REPLACE"
    output_type = "NORMAL"
    output_resource = ""
    error_position = "REPLACE"
    error_type = "NORMAL"
    error_resource = ""
    return

  /** Bare ADDRESS exchanges the current and previously selected settings. */
  swapEnvironment: method = .void
    held = .RexxAddressState()
    call held.copyFrom(self)
    environment_name = held.alternateEnvironment()
    input_position = held.alternatePosition("I")
    input_type = held.alternateType("I")
    input_resource = held.alternateResource("I")
    output_position = held.alternatePosition("O")
    output_type = held.alternateType("O")
    output_resource = held.alternateResource("O")
    error_position = held.alternatePosition("E")
    error_type = held.alternateType("E")
    error_resource = held.alternateResource("E")
    alternate_environment_name = held.environment()
    alternate_input_position = held.position("I")
    alternate_input_type = held.type("I")
    alternate_input_resource = held.resource("I")
    alternate_output_position = held.position("O")
    alternate_output_type = held.type("O")
    alternate_output_resource = held.resource("O")
    alternate_error_position = held.position("E")
    alternate_error_type = held.type("E")
    alternate_error_resource = held.resource("E")
    return

  environment: method = .string
    return environment_name

  alternateEnvironment: method = .string
    return alternate_environment_name

  setConnection: method = .void
    arg option = .string, position = .string, type = .string, resource = .string
    selector = upper(left(strip(option), 1))

    select
      when selector = "I" then do
        input_position = position
        input_type = type
        input_resource = resource
      end
      when selector = "O" then do
        output_position = position
        output_type = type
        output_resource = resource
      end
      when selector = "E" then do
        error_position = position
        error_type = type
        error_resource = resource
      end
      otherwise return
    end
    return

  connection: method = .string
    arg option = .string
    selector = upper(left(strip(option), 1))

    select
      when selector = "I" then return input_position || " " || input_type || " " || input_resource
      when selector = "O" then return output_position || " " || output_type || " " || output_resource
      when selector = "E" then return error_position || " " || error_type || " " || error_resource
      otherwise return ""
    end
    return ""

  position: method = .string
    arg option = .string
    selector = upper(left(strip(option), 1))
    if selector = "I" then return input_position
    if selector = "O" then return output_position
    if selector = "E" then return error_position
    return ""

  type: method = .string
    arg option = .string
    selector = upper(left(strip(option), 1))
    if selector = "I" then return input_type
    if selector = "O" then return output_type
    if selector = "E" then return error_type
    return ""

  resource: method = .string
    arg option = .string
    selector = upper(left(strip(option), 1))
    if selector = "I" then return input_resource
    if selector = "O" then return output_resource
    if selector = "E" then return error_resource
    return ""

  alternatePosition: method = .string
    arg option = .string
    selector = upper(left(strip(option), 1))
    if selector = "I" then return alternate_input_position
    if selector = "O" then return alternate_output_position
    if selector = "E" then return alternate_error_position
    return ""

  alternateType: method = .string
    arg option = .string
    selector = upper(left(strip(option), 1))
    if selector = "I" then return alternate_input_type
    if selector = "O" then return alternate_output_type
    if selector = "E" then return alternate_error_type
    return ""

  alternateResource: method = .string
    arg option = .string
    selector = upper(left(strip(option), 1))
    if selector = "I" then return alternate_input_resource
    if selector = "O" then return alternate_output_resource
    if selector = "E" then return alternate_error_resource
    return ""

/**
 * Per-activation Classic TRACE BIF state.
 *
 * The stored setting is the single Classic option letter. Interactive state
 * is represented separately and is rendered as the leading `?` required by
 * TRACE().
 */
RexxTraceState: class
  trace_setting = .string
  interacting = .boolean
  inhibiting = .boolean

  *: factory
    trace_setting = "N"
    interacting = 0
    inhibiting = 0
    return

  current: method = .string
    result = ""
    if interacting then result = result || "?"
    if inhibiting then result = result || "!"
    return result || trace_setting

  copyFrom: method = .void
    arg parent = .RexxTraceState
    trace_setting = "N"
    interacting = 0
    inhibiting = 0
    call apply(parent.current())
    return

  isInteractive: method = .boolean
    return interacting

  isInhibiting: method = .boolean
    return inhibiting

  apply: method = .boolean
    arg option = .string
    option_length = .int
    index = .int
    codepoint = .int
    remainder = .string
    next_mode = .string
    digit_start = .int
    digit_index = .int
    digit = .int
    i = .int
    assembler strlen option_length,option

    if option_length = 0 then do
      trace_setting = "N"
      interacting = 0
      inhibiting = 0
      return 1
    end
    index = 0
    do while index < option_length
      assembler strchar codepoint,option,index
      if codepoint <> 63 & codepoint <> 33 then leave
      index = index + 1
    end

    if index < option_length then do
      remainder = substr(option, index + 1)
      assembler strchar codepoint,option,index
      if codepoint = 43 | codepoint = 45 |,
         (codepoint >= 48 & codepoint <= 57) then do
        digit_start = 1
        if codepoint = 43 | codepoint = 45 then digit_start = 2
        if digit_start > length(remainder) then return 0
        do i = digit_start to length(remainder)
          digit_index = i - 1
          assembler strchar digit,remainder,digit_index
          if digit < 48 | digit > 57 then return 0
        end
        next_mode = trace_setting
        if strip(substr(remainder, digit_start), "L", "0") = "" then next_mode = "O"
      end
      else do
        next_mode = translate(left(remainder, 1))
        if upper(remainder) = "AS" | upper(remainder) = "ASM" |,
           upper(remainder) = "LL" | upper(remainder) = "LLM" then next_mode = _trace_mode_from_option(remainder)
        if next_mode <> "ASM" & next_mode <> "LLM" &,
           pos(next_mode, "ACEFILNOR") = 0 then return 0
      end
    end
    do i = 0 to index - 1
      assembler strchar codepoint,option,i
      if codepoint = 63 then interacting = \interacting
      else inhibiting = \inhibiting
    end
    if index < option_length then trace_setting = next_mode
    if trace_setting = "O" then do
      interacting = 0
      inhibiting = 0
    end
    return 1

/**
 * Per-activation Classic DATE/TIME clause clock.
 *
 * `beginClause` freezes one platform sample. The compiler's future direct
 * Level C lowering can call that method at each clause boundary; direct BIF
 * harnesses use `ensureClause`, and deterministic tests use `injectClause`.
 * Elapsed/reset state persists across clause samples in the same activation.
 */
RexxDateTimeState: class
  clause_base_day = .int
  clause_local_microseconds = .int
  clause_utc_microseconds = .int
  clause_offset_microseconds = .int
  elapsed_started = .boolean
  elapsed_start_microseconds = .int

  *: factory
    elapsed_started = 0
    return

  /** Capture and freeze the current local and UTC clock for a new clause. */
  beginClause: method = .void
    before_local = .int
    after_local = .int
    standard_seconds = .int
    timezone_seconds = .int
    utc_seconds = .int
    standard_day = .int
    standard_second = .int
    local_second = .int
    local_day = .int
    daylight_adjustment = .int
    fraction = .int

    assembler mtime before_local
    assembler time standard_seconds
    assembler xtime timezone_seconds,"Z"
    assembler mtime after_local
    if after_local < before_local then do
      assembler time standard_seconds
      assembler xtime timezone_seconds,"Z"
    end

    utc_seconds = standard_seconds + timezone_seconds
    standard_day = standard_seconds % 86400
    standard_second = standard_seconds // 86400
    if standard_second < 0 then do
      standard_second = standard_second + 86400
      standard_day = standard_day - 1
    end

    local_second = after_local % 1000000
    fraction = after_local // 1000000
    daylight_adjustment = local_second - standard_second
    local_day = standard_day
    if daylight_adjustment > 43200 then do
      daylight_adjustment = daylight_adjustment - 86400
      local_day = local_day - 1
    end
    else if daylight_adjustment < -43200 then do
      daylight_adjustment = daylight_adjustment + 86400
      local_day = local_day + 1
    end

    clause_base_day = local_day + 719162
    clause_local_microseconds = after_local
    clause_utc_microseconds = utc_seconds * 1000000 + fraction
    clause_offset_microseconds = (0 - timezone_seconds + daylight_adjustment) * 1000000
    return

  /** Install a deterministic clause sample for a direct library harness. */
  injectClause: method = .void
    arg base_day = .int, local_microseconds = .int, utc_microseconds = .int, offset_microseconds = .int
    clause_base_day = base_day
    clause_local_microseconds = local_microseconds
    clause_utc_microseconds = utc_microseconds
    clause_offset_microseconds = offset_microseconds
    return

  baseDay: method = .int
    return clause_base_day

  localMicroseconds: method = .int
    return clause_local_microseconds

  utcMicroseconds: method = .int
    return clause_utc_microseconds

  offsetMicroseconds: method = .int
    return clause_offset_microseconds

  /** Return elapsed microseconds and optionally reset the elapsed origin. */
  elapsedMicroseconds: method = .int
    arg reset = .boolean
    return elapsedAt(clause_utc_microseconds,reset)

  /** Use a nested invocation's frozen sample with the shared elapsed origin. */
  elapsedAt: method = .int
    arg now = .int, reset = .boolean
    elapsed = .int
    if \elapsed_started then do
      elapsed_start_microseconds = now
      elapsed_started = 1
      return 0
    end
    elapsed = now - elapsed_start_microseconds
    if reset then elapsed_start_microseconds = now
    return elapsed
