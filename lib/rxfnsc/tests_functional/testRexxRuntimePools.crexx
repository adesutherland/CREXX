options levelb comments_dash numeric_classic
import rexxvalue
import rexxstem
import rexxpool
import rexxclassicconfig

test_runtime_pool_constants: procedure expose RV_FLAG_INT
  constant RV_FLAG_INT = 0x00020000
  return

main: procedure = .int
errors = 0

stem = .RexxStem()
call stem.setString("1", "alpha")
call stem.setValue("2", .RexxValue.fromInt(42))
errors = errors + check(stem.containsTail("1"), "stem contains tail")
errors = errors + check(stem.value("1").asString() = "alpha", "stem string value")
errors = errors + check(stem.value("2").asInt() = 42, "stem RexxValue value")
errors = errors + check(stem.value("2").cacheFlags() = RV_FLAG_INT, "stem keeps value flags")
errors = errors + check(stem.size() = 2, "stem size")
call stem.dropTail("1")
errors = errors + check(\stem.containsTail("1"), "stem drop tail")
errors = errors + check(stem.isDroppedTail("1"), "stem remembers dropped tail")
call stem.setDefault(.RexxValue("base"))
errors = errors + check(stem.size() = 0, "stem default resets old tails")
errors = errors + check(\stem.isDroppedTail("1"), "stem default resets dropped tails")
call stem.dropTail("1")
errors = errors + check(stem.isDroppedTail("1"), "stem drop hides default")
call stem.setString("1", "restored")
errors = errors + check(\stem.isDroppedTail("1"), "tail assignment clears dropped state")
errors = errors + check(stem.value("1").asString() = "restored", "tail assignment restores value")

pool = .RexxVariablePool()
classic_config = .RexxClassicConfig("UTF8")
call pool.setString("answer", "41")
errors = errors + check(pool.value("ANSWER").asString() = "41", "pool normalizes scalar names")
call pool.setValue("answer", .RexxValue.fromInt(42))
errors = errors + check(pool.value("answer").asInt() = 42, "pool scalar replacement")
errors = errors + check(pool.value("answer").cacheFlags() = RV_FLAG_INT, "pool scalar uses RexxValue cache")

call pool.setStemString("items", "A", "aye")
items_a = pool.stemValue("ITEMS.", "A")
errors = errors + check(items_a.asString() = "aye", "pool stem root normalization")
errors = errors + check(pool.value("items").asString() = "", "pool scalar and stem roots are separate")
call pool.setString("key", "b")
errors = errors + check(pool.resolveSymbolName("items.key") = "ITEMS.b", "compound tail keeps substituted case")
call pool.setStemString("items", "b", "lower")
call pool.setStemString("items", "B", "upper")
errors = errors + check(pool.stemSymbolValue("items", "b").asString() = "lower", "lowercase tail binding")
errors = errors + check(pool.stemSymbolValue("items", "B").asString() = "upper", "uppercase tail binding")
call pool.setSymbolValue("items.", .RexxValue("base"))
errors = errors + check(pool.stemSymbolValue("items", "A").asString() = "base", "stem default replaces explicit tails")
call pool.dropStemTail("items", "b")
errors = errors + check(pool.stemSymbolValue("items", "b").asString() = "ITEMS.b", "dropped lowercase tail hides default")
errors = errors + check(pool.symbolValue("items.key").asString() = "ITEMS.b", "derived dropped tail displays source case")
errors = errors + check(\pool.symbolHasValue("items.key"), "dropped derived tail has no value")
errors = errors + check(pool.stemSymbolValue("items", "B").asString() = "base", "other tail retains default")
call pool.setStemString("items", "b", "restored")
errors = errors + check(pool.stemSymbolValue("items", "b").asString() = "restored", "pool tail assignment clears drop")

child = .RexxVariablePool()
call child.exposeValue("local_answer", reference pool, "answer")
call child.setString("local_answer", "parent-updated")
errors = errors + check(pool.value("answer").asString() = "parent-updated", "exposed scalar aliases parent")

call child.exposeStem("local_items", reference pool, "items.")
call child.setStemString("local_items", "B", "bee")
items_b = pool.stemValue("items", "B")
errors = errors + check(items_b.asString() = "bee", "exposed stem aliases parent")
call child.dropStemTail("local_items", "B")
errors = errors + check(pool.stemSymbolValue("items", "B").asString() = "ITEMS.B", "exposed stem tail drop reaches parent")
call pool.dropStem("items")
errors = errors + check(pool.stemSymbolValue("items", "b").asString() = "ITEMS.b", "dropping stem removes default and tails")
call pool.setStemString("items", "A", "after-drop")
errors = errors + check(pool.stemSymbolValue("items", "A").asString() = "after-drop", "stem binding restores after drop")

call child.drop("local_answer")
errors = errors + check(pool.isDropped("answer"), "dropping exposed scalar drops parent binding")
call pool.setString("answer", "restored")
errors = errors + check(\pool.isDropped("answer"), "set clears dropped scalar state")
errors = errors + check(pool.value("answer").asString() = "restored", "scalar restored after drop")

call pool.setStemString("items", "b", "lower-again")
call pool.setStemString("items", "B", "upper-again")
call pool.dropSymbol("items.key")
errors = errors + check(pool.symbolValue("items.key").asString() = "ITEMS.b", "symbol drop substitutes lower-case tail")
errors = errors + check(pool.stemSymbolValue("items", "B").asString() = "upper-again", "symbol drop preserves other case tail")
call child.dropSymbol("local_items.B")
errors = errors + check(pool.stemSymbolValue("items", "B").asString() = "ITEMS.B", "symbol drop follows exposed stem")
call pool.setSymbolValue("items.", .RexxValue("default"))
call pool.dropSymbol("items.")
errors = errors + check(pool.symbolValue("items.A").asString() = "ITEMS.A", "symbol stem drop removes default and tails")
call child.dropSymbol("local_answer")
errors = errors + check(pool.symbolValue("answer").asString() = "ANSWER", "symbol scalar drop follows exposed alias")

call pool.setString("answer", "again")
call pool.setString("key", "b")
call pool.setStemString("items", "b", "lower-list")
call pool.setStemString("items", "B", "upper-list")
call pool.dropIndirectList("answer / 1bad items.key items.B", reference classic_config)
errors = errors + check(pool.symbolValue("answer").asString() = "ANSWER", "indirect list drops first scalar")
errors = errors + check(pool.symbolValue("items.key").asString() = "ITEMS.b", "indirect list drops substituted tail")
errors = errors + check(pool.stemSymbolValue("items", "B").asString() = "ITEMS.B", "indirect list continues after invalid words")
call pool.setStemString("items", "b", "still-lower")
call pool.setStemString("items", "KEY", "literal-key")
call pool.dropIndirectList("key items.key", reference classic_config)
errors = errors + check(pool.symbolValue("key").asString() = "KEY", "indirect list first drop changes later substitution")
errors = errors + check(pool.stemSymbolValue("items", "KEY").asString() = "ITEMS.KEY", "indirect list resolves each item in order")
errors = errors + check(pool.stemSymbolValue("items", "b").asString() = "still-lower", "indirect list keeps earlier derived tail")
call pool.setStemString("items", "B", "parent-list")
call child.dropIndirectList("local_items.B", reference classic_config)
errors = errors + check(pool.stemSymbolValue("items", "B").asString() = "ITEMS.B", "indirect list follows exposed stem")

configured = .RexxClassicConfig("UTF8")
call configured.setTextDatatypeLetters("α", "Α")
call configured.setTextOtherBlanks("·")
call pool.setString("α", "greek")
call pool.setString("answer", "again")
call pool.dropIndirectList("α·answer", reference configured)
errors = errors + check(pool.symbolValue("α").asString() = "Α", "indirect list uses configured Unicode symbol alphabet")
errors = errors + check(pool.symbolValue("answer").asString() = "ANSWER", "indirect list uses configured text blank")
call pool.setString("α", "again")
call pool.setString("answer", "again")
call pool.dropIndirectList("answer 🙂 α", reference configured)
errors = errors + check(pool.symbolValue("answer").asString() = "ANSWER", "indirect list uses Unicode whitespace")
errors = errors + check(pool.symbolValue("α").asString() = "Α", "indirect list skips invalid Unicode word and continues")

-- Exact compound EXPOSE keeps substituted tail case and follows caller aliases.
exposed_parent = .RexxVariablePool()
call exposed_parent.setString("key", "b")
call exposed_parent.setStemString("a.", "b", "lower")
call exposed_parent.setStemString("a.", "B", "upper")
call exposed_parent.setString("list", "key a.key /")
exposed_child = .RexxVariablePool()
call exposed_child.exposeIndirect("list", reference exposed_parent, reference classic_config)
errors = errors + check(exposed_child.symbolValue("a.key").asString() = "lower", "indirect expose binds substituted lowercase tail")
call exposed_child.setSymbolValue("a.key", .RexxValue("changed"))
errors = errors + check(exposed_parent.stemSymbolValue("a.", "b").asString() = "changed", "exact alias updates caller tail")
errors = errors + check(exposed_parent.stemSymbolValue("a.", "B").asString() = "upper", "exact alias preserves distinct uppercase tail")
exposed_nested = .RexxVariablePool()
call exposed_nested.exposeSymbol("key", reference exposed_child)
call exposed_nested.exposeSymbol("a.key", reference exposed_child)
call exposed_nested.setSymbolValue("a.key", .RexxValue("nested"))
errors = errors + check(exposed_parent.stemSymbolValue("a.", "b").asString() = "nested", "nested exact alias reaches original caller")
call exposed_child.setSymbolValue("a.", .RexxValue("local-default"))
errors = errors + check(exposed_parent.stemSymbolValue("a.", "b").asString() = "local-default", "private stem reset updates exposed caller tail")
errors = errors + check(exposed_parent.stemSymbolValue("a.", "B").asString() = "upper", "private stem reset keeps unexposed caller tail")
errors = errors + check(exposed_child.symbolValue("a.B").asString() = "local-default", "private stem default serves unexposed tail")
call exposed_child.dropSymbol("a.")
errors = errors + check(exposed_parent.stemSymbolValue("a.", "b").asString() = "A.b", "private stem drop reaches exposed caller tail")
errors = errors + check(exposed_parent.stemSymbolValue("a.", "B").asString() = "upper", "private stem drop keeps unexposed caller tail")
call exposed_child.setSymbolValue("a.key", .RexxValue("restored"))
errors = errors + check(exposed_parent.stemSymbolValue("a.", "b").asString() = "restored", "exact alias survives private stem drop")
call exposed_parent.setString("unicode_tail", "é")
call exposed_parent.setStemString("u.", "é", "before")
call exposed_child.exposeSymbol("unicode_tail", reference exposed_parent)
call exposed_child.exposeSymbol("u.unicode_tail", reference exposed_parent)
call exposed_child.setSymbolValue("u.unicode_tail", .RexxValue("after"))
errors = errors + check(exposed_parent.stemSymbolValue("u.", "é").asString() = "after", "exact alias preserves Unicode substituted tail")

if errors = 0 then say "ok"
return errors

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL" label
  return 1
