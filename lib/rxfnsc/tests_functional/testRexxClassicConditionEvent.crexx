options levelb comments_dash numeric_classic
import rxfnsb
import rexxclassicconditionevent

main: procedure = .int expose failures handled stripped expected_id
  arg test_args = .string[]
  failures = 0
  handled = 0
  stripped = test_args[0] > 0 & test_args[1] = "testRexxClassicConditionEvent_opt"
  assembler sigcalla caught(),"CLASSIC_CONDITION"
  do expected_id = 2 to 7
    event = .RexxClassicConditionEvent(expected_id, "Élan 😀")
    failures = failures + check(event.conditionId() = expected_id, "condition identity")
    failures = failures + check(event.description() = "Élan 😀", "Unicode description")
    assembler signal "CLASSIC_CONDITION",event
  end
  failures = failures + check(handled = 6, "all typed VM events delivered")

  if failures = 0 then say "ok"
  return failures

caught: procedure = .string expose failures handled stripped expected_id
  arg raw = .runtime_signal_raw
  condition = .runtime_signal("")
  call condition.set_raw(raw)
  handled = handled + 1
  failures = failures + check(condition.name() = "CLASSIC_CONDITION", "VM event name")
  failures = failures + check(condition.code() = 29, "VM event code")
  if stripped then failures = failures + check(condition.line() = 0, "stripped source line")
  else failures = failures + check(condition.line() > 0, "causing source line")
  payload = condition.payload()
  failures = failures + check(payload is .RexxClassicConditionEvent, "typed payload")
  if payload is .RexxClassicConditionEvent then do
    typed = payload as .RexxClassicConditionEvent
    failures = failures + check(typed.conditionId() = expected_id, "delivered condition identity")
    failures = failures + check(typed.description() = "Élan 😀", "delivered Unicode description")
  end
  return "__rxsignal_skip"

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL" label
  return 1
