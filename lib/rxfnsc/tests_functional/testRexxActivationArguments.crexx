options levelb comments_dash numeric_classic
import rexxactivation
import rexxvalue
import rexxclassicconfig
import rexxpool

main: procedure = .int
  errors = numeric_form_validation()
  errors = errors + external_condition_scope()
  errors = errors + external_condition_lifecycle()
  errors = errors + external_halt_suppression()
  args = .RexxActivationArguments()
  call args.append(.RexxValue("first"), 1)
  call args.append(.RexxValue("ignored"), 0)
  call args.appendText("")
  errors = errors + check(args.argumentCount() = 3, "omitted slot counts")
  errors = errors + check(args.argumentExists(1), "first present")
  errors = errors + check(\args.argumentExists(2), "middle omitted")
  errors = errors + check(args.argumentExists(3), "explicit empty present")
  errors = errors + check(\args.argumentExists(4), "missing absent")
  errors = errors + check(args.argument(1).asString() = "first", "first value")
  errors = errors + check(args.argument(2).asString() = "", "omitted value")
  errors = errors + check(args.argument(3).asString() = "", "explicit empty value")
  errors = errors + check(args.argument(4).asString() = "", "missing value")
  errors = errors + check(args.argument(1).asString() = "first", "repeat read")
  call args.append(.RexxValue("ignored trailing"), 0)
  errors = errors + check(args.argumentCount() = 3, "trailing omission does not count")
  errors = errors + check(\args.argumentExists(4), "trailing omission remains absent")
  errors = errors + check(\args.hasReturnValue(), "initial return absent")
  errors = errors + check(\args.procedureEligible(), "main cannot enter PROCEDURE")
  errors = errors + check(\args.isFunctionCall(), "main is not a function")
  call args.beginInternalCall()
  errors = errors + check(args.procedureEligible(), "internal call allows PROCEDURE")
  errors = errors + check(\args.isFunctionCall(), "subroutine is not a function")
  call args.consumeFirstInstruction()
  errors = errors + check(\args.procedureEligible(), "ordinary first instruction consumes PROCEDURE right")
  call args.beginInternalCall()
  call args.enterProcedure()
  errors = errors + check(\args.procedureEligible(), "first PROCEDURE consumes its own right")
  call args.beginInternalFunction()
  errors = errors + check(args.isFunctionCall(), "function identity is per activation")
  errors = errors + check(args.procedureEligible(), "function allows first PROCEDURE")
  call args.beginInternalCall()
  errors = errors + check(\args.isFunctionCall(), "subroutine resets function identity")
  call args.setReturnValue(.RexxValue("é"))
  errors = errors + check(args.hasReturnValue(), "explicit return present")
  errors = errors + check(args.returnValue().asString() = "é", "Unicode return value")
  errors = errors + check(args.argument(1).asString() = "first", "return keeps arguments")
  other = .RexxActivationArguments()
  errors = errors + check(\other.hasReturnValue(), "fresh invocation return absent")
  errors = errors + check(args.signalPolicy(1) = 0, "fresh signal policy disabled")
  call args.setAddressEnvironment("COMMAND")
  call args.setAddressConnection("O", "APPEND", "STEM", "OUT.")
  call args.setAddressEnvironment("SYSTEM")
  errors = errors + check(args.addressConnection("O") = "REPLACE NORMAL ", "lasting selection resets connections")
  call args.swapAddressEnvironment()
  errors = errors + check(args.addressEnvironment() = "COMMAND", "bare ADDRESS swaps environment")
  errors = errors + check(args.addressConnection("O") = "APPEND STEM OUT.", "bare ADDRESS swaps connections")
  call args.swapAddressEnvironment()
  call args.setSignalPolicy(1, 3)
  call other.inheritSignalPolicy(reference args)
  errors = errors + check(other.signalPolicy(1) = 3, "child inherits signal policy")
  errors = errors + check(other.addressEnvironment() = "SYSTEM", "child inherits current ADDRESS environment")
  call other.swapAddressEnvironment()
  errors = errors + check(other.addressEnvironment() = "COMMAND", "child inherits alternate ADDRESS environment")
  errors = errors + check(other.addressConnection("O") = "APPEND STEM OUT.", "child inherits alternate ADDRESS connections")
  errors = errors + check(args.addressEnvironment() = "SYSTEM", "child ADDRESS does not change caller")
  call args.setSignalPolicy(1, 0)
  errors = errors + check(other.signalPolicy(1) = 3, "child policy is independent")
  errors = errors + check(args.signalPolicy(1) = 0, "parent policy disabled")
  call args.setCallPolicy(2, 4)
  errors = errors + check(args.signalPolicy(2) = -4, "CALL policy distinct from SIGNAL")
  errors = errors + check(args.callPolicy(2) = 4, "CALL handler selected")
  errors = errors + check(args.queueCallCondition(2, "Élan 😀", 29), "queue Unicode condition")
  errors = errors + check(args.takeCallCondition() = 4, "take selected handler at boundary")
  errors = errors + check(args.dispatchedConditionId() = 2, "dispatch condition identity")
  errors = errors + check(args.dispatchedConditionDescription() = "Élan 😀", "dispatch Unicode description")
  errors = errors + check(args.dispatchedConditionLine() = 29, "dispatch causing line")
  errors = errors + check(args.takeCallCondition() = 0, "event consumed once")
  call args.recordCallDispatchError("RXC-LC-16.1: Label not found: ABSENT")
  errors = errors + check(args.takeCallDispatchError() = "RXC-LC-16.1: Label not found: ABSENT", "missing handler detail")
  errors = errors + check(args.takeCallDispatchError() = "", "missing handler detail consumed once")
  call other.inheritSignalPolicy(reference args)
  call other.beginCallTrap(2, args.dispatchedConditionDescription())
  errors = errors + check(other.delayedConditionId() = 2, "handler has DELAY state")
  errors = errors + check(other.currentConditionInstruction() = "CALL", "handler condition call kind")
  errors = errors + check(\other.queueCallCondition(2, "nested", 30), "nested ERROR suppressed")
  errors = errors + check(args.delayedConditionId() = 0, "caller remains enabled")
  errors = errors + check(args.currentConditionId() = 0, "caller condition restored")
  call other.setSignalPolicy(2, 7)
  errors = errors + check(other.delayedConditionId() = 0, "SIGNAL ON replaces DELAY")
  errors = errors + check(other.callPolicy(2) = 0, "SIGNAL replaced CALL policy")
  errors = errors + check(args.callPolicy(2) = 4, "child policy leaves caller intact")
  call args.setSignalPolicy(2, 0)
  errors = errors + check(args.callPolicy(2) = 0, "OFF removes CALL policy")
  call args.setCallPolicy(4, 5)
  halt_handler = .RexxActivationArguments()
  call halt_handler.inheritSignalPolicy(reference args)
  call halt_handler.beginCallTrap(4, "first")
  nested_halt = .RexxActivationArguments()
  call nested_halt.inheritSignalPolicy(reference halt_handler)
  errors = errors + check(nested_halt.queueCallCondition(4, "buffered 😀", 31), "one nested HALT buffered")
  errors = errors + check(\nested_halt.queueCallCondition(4, "extra", 32), "further HALT suppressed")
  errors = errors + check(args.hasPendingCallCondition(), "HALT restored to interrupted caller")
  errors = errors + check(args.takeCallCondition() = 5, "buffered HALT selects caller handler")
  errors = errors + check(args.dispatchedConditionDescription() = "buffered 😀", "buffered HALT Unicode")
  errors = errors + check(args.dispatchedConditionLine() = 31, "buffered HALT source")
  errors = errors + check(\args.hasPendingCallCondition(), "buffered HALT consumed")
  call args.clearReturnValue()
  errors = errors + check(\args.hasReturnValue(), "bare return absent")
  errors = errors + check(args.returnValue().asString() = "", "cleared return value")
  do condition_id = 1 to 7
    call args.setSignalPolicy(condition_id, condition_id + 10)
    call args.recordCondition(condition_id, "Élan 😀", "extra", "SIGNAL")
    errors = errors + check(args.signalPolicy(condition_id) = condition_id + 10, "all SIGNAL policies selected")
    errors = errors + check(args.currentConditionId() = condition_id &,
        args.currentConditionName() <> "" &,
        args.currentConditionDescription() = "Élan 😀" &,
        args.currentConditionExtra() = "extra" &,
        args.currentConditionInstruction() = "SIGNAL", "all condition states recorded")
    call other.inheritSignalPolicy(reference args)
    errors = errors + check(other.signalPolicy(condition_id) = condition_id + 10 &,
        other.currentConditionId() = condition_id, "all condition states inherited")
    call other.setSignalPolicy(condition_id, 0)
    errors = errors + check(args.signalPolicy(condition_id) = condition_id + 10, "child policy leaves parent active")
    call args.setSignalPolicy(condition_id, 0)
  end
  if errors = 0 then say "ok"
  return errors

/* Normalization clears condition transport, not the activation's other owners. */
external_condition_scope: procedure = .int
  errors = 0
  id = .int
  parent = .RexxActivationArguments()
  config = .RexxClassicConfig("UTF8")
  pool = .RexxVariablePool(1)
  destination = .RexxVariablePool(1)
  payload = "éµμ雪" || ('00'x as .string) || "tail "
  call parent.setNumericDigits(.RexxValue("7"),reference config)
  call parent.setNumericFuzz(.RexxValue("1"),reference config)
  call parent.setNumericForm(.RexxValue("engineering"))
  call parent.setAddressEnvironment("SCOPE-TEST")
  call parent.setAddressConnection("O","APPEND","STEM","OUT.")
  call parent.setTraceOption("I")
  call parent.requestProgramExit(.RexxValue(payload),1)
  do id = 1 to 7
    call parent.setSignalPolicy(id,id + 10)
  end
  call parent.setCallPolicy(2,17)
  child = .RexxActivationArguments()
  call child.inheritSignalPolicy(reference parent)
  call child.append(.RexxValue(payload),1)
  call child.append(.RexxValue("ignored"),0)
  call child.appendText("")
  call child.setReturnValue(.RexxValue(payload))
  call pool.setString(".RC","caller rc")
  call child.captureCallerPool(reference pool)
  errors = errors + check(child.queueCallCondition(2,"old dispatch",15),"prepare dispatch before normalization")
  errors = errors + check(child.takeCallCondition() = 17,"prepare selected dispatch before normalization")
  call child.setCallPolicy(3,18)
  errors = errors + check(child.queueCallCondition(3,"old pending",16),"prepare pending before normalization")
  call child.recordCallDispatchError("old missing handler")
  call child.recordCondition(6,"old current","old extra","SIGNAL")
  original_root = child.programRoot()
  call child.beginExternalConditionScope()
  do id = 1 to 7
    errors = errors + check(child.signalPolicy(id) = 0,"ordinary external policies off")
    errors = errors + check(parent.signalPolicy(id) <> 0,"normalization leaves parent policy intact")
  end
  errors = errors + check(\child.hasPendingCallCondition() & child.takeCallCondition() = 0,"pending event cleared")
  errors = errors + check(child.dispatchedConditionId() = 0 & child.dispatchedConditionDescription() == "" & child.dispatchedConditionLine() = 0,"dispatch fields cleared")
  errors = errors + check(child.takeCallDispatchError() == "","missing handler detail cleared")
  errors = errors + check(child.currentConditionId() = 0 & child.currentConditionDescription() == "" & child.currentConditionExtra() == "" & child.currentConditionInstruction() == "","ordinary current fields cleared")
  errors = errors + check(child.delayedConditionId() = 0 & child.delayedSuppressionConditionId() = 0,"ordinary delay and suppression cleared")
  errors = errors + check(child.argumentCount() = 3 & child.argument(1).asString() == payload & \child.argumentExists(2) & child.argumentExists(3),"raw arguments and present empty unchanged")
  errors = errors + check(child.hasReturnValue() & child.returnValue().asString() == payload,"owned completion unchanged")
  errors = errors + check(child.numericDigits() = 7 & child.numericFuzz() = 1 & child.numericForm() = 2,"numeric state unchanged")
  errors = errors + check(child.addressEnvironment() == "SCOPE-TEST" & child.addressConnection("O") == "APPEND STEM OUT." & child.traceSetting() == "I","ADDRESS and TRACE unchanged")
  retained_root = child.programRoot()
  errors = errors + check(retained_root <refsame> original_root,"program root reference unchanged")
  errors = errors + check(child.programExitRequested() & parent.returnValue().asString() == payload,"program EXIT state unchanged")
  call child.applyCommandStatusToPool(reference destination)
  errors = errors + check(destination.symbolValue(".RC").asString() == "caller rc","caller pool reference unchanged")
  errors = errors + check(\child.queueCallCondition(0,"invalid zero",1) & \child.queueCallCondition(6,"invalid CALL id",1) & \child.hasPendingCallCondition(),"zero suppression never accepts invalid event IDs")
  return errors

/* Explicit delivery is one-shot; internal inheritance is not handler entry. */
external_condition_lifecycle: procedure = .int
  errors = 0
  payload = "delivered é雪" || ('00'x as .string) || " "
  parent = .RexxActivationArguments()
  delivered = .RexxActivationArguments
  internal = .RexxActivationArguments
  ordinary = .RexxActivationArguments
  do id = 2 to 5
    call parent.setCallPolicy(id,id + 20)
    delivered = .RexxActivationArguments()
    call delivered.inheritSignalPolicy(reference parent)
    call delivered.beginCallTrap(id,payload)
    call delivered.recordCondition(id,payload,"delivered extra","CALL")
    call delivered.beginExternalProgram()
    call delivered.beginExternalConditionScope()
    errors = errors + check(delivered.delayedSuppressionConditionId() = id & delivered.delayedConditionId() = id,"external begin preserves explicit delivery marker")
    errors = errors + check(delivered.currentConditionId() = id & delivered.currentConditionDescription() == payload & delivered.currentConditionExtra() == "delivered extra" & delivered.currentConditionInstruction() == "CALL","explicit C D E I preserved exactly")
    do policy = 1 to 7
      errors = errors + check(delivered.signalPolicy(policy) = 0 & delivered.callPolicy(policy) = 0,"explicit handler retains no foreign ordinal")
    end
    if id <> 4 then errors = errors + check(\delivered.queueCallCondition(id,"same event",20) & \delivered.hasPendingCallCondition(),"zero-policy ERROR FAILURE NOTREADY suppressed")
    call delivered.recordCondition(1,"later syntax","later extra","SIGNAL")
    errors = errors + check(delivered.delayedSuppressionConditionId() = id,"suppression follows delayed ID, not later current condition")
    internal = .RexxActivationArguments()
    call internal.inheritSignalPolicy(reference delivered)
    errors = errors + check(internal.delayedSuppressionConditionId() = id,"internal child inherits validated suppression")
    call internal.beginExternalConditionScope()
    errors = errors + check(internal.currentConditionId() = 0 & internal.delayedSuppressionConditionId() = 0,"internal inheritance never arms explicit entry")
    ordinary = .RexxActivationArguments()
    call ordinary.inheritSignalPolicy(reference delivered)
    call ordinary.beginExternalProgram()
    errors = errors + check(ordinary.delayedSuppressionConditionId() = 0,"ordinary external boundary clears inherited suppression before normalization")
    call ordinary.beginExternalConditionScope()
    errors = errors + check(ordinary.currentConditionId() = 0 & ordinary.delayedConditionId() = 0,"ordinary external inside handler starts fresh")
    call delivered.beginExternalConditionScope()
    errors = errors + check(delivered.currentConditionId() = 0 & delivered.delayedSuppressionConditionId() = 0,"normalization consumes explicit marker once")
  end

  marked = .RexxActivationArguments()
  call marked.beginCallTrap(2,"explicit")
  inherited = .RexxActivationArguments()
  call inherited.inheritSignalPolicy(reference marked)
  call inherited.beginExternalProgram()
  call inherited.beginExternalConditionScope()
  errors = errors + check(inherited.currentConditionId() = 0 & inherited.delayedSuppressionConditionId() = 0,"unconsumed entry marker is never inherited")
  call marked.setSignalPolicy(3,11)
  call marked.setCallPolicy(5,12)
  call marked.setSignalPolicy(0,99)
  call marked.setCallPolicy(1,99)
  call marked.setCallPolicy(2,0)
  call marked.beginExternalConditionScope()
  errors = errors + check(marked.delayedSuppressionConditionId() = 2,"other and invalid policy setters preserve marker")
  call marked.setSignalPolicy(3,21)
  call marked.setCallPolicy(5,22)
  errors = errors + check(marked.delayedSuppressionConditionId() = 2,"other policies preserve active suppression")
  call marked.setSignalPolicy(2,0)
  errors = errors + check(marked.delayedConditionId() = 0 & marked.delayedSuppressionConditionId() = 0,"matching OFF cancels delay and suppression")
  call marked.beginCallTrap(2,"new explicit")
  call marked.setCallPolicy(2,23)
  call marked.beginExternalConditionScope()
  errors = errors + check(marked.currentConditionId() = 0 & marked.delayedSuppressionConditionId() = 0,"matching CALL setter cancels marker")
  call marked.beginCallTrap(2,"new explicit")
  call marked.setSignalPolicy(2,24)
  call marked.beginExternalConditionScope()
  errors = errors + check(marked.currentConditionId() = 0,"matching SIGNAL setter cancels marker")

  call marked.beginCallTrap(2,"old explicit")
  call marked.beginExternalConditionScope()
  call marked.beginCallTrap(3,"new delivery")
  errors = errors + check(marked.delayedSuppressionConditionId() = 0,"new valid trap clears prior suppression")
  call marked.beginExternalConditionScope()
  errors = errors + check(marked.delayedSuppressionConditionId() = 3,"new delivery can normalize independently")
  call marked.beginExternalProgram()
  errors = errors + check(marked.delayedSuppressionConditionId() = 0,"external begin cancels active suppression")
  call marked.beginCallTrap(2,"stale")
  call marked.recordCondition(3,"different","extra","CALL")
  call marked.beginExternalConditionScope()
  errors = errors + check(marked.currentConditionId() = 0 & marked.delayedConditionId() = 0,"mismatched current identity rejects stale marker")
  call marked.beginCallTrap(2,"stale")
  call marked.recordCondition(2,"padded instruction","extra","CALL ")
  call marked.beginExternalConditionScope()
  errors = errors + check(marked.currentConditionId() = 0,"padded CALL is not an explicit delivery")
  call marked.beginCallTrap(0,"invalid")
  call marked.beginCallTrap(1,"invalid")
  call marked.beginCallTrap(6,"invalid")
  call marked.beginExternalConditionScope()
  errors = errors + check(marked.currentConditionId() = 0 & marked.delayedSuppressionConditionId() = 0,"invalid trap IDs never arm fresh entry")
  call marked.beginCallTrap(2,"still valid")
  call marked.beginCallTrap(7,"invalid no-op")
  call marked.beginExternalConditionScope()
  errors = errors + check(marked.delayedSuppressionConditionId() = 2 & marked.currentConditionDescription() == "still valid","invalid trap leaves an existing valid delivery unchanged")
  return errors

external_halt_suppression: procedure = .int
  errors = 0
  caller = .RexxActivationArguments()
  handler = .RexxActivationArguments()
  nested = .RexxActivationArguments()
  call caller.setCallPolicy(4,31)
  call handler.inheritSignalPolicy(reference caller)
  call handler.beginCallTrap(4,"first HALT")
  call handler.beginExternalProgram()
  call handler.beginExternalConditionScope()
  call nested.inheritSignalPolicy(reference handler)
  errors = errors + check(nested.callPolicy(4) = 0 & nested.delayedSuppressionConditionId() = 4,"nested HALT delay has no foreign policy")
  errors = errors + check(nested.queueCallCondition(4,"buffered 雪",71),"zero-policy HALT uses existing parent buffer")
  errors = errors + check(\nested.queueCallCondition(4,"occupied",72),"occupied interrupted slot rejects extra HALT")
  errors = errors + check(\nested.hasPendingCallCondition() & \handler.hasPendingCallCondition() & caller.hasPendingCallCondition(),"only interrupted caller owns buffered HALT")
  errors = errors + check(caller.takeCallCondition() = 31 & caller.dispatchedConditionDescription() == "buffered 雪" & caller.dispatchedConditionLine() = 71,"buffered HALT retains caller ordinal description and source")
  errors = errors + check(nested.queueCallCondition(4,"next",73) & caller.takeCallCondition() = 31,"consumed HALT slot can be reused")
  call handler.setCallPolicy(4,32)
  errors = errors + check(handler.delayedSuppressionConditionId() = 0 & handler.delayedConditionId() = 0,"matching CALL ON cancels HALT suppression")
  errors = errors + check(handler.queueCallCondition(4,"local",74) & handler.takeCallCondition() = 32,"local policy replaces foreign suppression")
  return errors

/* A fresh owner isolates FORM validation from argument/trap state above. */
numeric_form_validation: procedure = .int
  errors = 0
  activation = .RexxActivationArguments()
  message = activation.setNumericForm(.RexxValue("engineering suffix"))
  errors = errors + check(message == "" & activation.numericForm() = 2, "FORM accepts lower-case E prefix, not only the full keyword")
  message = activation.setNumericForm(.RexxValue("invalid"))
  errors = errors + check(message == "RXC-LC-33.3: NUMERIC FORM must start with E or S; found invalid", "invalid FORM has exact standard 33.3 identity")
  errors = errors + check(activation.numericDigits() = 9 & activation.numericFuzz() = 0 & activation.numericForm() = 2, "rejected FORM preserves DIGITS FUZZ and prior ENGINEERING form")
  message = activation.setNumericForm(.RexxValue("scientific suffix"))
  errors = errors + check(message == "" & activation.numericForm() = 1, "FORM accepts lower-case S prefix after rejection")
  return errors

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL" label
  return 1
