options levelb comments_dash numeric_classic
import rexxactivation
import rexxvalue

main: procedure = .int
  errors = 0
  args = .RexxActivationArguments()
  call args.append(.RexxValue("first"), 1)
  call args.append(.RexxValue("ignored"), 0)
  call args.appendText("")
  errors = errors + check(args.argumentCount() = 3, "omitted slot counts")
  errors = errors + check(args.argumentExists(1), "first present")
  errors = errors + check(\args.argumentExists(2), "middle omitted")
  errors = errors + check(args.argumentExists(3), "explicit empty present")
  errors = errors + check(\args.argumentExists(4), "missing absent")
  errors = errors + check(args.argument(1).asString() = "first", "first value")
  errors = errors + check(args.argument(2).asString() = "", "omitted value")
  errors = errors + check(args.argument(3).asString() = "", "explicit empty value")
  errors = errors + check(args.argument(4).asString() = "", "missing value")
  errors = errors + check(args.argument(1).asString() = "first", "repeat read")
  call args.append(.RexxValue("ignored trailing"), 0)
  errors = errors + check(args.argumentCount() = 3, "trailing omission does not count")
  errors = errors + check(\args.argumentExists(4), "trailing omission remains absent")
  errors = errors + check(\args.hasReturnValue(), "initial return absent")
  errors = errors + check(\args.procedureEligible(), "main cannot enter PROCEDURE")
  errors = errors + check(\args.isFunctionCall(), "main is not a function")
  call args.beginInternalCall()
  errors = errors + check(args.procedureEligible(), "internal call allows PROCEDURE")
  errors = errors + check(\args.isFunctionCall(), "subroutine is not a function")
  call args.consumeFirstInstruction()
  errors = errors + check(\args.procedureEligible(), "ordinary first instruction consumes PROCEDURE right")
  call args.beginInternalCall()
  call args.enterProcedure()
  errors = errors + check(\args.procedureEligible(), "first PROCEDURE consumes its own right")
  call args.beginInternalFunction()
  errors = errors + check(args.isFunctionCall(), "function identity is per activation")
  errors = errors + check(args.procedureEligible(), "function allows first PROCEDURE")
  call args.beginInternalCall()
  errors = errors + check(\args.isFunctionCall(), "subroutine resets function identity")
  call args.setReturnValue(.RexxValue("é"))
  errors = errors + check(args.hasReturnValue(), "explicit return present")
  errors = errors + check(args.returnValue().asString() = "é", "Unicode return value")
  errors = errors + check(args.argument(1).asString() = "first", "return keeps arguments")
  other = .RexxActivationArguments()
  errors = errors + check(\other.hasReturnValue(), "fresh invocation return absent")
  call args.clearReturnValue()
  errors = errors + check(\args.hasReturnValue(), "bare return absent")
  errors = errors + check(args.returnValue().asString() = "", "cleared return value")
  if errors = 0 then say "ok"
  return errors

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL" label
  return 1
