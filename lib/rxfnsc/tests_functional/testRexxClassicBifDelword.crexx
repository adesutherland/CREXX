options levelb comments_dash numeric_classic
import rexxclassicbifs
import rexxclassicbifdelword
import rexxvalue

errors = 0

errors = errors + check_count("Now time", "Now is the  time", "2", "2")
errors = errors + check_omitted("Now is ", "Now is the time ", "3")
errors = errors + check_omitted("Now time", "Now time", "5")
errors = errors + check_omitted("", "Med lov skal", "1")
errors = errors + check_count("lov skal", "Med lov skal", "1", "1")
errors = errors + check_count("Med ", "Med lov skal", "2", "99")
errors = errors + check_count("Med lov skal", "Med lov skal", "2", "0")
errors = errors + check_count("  beta", "  alpha   beta", "1", "1")
errors = errors + check_count("one three", "one two three", "2", "1", "UTF8")
errors = errors + check_omitted("", "", "1")
errors = errors + check_count("one|three", "one|two|three", "2", "1", "BYTE_BAR")

errors = errors + check_count_error("RXC-LC-40.3", 0)
errors = errors + check_count_error("RXC-LC-40.3", 1)
errors = errors + check_count_error("RXC-LC-40.4", 4)
errors = errors + check_omitted_error(1)
errors = errors + check_omitted_error(2)
errors = errors + check_start_error("RXC-LC-40.12", "not-a-number")
errors = errors + check_start_error("RXC-LC-40.12", "1.5")
errors = errors + check_start_error("RXC-LC-40.14", "0")
errors = errors + check_start_error("RXC-LC-40.14", "-1")
errors = errors + check_count_value_error("RXC-LC-40.12", "1.5")
errors = errors + check_count_value_error("RXC-LC-40.13", "-1")

if errors = 0 then say "PASS: Level C DELWORD BIF"
return errors <> 0

check_omitted: procedure = .int
  arg expected = .string, string = .string, start = .string, profile = "BYTE"
  return run_check(expected, string, start, 0, "", profile)

check_count: procedure = .int
  arg expected = .string, string = .string, start = .string, delete_count = .string, profile = "BYTE"
  return run_check(expected, string, start, 1, delete_count, profile)

run_check: procedure = .int
  arg expected = .string, string = .string, start = .string, count_supplied = .boolean, delete_count = .string, profile = .string
  args = .RexxValue[]
  exists = .int[]
  args[1] = .RexxValue(string)
  args[2] = .RexxValue(start)
  exists[1] = 1
  exists[2] = 1
  if count_supplied then do
    args[3] = .RexxValue(delete_count)
    exists[3] = 1
  end
  context = .RexxBifCallContext("DELWORD")
  call configure_profile context, profile
  call context.setArguments(args, exists)
  result = rexxclassicbif_delword(reference context)
  if \context.hasError() & result.asString() = expected then return 0
  say "FAIL: DELWORD expected" expected "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

configure_profile: procedure
  arg context = .RexxBifCallContext, profile = .string
  if profile = "UTF8" then call context.useUtf8Profile()
  else if profile = "BYTE_BAR" then do
    blanks = .binary
    blanks = "7C"x
    call context.setByteOtherBlanks(blanks)
  end
  return

check_count_error: procedure = .int
  arg expected_code = .string, count = .int
  args = .RexxValue[]
  exists = .int[]
  do i = 1 to count
    args[i] = .RexxValue("A")
    exists[i] = 1
  end
  context = .RexxBifCallContext("DELWORD")
  call context.setArguments(args, exists)
  result = rexxclassicbif_delword(reference context)
  if context.hasError() & context.errorCode() = expected_code then return 0
  say "FAIL: DELWORD expected error" expected_code "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_omitted_error: procedure = .int
  arg omitted = .int
  args = .RexxValue[]
  exists = .int[]
  do i = 1 to 2
    args[i] = .RexxValue("A")
    exists[i] = i <> omitted
  end
  context = .RexxBifCallContext("DELWORD")
  call context.setArguments(args, exists)
  result = rexxclassicbif_delword(reference context)
  if context.hasError() & context.errorCode() = "RXC-LC-40.5" then return 0
  say "FAIL: DELWORD omitted" omitted "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_start_error: procedure = .int
  arg expected_code = .string, start = .string
  args = .RexxValue[]
  exists = .int[]
  args[1] = .RexxValue("one two")
  args[2] = .RexxValue(start)
  exists[1] = 1
  exists[2] = 1
  context = .RexxBifCallContext("DELWORD")
  call context.setArguments(args, exists)
  result = rexxclassicbif_delword(reference context)
  if context.hasError() & context.errorCode() = expected_code then return 0
  say "FAIL: DELWORD start expected error" expected_code "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_count_value_error: procedure = .int
  arg expected_code = .string, delete_count = .string
  args = .RexxValue[]
  exists = .int[]
  args[1] = .RexxValue("one two")
  args[2] = .RexxValue("1")
  args[3] = .RexxValue(delete_count)
  exists[1] = 1
  exists[2] = 1
  exists[3] = 1
  context = .RexxBifCallContext("DELWORD")
  call context.setArguments(args, exists)
  result = rexxclassicbif_delword(reference context)
  if context.hasError() & context.errorCode() = expected_code then return 0
  say "FAIL: DELWORD count expected error" expected_code "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1
