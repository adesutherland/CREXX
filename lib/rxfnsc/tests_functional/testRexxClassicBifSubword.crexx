options levelb comments_dash numeric_classic
import rexxclassicbifs
import rexxvalue

errors = 0

errors = errors + check_count("is the", "Now is the  time", "2", "2")
errors = errors + check_omitted("the  time", "Now is the  time  ", "3")
errors = errors + check_omitted("", "Now is the time", "5")
errors = errors + check_count("is", "Now is the time", "2", "1")
errors = errors + check_count("is   the", "Now is   the  time", "2", "2")
errors = errors + check_count("the  time", "Now is the  time   ", "3", "99")
errors = errors + check_count("", "Now is the time", "2", "0")
errors = errors + check_omitted("one two", "  one two  ", "1")
errors = errors + check_count("two　three", "one two　three", "2", "2", "UTF8")
errors = errors + check_omitted("", "", "1")
errors = errors + check_count("two|three", "one|two|three", "2", "2", "BYTE_BAR")

errors = errors + check_count_error("RXC-LC-40.3", 0)
errors = errors + check_count_error("RXC-LC-40.3", 1)
errors = errors + check_count_error("RXC-LC-40.4", 4)
errors = errors + check_omitted_error(1)
errors = errors + check_omitted_error(2)
errors = errors + check_start_error("RXC-LC-40.12", "not-a-number")
errors = errors + check_start_error("RXC-LC-40.12", "1.5")
errors = errors + check_start_error("RXC-LC-40.14", "0")
errors = errors + check_start_error("RXC-LC-40.14", "-1")
errors = errors + check_count_value_error("RXC-LC-40.12", "1.5")
errors = errors + check_count_value_error("RXC-LC-40.13", "-1")

if errors = 0 then say "PASS: Level C SUBWORD BIF"
return errors <> 0

check_omitted: procedure = .int
  arg expected = .string, string = .string, start = .string, profile = "BYTE"
  return run_check(expected, string, start, 0, "", profile)

check_count: procedure = .int
  arg expected = .string, string = .string, start = .string, wordcount = .string, profile = "BYTE"
  return run_check(expected, string, start, 1, wordcount, profile)

run_check: procedure = .int
  arg expected = .string, string = .string, start = .string, count_supplied = .boolean, wordcount = .string, profile = .string
  args = .RexxValue[]
  exists = .int[]
  args[1] = .RexxValue(string)
  args[2] = .RexxValue(start)
  exists[1] = 1
  exists[2] = 1
  if count_supplied then do
    args[3] = .RexxValue(wordcount)
    exists[3] = 1
  end
  context = .RexxBifCallContext("SUBWORD")
  call configure_profile context, profile
  call context.setArguments(args, exists)
  result = rexxclassicbif_subword(reference context)
  if \context.hasError() & result.asString() == expected & args[1].asString() == string then return 0
  say "FAIL: SUBWORD expected" expected "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

configure_profile: procedure
  arg context = .RexxBifCallContext, profile = .string
  if profile = "UTF8" then call context.useUtf8Profile()
  else if profile = "BYTE_BAR" then do
    blanks = .binary
    blanks = "7C"x
    call context.setByteOtherBlanks(blanks)
  end
  return

check_count_error: procedure = .int
  arg expected_code = .string, count = .int
  args = .RexxValue[]
  exists = .int[]
  do i = 1 to count
    args[i] = .RexxValue("A")
    exists[i] = 1
  end
  context = .RexxBifCallContext("SUBWORD")
  call context.setArguments(args, exists)
  result = rexxclassicbif_subword(reference context)
  if context.hasError() & context.errorCode() = expected_code then return 0
  say "FAIL: SUBWORD expected error" expected_code "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_omitted_error: procedure = .int
  arg omitted = .int
  args = .RexxValue[]
  exists = .int[]
  do i = 1 to 2
    args[i] = .RexxValue("A")
    exists[i] = i <> omitted
  end
  context = .RexxBifCallContext("SUBWORD")
  call context.setArguments(args, exists)
  result = rexxclassicbif_subword(reference context)
  if context.hasError() & context.errorCode() = "RXC-LC-40.5" then return 0
  say "FAIL: SUBWORD omitted" omitted "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_start_error: procedure = .int
  arg expected_code = .string, start = .string
  args = .RexxValue[]
  exists = .int[]
  args[1] = .RexxValue("one two")
  args[2] = .RexxValue(start)
  exists[1] = 1
  exists[2] = 1
  context = .RexxBifCallContext("SUBWORD")
  call context.setArguments(args, exists)
  result = rexxclassicbif_subword(reference context)
  if context.hasError() & context.errorCode() = expected_code then return 0
  say "FAIL: SUBWORD start expected error" expected_code "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_count_value_error: procedure = .int
  arg expected_code = .string, wordcount = .string
  args = .RexxValue[]
  exists = .int[]
  args[1] = .RexxValue("one two")
  args[2] = .RexxValue("1")
  args[3] = .RexxValue(wordcount)
  exists[1] = 1
  exists[2] = 1
  exists[3] = 1
  context = .RexxBifCallContext("SUBWORD")
  call context.setArguments(args, exists)
  result = rexxclassicbif_subword(reference context)
  if context.hasError() & context.errorCode() = expected_code then return 0
  say "FAIL: SUBWORD count expected error" expected_code "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1
