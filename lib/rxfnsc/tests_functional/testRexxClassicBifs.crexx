options levelb comments_dash numeric_classic
import rexxclassicbifs
import rexxclassicconfig
import rexxvalue
import rexxpool

errors = 0

errors = errors + check_bif("LENGTH", "3", "abc")
errors = errors + check_bif("SUBSTR", "bc  ", "abc", "2", "4")
errors = errors + check_bif("SUBSTR", "...", "abc", "5", "3", ".")
errors = errors + check_bif("SUBWORD", "is the", "Now is the time", "2", "2")
errors = errors + check_bif("LEFT", "abc..", "abc", "5", ".")
errors = errors + check_bif("RIGHT", "007", "7", "3", "0")
errors = errors + check_bif("STRIP", "12.7", "0012.700", "B", "0")
errors = errors + check_bif("POS", "7", "foo", "a foo foo", "4")
errors = errors + check_bif("WORD", "the", "Now is the time", "3")
errors = errors + check_bif("WORDS", "4", "Now is the time")
errors = errors + check_bif("SPACE", "Nowisthetime", "Now  is   the time", "0")
errors = errors + check_bif("SPACE", "Now++is++the++time", "Now  is   the time", "2", "+")
errors = errors + check_bif("ABBREV", "1", "PRINT", "PRI")
errors = errors + check_bif("ABBREV", "0", "PRINT", "", "1")
errors = errors + check_bif("BITAND", "@", "A", "B")
errors = errors + check_bif("BITOR", "C", "A", "B")
errors = errors + check_bif("BITXOR", "a", "A", " ")
errors = errors + check_bif("COPIES", "abcabcabc", "abc", "3")
errors = errors + check_bif("VERIFY", "2", "1Z3", "1234567890")
errors = errors + check_bif("VERIFY", "3", "AB4T", "1234567890", "M")
errors = errors + check_bif("DATATYPE", "NUM", "12.3")
errors = errors + check_bif("DATATYPE", "1", "BCd3", "X")
errors = errors + check_bif("DATATYPE", "0", "BCgd3", "X")
errors = errors + check_bif("ABS", "12.5", "-12.5")
errors = errors + check_bif("SIGN", "-1", "-0.307")
errors = errors + check_bif("MIN", "-1", "4", "-1", "9")
errors = errors + check_bif("MAX", "9", "4", "-1", "9")
errors = errors + check_bif("UPPER", "MIXED", "Mixed")
errors = errors + check_bif("LOWER", "mixed", "Mixed")
errors = errors + check(rexxclassicbif_length(.RexxValue("abcdef")).asString() = "6", "direct length helper")

options_config = .RexxClassicConfig()
call options_config.applyOptions(.RexxValue("  etmode" || '00'x || " unknown  "))
errors = errors + check(options_config.profile() = "BYTE", "unknown BYTE options with NUL")
call options_config.useUtf8Profile()
call options_config.applyOptions(.RexxValue("exmode" || '00'x || " noetmode"))
errors = errors + check(options_config.profile() = "UTF8", "unknown UTF8 options with NUL")

errors = errors + check_error("LENGTH", "RXC-LC-40.3")
errors = errors + check_error("LEFT", "RXC-LC-40.13", "abc", "-1")
errors = errors + check_error("LEFT", "RXC-LC-40.23", "abc", "5", "..")
errors = errors + check_error("DATATYPE", "RXC-LC-40.28", "abc", "Q")

args = .RexxValue[]
exists = .int[]
args[1] = .RexxValue("abc")
args[2] = .RexxValue("")
args[3] = .RexxValue("2")
exists[1] = 1
exists[2] = 0
exists[3] = 1
ctx = .RexxBifCallContext("SUBSTR")
call ctx.setArguments(args, exists)
result = rexxclassicbif_substr(reference ctx)
errors = errors + check(ctx.hasError() & ctx.errorCode() = "RXC-LC-40.5" & result.asString() = "", "omitted required argument")

args = .RexxValue[]
exists = .int[]
args[1] = .RexxValue(" ")
args[2] = .RexxValue("abc def ghi")
args[3] = .RexxValue("5")
exists[1] = 1
exists[2] = 1
exists[3] = 1
ctx = .RexxBifCallContext("POS")
call ctx.setArguments(args, exists)
result = rexxclassicbif_pos(reference ctx)
errors = errors + check(\ctx.hasError() & result.asString() = "8", "pos with blank needle and start")

pool = .RexxVariablePool()
call pool.setString("answer", "41")
ctx = .RexxBifCallContext("LENGTH")
call ctx.setCallerPool(reference pool)
ctx_pool_ref = ctx.callerPool()
ctx_pool = dereference ctx_pool_ref
call ctx_pool.setString("answer", "42")
errors = errors + check(pool.value("answer").asString() = "42", "context carries caller pool")

compat_args = .RexxValue[]
compat_exists = .int[]
compat_args[1] = .RexxValue("abcdef")
compat_args[2] = .RexxValue("2")
compat_args[3] = .RexxValue("3")
compat_exists[1] = 1
compat_exists[2] = 1
compat_exists[3] = 1
compat_context = .RexxBifCallContext("SUBSTR")
call compat_context.setArguments(compat_args, compat_exists)
compat_result = rexxclassicbif_call(reference compat_context)
errors = errors + check(\compat_context.hasError() & compat_result.asString() = "bcd", "deprecated dispatcher compatibility")
errors = errors + check_context_lifetimes()

if errors = 0 then say "ok"
return errors

check_context_lifetimes: procedure = .int
  errors = 0
  context = prepared_context()
  owned_pool_ref = context.callerPool()
  owned_config_ref = context.configReference()
  errors = errors + check(<refvalid>(owned_pool_ref) & <refvalid>(owned_config_ref), "returned context owns live defaults")
  owned_pool = dereference owned_pool_ref
  errors = errors + check(owned_pool.value("owned").asString() = "original", "returned context retains prepared pool")
  copied_context = context
  copied_pool_ref = copied_context.callerPool()
  copied_config_ref = copied_context.configReference()
  errors = errors + check(\(copied_pool_ref <refsame> owned_pool_ref) & \(copied_config_ref <refsame> owned_config_ref), "prepared context copy binds its own defaults")
  copied_pool = dereference copied_pool_ref
  call copied_pool.setString("owned", "copy")
  call copied_context.useUtf8Profile()
  errors = errors + check(owned_pool.value("owned").asString() = "original" & copied_pool.value("owned").asString() = "copy", "copied owned pools mutate independently")
  errors = errors + check(context.characterConfig().isByteProfile() & \copied_context.characterConfig().isByteProfile(), "copied owned configurations mutate independently")
  context = .RexxBifCallContext("LENGTH")
  replacement_pool_ref = context.callerPool()
  replacement_config_ref = context.configReference()
  errors = errors + check((owned_pool_ref <refsame> replacement_pool_ref) & (owned_config_ref <refsame> replacement_config_ref), "same-layout assignment preserves destination owned storage identities")
  errors = errors + check(<refvalid>(copied_pool_ref) & <refvalid>(copied_config_ref), "copy retains its independent owned lifetimes")
  retired_pool_ref = make_retired_owned_pool()
  retired_config_ref = make_retired_owned_config()
  errors = errors + check(<refvalid>(retired_pool_ref) = 0 & <refvalid>(retired_config_ref) = 0, "owned references expire after physical owner retirement")

  external_pool = .RexxVariablePool()
  external_config = .RexxClassicConfig()
  external_pool_ref = reference external_pool
  external_config_ref = reference external_config
  borrowed_context = .RexxBifCallContext("LENGTH")
  call borrowed_context.setCallerPool(external_pool_ref)
  call borrowed_context.setConfig(external_config_ref)
  borrowed_copy = borrowed_context
  borrowed_pool_ref = borrowed_copy.callerPool()
  borrowed_config_ref = borrowed_copy.configReference()
  errors = errors + check((borrowed_pool_ref <refsame> external_pool_ref) & (borrowed_config_ref <refsame> external_config_ref), "copied context preserves explicit borrowed identities")
  call borrowed_copy.useUtf8Profile()
  errors = errors + check(\external_config.isByteProfile() & external_pool.unicodeNames(), "borrowed context mutations reach external owners")

  with_expired_config = make_expired_config_context()
  expired_config_ref = with_expired_config.configReference()
  expired_config_copy = with_expired_config
  expired_copy_ref = expired_config_copy.configReference()
  errors = errors + check(<refvalid>(expired_config_ref) = 0 & <refvalid>(expired_copy_ref) = 0, "expired explicit configuration never falls back to owned default")
  still_owned_pool_ref = expired_config_copy.callerPool()
  errors = errors + check(<refvalid>(still_owned_pool_ref), "expired borrowed configuration leaves owned pool live")
  replacement_config = .RexxClassicConfig("BYTE")
  call expired_config_copy.setCharacterConfig(replacement_config)
  repaired_config_ref = expired_config_copy.configReference()
  errors = errors + check(<refvalid>(repaired_config_ref) & expired_config_copy.characterConfig().isByteProfile(), "explicit owned configuration replaces expired borrowed binding")

  with_expired_pool = make_expired_pool_context()
  expired_pool_ref = with_expired_pool.callerPool()
  still_owned_config_ref = with_expired_pool.configReference()
  errors = errors + check(<refvalid>(expired_pool_ref) = 0 & <refvalid>(still_owned_config_ref), "expired borrowed pool remains expired while owned configuration survives")
  expression_context = .RexxBifCallContext.expression("expression")
  expression_pool_ref = expression_context.callerPool()
  expression_config_ref = expression_context.configReference()
  errors = errors + check(<refvalid>(expression_pool_ref) = 0 & <refvalid>(expression_config_ref) = 0, "expression context retains absent defaults")
  return errors

context_retirement_controls: procedure expose CONTEXT_RETIREMENT_CONTROL
  constant CONTEXT_RETIREMENT_CONTROL = 0
  return

/* Inspect physical owner retirement, with ordinary calls in both modes. */
make_retired_owned_pool: procedure = reference .RexxVariablePool expose CONTEXT_RETIREMENT_CONTROL
  context = .RexxBifCallContext("LENGTH")
  return context.callerPool()

make_retired_owned_config: procedure = reference .RexxClassicConfig expose CONTEXT_RETIREMENT_CONTROL
  context = .RexxBifCallContext("LENGTH")
  return context.configReference()

prepared_context: procedure = .RexxBifCallContext
  context = .RexxBifCallContext("LENGTH")
  pool_ref = context.callerPool()
  pool = dereference pool_ref
  call pool.setString("owned", "original")
  return context

make_expired_config_context: procedure = .RexxBifCallContext
  context = .RexxBifCallContext("LENGTH")
  config = .RexxClassicConfig()
  call context.setConfig(reference config)
  return context

make_expired_pool_context: procedure = .RexxBifCallContext
  context = .RexxBifCallContext("LENGTH")
  pool = .RexxVariablePool()
  call context.setCallerPool(reference pool)
  return context

check_bif: procedure = .int
  arg name = .string, expected = .string, ... = .string
  args = .RexxValue[]
  exists = .int[]
  do i = 1 to arg[0]
    args[i] = .RexxValue(arg[i])
    exists[i] = 1
  end
  ctx = .RexxBifCallContext(name)
  call ctx.setArguments(args, exists)
  result = invoke_direct(name, reference ctx)
  if \ctx.hasError() & result.asString() = expected then return 0
  say "FAIL" name "expected" expected "got" result.asString() ctx.errorCode() ctx.errorMessage()
  return 1

check_error: procedure = .int
  arg name = .string, expected_code = .string, ... = .string
  args = .RexxValue[]
  exists = .int[]
  do i = 1 to arg[0]
    args[i] = .RexxValue(arg[i])
    exists[i] = 1
  end
  ctx = .RexxBifCallContext(name)
  call ctx.setArguments(args, exists)
  result = invoke_direct(name, reference ctx)
  if ctx.hasError() & ctx.errorCode() = expected_code then return 0
  say "FAIL" name "expected error" expected_code "got" result.asString() ctx.errorCode() ctx.errorMessage()
  return 1

invoke_direct: procedure = .RexxValue
  arg name = .string, context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  select
    when name = "ABBREV" then return rexxclassicbif_abbrev(context_ref)
    when name = "ABS" then return rexxclassicbif_abs(context_ref)
    when name = "BITAND" then return rexxclassicbif_bitand(context_ref)
    when name = "BITOR" then return rexxclassicbif_bitor(context_ref)
    when name = "BITXOR" then return rexxclassicbif_bitxor(context_ref)
    when name = "COPIES" then return rexxclassicbif_copies(context_ref)
    when name = "DATATYPE" then return rexxclassicbif_datatype(context_ref)
    when name = "LEFT" then return rexxclassicbif_left(context_ref)
    when name = "LENGTH" then do
      call context.clearError()
      if rexxclassicbif_check_args(context_ref, "rANY") = 0 then return .RexxValue("")
      return rexxclassicbif_length(context.argument(1))
    end
    when name = "LOWER" then return rexxclassicbif_lower(context_ref)
    when name = "MAX" then return rexxclassicbif_max(context_ref)
    when name = "MIN" then return rexxclassicbif_min(context_ref)
    when name = "POS" then return rexxclassicbif_pos(context_ref)
    when name = "RIGHT" then return rexxclassicbif_right(context_ref)
    when name = "SIGN" then return rexxclassicbif_sign(context_ref)
    when name = "SPACE" then return rexxclassicbif_space(context_ref)
    when name = "STRIP" then return rexxclassicbif_strip(context_ref)
    when name = "SUBSTR" then return rexxclassicbif_substr(context_ref)
    when name = "SUBWORD" then return rexxclassicbif_subword(context_ref)
    when name = "UPPER" then return rexxclassicbif_upper(context_ref)
    when name = "VERIFY" then return rexxclassicbif_verify(context_ref)
    when name = "WORD" then return rexxclassicbif_word(context_ref)
    when name = "WORDS" then return rexxclassicbif_words(context_ref)
  end
  return .RexxValue("")

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL" label
  return 1
