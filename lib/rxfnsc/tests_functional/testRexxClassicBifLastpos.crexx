options levelb comments_dash numeric_classic
import rexxclassicbifs
import rexxclassicbiflastpos
import rexxvalue

errors = 0

errors = errors + check_default("8", " ", "abc def ghi")
errors = errors + check_default("0", " ", "abcdefghi")
errors = errors + check_end("4", " ", "abc def ghi", "7")
errors = errors + check_default("6", "b", "abc abc")
errors = errors + check_end("2", "b", "abc abc", "5")
errors = errors + check_end("6", "b", "abc abc", "6")
errors = errors + check_end("6", "b", "abc abc", "20")
errors = errors + check_default("5", "abc", "abc abc")
errors = errors + check_end("1", "abc", "abc abc", "6")
errors = errors + check_default("2", "aa", "aaa")
errors = errors + check_end("1", "aa", "aaa", "2")
errors = errors + check_default("0", "", "anything")
errors = errors + check_default("0", "a", "")
errors = errors + check_default("4", "→", "a→b→c")
errors = errors + check_end("2", "→", "a→b→c", "3")
errors = errors + check_byte_profile("4", "b", "aéb")
errors = errors + check_large()

errors = errors + check_count_error("RXC-LC-40.3", 0)
errors = errors + check_count_error("RXC-LC-40.3", 1)
errors = errors + check_count_error("RXC-LC-40.4", 4)
errors = errors + check_omitted_required(1)
errors = errors + check_omitted_required(2)
errors = errors + check_end_error("not-a-number", "RXC-LC-40.12")
errors = errors + check_end_error("1.5", "RXC-LC-40.12")
errors = errors + check_end_error("0", "RXC-LC-40.14")
errors = errors + check_end_error("-1", "RXC-LC-40.14")

if errors = 0 then say "PASS: Level C LASTPOS BIF"
return errors <> 0

check_default: procedure = .int
  arg expected = .string, needle = .string, haystack = .string
  return run_check(expected, needle, haystack, 0, "")

check_end: procedure = .int
  arg expected = .string, needle = .string, haystack = .string, search_end = .string
  return run_check(expected, needle, haystack, 1, search_end)

run_check: procedure = .int
  arg expected = .string, needle = .string, haystack = .string, end_exists = .boolean, search_end = .string
  args = .RexxValue[]
  exists = .int[]
  args[1] = .RexxValue(needle)
  args[2] = .RexxValue(haystack)
  exists[1] = 1
  exists[2] = 1
  if end_exists then do
    args[3] = .RexxValue(search_end)
    exists[3] = 1
  end
  context = .RexxBifCallContext("LASTPOS")
  call context.useUtf8Profile()
  call context.setArguments(args, exists)
  result = rexxclassicbif_lastpos(reference context)
  if \context.hasError() & result.asString() = expected & args[1].asString() = needle & args[2].asString() = haystack then return 0
  say "FAIL: LASTPOS expected" expected "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_byte_profile: procedure = .int
  arg expected = .string, needle = .string, haystack = .string
  args = .RexxValue[]
  exists = .int[]
  args[1] = .RexxValue(needle)
  args[2] = .RexxValue(haystack)
  exists[1] = 1
  exists[2] = 1
  context = .RexxBifCallContext("LASTPOS")
  call context.setArguments(args, exists)
  result = rexxclassicbif_lastpos(reference context)
  if \context.hasError() & result.asString() = expected then return 0
  say "FAIL: LASTPOS BYTE expected" expected "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_large: procedure = .int
  large = ""
  pad_character = 97
  large_count = 1000
  assembler padstr large,pad_character,large_count
  return check_default("999", "aa", large)

check_count_error: procedure = .int
  arg expected_code = .string, count = .int
  args = .RexxValue[]
  exists = .int[]
  do i = 1 to count
    args[i] = .RexxValue("A")
    exists[i] = 1
  end
  context = .RexxBifCallContext("LASTPOS")
  call context.setArguments(args, exists)
  result = rexxclassicbif_lastpos(reference context)
  if context.hasError() & context.errorCode() = expected_code then return 0
  say "FAIL: LASTPOS expected error" expected_code "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_omitted_required: procedure = .int
  arg omitted = .int
  args = .RexxValue[]
  exists = .int[]
  do i = 1 to 2
    args[i] = .RexxValue("A")
    exists[i] = i <> omitted
  end
  context = .RexxBifCallContext("LASTPOS")
  call context.setArguments(args, exists)
  result = rexxclassicbif_lastpos(reference context)
  if context.hasError() & context.errorCode() = "RXC-LC-40.5" then return 0
  say "FAIL: LASTPOS omitted" omitted "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_end_error: procedure = .int
  arg search_end = .string, expected_code = .string
  args = .RexxValue[]
  exists = .int[]
  args[1] = .RexxValue("a")
  args[2] = .RexxValue("abc")
  args[3] = .RexxValue(search_end)
  exists[1] = 1
  exists[2] = 1
  exists[3] = 1
  context = .RexxBifCallContext("LASTPOS")
  call context.setArguments(args, exists)
  result = rexxclassicbif_lastpos(reference context)
  if context.hasError() & context.errorCode() = expected_code then return 0
  say "FAIL: LASTPOS search end expected" expected_code "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1
