options levelb comments_dash numeric_classic
import rexxclassicbifs
import rexxclassicbifdelstr
import rexxvalue

errors = 0

errors = errors + check_omitted("ab", "abcd", "3")
errors = errors + check_length("abe", "abcde", "3", "2")
errors = errors + check_omitted("abcde", "abcde", "6")
errors = errors + check_length("abcde", "abcde", "3", "0")
errors = errors + check_length("cde", "abcde", "1", "2")
errors = errors + check_length("abc", "abcde", "4", "20")
errors = errors + check_omitted("", "abcde", "1")
errors = errors + check_omitted("", "", "1")
errors = errors + check_length("az", "aé日z", "2", "2")

errors = errors + check_count_error("RXC-LC-40.3", 0)
errors = errors + check_count_error("RXC-LC-40.3", 1)
errors = errors + check_count_error("RXC-LC-40.4", 4)
errors = errors + check_omitted_error(1)
errors = errors + check_omitted_error(2)
errors = errors + check_start_error("RXC-LC-40.12", "not-a-number")
errors = errors + check_start_error("RXC-LC-40.12", "1.5")
errors = errors + check_start_error("RXC-LC-40.14", "0")
errors = errors + check_start_error("RXC-LC-40.14", "-1")
errors = errors + check_length_error("RXC-LC-40.12", "1.5")
errors = errors + check_length_error("RXC-LC-40.13", "-1")

if errors = 0 then say "PASS: Level C DELSTR BIF"
return errors <> 0

check_omitted: procedure = .int
  arg expected = .string, string = .string, start = .string
  return run_check(expected, string, start, 0, "")

check_length: procedure = .int
  arg expected = .string, string = .string, start = .string, delete_length = .string
  return run_check(expected, string, start, 1, delete_length)

run_check: procedure = .int
  arg expected = .string, string = .string, start = .string, length_supplied = .boolean, delete_length = .string
  args = .RexxValue[]
  exists = .int[]
  args[1] = .RexxValue(string)
  args[2] = .RexxValue(start)
  exists[1] = 1
  exists[2] = 1
  if length_supplied then do
    args[3] = .RexxValue(delete_length)
    exists[3] = 1
  end
  context = .RexxBifCallContext("DELSTR")
  call context.setArguments(args, exists)
  result = rexxclassicbif_delstr(reference context)
  if \context.hasError() & result.asString() = expected then return 0
  say "FAIL: DELSTR expected" expected "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_count_error: procedure = .int
  arg expected_code = .string, count = .int
  args = .RexxValue[]
  exists = .int[]
  do i = 1 to count
    args[i] = .RexxValue("A")
    exists[i] = 1
  end
  context = .RexxBifCallContext("DELSTR")
  call context.setArguments(args, exists)
  result = rexxclassicbif_delstr(reference context)
  if context.hasError() & context.errorCode() = expected_code then return 0
  say "FAIL: DELSTR expected error" expected_code "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_omitted_error: procedure = .int
  arg omitted = .int
  args = .RexxValue[]
  exists = .int[]
  do i = 1 to 2
    args[i] = .RexxValue("A")
    exists[i] = i <> omitted
  end
  context = .RexxBifCallContext("DELSTR")
  call context.setArguments(args, exists)
  result = rexxclassicbif_delstr(reference context)
  if context.hasError() & context.errorCode() = "RXC-LC-40.5" then return 0
  say "FAIL: DELSTR omitted" omitted "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_start_error: procedure = .int
  arg expected_code = .string, start = .string
  args = .RexxValue[]
  exists = .int[]
  args[1] = .RexxValue("abc")
  args[2] = .RexxValue(start)
  exists[1] = 1
  exists[2] = 1
  context = .RexxBifCallContext("DELSTR")
  call context.setArguments(args, exists)
  result = rexxclassicbif_delstr(reference context)
  if context.hasError() & context.errorCode() = expected_code then return 0
  say "FAIL: DELSTR start expected error" expected_code "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_length_error: procedure = .int
  arg expected_code = .string, delete_length = .string
  args = .RexxValue[]
  exists = .int[]
  args[1] = .RexxValue("abc")
  args[2] = .RexxValue("1")
  args[3] = .RexxValue(delete_length)
  exists[1] = 1
  exists[2] = 1
  exists[3] = 1
  context = .RexxBifCallContext("DELSTR")
  call context.setArguments(args, exists)
  result = rexxclassicbif_delstr(reference context)
  if context.hasError() & context.errorCode() = expected_code then return 0
  say "FAIL: DELSTR length expected error" expected_code "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1
