options levelb comments_dash numeric_classic
import rexxclassicbifs
import rexxclassicbifwordindex
import rexxvalue

errors = 0

errors = errors + check_value("8", "Now is the time", "3")
errors = errors + check_value("0", "Now is the time", "6")
errors = errors + check_value("1", "This is a test", "1")
errors = errors + check_value("3", "  This is a test", "1")
errors = errors + check_value("8", "This   is a test", "2")
errors = errors + check_value("21", "This is certainly a test  ", "5")
errors = errors + check_value("5", "one two three", "2", "UTF8")
errors = errors + check_value("0", "", "1")
errors = errors + check_value("0", "    ", "1", "UTF8")
errors = errors + check_value("5", "one|two", "2", "BYTE_BAR")

errors = errors + check_count_error("RXC-LC-40.3", 0)
errors = errors + check_count_error("RXC-LC-40.3", 1)
errors = errors + check_count_error("RXC-LC-40.4", 3)
errors = errors + check_omitted_error(1)
errors = errors + check_omitted_error(2)
errors = errors + check_wordnum_error("RXC-LC-40.12", "not-a-number")
errors = errors + check_wordnum_error("RXC-LC-40.12", "1.5")
errors = errors + check_wordnum_error("RXC-LC-40.14", "0")
errors = errors + check_wordnum_error("RXC-LC-40.14", "-1")

if errors = 0 then say "PASS: Level C WORDINDEX BIF"
return errors <> 0

check_value: procedure = .int
  arg expected = .string, string = .string, wordnum = .string, profile = "BYTE"
  args = .RexxValue[]
  exists = .int[]
  args[1] = .RexxValue(string)
  args[2] = .RexxValue(wordnum)
  exists[1] = 1
  exists[2] = 1
  context = .RexxBifCallContext("WORDINDEX")
  call configure_profile context, profile
  call context.setArguments(args, exists)
  result = rexxclassicbif_wordindex(reference context)
  if \context.hasError() & result.asString() = expected & args[1].asString() == string then return 0
  say "FAIL: WORDINDEX expected" expected "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

configure_profile: procedure
  arg context = .RexxBifCallContext, profile = .string
  if profile = "UTF8" then call context.useUtf8Profile()
  else if profile = "BYTE_BAR" then do
    blanks = .binary
    blanks = "7C"x
    call context.setByteOtherBlanks(blanks)
  end
  return

check_count_error: procedure = .int
  arg expected_code = .string, count = .int
  args = .RexxValue[]
  exists = .int[]
  do i = 1 to count
    args[i] = .RexxValue("A")
    exists[i] = 1
  end
  context = .RexxBifCallContext("WORDINDEX")
  call context.setArguments(args, exists)
  result = rexxclassicbif_wordindex(reference context)
  if context.hasError() & context.errorCode() = expected_code then return 0
  say "FAIL: WORDINDEX expected error" expected_code "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_omitted_error: procedure = .int
  arg omitted = .int
  args = .RexxValue[]
  exists = .int[]
  do i = 1 to 2
    args[i] = .RexxValue("A")
    exists[i] = i <> omitted
  end
  context = .RexxBifCallContext("WORDINDEX")
  call context.setArguments(args, exists)
  result = rexxclassicbif_wordindex(reference context)
  if context.hasError() & context.errorCode() = "RXC-LC-40.5" then return 0
  say "FAIL: WORDINDEX omitted" omitted "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1

check_wordnum_error: procedure = .int
  arg expected_code = .string, wordnum = .string
  args = .RexxValue[]
  exists = .int[]
  args[1] = .RexxValue("one two")
  args[2] = .RexxValue(wordnum)
  exists[1] = 1
  exists[2] = 1
  context = .RexxBifCallContext("WORDINDEX")
  call context.setArguments(args, exists)
  result = rexxclassicbif_wordindex(reference context)
  if context.hasError() & context.errorCode() = expected_code then return 0
  say "FAIL: WORDINDEX number expected error" expected_code "got" result.asString(),
      context.errorCode() context.errorMessage()
  return 1
