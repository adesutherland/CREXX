options levelb comments_dash numeric_classic
namespace rexxclassiccontext expose RexxClassicContext
import rexxactivation
import rexxpool
import rexxclassicconfig

/**
 * Borrowed Classic activation, visible-pool binding and execution configuration.
 *
 * The caller owns and initializes all three targets and keeps their storage
 * alive for every borrow. This value owns no activation, pool or configuration
 * and does not select a character profile or pool-name policy. Copying it shares
 * the targets but gives the copy its own replaceable pool binding. Pass a
 * reference to one authoritative bundle when helpers must observe rebinding.
 * If a caller explicitly skips REFERENCE_INVALID with a procedure handler, a
 * failed factory returns an unbound bundle, a failed getter returns an empty
 * reference, and a failed bindPool leaves its previous binding unchanged.
 */
RexxClassicContext: class
  activation_ref = reference .rexxactivation..RexxActivationArguments
  pool_ref = reference .rexxpool..RexxVariablePool
  config_ref = reference .rexxclassicconfig..RexxClassicConfig

  /**
   * Borrow existing caller-owned objects without copying or extending lifetime.
   * @param activation reference to stable activation storage
   * @param pool reference to stable visible-pool storage
   * @param config reference to stable execution-configuration storage
   * @return a value bundle whose fields retain the supplied references
   * @throws REFERENCE_INVALID if any reference is empty or expired
   */
  *: factory
    arg activation = reference .rexxactivation..RexxActivationArguments, pool = reference .rexxpool..RexxVariablePool, config = reference .rexxclassicconfig..RexxClassicConfig
    if <refvalid>(activation) = 0 then do
      assembler signal "REFERENCE_INVALID", "Classic activation reference is not live"
      return
    end
    if <refvalid>(pool) = 0 then do
      assembler signal "REFERENCE_INVALID", "Classic pool reference is not live"
      return
    end
    if <refvalid>(config) = 0 then do
      assembler signal "REFERENCE_INVALID", "Classic configuration reference is not live"
      return
    end
    activation_ref = activation
    pool_ref = pool
    config_ref = config
    return

  /**
   * @return the borrowed activation reference, without copying its state
   * @throws REFERENCE_INVALID if the activation owner has expired
   */
  activation: method = reference .rexxactivation..RexxActivationArguments
    if <refvalid>(activation_ref) = 0 then do
      assembler signal "REFERENCE_INVALID", "Classic activation reference is not live"
      empty_activation = reference .rexxactivation..RexxActivationArguments
      return empty_activation
    end
    return activation_ref

  /**
   * @return this bundle's current borrowed visible-pool reference
   * @throws REFERENCE_INVALID if the current pool owner has expired
   */
  pool: method = reference .rexxpool..RexxVariablePool
    if <refvalid>(pool_ref) = 0 then do
      assembler signal "REFERENCE_INVALID", "Classic pool reference is not live"
      empty_pool = reference .rexxpool..RexxVariablePool
      return empty_pool
    end
    return pool_ref

  /**
   * @return the borrowed execution-configuration reference
   * @throws REFERENCE_INVALID if the configuration owner has expired
   */
  config: method = reference .rexxclassicconfig..RexxClassicConfig
    if <refvalid>(config_ref) = 0 then do
      assembler signal "REFERENCE_INVALID", "Classic configuration reference is not live"
      empty_config = reference .rexxclassicconfig..RexxClassicConfig
      return empty_config
    end
    return config_ref

  /**
   * Replace only this bundle's pool binding; leave the old binding on failure.
   * @param pool reference to replacement caller-owned pool storage
   * @throws REFERENCE_INVALID if the replacement reference is empty or expired
   */
  bindPool: method = .void
    arg pool = reference .rexxpool..RexxVariablePool
    if <refvalid>(pool) = 0 then do
      assembler signal "REFERENCE_INVALID", "Classic replacement pool reference is not live"
      return
    end
    pool_ref = pool
    return
