options levelb comments_dash numeric_classic
namespace rexxclassicconditionevent expose RexxClassicConditionEvent

/**
 * Typed payload of VM CLASSIC_CONDITION (code 29). The VM event supplies the
 * causing source; this value supplies the Classic condition and description.
 * SYNTAX remains a separate VM event (code 28). Condition IDs match the
 * activation's seven-slot policy: 2 ERROR, 3 FAILURE, 4 HALT, 5 NOTREADY,
 * 6 NOVALUE, 7 LOSTDIGITS.
 */
RexxClassicConditionEvent: class
  event_condition = .int
  event_description = .string

  /**
   * @param condition_id one of the six non-SYNTAX Classic condition IDs
   * @param detail condition description, kept as valid Unicode text
   * @signal INVALID_ARGUMENTS if the condition ID is outside 2..7
   */
  *: factory
    arg condition_id = .int, detail = .string
    if condition_id < 2 | condition_id > 7 then do
      assembler signal "INVALID_ARGUMENTS", "Invalid Classic condition ID"
    end
    event_condition = condition_id
    event_description = detail
    return

  /** @return the one-based Classic condition ID */
  conditionId: method = .int
    return event_condition

  /** @return the condition description without altering Unicode text */
  description: method = .string
    return event_description
