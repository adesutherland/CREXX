options levelb comments_dash numeric_classic
namespace rexxclassicbifd2x expose rexxclassicbif_d2x rexxclassic_decimal_to_hex rexxclassic_fit_hex
import rexxclassicbifs
import rexxvalue

/**
 * Convert a Classic whole-number argument to hexadecimal.
 *
 * @bif D2X
 * @signature D2X(number [,length])
 * @checkargs rWHOLENUM>=0, or rWHOLENUM rWHOLE>=0
 * @sandbox pure
 * @return uppercase hexadecimal text as a RexxValue
 */
rexxclassicbif_d2x: procedure = .RexxValue
  numeric digits inherited
  numeric form inherited
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()

  if context.argumentExists(2) then checklist = "rWHOLENUM rWHOLE>=0"
  else checklist = "rWHOLENUM>=0 oWHOLE>=0"
  if rexxclassicbif_check_args(context_ref, checklist) = 0 then return .RexxValue("")

  number = context.argumentText(1)
  number_length = .int
  first_codepoint = .int
  start = 0
  negative = 0
  magnitude = number
  assembler strlen number_length,number
  assembler strchar first_codepoint,number,start
  if first_codepoint = 45 then do
    negative = 1
    start = 1
    number_length = number_length - 1
    magnitude = ""
    assembler setstrpos number,start
    assembler substring magnitude,number,number_length
  end
  result = rexxclassic_decimal_to_hex(magnitude, negative)

  if context.argumentExists(2) then do
    output_length = .int
    output_length = context.argumentText(2)
    result = rexxclassic_fit_hex(result, output_length, negative)
  end
  return .RexxValue(result)

/* Convert plain decimal magnitude digits using mutable base-1e9 limbs. */
rexxclassic_decimal_to_hex: procedure = .string
  arg decimal_digits = .string, negative = .int
  limbs = .int[]
  hex_digits = .int[]
  decimal_length = .int
  first_chunk_length = .int
  chunk_length = .int
  limb_count = 0
  first_limb = 1
  offset = 0
  carry = .int
  combined = .int
  quotient = .int
  hex_count = 0
  digit = .int
  codepoint = .int
  table = "0123456789ABCDEF"
  result = ""

  assembler strlen decimal_length,decimal_digits
  assembler imod first_chunk_length,decimal_length,9
  if first_chunk_length = 0 then first_chunk_length = 9
  chunk_length = first_chunk_length
  do while offset < decimal_length
    segment = ""
    assembler setstrpos decimal_digits,offset
    assembler substring segment,decimal_digits,chunk_length
    limb_count = limb_count + 1
    limbs[limb_count] = segment
    offset = offset + chunk_length
    chunk_length = 9
  end

  do while first_limb <= limb_count
    carry = 0
    do i = first_limb to limb_count
      combined = carry * 1000000000 + limbs[i]
      assembler idiv quotient,combined,16
      assembler imod carry,combined,16
      limbs[i] = quotient
    end
    hex_count = hex_count + 1
    hex_digits[hex_count] = carry
    do while first_limb <= limb_count & limbs[first_limb] = 0
      first_limb = first_limb + 1
    end
  end

  if negative then do
    carry = 1
    do i = 1 to hex_count
      digit = 15 - hex_digits[i] + carry
      if digit >= 16 then do
        digit = digit - 16
        carry = 1
      end
      else carry = 0
      hex_digits[i] = digit
    end
  end

  do i = hex_count to 1 by -1
    digit = hex_digits[i]
    assembler strchar codepoint,table,digit
    assembler appendchar result,codepoint
  end
  return result

/* Apply exact Classic width using zero/sign padding or low-digit truncation. */
rexxclassic_fit_hex: procedure = .string
  arg source = .string, output_length = .int, negative = .int
  source_length = .int
  start = .int
  padding_count = .int
  pad_character = 48
  result = ""

  if output_length = 0 then return result
  assembler strlen source_length,source
  if source_length > output_length then do
    start = source_length - output_length
    assembler setstrpos source,start
    assembler substring result,source,output_length
    return result
  end
  if source_length = output_length then return source

  if negative then pad_character = 70
  padding_count = output_length - source_length
  assembler padstr result,pad_character,padding_count
  assembler append result,source
  return result
