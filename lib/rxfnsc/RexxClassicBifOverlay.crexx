options levelb comments_dash numeric_classic
namespace rexxclassicbifoverlay expose rexxclassicbif_overlay
import rexxclassicbifs
import rexxclassiccharacterops
import rexxclassiccharacterscan
import rexxvalue

/**
 * Overlay formatted text onto a Classic target string.
 *
 * @bif OVERLAY
 * @signature OVERLAY(new, target [,start [,length [,pad]]])
 * @checkargs rANY rANY oWHOLE>0 oWHOLE>=0 oPAD
 * @sandbox pure
 * @return target with the formatted overlay as a RexxValue
 */
rexxclassicbif_overlay: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY rANY oWHOLE>0 oWHOLE>=0 oPAD") = 0 then return .RexxValue("")

  start = 1
  if context.argumentExists(3) then start = context.argumentText(3) + 0
  length_supplied = context.argumentExists(4)
  overlay_length = 0
  if length_supplied then overlay_length = context.argumentText(4) + 0
  config = context.characterConfig()

  if config.isByteProfile() then do
    new_bytes = context.argument(1).asBinary()
    target_bytes = context.argument(2).asBinary()
    pad_bytes = .binary
    if context.argumentExists(5) then pad_bytes = context.argument(5).asBinary()
    else pad_bytes = " " as .binary
    new_length = .int
    target_length = .int
    pad_byte = .int
    pad_index = 0
    before = start - 1
    assembler blen new_length,new_bytes
    assembler blen target_length,target_bytes
    assembler getbyte pad_byte,pad_bytes,pad_index
    if \length_supplied then overlay_length = new_length
    if overlay_length = 0 & before <= target_length then return .RexxValue.fromBinary(target_bytes)
    result_bytes = .binary
    if before > 0 then do
      if before >= target_length then do
        assembler bappend result_bytes,target_bytes
        if before > target_length then do
          padding_needed = before - target_length
          padding_bytes = rexxclassic_byte_slice_pad("" as .binary,0,0,padding_needed,pad_byte)
          assembler bappend result_bytes,padding_bytes
        end
      end
      else do
        segment_bytes = rexxclassic_byte_slice(target_bytes,0,before)
        assembler bappend result_bytes,segment_bytes
      end
    end
    if overlay_length > 0 then do
      copy_length = overlay_length
      if new_length < copy_length then copy_length = new_length
      segment_bytes = .binary
      segment_bytes = rexxclassic_byte_slice_pad(new_bytes,0,copy_length,overlay_length,pad_byte)
      assembler bappend result_bytes,segment_bytes
    end
    tail_start = before + overlay_length
    if tail_start < target_length then do
      tail_length = target_length - tail_start
      segment_bytes = .binary
      segment_bytes = rexxclassic_byte_slice(target_bytes,tail_start,tail_length)
      assembler bappend result_bytes,segment_bytes
    end
    return .RexxValue.fromBinary(result_bytes)
  end

  new_string = context.argumentText(1)
  target = context.argumentText(2)
  pad = " "
  if context.argumentExists(5) then pad = context.argumentText(5)

  new_length = .int
  target_length = .int
  pad_character = .int
  pad_index = .int
  pad_index = 0
  before = .int
  padding_needed = .int
  tail_start = .int
  tail_length = .int
  cursor = 0
  padding = ""
  segment = ""
  result = ""

  assembler strlen new_length,new_string
  assembler strlen target_length,target
  if \length_supplied then overlay_length = new_length
  before = start - 1
  if overlay_length = 0 & before <= target_length then return .RexxValue(target)

  assembler strchar pad_character,pad,pad_index

  if before > 0 then do
    if before >= target_length then do
      assembler scopy result,target
      if before > target_length then do
        padding_needed = before - target_length
        padding = ""
        assembler padstr padding,pad_character,padding_needed
        assembler append result,padding
      end
    end
    else do
      assembler substring result,target,cursor,before
    end
  end

  if overlay_length > 0 then do
    if overlay_length >= new_length then do
      if new_length > 0 then assembler append result,new_string
      if overlay_length > new_length then do
        padding_needed = overlay_length - new_length
        padding = ""
        assembler padstr padding,pad_character,padding_needed
        assembler append result,padding
      end
    end
    else do
      assembler substring segment,new_string,cursor,overlay_length
      assembler append result,segment
    end
  end

  tail_start = before + overlay_length
  if tail_start < target_length then do
    tail_length = target_length - tail_start
    assembler substring segment,target,tail_start,tail_length
    assembler append result,segment
  end
  return .RexxValue(result)
