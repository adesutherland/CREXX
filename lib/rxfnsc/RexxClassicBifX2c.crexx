options levelb comments_dash numeric_classic
namespace rexxclassicbifx2c expose rexxclassicbif_x2c
import rexxclassicbifs
import rexxclassicencoding
import rexxvalue

/** Convert validated hexadecimal text to exact configured character bytes. */
rexxclassicbif_x2c: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rHEX") = 0 then return .RexxValue("")

  bytes = rexxclassic_hex_to_bytes(context.argumentText(1))
  config = context.characterConfig()
  if config.isUtf8Profile() & rexxclassic_bytes_are_utf8(bytes) then
    return .RexxValue.fromBinaryText(bytes)
  return .RexxValue.fromBinary(bytes)
