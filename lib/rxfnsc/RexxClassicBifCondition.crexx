options levelb comments_dash numeric_classic
namespace rexxclassicbifcondition expose rexxclassicbif_condition
import rexxclassicbifs
import rexxactivation
import rexxvalue

/**
 * Read the current Classic invocation's last trapped condition.
 *
 * @bif CONDITION
 * @signature CONDITION([option])
 * @checkargs oCDEIS
 * @param context_ref BIF operands and diagnostic context
 * @param activation_ref active Classic invocation
 * @return condition name, description, extra data, trapping instruction, or current state
 * @sandbox activation-local
 */
rexxclassicbif_condition: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext, activation_ref = reference .RexxActivationArguments
  context = dereference context_ref
  activation = dereference activation_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "oCDEIS") = 0 then return .RexxValue("")

  option = "I"
  if context.argumentExists(1) then option = context.argumentText(1)
  if option = "C" then return .RexxValue(activation.currentConditionName())
  if option = "D" then return .RexxValue(activation.currentConditionDescription())
  if option = "E" then return .RexxValue(activation.currentConditionExtra())
  if option = "I" then return .RexxValue(activation.currentConditionInstruction())
  condition_id = activation.currentConditionId()
  if condition_id = 0 then return .RexxValue("")
  if activation.signalPolicy(condition_id) > 0 then return .RexxValue("ON")
  return .RexxValue("OFF")
