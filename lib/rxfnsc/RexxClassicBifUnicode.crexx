  return .RexxValue("")

/**
 * Explicit isDecodable over Classic codepoint/ordinal strings.
 * @bif ISDECODABLE
 * @checkargs rANY oANY
 * @return Unicode text, an ordinal byte string, or an exact scalar result
 * @signal CLASSIC_SYNTAX argument/conversion failures at the authored call
 */
rexxclassicbif_isdecodable: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY oANY") = 0 then return .RexxValue("")
  do
    encoding = "UTF-8"
    if context.argumentExists(2) then encoding = context.argumentText(2)
    bytes = _ordinal_argument(context_ref,1)
    if context.hasError() then return .RexxValue("")
    return .RexxValue(rxunicode..isDecodable(bytes,encoding) || "")
  on signal unicode_error as problem
    call rexxclassicbif_set_error(context_ref,"23.1",1,problem.message(),"")
  on signal invalid_arguments as problem
    call rexxclassicbif_set_error(context_ref,"40",0,problem.message(),"")
  on signal out_of_range as problem
    call rexxclassicbif_set_error(context_ref,"40",0,problem.message(),"")
  end
  return .RexxValue("")

/** Materialize encoded bytes from the fixed Classic ordinal domain. */
_ordinal_argument: procedure = .binary
  arg context_ref = reference .RexxBifCallContext, index = .int
  context = dereference context_ref
  text = context.argumentText(index)
  if \rexxclassic_text_is_latin1(text) then do
    call rexxclassicbif_set_error(context_ref,"23.1",index,text,"")
    return "" as .binary
  end
  return rexxclassic_text_to_latin1(text)
