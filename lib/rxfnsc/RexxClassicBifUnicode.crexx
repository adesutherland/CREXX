/**
 * Explicit encode over Classic codepoint/ordinal strings.
 * @bif ENCODE
 * @checkargs rANY oANY oANY
 * @return Unicode text, an ordinal byte string, or an exact scalar result
 * @signal CLASSIC_SYNTAX argument/conversion failures at the authored call
 */
rexxclassicbif_encode: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY oANY oANY") = 0 then return .RexxValue("")
  do
    encoding = "UTF-8"
    if context.argumentExists(2) then encoding = context.argumentText(2)
    bytes = .binary
    if context.argumentExists(3) then do
      replacement = _ordinal_argument(context_ref,3)
      if context.hasError() then return .RexxValue("")
      bytes = rxunicode..encode(context.argumentText(1),encoding,replacement)
    end
    else bytes = rxunicode..encode(context.argumentText(1),encoding)
    return .RexxValue(rexxclassic_latin1_to_text(bytes))
  on signal unicode_error as problem
    call rexxclassicbif_set_error(context_ref,"23.1",1,problem.message(),"")
  on signal invalid_arguments as problem
    call rexxclassicbif_set_error(context_ref,"40",0,problem.message(),"")
  on signal out_of_range as problem
    call rexxclassicbif_set_error(context_ref,"40",0,problem.message(),"")
  end
  return .RexxValue("")

/**
 * Explicit decode over Classic codepoint/ordinal strings.
 * @bif DECODE
 * @checkargs rANY oANY oANY
 * @return Unicode text, an ordinal byte string, or an exact scalar result
 * @signal CLASSIC_SYNTAX argument/conversion failures at the authored call
 */
rexxclassicbif_decode: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY oANY oANY") = 0 then return .RexxValue("")
  do
    encoding = "UTF-8"
    if context.argumentExists(2) then encoding = context.argumentText(2)
    bytes = _ordinal_argument(context_ref,1)
    if context.hasError() then return .RexxValue("")
    if context.argumentExists(3) then return .RexxValue(rxunicode..decode(bytes,encoding,context.argumentText(3)))
    return .RexxValue(rxunicode..decode(bytes,encoding))
  on signal unicode_error as problem
    call rexxclassicbif_set_error(context_ref,"23.1",1,problem.message(),"")
  on signal invalid_arguments as problem
    call rexxclassicbif_set_error(context_ref,"40",0,problem.message(),"")
  on signal out_of_range as problem
    call rexxclassicbif_set_error(context_ref,"40",0,problem.message(),"")
