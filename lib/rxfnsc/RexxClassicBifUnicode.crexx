/**
 * Explicit graphemeSubstr over Classic codepoint/ordinal strings.
 * @bif GRAPHEMESUBSTR
 * @checkargs rANY rWHOLE>0 oWHOLE>=0 oANY
 * @return Unicode text, an ordinal byte string, or an exact scalar result
 * @signal CLASSIC_SYNTAX argument/conversion failures at the authored call
 */
rexxclassicbif_graphemesubstr: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rANY rWHOLE>0 oWHOLE>=0 oANY") = 0 then return .RexxValue("")
  do
    start = (context.argumentText(2) as .int)
    if context.argumentExists(3) then do
      count = (context.argumentText(3) as .int)
      if context.argumentExists(4) then return .RexxValue(rxunicode..graphemeSubstr(context.argumentText(1),start,count,context.argumentText(4)))
      return .RexxValue(rxunicode..graphemeSubstr(context.argumentText(1),start,count))
    end
    if context.argumentExists(4) then return .RexxValue(rxunicode..graphemeSubstr(context.argumentText(1),start,,context.argumentText(4)))
    return .RexxValue(rxunicode..graphemeSubstr(context.argumentText(1),start))
  on signal unicode_error as problem
    call rexxclassicbif_set_error(context_ref,"23.1",1,problem.message(),"")
  on signal invalid_arguments as problem
    call rexxclassicbif_set_error(context_ref,"40",0,problem.message(),"")
  on signal out_of_range as problem
    call rexxclassicbif_set_error(context_ref,"40",0,problem.message(),"")
  end
  return .RexxValue("")

