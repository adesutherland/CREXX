options levelb comments_dash numeric_classic
namespace rexxclassicbiftrace expose rexxclassicbif_trace rexxclassicbif_trace_frame
import rexxclassicbifs
import rexxpool
import rexxvalue
import rexxactivation

/**
 * Query or update the caller activation's Classic TRACE BIF state.
 *
 * @bif TRACE
 * @signature TRACE([option])
 * @checkargs oANY
 * @sandbox reads and updates only the caller activation's TRACE state
 * @return trace setting in effect before this call
 */
rexxclassicbif_trace: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "oANY") = 0 then return .RexxValue("")

  pool_ref = reference .RexxVariablePool
  pool_ref = context.callerPool()
  pool = dereference pool_ref
  previous = pool.traceSetting()
  if context.argumentExists(1) then do
    if \pool.setTraceOption(context.argumentText(1)) then do
      call rexxclassicbif_set_error(context_ref, "40.28", 1, context.argumentText(1), "ACEFILNOR")
      return .RexxValue("")
    end
  end
  return .RexxValue(previous)

/** Compiled Level C reads and changes the invocation, even when its pool is shared. */
rexxclassicbif_trace_frame: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext, activation_ref = reference .RexxActivationArguments
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "oANY") = 0 then return .RexxValue("")
  activation = dereference activation_ref
  previous = activation.traceSetting()
  if context.argumentExists(1) then do
    if \activation.setTraceOption(context.argumentText(1)) then do
      call rexxclassicbif_set_error(context_ref, "40.28", 1, context.argumentText(1), "ACEFILNOR")
      return .RexxValue("")
    end
  end
  return .RexxValue(previous)
