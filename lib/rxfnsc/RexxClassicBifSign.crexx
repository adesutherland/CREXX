options levelb comments_dash numeric_classic
namespace rexxclassicbifsign expose rexxclassicbif_sign
import rexxclassicbifs
import rexxvalue

/**
 * Return the sign of one Classic numeric argument.
 *
 * @bif SIGN
 * @signature SIGN(number)
 * @checkargs rNUM
 * @sandbox pure
 * @return `-1`, `0`, or `1` as a RexxValue integer
 */
rexxclassicbif_sign: procedure = .RexxValue
  arg context_ref = reference .RexxBifCallContext
  context = dereference context_ref
  call context.clearError()
  if rexxclassicbif_check_args(context_ref, "rNUM") = 0 then return .RexxValue("")
  value = "0" as .decimal
  value = context.argument(1).asDecimal()
  if value > 0 then return .RexxValue.fromInt(1)
  if value < 0 then return .RexxValue.fromInt(-1)
  return .RexxValue.fromInt(0)
