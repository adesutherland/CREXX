/* Focused transitional boxed-array statistics contract. */
options levelb floats_binary

import rxstats

check_close: procedure = .int
  arg actual = .float, expected = .float, tolerance = .float, label = .string
  difference = actual - expected
  if difference < 0.0 then difference = -difference
  if difference <= tolerance then return 0
  say "FAIL:" label "expected=" expected "actual=" actual
  return 1

check_invalid_empty: procedure = .int
  values = .float[]
  do
    ignored = rxstats..mean(values)
    say "FAIL: empty mean did not signal"
    return 1
  on signal invalid_arguments as problem
    if pos("RXSTATS.MEAN", problem.message()) > 0 then return 0
    say "FAIL: empty mean signal identity" problem.message()
    return 1
  end
  return 1

check_invalid_pairs: procedure = .int
  x = .float[]
  y = .float[]
  x[1] = 1.0
  y[1] = 1.0
  y[2] = 2.0
  do
    ignored = rxstats..covariance(x, y)
    say "FAIL: unequal covariance did not signal"
    return 1
  on signal invalid_arguments as problem
    if pos("RXSTATS.COVARIANCE", problem.message()) > 0 then return 0
    say "FAIL: unequal covariance signal identity" problem.message()
    return 1
  end
  return 1

check_invalid_stddev: procedure = .int
  values = .float[]
  values[1] = 1.0
  do
    ignored = rxstats..stddev(values)
    say "FAIL: singleton stddev did not signal"
    return 1
  on signal invalid_arguments as problem
    if pos("RXSTATS.STDDEV", problem.message()) > 0 then return 0
    say "FAIL: singleton stddev signal identity" problem.message()
    return 1
  end
  return 1

check_invalid_covariance_count: procedure = .int
  x = .float[]
  y = .float[]
  x[1] = 1.0
  y[1] = 2.0
  do
    ignored = rxstats..covariance(x, y)
    say "FAIL: singleton covariance did not signal"
    return 1
  on signal invalid_arguments as problem
    if pos("RXSTATS.COVARIANCE", problem.message()) > 0 then return 0
    say "FAIL: singleton covariance signal identity" problem.message()
    return 1
  end
  return 1

check_invalid_correlation: procedure = .int
  x = .float[]
  y = .float[]
  x[1] = 1.0
  x[2] = 1.0
  y[1] = 1.0
  y[2] = 2.0
  do
    ignored = rxstats..correlation(x, y)
    say "FAIL: zero-variance correlation did not signal"
    return 1
  on signal invalid_arguments as problem
    if pos("RXSTATS.CORRELATION", problem.message()) > 0 then return 0
    say "FAIL: zero-variance correlation signal identity" problem.message()
    return 1
  end
  return 1

check_invalid_regression: procedure = .int
  x = .float[]
  y = .float[]
  slope = 0.0
  intercept = 0.0
  x[1] = 1.0
  x[2] = 1.0
  y[1] = 1.0
  y[2] = 2.0
  do
    ignored = rxstats..regression(x, y, slope, intercept)
    say "FAIL: zero-variance regression did not signal"
    return 1
  on signal invalid_arguments as problem
    if pos("RXSTATS.REGRESSION", problem.message()) > 0 then return 0
    say "FAIL: zero-variance regression signal identity" problem.message()
    return 1
  end
  return 1

main: procedure = .int
  values = .float[]
  x = .float[]
  y = .float[]
  stable = .float[]
  large_x = .float[]
  large_y = .float[]
  slope = 0.0
  intercept = 0.0
  failures = 0

  values[1] = 2.0
  values[2] = 4.0
  values[3] = 4.0
  values[4] = 4.0
  values[5] = 5.0
  values[6] = 5.0
  values[7] = 7.0
  values[8] = 9.0

  x[1] = 1.0
  x[2] = 2.0
  x[3] = 3.0
  x[4] = 4.0
  y[1] = 3.0
  y[2] = 5.0
  y[3] = 7.0
  y[4] = 9.0

  stable[1] = 1000000000000.0
  stable[2] = 1000000000001.0
  stable[3] = 1000000000002.0

  do index = 1 to 256
    large_x[index] = 1000000000000.0 + ((index - 1) <mod> 17)
    large_y[index] = 3.0 * large_x[index] + 7.0
  end

  failures = failures + check_close(rxstats..mean(values), 5.0, 0.0, "mean")
  failures = failures + check_close(rxstats..stddev(values), 2.138089935299395, 0.000000000001, "sample stddev")
  failures = failures + check_close(rxstats..covariance(x, y), 3.333333333333333, 0.000000000000004, "sample covariance")
  failures = failures + check_close(rxstats..correlation(x, y), 1.0, 0.000000000000002, "correlation")
  failures = failures + check_close(rxstats..mean(stable), 1000000000001.0, 0.0, "stable large-offset mean")
  failures = failures + check_close(rxstats..stddev(large_x), 4.92442890089805, 0.00000000000001, "large-offset sample stddev")
  failures = failures + check_close(rxstats..covariance(large_x, large_y), 72.75, 0.0, "large-offset sample covariance")
  failures = failures + check_close(rxstats..correlation(large_x, large_y), 1.0, 0.0, "large-offset correlation")
  ignored = rxstats..regression(x, y, slope, intercept)
  failures = failures + check_close(slope, 2.0, 0.0, "regression slope")
  failures = failures + check_close(intercept, 1.0, 0.0, "regression intercept")
  failures = failures + check_invalid_empty()
  failures = failures + check_invalid_stddev()
  failures = failures + check_invalid_pairs()
  failures = failures + check_invalid_covariance_count()
  failures = failures + check_invalid_correlation()
  failures = failures + check_invalid_regression()

  if failures > 0 then return 1
  say "PASS: rxstats transitional boxed-array contract"
  return 0
