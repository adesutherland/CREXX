/* RXMATH deterministic plugin test */
options levelb
import rxmath
import rxfnsb

errors = 0

identifier = uuid()
errors = errors + check(length(identifier) = 36, "UUID length")
errors = errors + check(sqrt(16) = 4, "SQRT")
errors = errors + check(pow(2,3) = 8, "POW")
errors = errors + check(floor(pi()) = 3, "FLOOR")
errors = errors + check(ceil(pi()) = 4, "CEIL")
errors = errors + check(fmod(7,4) = 3, "FMOD")
errors = errors + check(sin(0) = 0, "SIN")

if errors <> 0 then do
  say "rxmath failures:" errors
  exit 1
end

say "PASS: rxmath deterministic helpers"
exit 0

check: procedure = .int
  arg ok = .boolean, label = .string
  if \ok then do
    say "rxmath failed:" label
    return 1
  end
  return 0
