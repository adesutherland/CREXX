/* RXTCP self-contained loopback test */
options levelb
import rxtcp

call tcpflags "NDEBUG"

connections = .string[]
port = 32310
last_port = 32350
server = -1

do while port <= last_port
  server = tcpserver(port, connections)
  if server >= 0 then leave
  port = port + 1
end

if server < 0 then do
  say "rxtcp failed: no loopback port available"
  exit 1
end

client = tcpopen("127.0.0.1", port)
if client < 0 then do
  say "rxtcp failed: tcpopen returned" client
  call tcpclose server
  exit 1
end

accepted = tcpwait(server, 1000, connections)
if accepted < 0 then do
  say "rxtcp failed: tcpwait returned" accepted
  call tcpclose client
  call tcpclose server
  exit 1
end

send_rc = tcpsend(client, "ping")
if send_rc <> 0 then do
  say "rxtcp failed: tcpsend returned" send_rc
  call tcpclose client
  call tcpclose accepted
  call tcpclose server
  exit 1
end

if tcpclose(client) <> 0 then do
  say "rxtcp failed: client close"
  call tcpclose accepted
  call tcpclose server
  exit 1
end

received = tcpreceive(accepted, 1000)
if received <> "ping" then do
  say "rxtcp failed: expected [ping] got ["received"]"
  call tcpclose accepted
  call tcpclose server
  exit 1
end

if tcpclose(accepted) <> 0 then do
  say "rxtcp failed: accepted socket close"
  call tcpclose server
  exit 1
end
if tcpclose(server) <> 0 then do
  say "rxtcp failed: server close"
  exit 1
end

if tcpopen("127.0.0.1", 0) <> -2 then do
  say "rxtcp failed: invalid port was not rejected"
  exit 1
end

say "PASS: rxtcp self-contained loopback"
exit 0
