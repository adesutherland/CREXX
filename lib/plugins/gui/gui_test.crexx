options levelb
import gui

arg test_args = .string[]

automated = test_args.0 > 0
failures = 0

if rgb_to_hex(255, 0, 16) \= "#FF0010" then do
    say "FAIL: rgb_to_hex did not preserve the requested components"
    failures = failures + 1
end
if rgb_to_hex(256, 0, 0) \= "" then do
    say "FAIL: rgb_to_hex accepted an out-of-range component"
    failures = failures + 1
end

if \automated then
    call splash_pick "cREXX GTK plugin", "GTK 3 loaded successfully", 1, 420, 180, ""

init_rc = init_window("cREXX GTK plugin", 460, 240)
if init_rc \= 1 then do
    say "FAIL: GTK could not initialize a window"
    exit 1
end

title = add_text("The cREXX GTK plugin is active.", 20, 20)
edit = add_edit(20, 60, 410)
set_edit_rc = set_edit(edit, "Edit-field round trip")
edit_text = get_edit(edit)
ok_button = add_button("OK", 120, 110)
cancel_button = add_button("Cancel", 240, 110)
status = add_status_bar()

if title < 1 | edit < 1 | ok_button < 1 | cancel_button < 1 | status < 1 then do
    say "FAIL: one or more widgets could not be created"
    failures = failures + 1
end
if set_edit_rc \= 1 | edit_text \= "Edit-field round trip" then do
    say "FAIL: edit-field set/get contract failed: rc=" set_edit_rc "text=<"edit_text">"
    failures = failures + 1
end
if set_status(status, "Ready: choose OK or Cancel") \= 1 then do
    say "FAIL: status-bar update failed"
    failures = failures + 1
end
if show_window(-1, -1) \= 1 then do
    say "FAIL: main window could not be shown"
    failures = failures + 1
end

event_token = .int
if automated then do
    event_token = process_events(50)
    if event_token \= 0 then do
        say "FAIL: idle event processing returned" event_token "instead of 0"
        failures = failures + 1
    end
end
else do forever
    event_token = process_events(250)
    if event_token < 0 then leave
    if event_token = ok_button then do
        call set_status status, "OK selected"
        leave
    end
    if event_token = cancel_button then do
        call set_status status, "Cancel selected"
        leave
    end
end

call cleanup_gui

/* A second lifecycle catches stale widget, graph, and display state. */
if init_window("cREXX GTK lifecycle check", 240, 120) \= 1 then do
    say "FAIL: GTK window could not be reinitialized after cleanup"
    failures = failures + 1
end
call cleanup_gui

if failures > 0 then exit 1
say "PASS: gui GTK public contract"
exit 0
