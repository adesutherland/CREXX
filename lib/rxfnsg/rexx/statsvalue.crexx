/**
 * Immutable result values returned by the native `rxstats` provider.
 *
 * The private representation uses the same host-native packed float primitive
 * as `.packedfloat`, but it is deliberately not a public positional or binary
 * interface.
 *
 * @docType runtime-module
 */
options levelg

namespace rxstats expose linearfit
import rxfnsb

/** Immutable slope and intercept returned by ordinary least-squares fitting. */
linearfit: class
  _data = .binary with register.0.binary

  /**
   * Construct a linear-fit value.
   *
   * @param slope fitted gradient
   * @param intercept fitted value at x equals zero
   */
  *: factory
    arg slope = .float, intercept = .float
    data = .binary
    call binresize data, 2 * <sizeof..float>
    <packed..float>(0) data = slope
    <packed..float>(1) data = intercept
    _data = data
    return

  /** @return fitted gradient */
  slope: method = .float
    return <packed..float>(0) _data

  /** @return fitted value at x equals zero */
  intercept: method = .float
    return <packed..float>(1) _data
