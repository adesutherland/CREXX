/*
 * cREXX License (MIT)
 *
 * Context-preserving decimal mathematics for the Level G standard library.
 */

/**
 * Level-B-authored decimal algorithms over the core mc_decimal arithmetic.
 * Public entry points inherit the caller's precision. Computation selects an
 * 18, 32, or 64 digit work context, then the public frame rounds once into the
 * caller's context.
 *
 * @docType runtime-module
 */
options levelb

namespace rxdecimal expose sqrt exp ln sin cos pi euler
import rxfnsb

_rxdecimal_abs: procedure = .decimal
  numeric digits inherited
  arg value = .decimal
  if value < 0 then return 0 - value
  return value

_rxdecimal_pi_work: procedure = .decimal
  numeric digits inherited
  value = .decimal
  value = "3.141592653589793238462643383279502884197169399375105820974944592307816" as .decimal
  return value

_rxdecimal_e_work: procedure = .decimal
  numeric digits inherited
  value = .decimal
  value = "2.718281828459045235360287471352662497757247093699959574966967627724077" as .decimal
  return value

/** Newton iteration in the selected work context. */
_rxdecimal_sqrt_work: procedure = .decimal
  numeric digits inherited
  arg value = .decimal
  if value = 0 then return 0
  estimate = value
  if estimate < 1 then estimate = 1
  do iteration = 1 to 512
    next = (estimate + value / estimate) / 2
    if next = estimate then return next
    estimate = next
  end
  assembler signal "FAILURE", "RXDECIMAL.SQRT did not converge"
  return 0

/** Halving and Taylor recurrence in the selected work context. */
_rxdecimal_exp_work: procedure = .decimal
  numeric digits inherited
  arg value = .decimal
  if value < 0 then return 1 / _rxdecimal_exp_work(0 - value)

  reduced = value
  squarings = 0
  do while reduced > 0.5
    reduced = reduced / 2
    squarings = squarings + 1
    if squarings > 4096 then
      assembler signal "OVERFLOW_UNDERFLOW", "RXDECIMAL.EXP argument is outside the supported range"
  end
  total = .decimal
  term = .decimal
  total = 1
  term = 1
  do denominator = 1 to 4096
    term = term * reduced / denominator
    next = total + term
    if next = total then leave
    total = next
  end
  do squarings
    total = total * total
  end
  return total

/** Repeated-square-root reduction and atanh series for natural logarithm. */
_rxdecimal_ln_work: procedure = .decimal
  numeric digits inherited
  arg value = .decimal
  reduced = value
  multiplier = 1
  do while reduced < 0.75 | reduced > 1.5
    reduced = _rxdecimal_sqrt_work(reduced)
    multiplier = multiplier * 2
  end

  ratio = (reduced - 1) / (reduced + 1)
  ratio_squared = ratio * ratio
  term = ratio
  total = ratio
  denominator = 3
  do iteration = 1 to 4096
    term = term * ratio_squared
    next = total + term / denominator
    if next = total then leave
    total = next
    denominator = denominator + 2
  end
  return 2 * multiplier * total

/** Reduce an angle to [-pi, pi] without converting through binary float. */
_rxdecimal_reduce_angle: procedure = .decimal
  numeric digits inherited
  arg value = .decimal
  pi_value = _rxdecimal_pi_work()
  period = 2 * pi_value
  quotient = trunc(value / period)
  reduced = value - quotient * period
  if reduced > pi_value then reduced = reduced - period
  if reduced < 0 - pi_value then reduced = reduced + period
  return reduced

/** Quadrant reduction plus a Taylor recurrence for sine. */
_rxdecimal_sin_work: procedure = .decimal
  numeric digits inherited
  arg value = .decimal
  pi_value = _rxdecimal_pi_work()
  half_pi = pi_value / 2
  reduced = _rxdecimal_reduce_angle(value)
  if reduced > half_pi then reduced = pi_value - reduced
  if reduced < 0 - half_pi then reduced = 0 - pi_value - reduced

  square = reduced * reduced
  term = reduced
  total = reduced
  do index = 1 to 4096
    denominator = (2 * index) * (2 * index + 1)
    term = (0 - term) * square / denominator
    next = total + term
    if next = total then leave
    total = next
  end
  return total

/** Quadrant reduction plus a Taylor recurrence for cosine. */
_rxdecimal_cos_work: procedure = .decimal
  numeric digits inherited
  arg value = .decimal
  pi_value = _rxdecimal_pi_work()
  half_pi = pi_value / 2
  reduced = _rxdecimal_reduce_angle(value)
  sign_value = 1
  if reduced > half_pi then do
    reduced = pi_value - reduced
    sign_value = -1
  end
  if reduced < 0 - half_pi then do
    reduced = 0 - pi_value - reduced
    sign_value = -1
  end

  square = reduced * reduced
  term = .decimal
  total = .decimal
  term = 1
  total = 1
  do index = 1 to 4096
    denominator = (2 * index - 1) * (2 * index)
    term = (0 - term) * square / denominator
    next = total + term
    if next = total then leave
    total = next
  end
  return sign_value * total

/* Fixed work-context adapters. */
_rxdecimal_sqrt_18: procedure = .decimal
  numeric digits 18
  arg value = .decimal
  return _rxdecimal_sqrt_work(value)
_rxdecimal_sqrt_32: procedure = .decimal
  numeric digits 32
  arg value = .decimal
  return _rxdecimal_sqrt_work(value)
_rxdecimal_sqrt_64: procedure = .decimal
  numeric digits 64
  arg value = .decimal
  return _rxdecimal_sqrt_work(value)

_rxdecimal_exp_18: procedure = .decimal
  numeric digits 18
  arg value = .decimal
  return _rxdecimal_exp_work(value)
_rxdecimal_exp_32: procedure = .decimal
  numeric digits 32
  arg value = .decimal
  return _rxdecimal_exp_work(value)
_rxdecimal_exp_64: procedure = .decimal
  numeric digits 64
  arg value = .decimal
  return _rxdecimal_exp_work(value)

_rxdecimal_ln_18: procedure = .decimal
  numeric digits 18
  arg value = .decimal
  return _rxdecimal_ln_work(value)
_rxdecimal_ln_32: procedure = .decimal
  numeric digits 32
  arg value = .decimal
  return _rxdecimal_ln_work(value)
_rxdecimal_ln_64: procedure = .decimal
  numeric digits 64
  arg value = .decimal
  return _rxdecimal_ln_work(value)

_rxdecimal_sin_18: procedure = .decimal
  numeric digits 18
  arg value = .decimal
  return _rxdecimal_sin_work(value)
_rxdecimal_sin_32: procedure = .decimal
  numeric digits 32
  arg value = .decimal
  return _rxdecimal_sin_work(value)
_rxdecimal_sin_64: procedure = .decimal
  numeric digits 64
  arg value = .decimal
  return _rxdecimal_sin_work(value)

_rxdecimal_cos_18: procedure = .decimal
  numeric digits 18
  arg value = .decimal
  return _rxdecimal_cos_work(value)
_rxdecimal_cos_32: procedure = .decimal
  numeric digits 32
  arg value = .decimal
  return _rxdecimal_cos_work(value)
_rxdecimal_cos_64: procedure = .decimal
  numeric digits 64
  arg value = .decimal
  return _rxdecimal_cos_work(value)

_rxdecimal_pi_18: procedure = .decimal
  numeric digits 18
  return _rxdecimal_pi_work()
_rxdecimal_pi_32: procedure = .decimal
  numeric digits 32
  return _rxdecimal_pi_work()
_rxdecimal_pi_64: procedure = .decimal
  numeric digits 64
  return _rxdecimal_pi_work()

_rxdecimal_e_18: procedure = .decimal
  numeric digits 18
  return _rxdecimal_e_work()
_rxdecimal_e_32: procedure = .decimal
  numeric digits 32
  return _rxdecimal_e_work()
_rxdecimal_e_64: procedure = .decimal
  numeric digits 64
  return _rxdecimal_e_work()

/**
 * Return the non-negative decimal square root.
 *
 * @param value non-negative decimal value
 * @return square root rounded in the caller's numeric context
 * @signal INVALID_ARGUMENTS value is negative
 */
sqrt: procedure = .decimal
  numeric digits inherited
  arg value = .decimal
  if value < 0 then
    assembler signal "INVALID_ARGUMENTS", "RXDECIMAL.SQRT requires a non-negative value"
  caller_digits = .int
  assembler getnumdgts caller_digits
  if caller_digits <= 9 then result = _rxdecimal_sqrt_18(value)
  else if caller_digits <= 18 then result = _rxdecimal_sqrt_32(value)
  else result = _rxdecimal_sqrt_64(value)
  return result + 0

/**
 * Return the natural exponential.
 *
 * @param value decimal exponent
 * @return e**value rounded in the caller's numeric context
 */
exp: procedure = .decimal
  numeric digits inherited
  arg value = .decimal
  caller_digits = .int
  assembler getnumdgts caller_digits
  if caller_digits <= 9 then result = _rxdecimal_exp_18(value)
  else if caller_digits <= 18 then result = _rxdecimal_exp_32(value)
  else result = _rxdecimal_exp_64(value)
  return result + 0

/**
 * Return the natural logarithm.
 *
 * @param value positive decimal value
 * @return natural logarithm rounded in the caller's numeric context
 * @signal INVALID_ARGUMENTS value is zero or negative
 */
ln: procedure = .decimal
  numeric digits inherited
  arg value = .decimal
  if value <= 0 then
    assembler signal "INVALID_ARGUMENTS", "RXDECIMAL.LN requires a positive value"
  caller_digits = .int
  assembler getnumdgts caller_digits
  if caller_digits <= 9 then result = _rxdecimal_ln_18(value)
  else if caller_digits <= 18 then result = _rxdecimal_ln_32(value)
  else result = _rxdecimal_ln_64(value)
  return result + 0

/**
 * Return the sine of a decimal radian angle.
 *
 * @param value radians
 * @return sine rounded in the caller's numeric context
 */
sin: procedure = .decimal
  numeric digits inherited
  arg value = .decimal
  caller_digits = .int
  assembler getnumdgts caller_digits
  if caller_digits <= 9 then result = _rxdecimal_sin_18(value)
  else if caller_digits <= 18 then result = _rxdecimal_sin_32(value)
  else result = _rxdecimal_sin_64(value)
  return result + 0

/**
 * Return the cosine of a decimal radian angle.
 *
 * @param value radians
 * @return cosine rounded in the caller's numeric context
 */
cos: procedure = .decimal
  numeric digits inherited
  arg value = .decimal
  caller_digits = .int
  assembler getnumdgts caller_digits
  if caller_digits <= 9 then result = _rxdecimal_cos_18(value)
  else if caller_digits <= 18 then result = _rxdecimal_cos_32(value)
  else result = _rxdecimal_cos_64(value)
  return result + 0

/** @return pi rounded in the caller's numeric context */
pi: procedure = .decimal
  numeric digits inherited
  caller_digits = .int
  assembler getnumdgts caller_digits
  if caller_digits <= 9 then result = _rxdecimal_pi_18()
  else if caller_digits <= 18 then result = _rxdecimal_pi_32()
  else result = _rxdecimal_pi_64()
  return result + 0

/** @return Euler's number rounded in the caller's numeric context */
euler: procedure = .decimal
  numeric digits inherited
  caller_digits = .int
  assembler getnumdgts caller_digits
  if caller_digits <= 9 then result = _rxdecimal_e_18()
  else if caller_digits <= 18 then result = _rxdecimal_e_32()
  else result = _rxdecimal_e_64()
  return result + 0
