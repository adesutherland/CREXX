        response_headers = binsubstr(response, 1, body_start - 1) as .string
        if binlength(response_headers as .binary) > _header_bytes | http_header_count(response_headers) > _header_count then do
          _last_transport = -23
          _last_error = "HTTP response exceeds the configured header ceiling"
          call discard_socket()
          return response
        end
        content_length = http_content_length(response_headers)
        if content_length > _maximum_response then do
          _last_transport = -22
          _last_error = "HTTP response exceeds the configured body ceiling"
          call discard_socket()
          return response
        end
      end
      if binlength(response) > _maximum_response + _header_bytes + 65536 then do
        _last_transport = -22
        _last_error = "HTTP encoded response exceeds the configured safety ceiling"
        call discard_socket()
        return response
      end
      if http_response_complete(response) then return response
      if state = 1 then do
        call discard_socket()
        if body_start = 0 then do
          _last_transport = -5
          _last_error = "HTTP response ended before its headers"
          return response
        end
        transfer_encoding = translate(http_header_value(response_headers, "Transfer-Encoding"))
        content_length = http_content_length(response_headers)
        received_body = binlength(binsubstr(response, body_start))
        if pos("CHUNKED", transfer_encoding) > 0 | (content_length >= 0 & received_body < content_length) then do
          _last_transport = -13
          _last_error = "HTTP response ended before its declared body completed"
        end
        return response
      end
      if state = 2 then do
        _last_transport = -6
        _last_error = "HTTP response timed out"
        call discard_socket()
        return response
      end
      if state = 3 then do
        _last_transport = -7
        _last_error = "HTTP response would block"
        call discard_socket()
        return response
      end
      if state < 0 | binlength(chunk) = 0 then do
        _last_transport = -8
        _last_error = "HTTP socket receive failed: " || socketerror(_socket)
        call discard_socket()
        return response
      end
    end

  discard_socket: method = .void
    if _socket > 0 then drop_rc = socketclose(_socket)
    _socket = 0
    return
