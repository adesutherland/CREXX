    body_reference_bytes = binsubstr(wire, 65 + method_length + path_length, 92)
    content_type = binsubstr(wire, 157 + method_length + path_length, content_type_length) as .string
    request_headers = binsubstr(wire, 157 + method_length + path_length + content_type_length, header_length) as .string
    if http_method_valid(verb) = 0 | http_request_target_valid(path) = 0 | body_length > _request_bytes | header_length > _header_bytes | http_header_count(request_headers) > _header_count | http_header_lines_valid(request_headers) = 0 then do
