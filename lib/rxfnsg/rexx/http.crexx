    content_type_length = <at..int>(40) wire
    header_length = <at..int>(48) wire
    total_length = 64 + method_length + path_length + 92 + content_type_length + header_length
    invalid = method_length < 0 | path_length < 0 | body_length < -1 | content_type_length < 0 | header_length < 0 | total_length <> binlength(wire)
    if invalid then do
