    body_length = <at..int>(32) wire
    content_type_length = <at..int>(40) wire
    header_length = <at..int>(48) wire
    total_length = 64 + method_length + path_length + body_length + content_type_length + header_length
    invalid = method_length < 0 | path_length < 0 | body_length < 0 | content_type_length < 0 | header_length < 0 | total_length <> binlength(wire)
    if invalid then return http_response_wire(-41, 0, "", ''x as .binary, "HTTP request frame fields are invalid", 0, 0, 0)
