    if http_method_valid(verb) = 0 | http_request_target_valid(path) = 0 then return http_response_wire(-42, 0, "", ''x as .binary, "HTTP request method or target is invalid", 0, 0, 0)
    if body_length > _request_bytes | header_length > _header_bytes | http_header_count(request_headers) > _header_count | http_header_lines_valid(request_headers) = 0 then return http_response_wire(-42, 0, "", ''x as .binary, "HTTP request exceeds the configured limits or contains unsafe headers", 0, 0, 0)
    idempotent = http_method_idempotent(verb) | http_header_value(request_headers, "Idempotency-Key") <> ""
