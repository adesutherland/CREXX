/* Generate the constant-backed default full Unicode case-mapping module. */
options levelb

import rxfnsb
import _rxunicodebuild

arg argv = .string[]
if argv[0] \= 5 then do
  say "usage: generate_case_mapping UnicodeData.txt SpecialCasing.txt DerivedCoreProperties.txt template output"
  return 2
end

tables = case_mapping_compile(argv[1],argv[2],argv[3],"17.0.0")
if tables.status() \= 0 then do
  say "FAIL: Unicode case mapping line" tables.error_line() || ":" || tables.error()
  return 1
end
if tables.byte_length() \= 4590140 | tables.record_count() \= 3037 |,
   tables.cased_count() \= 4632 | tables.ignorable_count() \= 2794 |,
   tables.special_unconditional_count() \= 103 | tables.max_mapping() \= 3 then do
  say "FAIL: Unicode 17 case-mapping prepared-image audit" tables.byte_length()
  return 1
end

template = readlines(argv[4])
if template[0] <= 0 then do
  say "FAIL: rxunicode case-mapping template is empty or unreadable"
  return 1
end

path = argv[5]
if erasefile(path) \= 0 then return 1
marker_count = 0
do line_number = 1 to template[0]
  line = template[line_number]
  if strip(line) = "/* @RXUNICODE_CASE_MAPPING_DATA@ */" then do
    marker_count = marker_count + 1
    if charout(path,"  constant UNICODE_CASE_MAPPING_DATA = '") \= 0 then return 1
    if charout(path,bin2x(tables.image())) \= 0 then return 1
    if charout(path,"'x as .binary" || "0a"x) \= 0 then return 1
  end
  else if charout(path,line || "0a"x) \= 0 then return 1
end
if charout(path) \= 0 then return 1
if marker_count \= 1 then do
  ignored = erasefile(path)
  say "FAIL: rxunicode case-mapping template must contain exactly one data marker"
  return 1
end

say "Unicode case-mapping section bytes:" tables.byte_length()
say "Unicode case-mapping records:" tables.record_count()
say "Unicode case-mapping source: PASS"
return 0
