/*
 * cREXX License (MIT)
 *
 * Deterministically freeze the Unicode 17.0.0 normalization engine into one
 * private product runtime module. The public Level G facade remains stateless.
 */

options levelb

import rxfnsb
import unicode_data
import unicode_normprops
import unicode_d

arg argv = .string[]
if argv[0] \= 4 then do
  say "usage: generate_normalization UnicodeData.txt DerivedNormalizationProps.txt unicode_d.crexx output.crexx"
  return 2
end

ucd = unicode_data_parse(argv[1], "17.0.0")
if ucd.status() \= 0 then do
  say "FAIL: UnicodeData line" ucd.error_line() || ":" || ucd.error()
  return 1
end
properties = unicode_normprops_parse(argv[2], "17.0.0")
if properties.status() \= 0 then do
  say "FAIL: normalization properties line" properties.error_line() || ":" || properties.error()
  return 1
end
tables = unicode_norm_compile(ucd, properties)
if tables.status() \= 0 then do
  say "FAIL: prepared normalization table compiler:" tables.error()
  return 1
end
if tables.byte_length() \= 6736284 | tables.rank_count() \= 55 |,
   tables.nfd_mapping_count() \= 2081 | tables.nfkd_mapping_count() \= 5914 |,
   tables.composition_pair_count() \= 961 |,
   tables.nfc_qc_no_count() \= 1120 | tables.nfc_qc_maybe_count() \= 132 |,
   tables.nfkc_qc_no_count() \= 4965 | tables.nfkc_qc_maybe_count() \= 132 then do
  say "FAIL: prepared normalization image audit"
  return 1
end

template_lines = readlines(argv[3])
if template_lines[0] <= 0 then do
  say "FAIL: normalizer source template is empty or unreadable"
  return 1
end

path = argv[4]
if erasefile(path) \= 0 then return 1
call emit_line path, "/* Generated Unicode 17.0.0 constant-backed normalization runtime. */"
call emit_line path, "/* Generated by generate_normalization.crexx; do not edit. */"
call emit_line path, "options levelb"
call emit_line path, ""
call emit_line path, "namespace _rxunicode expose unicode_normalize unicode_is_normalized"
call emit_line path, "import rxfnsb"
call emit_line path, ""
call emit_line path, "unicode_normalization_constants: procedure expose UNICODE_NORMALIZATION_DATA"
call emit_line path, "  /* One compiler-owned module-scoped constant-pool item. */"
if charout(path, "  constant UNICODE_NORMALIZATION_DATA = '") \= 0 then return 1
if charout(path, bin2x(tables.image())) \= 0 then return 1
if charout(path, "'x as .binary" || "0a"x) \= 0 then return 1
call emit_line path, "  return"
call emit_line path, ""
call emit_line path, "_unicode_normalization_is_scalar: procedure = .int"
call emit_line path, "  arg codepoint = .int"
call emit_line path, "  if codepoint < 0 | codepoint > 0x10FFFF then return 0"
call emit_line path, "  if codepoint >= 0xD800 & codepoint <= 0xDFFF then return 0"
call emit_line path, "  return 1"
call emit_line path, ""
call emit_line path, "_unicode_normalization_form: procedure = .string"
call emit_line path, "  arg form = .int"
call emit_line path, '  if form = 1 then return "NFD"'
call emit_line path, '  if form = 2 then return "NFKD"'
call emit_line path, '  if form = 3 then return "NFC"'
call emit_line path, '  if form = 4 then return "NFKC"'
call emit_line path, '  signal invalid_arguments "rxunicode normalization form is invalid"'
call emit_line path, '  return ""'
call emit_line path, ""
call emit_line path, "_unicode_normalizer_new: procedure = .unicodednormalizer"
call emit_line path, "  arg form = .int"
call emit_line path, "  normalizer = .unicodednormalizer()"
call emit_line path, "  call normalizer.initialize(_unicode_normalization_form(form),0)"
call emit_line path, "  return normalizer"
call emit_line path, ""
call emit_line path, "unicode_normalize: procedure = .string"
call emit_line path, "  arg expose source = .string, form = .int"
call emit_line path, "  normalizer = _unicode_normalizer_new(form)"
call emit_line path, "  return normalizer.normalize(source)"
call emit_line path, ""
call emit_line path, "unicode_is_normalized: procedure = .boolean"
call emit_line path, "  arg expose source = .string, form = .int"
call emit_line path, "  normalizer = _unicode_normalizer_new(form)"
call emit_line path, "  return normalizer.is_normalized(source) \= 0"
call emit_line path, ""

line_number = .int
line = .string
stripped = .string
copying = 0
copying_method = 1
skipping_initialize = 0
skipping_method_comment = 0
class_found = 0
method_name = .string
do line_number = 1 to template_lines[0]
  line = template_lines[line_number]
  stripped = strip(line)
  if copying = 0 then do
    if stripped = "unicodednormalizer: class" then do
      copying = 1
      class_found = 1
    end
    else iterate
  end

  if skipping_method_comment then do
    if pos("*/", stripped) > 0 then skipping_method_comment = 0
    iterate
  end
  if left(line,4) = "  /*" then do
    if pos("*/", stripped) = 0 then skipping_method_comment = 1
    iterate
  end

  if left(line,2) = "  " & left(line,3) \= "   " &,
     left(stripped,1) = "_" & pos(" = .", stripped) > 0 &,
     pos(": method", stripped) = 0 then do
    if normalization_product_field(stripped) = 0 then iterate
  end

  if stripped = "*: factory" then do
    call emit_line path, "  *: factory"
    call emit_line path, "    _ready = 0"
    call emit_line path, "    _status = 0"
    call emit_line path, '    _error = ""'
    call emit_line path, "    _form = 0"
    call emit_line path, "    _compose = 0"
    call emit_line path, "    _pending_count = 0"
    call emit_line path, "    _pending_capacity = 64"
    call emit_line path, "    _pending_disordered = 0"
    call emit_line path, "    _pending_last_ccc = 0"
    call emit_line path, "    call binresize _pending, _pending_capacity * 12"
    call emit_line path, "    _compose_has_starter = 0"
    call emit_line path, "    _compose_starter = 0"
    call emit_line path, "    _compose_last_ccc = 0"
    call emit_line path, "    _compose_mark_count = 0"
    call emit_line path, "    _compose_mark_capacity = 64"
    call emit_line path, "    call binresize _compose_marks, _compose_mark_capacity * 4"
    call emit_line path, "    _check_index = 0"
    call emit_line path, "    _check_length = 0"
    call emit_line path, "    _check_ok = 1"
    call emit_line path, "    return"
    call emit_line path, ""
    copying_method = 0
    iterate
  end
  if stripped = "_bucket_flushes = 0" |,
     stripped = "_bucket_flushes = _bucket_flushes + 1" then iterate
  if stripped = "initialize: method = .void" then do
    call emit_line path, "  initialize: method = .void"
    call emit_line path, "    arg form = .string, validate = 0"
    call emit_line path, "    _ready = 0"
    call emit_line path, "    _status = 0"
    call emit_line path, '    _error = ""'
    call emit_line path, "    form = upper(form)"
    call emit_line path, '    if form = "NFD" then _form = 1'
    call emit_line path, '    else if form = "NFKD" then _form = 2'
    call emit_line path, '    else if form = "NFC" then _form = 3'
    call emit_line path, '    else if form = "NFKC" then _form = 4'
    call emit_line path, "    else do"
    call emit_line path, '      call _fail "prepared normalization form must be NFD, NFKD, NFC, or NFKC"'
    call emit_line path, "      return"
    call emit_line path, "    end"
    call emit_line path, "    _compose = _form >= 3"
    call emit_line path, "    if validate then call _validate_image"
    call emit_line path, "    else call _load_trusted_image"
    call emit_line path, "    if _status = 0 then do"
    call emit_line path, "      call binresize _counts, _rank_count * 4"
    call emit_line path, "      call binresize _next, _rank_count * 4"
    call emit_line path, "      _ready = 1"
    call emit_line path, "    end"
    call emit_line path, "    return"
    call emit_line path, ""
    skipping_initialize = 1
    copying_method = 0
    iterate
  end
  if skipping_initialize then do
    if stripped = "ready: method = .int" then do
      call emit_line path, "  _load_trusted_image: method = .void"
      call emit_line path, "    _ccc_offset = <at..u32>(16) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "    _rank_offset = <at..u32>(24) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "    _rank_count = <at..u32>(96) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "    _prepared_offset = <at..u32>(156) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "    _prepared_count = <at..u32>(188) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "    if _form = 1 | _form = 3 then do"
      call emit_line path, "      _bits_offset = <at..u32>(32) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "      _pages_offset = <at..u32>(48) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "      _records_offset = <at..u32>(64) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "      _record_count = <at..u32>(68) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "      _components_offset = <at..u32>(72) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "      _component_count = <at..u32>(76) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "    end"
      call emit_line path, "    else do"
      call emit_line path, "      _bits_offset = <at..u32>(40) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "      _pages_offset = <at..u32>(56) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "      _records_offset = <at..u32>(80) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "      _record_count = <at..u32>(84) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "      _components_offset = <at..u32>(88) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "      _component_count = <at..u32>(92) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "    end"
      call emit_line path, "    _composition_directory_offset = <at..u32>(160) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "    _composition_directory_count = <at..u32>(164) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "    _composition_pairs_offset = <at..u32>(168) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "    _composition_pair_count = <at..u32>(172) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "    _quick_check_offset = <at..u32>(192) UNICODE_NORMALIZATION_DATA"
      call emit_line path, "    return"
      call emit_line path, ""
      skipping_initialize = 0
    end
    else iterate
  end

  method_name = ""
  if pos(": method", stripped) > 0 then do
    method_name = word(stripped,1)
    method_name = left(method_name,length(method_name) - 1)
    copying_method = normalization_product_method(method_name)
  end
  if copying_method = 0 then iterate

  line = changestr("unicode_d_is_scalar",line,"_unicode_normalization_is_scalar")
  line = changestr("_image",line,"UNICODE_NORMALIZATION_DATA")
  line = changestr("_validateUNICODE_NORMALIZATION_DATA",line,"_validate_image")
  call emit_line path,line
end

if class_found = 0 then do
  say "FAIL: normalizer class marker not found in template"
  return 1
end
call emit_line path, ""
call emit_line path, "_normalization_boot: initialiser"
call emit_line path, "  verifier = .unicodednormalizer()"
call emit_line path, '  call verifier.initialize("NFD",1)'
call emit_line path, '  if verifier.ready() = 0 then signal failure "rxunicode NFD data validation failed: " || verifier.error()'
call emit_line path, "  verifier = .unicodednormalizer()"
call emit_line path, '  call verifier.initialize("NFKD",1)'
call emit_line path, '  if verifier.ready() = 0 then signal failure "rxunicode NFKD data validation failed: " || verifier.error()'
call emit_line path, "  return"
if charout(path) \= 0 then return 1

say "Unicode normalization section bytes:" tables.byte_length()
say "Unicode normalization source: PASS"
return 0

emit_line: procedure = .void
  arg path = .string, line = .string
  ignored = charout(path,line || "0a"x)
  return

/** Fields retained by the generated codepoint-only product normalizer. */
normalization_product_field: procedure = .int
  arg declaration = .string
  select
    when declaration = "_ready = .int" then return 1
    when declaration = "_status = .int" then return 1
    when declaration = "_error = .string" then return 1
    when declaration = "_form = .int" then return 1
    when declaration = "_ccc_offset = .int" then return 1
    when declaration = "_rank_offset = .int" then return 1
    when declaration = "_rank_count = .int" then return 1
    when declaration = "_prepared_offset = .int" then return 1
    when declaration = "_prepared_count = .int" then return 1
    when declaration = "_bits_offset = .int" then return 1
    when declaration = "_pages_offset = .int" then return 1
    when declaration = "_records_offset = .int" then return 1
    when declaration = "_record_count = .int" then return 1
    when declaration = "_components_offset = .int" then return 1
    when declaration = "_component_count = .int" then return 1
    when declaration = "_composition_directory_offset = .int" then return 1
    when declaration = "_composition_directory_count = .int" then return 1
    when declaration = "_composition_pairs_offset = .int" then return 1
    when declaration = "_composition_pair_count = .int" then return 1
    when declaration = "_quick_check_offset = .int" then return 1
    when declaration = "_pending = .binary" then return 1
    when declaration = "_pending_count = .int" then return 1
    when declaration = "_pending_capacity = .int" then return 1
    when declaration = "_pending_disordered = .int" then return 1
    when declaration = "_pending_last_ccc = .int" then return 1
    when declaration = "_scratch = .binary" then return 1
    when declaration = "_counts = .binary" then return 1
    when declaration = "_next = .binary" then return 1
    when declaration = "_compose = .int" then return 1
    when declaration = "_compose_has_starter = .int" then return 1
    when declaration = "_compose_starter = .int" then return 1
    when declaration = "_compose_last_ccc = .int" then return 1
    when declaration = "_compose_marks = .binary" then return 1
    when declaration = "_compose_mark_count = .int" then return 1
    when declaration = "_compose_mark_capacity = .int" then return 1
    when declaration = "_check_index = .int" then return 1
    when declaration = "_check_length = .int" then return 1
    when declaration = "_check_ok = .int" then return 1
    otherwise return 0
  end
  return 0

/** Methods retained by the generated codepoint-only product normalizer. */
normalization_product_method: procedure = .int
  arg name = .string
  select
    when name = "ready" | name = "error" then return 1
    when name = "normalize" | name = "is_normalized" then return 1
    when name = "_fail" | name = "_validate_image" then return 1
    when name = "_mapped" | name = "_find_mapping" then return 1
    when name = "_process_prepared_scalar_string" |,
         name = "_process_lookup_scalar_string" then return 1
    when name = "_emit_decomposed_scalar_string" |,
         name = "_emit_hangul_string" then return 1
    when name = "_enqueue_scalar_mark" |,
         name = "_enqueue_prepared_mark" then return 1
    when name = "_flush_pending_string" |,
         name = "_process_mapping_string" then return 1
    when name = "_check_composed_string" |,
         name = "_check_prepared_scalar" |,
         name = "_check_lookup_scalar" then return 1
    when name = "_check_emit_decomposed" |,
         name = "_check_emit_hangul" |,
         name = "_check_process_mapping" then return 1
    when name = "_check_flush_pending" |,
         name = "_check_compose_scalar" |,
         name = "_check_flush_composer" |,
         name = "_check_emit" then return 1
    when name = "_process_prepared_mapping_string" |,
         name = "_sort_pending" then return 1
    when name = "_compose_scalar_string" |,
         name = "_flush_composer_string" |,
         name = "_compose_pair" |,
         name = "_ensure_compose_marks" then return 1
    otherwise return 0
  end
  return 0
