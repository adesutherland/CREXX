/* Product build-time compiler for Unicode 17 default full case mappings. */
options levelb

namespace _rxunicodebuild expose casemappingtables case_mapping_compile
import rxfnsb

case_mapping_compile: procedure = .casemappingtables
  arg unicode_data_path = .string, special_casing_path = .string, core_path = .string, version = .string
  tables = .casemappingtables()
  call tables.compile(unicode_data_path,special_casing_path,core_path,version)
  return tables

case_mapping_is_scalar: procedure = .int
  arg codepoint = .int
  if codepoint < 0 | codepoint > 0x10FFFF then return 0
  if codepoint >= 0xD800 & codepoint <= 0xDFFF then return 0
  return 1

casemappingtables: class
  _status = .int
  _error = .string
  _error_line = .int
  _descriptor = .binary
  _records = .binary
  _image = .binary
  _record_count = .int
  _cased_count = .int
  _ignorable_count = .int
  _simple_upper_count = .int
  _simple_lower_count = .int
  _special_unconditional_count = .int
  _max_mapping = .int

  *: factory
    _status = 0
    _error = ""
    _error_line = 0
    _record_count = 0
    _cased_count = 0
    _ignorable_count = 0
    _simple_upper_count = 0
    _simple_lower_count = 0
    _special_unconditional_count = 0
    _max_mapping = 0
    call binresize _descriptor,0x110000 * 4
    call binresize _records,0
    call binresize _image,0
    return

  compile: method = .void
    arg unicode_data_path = .string, special_casing_path = .string, core_path = .string, version = .string
    if version \= "17.0.0" then do
      call _fail "case-mapping compiler requires Unicode version 17.0.0",0
      return
    end
    call _parse_unicode_data unicode_data_path
    if _status = 0 then call _parse_special_casing special_casing_path
    if _status = 0 then call _parse_properties core_path
    if _status \= 0 then return
    if _record_count \= 3037 | _cased_count \= 4632 |,
       _ignorable_count \= 2794 | _simple_upper_count \= 1505 |,
       _simple_lower_count \= 1488 | _special_unconditional_count \= 103 |,
       _max_mapping \= 3 then do
      call _fail "Unicode 17 default case-mapping count audit failed",0
      return
    end
    call _assemble_image
    return

  status: method = .int
    return _status

  error: method = .string
    return _error

  error_line: method = .int
    return _error_line

  image: method = .binary
    return _image

  byte_length: method = .int
    return <blen>(_image)

  record_count: method = .int
    return _record_count

  cased_count: method = .int
    return _cased_count

  ignorable_count: method = .int
    return _ignorable_count

  special_unconditional_count: method = .int
    return _special_unconditional_count

  max_mapping: method = .int
    return _max_mapping

  has_record: method = .int
    arg codepoint = .int
    if case_mapping_is_scalar(codepoint) = 0 then return 0
    return (<at..u32>(64 + codepoint * 4) _image <and> 0x00FFFFFF) \= 0

  record_source: method = .int
    arg record_index = .int
    if record_index < 0 | record_index >= _record_count then return -1
    records_offset = <at..u32>(24) _image
    return <at..u32>(records_offset + record_index * 44) _image

  expected_upper: method = .string
    arg record_index = .int
    return _expected(record_index,1)

  expected_lower: method = .string
    arg record_index = .int
    return _expected(record_index,2)

  _expected: method = .string
    arg record_index = .int, mode = .int
    if record_index < 0 | record_index >= _record_count then return ""
    records_offset = <at..u32>(24) _image
    offset = records_offset + record_index * 44
    source = <at..u32>(offset) _image
    mapping_offset = 4
    count_offset = 40
    if mode = 2 then do
      mapping_offset = 16
      count_offset = 41
    end
    count = <at..u8>(offset + count_offset) _image
    result = ""
    if count = 0 then assembler appendchar result,source
    else do i = 0 to count - 1
      codepoint = <at..u32>(offset + mapping_offset + i * 4) _image
      assembler appendchar result,codepoint
    end
    return result

  _parse_unicode_data: method = .void
    arg path = .string
    lines = readlines(path)
    if lines[0] <= 0 then do
      call _fail "UnicodeData input is empty or unreadable",0
      return
    end
    do line_number = 1 to lines[0] while _status = 0
      fields = qsplit(lines[line_number],";")
      if fields[0] < 14 then do
        call _fail "UnicodeData record has fewer than fourteen fields",line_number
        leave
      end
      upper_mapping = strip(fields[13])
      lower_mapping = strip(fields[14])
      /* UnicodeData includes surrogate and range-marker records, but none can
       * participate in scalar case mappings. Avoid treating those unrelated
       * records as malformed case data. */
      if upper_mapping = "" & lower_mapping = "" then iterate
      source = x2d(strip(fields[1]))
      if case_mapping_is_scalar(source) = 0 then do
        call _fail "UnicodeData case-mapping source is not a scalar",line_number
        leave
      end
      if upper_mapping \= "" then do
        call _set_mapping source,1,upper_mapping,line_number
        _simple_upper_count = _simple_upper_count + 1
      end
      if lower_mapping \= "" then do
        call _set_mapping source,2,lower_mapping,line_number
        _simple_lower_count = _simple_lower_count + 1
      end
    end
    return

  _parse_special_casing: method = .void
    arg path = .string
    lines = readlines(path)
    if lines[0] <= 0 then do
      call _fail "SpecialCasing input is empty or unreadable",0
      return
    end
    do line_number = 1 to lines[0] while _status = 0
      line = lines[line_number]
      comment = pos("#",line)
      if comment > 0 then line = left(line,comment - 1)
      line = strip(line)
      if line = "" then iterate
      fields = qsplit(line,";")
      if fields[0] < 4 then do
        call _fail "SpecialCasing record is malformed",line_number
        leave
      end
      source = x2d(strip(fields[1]))
      condition = ""
      if fields[0] >= 5 then condition = strip(fields[5])
      if condition = "" then do
        call _set_mapping source,2,strip(fields[2]),line_number
        call _set_mapping source,1,strip(fields[4]),line_number
        _special_unconditional_count = _special_unconditional_count + 1
      end
      else if condition = "Final_Sigma" then do
        if source \= 0x03A3 then call _fail "Final_Sigma source is unexpected",line_number
        else call _set_mapping source,3,strip(fields[2]),line_number
      end
      /* All other conditional records are locale-sensitive and excluded. */
    end
    return

  _parse_properties: method = .void
    arg path = .string
    lines = readlines(path)
    if lines[0] <= 0 then do
      call _fail "DerivedCoreProperties input is empty or unreadable",0
      return
    end
    do line_number = 1 to lines[0] while _status = 0
      line = lines[line_number]
      comment = pos("#",line)
      if comment > 0 then line = left(line,comment - 1)
      line = strip(line)
      if line = "" then iterate
      fields = qsplit(line,";")
      if fields[0] < 2 then iterate
      property = strip(fields[2])
      if property \= "Cased" & property \= "Case_Ignorable" then iterate
      range = strip(fields[1])
      dots = pos("..",range)
      first = .int
      last = .int
      if dots = 0 then do
        first = x2d(range)
        last = first
      end
      else do
        first = x2d(strip(left(range,dots - 1)))
        last = x2d(strip(substr(range,dots + 2)))
      end
      first_valid = case_mapping_is_scalar(first)
      last_valid = case_mapping_is_scalar(last)
      if first_valid = 0 | last_valid = 0 | last < first then do
        call _fail "DerivedCoreProperties range is invalid",line_number
        leave
      end
      if property = "Cased" then flag = 0x40000000
      else flag = 0x80000000
      do codepoint = first to last
        offset = codepoint * 4
        descriptor = <at..u32>(offset) _descriptor
        if (descriptor <and> flag) = 0 then do
          <at..u32>(offset) _descriptor = descriptor <or> flag
          if property = "Cased" then _cased_count = _cased_count + 1
          else _ignorable_count = _ignorable_count + 1
        end
      end
    end
    return

  _set_mapping: method = .void
    arg source = .int, mode = .int, mapping = .string, line_number = .int
    if case_mapping_is_scalar(source) = 0 then do
      call _fail "case-mapping source is not a scalar",line_number
      return
    end
    count = words(mapping)
    if count < 1 | count > 3 then do
      call _fail "case mapping length is outside 1..3",line_number
      return
    end
    identity = count = 1 & x2d(word(mapping,1)) = source
    record = _ensure_record(source)
    offset = record * 44
    mapping_offset = 4
    count_offset = 40
    if mode = 2 then do
      mapping_offset = 16
      count_offset = 41
    end
    else if mode = 3 then do
      mapping_offset = 28
      count_offset = 42
    end
    if identity then count = 0
    <at..u8>(offset + count_offset) _records = count
    do i = 0 to 2
      <at..u32>(offset + mapping_offset + i * 4) _records = 0
    end
    do component_index = 1 to count while _status = 0
      component = x2d(word(mapping,component_index))
      if case_mapping_is_scalar(component) = 0 then,
        call _fail "case mapping contains a non-scalar",line_number
      else <at..u32>(offset + mapping_offset + (component_index - 1) * 4) _records = component
    end
    if words(mapping) > _max_mapping then _max_mapping = words(mapping)
    return

  _ensure_record: method = .int
    arg source = .int
    descriptor_offset = source * 4
    descriptor = <at..u32>(descriptor_offset) _descriptor
    record_number = descriptor <and> 0x00FFFFFF
    if record_number \= 0 then return record_number - 1
    record = _record_count
    _record_count = _record_count + 1
    call binresize _records,_record_count * 44
    offset = record * 44
    call binfillat _records,offset,44,0
    <at..u32>(offset) _records = source
    <at..u32>(descriptor_offset) _descriptor = (descriptor <and> 0xFF000000) <or> (record + 1)
    return record

  _assemble_image: method = .void
    descriptor_offset = 64
    records_offset = descriptor_offset + 0x110000 * 4
    total = records_offset + _record_count * 44
    call binresize _image,total
    <at..u8>(0) _image = 67
    <at..u8>(1) _image = 85
    <at..u8>(2) _image = 67
    <at..u8>(3) _image = 77
    <at..u16>(4) _image = 1
    <at..u16>(6) _image = 64
    <at..u16>(8) _image = 17
    <at..u16>(10) _image = 0
    <at..u16>(12) _image = 0
    <at..u32>(16) _image = descriptor_offset
    <at..u32>(20) _image = 0x110000
    <at..u32>(24) _image = records_offset
    <at..u32>(28) _image = _record_count
    <at..u32>(32) _image = 44
    <at..u32>(36) _image = _cased_count
    <at..u32>(40) _image = _ignorable_count
    <at..u32>(44) _image = _simple_upper_count
    <at..u32>(48) _image = _simple_lower_count
    <at..u32>(52) _image = _special_unconditional_count
    <at..u32>(56) _image = total
    <at..u32>(60) _image = _max_mapping
    call bincopy _image,descriptor_offset,_descriptor,0,<blen>(_descriptor)
    call bincopy _image,records_offset,_records,0,<blen>(_records)
    return

  _fail: method = .void
    arg message = .string, line_number = .int
    if _status \= 0 then return
    _status = 1
    _error = message
    _error_line = line_number
    return
