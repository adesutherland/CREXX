/*
 * cREXX License (MIT)
 *
 * Deterministically generate the constant-backed Level G rxunicode grapheme
 * module from the pinned Unicode 17.0.0 UAX #29 property inputs.
 */

options levelb

import rxfnsb
import _rxunicodebuild

arg argv = .string[]
if argv[0] \= 5 then do
  say "usage: generate_grapheme GraphemeBreakProperty.txt emoji-data.txt DerivedCoreProperties.txt unicode_grapheme.crexx.in output.crexx"
  return 2
end

tables = grapheme_compile(argv[1], argv[2], argv[3], "17.0.0")
if tables.status() \= 0 then do
  say "FAIL: grapheme data line" tables.error_line() || ":" || tables.error()
  return 1
end
if tables.byte_length() \= 1114176 | tables.gcb_assigned() \= 18101 |,
   tables.extended_pictographic_count() \= 2848 |,
   tables.incb_consonant_count() \= 911 |,
   tables.incb_extend_count() \= 2217 |,
   tables.incb_linker_count() \= 20 then do
  say "FAIL: Unicode 17 grapheme prepared-image audit"
  return 1
end

template = readlines(argv[4])
if template[0] <= 0 then do
  say "FAIL: rxunicode grapheme template is empty or unreadable"
  return 1
end

path = argv[5]
if erasefile(path) \= 0 then return 1
marker_count = 0
do line_number = 1 to template[0]
  line = template[line_number]
  if strip(line) = "/* @RXUNICODE_GRAPHEME_DATA@ */" then do
    marker_count = marker_count + 1
    if charout(path, "  constant UNICODE_GRAPHEME_DATA = '") \= 0 then return 1
    if charout(path, bin2x(tables.image())) \= 0 then return 1
    if charout(path, "'x as .binary" || "0a"x) \= 0 then return 1
  end
  else if charout(path, line || "0a"x) \= 0 then return 1
end
if charout(path) \= 0 then return 1
if marker_count \= 1 then do
  ignored = erasefile(path)
  say "FAIL: rxunicode grapheme template must contain exactly one data marker"
  return 1
end

return 0
