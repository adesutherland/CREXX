/* Bounded Level G server, task-handler and public client integration proof. */
options levelg

import rxfnsb
import rxsocket
import concurrency
import rxfnsg
import _rxhttpcore

protocol_checks: procedure = .int
  crlf = "0d0a"x
  errors = 0
  valid_text = "POST /parse HTTP/1.1" || crlf || "Host: 127.0.0.1" || crlf || "Content-Length: 3" || crlf || crlf || "abcNEXT"
  valid = http_parse_request(valid_text as .binary, 1024, 8, 8)
  if valid.state() <> 1 | valid.verb() <> "POST" | valid.target() <> "/parse" | valid.body() as .string <> "abc" | valid.consumed() <> binlength(valid_text as .binary) - 4 then errors = errors + 1
  partial = http_parse_request("GET / HTTP/1.1" as .binary, 1024, 8, 8)
  if partial.state() <> 0 then errors = errors + 1
  duplicate_text = "POST / HTTP/1.1" || crlf || "Host: x" || crlf || "Content-Length: 0" || crlf || "Content-Length: 0" || crlf || crlf
  duplicate = http_parse_request(duplicate_text as .binary, 1024, 8, 8)
  if duplicate.state() <> 2 | duplicate.status() <> 400 then errors = errors + 1
  transfer_text = "POST / HTTP/1.1" || crlf || "Host: x" || crlf || "Transfer-Encoding: chunked" || crlf || crlf || "0" || crlf || crlf
  transfer = http_parse_request(transfer_text as .binary, 1024, 8, 8)
  if transfer.state() <> 2 | transfer.status() <> 501 then errors = errors + 1
  large_text = "POST / HTTP/1.1" || crlf || "Host: x" || crlf || "Content-Length: 6" || crlf || crlf || "123456"
  large = http_parse_request(large_text as .binary, 1024, 8, 5)
  if large.state() <> 2 | large.status() <> 413 then errors = errors + 1
  missing_host_text = "GET / HTTP/1.1" || crlf || crlf
  missing_host = http_parse_request(missing_host_text as .binary, 1024, 8, 8)
  if missing_host.state() <> 2 | missing_host.status() <> 400 then errors = errors + 1
  return errors

integrationservice: class implements .httpservice .taskwork
  *: factory
    return

  handle: method = .httpresponse
    arg request = .httprequest, context = .taskcontext
    if context.cancellation_requested() then return .httpresponse.text(503, "cancelled")
    if request.verb() = "GET" & request.target() = "/alpha?value=1" then do
      headers = .httpheaders.media_type("text/plain").add("X-Service", "integration")
      return .httpresponse.text(200, request.verb() || " " || request.target(), headers)
    end
    if request.verb() = "PUT" & request.target() = "/binary" then do
      headers = .httpheaders.media_type("application/octet-stream").add("X-Service", "integration")
      return .httpresponse.binary(201, request.body_bytes(), headers)
    end
    return .httpresponse.text(404, "not found")

  run: method = .channelvalue
    arg encoded = .channelvalue, context = .taskcontext
    service = self as .httpservice
    return service.dispatch(encoded, context)

server_client_request: class implements .taskwork
  _client = .channelvalue
  _verb = .string
  _target = .string
  _body = .binary
  _gate_reference = .binary

  *: factory
    arg client = .channelvalue, verb = .string, target = .string, body = .binary, gate_reference = .binary
    _client = client
    _verb = verb
    _target = target
    _body = body
    _gate_reference = gate_reference
    return

  run: method = .channelvalue
    arg ignored = .channelvalue, context = .taskcontext
    gate = .byteendpoint.from_encoded_reference(_gate_reference)
    gate_completion = gate.start_read(1, 5000).wait(5000)
    call gate.close()
    if gate_completion.succeeded() = 0 then return .channelvalue.string_value("HTTP test gate failed")
    client = .httpclient.from_channel(_client)
    headers = .httpheaders.media_type("application/octet-stream").add("X-Client-Task", _target)
    response = client.request(_verb, _target, _body, headers)
    call client.close()
    return response.to_channel()

slow_client_request: class implements .taskwork
  _port = .int
  _gate_reference = .binary

  *: factory
    arg port = .int, gate_reference = .binary
    _port = port
    _gate_reference = gate_reference
    return

  run: method = .channelvalue
    arg ignored = .channelvalue, context = .taskcontext
    socket = socketcreate()
    if socket < 0 then return .channelvalue.integer_value(-1)
    if sockettimeout(socket, 5000) <> 0 | socketconnect(socket, "127.0.0.1", _port) <> 0 then return .channelvalue.integer_value(-2)
    response = socketrecv(socket, 4096)
    drop_status = socketclose(socket)
    if left(response, 12) <> "HTTP/1.1 408" then return .channelvalue.integer_value(-3)
    gate = .byteendpoint.from_encoded_reference(_gate_reference)
    gate_completion = gate.start_write("!!" as .binary, 5000).wait(5000)
    if gate_completion.succeeded() then call gate.half_close(2)
    call gate.close()
    if gate_completion.succeeded() = 0 then return .channelvalue.integer_value(-4)
    return .channelvalue.integer_value(408)

main: procedure = .int
  errors = protocol_checks()
  server = .httpserver.local("127.0.0.1", 0, 2, 8, 6, 16384, 32, 1048576, 5000, 200)
  policy = .httppolicy.safe()
  call policy.set_timeouts(2000, 2000, 2000, 5000, 5000, 10000)
  call policy.set_limits(32, 16384, 1048576)
  client = .httpclient.pooled("http://127.0.0.1:" || server.port(), 2, 4, 1048576, policy)
  request_pool = .taskpool.local(3, 4)
  request_scope = .taskscope.collectall(request_pool, 30000)
  gate = .byteendpoint.memory(3, 2)
  gate_reference = gate.provider_reference().encode()
  slow = request_scope.submit(task .slow_client_request(server.port(), gate_reference), .channelvalue.null_value())
  client_record = client.to_channel()
  first = request_scope.submit(task .server_client_request(client_record, "GET", "/alpha?value=1", ''x as .binary, gate_reference), .channelvalue.null_value())
  binary_body = '00017fff42'x as .binary
  second = request_scope.submit(task .server_client_request(client_record, "PUT", "/binary", binary_body, gate_reference), .channelvalue.null_value())

  server_started_us = time("us")
  served = server.serve(task .integrationservice(), 2)
  server_elapsed_us = time("us") - server_started_us
  if server_elapsed_us < 0 then server_elapsed_us = server_elapsed_us + 86400000000
  first_completion = first.wait(-1)
  second_completion = second.wait(-1)
  slow_completion = slow.wait(-1)
  if slow_completion.succeeded() = 0 | slow_completion.value().as_integer() <> 408 then do
    say "FAIL: incomplete HTTP request did not receive 408"
    errors = errors + 1
  end
  if served <> 2 | server.served() <> 2 then do
    say "FAIL: HTTP server completed" served server.served() "requests"
    errors = errors + 1
  end
  if first_completion.succeeded() = 0 then do
    say "FAIL: first HTTP client task" first_completion.error_code() first_completion.message()
    errors = errors + 1
  end
  else do
    first_response = .httpresponse.from_channel(first_completion.value())
    if first_response.status() <> 200 | first_response.body() <> "GET /alpha?value=1" | first_response.header("X-Service") <> "integration" then do
      say "FAIL: first HTTP response" first_response.transport_status() first_response.status() first_response.error() first_response.body()
      errors = errors + 1
    end
  end
  if second_completion.succeeded() = 0 then do
    say "FAIL: second HTTP client task" second_completion.error_code() second_completion.message()
    errors = errors + 1
  end
  else do
    second_response = .httpresponse.from_channel(second_completion.value())
    if second_response.status() <> 201 | bincompare(second_response.body_bytes(), binary_body) <> 0 | second_response.header("Content-Type") <> "application/octet-stream" then do
      say "FAIL: second HTTP response" second_response.transport_status() second_response.status() second_response.error() second_response.body()
      errors = errors + 1
    end
  end

  call request_scope.finish()
  call request_pool.close()
  call gate.close()
  call client.close()
  call server.close()
  if server.scans() < 1 | server.idle_scans() > server.scans() then do
    say "FAIL: HTTP server scan telemetry" server.scans() server.idle_scans()
    errors = errors + 1
  end
  say "SERVER_METRICS served=" || served "elapsed_us=" || server_elapsed_us "scans=" || server.scans() "idle_scans=" || server.idle_scans()
  if errors > 0 then return 1
  say "PASS: Level G HTTP server dispatched two bounded requests to task handlers"
  return 0

exit main()
