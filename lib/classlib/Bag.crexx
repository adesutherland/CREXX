options levelb comments_dash

import data

namespace data expose Bag

/**
 * A simple bag (multiset) of strings.
 *
 * Duplicate values are allowed and values are retained in insertion order.
 */
Bag: interface

  /**
   * Creates an empty bag.
   *
   * @return .Bag Newly created empty bag.
   */
  *: factory

  /**
   * Adds a value to this bag.
   *
   * Duplicate values are allowed.
   *
   * @param value Value to add.
   * @return .void
   */
  add: method = .void
    arg value = .string

  /**
   * Returns the number of values in this bag.
   *
   * @return .int Number of values in the bag.
   */
  size: method = .int

  /**
   * Returns the value at the specified one-based position.
   *
   * @param position One-based element position.
   * @return .string Value at the specified position.
   */
  at: method = .string
    arg position = .int

  -- /**
  --  * Creates an iterator over the live bag.
  --  *
  --  * Values added after iterator creation may be observed by the iterator.
  --  *
  --  * @return .BagIterator Live iterator.
  --  */
  -- liveIterator: method = .BagIterator

  -- /**
  --  * Creates an iterator over a snapshot of this bag.
  --  *
  --  * Changes made after iterator creation are not visible to the iterator.
  --  *
  --  * @return .BagIterator Snapshot iterator.
  --  */
  -- snapshotIterator: method = .BagIterator
