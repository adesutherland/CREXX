options levelb comments_dash
namespace data expose ObjectObjectTreeMap

/**
 * Ordered map from object keys to object values, backed by an AVL tree.
 *
 * Nodes are stored in parallel arrays and linked by integer child indexes. The
 * deleted-node free list reuses node slots without compacting the arrays, so
 * lookup, insertion, removal, and ordered traversal avoid the old array-backed
 * map's linear scan and snapshot sort hot paths.
 */
ObjectObjectTreeMap: class
val	    = .int
root_	    = .int
count_	    = .int
node_count_ = .int
free_count_ = .int
keys_	    = .object[]
values_	    = .object[]
left_	    = .int[]
right_	    = .int[]
height_	    = .int[]
free_	    = .int[]
comparator_ = .ObjectComparator

  /**
   * Create an empty ObjectObjectTreeMap using the supplied comparator.
   *
   * @param comparator Comparator defining key order and equality.
   * @return .ObjectObjectTreeMap
   */
  *: factory
    arg comparator = .ObjectComparator
    comparator_ = comparator
    val = 1
    root_ = 0
    count_ = 0
    node_count_ = 0
    free_count_ = 0
    return

  /**
   * Associates the specified value with the specified key in this map.
   *
   * @param key Key object to store.
   * @param value Object value to associate with the key.
   * @return .int 0 on success.
   */
  put: method = .int
    arg key = .object, value = .object
    new_node = .int

    if root_ = 0 then do
      if free_count_ > 0 then do
        new_node = free_[free_count_]
        free_[free_count_] = 0
        free_count_ = free_count_ - 1
      end
      else do
        node_count_ = node_count_ + 1
        new_node = node_count_
      end
      keys_[new_node] = key
      values_[new_node] = value
      left_[new_node] = 0
      right_[new_node] = 0
      height_[new_node] = 1
      root_ = new_node
      count_ = 1
      return 0
    end

    path = .int[]
    direction = .int[]
    depth = 0
    node = root_
    parent = 0
    last_direction = 0

    do while node <> 0
      comparison = comparator_.compare(key, keys_[node])
      if comparison = 0 then do
        values_[node] = value
        return 0
      end

      depth = depth + 1
      path[depth] = node
      parent = node

      if comparison < 0 then do
        direction[depth] = -1
        last_direction = -1
        node = left_[node]
      end
      else do
        direction[depth] = 1
        last_direction = 1
        node = right_[node]
      end
    end

    if free_count_ > 0 then do
      new_node = free_[free_count_]
      free_[free_count_] = 0
      free_count_ = free_count_ - 1
    end
    else do
      node_count_ = node_count_ + 1
      new_node = node_count_
    end
    keys_[new_node] = key
    values_[new_node] = value
    left_[new_node] = 0
    right_[new_node] = 0
    height_[new_node] = 1
    count_ = count_ + 1
    if last_direction < 0 then left_[parent] = new_node
    else right_[parent] = new_node

    do level = depth to 1 by -1
      subtree = path[level]
      left_height = 0
      right_height = 0
      left_child = left_[subtree]
      right_child = right_[subtree]
      if left_child <> 0 then left_height = height_[left_child]
      if right_child <> 0 then right_height = height_[right_child]

      if left_height > right_height then height_[subtree] = left_height + 1
      else height_[subtree] = right_height + 1

      balance = left_height - right_height

      if balance > 1 then do
        child = left_[subtree]
        child_left_height = 0
        child_right_height = 0
        grandchild = left_[child]
        if grandchild <> 0 then child_left_height = height_[grandchild]
        grandchild = right_[child]
        if grandchild <> 0 then child_right_height = height_[grandchild]

        if child_left_height < child_right_height then do
          rotate_x = child
          rotate_y = right_[rotate_x]
          transfer = left_[rotate_y]
          left_[rotate_y] = rotate_x
          right_[rotate_x] = transfer

          left_height = 0
          right_height = 0
          left_child = left_[rotate_x]
          right_child = right_[rotate_x]
          if left_child <> 0 then left_height = height_[left_child]
          if right_child <> 0 then right_height = height_[right_child]
          if left_height > right_height then height_[rotate_x] = left_height + 1
          else height_[rotate_x] = right_height + 1

          left_height = 0
          right_height = 0
          left_child = left_[rotate_y]
          right_child = right_[rotate_y]
          if left_child <> 0 then left_height = height_[left_child]
          if right_child <> 0 then right_height = height_[right_child]
          if left_height > right_height then height_[rotate_y] = left_height + 1
          else height_[rotate_y] = right_height + 1

          left_[subtree] = rotate_y
        end

        rotate_y = subtree
        rotate_x = left_[rotate_y]
        transfer = right_[rotate_x]
        right_[rotate_x] = rotate_y
        left_[rotate_y] = transfer

        left_height = 0
        right_height = 0
        left_child = left_[rotate_y]
        right_child = right_[rotate_y]
        if left_child <> 0 then left_height = height_[left_child]
        if right_child <> 0 then right_height = height_[right_child]
        if left_height > right_height then height_[rotate_y] = left_height + 1
        else height_[rotate_y] = right_height + 1

        left_height = 0
        right_height = 0
        left_child = left_[rotate_x]
        right_child = right_[rotate_x]
        if left_child <> 0 then left_height = height_[left_child]
        if right_child <> 0 then right_height = height_[right_child]
        if left_height > right_height then height_[rotate_x] = left_height + 1
        else height_[rotate_x] = right_height + 1

        subtree = rotate_x
      end
      else if balance < -1 then do
        child = right_[subtree]
        child_left_height = 0
        child_right_height = 0
        grandchild = left_[child]
        if grandchild <> 0 then child_left_height = height_[grandchild]
        grandchild = right_[child]
        if grandchild <> 0 then child_right_height = height_[grandchild]

        if child_right_height < child_left_height then do
          rotate_y = child
          rotate_x = left_[rotate_y]
          transfer = right_[rotate_x]
          right_[rotate_x] = rotate_y
          left_[rotate_y] = transfer

          left_height = 0
          right_height = 0
          left_child = left_[rotate_y]
          right_child = right_[rotate_y]
          if left_child <> 0 then left_height = height_[left_child]
          if right_child <> 0 then right_height = height_[right_child]
          if left_height > right_height then height_[rotate_y] = left_height + 1
          else height_[rotate_y] = right_height + 1

          left_height = 0
          right_height = 0
          left_child = left_[rotate_x]
          right_child = right_[rotate_x]
          if left_child <> 0 then left_height = height_[left_child]
          if right_child <> 0 then right_height = height_[right_child]
          if left_height > right_height then height_[rotate_x] = left_height + 1
          else height_[rotate_x] = right_height + 1

          right_[subtree] = rotate_x
        end

        rotate_x = subtree
        rotate_y = right_[rotate_x]
        transfer = left_[rotate_y]
        left_[rotate_y] = rotate_x
        right_[rotate_x] = transfer

        left_height = 0
        right_height = 0
        left_child = left_[rotate_x]
        right_child = right_[rotate_x]
        if left_child <> 0 then left_height = height_[left_child]
        if right_child <> 0 then right_height = height_[right_child]
        if left_height > right_height then height_[rotate_x] = left_height + 1
        else height_[rotate_x] = right_height + 1

        left_height = 0
        right_height = 0
        left_child = left_[rotate_y]
        right_child = right_[rotate_y]
        if left_child <> 0 then left_height = height_[left_child]
        if right_child <> 0 then right_height = height_[right_child]
        if left_height > right_height then height_[rotate_y] = left_height + 1
        else height_[rotate_y] = right_height + 1

        subtree = rotate_y
      end

      if level = 1 then root_ = subtree
      else do
        parent = path[level - 1]
        if direction[level - 1] < 0 then left_[parent] = subtree
        else right_[parent] = subtree
      end
    end

    return 0

  /**
   * Returns the value to which the specified key is mapped.
   *
   * @param key Key object to look up.
   * @return .object Mapped object, or an uninitialized object if the key is absent.
   */
  get: method = .object
    arg key = .object
    node = root_
    do while node <> 0
      comparison = comparator_.compare(key, keys_[node])
      if comparison = 0 then return values_[node]
      if comparison < 0 then node = left_[node]
      else node = right_[node]
    end
    none = .object
    return none

  /**
   * Returns the number of key-value mappings in this map.
   *
   * @return .int Number of mappings.
   */
  size: method = .int
    return count_

  /**
   * Removes a mapping from this map.
   *
   * @param key Key object to remove.
   * @return .int 0 if removed, 4 if the key was not present.
   */
  remove: method = .int
    arg key = .object
    path = .int[]
    direction = .int[]
    depth = 0
    node = root_

    do while node <> 0
      comparison = comparator_.compare(key, keys_[node])
      if comparison = 0 then leave

      depth = depth + 1
      path[depth] = node
      if comparison < 0 then do
        direction[depth] = -1
        node = left_[node]
      end
      else do
        direction[depth] = 1
        node = right_[node]
      end
    end

    if node = 0 then return 4

    removed = node
    if left_[node] <> 0 & right_[node] <> 0 then do
      depth = depth + 1
      path[depth] = node
      direction[depth] = 1
      successor_parent = node
      successor = right_[node]
      do while left_[successor] <> 0
        successor_parent = successor
        depth = depth + 1
        path[depth] = successor
        direction[depth] = -1
        successor = left_[successor]
      end

      keys_[node] = keys_[successor]
      values_[node] = values_[successor]
      replacement = right_[successor]
      if successor_parent = node then right_[node] = replacement
      else left_[successor_parent] = replacement
      removed = successor
    end
    else do
      replacement = left_[node]
      if replacement = 0 then replacement = right_[node]
      if depth = 0 then root_ = replacement
      else do
        parent = path[depth]
        if direction[depth] < 0 then left_[parent] = replacement
        else right_[parent] = replacement
      end
    end

    removed_key = .object
    keys_[removed] = removed_key
    removed_value = .object
    values_[removed] = removed_value
    left_[removed] = 0
    right_[removed] = 0
    height_[removed] = 0
    free_count_ = free_count_ + 1
    free_[free_count_] = removed
    count_ = count_ - 1

    do level = depth to 1 by -1
      subtree = path[level]
      left_height = 0
      right_height = 0
      left_child = left_[subtree]
      right_child = right_[subtree]
      if left_child <> 0 then left_height = height_[left_child]
      if right_child <> 0 then right_height = height_[right_child]

      if left_height > right_height then height_[subtree] = left_height + 1
      else height_[subtree] = right_height + 1

      balance = left_height - right_height

      if balance > 1 then do
        child = left_[subtree]
        child_left_height = 0
        child_right_height = 0
        grandchild = left_[child]
        if grandchild <> 0 then child_left_height = height_[grandchild]
        grandchild = right_[child]
        if grandchild <> 0 then child_right_height = height_[grandchild]

        if child_left_height < child_right_height then do
          rotate_x = child
          rotate_y = right_[rotate_x]
          transfer = left_[rotate_y]
          left_[rotate_y] = rotate_x
          right_[rotate_x] = transfer

          left_height = 0
          right_height = 0
          left_child = left_[rotate_x]
          right_child = right_[rotate_x]
          if left_child <> 0 then left_height = height_[left_child]
          if right_child <> 0 then right_height = height_[right_child]
          if left_height > right_height then height_[rotate_x] = left_height + 1
          else height_[rotate_x] = right_height + 1

          left_height = 0
          right_height = 0
          left_child = left_[rotate_y]
          right_child = right_[rotate_y]
          if left_child <> 0 then left_height = height_[left_child]
          if right_child <> 0 then right_height = height_[right_child]
          if left_height > right_height then height_[rotate_y] = left_height + 1
          else height_[rotate_y] = right_height + 1

          left_[subtree] = rotate_y
        end

        rotate_y = subtree
        rotate_x = left_[rotate_y]
        transfer = right_[rotate_x]
        right_[rotate_x] = rotate_y
        left_[rotate_y] = transfer

        left_height = 0
        right_height = 0
        left_child = left_[rotate_y]
        right_child = right_[rotate_y]
        if left_child <> 0 then left_height = height_[left_child]
        if right_child <> 0 then right_height = height_[right_child]
        if left_height > right_height then height_[rotate_y] = left_height + 1
        else height_[rotate_y] = right_height + 1

        left_height = 0
        right_height = 0
        left_child = left_[rotate_x]
        right_child = right_[rotate_x]
        if left_child <> 0 then left_height = height_[left_child]
        if right_child <> 0 then right_height = height_[right_child]
        if left_height > right_height then height_[rotate_x] = left_height + 1
        else height_[rotate_x] = right_height + 1

        subtree = rotate_x
      end
      else if balance < -1 then do
        child = right_[subtree]
        child_left_height = 0
        child_right_height = 0
        grandchild = left_[child]
        if grandchild <> 0 then child_left_height = height_[grandchild]
        grandchild = right_[child]
        if grandchild <> 0 then child_right_height = height_[grandchild]

        if child_right_height < child_left_height then do
          rotate_y = child
          rotate_x = left_[rotate_y]
          transfer = right_[rotate_x]
          right_[rotate_x] = rotate_y
          left_[rotate_y] = transfer

          left_height = 0
          right_height = 0
          left_child = left_[rotate_y]
          right_child = right_[rotate_y]
          if left_child <> 0 then left_height = height_[left_child]
          if right_child <> 0 then right_height = height_[right_child]
          if left_height > right_height then height_[rotate_y] = left_height + 1
          else height_[rotate_y] = right_height + 1

          left_height = 0
          right_height = 0
          left_child = left_[rotate_x]
          right_child = right_[rotate_x]
          if left_child <> 0 then left_height = height_[left_child]
          if right_child <> 0 then right_height = height_[right_child]
          if left_height > right_height then height_[rotate_x] = left_height + 1
          else height_[rotate_x] = right_height + 1

          right_[subtree] = rotate_x
        end

        rotate_x = subtree
        rotate_y = right_[rotate_x]
        transfer = left_[rotate_y]
        left_[rotate_y] = rotate_x
        right_[rotate_x] = transfer

        left_height = 0
        right_height = 0
        left_child = left_[rotate_x]
        right_child = right_[rotate_x]
        if left_child <> 0 then left_height = height_[left_child]
        if right_child <> 0 then right_height = height_[right_child]
        if left_height > right_height then height_[rotate_x] = left_height + 1
        else height_[rotate_x] = right_height + 1

        left_height = 0
        right_height = 0
        left_child = left_[rotate_y]
        right_child = right_[rotate_y]
        if left_child <> 0 then left_height = height_[left_child]
        if right_child <> 0 then right_height = height_[right_child]
        if left_height > right_height then height_[rotate_y] = left_height + 1
        else height_[rotate_y] = right_height + 1

        subtree = rotate_y
      end

      if level = 1 then root_ = subtree
      else do
        parent = path[level - 1]
        if direction[level - 1] < 0 then left_[parent] = subtree
        else right_[parent] = subtree
      end
    end

    return 0

  /**
   * Tests whether this map contains a mapping for the specified key object.
   *
   * @param key Key object to test.
   * @return .int 1 if present, 0 otherwise.
   */
  containsKey: method = .int
    arg key = .object
    node = root_
    do while node <> 0
      comparison = comparator_.compare(key, keys_[node])
      if comparison = 0 then return 1
      if comparison < 0 then node = left_[node]
      else node = right_[node]
    end
    return 0

  /**
   * Returns the first key in comparator order.
   *
   * @return .object First key, or an uninitialized object if the map is empty.
   */
  firstKey: method = .object
    stack = .int[]
    top = 0
    node = root_
    do while node <> 0 | top > 0
      do while node <> 0
        top = top + 1
        stack[top] = node
        node = left_[node]
      end
      node = stack[top]
      top = top - 1
      return keys_[node]
    end
    none = .object
    return none

  /**
   * Returns the last key in comparator order.
   *
   * @return .object Last key, or an uninitialized object if the map is empty.
   */
  lastKey: method = .object
    stack = .int[]
    top = 0
    node = root_
    do while node <> 0 | top > 0
      do while node <> 0
        top = top + 1
        stack[top] = node
        node = right_[node]
      end
      node = stack[top]
      top = top - 1
      return keys_[node]
    end
    none = .object
    return none

  /**
   * Returns the keys in comparator order.
   *
   * @return .object[] Ordered array of keys.
   */
  keyArray: method = .object[]
    result = .object[]
    out = 0
    stack = .int[]
    top = 0
    node = root_
    do while node <> 0 | top > 0
      do while node <> 0
        top = top + 1
        stack[top] = node
        node = left_[node]
      end
      node = stack[top]
      top = top - 1
      out = out + 1
      result[out] = keys_[node]
      node = right_[node]
    end
    return result

  /**
   * Returns the object values ordered by their corresponding keys.
   *
   * @return .object[] Array of object values in key order.
   */
  valueArray: method = .object[]
    result = .object[]
    out = 0
    stack = .int[]
    top = 0
    node = root_
    do while node <> 0 | top > 0
      do while node <> 0
        top = top + 1
        stack[top] = node
        node = left_[node]
      end
      node = stack[top]
      top = top - 1
      out = out + 1
      result[out] = values_[node]
      node = right_[node]
    end
    return result

  /**
   * Returns an iterator over keys and object values in comparator order.
   *
   * @return .ObjectObjectTreeMapIterator Iterator over this map snapshot.
   */
  iterator: method = .ObjectObjectTreeMapIterator
    return .ObjectObjectTreeMapIterator(keyArray(), valueArray())

  /**
   * Clears this map and releases its backing arrays.
   *
   * @return .int 0 on success.
   */
  free: method = .int
    assembler SETATTRS keys_,0
    assembler SETATTRS values_,0
    assembler SETATTRS left_,0
    assembler SETATTRS right_,0
    assembler SETATTRS height_,0
    assembler SETATTRS free_,0
    root_ = 0
    count_ = 0
    node_count_ = 0
    free_count_ = 0
    val = 0
    return 0
