options levelb comments_dash
import data
import rexx

failures = 0
a = .TreeMap(.RexxComparator())

key = .rexx
val = .rexx

loop i=9 to 1 by -1 
  key	= .rexx('foo'||i)
  val	= .rexx('bar'||i)
  rc = a.put(key as .object,val as .object)
end
if val.toString() <> 'bar1' then failures=failures+1
if a.size() <> 9 then failures=failures+1

i = a.iterator()
loop while i.hasNext()
  key = i.next() as .rexx
end
if key.toString()  <> 'foo9' then failures=failures+1


if a.toString() <> ,
'{foo1=bar1, foo2=bar2, foo3=bar3, foo4=bar4, foo5=bar5, foo6=bar6, foo7=bar7, foo8=bar8, foo9=bar9}' then ,
failures=failures+1

if failures <> 0 then say 'FAIL'
else say 'PASS'

return failures
