/* rexx */
options levelb comments_dash
import data_KeyDB
import rxfnsb

arg test_args = .string[]

if test_args.0 > 0 then database_file = "testKeyDB." || test_args.1 || ".db"
else database_file = "testKeyDB.db"

kdb = .KeyDB()
failures = 0
alpha_value = "one" || d2c(26) || "tail" /* ASCII SUB must survive binary file I/O on Windows. */

handle = kdb.open(database_file, "w+")
if handle < 0 then do
  say "Failed to open key database:" handle
  return 1
end

rc = kdb.begin()
failures = failures + check_int("begin", rc, 0)
failures = failures + check_int("put alpha", kdb.put("alpha", alpha_value), 0)
failures = failures + check_int("put beta", kdb.put("beta", "two"), 0)
rc = kdb.commit()
failures = failures + check_int("commit", rc, 0)

failures = failures + check_string("get alpha", kdb.get("alpha"), alpha_value)
failures = failures + check_string("get beta", kdb.get("beta"), "two")
failures = failures + check_int("contains alpha", kdb.containsKey("alpha"), 1)
failures = failures + check_int("size after insert", kdb.size(), 2)
failures = failures + check_int("validate", kdb.validate(), 0)

/* Enumeration keeps its own cursor when get() seeks the index file. */
key = kdb.firstKey()
failures = failures + check_string("first key", key, "alpha")
failures = failures + check_string("get during enumeration", kdb.get(key), alpha_value)
failures = failures + check_string("next key after get", kdb.nextKey(), "beta")
failures = failures + check_string("end of enumeration", kdb.nextKey(), "NOT_FOUND")

/* Prefix search scans active keys and returns them in index order. */
failures = failures + check_int("begin prefix data", kdb.begin(), 0)
failures = failures + check_int("put prefix one", kdb.put("customer:001", "one"), 0)
failures = failures + check_int("put prefix two", kdb.put("customer:002", "two"), 0)
failures = failures + check_int("put other prefix", kdb.put("order:001", "order"), 0)
failures = failures + check_int("commit prefix data", kdb.commit(), 0)
prefix_keys = .string[]
prefix_keys = kdb.findkeys("customer:",'ONLY')
failures = failures + check_int("prefix match count", prefix_keys[0], 2)
if prefix_keys[0] = 2 then do
  failures = failures + check_string("prefix first key", prefix_keys[1], "customer:001")
  failures = failures + check_string("prefix second key", prefix_keys[2], "customer:002")
end
empty_prefix = .string[]
empty_prefix = kdb.findkeys("missing:",'only')
failures = failures + check_int("prefix no match", empty_prefix[0], 0)
failures = failures + check_int("remove prefix one", kdb.removeCommit("customer:001"), 0)
failures = failures + check_int("remove prefix two", kdb.removeCommit("customer:002"), 0)
failures = failures + check_int("remove other prefix", kdb.removeCommit("order:001"), 0)

/* Updates replace the existing record and rollback restores both files. */
failures = failures + check_int("begin update rollback", kdb.begin(), 0)
failures = failures + check_int("update alpha", kdb.put("alpha", "rolled back"), 0)
failures = failures + check_int("rollback update", kdb.rollback(), 0)
failures = failures + check_string("value after rollback", kdb.get("alpha"), alpha_value)
failures = failures + check_int("size after rollback", kdb.size(), 2)

failures = failures + check_int("update commit begin", kdb.begin(), 0)
failures = failures + check_int("update alpha committed", kdb.put("alpha", "updated"), 0)
failures = failures + check_int("update commit", kdb.commit(), 0)
failures = failures + check_string("updated value", kdb.get("alpha"), "updated")
failures = failures + check_int("size after update", kdb.size(), 2)

failures = failures + check_int("remove beta", kdb.removeCommit("beta"), 0)

stats = kdb.stats()
if length(stats) = 0 then do
  say "stats returned an empty string"
  failures = failures + 1
end

/* Closing with an active transaction must roll it back. */
failures = failures + check_int("begin close rollback", kdb.begin(), 0)
failures = failures + check_int("put close rollback", kdb.put("transient", "not committed"), 0)
failures = failures + check_int("close rolls back", kdb.close(), 0)

rc = kdb.close()
failures = failures + check_int("close", rc, 0)

handle = kdb.open(database_file, "r")
if handle < 0 then do
  say "Failed to reopen key database:" handle
  failures = failures + 1
end
else do
  failures = failures + check_string("get alpha after reopen", kdb.get("alpha"), "updated")
  failures = failures + check_int("contains beta after reopen", kdb.containsKey("beta"), 0)
  failures = failures + check_string("get beta after reopen", kdb.get("beta"), "NOT_FOUND")
  failures = failures + check_string("uncommitted key absent", kdb.get("transient"), "NOT_FOUND")
  failures = failures + check_string("first key after deletion", kdb.firstKey(), "alpha")
  failures = failures + check_string("deleted key skipped", kdb.nextKey(), "NOT_FOUND")
  failures = failures + check_int("reopen already-open handle", kdb.open(database_file, "r") < 0, 0)
  failures = failures + check_string("value after repeated open", kdb.get("alpha"), "updated")
  failures = failures + check_int("close before clear", kdb.close(), 0)
  failures = failures + check_int("open for clear", kdb.open(database_file, "w+") < 0, 0)
  failures = failures + check_int("clear", kdb.clear(), 0)
  failures = failures + check_int("size after clear", kdb.size(), 0)
  failures = failures + check_string("first key after clear", kdb.firstKey(), "NOT_FOUND")
  failures = failures + check_int("begin reset data", kdb.begin(), 0)
  failures = failures + check_int("put reset data", kdb.put("reset-me", "value"), 0)
  failures = failures + check_int("commit reset data", kdb.commit(), 0)
  failures = failures + check_string("reset data present", kdb.get("reset-me"), "value")
  failures = failures + check_int("reset", kdb.reset(), 0)
  failures = failures + check_int("size after reset", kdb.size(), 0)
  failures = failures + check_string("reset removes data", kdb.get("reset-me"), "NOT_FOUND")
  failures = failures + check_int("close after reopen", kdb.close(), 0)
end

if failures > 0 then do
  say "testKeyDB failed:" failures "check(s)"
  return 1
end

say "testKeyDB ok"
return 0

check_int: procedure = .int
  arg label = .string, actual = .int, expected = .int
  if actual = expected then return 0
  say label "expected" expected "got" actual
  return 1

check_string: procedure = .int
  arg label = .string, actual = .string, expected = .string
  if actual = expected then return 0
  say label "expected" expected "got" actual
  return 1
