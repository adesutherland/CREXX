options levelg comments_dash

namespace test_taskcontext_endpoint expose context_endpoint_writer
import concurrency
import rxfnsb

context_endpoint_writer: class implements .taskwork
  *: factory
    return

  run: method = .channelvalue
    arg provider_reference = .channelvalue, context = .taskcontext
    endpoint = context.endpoint(provider_reference)
    completion = endpoint.start_write('c0ffee'x as .binary, -1).wait(-1)
    if completion.succeeded() = 0 then do
      call endpoint.close()
      return .channelvalue.integer_value(-1)
    end
    accepted = completion.value().as_integer()
    call endpoint.half_close(2)
    call endpoint.close()
    return .channelvalue.integer_value(accepted)

main: procedure = .int
  endpoint = .byteendpoint.memory(3, 16)
  pool = .taskpool.local(1, 2)
  scope = .taskscope.collectall(pool, 60000)
  child = scope.submit(task .context_endpoint_writer(), endpoint.provider_reference())
  completion = child.wait(-1)
  if completion.succeeded() = 0 then do
    say "FAIL: taskcontext endpoint task" completion.error_code() completion.message()
    call scope.abort(.channelvalue.string_value("taskcontext endpoint failed"))
    call pool.close()
    call endpoint.close()
    return 1
  end
  if completion.value().as_integer() <> 3 then do
    say "FAIL: taskcontext endpoint accepted" completion.value().as_integer()
    call scope.finish()
    call pool.close()
    call endpoint.close()
    return 2
  end
  observed = endpoint.start_read(16, -1).wait(-1)
  observed_eof = endpoint.start_read(16, -1).wait(-1)
  call scope.finish()
  call pool.close()
  call endpoint.close()
  if observed.succeeded() = 0 then do
    say "FAIL: taskcontext endpoint controller read" observed.error_code() observed.message()
    return 3
  end
  if observed.value().as_binary() <> 'c0ffee'x as .binary then do
    say "FAIL: taskcontext endpoint transferred bytes"
    return 4
  end
  if observed_eof.succeeded() = 0 | observed_eof.details().field("eof").as_boolean() = 0 then do
    say "FAIL: taskcontext endpoint write half did not close"
    return 5
  end
  say "PASS: taskcontext endpoint adapts a type-4 provider reference"
  return 0
