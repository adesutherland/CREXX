/* Complete public-surface tests for the Level B .Rexx class. */
options levelb comments_dash numeric_classic
import rexx
import rxfnsb

errors = 0
errors = errors + test_construction()
errors = errors + test_text_methods()
errors = errors + test_conversions()
errors = errors + test_numeric_methods()
errors = errors + test_format_presence()
errors = errors + test_word_and_introspection_methods()
errors = errors + test_signals()

if errors = 0 then say "PASS: Rexx class complete public surface"
return errors <> 0

test_construction: procedure = .int
  errors = 0
  subject = .rexx("Mixed")
  errors = errors + check(subject.toString() = "Mixed", "factory and toString")
  errors = errors + check(subject.stringValue() = "Mixed", "stringValue")
  errors = errors + check(subject.length() = 5, "length")
  errors = errors + check(subject.linesize() = 999999999, "linesize")
  return errors

test_text_methods: procedure = .int
  errors = 0

  errors = errors + check(.rexx("Print").abbrev("Pri"), "abbrev default")
  errors = errors + check(.rexx("PRINT").abbrev("PRI", 4) = 0, "abbrev minimum")
  errors = errors + check(.rexx("ABC").center(8, "-").toString() = "--ABC---", "center")
  errors = errors + check(.rexx("ABC").centre(7).toString() = "  ABC  ", "centre")
  errors = errors + check(.rexx("elephant").changestr("ph", "X").toString() = "eleXant", "changestr")
  errors = errors + check(.rexx("abc").compare("ak") = 2, "compare")
  errors = errors + check(.rexx("ab ").compare("ab", "x") = 3, "compare pad")
  errors = errors + check(.rexx("abc").copies(3).toString() = "abcabcabc", "copies")
  errors = errors + check(.rexx("abcabc").countstr("bc") = 2, "countstr")

  errors = errors + check(.rexx("abcde").delstr(3).toString() = "ab", "delstr omitted length")
  errors = errors + check(.rexx("abcde").delstr(3, 0).toString() = "abcde", "delstr explicit zero")
  errors = errors + check(.rexx("Now is the  time").delword(2, 2).toString() = "Now time", "delword count")
  errors = errors + check(.rexx("Now is the time ").delword(3).toString() = "Now is ", "delword omitted count")

  target = .rexx("abc")
  errors = errors + check(target.insert("123").toString() = "123abc", "insert default")
  errors = errors + check(target.insert("123", 5, 6, "+").toString() = "abc++123+++", "insert extension")
  errors = errors + check(target.insert("123", 0, 0).toString() = "abc", "insert explicit zero")
  errors = errors + check(target.insert("123", , 5, "-").toString() = "123--abc", "insert optional hole")
  errors = errors + check(target.toString() = "abc", "insert receiver unchanged")

  errors = errors + check(.rexx("Fou-Baa").lower().toString() = "fou-baa", "lower")
  overlay_target = .rexx("abcdef")
  errors = errors + check(overlay_target.overlay("qq").toString() = "qqcdef", "overlay default")
  errors = errors + check(overlay_target.overlay(".", 3, 2).toString() = "ab. ef", "overlay width")
  errors = errors + check(overlay_target.overlay("qq", 3, 0).toString() = "abcdef", "overlay explicit zero")
  errors = errors + check(overlay_target.overlay("foo", , 4, "*").toString() = "foo*ef", "overlay optional hole")
  errors = errors + check(overlay_target.toString() = "abcdef", "overlay receiver unchanged")

  search = .rexx("abc def ghi")
  errors = errors + check(search.pos(" ") = 4, "pos receiver is haystack")
  errors = errors + check(search.pos(" ", 5) = 8, "pos start")
  errors = errors + check(search.lastpos(" ") = 8, "lastpos receiver is haystack")
  errors = errors + check(search.lastpos(" ", 7) = 4, "lastpos search end")

  errors = errors + check(.rexx("abc d").left(8).toString() = "abc d   ", "left")
  errors = errors + check(.rexx("abc d").left(8, ".").toString() = "abc d...", "left pad")
  errors = errors + check(.rexx("12").right(5, "0").toString() = "00012", "right pad")
  errors = errors + check(.rexx("ABc.").reverse().toString() = ".cBA", "reverse")
  errors = errors + check(.rexx("  abc   def ").space(2, "+").toString() = "abc++def", "space")

  errors = errors + check(.rexx("　ab c　").strip().toString() = "ab c", "strip omitted Unicode whitespace")
  errors = errors + check(.rexx(" x　").strip(, " ").toString() = "x　", "strip explicit blank")
  errors = errors + check(.rexx("0012.7000").strip("B", "0").toString() = "12.7", "strip custom")
  errors = errors + check(.rexx("abc").substr(2).toString() = "bc", "substr omitted length")
  errors = errors + check(.rexx("abc").substr(2, 0).toString() = "", "substr explicit zero")
  errors = errors + check(.rexx("abc").substr(2, 6, ".").toString() = "bc....", "substr padding")

  errors = errors + check(.rexx("abbc").translate("&", "b").toString() = "a&&c", "translate")
  errors = errors + check(.rexx("Foo").translate().toString() = "FOO", "translate omitted tables")
  errors = errors + check(.rexx("a b").translate(, " ", "*").toString() = "a*b", "translate omitted output")
  errors = errors + check(.rexx("abc").translate(,, "$").toString() = "ABC", "translate pad does not replace uppercase mode")
  errors = errors + check(.rexx("Fou-Baa").upper().toString() = "FOU-BAA", "upper")
  errors = errors + check(.rexx("AB4T").verify("1234567890", "M") = 3, "verify")
  errors = errors + check(.rexx("i").sequence("l").toString() = "ijkl", "sequence")
  errors = errors + check(.rexx("a").xrange("f").toString() = "abcdef", "xrange")
  return errors

test_conversions: procedure = .int
  errors = 0
  errors = errors + check(.rexx("10111").b2x().toString() = "17", "b2x")
  errors = errors + check(.rexx("10 1010").b2d() = 42, "b2d")
  errors = errors + check(.rexx("M").c2x().toString() = "4D", "c2x")
  errors = errors + check(.rexx("M").c2d() = 77, "c2d")
  errors = errors + check(.rexx("129").d2b().toString() = "10000001", "d2b")
  errors = errors + check(.rexx("77").d2c().toString() = "M", "d2c")
  errors = errors + check(.rexx("129").d2x().toString() = "81", "d2x")
  errors = errors + check(.rexx("0001").x2b().toString() = "0000000000000001", "x2b leading zeros")
  errors = errors + check(.rexx("FF").x2c().toString() = "ÿ", "x2c Unicode byte")
  errors = errors + check(.rexx("81").x2d() = 129, "x2d omitted width")
  errors = errors + check(.rexx("81").x2d(2) = -127, "x2d signed width")
  errors = errors + check(.rexx("0031").x2d(0) = 0, "x2d explicit zero")
  errors = errors + check(.rexx("A").reradix(16, 10).toString() = "10", "reradix")
  return errors

test_numeric_methods: procedure = .int
  errors = 0
  source = .rexx(" - 123.45 ")
  errors = errors + check(source.abs().toString() = "123.45", "abs Classic sign whitespace")
  errors = errors + check(source.sign().toString() = "-1", "sign Classic sign whitespace")
  errors = errors + check(.rexx(" - 127.09782 ").trunc(3).toString() = "-127.097", "trunc Classic sign whitespace")
  errors = errors + check(source.toString() = " - 123.45 ", "numeric receiver unchanged")
  return errors

test_format_presence: procedure = .int
  numeric digits 18
  numeric form scientific
  errors = 0
  wrapped = .rexx(" + 12345.73 ")
  number = "12345.73" as .decimal

  errors = errors + check(wrapped.format().toString() = .rxfnsb..format(number), "format no controls")
  errors = errors + check(wrapped.format(8).toString() = .rxfnsb..format(number, 8), "format before")
  errors = errors + check(wrapped.format(, 3).toString() = .rxfnsb..format(number, , 3), "format after")
  errors = errors + check(wrapped.format(, , 2).toString() = .rxfnsb..format(number, , , 2), "format expp")
  errors = errors + check(wrapped.format(, , , 2).toString() = .rxfnsb..format(number, , , , 2), "format expt")
  errors = errors + check(wrapped.format(8, 3).toString() = .rxfnsb..format(number, 8, 3), "format before after")
  errors = errors + check(wrapped.format(8, , 2).toString() = .rxfnsb..format(number, 8, , 2), "format before expp")
  errors = errors + check(wrapped.format(8, , , 2).toString() = .rxfnsb..format(number, 8, , , 2), "format before expt")
  errors = errors + check(wrapped.format(, 3, 2).toString() = .rxfnsb..format(number, , 3, 2), "format after expp")
  errors = errors + check(wrapped.format(, 3, , 2).toString() = .rxfnsb..format(number, , 3, , 2), "format after expt")
  errors = errors + check(wrapped.format(, , 2, 2).toString() = .rxfnsb..format(number, , , 2, 2), "format expp expt")
  errors = errors + check(wrapped.format(8, 3, 2).toString() = .rxfnsb..format(number, 8, 3, 2), "format before after expp")
  errors = errors + check(wrapped.format(8, 3, , 2).toString() = .rxfnsb..format(number, 8, 3, , 2), "format before after expt")
  errors = errors + check(wrapped.format(8, , 2, 2).toString() = .rxfnsb..format(number, 8, , 2, 2), "format before expp expt")
  errors = errors + check(wrapped.format(, 3, 2, 2).toString() = .rxfnsb..format(number, , 3, 2, 2), "format after expp expt")
  errors = errors + check(wrapped.format(8, 3, 2, 2).toString() = .rxfnsb..format(number, 8, 3, 2, 2), "format all controls")
  return errors

test_word_and_introspection_methods: procedure = .int
  errors = 0
  words = .rexx("Now is the  time")
  errors = errors + check(words.word(3).toString() = "the", "word")
  errors = errors + check(words.words() = 4, "words")
  errors = errors + check(words.wordindex(3) = 8, "wordindex")
  errors = errors + check(words.subword(2, 2).toString() = "is the", "subword count")
  errors = errors + check(words.subword(3).toString() = "the  time", "subword omitted count")
  errors = errors + check(words.wordlength(3) = 3, "wordlength")
  errors = errors + check(words.wordpos("is the") = 2, "wordpos")
  errors = errors + check(.rexx("not_used").symbol() = "LIT", "symbol")
  errors = errors + check(.rexx("21.3").datatype() = "NUM", "datatype classification")
  errors = errors + check(.rexx("123").datatype("W") = "1", "datatype test")
  errors = errors + check(.rexx("missing").value().toString() = "MISSING", "value fallback")
  return errors

test_signals: procedure = .int
  errors = 0
  caught = 0

  do
    ignored = .rexx("Print").abbrev("Pri", -1)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("102").b2d()
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("abc").delstr(0)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("abc").delstr(1, -1)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("abc").insert("x", -1)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("abc").left(4, "")
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("abc").overlay("x", 0)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("abc").pos("a", 0)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("abc").lastpos("a", 0)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("abc").right(4, "xy")
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("abc").strip(, "")
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("abc").substr(0)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("abc").substr(1, -1)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("not-a-number").abs()
  on signal conversion_error
    caught = caught + 1
  end
  do
    ignored = .rexx("not-a-number").sign()
  on signal conversion_error
    caught = caught + 1
  end
  do
    ignored = .rexx("not-a-number").trunc()
  on signal conversion_error
    caught = caught + 1
  end
  do
    ignored = .rexx("123").format(2)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("1").trunc(-1)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("1G").x2b()
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .rexx("81").x2d(-1)
  on signal invalid_arguments
    caught = caught + 1
  end

  errors = errors + check(caught = 20, "all adapter failures are catchable signals")
  return errors

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: Rexx class" label
  return 1
