options levelb comments_dash
namespace data expose ObjectObjectHashMapIterator

/** Snapshot iterator over object keys and their associated object values. */
ObjectObjectHashMapIterator: class implements .ObjectIterator
keys_ = .object[]
values_ = .object[]
position_ = .int

  /**
   * Create an iterator over insertion-ordered snapshot arrays.
   *
   * @param keys Snapshot of map keys.
   * @param values Snapshot of map values.
   * @return .ObjectObjectHashMapIterator
   */
  *: factory
    arg keys = .object[], values = .object[]
    keys_ = keys
    values_ = values
    position_ = 0
    return

  /** @return .int 1 when another key is available, otherwise 0. */
  hasNext: method = .int
    if position_ < keys_[0] then return 1
    return 0

  /** @return .object Next key in insertion order. */
  next: method = .object
    position_ = position_ + 1
    return keys_[position_]

  /** @return .object Next key in insertion order. */
  nextKey: method = .object
    return next()

  /** @return .object Value associated with the current key. */
  value: method = .object
    return values_[position_]

  /** @return .object Next value in insertion order. */
  nextValue: method = .object
    position_ = position_ + 1
    return values_[position_]
