options levelb numeric_classic comments_dash
namespace time expose OffsetDateTime

import time

/**
 * Represents a date and time with a UTC offset.
 */
OffsetDateTime: class

  datetime_       = .DateTime
  offset_minutes_ = .int

  /**
   * Creates an OffsetDateTime.
   *
   * @param datetime the local date and time
   * @param offset_minutes the offset from UTC in minutes
   */
  *: factory
    arg datetime = .DateTime(), offset_minutes = 0

    datetime_ = datetime
    offset_minutes_ = offset_minutes
    return

  /**
   * Returns the local date and time.
   *
   * @return .DateTime the local DateTime
   */
  dateTime: method = .DateTime
    return datetime_

  /**
   * Returns the UTC offset in minutes.
   *
   * @return .int the offset from UTC in minutes
   */
  offsetMinutes: method = .int
    return offset_minutes_

  /**
   * Returns this value converted to UTC.
   *
   * The returned OffsetDateTime represents the same instant with an
   * offset of zero. This OffsetDateTime is not modified.
   *
   * @return .OffsetDateTime the equivalent value in UTC
   */

  toUTC: method = .OffsetDateTime
    base = datetime_.baseDate()
    day_us = datetime_.dayMicroseconds()

    copy = .DateTime(base,day_us)

    call copy.addMinutes(-offset_minutes_)

    return .OffsetDateTime(copy,0)
