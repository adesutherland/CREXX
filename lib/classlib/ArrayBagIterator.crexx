options levelb comments_dash

import data
namespace data expose ArrayBagIterator

/**
 * Iterator over a Bag.
 *
 * The iterator can operate either on the live Bag or on a snapshot captured
 * when the iterator is created.
 */
ArrayBagIterator: class
  bag_ref_ = reference .ArrayBag
  bag_copy_ = .ArrayBag
  position_ = .int
  snapshot_ = .int

  /**
   * Creates a Bag iterator.
   *
   * @param source Reference to the source Bag.
   * @param make_snapshot 0 for live iteration, non-zero for snapshot iteration.
   * @return .BagIterator Newly created iterator.
   */
  *: factory
    arg source = reference .ArrayBag, make_snapshot = .int

    snapshot_ = make_snapshot
    position_ = 1

    if snapshot_ then
      bag_copy_ = snapshot source
    else
      bag_ref_ = source

    return

  /**
   * Tests whether another value is available.
   *
   * @return .int 1 if another value is available, otherwise 0.
   */
  hasNext: method = .int
    if snapshot_ then
      return position_ <= bag_copy_.size()

    if <refvalid>(bag_ref_) = 0 then return 0

    bag = dereference bag_ref_
    return position_ <= bag.size()

  /**
   * Returns the next value.
   *
   * @return .string Next value, or an empty string when iteration is exhausted.
   */
  next: method = .string
    if snapshot_ then do
      if position_ > bag_copy_.size() then return ""
      value = bag_copy_.at(position_)
      position_ = position_ + 1
      return value
    end

    if <refvalid>(bag_ref_) = 0 then return ""

    bag = dereference bag_ref_
    if position_ > bag.size() then return ""

    value = .string
    value = bag.at(position_)
    position_ = position_ + 1
    return value
