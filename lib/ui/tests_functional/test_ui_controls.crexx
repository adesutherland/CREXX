/* Shared logical controls: identity, value ownership and rejected configuration. */
options levelg
import ui

main: procedure = .int
  failures = 0
  ids = .string[]
  labels = .string[]
  ids[1] = "AT"
  ids[2] = "DE"
  ids[3] = "EU"
  labels[1] = "Austria: 6 from 45"
  labels[2] = "Germany: 6 from 49"
  labels[3] = "Euro: 5 plus 2"
  view = .ui..uiview_impl("Lotto controls")
  rc = view.add_choice("game", ids, labels, "DE", "root", "")
  failures = failures + check(rc = 1, "choice accepted")
  rc = view.add_integer("tips", "10", 1, 50, 1, "below", "game")
  failures = failures + check(rc = 1, "integer accepted")
  call view.add_label("status", "Ready", "below", "tips")
  call view.add_button("generate", "Generate", "lotto.generate", "g", "below", "status")
  readonly = view as .uiview
  failures = failures + check(readonly.count() = 4, "same read-only interface")
  failures = failures + check(readonly.node_kind(1) = "choice", "choice kind")
  failures = failures + check(readonly.node_value(1) = "DE", "stable selected item")
  failures = failures + check(readonly.node_option_count(1) = 3, "choice cardinality")
  failures = failures + check(readonly.node_option_id(1, 3) = "EU", "option identity")
  failures = failures + check(readonly.node_option_text(1, 2) = labels[2], "option label")
  failures = failures + check(readonly.node_kind(2) = "integer", "integer kind")
  failures = failures + check(readonly.node_value(2) = "10", "integer value text")
  failures = failures + check(readonly.node_minimum(2) = 1 & readonly.node_maximum(2) = 50 & readonly.node_step(2) = 1, "integer bounds")
  failures = failures + check(readonly.node_row(2) = 1 & readonly.node_column(2) = 0, "shared placement")
  failures = failures + check(readonly.node_value(3) = "" & readonly.node_option_count(4) = 0, "legacy node defaults")
  failures = failures + check(readonly.node_option_id(1, 0) = "" & readonly.node_option_text(1, 4) = "", "invalid option indices")
  failures = failures + check(readonly.node_value(0) = "" & readonly.node_step(99) = 0, "invalid node indices")
  /* Rejected declarations do not partially mutate the view or earlier options. */
  count_before = view.count()
  rc = view.add_choice("missing", ids, labels, "UNKNOWN")
  failures = failures + check(rc = 0 & view.count() = count_before, "unknown selected identity rejected")
  rc = view.add_choice("game", ids, labels, "AT")
  failures = failures + check(rc = 0 & view.count() = count_before, "duplicate node rejected")
  duplicate_ids = ids
  duplicate_ids[2] = "AT"
  rc = view.add_choice("duplicate", duplicate_ids, labels, "AT")
  failures = failures + check(rc = 0 & view.count() = count_before, "duplicate option rejected")
  failures = failures + check(ids[2] = "DE" & view.node_option_id(1, 2) = "DE", "source and view value ownership")
  empty = .string[]
  rc = view.add_choice("empty", empty, empty, "")
  failures = failures + check(rc = 0 & view.count() = count_before, "empty choice rejected")
  rc = view.add_choice("mismatch", ids, empty, "AT")
  failures = failures + check(rc = 0 & view.count() = count_before, "label cardinality rejected")
  rc = view.add_integer("range", "10", 50, 1, 1)
  failures = failures + check(rc = 0 & view.count() = count_before, "reversed bounds rejected")
  rc = view.add_integer("step", "10", 1, 50, 0)
  failures = failures + check(rc = 0 & view.count() = count_before, "zero step rejected")
  rc = view.add_integer("editing", "", 1, 50)
  failures = failures + check(rc = 1 & view.node_value(5) = "", "empty editing value preserved")
  rc = view.add_integer("invalid-edit", "51", 1, 50)
  failures = failures + check(rc = 1 & view.node_value(6) = "51", "feature owns committed-value validation")
  if failures = 0 then say "PASS: shared UI choice and integer views"
  return failures <> 0

check: procedure = .int
  arg ok = .boolean, description = .string
  if ok then return 0
  say "FAIL:" description
  return 1
