options levelg
namespace ui_tui_test
import rxfnsb
import ui
import ui_contract
import ui_tui

commands = .string[]
commands[1] = "g"
commands[2] = "q"
commands[3] = "g"
commands[4] = "q"

journal = ""
session = .uisession("line-conformance", ui_tui..capabilities())
rc = session.add_component("root", .tui_probe(reference journal))
rc = session.register_event("probe.go")
rc = session.register_command(.uicommand("probe.go", "Go", "root", "probe.go", "g"))
rc = session.register_command(.uicommand("probe.quit", "Quit", "root", "ui.close.requested", "q"))
driver = .ui_tui..tuidriver.scripted(commands)
run_rc = driver.run(session)

if run_rc \= 0 then do
  say "FAIL: scripted TUI run returned" run_rc
  exit 1
end
if pos("Count: 1", driver.transcript()) = 0 then do
  say "FAIL: scripted TUI did not re-render updated state"
  exit 1
end
if journal \= "ui.ready probe.go ui.close.requested probe.go ui.close.requested ui.closed " then do
  say "FAIL: close was not vetoed or lifecycle not completed:" journal
  exit 1
end

say "PASS: TUI drives semantic events"
exit 0

tui_probe: class implements .uicomponent
  _count = .int
  _trace = reference .string

  *: factory
    arg journal = reference .string
    _trace = journal
    _count = 0
    return

  update: method = .uieffects
    arg event = .uimessage
    journal = dereference _trace
    journal = journal || event.name() || " "
    effects = .uieffects()
    if event.name() = "probe.go" then _count = _count + 1
    if event.name() = "ui.close.requested" & _count >= 2 then
      call effects.add(.uimessage("ui.close", .uipayload(), "root", "effect"))
    return effects

  view: method = .uiview
    result = .ui..uiview_impl("TUI probe")
    call result.add_label("count", "Count: " || _count)
    call result.add_button("go", "Go", "probe.go", "g")
    call result.add_button("quit", "Quit", "probe.quit", "q")
    return result

  count: method = .int
    return _count
