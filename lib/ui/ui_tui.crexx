/* Portable Level G line-oriented driver for the experimental cREXX UI library. */
options levelg
namespace ui_tui expose tuidriver capabilities
import rxfnsb
import ui
import ui_contract
import ui_local_resources

/** @return services implemented by the line host, not raw terminal input */
capabilities: procedure = .uicapabilities
  caps = .uicapabilities()
  call caps.enable("ui.resource.choose")
  call caps.enable("io.text.read")
  call caps.enable("ui.dialog")
  return caps

/** Portable TUI driver with interactive and deterministic scripted modes. */
tuidriver: class implements .uidriver
  _scripted = .int
  _inputs = .string[]
  _input_count = .int
  _input_cursor = .int
  _transcript = .string
  _exhausted = .int
  _session = .uisession
  _resources = .uilocal_resources
  _request = .uimessage
  _modal = .int
  _running = .int
  _error = .string

  /** Construct an interactive terminal driver. */
  *: factory
    _scripted = 0
    _input_count = 0
    _input_cursor = 0
    _transcript = ""
    _exhausted = 0
    return

  /** Construct a deterministic terminal driver.
   * @param inputs commands and prompted values in consumption order
   */
  scripted: factory
    arg inputs = .string[]
    _scripted = 1
    _input_count = inputs[0]
    _input_cursor = 0
    _transcript = ""
    _exhausted = 0
    do index = 1 to _input_count
      _inputs[index] = inputs[index]
    end
    return

  /** Run the terminal event loop.
   * Input is line-blocking; effects and completions are serviced between lines.
   * A modal request persists across turns, never calls a feature recursively.
   * @param session configured application session owned for this run
   * @return zero on accepted close, two on host fault, three on input exhaustion
   */
  run: method = .int
    arg session = .uisession
    _session = session
    _resources = .uilocal_resources(session.id())
    _running = 1
    _modal = 0
    _error = ""
    answer = .string
    rc = _session.post(.uimessage("ui.ready", .uipayload()))
    if rc < 0 then _error = "Cannot admit ui.ready"
    do while _running & _error = ""
      call service()
      if \_running | _error \= "" then leave
      /* A finite service budget yields to the owner, not to blocking input
       * while admitted work remains. No pending completion is stranded. */
      if _session.queued() > 0 | _session.pending() > 0 then iterate
      view = _session.view()
      call render(view)
      if _error \= "" then leave
      if _modal then do
        body = _request.body()
        call emit_line(body.text("title"))
        if _request.name() = "ui.resource.choose" then do
          answer = next_input("File path (empty cancels)")
          if _exhausted then leave
          call selected(answer)
        end
        else do
          call emit_line(body.text("message"))
          answer = lower(strip(next_input("OK / Cancel")))
          if _exhausted then leave
          if answer = "ok" | answer = "cancel" | answer = "" then do
            output = .uipayload()
            if answer = "ok" then do
              call output.put_text("response", "ok")
              call finish(_request, "ui.dialog.accepted", output)
            end
            else call cancelled("dialog_cancelled")
            _modal = 0
          end
          else call emit_line("Enter OK or Cancel")
        end
        iterate
      end
      command = next_input("Command")
      if _exhausted then leave
      command = lower(strip(command))

      action = ""
      do index = 1 to view.count()
        if view.node_kind(index) = "button" then do
          if command = lower(view.node_shortcut(index)) | command = lower(view.node_action(index)) then do
            action = view.node_action(index)
            leave
          end
        end
      end

      if action = "" then do
        call emit_line("Unknown command: " || command)
        iterate
      end

      rc = _session.invoke(action)
      if rc < 0 then call emit_line("Command unavailable: " || action)
    end
    /* No native surface remains. Teardown also invalidates resource grants. */
    call _session.close()
    if _exhausted then return 3
    if _error \= "" then do
      call emit_line(_error)
      return 2
    end
    return 0

  /** Owner-only service turn. File I/O is synchronous and bounded in this slice. */
  service: method = .void
    do budget = 1 to 64
      rc = _session.pump()
      if rc < 0 then do
        _error = _session.fault()
        return
      end
      if _session.pending() = 0 then return
      effect = _session.take_effect()
      name = effect.name()
      body = effect.body()
      if name = "ui.resource.choose" | name = "ui.dialog.confirm" then do
        if _modal then call fail_effect(effect, "dialog_busy", "Another dialog is active")
        else if name = "ui.resource.choose" & body.text("purpose") \= "open" then
          call fail_effect(effect, "unsupported_purpose", "This selector opens existing files only")
        else do
          _request = effect
          _modal = 1
        end
      end
      else if name = "io.text.read" then do
        rc = _session.complete(_resources.read(effect))
        if rc < 0 then _error = "Read completion rejected"
      end
      else if name = "ui.close" then do
        if _modal then call cancelled("host_closed")
        _modal = 0
        _running = 0
        call finish(effect, "ui.closed", .uipayload())
        rc = _session.pump()
        if rc < 0 then _error = _session.fault()
        return
      end
      else call fail_effect(effect, "unsupported_effect", "No line executor for " || name)
      if _error \= "" then return
    end
    return

  selected: method = .void
    arg path = .string
    if strip(path) = "" then call cancelled("dialog_cancelled")
    else do
      grant = _resources.grant(path)
      if grant.id() = "" then call fail_effect(_request, "resource_limit", "Local resource grant limit reached")
      else do
        body = .uipayload()
        call body.put_resource("resource", grant)
        call finish(_request, "ui.resource.selected", body)
      end
    end
    _modal = 0
    return

  cancelled: method = .void
    arg reason = .string
    body = .uipayload()
    call body.put_text("reason", reason)
    call finish(_request, "ui.effect.cancelled", body)
    return

  finish: method = .void
    arg request = .uimessage, name = .string, body = .uipayload
    rc = _session.complete(.uimessage(name, body, request.target(), "event", request.request_id(), request.session_id()))
    if rc < 0 then _error = "Effect completion rejected: " || name
    return

  fail_effect: method = .void
    arg request = .uimessage, code = .string, message = .string
    body = .uipayload()
    call body.put_text("code", code)
    call body.put_text("message", message)
    call finish(request, "ui.effect.failed", body)
    return

  /** @return complete scripted rendering and prompt transcript */
  transcript: method = .string
    return _transcript

  render: method = .void
    arg view = .uiview
    kind = .string
    call emit_line("")
    call emit_line("=== " || view.title() || " ===")

    /* The tracer uses a logical grid, but deliberately avoids terminal-cell
     * measurement policy. Nodes in the same row are joined left-to-right;
     * a later ANSI driver can use the same row/column values for cursor-based
     * rendering and width-aware alignment. */
    maximum_row = 0
    maximum_column = 0
    do position_index = 1 to view.count()
      kind = view.node_kind(position_index)
      if kind \= "label" & kind \= "line" & kind \= "button" then do
        _error = "Unsupported line view node: " || kind
        return
      end
      if view.node_row(position_index) > maximum_row then
        maximum_row = view.node_row(position_index)
      if view.node_column(position_index) > maximum_column then
        maximum_column = view.node_column(position_index)
    end

    do grid_row = 0 to maximum_row
      rendered = ""
      separator = 0
      do grid_column = 0 to maximum_column
        do render_index = 1 to view.count()
          if view.node_row(render_index) = grid_row & view.node_column(render_index) = grid_column then do
            kind = view.node_kind(render_index)
            if kind = "line" then separator = 1
            else do
              if rendered \= "" then rendered = rendered || "    "
              if kind = "button" then
                rendered = rendered || "[" || upper(view.node_shortcut(render_index)) || "] " || view.node_text(render_index)
              else rendered = rendered || view.node_text(render_index)
            end
          end
        end
      end
      if separator then call emit_line("------------------------------------------------------------")
      else if rendered \= "" then call emit_line(rendered)
    end
    return

  next_input: method = .string
    arg prompt = .string
    if _scripted then do
      if _input_cursor >= _input_count then do
        _exhausted = 1
        return ""
      end
      _input_cursor = _input_cursor + 1
      value = _inputs[_input_cursor]
      call emit_line(prompt || ": " || value)
      return value
    end
    say prompt || ":"
    return linein("")

  emit_line: method = .void
    arg line = .string
    if length(_transcript) > 0 then _transcript = _transcript || '0A'x
    _transcript = _transcript || line
    if \_scripted then say line
    return
