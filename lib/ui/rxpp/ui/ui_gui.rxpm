##MACRO UI_GUI phase,namespace,block_id
  phase = upper(unquote(phase))
  namespace = unquote(namespace)
  if phase \= 'BLOCK' then return

  control_count = 0
  command_count = 0
  binding_count = 0
  event_count = 0
  row_mode = 0
  previous_id = ''
  row_first_id = ''
  ids = ''
  allowed_name = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-'
  in_comment = 0
  do i = 1 to handler_lines.0
    line = strip(changestr('__RXPP_QUOTE__', handler_lines.i, '"'))
    if left(line, 2) = '/*' then in_comment = 1
    if in_comment then do
      if pos('*/', line) > 0 then in_comment = 0
      iterate
    end
    if line = '' then iterate
    if left(line, 2) = '--' then iterate
    op = upper(word(line, 1))
    if op = 'ROW' then do
      bad = 0
      if words(line) \= 1 then bad = 1
      if row_mode = 1 then bad = 1
      if bad = 1 then do
        handler_error = 'malformed or nested ROW'
        handler_error_line = i
        return
      end
      row_mode = 1
      row_first_id = ''
      iterate
    end
    if op = 'END' then do
      bad = 0
      if upper(word(line, 2)) \= 'ROW' then bad = 1
      if words(line) \= 2 then bad = 1
      if row_mode = 0 then bad = 1
      if bad = 1 then do
        handler_error = 'unmatched END ROW'
        handler_error_line = i
        return
      end
      row_mode = 0
      row_first_id = ''
      iterate
    end
    if op = 'BIND' then do
      if words(line) \= 3 then do
        handler_error = 'BIND requires a control ID and source node ID'
        handler_error_line = i
        return
      end
      binding_count = binding_count + 1
      binding_id.binding_count = word(line, 2)
      binding_source.binding_count = word(line, 3)
      bad = 0
      if verify(binding_id.binding_count, allowed_name) > 0 then bad = 1
      if verify(binding_source.binding_count, allowed_name) > 0 then bad = 1
      if bad = 1 then do
        handler_error = 'BIND contains an invalid identifier'
        handler_error_line = i
        return
      end
      binding_line.binding_count = i
      iterate
    end
    if op = 'ON' then do
      bad = 0
      if words(line) \= 4 then bad = 1
      if upper(word(line, 4)) \= 'FORWARD' then bad = 1
      if bad = 1 then do
        handler_error = 'ON requires event kind, control ID and FORWARD'
        handler_error_line = i
        return
      end
      event_count = event_count + 1
      event_kind.event_count = upper(word(line, 2))
      event_id.event_count = word(line, 3)
      if verify(event_id.event_count, allowed_name) > 0 then do
        handler_error = 'ON contains an invalid control ID'
        handler_error_line = i
        return
      end
      event_line.event_count = i
      iterate
    end
    kind = ''
    if op = 'LABEL' then kind = 'label'
    if op = 'LINE' then kind = 'line'
    if op = 'STATUSBAR' then kind = 'statusbar'
    if op = 'TEXT' then kind = 'input'
    if op = 'CHECKBOX' then kind = 'checkbox'
    if op = 'PROGRESS' then kind = 'progress'
    if op = 'BUTTON' then kind = 'button'
    if op = 'SCENE' then kind = 'scene'
    if kind = '' then do
      handler_error = 'unsupported DEFINE-GUI declaration ' || op
      handler_error_line = i
      return
    end
    control_id = word(line, 2)
    bad = 0
    if control_id = '' then bad = 1
    if wordpos(control_id, ids) > 0 then bad = 1
    if verify(control_id, allowed_name) > 0 then bad = 1
    if bad = 1 then do
      handler_error = 'missing, duplicate or invalid control ID ' || control_id
      handler_error_line = i
      return
    end
    if op = 'BUTTON' then do
      bad = 0
      if words(line) \= 8 then bad = 1
      if upper(word(line, 3)) \= 'ACTION' then bad = 1
      if upper(word(line, 5)) \= 'EVENT' then bad = 1
      if upper(word(line, 7)) \= 'SHORTCUT' then bad = 1
      if bad = 1 then do
        handler_error = 'BUTTON requires ACTION, EVENT and SHORTCUT'
        handler_error_line = i
        return
      end
      action = word(line, 4)
      event = word(line, 6)
      shortcut = word(line, 8)
      bad = 0
      if action = '' then bad = 1
      if event = '' then bad = 1
      if shortcut = '' then bad = 1
      if verify(action, allowed_name) > 0 then bad = 1
      if verify(event, allowed_name) > 0 then bad = 1
      if verify(shortcut, allowed_name) > 0 then bad = 1
      if bad = 1 then do
        handler_error = 'empty BUTTON command definition'
        handler_error_line = i
        return
      end
      found_command = 0
      do j = 1 to command_count
        if command_action.j = action then do
          found_command = 1
          bad = 0
          if command_event.j \= event then bad = 1
          if command_shortcut.j \= shortcut then bad = 1
          if bad = 1 then do
            handler_error = 'conflicting command definition ' || action
            handler_error_line = i
            return
          end
        end
      end
      if found_command = 0 then do
        command_count = command_count + 1
        command_action.command_count = action
        command_event.command_count = event
        command_shortcut.command_count = shortcut
      end
    end
    if op \= 'BUTTON' then do
      if words(line) \= 2 then do
        handler_error = op || ' requires exactly one control ID'
        handler_error_line = i
        return
      end
      action = 'none'
      event = ''
      shortcut = 'none'
    end
    control_count = control_count + 1
    control_kind.control_count = kind
    control_id_value.control_count = control_id
    control_source.control_count = control_id
    control_action.control_count = action
    control_event.control_count = event
    control_shortcut.control_count = shortcut
    control_relation.control_count = 'below'
    control_anchor.control_count = previous_id
    if previous_id = '' then control_relation.control_count = 'root'
    if row_mode = 1 then do
      if row_first_id = '' then row_first_id = control_id
      else control_relation.control_count = 'right'
    end
    previous_id = control_id
    ids = ids || ' ' || control_id
  end
  if row_mode = 1 then do
    handler_error = 'ROW is missing END ROW'
    handler_error_line = handler_lines.0
    return
  end
  if control_count = 0 then do
    handler_error = 'DEFINE-GUI has no controls'
    handler_error_line = 1
    return
  end
  do i = 1 to binding_count
    bad = 0
    if wordpos(binding_id.i, ids) = 0 then bad = 1
    if wordpos(binding_source.i, ids) = 0 then bad = 1
    if bad = 1 then do
      handler_error = 'BIND references an unknown control or source node'
      handler_error_line = binding_line.i
      return
    end
    do j = 1 to i - 1
      if binding_id.i = binding_id.j then do
        handler_error = 'duplicate BIND for ' || binding_id.i
        handler_error_line = binding_line.i
        return
      end
    end
    do j = 1 to control_count
      if control_id_value.j = binding_id.i then control_source.j = binding_source.i
    end
  end
  do i = 1 to event_count
    if wordpos(event_id.i, ids) = 0 then do
      handler_error = 'ON references an unknown control'
      handler_error_line = event_line.i
      return
    end
    if wordpos(event_kind.i, 'POINTER KEY CHANGE COMMIT CHECKED SELECTION') = 0 then do
      handler_error = 'unknown ON event kind ' || event_kind.i
      handler_error_line = event_line.i
      return
    end
    do j = 1 to control_count
      if control_id_value.j = event_id.i then do
        kind = control_kind.j
        bad = 0
        if event_kind.i = 'POINTER' then do
          if kind \= 'scene' then bad = 1
        end
        if event_kind.i = 'KEY' then do
          if kind \= 'scene' then bad = 1
        end
        if bad = 1 then do
          handler_error = 'scene input ON requires a SCENE control'
          handler_error_line = event_line.i
          return
        end
        bad = 0
        if event_kind.i = 'CHANGE' then do
          if kind \= 'input' then bad = 1
        end
        if event_kind.i = 'COMMIT' then do
          if kind \= 'input' then bad = 1
        end
        if bad = 1 then do
          handler_error = 'text input ON requires a TEXT control'
          handler_error_line = event_line.i
          return
        end
        if event_kind.i = 'CHECKED' then do
          if kind \= 'checkbox' then do
            handler_error = 'CHECKED requires a CHECKBOX control'
            handler_error_line = event_line.i
            return
          end
        end
        if event_kind.i = 'SELECTION' then do
          handler_error = 'SELECTION is unsupported by this bounded grammar'
          handler_error_line = event_line.i
          return
        end
      end
    end
  end

  .gen import ui
  .gen import ui_contract
  .gen source_node: procedure = .int
  .gen   arg source = .uiview, wanted = .string
  .gen   do index = 1 to source.count()
  .gen     if source.node_id(index) = wanted then return index
  .gen   end
  .gen   return 0
  .gen render: procedure = .uiview
  .gen   arg source = .uiview
  .gen   view = .ui..uiview_impl(source.title())
  do i = 1 to control_count
    control_id = control_id_value.i
    source_id = control_source.i
    kind = control_kind.i
    relation = control_relation.i
    anchor = control_anchor.i
    action = control_action.i
    shortcut = control_shortcut.i
    generated = '  index = source_node(source, "' || source_id || '")'
    .gen &generated
    .gen   if index < 1 then return source
    generated = '  call view.add_label("' || control_id || '", source.node_text(index), "' || relation || '", "' || anchor || '")'
    if kind = 'scene' then generated = '  call view.add_scene("' || control_id || '", source.node_value(index), "' || relation || '", "' || anchor || '")'
    if kind = 'input' then generated = '  call view.add_input("' || control_id || '", source.node_value(index), "' || relation || '", "' || anchor || '")'
    if kind = 'checkbox' then generated = '  call view.add_checkbox("' || control_id || '", source.node_text(index), source.node_value(index), "' || relation || '", "' || anchor || '")'
    if kind = 'progress' then generated = '  call view.add_progress("' || control_id || '", source.node_value(index), "' || relation || '", "' || anchor || '")'
    if kind = 'button' then generated = '  call view.add_button("' || control_id || '", source.node_text(index), "' || action || '", "' || shortcut || '", "' || relation || '", "' || anchor || '")'
    if kind = 'line' then generated = '  call view.add_line("' || control_id || '", "' || relation || '", "' || anchor || '")'
    if kind = 'statusbar' then generated = '  call view.add_statusbar("' || control_id || '", source.node_text(index), "' || relation || '", "' || anchor || '")'
    .gen &generated
  end
  .gen   return view
  .gen controller_component: class implements .uicomponent
  .gen   _delegate = .uicomponent
  .gen   *: factory
  .gen     arg delegate = .uicomponent
  .gen     _delegate = delegate
  .gen     return
  .gen   update: method = .uieffects
  .gen     arg event = .uimessage
  .gen     return _delegate.update(event)
  .gen   view: method = .uiview
  .gen     return render(_delegate.view())
  .gen make_controller: procedure = .uicomponent
  .gen   arg delegate = .uicomponent
  .gen   return .controller_component(delegate)
  .gen control_metadata: procedure = .string[]
  .gen   result = .string[]
  do i = 1 to control_count
    metadata = control_id_value.i || '|' || control_kind.i || '|' || control_source.i || '|' || control_action.i || '|' || control_event.i
    .gen   result[&i] = "&metadata"
  end
  .gen   return result
  .gen event_metadata: procedure = .string[]
  .gen   result = .string[]
  do i = 1 to event_count
    metadata = event_id.i || '|' || event_kind.i
    .gen   result[&i] = "&metadata"
  end
  .gen   return result
  .gen register_gui: procedure = .int
  .gen   arg session = .uisession
  .gen   rc = 0
  do i = 1 to command_count
    action = command_action.i
    event = command_event.i
    shortcut = command_shortcut.i
    if left(event, 3) \= 'ui.' then do
      generated = '  rc = session.register_event("' || event || '")'
      .gen &generated
      .gen   if rc < 0 then return rc
    end
    generated = '  rc = session.register_command(.uicommand("' || action || '", "' || action || '", "root", "' || event || '", "' || shortcut || '"))'
    .gen &generated
    .gen   if rc < 0 then return rc
  end
  .gen   return rc
##MEND
