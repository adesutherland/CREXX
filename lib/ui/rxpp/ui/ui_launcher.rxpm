##MACRO UI_LAUNCHER driver_namespace,driver_class,app_namespace,session_factory
  driver_namespace = unquote(driver_namespace)
  driver_class = unquote(driver_class)
  app_namespace = unquote(app_namespace)
  session_factory = unquote(session_factory)
  .gen import &driver_namespace
  .gen import &app_namespace
  .gen session = &app_namespace..&session_factory("app-local", &driver_namespace..capabilities())
  .gen driver = .&driver_namespace..&driver_class()
  .gen exit driver.run(session)
##MEND
