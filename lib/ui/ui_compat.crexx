/* Temporary adapter for the existing scalar GTK and line-TUI tracer drivers.
 * New drivers should implement the ui_contract session/executor boundary.
 * This adapter is deliberately synchronous and supports one root component.
 */
options levelg
namespace ui_compat expose uibridge
import ui
import ui_contract

/** Keep legacy driver details outside the application feature. */
uibridge: class implements .uiapp
  _session = .uisession
  _pending = .uimessage
  _resource = .uiresource
  _path = .string
  _resource_number = .int
  _error = .string

  /** @param component backend-independent feature owned by this session */
  *: factory
    arg component = .uicomponent
    _session = .uisession("tracer-local", .uicapabilities("tracer.compat"))
    rc = _session.add_component("root", component)
    _pending = .uimessage("", .uipayload())
    _resource = .uiresource("unselected", "local", "")
    _path = ""
    _resource_number = 0
    _error = ""
    return

  /** @param name application event @param fields typed field specification */
  register_event: method = .int
    arg name = .string, fields = "{}"
    return _session.register_event(name, fields)
  /** @param command shared action declaration */
  register_command: method = .int
    arg command = .uicommand
    return _session.register_command(command)

  /** Translate scalar legacy input into validated v0 traffic.
   * @param event legacy driver event @return legacy driver work request
   */
  update: method = .uieffect
    arg event = .uievent
    name = event.name()
    body = .uipayload
    rc = -1
    if name = "app.ready" then rc = _session.post(.uimessage("ui.ready", .uipayload()))
    else if name = "app.quit.requested" then rc = _session.post(.uimessage("ui.close.requested", .uipayload()))
    else if name = "file.selection.cancelled" & _pending.name() = "ui.resource.choose" then
      rc = finish("ui.effect.cancelled", .uipayload('{"reason":"chooser_cancelled"}'))
    else if name = "file.selected" & _pending.name() = "ui.resource.choose" then do
      /* The path stays here. The application receives only an opaque token and
       * display text, the same shape that a browser file grant could provide. */
      _resource_number = _resource_number + 1
      _path = event.payload()
      _resource = .uiresource("resource-" || _resource_number, "local", _path)
      body = .uipayload()
      call body.put_resource("resource", _resource)
      rc = finish("ui.resource.selected", body)
    end
    else if name = "file.loaded" & _pending.name() = "io.text.read" then do
      body = .uipayload()
      records = .string[]
      if event.item_count() <= 4096 then do
        do index = 1 to event.item_count()
          records[index] = event.item(index)
        end
      end
      call body.put_resource("resource", _resource)
      call body.put_texts("records", records)
      registry = .uiregistry()
      candidate = .uimessage("io.text.read.completed", body)
      if event.item_count() > 4096 | registry.validate(candidate) \= "" then
        rc = finish("ui.effect.failed", .uipayload('{"code":"resource_too_large","message":"File exceeds the tracer message limits"}'))
      else rc = finish("io.text.read.completed", body)
    end
    else if name = "file.load.failed" & _pending.name() = "io.text.read" then do
      body = .uipayload()
      call body.put_text("code", "read_failed")
      call body.put_text("message", "Could not read " || _resource.display_name())
      rc = finish("ui.effect.failed", body)
    end
    else rc = _session.invoke(name)
    if rc < 0 then return fail("rejected legacy input: " || name)
    return next_work()

  /** @return current root feature view */
  view: method = .uiview
    return _session.view()
  /** @return adapter diagnostic; empty on success */
  error: method = .string
    return _error

  finish: method = .int
    arg name = .string, body = .uipayload
    outcome = .uimessage(name, body, _pending.target(), "event", _pending.request_id(), _pending.session_id())
    rc = _session.complete(outcome)
    if rc = 0 then _pending = .uimessage("", .uipayload())
    return rc

  next_work: method = .uieffect
    /* Finite budget guards accidental immediate-effect loops in a feature. */
    do step = 1 to 64
      if _session.pump() < 0 then return fail(_session.fault())
      if _pending.name() \= "" | _session.pending() = 0 then return .uieffect_impl("none", "")
      _pending = _session.take_effect()
      if _pending.name() = "ui.resource.choose" then return .uieffect_impl("choose_file", "")
      if _pending.name() = "io.text.read" then do
        body = _pending.body()
        resource = body.resource("resource")
        if resource.id() = _resource.id() & resource.scope() = "local" & _path \= "" then
          return .uieffect_impl("read_text", _path)
        rc = finish("ui.effect.failed", .uipayload('{"code":"invalid_resource","message":"Resource grant is no longer available"}'))
        if rc < 0 then return fail("cannot report invalid resource")
        iterate
      end
      if _pending.name() = "ui.close" then do
        /* Legacy drivers have no post-destruction callback. Do not fabricate
         * ui.closed before the window has closed: abandon on owner teardown.
         * The existing driver releases its native resources after this return. */
        call _session.close()
        _path = ""
        return .uieffect_impl("quit", "")
      end
      return fail("unexpected adapter effect: " || _pending.name())
    end
    return fail("adapter work budget exceeded")

  fail: method = .uieffect
    arg message = .string
    _error = message
    say "UI contract error:" message
    call _session.close()
    _path = ""
    return .uieffect_impl("quit", "")
