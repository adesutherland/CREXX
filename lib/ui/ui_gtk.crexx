/* GTK owns the native loop. Its idle mailbox enters the same Level G session
 * contract as the terminal hosts; native signals never call a feature directly.
 */
options levelg
namespace ui_gtk expose gtkdriver capabilities
import ui
import ui_contract
import ui_local_resources
import ui_gtk_native

/** @return services actually implemented by this GTK host */
capabilities: procedure = .uicapabilities
  caps = .uicapabilities()
  call caps.enable("ui.resource.choose")
  call caps.enable("io.text.read")
  call caps.enable("io.text.write")
  call caps.enable("ui.dialog")
  call caps.enable("ui.widgets")
  call caps.enable("ui.collections")
  return caps

/** GTK 3 host. Application policy lives exclusively in session components. */
gtkdriver: class implements .uidriver
  _session = .uisession
  _resources = .uilocal_resources
  _request = .uimessage
  _close_request = .uimessage
  _modal = .int
  _closing = .int
  _closed = .int
  _error = .string

  /** Construct an idle host; run owns all native resources. */
  *: factory
    _modal = 0
    _closing = 0
    _closed = 0
    _error = ""
    return

  /** Build the initial GTK tree and enter the native event loop.
   * @param session configured application session owned for this run
   * @return zero after native destruction and ui.closed; nonzero on failure
   */
  run: method = .int
    arg session = .uisession
    _session = session
    _resources = .uilocal_resources(session.id())
    _modal = 0
    _closing = 0
    _closed = 0
    _error = ""
    view = _session.view()
    if ui_gtk_native..create(view.title(), 520, 360) \= 1 then do
      _error = "Cannot create GTK surface"
      call _session.close()
      return -1
    end
    do index = 1 to view.count()
      kind = view.node_kind(index)
      rc = 0
      if kind = "label" then rc = add_label(view.node_id(index), view.node_text(index), view.node_column(index), view.node_row(index))
      else if kind = "line" then rc = add_line(view.node_id(index), view.node_column(index), view.node_row(index))
      else if kind = "button" then rc = add_button(view.node_id(index), view.node_text(index), view.node_action(index), view.node_column(index), view.node_row(index))
      else if kind = "choice" then do
        option_ids = .string[]
        option_texts = .string[]
        call arraydrop option_ids
        call arraydrop option_texts
        do option = 1 to view.node_option_count(index)
          option_ids[option] = view.node_option_id(index, option)
          option_texts[option] = view.node_option_text(index, option)
        end
        rc = ui_gtk_native..add_choice(view.node_id(index), option_ids, option_texts, view.node_value(index), view.node_column(index), view.node_row(index))
      end
      else if kind = "integer" then rc = ui_gtk_native..add_integer(view.node_id(index), view.node_value(index), view.node_minimum(index), view.node_maximum(index), view.node_step(index), view.node_column(index), view.node_row(index))
      if rc \= 1 then _error = "Unsupported or invalid GTK view node: " || kind
    end
    native_rc = -1
    if _error = "" then do
      if show() \= 1 then _error = "Cannot show GTK surface"
      else do
        /* The callback holds a weak reference to this live receiver. Native run
         * is synchronous; neither this reference nor borrowed RXPA arguments
         * escape it. Copies of the callback therefore share host state. */
        callback = .gtkcallback(reference self)
        do
          native_rc = ui_gtk_native..run(callback)
        on signal
          _error = "GTK callback failed"
        end
      end
    end
    call cleanup()
    call _session.close()
    if _error \= "" | native_rc < 0 | \_closed then return -2
    return 0

  /** @return diagnostic retained after deterministic native teardown */
  error: method = .string
    return _error

  /** Owner-turn entry, called only by the native idle mailbox.
   * @param action native fact, not application policy
   * @param payload owned text captured when the native signal occurred
   * @return 0 stop, 1 wait for native input, 2 schedule more queued work
   */
  on_native_event: method = .int
    arg action = .string, payload = .string
    rc = 0
    if action = "ready" then rc = _session.post(.uimessage("ui.ready", .uipayload()))
    else if action = "command" & \_modal & \_closing then do
      /* Disabled/unregistered commands are rejected without killing the host. */
      rc = _session.invoke(payload)
      rc = 0
    end
    else if (action = "selection.changed" | action = "value.changed" | action = "value.committed") & \_modal & \_closing then
      rc = _session.post(.uimessage("widget." || action, .uipayload(payload)))
    else if action = "close.requested" & \_closing then rc = _session.post(.uimessage("ui.close.requested", .uipayload()))
    else if action = "dialog.accepted" | action = "dialog.cancelled" then do
      if _modal then do
        body = .uipayload()
        if action = "dialog.cancelled" then do
          call body.put_text("reason", "dialog_cancelled")
          call finish(_request, "ui.effect.cancelled", body)
        end
        else if _request.name() = "ui.dialog.confirm" then do
          call body.put_text("response", "ok")
          call finish(_request, "ui.dialog.accepted", body)
        end
        else do
          request_body = _request.body()
          grant = _resources.grant(payload, request_body.text("purpose"))
          if grant.id() = "" then call fail_effect(_request, "resource_limit", "Local resource grant limit reached")
          else do
            call body.put_resource("resource", grant)
            call finish(_request, "ui.resource.selected", body)
          end
        end
        _modal = 0
      end
    end
    else if action = "closed" then do
      if \_closing then _error = "GTK surface destroyed without a close effect"
      else call finish(_close_request, "ui.closed", .uipayload())
      _closed = 1
    end
    if rc < 0 then _error = "Native input admission failed"
    if _error = "" then call service()
    if _error \= "" | _closed then return 0
    call render()
    if _error \= "" then return 0
    if _session.queued() > 0 | _session.pending() > 0 then return 2
    return 1

  /** Bounded owner work; showing a dialog returns immediately to GTK. */
  service: method = .void
    do budget = 1 to 64
      rc = _session.pump()
      if rc < 0 then do
        _error = _session.fault()
        return
      end
      if _closed | _session.pending() = 0 then return
      effect = _session.take_effect()
      name = effect.name()
      body = effect.body()
      if name = "ui.resource.choose" | name = "ui.dialog.confirm" then do
        if _modal | _closing then call fail_effect(effect, "dialog_busy", "Another dialog or close is active")
        else if name = "ui.resource.choose" & body.text("purpose") \= "open" & body.text("purpose") \= "save" then
          call fail_effect(effect, "unsupported_purpose", "Unsupported file chooser purpose")
        else do
          _request = effect
          _modal = 1
          kind = "confirm"
          if name = "ui.resource.choose" then kind = "file"
          if name = "ui.resource.choose" & body.text("purpose") = "save" then kind = "save"
          if begin_dialog(kind, body.text("title"), body.text("message")) \= 1 then do
            _modal = 0
            call fail_effect(effect, "dialog_failed", "Cannot create GTK dialog")
          end
        end
      end
      else if name = "io.text.read" then do
        rc = _session.complete(_resources.read(effect))
        if rc < 0 then _error = "Read completion rejected"
      end
      else if name = "io.text.write" then do
        response = _resources.write(effect)
        rc = _session.complete(response)
        if rc < 0 then _error = "Write completion rejected"
      end
      else if name = "ui.close" then do
        if _closing then call fail_effect(effect, "close_busy", "Close already in progress")
        else do
          _close_request = effect
          _closing = 1
          /* Native response/destroy signals enqueue their facts. ui.closed is
           * admitted only when the destruction fact returns through the mailbox. */
          call close_surface()
        end
      end
      else call fail_effect(effect, "unsupported_effect", "No GTK executor for " || name)
      if _error \= "" then return
    end
    return

  finish: method = .void
    arg request = .uimessage, name = .string, body = .uipayload
    rc = _session.complete(.uimessage(name, body, request.target(), "event", request.request_id(), request.session_id()))
    if rc < 0 then _error = "Effect completion rejected: " || name
    return

  fail_effect: method = .void
    arg request = .uimessage, code = .string, message = .string
    body = .uipayload()
    call body.put_text("code", code)
    call body.put_text("message", message)
    call finish(request, "ui.effect.failed", body)
    return

  /** Reproject feature text; this tracer has a fixed node topology. */
  render: method = .void
    if _closing | _closed then return
    view = _session.view()
    option = .int
    do index = 1 to view.count()
      kind = view.node_kind(index)
      if kind = "choice" then do
        option_ids = .string[]
        option_texts = .string[]
        call arraydrop option_ids
        call arraydrop option_texts
        do option = 1 to view.node_option_count(index)
          option_ids[option] = view.node_option_id(index, option)
          option_texts[option] = view.node_option_text(index, option)
        end
        if ui_gtk_native..set_choice(view.node_id(index), option_ids, option_texts, view.node_value(index)) \= 1 then _error = "GTK choice projection failed"
      end
      else if kind = "integer" then do
        if ui_gtk_native..set_integer(view.node_id(index), view.node_value(index)) \= 1 then _error = "GTK integer projection failed"
      end
      else if kind \= "line" then do
        if set_text(view.node_id(index), view.node_text(index)) \= 1 then _error = "GTK view projection failed"
      end
    end
    return

/* Implementation detail: one identity-preserving RXPA callback, not another
 * application shell. The receiver is valid only during gtkdriver.run(). */
gtkcallback: class implements .eventhandler
  _host = reference .gtkdriver
  *: factory
    arg host = reference .gtkdriver
    _host = host
    return
  on_native_event: method = .int
    arg action = .string, payload = .string
    host = dereference _host
    return host.on_native_event(action, payload)
