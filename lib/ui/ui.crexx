/*
 * cREXX experimental Level G backend-neutral UI contracts and runtime.
 *
 * The library deliberately exposes semantic events and effects rather than
 * native widget handles. Drivers own their event loops and rendering details;
 * application classes own feature state, update logic and logical views.
 */
options levelg
namespace ui expose uievent uieffect uiview uiapp uidriver uievent_impl uieffect_impl uiview_impl uiruntime
import rxfnsb

/** One semantic fact delivered to an application. */
uievent: interface
  /** @return stable semantic event name */
  name: method = .string
  /** @return scalar event payload, or an empty string */
  payload: method = .string
  /** @return number of structured text items carried by the event */
  item_count: method = .int
  /** @param index one-based item index
   * @return event item, or an empty string when the index is invalid
   */
  item: method = .string
    arg index = .int

/** A request for impure work outside an application's update method. */
uieffect: interface
  /** @return stable effect kind; `none` means no work */
  kind: method = .string
  /** @return scalar effect payload */
  payload: method = .string

/** A flat logical view rendered by the tracer drivers. */
uiview: interface
  /** @return application window or screen title */
  title: method = .string
  /** @return number of logical nodes */
  count: method = .int
  /** @param index one-based node index
   * @return `label`, `line`, or `button`
   */
  node_kind: method = .string
    arg index = .int
  /** @param index one-based node index
   * @return stable logical node identity
   */
  node_id: method = .string
    arg index = .int
  /** @param index one-based node index
   * @return text currently displayed by the node
   */
  node_text: method = .string
    arg index = .int
  /** @param index one-based node index
   * @return semantic event emitted by a button
   */
  node_action: method = .string
    arg index = .int
  /** @param index one-based node index
   * @return TUI shortcut, or an empty string
   */
  node_shortcut: method = .string
    arg index = .int
  /** @param index one-based node index
   * @return authored placement relation (`root`, `below`, or `right`)
   */
  node_relation: method = .string
    arg index = .int
  /** @param index one-based node index
   * @return stable node ID used as the placement anchor, or an empty string
   */
  node_anchor: method = .string
    arg index = .int
  /** @param index one-based node index
   * @return resolved zero-based logical grid row
   */
  node_row: method = .int
    arg index = .int
  /** @param index one-based node index
   * @return resolved zero-based logical grid column
   */
  node_column: method = .int
    arg index = .int

/** Feature-owned model/update/view contract. */
uiapp: interface
  /** Apply one semantic event and return the next requested effect.
   * @param event event to reduce into application state
   * @return requested effect, or `none`
   */
  update: method = .uieffect
    arg event = .uievent
  /** @return backend-neutral view of current application state */
  view: method = .uiview

/** Backend event-loop contract. */
uidriver: interface
  /** Run until the application requests the `quit` effect.
   * @param runtime application runtime to drive
   * @return zero on normal termination
   */
  run: method = .int
    arg runtime = .uiruntime

/** Concrete semantic event value. */
uievent_impl: class implements .uievent
  _name = .string
  _payload = .string
  _items = .string[]
  _item_count = .int

  /** Construct an event with a scalar payload.
   * @param name semantic event name
   * @param payload scalar payload
   */
  *: factory
    arg name = .string, payload = ""
    _name = name
    _payload = payload
    _item_count = 0
    return

  /** Construct an event carrying text records.
   * @param name semantic event name
   * @param payload scalar payload, normally a path
   * @param items text records
   */
  with_items: factory
    arg name = .string, payload = .string, items = .string[]
    _name = name
    _payload = payload
    _item_count = items[0]
    do index = 1 to _item_count
      _items[index] = items[index]
    end
    return

  name: method = .string
    return _name

  payload: method = .string
    return _payload

  item_count: method = .int
    return _item_count

  item: method = .string
    arg index = .int
    if index < 1 | index > _item_count then return ""
    return _items[index]

/** Concrete effect value. */
uieffect_impl: class implements .uieffect
  _kind = .string
  _payload = .string

  /** @param kind stable effect kind
   * @param payload scalar effect payload
   */
  *: factory
    arg kind = .string, payload = ""
    _kind = kind
    _payload = payload
    return

  kind: method = .string
    return _kind

  payload: method = .string
    return _payload

/** Mutable logical-view builder returned through the read-only uiview contract. */
uiview_impl: class implements .uiview
  _title = .string
  _count = .int
  _kinds = .string[]
  _ids = .string[]
  _texts = .string[]
  _actions = .string[]
  _shortcuts = .string[]
  _relations = .string[]
  _anchors = .string[]
  _rows = .int[]
  _columns = .int[]

  /** @param title application window or screen title */
  *: factory
    arg title = .string
    _title = title
    _count = 0
    return

  /** Append a text label.
   * @param id stable node identity
   * @param text displayed text
   * @param relation placement relative to the anchor
   * @param anchor stable node ID, or empty to use the preceding node
   */
  add_label: method = .void
    arg id = .string, text = .string, relation = "below", anchor = ""
    _count = _count + 1
    _kinds[_count] = "label"
    _ids[_count] = id
    _texts[_count] = text
    _actions[_count] = ""
    _shortcuts[_count] = ""
    call place_current relation, anchor
    return

  /** Append a horizontal visual separator.
   * @param id stable node identity
   * @param relation placement relative to the anchor
   * @param anchor stable node ID, or empty to use the preceding node
   */
  add_line: method = .void
    arg id = .string, relation = "below", anchor = ""
    _count = _count + 1
    _kinds[_count] = "line"
    _ids[_count] = id
    _texts[_count] = ""
    _actions[_count] = ""
    _shortcuts[_count] = ""
    call place_current relation, anchor
    return

  /** Append a button.
   * @param id stable node identity
   * @param text displayed text
   * @param action semantic event name
   * @param shortcut TUI shortcut
   * @param relation placement relative to the anchor
   * @param anchor stable node ID, or empty to use the preceding node
   */
  add_button: method = .void
    arg id = .string, text = .string, action = .string, shortcut = .string, relation = "below", anchor = ""
    _count = _count + 1
    _kinds[_count] = "button"
    _ids[_count] = id
    _texts[_count] = text
    _actions[_count] = action
    _shortcuts[_count] = shortcut
    call place_current relation, anchor
    return

  /** Append a node from RXPP's compact builder specification.
   *
   * The form is `kind|id|action|shortcut|relation|anchor`. Labels and lines
   * use `none` for fields that do not apply. `root` starts a layout, while
   * `below` and `right` place a node relative to a stable prior node ID.
   * RXPP emits this one uniform operation so a future GUI builder need not
   * generate backend-specific procedure calls.
   *
   * @param spec logical node specification
   * @param text displayed text expression
   */
  add_spec: method = .void
    arg spec = .string, text = .string
    fields = translate(spec, "   ", "|")
    kind = word(fields, 1)
    id = word(fields, 2)
    action = word(fields, 3)
    shortcut = word(fields, 4)
    relation = word(fields, 5)
    anchor = word(fields, 6)
    if action = "none" then action = ""
    if shortcut = "none" then shortcut = ""
    if anchor = "none" then anchor = ""
    if kind = "label" then call add_label(id, text, relation, anchor)
    else if kind = "line" then call add_line(id, relation, anchor)
    else if kind = "button" then call add_button(id, text, action, shortcut, relation, anchor)
    return

  /** Resolve the current node's relative placement into a small logical grid.
   *
   * This is deliberately view logic rather than GTK/TUI policy. Drivers see
   * the same coordinates, while the application keeps readable relationships
   * between stable node IDs. Missing/unknown placement currently falls back
   * to `below` the preceding node; a production contract should report a
   * validation diagnostic instead.
   *
   * @param relation `root`, `below`, or `right`
   * @param anchor stable ID of an earlier node
   */
  place_current: method = .void
    arg relation = .string, anchor = .string
    row = 0
    column = 0
    resolved_relation = lower(strip(relation))
    resolved_anchor = strip(anchor)

    if _count = 1 | resolved_relation = "root" then do
      resolved_relation = "root"
      resolved_anchor = ""
    end
    else do
      anchor_index = _count - 1
      if resolved_anchor \= "" then do
        anchor_found = 0
        do candidate = 1 to _count - 1
          if _ids[candidate] = resolved_anchor then do
            anchor_index = candidate
            anchor_found = 1
            leave
          end
        end
        if \anchor_found then resolved_anchor = _ids[anchor_index]
      end
      else resolved_anchor = _ids[anchor_index]

      row = _rows[anchor_index]
      column = _columns[anchor_index]
      if resolved_relation = "right" then column = column + 1
      else do
        resolved_relation = "below"
        row = row + 1
      end
    end

    _relations[_count] = resolved_relation
    _anchors[_count] = resolved_anchor
    _rows[_count] = row
    _columns[_count] = column
    return

  title: method = .string
    return _title

  count: method = .int
    return _count

  node_kind: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _kinds[index]

  node_id: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _ids[index]

  node_text: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _texts[index]

  node_action: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _actions[index]

  node_shortcut: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _shortcuts[index]

  node_relation: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _relations[index]

  node_anchor: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _anchors[index]

  node_row: method = .int
    arg index = .int
    if index < 1 | index > _count then return -1
    return _rows[index]

  node_column: method = .int
    arg index = .int
    if index < 1 | index > _count then return -1
    return _columns[index]

/** Event dispatcher and backend-neutral effect executor. */
uiruntime: class
  _app = .uiapp
  _event_count = .int

  /** @param app feature application to run */
  *: factory
    arg app = .uiapp
    _app = app
    _event_count = 0
    return

  /** Dispatch a named scalar event.
   * @param name semantic event name
   * @param payload scalar payload
   * @return first driver-owned effect after backend-neutral effects complete
   */
  dispatch: method = .uieffect
    arg name = .string, payload = ""
    return dispatch_event(.uievent_impl(name, payload))

  /** Dispatch a structured event.
   *
   * `read_text` is deliberately resolved here rather than in either driver.
   * Its completion is delivered as `file.loaded` or `file.load.failed`, so a
   * future asynchronous executor can preserve the application contract.
   *
   * @param event semantic event
   * @return first effect requiring a driver, or `none`
   */
  dispatch_event: method = .uieffect
    arg event = .uievent
    _event_count = _event_count + 1
    effect = _app.update(event)

    do while effect.kind() = "read_text"
      path = effect.payload()
      records = readlines(path, 1, 0, "return")
      failed = 0
      if records[0] = 1 then do
        if records[1] = "-8 OPEN ERROR" then failed = 1
      end

      if failed then event = .uievent_impl("file.load.failed", path)
      else event = .uievent_impl.with_items("file.loaded", path, records)

      _event_count = _event_count + 1
      effect = _app.update(event)
    end
    return effect

  /** @return current logical view */
  view: method = .uiview
    return _app.view()

  /** @return number of semantic events delivered to the application */
  event_count: method = .int
    return _event_count
