/*
 * cREXX experimental Level G backend-neutral UI logical views.
 *
 * The library deliberately exposes semantic events and effects rather than
 * native widget handles. Drivers own their event loops and rendering details;
 * application classes own feature state, update logic and logical views.
 */
options levelg
namespace ui expose uiview uiview_impl
import rxfnsb

/** A flat logical view rendered by the tracer drivers. */
uiview: interface
  /** @return application window or screen title */
  title: method = .string
  /** @return number of logical nodes */
  count: method = .int
  /** @param index one-based node index
   * @return `label`, `line`, `input`, `button`, `choice`, or `integer`
   */
  node_kind: method = .string
    arg index = .int
  /** @param index one-based node index
   * @return stable logical node identity
   */
  node_id: method = .string
    arg index = .int
  /** @param index one-based node index
   * @return text currently displayed by the node
   */
  node_text: method = .string
    arg index = .int
  /** @param index one-based node index
   * @return registered command ID invoked by a button
   */
  node_action: method = .string
    arg index = .int
  /** @param index one-based node index
   * @return TUI shortcut, or an empty string
   */
  node_shortcut: method = .string
    arg index = .int
  /** @param index one-based node index
   * @return authored placement relation (`root`, `below`, or `right`)
   */
  node_relation: method = .string
    arg index = .int
  /** @param index one-based node index
   * @return stable node ID used as the placement anchor, or an empty string
   */
  node_anchor: method = .string
    arg index = .int
  /** @param index one-based node index
   * @return resolved zero-based logical grid row
   */
  node_row: method = .int
    arg index = .int
  /** @param index one-based node index
   * @return resolved zero-based logical grid column
   */
  node_column: method = .int
    arg index = .int
  /** @param index one-based node index @return current editable/selected value */
  node_value: method = .string
    arg index = .int
  /** @param index one-based node index @return single-choice option count */
  node_option_count: method = .int
    arg index = .int
  /** @param index node index @param option one-based option index
   * @return stable choice item identity, or empty for an invalid index */
  node_option_id: method = .string
    arg index = .int, option = .int
  /** @param index node index @param option one-based option index
   * @return displayed choice label, or empty for an invalid index */
  node_option_text: method = .string
    arg index = .int, option = .int
  /** @param index node index @return inclusive integer lower bound */
  node_minimum: method = .int
    arg index = .int
  /** @param index node index @return inclusive integer upper bound */
  node_maximum: method = .int
    arg index = .int
  /** @param index node index @return positive integer increment */
  node_step: method = .int
    arg index = .int

/** Mutable logical-view builder returned through the read-only uiview contract. */
uiview_impl: class implements .uiview
  _title = .string
  _count = .int
  _kinds = .string[]
  _ids = .string[]
  _texts = .string[]
  _actions = .string[]
  _shortcuts = .string[]
  _relations = .string[]
  _anchors = .string[]
  _rows = .int[]
  _columns = .int[]
  _values = .string[]
  _option_counts = .int[]
  _option_offsets = .int[]
  _option_ids = .string[]
  _option_texts = .string[]
  _option_total = .int
  _minimums = .int[]
  _maximums = .int[]
  _steps = .int[]

  /** @param title application window or screen title */
  *: factory
    arg title = .string
    _title = title
    _count = 0
    _option_total = 0
    return

  /** Append a text label.
   * @param id stable node identity
   * @param text displayed text
   * @param relation placement relative to the anchor
   * @param anchor stable node ID, or empty to use the preceding node
   */
  add_label: method = .void
    arg id = .string, text = .string, relation = "below", anchor = ""
    _count = _count + 1
    _kinds[_count] = "label"
    _ids[_count] = id
    _texts[_count] = text
    _actions[_count] = ""
    _shortcuts[_count] = ""
    call initialise_control()
    call place_current relation, anchor
    return

  /** Append a horizontal visual separator.
   * @param id stable node identity
   * @param relation placement relative to the anchor
   * @param anchor stable node ID, or empty to use the preceding node
   */
  add_line: method = .void
    arg id = .string, relation = "below", anchor = ""
    _count = _count + 1
    _kinds[_count] = "line"
    _ids[_count] = id
    _texts[_count] = ""
    _actions[_count] = ""
    _shortcuts[_count] = ""
    call initialise_control()
    call place_current relation, anchor
    return

  /** Append a button.
   * @param id stable node identity
   * @param text displayed text
   * @param action registered command ID
   * @param shortcut TUI shortcut
   * @param relation placement relative to the anchor
   * @param anchor stable node ID, or empty to use the preceding node
   */
  add_button: method = .void
    arg id = .string, text = .string, action = .string, shortcut = .string, relation = "below", anchor = ""
    _count = _count + 1
    _kinds[_count] = "button"
    _ids[_count] = id
    _texts[_count] = text
    _actions[_count] = action
    _shortcuts[_count] = shortcut
    call initialise_control()
    call place_current relation, anchor
    return

  /** Append an editable text field. Drivers advertise support explicitly.
   * @param id stable field identity @param text current display value
   * @param relation placement @param anchor stable preceding node
   */
  add_input: method = .void
    arg id = .string, text = .string, relation = "below", anchor = ""
    call add_label(id, text, relation, anchor)
    _kinds[_count] = "input"
    _values[_count] = text
    return

  /** Append one exclusive choice using stable item IDs.
   * @param id stable control identity
   * @param option_ids distinct nonempty item IDs (maximum 64)
   * @param option_texts corresponding display labels
   * @param selected current item ID, which must belong to the options
   * @param relation placement relative to the anchor
   * @param anchor stable earlier node identity
   * @return 1 when added; 0 for invalid input, with the view unchanged
   */
  add_choice: method = .int
    arg id = .string, option_ids = .string[], option_texts = .string[], selected = .string, relation = "below", anchor = ""
    i = .int
    previous = .int
    if id = "" | length(id) > 128 | option_ids[0] < 1 | option_ids[0] > 64 then return 0
    if option_ids[0] \= option_texts[0] then return 0
    found = 0
    do i = 1 to option_ids[0]
      if option_ids[i] = "" | length(option_ids[i]) > 128 | length(option_texts[i]) > 16384 then return 0
      if option_ids[i] = selected then found = 1
      do previous = 1 to i - 1
        if option_ids[previous] = option_ids[i] then return 0
      end
    end
    if \found then return 0
    do i = 1 to _count
      if _ids[i] = id then return 0
    end
    call add_label(id, "", relation, anchor)
    _kinds[_count] = "choice"
    _values[_count] = selected
    _option_counts[_count] = option_ids[0]
    _option_offsets[_count] = _option_total
    do i = 1 to option_ids[0]
      _option_total = _option_total + 1
      _option_ids[_option_total] = option_ids[i]
      _option_texts[_option_total] = option_texts[i]
    end
    return 1

  /** Append a bounded integer editor, preserving text during editing.
   * @param id stable control identity
   * @param value current text, including transient invalid/empty editing state
   * @param minimum inclusive lower bound
   * @param maximum inclusive upper bound
   * @param step positive increment
   * @param relation placement relative to the anchor
   * @param anchor stable earlier node identity
   * @return 1 when added; 0 for invalid configuration, with the view unchanged
   * Drivers reject bounds they cannot represent; features validate committed
   * text before conversion. Rendering a value never represents user input.
   */
  add_integer: method = .int
    arg id = .string, value = .string, minimum = .int, maximum = .int, step = 1, relation = "below", anchor = ""
    if id = "" | length(id) > 128 | length(value) > 16384 | minimum > maximum | step < 1 then return 0
    do i = 1 to _count
      if _ids[i] = id then return 0
    end
    call add_label(id, value, relation, anchor)
    _kinds[_count] = "integer"
    _values[_count] = value
    _minimums[_count] = minimum
    _maximums[_count] = maximum
    _steps[_count] = step
    return 1

  /** Initialise optional fields for the just-added logical node. */
  initialise_control: method = .void
    _values[_count] = ""
    _option_counts[_count] = 0
    _option_offsets[_count] = 0
    _minimums[_count] = 0
    _maximums[_count] = 0
    _steps[_count] = 0
    return

  /** Append a node from RXPP's compact builder specification.
   *
   * The form is `kind|id|action|shortcut|relation|anchor`. Labels and lines
   * use `none` for fields that do not apply. `root` starts a layout, while
   * `below` and `right` place a node relative to a stable prior node ID.
   * RXPP emits this one uniform operation so a future GUI builder need not
   * generate backend-specific procedure calls.
   *
   * @param spec logical node specification
   * @param text displayed text expression
   */
  add_spec: method = .void
    arg spec = .string, text = .string
    fields = translate(spec, "   ", "|")
    kind = word(fields, 1)
    id = word(fields, 2)
    action = word(fields, 3)
    shortcut = word(fields, 4)
    relation = word(fields, 5)
    anchor = word(fields, 6)
    if action = "none" then action = ""
    if shortcut = "none" then shortcut = ""
    if anchor = "none" then anchor = ""
    if kind = "label" then call add_label(id, text, relation, anchor)
    else if kind = "input" then call add_input(id, text, relation, anchor)
    else if kind = "line" then call add_line(id, relation, anchor)
    else if kind = "button" then call add_button(id, text, action, shortcut, relation, anchor)
    return

  /** Resolve the current node's relative placement into a small logical grid.
   *
   * This is deliberately view logic rather than GTK/TUI policy. Drivers see
   * the same coordinates, while the application keeps readable relationships
   * between stable node IDs. Missing/unknown placement currently falls back
   * to `below` the preceding node; a production contract should report a
   * validation diagnostic instead.
   *
   * @param relation `root`, `below`, or `right`
   * @param anchor stable ID of an earlier node
   */
  place_current: method = .void
    arg relation = .string, anchor = .string
    row = 0
    column = 0
    resolved_relation = lower(strip(relation))
    resolved_anchor = strip(anchor)

    if _count = 1 | resolved_relation = "root" then do
      resolved_relation = "root"
      resolved_anchor = ""
    end
    else do
      anchor_index = _count - 1
      if resolved_anchor \= "" then do
        anchor_found = 0
        do candidate = 1 to _count - 1
          if _ids[candidate] = resolved_anchor then do
            anchor_index = candidate
            anchor_found = 1
            leave
          end
        end
        if \anchor_found then resolved_anchor = _ids[anchor_index]
      end
      else resolved_anchor = _ids[anchor_index]

      row = _rows[anchor_index]
      column = _columns[anchor_index]
      if resolved_relation = "right" then column = column + 1
      else do
        resolved_relation = "below"
        row = row + 1
      end
    end

    _relations[_count] = resolved_relation
    _anchors[_count] = resolved_anchor
    _rows[_count] = row
    _columns[_count] = column
    return

  title: method = .string
    return _title

  count: method = .int
    return _count

  node_kind: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _kinds[index]

  node_id: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _ids[index]

  node_text: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _texts[index]

  node_action: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _actions[index]

  node_shortcut: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _shortcuts[index]

  node_relation: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _relations[index]

  node_anchor: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _anchors[index]

  node_row: method = .int
    arg index = .int
    if index < 1 | index > _count then return -1
    return _rows[index]

  node_column: method = .int
    arg index = .int
    if index < 1 | index > _count then return -1
    return _columns[index]

  node_value: method = .string
    arg index = .int
    if index < 1 | index > _count then return ""
    return _values[index]

  node_option_count: method = .int
    arg index = .int
    if index < 1 | index > _count then return 0
    return _option_counts[index]

  node_option_id: method = .string
    arg index = .int, option = .int
    if index < 1 | index > _count then return ""
    if option < 1 | option > _option_counts[index] then return ""
    return _option_ids[_option_offsets[index] + option]

  node_option_text: method = .string
    arg index = .int, option = .int
    if index < 1 | index > _count then return ""
    if option < 1 | option > _option_counts[index] then return ""
    return _option_texts[_option_offsets[index] + option]

  node_minimum: method = .int
    arg index = .int
    if index < 1 | index > _count then return 0
    return _minimums[index]

  node_maximum: method = .int
    arg index = .int
    if index < 1 | index > _count then return 0
    return _maximums[index]

  node_step: method = .int
    arg index = .int
    if index < 1 | index > _count then return 0
    return _steps[index]
