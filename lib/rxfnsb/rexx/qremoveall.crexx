/** Remove balanced quote-aware spans by source position. */
options levelb
namespace rxfnsb expose qremoveall

/**
 * Remove every balanced top-level pair in one positional reconstruction pass.
 *
 * @param open non-empty opening delimiter
 * @param close non-empty distinct closing delimiter
 * @param text source text
 * @param mode I or C removes complete spans; X or E removes contents only
 * @return reconstructed text
 * @signal INVALID_ARGUMENTS invalid arguments or malformed quote/pair grammar
 */
qremoveall: procedure = .string
  arg open = .string, close = .string, text = .string, mode = 'I'
  folded_mode = ''
  assembler strupper folded_mode,mode
  folded_mode = left(folded_mode,1)
  if folded_mode = 'C' then folded_mode = 'I'
  if folded_mode = 'E' then folded_mode = 'X'
  if folded_mode <> 'I' & folded_mode <> 'X' then
    assembler signal "INVALID_ARGUMENTS", "QREMOVEALL mode must be I, C, X, or E"

  spans = qscan_pair_spans(open,close,text,1)
  out = ''
  cursor = .int
  remove_start = .int
  remove_end = .int
  count = .int
  assembler idiv count,spans[0],4
  do index = 1 to count
    base = (index - 1) * 4
    if folded_mode = 'I' then do
      remove_start = spans[base + 1]
      remove_end = spans[base + 4]
    end
    else do
      remove_start = spans[base + 2]
      remove_end = spans[base + 3]
    end
    out = out || substr(text,cursor + 1,remove_start - cursor)
    cursor = remove_end
  end
  out = out || substr(text,cursor + 1)
  return out
