/**
 * Level B COMPARE implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/compare.md
 */
options levelb

namespace rxfnsb expose compare

/**
 * Return the first differing character position after virtual padding.
 *
 * @param left first string
 * @param right second string
 * @param pad exactly one codepoint used beyond the shorter string
 * @return first differing 1-based position, or zero
 */
compare: procedure = .int
  arg left = .string, right = .string, pad = " "
  left_length = .int
  right_length = .int
  common_length = .int
  pad_length = .int
  pad_character = .int
  left_character = .int
  right_character = .int
  pad_index = 0
  i = .int

  assembler strlen pad_length,pad
  if pad_length <> 1 then
    assembler signal "INVALID_ARGUMENTS","COMPARE pad must contain exactly one character"
  assembler strchar pad_character,pad,pad_index
  assembler strlen left_length,left
  assembler strlen right_length,right

  common_length = left_length
  if right_length < common_length then common_length = right_length
  do i = 0 to common_length - 1
    assembler strchar left_character,left,i
    assembler strchar right_character,right,i
    if left_character <> right_character then return i + 1
  end

  if left_length > right_length then do i = common_length to left_length - 1
    assembler strchar left_character,left,i
    if left_character <> pad_character then return i + 1
  end
  else if right_length > left_length then do i = common_length to right_length - 1
    assembler strchar right_character,right,i
    if pad_character <> right_character then return i + 1
  end
  return 0
