/**
 * Typed Level B X2B implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/x2b.md
 */
options levelb

namespace rxfnsb expose x2b

/**
 * Convert grouped hexadecimal digit text to binary digit text.
 *
 * @param hexadecimal hexadecimal digits with standard interior grouping blanks
 * @return four binary digits for every hexadecimal digit
 */
x2b: procedure = .string
  arg hexadecimal = .string
  hexadecimal_length = .int
  hexadecimal_digits = 0
  codepoint = .int
  remainder = .int
  nibble = .int
  table_offset = .int
  table_end = .int
  blank_character = 32
  bit_table = "0000000100100011010001010110011110001001101010111100110111101111"
  result = ""
  index = 0

  assembler strlen hexadecimal_length,hexadecimal
  if hexadecimal_length = 0 then return result
  assembler strchar codepoint,hexadecimal,index
  if codepoint = blank_character then
    assembler signal "INVALID_ARGUMENTS", "X2B hexadecimal text cannot start with a blank"
  index = hexadecimal_length - 1
  assembler strchar codepoint,hexadecimal,index
  if codepoint = blank_character then
    assembler signal "INVALID_ARGUMENTS", "X2B hexadecimal text cannot end with a blank"

  do index = hexadecimal_length - 1 to 0 by -1
    assembler strchar codepoint,hexadecimal,index
    if codepoint = blank_character then do
      assembler iand remainder,hexadecimal_digits,1
      if remainder <> 0 then
        assembler signal "INVALID_ARGUMENTS", "X2B blank must have an even number of hexadecimal digits to its right"
    end
    else if (codepoint >= 48 & codepoint <= 57) |,
            (codepoint >= 65 & codepoint <= 70) |,
            (codepoint >= 97 & codepoint <= 102) then
      hexadecimal_digits = hexadecimal_digits + 1
    else
      assembler signal "INVALID_ARGUMENTS", "X2B input contains a non-hexadecimal character"
  end

  do index = 0 to hexadecimal_length - 1
    assembler strchar codepoint,hexadecimal,index
    if codepoint = blank_character then iterate
    if codepoint <= 57 then nibble = codepoint - 48
    else if codepoint <= 70 then nibble = codepoint - 55
    else nibble = codepoint - 87
    table_offset = nibble * 4
    table_end = table_offset + 3
    do bit_index = table_offset to table_end
      assembler concchar result,bit_table,bit_index
    end
  end
  return result
