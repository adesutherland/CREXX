/** Level B native-integer FORMAT. @docType runtime-function @see lib/rxfnsb/rexx/intformat.md */
options levelb comments_dash numeric_classic
namespace rxfnsb expose intformat
import _rxsysb

/**
 * Format a native signed integer using Classic FORMAT controls.
 *
 * @param number native signed integer
 * @param before optional non-negative integer-part width
 * @param after optional non-negative fractional width
 * @param expp optional non-negative exponent width
 * @param expt optional non-negative exponent trigger
 * @return formatted numeric text
 * @signal CONVERSION_ERROR a supplied value cannot convert to its typed parameter
 * @signal INVALID_ARGUMENTS a control is negative or a requested field cannot fit
 */
intformat: procedure = .string
  numeric digits inherited
  numeric form inherited
  numeric case inherited
  arg number = .int, before = 0, after = 0, expp = 0, expt = 0
  before_exists = ?before
  after_exists = ?after
  expp_exists = ?expp
  expt_exists = ?expt
  number_text = number as .string
  return _typedformat(number_text,before,before_exists,after,after_exists, ,
      expp,expp_exists,expt,expt_exists)
