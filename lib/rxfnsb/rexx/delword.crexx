/**
 * Delete a word range while preserving preceding whitespace.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/delword.md
 */
options levelb

namespace rxfnsb expose delword

/**
 * Delete words beginning at a positive word number.
 *
 * @param string source text
 * @param wnum positive one-based first word number
 * @param wcount optional non-negative number of words; omitted means through end
 * @return source with the selected words and their following blanks removed
 * @signal INVALID_ARGUMENTS invalid word number or supplied count
 */
delword: procedure = .string
  arg string = .string, wnum = .int, wcount = 0
  count_supplied = ?wcount

  if wnum < 1 then
    assembler signal "INVALID_ARGUMENTS", "DELWORD start must be positive"
  if count_supplied & wcount < 0 then
    assembler signal "INVALID_ARGUMENTS", "DELWORD count must be non-negative"
  if count_supplied & wcount = 0 then return string

  string_length = .int
  assembler strlen string_length,string
  if string_length = 0 then return string

  scan = 0
  current_word = 0
  delete_start = -1
  do while scan < string_length
    assembler fndnblnk scan,string,scan
    if scan < 0 then return string
    current_word = current_word + 1
    if current_word = wnum then do
      delete_start = scan
      leave
    end
    assembler fndblnk scan,string,scan
    if scan < 0 then return string
  end

  delete_end = string_length
  if count_supplied then do
    deleted = 0
    scan = delete_start
    word_end = 0
    next_word = 0
    do while deleted < wcount
      assembler fndblnk word_end,string,scan
      deleted = deleted + 1
      if word_end < 0 then do
        delete_end = string_length
        leave
      end
      assembler fndnblnk next_word,string,word_end
      if next_word < 0 then do
        delete_end = string_length
        leave
      end
      delete_end = next_word
      if deleted = wcount then leave
      scan = next_word
    end
  end

  result = ""
  cursor = 0
  if delete_start > 0 then do
    assembler setstrpos string,cursor
    assembler substring result,string,delete_start
  end
  if delete_end < string_length then do
    tail = ""
    tail_length = string_length - delete_end
    assembler setstrpos string,delete_end
    assembler substring tail,string,tail_length
    assembler append result,tail
  end
  return result
