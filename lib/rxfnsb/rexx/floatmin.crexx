/** Level B binary64 minimum. @docType runtime-function @see lib/rxfnsb/rexx/floatmin.md */
options levelb
namespace rxfnsb expose floatmin

/**
 * Return the least of one or more binary64 values.
 *
 * @param first first binary64 value
 * @param ... additional binary64 values
 * @return first occurrence of the least value
 * @signal INVALID_ARGUMENTS any argument is NaN
 */
floatmin: procedure = .float
  arg first = .float, ... = .float
  if first <> first then assembler signal "INVALID_ARGUMENTS","FLOATMIN does not accept NaN"
  do i = 1 to arg[0]
    if arg[i] <> arg[i] then assembler signal "INVALID_ARGUMENTS","FLOATMIN does not accept NaN"
    if arg[i] < first then first = arg[i]
  end
  return first
