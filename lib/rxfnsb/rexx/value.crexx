/**
 * Level B caller-register VALUE helper.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/value.md
 */
options levelb

namespace rxfnsb expose value

/**
 * Return the value of one visible scalar or constant in the caller frame.
 *
 * This is the Level B introspection helper, not the assigning Classic VALUE
 * BIF. Lookup is limited to metadata for the immediate caller procedure.
 *
 * @param inputstring source name to inspect
 * @return caller value, the uppercased name when it is not visible, or an
 *         empty string for an empty name
 */
value: procedure = .string
  arg inputstring = .string

  input_length = .int
  assembler strlen input_length,inputstring
  if input_length = 0 then return ""

  reg = .string
  fallback = .string
  needle = .string
  symbol = .string
  type = .string
  constant_value = .string
  string_value = .string
  int_value = .int
  float_value = .float
  register_number = .int
  module = .int
  addr = .int
  stop_scan = .boolean
  address_object = 0
  meta_array = 0
  meta_entry = ""

  assembler strlower reg,inputstring
  assembler strupper fallback,inputstring
  needle = "." || reg || "@"

  assembler metaloadcalleraddr address_object
  assembler linkattr1 module,address_object,1
  assembler linkattr1 addr,address_object,2

  /* Scan only the immediate caller procedure's live metadata. */
  do a = addr to 0 by -1
    stop_scan = 0
    assembler metaloaddata meta_array,module,a
    do i = 1 to meta_array
      assembler linkattr1 meta_entry,meta_array,i

      /* Process every record at the entry address before stopping. */
      if meta_entry = ".meta_func" then do
        stop_scan = 1
        iterate
      end

      if meta_entry = ".meta_clear" then do
        assembler linkattr1 symbol,meta_entry,1
        if pos(needle, symbol || "@") > 0 then stop_scan = 1
        iterate
      end

      if meta_entry = ".meta_const" then do
        assembler linkattr1 symbol,meta_entry,1
        if pos(needle, symbol || "@") > 0 then do
          assembler linkattr1 constant_value,meta_entry,4
          return constant_value
        end
        iterate
      end

      if meta_entry = ".meta_reg" then do
        assembler linkattr1 symbol,meta_entry,1
        if pos(needle, symbol || "@") = 0 then iterate

        assembler linkattr1 type,meta_entry,3
        assembler linkattr1 register_number,meta_entry,4
        if type = ".int" then do
          assembler metalinkpreg int_value,register_number
          int_copy = int_value
          assembler unlink int_value
          return int_copy
        end
        if type = ".float" then do
          assembler metalinkpreg float_value,register_number
          float_copy = float_value
          assembler unlink float_value
          return float_copy
        end

        assembler metalinkpreg string_value,register_number
        string_copy = string_value
        assembler unlink string_value
        return string_copy
      end
    end
    if stop_scan then leave
  end

  return fallback
