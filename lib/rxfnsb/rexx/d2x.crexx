/**
 * Typed Level B D2X implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/d2x.md
 */
options levelb

namespace rxfnsb expose d2x

/**
 * Convert a native integer to uppercase hexadecimal digit text.
 *
 * @param number native signed integer
 * @param output_length optional non-negative hexadecimal width
 * @return minimal or fixed-width uppercase hexadecimal digits
 */
d2x: procedure = .string
  arg number = .int, output_length = 0
  length_supplied = ?output_length
  if length_supplied & output_length < 0 then
    assembler signal "INVALID_ARGUMENTS", "D2X output length must be non-negative"
  if \length_supplied & number < 0 then
    assembler signal "INVALID_ARGUMENTS", "D2X requires a length for negative integers"
  if length_supplied & output_length = 0 then return ""

  table = "0123456789ABCDEF"
  result = ""
  working = .int
  width = .int
  emitted_width = .int
  padding_count = .int
  bit_shift = .int
  nibble = .int
  codepoint = .int
  pad_character = 48

  if length_supplied then width = output_length
  else do
    width = 1
    working = number
    do while working > 15
      width = width + 1
      assembler ishr working,working,4
    end
  end

  if number < 0 then pad_character = 70
  emitted_width = width
  if emitted_width > 16 then do
    padding_count = emitted_width - 16
    assembler padstr result,pad_character,padding_count
    emitted_width = 16
  end

  do shift = emitted_width - 1 to 0 by -1
    bit_shift = shift * 4
    assembler ishr nibble,number,bit_shift
    assembler iand nibble,nibble,15
    assembler strchar codepoint,table,nibble
    assembler appendchar result,codepoint
  end
  return result
