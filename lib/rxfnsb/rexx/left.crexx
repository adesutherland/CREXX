/**
 * Level B LEFT implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/left.md
 */
options levelb
namespace rxfnsb expose left

/**
 * Return or pad the leftmost characters to an exact width.
 *
 * @param string source text
 * @param width non-negative result width
 * @param pad exactly one padding codepoint
 * @return leftmost text padded on the right to `width`
 */
left: procedure = .string
  arg string = .string, width = .int, pad = " "
  string_length = .int
  pad_length = .int
  padding_length = .int
  pad_character = .int
  pad_index = 0
  cursor = 0
  padding = ""
  result = ""

  if width < 0 then
    assembler signal "INVALID_ARGUMENTS","LEFT width must be non-negative"
  assembler strlen pad_length,pad
  if pad_length <> 1 then
    assembler signal "INVALID_ARGUMENTS","LEFT pad must contain exactly one character"

  if width = 0 then return result
  assembler strlen string_length,string
  if width = string_length then return string

  if width < string_length then do
    assembler substring result,string,cursor,width
    return result
  end

  padding_length = width - string_length
  assembler strchar pad_character,pad,pad_index
  assembler padstr padding,pad_character,padding_length
  assembler scopy result,string
  assembler append result,padding
  return result
