/**
 * Level B VERIFY implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/verify.md
 */
options levelb
namespace rxfnsb expose verify

/**
 * Find the first matching or non-matching reference character.
 *
 * @param string text to inspect
 * @param reference character table
 * @param option Match or Nomatch; only the first character is significant
 * @param start optional positive 1-based start position
 * @return first qualifying character position, or zero
 */
verify: procedure = .int
  arg expose string = .string, expose refchars = .string, option = "N", start = 1
  option_length = .int
  option_code = .int
  source_length = .int
  reference_length = .int
  source_code = .int
  reference_position = .int
  want_match = .boolean
  option_index = 0

  assembler strlen option_length,option
  if option_length = 0 then
    assembler signal "INVALID_ARGUMENTS","VERIFY option must start with M or N"
  assembler strchar option_code,option,option_index
  if option_code = 77 | option_code = 109 then want_match = 1
  else if option_code = 78 | option_code = 110 then want_match = 0
  else assembler signal "INVALID_ARGUMENTS","VERIFY option must start with M or N"

  if start < 1 then
    assembler signal "INVALID_ARGUMENTS","VERIFY start must be positive"

  assembler strlen source_length,string
  if source_length = 0 | start > source_length then return 0
  assembler strlen reference_length,refchars
  if reference_length = 0 then do
    if want_match then return 0
    return start
  end

  do index = start - 1 to source_length - 1
    assembler strchar source_code,string,index
    assembler poschar reference_position,refchars,source_code
    found = reference_position >= 0 & reference_position < reference_length
    if found = want_match then return index + 1
  end
  return 0
