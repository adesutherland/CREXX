/**
 * Level B INSERT implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/insert.md
 */
options levelb
namespace rxfnsb expose insert

/**
 * Insert a formatted string after a character position in a target.
 *
 * @param new_string text to insert
 * @param target source text
 * @param before optional non-negative character count before the insertion
 * @param insert_length optional non-negative formatted insertion width
 * @param pad exactly one padding codepoint
 * @return target with the formatted insertion added
 */
insert: procedure = .string
  arg new_string = .string, target = .string, before = 0, insert_length = 0, pad = " "
  length_supplied = ?insert_length
  new_length = .int
  target_length = .int
  pad_length = .int
  pad_character = .int
  pad_index = 0
  padding_needed = .int
  tail_length = .int
  cursor = 0
  padding = ""
  segment = ""
  result = ""

  if before < 0 then
    assembler signal "INVALID_ARGUMENTS","INSERT position must be non-negative"
  if length_supplied & insert_length < 0 then
    assembler signal "INVALID_ARGUMENTS","INSERT length must be non-negative"
  assembler strlen pad_length,pad
  if pad_length <> 1 then
    assembler signal "INVALID_ARGUMENTS","INSERT pad must contain exactly one character"

  assembler strlen new_length,new_string
  assembler strlen target_length,target
  if \length_supplied then insert_length = new_length
  if insert_length = 0 & before <= target_length then return target

  assembler strchar pad_character,pad,pad_index

  /* LEFT(target, before, pad), without a helper call. */
  if before > 0 then do
    if before >= target_length then do
      assembler scopy result,target
      if before > target_length then do
        padding_needed = before - target_length
        padding = ""
        assembler padstr padding,pad_character,padding_needed
        assembler append result,padding
      end
    end
    else do
      assembler setstrpos target,cursor
      assembler substring result,target,before
    end
  end

  /* LEFT(new_string, insert_length, pad), appended directly. */
  if insert_length > 0 then do
    if insert_length >= new_length then do
      if new_length > 0 then assembler append result,new_string
      if insert_length > new_length then do
        padding_needed = insert_length - new_length
        padding = ""
        assembler padstr padding,pad_character,padding_needed
        assembler append result,padding
      end
    end
    else do
      assembler setstrpos new_string,cursor
      assembler substring segment,new_string,insert_length
      assembler append result,segment
    end
  end

  /* SUBSTR(target, before + 1), when target text remains. */
  if before < target_length then do
    tail_length = target_length - before
    assembler setstrpos target,before
    assembler substring segment,target,tail_length
    assembler append result,segment
  end
  return result
