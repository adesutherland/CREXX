/* rexx */
/**
 * Return the conventional 32-bit FNV-1a hash of a text value's exact UTF-8
 * bytes.
 *
 * @param input_value text to hash
 * @return unsigned 32-bit hash as an integer in 0..4294967295
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/fnv.md
 */
options levelb numeric_classic

namespace rxfnsb expose fnv

fnv: procedure = .int
  arg input_value = .string

  bytes = input_value as .binary
  len = 0
  hashr = 0

  assembler blen len,bytes
  assembler rxhash hashr,input_value,len
  return hashr
