/**
 * Level B string stem/map and iterator classes.
 *
 * @docType runtime-class
 * @see lib/rxfnsb/rexx/stem.md
 */
options levelb comments_dash

namespace rxfnsb expose stem stemIterator

/** ------------------------------------------------------------------
 *  stem
 *
 *  A string-to-string hash map implementing classic Rexx compound
 *  variables behaviour.
 *
 * ------------------------------------------------------------------ */
stem: class
  keys = .string[]
  vals = .string[]
  default_value = .string

 /**
  * Constructs an empty stem.
  *
  * The first access initialises the private native D2-hybrid representation.
  * Bucket heads and fixed-width hash/chain/generation records live in the
  * receiver's binary payload; keys, values, and the current default remain
  * VM-owned attributes.
  */
  *: factory
    return

 /**
  * Computes the hash bucket for a key.
  *
  * Uses a codepoint polynomial rolling hash (multiplier 31), reducing each
  * step modulo the bucket count to avoid native integer overflow.
  *
  * @param key key to hash
  * @return bucket number (1..num_buckets)
  */
  hash: method = .int
    arg key = .string

    h = 0
    key_length = .int
    codepoint = .int
    assembler strlen key_length,key
    do offset = 0 to key_length - 1
      assembler strchar codepoint,key,offset
      h = (h * 31 + codepoint) % 256
    end
    return h + 1

 /**
  * Retrieves the value associated with a key.
  *
  * @param key key to search for
  * @return associated value, the assigned stem default, or an empty string if
  *         neither exists
  */
  get: method = .string
    arg key = .string
    result = .string
    assembler stemget result,self,key
    return result

 /**
  * Adds or updates a key/value pair.
  *
  * If the key already exists, its value is replaced.
  * Otherwise a new entry is inserted.
  *
  * An omitted key is the property-assignment form produced by `stem. = value`.
  * It assigns the Classic stem default and replaces the values of existing
  * tails. An explicitly supplied empty-string key remains a normal key.
  *
  * @param key optional key to store; omission assigns the stem default
  * @param value value to associate with the key
  */
  set: method = .void
    arg key = "", value = .string

    if \?key then do
      assembler stemreset self,value
      return
    end
    assembler stemset self,key,value
    return

 /**
  * Returns the number of stored entries.
  *
  * @return entry count
  */
  size: method = .int
    result = .int
    assembler stemsize result,self
    return result

 /**
  * Returns the key at a given insertion index.
  *
  * @param ix insertion index (1-based)
  * @return key
  */
  key: method = .string
    arg ix = .int
    count = size()
    if ix < 1 | ix > count then
      assembler signal "INVALID_ARGUMENTS", "STEM key index is outside the stored range"
    result = .string
    assembler stemkeyat result,self,ix
    return result

 /**
  * Returns a value using an internal array index.
  *
   * @param kv internal value index (1-based)
   * @return value
   * @signal INVALID_ARGUMENTS index is outside the stored range
   */
  value: method = .string
    arg kv = .int
    count = size()
    if kv < 1 | kv > count then
      assembler signal "INVALID_ARGUMENTS", "STEM value index is outside the stored range"
    result = .string
    assembler stemvalueat result,self,kv
    return result

 /**
  * Returns a value at a given insertion index.
  *
  * @param ix insertion index (1-based)
  * @return value
  */
  valueAt: method = .string
    arg ix = .int
    count = size()
    if ix < 1 | ix > count then
      assembler signal "INVALID_ARGUMENTS", "STEM valueAt index is outside the stored range"
    result = .string
    assembler stemvalueat result,self,ix
    return result

 /**
  * Returns all keys.
  *
  * @return array containing all keys in insertion order
  */
  tails: method = .string[]
    result = .string[]
    count = size()
    do i = 1 to count
      key = .string
      assembler stemkeyat key,self,i
      result[i] = key
    end
    return result

 /**
  * Returns all values.
  *
  * @return array containing all values in insertion order
  */
  values: method = .string[]
    result = .string[]
    count = size()
    do i = 1 to count
      value = .string
      assembler stemvalueat value,self,i
      result[i] = value
    end
    return result

 /**
  * Creates a live iterator.
  *
  * The iterator reflects subsequent modifications to the stem.
  *
  * @return stemIterator instance
  */
  iterator: method = .stemIterator
    return .stemIterator(reference self, 0)

 /**
  * Creates a snapshot iterator.
  *
  * The iterator traverses a copy of the contents that existed
  * at the time of creation.
  *
  * @return stemIterator instance
  */
  snapshotIterator: method = .stemIterator
    return .stemIterator(reference self, 1)

 /** ------------------------------------------------------------------
  * stemIterator
  *
  * Iterator for traversing stem contents.
  *
  * Two operating modes exist:
  *
  * - Live mode
  *     Reads directly from the underlying stem.
  *
  * - Snapshot mode
  *     Operates on an internal copy of the stem contents.
  *
  * Iteration proceeds in insertion order.
  * ------------------------------------------------------------------ */
stemIterator: class
  stem_ref = reference .stem
  keys_copy = .string[]
  values_copy = .string[]
  count_copy = .int
  snapshot_ = .int
  index_ = .int
  current_tail_ = .string

 /**
  * Creates a new iterator.
  *
  * @param source stem to iterate over
  * @param snapshot_flag
  *        0 = live iterator
  *        1 = snapshot iterator
  */
  *: factory
    arg source = reference .stem, snapshot_flag = 0
    if snapshot_flag <> 0 & snapshot_flag <> 1 then
      assembler signal "INVALID_ARGUMENTS", "STEM iterator snapshot flag must be zero or one"
    snapshot_ = snapshot_flag
    index_ = 0
    current_tail_ = ""

    if snapshot_ = 1 then do
      stem = dereference source
      keys_copy = stem.tails()
      values_copy = stem.values()
      count_copy = stem.size()
    end
    else do
      stem_ref = source
    end
    return

 /**
  * Indicates whether another element exists.
  *
  * @return 1 if another element is available, otherwise 0
  */
  hasNext: method = .int
    if snapshot_ = 1 then
      return index_ < count_copy

    stem = dereference stem_ref
    return index_ < stem.size()

 /**
  * Advances to the next key.
  *
  * @return next key, or an empty string when exhausted
  */
  next: method = .string
    if snapshot_ = 1 then do
      if index_ >= count_copy then return ""
      index_ = index_ + 1
      current_tail_ = keys_copy[index_]
      return current_tail_
    end

    stem = dereference stem_ref
    if index_ >= stem.size() then return ""
    index_ = index_ + 1
    current_tail_ = stem.key(index_)
    return current_tail_

 /**
  * Returns the value corresponding to the current key.
  *
  * next() must have been called successfully first.
  *
  * @return current value
  */
  value: method = .string
    if index_ < 1 then return ""

    if snapshot_ = 1 then do
      if index_ > count_copy then return ""
      return values_copy[index_]
    end

    stem = dereference stem_ref
    return stem.value(index_)

 /**
  * Returns the current iterator position.
  *
  * @return 1-based index
  */
  index: method = .int
    return index_

 /**
  * Resets the iterator to its initial position.
  */
  reset: method = .void
    index_ = 0
    current_tail_ = ""
    return

 /**
  * Indicates whether the iterator is operating in live mode
  * and whether the underlying stem reference is still valid.
  *
  * @return 1 if live and valid, otherwise 0
  */
  isLive: method = .int
    if snapshot_ = 1 then return 0
    if <refvalid>(stem_ref) then return 1
    return 0
