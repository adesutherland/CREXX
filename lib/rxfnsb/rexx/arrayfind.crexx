/**
 * String-array substring search.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/arrayfind.md
 */
options levelb
namespace rxfnsb expose arrayfind

/**
 * Return the first array index whose element contains a substring.
 *
 * @param needle substring to locate
 * @param array one-based string array using array[0] as its high-water mark
 * @param from optional first array index; values below one clamp to one
 * @param case_sensitive optional 1 for case-sensitive or 0 for folded matching
 * @return first matching array index, or zero
 * @signal INVALID_ARGUMENTS case_sensitive is not 0 or 1
 */
arrayfind: procedure = .int
  arg needle = .string, array = .string[], from = 1, case_sensitive = 1
  high = array[0]
  found_position = .int
  candidate = .string

  if case_sensitive <> 0 & case_sensitive <> 1 then
    assembler signal "INVALID_ARGUMENTS", "ARRAYFIND case-sensitive flag must be zero or one"
  if needle == "" | high < 1 then return 0
  if from < 1 then from = 1
  if from > high then return 0

  if case_sensitive then do index = from to high
    candidate = array[index]
    found_position = 1
    assembler strpos found_position,needle,candidate
    if found_position > 0 then return index
  end
  else do
    folded_needle = ""
    folded_candidate = ""
    assembler strupper folded_needle,needle
    do index = .int(from) to high
      candidate = array[index]
      assembler strupper folded_candidate,candidate
      found_position = 1
      assembler strpos found_position,folded_needle,folded_candidate
      if found_position > 0 then return index
    end
  end
  return 0
