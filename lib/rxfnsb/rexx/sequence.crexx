options levelb

namespace rxfnsb expose sequence

/**
 * Return an inclusive ascending Unicode scalar sequence.
 *
 * @param from one Unicode character
 * @param tos one Unicode character
 * @return every Unicode scalar from from through tos
 * @signal INVALID_ARGUMENTS an endpoint is not one character or is descending
 */
sequence: procedure = .string
  arg from = .string, tos = .string
  from_length = .int
  to_length = .int
  from_codepoint = .int
  to_codepoint = .int
  current = .int
  index = 0
  result = ""

  assembler strlen from_length,from
  assembler strlen to_length,tos
  if from_length <> 1 | to_length <> 1 then
    assembler signal "INVALID_ARGUMENTS", "SEQUENCE endpoints must each contain exactly one character"

  assembler strchar from_codepoint,from,index
  assembler strchar to_codepoint,tos,index
  if from_codepoint > to_codepoint then
    assembler signal "INVALID_ARGUMENTS", "SEQUENCE start must not follow its end"

  current = from_codepoint
  do while current <= to_codepoint
    assembler appendchar result,current
    if current = to_codepoint then return result
    /* Unicode surrogate code points are not scalar values. */
    if current = 55295 then current = 57344
    else assembler inc current
  end
  return result
