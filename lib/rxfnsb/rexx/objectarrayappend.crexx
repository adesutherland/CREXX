/**
 * In-place object-array append.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/objectarrayappend.md
 */
options levelb
namespace rxfnsb expose objectarrayappend

/**
 * Append one object value one or more times.
 *
 * @param array exposed object array using array[0] as its high-water mark
 * @param value object value copied into each appended slot
 * @param count optional non-negative number of copies; defaults to one
 * @return the new array high-water mark
 * @signal INVALID_ARGUMENTS count is negative
 */
objectarrayappend: procedure = .int
  arg expose array = .object[], value = .object, count = 1

  hi = array[0]
  if count < 0 then
    assembler signal "INVALID_ARGUMENTS", "OBJECTARRAYAPPEND count must be non-negative"
  if count = 0 then return hi

  from = hi + 1
  assembler INSATTRS1 array,from,count

  i = from
  do count
    array[i] = value
    i = i + 1
  end
  return array[0]
