/** Find a string outside matching ASCII quotes. */
options levelb
namespace rxfnsb expose qpos

/**
 * Find the first occurrence of needle outside single or double quotes.
 * Doubled matching quotes escape a quote and unmatched quotes signal.
 *
 * @param needle non-empty string to locate
 * @param text source text
 * @param start optional positive one-based codepoint position
 * @return one-based codepoint position, or zero when absent
 * @signal INVALID_ARGUMENTS invalid needle, start, or quote grammar
 */
qpos: procedure = .int
  arg needle = .string, text = .string, start = 1
  matches = qscan_outside_matches(text,needle,start)
  if matches[0] = 0 then return 0
  return matches[1]
