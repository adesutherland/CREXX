/**
 * In-place string-array deletion.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/arraydelete.md
 */
options levelb
namespace rxfnsb expose arraydelete

/**
 * Delete a range from a one-based string array.
 *
 * @param array exposed array using array[0] as its high-water mark
 * @param from positive first index to delete
 * @param count non-negative maximum number of elements to delete
 * @return the new array high-water mark
 * @signal INVALID_ARGUMENTS invalid position or count
 */
arraydelete: procedure = .int
  arg expose array = .string[], from = .int, count = .int

  hi = array[0]
  if from < 1 then
    assembler signal "INVALID_ARGUMENTS", "ARRAYDELETE position must be positive"
  if count < 0 then
    assembler signal "INVALID_ARGUMENTS", "ARRAYDELETE count must be non-negative"
  if count = 0 | hi < 1 | from > hi then return hi

  available = hi - from + 1
  if count > available then count = available

  assembler DELATTRS1 array,from,count
  return array[0]
