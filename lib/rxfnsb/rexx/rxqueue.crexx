/*------------------------------------------------------------
 * RXFNSB Queue Functions
 *
 * Simple implementation of the classic Rexx data queue.
 *
 * The queue is shared by the running CREXX execution and all
 * nested procedures through EXPOSE.
 *
 * Internally, the queue is represented as a string array.
 * A future implementation may replace this with a more
 * efficient data structure or an external queue manager
 * without changing the public interface.
 *------------------------------------------------------------
*/

options levelb
import rxfnsb

namespace rxfnsb expose push queue pull queued

/*------------------------------------------------------------*/
/* Insert a string at the front of the queue (LIFO).          */
/*------------------------------------------------------------*/
push: procedure = .void expose _queue _queue_ready
  arg value = .string
  call _ensure_queue
  call arrayprepend _queue, value
return

/*------------------------------------------------------------*/
/* Append a string to the end of the queue (FIFO).            */
/*------------------------------------------------------------*/
queue: procedure = .void expose _queue _queue_ready
  arg value = .string
  call _ensure_queue
  call arrayappend _queue, value
return

/*------------------------------------------------------------*/
/* Remove and return the next string from the queue.          */
/*                                                            */
/* Returns an empty string when the queue is empty.           */
/*------------------------------------------------------------*/
pull: procedure = .string expose _queue _queue_ready
  call _ensure_queue
  if _queue[0] = 0 then return ""

  value = _queue[1]
  call arraydelete _queue, 1, 1
return value

/*------------------------------------------------------------*/
/* Return the current number of queued entries.               */
/*------------------------------------------------------------*/
queued: procedure = .int expose _queue _queue_ready
  call _ensure_queue
  return _queue[0]

/*------------------------------------------------------------*/
/* Initialize private queue state without executable top-level */
/* code in the linked library module.                          */
/*------------------------------------------------------------*/
_ensure_queue: procedure = .void expose _queue _queue_ready
  if _queue_ready <> 1 then do
    _queue = .string[]
    _queue_ready = 1
  end
return
