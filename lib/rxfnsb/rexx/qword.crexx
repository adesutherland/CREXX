/** Select a Unicode quote-aware word. */
options levelb
namespace rxfnsb expose qword

/**
 * Return the requested word, preserving quote delimiters and doubled quotes.
 * Quotes may occur anywhere in a word and Unicode White_Space separates words.
 *
 * @param line source text
 * @param wanted positive one-based word number
 * @return selected word, or empty when absent
 * @signal INVALID_ARGUMENTS invalid index or unmatched quote
 */
qword: procedure = .string
  arg line = .string, wanted = .int
  if wanted < 1 then
    assembler signal "INVALID_ARGUMENTS", "QWORD word number must be positive"
  spans = qscan_word_spans(line)
  current_word = 0
  do start_index = 1 to spans[0] by 2
    current_word = current_word + 1
    if current_word = wanted then
      return substr(line,spans[start_index] + 1,spans[start_index + 1])
  end
  return ''
