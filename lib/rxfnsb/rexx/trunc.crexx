/* rexx */
  options levelb

namespace rxfnsb expose trunc

trunc: procedure = .string
       arg innum = .string, fraction = 0
   source=innum

 /* translate exponential format to integer */
   ppi=pos('E',source)
   if ppi>0 then do
      num=substr(source,1,ppi-1)
      exp=substr(source,ppi+1)
      assembler stof num
      assembler stoi exp
      xnum=num*(10**exp)
      assembler itos xnum
      source=xnum||''
   end

   whole=.string
   fractional=.string
   dp=pos('.',source)
   if dp=0 then do
      whole=source
      fractional=""
   end
   else do
      whole=substr(source,1,dp-1)
      fractional=substr(source,dp+1)
   end

   if whole="" then whole="0"
   if fraction=0 then return whole
   return whole||'.'||left(fractional,fraction,'0')
