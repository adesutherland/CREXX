/**
 * Independent string-array slice copy.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/arraycopy.md
 */
options levelb

namespace rxfnsb expose arraycopy

/**
 * Copy a bounded slice into a new one-based string array.
 *
 * @param array read-only source array using array[0] as its high-water mark
 * @param from optional first source index; negative values count from the end
 * @param count optional non-negative maximum length; zero means through end
 * @return a new independently mutable array containing the selected strings
 * @signal INVALID_ARGUMENTS count is negative
 */
arraycopy: procedure=.string[]
  arg expose array=.string[], from=1, count=0

  high = array[0]
  result = .string[]
  if count < 0 then
    assembler signal "INVALID_ARGUMENTS", "ARRAYCOPY count must be non-negative"
  if from < 0 then from = high + from + 1
  if from < 1 | from > high then return result

  available = high - from + 1
  if count = 0 | count > available then count = available
  assembler SETATTRS result,count

  source_index = from
  target_index = 1
  source_value = ""
  target_value = ""
  do count
    assembler linkattr1 source_value,array,source_index
    assembler linkattr1 target_value,result,target_index
    assembler scopy target_value,source_value
    assembler unlink source_value
    assembler unlink target_value
    assembler inc source_index
    assembler inc target_index
  end
  return result
