/**
 * Count whitespace-delimited words.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/words.md
 */
options levelb

namespace rxfnsb expose words

/**
 * Count words in a string.
 *
 * @param string source text
 * @return number of words
 */
words: procedure = .int
  arg string = .string
  string_length = .int
  assembler strlen string_length,string
  scan = 0
  count = 0
  if string_length = 0 then return 0

  do while scan < string_length
    assembler fndnblnk scan,string,scan
    if scan < 0 then leave
    count = count + 1
    assembler fndblnk scan,string,scan
    if scan < 0 then leave
  end
  return count
