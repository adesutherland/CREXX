/** Level B binary64 sign. @docType runtime-function @see lib/rxfnsb/rexx/floatsign.md */
options levelb
namespace rxfnsb expose floatsign

/**
 * Return the sign of a binary64 value.
 *
 * @param number binary64 value
 * @return -1, 0 or 1; both signed zeros return 0
 * @signal INVALID_ARGUMENTS number is NaN
 */
floatsign: procedure = .int
  arg number = .float
  if number <> number then assembler signal "INVALID_ARGUMENTS","FLOATSIGN does not accept NaN"
  if number > 0.0 then return 1
  if number < 0.0 then return -1
  return 0
