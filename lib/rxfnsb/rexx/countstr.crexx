/**
 * Level B COUNTSTR implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/countstr.md
 */
options levelb

namespace rxfnsb expose countstr

/**
 * Count non-overlapping occurrences of a string.
 *
 * @param needle case-sensitive text to find
 * @param haystack text to search
 * @return number of non-overlapping matches
 */
countstr: procedure = .int
  arg needle = .string, haystack = .string
  count = 0
  position = 1
  found = .int
  needle_length = .int
  haystack_length = .int
  assembler strlen needle_length,needle
  assembler strlen haystack_length,haystack
  if needle_length = 0 | needle_length > haystack_length then return 0

  do forever
    found = position
    assembler strpos found,needle,haystack
    if found = 0 then leave
    count = count + 1
    position = found + needle_length
  end
  return count
