/**
 * Level B native-integer absolute value.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/intabs.md
 */
options levelb
namespace rxfnsb expose intabs

/**
 * Return the absolute value of a signed 64-bit integer.
 *
 * @param number native signed integer
 * @return non-negative native integer
 * @signal OVERFLOW_UNDERFLOW the absolute value is not representable
 */
intabs: procedure = .int
  arg number = .int
  minimum = -9223372036854775807 - 1
  zero = 0
  result = .int
  if number = minimum then
    assembler signal "OVERFLOW_UNDERFLOW","INTABS cannot represent abs(INT64_MIN)"
  if number < 0 then do
    assembler isub result,zero,number
    return result
  end
  return number
