/**
 * Typed Level B Unicode-byte X2C implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/x2c.md
 */
options levelb

namespace rxfnsb expose x2c

/**
 * Convert grouped hexadecimal bytes to Unicode U+00xx characters.
 *
 * @param hexadecimal hexadecimal digits with standard interior grouping blanks
 * @return one Unicode code point for each parsed byte
 */
x2c: procedure = .string
  arg hexadecimal = .string
  hexadecimal_length = .int
  hexadecimal_digits = 0
  codepoint = .int
  remainder = .int
  nibble = .int
  high_nibble = -1
  byte = .int
  blank_character = 32
  result = ""
  index = 0

  assembler strlen hexadecimal_length,hexadecimal
  if hexadecimal_length = 0 then return result
  assembler strchar codepoint,hexadecimal,index
  if codepoint = blank_character then
    assembler signal "INVALID_ARGUMENTS", "X2C hexadecimal text cannot start with a blank"
  index = hexadecimal_length - 1
  assembler strchar codepoint,hexadecimal,index
  if codepoint = blank_character then
    assembler signal "INVALID_ARGUMENTS", "X2C hexadecimal text cannot end with a blank"

  do index = hexadecimal_length - 1 to 0 by -1
    assembler strchar codepoint,hexadecimal,index
    if codepoint = blank_character then do
      assembler iand remainder,hexadecimal_digits,1
      if remainder <> 0 then
        assembler signal "INVALID_ARGUMENTS", "X2C blank must have an even number of hexadecimal digits to its right"
    end
    else if (codepoint >= 48 & codepoint <= 57) |,
            (codepoint >= 65 & codepoint <= 70) |,
            (codepoint >= 97 & codepoint <= 102) then
      hexadecimal_digits = hexadecimal_digits + 1
    else
      assembler signal "INVALID_ARGUMENTS", "X2C input contains a non-hexadecimal character"
  end

  assembler iand remainder,hexadecimal_digits,1
  if remainder <> 0 then high_nibble = 0
  do index = 0 to hexadecimal_length - 1
    assembler strchar codepoint,hexadecimal,index
    if codepoint = blank_character then iterate
    if codepoint <= 57 then nibble = codepoint - 48
    else if codepoint <= 70 then nibble = codepoint - 55
    else nibble = codepoint - 87
    if high_nibble < 0 then high_nibble = nibble
    else do
      byte = high_nibble * 16 + nibble
      assembler appendchar result,byte
      high_nibble = -1
    end
  end
  return result
