/**
 * Typed Level B Unicode D2C implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/d2c.md
 */
options levelb

namespace rxfnsb expose d2c

/**
 * Convert a native Unicode scalar value to one character.
 *
 * @param codepoint native Unicode scalar value
 * @param output_length optional Unicode character count, zero or one
 * @return the encoded character, or empty text for a zero output length
 */
d2c: procedure = .string
  arg codepoint = .int, output_length = 0
  length_supplied = ?output_length

  if length_supplied then do
    if output_length < 0 | output_length > 1 then
      assembler signal "CONVERSION_ERROR", "D2C Unicode output length must be zero or one"
    if output_length = 0 then return ""
  end

  if codepoint < 0 | codepoint > 1114111 | ,
     (codepoint >= 55296 & codepoint <= 57343) then
    assembler signal "CONVERSION_ERROR", "D2C invalid Unicode scalar value"

  result = ""
  assembler appendchar result,codepoint
  return result
