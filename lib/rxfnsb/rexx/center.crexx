/**
 * Level B CENTER implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/center.md
 */
options levelb

namespace rxfnsb expose center

/**
 * Center or centrally truncate a string to an exact character width.
 *
 * @param string source text
 * @param width non-negative result width
 * @param pad exactly one padding codepoint
 * @return a string containing exactly `width` codepoints
 */
center: procedure = .string
  arg string = .string, width = .int, pad = " "
  string_length = .int
  pad_length = .int
  difference = .int
  half = .int
  start = .int
  pad_character = .int
  pad_index = 0
  padding = ""
  result = ""

  if width < 0 then
    assembler signal "INVALID_ARGUMENTS","CENTER width must be non-negative"
  assembler strlen pad_length,pad
  if pad_length <> 1 then
    assembler signal "INVALID_ARGUMENTS","CENTER pad must contain exactly one character"

  assembler strlen string_length,string
  if width = string_length then return string

  if width < string_length then do
    difference = string_length - width
    start = difference
    assembler idiv start,start,2
    assembler SETSTRPOS string,start
    assembler substring result,string,width
    return result
  end

  difference = width - string_length
  half = difference
  assembler idiv half,half,2
  assembler strchar pad_character,pad,pad_index
  assembler padstr padding,pad_character,half
  assembler scopy result,padding
  assembler append result,string
  assembler append result,padding
  if difference - half > half then assembler appendchar result,pad_character
  return result
