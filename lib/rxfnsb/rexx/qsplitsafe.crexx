/** Split outside quotes and nested configured delimiter pairs. */
options levelb
namespace rxfnsb expose qsplitsafe

/**
 * Split exact fields on separators outside quotes and pair stacks.
 * Pair configuration consists of one-codepoint opener/closer pairs.
 *
 * @param text source text
 * @param sep non-empty separator
 * @param start optional positive position at which separators become active
 * @param pairs optional opener/closer codepoint pairs, default ()
 * @return exact fields; the prefix before start remains in the first field
 * @signal INVALID_ARGUMENTS invalid arguments, quotes, or pair grammar
 */
qsplitsafe: procedure = .string[]
  arg text = .string, sep = .string, start = 1, pairs = '()'
  matches = qscan_safe_matches(text,sep,start,pairs)
  parts = .string[]
  separator_length = .int
  assembler strlen separator_length,sep
  field_start = 1
  do index = 1 to matches[0]
    separator_position = matches[index]
    parts[index] = substr(text,field_start,separator_position - field_start)
    field_start = separator_position + separator_length
  end
  parts[matches[0] + 1] = substr(text,field_start)
  return parts
