/**
 * Non-mutating string-array element lookup with a fallback value.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/arrayget.md
 */
options levelb

namespace rxfnsb expose arrayget

/**
 * Return one array element, or a fallback for an out-of-range index.
 *
 * @param array string array using array[0] as its high-water mark
 * @param index one-based element index
 * @param default fallback value; defaults to the empty string
 * @return array[index] when index is in range, otherwise default
 */
arrayget: procedure=.string
  arg array=.string[], index=.int, default=""

  if index < 1 then return default
  if index > array[0] then return default
return array[index]
