/**
 * Level B formatted-float integer helper.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/_itrunc.md
 */
options levelb
namespace _rxsysb expose _itrunc

/**
 * Return the text before the decimal point in a VM-formatted float.
 *
 * @param number floating-point value
 * @return formatted integer prefix, including any sign
 */
_itrunc: procedure = .string
  arg number = .float
  result = ""
  decimal_point = "."
  point_position = 1
  integer_length = .int
  start = 0

  assembler ftos number
  assembler strpos point_position,decimal_point,number
  if point_position = 0 then do
    assembler scopy result,number
    return result
  end
  integer_length = point_position - 1
  if integer_length <= 0 then return result
  assembler substring result,number,start,integer_length
  return result
