/**
 * Level B ABS implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/abs.md
 */
options levelb comments_dash numeric_classic
namespace rxfnsb expose abs

/**
 * Return the absolute value of a decimal number.
 *
 * @param number decimal value
 * @return non-negative decimal value
 * @signal CONVERSION_ERROR number cannot be converted to decimal
 */
abs: procedure = .decimal
  arg number = .decimal
  if number < 0 then return 0 - number
  return number
