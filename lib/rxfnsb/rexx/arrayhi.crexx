/**
 * String-array high-water query and bounded shrink.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/arrayhi.md
 */
options levelb

namespace rxfnsb expose arrayhi

/**
 * Query an array high-water mark or shrink it in place.
 *
 * @param array exposed string array using array[0] as its high-water mark
 * @param mode optional case-insensitive GET or SET; omitted means GET
 * @param newhi positive smaller mark used only with SET
 * @return the resulting array high-water mark
 * @signal INVALID_ARGUMENTS invalid mode or mode/newhi combination
 */
arrayhi: procedure=.int
  arg expose array=.string[], mode="GET", newhi=0
  mode_supplied = ?mode
  newhi_supplied = ?newhi
  high = array[0]

  if \mode_supplied then return high

  folded_mode = ""
  assembler strupper folded_mode,mode
  if folded_mode == "GET" then do
    if newhi_supplied then
      assembler signal "INVALID_ARGUMENTS", "ARRAYHI GET does not accept a new high-water mark"
    return high
  end
  if folded_mode <> "SET" then
    assembler signal "INVALID_ARGUMENTS", "ARRAYHI mode must be GET or SET"
  if \newhi_supplied then
    assembler signal "INVALID_ARGUMENTS", "ARRAYHI SET requires a new high-water mark"

  if newhi >= high | newhi < 1 then return high
  assembler SETATTRS array,newhi
  return newhi
