/**
 * In-place string-array insertion.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/arrayinsert.md
 */
options levelb
namespace rxfnsb expose arrayinsert

/**
 * Open and initialise a gap in a one-based string array.
 *
 * @param array exposed array using array[0] as its high-water mark
 * @param from positive insertion position; beyond the end clamps to append
 * @param count non-negative number of slots to insert
 * @param default optional value assigned to every inserted slot
 * @return the new array high-water mark
 * @signal INVALID_ARGUMENTS invalid position or count
 */
arrayinsert: procedure = .int
  arg expose array = .string[], from = .int, count = .int, default = ""

  hi = array[0]
  if from < 1 then
    assembler signal "INVALID_ARGUMENTS", "ARRAYINSERT position must be positive"
  if count < 0 then
    assembler signal "INVALID_ARGUMENTS", "ARRAYINSERT count must be non-negative"
  if count = 0 then return hi

  if from > hi + 1 then from = hi + 1
  assembler INSATTRS1 array,from,count

  i = from
  do count
    array[i] = default
    i = i + 1
  end
  return array[0]
