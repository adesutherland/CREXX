/**
 * Compile the legacy dynamic PARSE template representation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/parsecompile.md
 */
options levelb
namespace rxfnsb expose parsecompile

/**
 * Compile a dynamic template into parallel token and integer-kind arrays.
 *
 * Kinds are 1 variable, 2 literal, 3 absolute position, 4 signed relative
 * position, 5 implicit word separator, and 6 prior-variable delimiter search.
 * The output arrays are not changed if template validation fails.
 *
 * @param template dynamic template text
 * @param token exposed output payload array
 * @param token_type exposed output integer-kind array
 * @return number of compiled plan items
 * @signal INVALID_ARGUMENTS malformed quote, position, or search token
 */
parsecompile: procedure = .int
  arg template = .string, expose token = .string[], expose token_type = .int[]
  template_length = .int
  index = .int
  segment_start = .int
  next_index = .int
  quote_code = .int
  code = .int
  next_code = .int
  char_index = .int
  segment_length = .int
  kind = .int
  value = .string
  pending_blank = .string
  pending_blank_exists = .boolean
  previous_kind = .int
  count = .int

  /* Validation is deliberately complete before exposed output is touched. */
  call _validate_legacy_template template

  assembler SETATTRS token,0
  assembler SETATTRS token_type,0

  assembler strlen template_length,template
  index = 0
  segment_start = 0
  pending_blank = ""
  pending_blank_exists = 0
  previous_kind = 0
  count = 0

  do while index < template_length
    assembler strchar code,template,index

    if _legacy_blank(code) then do
      if index > segment_start then do
        segment_length = index - segment_start
        kind = _legacy_segment_kind(template,segment_start,segment_length)
        value = _legacy_slice(template,segment_start,segment_length)
        if kind = 6 then value = _legacy_slice(template,segment_start + 1,segment_length - 2)
        count = _emit_legacy_item(token,token_type,count,pending_blank,pending_blank_exists,previous_kind,value,kind)
      end

      next_index = index + 1
      do while next_index < template_length
        assembler strchar next_code,template,next_index
        if \_legacy_blank(next_code) then leave
        next_index = next_index + 1
      end

      /* The historical compiler suppresses whitespace touching a quote. */
      if previous_kind = 2 | (next_index < template_length & (next_code = 39 | next_code = 34)) then do
        pending_blank = ""
        pending_blank_exists = 0
      end
      else do
        pending_blank = _legacy_slice(template,index,next_index - index)
        pending_blank_exists = 1
      end
      index = next_index
      segment_start = index
      iterate
    end

    if code = 39 | code = 34 then do
      if index > segment_start then do
        segment_length = index - segment_start
        kind = _legacy_segment_kind(template,segment_start,segment_length)
        value = _legacy_slice(template,segment_start,segment_length)
        if kind = 6 then value = _legacy_slice(template,segment_start + 1,segment_length - 2)
        count = _emit_legacy_item(token,token_type,count,pending_blank,pending_blank_exists,previous_kind,value,kind)
      end

      quote_code = code
      next_index = index + 1
      do while next_index < template_length
        assembler strchar next_code,template,next_index
        if next_code = quote_code then do
          if next_index + 1 < template_length then do
            char_index = next_index + 1
            assembler strchar code,template,char_index
            if code = quote_code then do
              next_index = next_index + 2
              iterate
            end
          end
          leave
        end
        next_index = next_index + 1
      end

      value = _legacy_slice(template,index + 1,next_index - index - 1)
      count = _emit_legacy_item(token,token_type,count,pending_blank,pending_blank_exists,previous_kind,value,2)
      index = next_index + 1
      segment_start = index
      iterate
    end

    index = index + 1
  end

  if index > segment_start then do
    segment_length = index - segment_start
    kind = _legacy_segment_kind(template,segment_start,segment_length)
    value = _legacy_slice(template,segment_start,segment_length)
    if kind = 6 then value = _legacy_slice(template,segment_start + 1,segment_length - 2)
    count = _emit_legacy_item(token,token_type,count,pending_blank,pending_blank_exists,previous_kind,value,kind)
  end
  return count

/* Validate without mutating the exposed output arrays. */
_validate_legacy_template: procedure
  arg template = .string
  template_length = .int
  index = .int
  segment_start = .int
  next_index = .int
  code = .int
  next_code = .int
  quote_code = .int
  char_index = .int

  assembler strlen template_length,template
  index = 0
  segment_start = 0
  do while index < template_length
    assembler strchar code,template,index
    if _legacy_blank(code) then do
      if index > segment_start then call _validate_legacy_segment template,segment_start,index - segment_start
      index = index + 1
      do while index < template_length
        assembler strchar code,template,index
        if \_legacy_blank(code) then leave
        index = index + 1
      end
      segment_start = index
      iterate
    end

    if code = 39 | code = 34 then do
      if index > segment_start then call _validate_legacy_segment template,segment_start,index - segment_start
      quote_code = code
      next_index = index + 1
      do while next_index < template_length
        assembler strchar next_code,template,next_index
        if next_code = quote_code then do
          if next_index + 1 < template_length then do
            char_index = next_index + 1
            assembler strchar code,template,char_index
            if code = quote_code then do
              next_index = next_index + 2
              iterate
            end
          end
          leave
        end
        next_index = next_index + 1
      end
      if next_index >= template_length then
        assembler signal "INVALID_ARGUMENTS","PARSECOMPILE template has an unmatched quote"
      index = next_index + 1
      segment_start = index
      iterate
    end
    index = index + 1
  end
  if index > segment_start then call _validate_legacy_segment template,segment_start,index - segment_start
  return

_validate_legacy_segment: procedure
  arg source = .string, start = .int, segment_length = .int
  first_code = .int
  last_code = .int
  char_index = .int

  if segment_length <= 0 then return
  assembler strchar first_code,source,start
  if first_code = 43 | first_code = 45 then do
    if segment_length = 1 | \_legacy_digits(source,start + 1,segment_length - 1) then
      assembler signal "INVALID_ARGUMENTS","PARSECOMPILE relative position must be a sign followed by digits"
    if \_legacy_native_magnitude(source,start + 1,segment_length - 1,first_code = 45) then
      assembler signal "INVALID_ARGUMENTS","PARSECOMPILE relative position is too large"
    return
  end
  if first_code = 40 then do
    if segment_length < 3 then
      assembler signal "INVALID_ARGUMENTS","PARSECOMPILE search token must be parenthesized and nonempty"
    char_index = start + segment_length - 1
    assembler strchar last_code,source,char_index
    if last_code <> 41 then
      assembler signal "INVALID_ARGUMENTS","PARSECOMPILE search token is missing its closing parenthesis"
    return
  end
  if _legacy_digits(source,start,segment_length) then do
    if \_legacy_native_magnitude(source,start,segment_length) then
      assembler signal "INVALID_ARGUMENTS","PARSECOMPILE absolute position is too large"
  end
  return

_legacy_segment_kind: procedure = .int
  arg source = .string, start = .int, segment_length = .int
  first_code = .int
  assembler strchar first_code,source,start
  if first_code = 43 | first_code = 45 then return 4
  if first_code = 40 then return 6
  if _legacy_digits(source,start,segment_length) then return 3
  return 1

_legacy_digits: procedure = .boolean
  arg source = .string, start = .int, segment_length = .int
  code = .int
  if segment_length <= 0 then return 0
  do index = start to start + segment_length - 1
    assembler strchar code,source,index
    if code < 48 | code > 57 then return 0
  end
  return 1

/* Native positions are signed 64-bit integers. */
_legacy_native_magnitude: procedure = .boolean
  arg source = .string, start = .int, segment_length = .int, allow_minimum = 0
  first_nonzero = .int
  significant = .int
  code = .int
  limit_code = .int
  char_index = .int
  limit_text = .string
  constant LIMIT = "9223372036854775807"

  limit_text = LIMIT
  if allow_minimum then limit_text = "9223372036854775808"
  first_nonzero = start
  do while first_nonzero < start + segment_length
    assembler strchar code,source,first_nonzero
    if code <> 48 then leave
    first_nonzero = first_nonzero + 1
  end
  significant = start + segment_length - first_nonzero
  if significant < 19 then return 1
  if significant > 19 then return 0
  do index = 0 to 18
    char_index = first_nonzero + index
    assembler strchar code,source,char_index
    assembler strchar limit_code,limit_text,index
    if code < limit_code then return 1
    if code > limit_code then return 0
  end
  return 1

_legacy_blank: procedure = .boolean
  arg code = .int
  return code = 32 | code = 9 | code = 13 | code = 10 | code = 11 | code = 12 | code = 160

_legacy_slice: procedure = .string
  arg source = .string, start = .int, slice_length = .int
  result = ""
  if slice_length <= 0 then return result
  assembler substring result,source,start,slice_length
  return result

_emit_legacy_item: procedure = .int
  arg expose token = .string[], expose token_type = .int[], count = .int, expose pending_blank = .string, expose pending_blank_exists = .boolean, expose previous_kind = .int, value = .string, kind = .int

  if pending_blank_exists then do
    if previous_kind = 1 & kind = 1 then do
      count = count + 1
      token[count] = pending_blank
      token_type[count] = 5
    end
    pending_blank = ""
    pending_blank_exists = 0
  end
  count = count + 1
  token[count] = value
  token_type[count] = kind
  previous_kind = kind
  return count
