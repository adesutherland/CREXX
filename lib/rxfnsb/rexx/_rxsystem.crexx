/**
 * Level B process-exit and cached file-handle primitives.
 *
 * @docType runtime-module
 * @see lib/rxfnsb/rexx/_rxsystem.md
 */
options levelb
namespace _rxsysb expose _open _close _exit
#import rxfnsb

/** Exit the VM process with an integer return code. */
_exit: procedure = .void
    arg return_value = 0
    /* We can call exit handlers here */
    assembler exit return_value /* Real Exit! */
    return /* Never Reached */

/**
 * Return a cached FILEID, opening the file when needed.
 *
 * Modes are r, w, or a. The cached w/a modes both use append at the C boundary
 * so repeated line/character output calls retain the open stream position.
 */
_open: procedure = .int expose _open_file_names _open_file_ids _open_file_modes
    arg name = .string, mode = .string

    _open_file_names = .string[]
    _open_file_ids = .int[]
    _open_file_modes = .string[]
    fileid = .int
    empty_slot = .int
    rc = .int
    c_mode = .string
    requested_mode = .string

    if name = "" then do
        call _rxsystem_invalid_arguments("_open requires a non-blank file name")
        return 0
    end

    requested_mode = mode
    if requested_mode = "r" then c_mode = "r"
    else if requested_mode = "w" | requested_mode = "a" then c_mode = "a"
    else do
        call _rxsystem_invalid_arguments("_open mode must be r, w, or a")
        return 0
    end

    do i = 1 to _open_file_names.0 while fileid = 0
        if name = _open_file_names.i then do
            if c_mode <> _open_file_modes.i then do
                /* need to close the file so it can be opened again in the right mode */
                assembler fclose rc,_open_file_ids.i
                _open_file_ids.i = 0
                _open_file_names.i = ""
                _open_file_modes.i = ""
                if rc <> 0 then do
                    call _rxsystem_notready("_open could not close file while changing mode: " || name)
                    return 0
                end
            end
            else fileid = _open_file_ids.i
        end
        if empty_slot = 0 & _open_file_names.i = "" then empty_slot = i
    end

    if fileid = 0 then do
        if empty_slot = 0 then empty_slot = _open_file_names.0 + 1

        assembler fopen fileid,name,c_mode
        if fileid <> 0 then do
            _open_file_names.empty_slot = name
            _open_file_modes.empty_slot = c_mode
            _open_file_ids.empty_slot = fileid
        end
    end

    return fileid

/** Close and remove a cached file handle. */
_close: procedure = .void expose _open_file_names _open_file_ids _open_file_modes
    arg name = .string, nomsg = 0

    found_slot = .int
    rc = .int

    if name = "" then do
        call _rxsystem_invalid_arguments("_close requires a non-blank file name")
        return
    end
    if nomsg <> 0 & nomsg <> 1 then do
        call _rxsystem_invalid_arguments("_close nomsg must be 0 or 1")
        return
    end

    do i = 1 to _open_file_names.0 while found_slot = 0
        if name = _open_file_names.i then found_slot = i
    end

    rc = 0
    if found_slot > 0 then do
        assembler fclose rc,_open_file_ids.found_slot
        _open_file_ids.found_slot = 0
        _open_file_names.found_slot = ""
        _open_file_modes.found_slot = ""
        if rc <> 0 & \nomsg then do
            call _rxsystem_notready("_close failed for file: " || name)
            return
        end
    end
    else if \nomsg then do
        call _rxsystem_notready("_close file is not open: " || name)
        return
    end

    return

_rxsystem_invalid_arguments: procedure = .void
    arg message = .string
    assembler signal "INVALID_ARGUMENTS",message
    return

_rxsystem_notready: procedure = .void
    arg message = .string
    assembler signal "NOTREADY",message
    return
