/**
 * Level B formatted-float fraction helper.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/_ftrunc.md
 */
options levelb
namespace _rxsysb expose _ftrunc

/**
 * Return the text after the decimal point in a VM-formatted float.
 *
 * @param number floating-point value
 * @return formatted fractional suffix, or the empty string when there is none
 */
_ftrunc: procedure = .string
  arg number = .float
  result = ""
  decimal_point = "."
  point_position = 1
  formatted_length = .int
  fraction_length = .int

  assembler ftos number
  assembler strpos point_position,decimal_point,number
  if point_position = 0 then return result
  assembler strlen formatted_length,number
  fraction_length = formatted_length - point_position
  if fraction_length <= 0 then return result
  assembler substring result,number,point_position,fraction_length
  return result
