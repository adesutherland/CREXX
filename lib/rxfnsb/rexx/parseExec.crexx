/**
 * Execute the compiler PARSE exit's frozen length-prefixed stream plan.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/parseExec.md
 */
options levelb
namespace rxfnsb expose parseexec

/**
 * Execute `kind,length:text;` items without materializing a decoded plan.
 *
 * Kinds are 1 target, 2 literal, 3 absolute position, 4 relative forward,
 * 5 relative backward, and 6 implicit next-word control. The decoder retains
 * at most two lookahead items plus pre-start controls.
 *
 * @param src source text
 * @param splan frozen compiler-emitted stream plan
 * @param template diagnostic template text
 * @param debug optional 0, 1, or 9 diagnostic level
 * @return values aligned with target items, including drop-target slots
 * @signal INVALID_ARGUMENTS malformed stream, item, numeric payload, or debug
 */
parseexec: procedure = .string[]
  arg src = .string, splan = .string, template = .string, debug = 0
  result = .string[]
  source_length = .int
  cursor = .int
  pending_variable = .string
  capture_start = .int
  pre_count = .int
  pre_kind = .int[]
  pre_text = .string[]
  shared_kind = .int
  shared_text = .string
  plan_position = .int
  current_kind = .int
  current_text = .string
  next_kind = .int
  next_text = .string
  after_kind = .int
  after_text = .string
  current_exists = .boolean
  next_exists = .boolean
  after_exists = .boolean
  item_number = .int
  final_cursor = .int
  position = .int
  anchor_at_start = .boolean
  starts_with_blank = .boolean
  pre_relative_anchor = .boolean
  first_code = .int
  literal_index = .int
  literal_length = .int
  relative_anchor = .int

  if debug <> 0 & debug <> 1 & debug <> 9 then
    assembler signal "INVALID_ARGUMENTS","PARSEEXEC debug must be 0, 1, or 9"

  assembler strlen source_length,src
  cursor = 1
  pending_variable = ""
  capture_start = 0
  pre_count = 0
  shared_kind = 0
  shared_text = ""
  plan_position = 0
  item_number = 0
  relative_anchor = 0
  pre_relative_anchor = 0

  current_exists = _stream_next_item(splan,plan_position,current_kind,current_text)
  next_exists = _stream_next_item(splan,plan_position,next_kind,next_text)
  after_exists = _stream_next_item(splan,plan_position,after_kind,after_text)

  if debug > 0 then do
    call _parse_log "----- PARSE STREAM -----"
    call _parse_log "PARSE STRING='" || src || "'"
    call _parse_log "PARSE TEMPLATE='" || template || "'"
  end
  if debug = 9 then call _parse_log "PLAN='" || splan || "'"

  do while current_exists
    item_number = item_number + 1
    if debug = 9 then
      call _parse_log "ITEM[" || item_number || "] KIND=(" || current_kind || "," || current_text || ") CURSOR=" || cursor

    if current_kind = 1 then do
      if pending_variable <> "" then do
        final_cursor = _finalize_implicit(src,source_length,capture_start,result)
        cursor = final_cursor
        pending_variable = ""
        capture_start = 0
      end

      if shared_kind <> 0 then do
        pre_count = pre_count + 1
        pre_kind[pre_count] = shared_kind
        pre_text[pre_count] = shared_text
        shared_kind = 0
        shared_text = ""
      end

      /* Preserve the established ABS/LIT/ABS overlay normalization. */
      if pre_count >= 3 then do
        if pre_kind[pre_count] = 3 & pre_kind[pre_count - 1] = 2 & pre_kind[pre_count - 2] = 3 then do
          if pre_text[pre_count] = pre_text[pre_count - 2] then pre_count = pre_count - 1
        end
      end

      do pre_index = 1 to pre_count
        if pre_kind[pre_index] = 8 then do
          assembler strlen literal_length,pre_text[pre_index]
          position = cursor - literal_length
          if position >= 1 & _stream_equals_at(src,source_length,position,pre_text[pre_index]) then cursor = position
          else cursor = source_length + 1
        end
        else if pre_kind[pre_index] = 2 then do
          position = cursor
          if pre_text[pre_index] = "" then position = cursor
          else assembler strpos position,pre_text[pre_index],src
          if pre_text[pre_index] <> "" & position = 0 then cursor = source_length + 1
          else do
            relative_anchor = position
            anchor_at_start = 0
            starts_with_blank = 0
            assembler strlen literal_length,pre_text[pre_index]
            if literal_length > 0 then do
              literal_index = 0
              assembler strchar first_code,pre_text[pre_index],literal_index
              if first_code = 32 then starts_with_blank = 1
            end
            if pre_index < pre_count then do
              if pre_kind[pre_index + 1] = 4 | pre_kind[pre_index + 1] = 5 then anchor_at_start = 1
            end
            if \anchor_at_start & \starts_with_blank & next_exists & (next_kind = 4 | next_kind = 5) then anchor_at_start = 1
            if anchor_at_start then cursor = position
            else cursor = position + literal_length
          end
        end
        else cursor = _apply_stream_cursor(src,source_length,cursor,pre_kind[pre_index],pre_text[pre_index])
      end

      pre_relative_anchor = 0
      do pre_index = 1 to pre_count - 1
        if pre_kind[pre_index] = 2 & (pre_kind[pre_index + 1] = 4 | pre_kind[pre_index + 1] = 5) then do
          pre_relative_anchor = 1
          leave
        end
      end
      pre_count = 0
      /* A literal immediately followed by a pre-target relative control has
       * already been consumed while establishing this target's start. Do not
       * reuse that anchor for the later target-ending control. Keep anchors
       * across dropped targets, as required by classic PARSE semantics. */
      if pre_relative_anchor then relative_anchor = 0
      pre_relative_anchor = 0
      pending_variable = current_text
      capture_start = cursor
    end
    else if pending_variable = "" then do
      pre_count = pre_count + 1
      pre_kind[pre_count] = current_kind
      pre_text[pre_count] = current_text
    end
    else do
      if current_kind = 2 then do
        final_cursor = _finalize_literal(src,source_length,capture_start,pending_variable,current_text,result,cursor,relative_anchor)
        if final_cursor <= source_length + 1 then relative_anchor = final_cursor - length(current_text)
        if next_exists & after_exists & next_kind = 1 & after_kind = 4 then do
          shared_kind = 8
          shared_text = current_text
        end
      end
      else if current_kind = 7 then do
        dynamic_text = _resolve_dynamic_delimiter(splan,current_text,result)
        final_cursor = _finalize_literal(src,source_length,capture_start,pending_variable,dynamic_text,result,cursor,relative_anchor)
        if final_cursor <= source_length + 1 then relative_anchor = final_cursor - length(dynamic_text)
      end
      else if current_kind = 3 | current_kind = 4 | current_kind = 5 then do
        final_cursor = _finalize_numeric(src,source_length,cursor,capture_start,current_kind,current_text,pending_variable,result,relative_anchor)
        relative_anchor = 0
        if current_kind = 3 & next_exists & next_kind = 1 then do
          shared_kind = 3
          shared_text = current_text
        end
      end
      else do
        final_cursor = _finalize_implicit(src,source_length,capture_start,result)
      end
      cursor = final_cursor
      pending_variable = ""
      capture_start = 0
    end

    current_exists = next_exists
    current_kind = next_kind
    current_text = next_text
    next_exists = after_exists
    next_kind = after_kind
    next_text = after_text
    if current_exists then after_exists = _stream_next_item(splan,plan_position,after_kind,after_text)
    else after_exists = 0
  end

  if pending_variable <> "" then do
    if pending_variable = "." then result[result[0] + 1] = ""
    else if capture_start > source_length then result[result[0] + 1] = ""
    else result[result[0] + 1] = _stream_tail(src,capture_start,source_length)
  end
  return result

_resolve_dynamic_delimiter: procedure = .string
  arg plan = .string, name = .string, expose result = .string[]
  plan_position = 0
  target_index = 0
  kind = .int
  text = .string
  exists = .boolean

  exists = _stream_next_item(plan,plan_position,kind,text)
  do while exists
    if kind = 1 then do
      target_index = target_index + 1
      if text = name then do
        if target_index <= result[0] then return result[target_index]
        return ""
      end
    end
    exists = _stream_next_item(plan,plan_position,kind,text)
  end
  return ""

/* Strict streaming decoder. `position` is a zero-based character cursor. */
_stream_next_item: procedure = .boolean
  arg plan = .string, expose position = .int, expose kind = .int, expose text = .string
  plan_length = .int
  number_start = .int
  field_length = .int
  code = .int
  digit = .int
  payload_length = .int

  assembler strlen plan_length,plan
  if position = plan_length then return 0
  if position < 0 | position > plan_length then
    assembler signal "INVALID_ARGUMENTS","PARSEEXEC stream cursor is outside the plan"

  number_start = position
  kind = 0
  do while position < plan_length
    assembler strchar code,plan,position
    if code = 44 then leave
    if code < 48 | code > 57 then
      assembler signal "INVALID_ARGUMENTS","PARSEEXEC item kind must be decimal digits followed by comma"
    digit = code - 48
    kind = kind * 10 + digit
    position = position + 1
  end
  if position = number_start | position >= plan_length then
    assembler signal "INVALID_ARGUMENTS","PARSEEXEC item kind is missing"
  position = position + 1

  number_start = position
  field_length = 0
  do while position < plan_length
    assembler strchar code,plan,position
    if code = 58 then leave
    if code < 48 | code > 57 then
      assembler signal "INVALID_ARGUMENTS","PARSEEXEC field length must be decimal digits followed by colon"
    digit = code - 48
    if field_length > plan_length then
      assembler signal "INVALID_ARGUMENTS","PARSEEXEC field length exceeds the plan"
    field_length = field_length * 10 + digit
    position = position + 1
  end
  if position = number_start | position >= plan_length then
    assembler signal "INVALID_ARGUMENTS","PARSEEXEC field length is missing"
  position = position + 1

  if field_length > plan_length - position then
    assembler signal "INVALID_ARGUMENTS","PARSEEXEC field payload is truncated"
  text = _stream_zero_span(plan,position,field_length)
  position = position + field_length
  if position >= plan_length then
    assembler signal "INVALID_ARGUMENTS","PARSEEXEC item terminator is missing"
  assembler strchar code,plan,position
  if code <> 59 then
    assembler signal "INVALID_ARGUMENTS","PARSEEXEC item must end with semicolon"
  position = position + 1

  if kind < 1 | kind > 7 then
    assembler signal "INVALID_ARGUMENTS","PARSEEXEC item kind must be between 1 and 7"
  assembler strlen payload_length,text
  if kind = 1 & payload_length = 0 then
    assembler signal "INVALID_ARGUMENTS","PARSEEXEC target must be nonempty"
  if kind >= 3 & kind <= 5 then do
    if \_stream_native_digits(text,payload_length) then
      assembler signal "INVALID_ARGUMENTS","PARSEEXEC position payload must be a native nonnegative integer"
  end
  if kind = 6 & text <> "{implicit}" then
    assembler signal "INVALID_ARGUMENTS","PARSEEXEC implicit item payload is invalid"
  if kind = 7 & payload_length = 0 then
    assembler signal "INVALID_ARGUMENTS","PARSEEXEC dynamic delimiter name must be nonempty"
  return 1

_stream_native_digits: procedure = .boolean
  arg source = .string, source_length = .int
  code = .int
  limit_code = .int
  first_nonzero = .int
  significant = .int
  limit_text = .string
  char_index = .int
  constant NATIVE_LIMIT = "9223372036854775807"

  if source_length = 0 then return 0
  first_nonzero = 0
  do index = 0 to source_length - 1
    assembler strchar code,source,index
    if code < 48 | code > 57 then return 0
    if first_nonzero = 0 & code = 48 then iterate
    if first_nonzero = 0 then first_nonzero = index + 1
  end
  if first_nonzero = 0 then return 1
  first_nonzero = first_nonzero - 1
  significant = source_length - first_nonzero
  if significant < 19 then return 1
  if significant > 19 then return 0
  limit_text = NATIVE_LIMIT
  do index = 0 to 18
    char_index = first_nonzero + index
    assembler strchar code,source,char_index
    assembler strchar limit_code,limit_text,index
    if code < limit_code then return 1
    if code > limit_code then return 0
  end
  return 1

_apply_stream_cursor: procedure = .int
  arg src = .string, source_length = .int, cursor = .int, kind = .int, text = .string
  position = .int
  movement = .int
  room = .int
  code = .int
  char_index = .int

  if kind = 2 then do
    if text = "" then return cursor
    position = cursor
    assembler strpos position,text,src
    if position = 0 then return source_length + 1
    return position
  end
  movement = text
  if kind = 3 then do
    if movement < 1 then return 1
    if movement > source_length + 1 then return source_length + 1
    return movement
  end
  if kind = 4 then do
    room = source_length + 1 - cursor
    if movement > room then return source_length + 1
    return cursor + movement
  end
  if kind = 5 then do
    if movement >= cursor then return 1
    return cursor - movement
  end
  if kind = 6 then do
    position = cursor
    do while position <= source_length
      char_index = position - 1
      assembler strchar code,src,char_index
      if code <> 32 then leave
      position = position + 1
    end
    return position
  end
  return cursor

_finalize_literal: procedure = .int
  arg src = .string, source_length = .int, capture_start = .int, pending_variable = .string, literal = .string, expose result = .string[], cursor = .int, expose relative_anchor = .int
  value = .string
  final_cursor = .int
  position = .int
  literal_length = .int

  assembler strlen literal_length,literal
  if literal_length = 0 then do
    value = ""
    final_cursor = cursor
    if pending_variable <> "." then result[result[0] + 1] = value
    return final_cursor
  end
  position = cursor
  assembler strpos position,literal,src
  if position = 0 then do
    value = _stream_tail(src,capture_start,source_length)
    final_cursor = source_length + 1
  end
  else do
    relative_anchor = position
    value = _stream_span(src,capture_start,position - capture_start)
    final_cursor = position + literal_length
  end
  result[result[0] + 1] = value
  return final_cursor

_finalize_numeric: procedure = .int
  arg src = .string, source_length = .int, cursor = .int, capture_start = .int, kind = .int, text = .string, pending_variable = .string, expose result = .string[], relative_anchor = 0
  value = .string
  position = .int
  movement = .int
  room = .int

  movement = text
  if kind = 3 then do
    position = movement
    if position < 1 then position = 1
    if position > source_length + 1 then position = source_length + 1
  end
  else if kind = 4 then do
    if relative_anchor > 0 then do
      cursor = relative_anchor
      relative_anchor = 0
    end
    room = source_length + 1 - cursor
    if movement > room then position = source_length + 1
    else position = cursor + movement
  end
  else do
    if relative_anchor > 0 then do
      cursor = relative_anchor
      relative_anchor = 0
    end
    if movement >= cursor then position = 1
    else position = cursor - movement
  end

  if position <= capture_start then do
    if pending_variable <> "." then do
      if kind = 5 then value = _take_raw_word(src,capture_start,source_length)
      else value = _take_word(src,capture_start,source_length)
      position = capture_start
    end
  end
  else if pending_variable <> "." then value = _stream_span(src,capture_start,position - capture_start)
  result[result[0] + 1] = value
  return position

_finalize_implicit: procedure = .int
  arg src = .string, source_length = .int, capture_start = .int, expose result = .string[]
  value = .string
  first = .int
  after = .int
  char_index = .int
  code = .int

  first = capture_start
  do while first <= source_length
    char_index = first - 1
    assembler strchar code,src,char_index
    if code <> 32 then leave
    first = first + 1
  end
  if first > source_length then do
    value = ""
    after = source_length + 1
  end
  else do
    after = first
    do while after <= source_length
      char_index = after - 1
      assembler strchar code,src,char_index
      if code = 32 then leave
      after = after + 1
    end
    value = _stream_span(src,first,after - first)
    if after <= source_length then after = after + 1
  end
  result[result[0] + 1] = value
  return after

_take_raw_word: procedure = .string
  arg src = .string, field_start = .int, source_length = .int
  first = .int
  word_start = .int
  after = .int
  char_index = .int
  code = .int

  first = field_start
  if first > source_length then return ""
  word_start = first
  do while word_start <= source_length
    char_index = word_start - 1
    assembler strchar code,src,char_index
    if code <> 32 then leave
    word_start = word_start + 1
  end
  if word_start > source_length then return _stream_tail(src,first,source_length)
  after = word_start
  do while after <= source_length
    char_index = after - 1
    assembler strchar code,src,char_index
    if code = 32 then leave
    after = after + 1
  end
  do while after <= source_length
    char_index = after - 1
    assembler strchar code,src,char_index
    if code <> 32 then leave
    after = after + 1
  end
  return _stream_span(src,first,after - first)

_take_word: procedure = .string
  arg src = .string, field_start = .int, source_length = .int
  first = .int
  after = .int
  char_index = .int
  code = .int

  first = field_start
  do while first <= source_length
    char_index = first - 1
    assembler strchar code,src,char_index
    if code <> 32 then leave
    first = first + 1
  end
  if first > source_length then return ""
  after = first
  do while after <= source_length
    char_index = after - 1
    assembler strchar code,src,char_index
    if code = 32 then leave
    after = after + 1
  end
  return _stream_span(src,first,after - first)

_stream_equals_at: procedure = .boolean
  arg source = .string, source_length = .int, start = .int, expected = .string
  expected_length = .int
  source_code = .int
  expected_code = .int
  source_index = .int
  assembler strlen expected_length,expected
  if start < 1 | start + expected_length - 1 > source_length then return 0
  do index = 0 to expected_length - 1
    source_index = start - 1 + index
    assembler strchar source_code,source,source_index
    assembler strchar expected_code,expected,index
    if source_code <> expected_code then return 0
  end
  return 1

_stream_zero_span: procedure = .string
  arg source = .string, start = .int, span_length = .int
  result = ""
  if span_length <= 0 then return result
  assembler substring result,source,start,span_length
  return result

_stream_span: procedure = .string
  arg source = .string, start = .int, span_length = .int
  if span_length <= 0 then return ""
  return _stream_zero_span(source,start - 1,span_length)

_stream_tail: procedure = .string
  arg source = .string, start = .int, source_length = .int
  if start > source_length then return ""
  return _stream_span(source,start,source_length - start + 1)

_parse_log: procedure
  arg text = .string
  say ">DBG " text
  return
