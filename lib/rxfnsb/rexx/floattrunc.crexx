/**
 * Level B binary64 TRUNC implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/floattrunc.md
 */
options levelb comments_dash numeric_classic
namespace rxfnsb expose floattrunc

/**
 * Truncate a finite binary64 value to fixed non-exponent text.
 *
 * @param number finite binary64 value
 * @param fraction optional non-negative number of fractional digits
 * @return fixed, non-exponent numeric text without rounding after extraction
 * @signal CONVERSION_ERROR a supplied value cannot convert to its typed parameter
 * @signal INVALID_ARGUMENTS fraction is negative or number is non-finite
 */
floattrunc: procedure = .string
  numeric digits inherited
  numeric case inherited
  arg number = .float, fraction = 0
  coefficient = .string
  formatted = .string
  digits = ""
  tail = ""
  whole = ""
  fractional = ""
  segment = ""
  padding = ""
  result = ""
  exponent = .int
  coefficient_length = .int
  sign_offset = .int
  point_position = .int
  prefix_length = .int
  tail_length = .int
  digit_length = .int
  decimal_position = .int
  padding_count = .int
  remaining = .int
  start = .int
  copy_length = .int
  zero_character = 48
  point_character = 46
  minus_character = 45
  negative = .boolean

  if fraction < 0 then
    assembler signal "INVALID_ARGUMENTS","FLOATTRUNC fraction must be non-negative"

  assembler fextr coefficient,exponent,number
  if coefficient == "NAN" | coefficient == "nan" | ,
     coefficient == "INF" | coefficient == "inf" | ,
     coefficient == "-INF" | coefficient == "-inf" then
    assembler signal "INVALID_ARGUMENTS","FLOATTRUNC requires a finite number"

  formatted = coefficient || ""
  negative = number < 0.0
  assembler strlen coefficient_length,formatted
  if negative then sign_offset = 1
  else sign_offset = 0

  point_position = -1
  assembler poschar point_position,formatted,point_character
  if point_position < 0 then do
    digit_length = coefficient_length - sign_offset
    start = sign_offset
    assembler substring digits,formatted,start,digit_length
  end
  else do
    prefix_length = point_position - sign_offset
    digit_length = coefficient_length - sign_offset - 1
    if prefix_length > 0 then do
      start = sign_offset
      assembler substring digits,formatted,start,prefix_length
    end
    tail_length = coefficient_length - point_position - 1
    if tail_length > 0 then do
      start = point_position + 1
      assembler substring tail,formatted,start,tail_length
      assembler append digits,tail
    end
  end

  decimal_position = exponent + 1
  if negative then assembler appendchar result,minus_character

  if decimal_position <= 0 then assembler appendchar result,zero_character
  else if decimal_position < digit_length then do
    start = 0
    assembler substring whole,digits,start,decimal_position
    assembler append result,whole
  end
  else do
    assembler append result,digits
    padding_count = decimal_position - digit_length
    if padding_count > 0 then do
      assembler padstr padding,zero_character,padding_count
      assembler append result,padding
    end
  end

  if fraction = 0 then return result
  assembler appendchar result,point_character
  remaining = fraction
  if decimal_position < 0 then do
    padding_count = 0 - decimal_position
    if padding_count > remaining then padding_count = remaining
    if padding_count > 0 then do
      assembler padstr fractional,zero_character,padding_count
      remaining = remaining - padding_count
    end
    start = 0
  end
  else start = decimal_position

  if remaining > 0 & start < digit_length then do
    copy_length = digit_length - start
    if copy_length > remaining then copy_length = remaining
    assembler substring segment,digits,start,copy_length
    assembler append fractional,segment
    remaining = remaining - copy_length
  end
  if remaining > 0 then do
    assembler padstr padding,zero_character,remaining
    assembler append fractional,padding
  end
  assembler append result,fractional
  return result
