/** Remove line or balanced block comments outside quotes. */
options levelb
namespace rxfnsb expose qstripcomment

/**
 * Remove comments by position while preserving all original line endings.
 * An omitted or empty close selects line-comment mode.
 *
 * @param open non-empty comment opener
 * @param close optional block-comment closer
 * @param text source text
 * @return source with comments removed and CRLF, LF, or CR retained
 * @signal INVALID_ARGUMENTS invalid delimiters or malformed quote/pair grammar
 */
qstripcomment: procedure = .string
  arg open = .string, close = '', text = .string
  if close = '' then spans = qscan_line_comment_spans(open,text)
  else spans = qscan_pair_spans(open,close,text,1)

  out = ''
  cursor = 0
  if close = '' then do
    count = .int
    assembler idiv count,spans[0],2
    do index = 1 to count
      base = (index - 1) * 2
      remove_start = spans[base + 1]
      remove_end = spans[base + 2]
      out = out || substr(text,cursor + 1,remove_start - cursor)
      cursor = remove_end
    end
  end
  else do
    count = .int
    assembler idiv count,spans[0],4
    do index = .int(1) to count
      base = .int
      base = (index - 1) * 4
      remove_start = .int
      remove_start = spans[base + 1]
      remove_end = .int
      remove_end = spans[base + 4]
      out = out || substr(text,cursor + 1,remove_start - cursor)
      cursor = remove_end
    end
  end
  out = out || substr(text,cursor + 1)
  return out
