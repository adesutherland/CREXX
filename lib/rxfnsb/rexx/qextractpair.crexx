/** Extract the first balanced, quote-aware delimiter pair. */
options levelb
namespace rxfnsb expose qextractpair

/**
 * Extract the first top-level balanced pair at or after start.
 *
 * @param open non-empty opening delimiter
 * @param close non-empty distinct closing delimiter
 * @param text source text
 * @param start optional positive one-based codepoint position
 * @param mode X or E for contents, I or C to include delimiters
 * @return the selected span, or empty when no opening delimiter is present
 * @signal INVALID_ARGUMENTS invalid arguments or malformed quote/pair grammar
 */
qextractpair: procedure = .string
  arg open = .string, close = .string, text = .string, start = 1, mode = 'X'
  folded_mode = ''
  assembler strupper folded_mode,mode
  folded_mode = left(folded_mode,1)
  if folded_mode = 'E' then folded_mode = 'X'
  if folded_mode = 'C' then folded_mode = 'I'
  if folded_mode <> 'X' & folded_mode <> 'I' then
    assembler signal "INVALID_ARGUMENTS", "QEXTRACTPAIR mode must be X, E, I, or C"

  spans = qscan_pair_spans(open,close,text,start)
  if spans[0] = 0 then return ''
  if folded_mode = 'I' then
    return substr(text,spans[1] + 1,spans[4] - spans[1])
  return substr(text,spans[2] + 1,spans[3] - spans[2])
