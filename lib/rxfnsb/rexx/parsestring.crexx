/**
 * Execute the legacy dynamic PARSE token-array representation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/parsestring.md
 */
options levelb
namespace rxfnsb expose parsestring

/**
 * Execute a validated token plan against a source string.
 *
 * The token arrays are borrowed read-only through `expose`; only the two output
 * arrays are changed. Validation completes before either output is cleared.
 *
 * @param parse_string source text
 * @param tokenhi number of plan items to execute
 * @param token exposed read-only token payloads
 * @param token_type exposed read-only integer token kinds
 * @param variable exposed output variable names
 * @param variable_content exposed output field values
 * @param template optional diagnostic copy of the source template
 * @signal INVALID_ARGUMENTS malformed count, kind, or token payload
 */
parsestring: procedure
  arg parse_string = .string, tokenhi = .int, expose token = .string[], expose token_type = .int[], expose variable = .string[], expose variable_content = .string[], template = "unknown"
  source_length = .int
  pointer = .int
  variable_count = .int
  pending_variable = .int
  pending_start = .int
  new_position = .int
  before_pointer = .int
  final_after_one_blank = .int
  kind = .int
  position = .int
  delimiter_length = .int
  blank_position = .int
  char_index = .int
  code = .int
  movement = .int
  room = .int
  prior_variable = .int
  matched_variable = .int
  delimiter = .string

  call _validate_legacy_plan tokenhi,token,token_type

  /* Validation errors leave caller-owned outputs unchanged. */
  assembler SETATTRS variable,0
  assembler SETATTRS variable_content,0

  assembler strlen source_length,parse_string
  pointer = 1
  variable_count = 0
  pending_variable = 0
  pending_start = 0
  before_pointer = 0
  final_after_one_blank = 0

  do item = 1 to tokenhi
    kind = token_type[item]

    if kind = 1 then do
      variable_count = variable_count + 1
      variable[variable_count] = token[item]
      pending_variable = variable_count
      pending_start = pointer
      iterate
    end

    if kind = 3 | kind = 4 then do
      if before_pointer > 0 then do
        pointer = before_pointer
        pending_start = pointer
        before_pointer = 0
      end

      movement = token[item]
      if kind = 3 then do
        new_position = movement
        if new_position < 1 then new_position = 1
        if new_position > source_length + 1 then new_position = source_length + 1
      end
      else if movement >= 0 then do
        room = source_length + 1 - pointer
        if movement > room then new_position = source_length + 1
        else new_position = pointer + movement
      end
      else do
        if movement <= 0 - pointer then new_position = 1
        else new_position = pointer + movement
      end

      if pending_variable > 0 then do
        if new_position <= pending_start then
          variable_content[pending_variable] = _legacy_tail(parse_string,pending_start,source_length)
        else
          variable_content[pending_variable] = _legacy_span(parse_string,pending_start,new_position - pending_start)
        pending_variable = 0
        pending_start = 0
        before_pointer = 0
      end
      pointer = new_position
      iterate
    end

    if kind = 2 then do
      position = pointer
      if token[item] = "" then position = pointer
      else assembler strpos position,token[item],parse_string

      if token[item] <> "" & position = 0 then do
        if pending_variable > 0 then do
          variable_content[pending_variable] = _legacy_tail(parse_string,pending_start,source_length)
          pending_variable = 0
          pending_start = 0
          before_pointer = 0
        end
        pointer = source_length + 1
      end
      else do
        if pending_variable > 0 then do
          variable_content[pending_variable] = _legacy_span(parse_string,pending_start,position - pending_start)
          pending_variable = 0
          pending_start = 0
          before_pointer = 0
        end
        before_pointer = position
        assembler strlen delimiter_length,token[item]
        pointer = position + delimiter_length
      end
      iterate
    end

    if kind = 5 then do
      do while pointer <= source_length
        char_index = pointer - 1
        assembler strchar code,parse_string,char_index
        if \_legacy_parse_blank(code) then leave
        pointer = pointer + 1
      end
      pending_start = pointer

      blank_position = pointer
      do while blank_position <= source_length
        char_index = blank_position - 1
        assembler strchar code,parse_string,char_index
        if _legacy_parse_blank(code) then leave
        blank_position = blank_position + 1
      end

      if blank_position > source_length then do
        if pending_variable > 0 then do
          variable_content[pending_variable] = _legacy_tail(parse_string,pending_start,source_length)
          pending_variable = 0
          pending_start = 0
        end
        pointer = source_length + 1
      end
      else do
        if pending_variable > 0 then do
          variable_content[pending_variable] = _legacy_span(parse_string,pending_start,blank_position - pending_start)
          pending_variable = 0
          pending_start = 0
          before_pointer = 0
        end
        final_after_one_blank = blank_position + 1
        pointer = blank_position
        do while pointer <= source_length
          char_index = pointer - 1
          assembler strchar code,parse_string,char_index
          if \_legacy_parse_blank(code) then leave
          pointer = pointer + 1
        end
      end
      iterate
    end

    /* kind 6 searches for a prior variable value, or its literal payload. */
    prior_variable = 0
    matched_variable = 0
    do prior_item = 1 to item - 1
      if token_type[prior_item] <> 1 then iterate
      prior_variable = prior_variable + 1
      if token[prior_item] = token[item] then do
        matched_variable = prior_variable
        leave
      end
    end
    if matched_variable > 0 then delimiter = variable_content[matched_variable]
    else delimiter = token[item]

    position = pointer
    if delimiter = "" then position = pointer
    else assembler strpos position,delimiter,parse_string
    if delimiter <> "" & position = 0 then do
      if pending_variable > 0 then do
        variable_content[pending_variable] = _legacy_tail(parse_string,pending_start,source_length)
        pending_variable = 0
        pending_start = 0
        before_pointer = 0
      end
      pointer = source_length + 1
    end
    else do
      if pending_variable > 0 then do
        variable_content[pending_variable] = _legacy_span(parse_string,pending_start,position - pending_start)
        pending_variable = 0
        pending_start = 0
        before_pointer = 0
      end
      assembler strlen delimiter_length,delimiter
      pointer = position + delimiter_length
    end
  end

  if pending_variable > 0 then do
    new_position = pointer
    if final_after_one_blank > 0 then new_position = final_after_one_blank
    variable_content[pending_variable] = _legacy_tail(parse_string,new_position,source_length)
  end
  return

_validate_legacy_plan: procedure
  arg tokenhi = .int, expose token = .string[], expose token_type = .int[]
  kind = .int
  payload_length = .int
  code = .int
  last_code = .int
  char_index = .int

  char_index = 0
  if tokenhi < 0 | tokenhi > token[0] | tokenhi > token_type[0] then
    assembler signal "INVALID_ARGUMENTS","PARSESTRING token count exceeds its plan arrays"

  do item = 1 to tokenhi
    kind = token_type[item]
    if kind < 1 | kind > 6 then
      assembler signal "INVALID_ARGUMENTS","PARSESTRING token kind must be between 1 and 6"
    assembler strlen payload_length,token[item]
    if kind = 1 & payload_length = 0 then
      assembler signal "INVALID_ARGUMENTS","PARSESTRING variable token must be nonempty"
    if kind = 3 then do
      if \_legacy_plan_digits(token[item],0,payload_length) | \_legacy_plan_magnitude(token[item],0,payload_length) then
        assembler signal "INVALID_ARGUMENTS","PARSESTRING absolute position is invalid"
    end
    if kind = 4 then do
      if payload_length < 2 then
        assembler signal "INVALID_ARGUMENTS","PARSESTRING relative position is invalid"
      assembler strchar code,token[item],char_index
      if code <> 43 & code <> 45 then
        assembler signal "INVALID_ARGUMENTS","PARSESTRING relative position requires a sign"
      if \_legacy_plan_digits(token[item],1,payload_length - 1) | \_legacy_plan_magnitude(token[item],1,payload_length - 1,code = 45) then
        assembler signal "INVALID_ARGUMENTS","PARSESTRING relative position is invalid"
    end
    if kind = 5 then do
      if payload_length = 0 then
        assembler signal "INVALID_ARGUMENTS","PARSESTRING word separator must be nonempty"
      do index = 0 to payload_length - 1
        assembler strchar code,token[item],index
        if \_legacy_parse_blank(code) then
          assembler signal "INVALID_ARGUMENTS","PARSESTRING word separator contains a nonblank"
      end
    end
    if kind = 6 & payload_length = 0 then
      assembler signal "INVALID_ARGUMENTS","PARSESTRING search token must be nonempty"
  end
  return

_legacy_plan_digits: procedure = .boolean
  arg source = .string, start = .int, segment_length = .int
  code = .int
  if segment_length <= 0 then return 0
  do index = start to start + segment_length - 1
    assembler strchar code,source,index
    if code < 48 | code > 57 then return 0
  end
  return 1

_legacy_plan_magnitude: procedure = .boolean
  arg source = .string, start = .int, segment_length = .int, allow_minimum = 0
  first_nonzero = .int
  significant = .int
  code = .int
  limit_code = .int
  char_index = .int
  limit_text = .string
  constant NATIVE_LIMIT = "9223372036854775807"

  limit_text = NATIVE_LIMIT
  if allow_minimum then limit_text = "9223372036854775808"
  first_nonzero = start
  do while first_nonzero < start + segment_length
    assembler strchar code,source,first_nonzero
    if code <> 48 then leave
    first_nonzero = first_nonzero + 1
  end
  significant = start + segment_length - first_nonzero
  if significant < 19 then return 1
  if significant > 19 then return 0
  do index = 0 to 18
    char_index = first_nonzero + index
    assembler strchar code,source,char_index
    assembler strchar limit_code,limit_text,index
    if code < limit_code then return 1
    if code > limit_code then return 0
  end
  return 1

_legacy_parse_blank: procedure = .boolean
  arg code = .int
  return code = 32 | code = 9 | code = 13 | code = 10 | code = 11 | code = 12 | code = 160

_legacy_span: procedure = .string
  arg source = .string, start = .int, span_length = .int
  result = ""
  offset = .int
  if span_length <= 0 then return result
  offset = start - 1
  assembler substring result,source,offset,span_length
  return result

_legacy_tail: procedure = .string
  arg source = .string, start = .int, source_length = .int
  if start > source_length then return ""
  return _legacy_span(source,start,source_length - start + 1)
