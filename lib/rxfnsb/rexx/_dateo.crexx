/** Format a Julian day number using the extended Level B DATE surface. */
options levelb numeric_classic
namespace _rxsysb expose _dateo

/**
 * Format a supported Julian day number.
 *
 * @param jdn Julian day number for Gregorian year 1 through 9999
 * @param format documented Level B DATE output format or abbreviation
 * @param osep optional one-codepoint separator override
 * @return formatted date; numeric results are strings
 * @signal INVALID_ARGUMENTS invalid JDN, format, or separator
 */
_dateo: procedure = .string
  arg jdn = .int, format = .string, osep = ""
  format_code = .int
  separator_length = .int
  year = .int
  month = .int
  day = .int
  day_of_year = .int
  weekday = .int
  base_day = .int
  century_start = .int
  century_day = .int
  separator = .string
  year_text = .string
  short_year = .string
  month_text = .string
  day_text = .string

  format_code = _dateformat(format,1)
  assembler strlen separator_length,osep
  if format_code = 0 | separator_length > 1 then call _dateo_fail
  call _datefromjdn jdn,year,month,day,day_of_year,weekday,base_day

  select
    when format_code = 15 then return _date_signed_text(base_day)
    when format_code = 16 then return _date_signed_text(base_day - 719162)
    when format_code = 17 then return _date_signed_text((base_day - 719162) * 86400)
    when format_code = 18 then return _date_signed_text(jdn)
    when format_code = 14 then return _date_digits(year,4) || _date_digits(day_of_year,3)
    when format_code = 19 then return _date_digits(day_of_year,3)
    when format_code = 20 then return _date_weekday_name(weekday)
    when format_code = 21 then return _date_month_name(month)
    when format_code = 22 then do
      century_start = year % 100 * 100
      if century_start = 0 then century_start = 1
      century_day = jdn - _jdn(1,1,century_start) + 1
      return _date_signed_text(century_day)
    end
    when format_code = 1 then
      return _date_digits(day,0) || " " || _date_month_abbreviation(month) || " " || _date_digits(year,4)
    when format_code = 2 then
      return _date_digits(day,2) || " " || _date_month_name(month) || " " || _date_digits(year,4)
    when format_code = 3 then
      return _date_digits(year,4) || _date_digits(month,2) || _date_digits(day,2)
    when format_code = 13 then
      return _date_weekday_name(weekday) || ", " || _date_month_name(month) || " " || _date_digits(day,2) || ", " || _date_digits(year,4)
    otherwise nop
  end

  year_text = _date_digits(year,4)
  short_year = _date_digits(year // 100,2)
  month_text = _date_digits(month,2)
  day_text = _date_digits(day,2)

  select
    when format_code = 4 then do
      separator = _date_output_separator(osep,"/")
      return short_year || separator || month_text || separator || day_text
    end
    when format_code = 5 then do
      separator = _date_output_separator(osep,"/")
      return year_text || separator || month_text || separator || day_text
    end
    when format_code = 6 then do
      separator = _date_output_separator(osep,"/")
      return day_text || separator || month_text || separator || short_year
    end
    when format_code = 7 then do
      separator = _date_output_separator(osep,"/")
      return day_text || separator || month_text || separator || year_text
    end
    when format_code = 8 then do
      separator = _date_output_separator(osep,".")
      return day_text || separator || month_text || separator || short_year
    end
    when format_code = 9 then do
      separator = _date_output_separator(osep,".")
      return day_text || separator || month_text || separator || year_text
    end
    when format_code = 10 then do
      separator = _date_output_separator(osep,"/")
      return month_text || separator || day_text || separator || short_year
    end
    when format_code = 11 then do
      separator = _date_output_separator(osep,"/")
      return month_text || separator || day_text || separator || year_text
    end
    when format_code = 12 then do
      separator = _date_output_separator(osep,"-")
      return year_text || separator || month_text || separator || day_text
    end
    when format_code = 23 then do
      separator = _date_output_separator(osep,"-")
      return day_text || separator || month_text || separator || short_year
    end
    when format_code = 24 then do
      separator = _date_output_separator(osep,"-")
      return day_text || separator || month_text || separator || year_text
    end
    when format_code = 25 then do
      separator = osep
      return year_text || separator || month_text || separator || day_text
    end
    otherwise call _dateo_fail
  end
  return ""

_date_digits: procedure = .string
  arg value = .int, width = .int
  divisor = .int
  digit = .int
  codepoint = .int
  result = .string
  divisor = 1
  if width > 0 then do index = 2 to width
    divisor = divisor * 10
  end
  else do while value % divisor >= 10
    divisor = divisor * 10
  end
  do while divisor > 0
    digit = value % divisor
    codepoint = digit + 48
    assembler appendchar result,codepoint
    value = value // divisor
    divisor = divisor % 10
  end
  return result

_date_signed_text: procedure = .string
  arg value = .int
  result = .string
  minus = .int
  if value < 0 then do
    minus = 45
    assembler appendchar result,minus
    value = 0 - value
  end
  return result || _date_digits(value,0)

_date_output_separator: procedure = .string
  arg override = .string, default_separator = .string
  if override = "" then return default_separator
  return override

_date_month_abbreviation: procedure = .string
  arg month = .int
  select
    when month = 1 then return "Jan"
    when month = 2 then return "Feb"
    when month = 3 then return "Mar"
    when month = 4 then return "Apr"
    when month = 5 then return "May"
    when month = 6 then return "Jun"
    when month = 7 then return "Jul"
    when month = 8 then return "Aug"
    when month = 9 then return "Sep"
    when month = 10 then return "Oct"
    when month = 11 then return "Nov"
    otherwise return "Dec"
  end
  return ""

_date_month_name: procedure = .string
  arg month = .int
  select
    when month = 1 then return "January"
    when month = 2 then return "February"
    when month = 3 then return "March"
    when month = 4 then return "April"
    when month = 5 then return "May"
    when month = 6 then return "June"
    when month = 7 then return "July"
    when month = 8 then return "August"
    when month = 9 then return "September"
    when month = 10 then return "October"
    when month = 11 then return "November"
    otherwise return "December"
  end
  return ""

_date_weekday_name: procedure = .string
  arg weekday = .int
  select
    when weekday = 1 then return "Monday"
    when weekday = 2 then return "Tuesday"
    when weekday = 3 then return "Wednesday"
    when weekday = 4 then return "Thursday"
    when weekday = 5 then return "Friday"
    when weekday = 6 then return "Saturday"
    otherwise return "Sunday"
  end
  return ""

_dateo_fail: procedure
  assembler signal "INVALID_ARGUMENTS","DATE output format or separator is invalid"
  return
