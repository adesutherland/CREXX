 options levelb

 namespace rxfnsb expose afterword

/**
 * Return the source text following a whitespace-delimited word.
 *
 * Unlike SUBWORD(), AFTERWORD() preserves the original text following
 * the selected word, including whitespace.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/afterword.md
 */
/**
 * Return everything following a positive one-based word number.
 *
 * The selected word itself is not returned. All characters following
 * the word are returned unchanged, including leading and trailing
 * whitespace.
 *
 * Examples:
 *
 *   afterword("one two   three", 1)  -> " two   three"
 *   afterword("one two   three", 2)  -> "   three"
 *   afterword("one two   three", 3)  -> ""
 *   afterword("one two   ", 2)       -> "   "
 *
 * @param string source text
 * @param wordnum positive one-based word number
 * @return source text following the selected word, preserving whitespace;
 *         empty string if the word does not exist or nothing follows it
 * @signal INVALID_ARGUMENTS word number is not positive
 */
afterword: procedure = .string
    arg string = .string, wordnum = .int
    if wordnum < 1 then assembler signal "INVALID_ARGUMENTS", "AFTERWORD word number must be positive"
    /* WORDINDEX() returns the character position of the requested word. Zero means that the word does not exist. */
    word_start = wordindex(string, wordnum)
    if word_start = 0 then return ""
    /* WORDINDEX() is one-based, while the VM string instructions use  zero-based offsets.  */
    word_start = word_start - 1
    word_end = .int
    /* Locate the first whitespace character following the word.
     * Starting the returned substring at WORD_END preserves all
     * whitespace following the selected word.
     */
    assembler fndblnk word_end,string,word_start
    /* The selected word reaches the end of the string. */
    if word_end < 0 then return ""
    string_length = .int
    assembler strlen string_length,string
    result = ""
    result_length = string_length - word_end
    assembler substring result,string,word_end,result_length
return result