options levelb numeric_classic

namespace rxfnsb expose time
import _rxsysb

/**
 * Return local/UTC clock, elapsed, timezone, or process-clock information.
 *
 * @param option optional case-insensitive Level B time format
 * @return the requested value as text
 * @signal INVALID_ARGUMENTS option is unsupported
 */
time: procedure = .string
  arg option = ""
  normalized = ""
  today_microseconds = 0
  day_microseconds = 86400000000

  if option == "" then normalized = "N"
  else assembler strupper normalized,option

  if normalized = "ZD" then do
    assembler xtime today_microseconds,"Z"
    return today_microseconds
  end
  if normalized = "T" then do
    assembler xtime today_microseconds,"T"
    return today_microseconds
  end
  if normalized = "TS" then do
    assembler xtime today_microseconds,"C"
    return today_microseconds
  end
  if normalized = "ZN" then do
    result = ""
    assembler xtime result,"N"
    return result
  end

  valid = 0
  if normalized = "N" | normalized = "L" | normalized = "H" then valid = 1
  if normalized = "M" | normalized = "S" | normalized = "US" then valid = 1
  if normalized = "E" | normalized = "R" | normalized = "C" then valid = 1
  if normalized = "UTC" then valid = 1
  if valid = 0 then
    assembler signal "INVALID_ARGUMENTS", "TIME option is not supported"

  if normalized = "UTC" then do
    assembler xtime today_microseconds,"U"
    if today_microseconds < 0 then today_microseconds = today_microseconds + day_microseconds
    if today_microseconds >= day_microseconds then today_microseconds = today_microseconds - day_microseconds
    normalized = "N"
  end
  else assembler mtime today_microseconds

  /* Keep the benchmark/timestamp path free of formatting work. */
  if normalized = "US" then return today_microseconds

  if normalized = "E" | normalized = "R" then do
    elapsed_microseconds = _elapsed(today_microseconds)
    if elapsed_microseconds < 0 then
      elapsed_microseconds = elapsed_microseconds + day_microseconds
    if normalized = "R" then ignored = _elapsed(0)
    elapsed_seconds = 0.0
    elapsed_seconds = elapsed_microseconds
    return elapsed_seconds / 1000000
  end

  microseconds = today_microseconds // 1000000
  seconds_today = today_microseconds % 1000000
  hour = seconds_today % 3600
  remainder = seconds_today // 3600
  minute = remainder % 60
  second = remainder // 60

  if normalized = "H" then return hour
  if normalized = "M" then return hour * 60 + minute
  if normalized = "S" then return seconds_today

  result = ""
  if normalized = "C" then do
    civil_hour = hour
    suffix = 97
    if civil_hour = 0 then civil_hour = 12
    else if civil_hour >= 12 then do
      suffix = 112
      if civil_hour > 12 then civil_hour = civil_hour - 12
    end
    codepoint = 48 + civil_hour % 10
    assembler appendchar result,codepoint
    codepoint = 48 + civil_hour // 10
    assembler appendchar result,codepoint
    codepoint = 58
    assembler appendchar result,codepoint
    codepoint = 48 + minute % 10
    assembler appendchar result,codepoint
    codepoint = 48 + minute // 10
    assembler appendchar result,codepoint
    assembler appendchar result,suffix
    codepoint = 109
    assembler appendchar result,codepoint
    return result
  end

  codepoint = 48 + hour % 10
  assembler appendchar result,codepoint
  codepoint = 48 + hour // 10
  assembler appendchar result,codepoint
  codepoint = 58
  assembler appendchar result,codepoint
  codepoint = 48 + minute % 10
  assembler appendchar result,codepoint
  codepoint = 48 + minute // 10
  assembler appendchar result,codepoint
  codepoint = 58
  assembler appendchar result,codepoint
  codepoint = 48 + second % 10
  assembler appendchar result,codepoint
  codepoint = 48 + second // 10
  assembler appendchar result,codepoint
  if normalized = "N" then return result

  codepoint = 46
  assembler appendchar result,codepoint
  divisor = 100000
  do 6
    digit = microseconds % divisor
    microseconds = microseconds // divisor
    codepoint = 48 + digit
    assembler appendchar result,codepoint
    divisor = divisor % 10
  end
  return result


