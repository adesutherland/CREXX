/**
 * Positional string replacement without padding.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/splice.md
 */
options levelb
namespace rxfnsb expose splice

/**
 * Remove a character span and insert replacement text at the same position.
 *
 * @param needle replacement text
 * @param haystack original text
 * @param at positive 1-based insertion/removal position
 * @param remove_length non-negative number of characters to remove
 * @return spliced string without padding
 * @signal INVALID_ARGUMENTS invalid position or removal length
 */
splice: procedure = .string
  arg needle = .string, haystack = .string, at = .int, remove_length = .int
  haystack_length = .int
  prefix_length = .int
  available = .int
  removed = .int
  suffix_start = .int
  suffix_length = .int
  cursor = 0
  result = ""

  if at < 1 then
    assembler signal "INVALID_ARGUMENTS", "SPLICE position must be positive"
  if remove_length < 0 then
    assembler signal "INVALID_ARGUMENTS", "SPLICE removal length must be non-negative"
  if needle == "" & remove_length = 0 then return haystack

  assembler strlen haystack_length,haystack
  if at > haystack_length + 1 then at = haystack_length + 1
  prefix_length = at - 1
  available = haystack_length - prefix_length
  removed = remove_length
  if removed > available then removed = available
  suffix_start = prefix_length + removed
  suffix_length = haystack_length - suffix_start

  if prefix_length = 0 & suffix_length = 0 then return needle
  if prefix_length = haystack_length then do
    result = haystack
    assembler append result,needle
    return result
  end

  if prefix_length > 0 then do
    assembler setstrpos haystack,cursor
    assembler substring result,haystack,prefix_length
  end
  if needle <> "" then assembler append result,needle
  if suffix_length > 0 then do
    suffix = ""
    assembler setstrpos haystack,suffix_start
    assembler substring suffix,haystack,suffix_length
    assembler append result,suffix
  end
  return result
