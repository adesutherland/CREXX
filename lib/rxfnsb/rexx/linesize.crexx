options levelb

namespace rxfnsb expose linesize

/**
 * Return the implementation line-size limit.
 *
 * The portable Level B implementation uses the traditional effectively
 * unlimited value 999999999. A platform may replace this module when it has a
 * smaller native line limit.
 *
 * @return the maximum line size
 */
linesize: procedure = .int
  return 999999999
