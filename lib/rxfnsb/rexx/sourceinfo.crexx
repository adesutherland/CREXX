/*
 * cREXX Level B runtime function.
 */
options levelb

namespace rxfnsb expose sourceinfo

/**
 * Return the root program's system, invocation mode, and source file.
 *
 * @return three space-separated source context fields
 */
sourceinfo: procedure = .string
  address_object = 0
  meta_array = 0
  meta_entry = ""
  source_file = ""
  candidate_file = ""
  module = 0
  source_address = 0

  /* Use the existing caller-address and source-step metadata facilities. */
  assembler metaloadcalleraddr address_object
  assembler linkattr1 module,address_object,1
  assembler linkattr1 source_address,address_object,2

  do a = source_address to 0 by -1
    assembler metaloaddata meta_array,module,a
    do i = 1 to meta_array
      assembler linkattr1 meta_entry,meta_array,i
      if meta_entry = ".meta_source_step" then do
        assembler linkattr1 candidate_file,meta_entry,4
        /* Certified exit fragments carry synthetic source metadata. */
        if candidate_file <> "exit_fragment" then do
          source_file = candidate_file
          return word(version(), 1) || " COMMAND " || source_file
        end
      end
    end
  end

  return word(version(), 1) || " COMMAND "
