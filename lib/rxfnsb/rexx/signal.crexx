/**
 * Level B signal condition, handler-action, and VM transport objects.
 *
 * @docType runtime-module
 * @see lib/rxfnsb/rexx/signal.md
 */
options levelb

namespace rxfnsb expose signal standard_signal runtime_signal runtime_signal_raw signalaction standard_signalaction signalrelay

/** Public condition contract used by Level B signal handlers. */
signal: interface
  *: factory
    arg name = .string, message = ""

  name: method = .string
  code: method = .int
  module: method = .int
  address: method = .int
  message: method = .string
  payload: method = .object
  file: method = .string
  line: method = .int
  column: method = .int
  source: method = .string

/** Message-only condition created through the public `.signal` factory. */
standard_signal: class implements .signal
  _name = .string
  _message = .string
  _payload = .object

  *: match
    arg name = .string, message = ""
    return 2

  *: factory
    arg name = .string, message = ""
    _name = _signal_name(name)
    _message = message
    return

  name: method = .string
    return _name

  code: method = .int
    return _signal_code(_name)

  module: method = .int
    return 0

  address: method = .int
    return 0

  message: method = .string
    return _message

  payload: method = .object
    return _payload

  file: method = .string
    return ""

  line: method = .int
    return 0

  column: method = .int
    return 0

  source: method = .string
    return ""

/**
 * Internal five-slot view over the raw VM interrupt object.
 *
 * Attribute order and register views are part of the VM/library ABI.
 */
runtime_signal_raw: class
  _code = .int with register.1.int
  _module = .int with register.2.int
  _address = .int with register.3.int
  _name = .string with register.4.string
  _message = .string with register.5.string
  _payload = .object with register.5.object

  name: method = .string
    return _name

  code: method = .int
    return _code

  module: method = .int
    return _module

  address: method = .int
    return _address

  message: method = .string
    return _message

  payload: method = .object
    return _payload

/** Public condition wrapper around a raw VM interrupt object. */
runtime_signal: class implements .signal
  _has_raw = .int with register.1.int
  _name = .string with register.2.string
  _message = .string with register.3.string
  _payload = .object with register.4.object
  _raw = .runtime_signal_raw with register.5.object

  *: factory
    arg name = .string, message = ""
    _name = _signal_name(name)
    _message = message
    _has_raw = 0
    return

  set_raw: method = .void
    arg raw = .runtime_signal_raw
    _raw = raw
    _has_raw = 1
    return

  name: method = .string
    if _has_raw = 0 then return _name
    return _raw.name()

  code: method = .int
    if _has_raw = 0 then return _signal_code(_name)
    return _raw.code()

  module: method = .int
    if _has_raw = 0 then return 0
    return _raw.module()

  address: method = .int
    if _has_raw = 0 then return 0
    return _raw.address()

  message: method = .string
    if _has_raw = 0 then return _message
    return _raw.message()

  payload: method = .object
    if _has_raw = 0 then return _payload
    return _raw.payload()

  file: method = .string
    return _signal_metadata_string(module(), address(), ".meta_source_step", 4)

  line: method = .int
    return _signal_metadata_int(module(), address(), ".meta_source_step", 5)

  column: method = .int
    return _signal_metadata_int(module(), address(), ".meta_source_step", 6)

  source: method = .string
    return _signal_metadata_string(module(), address(), ".meta_source_step", 8)

/** Explicit action returned by an action-aware signal handler. */
signalaction: interface
  skip: factory
  fail: factory
  kind: method = .string

/** Standard immutable-by-convention implementation of `.signalaction`. */
standard_signalaction: class implements .signalaction
  _kind = .string

  skip: factory
    _kind = "skip"
    return

  fail: factory
    _kind = "fail"
    return

  kind: method = .string
    return _kind

_signal_name: procedure = .string
  arg name = .string
  return upper(name)

_signal_code: procedure = .int
  arg name = .string
  n = .string
  n = upper(name)
  select n
    when "KILL" then return 1
    when "FAILURE" then return 2
    when "ERROR" then return 3
    when "SYNTAX" then return 3
    when "OVERFLOW_UNDERFLOW" then return 4
    when "DIVISION_BY_ZERO" then return 5
    when "CONVERSION_ERROR" then return 6
    when "INVALID_ARGUMENTS" then return 7
    when "OUT_OF_RANGE" then return 8
    when "UNICODE_ERROR" then return 9
    when "UNKNOWN_INSTRUCTION" then return 10
    when "FUNCTION_NOT_FOUND" then return 11
    when "NOT_IMPLEMENTED" then return 12
    when "INVALID_SIGNAL_CODE" then return 13
    when "REFERENCE_INVALID" then return 14
    when "NOTREADY" then return 15
    when "CHANNEL_ERROR" then return 26
    when "TASK_FAILURE" then return 27
    when "CLASSIC_SYNTAX" then return 28
    when "CLASSIC_CONDITION" then return 29
    when "OBJECT_NOT_INITIALIZED" then return 16
    when "RXBIN_CORRUPTION" then return 17
    when "CANCEL" then return 18
    when "QUIT" then return 19
    when "TERM" then return 20
    when "POSIX_INT" then return 21
    when "POSIX_HUP" then return 22
    when "POSIX_USR1" then return 23
    when "POSIX_USR2" then return 24
    when "POSIX_CHLD" then return 25
    when "OTHER" then return 30
    when "BREAKPOINT" then return 31
    otherwise return 13
  end
  return 13

_signal_metadata_string: procedure = .string
  arg module = .int, address = .int, wanted = .string, attr = .int
  meta_array = 0
  meta_entry = ""
  result = ""

  if module <= 0 then return ""
  if address < 0 then return ""

  do a = address to 0 by -1
    assembler metaloaddata meta_array, module, a
    do i = 1 to meta_array
      assembler linkattr1 meta_entry, meta_array, i
      if meta_entry = wanted then do
        assembler linkattr1 result, meta_entry, attr
        return result
      end
    end
  end

  return ""

_signal_metadata_int: procedure = .int
  arg module = .int, address = .int, wanted = .string, attr = .int
  meta_array = 0
  meta_entry = ""
  result = .int
  result = 0

  if module <= 0 then return 0
  if address < 0 then return 0

  do a = address to 0 by -1
    assembler metaloaddata meta_array, module, a
    do i = 1 to meta_array
      assembler linkattr1 meta_entry, meta_array, i
      if meta_entry = wanted then do
        assembler linkattr1 result, meta_entry, attr
        return result
      end
    end
  end

  return 0

/** Relay one bound VM event after caller-owned cleanup.
 * @param problem Original VM-bound signal; its typed payload and origin survive.
 * @return No value; a caller that skips the relayed event must return.
 * @signal INVALID_ARGUMENTS A user-created signal has no bound runtime origin.
 * SIGNALORIGIN tags are instruction literals; this shared transport covers every
 * maskable canonical tag without converting its payload into message text.
 */
signalrelay: procedure = .void
  arg problem = .signal
  name = problem.name()
  payload = problem.payload()
  select
    when name = "FAILURE" then assembler signalorigin "FAILURE",payload,problem
    when name = "ERROR" then assembler signalorigin "ERROR",payload,problem
    when name = "OVERFLOW_UNDERFLOW" then assembler signalorigin "OVERFLOW_UNDERFLOW",payload,problem
    when name = "DIVISION_BY_ZERO" then assembler signalorigin "DIVISION_BY_ZERO",payload,problem
    when name = "CONVERSION_ERROR" then assembler signalorigin "CONVERSION_ERROR",payload,problem
    when name = "INVALID_ARGUMENTS" then assembler signalorigin "INVALID_ARGUMENTS",payload,problem
    when name = "OUT_OF_RANGE" then assembler signalorigin "OUT_OF_RANGE",payload,problem
    when name = "UNICODE_ERROR" then assembler signalorigin "UNICODE_ERROR",payload,problem
    when name = "UNKNOWN_INSTRUCTION" then assembler signalorigin "UNKNOWN_INSTRUCTION",payload,problem
    when name = "FUNCTION_NOT_FOUND" then assembler signalorigin "FUNCTION_NOT_FOUND",payload,problem
    when name = "NOT_IMPLEMENTED" then assembler signalorigin "NOT_IMPLEMENTED",payload,problem
    when name = "INVALID_SIGNAL_CODE" then assembler signalorigin "INVALID_SIGNAL_CODE",payload,problem
    when name = "REFERENCE_INVALID" then assembler signalorigin "REFERENCE_INVALID",payload,problem
    when name = "NOTREADY" then assembler signalorigin "NOTREADY",payload,problem
    when name = "OBJECT_NOT_INITIALIZED" then assembler signalorigin "OBJECT_NOT_INITIALIZED",payload,problem
    when name = "RXBIN_CORRUPTION" then assembler signalorigin "RXBIN_CORRUPTION",payload,problem
    when name = "CANCEL" then assembler signalorigin "CANCEL",payload,problem
    when name = "QUIT" then assembler signalorigin "QUIT",payload,problem
    when name = "TERM" then assembler signalorigin "TERM",payload,problem
    when name = "POSIX_INT" then assembler signalorigin "POSIX_INT",payload,problem
    when name = "POSIX_HUP" then assembler signalorigin "POSIX_HUP",payload,problem
    when name = "POSIX_USR1" then assembler signalorigin "POSIX_USR1",payload,problem
    when name = "POSIX_USR2" then assembler signalorigin "POSIX_USR2",payload,problem
    when name = "POSIX_CHLD" then assembler signalorigin "POSIX_CHLD",payload,problem
    when name = "CHANNEL_ERROR" then assembler signalorigin "CHANNEL_ERROR",payload,problem
    when name = "TASK_FAILURE" then assembler signalorigin "TASK_FAILURE",payload,problem
    when name = "CLASSIC_SYNTAX" then assembler signalorigin "CLASSIC_SYNTAX",payload,problem
    when name = "CLASSIC_CONDITION" then assembler signalorigin "CLASSIC_CONDITION",payload,problem
    when name = "BREAKPOINT" then assembler signalorigin "BREAKPOINT",payload,problem
    otherwise assembler signalorigin "OTHER",payload,problem
  end
  return
