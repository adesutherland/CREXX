  execute: method = .addressresponse
    arg request = .addressrequest
    env_name = .string
    env_name = _environment_name
    if env_name = "" then env_name = request.get_environment_name()
    return unknown_environment_response(env_name)

  invoke: method = .addressfunctionresponse
    arg request = .addressfunctionrequest
    return unsupported_function_response(_environment_name, request.get_function_name())

nativeaddressenvironment: class implements .addressenvironment .addressinstance .addressfunctionenvironment
  _environment_id = .string
  _environment_name = .string
  _native_handle = .int

  *: match
    arg env_name = .string
    if native_address_runtime_enabled() = 0 then return 0
    return _native_address_match(env_name)

  *: factory
    arg env_name = .string
    _environment_name = normalize_environment_name(env_name)
    _native_handle = _native_address_handle(env_name)
    _environment_id = _native_address_id(env_name)
    if _environment_id = "" then _environment_id = _environment_name
    return

  bind_environment: method = .void
    arg env_name = .string, instance_id = .string
    _environment_name = normalize_environment_name(env_name)
    _environment_id = instance_id
    if _environment_id = "" then _environment_id = _native_address_id(_environment_name)
    if _environment_id = "" then _environment_id = _environment_name
    return

  environment_name: method = .string
    return _environment_name

  environment_id: method = .string
    return _environment_id

  execute: method = .addressresponse
    arg request = .addressrequest
    rc = .int
    response = .addressresponse
    response = .addressresponse(0)
    rc = _native_address_execute(_native_handle, request, response)
    call response.set_rc(rc)
    return response

  invoke: method = .addressfunctionresponse
    arg request = .addressfunctionrequest
    rc = .int
    response = .addressfunctionresponse
    response = .addressfunctionresponse(0, "")
    rc = _native_address_invoke(_native_handle, request, response)
    call response.set_rc(rc)
    return response

/* This is the function that the compiler calls for the ADDRESS instruction */
_address: procedure = .int
  arg env = "", command = "", in = .addressredirect, out = .addressredirect, err = .addressredirect, expose ... = .string

  request = .addressrequest
  response = .addressresponse
  env_name = .string
  set_rc = .int
  update = .addressbinding
  update_kind = .string
  update_internal = .string
  update_alias = .string
  exposed_name = .string
  update_value = .string
  j = .int

  if initialized(in) = 0 then in = .addressredirect.none()
  if initialized(out) = 0 then out = .addressredirect.none()
  if initialized(err) = 0 then err = .addressredirect.none()
  call ensure_address_runtime

  env_name = normalize_environment_name(env)
  if env_name \= "" then do
    set_rc = _set_address_environment(env_name)
    if set_rc \= 0 then return set_rc
    env_name = _current_address_environment()
  end
  else env_name = _current_address_environment()

  request = .addressrequest(env_name, command, in, out, err)

  do i = 1 to arg[0] by 2
    alias = .string
    value = .string

    alias = arg[i]
    value = ""
    j = i + 1
    if j <= arg[0] then value = arg[j]

    call request.add_binding("var", alias, alias, value)
  end

  response = dispatch_address_request(request)

  do update_index = 1 to response.get_updated_binding_count()
    update = response.get_updated_binding(update_index)
    update_kind = normalize_environment_name(update.get_kind())
    if update_kind = "SANDBOX" then do
      update_internal = update.get_internal_name()
      update_alias = update.get_external_alias()
      if update_internal = "" then update_internal = update_alias
      if update_internal = "" then iterate
      update_value = update.get_value()
      call request.set_sandbox_value(update_internal, update_value)
      iterate
    end
    if update_kind \= "VAR" then iterate

    update_internal = update.get_internal_name()
    update_alias = update.get_external_alias()
    if update_alias = "" then update_alias = update_internal
    update_value = update.get_value()

    do i = 1 to arg[0] by 2
      j = i + 1
      if j > arg[0] then iterate

      exposed_name = arg[i]
      if normalize_environment_name(exposed_name) = normalize_environment_name(update_internal) | normalize_environment_name(exposed_name) = normalize_environment_name(update_alias) then do
        call _address_apply_exposed_value(arg[j], update_value)
      end
    end
  end
  return response.get_rc()

/* ADDRESS dispatch with an explicit caller-supplied sandbox object. */
_address_with_sandbox: procedure = .int
  arg env = "", command = "", in = .addressredirect, out = .addressredirect, err = .addressredirect, expose sandbox = .addresssandbox, expose ... = .string

  request = .addressrequest
  response = .addressresponse
  env_name = .string
  set_rc = .int
  update = .addressbinding
  update_kind = .string
  update_internal = .string
  update_alias = .string
  exposed_name = .string
  update_value = .string
  j = .int

  if initialized(in) = 0 then in = .addressredirect.none()
  if initialized(out) = 0 then out = .addressredirect.none()
  if initialized(err) = 0 then err = .addressredirect.none()
  call ensure_address_runtime

  env_name = normalize_environment_name(env)
  if env_name \= "" then do
    set_rc = _set_address_environment(env_name)
    if set_rc \= 0 then return set_rc
    env_name = _current_address_environment()
  end
  else env_name = _current_address_environment()

  request = .addressrequest(env_name, command, in, out, err)
  /* Keep C and Rexx providers on the same caller-supplied sandbox object. */
  assembler linktoattr1 6, request, sandbox

  do i = 1 to arg[0] by 2
    alias = .string
    value = .string

    alias = arg[i]
    value = ""
    j = i + 1
    if j <= arg[0] then value = arg[j]

    call request.add_binding("var", alias, alias, value)
  end

  response = dispatch_address_request(request)

  do update_index = 1 to response.get_updated_binding_count()
    update = response.get_updated_binding(update_index)
    update_kind = normalize_environment_name(update.get_kind())
    if update_kind = "SANDBOX" then do
      update_internal = update.get_internal_name()
      update_alias = update.get_external_alias()
      if update_internal = "" then update_internal = update_alias
      if update_internal = "" then iterate
      update_value = update.get_value()
      call sandbox.set(update_internal, update_value)
      iterate
    end
    if update_kind \= "VAR" then iterate

    update_internal = update.get_internal_name()
    update_alias = update.get_external_alias()
    if update_alias = "" then update_alias = update_internal
    update_value = update.get_value()

    do i = 1 to arg[0] by 2
      j = i + 1
      if j > arg[0] then iterate

      exposed_name = arg[i]
      if normalize_environment_name(exposed_name) = normalize_environment_name(update_internal) | normalize_environment_name(exposed_name) = normalize_environment_name(update_alias) then do
        call _address_apply_exposed_value(arg[j], update_value)
      end
    end
  end
  return response.get_rc()

_address_apply_exposed_value: procedure = .void
  arg expose target = .string, value = .string
  target = value
  return

_address_new_request: procedure = .addressrequest
  arg env = "", command = "", in = .addressredirect, out = .addressredirect, err = .addressredirect

  env_name = .string
  set_rc = .int

  if initialized(in) = 0 then in = .addressredirect.none()
  if initialized(out) = 0 then out = .addressredirect.none()
  if initialized(err) = 0 then err = .addressredirect.none()
  call ensure_address_runtime

  env_name = normalize_environment_name(env)
  if env_name \= "" then do
    set_rc = _set_address_environment(env_name)
    if set_rc \= 0 then return .addressrequest("", command, in, out, err)
    env_name = _current_address_environment()
  end
  else env_name = _current_address_environment()

  return .addressrequest(env_name, command, in, out, err)

_address_dispatch_request: procedure = .addressresponse
  arg request = .addressrequest
  return dispatch_address_request(request)

_address_link_request_sandbox: procedure = .void
  arg request = .addressrequest, expose sandbox = .addresssandbox
  assembler linktoattr1 6, request, sandbox
  return

_address_apply_response_var: procedure = .void
  arg response = .addressresponse, internal_name = .string, expose target = .string

  update = .addressbinding
  update_kind = .string
  update_internal = .string
  update_alias = .string

  do update_index = 1 to response.get_updated_binding_count()
    update = response.get_updated_binding(update_index)
    update_kind = normalize_environment_name(update.get_kind())
    if update_kind \= "VAR" then iterate

    update_internal = update.get_internal_name()
    update_alias = update.get_external_alias()
    if update_alias = "" then update_alias = update_internal

    if normalize_environment_name(internal_name) = normalize_environment_name(update_internal) | normalize_environment_name(internal_name) = normalize_environment_name(update_alias) then do
      target = update.get_value()
    end
  end
  return

_address_apply_response_sandbox: procedure = .void
  arg response = .addressresponse, expose sandbox = .addresssandbox

  update = .addressbinding
  update_kind = .string
  update_internal = .string
  update_alias = .string
  update_value = .string

  do update_index = 1 to response.get_updated_binding_count()
    update = response.get_updated_binding(update_index)
    update_kind = normalize_environment_name(update.get_kind())
    if update_kind \= "SANDBOX" then iterate

    update_internal = update.get_internal_name()
    update_alias = update.get_external_alias()
    if update_internal = "" then update_internal = update_alias
    if update_internal = "" then iterate
    update_value = update.get_value()
    call sandbox.set(update_internal, update_value)
  end
  return

_address_apply_response_stem: procedure = .void
  arg response = .addressresponse, internal_name = .string, stem = .addressstem

  update = .addressbinding
  update_kind = .string
  update_internal = .string
  update_alias = .string
  update_value = .string
  stem_prefix = .string
  update_key = .string

  stem_prefix = normalize_environment_name(internal_name) || "."

  do update_index = 1 to response.get_updated_binding_count()
    update = response.get_updated_binding(update_index)
    update_kind = normalize_environment_name(update.get_kind())
    if update_kind \= "STEM" then iterate

    update_internal = update.get_internal_name()
    update_alias = update.get_external_alias()
    if update_internal = "" then update_internal = update_alias
    if update_internal = "" then iterate

    update_key = ""
    if left(normalize_environment_name(update_internal), length(stem_prefix)) = stem_prefix then do
      update_key = substr(update_internal, length(stem_prefix) + 1)
    end
    else if normalize_environment_name(update_alias) = normalize_environment_name(internal_name) then update_key = update_internal
    else iterate

    update_value = update.get_value()
    call stem.set(update_key, update_value)
  end
  return

_address_apply_response_request_stem: procedure = .void
  arg response = .addressresponse, request = .addressrequest, binding_index = .int, internal_name = .string

  update = .addressbinding
  update_kind = .string
  update_internal = .string
  update_alias = .string
  update_value = .string
  stem_prefix = .string
  update_key = .string

  stem_prefix = normalize_environment_name(internal_name) || "."

  do update_index = 1 to response.get_updated_binding_count()
    update = response.get_updated_binding(update_index)
    update_kind = normalize_environment_name(update.get_kind())
    if update_kind \= "STEM" then iterate

    update_internal = update.get_internal_name()
    update_alias = update.get_external_alias()
    if update_internal = "" then update_internal = update_alias
    if update_internal = "" then iterate

    update_key = ""
    if left(normalize_environment_name(update_internal), length(stem_prefix)) = stem_prefix then do
      update_key = substr(update_internal, length(stem_prefix) + 1)
    end
    else if normalize_environment_name(update_alias) = normalize_environment_name(internal_name) then update_key = update_internal
    else iterate

    update_value = update.get_value()
    call request.set_binding_stem_value(binding_index, update_key, update_value)
  end
  return

_address_environment: procedure = .addressenvironment expose _address_runtime_ready _address_current_name _address_current_index _address_environment_names _address_environment_objects
  arg env_name = ""

  name = .string
  idx = .int
  ensure_rc = .int

  call ensure_address_runtime

  name = normalize_environment_name(env_name)
  if name = "" then name = _current_address_environment()
  if name = _address_current_name then do
    if _address_current_index > 0 & _address_current_index <= _address_environment_names.0 & _address_environment_names[_address_current_index] = name then return _address_environment_objects[_address_current_index] as .addressenvironment

    idx = find_address_environment_index(_address_environment_names, name)
    if idx \= 0 then do
      _address_current_index = idx
      return _address_environment_objects[idx] as .addressenvironment
    end
  end

  ensure_rc = _ensure_address_environment(name)
  if ensure_rc \= 0 then return .unknownaddressenvironment(name)

  idx = find_address_environment_index(_address_environment_names, name)
  if idx = 0 then return .unknownaddressenvironment(name)
  if name = _address_current_name then _address_current_index = idx
  return _address_environment_objects[idx] as .addressenvironment

_address_function: procedure = .addressfunctionresponse expose _address_runtime_ready _address_environment_names _address_environment_objects
  arg env_name = "", function_name = "", arguments = .string[]

  env_obj = .addressenvironment
  fn_env = .addressfunctionenvironment
  idx = .int
  request = .addressfunctionrequest
  request_env = .string
  response = .addressfunctionresponse
  sandbox = .addresssandbox

  call ensure_address_runtime
  request_env = normalize_environment_name(env_name)
  if request_env = "" then request_env = _current_address_environment()
  if _ensure_address_environment(request_env) \= 0 then return unsupported_function_response(request_env, function_name)

  idx = find_address_environment_index(_address_environment_names, request_env)
  if idx = 0 then return unsupported_function_response(request_env, function_name)

  env_obj = _address_environment_objects[idx] as .addressenvironment
  if env_obj is .addressfunctionenvironment then do
    fn_env = env_obj as .addressfunctionenvironment
    sandbox = .standardaddresssandbox()
    request = .addressfunctionrequest(request_env, function_name, arguments, sandbox, "")
    response = fn_env.invoke(request)
    _address_environment_objects[idx] = fn_env as .addressenvironment
    return response
  end

  return unsupported_function_response(request_env, function_name)

_address_call_response: procedure = .addressfunctionresponse
  arg env_name = "", function_name = "", ... = .string

  arguments = .string[]
  do i = 1 to arg[0]
    arguments[i] = arg[i]
  end

  return _address_function(env_name, function_name, arguments)

_address_call: procedure = .string
  arg env_name = "", function_name = "", ... = .string

  arguments = .string[]
  response = .addressfunctionresponse

  do i = 1 to arg[0]
    arguments[i] = arg[i]
  end

  response = _address_function(env_name, function_name, arguments)
  return response.get_result()

addressenv: procedure = .addressenvironment
  arg env_name = ""
  return _address_environment(env_name)

addresscall: procedure = .string
  arg env_name = "", function_name = "", ... = .string

  arguments = .string[]
  response = .addressfunctionresponse

  do i = 1 to arg[0]
    arguments[i] = arg[i]
  end

  response = _address_function(env_name, function_name, arguments)
  return response.get_result()

_new_address_environment: procedure = .addressenvironment
  arg env_name = .string
  return .addressenvironment(require_address_environment_name(env_name, "_new_address_environment"))

bind_address_environment_object: procedure = .void
  arg env_name = .string, env_obj = .addressenvironment, instance_id = ""

  instance = .addressinstance
  bound_id = .string

  if env_obj is .addressinstance then do
    instance = env_obj as .addressinstance
    bound_id = instance_id
    if bound_id = "" then bound_id = instance.environment_id()
    call instance.bind_environment(env_name, bound_id)
  end
  return

_ensure_address_environment: procedure = .int expose _address_runtime_ready _address_environment_names _address_environment_objects
  arg env_name = .string

  name = .string
  idx = .int
  env_obj = .addressenvironment

  call ensure_address_runtime

  name = require_address_environment_name(env_name, "_ensure_address_environment")

  idx = find_address_environment_index(_address_environment_names, name)
  if idx \= 0 then return 0

  env_obj = .addressenvironment(name)
  call bind_address_environment_object(name, env_obj, "")
  idx = _address_environment_names.0 + 1
  _address_environment_names.idx = name
  _address_environment_objects.idx = env_obj
  return 0

_register_address_environment: procedure = .int expose _address_runtime_ready _address_current_name _address_current_index _address_environment_names _address_environment_objects
  arg env_name = .string, env_obj = .addressenvironment

  name = .string
  idx = .int

  call ensure_address_runtime

  name = require_address_environment_name(env_name, "_register_address_environment")

  idx = find_address_environment_index(_address_environment_names, name)
  if idx = 0 then idx = _address_environment_names.0 + 1

  call bind_address_environment_object(name, env_obj, "")
  _address_environment_names.idx = name
  _address_environment_objects.idx = env_obj
  if name = _address_current_name then _address_current_index = idx
  return 0

_set_address_environment: procedure = .int expose _address_runtime_ready _address_current_name _address_environment_names _address_environment_objects
  arg env_name = .string

  name = .string
  idx = .int
  ensure_rc = .int
  call ensure_address_runtime

  name = require_address_environment_name(env_name, "_set_address_environment")

  if name = _address_current_name then return 0

  idx = find_address_environment_index(_address_environment_names, name)
  if idx = 0 then do
    ensure_rc = _ensure_address_environment(name)
    if ensure_rc \= 0 then return ensure_rc
    idx = find_address_environment_index(_address_environment_names, name)
    if idx = 0 then return -3
  end

  _address_current_name = name
  return 0

_current_address_environment: procedure = .string expose _address_runtime_ready _address_current_name _address_environment_names _address_environment_objects
  call ensure_address_runtime
  if _address_current_name = "" then _address_current_name = "CREXX"
  return _address_current_name

_reset_address_environments: procedure = .int expose _address_runtime_ready _address_current_name _address_current_index _address_environment_names _address_environment_objects
  _address_runtime_ready = 0
  _address_current_name = ""
  _address_current_index = 0
  _address_environment_names = .string[]
  _address_environment_objects = .addressenvironment[]
  call ensure_address_runtime
  return 0

_enable_native_address_environment: procedure = .int expose _address_runtime_ready _address_environment_names _address_environment_objects
  idx = .int

  call ensure_address_runtime
  idx = find_address_environment_index(_address_environment_names, "__NATIVE_ADDRESS_PROVIDER__")
  if idx = 0 then do
    idx = _address_environment_names.0 + 1
    _address_environment_names.idx = "__NATIVE_ADDRESS_PROVIDER__"
    _address_environment_objects.idx = .unknownaddressenvironment("__NATIVE_ADDRESS_PROVIDER__")
  end

  return 0

native_address_runtime_enabled: procedure = .int expose _address_runtime_ready _address_environment_names _address_environment_objects
  call ensure_address_runtime
  if find_address_environment_index(_address_environment_names, "__NATIVE_ADDRESS_PROVIDER__") \= 0 then return 1
  return 0

ensure_address_runtime: procedure expose _address_runtime_ready _address_current_name _address_current_index _address_environment_names _address_environment_objects
  if _address_runtime_ready = 1 then return

  _address_environment_names = .string[]
  _address_environment_objects = .addressenvironment[]
  _address_current_name = "CREXX"
  _address_current_index = 0
  _address_runtime_ready = 1

  call _ensure_address_environment("CREXX")
  call _ensure_address_environment("SYSTEM")
  call _ensure_address_environment("COMMAND")
  call _ensure_address_environment("CMD")
  call _ensure_address_environment("SHELL")
  call _ensure_address_environment("PATH")

  _address_current_index = find_address_environment_index(_address_environment_names, "CREXX")

  return

alias_address_environment: procedure = .int expose _address_runtime_ready _address_current_name _address_current_index _address_environment_names _address_environment_objects
  arg alias_name = .string, target_name = .string

  alias = .string
  target = .string
  alias_idx = .int
  target_idx = .int
  ensure_rc = .int

  alias = require_address_environment_name(alias_name, "alias_address_environment alias")
  target = require_address_environment_name(target_name, "alias_address_environment target")

  ensure_rc = _ensure_address_environment(target)
  if ensure_rc \= 0 then return ensure_rc

  target_idx = find_address_environment_index(_address_environment_names, target)
  if target_idx = 0 then return -3

  alias_idx = find_address_environment_index(_address_environment_names, alias)
  if alias_idx = 0 then alias_idx = _address_environment_names.0 + 1

  _address_environment_names.alias_idx = alias
  _address_environment_objects.alias_idx = _address_environment_objects[target_idx] as .addressenvironment
  if alias = _address_current_name then _address_current_index = alias_idx
  return 0

find_address_environment_index: procedure = .int
  arg expose env_names = .string[], env_name = .string

  name = .string
  name = normalize_environment_name(env_name)

  do i = 1 to env_names.0
    if env_names.i = name then return i
  end

  return 0

normalize_sandbox_key: procedure = .string
  arg name = .string
  normalized = .string
  normalized = strip(name)
  normalized = upper(normalized)
  return normalized

find_sandbox_key_index: procedure = .int
  arg expose keys = .string[], present = .int[], key_count = .int, name = .string

  key = .string
  key = normalize_sandbox_key(name)
  if key = "" then return 0

  return find_normalized_sandbox_key_index(keys, present, key_count, key)

find_normalized_sandbox_key_index: procedure = .int
  arg expose keys = .string[], present = .int[], key_count = .int, key = .string

  do i = 1 to key_count
    if present[i] = 1 & keys[i] = key then return i
  end

  return 0

require_address_environment_name: procedure = .string
  arg env_name = .string, operation = .string
  name = .string

  name = normalize_environment_name(env_name)
  if name = "" then do
    call address_invalid_arguments(operation || " requires a non-blank environment name")
    return ""
  end
  return name

address_invalid_arguments: procedure = .void
  arg message = .string
  assembler signal "INVALID_ARGUMENTS",message
  return

dispatch_address_request: procedure = .addressresponse expose _address_runtime_ready _address_environment_names _address_environment_objects
  arg request = .addressrequest

  env_name = .string
  idx = .int
  env_obj = .addressenvironment
  response = .addressresponse

  call ensure_address_runtime

  env_name = normalize_environment_name(request.get_environment_name())
  if env_name = "" then env_name = _current_address_environment()

  idx = find_address_environment_index(_address_environment_names, env_name)
  if idx = 0 then do
    call _ensure_address_environment(env_name)
    idx = find_address_environment_index(_address_environment_names, env_name)
  end
  if idx = 0 then return unknown_environment_response(env_name)

  env_obj = _address_environment_objects[idx] as .addressenvironment
  call rxfnsb.._trace_command_before(env_name, request.get_command())
  response = env_obj.execute(request)
  output_endpoint = request.get_stdout_endpoint()
  error_endpoint = request.get_stderr_endpoint()
  call output_endpoint.finish()
  call error_endpoint.finish()
  call rxfnsb.._trace_command_after(env_name, request.get_command(), response.get_rc(), response.get_condition_name())
  _address_environment_objects[idx] = env_obj
  return response

execute_system_command: procedure = .addressresponse expose _address_runtime_ready _address_environment_names _address_environment_objects
  arg source_request = .addressrequest, command = .string

  request = .addressrequest
  env_obj = .addressenvironment
  idx = .int
  stdin_endpoint = .addressredirect
  stdout_endpoint = .addressredirect
  stderr_endpoint = .addressredirect
  sandbox = .addresssandbox

  stdin_endpoint = source_request.get_stdin_endpoint()
  stdout_endpoint = source_request.get_stdout_endpoint()
  stderr_endpoint = source_request.get_stderr_endpoint()
  request = .addressrequest("SYSTEM", command, stdin_endpoint, stdout_endpoint, stderr_endpoint)
  assembler linkattr1 sandbox, source_request, 6
  assembler linktoattr1 6, request, sandbox

  do i = 1 to source_request.get_binding_count()
    call request.add_binding_plan(source_request.get_binding(i))
  end

  call ensure_address_runtime
  call _ensure_address_environment("SYSTEM")
  idx = find_address_environment_index(_address_environment_names, "SYSTEM")
  if idx = 0 then return unknown_environment_response("SYSTEM")

  env_obj = _address_environment_objects[idx] as .addressenvironment
  return env_obj.execute(request)

_address_execute_system_command: procedure = .addressresponse
  arg source_request = .addressrequest, command = .string
  return execute_system_command(source_request, command)

_address_unknown_command_response: procedure = .addressresponse
  arg env_name = .string, command = .string
  return unknown_command_response(env_name, command)

_address_normalize_environment_name: procedure = .string
  arg env_name = .string
  return normalize_environment_name(env_name)

_address_normalize_command: procedure = .string
  arg command = .string
  return normalize_command(command)

_address_first_chars: procedure = .string
  arg text = .string, count = .int
  return first_chars(text, count)

/* Private RXCV/channel helpers for the foundational ADDRESS library. They
 * deliberately use only the five core RXAS channel instructions. */
_address_channel_error: procedure = .void
  arg operation = .string, status = .int
  message = operation || " status=" || status
  assembler signal "CHANNEL_ERROR",message
  return

_address_cv_node: procedure = .binary
  arg tag = .int, payload = .binary
  result = '000000000000000000000000'x as .binary
  payload_length = 0
  <at..u8>(0) result = tag
  assembler blen payload_length,payload
  <at..int>(4) result = payload_length
  assembler bappend result,payload
  return result

_address_cv_merge_flags: procedure = .int
  arg left_flags = .int, right_flags = .int
  if right_flags = 0 then return left_flags
  if left_flags = 0 then return right_flags
  if left_flags = right_flags then return left_flags
  return 3

_address_cv_flags_at: procedure = .int
  arg bytes = .binary, offset = .int
  tag = <at..u8>(offset) bytes
  if tag = 10 then return 1
  if tag = 11 then return 2
  if tag = 8 then do
    count = <at..int>(offset + 12) bytes
    child = offset + 20
    flags = 0
    do i = 1 to count
      flags = _address_cv_merge_flags(flags, _address_cv_flags_at(bytes, child))
      child = child + 12 + <at..int>(child + 4) bytes
    end
    return flags
  end
  if tag = 9 then do
    schema_length = <at..int>(offset + 12) bytes
    fields = <at..int>(offset + 24 + schema_length) bytes
    child = offset + 32 + schema_length
    flags = 0
    do i = 1 to fields
      name_length = <at..int>(child) bytes
      child = child + 8 + name_length
      flags = _address_cv_merge_flags(flags, _address_cv_flags_at(bytes, child))
      child = child + 12 + <at..int>(child + 4) bytes
    end
    return flags
  end
  return 0

_address_cv_document: procedure = .binary
  arg node = .binary
  result = '52584356010000000000000000000000'x as .binary
  node_length = 0
  <at..u16>(6) result = _address_cv_flags_at(node, 0)
  assembler blen node_length,node
  <at..int>(8) result = 16 + node_length
  assembler bappend result,node
  return result

_address_cv_root_node: procedure = .binary
  arg document = .binary
  result = .binary
  byte_count = <at..int>(20) document + 12
  start = 16
  assembler bslice result,document,start,byte_count
  return result

_address_cv_null: procedure = .binary
  return _address_cv_document(_address_cv_node(0, ''x as .binary))

_address_cv_boolean: procedure = .binary
  arg item = .boolean
  if item then return _address_cv_document(_address_cv_node(2, ''x as .binary))
  return _address_cv_document(_address_cv_node(1, ''x as .binary))

_address_cv_integer: procedure = .binary
  arg item = .int
  payload = '0000000000000000'x as .binary
  <at..int>(0) payload = item
  return _address_cv_document(_address_cv_node(3, payload))

_address_cv_string: procedure = .binary
  arg item = .string
  return _address_cv_document(_address_cv_node(6, item as .binary))

_address_cv_binary: procedure = .binary
  arg item = .binary
  return _address_cv_document(_address_cv_node(7, item))

_address_cv_name_compare: procedure = .int
  arg left = .string, right = .string
  left_bytes = left as .binary
  right_bytes = right as .binary
  left_length = 0
  right_length = 0
  assembler blen left_length,left_bytes
  assembler blen right_length,right_bytes
  common = left_length
  if right_length < common then common = right_length
  do offset = 0 to common - 1
    left_byte = 0
    right_byte = 0
    assembler getbyte left_byte,left_bytes,offset
    assembler getbyte right_byte,right_bytes,offset
    if left_byte < right_byte then return -1
    if left_byte > right_byte then return 1
  end
  if left_length < right_length then return -1
  if left_length > right_length then return 1
  return 0

_address_cv_record: procedure = .binary
  arg schema = .string, names = .string[], values = .binary[]
  sorted_names = .string[]
  sorted_values = .binary[]
  do i = 1 to names[0]
    sorted_names[i] = names[i]
    sorted_values[i] = values[i]
  end
  do i = 2 to sorted_names[0]
    name = sorted_names[i]
    encoded = sorted_values[i]
    j = i - 1
    do while j >= 1
      if _address_cv_name_compare(sorted_names[j], name) <= 0 then leave
      sorted_names[j + 1] = sorted_names[j]
      sorted_values[j + 1] = sorted_values[j]
      j = j - 1
    end
    sorted_names[j + 1] = name
    sorted_values[j + 1] = encoded
  end
  payload = '0000000000000000'x as .binary
  schema_bytes = schema as .binary
  schema_length = 0
  assembler blen schema_length,schema_bytes
  <at..int>(0) payload = schema_length
  assembler bappend payload,schema_bytes
  trailer = '000000000000000000000000'x as .binary
  <at..u32>(0) trailer = 1
  <at..int>(4) trailer = sorted_names[0]
  assembler bappend payload,trailer
  do i = 1 to sorted_names[0]
    name_bytes = sorted_names[i] as .binary
    name_length = 0
    assembler blen name_length,name_bytes
    prefix = '0000000000000000'x as .binary
    <at..int>(0) prefix = name_length
    assembler bappend payload,prefix
    assembler bappend payload,name_bytes
    node = _address_cv_root_node(sorted_values[i])
    assembler bappend payload,node
  end
  return _address_cv_document(_address_cv_node(9, payload))

_address_cv_string_array: procedure = .binary
  arg items = .string[]
  payload = '0000000000000000'x as .binary
  <at..int>(0) payload = items[0]
  do i = 1 to items[0]
    node = _address_cv_root_node(_address_cv_string(items[i]))
    assembler bappend payload,node
  end
  return _address_cv_document(_address_cv_node(8, payload))

_address_cv_field: procedure = .binary
  arg document = .binary, wanted = .string
  schema_length = <at..int>(28) document
  fields = <at..int>(40 + schema_length) document
  offset = 48 + schema_length
  do i = 1 to fields
    name_length = <at..int>(offset) document
    current = <at..string>(offset + 8, name_length) document
    offset = offset + 8 + name_length
    node_length = 12 + <at..int>(offset + 4) document
    if current = wanted then do
      node = .binary
      assembler bslice node,document,offset,node_length
      return _address_cv_document(node)
    end
    offset = offset + node_length
  end
  call _address_channel_error "RXCV missing field " || wanted, 1
  return _address_cv_null()

_address_cv_type: procedure = .int
  arg document = .binary
  return <at..u8>(16) document

_address_cv_as_integer: procedure = .int
  arg document = .binary
  if _address_cv_type(document) <> 3 then do
    call _address_channel_error "RXCV integer type", 2
    return 0
  end
  return <at..int>(28) document

_address_cv_as_boolean: procedure = .boolean
  arg document = .binary
  tag = _address_cv_type(document)
  if tag <> 1 & tag <> 2 then do
    call _address_channel_error "RXCV boolean type", 2
    return 0
  end
  return tag = 2

_address_cv_as_binary: procedure = .binary
  arg document = .binary
  if _address_cv_type(document) <> 7 then do
    call _address_channel_error "RXCV binary type", 2
    empty = .binary
    return empty
  end
  result = .binary
  start = 28
  byte_count = <at..int>(20) document
  assembler bslice result,document,start,byte_count
  return result

_address_chan_open: procedure = .int
  arg provider = .int, capabilities = .int, configuration = .binary
  status = 0
  handle = 0
  assembler chanopen status,handle,provider,capabilities,configuration
  if status <> 0 then call _address_channel_error "chanopen", status
  return handle

_address_chan_start: procedure = .int
  arg handle = .int, envelope = .binary, wait_microseconds = .int
  status = 0
  ticket = 0
  assembler chanstart status,ticket,handle,envelope,wait_microseconds
  if status <> 0 then call _address_channel_error "chanstart", status
  return ticket

_address_chan_wait: procedure = .binary
  arg handle = .int, wait_microseconds = .int
  status = 0
  completion = .binary
  assembler chanwait status,completion,handle,wait_microseconds
  if status = 10 | status = 11 then do
    empty = .binary
    return empty
  end
  if status <> 0 then call _address_channel_error "chanwait", status
  return completion

_address_chan_close: procedure = .void
  arg handle = .int, mode = .int
  status = 0
  assembler chanclose status,handle,mode
  if status <> 0 then call _address_channel_error "chanclose", status
  return

_address_byte_open: procedure = .int
  arg direction = .int, capacity = .int
  names = .string[]
  values = .binary[]
  names[1] = "capacity"
  values[1] = _address_cv_integer(capacity)
  names[2] = "direction"
  values[2] = _address_cv_integer(direction)
  configuration = _address_cv_record("crexx.channel.byte-memory", names, values)
  return _address_chan_open(4, 127, configuration)

_address_byte_reference: procedure = .binary
  arg handle = .int, rights = .int
  names = .string[]
  values = .binary[]
  names[1] = "requestedRights"
  values[1] = _address_cv_integer(rights)
  names[2] = "requestedScope"
  values[2] = _address_cv_integer(1)
  envelope = _address_cv_record("crexx.channel.byte-export-reference", names, values)
  ticket = _address_chan_start(handle, envelope, -1)
  completion = _address_chan_wait(handle, -1)
  state = _address_cv_as_integer(_address_cv_field(completion, "state"))
  if state <> 1 then call _address_channel_error "byte endpoint export", state
  return _address_cv_field(completion, "result")

_address_byte_half_close: procedure = .void
  arg handle = .int, direction = .int
  names = .string[]
  values = .binary[]
  names[1] = "direction"
  values[1] = _address_cv_integer(direction)
  envelope = _address_cv_record("crexx.channel.byte-half-close", names, values)
  ticket = _address_chan_start(handle, envelope, -1)
  completion = _address_chan_wait(handle, -1)
  state = _address_cv_as_integer(_address_cv_field(completion, "state"))
  if state <> 1 then call _address_channel_error "byte endpoint half-close", state
  return

_address_byte_start_write: procedure = .int
  arg handle = .int, bytes = .binary
  names = .string[]
  values = .binary[]
  names[1] = "bytes"
  values[1] = _address_cv_binary(bytes)
  envelope = _address_cv_record("crexx.channel.byte-write", names, values)
  return _address_chan_start(handle, envelope, -1)

_address_byte_start_drain: procedure = .int
  arg handle = .int
  names = .string[]
  values = .binary[]
  names[1] = "maximumBytes"
  values[1] = _address_cv_integer(16777216)
  envelope = _address_cv_record("crexx.channel.byte-drain", names, values)
  return _address_chan_start(handle, envelope, -1)

spawn_request: procedure = .addressresponse
  arg request = .addressrequest, spawn_mode = 0

  response = .addressresponse(0)
  env_names = .string[]
  env_values = .binary[]
  crexx_bindings = .string[]
  environment = .binary
  binding_slot = .int
  command = .string
  stdin_adapter = .addressredirect
  stdout_adapter = .addressredirect
  stderr_adapter = .addressredirect
  stdin_handle = 0
  stdout_handle = 0
  stderr_handle = 0
  child_handle = 0
  stdout_done = 1
  stderr_done = 1

  stdin_adapter = request.get_stdin_endpoint()
  stdout_adapter = request.get_stdout_endpoint()
  stderr_adapter = request.get_stderr_endpoint()

  binding_slot = 0
  do i = 1 to request.get_binding_count()
    binding = .addressbinding
    alias = .string
    kind = .string
    stem_count = .int
    stem_i = .int

    binding = request.get_binding(i)
    kind = normalize_environment_name(binding.get_kind())

    alias = binding.get_external_alias()
    if alias = "" then alias = binding.get_internal_name()

    if kind = "VAR" then do
      env_slot = env_names[0] + 1
      env_names[env_slot] = alias
      env_values[env_slot] = _address_cv_string(binding.get_value())

      binding_slot = binding_slot + 1
      crexx_bindings.binding_slot = "VAR"
      binding_slot = binding_slot + 1
      crexx_bindings.binding_slot = alias
      binding_slot = binding_slot + 1
      crexx_bindings.binding_slot = binding.get_value()
    end
    else if kind = "STEM" then do
      stem_count = binding.get_stem_value("0") as .int
      if stem_count < 0 then do
        call address_invalid_arguments("ADDRESS stem binding count must not be negative")
        stem_count = 0
      end

      binding_slot = binding_slot + 1
      crexx_bindings.binding_slot = "STEM"
      binding_slot = binding_slot + 1
      crexx_bindings.binding_slot = alias
      binding_slot = binding_slot + 1
      crexx_bindings.binding_slot = stem_count || ""

      do stem_i = 1 to stem_count
        binding_slot = binding_slot + 1
        crexx_bindings.binding_slot = binding.get_stem_value(stem_i || "")
      end
    end
  end

  command = request.get_command()

  null_value = _address_cv_null()
  stdin_reference = null_value
  stdout_reference = null_value
  stderr_reference = null_value

  if stdin_adapter.has_input() then do
    input_bytes = stdin_adapter.input_snapshot()
    input_length = 0
    assembler blen input_length,input_bytes
    if input_length > 16777216 then do
      call _address_channel_error "ADDRESS input exceeds RXCV limit", 8
      return response
    end
    input_capacity = input_length
    if input_capacity < 1 then input_capacity = 1
    stdin_handle = _address_byte_open(3, input_capacity)
    stdin_reference = _address_byte_reference(stdin_handle, 1)
    write_ticket = _address_byte_start_write(stdin_handle, input_bytes)
    write_completion = _address_chan_wait(stdin_handle, -1)
    write_state = _address_cv_as_integer(_address_cv_field(write_completion, "state"))
    if write_state <> 1 then call _address_channel_error "ADDRESS stdin snapshot", write_state
    call _address_byte_half_close(stdin_handle, 2)
  end

  if stdout_adapter.captures_output() then do
    stdout_handle = _address_byte_open(3, 65536)
    stdout_reference = _address_byte_reference(stdout_handle, 2)
    stdout_ticket = _address_byte_start_drain(stdout_handle)
    stdout_done = 0
  end

  if stderr_adapter.captures_output() then do
    stderr_handle = _address_byte_open(3, 65536)
    stderr_reference = _address_byte_reference(stderr_handle, 2)
    stderr_ticket = _address_byte_start_drain(stderr_handle)
    stderr_done = 0
  end

  child_config_names = .string[]
  child_config_values = .binary[]
  child_config_names[1] = "capacity"
  child_config_values[1] = _address_cv_integer(1)
  child_configuration = _address_cv_record("crexx.channel.child-process-provider", child_config_names, child_config_values)
  child_handle = _address_chan_open(5, 255, child_configuration)

  if env_names[0] > 0 then environment = _address_cv_record("crexx.channel.environment", env_names, env_values)
  else environment = null_value
  empty_arguments = .string[]
  child_names = .string[]
  child_values = .binary[]
  child_names[1] = "arguments"
  child_values[1] = _address_cv_string_array(empty_arguments)
  child_names[2] = "bindings"
  child_values[2] = _address_cv_string_array(crexx_bindings)
  child_names[3] = "environment"
  child_values[3] = environment
  child_names[4] = "executable"
  child_values[4] = _address_cv_string(command)
  child_names[5] = "mode"
  child_values[5] = _address_cv_integer(spawn_mode)
  child_names[6] = "stderr"
  child_values[6] = stderr_reference
  child_names[7] = "stdin"
  child_values[7] = stdin_reference
  child_names[8] = "stdout"
  child_values[8] = stdout_reference
  child_names[9] = "workingDirectory"
  child_values[9] = null_value
  child_envelope = _address_cv_record("crexx.channel.child-process-start", child_names, child_values)
  child_ticket = _address_chan_start(child_handle, child_envelope, -1)

  child_done = 0
  rc = -3
  do while child_done = 0 | stdout_done = 0 | stderr_done = 0
    if child_done = 0 then do
      child_completion = _address_chan_wait(child_handle, 1000)
      child_completion_length = 0
      assembler blen child_completion_length,child_completion
      if child_completion_length > 0 then do
        child_done = 1
        child_state = _address_cv_as_integer(_address_cv_field(child_completion, "state"))
        if child_state = 1 then rc = _address_cv_as_integer(_address_cv_field(child_completion, "result"))
      end
    end

    if stdout_done = 0 then do
      stream_completion = _address_chan_wait(stdout_handle, 0)
      stream_length = 0
      assembler blen stream_length,stream_completion
      if stream_length > 0 then do
        stream_state = _address_cv_as_integer(_address_cv_field(stream_completion, "state"))
        if stream_state <> 1 then call _address_channel_error "ADDRESS stdout drain", stream_state
        stream_bytes = _address_cv_as_binary(_address_cv_field(stream_completion, "result"))
        call stdout_adapter.append_bytes(stream_bytes)
        stream_details = _address_cv_field(stream_completion, "details")
        stdout_done = _address_cv_as_boolean(_address_cv_field(stream_details, "eof"))
        if stdout_done = 0 then stdout_ticket = _address_byte_start_drain(stdout_handle)
      end
    end

    if stderr_done = 0 then do
      stream_completion = _address_chan_wait(stderr_handle, 0)
      stream_length = 0
      assembler blen stream_length,stream_completion
      if stream_length > 0 then do
        stream_state = _address_cv_as_integer(_address_cv_field(stream_completion, "state"))
        if stream_state <> 1 then call _address_channel_error "ADDRESS stderr drain", stream_state
        call stderr_adapter.append_bytes(_address_cv_as_binary(_address_cv_field(stream_completion, "result")))
        stream_details = _address_cv_field(stream_completion, "details")
        stderr_done = _address_cv_as_boolean(_address_cv_field(stream_details, "eof"))
        if stderr_done = 0 then stderr_ticket = _address_byte_start_drain(stderr_handle)
      end
    end
  end

  call _address_chan_close child_handle,1
  if stdin_handle <> 0 then call _address_chan_close stdin_handle,1
  if stdout_handle <> 0 then call _address_chan_close stdout_handle,1
  if stderr_handle <> 0 then call _address_chan_close stderr_handle,1

  /* Class values are copied at the request/provider boundary. Apply the
     bytes accumulated by this controller-owned copy to its explicit target
     references before returning to the outer dispatcher. */
  call stdout_adapter.finish()
  call stderr_adapter.finish()
  call response.set_rc(rc)
  return response

unknown_environment_response: procedure = .addressresponse
  arg env_name = .string

  response = .addressresponse(0)
  call response.set_rc(-3)
  call response.set_condition_name("FAILURE")
  call response.add_diagnostic("Unknown address environment " || env_name)
  return response

unknown_command_response: procedure = .addressresponse
  arg env_name = .string, command = .string

  response = .addressresponse(0)
  call response.set_rc(-3)
  call response.set_condition_name("FAILURE")
  call response.add_diagnostic("Unknown command for " || env_name || ": " || command)
  return response

unsupported_function_response: procedure = .addressfunctionresponse
  arg env_name = .string, function_name = .string

  response = .addressfunctionresponse(-3, "")
  call response.set_condition_name("FAILURE")
  call response.add_diagnostic("Unknown address function for " || env_name || ": " || function_name)
  return response

normalize_environment_name: procedure = .string
  arg env_name = .string
  normalized = .string
  normalized = strip(env_name)
  normalized = upper(normalized)
  return normalized

normalize_address_lookup_words: procedure = .string
  arg words_text = .string
  normalized = .string
  normalized = strip(words_text)
  normalized = upper(normalized)
  normalized = space(normalized)
  return normalized

normalize_command: procedure = .string
  arg command = .string
  normalized = .string
  normalized = strip(command)
  normalized = space(normalized)
  normalized = upper(normalized)
  return normalized

first_chars: procedure = .string
  arg text = .string, count = .int
  if count <= 0 then return ""
  return substr(text, 1, count)

/* Return an adapter that inherits the normal stream. */
_noredir: procedure = .addressredirect
    return .addressredirect.none()

/* Return a controller-side output-array adapter. */
_redir2array: procedure = .addressredirect
    arg target = reference .string[]
    return .addressredirect.output_array(target)

/* Return a controller-side output-string adapter. */
_redir2string: procedure = .addressredirect
    arg target = reference .string
    return .addressredirect.output_string(target)

/* Snapshot array input before asynchronous I/O begins. */
_array2redir: procedure = .addressredirect
    arg source = .string[]
    return .addressredirect.input_array(source)

/* Snapshot string input before asynchronous I/O begins. */
_string2redir: procedure = .addressredirect
    arg source = .string
    return .addressredirect.input_string(source)
