/**
 * Typed Level B DATATYPE classifier.
 *
 * Level B deliberately uses an ASCII character catalog over codepoint-safe
 * string traversal. Option D is the cREXX digits extension; the separate
 * Classic Level C BIF has the standard ABLMNSUWX catalog.
 *
 * @param value string to classify without mutation
 * @param type optional first-character classification option
 * @return NUM/CHAR when type is omitted, otherwise "1" or "0"
 * @signal INVALID_ARGUMENTS for an empty or unsupported explicit option
 */
options levelb numeric_classic

namespace rxfnsb expose datatype

datatype: procedure = .string
  arg value = .string, type = ""

  if \?type then do
    if _datatype_number(value,0) then return "NUM"
    return "CHAR"
  end

  type_length = .int
  option = .int
  option_index = 0
  assembler strlen type_length,type
  if type_length = 0 then
    assembler signal "INVALID_ARGUMENTS", "DATATYPE option must not be empty"
  assembler strchar option,type,option_index
  if option >= 97 & option <= 122 then option = option - 32
  if option <> 65 & option <> 66 & option <> 68 & option <> 76 &,
     option <> 77 & option <> 78 & option <> 83 & option <> 85 &,
     option <> 87 & option <> 88 then
    assembler signal "INVALID_ARGUMENTS", "DATATYPE option must be A, B, D, L, M, N, S, U, W, or X"

  select
    when option = 65 then result = _datatype_ascii_class(value,"A")
    when option = 66 then result = _datatype_grouped(value,4,1)
    when option = 68 then result = _datatype_ascii_class(value,"D")
    when option = 76 then result = _datatype_ascii_class(value,"L")
    when option = 77 then result = _datatype_ascii_class(value,"M")
    when option = 78 then result = _datatype_number(value,0)
    when option = 83 then result = _datatype_symbol(value)
    when option = 85 then result = _datatype_ascii_class(value,"U")
    when option = 87 then result = _datatype_number(value,1)
    otherwise result = _datatype_grouped(value,2,0)
  end
  if result then return "1"
  return "0"

/** Scan an ASCII-only Level B character class without allocating slices. */
_datatype_ascii_class: procedure = .boolean
  arg value = .string, mode = .string
  value_length = .int
  codepoint = .int
  assembler strlen value_length,value
  if value_length = 0 then return 0

  do index = 0 to value_length - 1
    assembler strchar codepoint,value,index
    is_digit = codepoint >= 48 & codepoint <= 57
    is_upper = codepoint >= 65 & codepoint <= 90
    is_lower = codepoint >= 97 & codepoint <= 122
    select
      when mode = "A" then valid = is_digit | is_upper | is_lower
      when mode = "D" then valid = is_digit
      when mode = "L" then valid = is_lower
      when mode = "M" then valid = is_upper | is_lower
      otherwise valid = is_upper
    end
    if \valid then return 0
  end
  return 1

/** Validate Classic-style right-grouped binary or hexadecimal text. */
_datatype_grouped: procedure = .boolean
  arg value = .string, group_size = .int, binary_only = .boolean
  value_length = .int
  codepoint = .int
  remainder = .int
  assembler strlen value_length,value
  if value_length = 0 then return 1
  first_index = 0
  assembler strchar codepoint,value,first_index
  if codepoint = 32 then return 0
  last = value_length - 1
  assembler strchar codepoint,value,last
  if codepoint = 32 then return 0

  digit_count = 0
  do index = value_length - 1 to 0 by -1
    assembler strchar codepoint,value,index
    if codepoint = 32 then do
      assembler imod remainder,digit_count,group_size
      if remainder <> 0 then return 0
      iterate
    end
    if codepoint >= 48 & codepoint <= 57 then do
      if binary_only & codepoint > 49 then return 0
    end
    else if binary_only then return 0
    else if \((codepoint >= 65 & codepoint <= 70) |,
              (codepoint >= 97 & codepoint <= 102)) then return 0
    digit_count = digit_count + 1
  end
  return 1

/** Test the Level B non-numeric symbol spelling used by option S. */
_datatype_symbol: procedure = .boolean
  arg value = .string
  value_length = .int
  codepoint = .int
  assembler strlen value_length,value
  if value_length = 0 then return 0
  first_index = 0
  assembler strchar codepoint,value,first_index
  if \((codepoint >= 65 & codepoint <= 90) |,
       (codepoint >= 97 & codepoint <= 122) |,
       codepoint = 33 | codepoint = 63 | codepoint = 95 |,
       codepoint = 64 | codepoint = 35 | codepoint = 36) then return 0

  do index = 1 to value_length - 1
    assembler strchar codepoint,value,index
    if (codepoint >= 65 & codepoint <= 90) |,
       (codepoint >= 97 & codepoint <= 122) |,
       (codepoint >= 48 & codepoint <= 57) |,
       codepoint = 33 | codepoint = 63 | codepoint = 95 |,
       codepoint = 64 | codepoint = 35 | codepoint = 36 |,
       codepoint = 46 then iterate
    return 0
  end
  return 1

/**
 * Parse a number exactly and optionally require an integral mathematical value.
 * No float conversion, tolerance, or exponentiation is used.
 */
_datatype_number: procedure = .boolean
  arg value = .string, whole_required = .boolean
  text = strip(value)
  text_length = .int
  codepoint = .int
  assembler strlen text_length,text
  if text_length = 0 then return 0

  index = 0
  assembler strchar codepoint,text,index
  if codepoint = 43 | codepoint = 45 then do
    index = index + 1
    do while index < text_length
      assembler strchar codepoint,text,index
      if codepoint <> 32 then leave
      index = index + 1
    end
    if index >= text_length then return 0
  end

  digit_count = 0
  fractional_digits = 0
  last_nonzero_digit = 0
  saw_point = 0
  do while index < text_length
    assembler strchar codepoint,text,index
    if codepoint >= 48 & codepoint <= 57 then do
      digit_count = digit_count + 1
      if saw_point then fractional_digits = fractional_digits + 1
      if codepoint <> 48 then last_nonzero_digit = digit_count
      index = index + 1
      iterate
    end
    if codepoint = 46 & \saw_point then do
      saw_point = 1
      index = index + 1
      iterate
    end
    leave
  end
  if digit_count = 0 then return 0

  exponent = 0
  exponent_negative = 0
  if index < text_length then do
    assembler strchar codepoint,text,index
    if codepoint <> 69 & codepoint <> 101 then return 0
    index = index + 1
    if index >= text_length then return 0
    assembler strchar codepoint,text,index
    if codepoint = 43 | codepoint = 45 then do
      exponent_negative = codepoint = 45
      index = index + 1
    end
    exponent_start = index
    exponent_cap = text_length + 1
    do while index < text_length
      assembler strchar codepoint,text,index
      if codepoint < 48 | codepoint > 57 then return 0
      if exponent <= exponent_cap then exponent = exponent * 10 + codepoint - 48
      if exponent > exponent_cap then exponent = exponent_cap
      index = index + 1
    end
    if index = exponent_start then return 0
  end

  if \whole_required then return 1
  if last_nonzero_digit = 0 then return 1
  if exponent_negative then exponent = 0 - exponent
  decimal_position = digit_count - fractional_digits + exponent
  if decimal_position <= 0 then return 0
  if decimal_position >= digit_count then return 1
  return last_nonzero_digit <= decimal_position
