/**
 * Level B STRIP implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/strip.md
 */
options levelb
namespace rxfnsb expose strip

/**
 * Remove leading, trailing, or both runs of a character class.
 *
 * @param string source text
 * @param option optional L, T, or B selector; only its first codepoint matters
 * @param char optional single codepoint; omission selects all Unicode whitespace
 * @return requested slice of the source
 */
strip: procedure = .string
  arg string = .string, option = "B", char = " "
  char_supplied = ?char
  option_length = .int
  option_character = .int
  normalized_option = ""
  char_length = .int
  trim_character = .int
  current_character = .int
  string_length = .int
  start = 0
  end_position = .int
  search = .int
  last = .int
  index = .int
  slice_length = .int
  result = ""

  assembler strlen option_length,option
  if option_length = 0 then
    assembler signal "INVALID_ARGUMENTS","STRIP option must start with L, T, or B"
  assembler strupper normalized_option,option
  assembler strchar option_character,normalized_option,start
  if option_character <> 76 & option_character <> 84 & option_character <> 66 then
    assembler signal "INVALID_ARGUMENTS","STRIP option must start with L, T, or B"

  if char_supplied then do
    assembler strlen char_length,char
    if char_length <> 1 then
      assembler signal "INVALID_ARGUMENTS","STRIP char must contain exactly one character"
    assembler strchar trim_character,char,start
  end

  assembler strlen string_length,string
  end_position = string_length
  if string_length = 0 then return result

  if \char_supplied then do
    if option_character = 76 | option_character = 66 then do
      search = 0
      assembler fndnblnk start,string,search
      if start < 0 then return result
    end
    if option_character = 84 | option_character = 66 then do
      search = 0 - string_length
      assembler fndnblnk last,string,search
      if last < 0 then return result
      end_position = last + 1
    end
  end
  else do
    if option_character = 76 | option_character = 66 then do while start < end_position
      assembler strchar current_character,string,start
      if current_character <> trim_character then leave
      start = start + 1
    end
    if option_character = 84 | option_character = 66 then do while end_position > start
      index = end_position - 1
      assembler strchar current_character,string,index
      if current_character <> trim_character then leave
      end_position = end_position - 1
    end
  end

  if start = 0 & end_position = string_length then return string
  slice_length = end_position - start
  if slice_length <= 0 then return result
  assembler substring result,string,start,slice_length
  return result
