/**
 * Level B REVERSE implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/reverse.md
 */
options levelb
namespace rxfnsb expose reverse

/**
 * Reverse the Unicode codepoint sequence in a string.
 *
 * @param string source text
 * @return source codepoints in reverse order
 */
reverse: procedure = .string
  arg string = .string
  string_length = .int
  index = .int
  codepoint = .int
  result = ""

  assembler strlen string_length,string
  index = string_length - 1
  do while index >= 0
    assembler strchar codepoint,string,index
    assembler appendchar result,codepoint
    index = index - 1
  end
  return result
