/**
 * In-place string-array clear.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/arraydrop.md
 */
options levelb

namespace rxfnsb expose arraydrop

/**
 * Clear every logical element from a string array.
 *
 * @param array exposed string array using array[0] as its high-water mark
 * @return zero, the new high-water mark
 */
arraydrop: procedure=.int
  arg expose array=.string[]
  assembler SETATTRS array,0
return 0
