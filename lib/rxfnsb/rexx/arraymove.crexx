/**
 * In-place string-array block move.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/arraymove.md
 */
options levelb

namespace rxfnsb expose arraymove

/**
 * Move a block within one string array.
 *
 * @param array exposed string array using array[0] as its high-water mark
 * @param from positive first source index
 * @param count non-negative maximum number of values to move
 * @param tto positive insertion position in the original array
 * @return the unchanged array high-water mark
 * @signal INVALID_ARGUMENTS invalid source, count, or destination
 */
arraymove: procedure=.int
  arg expose array=.string[], from=.int, count=.int, tto=.int

  hi = array[0]
  if from < 1 then
    assembler signal "INVALID_ARGUMENTS", "ARRAYMOVE source position must be positive"
  if count < 0 then
    assembler signal "INVALID_ARGUMENTS", "ARRAYMOVE count must be non-negative"
  if tto < 1 then
    assembler signal "INVALID_ARGUMENTS", "ARRAYMOVE destination position must be positive"
  if count = 0 | hi < 1 | from > hi then return hi

  available = hi - from + 1
  if count > available then count = available
  if tto > hi + 1 then tto = hi + 1
  if tto >= from & tto - from <= count then return hi

  assembler INSATTRS1 array,tto,count
  if tto < from then source_start = from + count
  else source_start = from

  source_index = source_start
  target_index = tto
  source_value = ""
  target_value = ""
  do count
    assembler linkattr1 source_value,array,source_index
    assembler linkattr1 target_value,array,target_index
    assembler scopy target_value,source_value
    assembler unlink source_value
    assembler unlink target_value
    assembler inc source_index
    assembler inc target_index
  end

  assembler DELATTRS1 array,source_start,count
  return array[0]
