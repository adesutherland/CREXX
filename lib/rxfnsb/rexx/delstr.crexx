/**
 * Level B DELSTR implementation.
 *
 * @docType runtime-function
 * @see lib/rxfnsb/rexx/delstr.md
 */
options levelb
namespace rxfnsb expose delstr

/**
 * Delete a character range from a string.
 *
 * @param string source text
 * @param start positive 1-based start position
 * @param delete_length optional non-negative character count
 * @return source text with the selected range removed
 */
delstr: procedure = .string
  arg string = .string, start = .int, delete_length = 0
  length_supplied = ?delete_length
  string_length = .int
  prefix_length = .int
  available = .int
  tail_start = .int
  tail_length = .int
  cursor = 0
  tail = ""
  result = ""

  if start < 1 then
    assembler signal "INVALID_ARGUMENTS","DELSTR start must be positive"
  if length_supplied & delete_length < 0 then
    assembler signal "INVALID_ARGUMENTS","DELSTR length must be non-negative"

  assembler strlen string_length,string
  if start > string_length then return string
  if length_supplied & delete_length = 0 then return string

  prefix_length = start - 1
  available = string_length - prefix_length
  if \length_supplied then delete_length = available
  if delete_length >= available then do
    if prefix_length = 0 then return ""
    assembler substring result,string,cursor,prefix_length
    return result
  end

  if prefix_length > 0 then do
    assembler substring result,string,cursor,prefix_length
  end
  tail_start = prefix_length + delete_length
  tail_length = string_length - tail_start
  assembler substring tail,string,tail_start,tail_length
  assembler append result,tail
  return result
