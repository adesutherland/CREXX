/* Focused Level B OBJECTARRAYMOVE tests. */
options levelb
import rxfnsb

errors = 0
errors = errors + test_move("backward", "ABCDE", 3, 2, 1, "C|D|A|B|E")
errors = errors + test_move("forward", "ABCDE", 2, 2, 5, "A|D|B|C|E")
errors = errors + test_move("prepend", "ABCDE", 4, 2, 1, "D|E|A|B|C")
errors = errors + test_move("append", "ABCDE", 1, 2, 6, "C|D|E|A|B")
errors = errors + test_move("destination clamp", "ABCDE", 2, 1, 999, "A|C|D|E|B")
errors = errors + test_move("count clamp", "ABCDE", 4, 999999999, 1, "D|E|A|B|C")
errors = errors + test_move("inside block no-op", "ABCDE", 2, 2, 3, "A|B|C|D|E")
errors = errors + test_move("after block no-op", "ABCDE", 2, 2, 4, "A|B|C|D|E")
errors = errors + test_move("zero count no-op", "ABCDE", 2, 0, 1, "A|B|C|D|E")
errors = errors + test_move("source above high no-op", "ABCDE", 6, 1, 1, "A|B|C|D|E")
errors = errors + test_empty()
errors = errors + test_invalid_from()
errors = errors + test_invalid_count()
errors = errors + test_invalid_to()

if errors = 0 then say "PASS: objectarraymove"
return errors <> 0

test_move: procedure = .int
  arg label = .string, data = .string, from = .int, count = .int, tto = .int, expected = .string
  array = load(data)
  before_hi = array[0]
  rc = objectarraymove(array, from, count, tto)
  actual = join(array)
  if rc = before_hi & array[0] = before_hi & actual == expected then return 0
  say "FAIL: OBJECTARRAYMOVE" label "expected" before_hi expected "got" rc actual
  return 1

test_empty: procedure = .int
  array = .object[]
  rc = objectarraymove(array, 1, 1, 1)
  if rc = 0 & array[0] = 0 then return 0
  say "FAIL: OBJECTARRAYMOVE empty array"
  return 1

test_invalid_from: procedure = .int
  array = load("AB")
  do
    ignored = objectarraymove(array, 0, 1, 1)
  on signal invalid_arguments
    return 0
  end
  say "FAIL: OBJECTARRAYMOVE invalid source did not signal"
  return 1

test_invalid_count: procedure = .int
  array = load("AB")
  do
    ignored = objectarraymove(array, 1, -1, 1)
  on signal invalid_arguments
    return 0
  end
  say "FAIL: OBJECTARRAYMOVE invalid count did not signal"
  return 1

test_invalid_to: procedure = .int
  array = load("AB")
  do
    ignored = objectarraymove(array, 1, 1, 0)
  on signal invalid_arguments
    return 0
  end
  say "FAIL: OBJECTARRAYMOVE invalid destination did not signal"
  return 1

load: procedure = .object[]
  arg data = .string
  array = .object[]
  data_length = .int
  codepoint = .int
  assembler strlen data_length,data
  do index = 0 to data_length - 1
    name = ""
    assembler strchar codepoint,data,index
    assembler appendchar name,codepoint
    array[index + 1] = .box(name) as .object
  end
  return array

join: procedure = .string
  arg array = .object[]
  result = ""
  do i = 1 to array[0]
    if i > 1 then result = result || "|"
    item = array[i] as .box
    result = result || item.name()
  end
  return result

box: class
  name_ = .string

  *: factory
    arg name = .string
    name_ = name
    return

  name: method = .string
    return name_
