/* rexx */
options levelb
import rxfnsb

errors = 0

a = 10
aa = 10.5
b = "hello"
blank = " "
empty = ""
d = a + 1
d = d + 0
dd = aa + 1
e = b "there"
e = e || ""
blank = blank || ""
empty = empty || ""

errors = errors + check(value("a") = "10", "integer register")
errors = errors + check(value("A") = "10", "case-insensitive name")
errors = errors + check(value("aa") = "10.5", "exact longer name")
errors = errors + check(value("b") = "hello", "string register")
errors = errors + check(value("c") = "C", "constant metadata")
errors = errors + check(value("d") = "11", "calculated integer")
errors = errors + check(value("dd") = "11.5", "calculated float")
errors = errors + check(value("e") = "hello there", "calculated string")
errors = errors + check(value("f") = "F", "not-yet-visible variable")
errors = errors + check(value("g") = "G", "not-yet-visible expression")
errors = errors + check(c2x(value("blank")) = "20", "blank value")
errors = errors + check(length(value("empty")) = 0, "empty value")
errors = errors + check(value("") = "", "empty name")
errors = errors + check(value("missing") = "MISSING", "missing name")
errors = errors + check(boundary_probe() = "OUTER_ONLY", "procedure boundary")

/* These enter scope only after the calls above. */
f = 99
g = f + 1
g = g + 1
outer_only = "must not leak into boundary_probe"

if errors = 0 then say "PASS: value"
return errors <> 0

boundary_probe: procedure = .string
  local_value = "local"
  local_value = local_value || ""
  return value("outer_only")

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: VALUE" label
  return 1
