/* Focused Level B TRUNC tests. */
options levelb comments_dash numeric_classic
import rxfnsb

arg test_args = .string[]
errors = 0
source = "127.09782"

errors = errors + check("12", trunc(12.3), "default fraction")
errors = errors + check("127.097", trunc(source, 3), "truncate without rounding")
errors = errors + check("127.100", trunc(127.1, 3), "pad fractional zeros")
errors = errors + check("-1234", trunc(-1234.5678), "negative integer result")
errors = errors + check("0", trunc(.5678), "leading decimal integer result")
errors = errors + check("0.0012", trunc(.00127, 4), "small positive value")
errors = errors + check("-0.0012", trunc(-.00127, 4), "small negative value")
errors = errors + check("4.5678000", trunc(4.5678, 7), "fraction extension")
errors = errors + check("100", trunc("1E2"), "positive exponent")
errors = errors + check("120.00", trunc("12E1", 2), "exponent with fraction")
errors = errors + check("0.000000000001", trunc("1E-12", 12), "negative exponent")
errors = errors + check("100000000000000000000", trunc("1E20"), "large fixed result")
errors = errors + check("0.00", trunc("-0", 2), "negative zero")
errors = errors + check("9007199254740993", trunc("9007199254740993"), "decimal precision")
errors = errors + check(source, source, "argument is not mutated")

caught = 0
do
  ignored = trunc(1.25, -1)
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check("1", caught || "", "negative fraction uses signal")

invalid = "not-a-number"
if test_args[0] = 1 then invalid = test_args[1]
caught = 0
do
  ignored = .string
  ignored = trunc(invalid)
on signal conversion_error
  caught = caught + 1
end
errors = errors + check("1", caught || "", "invalid dynamic decimal uses signal")

if errors = 0 then say "PASS: trunc"
return errors <> 0

check: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if actual = expected then return 0
  say "FAIL: TRUNC" label "expected" expected "got" actual
  return 1
