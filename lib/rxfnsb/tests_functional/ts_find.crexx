/* rexx */
options levelb
import rxfnsb

errors = 0
errors = errors + check(3, find("the", "Now is the time"), "argument order")
errors = errors + check(2, find("is the", "Now is the time"), "phrase")
errors = errors + check(6, find("be", "To be or not to be", 3), "start")
errors = errors + check(0, find("The", "Now is the time"), "case-sensitive")
errors = errors + check(0, find("jum", "the quick jumps"), "no word prefix")
errors = errors + check(2, find("β γ", "α β　γ δ"), "Unicode blanks")
errors = errors + check(0, find("", "one two"), "empty phrase")

needle = "is the"
haystack = "Now is the time"
ignored = find(needle, haystack)
errors = errors + check_string("is the", needle, "needle unchanged")
errors = errors + check_string("Now is the time", haystack, "haystack unchanged")

caught = 0
do
  ignored = find("one", "one two", 0)
on signal invalid_arguments
  caught = 1
end
errors = errors + check(1, caught, "invalid start signals")

if errors = 0 then say "PASS: find"
return errors <> 0

check: procedure = .int
  arg expected = .int, actual = .int, label = .string
  if expected = actual then return 0
  say "FAIL: FIND" label "expected" expected "got" actual
  return 1

check_string: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if expected == actual then return 0
  say "FAIL: FIND" label "values differ"
  return 1
