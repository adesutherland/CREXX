/* Focused Level B FORMAT tests. */
options levelb comments_dash numeric_classic
import rxfnsb

errors = test_scientific() + test_engineering()

caught = 0
do
  ignored = format(123, 2)
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check("1", caught || "", "before fit uses signal")

caught = 0
do
  ignored = format("1E20", 1, 1, 1, 1)
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check("1", caught || "", "exponent fit uses signal")

if errors = 0 then say "PASS: format"
return errors <> 0

test_scientific: procedure = .int
  numeric digits 18
  numeric form scientific
  errors = 0
  source = "12.73" as .decimal
  errors = errors + check("12.73", format(source), "one argument")
  errors = errors + check("  12.7300", format(source, 4, 4), "before and after")
  errors = errors + check("   2", format(1.73, 4, 0), "round to integer")
  errors = errors + check("   1.8", format(1.75, 4, 1), "round half up")
  errors = errors + check("  -0.8", format(-.76, 4, 1), "negative small value")
  errors = errors + check("0", format(-.4, , 0), "rounded negative zero")
  errors = errors + check("1.234573E+04", format(12345.73, , , 2, 2), "exponent width")
  errors = errors + check("1.235E+4", format(12345.73, , 3, , 0), "forced exponent")
  errors = errors + check("1.235", format(1.234573, , 3, , 0), "zero exponent omitted")
  errors = errors + check("1.235    ", format(1.2345, , 3, 2, 0), "zero exponent field")
  errors = errors + check("1E+20", format("1E20", , , 2), "digits default exponent trigger")
  errors = errors + check("12345.73", format(12345.73, , , 0, 1), "zero exponent width suppresses exponent")
  errors = errors + check("100.00", format(99.999, , 2, , 2), "rounding grows integer")
  errors = errors + check("1.0000    ", format(.99999, , 4, 2, 2), "rounding removes exponent")
  errors = errors + check(source as .string, source as .string, "argument is not mutated")
  return errors

test_engineering: procedure = .int
  numeric digits 18
  numeric form engineering
  errors = 0
  errors = errors + check("12.345E+003", format(12345, , 3, 3, 0), "engineering exponent")
  errors = errors + check("  12.345E+003", format(12345, 5, 3, 3, 0), "engineering before width")
  return errors

check: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if actual = expected then return 0
  say "FAIL: FORMAT" label "expected [" || expected || "] got [" || actual || "]"
  return 1
