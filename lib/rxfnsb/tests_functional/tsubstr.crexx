/* Focused Level B SUBSTR tests. */
options levelb
import rxfnsb

errors = 0
source = "René日🙂"

errors = errors + check(substr("abc", 2) = "bc", "documented omitted length")
errors = errors + check(substr("abc", 2, 4) = "bc  ", "documented default padding")
errors = errors + check(substr("abc", 5, 4) = "    ", "documented padding beyond end")
errors = errors + check(substr("abc", 2, 6, ".") = "bc....", "documented custom padding")
errors = errors + check(substr("abc", 5, 6, ".") = "......", "custom padding only")
errors = errors + check(substr("abc", 2, 0) = "", "zero length")
errors = errors + check(substr("abc", 5) = "", "omitted length beyond end")
errors = errors + check(substr("abc", 2,, ".") = "bc", "omitted length with pad")
errors = errors + check(substr("abcdefgh", 1, 8) = "abcdefgh", "whole string")
errors = errors + check(substr(source, 2, 3) = "ené", "Unicode slice")
errors = errors + check(substr("12345678", 5, 6, "é") = "5678éé", "Unicode padding")
embedded_nul = "a" || d2c(0) || "bc"
errors = errors + check(substr(embedded_nul, 2, 2) = d2c(0) || "b", "slice across embedded U+0000")
errors = errors + check(source = "René日🙂", "source is not mutated")

large_source = ""
x = "x"
do i = 1 to 1000
  assembler append large_source,x
end
large_expected = ""
do i = 1 to 500
  assembler append large_expected,x
end
dot = "."
do i = 1 to 250
  assembler append large_expected,dot
end
errors = errors + check(substr(large_source, 501, 750, ".") = large_expected, "substantial slice and pad")

caught = 0
do
  ignored = substr("abc", 0)
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = substr("abc", 1, -1)
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = substr("", 1, 0, "")
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = substr("abc", 1, 1, "xy")
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(caught = 4, "start, length, and pad failures use signals")

if errors = 0 then say "PASS: substr"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: SUBSTR" label
  return 1
