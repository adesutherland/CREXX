/* Focused Level B STRIP tests. */
options levelb
import rxfnsb

errors = 0
source = "  ab c  "

errors = errors + check(strip(source) = "ab c", "documented both")
errors = errors + check(strip(source, "Leading") = "ab c  ", "option first character")
errors = errors + check(strip(source, "t") = "  ab c", "lowercase trailing")
errors = errors + check(strip("12.7000",, "0") = "12.7", "custom trailing character")
errors = errors + check(strip("0012.7000",, "0") = "12.7", "custom both")
errors = errors + check(strip(" foo bar ", "B", "*") = " foo bar ", "absent custom character")
errors = errors + check(strip(" foo bar",, "r") = " foo ba", "omitted option with char")
errors = errors + check(strip("　ab c　") = "ab c", "default Unicode whitespace")
errors = errors + check(strip(" x　",, " ") = "x　", "explicit blank only")
errors = errors + check(strip("🙂🙂x🙂", "B", "🙂") = "x", "Unicode custom character")
errors = errors + check(strip("　　") = "", "all whitespace")
errors = errors + check(strip("....",, ".") = "", "all custom characters")
errors = errors + check(strip("") = "", "empty string")
errors = errors + check(source = "  ab c  ", "source is not mutated")

edge = ""
dot = "."
do i = 1 to 1000
  assembler append edge,dot
end
large = ""
center = "center"
assembler append large,edge
assembler append large,center
assembler append large,edge
errors = errors + check(strip(large,, ".") = center, "substantial input")

caught = 0
do
  ignored = strip("", "")
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = .string
  ignored = strip("", "X")
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = .string
  ignored = strip("",, "")
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = .string
  ignored = strip("x",, "xy")
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(caught = 4, "option and char failures use signals")

if errors = 0 then say "PASS: strip"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: STRIP" label
  return 1
