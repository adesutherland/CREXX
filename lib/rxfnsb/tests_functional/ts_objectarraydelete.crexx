/* Focused Level B OBJECTARRAYDELETE tests. */
options levelb
import rxfnsb

errors = 0
errors = errors + test_delete("middle", "ABCDE", 2, 2, 3, "A|D|E")
errors = errors + test_delete("first", "ABC", 1, 1, 2, "B|C")
errors = errors + test_delete("last", "ABC", 3, 1, 2, "A|B")
errors = errors + test_delete("whole", "ABC", 1, 3, 0, "")
errors = errors + test_delete("tail clamp", "ABCD", 3, 999999999, 2, "A|B")
errors = errors + test_delete("above high no-op", "AB", 3, 1, 2, "A|B")
errors = errors + test_delete("zero count no-op", "AB", 1, 0, 2, "A|B")
errors = errors + test_empty()
errors = errors + test_invalid_from()
errors = errors + test_invalid_count()

if errors = 0 then say "PASS: objectarraydelete"
return errors <> 0

test_delete: procedure = .int
  arg label = .string, data = .string, from = .int, count = .int, expected_rc = .int, expected = .string
  array = load(data)
  rc = objectarraydelete(array, from, count)
  actual = join(array)
  if rc = expected_rc & actual == expected then return 0
  say "FAIL: OBJECTARRAYDELETE" label "expected" expected_rc expected "got" rc actual
  return 1

test_empty: procedure = .int
  array = .object[]
  rc = objectarraydelete(array, 1, 1)
  if rc = 0 & array[0] = 0 then return 0
  say "FAIL: OBJECTARRAYDELETE empty array"
  return 1

test_invalid_from: procedure = .int
  array = load("AB")
  do
    ignored = objectarraydelete(array, 0, 1)
  on signal invalid_arguments
    return 0
  end
  say "FAIL: OBJECTARRAYDELETE invalid position did not signal"
  return 1

test_invalid_count: procedure = .int
  array = load("AB")
  do
    ignored = objectarraydelete(array, 1, -1)
  on signal invalid_arguments
    return 0
  end
  say "FAIL: OBJECTARRAYDELETE invalid count did not signal"
  return 1

load: procedure = .object[]
  arg data = .string
  array = .object[]
  data_length = .int
  codepoint = .int
  assembler strlen data_length,data
  do index = 0 to data_length - 1
    name = ""
    assembler strchar codepoint,data,index
    assembler appendchar name,codepoint
    array[index + 1] = .box(name) as .object
  end
  return array

join: procedure = .string
  arg array = .object[]
  result = ""
  do i = 1 to array[0]
    if i > 1 then result = result || "|"
    item = array[i] as .box
    result = result || item.name()
  end
  return result

box: class
  name_ = .string

  *: factory
    arg name = .string
    name_ = name
    return

  name: method = .string
    return name_
