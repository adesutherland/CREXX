/* Focused Level B CENTER tests; CENTRE has a separate selector row. */
options levelb
import rxfnsb

errors = 0
source = "ABC"

errors = errors + check(center(source, 7) = "  ABC  ", "balanced padding")
errors = errors + check(center(source, 8, "-") = "--ABC---", "odd padding goes right")
errors = errors + check(center("The blue sky", 8) = "e blue s", "even truncation")
errors = errors + check(center("The blue sky", 7) = "e blue ", "odd truncation goes right")
errors = errors + check(center("****", 7, "-") = "-****--", "odd width padding")
errors = errors + check(center("*****", 8, "-") = "-*****--", "odd difference padding")
errors = errors + check(center("12345678", 4, "-") = "3456", "even central slice")
errors = errors + check(center("12345678", 5, "-") = "23456", "odd central slice")
errors = errors + check(center("same", 4) = "same", "unchanged width")
errors = errors + check(center("anything", 0) = "", "zero width")
errors = errors + check(center("", 3, ".") = "...", "empty source")
errors = errors + check(center("é", 3, "·") = "·é·", "Unicode source and pad")
errors = errors + check(source = "ABC", "source is not exposed or mutated")

caught = 0
do
  ignored = center("abc", -1)
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = center("abc", 5, "")
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = center("abc", 5, "xy")
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(caught = 3, "width and pad failures use signals")

if errors = 0 then say "PASS: center"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: CENTER" label
  return 1
