/* Focused Level B RIGHT tests. */
options levelb
import rxfnsb

errors = 0
source = "foobar"

errors = errors + check(right("abc  d", 8) = "  abc  d", "documented blank padding")
errors = errors + check(right("abc def", 5) = "c def", "documented truncation")
errors = errors + check(right("12", 5, "0") = "00012", "documented zero padding")
errors = errors + check(right("", 4) = "    ", "empty source padding")
errors = errors + check(right(source, 0) = "", "zero width")
errors = errors + check(right(source, 3) = "bar", "rightmost slice")
errors = errors + check(right(source, 6) = source, "equal width")
errors = errors + check(right(source, 8, "*") = "**foobar", "padded width")
errors = errors + check(right("aé日", 2) = "é日", "Unicode truncation")
errors = errors + check(right("é", 3, "·") = "··é", "Unicode padding")
errors = errors + check(source = "foobar", "source is not mutated")

wide = right("x", 1000, ".")
wide_length = .int
assembler strlen wide_length,wide
errors = errors + check(wide_length = 1000, "substantial direct padding")

caught = 0
do
  ignored = right("abc", -1)
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = .string
  ignored = right("abc", 3, "")
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = .string
  ignored = right("abc", 3, "xy")
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(caught = 3, "width and pad failures use signals")

if errors = 0 then say "PASS: right"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: RIGHT" label
  return 1
