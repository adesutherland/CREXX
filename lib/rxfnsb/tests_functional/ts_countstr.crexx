/* Focused Level B COUNTSTR tests. */
options levelb
import rxfnsb

errors = 0
needle = "bc"
haystack = "abcabcabc"

errors = errors + check(countstr(needle, haystack) = 3, "three matches")
errors = errors + check(countstr("aa", "aaaa") = 2, "non-overlapping matches")
errors = errors + check(countstr("aa", "aaaaa") = 2, "trailing partial match")
errors = errors + check(countstr("", "a a") = 0, "empty needle")
errors = errors + check(countstr("", "") = 0, "both empty")
errors = errors + check(countstr("a", "") = 0, "empty haystack")
errors = errors + check(countstr("abcdefg", "abcdef") = 0, "oversized needle")
errors = errors + check(countstr("missing", "abcdef") = 0, "absent needle")
errors = errors + check(countstr("abc", "abcdef") = 1, "match at start")
errors = errors + check(countstr("abc", "defabc") = 1, "match at end")
errors = errors + check(countstr("é", "café été") = 3, "Unicode matches")
errors = errors + check(countstr("ab", copies("ab", 1000)) = 1000, "substantial repeated input")
errors = errors + check(needle = "bc" & haystack = "abcabcabc", "arguments are not mutated")

if errors = 0 then say "PASS: countstr"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: COUNTSTR" label
  return 1
