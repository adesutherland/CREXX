/* Boundary and error coverage for the extended Level B DATE BIF. */
options levelb
import rxfnsb

errors = 0
errors = errors + expect("00010101",date("ST","0","B"),"minimum date")
errors = errors + expect("99991231",date("ST","3652058","B"),"maximum date")
errors = errors + expect("20000229",date("ST","29/02/00","E"),"deterministic two-digit leap year")
errors = errors + expect("20991231",date("ST","99/12/31","O"),"deterministic two-digit upper year")
errors = errors + expect("19691231",date("ST","-1","EP"),"negative epoch floors to prior day")
errors = errors + expect("19700101",date("ST","86399","EP"),"positive epoch remains same day")
errors = errors + expect("2000366",date("J","2000366","J"),"leap Julian day")
errors = errors + expect("0001001",date("J","0001001","J"),"minimum Julian day")
errors = errors + expect("1",date("C","0","B"),"first-century first day")
errors = errors + expect("1962/03/10",date("S","716308","B","/"),"SORTED separator")

caught = 0
caught = caught + catches("BAD","19620310","ST","","")
caught = caught + catches("ST","31/04/24","E","","")
caught = caught + catches("ST","29/02/01","E","","")
caught = caught + catches("ST","10/03/962","XE","","")
caught = caught + catches("ST","10/03/1962","E","","")
caught = caught + catches("ST","Friday, March 10, 1962","QU","","")
caught = caught + catches("ST","1962366","J","","")
caught = caught + catches("ST","-62135596801","EP","","")
caught = caught + catches("ST","9999999999999","EP","","")
caught = caught + catches("ST","5373485","JDN","","")
caught = caught + catches("ST","069","D","","")
caught = caught + catches("ST","1962-03-10","IN","","••")
caught = caught + catches("ST","19620310","ST","••","")
errors = errors + check(caught = 13,"all invalid DATE cases signal")

if errors = 0 then say "PASS: date boundaries"
return errors <> 0

catches: procedure = .int
  arg output_format = .string, input = .string, input_format = .string, output_separator = .string, input_separator = .string
  do
    ignored = date(output_format,input,input_format,output_separator,input_separator)
  on signal invalid_arguments
    return 1
  end
  say "FAIL: DATE boundaries expected INVALID_ARGUMENTS for" output_format input input_format output_separator input_separator
  return 0

expect: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if actual = expected then return 0
  say "FAIL: DATE boundaries" label "expected" expected "actual" actual
  return 1

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: DATE boundaries" label
  return 1
