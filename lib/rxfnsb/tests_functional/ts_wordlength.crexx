/* Focused Level B WORDLENGTH tests. */
options levelb
import rxfnsb

errors = 0
errors = errors + check(2, wordlength("Now is the time", 2), "book short")
errors = errors + check(5, wordlength("Now comes the time", 2), "book long")
errors = errors + check(0, wordlength("Now is the time", 6), "absent")
errors = errors + check(4, wordlength("This is a test", 1), "first")
errors = errors + check(4, wordlength("This is a test  ", 4), "last trailing")
errors = errors + check(2, wordlength("one é日 three", 2), "Unicode word")
errors = errors + check(0, wordlength("", 1), "empty")
errors = errors + check(0, wordlength("    ", 1), "blank only")
errors = errors + invalid_wordnum(0)
errors = errors + invalid_wordnum(-1)

if errors = 0 then say "PASS: wordlength"
return errors <> 0

invalid_wordnum: procedure = .int
  arg wordnum = .int
  do
    ignored = wordlength("one two", wordnum)
  on signal invalid_arguments
    return 0
  end
  say "FAIL: WORDLENGTH invalid number did not signal" wordnum
  return 1

check: procedure = .int
  arg expected = .int, actual = .int, label = .string
  if expected = actual then return 0
  say "FAIL: WORDLENGTH" label "expected" expected "got" actual
  return 1
