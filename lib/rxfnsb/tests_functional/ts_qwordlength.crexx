/* rexx */
options levelb
import rxfnsb

errors = 0
source = "alpha beta gamma"
errors = errors + check(5, qwordlength(source, 1), "first")
errors = errors + check(4, qwordlength(source, 2), "second")
errors = errors + check(5, qwordlength(source, 3), "last")
errors = errors + check(0, qwordlength(source, 4), "missing")
errors = errors + check(0, qwordlength("", 1), "empty source")
errors = errors + check_string("alpha beta gamma", source, "source unchanged")

caught = 0
do
  ignored = qwordlength(source, 0)
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(1, caught, "invalid word number signal")

if errors = 0 then say "PASS: qwordlength"
return errors <> 0

check: procedure = .int
  arg expected = .int, actual = .int, label = .string
  if expected = actual then return 0
  say "FAIL: QWORDLENGTH" label "expected" expected "got" actual
  return 1

check_string: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if expected == actual then return 0
  say "FAIL: QWORDLENGTH" label "source changed"
  return 1
