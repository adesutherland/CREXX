/* rexx */
options levelb
import _rxsysb

errors = 0
errors = errors + check("10", reradix("A", 16, 10), "hex to decimal")
errors = errors + check("3969", reradix("f81", 16, 10), "lowercase")
errors = errors + check("A", reradix("1010", 2, 16), "binary to hex")
errors = errors + check("01", reradix("00001", 2, 16), "binary width")
errors = errors + check("00001111", reradix("0F", 16, 2), "hex width")
errors = errors + check("0", reradix("000", 10, 7), "zero normalization")
errors = errors + check("102012", reradix(reradix("102012", 3, 7), 7, 3), "general round trip")
errors = errors + check("FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF", reradix("340282366920938463463374607431768211455", 10, 16), "beyond native integer")

subject = "a5"
ignored = reradix(subject, 16, 10)
errors = errors + check("a5", subject, "input unchanged")

caught = 0
caught = caught + invalid("1", 1, 10)
caught = caught + invalid("1", 10, 17)
caught = caught + invalid("", 10, 2)
caught = caught + invalid("2", 2, 10)
caught = caught + invalid("G", 16, 10)
errors = errors + check_int(5, caught, "invalid arguments signal")

if errors = 0 then say "PASS: reradix"
return errors <> 0

invalid: procedure = .int
  arg subject = .string, from_radix = .int, to_radix = .int
  do
    ignored = reradix(subject, from_radix, to_radix)
  on signal invalid_arguments
    return 1
  end
  return 0

check: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if expected == actual then return 0
  say "FAIL: RERADIX" label "expected" expected "got" actual
  return 1

check_int: procedure = .int
  arg expected = .int, actual = .int, label = .string
  if expected = actual then return 0
  say "FAIL: RERADIX" label "expected" expected "got" actual
  return 1
