/* Focused Level B LENGTH tests. */
options levelb
import rxfnsb

errors = 0
source = "René"

errors = errors + check(length("") = 0, "empty string")
errors = errors + check(length("a") = 1, "single character")
errors = errors + check(length("abcdefgh") = 8, "documented ASCII example")
errors = errors + check(length(source) = 4, "Unicode Latin text")
errors = errors + check(length("é日🙂") = 3, "Unicode codepoints, not UTF-8 bytes")
errors = errors + check(length("é") = 2, "combining codepoint is counted separately")
errors = errors + check(source = "René", "source is not exposed or mutated")

if errors = 0 then say "PASS: length"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: LENGTH" label
  return 1
