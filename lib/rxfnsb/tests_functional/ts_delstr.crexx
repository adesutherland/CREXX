/* Focused Level B DELSTR tests. */
options levelb
import rxfnsb

errors = 0
source = "abcde"

errors = errors + check(delstr("abcd", 3) = "ab", "documented omitted length")
errors = errors + check(delstr(source, 3, 2) = "abe", "documented middle deletion")
errors = errors + check(delstr(source, 6) = source, "documented start beyond end")
errors = errors + check(delstr(source, 3, 0) = source, "explicit zero changes nothing")
errors = errors + check(delstr(source, 1, 2) = "cde", "delete prefix")
errors = errors + check(delstr(source, 4, 20) = "abc", "oversized length")
errors = errors + check(delstr(source, 1) = "", "omitted length from first character")
errors = errors + check(delstr("", 1) = "", "empty source")
errors = errors + check(delstr("aé日z", 2, 2) = "az", "Unicode character positions")
errors = errors + check(source = "abcde", "source is not mutated")

caught = 0
do
  ignored = delstr(source, 0)
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = .string
  ignored = delstr(source, 2, -1)
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(caught = 2, "invalid start and length use signals")

if errors = 0 then say "PASS: delstr"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: DELSTR" label
  return 1
