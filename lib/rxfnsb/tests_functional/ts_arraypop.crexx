/* rexx */
options levelb
import rxfnsb

errors = 0
values = .string[]
values[1] = "A"
values[2] = ""
values[3] = "🙂"

errors = errors + check_string("🙂", arraypop(values, "missing"), "last value")
errors = errors + check_int(2, values[0], "high-water after first pop")
errors = errors + check_string("A", values[1], "first retained")
errors = errors + check_string("", values[2], "empty retained")
errors = errors + check_string("", arraypop(values, "missing"), "empty element value")
errors = errors + check_string("A", arraypop(values), "final value")
errors = errors + check_int(0, values[0], "empty high-water")
errors = errors + check_string("missing", arraypop(values, "missing"), "explicit default")
errors = errors + check_string("", arraypop(values), "omitted default")
errors = errors + check_int(0, values[0], "empty remains empty")

if errors = 0 then say "PASS: arraypop"
return errors <> 0

check_string: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if expected == actual then return 0
  say "FAIL: ARRAYPOP" label "values differ"
  return 1

check_int: procedure = .int
  arg expected = .int, actual = .int, label = .string
  if expected = actual then return 0
  say "FAIL: ARRAYPOP" label "expected" expected "got" actual
  return 1
