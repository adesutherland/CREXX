options levelb
import rxfnsb

errors = 0
mary = 10
bert = "Fred"
j = 3

errors = errors + check(symbol("J") = "VAR", "named integer variable")
errors = errors + check(symbol(j) = "LIT", "variable value is a literal symbol")
errors = errors + check(symbol(2) = "LIT", "numeric literal")
errors = errors + check(symbol("mary") = "VAR", "lowercase integer variable")
errors = errors + check(symbol("BERT") = "VAR", "uppercase string variable")
errors = errors + check(symbol("cccc") = "LIT", "unused valid name")
errors = errors + check(symbol("dress") = "LIT", "keyword suffix is not reserved")
errors = errors + check(symbol("IF") = "BAD", "Level B reserved word")
errors = errors + check(symbol("0.23.4") = "LIT", "Level B dotted constant")
errors = errors + check(symbol("a_b") = "LIT", "underscore name")
errors = errors + check(symbol("") = "BAD", "empty name")
errors = errors + check(symbol("cc*cc") = "BAD", "invalid character")
errors = errors + check(symbol("has blank") = "BAD", "embedded blank")

if errors = 0 then say "PASS: Level B symbol"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL:" label
  return 1
