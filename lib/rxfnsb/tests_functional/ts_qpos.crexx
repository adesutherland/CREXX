options levelb
import rxfnsb

errors = 0
errors = errors + check(10,qpos(';','say hello;world'),"plain")
errors = errors + check(18,qpos(';','say "hello;world"; next'),"double quote")
errors = errors + check(12,qpos(';',"say 'a;b;c'; end"),"single quote")
errors = errors + check(0,qpos(';','say "escaped ""quote""; end"'),"doubled quote")
errors = errors + check(9,qpos(';','a="b;c"d;e;f'),"quote within token")
errors = errors + check(3,qpos(';',';;;;',3),"start")
errors = errors + check(8,qpos('γ','α"βγ"δεγ'),"codepoint position")
errors = errors + check(3,qpos('b','a' || d2c(0) || 'b'),"match after embedded U+0000")

caught = 0
do
  ignored = qpos('', 'a b')
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(1,caught,"empty needle signal")

caught = 0
do
  ignored = .int
  ignored = qpos(';', 'say "unfinished; quote')
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(1,caught,"unmatched quote signal")

caught = 0
do
  ignored = .int
  ignored = qpos(';', 'a;b', 0)
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(1,caught,"invalid start signal")

if errors = 0 then say "PASS: qpos"
return errors <> 0

check: procedure = .int
  arg expected = .int, actual = .int, label = .string
  if expected = actual then return 0
  say "FAIL: QPOS" label "expected" expected "got" actual
  return 1
