/* Focused Level B OVERLAY tests. */
options levelb
import rxfnsb

errors = 0
new_string = "foo"
target = "abcdefghi"

errors = errors + check(overlay(" ", "abcdef", 3) = "ab def", "documented single-character overlay")
errors = errors + check(overlay(".", "abcdef", 3, 2) = "ab. ef", "documented padded overlay")
errors = errors + check(overlay("qq", "abcd") = "qqcd", "default start and length")
errors = errors + check(overlay("qq", "abcd", 4) = "abcqq", "overlay extends target")
errors = errors + check(overlay("123", "abc", 5, 6, "+") = "abc+123+++", "target and overlay padding")
errors = errors + check(overlay(new_string, target, 3, 4, "*") = "abfoo*ghi", "formatted overlay")
errors = errors + check(overlay(new_string, target, 3, 2, "*") = "abfoefghi", "truncated overlay")
errors = errors + check(overlay(new_string, target, 3, 0) = target, "explicit zero is identity inside target")
errors = errors + check(overlay(new_string, "abc", 5, 0, "+") = "abc+", "zero width still extends to start")
errors = errors + check(overlay(new_string, target, , 4, "*") = "foo*efghi", "omitted start with later arguments")
errors = errors + check(overlay("", target, 3) = target, "empty new text with omitted length")
errors = errors + check(overlay("", "", 3, 4, "*") = "******", "empty inputs with explicit width")
errors = errors + check(overlay("日", "aébc", 2) = "a日bc", "Unicode character position")
errors = errors + check(overlay("X", "ab", 4, 3, "·") = "ab·X··", "Unicode padding")
errors = errors + check(new_string = "foo" & target = "abcdefghi", "arguments are not mutated")

caught = 0
do
  ignored = overlay("x", "abc", 0)
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = overlay("x", "abc", 1, -1)
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = overlay("x", "abc", 1, 1, "")
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = overlay("x", "abc", 1, 1, "xy")
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(caught = 4, "start, length, and pad failures use signals")

if errors = 0 then say "PASS: overlay"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: OVERLAY" label
  return 1
