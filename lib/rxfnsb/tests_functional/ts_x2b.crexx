/* Focused Level B X2B tests. */
options levelb
import rxfnsb

errors = 0
source = "DeadBeef"
errors = errors + check("11000011", x2b("C3"), "documented pair")
errors = errors + check("0111", x2b("7"), "single nibble")
errors = errors + check("000111000001", x2b("1 C1"), "documented grouping")
errors = errors + check("11011110101011011011111011101111", x2b(source), "mixed case")
errors = errors + check("DeadBeef", source, "source is not mutated")
errors = errors + check("0000000000000001", x2b("0001"), "leading zero nibbles retained")
errors = errors + check("00000000", x2b("00"), "all zero nibbles retained")
errors = errors + check("00010000001000000011", x2b("1  02 03"), "consecutive valid group blanks")
errors = errors + check("00010000001000000011", x2b("102 03"), "uneven left group")
errors = errors + check("", x2b(""), "empty input")

large_hex = ""
large_binary = ""
do 64
  large_hex = large_hex || "F"
  large_binary = large_binary || "1111"
end
errors = errors + check(large_binary, x2b(large_hex), "256-bit input")

caught = 0
do
  ignored = x2b(" A")
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = x2b("A ")
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = x2b("1 0")
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = x2b("0G")
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = x2b("0" || "09"x || "0")
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check_int(5, caught, "invalid blank placement and characters signal")

if errors = 0 then say "PASS: x2b"
return errors <> 0

check: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if expected = actual then return 0
  say "FAIL: X2B" label "expected" expected "got" actual
  return 1

check_int: procedure = .int
  arg expected = .int, actual = .int, label = .string
  if expected = actual then return 0
  say "FAIL: X2B" label "expected" expected "got" actual
  return 1
