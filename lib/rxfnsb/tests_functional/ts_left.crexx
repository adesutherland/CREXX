/* Focused Level B LEFT tests. */
options levelb
import rxfnsb

errors = 0
source = "foobar"

errors = errors + check(left("abc d", 8) = "abc d   ", "documented blank padding")
errors = errors + check(left("abc d", 8, ".") = "abc d...", "documented explicit padding")
errors = errors + check(left("abc  def", 7) = "abc  de", "documented truncation")
errors = errors + check(left(source, 1) = "f", "single-character truncation")
errors = errors + check(left(source, 0) = "", "zero width")
errors = errors + check(left(source, 6) = source, "equal width")
errors = errors + check(left(source, 8, "*") = "foobar**", "padded width")
errors = errors + check(left("aé日", 2) = "aé", "Unicode truncation")
errors = errors + check(left("é", 3, "·") = "é··", "Unicode padding")
errors = errors + check(source = "foobar", "source is not mutated")

wide = left("x", 1000, ".")
wide_length = .int
assembler strlen wide_length,wide
errors = errors + check(wide_length = 1000, "substantial direct padding")

caught = 0
do
  ignored = left("abc", -1)
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = left("abc", 3, "")
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = left("abc", 3, "xy")
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(caught = 3, "width and pad failures use signals")

if errors = 0 then say "PASS: left"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: LEFT" label
  return 1
