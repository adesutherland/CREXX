*/
say errors

return errors<>0

assert: procedure = .int
  arg testno = .int, expected = .string, actual = .string
  if expected = actual then return 0
  say "Parse test failed :" testno
  say "Expected : '" || expected || "'"
  say "Actual   : '" || actual || "'"
  return 1

assertInt: procedure = .int
  arg testno = .int, expected = .int, actual = .int
  if expected = actual then return 0
  say "Parse test failed :" testno
  say "Expected :" expected
  say "Actual   :" actual
  return 1
