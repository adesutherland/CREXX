/* Test Numeric Access Functions: digits(), fuzz(), form(), numcase(), and standard() */
options levelb comments_dash
import rxfnsb

errors = test1() + test2()
if errors = 0 then say "PASS: numeric"
return errors <> 0

/* Test 1 with one set of numeric options */
test1: procedure = .int
    numeric case upper
    numeric digits 6
    numeric fuzz 2
    numeric form engineering
    numeric standard classic

    errors = 0
    errors = errors + check_string("classic", standard(), "standard classic")
    errors = errors + check_string("engineering", form(), "form engineering")
    errors = errors + check_string("upper", numcase(), "case upper")
    errors = errors + check_int(6, digits(), "digits 6")
    errors = errors + check_int(2, fuzz(), "fuzz 2")
    return errors

/* Test 2 with another set of numeric options */
test2: procedure = .int
    numeric case lower
    numeric digits 10
    numeric fuzz 0
    numeric form scientific
    numeric standard common
    errors = 0
    errors = errors + check_string("common", standard(), "standard common")
    errors = errors + check_string("scientific", form(), "form scientific")
    errors = errors + check_string("lower", numcase(), "case lower")
    errors = errors + check_int(10, digits(), "digits 10")
    errors = errors + check_int(0, fuzz(), "fuzz 0")
    return errors

check_string: procedure = .int
    arg expected = .string, actual = .string, label = .string
    if actual = expected then return 0
    say "FAIL:" label "expected" expected "got" actual
    return 1

check_int: procedure = .int
    arg expected = .int, actual = .int, label = .string
    if actual = expected then return 0
    say "FAIL:" label "expected" expected "got" actual
    return 1
