/* Focused Level B OBJECTARRAYAPPEND tests. */
options levelb
import rxfnsb

errors = 0

array = .object[]
errors = errors + check_int(1, objectarrayappend(array, .box("A") as .object), "default count return")
errors = errors + check("A", join(array), "default count data")

value = .box("X")
errors = errors + check_int(3, objectarrayappend(array, value as .object, 2), "repeat return")
call value.setName("Y")
errors = errors + check("A|X|X", join(array), "repeat object-value copies")

before = join(array)
errors = errors + check_int(3, objectarrayappend(array, .box("Z") as .object, 0), "zero count return")
errors = errors + check(before, join(array), "zero count no-op")
errors = errors + test_invalid_count()

if errors = 0 then say "PASS: objectarrayappend"
return errors <> 0

test_invalid_count: procedure = .int
  array = .object[]
  array[1] = .box("A") as .object
  do
    ignored = objectarrayappend(array, .box("X") as .object, -1)
  on signal invalid_arguments
    return 0
  end
  say "FAIL: OBJECTARRAYAPPEND negative count did not signal"
  return 1

check_int: procedure = .int
  arg expected = .int, actual = .int, label = .string
  if expected = actual then return 0
  say "FAIL: OBJECTARRAYAPPEND" label "expected" expected "got" actual
  return 1

check: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if expected == actual then return 0
  say "FAIL: OBJECTARRAYAPPEND" label "expected" expected "got" actual
  return 1

join: procedure = .string
  arg array = .object[]
  result = ""
  do i = 1 to array[0]
    if i > 1 then result = result || "|"
    item = array[i] as .box
    result = result || item.name()
  end
  return result

box: class
  name_ = .string

  *: factory
    arg name = .string
    name_ = name
    return

  name: method = .string
    return name_

  setName: method = .void
    arg name = .string
    name_ = name
    return
