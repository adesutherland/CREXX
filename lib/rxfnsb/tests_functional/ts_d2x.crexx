/* Focused Level B D2X tests. */
options levelb
import rxfnsb

errors = 0
source = 129
errors = errors + check("0", d2x(0), "zero")
errors = errors + check("9", d2x(9), "documented nine")
errors = errors + check("81", d2x(source), "documented 129")
errors = errors + check_int(129, source, "source is not mutated")
errors = errors + check("1", d2x(129, 1), "positive truncation")
errors = errors + check("81", d2x(129, 2), "exact width")
errors = errors + check("0081", d2x(129, 4), "positive padding")
errors = errors + check("01", d2x(257, 2), "low-digit truncation")
errors = errors + check("", d2x(12, 0), "zero width")
errors = errors + check("000000000000000000000001", d2x(1, 24), "width above old cap")

errors = errors + check("FF", d2x(-1, 2), "negative one")
errors = errors + check("81", d2x(-127, 2), "negative 127")
errors = errors + check("80", d2x(-128, 2), "negative 128")
errors = errors + check("7F", d2x(-129, 2), "negative truncation")
errors = errors + check("FFF81", d2x(-127, 5), "negative padding")
errors = errors + check("FFFFFFFFFFFFFFFFFFFFFFFF", d2x(-1, 24), "negative width above old cap")

maximum = 9223372036854775807
minimum = -9223372036854775807 - 1
errors = errors + check("7FFFFFFFFFFFFFFF", d2x(maximum), "maximum native integer")
errors = errors + check("8000000000000000", d2x(minimum, 16), "minimum native integer")

caught = 0
do
  ignored = d2x(-1)
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = d2x(1, -1)
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check_int(2, caught, "negative without width and negative width signal")

if errors = 0 then say "PASS: d2x"
return errors <> 0

check: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if expected = actual then return 0
  say "FAIL: D2X" label "expected" expected "got" actual
  return 1

check_int: procedure = .int
  arg expected = .int, actual = .int, label = .string
  if expected = actual then return 0
  say "FAIL: D2X" label "expected" expected "got" actual
  return 1
