/* Focused Level B DELWORD tests. */
options levelb
import rxfnsb

errors = 0
errors = errors + check_count("Now time", "Now is the  time", 2, 2, "middle range")
errors = errors + check_omitted("Now is ", "Now is the time ", 3, "omitted through end")
errors = errors + check_omitted("Now time", "Now time", 5, "start above words")
errors = errors + check_omitted("", "Med lov skal", 1, "all words")
errors = errors + check_count("lov skal", "Med lov skal", 1, 1, "first word")
errors = errors + check_count("Med ", "Med lov skal", 2, 99, "count clamps")
errors = errors + check_count("Med lov skal", "Med lov skal", 2, 0, "zero no-op")
errors = errors + check_count("  beta", "  alpha   beta", 1, 1, "leading blanks preserved")
errors = errors + check_count("one three", "one two three", 2, 1, "Unicode blank")
errors = errors + check_omitted("", "", 1, "empty source")
errors = errors + invalid_start(0)
errors = errors + invalid_start(-1)
errors = errors + invalid_count()

if errors = 0 then say "PASS: delword"
return errors <> 0

check_omitted: procedure = .int
  arg expected = .string, source = .string, start = .int, label = .string
  return check(expected, delword(source, start), label)

check_count: procedure = .int
  arg expected = .string, source = .string, start = .int, count = .int, label = .string
  return check(expected, delword(source, start, count), label)

invalid_start: procedure = .int
  arg start = .int
  do
    ignored = delword("one two", start)
  on signal invalid_arguments
    return 0
  end
  say "FAIL: DELWORD invalid start did not signal" start
  return 1

invalid_count: procedure = .int
  do
    ignored = delword("one two", 1, -1)
  on signal invalid_arguments
    return 0
  end
  say "FAIL: DELWORD invalid count did not signal"
  return 1

check: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if expected == actual then return 0
  say "FAIL: DELWORD" label "expected" expected "got" actual
  return 1
