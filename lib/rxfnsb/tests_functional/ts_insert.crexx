/* Focused Level B INSERT tests. */
options levelb
import rxfnsb

errors = 0
new_string = "123"
target = "abc"

errors = errors + check(insert(new_string, target) = "123abc", "default insertion")
errors = errors + check(insert(" ", "abcdef", 3) = "abc def", "middle insertion")
errors = errors + check(insert(new_string, target, 5, 6) = "abc  123   ", "blank extension and formatting")
errors = errors + check(insert(new_string, target, 5, 6, "+") = "abc++123+++", "explicit padding")
errors = errors + check(insert(new_string, target, 0, 5, "-") = "123--abc", "formatted prefix")
errors = errors + check(insert("abc", "def", 2) = "deabcf", "position is characters before insert")
errors = errors + check(insert("abc", "def", 2, 1) = "deaf", "truncated insertion")
errors = errors + check(insert("abc", "def", 2, 0) = "def", "zero length is identity")
errors = errors + check(insert(new_string, target, , 5, "-") = "123--abc", "omitted position with later arguments")
errors = errors + check(insert("日", "aéb", 2) = "aé日b", "Unicode character position")
errors = errors + check(insert("X", "ab", 4, 3, "·") = "ab··X··", "Unicode pad and target extension")
errors = errors + check(new_string = "123" & target = "abc", "arguments are not mutated")

caught = 0
do
  ignored = insert("x", "abc", -1)
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = .string
  ignored = insert("x", "abc", 0, -1)
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = .string
  ignored = insert("x", "abc", 0, 1, "")
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = .string
  ignored = insert("x", "abc", 0, 1, "xy")
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(caught = 4, "position, length, and pad failures use signals")

if errors = 0 then say "PASS: insert"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: INSERT" label
  return 1
