/* Focused Level B C2X tests. */
options levelb
import rxfnsb

errors = 0
source = "Hello"
errors = errors + check("", c2x(""), "empty string")
errors = errors + check("4D", c2x("M"), "documented single character")
errors = errors + check("373273", c2x("72s"), "documented multi-character string")
errors = errors + check("0123", c2x("0123"x), "control bytes keep leading zeroes")
errors = errors + check("0101", c2x("101"x), "each character has two digits")
errors = errors + check("48656C6C6F", c2x(source), "ASCII word")
errors = errors + check("E9", c2x("é"), "established Unicode low-byte behavior")
errors = errors + check("Hello", source, "source is not mutated")

large = ""
expected = ""
do 128
  large = large || "A"
  expected = expected || "41"
end
errors = errors + check(expected, c2x(large), "long input")

if errors = 0 then say "PASS: c2x"
return errors <> 0

check: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if expected = actual then return 0
  say "FAIL: C2X" label "expected" expected "got" actual
  return 1
