/* Focused Level B POS tests. */
options levelb
import rxfnsb

errors = 0
needle = "foo"
haystack = "a foo foo b"

errors = errors + check(pos("day", "Saturday") = 6, "documented match")
errors = errors + check(pos("x", "abc def ghi") = 0, "documented absence")
errors = errors + check(pos(" ", "abc def ghi") = 4, "documented first blank")
errors = errors + check(pos(" ", "abc def ghi", 5) = 8, "documented start")
errors = errors + check(pos(needle, haystack) = 3, "first occurrence")
errors = errors + check(pos(needle, haystack, 4) = 7, "later occurrence")
errors = errors + check(pos(needle, haystack, 30) = 0, "start beyond haystack")
errors = errors + check(pos("", haystack) = 0, "empty needle")
errors = errors + check(pos(needle, "") = 0, "empty haystack")
errors = errors + check(pos("", "") = 0, "both empty")
errors = errors + check(pos("b", "b") = 1, "whole-string match")
errors = errors + check(pos("c", "a→bc") = 4, "Unicode character position")
errors = errors + check(pos("→", "a→b→c", 3) = 4, "Unicode start position")
embedded_nul = "a" || d2c(0) || "bc" || d2c(0) || "d"
errors = errors + check(pos("bc", embedded_nul) = 3, "match after embedded U+0000")
errors = errors + check(pos(d2c(0), embedded_nul, 3) = 5, "embedded U+0000 needle")
errors = errors + check(needle = "foo" & haystack = "a foo foo b", "arguments are not mutated")

large = ""
marker = "Z"
pad_character = 97
large_count = 1000
assembler padstr large,pad_character,large_count
assembler append large,marker
errors = errors + check(pos("Z", large) = 1001, "substantial direct search")

caught = 0
do
  ignored = pos("a", "abc", 0)
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = .int
  ignored = pos("a", "abc", -1)
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(caught = 2, "invalid start uses signals")

if errors = 0 then say "PASS: pos"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: POS" label
  return 1
