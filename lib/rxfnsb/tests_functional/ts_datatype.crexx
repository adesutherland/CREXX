options levelb numeric_classic
import rxfnsb

errors = 0

errors = errors + check("NUM",datatype("12.3"),"default decimal")
errors = errors + check("NUM",datatype(" - 12.3E+2 "),"default signed exponent")
errors = errors + check("CHAR",datatype(""),"default empty")
errors = errors + check("CHAR",datatype("1.2.3"),"default malformed")

errors = errors + check("1",datatype("DeadBeef","A"),"alphanumeric")
errors = errors + check("0",datatype("Dead Beef","A"),"alphanumeric blank")
errors = errors + check("1",datatype("01001101","B"),"binary")
errors = errors + check("1",datatype("0110 1101","B"),"binary grouping")
errors = errors + check("0",datatype("01 01","B"),"binary bad grouping")
errors = errors + check("0",datatype(" 0101","B"),"binary leading blank")
errors = errors + check("1",datatype("","B"),"binary empty")
errors = errors + check("1",datatype("0123456789","D"),"digits extension")
errors = errors + check("0",datatype("12.3","D"),"digits decimal")
errors = errors + check("1",datatype("lower","L"),"lowercase")
errors = errors + check("0",datatype("Lower","L"),"lowercase mixed")
errors = errors + check("1",datatype("Mixed","M"),"mixed letters")
errors = errors + check("0",datatype("Mixed3","M"),"mixed rejects digit")
errors = errors + check("1",datatype("+.5e-2","N"),"number syntax")
errors = errors + check("0",datatype("+","N"),"number sign only")
errors = errors + check("1",datatype("name.1","S"),"symbol")
errors = errors + check("0",datatype("3name","S"),"symbol leading digit")
errors = errors + check("1",datatype("UPPER","U"),"uppercase")
errors = errors + check("0",datatype("Upper","U"),"uppercase mixed")
errors = errors + check("1",datatype("123.000","W"),"exact whole fraction")
errors = errors + check("0",datatype("123.0000003","W"),"no whole tolerance")
errors = errors + check("1",datatype("123000E-3","W"),"whole negative exponent")
errors = errors + check("0",datatype("123001E-3","W"),"fractional negative exponent")
errors = errors + check("1",datatype("0E-999999999999","W"),"zero huge exponent")
errors = errors + check("1",datatype("123.0E+999999999999","W"),"positive huge exponent")
errors = errors + check("1",datatype("DeadBeef","X"),"hexadecimal")
errors = errors + check("1",datatype("A BC DF","X"),"hex grouping")
errors = errors + check("0",datatype("A B C","X"),"hex bad grouping")
errors = errors + check("0",datatype("ABC ","X"),"hex trailing blank")
errors = errors + check("1",datatype("","X"),"hex empty")
errors = errors + check("1",datatype("abc","alphabetic option tail"),"first option character")

errors = errors + expect_option_signal("empty option","")
errors = errors + expect_option_signal("unknown option","Q")

if errors = 0 then say "PASS: datatype"
return errors <> 0

check: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if expected = actual then return 0
  say "FAIL: DATATYPE" label "expected" expected "got" actual
  return 1

expect_option_signal: procedure = .int
  arg label = .string, option = .string
  caught = 0
  do
    ignored = datatype("abc",option)
  on signal invalid_arguments
    caught = 1
  end
  if caught then return 0
  say "FAIL: DATATYPE" label "did not signal INVALID_ARGUMENTS"
  return 1
