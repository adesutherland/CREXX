/* Focused Level B LASTPOS tests. */
options levelb
import rxfnsb

errors = 0
needle = "abc"
haystack = "abc abc"

errors = errors + check(lastpos(" ", "abc def ghi") = 8, "last blank")
errors = errors + check(lastpos(" ", "abcdefghi") = 0, "absent blank")
errors = errors + check(lastpos(" ", "abc def ghi", 7) = 4, "search end excludes later blank")
errors = errors + check(lastpos("b", haystack) = 6, "last single-character match")
errors = errors + check(lastpos("b", haystack, 5) = 2, "limit before last match")
errors = errors + check(lastpos("b", haystack, 6) = 6, "match ending at limit")
errors = errors + check(lastpos("b", haystack, 20) = 6, "limit beyond haystack")
errors = errors + check(lastpos("x", haystack) = 0, "absent needle")
errors = errors + check(lastpos(needle, haystack) = 5, "multicharacter match")
errors = errors + check(lastpos(needle, haystack, 6) = 1, "multicharacter match must end by limit")
errors = errors + check(lastpos("aa", "aaa") = 2, "overlapping matches")
errors = errors + check(lastpos("aa", "aaa", 2) = 1, "overlap limited by match end")
errors = errors + check(lastpos("", haystack) = 0, "empty needle")
errors = errors + check(lastpos("a", "") = 0, "empty haystack")
errors = errors + check(lastpos("", "") = 0, "both empty")
errors = errors + check(lastpos("→", "a→b→c") = 4, "Unicode character position")
errors = errors + check(lastpos("→", "a→b→c", 3) = 2, "Unicode search end")
embedded_nul = "a" || d2c(0) || "b" || d2c(0) || "c"
errors = errors + check(lastpos(d2c(0), embedded_nul) = 4, "embedded U+0000 needle")
errors = errors + check(lastpos("c", embedded_nul) = 5, "match after embedded U+0000")
errors = errors + check(needle = "abc" & haystack = "abc abc", "arguments are not mutated")

large = ""
pad_character = 97
large_count = 1000
assembler padstr large,pad_character,large_count
errors = errors + check(lastpos("aa", large) = 999, "substantial overlapping search")

caught = 0
do
  ignored = lastpos("a", "abc", 0)
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = .int
  ignored = lastpos("a", "abc", -1)
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(caught = 2, "invalid search end uses signals")

if errors = 0 then say "PASS: lastpos"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: LASTPOS" label
  return 1
