/* Focused Level B WORDINDEX tests. */
options levelb
import rxfnsb

errors = 0
errors = errors + check(8, wordindex("Now is the time", 3), "book middle")
errors = errors + check(0, wordindex("Now is the time", 6), "absent")
errors = errors + check(1, wordindex("This is a test", 1), "first")
errors = errors + check(3, wordindex("  This is a test", 1), "leading blanks")
errors = errors + check(8, wordindex("This   is a test", 2), "multiple blanks")
errors = errors + check(21, wordindex("This is certainly a test  ", 5), "last")
errors = errors + check(5, wordindex("one two three", 2), "Unicode blank")
errors = errors + check(0, wordindex("", 1), "empty")
errors = errors + check(0, wordindex("    ", 1), "blank only")
errors = errors + invalid_wordnum(0)
errors = errors + invalid_wordnum(-1)

if errors = 0 then say "PASS: wordindex"
return errors <> 0

invalid_wordnum: procedure = .int
  arg wordnum = .int
  do
    ignored = wordindex("one two", wordnum)
  on signal invalid_arguments
    return 0
  end
  say "FAIL: WORDINDEX invalid number did not signal" wordnum
  return 1

check: procedure = .int
  arg expected = .int, actual = .int, label = .string
  if expected = actual then return 0
  say "FAIL: WORDINDEX" label "expected" expected "got" actual
  return 1
