/* Focused Level B ABS tests. */
options levelb comments_dash
import rxfnsb

errors = 0
source = "-12.345"

errors = errors + check(abs(12.3) = 12.3, "positive decimal")
errors = errors + check(abs(-12.345) = 12.345, "negative decimal")
errors = errors + check(abs(source) = 12.345, "standard numeric string conversion")
errors = errors + check(abs("+1") = 1, "explicit plus")
errors = errors + check(abs("-0") = 0, "negative zero")
errors = errors + check(abs(0) = 0, "integer zero promotion")
errors = errors + check((abs("-123.45E+16") as .string) = "1.2345E+18", "exponent normalization")
errors = errors + check(source = "-12.345", "argument is not mutated")

if errors = 0 then say "PASS: abs"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: ABS" label
  return 1
