/* Focused Level B X2D tests. */
options levelb
import rxfnsb

errors = 0
source = "FF81"
errors = errors + check(0, x2d(""), "empty input")
errors = errors + check(14, x2d("0E"), "documented fourteen")
errors = errors + check(129, x2d("81"), "documented 129")
errors = errors + check(3969, x2d("F81"), "documented 3969")
errors = errors + check(65409, x2d(source), "documented 65409")
errors = errors + check_string("FF81", source, "source is not mutated")
errors = errors + check(50928, x2d("c6f0"), "mixed case")
errors = errors + check(65409, x2d("FF 81"), "valid grouping")
errors = errors + check(9223372036854775807, x2d("00007FFFFFFFFFFFFFFF"), "leading-zero maximum")

errors = errors + check(-127, x2d("81", 2), "signed two digits")
errors = errors + check(129, x2d("81", 4), "zero-padded signed width")
errors = errors + check(-3967, x2d("F081", 4), "signed four digits")
errors = errors + check(129, x2d("F081", 3), "signed truncation three")
errors = errors + check(-127, x2d("F081", 2), "signed truncation two")
errors = errors + check(1, x2d("F081", 1), "signed truncation one")
errors = errors + check(0, x2d("0031", 0), "zero signed width")
errors = errors + check(2748, x2d("abc", 12345), "large zero-padded width")
minimum = -9223372036854775807 - 1
errors = errors + check(minimum, x2d("8000000000000000", 16), "minimum native integer")
errors = errors + check(9223372036854775807, x2d("07FFFFFFFFFFFFFFF", 17), "positive sign extension above 64 bits")
errors = errors + check(minimum, x2d("F8000000000000000", 17), "negative sign extension above 64 bits")
errors = errors + check(-1, x2d("FFFFFFFFFFFFFFFFF", 17), "negative sign extension above 64 bits")

invalid_caught = 0
do
  ignored = x2d("G0")
on signal invalid_arguments
  invalid_caught = invalid_caught + 1
end
do
  ignored = .int
  ignored = x2d(" A")
on signal invalid_arguments
  invalid_caught = invalid_caught + 1
end
do
  ignored = .int
  ignored = x2d("A ")
on signal invalid_arguments
  invalid_caught = invalid_caught + 1
end
do
  ignored = .int
  ignored = x2d("1 0")
on signal invalid_arguments
  invalid_caught = invalid_caught + 1
end
do
  ignored = .int
  ignored = x2d("0" || "09"x || "0")
on signal invalid_arguments
  invalid_caught = invalid_caught + 1
end
do
  ignored = .int
  ignored = x2d("1", -1)
on signal invalid_arguments
  invalid_caught = invalid_caught + 1
end
errors = errors + check(6, invalid_caught, "invalid text and negative length signal")

overflow_caught = 0
do
  ignored = .int
  ignored = x2d("8000000000000000")
on signal overflow_underflow
  overflow_caught = overflow_caught + 1
end
do
  ignored = .int
  ignored = x2d("08000000000000000", 17)
on signal overflow_underflow
  overflow_caught = overflow_caught + 1
end
do
  ignored = .int
  ignored = x2d("F7FFFFFFFFFFFFFFF", 17)
on signal overflow_underflow
  overflow_caught = overflow_caught + 1
end
errors = errors + check(3, overflow_caught, "unsigned and signed native overflow signal")

if errors = 0 then say "PASS: x2d"
return errors <> 0

check: procedure = .int
  arg expected = .int, actual = .int, label = .string
  if expected = actual then return 0
  say "FAIL: X2D" label "expected" expected "got" actual
  return 1

check_string: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if expected = actual then return 0
  say "FAIL: X2D" label "expected" expected "got" actual
  return 1
