/* Focused Level B ARRAYAPPEND tests. */
options levelb
import rxfnsb

errors = 0

array = .string[]
errors = errors + check_int(1, arrayappend(array, "A"), "default count return")
errors = errors + check("A", join(array), "default count data")

value = "β"
errors = errors + check_int(4, arrayappend(array, value, 3), "repeat return")
value = "changed"
errors = errors + check("A|β|β|β", join(array), "repeat data/value copy")

before = join(array)
errors = errors + check_int(4, arrayappend(array, "X", 0), "zero count return")
errors = errors + check(before, join(array), "zero count no-op")

errors = errors + test_invalid_count()

if errors = 0 then say "PASS: arrayappend"
return errors <> 0

test_invalid_count: procedure = .int
  array = .string[]
  array[1] = "A"
  do
    ignored = arrayappend(array, "X", -1)
  on signal invalid_arguments
    return 0
  end
  say "FAIL: ARRAYAPPEND negative count did not signal"
  return 1

check_int: procedure = .int
  arg expected = .int, actual = .int, label = .string
  if expected = actual then return 0
  say "FAIL: ARRAYAPPEND" label "expected" expected "got" actual
  return 1

check: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if expected == actual then return 0
  say "FAIL: ARRAYAPPEND" label "expected" expected "got" actual
  return 1

join: procedure = .string
  arg array = .string[]
  result = ""
  do i = 1 to array[0]
    if i > 1 then result = result || "|"
    result = result || array[i]
  end
  return result
