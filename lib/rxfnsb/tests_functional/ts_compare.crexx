/* Focused Level B COMPARE tests. */
options levelb
import rxfnsb

errors = 0
left = "ab-- "
right = "ab"

errors = errors + check(compare("abc", "abc") = 0, "equal")
errors = errors + check(compare("abc", "ak") = 2, "internal mismatch")
errors = errors + check(compare("ab ", "ab") = 0, "default blank padding")
errors = errors + check(compare("ab ", "ab", " ") = 0, "explicit blank padding")
errors = errors + check(compare("ab ", "ab", "x") = 3, "nonblank pad mismatch")
errors = errors + check(compare(left, right, "-") = 5, "first tail mismatch")
errors = errors + check(compare("foo", "bar") = 1, "first-position mismatch")
errors = errors + check(compare(" ", "") = 0, "blank equals default padding")
errors = errors + check(compare("", "x") = 1, "right side longer")
errors = errors + check(compare("x", "") = 1, "left side longer")
errors = errors + check(compare("foo", "f", "o") = 0, "nonblank virtual padding")
errors = errors + check(compare("foobar", "foobag") = 6, "last-position mismatch")
errors = errors + check(compare("aé", "aê") = 2, "Unicode mismatch position")
errors = errors + check(compare("é", "é·", "·") = 0, "Unicode pad")
errors = errors + check(left = "ab-- " & right = "ab", "arguments are not mutated")

caught = 0
do
  ignored = compare("a", "b", "")
on signal invalid_arguments
  caught = caught + 1
end
do
  ignored = .int
  ignored = compare("a", "b", "xy")
on signal invalid_arguments
  caught = caught + 1
end
errors = errors + check(caught = 2, "invalid pads use signals")

if errors = 0 then say "PASS: compare"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: COMPARE" label
  return 1
