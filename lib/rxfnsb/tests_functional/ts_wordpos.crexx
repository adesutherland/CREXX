/* Focused Level B WORDPOS tests. */
options levelb
import rxfnsb

errors = 0
errors = errors + check(3, wordpos("the", "Now is the time"), "book word")
errors = errors + check(0, wordpos("The", "Now is the time"), "case strict")
errors = errors + check(2, wordpos("is the", "Now is the time"), "phrase")
errors = errors + check(2, wordpos(" is    the ", "Now  is the time"), "blank equivalence")
errors = errors + check(0, wordpos("is time", "Now is the time"), "nonadjacent")
errors = errors + check(2, wordpos("be", "To be or not to be"), "first duplicate")
errors = errors + check(6, wordpos("be", "To be or not to be", 3), "start duplicate")
errors = errors + check(0, wordpos("jum", "the fox jumps"), "no prefix match")
errors = errors + check(3, wordpos("jumps", "the fox jumps"), "exact last")
errors = errors + check(2, wordpos("β γ", "α β　γ δ"), "Unicode blanks")
errors = errors + check(0, wordpos("", "one two"), "empty phrase")
errors = errors + check(0, wordpos("    ", "one two"), "blank phrase")
errors = errors + check(0, wordpos("one", ""), "empty target")
errors = errors + check(0, wordpos("one", "one two", 3), "start above target")
errors = errors + invalid_start(0)
errors = errors + invalid_start(-1)

if errors = 0 then say "PASS: wordpos"
return errors <> 0

invalid_start: procedure = .int
  arg start = .int
  do
    ignored = wordpos("one", "one two", start)
  on signal invalid_arguments
    return 0
  end
  say "FAIL: WORDPOS invalid start did not signal" start
  return 1

check: procedure = .int
  arg expected = .int, actual = .int, label = .string
  if expected = actual then return 0
  say "FAIL: WORDPOS" label "expected" expected "got" actual
  return 1
