/* Assertion coverage for the legacy dynamic Level B PARSE helpers. */
options levelb
import rxfnsb

errors = 0
errors = errors + test_compile_plans()
errors = errors + test_direct_execution()
errors = errors + test_wrapper_options()
errors = errors + test_validation_signals()

if errors = 0 then say "PASS: legacy parse helpers"
return errors <> 0

test_compile_plans: procedure = .int
  errors = 0
  token = .string[]
  kind = .int[]

  count = parsecompile("first','second third",token,kind)
  errors = errors + check(count = 5,"compile item count")
  errors = errors + check(token[1] = "first" & kind[1] = 1,"compile first variable")
  errors = errors + check(token[2] = "," & kind[2] = 2,"compile literal")
  errors = errors + check(token[3] = "second" & kind[3] = 1,"compile second variable")
  errors = errors + check(token[4] = " " & kind[4] = 5,"compile implicit blank")
  errors = errors + check(token[5] = "third" & kind[5] = 1,"compile third variable")

  count = parsecompile("left ',' right",token,kind)
  errors = errors + check(count = 3,"quote-adjacent whitespace suppressed")
  errors = errors + check(token[1] = "left" & kind[1] = 1,"suppressed left")
  errors = errors + check(token[2] = "," & kind[2] = 2,"suppressed literal")
  errors = errors + check(token[3] = "right" & kind[3] = 1,"suppressed right")

  count = parsecompile("name 10 job +8 surname (name)",token,kind)
  errors = errors + check(count = 6,"position/search plan count")
  errors = errors + check(kind[1] = 1 & kind[2] = 3 & kind[3] = 1,"absolute plan kinds")
  errors = errors + check(token[2] = "10" & token[4] = "+8" & kind[4] = 4,"typed position payloads")
  errors = errors + check(token[6] = "name" & kind[6] = 6,"prior-variable search")

  count = parsecompile("a 'can''t' b",token,kind)
  errors = errors + check(count = 3,"doubled quote plan count")
  errors = errors + check(token[2] = "can''t" & kind[2] = 2,"doubled quote retained")

  count = parsecompile('a "," b',token,kind)
  errors = errors + check(count = 3 & token[2] = "," & kind[2] = 2,"double-quoted literal")

  count = parsecompile("a -9223372036854775808 b",token,kind)
  errors = errors + check(count = 3 & token[2] = "-9223372036854775808" & kind[2] = 4,"minimum relative position")

  count = parsecompile("a b",token,kind)
  errors = errors + check(count = 3,"NBSP word plan count")
  errors = errors + check(token[2] = " " & kind[2] = 5,"NBSP word delimiter")
  return errors

test_direct_execution: procedure = .int
  errors = 0
  token = .string[]
  kind = .int[]
  variable = .string[]
  value = .string[]

  count = parsecompile("a b c",token,kind)
  source = "one  two three"
  call parsestring source,count,token,kind,variable,value,"a b c"
  errors = errors + check(variable[0] = 3 & value[0] = 3,"word output counts")
  errors = errors + check(variable[1] = "a" & value[1] = "one","word first")
  errors = errors + check(variable[2] = "b" & value[2] = "two","word second")
  errors = errors + check(variable[3] = "c" & value[3] = "three","word third")

  count = parsecompile("a','b','c",token,kind)
  source = "left,middle,right"
  call parsestring source,count,token,kind,variable,value
  errors = errors + check(value[1] = "left" & value[2] = "middle" & value[3] = "right","literal fields")

  count = parsecompile("a','b (a) c",token,kind)
  source = "xx,yyxxzz"
  call parsestring source,count,token,kind,variable,value
  errors = errors + check(value[1] = "xx" & value[2] = "yy" & value[3] = "zz","prior-variable delimiter")
  errors = errors + check(source = "xx,yyxxzz","source nonmutation")
  errors = errors + check(token[1] = "a" & kind[1] = 1,"plan nonmutation")

  count = parsecompile("a 4 b +2 c -3 d",token,kind)
  call parsestring "abcdefghij",count,token,kind,variable,value
  errors = errors + check(value[1] = "abc" & value[2] = "de","absolute and forward positions")
  errors = errors + check(value[3] = "fghij" & value[4] = "cdefghij","backward position and final tail")

  count = parsecompile("a':'b",token,kind)
  call parsestring "no delimiter",count,token,kind,variable,value
  errors = errors + check(value[1] = "no delimiter" & value[2] = "","missing literal fallback")

  count = parsecompile("a -9223372036854775808 b",token,kind)
  call parsestring "abc",count,token,kind,variable,value
  errors = errors + check(value[1] = "abc" & value[2] = "abc","minimum relative execution")
  return errors

test_wrapper_options: procedure = .int
  errors = 0
  variable = .string[]
  value = .string[]

  count = parse("  One , TWO  ","left','right",variable,value,1,2)
  errors = errors + check(count = 2 & variable[0] = 2 & value[0] = 2,"wrapper output count")
  errors = errors + check(value[1] = "one" & value[2] = "two","strip and lowercase")

  count = parse("one,two","left','right",variable,value,0,1)
  errors = errors + check(value[1] = "ONE" & value[2] = "TWO","uppercase option")

  count = parse("ignored","",variable,value)
  errors = errors + check(count = 0 & variable[0] = 0 & value[0] = 0,"empty template clears outputs")
  return errors

test_validation_signals: procedure = .int
  errors = 0
  caught = 0
  token = .string[]
  kind = .int[]
  variable = .string[]
  value = .string[]
  token[1] = "sentinel"
  kind[1] = 1
  variable[1] = "old-name"
  value[1] = "old-value"

  do
    ignored = parsecompile("a'unclosed",token,kind)
  on signal invalid_arguments
    caught = caught + 1
    errors = errors + check(token[1] = "sentinel" & kind[1] = 1,"compile signal preserves outputs")
  end
  do
    ignored = .int
    ignored = parsecompile("a +x b",token,kind)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .int
    ignored = parsecompile("a () b",token,kind)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .int
    ignored = parsecompile("a (name b",token,kind)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .int
    ignored = parsecompile("a 9223372036854775808 b",token,kind)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .int
    ignored = parsecompile("a +9223372036854775808 b",token,kind)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    call parsestring "abc",2,token,kind,variable,value
  on signal invalid_arguments
    caught = caught + 1
    errors = errors + check(variable[1] = "old-name" & value[1] = "old-value","count signal preserves outputs")
  end
  do
    token[1] = "a"
    kind[1] = 9
    call parsestring "abc",1,token,kind,variable,value
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    call parsestring "abc",-1,token,kind,variable,value
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    token[1] = ""
    kind[1] = 1
    call parsestring "abc",1,token,kind,variable,value
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    token[1] = "x"
    kind[1] = 3
    call parsestring "abc",1,token,kind,variable,value
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    token[1] = "+x"
    kind[1] = 4
    call parsestring "abc",1,token,kind,variable,value
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    token[1] = "x"
    kind[1] = 5
    call parsestring "abc",1,token,kind,variable,value
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    token[1] = ""
    kind[1] = 6
    call parsestring "abc",1,token,kind,variable,value
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .int
    ignored = parse("abc","a",variable,value,2,0)
  on signal invalid_arguments
    caught = caught + 1
  end
  do
    ignored = .int
    ignored = parse("abc","a",variable,value,0,3)
  on signal invalid_arguments
    caught = caught + 1
  end

  errors = errors + check(caught = 16,"all legacy validation signals caught")
  return errors

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: legacy parse" label
  return 1
