/* Focused Level B UPPER tests. */
options levelb
import rxfnsb

errors = 0
source = "The quick brown fox jumps over the lazy dog"

errors = errors + check(upper(source) = "THE QUICK BROWN FOX JUMPS OVER THE LAZY DOG", "ASCII alphabet")
errors = errors + check(upper("MiXeD 123 !?") = "MIXED 123 !?", "mixed text preserves nonletters")
errors = errors + check(upper("äöüé") = "ÄÖÜÉ", "Unicode cased characters")
errors = errors + check(upper("ALREADY UPPER") = "ALREADY UPPER", "already uppercase")
errors = errors + check(upper("") = "", "empty string")
embedded_nul = "a" || d2c(0) || "b"
errors = errors + check(upper(embedded_nul) = "A" || d2c(0) || "B", "text after embedded U+0000")
errors = errors + check(source = "The quick brown fox jumps over the lazy dog", "source is not exposed or mutated")

if errors = 0 then say "PASS: upper"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: UPPER" label
  return 1
