/* Focused Level B SIGN tests. */
options levelb comments_dash numeric_classic
import rxfnsb

errors = 0
source = "-7.25"

errors = errors + check(sign(3.14) = 1, "positive decimal")
errors = errors + check(sign(-3.14) = -1, "negative decimal")
errors = errors + check(sign(0) = 0, "integer zero promotion")
errors = errors + check(sign("-0") = 0, "negative zero")
errors = errors + check(sign(source) = -1, "numeric string promotion")
errors = errors + check(sign("1E-999") = 1, "positive below binary-float range")
errors = errors + check(sign("-1E-999") = -1, "negative below binary-float range")
errors = errors + check(sign("1E+999") = 1, "positive above binary-float range")
errors = errors + check(sign("-1E+999") = -1, "negative above binary-float range")
errors = errors + check(source = "-7.25", "argument is not mutated")

if errors = 0 then say "PASS: sign"
return errors <> 0

check: procedure = .int
  arg passed = .boolean, label = .string
  if passed then return 0
  say "FAIL: SIGN" label
  return 1
