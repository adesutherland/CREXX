/* Focused Level B SPLICE tests. */
options levelb
import rxfnsb

errors = 0
errors = errors + check("abXef", splice("X", "abcdef", 3, 2), "replace middle")
errors = errors + check("abXYZef", splice("XYZ", "abcdef", 3, 2), "grow")
errors = errors + check("abX", splice("X", "abcdef", 3, 99), "remove through end")
errors = errors + check("abc-def", splice("-", "abcdef", 4, 0), "insert")
errors = errors + check("XYdef", splice("XY", "abcdef", 1, 3), "replace from start")
errors = errors + check("XYZ", splice("XYZ", "abcdef", 1, 6), "replace whole string")
errors = errors + check("abcdefEND", splice("END", "abcdef", 99, 2), "clamp to append")
errors = errors + check("abc", splice("", "abcdef", 4, 99), "delete tail")
errors = errors + check("X", splice("X", "", 1, 0), "insert into empty")
errors = errors + check("X", splice("X", "", 1, 99), "replace empty")
errors = errors + check("abcdeZ", splice("Z", "abcdef", 6, 1), "replace last")
errors = errors + check("abcdef!", splice("!", "abcdef", 7, 0), "explicit append")
errors = errors + check("abcdef", splice("", "abcdef", 3, 0), "empty no-op")
errors = errors + check("aΩz", splice("Ω", "aαβz", 2, 2), "Unicode character positions")

needle = "replacement"
haystack = "original"
ignored = splice(needle, haystack, 4, 2)
errors = errors + check("replacement", needle, "needle is not mutated")
errors = errors + check("original", haystack, "haystack is not mutated")

invalid_caught = 0
do
  ignored = splice("X", "abcdef", 0, 2)
on signal invalid_arguments
  invalid_caught = invalid_caught + 1
end
do
  ignored = splice("X", "abcdef", 3, -1)
on signal invalid_arguments
  invalid_caught = invalid_caught + 1
end
errors = errors + check_int(2, invalid_caught, "invalid controls signal")

if errors = 0 then say "PASS: splice"
return errors <> 0

check: procedure = .int
  arg expected = .string, actual = .string, label = .string
  if expected == actual then return 0
  say "FAIL: SPLICE" label "expected" expected "got" actual
  return 1

check_int: procedure = .int
  arg expected = .int, actual = .int, label = .string
  if expected = actual then return 0
  say "FAIL: SPLICE" label "expected" expected "got" actual
  return 1
